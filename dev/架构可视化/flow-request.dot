// Weline 一次前台请求的运行逻辑流（current-state，全部步骤有源码行级证据）
// 来源: Framework/Runtime/{WlsRuntime,FpmRuntime,RequestPipeline}.php, App.php, Router/{Core,FullPageCacheCoordinator}.php, View/{Template,Block}.php
// 生成: 2026-10-05 · flow-visualizer + graphviz · 再生成见 flow-evidence.md
digraph weline_request_flow {
  graph [rankdir=TB, ranksep=0.42, nodesep=0.3, fontname="PingFang SC", labelloc=t, fontsize=18]
  graph [label="Weline 前台请求执行流（节点=阶段，标注源码位置；橙=缓存短路，红=失败/旁路，蓝=上下文冻结一次→后续只读）"]
  node [shape=box, style="rounded,filled", fontsize=11, fillcolor="#e8f0fe", margin="0.14,0.07"]
  edge [fontsize=10, arrowsize=0.8]

  Client [shape=ellipse, label="访客浏览器"]
  Transport [label="① 传输层\nWLS: nginx→worker 常驻进程(WlsRuntime.handle:6517)\nFPM: nginx→php-fpm 每请求(FpmRuntime.handle:34)"]
  Boot [label="② bootstrapRequestCycle + RequestContext::init\n异常/TraceContext/autoload (App.php runWithRuntime:1334)\ninit 重置 storage/cleanup·生成 requestId/connectionId/chainId (:143,:40-57)"]
  PreGate [label="③ pre_route_gate 事件\ndispatchPreRouteGate (App.php:163)\n维护模式等强制门禁·观察者不得派发控制器 (event.php)"]
  Url [label="④ URL 解析\nparseUrl(App.php:207)→applyParsedUrl\nsynchronizeParsedLocalization：先冻结访客 URI 的 lang/currency (:395-396)"]
  ScopeFreeze [shape=hexagon, fillcolor="#d2e3fc", label="④b Scope 冻结（只算一次）\ninstallStorefrontNavigationScope→provides DI 到 Websites\ntarget DetectWebsite→ScopeResolver 解析 Website→Store→Channel (App.php:781, ScopeResolver.php:131)\nRequestContext::installScopeIdentity：不可变 ScopeIdentity，二次改写不同身份即抛「已冻结」(:541-585)"]
  CacheKeyFreeze [shape=hexagon, fillcolor="#d2e3fc", label="④c 缓存键/渲染事实冻结（只算一次）\nfreezeCurrent→不可变 StorefrontCacheKeyContext(SHA-256 指纹)\n(App.php:496; Resolver.php:22-94) · RenderContext installOnce (:510)"]
  Ctx [shape=cylinder, fillcolor="#d2e3fc", label="请求上下文 Context（纤程隔离）\nScopeIdentity + CacheKeyContext + env.*/route.* 投影\n发布前清空全部可变投影，避免继承脏值"]
  ScopeGate [shape=hexagon, label="⑤ storefront_scope_ready_gate / application_context_ready 事件\n观察者二次门禁·能力模块不反查宿主业务 (App.php:466-489)"]
  FpcProbe [shape=diamond, fontsize=10, label="⑥ FPC 探测\ngetCachedResponse\n(Core.php:1707)"]
  Hit [shape=cds, label="⑦ HIT: 直接返回缓存 Response\nX-WLS-FPC-Status: HIT"]
  Stale [label="⑦b stale_before_build:\n上一代/同代 receipt 软服务\n(wls.performance.fpc_serve_stale_before_build Core.php:1716-1730)"]
  Lock [label="⑧ acquireBuildLock 单飞建锁\n(Core.php:1736; 未抢到→waitForPublishedResponse:1761)"]
  Before [label="⑨ run_before 事件 dispatchRunBefore\n(RequestPipeline)"]
  Session [label="⑩ 懒启动会话 startSessionIfNeeded\n(仅需要 session 的路由)"]
  Route [label="⑪ Router\\Core.start():396\n路由匹配: generated 路由快路径(:306)+统一缓存\n事件 router_before_start/process_uri_before/route_before(:408/:594)"]
  Attr [label="⑫ 控制器 Attribute 链 execute\n(Core.php:1840-1850) 鉴权/前置拦截\n返回非空即短路"]
  Ctrl [label="⑬ ObjectManager 实例化控制器\n(provides/DI 权威绑定 Core.php:1875)\ncall_user_func([$dispatch,$method]) (:1893)"]
  Render [label="⑭ View 渲染\nBlock.render→fetchHtml→编译模板 include+extract\n(View/Block.php:76-116) FiberOutputBuffer 捕获"]
  Hook [label="⑭b <hook>name</hook> 处执行 view/hooks/*.phtml\n按 @hook-priority/sort/solo 元数据编排\n(Template.php:2600-2615, Hooker 兜底)"]
  Publish [label="⑮ publishResponse 回写 FPC\n(canPublishResponse 判定可缓存 Core.php:2006)\nreleaseBuildLock (:2033)"]
  After [label="⑯ run_after 事件 → 响应输出\n早退/异常路径不跑 after，由 Runtime finally+RequestResetter 恰好一次清理上下文 (RequestPipeline 注释)"]
  Err [label="✗ handleException→RendererFactory\n500 渲染 (bootstrap.php catch / WlsRuntime:8038)"]

  Client -> Transport -> Boot -> PreGate -> Url -> ScopeFreeze -> CacheKeyFreeze -> ScopeGate -> FpcProbe
  ScopeFreeze -> Ctx [label="install（写一次）", color="#1a5fb4", penwidth=1.6]
  CacheKeyFreeze -> Ctx [label="install（写一次）", color="#1a5fb4", penwidth=1.6]
  Ctx -> FpcProbe [label="current() 读缓存键指纹\n(Core.php:1694, Coordinator:1776)", color="#1a5fb4", style=dotted]
  Ctx -> Route [label="只读 area/route.path/ScopeIdentity\n不再解析 Scope·不查 DB", color="#1a5fb4", style=dotted]
  Ctx -> Ctrl [label="只读 lang/currency/scope\n(如 getWelineWebsiteCode←scopeIdentity :699-712)", color="#1a5fb4", style=dotted]
  Hit -> Transport [label="缓存 Response", color="#b06000"]
  After -> Transport [label="渲染 Response"]
  Err -> Transport [label="错误页", style=dotted, color="#c5221f"]
  Transport -> Client [label="请求", penwidth=1.4]
  Client -> Transport [label="HTML / JSON 响应", constraint=false, penwidth=1.4]
  Client -> Media [label="静态资源（nginx 直出）", style=dotted]

  FpcProbe -> Hit [label="命中", color="#b06000", penwidth=1.6]
  FpcProbe -> Stale [label="重建窗口·上代receipt", color="#b06000", style=dashed]
  FpcProbe -> Lock [label="MISS"]
  Stale -> After [label="直接返回", color="#b06000", style=dashed]
  Lock -> Before -> Session -> Route -> Attr -> Ctrl -> Render -> Hook -> Publish -> After
  Attr -> After [label="短路：重定向/拒绝", style=dotted, color="#c5221f", labeldistance=2.4]
  Route -> Err [label="404/异常", style=dotted, color="#c5221f"]
  Ctrl -> Err [label="throw", style=dotted, color="#c5221f"]

  subgraph cluster_stores {
    label="数据面"; style=filled; fillcolor="#f8f9fa"; fontsize=12;
    DB [shape=cylinder, label="MySQL/PDO"]
    CacheStore [shape=cylinder, label="FPC/词典缓存\nProcess L1 + 共享存储"]
    Ses [shape=cylinder, label="Session 存储"]
    Media [shape=cylinder, label="pub/static 静态\nnginx 直出·不进 PHP"]
  }
  Ctrl -> DB [label="Model/Eav 读写", style=dotted]
  Publish -> CacheStore [label="写 receipt/gzip", style=dotted]
  FpcProbe -> CacheStore [label="读", style=dotted]
  Session -> Ses [label="读写", style=dotted]
}
