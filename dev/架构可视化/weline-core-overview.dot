digraph weline_core_mech {
  graph [rankdir=BT, ranksep=0.9, nodesep=0.35, fontname="PingFang SC", labelloc=t, fontsize=18]
  graph [label="Weline 核心骨架 · 集成机制视图（边的颜色=装配通道）"]
  node [shape=box, style="rounded,filled", fontsize=11, margin="0.12,0.06", fontcolor=white]
