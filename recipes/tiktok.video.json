{
  "platform": "tiktok",
  "kind": "video",
  "version": 1,
  "entry": "https://www.tiktok.com/tiktokstudio/upload?from=webapp",
  "fields": [
    {
      "key": "caption",
      "role": "textbox",
      "anchor": [
        "Add a caption",
        "添加描述",
        "Describe your video"
      ]
    }
  ],
  "media": {
    "upload_role": "file",
    "accept": [
      "video/mp4"
    ],
    "max": 1
  },
  "verify": {
    "url_matches": "/video/",
    "text_any": [
      "已发布",
      "Your video is being uploaded",
      "Published"
    ]
  },
  "branches": [
    {
      "when_text": [
        "Continue to post",
        "继续"
      ],
      "do": "click:continue"
    }
  ],
  "give_up": [
    "需要验证码",
    "账号受限",
    "Upload failed"
  ],
  "submit": {
    "role": "button",
    "anchor": [
      "Post",
      "发布",
      "Publish"
    ]
  }
}