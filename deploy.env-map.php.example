 *
 * @see app/code/Weline/Deploy/doc/开发/spec/deploy-env-map.md
 */
return [
    'schema' => 'deploy-env-map.v1',
    // 可选：强制档位。不写则读 app/etc/env.php 的 system.deploy（dev/staging/prod）
    // 'target_level' => 'prod',

    'rules' => [
        [
            'module' => 'Weline_Payment',
            'area' => 'backend',
            'key' => 'payment/method/paypal/environment',
            // 与后台配置中心 Scope 对齐：global 或三段 storage scope
            'scopes' => [
                'global',
                // 'hanfu.__website__.default',
            ],
            'values_by_level' => [
                'dev' => 'sandbox',
                'staging' => 'sandbox',
                'prod' => 'live',
            ],
        ],
        // 按需追加 Stripe / Fake 等同一 key 模式
        // [
        //     'module' => 'Weline_Payment',
        //     'area' => 'backend',
        //     'key' => 'payment/method/stripe/environment',
