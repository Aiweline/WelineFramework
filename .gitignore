/sql.sql
/sql.log
/dev_sql.log

# NOTE: .codex/ is ignored as a whole above (see "AI agent protocols"). The former
# `.codex/*` + `!.codex/agents|prompts|config.toml` negations were dead rules — git cannot
# re-include a path whose parent directory is excluded (verified via git check-ignore).

# Local build, cache, backup and test artifacts
/build/
**/__pycache__/
*.py[cod]
*.orig
*.bak
*.swp
*.swo
/tests/e2e/**/.npm/
/tests/e2e/**/artifacts/
/tests/e2e/**/*.log
/tests/var/codex-tmp/

# Generated module and report artifacts
/app/code/**/node_modules/
/app/code/Weline/Server/var/log/*.json
/app/code/Weline/ThemeFancy/view/statics/assets/libs/**/yarn-error.log
/app/code/Weline/Visitor/etc/report_catalog.json

# Accidental local file
/NUL

# Mail templates: only zh_Hans_CN entities + shell/samples in git; other locales live in DB
**/view/email/**/*.html
**/view/email/**/*.subject.txt
!**/view/email/**/zh_Hans_CN.html
