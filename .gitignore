!.gitignore

# macOS metadata
.DS_Store

# Local tooling / session state (do not commit)
.omx/
.dev
/tmp/
/data/pagebuilder/
/app/var/
/artifacts/

# Uploaded / generated storefront media — only keep the placeholder
/pub/media/**
!/pub/media/
!/pub/media/.gitkeep

# Theme preview screenshots (ThemePreviewGenerator) — runtime cache, never commit
/pub/theme_previews/**

# Agent/browser QA screenshot dumps under team channel dirs — local only, never commit
**/doc/**/channel/**/*-qa-shots/
**/doc/**/channel/**/qa-shots/
**/sitewide-click-qa-shots/
# Browser acceptance / page preview dumps in docs — local only, never commit
**/doc/**/evidence/
**/doc/**/meetings/evidence/
**/doc/**/page-previews/
**/doc/**/live-shots/
**/doc/**/wireframes/effects/

# Accidental cwd-relative writes when HOME was polluted to a site URL
/http:
/https:

# IDE / editor local config (do not commit)
.idea
.vscode
.cursor/
.trae/

# AI agent protocols — only AGENTS.md is committed; editor-local MCP/rules stay untracked
CLAUDE.md
CLAUDE.local.md
.mcp.json
.cursorrules
.cursorignore
.codex/
.github/copilot-instructions.md
GEMINI.md
.gemini/
.windsurfrules
.windsurf/
.aider*
opencode.json
AGENTS.local.md

