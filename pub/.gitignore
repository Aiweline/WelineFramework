# 忽略pub目录下的所有文件和目录
*
!.gitignore

# 保留这些目录
!static/
!static/.gitkeep
# media：只保留目录占位 .gitkeep，禁止跟踪任何上传/生成的媒体文件
!media/
!media/.gitkeep
media/**
!media/.gitkeep
!source/
!source/**

# 保留 sitemaps 目录
!sitemaps/.gitkeep

# 保留cli-server-router.php
!cli-server-router.php

# 保留 HTTP 状态回执页（站点可覆盖同路径文件）
!errors/
!errors/**
