# 忽略pub目录下的所有文件和目录
*
!.gitignore

# 保留这些目录
!static/
!static/.gitkeep
# media：只保留目录占位 .gitkeep，禁止跟踪任何上传/生成的媒体文件
!media/
!media/.gitkeep
media/**
!media/.gitkeep
# theme_previews：ThemePreviewGenerator 截图缓存；禁止添加 !theme_previews 解除忽略
!source/
!source/**

# 保留 sitemaps 目录
!sitemaps/.gitkeep

# 保留cli-server-router.php
!cli-server-router.php

# 保留站点 Web 入口（与 cli-server-router.php 同为 pub 白名单）
!index.php

# 保留 HTTP 状态回执页 PHP 模板（站点可覆盖同路径文件）
!errors/
!errors/**
# 维护页 / 前台 404 静态快照由 setup:upgrade 等生成，禁止入库
errors/maintenance/
errors/storefront-not-found/