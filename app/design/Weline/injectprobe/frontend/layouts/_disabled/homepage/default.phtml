<?php
/**
 * injectprobe homepage — minimal storefront shell for injection bake acceptance.
 *
 * @meta.name {default="injectprobe 首页",name="injectprobe 首页"}
 * @meta.description {default="注入探针首页：极简 content，依赖 Footer 故意无 float 层",name="页面描述"}
 * @param.showHeader {default=true,name="Show Header"}
 * @param.showFooter {default=true,name="Show Footer"}
 * @param.class {default="",name="Extra CSS class"}
 */
$meta = $this->getData('meta') ?? [];
if (!is_array($meta)) {
    $meta = [];
}
$meta['showHeader'] = ($meta['showHeader'] ?? $this->getData('showHeader') ?? true);
$meta['showFooter'] = ($meta['showFooter'] ?? $this->getData('showFooter') ?? true);
$this->assign('meta', $meta);
$class = htmlspecialchars((string)($meta['class'] ?? ''), ENT_QUOTES, 'UTF-8');
?>
<main id="homepage-main"
      class="theme-layout-homepage injectprobe-homepage <?= $class ?>"
      data-layout-type="homepage"
      data-injectprobe-theme="1">
    <w:slot id="content"
            name="主内容"
            accept="content,container,banner,promo-banner"
            multiple="true"
            append="true"
            position="content"
            class="injectprobe-homepage__content">
        <section class="injectprobe-homepage__hero" data-testid="injectprobe-hero">
            <h1>injectprobe</h1>
            <p>故意裁掉 Footer 悬浮层 — 验收 required 固化与进店音乐/客服注入。</p>
        </section>
    </w:slot>
</main>
