$proofParts = static function (string $label): array {
    $label = trim($label);
    $known = [
        'PHP 8.4+' => ['PHP 8.4+', '运行时基线'],
        'MIT 许可' => ['MIT', '开源许可'],
        '127 个已注册模块' => ['127', '个已注册模块'],
        'WLS + FPM' => ['WLS + FPM', '双运行时'],
    ];
    if (isset($known[$label])) {
        return $known[$label];
    }
    if (preg_match('/^(\d+)\s*(.*)$/u', $label, $matches) === 1) {
        return [$matches[1], trim($matches[2])];
    }

    return [$label, ''];
};
