    'company' => 'fCompany',
    'stack' => 'fStack',
    'market' => 'fMarket',
    'volume_band' => 'fVolume',
    'timeline' => 'fTimeline',
    'message' => 'fMessage',
    'consent' => 'fConsent',
];
$labelOf = static function (string $key, string $fallback) use ($fields): string {
    $label = (string)($fields[$key]['label'] ?? '');

    return $label !== '' ? $label : $fallback;
};
$errOf = static function (string $key) use ($errors): string {
    return trim((string)($errors[$key] ?? ''));
};
$valueOf = static function (string $key) use ($values): string {
    return (string)($values[$key] ?? '');
};
$invalidClass = static function (string $key) use ($errOf): string {
    return $errOf($key) !== '' ? ' invalid' : '';
};
$errId = static function (string $key) use ($fieldIds): string {
    return ($fieldIds[$key] ?? 'f' . $key) . 'Err';
};
$formError = $errOf('form');
$statusMessage = $message !== '' ? $message : $formError;
if ($statusMessage === '') {
    $statusMessage = match ($status) {
        'invalid' => '还有必填项没有完成，请检查标红的字段。',
        'rate_limited' => '提交过于频繁，请稍后再试，或直接使用下方邮件地址。',
        'new' => '邮件服务未配置或暂不可用，请使用下方邮件地址联系我们。',
        'failed' => '发送失败，请使用下方邮件地址联系我们。',
        default => '',
    };
}
$isSuccess = $status === 'sent';
$statusKind = $isSuccess ? 'ok' : (in_array($status, ['invalid', 'failed', 'rate_limited', 'new'], true) ? 'err' : '');
