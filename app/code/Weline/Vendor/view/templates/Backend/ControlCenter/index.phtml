<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('商家管理'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$form = (array)($this->getData('workspace_form') ?? []);
$kind = (string)($form['kind'] ?? '');
$formActionUrl = $form === [] ? '' : $this->getBackendUrl((string)($form['action'] ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string { if (is_bool($value)) return $value ? (string)__('是') : (string)__('否'); if (is_array($value)) return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]'); return $escape($value); };
?>
<section class="commerce-control-center" data-testid="vendor-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between"><h4 style="--w-mb-sm:0;"><?= $escape($title) ?></h4><span class="w-badge <?= $form === [] ? 'bg-info text-dark' : 'bg-success' ?>"><?= $form === [] ? __('只读诊断') : __('可管理') ?></span></div>
    <div class="w-alert" role="status" data-tone="info"><?= $form === [] ? __('此页面只显示脱敏业务事实；冲正与生产迁移不在普通后台执行。') : __('写操作复用 Vendor 领域服务与 rollout 门禁；结算只调度内部账本，不调用外部资金接口。') ?></div>
    <?php if ($form !== []): ?>
        <div class="w-card" data-testid="vendor-<?= $escape($code) ?>-write-form" style="--w-mb:var(--weline-space-4);">
            <div class="w-card__header"><h5 style="--w-mb:0;"><?= __('业务操作') ?></h5></div>
            <div class="w-card__body"><w:form method="post" action="@var($formActionUrl)"><div class="w-grid" style="--w-gap:var(--weline-space-4);">
                <?php if ($kind === 'vendor'): ?>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('商家代码') ?></label><input class="w-input" name="code" maxlength="64" required></div>
                    <div style="--w-span-md:4;"><label class="w-field__label"><?= __('法定名称') ?></label><input class="w-input" name="legal_name" maxlength="255" required></div>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('环境') ?></label><select class="w-select" name="environment"><option value="sandbox">sandbox</option><option value="live">live</option></select></div>
                <?php elseif ($kind === 'authorization'): ?>
                    <div style="--w-span-md:5;"><label class="w-field__label"><?= __('商家 ID') ?></label><input class="w-input" name="vendor_id" maxlength="64" required></div>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('网站 ID') ?></label><input class="w-input" type="number" min="0" name="website_id" value="0" required></div>
                <?php elseif ($kind === 'product-binding'): ?>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('商家 ID') ?></label><input class="w-input" name="vendor_id" maxlength="64" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('网站 ID') ?></label><input class="w-input" type="number" min="0" name="website_id" value="0" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('店铺 ID') ?></label><input class="w-input" type="number" min="1" name="store_id" required></div>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('SKU') ?></label><input class="w-input" name="product_sku" maxlength="128" required></div>
                <?php elseif ($kind === 'split-rule'): ?>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('商家 ID') ?></label><input class="w-input" name="vendor_id" maxlength="64" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('网站 ID') ?></label><input class="w-input" type="number" min="0" name="website_id" value="0" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('平台佣金（基点）') ?></label><input class="w-input" type="number" min="0" max="10000" name="commission_bps" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('货币') ?></label><input class="w-input" name="currency" value="CNY" maxlength="3" required></div>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('法定实体') ?></label><input class="w-input" name="legal_entity" maxlength="255"></div>
                <?php elseif ($kind === 'payout'): ?>
                    <div style="--w-span-md:5;"><label class="w-field__label"><?= __('不可变快照 ID') ?></label><input class="w-input" name="snapshot_id" maxlength="64" required></div>
                    <div style="--w-span-md:5;"><label class="w-field__label"><?= __('幂等键') ?></label><input class="w-input" name="idempotency_key" maxlength="128" required></div>
                <?php endif; ?>
                <div class="w-cluster" data-align="end" style="--w-span-md:2;"><button class="w-button" type="submit" data-testid="vendor-<?= $escape($code) ?>-submit" data-w-width="full" data-tone="primary"><?= $kind === 'payout' ? __('调度结算') : __('保存') ?></button></div>
            </div></w:form></div>
        </div>
    <?php endif; ?>
    <?php if ($status !== []): ?><div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__body"><div class="w-grid" style="--w-gap:var(--weline-space-4);"><?php foreach ($status as $key => $value): ?><div style="--w-span-md:4;"><div class="w-text" data-tone="muted" data-size="sm"><?= $escape($key) ?></div><div class="w-text" data-weight="strong"><?= $display($value) ?></div></div><?php endforeach; ?></div></div></div><?php endif; ?>
    <?php foreach ($datasets as $dataset): ?><div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__header"><h5 style="--w-mb:0;"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="w-card__body">
        <?php if (!empty($dataset['error'])): ?><div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div><?php elseif (empty($dataset['rows'])): ?><div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div><?php else: ?>
        <div class="w-table-wrap"><table class="w-table" data-w-vertical="middle" style="--w-mb:0;"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody><?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
