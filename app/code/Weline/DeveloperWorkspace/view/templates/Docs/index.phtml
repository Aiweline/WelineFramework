        'emptySearch' => (string)__('没有找到匹配的文档'),
        'requestFailed' => (string)__('文档加载失败，请稍后重试'),
        'catalogs' => (string)__('分类'),
        'documents' => (string)__('文档'),
        'search' => (string)__('搜索'),
        'copy' => (string)__('复制'),
        'copied' => (string)__('已复制'),
        'copyFailed' => (string)__('复制失败'),
        'fullscreen' => (string)__('全屏'),
        'fullscreenClose' => (string)__('关闭'),
        'i18nPlaceholder' => (string)__('翻译占位变量'),
        'toc' => (string)__('目录'),
        'tocShow' => (string)__('显示目录'),
        'tocHide' => (string)__('隐藏目录'),
    ],
];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG
