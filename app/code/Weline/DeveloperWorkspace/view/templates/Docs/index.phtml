/** @var \Weline\Framework\View\Template $this */
$document = $this->getData('document');
$currentLanguage = (string)($this->getData('currentLanguage') ?: 'zh_Hans_CN');
$documentId = $document && $document->getId()
    ? (int)$document->getId()
    : (int)($this->request->getParam('id') ?? 0);
$catalogId = $document && $document->getId()
    ? (int)$document->getCategoryId()
    : (int)($this->request->getParam('catalog_id') ?? 0);
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$themeSystemLabel = $escape(__('跟随系统'));
$themeLightLabel = $escape(__('明亮模式'));
$themeDarkLabel = $escape(__('暗黑模式'));
$themeMenuLabel = $escape(__('主题模式'));
$uiAssetVersion = static function (string $relative): string {
    $path = BP . 'app/code/Weline/Theme/view/statics/ui/' . ltrim($relative, '/');
    if (!is_file($path)) {
        return '0';
    }
    $hash = hash_file('sha256', $path);
    return is_string($hash) ? substr($hash, 0, 16) : '0';
};
$config = [
    'baseUrl' => rtrim((string)$this->getUrl('dev/tool'), '/'),
    'documentId' => $documentId,
    'catalogId' => $catalogId,
    'locale' => $currentLanguage,
    'text' => [
        'loading' => (string)__('加载中…'),
        'chooseCatalog' => (string)__('请选择分类查看文档'),
