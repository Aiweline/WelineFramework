<?php
/**
 * 新增/编辑开发文档（内容模板）
 * 
 * 由布局系统自动包裹 HTML 框架
 *
 * @var \Weline\Framework\View\Template $this
 */
?>
<!-- 页面标题 -->
<div class="w-grid">
    <div style="--w-span-lg:12;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title">
                    <lang>管理开发文档</lang>
                </h4>
                <p class="w-text" data-tone="muted">
                    <lang>开发文档编辑器 有新的开发文档时可以随时编辑</lang>
                </p>
                <w:form class="w-form" method="post" action="@admin-url('dev/tool/admin/document/post')">
                    <label>
                        <input type="text" class="w-visually-hidden" name="id" value="@var{$document['id']}">
                    </label>
                    <div class="w-grid">
                        <div style="--w-span:6;">

                        </div>
                        <div style="--w-span:6;">
                            <button type='submit' class="w-button" data-tone="primary">
                                <lang>保存</lang>
                            </button>
                            <button type="button" class="w-button" data-w-component="history-back" data-w-fallback="@admin-url('dev/tool/admin/document')" data-tone="neutral">
                                <lang>返回</lang>
                            </button>
                        </div>
                    </div>
                    <div class="w-grid">
                        <div style="--w-span-md:6;">
                            <div data-w-position="relative" style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label" for='title'>
                                    <lang>标题</lang>
                                </label>
                                <input type='text' name='title' class="w-input" id='title' placeholder='@lang(标题)' value='@var($document.title)' required>
                                <div class="w-field__hint">
                                    <lang>请输入标题</lang>
                                </div>
                            </div>
                        </div>
                        <div style="--w-span-md:3;">
                            <div data-w-position="relative" style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label" for='author'>
                                    <lang>作者</lang>
                                </label>
                                <div class="w-field__control">
                                    <div class="w-field__prefix">
                                        <span class="w-field__addon" id='authorPrepend'>@</span>
                                    </div>
                                    <select name='author_id' class="w-select" id='author' aria-describedby='authorPrepend' required>
                                        <foreach name="users">
                                            <if condition="document.author_id === v.user_id">
                                                <option value="{{v.user_id}}" selected>
                                                    {{v.username}}
                                                </option>
                                                <else/>
                                                <option value="{{v.user_id}}">
                                                    {{v.username}}
                                                </option>
                                            </if>
                                        </foreach>
                                    </select>
                                    <div class='w-field__error'>
                                        <lang>请输入作者</lang>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="--w-span-md:6;">
                            <div data-w-position="relative" style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label" for='summary'>
                                    <lang>摘要</lang>
                                </label>
                                <textarea type='text' name='summary' class="w-textarea" id='summary' placeholder='@lang(摘要)' required>@var{$document->getSummary()}</textarea>
                                <div class='w-field__error'>
                                    <lang>请输入摘要</lang>
                                </div>
                            </div>
                        </div>
                        <div style="--w-span-md:3;">
                            <div data-w-position="relative" style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label" for='category'>
                                    <lang>分类</lang>
                                </label>
                                <select name='category_id' class="w-select" id='category'>
                                    <w:foreach name='catalogs' item='v'>
                                        <w:if condition="document.category_id === v.id">
                                            <option value="@var{$v.id}" selected>
                                                <var>$v.name</var>
                                            </option>
                                            <w:else/>
                                            <option value="@var{$v.id}">
                                                <var>$v.name</var>
                                            </option>
                                        </w:if>
                                        <w:notempty name="$v.nodes">    
                                            <w:foreach name="$v.nodes" item="node">
                                                <w:if condition="$document.category_id === $node.id">
                                                    <option value="@var{$node.id}"
                                                            selected>
                                                        <w:php>echo str_pad('-',$node['level']);</w:php>
                                                        <w:var>$node.name</w:var>
                                                    </option>
                                                    <w:else/>
                                                    <option value="@var{$node.id}">
                                                        <w:php>echo str_pad('-',$node['level']);</w:php>
                                                        <w:var>$node.name</w:var>
                                                    </option>
                                                </w:if>
                                            </w:foreach>
                                        </w:notempty>
                                    </w:foreach>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="w-grid">
                        <div style="--w-span-md:12;">
                            <div data-w-position="relative" style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label" for='elm1'>
                                    <lang>文章内容</lang>
                                </label>
                                <textarea id='elm1'
                                          name='content'
                                          class="w-textarea"
                                          data-w-component="tinymce"
                                          data-w-editor-engine="@static(Weline_DeveloperWorkspace::engines/tinymce/tinymce.min.js)"
                                          data-w-editor-language="zh_CN"
                                          data-w-editor-language-source="@static(Weline_DeveloperWorkspace::engines/tinymce/langs/zh_CN.js)"
                                          data-w-editor-upload-url="@admin-url('dev/tool/admin/document/upload')"
                                          required>@var{$document->getContent()}</textarea>
                                <div class='w-field__error'>
                                    <lang>文章内容不能为空</lang>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button class="w-button" type='submit' data-tone="primary">
                        <lang>保存</lang>
                    </button>
                </w:form>
            </div>
        </div>
    </div>
</div>

<script type="module" src="@static(Weline_DeveloperWorkspace::js/document-editor.js)"></script>
