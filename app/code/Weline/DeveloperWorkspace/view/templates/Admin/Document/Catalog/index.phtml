<?php
/** @var \Weline\Framework\View\Template $this */
$catalogs = is_array($this->getData('catalogs')) ? $this->getData('catalogs') : [];
$catalog = $this->getData('catalog');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$catalogValue = static function (mixed $row, string $key, mixed $default = ''): mixed {
    if (is_array($row)) {
        return $row[$key] ?? $default;
    }
    if (is_object($row) && method_exists($row, 'getData')) {
        $value = $row->getData($key);
        return $value === null ? $default : $value;
    }
    return $default;
};
$selectedId = is_object($catalog) && method_exists($catalog, 'getId') ? max(0, (int)$catalog->getId()) : 0;
$isNew = (int)($this->request->getParam('new') ?? 0) === 1;
$editing = $isNew || $selectedId > 0;
$parentId = $isNew
    ? max(0, (int)($this->request->getParam('pid') ?? 0))
    : max(0, (int)$catalogValue($catalog, 'pid', 0));
$isSystem = !$isNew && (int)$catalogValue($catalog, 'is_system', 0) === 1;
$isActive = $isNew || (int)$catalogValue($catalog, 'is_active', 1) === 1;
$flatCatalogs = [];
$flatten = function (array $nodes, int $depth = 0, array $ancestors = []) use (&$flatten, &$flatCatalogs): void {
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        $id = max(0, (int)($node['id'] ?? 0));
        if ($id === 0) {
            continue;
        }
        $flatCatalogs[] = [
            'id' => $id,
            'name' => (string)($node['name'] ?? ''),
            'depth' => $depth,
            'ancestors' => $ancestors,
        ];
        $children = is_array($node['nodes'] ?? null) ? $node['nodes'] : [];
        if ($children !== []) {
            $flatten($children, $depth + 1, [...$ancestors, $id]);
        }
    }
};
$flatten($catalogs);
$catalogPageUrl = function (array $params = []): string {
    return (string)$this->getBackendUrl('dev/tool/admin/document/catalog', $params);
};
$renderTree = function (array $nodes) use (&$renderTree, $escape, $selectedId, $catalogPageUrl): void {
    if ($nodes === []) {
        return;
    }
    echo '<ul class="w-tree">';
    $count = count($nodes);
    foreach (array_values($nodes) as $index => $node) {
        if (!is_array($node)) {
            continue;
        }
        $id = max(0, (int)($node['id'] ?? 0));
        if ($id === 0) {
            continue;
        }
        $name = (string)($node['name'] ?? '');
        $pid = max(0, (int)($node['pid'] ?? 0));
        $level = max(1, (int)($node['level'] ?? 1));
        $system = (int)($node['is_system'] ?? 0) === 1;
        $children = is_array($node['nodes'] ?? null) ? $node['nodes'] : [];
        $rowState = $selectedId === $id ? 'selected' : ($system ? 'locked' : 'idle');
        echo '<li class="w-catalog-tree__item">';
        echo '<div class="w-tree__row w-catalog-tree__row" data-state="' . $rowState . '">';
        echo '<a class="w-catalog-tree__link" href="' . $escape($catalogPageUrl(['id' => $id])) . '"' . ($selectedId === $id ? ' aria-current="page"' : '') . '>';
        echo '<w-icon name="' . ($system ? 'settings' : 'folder') . '" size="sm"></w-icon><span>' . $escape($name) . '</span>';
        if ($system) {
            echo '<span class="w-badge" data-tone="info">' . $escape(__('系统')) . '</span>';
        }
        echo '</a>';
        if (!$system) {
            echo '<span class="w-catalog-tree__actions">';
            echo '<button class="w-button" type="button" data-tone="quiet" data-size="sm" data-catalog-reorder data-id="' . $id . '" data-pid="' . $pid . '" data-level="' . $level . '" data-position="' . max(1, $index) . '" aria-label="' . $escape(__('上移 %{1}', $name)) . '"' . ($index === 0 ? ' disabled' : '') . '><w-icon name="chevron-up" size="sm"></w-icon></button>';
            echo '<button class="w-button" type="button" data-tone="quiet" data-size="sm" data-catalog-reorder data-id="' . $id . '" data-pid="' . $pid . '" data-level="' . $level . '" data-position="' . min($count, $index + 2) . '" aria-label="' . $escape(__('下移 %{1}', $name)) . '"' . ($index >= $count - 1 ? ' disabled' : '') . '><w-icon name="chevron-down" size="sm"></w-icon></button>';
            echo '</span>';
        }
        echo '</div>';
        echo '<a class="w-catalog-tree__add" href="' . $escape($catalogPageUrl(['new' => 1, 'pid' => $id])) . '"><w-icon name="plus" size="sm"></w-icon>' . $escape(__('添加子分类')) . '</a>';
        if ($children !== []) {
            $renderTree($children);
        }
        echo '</li>';
    }
    echo '</ul>';
};
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-developer-catalogs.css)">

<section
    class="w-backend-page w-catalog-admin"
    data-catalog-admin
    data-text-save-success="<?= $escape(__('分类已保存')) ?>"
    data-text-save-failed="<?= $escape(__('分类保存失败')) ?>"
    data-text-delete-title="<?= $escape(__('删除分类')) ?>"
    data-text-delete-message="<?= $escape(__('删除分类会同时删除其子分类，且无法恢复。确定继续吗？')) ?>"
    data-text-delete-success="<?= $escape(__('分类已删除')) ?>"
    data-text-delete-failed="<?= $escape(__('分类删除失败')) ?>"
    data-text-reorder-success="<?= $escape(__('分类顺序已保存')) ?>"
    data-text-reorder-failed="<?= $escape(__('分类排序失败')) ?>"
>
    <header class="w-backend-page__heading">
        <div class="w-stack">
            <h1><w:icon name="tree" size="md"></w:icon><?= $escape(__('开发文档分类')) ?></h1>
            <p class="w-text" data-tone="muted"><?= $escape(__('使用键盘可操作的树形列表维护层级，通过上移和下移按钮调整同级顺序')) ?></p>
        </div>
        <nav class="w-cluster" aria-label="<?= $escape(__('分类管理操作')) ?>">
            <a class="w-button" data-tone="primary" href="<?= $escape($catalogPageUrl(['new' => 1])) ?>"><w:icon name="plus" size="sm"></w:icon><?= $escape(__('添加顶级分类')) ?></a>
            <a class="w-button" data-tone="neutral" href="@admin-url('dev/tool/admin/document')"><w:icon name="arrow-left" size="sm"></w:icon><?= $escape(__('返回文档')) ?></a>
        </nav>
    </header>

    <template>Weline_Component::message.phtml</template>

    <div class="w-catalog-admin__layout">
        <aside class="w-card w-catalog-admin__tree-card" aria-labelledby="catalog-tree-heading">
            <header class="w-card__header"><h2 class="w-card__title" id="catalog-tree-heading"><w:icon name="folder" size="sm"></w:icon><?= $escape(__('分类树')) ?></h2></header>
            <div class="w-card__body">
                <?php if ($catalogs !== []): ?>
                    <nav class="w-catalog-tree" aria-label="<?= $escape(__('文档分类树')) ?>"><?php $renderTree($catalogs); ?></nav>
                <?php else: ?>
                    <div class="w-empty"><w:icon name="folder" size="lg"></w:icon><p><?= $escape(__('暂无分类')) ?></p><a class="w-button" data-tone="primary" href="<?= $escape($catalogPageUrl(['new' => 1])) ?>"><?= $escape(__('添加分类')) ?></a></div>
                <?php endif; ?>
            </div>
        </aside>

        <main class="w-card w-catalog-admin__editor" aria-labelledby="catalog-editor-heading">
            <header class="w-card__header">
                <h2 class="w-card__title" id="catalog-editor-heading">
                    <w:icon name="<?= $isNew ? 'plus' : 'edit' ?>" size="sm"></w:icon>
                    <?= $escape($isNew ? __('添加分类') : ($selectedId > 0 ? __('编辑分类') : __('分类信息'))) ?>
                </h2>
            </header>
            <div class="w-card__body">
                <?php if (!$editing): ?>
                    <div class="w-empty"><w:icon name="folder" size="lg"></w:icon><p><?= $escape(__('请从左侧选择分类，或添加一个新分类')) ?></p></div>
                <?php else: ?>
                    <form class="w-form w-catalog-form" method="post" action="@admin-url('dev/tool/admin/document/catalog/post')" data-catalog-form>
                        <input type="hidden" name="id" value="<?= $selectedId ?>">
                        <label class="w-field">
                            <span class="w-field__label"><?= $escape(__('分类名称')) ?></span>
                            <input class="w-input" type="text" name="name" maxlength="60" required value="<?= $escape($isNew ? '' : $catalogValue($catalog, 'name', '')) ?>" <?= $isSystem ? 'readonly' : '' ?>>
                            <?php if ($isSystem): ?><span class="w-field__hint"><?= $escape(__('系统分类不能修改名称或父级')) ?></span><?php endif; ?>
                        </label>

                        <label class="w-field">
                            <span class="w-field__label"><?= $escape(__('分类描述')) ?></span>
                            <textarea class="w-textarea" name="description" rows="5"><?= $escape($isNew ? '' : $catalogValue($catalog, 'description', '')) ?></textarea>
                        </label>

                        <label class="w-field">
                            <span class="w-field__label"><?= $escape(__('父分类')) ?></span>
                            <?php if ($isSystem): ?>
                                <input type="hidden" name="pid" value="<?= $parentId ?>">
                            <?php endif; ?>
                            <select class="w-select" name="pid" <?= $isSystem ? 'disabled' : '' ?>>
                                <option value="0" <?= $parentId === 0 ? 'selected' : '' ?>><?= $escape(__('顶级分类')) ?></option>
                                <?php foreach ($flatCatalogs as $option): ?>
                                    <?php
                                    $optionId = (int)$option['id'];
                                    $isSelf = !$isNew && $optionId === $selectedId;
                                    $isDescendant = !$isNew && in_array($selectedId, $option['ancestors'], true);
                                    if ($isSelf || $isDescendant) { continue; }
                                    ?>
                                    <option value="<?= $optionId ?>" <?= $optionId === $parentId ? 'selected' : '' ?>><?= $escape(str_repeat('—', (int)$option['depth']) . $option['name']) ?></option>
                                <?php endforeach; ?>
                            </select>
                        </label>

                        <label class="w-switch">
                            <input type="hidden" name="is_active" value="0">
                            <input type="checkbox" name="is_active" value="1" <?= $isActive ? 'checked' : '' ?>>
                            <span><?= $escape(__('启用分类')) ?></span>
                        </label>

                        <?php if ($isSystem): ?>
                            <div class="w-alert" data-tone="info"><w:icon name="info" size="sm"></w:icon><div><strong><?= $escape(__('系统分类')) ?></strong><p><?= $escape(__('可修改描述和启用状态；名称、父级、排序及删除受保护。')) ?></p></div></div>
                        <?php endif; ?>

                        <footer class="w-catalog-form__actions w-cluster" data-justify="between">
                            <div>
                                <?php if (!$isNew && $selectedId > 0 && !$isSystem): ?>
                                    <button class="w-button" type="button" data-tone="danger" data-catalog-delete="<?= $selectedId ?>"><w:icon name="trash" size="sm"></w:icon><?= $escape(__('删除')) ?></button>
                                <?php endif; ?>
                            </div>
                            <div class="w-cluster">
                                <a class="w-button" data-tone="neutral" href="<?= $escape($catalogPageUrl()) ?>"><?= $escape(__('取消')) ?></a>
                                <button class="w-button" type="submit" data-tone="primary"><w:icon name="save" size="sm"></w:icon><?= $escape(__('保存')) ?></button>
                            </div>
                        </footer>
                    </form>
                <?php endif; ?>
            </div>
        </main>
    </div>
</section>

<script type="module" src="@static(Weline_Theme::ui/pages/weline-developer-catalogs.js)"></script>
