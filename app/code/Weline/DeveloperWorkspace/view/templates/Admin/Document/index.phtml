<?php
/** @var \Weline\Framework\View\Template $this */
$catalogs = is_array($this->getData('catalogs')) ? $this->getData('catalogs') : [];
$documents = is_iterable($this->getData('documents')) ? $this->getData('documents') : [];
$pagination = is_array($this->getData('pagination')) ? $this->getData('pagination') : [];
$locales = is_array($this->getData('documentLocales')) ? $this->getData('documentLocales') : [];
$selectedCategoryId = max(0, (int)($this->getData('selectedCategoryId') ?? 0));
$currentLocale = (string)($this->getData('currentDocumentLocale') ?: 'zh_Hans_CN');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$value = static function (mixed $row, string $key, mixed $default = ''): mixed {
    if (is_array($row)) {
        return $row[$key] ?? $default;
    }
    if (is_object($row) && method_exists($row, 'getData')) {
        $result = $row->getData($key);
        return $result === null ? $default : $result;
    }
    return $default;
};
$page = max(1, (int)($pagination['page'] ?? 1));
$pageSize = max(1, (int)($pagination['pageSize'] ?? 10));
$lastPage = max(0, (int)($pagination['lastPage'] ?? 0));
$totalSize = max(0, (int)($pagination['totalSize'] ?? 0));
$pageUrl = function (int $targetPage) use ($selectedCategoryId, $currentLocale, $pageSize): string {
    $params = [
        'page' => max(1, $targetPage),
        'pageSize' => $pageSize,
        'locale' => $currentLocale,
    ];
    if ($selectedCategoryId > 0) {
        $params['category_id'] = $selectedCategoryId;
    }
    return (string)$this->getBackendUrl('dev/tool/admin/document', $params);
};
$catalogUrl = function (int $categoryId) use ($currentLocale): string {
    $params = ['locale' => $currentLocale];
    if ($categoryId > 0) {
        $params['category_id'] = $categoryId;
    }
    return (string)$this->getBackendUrl('dev/tool/admin/document', $params);
};
$renderCatalogs = function (array $nodes) use (&$renderCatalogs, $escape, $selectedCategoryId, $catalogUrl): void {
    if ($nodes === []) {
        return;
    }
    echo '<ul class="w-tree">';
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        $id = max(0, (int)($node['id'] ?? 0));
        if ($id === 0) {
            continue;
        }
        $children = is_array($node['nodes'] ?? null) ? $node['nodes'] : [];
        $active = $id === $selectedCategoryId;
        echo '<li class="w-document-tree__item">';
        if ($children !== []) {
            echo '<details class="w-document-tree__branch" open>';
            echo '<summary class="w-tree__row">';
            echo '<w-icon name="folder" size="sm"></w-icon>';
            echo '<a class="w-document-tree__link" href="' . $escape($catalogUrl($id)) . '"' . ($active ? ' aria-current="page"' : '') . '>' . $escape($node['name'] ?? '') . '</a>';
            echo '</summary>';
            $renderCatalogs($children);
            echo '</details>';
        } else {
            echo '<div class="w-tree__row">';
            echo '<w-icon name="file" size="sm"></w-icon>';
            echo '<a class="w-document-tree__link" href="' . $escape($catalogUrl($id)) . '"' . ($active ? ' aria-current="page"' : '') . '>' . $escape($node['name'] ?? '') . '</a>';
            echo '</div>';
        }
        echo '</li>';
    }
    echo '</ul>';
};
