<?php
$scope_key = $scope_key ?? '';
$guest_token = $guest_token ?? '';
$cart_type = $cart_type ?? '';
$cart_type_rows = $cart_type_rows ?? [];
$carts = $carts ?? [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$canQuery = $scope_key !== '' || strlen((string)$guest_token) >= 4;
?>
<div class="w-grid" data-testid="cart-inspection-management"><div style="--w-span:12;">
    <div class="w-backend-page__heading"><h4 class="w-backend-page__title"><?= __('购物车检查') ?></h4></div>
    <div class="w-alert" data-tone="info"><?= __('Inspection 按 scope_key 与/或 guest_token（完整或末 4+ 位）查询真实持久库；对照店面 Cookie weline_cart_guest_token。') ?></div>
    <?php if ($load_error !== ''): ?><div class="w-alert" data-tone="danger"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="w-card"><div class="w-card__body">
        <form method="get" class="w-grid" data-testid="cart-inspection-form" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
            <div style="--w-span-md:4;"><input class="w-input" name="scope_key" data-testid="cart-scope-key" value="<?= $escape($scope_key) ?>" placeholder="<?= __('完整 scope key（可选）') ?>"></div>
            <div style="--w-span-md:4;"><input class="w-input" name="guest_token" data-testid="cart-guest-token" value="<?= $escape($guest_token) ?>" placeholder="<?= __('guest_token 完整或末 4+ 位') ?>"></div>
            <div style="--w-span-md:2;">
                <select class="w-select" name="cart_type" data-testid="cart-type-filter">
                    <option value=""><?= __('全部类型') ?></option>
                    <?php foreach ($cart_type_rows as $row): ?>
                        <?php
                        $code = (string)($row['code'] ?? '');
                        if ($code === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($code) ?>" <?= $cart_type === $code ? 'selected' : '' ?>><?= $escape((string)($row['label'] ?? $code)) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div><button class="w-button" data-testid="cart-inspection-submit" type="submit" data-tone="primary"><?= __('检查') ?></button></div>
        </form>
        <div data-testid="cart-result-count" style="--w-mb:var(--weline-space-2);"><?= __('匹配购物车：%{1}', count($carts)) ?></div>
        <div class="w-table-wrap"><table class="w-table"><thead><tr>
            <th><?= __('Scope') ?></th><th><?= __('类型') ?></th><th><?= __('所有者类型') ?></th><th><?= __('所有者') ?></th><th><?= __('货币') ?></th><th><?= __('商品数') ?></th><th><?= __('过期') ?></th><th><?= __('更新') ?></th>
        </tr></thead><tbody>
        <?php if (!$canQuery): ?><tr><td colspan="8" class="w-text" data-align="center" data-tone="muted"><?= __('请输入 scope key 或 guest_token（至少 4 位）') ?></td></tr>
        <?php elseif ($carts === []): ?><tr><td colspan="8" class="w-text" data-align="center" data-tone="muted"><?= __('未找到购物车') ?></td></tr>
        <?php else: foreach ($carts as $cart): ?>
            <?php
            $tone = (string)($cart['cart_type_tone'] ?? 'secondary');
            if ($tone === 'muted') {
                $tone = 'secondary';
            }
            ?>
            <tr data-testid="cart-inspection-row">
            <td><code><?= $escape($cart['scope_key'] ?? '') ?></code></td>
            <td><span class="w-badge" data-tone="<?= $escape($tone) ?>" data-testid="cart-type-badge"><?= $escape($cart['cart_type_label'] ?? '') ?></span></td>
            <td><?= $escape($cart['owner_kind'] ?? '') ?></td>
            <td><?= $escape($cart['owner_id'] ?? '') ?></td>
            <td><?= $escape($cart['currency'] ?? '') ?></td>
            <td><?= (int)($cart['item_count'] ?? 0) ?></td>
            <td><?= $escape($cart['expires_at'] ?? '') ?></td>
            <td><?= $escape($cart['updated_at'] ?? '') ?></td>
        </tr><?php endforeach; endif; ?>
        </tbody></table></div>
    </div></div>
</div></div>
