<script>
(function () {
    'use strict';

    const root = document.querySelector('[data-weline-cart]');
    if (!root) {
        return;
    }

    const copy = <?= json_encode($copy, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    const stateNodes = Array.from(root.querySelectorAll('[data-cart-state]'));
    const itemsNode = root.querySelector('[data-cart-items]');
    const countNode = root.querySelector('[data-cart-count]');
    const subtotalNode = root.querySelector('[data-cart-subtotal]');
    const grandTotalNode = root.querySelector('[data-cart-grand-total]');
    const errorNode = root.querySelector('[data-cart-error]');
    const messageNode = root.querySelector('[data-cart-message]');
    const retryButton = root.querySelector('[data-cart-retry]');
    const guestTokenStorageKey = 'weline.cart.guest_token';
    let cartApi = null;

    function cartIdentity() {
        try {
            const guestToken = String(window.sessionStorage.getItem(guestTokenStorageKey) || '').trim();
            return guestToken ? { guest_token: guestToken } : {};
        } catch (error) {
            return {};
        }
    }

    function text(value) {
        return value == null ? '' : String(value);
    }

    function setText(node, value) {
        if (node) {
            node.textContent = text(value);
        }
    }

    function showState(state) {
        stateNodes.forEach(function (node) {
            node.hidden = node.dataset.cartState !== state;
        });
        root.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    }

    function amountFromMinor(item, minorKey, decimalKey) {
        const minor = Number(item && item[minorKey]);
        if (Number.isFinite(minor)) {
            return minor / 100;
        }
        const decimal = Number(item && item[decimalKey]);
        return Number.isFinite(decimal) ? decimal : 0;
    }

    function money(amount, currency) {
        const numericAmount = Number(amount || 0);
        const formattedAmount = new Intl.NumberFormat(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }).format(Number.isFinite(numericAmount) ? numericAmount : 0);
        return (text(currency).trim() || 'CNY') + ' ' + formattedAmount;
    }

    function cell(label, value) {
        const node = document.createElement('td');
        node.dataset.label = label;
        node.textContent = text(value);
        return node;
    }

    function productCell(item) {
        const node = document.createElement('td');
        node.dataset.label = copy.product;
        const name = document.createElement('strong');
        name.textContent = text(item && item.name);
        node.appendChild(name);
        const skuValue = text(item && item.sku).trim();
        if (skuValue) {
            const sku = document.createElement('small');
            sku.textContent = 'SKU: ' + skuValue;
            node.appendChild(sku);
        }
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'weline-cart-shell__action weline-cart-shell__action--remove';
        remove.dataset.cartAction = 'remove';
        remove.dataset.itemId = text(item && item.item_id);
        remove.textContent = copy.remove;
        remove.setAttribute('aria-label', copy.remove + ' ' + text(item && item.name));
        node.appendChild(remove);
        return node;
    }

    function quantityCell(item, quantity) {
        const node = document.createElement('td');
        node.dataset.label = copy.quantity;
        const controls = document.createElement('div');
        controls.className = 'weline-cart-shell__quantity-controls';
        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'weline-cart-shell__quantity-input';
        input.min = '1';
        input.max = String(Math.max(1, Number(item && item.stock) || 999));
        input.value = String(quantity);
        input.dataset.cartQuantity = text(item && item.item_id);
        input.setAttribute('aria-label', copy.quantity + ' ' + text(item && item.name));
        const update = document.createElement('button');
        update.type = 'button';
        update.className = 'weline-cart-shell__action';
        update.dataset.cartAction = 'update';
        update.dataset.itemId = text(item && item.item_id);
        update.textContent = copy.update;
        controls.appendChild(input);
        controls.appendChild(update);
        node.appendChild(controls);
        return node;
    }

    function render(summary) {
        const items = Array.isArray(summary && summary.items) ? summary.items : [];
        if (!items.length || Boolean(summary && summary.is_empty)) {
            showState('empty');
            return;
        }

        itemsNode.textContent = '';
        const currency = text(summary && summary.currency || items[0] && items[0].currency || 'CNY');
        items.forEach(function (item) {
            const row = document.createElement('tr');
            const quantity = Math.max(1, Number(item && (item.qty || item.quantity)) || 1);
            row.appendChild(productCell(item));
            row.appendChild(cell(copy.price, money(amountFromMinor(item, 'unit_price_minor', 'price'), currency)));
            row.appendChild(quantityCell(item, quantity));
            row.appendChild(cell(copy.subtotal, money(amountFromMinor(item, 'row_total_minor', 'row_total'), currency)));
            itemsNode.appendChild(row);
        });

        const count = Number(summary && (summary.cart_count ?? summary.item_count)) || 0;
        const subtotal = amountFromMinor(summary, 'subtotal_minor', 'subtotal');
        const grandTotal = amountFromMinor(summary, 'grand_total_minor', 'grand_total');
        setText(countNode, count);
        setText(subtotalNode, money(subtotal, currency));
        setText(grandTotalNode, money(grandTotal, currency));
        showState('ready');
    }

    async function getCartApi() {
        if (cartApi) {
            return cartApi;
        }
        if (!window.Weline || typeof Weline.load !== 'function') {
            throw new Error(copy.loadFailed);
        }
        const api = await Weline.load('api');
        cartApi = await api.resource('cart');
        return cartApi;
    }

    async function loadCart() {
        showState('loading');
        try {
            const cart = await getCartApi();
            const result = await cart.getV2Cart(cartIdentity());
            const summary = result && result.data && typeof result.data === 'object' ? result.data : result;
            if (!summary || summary.success === false) {
                throw new Error(text(summary && summary.message) || copy.loadFailed);
            }
            render(summary);
        } catch (error) {
            setText(errorNode, error && error.message ? error.message : copy.loadFailed);
            showState('error');
        }
    }

    if (retryButton) {
        retryButton.addEventListener('click', loadCart);
    }

    root.addEventListener('click', async function (event) {
        const button = event.target.closest('[data-cart-action]');
        if (!button || button.disabled) {
            return;
        }
        const itemId = text(button.dataset.itemId).trim();
        const action = text(button.dataset.cartAction);
        const quantityInput = root.querySelector('[data-cart-quantity="' + CSS.escape(itemId) + '"]');
        button.disabled = true;
        root.setAttribute('aria-busy', 'true');
        setText(messageNode, '');
        messageNode && messageNode.classList.remove('is-error');
        try {
            const cart = await getCartApi();
            const params = Object.assign(cartIdentity(), { item_id: itemId });
            const result = action === 'remove'
                ? await cart.removeV2(params)
                : await cart.updateV2(Object.assign(params, {
                    qty: Math.max(1, Number(quantityInput && quantityInput.value) || 1),
                }));
            const summary = result && result.data && typeof result.data === 'object' ? result.data : result;
            if (!summary || summary.success === false) {
                throw new Error(text(summary && summary.message) || copy.mutationFailed);
            }
            setText(messageNode, text(summary.message));
            render(summary);
        } catch (error) {
            setText(messageNode, error && error.message ? error.message : copy.mutationFailed);
            messageNode && messageNode.classList.add('is-error');
            button.disabled = false;
        } finally {
            root.setAttribute('aria-busy', 'false');
        }
    });

    loadCart();
})();
</script>
