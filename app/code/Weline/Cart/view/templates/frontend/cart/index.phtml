<script>
(function () {
    'use strict';

    const root = document.querySelector('[data-weline-cart]');
    if (!root) {
        return;
    }

    const copy = <?= json_encode($copy, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    const stateNodes = Array.from(root.querySelectorAll('[data-cart-state]'));
    const itemsNode = root.querySelector('[data-cart-items]');
    const subtitleNode = root.querySelector('[data-cart-subtitle]');
    const subtotalLabelNode = root.querySelector('[data-cart-subtotal-label]');
    const grandTotalNode = root.querySelector('[data-cart-grand-total]');
    const goodsSubtotalNode = root.querySelector('[data-cart-goods-subtotal]');
    const discountBreakdownNode = root.querySelector('[data-cart-discount-breakdown]');
    const discountLinesNode = root.querySelector('[data-cart-discount-lines]');
    const errorNode = root.querySelector('[data-cart-error]');
    const messageNode = root.querySelector('[data-cart-message]');
    const retryButton = root.querySelector('[data-cart-retry]');
    const checkoutNode = root.querySelector('[data-cart-checkout]');
    const summaryRoot = root.querySelector('.weline-cart-shell__summary');
    const siblingsNode = root.querySelector('[data-cart-siblings]');
    const guestTokenStorageKey = 'weline.cart.guest_token';
    let cartApi = null;
    let guestToken = '';
    let cartLoadSeq = 0;

    function discountPreview(summary) {
        if (!summary || typeof summary !== 'object' || !summary.discount_preview) {
            return null;
        }
        return summary.discount_preview;
    }

    function discountAmountMajor(summary) {
        const preview = discountPreview(summary);
        if (!preview) {
            return 0;
        }
        const minor = Number(preview.amount_minor || 0);
        if (minor <= 0) {
            return 0;
        }
        const precision = Number(preview.currency_precision == null ? 2 : preview.currency_precision);
        return minor / Math.pow(10, precision);
    }

    function discountKindLabel(kind) {
        if (kind === 'stack') {
            return text(summaryRoot && summaryRoot.getAttribute('data-i18n-discount-stack') || '叠加优惠');
        }
        if (kind === 'coupon') {
            return text(summaryRoot && summaryRoot.getAttribute('data-i18n-discount-coupon') || '优惠券');
        }
        return text(summaryRoot && summaryRoot.getAttribute('data-i18n-discount-automatic') || '自动优惠');
    }

    function renderDiscountBreakdown(summary, currency, goodsSubtotal) {
        if (!discountBreakdownNode || !discountLinesNode) {
            return;
        }
        const preview = discountPreview(summary);
        const items = preview && Array.isArray(preview.items) ? preview.items : [];
        const precision = Number(preview && preview.currency_precision != null ? preview.currency_precision : 2);

        discountLinesNode.textContent = '';
        // Quote may return amount_minor without per-line items; still show one coupon row.
        let lines = items;
        if (!lines.length && preview && Number(preview.amount_minor || 0) > 0) {
            lines = [{
                label: String(preview.coupon_code || preview.label || '').trim(),
                coupon_code: String(preview.coupon_code || '').trim(),
                source: preview.coupon_code ? 'coupon' : 'automatic',
                kind: preview.coupon_code ? 'coupon' : 'automatic',
                amount_minor: Number(preview.amount_minor || 0),
                stackable: false,
            }];
        }
        if (!lines.length) {
            discountBreakdownNode.hidden = true;
            // Keep goods subtotal current for B2B credit deposit base even when breakdown is hidden.
            setText(goodsSubtotalNode, money(goodsSubtotal, currency));
            if (root) {
                root.setAttribute(
                    'data-cart-goods-subtotal-major',
                    String(isFinite(Number(goodsSubtotal)) && Number(goodsSubtotal) > 0 ? Number(goodsSubtotal) : 0)
                );
            }
            return;
        }

        discountBreakdownNode.hidden = false;
        setText(goodsSubtotalNode, money(goodsSubtotal, currency));
        if (root) {
            root.setAttribute(
                'data-cart-goods-subtotal-major',
                String(isFinite(Number(goodsSubtotal)) && Number(goodsSubtotal) > 0 ? Number(goodsSubtotal) : 0)
            );
        }

        lines.forEach(function (item) {
            if (!item || typeof item !== 'object') {
                return;
            }
            const minor = Number(item.amount_minor || 0);
            if (minor <= 0) {
                return;
            }
            const row = document.createElement('div');
            row.className = 'weline-cart-shell__discount-line';
            if (item.stackable || item.kind === 'stack') {
                row.classList.add('weline-cart-shell__discount-line--stack');
            }

            const label = document.createElement('span');
            const kind = String(item.kind || (item.source === 'coupon' ? 'coupon' : 'automatic'));
            const name = String(item.label || item.coupon_code || '').trim();
            label.textContent = discountKindLabel(kind) + (name ? ' ' + name : '');

            const amount = document.createElement('strong');
            amount.textContent = '-' + money(minor / Math.pow(10, precision), currency);

            row.appendChild(label);
            row.appendChild(amount);
            discountLinesNode.appendChild(row);
        });
    }

    function readStoredGuestToken() {
        if (window.WelineCart && typeof window.WelineCart.getGuestSession === 'function') {
            const session = window.WelineCart.getGuestSession();
            const sessionToken = session && session.token ? String(session.token).trim() : '';
            if (sessionToken) {
                return sessionToken;
            }
        }
        try {
            return String(window.sessionStorage.getItem(guestTokenStorageKey) || '').trim();
        } catch (error) {
            return '';
        }
    }

    try {
        guestToken = readStoredGuestToken();
    } catch (error) {
        // Storage can be unavailable in privacy-restricted browser contexts.
    }

    async function ensureGuestToken() {
        try {
            await Weline.load('cart');
            guestToken = readStoredGuestToken();
        } catch (error) {
            // The API fallback below can still establish a new guest session.
        }
        if (guestToken) {
            return guestToken;
        }

        const result = await (await getCartApi()).issueGuestToken({});
        const payload = result && result.data && typeof result.data === 'object' ? result.data : result;
        guestToken = String((payload && payload.guest_token) || (result && result.guest_token) || '').trim();
        if (!guestToken) {
            throw new Error(copy.guestTokenIssueFailed);
        }
        if (window.WelineCart && typeof window.WelineCart.rememberGuestSession === 'function') {
            window.WelineCart.rememberGuestSession(guestToken);
        } else {
            try {
                window.sessionStorage.setItem(guestTokenStorageKey, guestToken);
            } catch (error) {
                // The current cart request still owns the token even if storage is unavailable.
            }
        }
        return guestToken;
    }

    async function cartIdentity(forcedMode) {
        const token = await ensureGuestToken();
        const mode = forcedMode === 'tob' || forcedMode === 'toc'
            ? forcedMode
            : preferredCartType();
        return {
            guest_token: token,
            cart_type: mode,
            selling_mode: mode,
        };
    }

    function readSellingModeCookie() {
        try {
            const raw = String(document.cookie || '');
            const names = [];
            const site = window.site || {};
            const websiteId = String(site.website_id || site.websiteId || '').trim();
            if (websiteId !== '' && /^\d+$/.test(websiteId)) {
                names.push('weline_selling_mode_w' + websiteId);
            }
            raw.split(';').forEach(function (part) {
                const key = String(part.split('=')[0] || '').trim();
                if (/^weline_selling_mode_w\d+$/.test(key) && names.indexOf(key) === -1) {
                    names.push(key);
                }
            });
            names.push('weline_selling_mode');
            for (let i = 0; i < names.length; i += 1) {
                const match = raw.match(new RegExp('(?:^|; )' + names[i].replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)'));
                const value = match ? decodeURIComponent(match[1]).toLowerCase() : '';
                if (value === 'toc' || value === 'tob') {
                    return value;
                }
            }
            const fromSession = String(window.sessionStorage.getItem('weline_selling_mode') || '').toLowerCase();
            if (fromSession === 'toc' || fromSession === 'tob') {
                return fromSession;
            }
        } catch (error) {}
        return '';
    }

    function isCustomerLoggedIn() {
        try {
            const site = window.site || {};
            if (Number(site.user_id || site.userId || 0) > 0) {
                return true;
            }
            const b2b = document.querySelector('[data-b2b-selling-mode="1"]');
            if (b2b && String(b2b.getAttribute('data-customer-logged-in') || '0') === '1') {
                return true;
            }
        } catch (error) {}
        return false;
    }

    function preferredCartType() {
        // Default / guest = retail. tob cookie is only a post-login preference hint.
        if (!isCustomerLoggedIn()) {
            return 'toc';
        }
        try {
            if (window.WelineB2BSellingMode && typeof window.WelineB2BSellingMode.preferredMode === 'function') {
                const fromB2b = String(window.WelineB2BSellingMode.preferredMode() || '').trim().toLowerCase();
                if (fromB2b === 'tob' || fromB2b === 'toc') {
                    return fromB2b;
                }
            }
        } catch (error) {}
        const fromCookie = readSellingModeCookie();
        if (fromCookie === 'tob' || fromCookie === 'toc') {
            return fromCookie;
        }
        const fromRoot = String(root.getAttribute('data-cart-type') || '').trim().toLowerCase();
        return fromRoot === 'tob' ? 'tob' : 'toc';
    }

    function applyCartTypeChrome(mode) {
        const next = mode === 'tob' ? 'tob' : 'toc';
        root.setAttribute('data-cart-type', next);
        root.classList.toggle('is-cart-type-tob', next === 'tob');
    }

    // Mutations must target the cart currently painted on this page, not the
    // global selling-mode preference (which can still be toc while chrome shows tob).
    function activeCartType() {
        const fromRoot = String(root.getAttribute('data-cart-type') || '').trim().toLowerCase();
        if (fromRoot === 'tob' || fromRoot === 'toc') {
            return fromRoot;
        }
        return preferredCartType();
    }

    function isUsableLocalCartSummary(summary, mode) {
        if (!summary || typeof summary !== 'object' || summary.success === false) {
            return false;
        }
        if (summary.cart_count == null && !Array.isArray(summary.items)) {
            return false;
        }
        const reported = String(summary.cart_type || summary.selling_mode || '').toLowerCase();
        if (reported && reported !== mode) {
            return false;
        }
        return true;
    }

    function localCartSummaryHasItems(summary) {
        if (!summary || typeof summary !== 'object' || summary.is_empty === true) {
            return false;
        }
        if (Number(summary.cart_count || summary.item_count || 0) > 0) {
            return true;
        }
        return Array.isArray(summary.items) && summary.items.length > 0;
    }

    function clearLocalCartSummary(mode) {
        const next = mode === 'tob' ? 'tob' : 'toc';
        try {
            window.localStorage.removeItem('weline.cart.summary_cache.' + next);
        } catch (error) {}
        if (window.WelineCart && typeof window.WelineCart.clearCachedSummary === 'function') {
            try {
                window.WelineCart.clearCachedSummary({ cartType: next });
            } catch (clearError) {}
        }
    }

    // Sibling Persistence counts win over a stale empty Presentation bucket.
    function invalidateEmptyCachesClaimedBySiblings(summary) {
        const rows = summary && Array.isArray(summary.sibling_carts) ? summary.sibling_carts : [];
        rows.forEach(function (row) {
            if (!row || Number(row.item_count || row.cart_count || 0) <= 0) {
                return;
            }
            const type = String(row.cart_type || '').toLowerCase() === 'tob' ? 'tob' : 'toc';
            const cached = readLocalCartSummary(type);
            if (cached && !localCartSummaryHasItems(cached)) {
                clearLocalCartSummary(type);
            }
        });
    }

    function rememberLocalCartSummary(summary) {
        if (!summary || typeof summary !== 'object' || summary.success === false) {
            return;
        }
        const mode = String(summary.cart_type || summary.selling_mode || preferredCartType()).toLowerCase() === 'tob'
            ? 'tob'
            : 'toc';
        summary.cart_type = mode;
        summary.selling_mode = mode;
        let currency = String(summary.currency || '').trim().toUpperCase();
        if (!/^[A-Z]{3}$/.test(currency) && window.WelineCart && typeof window.WelineCart.currentDisplayCurrency === 'function') {
            currency = String(window.WelineCart.currentDisplayCurrency() || 'CNY').toUpperCase();
        }
        if (!/^[A-Z]{3}$/.test(currency)) {
            currency = 'CNY';
        }
        summary.currency = currency;
        const locale = window.WelineCart && typeof window.WelineCart.currentDisplayLocale === 'function'
            ? String(window.WelineCart.currentDisplayLocale() || '')
            : String(document.documentElement.getAttribute('lang') || '').replace(/-/g, '_');
        if (window.WelineCart && typeof window.WelineCart.rememberSummary === 'function') {
            try {
                window.WelineCart.rememberSummary(summary, { cart_type: mode, currency: currency, locale: locale });
            } catch (error) {}
        }
        try {
            const guest = window.WelineCart && typeof window.WelineCart.getGuestSession === 'function'
                ? window.WelineCart.getGuestSession()
                : null;
            window.localStorage.setItem('weline.cart.summary_cache.' + mode, JSON.stringify({
                guest_token: guest && guest.token ? String(guest.token).trim() : '',
                scope_key: String(summary.scope_key || ''),
                cart_type: mode,
                currency: currency,
                locale: locale,
                saved_at: Date.now(),
                summary: summary,
            }));
        } catch (error) {}
    }

    function readLocalCartSummary(mode) {
        const next = mode === 'tob' ? 'tob' : 'toc';
        const wantCurrency = window.WelineCart && typeof window.WelineCart.currentDisplayCurrency === 'function'
            ? String(window.WelineCart.currentDisplayCurrency() || 'CNY').toUpperCase()
            : 'CNY';
        const wantLocale = window.WelineCart && typeof window.WelineCart.currentDisplayLocale === 'function'
            ? String(window.WelineCart.currentDisplayLocale() || '')
            : String(document.documentElement.getAttribute('lang') || '').replace(/-/g, '_');
        if (window.WelineCart && typeof window.WelineCart.getCachedSummary === 'function') {
            try {
                const shared = window.WelineCart.getCachedSummary({
                    cartType: next,
                    currency: wantCurrency,
                    locale: wantLocale,
                    requireTokenMatch: true,
                });
                if (isUsableLocalCartSummary(shared, next)) {
                    const sharedCurrency = String(shared.currency || '').toUpperCase();
                    if (!sharedCurrency || sharedCurrency === wantCurrency) {
                        return Object.assign({}, shared, { cart_type: next, selling_mode: next });
                    }
                }
            } catch (error) {}
        }
        try {
            const raw = window.localStorage.getItem('weline.cart.summary_cache.' + next);
            if (!raw) {
                return null;
            }
            const data = JSON.parse(raw);
            if (!data || !isUsableLocalCartSummary(data.summary, next)) {
                return null;
            }
            let guestToken = '';
            try {
                if (window.WelineCart && typeof window.WelineCart.getGuestSession === 'function') {
                    const session = window.WelineCart.getGuestSession();
                    guestToken = session && session.token ? String(session.token).trim() : '';
                }
            } catch (tokenError) {
                guestToken = '';
            }
            const cachedToken = String(data.guest_token || '').trim();
            const summary = data.summary;
            const hasItems = !!(summary && summary.is_empty !== true
                && (Number(summary.cart_count || summary.item_count || 0) > 0
                    || (Array.isArray(summary.items) && summary.items.length > 0)));
            // Ghost-cart gate: non-empty local summary without matching guest_token is a miss.
            if (hasItems && (!guestToken || !cachedToken || guestToken !== cachedToken)) {
                return null;
            }
            const cachedCurrency = String(data.currency || (data.summary && data.summary.currency) || '').toUpperCase();
            if (!cachedCurrency || cachedCurrency !== wantCurrency) {
                return null;
            }
            const cachedLocale = String(data.locale || '').replace(/-/g, '_');
            if (wantLocale && cachedLocale && wantLocale.toLowerCase() !== cachedLocale.toLowerCase()) {
                return null;
            }
            return Object.assign({}, data.summary, { cart_type: next, selling_mode: next });
        } catch (error) {
            return null;
        }
    }

    function text(value) {
        return value == null ? '' : String(value);
    }

    function setText(node, value) {
        if (node) {
            node.textContent = text(value);
        }
    }

    function showState(state) {
        // Exclusive page shell: only one of loading|empty|error|ready may paint.
        // CSS `[data-cart-view]` + hidden/aria-hidden/inert — do not rely on hidden alone.
        const next = String(state || '').trim();
        const allowed = { loading: 1, empty: 1, error: 1, ready: 1 };
        const view = allowed[next] ? next : 'loading';
        root.setAttribute('data-cart-view', view);
        stateNodes.forEach(function (node) {
            const active = node.dataset.cartState === view;
            node.hidden = !active;
            if (active) {
                node.removeAttribute('hidden');
                node.removeAttribute('aria-hidden');
                node.removeAttribute('inert');
            } else {
                node.setAttribute('hidden', '');
                node.setAttribute('aria-hidden', 'true');
                node.setAttribute('inert', '');
            }
        });
        root.setAttribute('aria-busy', view === 'loading' ? 'true' : 'false');
    }

    // Paint-before-fetch: clear non-loading shells immediately (avoids SSR/a11y bleed).
    showState('loading');

    function amountFromMinor(item, minorKey, decimalKey) {
        const minor = Number(item && item[minorKey]);
        if (Number.isFinite(minor)) {
            return minor / 100;
        }
        const decimal = Number(item && item[decimalKey]);
        return Number.isFinite(decimal) ? decimal : 0;
    }

    function money(amount, currency) {
        const numericAmount = Number(amount || 0);
        const formattedAmount = new Intl.NumberFormat(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }).format(Number.isFinite(numericAmount) ? numericAmount : 0);
        return (text(currency).trim() || 'CNY') + ' ' + formattedAmount;
    }

    function subtotalItemsLabel(count) {
        const template = copy.subtotalItems || '';
        if (template.indexOf('%1') !== -1) {
            return template.replace('%1', String(count));
        }
        return copy.subtotal + ' (' + count + ')';
    }

    function siblingBrowseLabel(label, count) {
        const template = String(copy.siblingBrowse || '浏览%1 %2件商品');
        return template
            .replace(/%\{1\}|%1/g, String(label || ''))
            .replace(/%\{2\}|%2/g, String(count));
    }

    function formatLineOptions(item) {
        const options = item && Array.isArray(item.options) ? item.options : [];
        const parts = [];
        options.forEach(function (option) {
            if (!option || typeof option !== 'object') {
                return;
            }
            const label = text(option.label || option.code).trim();
            const value = text(option.value_label || option.value).trim();
            if (!label || !value) {
                return;
            }
            parts.push(label + ': ' + value);
        });
        if (parts.length) {
            return parts.join(' · ');
        }

        const selection = item && item.selection && typeof item.selection === 'object' ? item.selection : null;
        if (!selection) {
            return '';
        }
        Object.keys(selection).sort().forEach(function (code) {
            const value = text(selection[code]).trim();
            const axis = text(code).trim();
            if (axis && value) {
                parts.push(axis + ': ' + value);
            }
        });
        return parts.join(' · ');
    }

    function isDisplayableSwatchUrl(value) {
        const image = text(value).trim();
        if (!image) {
            return false;
        }
        if (/^asset:\/\//i.test(image)) {
            return false;
        }
        if (/^[a-z][a-z0-9+.-]*:/i.test(image) && !/^(https?:)?\/\//i.test(image)) {
            return false;
        }
        return true;
    }

    function appendLineOptions(details, item) {
        const options = item && Array.isArray(item.options) ? item.options : [];
        if (!options.length) {
            const fallback = formatLineOptions(item);
            if (!fallback) {
                return;
            }
            const optionsEl = document.createElement('small');
            optionsEl.className = 'weline-cart-shell__line-options';
            optionsEl.textContent = fallback;
            details.appendChild(optionsEl);
            return;
        }

        const list = document.createElement('ul');
        list.className = 'weline-cart-shell__line-options';
        options.forEach(function (option) {
            if (!option || typeof option !== 'object') {
                return;
            }
            const label = text(option.label || option.code).trim();
            const value = text(option.value_label || option.value).trim();
            if (!label || !value) {
                return;
            }
            const li = document.createElement('li');
            li.className = 'weline-cart-shell__line-option';
            const swatchImage = text(option.swatch_image).trim();
            const swatchColor = text(option.swatch_color).trim();
            if (isDisplayableSwatchUrl(swatchImage)) {
                const img = document.createElement('img');
                img.className = 'weline-cart-shell__line-option-swatch';
                img.src = swatchImage;
                img.alt = '';
                li.appendChild(img);
            } else if (swatchColor) {
                const swatch = document.createElement('span');
                swatch.className = 'weline-cart-shell__line-option-swatch weline-cart-shell__line-option-swatch--color';
                swatch.style.backgroundColor = swatchColor;
                swatch.setAttribute('aria-hidden', 'true');
                li.appendChild(swatch);
            }
            const copy = document.createElement('span');
            copy.className = 'weline-cart-shell__line-option-text';
            copy.textContent = label + ': ' + value;
            li.appendChild(copy);
            list.appendChild(li);
        });
        if (list.childNodes.length) {
            details.appendChild(list);
        }
    }

    function buildLine(item, currency) {
        const row = document.createElement('article');
        row.className = 'weline-cart-shell__line';
        row.dataset.cartLine = '1';
        const itemId = text(item && item.item_id).trim();
        if (itemId) {
            row.dataset.itemId = itemId;
        }
        // Pixel scrape hooks for remove_from_cart / view_cart (Visitor __getCartItems).
        const productId = text(item && (item.product_id || item.legacy_product_id || item.offer_id)).trim();
        if (productId) {
            row.dataset.productId = productId;
        }
        const lineName = text(item && item.name).trim();
        if (lineName) {
            row.dataset.productName = lineName;
            row.dataset.name = lineName;
        }
        if (currency) {
            row.dataset.currency = currency;
            row.dataset.pixelCurrency = currency;
        }
        const lineFound = !(item && Object.prototype.hasOwnProperty.call(item, 'found')) || Boolean(item.found);
        const lineSellable = !(item && Object.prototype.hasOwnProperty.call(item, 'sellable')) || Boolean(item.sellable);
        const lineBlocked = !lineFound || !lineSellable;
        if (lineBlocked) {
            row.classList.add('is-unavailable');
            row.dataset.cartLineBlocked = '1';
        }

        const quantity = Math.max(1, Number(item && (item.qty || item.quantity)) || 1);
        const maxQty = Math.max(1, Number(item && item.stock) || 999);
        const image = text(item && item.image).trim();
        const unitAmount = amountFromMinor(item, 'unit_price_minor', 'price');
        const rowAmount = amountFromMinor(item, 'row_total_minor', 'row_total');
        if (unitAmount > 0) {
            row.dataset.price = String(unitAmount);
            row.dataset.pixelValue = String(rowAmount > 0 ? rowAmount : unitAmount * quantity);
        }

        const media = document.createElement('div');
        media.className = 'weline-cart-shell__line-media';
        if (image) {
            const img = document.createElement('img');
            img.src = image;
            img.alt = '';
            media.appendChild(img);
        }

        const details = document.createElement('div');
        details.className = 'weline-cart-shell__line-details';

        const title = document.createElement('strong');
        title.className = 'weline-cart-shell__line-title';
        title.textContent = text(item && item.name);
        details.appendChild(title);

        const skuValue = text(item && item.sku).trim();
        if (skuValue) {
            const sku = document.createElement('small');
            sku.className = 'weline-cart-shell__line-sku';
            sku.textContent = 'SKU: ' + skuValue;
            details.appendChild(sku);
        }

        appendLineOptions(details, item);

        const issueText = text(item && item.message).trim();
        if (lineBlocked && issueText) {
            const issue = document.createElement('p');
            issue.className = 'weline-cart-shell__line-issue';
            issue.textContent = issueText;
            details.appendChild(issue);
        }

        const meta = document.createElement('div');
        meta.className = 'weline-cart-shell__line-meta';

        const qtyWrap = document.createElement('div');
        qtyWrap.className = 'weline-cart-shell__qty';

        const decrease = document.createElement('button');
        decrease.type = 'button';
        decrease.dataset.qtyDecrease = '1';
        decrease.dataset.itemId = itemId;
        decrease.setAttribute('aria-label', copy.decreaseQty);
        decrease.textContent = '−';
        if (quantity <= 1 || lineBlocked) {
            decrease.disabled = true;
        }

        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'weline-cart-shell__qty-input';
        input.min = '1';
        input.max = String(maxQty);
        input.value = String(quantity);
        input.dataset.cartQuantity = itemId;
        input.setAttribute('aria-label', copy.quantity + ' ' + text(item && item.name));
        if (lineBlocked) {
            input.disabled = true;
        }

        const increase = document.createElement('button');
        increase.type = 'button';
        increase.dataset.qtyIncrease = '1';
        increase.dataset.itemId = itemId;
        increase.setAttribute('aria-label', copy.increaseQty);
        increase.textContent = '+';
        if (quantity >= maxQty || lineBlocked) {
            increase.disabled = true;
        }

        qtyWrap.appendChild(decrease);
        qtyWrap.appendChild(input);
        qtyWrap.appendChild(increase);

        const remove = document.createElement('button');
        remove.type = 'button';
        // Official Visitor pixel markers (event_dictionary remove_from_cart).
        remove.className = 'weline-cart-shell__action weline-cart-shell__action--remove weline-pixel::remove_from_cart';
        remove.dataset.cartAction = 'remove';
        remove.dataset.pixelEvent = 'remove_from_cart';
        remove.dataset.itemId = itemId;
        remove.textContent = copy.remove;
        remove.setAttribute('aria-label', copy.remove + ' ' + text(item && item.name));
        if (productId) {
            remove.dataset.productId = productId;
        }
        if (unitAmount > 0) {
            remove.dataset.price = String(unitAmount);
            remove.dataset.pixelValue = String(rowAmount > 0 ? rowAmount : unitAmount * quantity);
        }
        if (currency) {
            remove.dataset.currency = currency;
            remove.dataset.pixelCurrency = currency;
        }

        meta.appendChild(qtyWrap);
        meta.appendChild(remove);
        details.appendChild(meta);

        const priceCol = document.createElement('div');
        priceCol.className = 'weline-cart-shell__line-price';

        const priceRow = document.createElement('span');
        priceRow.className = 'weline-cart-shell__line-price-row';

        const nowEl = document.createElement('span');
        nowEl.className = 'weline-cart-shell__line-price-now';
        nowEl.textContent = money(rowAmount, currency);
        if (rowAmount > 0) {
            nowEl.dataset.price = String(rowAmount);
            nowEl.dataset.pixelValue = String(rowAmount);
        }
        priceRow.appendChild(nowEl);

        const compareAtMinor = Math.max(0, Number(item && item.compare_at_minor) || 0);
        const unitMinor = Math.max(0, Number(item && item.unit_price_minor) || 0);
        let originalMajor = Number(item && item.original_price);
        if (!(originalMajor > 0) && compareAtMinor > 0) {
            originalMajor = compareAtMinor / 100;
        }
        const hasDeal = Boolean(item && item.has_deal)
            || (compareAtMinor > unitMinor && unitMinor > 0)
            || (originalMajor > unitAmount && unitAmount > 0);
        if (hasDeal && originalMajor > 0) {
            const wasEl = document.createElement('span');
            wasEl.className = 'weline-cart-shell__line-price-was';
            wasEl.textContent = money(originalMajor * quantity, currency);
            priceRow.appendChild(wasEl);
        }
        priceCol.appendChild(priceRow);

        if (hasDeal && originalMajor > 0) {
            const campaignLabel = text(item && item.campaign_label).trim();
            const campaignUrl = text(item && item.campaign_url).trim();
            if (campaignLabel) {
                const campaignEl = campaignUrl
                    ? document.createElement('a')
                    : document.createElement('span');
                campaignEl.className = 'weline-cart-shell__line-price-campaign';
                campaignEl.textContent = campaignLabel;
                if (campaignUrl) {
                    campaignEl.href = campaignUrl;
                }
                priceCol.appendChild(campaignEl);
            }
        }

        const unitPrice = document.createElement('small');
        unitPrice.className = 'weline-cart-shell__line-unit';
        unitPrice.textContent = copy.unitPrice + ': ' + money(unitAmount, currency);
        priceCol.appendChild(unitPrice);

        row.appendChild(media);
        row.appendChild(details);
        row.appendChild(priceCol);
        return row;
    }

    function renderSiblingCarts(summary) {
        if (!siblingsNode) {
            return;
        }
        const emptyLead = root.querySelector('[data-cart-empty-lead]');
        siblingsNode.textContent = '';
        const rows = summary && Array.isArray(summary.sibling_carts) ? summary.sibling_carts : [];
        const usable = rows.filter(function (row) {
            return row && Number(row.item_count || row.cart_count || 0) > 0;
        });
        if (!usable.length) {
            siblingsNode.hidden = true;
            if (emptyLead) {
                emptyLead.hidden = false;
            }
            return;
        }
        siblingsNode.hidden = false;
        if (emptyLead) {
            emptyLead.hidden = true;
        }
        usable.forEach(function (row) {
            const type = String(row.cart_type || '').toLowerCase() === 'tob' ? 'tob' : 'toc';
            const label = String(row.label || (type === 'tob' ? '批发车' : '零售车')).trim();
            const count = Number(row.item_count || row.cart_count || 0);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'weline-cart-shell__sibling-cta';
            btn.setAttribute('data-cart-sibling', type);
            btn.setAttribute('data-cart-sibling-switch', type);
            if (row.switchable === false && row.gate) {
                btn.setAttribute('data-cart-sibling-gate', String(row.gate));
            }
            btn.textContent = siblingBrowseLabel(label, count);
            btn.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();
                if (window.WelineCart && typeof window.WelineCart.requestCartType === 'function') {
                    window.WelineCart.requestCartType(type, {
                        source: 'sibling-cta',
                        forceNetwork: true,
                    });
                } else {
                    try {
                        window.sessionStorage.setItem('weline_cart_type_explicit', type);
                    } catch (e) {}
                    window.dispatchEvent(new CustomEvent('weline:cart-type-changed', {
                        detail: {
                            cart_type: type,
                            selling_mode: type,
                            source: 'sibling-cta',
                            forceNetwork: true,
                        },
                    }));
                }
                loadCart({ soft: false, cartType: type, forceNetwork: true });
            });
            siblingsNode.appendChild(btn);
        });
    }

    function render(summary) {
        const items = Array.isArray(summary && summary.items) ? summary.items : [];
        if (!items.length || Boolean(summary && summary.is_empty)) {
            if (subtitleNode) {
                subtitleNode.hidden = true;
            }
            if (checkoutNode) {
                checkoutNode.removeAttribute('aria-disabled');
                checkoutNode.classList.remove('is-disabled');
                if (checkoutNode.dataset.href) {
                    checkoutNode.setAttribute('href', checkoutNode.dataset.href);
                }
            }
            invalidateEmptyCachesClaimedBySiblings(summary);
            rememberLocalCartSummary(Object.assign({
                success: true,
                is_empty: true,
                items: [],
                cart_count: 0,
                cart_type: preferredCartType(),
                selling_mode: preferredCartType(),
            }, summary && typeof summary === 'object' ? summary : {}));
            renderSiblingCarts(summary);
            showState('empty');
            return;
        }

        renderSiblingCarts({ sibling_carts: [] });

        itemsNode.textContent = '';
        let currency = text(summary && summary.currency || items[0] && items[0].currency || '').trim().toUpperCase();
        const displayCurrency = window.WelineCart && typeof window.WelineCart.currentDisplayCurrency === 'function'
            ? String(window.WelineCart.currentDisplayCurrency() || '').trim().toUpperCase()
            : '';
        // Prefer live storefront display currency so a stale API label cannot keep CNY
        // after the shopper switched to USD/EUR in the header.
        if (/^[A-Z]{3}$/.test(displayCurrency)) {
            currency = displayCurrency;
        } else if (!/^[A-Z]{3}$/.test(currency)) {
            currency = 'CNY';
        }
        if (summary && typeof summary === 'object') {
            summary.currency = currency;
        }
        items.forEach(function (item) {
            itemsNode.appendChild(buildLine(item, currency));
        });

        const count = Number(summary && (summary.cart_count ?? summary.item_count)) || 0;
        const goodsSubtotal = amountFromMinor(summary, 'subtotal_minor', 'subtotal');
        const fallbackGrand = amountFromMinor(summary, 'grand_total_minor', 'grand_total');
        const discountMajor = discountAmountMajor(summary);
        const payable = Math.max(0, (goodsSubtotal || fallbackGrand) - discountMajor);
        if (subtitleNode) {
            setText(subtitleNode, subtotalItemsLabel(count));
            subtitleNode.hidden = false;
        }
        setText(subtotalLabelNode, copy.subtotal);
        setText(grandTotalNode, money(payable, currency));
        renderDiscountBreakdown(summary, currency, goodsSubtotal || fallbackGrand);

        const blocked = Boolean(summary && summary.checkout_blocked);
        const blockingMessage = text(summary && (summary.blocking_message || summary.message)).trim();
        if (checkoutNode) {
            if (!checkoutNode.dataset.href) {
                checkoutNode.dataset.href = checkoutNode.getAttribute('href') || '';
            }
            if (blocked) {
                checkoutNode.setAttribute('aria-disabled', 'true');
                checkoutNode.classList.add('is-disabled');
                checkoutNode.removeAttribute('href');
            } else {
                checkoutNode.removeAttribute('aria-disabled');
                checkoutNode.classList.remove('is-disabled');
                if (checkoutNode.dataset.href) {
                    checkoutNode.setAttribute('href', checkoutNode.dataset.href);
                }
            }
        }
        if (messageNode) {
            if (blocked && blockingMessage) {
                setText(messageNode, blockingMessage);
                messageNode.classList.add('is-error');
            } else if (!text(summary && summary.message)) {
                setText(messageNode, '');
                messageNode.classList.remove('is-error');
            }
        }
        rememberLocalCartSummary(summary);
        root.__welineLastCartSummary = summary;
        showState('ready');
    }

    async function getCartApi() {
        if (cartApi) {
            return cartApi;
        }
        if (!window.Weline || typeof Weline.load !== 'function') {
            throw new Error(copy.loadFailed);
        }
        const api = await Weline.load('api');
        cartApi = await api.resource('cart');
        return cartApi;
    }

    function isCommerceTypeGateFailure(payload, error) {
        const code = text(
            (payload && (payload.error_code || payload.code))
            || (error && error.response && error.response.data && error.response.data.data && error.response.data.data.error_code)
            || (error && error.code)
            || ''
        ).toLowerCase();
        if (code === 'cart_commerce_type_login_required'
            || code === 'cart_commerce_type_membership_required'
            || code === 'business_error'
        ) {
            const message = text(
                (payload && payload.message)
                || (error && error.message)
                || (error && error.response && error.response.data && error.response.data.data && error.response.data.data.message)
                || ''
            );
            if (code !== 'business_error') {
                return true;
            }
            return /需要登录|批发身份|login_required|membership_required/i.test(message + ' ' + code);
        }
        return false;
    }

    async function enrichEmptySiblings(summary, requestedMode) {
        if (!summary || typeof summary !== 'object') {
            return summary;
        }
        const empty = Boolean(summary.is_empty) || !Array.isArray(summary.items) || !summary.items.length;
        if (!empty) {
            return summary;
        }
        const rows = Array.isArray(summary.sibling_carts) ? summary.sibling_carts : [];
        if (rows.some(function (row) {
            return row && Number(row.item_count || row.cart_count || 0) > 0;
        })) {
            return summary;
        }
        // Logged-in only: guest tob carts do not exist; probing would only return a gate shell.
        if (!isCustomerLoggedIn()) {
            return summary;
        }
        const other = requestedMode === 'tob' ? 'toc' : 'tob';
        try {
            const cart = await getCartApi();
            const result = await cart.getCart(await cartIdentity(other));
            const otherSummary = result && result.data && typeof result.data === 'object' ? result.data : result;
            if (!otherSummary || otherSummary.success === false || otherSummary.is_empty) {
                return summary;
            }
            const count = Number(otherSummary.cart_count || otherSummary.item_count || 0)
                || (Array.isArray(otherSummary.items) ? otherSummary.items.length : 0);
            if (count <= 0) {
                return summary;
            }
            summary.sibling_carts = [{
                cart_type: other,
                label: other === 'tob' ? '批发车' : '零售车',
                item_count: count,
                cart_count: count,
                switchable: true,
                gate: null,
            }];
        } catch (error) {}
        return summary;
    }

    async function loadCart(options) {
        const soft = !!(options && options.soft);
        const preferCache = !!(options && options.preferCache);
        const requestedMode = options && (options.cartType === 'tob' || options.cartType === 'toc')
            ? options.cartType
            : preferredCartType();
        const seq = ++cartLoadSeq;
        const couponCode = String((options && options.couponCode) || '').trim().toUpperCase();
        // Empty typed cache cannot short-circuit: sibling CTA may claim the other cart
        // still has lines while a stale empty bucket would paint 「购物车是空的」.
        if (preferCache && !options.forceNetwork) {
            const cached = readLocalCartSummary(requestedMode);
            if (cached && localCartSummaryHasItems(cached)) {
                applyCartTypeChrome(requestedMode);
                render(cached);
                return;
            }
        }
        if (!soft) {
            showState('loading');
        }
        try {
            applyCartTypeChrome(requestedMode);
            const cart = await getCartApi();
            let result;
            const identity = await cartIdentity(requestedMode);
            if (couponCode) {
                identity.coupon_code = couponCode;
            }
            try {
                result = await cart.getCart(identity);
            } catch (requestError) {
                if (requestedMode === 'tob' && isCommerceTypeGateFailure(null, requestError)) {
                    // Guest/wholesale gate: keep page usable with retail cart (SSR already fail-soft).
                    result = await cart.getCart(await cartIdentity('toc'));
                    if (seq !== cartLoadSeq) {
                        return;
                    }
                    const tocSummary = result && result.data && typeof result.data === 'object' ? result.data : result;
                    if (!tocSummary || tocSummary.success === false) {
                        throw requestError;
                    }
                    tocSummary.gate_reason = 'cart_commerce_type_login_required';
                    tocSummary.preferred_cart_type = 'tob';
                    applyCartTypeChrome('toc');
                    render(tocSummary);
                    // Do not paint wholesale login-required copy onto the retail cart body.
                    return;
                }
                throw requestError;
            }
            if (seq !== cartLoadSeq) {
                return;
            }
            const summary = result && result.data && typeof result.data === 'object' ? result.data : result;
            if (!summary || summary.success === false) {
                if (requestedMode === 'tob' && isCommerceTypeGateFailure(summary, null)) {
                    // Prefer empty tob + sibling CTA when server already attached hints.
                    if (summary && Array.isArray(summary.sibling_carts) && summary.sibling_carts.length) {
                        applyCartTypeChrome('tob');
                        render(Object.assign({}, summary, {
                            is_empty: true,
                            items: [],
                            cart_type: 'tob',
                            selling_mode: 'tob',
                        }));
                        return;
                    }
                    const tocResult = await cart.getCart(await cartIdentity('toc'));
                    if (seq !== cartLoadSeq) {
                        return;
                    }
                    const tocSummary = tocResult && tocResult.data && typeof tocResult.data === 'object'
                        ? tocResult.data
                        : tocResult;
                    if (tocSummary && tocSummary.success !== false) {
                        tocSummary.gate_reason = text(summary.error_code) || 'cart_commerce_type_login_required';
                        tocSummary.preferred_cart_type = 'tob';
                        applyCartTypeChrome('toc');
                        render(tocSummary);
                        return;
                    }
                }
                throw new Error(text(summary && summary.message) || copy.loadFailed);
            }
            const reported = String(summary.cart_type || summary.selling_mode || '').toLowerCase();
            if (summary.is_empty && Array.isArray(summary.sibling_carts) && summary.sibling_carts.length) {
                applyCartTypeChrome(requestedMode);
            } else {
                applyCartTypeChrome(reported === 'tob' || reported === 'toc' ? reported : requestedMode);
            }
            render(await enrichEmptySiblings(summary, requestedMode));
        } catch (error) {
            if (seq !== cartLoadSeq) {
                return;
            }
            if (soft) {
                return;
            }
            setText(errorNode, error && error.message ? error.message : copy.loadFailed);
            showState('error');
        }
    }

    async function mutateCart(action, itemId, qty) {
        root.setAttribute('aria-busy', 'true');
        setText(messageNode, '');
        messageNode && messageNode.classList.remove('is-error');
        const mode = activeCartType();
        try {
            const cart = await getCartApi();
            const params = Object.assign(await cartIdentity(mode), { item_id: itemId });
            const result = action === 'remove'
                ? await cart.remove(params)
                : await cart.update(Object.assign(params, { qty: Math.max(1, Number(qty) || 1) }));
            const summary = result && result.data && typeof result.data === 'object' ? result.data : result;
            if (!summary || summary.success === false) {
                throw new Error(text(summary && summary.message) || copy.mutationFailed);
            }
            setText(messageNode, text(summary.message));
            const reported = String(summary.cart_type || summary.selling_mode || mode).toLowerCase();
            applyCartTypeChrome(reported === 'tob' ? 'tob' : 'toc');
            if (summary.is_empty || !Array.isArray(summary.items) || !summary.items.length) {
                // Mutation summaries historically omitted sibling_carts — refresh empty state.
                await loadCart({ soft: true, cartType: reported === 'tob' ? 'tob' : 'toc', forceNetwork: true });
                return;
            }
            render(summary);
        } catch (error) {
            setText(messageNode, error && error.message ? error.message : copy.mutationFailed);
            messageNode && messageNode.classList.add('is-error');
            throw error;
        } finally {
            root.setAttribute('aria-busy', 'false');
        }
    }

    if (retryButton) {
        retryButton.addEventListener('click', loadCart);
    }

    window.addEventListener('weline:cart-updated', function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        const forceNetwork = detail.refresh === true || detail.forceNetwork === true;
        if (forceNetwork && detail.discount_preview && typeof detail.discount_preview === 'object'
            && Number(detail.discount_preview.amount_minor || 0) > 0
            && root.__welineLastCartSummary) {
            const patched = Object.assign({}, root.__welineLastCartSummary, {
                discount_preview: detail.discount_preview,
            });
            render(patched);
        }
        if (forceNetwork && detail.clear_discount === true && root.__welineLastCartSummary) {
            const cleared = Object.assign({}, root.__welineLastCartSummary);
            delete cleared.discount_preview;
            render(cleared);
        }
        loadCart({
            soft: true,
            cartType: preferredCartType(),
            forceNetwork: forceNetwork,
            couponCode: String(detail.coupon_code || '').trim(),
            clearDiscount: detail.clear_discount === true,
        });
    });

    window.addEventListener('weline:cart-type-changed', function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        const mode = String(detail.cart_type || detail.selling_mode || preferredCartType()).toLowerCase();
        const next = mode === 'tob' ? 'tob' : 'toc';
        applyCartTypeChrome(next);
        // Prefer typed local summary; only hit getCart when that type has no usable cache.
        loadCart({ soft: false, cartType: next, preferCache: true, forceNetwork: detail.forceNetwork === true });
    });
    // Legacy B2B event → same chrome reload path (adapter until callers migrate).
    window.addEventListener('weline:selling-mode-changed', function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        if (detail.source === 'b2b-setMode') {
            // setMode already emits cart-type-changed; avoid double loadCart.
            return;
        }
        const mode = String(detail.selling_mode || detail.cart_type || preferredCartType()).toLowerCase();
        const next = mode === 'tob' ? 'tob' : 'toc';
        applyCartTypeChrome(next);
        loadCart({ soft: false, cartType: next, preferCache: true, forceNetwork: detail.forceNetwork === true });
    });

    root.addEventListener('click', async function (event) {
        const button = event.target.closest('[data-cart-action], [data-qty-decrease], [data-qty-increase]');
        if (!button || button.disabled) {
            return;
        }

        const itemId = text(button.dataset.itemId).trim();
        if (!itemId) {
            return;
        }

        const quantityInput = root.querySelector('[data-cart-quantity="' + CSS.escape(itemId) + '"]');
        let action = text(button.dataset.cartAction);
        let nextQty = Math.max(1, Number(quantityInput && quantityInput.value) || 1);

        if (button.hasAttribute('data-qty-decrease')) {
            action = 'update';
            nextQty = Math.max(1, nextQty - 1);
        } else if (button.hasAttribute('data-qty-increase')) {
            action = 'update';
            const maxQty = Math.max(1, Number(quantityInput && quantityInput.max) || 999);
            nextQty = Math.min(maxQty, nextQty + 1);
        }

        button.disabled = true;
        try {
            await mutateCart(action, itemId, nextQty);
        } catch (error) {
            button.disabled = false;
        }
    });

    applyCartTypeChrome(preferredCartType());
    loadCart({ cartType: preferredCartType() });
})();
</script>
