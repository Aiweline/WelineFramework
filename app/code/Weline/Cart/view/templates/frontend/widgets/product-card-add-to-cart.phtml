<?php

/**
 * Cart-owned add-to-cart control for product cards (Hook-backed).
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Product\Helper\StorefrontOfferDetailQuery;
use Weline\Product\Helper\StorefrontOfferResolver;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-card-add-to-cart');
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false);

$offer = StorefrontOfferResolver::resolve($this);
if ($offer === [] && !$isPreviewMode) {
    return;
}

$productId = max(0, (int)($offer['product_id'] ?? 0));
$offerUuid = trim((string)($offer['global_offer_uuid'] ?? ''));
$sellable = !empty($offer['sellable']);
$quoteOnly = !empty($offer['quote_only']);
// Quote-only never enables add-to-cart; expose Product-owned inquiry entry instead.
$quoteHrefPath = '';
$quoteHrefParams = [];
if ($quoteOnly && $productId > 0) {
    $slug = strtolower(trim((string)($offer['slug'] ?? '')));
    $quoteHrefPath = $slug !== '' ? ('product/' . $slug) : ('product/' . $productId);
    $quoteHrefParams = StorefrontOfferDetailQuery::params($offer);
    $quoteHrefParams['quote'] = '1';
}
$buttonEnabled = $quoteOnly
    ? ($quoteHrefPath !== '' && !$isPreviewMode)
    : ($isPreviewMode || ($sellable && ($offerUuid !== '' || $productId > 0)));

$needsSelection = !empty($offer['needs_selection'])
    || !empty($offer['selection_required'])
    || ((\is_array($offer['combination'] ?? null) && ($offer['combination'] ?? []) !== []))
    || ((int)($offer['variant_offer_count'] ?? $offer['offer_count'] ?? 0) > 1);
// Listing cards: always open purchase panel so multi-spec / tob MOQ / ladder prices are explicit.
$openPurchasePanel = !$quoteOnly && $productId > 0 && (
    $needsSelection
    || filter_var($this->getData('card_open_purchase_panel') ?? true, FILTER_VALIDATE_BOOLEAN)
);

$variant = trim((string)($this->getData('card_add_to_cart_variant') ?? 'cta'));
$extraClass = trim((string)($this->getData('card_add_to_cart_button_class') ?? ''));
$labelOverride = trim((string)($this->getData('card_add_to_cart_label') ?? ''));

$buttonLabel = WidgetI18n::label(
    $labelOverride,
    $quoteOnly ? '仅询价' : ($sellable ? '加入购物车' : '暂不可售')
);

if ($variant === 'icon') {
    $buttonClass = 'action-btn btn-cart weline-pixel::add_to_cart';
} elseif ($variant === 'storefront') {
    $buttonClass = 'product-storefront__add weline-pixel::add_to_cart';
} elseif ($variant === 'amz-card') {
    $buttonClass = 'amz-card__add weline-pixel::add_to_cart';
} else {
    $buttonClass = 'btn-add-to-cart weline-pixel::add_to_cart';
}
if ($extraClass !== '') {
    $buttonClass .= ' ' . $extraClass;
}
$controlClass = trim($quoteOnly ? str_replace(' weline-pixel::add_to_cart', '', $buttonClass) : $buttonClass);
if ($quoteOnly) {
    // Inquiry CTA: light/amber surface + dark readable text — not solid buy-now red.
    if ($variant === 'storefront') {
        $controlClass = 'product-storefront__quote';
    } elseif ($variant === 'amz-card') {
        $controlClass = 'amz-card__quote';
    } elseif ($variant === 'icon') {
        $controlClass = 'action-btn btn-quote';
    } else {
        $controlClass = 'btn-quote';
    }
    if ($extraClass !== '') {
        $controlClass .= ' ' . $extraClass;
    }
}
?>
<div class="weline-cart-product-card-add-to-cart"
     data-weline-load="cart"
     data-widget-module="Weline_Cart"
     data-widget-code="product-card-add-to-cart"
     data-uid="<?= $escape($scope->uid) ?>"
     data-purchase-loading="<?= $escape(WidgetI18n::label('正在加入购物车...')) ?>"
     data-purchase-success="<?= $escape(WidgetI18n::label('已加入购物车')) ?>"
     data-purchase-error="<?= $escape(WidgetI18n::label('加入购物车失败')) ?>"
     data-purchase-mark-added="<?= $escape(WidgetI18n::label('已加入')) ?>"
     data-cart-url="@url{'cart'}"
     data-cart-link-text="<?= $escape(WidgetI18n::label('前往购物车')) ?>"
     weline-code="<?= $escape($scope->code) ?>">
    <?php if ($quoteOnly && $quoteHrefPath !== ''): ?>
        <a class="<?= $escape($controlClass) ?>"
           href="@url{$quoteHrefPath|$quoteHrefParams}#quote"
           data-testid="product-card-add-to-cart"
           data-default-label="<?= $escape($buttonLabel) ?>"
           data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
           data-product-id="<?= $productId ?>"
           data-global-offer-uuid="<?= $escape($offerUuid) ?>"
           data-quote-only="1"
           <?php if (!$buttonEnabled): ?>aria-disabled="true" tabindex="-1"<?php endif; ?>>
            <?php if ($variant === 'icon'): ?>
                <w:icon name="message" size="sm"></w:icon>
                <span class="visually-hidden"><?= $escape($buttonLabel) ?></span>
            <?php else: ?>
                <span data-card-add-label="1"><?= $escape($buttonLabel) ?></span>
            <?php endif; ?>
        </a>
    <?php else: ?>
        <button type="button"
                class="<?= $escape($controlClass) ?>"
                data-action="add"
                data-testid="product-card-add-to-cart"
                data-default-label="<?= $escape($buttonLabel) ?>"
                data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                data-product-id="<?= $productId ?>"
                data-global-offer-uuid="<?= $escape($offerUuid) ?>"
                data-qty="1"
                data-quote-only="0"
                data-needs-selection="<?= $needsSelection ? '1' : '0' ?>"
                data-open-purchase-panel="<?= $openPurchasePanel ? '1' : '0' ?>"
                <?= $buttonEnabled ? '' : 'disabled' ?>>
            <?php if ($variant === 'icon'): ?>
                <w:icon name="cart" size="sm"></w:icon>
                <span class="visually-hidden"><?= $escape($buttonLabel) ?></span>
            <?php else: ?>
                <?php if ($variant === 'cta'): ?>
                    <w:icon name="cart" size="sm"></w:icon>
                <?php endif; ?>
                <span class="weline-pixel::add_to_cart" data-card-add-label="1"><?= $escape($buttonLabel) ?></span>
            <?php endif; ?>
        </button>
    <?php endif; ?>
    <?php if (!$quoteOnly && !$sellable && trim((string)($offer['message'] ?? '')) !== ''): ?>
        <small class="weline-cart-product-card-add-to-cart__message"><?= $escape($offer['message']) ?></small>
    <?php endif; ?>
</div>
