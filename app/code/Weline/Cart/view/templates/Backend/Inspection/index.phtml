<?php
$scope_key = $scope_key ?? '';
$carts = $carts ?? [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="w-grid" data-testid="cart-inspection-management"><div style="--w-span:12;">
    <div class="w-backend-page__heading"><h4 class="w-backend-page__title"><?= __('购物车检查') ?></h4></div>
    <div class="w-alert" data-tone="info"><?= __('Cart V2 按 Scope 隔离；请输入完整 scope key 查询真实持久缓存，不支持全局枚举。') ?></div>
    <?php if ($load_error !== ''): ?><div class="w-alert" data-tone="danger"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="w-card"><div class="w-card__body">
        <form method="get" class="w-grid" data-testid="cart-inspection-form" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
            <div style="--w-span-md:8;"><input class="w-input" name="scope_key" data-testid="cart-scope-key" value="<?= $escape($scope_key) ?>" placeholder="<?= __('输入完整 scope key') ?>" required></div>
            <div><button class="w-button" data-testid="cart-inspection-submit" type="submit" data-tone="primary"><?= __('检查') ?></button></div>
        </form>
        <div data-testid="cart-result-count" style="--w-mb:var(--weline-space-2);"><?= __('匹配购物车：%{1}', count($carts)) ?></div>
        <div class="w-table-wrap"><table class="w-table"><thead><tr>
            <th><?= __('Scope') ?></th><th><?= __('所有者类型') ?></th><th><?= __('所有者') ?></th><th><?= __('货币') ?></th><th><?= __('商品数') ?></th>
        </tr></thead><tbody>
        <?php if ($scope_key === ''): ?><tr><td colspan="5" class="w-text" data-align="center" data-tone="muted"><?= __('请输入 scope key') ?></td></tr>
        <?php elseif ($carts === []): ?><tr><td colspan="5" class="w-text" data-align="center" data-tone="muted"><?= __('未找到购物车') ?></td></tr>
        <?php else: foreach ($carts as $cart): ?><tr data-testid="cart-inspection-row">
            <td><code><?= $escape($cart['scope_key'] ?? '') ?></code></td><td><?= $escape($cart['owner_kind'] ?? '') ?></td>
            <td><?= $escape($cart['owner_id'] ?? '') ?></td><td><?= $escape($cart['currency'] ?? '') ?></td><td><?= (int)($cart['item_count'] ?? 0) ?></td>
        </tr><?php endforeach; endif; ?>
        </tbody></table></div>
    </div></div>
</div></div>
