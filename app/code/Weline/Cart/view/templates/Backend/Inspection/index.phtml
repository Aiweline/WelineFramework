<?php
$scope_key = $scope_key ?? '';
$carts = $carts ?? [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="row" data-testid="cart-inspection-management"><div class="col-12">
    <div class="page-title-box"><h4 class="page-title"><?= __('购物车检查') ?></h4></div>
    <div class="alert alert-info"><?= __('Cart V2 按 Scope 隔离；请输入完整 scope key 查询真实持久缓存，不支持全局枚举。') ?></div>
    <?php if ($load_error !== ''): ?><div class="alert alert-danger"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="card"><div class="card-body">
        <form method="get" class="row g-2 mb-3" data-testid="cart-inspection-form">
            <div class="col-md-8"><input class="form-control" name="scope_key" data-testid="cart-scope-key" value="<?= $escape($scope_key) ?>" placeholder="<?= __('输入完整 scope key') ?>" required></div>
            <div class="col-auto"><button class="btn btn-primary" data-testid="cart-inspection-submit" type="submit"><?= __('检查') ?></button></div>
        </form>
        <div class="mb-2" data-testid="cart-result-count"><?= __('匹配购物车：%{1}', count($carts)) ?></div>
        <div class="table-responsive"><table class="table table-striped"><thead><tr>
            <th><?= __('Scope') ?></th><th><?= __('所有者类型') ?></th><th><?= __('所有者') ?></th><th><?= __('货币') ?></th><th><?= __('商品数') ?></th>
        </tr></thead><tbody>
        <?php if ($scope_key === ''): ?><tr><td colspan="5" class="text-center text-muted"><?= __('请输入 scope key') ?></td></tr>
        <?php elseif ($carts === []): ?><tr><td colspan="5" class="text-center text-muted"><?= __('未找到购物车') ?></td></tr>
        <?php else: foreach ($carts as $cart): ?><tr data-testid="cart-inspection-row">
            <td><code><?= $escape($cart['scope_key'] ?? '') ?></code></td><td><?= $escape($cart['owner_kind'] ?? '') ?></td>
            <td><?= $escape($cart['owner_id'] ?? '') ?></td><td><?= $escape($cart['currency'] ?? '') ?></td><td><?= (int)($cart['item_count'] ?? 0) ?></td>
        </tr><?php endforeach; endif; ?>
        </tbody></table></div>
    </div></div>
</div></div>
