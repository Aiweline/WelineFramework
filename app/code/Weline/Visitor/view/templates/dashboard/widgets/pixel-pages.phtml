<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-pages.css}
 * Dashboard Widget: 热门页面
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$insightService = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelAnalyticsInsightService::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}
$dashboard = $service->getDashboard($config);
$filters = is_array($dashboard['filters'] ?? null) ? $dashboard['filters'] : [];
$range = (string)($filters['range'] ?? $config['range']);
$listConfig = array_merge($config, [
    'website_id' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => $range,
]);
$report = $insightService->buildReport(array_merge($listConfig, [
    'websiteId' => $listConfig['website_id'],
]));
$rows = array_slice(is_array($report['pages'] ?? null) ? $report['pages'] : [], 0, 6);
$detailUrl = $service->detailUrl($listConfig);
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-pages">
    <header>
        <h3><?= __('热门页面') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </header>
    <?php if ($rows === []): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无页面浏览') ?></div>
    <?php else: ?>
        <table>
            <tbody>
            <?php foreach ($rows as $row): ?>
                <tr>
                    <th>
                        <strong title="<?= $h($row['path'] ?? '') ?>"><?= $h($row['path'] ?? '/') ?></strong>
                        <span><?= $h(__('停留 %{1}s', [$service->formatNumber($row['avg_dwell_sec'] ?? 0, 1)])) ?></span>
                    </th>
                    <td><?= $h($service->formatNumber($row['views'] ?? 0)) ?></td>
                    <td><?= $h($service->formatNumber($row['users'] ?? 0)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
