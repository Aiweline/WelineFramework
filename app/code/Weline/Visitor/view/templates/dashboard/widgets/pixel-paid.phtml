<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-paid.css}
 * Dashboard Widget: 付费广告（E03a，catalog pixel_paid）
 *
 * @widget.code {pixel_paid}
 * @widget.name {付费广告}
 * @widget.description {traffic_type=paid，按 utm_campaign 聚合事件与价值，可下钻事件列表。}
 * @widget.type {table}
 * @widget.area {backend}
 * @widget.position {["dashboard-detail"]}
 * @widget.page_layouts {["dashboard"]}
 * @widget.slot {dashboard-detail}
 * @widget.supports {["dashboard-widget","dashboard-slot-detail","dashboard-table","dashboard-list"]}
 * @param range {default="7d",type="select",label="统计范围",options={"today":"今日","7d":"近 7 天","30d":"近 30 天"}}
 * @param website_id {default="",type="string",label="站点 ID",description="留空时跟随当前 Dashboard 站点。"}
 *
 * @widget.default_injections {[{"layout_type":"dashboard","layout_option":"default","default_view":"weline_visitor_event_statistics","target_type":"website","slot":"dashboard-detail","area":"content","sort_order":80,"required":false,"reason":"付费广告报表部件（E03a）；Installer 种子已含本 code（E05）","config":{"dashboard_layout":{"colSpan":4,"rowSpan":1,"sortOrder":80}}}]}
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getPaidReport($config);
$rows = is_array($report['rows'] ?? null) ? $report['rows'] : [];
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$dimension = (string)($report['dimension'] ?? 'utm_campaign');
$catalogFilters = is_array($report['filters'] ?? null) ? $report['filters'] : [];
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config, ['traffic_type' => 'paid']));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-paid" data-pixel-widget="pixel_paid">
    <header>
        <h3><?= __('付费广告') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-paid-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <small>traffic_type=paid</small>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error !== '' && $rows === []): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php elseif ($rows === []): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无付费广告数据') ?></div>
    <?php else: ?>
        <table>
            <thead>
            <tr>
                <th><?= __('广告系列') ?></th>
                <th class="w-text" data-align="end"><?= __('事件') ?></th>
                <th class="w-text" data-align="end"><?= __('价值') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($rows as $row): ?>
                <?php
                $dimValue = (string)($row['dimension_value'] ?? '');
                $drillUrl = $service->channelDrilldownUrl($config, $dimension, $dimValue, $catalogFilters);
                ?>
                <tr>
                    <th>
                        <?php if ($dimValue !== ''): ?>
                            <a class="pixel-paid-link" href="<?= $h($drillUrl) ?>">
                                <code><?= $h($dimValue) ?></code>
                            </a>
                        <?php else: ?>
                            <code>—</code>
                        <?php endif; ?>
                    </th>
                    <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['events'] ?? 0)) ?></td>
                    <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['value_sum'] ?? 0, 2)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
