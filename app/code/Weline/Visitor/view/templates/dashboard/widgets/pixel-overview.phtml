<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-overview.css}
 * Dashboard Widget: 像素概览
 *
 * @widget.code {pixel_overview}
 * @widget.name {像素概览}
 * @widget.description {展示像素事件、独立访客、事件类型和处理率。}
 * @widget.type {stats}
 * @widget.area {backend}
 * @widget.position {["dashboard-summary"]}
 * @widget.page_layouts {["dashboard"]}
 * @widget.slot {dashboard-summary}
 * @widget.supports {["dashboard-widget","dashboard-slot-summary","dashboard-stat","dashboard-kpi"]}
 * @param range {default="7d",type="select",label="统计范围",options={"today":"今日","yesterday":"昨日","7d":"近 7 天","30d":"近 30 天","90d":"近 90 天"}}
 * @param website_id {default="",type="string",label="站点 ID",description="留空时跟随当前 Dashboard 站点。"}
 *
 * @widget.default_injections {[{"layout_type":"dashboard","layout_option":"default","default_view":"weline_visitor_event_statistics","target_type":"website","slot":"dashboard-summary","area":"content","sort_order":50,"required":true,"reason":"安装访客统计后自动展示像素概览","config":{"dashboard_layout":{"colSpan":4,"rowSpan":1,"sortOrder":50}}}]}
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}
$dashboard = $service->getDashboard($config);
$summary = is_array($dashboard['summary'] ?? null) ? $dashboard['summary'] : [];
$filters = is_array($dashboard['filters'] ?? null) ? $dashboard['filters'] : [];
$range = (string)($filters['range'] ?? $config['range']);
$siteLabel = array_key_exists('website_id', $filters) && $filters['website_id'] !== null
    ? __('站点 #%{1}', [(int)$filters['website_id']])
    : __('全部站点');
$items = [
    ['label' => __('事件'), 'value' => $service->formatNumber($summary['total_events'] ?? 0), 'hint' => $service->rangeLabel($range)],
    ['label' => __('访客'), 'value' => $service->formatNumber($summary['active_users'] ?? 0), 'hint' => __('按 IP 去重')],
    ['label' => __('类型'), 'value' => $service->formatNumber($summary['event_types'] ?? 0), 'hint' => __('事件种类')],
    ['label' => __('处理率'), 'value' => $service->formatPercent($summary['processed_rate'] ?? 0), 'hint' => __('Cron 处理')],
];
$change = (float)($summary['event_change'] ?? 0);
$changeClass = $change >= 0 ? 'positive' : 'negative';
$detailUrl = $service->detailUrl(array_merge($config, [
    'website_id' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => $range,
]));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-overview">
    <header>
        <h3><?= __('像素概览') ?></h3>
        <span><?= $h($siteLabel) ?></span>
    </header>
    <div class="pixel-overview-grid">
        <?php foreach ($items as $item): ?>
            <div>
                <strong><?= $h($item['value']) ?></strong>
                <span><?= $h($item['label']) ?></span>
                <small><?= $h($item['hint']) ?></small>
            </div>
        <?php endforeach; ?>
    </div>
    <footer class="pixel-widget-foot">
        <span class="<?= $h($changeClass) ?>"><?= $h($service->formatPercent($change)) ?></span>
        <small><?= __('较上一周期') ?></small>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('查看事件列表') ?></a>
    </footer>
</section>
