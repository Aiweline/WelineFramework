<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-top-events.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * Dashboard Widget: 热门像素事件
 *
 * @widget.code {pixel_top_events}
 * @widget.name {热门像素事件}
 * @widget.description {展示当前范围内触发最多的像素事件。}
 * @widget.type {table}
 * @widget.area {backend}
 * @widget.position {["dashboard-detail"]}
 * @widget.page_layouts {["dashboard"]}
 * @widget.slot {dashboard-detail}
 * @widget.supports {["dashboard-widget","dashboard-slot-detail","dashboard-table","dashboard-list"]}
 * @param range {default="7d",type="select",label="统计范围",options={"today":"今日","7d":"近 7 天","30d":"近 30 天","90d":"近 90 天"}}
 * @param website_id {default="",type="string",label="站点 ID",description="留空时跟随当前 Dashboard 站点。"}
 *
 * @widget.default_injections {[{"layout_type":"dashboard","layout_option":"default","default_view":"weline_visitor_event_statistics","target_type":"website","slot":"dashboard-detail","area":"content","sort_order":70,"required":true,"reason":"安装访客统计后自动展示热门像素事件","config":{"dashboard_layout":{"colSpan":9,"rowSpan":1,"sortOrder":70}}}]}
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}
$dashboard = $service->getDashboard($config);
$rows = array_slice(is_array($dashboard['event_rows'] ?? null) ? $dashboard['event_rows'] : [], 0, 6);
$filters = is_array($dashboard['filters'] ?? null) ? $dashboard['filters'] : [];
$range = (string)($filters['range'] ?? $config['range']);
$max = 1;
foreach ($rows as $row) {
    $max = max($max, (int)($row['count'] ?? 0));
}
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$listConfig = array_merge($config, [
    'website_id' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => $range,
]);
$listUrl = $service->detailUrl($listConfig);
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-events">
    <header>
        <h3><?= __('热门像素事件') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('查看列表') ?></a>
    </header>
    <?php if ($rows === []): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无事件') ?></div>
    <?php else: ?>
        <table>
            <tbody>
            <?php foreach ($rows as $row): ?>
                <?php
                $count = (int)($row['count'] ?? 0);
                $share = (float)($row['share'] ?? 0);
                $width = max(3, min(100, (int)round(($count / $max) * 100)));
                $eventName = (string)($row['event'] ?? '');
                $eventUrl = $service->detailUrl(array_merge($listConfig, ['event' => $eventName]));
                ?>
                <tr>
                    <th>
                        <a class="pixel-event-link" href="<?= $h($eventUrl) ?>">
                            <strong><?= $h($eventName !== '' ? $eventName : '-') ?></strong>
                        </a>
                        <span><?= $h(__('访客 %{1}', [$service->formatNumber($row['active_users'] ?? 0)])) ?></span>
                    </th>
                    <td>
                        <div class="pixel-event-count"><?= $h($service->formatNumber($count)) ?></div>
                        <div class="pixel-progress"><span data-widget-style="width: <?= (int)$width ?>%"></span></div>
                    </td>
                    <td><?= $h($service->formatPercent($share)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
