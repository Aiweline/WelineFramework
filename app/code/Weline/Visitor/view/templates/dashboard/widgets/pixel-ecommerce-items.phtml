<?php
/**
 * Dashboard Widget: 商品表现（F05a / F03）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getEcommerceItemsReport($config);
$items = is_array($report['items'] ?? null) ? $report['items'] : [];
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-ecommerce-items" data-pixel-widget="pixel_ecommerce_items">
    <header>
        <h3><?= __('商品表现') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-ecommerce-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error === 'website scope required'): ?>
        <div class="pixel-empty compact"><?= __('请选择站点后查看商品表现') ?></div>
    <?php elseif ($error !== '' && $items === []): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php elseif ($items === []): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无商品数据') ?></div>
    <?php else: ?>
        <table>
            <thead>
            <tr>
                <th><?= __('商品') ?></th>
                <th class="text-end"><?= __('购买') ?></th>
                <th class="text-end"><?= __('收入') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($items as $row): ?>
                <tr>
                    <th>
                        <div><?= $h($row['item_name'] ?? '') ?></div>
                        <code><?= $h($row['item_id'] ?? '') ?></code>
                    </th>
                    <td class="text-end"><?= $h($service->formatNumber($row['purchases'] ?? 0)) ?></td>
                    <td class="text-end"><?= $h($service->formatNumber($row['item_revenue'] ?? 0, 2)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
<style>
.dashboard-widget-pixel-ecommerce-items table{width:100%;border-collapse:collapse}
.dashboard-widget-pixel-ecommerce-items th,.dashboard-widget-pixel-ecommerce-items td{padding:8px 0;border-bottom:1px solid var(--w-dashboard-border,#e5e7eb);font-size:12px;vertical-align:top}
.dashboard-widget-pixel-ecommerce-items thead th{color:var(--w-dashboard-muted,#6b7280);font-weight:600}
.dashboard-widget-pixel-ecommerce-items tr:last-child th,.dashboard-widget-pixel-ecommerce-items tr:last-child td{border-bottom:0}
.dashboard-widget-pixel-ecommerce-items tbody th{text-align:left;font-weight:500}
.dashboard-widget-pixel-ecommerce-items tbody th code{color:var(--w-dashboard-muted,#6b7280);font-size:11px}
.dashboard-widget-pixel-ecommerce-items .text-end{text-align:right}
.dashboard-widget-pixel-ecommerce-items header,.pixel-ecommerce-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.pixel-ecommerce-meta{color:var(--w-dashboard-muted,#6b7280);font-size:12px}
.pixel-widget-detail{color:var(--bs-primary,#2563eb);text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap}
.pixel-widget-detail:hover{text-decoration:underline}
.pixel-empty.compact{min-height:110px;display:flex;align-items:center;color:var(--w-dashboard-muted,#6b7280);font-size:13px}
</style>
