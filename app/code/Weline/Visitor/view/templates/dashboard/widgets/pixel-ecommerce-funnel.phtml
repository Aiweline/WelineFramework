<?php
/**
 * Dashboard Widget: 电商漏斗（F05a / F01）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getEcommerceFunnelReport($config);
$steps = is_array($report['steps'] ?? null) ? $report['steps'] : [];
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-ecommerce-funnel" data-pixel-widget="pixel_ecommerce_funnel">
    <header>
        <h3><?= __('电商漏斗') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-ecommerce-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error === 'website scope required'): ?>
        <div class="pixel-empty compact"><?= __('请选择站点后查看电商漏斗') ?></div>
    <?php elseif ($error !== '' && $steps === []): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php elseif ((int)($report['step1_sessions'] ?? 0) <= 0): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无浏览商品会话') ?></div>
    <?php else: ?>
        <table>
            <thead>
            <tr>
                <th><?= __('步骤') ?></th>
                <th class="w-text" data-align="end"><?= __('会话') ?></th>
                <th class="w-text" data-align="end"><?= __('占比') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($steps as $step): ?>
                <?php $rate = (float)($step['rate_from_step1'] ?? 0); ?>
                <tr>
                    <th><?= $h(__((string)($step['label'] ?? $step['key'] ?? ''))) ?></th>
                    <td class="w-text" data-align="end"><?= $h($service->formatNumber($step['sessions'] ?? 0)) ?></td>
                    <td class="w-text" data-align="end"><?= $h($service->formatPercent($rate * 100)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
<style>
.dashboard-widget-pixel-ecommerce-funnel table{width:100%;border-collapse:collapse}
.dashboard-widget-pixel-ecommerce-funnel th,.dashboard-widget-pixel-ecommerce-funnel td{padding:8px 0;border-bottom:1px solid var(--w-dashboard-border,#e5e7eb);font-size:12px}
.dashboard-widget-pixel-ecommerce-funnel thead th{color:var(--w-dashboard-muted,#6b7280);font-weight:600}
.dashboard-widget-pixel-ecommerce-funnel tr:last-child th,.dashboard-widget-pixel-ecommerce-funnel tr:last-child td{border-bottom:0}
.dashboard-widget-pixel-ecommerce-funnel tbody th{text-align:left;font-weight:500}
.dashboard-widget-pixel-ecommerce-funnel .text-end{text-align:right}
.dashboard-widget-pixel-ecommerce-funnel header,.pixel-ecommerce-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.pixel-ecommerce-meta{color:var(--w-dashboard-muted,#6b7280);font-size:12px}
.pixel-widget-detail{color:var(--bs-primary,#2563eb);text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap}
.pixel-widget-detail:hover{text-decoration:underline}
.pixel-empty.compact{min-height:110px;display:flex;align-items:center;color:var(--w-dashboard-muted,#6b7280);font-size:13px}
</style>
