<?php
/**
 * Dashboard Widget: 像素参与度（会话/跳出/停留）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$insightService = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelAnalyticsInsightService::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}
$dashboard = $service->getDashboard($config);
$filters = is_array($dashboard['filters'] ?? null) ? $dashboard['filters'] : [];
$range = (string)($filters['range'] ?? $config['range']);
$report = $insightService->buildReport(array_merge($config, [
    'websiteId' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => $range,
]));
$engagement = is_array($report['engagement'] ?? null) ? $report['engagement'] : [];
$detailUrl = $service->detailUrl(array_merge($config, [
    'website_id' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => $range,
]));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$items = [
    ['label' => __('会话'), 'value' => $service->formatNumber($engagement['sessions'] ?? 0)],
    ['label' => __('参与率'), 'value' => $service->formatPercent($engagement['engagement_rate'] ?? 0)],
    ['label' => __('跳出率'), 'value' => $service->formatPercent($engagement['bounce_rate'] ?? 0)],
    ['label' => __('平均停留'), 'value' => $service->formatNumber($engagement['avg_session_duration_sec'] ?? 0, 1) . 's'],
];
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-engagement">
    <header>
        <h3><?= __('像素参与度') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </header>
    <div class="pixel-engagement-grid">
        <?php foreach ($items as $item): ?>
            <div>
                <strong><?= $h($item['value']) ?></strong>
                <span><?= $h($item['label']) ?></span>
            </div>
        <?php endforeach; ?>
    </div>
    <footer class="pixel-widget-foot">
        <small><?= $h(__('页/会话 %{1}', [$service->formatNumber($engagement['pages_per_session'] ?? 0, 2)])) ?></small>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('查看细节') ?></a>
    </footer>
</section>
<style>
.dashboard-widget-pixel-engagement header { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.pixel-engagement-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.pixel-engagement-grid div { border-radius:6px; background:var(--w-dashboard-surface-soft,#f8fafc); padding:12px 8px; text-align:center; }
.pixel-engagement-grid strong { display:block; color:#0f766e; font-size:20px; line-height:1.1; }
.pixel-engagement-grid span { display:block; margin-top:6px; color:var(--w-dashboard-muted,#6b7280); font-size:12px; }
.pixel-widget-detail { color:var(--bs-primary,#2563eb); text-decoration:none; font-size:12px; font-weight:600; }
.pixel-widget-detail:hover { text-decoration:underline; }
.pixel-widget-foot { display:flex; align-items:center; gap:8px; flex-wrap:wrap; color:var(--w-dashboard-muted,#6b7280); font-size:12px; }
.pixel-widget-foot .pixel-widget-detail { margin-left:auto; }
</style>
