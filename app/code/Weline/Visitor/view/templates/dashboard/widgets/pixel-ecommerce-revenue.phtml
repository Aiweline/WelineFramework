<?php
/**
 * Dashboard Widget: 购成与收入（F05a / F02）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getEcommerceRevenueReport($config);
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$byChannel = is_array($report['by_channel'] ?? null) ? $report['by_channel'] : [];
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-ecommerce-revenue" data-pixel-widget="pixel_ecommerce_revenue">
    <header>
        <h3><?= __('购成与收入') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-ecommerce-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error === 'website scope required'): ?>
        <div class="pixel-empty compact"><?= __('请选择站点后查看购成与收入') ?></div>
    <?php elseif ($error !== ''): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php else: ?>
        <div class="pixel-ecommerce-kpis">
            <div>
                <span><?= __('购买次数') ?></span>
                <strong><?= $h($service->formatNumber($report['purchases'] ?? 0)) ?></strong>
            </div>
            <div>
                <span><?= __('购买收入') ?></span>
                <strong><?= $h($service->formatNumber($report['purchase_revenue'] ?? 0, 2)) ?></strong>
            </div>
            <div>
                <span><?= __('客单价') ?></span>
                <strong><?= $h($service->formatNumber($report['avg_order_value'] ?? 0, 2)) ?></strong>
            </div>
            <div>
                <span><?= __('购成率') ?></span>
                <strong><?= $h($service->formatPercent(((float)($report['purchase_rate_from_view_item'] ?? 0)) * 100)) ?></strong>
            </div>
        </div>
        <?php if ($byChannel !== []): ?>
            <table>
                <thead>
                <tr>
                    <th><?= __('渠道') ?></th>
                    <th class="w-text" data-align="end"><?= __('收入') ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($byChannel as $row): ?>
                    <tr>
                        <th><code><?= $h($row['channel_code'] ?? $row['channel'] ?? '—') ?></code></th>
                        <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['purchase_revenue'] ?? $row['revenue'] ?? 0, 2)) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    <?php endif; ?>
</section>
<style>
.dashboard-widget-pixel-ecommerce-revenue .pixel-ecommerce-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:8px 0 12px}
.dashboard-widget-pixel-ecommerce-revenue .pixel-ecommerce-kpis span{display:block;color:var(--w-dashboard-muted,#6b7280);font-size:11px}
.dashboard-widget-pixel-ecommerce-revenue .pixel-ecommerce-kpis strong{font-size:16px}
.dashboard-widget-pixel-ecommerce-revenue table{width:100%;border-collapse:collapse}
.dashboard-widget-pixel-ecommerce-revenue th,.dashboard-widget-pixel-ecommerce-revenue td{padding:8px 0;border-bottom:1px solid var(--w-dashboard-border,#e5e7eb);font-size:12px}
.dashboard-widget-pixel-ecommerce-revenue thead th{color:var(--w-dashboard-muted,#6b7280);font-weight:600}
.dashboard-widget-pixel-ecommerce-revenue tr:last-child th,.dashboard-widget-pixel-ecommerce-revenue tr:last-child td{border-bottom:0}
.dashboard-widget-pixel-ecommerce-revenue tbody th{text-align:left;font-weight:500}
.dashboard-widget-pixel-ecommerce-revenue .text-end{text-align:right}
.dashboard-widget-pixel-ecommerce-revenue header,.pixel-ecommerce-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.pixel-ecommerce-meta{color:var(--w-dashboard-muted,#6b7280);font-size:12px}
.pixel-widget-detail{color:var(--bs-primary,#2563eb);text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap}
.pixel-widget-detail:hover{text-decoration:underline}
.pixel-empty.compact{min-height:110px;display:flex;align-items:center;color:var(--w-dashboard-muted,#6b7280);font-size:13px}
</style>
