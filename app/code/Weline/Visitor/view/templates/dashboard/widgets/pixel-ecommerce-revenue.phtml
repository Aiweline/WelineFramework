<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-ecommerce-revenue.css}
 * Dashboard Widget: 购成与收入（F05a / F02）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getEcommerceRevenueReport($config);
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$byChannel = is_array($report['by_channel'] ?? null) ? $report['by_channel'] : [];
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-ecommerce-revenue" data-pixel-widget="pixel_ecommerce_revenue">
    <header>
        <h3><?= __('购成与收入') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-ecommerce-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error === 'website scope required'): ?>
        <div class="pixel-empty compact"><?= __('请选择站点后查看购成与收入') ?></div>
    <?php elseif ($error !== ''): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php else: ?>
        <div class="pixel-ecommerce-kpis">
            <div>
                <span><?= __('购买次数') ?></span>
                <strong><?= $h($service->formatNumber($report['purchases'] ?? 0)) ?></strong>
            </div>
            <div>
                <span><?= __('购买收入') ?></span>
                <strong><?= $h($service->formatNumber($report['purchase_revenue'] ?? 0, 2)) ?></strong>
            </div>
            <div>
                <span><?= __('客单价') ?></span>
                <strong><?= $h($service->formatNumber($report['avg_order_value'] ?? 0, 2)) ?></strong>
            </div>
            <div>
                <span><?= __('购成率') ?></span>
                <strong><?= $h($service->formatPercent(((float)($report['purchase_rate_from_view_item'] ?? 0)) * 100)) ?></strong>
            </div>
        </div>
        <?php if ($byChannel !== []): ?>
            <table>
                <thead>
                <tr>
                    <th><?= __('渠道') ?></th>
                    <th class="w-text" data-align="end"><?= __('收入') ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($byChannel as $row): ?>
                    <tr>
                        <th><code><?= $h($row['channel_code'] ?? $row['channel'] ?? '—') ?></code></th>
                        <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['purchase_revenue'] ?? $row['revenue'] ?? 0, 2)) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    <?php endif; ?>
</section>
