<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-realtime.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * Dashboard Widget: 像素实时动向
 *
 * @widget.code {pixel_realtime}
 * @widget.name {像素实时动向}
 * @widget.description {展示最近一小时像素事件触发情况。}
 * @widget.type {list}
 * @widget.area {backend}
 * @widget.position {["dashboard-side","dashboard-detail"]}
 * @widget.page_layouts {["dashboard"]}
 * @widget.slot {dashboard-side}
 * @widget.supports {["dashboard-widget","dashboard-slot-side","dashboard-list","dashboard-status","dashboard-stat"]}
 * @param website_id {default="",type="string",label="站点 ID",description="留空时跟随当前 Dashboard 站点。"}
 *
 * @widget.default_injections {[{"layout_type":"dashboard","layout_option":"default","default_view":"weline_visitor_event_statistics","target_type":"website","slot":"dashboard-side","area":"content","sort_order":80,"required":true,"reason":"安装访客统计后自动展示像素实时动向","config":{"dashboard_layout":{"colSpan":3,"rowSpan":2,"sortOrder":80}}}]}
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => 'today',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}
$dashboard = $service->getDashboard($config);
$rows = is_array($dashboard['realtime_rows'] ?? null) ? $dashboard['realtime_rows'] : [];
$recent = array_slice(is_array($dashboard['recent_events'] ?? null) ? $dashboard['recent_events'] : [], 0, 3);
$max = 1;
$total = 0;
foreach ($rows as $row) {
    $count = (int)($row['count'] ?? 0);
    $total += $count;
    $max = max($max, $count);
}
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$filters = is_array($dashboard['filters'] ?? null) ? $dashboard['filters'] : [];
$listConfig = array_merge($config, [
    'website_id' => array_key_exists('website_id', $filters) ? $filters['website_id'] : ($config['website_id'] ?? null),
    'range' => 'today',
]);
$detailUrl = $service->detailUrl($listConfig);
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-realtime">
    <header>
        <h3><?= __('像素实时动向') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('查看事件列表') ?></a>
    </header>
    <div class="pixel-realtime-total">
        <strong><?= $h($service->formatNumber($total)) ?></strong>
        <span><?= __('事件触发') ?></span>
    </div>
    <div class="pixel-realtime-bars">
        <?php foreach ($rows as $row): ?>
            <?php
            $count = (int)($row['count'] ?? 0);
            $height = max(6, min(100, (int)round(($count / $max) * 100)));
            $time = substr((string)($row['timestamp'] ?? ''), 11, 5) ?: '-';
            ?>
            <div title="<?= $h(__('事件 %{1}', [$count])) ?>">
                <i data-widget-style="height: <?= (int)$height ?>%"></i>
                <span><?= $h($time) ?></span>
            </div>
        <?php endforeach; ?>
    </div>
    <?php if ($recent !== []): ?>
        <ul class="pixel-recent-list">
            <?php foreach ($recent as $event): ?>
                <?php
                $recentEvent = (string)($event['event'] ?? '');
                $recentUrl = $service->detailUrl(array_merge($listConfig, [
                    'event' => $recentEvent,
                ]));
                ?>
                <li>
                    <a class="pixel-recent-link" href="<?= $h($recentUrl) ?>">
                        <strong><?= $h($recentEvent !== '' ? $recentEvent : '-') ?></strong>
                    </a>
                    <span><?= $h(substr((string)($event['created_at'] ?? ''), 11, 5)) ?></span>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</section>
