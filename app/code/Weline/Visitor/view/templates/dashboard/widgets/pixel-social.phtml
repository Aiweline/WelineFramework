<?php
/**
 * @widget.source {Weline_Visitor::css/widgets/widget-pixel-social.css}
 * Dashboard Widget: 社媒流量（E03b，catalog pixel_social）
 */
$service = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\PixelDashboardWidgetData::class);
$config = [
    'range' => $this->getData('range') ?: '7d',
];
$widgetWebsiteId = $this->getData('website_id');
if ($widgetWebsiteId !== null && $widgetWebsiteId !== '' && $widgetWebsiteId !== 'all') {
    $config['website_id'] = $widgetWebsiteId;
}

$report = $service->getSocialReport($config);
$rows = is_array($report['rows'] ?? null) ? $report['rows'] : [];
$range = (string)($report['range'] ?? $config['range']);
$error = trim((string)($report['error'] ?? ''));
$clamped = !empty($report['window_clamped']);
$dimension = (string)($report['dimension'] ?? 'channel_code');
$catalogFilters = is_array($report['filters'] ?? null) ? $report['filters'] : [];
$listUrl = (string)($report['list_url'] ?? $service->listUrl($config, ['traffic_type' => 'social']));
$detailUrl = (string)($report['detail_url'] ?? $service->detailUrl($config));
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="dashboard-widget dashboard-widget-pixel dashboard-widget-pixel-social" data-pixel-widget="pixel_social">
    <header>
        <h3><?= __('社媒流量') ?></h3>
        <a class="pixel-widget-detail" href="<?= $h($listUrl) ?>"><?= __('事件列表') ?></a>
    </header>
    <div class="pixel-social-meta">
        <span><?= $h($service->rangeLabel($range)) ?></span>
        <small>traffic_type=social</small>
        <?php if ($clamped): ?>
            <small><?= __('已按热短窗截取') ?></small>
        <?php endif; ?>
        <a class="pixel-widget-detail" href="<?= $h($detailUrl) ?>"><?= __('详情报表') ?></a>
    </div>
    <?php if ($error !== '' && $rows === []): ?>
        <div class="pixel-empty compact"><?= $h($error) ?></div>
    <?php elseif ($rows === []): ?>
        <div class="pixel-empty compact"><?= __('当前范围暂无社媒流量数据') ?></div>
    <?php else: ?>
        <table>
            <thead>
            <tr>
                <th><?= __('渠道') ?></th>
                <th class="w-text" data-align="end"><?= __('事件') ?></th>
                <th class="w-text" data-align="end"><?= __('价值') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($rows as $row): ?>
                <?php
                $dimValue = (string)($row['dimension_value'] ?? '');
                $drillUrl = $service->channelDrilldownUrl($config, $dimension, $dimValue, $catalogFilters);
                ?>
                <tr>
                    <th>
                        <?php if ($dimValue !== ''): ?>
                            <a class="pixel-social-link" href="<?= $h($drillUrl) ?>">
                                <code><?= $h($dimValue) ?></code>
                            </a>
                        <?php else: ?>
                            <code>—</code>
                        <?php endif; ?>
                    </th>
                    <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['events'] ?? 0)) ?></td>
                    <td class="w-text" data-align="end"><?= $h($service->formatNumber($row['value_sum'] ?? 0, 2)) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
