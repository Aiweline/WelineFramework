<script>
(function () {
    var mediumByType = <?= $mediumJson ?>;
    var codeInput = document.getElementById('channel-code');
    var typeSelect = document.getElementById('channel-traffic-type');
    var mediumInput = document.getElementById('channel-utm-medium');
    var sourceInput = document.getElementById('channel-utm-source');
    var campPrev = document.getElementById('preview-utm-campaign');
    var wchPrev = document.getElementById('preview-wch');
    var pathInput = document.getElementById('channel-landing-path');
    var urlInput = document.getElementById('channel-landing-url');
    var copyBtn = document.getElementById('channel-copy-url');
    var copyOk = document.getElementById('channel-copy-ok');
    var enabledInput = document.getElementById('channel-enabled');
    var codeReadonly = <?= $codeReadonly ? 'true' : 'false' ?>;
    var mediumTouched = <?= \json_encode(\trim((string)($form['utm_medium'] ?? '')) !== '') ?>;
    var baseUrl = urlInput ? (urlInput.getAttribute('data-base-url') || '') : '';

    function normalizePath(path) {
        path = (path || '/').trim();
        if (!path || path === '/') return '/';
        if (/^(https?:)?\/\//i.test(path)) return '/';
        if (path.charAt(0) !== '/') path = '/' + path;
        path = path.split('?')[0].split('#')[0];
        return path || '/';
    }

    function syncPreview() {
        var code = (codeInput && codeInput.value ? codeInput.value : '').trim().toLowerCase();
        if (campPrev) campPrev.textContent = code || 'your_code';
        if (wchPrev) wchPrev.textContent = code || 'your_code';
        if (!mediumTouched && mediumInput && typeSelect) {
            mediumInput.value = mediumByType[typeSelect.value] || 'custom';
        }
        var enabled = !enabledInput || enabledInput.checked;
        var path = normalizePath(pathInput ? pathInput.value : '/');
        var source = (sourceInput && sourceInput.value ? sourceInput.value : 'weline').trim() || 'weline';
        var medium = (mediumInput && mediumInput.value ? mediumInput.value : 'custom').trim() || 'custom';
        var qs = 'utm_source=' + encodeURIComponent(source)
            + '&utm_medium=' + encodeURIComponent(medium)
            + '&utm_campaign=' + encodeURIComponent(code || 'your_code')
            + '&wch=' + encodeURIComponent(code || 'your_code');
        var url = '';
        if (enabled && code && baseUrl) {
            url = baseUrl + (path === '/' ? '/' : path) + '?' + qs;
        }
        if (urlInput) urlInput.value = url;
        if (copyBtn) copyBtn.disabled = !url;
    }

    if (codeInput && !codeReadonly) codeInput.addEventListener('input', syncPreview);
    if (typeSelect) typeSelect.addEventListener('change', function () {
        mediumTouched = false;
        syncPreview();
    });
    if (mediumInput) mediumInput.addEventListener('input', function () { mediumTouched = true; syncPreview(); });
    if (sourceInput) sourceInput.addEventListener('input', syncPreview);
    if (pathInput) pathInput.addEventListener('input', syncPreview);
    if (enabledInput) enabledInput.addEventListener('change', syncPreview);
    if (copyBtn) copyBtn.addEventListener('click', function () {
        var text = urlInput ? urlInput.value : '';
        if (!text) return;
        var done = function () {
            if (copyOk) {
                copyOk.classList.remove('d-none');
                setTimeout(function () { copyOk.classList.add('d-none'); }, 1500);
            }
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(function () {
                urlInput.select();
                try { document.execCommand('copy'); done(); } catch (e) {}
            });
        } else {
            urlInput.select();
            try { document.execCommand('copy'); done(); } catch (e2) {}
        }
    });
    syncPreview();
})();
</script>
