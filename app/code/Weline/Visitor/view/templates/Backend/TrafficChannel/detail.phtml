<?php
/**
 * 流量渠道详情：总计（B10）+ 漏斗（B12 营销简漏斗 / F05b 电商四步可切换）+ 事件轨迹（B11）。
 *
 * @var \Weline\Framework\View\Template $this
 * @var array $channel
 * @var array $hot_totals
 * @var array $timeline
 * @var array $funnel
 * @var string $funnel_mode
 * @var array $landing_preview
 * @var string $page_title
 */

$channel = $channel ?? [];
$hotTotals = $hot_totals ?? ['windows' => [], 'error' => '', 'channel_code' => ''];
$timeline = $timeline ?? [
    'days' => 7,
    'sessions' => [],
    'events' => [],
    'event_count' => 0,
    'session_count' => 0,
    'error' => '',
];
$funnel = $funnel ?? [
    'days' => 7,
    'steps' => [],
    'step1_sessions' => 0,
    'scored_sessions' => 0,
    'error' => '',
];
$landingPreview = $landing_preview ?? [];
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$channelId = (int)($channel['pixel_channel_id'] ?? $channel['id'] ?? 0);
$indexUrl = $this->getBackendUrlPath('visitor/backend/traffic-channel/index');
$editUrl = $this->getBackendUrlPath('visitor/backend/traffic-channel/getEdit', ['id' => $channelId]);
$timeline7Url = $this->getBackendUrlPath('visitor/backend/traffic-channel/getDetail', [
    'id' => $channelId,
    'timeline_days' => 7,
]);
$timeline30Url = $this->getBackendUrlPath('visitor/backend/traffic-channel/getDetail', [
    'id' => $channelId,
    'timeline_days' => 30,
]);
$websiteId = (int)($channel['website_id'] ?? 0);
$windows = is_array($hotTotals['windows'] ?? null) ? $hotTotals['windows'] : [];
$timelineDays = (int)($timeline['days'] ?? 7);
$sessions = is_array($timeline['sessions'] ?? null) ? $timeline['sessions'] : [];
$funnelSteps = is_array($funnel['steps'] ?? null) ? $funnel['steps'] : [];
// F05b：漏斗模式切换（营销简漏斗 / 电商四步）；日窗切换需带上当前模式
$funnelMode = \Weline\Visitor\Service\PixelChannelFunnelMode::normalize($funnel_mode ?? null);
$funnelIsEcommerce = \Weline\Visitor\Service\PixelChannelFunnelMode::isEcommerce($funnelMode);
$funnelFirstStepKey = (string)($funnelSteps[0]['key'] ?? '');
$funnelUrl = function (int $days, string $mode) use ($channelId): string {
    $query = ['id' => $channelId, 'timeline_days' => $days];
    if ($mode !== \Weline\Visitor\Service\PixelChannelFunnelMode::DEFAULT_MODE) {
        $query['funnel_mode'] = $mode;
    }

    return $this->getBackendUrlPath('visitor/backend/traffic-channel/getDetail', $query) . '#channel-funnel';
};
$funnelDay7Url = $funnelUrl(7, $funnelMode);
$funnelDay30Url = $funnelUrl(30, $funnelMode);
$funnelMarketingUrl = $funnelUrl($timelineDays, \Weline\Visitor\Service\PixelChannelFunnelMode::MARKETING);
$funnelEcommerceUrl = $funnelUrl($timelineDays, \Weline\Visitor\Service\PixelChannelFunnelMode::ECOMMERCE);
$metricLabels = [
    'events' => (string)__('事件数'),
    'sessions' => (string)__('会话数'),
    'users' => (string)__('访客数'),
    'value_sum' => (string)__('价值合计'),
    'page_views' => (string)__('浏览'),
    'interactions' => (string)__('互动点击'),
    'add_to_carts' => (string)__('加购'),
    'conversions' => (string)__('转化'),
];
$channelCode = trim((string)($channel['code'] ?? ''));
$trafficType = trim((string)($channel['traffic_type'] ?? ''));
// C07：渠道详情 → 像素 list 下钻（参数契约与看板一致）
$listDrillQuery = \Weline\Visitor\Service\PixelStatisticsService::buildListDrilldownQuery([
    'range' => $timelineDays === 30 ? '30d' : '7d',
], array_filter([
    'websiteId' => $websiteId > 0 ? (string)$websiteId : '',
    'channel_code' => $channelCode,
    'traffic_type' => $trafficType,
], static fn($v): bool => $v !== null && $v !== ''));
$listDrillUrl = $channelCode !== ''
    ? $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', $listDrillQuery)
    : '';
?>
<div class="weline-traffic-channel-detail">
    <div class="w-cluster" data-justify="between" data-align="center" style="--w-mb:var(--weline-space-4);">
        <div>
            <h1 class="h4" style="--w-mb:var(--weline-space-1);"><lang>渠道详情</lang></h1>
            <div class="w-text" data-tone="muted">
                <?= $h($channel['name'] ?? '') ?>
                · <code><?= $h($channel['code'] ?? '') ?></code>
                · <?= $websiteId === 0 ? $h(__('全局')) : $h(__('站点') . ' ' . $websiteId) ?>
                · <?= $h($channel['traffic_type'] ?? '') ?>
            </div>
        </div>
        <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <a class="w-button" href="<?= $h($indexUrl) ?>" data-tone="neutral" data-variant="outline" data-size="sm"><lang>返回列表</lang></a>
            <?php if ($listDrillUrl !== ''): ?>
                <a class="w-button" href="<?= $h($listDrillUrl) ?>" data-tone="primary" data-variant="outline" data-size="sm"><lang>像素事件列表</lang></a>
            <?php endif; ?>
            <a class="w-button" href="<?= $h($editUrl) ?>" data-tone="primary" data-variant="outline" data-size="sm"><lang>编辑</lang></a>
        </div>
    </div>

    <?php if (!empty($landingPreview['showable']) && !empty($landingPreview['url'])): ?>
        <div class="w-alert w-cluster" data-w-border="border" data-justify="between" data-align="center" data-tone="muted">
            <div class="w-text me-3" data-truncate="true">
                <lang>投放链接</lang>：
                <code class="user-select-all"><?= $h($landingPreview['url']) ?></code>
            </div>
            <button type="button" class="w-button js-copy-landing" data-url="<?= $h($landingPreview['url']) ?>" data-tone="success" data-variant="outline" data-size="sm"><lang>复制链接</lang></button>
        </div>
    <?php endif; ?>

    <?php if (($hotTotals['error'] ?? '') !== ''): ?>
        <div class="w-alert" data-tone="warning">
            <lang>热表总计暂不可用（扁平列未就绪或查询失败）。完成 setup:upgrade 后重试。</lang>
        </div>
    <?php endif; ?>

    <div class="w-grid" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-6);">
        <?php foreach ([7, 30] as $days): ?>
            <?php
            $window = is_array($windows[$days] ?? null) ? $windows[$days] : [];
            ?>
            <div style="--w-span-lg:6;">
                <div class="w-card" data-w-height="full">
                    <div class="w-card__header w-cluster" data-justify="between" data-align="center">
                        <strong><?= $h(__('近 %{1} 天', [(string)$days])) ?></strong>
                        <small class="w-text" data-tone="muted">
                            <?= $h(($window['start_date'] ?? '') . ' ~ ' . ($window['end_date'] ?? '')) ?>
                        </small>
                    </div>
                    <div class="w-card__body">
                        <div class="w-grid" style="--w-gap:var(--weline-space-4);">
                            <?php foreach ($metricLabels as $key => $label): ?>
                                <?php
                                $value = $window[$key] ?? 0;
                                $display = $key === 'value_sum'
                                    ? number_format((float)$value, 2)
                                    : number_format((int)$value);
                                ?>
                                <div style="--w-span:6;--w-span-md:4;">
                                    <div data-w-border="border" data-w-radius="md" data-w-height="full" style="--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">
                                        <div class="w-text" data-tone="muted" data-size="sm"><?= $h($label) ?></div>
                                        <div class="fs-5 w-text" data-weight="strong"><?= $h($display) ?></div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <div class="w-card" id="channel-funnel" data-funnel-mode="<?= $h($funnelMode) ?>" style="--w-mb:var(--weline-space-4);">
        <div class="w-card__header w-cluster" data-wrap="true" data-justify="between" data-align="center" style="--w-gap:var(--weline-space-2);">
            <div>
                <strong><?= $h(\Weline\Visitor\Service\PixelChannelFunnelMode::label($funnelMode)) ?></strong>
                <span class="w-text ms-2" data-tone="muted" data-size="sm">
                    <?= $h(__('按会话去重 · 近 %{1} 天 · %{2}占比', [
                        (string)$timelineDays,
                        \Weline\Visitor\Service\PixelChannelFunnelMode::baselineLabel($funnelMode),
                    ])) ?>
                </span>
            </div>
            <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                <div class="w-button-group" role="group" data-funnel-mode-switch>
                    <a class="w-button <?= $funnelIsEcommerce ? 'btn-outline-secondary' : 'btn-primary' ?>" href="<?= $h($funnelMarketingUrl) ?>"><lang>营销简漏斗</lang></a>
                    <a class="w-button <?= $funnelIsEcommerce ? 'btn-primary' : 'btn-outline-secondary' ?>" href="<?= $h($funnelEcommerceUrl) ?>"><lang>电商四步</lang></a>
                </div>
                <div class="w-button-group" role="group">
                    <a class="w-button <?= $timelineDays === 7 ? 'btn-primary' : 'btn-outline-secondary' ?>" href="<?= $h($funnelDay7Url) ?>"><lang>近 7 天</lang></a>
                    <a class="w-button <?= $timelineDays === 30 ? 'btn-primary' : 'btn-outline-secondary' ?>" href="<?= $h($funnelDay30Url) ?>"><lang>近 30 天</lang></a>
                </div>
            </div>
        </div>
        <div class="w-card__body">
            <?php if (($funnel['error'] ?? '') !== ''): ?>
                <div class="w-alert" data-tone="warning" style="--w-mb:0;">
                    <lang>渠道漏斗暂不可用（扁平列未就绪或查询失败）。</lang>
                </div>
            <?php elseif ((int)($funnel['step1_sessions'] ?? 0) <= 0): ?>
                <p class="w-text" data-tone="muted" style="--w-mb:0;">
                    <?= $h(\Weline\Visitor\Service\PixelChannelFunnelMode::emptyHint($funnelMode)) ?>
                </p>
            <?php else: ?>
                <div class="w-table-wrap">
                    <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                        <thead>
                        <tr>
                            <th><lang>步骤</lang></th>
                            <th class="w-text" data-align="end"><lang>会话数</lang></th>
                            <th class="w-text" data-align="end">
                                <?= $h(\Weline\Visitor\Service\PixelChannelFunnelMode::baselineLabel($funnelMode)) ?>
                            </th>
                            <th class="w-text" data-align="end"><lang>相对上步流失</lang></th>
                            <th style="min-width:160px"><lang>占比条</lang></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php foreach ($funnelSteps as $step): ?>
                            <?php
                            $rate = (float)($step['rate_from_step1'] ?? 0);
                            $dropoff = (float)($step['dropoff_from_prev'] ?? 0);
                            $pct = (int)round($rate * 100);
                            $labelKey = (string)($step['label'] ?? $step['key'] ?? '');
                            ?>
                            <tr>
                                <td><?= $h(__($labelKey)) ?></td>
                                <td class="w-text" data-align="end"><?= $h(number_format((int)($step['sessions'] ?? 0))) ?></td>
                                <td class="w-text" data-align="end"><?= $h(number_format($rate * 100, 1)) ?>%</td>
                                <td class="w-text" data-align="end">
                                    <?= (string)($step['key'] ?? '') === $funnelFirstStepKey
                                        ? '—'
                                        : $h(number_format($dropoff * 100, 1) . '%') ?>
                                </td>
                                <td>
                                    <div class="w-progress" style="height:8px">
                                        <div class="w-progress__bar" role="progressbar" style="width: <?= $h((string)max(0, min(100, $pct))) ?>%" aria-valuenow="<?= $h((string)$pct) ?>" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;--w-mt:var(--weline-space-2);">
                    <?= $h(\Weline\Visitor\Service\PixelChannelFunnelMode::description($funnelMode)) ?>
                </p>
            <?php endif; ?>
        </div>
    </div>

    <div class="w-card" id="channel-timeline" style="--w-mb:var(--weline-space-4);">
        <div class="w-card__header w-cluster" data-wrap="true" data-justify="between" data-align="center" style="--w-gap:var(--weline-space-2);">
            <div>
                <strong><lang>事件轨迹</lang></strong>
                <span class="w-text ms-2" data-tone="muted" data-size="sm">
                    <?= $h(__('%{1} 个会话 / %{2} 条事件', [
                        (string)(int)($timeline['session_count'] ?? 0),
                        (string)(int)($timeline['event_count'] ?? 0),
                    ])) ?>
                </span>
            </div>
            <div class="w-button-group" role="group">
                <a class="w-button <?= $timelineDays === 7 ? 'btn-primary' : 'btn-outline-secondary' ?>" href="<?= $h($timeline7Url) ?>#channel-timeline"><lang>近 7 天</lang></a>
                <a class="w-button <?= $timelineDays === 30 ? 'btn-primary' : 'btn-outline-secondary' ?>" href="<?= $h($timeline30Url) ?>#channel-timeline"><lang>近 30 天</lang></a>
            </div>
        </div>
        <div class="w-card__body">
            <?php if (($timeline['error'] ?? '') !== ''): ?>
                <div class="w-alert" data-tone="warning" style="--w-mb:0;">
                    <lang>事件轨迹暂不可用（扁平列未就绪或查询失败）。</lang>
                </div>
            <?php elseif (!$sessions): ?>
                <p class="w-text" data-tone="muted" style="--w-mb:0;"><lang>该窗口暂无归因到此渠道的事件。</lang></p>
            <?php else: ?>
                <?php foreach ($sessions as $session): ?>
                    <?php
                    $sessionId = (string)($session['session_id'] ?? '');
                    $sessionEvents = is_array($session['events'] ?? null) ? $session['events'] : [];
                    ?>
                    <div data-w-border="border" data-w-radius="md" style="--w-mb:var(--weline-space-4);--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);">
                        <div class="w-cluster" data-wrap="true" data-justify="between" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-2);">
                            <div>
                                <span class="w-text" data-tone="muted"><lang>会话</lang></span>
                                <code><?= $sessionId !== '' ? $h($sessionId) : $h(__('（无 session_id）')) ?></code>
                            </div>
                            <div class="w-text" data-tone="muted" data-size="sm">
                                <?= $h(($session['started_at'] ?? '') . ' → ' . ($session['ended_at'] ?? '')) ?>
                                · <?= $h(__('%{1} 事件', [(string)(int)($session['event_count'] ?? 0)])) ?>
                            </div>
                        </div>
                        <ol class="ps-3" style="--w-mb:0;">
                            <?php foreach ($sessionEvents as $event): ?>
                                <li style="--w-mb:var(--weline-space-2);">
                                    <div class="align-items-baseline w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                                        <span class="w-text" data-tone="muted" data-size="sm"><?= $h($event['created_at'] ?? '') ?></span>
                                        <strong><?= $h($event['event'] ?? '') ?></strong>
                                        <?php if ((float)($event['value'] ?? 0) > 0): ?>
                                            <span class="w-badge" data-w-background="muted" data-tone="muted"><?= $h(number_format((float)$event['value'], 2)) ?></span>
                                        <?php endif; ?>
                                    </div>
                                    <?php if (($event['url'] ?? '') !== ''): ?>
                                        <div class="w-text" title="<?= $h($event['url']) ?>" data-truncate="true" data-size="sm">
                                            <?= $h($event['url']) ?>
                                        </div>
                                    <?php endif; ?>
                                </li>
                            <?php endforeach; ?>
                        </ol>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    </div>

    <p class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-4);--w-mb:0;">
        <lang>口径：热表明细按 channel_code 过滤；会话内事件按时间升序；漏斗按会话去重顺序步进。</lang>
    </p>
</div>
<script>
(function () {
    document.querySelectorAll('.js-copy-landing').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-url') || '';
            if (!text) return;
            var done = function () {
                var old = btn.textContent;
                btn.textContent = <?= \json_encode((string)__('已复制'), JSON_UNESCAPED_UNICODE) ?>;
                setTimeout(function () { btn.textContent = old; }, 1200);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done);
            }
        });
    });
})();
</script>
