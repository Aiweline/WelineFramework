<?php
/**
 * C01–C03：像素事件明细 list（热表分页 + 归因筛选表单）。
 *
 * @var \Weline\Framework\View\Template $this
 * @var string $page_title
 * @var array $rows
 * @var array $filters
 * @var array $pagination
 * @var list<string> $traffic_type_options
 * @var bool $list_ready
 * @var string $list_error
 */

$pageTitle = (string)($page_title ?? __('像素事件列表'));
$rows = $rows ?? [];
$filters = $filters ?? [];
$pagination = $pagination ?? ['page' => 1, 'page_size' => 50, 'page_count' => 0, 'total' => 0];
$trafficTypeOptions = $traffic_type_options ?? \Weline\Visitor\Model\PixelChannel::TRAFFIC_TYPES;
$listReady = (bool)($list_ready ?? false);
$listError = (string)($list_error ?? '');
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$page = max(1, (int)($pagination['page'] ?? 1));
$pageSize = max(1, (int)($pagination['page_size'] ?? 50));
$pageCount = max(0, (int)($pagination['page_count'] ?? 0));
$total = max(0, (int)($pagination['total'] ?? 0));

$selectedWebsite = (string)($filters['website_id_raw'] ?? '');
$selectedEvent = (string)($filters['event'] ?? '');
$selectedRange = (string)($filters['range'] ?? '30d');
$rangeLabels = [
    'today' => (string)__('今天'),
    'yesterday' => (string)__('昨天'),
    '7d' => (string)__('近 7 天'),
    '30d' => (string)__('近 30 天'),
    '90d' => (string)__('近 90 天'),
    'custom' => (string)__('自定义'),
];
$startInput = $selectedRange === 'custom' ? (string)($filters['start_day'] ?? '') : '';
$endInput = $selectedRange === 'custom' ? (string)($filters['end_day'] ?? '') : '';
$selectedChannel = (string)($filters['channel_code'] ?? '');
$selectedTrafficType = (string)($filters['traffic_type'] ?? '');
$selectedUtmSource = (string)($filters['utm_source'] ?? '');
$selectedUtmMedium = (string)($filters['utm_medium'] ?? '');
$selectedUtmCampaign = (string)($filters['utm_campaign'] ?? '');

$queryBase = array_filter([
    'websiteId' => $selectedWebsite,
    'event' => $selectedEvent,
    'range' => $selectedRange,
    'startDate' => (string)($filters['start_day'] ?? ''),
    'endDate' => (string)($filters['end_day'] ?? ''),
    'channel_code' => $selectedChannel,
    'traffic_type' => $selectedTrafficType,
    'utm_source' => $selectedUtmSource,
    'utm_medium' => $selectedUtmMedium,
    'utm_campaign' => $selectedUtmCampaign,
    'pageSize' => (string)$pageSize,
], static fn($v): bool => $v !== null && $v !== '');

$formAction = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list');
$indexUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/index', $queryBase);
$listUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', $queryBase);
$archiveListUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/archive-list', $queryBase);
$resetUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list');
$exportUrl = $this->getBackendUrlPath(
    'visitor/backend/pixel-dashboard/export',
    array_merge($queryBase, ['format' => 'csv'])
);
$prevUrl = $page > 1
    ? $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', array_merge($queryBase, ['page' => $page - 1]))
    : '';
$nextUrl = ($pageCount > 0 && $page < $pageCount)
    ? $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', array_merge($queryBase, ['page' => $page + 1]))
    : '';
?>
<style>
.weline-pixel-list-toolbar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem 1rem;
    align-items: end;
}
.weline-pixel-list-toolbar .weline-pixel-list-actions {
    grid-column: 1 / -1;
}
@media (min-width: 992px) {
    .weline-pixel-list-toolbar .weline-pixel-list-actions {
        grid-column: auto;
    }
}
</style>
<div class="weline-pixel-dashboard-list container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1"><?= $h($pageTitle) ?></h1>
            <div class="text-muted">
                <lang>热表明细列表</lang>
                · <?= $h(__('共 %{1} 条', [(string)$total])) ?>
                <?php if (!empty($filters['range'])): ?>
                    · <?= $h((string)($filters['start_day'] ?? '') . ' ~ ' . (string)($filters['end_day'] ?? '')) ?>
                <?php endif; ?>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="<?= $h($indexUrl) ?>"><lang>返回看板</lang></a>
            <a class="btn btn-sm btn-outline-secondary" href="<?= $h($archiveListUrl) ?>"><lang>冷归档明细</lang></a>
            <a class="btn btn-sm btn-outline-primary" href="<?= $h($listUrl) ?>"><lang>刷新</lang></a>
            <a class="btn btn-sm btn-primary" href="<?= $h($exportUrl) ?>">
                <i class="mdi mdi-download"></i> <lang>按当前筛选导出 CSV</lang>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <template>Weline_Component::message.phtml</template>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <w:form method="get" action="@var($formAction)" class="weline-pixel-list-toolbar" id="pixel-list-filter-form">
                <div class="weline-pixel-website-filter">
                    <label class="form-label" for="list-filter-website_trigger"><lang>站点</lang></label>
                    <w:websites:website:select
                        id="list-filter-website"
                        name="websiteId"
                        value="selectedWebsite"
                        display="selectedWebsiteDisplay"
                        options="websiteSelectOptionsJson"
                        multiple="false"
                        allow-empty="true"
                        clearable="true"
                        empty-label="@lang(全部站点)"
                        placeholder="@lang(搜索站点名称或编码)"
                        class="weline-pixel-website-select"
                    />
                </div>
                <div>
                    <label class="form-label" for="list-filter-event"><lang>事件</lang></label>
                    <input type="text" name="event" id="list-filter-event" class="form-control"
                           value="<?= $h($selectedEvent) ?>" placeholder="<?= $h(__('全部事件')) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-range"><lang>时间范围</lang></label>
                    <select name="range" id="list-filter-range" class="form-select">
                        <?php foreach ($rangeLabels as $rangeValue => $rangeLabel): ?>
                            <option value="<?= $h($rangeValue) ?>" <?= $selectedRange === $rangeValue ? 'selected' : '' ?>>
                                <?= $h($rangeLabel) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="list-filter-start"><lang>开始日期</lang></label>
                    <input type="date" name="startDate" id="list-filter-start" class="form-control" value="<?= $h($startInput) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-end"><lang>结束日期</lang></label>
                    <input type="date" name="endDate" id="list-filter-end" class="form-control" value="<?= $h($endInput) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-channel"><lang>渠道码</lang></label>
                    <input type="text" name="channel_code" id="list-filter-channel" class="form-control"
                           value="<?= $h($selectedChannel) ?>" placeholder="wch / channel_code">
                </div>
                <div>
                    <label class="form-label" for="list-filter-traffic"><lang>流量类型</lang></label>
                    <select name="traffic_type" id="list-filter-traffic" class="form-select">
                        <option value="" <?= $selectedTrafficType === '' ? 'selected' : '' ?>><lang>全部类型</lang></option>
                        <?php foreach ($trafficTypeOptions as $type): ?>
                            <?php $type = (string)$type; ?>
                            <option value="<?= $h($type) ?>" <?= $selectedTrafficType === $type ? 'selected' : '' ?>>
                                <?= $h($type) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="list-filter-utm-source">utm_source</label>
                    <input type="text" name="utm_source" id="list-filter-utm-source" class="form-control"
                           value="<?= $h($selectedUtmSource) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-utm-medium">utm_medium</label>
                    <input type="text" name="utm_medium" id="list-filter-utm-medium" class="form-control"
                           value="<?= $h($selectedUtmMedium) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-utm-campaign">utm_campaign</label>
                    <input type="text" name="utm_campaign" id="list-filter-utm-campaign" class="form-control"
                           value="<?= $h($selectedUtmCampaign) ?>">
                </div>
                <div>
                    <label class="form-label" for="list-filter-pagesize"><lang>每页条数</lang></label>
                    <select name="pageSize" id="list-filter-pagesize" class="form-select">
                        <?php foreach ([20, 50, 100, 200] as $size): ?>
                            <option value="<?= $size ?>" <?= $pageSize === $size ? 'selected' : '' ?>><?= $size ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="d-flex gap-2 weline-pixel-list-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="mdi mdi-filter-outline"></i> <lang>应用筛选</lang>
                    </button>
                    <a href="<?= $h($resetUrl) ?>" class="btn btn-outline-secondary"><lang>重置</lang></a>
                </div>
            </w:form>
        </div>
    </div>

    <?php if ($listError !== ''): ?>
        <div class="alert alert-warning">
            <lang>事件列表查询失败（扁平列未就绪或数据库异常）。</lang>
        </div>
    <?php endif; ?>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                    <tr>
                        <th><lang>时间</lang></th>
                        <th><lang>事件</lang></th>
                        <th><lang>站点</lang></th>
                        <th><lang>渠道码</lang></th>
                        <th><lang>流量类型</lang></th>
                        <th><lang>会话</lang></th>
                        <th><lang>URL</lang></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php if (!$listReady): ?>
                        <tr>
                            <td colspan="7" class="text-muted text-center py-5">
                                <lang>列表未就绪。</lang>
                            </td>
                        </tr>
                    <?php elseif (!$rows): ?>
                        <tr>
                            <td colspan="7" class="text-muted text-center py-5">
                                <lang>当前筛选条件下暂无事件。</lang>
                            </td>
                        </tr>
                    <?php else: ?>
                        <?php foreach ($rows as $row): ?>
                            <?php $data = \is_array($row) ? $row : []; ?>
                            <tr>
                                <td class="text-nowrap"><?= $h($data['created_at'] ?? '') ?></td>
                                <td><?= $h($data['event'] ?? '') ?></td>
                                <td><?= $h((string)($data['website_id'] ?? '')) ?></td>
                                <td><code><?= $h($data['channel_code'] ?? '') ?></code></td>
                                <td><?= $h($data['traffic_type'] ?? '') ?></td>
                                <td><code><?= $h($data['session_id'] ?? '') ?></code></td>
                                <td class="text-truncate" style="max-width:280px" title="<?= $h($data['url'] ?? '') ?>">
                                    <?= $h($data['url'] ?? '') ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                    </tbody>
                </table>
            </div>
        </div>
        <?php if ($listReady && $pageCount > 0): ?>
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-muted small">
                    <?= $h(__('第 %{1} / %{2} 页 · 每页 %{3} 条', [
                        (string)$page,
                        (string)$pageCount,
                        (string)$pageSize,
                    ])) ?>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <?php if ($prevUrl !== ''): ?>
                        <a class="btn btn-outline-secondary" href="<?= $h($prevUrl) ?>"><lang>上一页</lang></a>
                    <?php else: ?>
                        <button type="button" class="btn btn-outline-secondary" disabled><lang>上一页</lang></button>
                    <?php endif; ?>
                    <?php if ($nextUrl !== ''): ?>
                        <a class="btn btn-outline-secondary" href="<?= $h($nextUrl) ?>"><lang>下一页</lang></a>
                    <?php else: ?>
                        <button type="button" class="btn btn-outline-secondary" disabled><lang>下一页</lang></button>
                    <?php endif; ?>
                </div>
            </div>
        <?php endif; ?>
    </div>
</div>
