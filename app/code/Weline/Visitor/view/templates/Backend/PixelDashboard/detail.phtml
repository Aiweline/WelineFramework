<script>
(function () {
    document.querySelectorAll('[data-pixel-detail-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var idx = btn.getAttribute('data-pixel-detail-toggle');
            var row = document.querySelector('[data-pixel-detail-row="' + idx + '"]');
            if (!row) return;
            row.classList.toggle('d-none');
        });
    });
})();
</script>
