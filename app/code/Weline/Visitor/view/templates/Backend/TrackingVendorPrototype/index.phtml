    <div id="tvp-variant-3" class="tvp-variant" data-variant-panel="3" <?= $variant === '3' ? '' : 'hidden' ?>>
        <div class="tvp-v3-hero">
            <div>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><lang>变体 3 · 详情三 Tab 为主</lang></p>
                <label class="w-text" data-size="sm">
                    <lang>当前供应商</lang>
                    <select id="tvp-v3-select" class="w-input" data-size="sm" data-testid="tvp-v3-select"></select>
                </label>
            </div>
            <div class="w-cluster" id="tvp-v3-status-chips" style="--w-gap:var(--weline-space-2);"></div>
