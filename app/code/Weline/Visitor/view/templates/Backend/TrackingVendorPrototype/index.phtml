                    </tr>
                    </thead>
                    <tbody id="tvp-v1-tbody"></tbody>
                </table>
            </div>
        </div>
        <div class="tvp-v1-drawer w-card" id="tvp-v1-drawer" data-testid="tvp-v1-drawer">
            <div class="w-card__body" id="tvp-v1-detail"></div>
        </div>
    </div>

    <div id="tvp-variant-2" class="tvp-variant" data-variant-panel="2" <?= $variant === '2' ? '' : 'hidden' ?>>
        <p class="w-text" data-tone="muted" data-size="sm"><lang>变体 2 · 左列表右详情</lang></p>
        <div class="tvp-v2-split">
            <aside class="tvp-v2-nav" id="tvp-v2-nav" data-testid="tvp-v2-nav"></aside>
            <div class="w-card">
                <div class="w-card__body" id="tvp-v2-detail" data-testid="tvp-v2-detail"></div>
            </div>
        </div>
