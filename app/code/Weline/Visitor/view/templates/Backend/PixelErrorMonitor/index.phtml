$disposeUrl = $this->getBackendUrlPath('visitor/backend/pixel-error-monitor/postDispose');
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP;
?>
