        <div class="w-alert" data-tone="warning" style="--w-mb:var(--weline-space-4);">
            <lang>错误表尚未就绪或查询失败；完成 setup:upgrade 后刷新。</lang>
        </div>
    <?php endif; ?>

    <form method="get" action="<?= $h($indexUrl) ?>" class="w-card" style="--w-mb:var(--weline-space-4);">
        <div class="w-card__body">
            <div class="w-cluster" data-wrap="wrap" style="--w-gap:var(--weline-space-3);">
                <label>
                    <span class="w-text" data-size="sm"><lang>站点ID</lang></span>
                    <input class="w-input" type="number" name="website_id" value="<?= $h((string)($filters['website_id'] ?? 0)) ?>" min="0">
                </label>
                <label>
                    <span class="w-text" data-size="sm"><lang>错误类型</lang></span>
                    <select class="w-select" name="error_type">
                        <option value=""><lang>全部类型</lang></option>
                        <?php foreach ($errorTypes as $type): ?>
                            <option value="<?= $h($type) ?>" <?= (($filters['error_type'] ?? '') === $type) ? 'selected' : '' ?>><?= $h($type) ?></option>
                        <?php endforeach; ?>
                    </select>
                </label>
                <label>
                    <span class="w-text" data-size="sm"><lang>处置</lang></span>
                    <select class="w-select" name="disposition">
                        <option value="open" <?= (($filters['disposition'] ?? '') === 'open') ? 'selected' : '' ?>><lang>待处理</lang></option>
                        <option value="ignored_stale" <?= (($filters['disposition'] ?? '') === 'ignored_stale') ? 'selected' : '' ?>><lang>不予理会(版本过期)</lang></option>
                        <option value="resolved" <?= (($filters['disposition'] ?? '') === 'resolved') ? 'selected' : '' ?>><lang>已解决</lang></option>
                        <option value="" <?= (($filters['disposition'] ?? '') === '') ? 'selected' : '' ?>><lang>全部处置</lang></option>
                    </select>
                </label>
                <label>
                    <span class="w-text" data-size="sm"><lang>Stale</lang></span>
                    <select class="w-select" name="stale">
                        <option value=""><lang>全部</lang></option>
                        <option value="1" <?= (($filters['stale'] ?? '') === '1') ? 'selected' : '' ?>><lang>仅过期客户端</lang></option>
                        <option value="0" <?= (($filters['stale'] ?? '') === '0') ? 'selected' : '' ?>><lang>非过期</lang></option>
                    </select>
                </label>
                <label>
                    <span class="w-text" data-size="sm"><lang>邮箱</lang></span>
                    <select class="w-select" name="has_email">
                        <option value=""><lang>全部</lang></option>
                        <option value="1" <?= (($filters['has_email'] ?? '') === '1') ? 'selected' : '' ?>><lang>有邮箱</lang></option>
                        <option value="0" <?= (($filters['has_email'] ?? '') === '0') ? 'selected' : '' ?>><lang>访客</lang></option>
                    </select>
                </label>
                <label>
                    <span class="w-text" data-size="sm"><lang>主题版本</lang></span>
                    <select class="w-select" name="theme_empty">
                        <option value=""><lang>全部</lang></option>
                        <option value="1" <?= (($filters['theme_empty'] ?? '') === '1') ? 'selected' : '' ?>><lang>主题版本为空</lang></option>
                    </select>
                </label>
                <button type="submit" class="w-button" data-tone="primary"><lang>筛选</lang></button>
            </div>
        </div>
    </form>

    <div class="w-card">
        <div class="w-card__body" style="--w-pt:0;--w-pe:0;--w-pb:0;--w-ps:0;overflow:auto;">
            <table class="w-table" style="--w-mb:0;">
                <thead>
                <tr>
                    <th><lang>时间</lang></th>
                    <th><lang>重要程度</lang></th>
                    <th><lang>类型</lang></th>
                    <th><lang>消息</lang></th>
                    <th><lang>身份</lang></th>
                    <th><lang>框架版本</lang></th>
                    <th><lang>主题版本</lang></th>
                    <th><lang>Stale</lang></th>
                    <th><lang>操作</lang></th>
                </tr>
                </thead>
                <tbody>
                <?php if (!$incidents): ?>
                    <tr>
                        <td colspan="9" class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);">
                            <lang>暂无错误事故。</lang>
                        </td>
                    </tr>
                <?php else: ?>
                    <?php
                    $severityClassifier = new \Weline\Visitor\Service\PixelErrorIncidentClassifier();
                    foreach ($incidents as $row): ?>
                        <?php
                        $data = \is_object($row) && \method_exists($row, 'getData') ? $row->getData() : (array)$row;
                        $id = (int)($data['incident_id'] ?? 0);
                        $identity = (string)($data['identity_kind'] ?? 'visitor');
                        if (!empty($data['identity_email'])) {
                            $identityLabel = (string)$data['identity_email'];
                        } elseif ($identity === 'user') {
                            $identityLabel = 'user#' . (int)($data['user_id'] ?? 0);
                        } else {
                            $identityLabel = (string)__('访客');
                        }
                        $themeVer = (string)($data['theme_published_version'] ?? $data['theme_published_version_id'] ?? '');
                        $severity = \strtolower(\trim((string)($data['severity'] ?? '')));
                        if ($severity === '') {
                            $severity = $severityClassifier->severityForType((string)($data['error_type'] ?? ''));
                        }
                        $severityTone = $severityClassifier->severityBadgeTone($severity);
                        $severityLabel = $severityClassifier->severityLabel($severity);
                        $accent = match ($severityTone) {
                            'info' => 'var(--weline-theme-info)',
                            'warning' => 'var(--weline-theme-warning)',
                            default => 'var(--weline-theme-danger)',
                        };
                        ?>
                        <tr style="box-shadow: inset 3px 0 0 <?= $h($accent) ?>;">
                            <td><?= $h((string)($data['created_at'] ?? '')) ?></td>
                            <td>
                                <span class="w-badge" data-tone="<?= $h($severityTone) ?>" data-size="sm">
                                    <?= $h(__($severityLabel)) ?>
                                </span>
                            </td>
                            <td><code><?= $h((string)($data['error_type'] ?? '')) ?></code></td>
                            <td><?= $h(\mb_substr((string)($data['error_message'] ?? ''), 0, 80)) ?></td>
                            <td><?= $h($identityLabel) ?></td>
                            <td><?= $h((string)($data['client_deploy_version'] ?? '')) ?></td>
                            <td><?= $themeVer !== '' ? $h($themeVer) : '—' ?></td>
                            <td>
                                <?php if (!empty($data['stale_client'])): ?>
                                    <span class="w-badge" data-tone="info" data-size="sm">Y</span>
                                <?php else: ?>
                                    <span class="w-text" data-tone="muted">N</span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <button type="button"
                                        class="w-button"
                                        data-size="sm"
                                        data-pixel-error-open="<?= $h((string)$id) ?>">
                                    <lang>查看</lang>
                                </button>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
                </tbody>
            </table>
        </div>
