</div>

<div class="w-dialog" id="pixel-error-detail-dialog" tabindex="-1" data-w-component="dialog" data-state="closed" hidden aria-hidden="true">
    <div class="w-dialog__frame" data-size="lg">
        <div class="w-dialog__surface">
            <div class="w-dialog__header">
                <h5 class="w-dialog__title">
                    <lang>错误详情</lang>
                    <span id="pixel-error-detail-id" class="w-text" data-tone="muted" data-size="sm"></span>
                </h5>
                <button type="button" class="w-button" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm" aria-label="<?= $h((string)__('关闭')) ?>"></button>
            </div>
            <div class="w-dialog__body" id="pixel-error-detail-body">
                <p class="w-text" data-tone="muted"><lang>加载中…</lang></p>
