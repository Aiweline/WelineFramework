<?php
/** @var \Weline\Framework\View\Template $this */
$scopeKind = (string)($this->getData('scope_kind') ?? $this->getData('work_scope_type') ?? 'website');
$scopeId = (int)($this->getData('work_scope_id') ?? 0);
$storeCode = (string)($this->getData('scope_store_code') ?? '');
$channelCode = (string)($this->getData('scope_channel_code') ?? '');
$inheritChain = $this->getData('scope_inherit_chain');
if (!\is_array($inheritChain) || $inheritChain === []) {
    $inheritChain = ['channel ← store ← website ← global'];
}
$globalAlert = (string)__('事件供应商按网站隔离存储；自定义事件按配置范围隔离且不继承。Global 会落到默认网站。切换范围/主题后请核对搭接。');
$metaParts = [$scopeKind !== '' ? $scopeKind : 'website'];
if ($storeCode !== '') {
    $metaParts[] = 'store=' . $storeCode;
}
if ($channelCode !== '') {
    $metaParts[] = 'channel=' . $channelCode;
}
$metaParts[] = 'website_id=' . $scopeId;
$chainText = \implode(' ← ', \array_map('strval', $inheritChain));
?>
<div class="tvp-scope-toolbar" data-testid="tv-work-scope-toolbar" data-align="start">
    <div class="w-field tvp-scope-toolbar__field">
        <label class="w-field__label" for="tracking-vendor-work-scope"><lang>配置范围</lang></label>
        <div class="w-field__control">
            <w:scope
                id="tracking-vendor-work-scope"
                name="target_scope"
                value="selected_scope"
                placeholder="@lang(选择网站、店铺或渠道)"
                search-placeholder="@lang(搜索配置范围)"
                aria-label="@lang(选择配置范围)"
                searchable="true"
                default-expand-all="true"
                required="true"
            />
        </div>
        <p class="tvp-field__hint" data-testid="tv-work-scope-inherit" style="margin-block-start:var(--weline-space-1);">
            <lang>继承：渠道 ← 店铺 ← 网站 · 自定义事件按范围隔离（换站/换主题后请在事件搭接核对）</lang>
        </p>
        <p class="w-text tvp-scope-toolbar__custom-tip" data-tone="muted" data-size="xs" style="--w-m:0;" data-testid="tv-work-scope-custom-tip" hidden>
            <lang>自定义事件不随范围继承</lang>
        </p>
        <p class="w-text" data-tone="muted" data-size="xs" style="--w-m:0;" data-testid="tv-work-scope-meta">
            <?= __('当前：%{1} · 链 %{2}', [\implode(' · ', $metaParts), $chainText]) ?>
        </p>
    </div>
</div>
<script type="application/json" id="tracking-vendor-work-scope-i18n"><?= htmlspecialchars(json_encode(['globalAlert' => $globalAlert], JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT), ENT_NOQUOTES, 'UTF-8') ?></script>
