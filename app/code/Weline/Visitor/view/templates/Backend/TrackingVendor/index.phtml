    function parseUrlInsights(raw) {
        var text = String(raw || '').trim();
        if (!text) {
            return { path: '', params: [], channelHints: [] };
        }
        try {
            var u = new URL(text, window.location.origin);
            var params = [];
            var channelHints = [];
            u.searchParams.forEach(function (value, key) {
                params.push({ key: key, value: value });
                var lk = String(key).toLowerCase();
                if (lk.indexOf('utm_') === 0 || lk === 'channel' || lk === 'channel_code'
                    || lk === 'store' || lk === 'store_code' || lk === 'gclid' || lk === 'fbclid'
                    || lk === 'from' || lk === 'source' || lk === 'medium' || lk === 'campaign') {
                    channelHints.push(key + '=' + value);
                }
            });
            return {
                path: (u.pathname || '/') + (u.search || ''),
                host: u.host || '',
                params: params.slice(0, 12),
                channelHints: channelHints.slice(0, 6)
            };
        } catch (e) {
            return { path: text.slice(0, 160), params: [], channelHints: [] };
        }
    }

    function eventParamsHtml(params) {
        if (!params || typeof params !== 'object') {
            return '<div class="tvp-acc-params" data-empty="1">无事件参数</div>';
        }
        var keys = Object.keys(params);
        if (!keys.length) {
            return '<div class="tvp-acc-params" data-empty="1">无事件参数</div>';
        }
        return '<div class="tvp-acc-params" data-testid="tv-acc-event-params">' +
            keys.slice(0, 16).map(function (key) {
                var val = params[key];
                if (val != null && typeof val === 'object') {
                    try { val = JSON.stringify(val); } catch (e) { val = String(val); }
                }
                return '<span class="tvp-acc-param"><b>' + String(key).replace(/</g, '') + '</b>=' + String(val).replace(/</g, '') + '</span>';
            }).join('') +
            '</div>';
    }

    function collectParamPairs(ev, insights) {
        var pairs = [];
        var seen = {};
        function push(key, value) {
            key = String(key || '').trim();
            if (!key || seen[key]) return;
            seen[key] = 1;
            var val = value;
            if (val != null && typeof val === 'object') {
                try { val = JSON.stringify(val); } catch (e) { val = String(val); }
            }
            pairs.push({ key: key, value: val == null ? '' : String(val) });
        }
        var params = ev && ev.params && typeof ev.params === 'object' ? ev.params : {};
        Object.keys(params).slice(0, 24).forEach(function (k) { push(k, params[k]); });
        (insights && insights.params ? insights.params : []).forEach(function (p) {
            push(p.key, p.value);
        });
        return pairs;
    }

    function escapeAttr(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;');
    }

    function copyableParamsHtml(pairs, idx) {
        if (!pairs || !pairs.length) {
