    }

    var STREAM_SESSION_KEY = 'tvp_session_stream_v1';
    var activeStreamTab = 'stream';
    var sessionStreamEvents = [];
    var sandboxClearEpoch = 0;
    var sandboxGeneration = 0;
    var expandedAccIdx = {};
    var streamSearchQuery = '';
    var sandboxCompanionOpen = false;
    var companionUserClosed = false;

    function streamEventExpandKey(ev, idx) {
        try {
            return eventStreamKey(ev);
        } catch (e) {
            return 'idx:' + String(idx);
        }
    }

    function setExclusiveExpanded(key, open) {
        expandedAccIdx = {};
        if (open && key) {
            expandedAccIdx[key] = true;
        }
    }

    function streamSessionKey() {
        return STREAM_SESSION_KEY + ':' + String(websiteId || 0) + ':' + String(storageScope || '');
    }

    function loadSessionStream() {
        try {
            var raw = sessionStorage.getItem(streamSessionKey());
            var parsed = raw ? JSON.parse(raw) : [];
            sessionStreamEvents = Array.isArray(parsed) ? parsed : [];
        } catch (e) {
            sessionStreamEvents = [];
        }
        return sessionStreamEvents;
    }

    function saveSessionStream() {
        try {
            sessionStorage.setItem(streamSessionKey(), JSON.stringify((sessionStreamEvents || []).slice(0, 200)));
        } catch (e) {}
    }

    function eventStreamKey(ev) {
        if (ev && ev.id) return 'id:' + String(ev.id);
        if (ev && ev.seq) return 'seq:' + String(ev.seq);
        return [ev.weline_event || '', ev.at || '', ev.source || '', ev.path || ''].join('|');
    }

    function mergeSessionStream(incoming) {
        loadSessionStream();
        var map = {};
        (sessionStreamEvents || []).forEach(function (ev) {
            map[eventStreamKey(ev)] = ev;
        });
        (incoming || []).forEach(function (ev) {
            if (!ev || typeof ev !== 'object') return;
            map[eventStreamKey(ev)] = ev;
        });
        sessionStreamEvents = Object.keys(map).map(function (k) { return map[k]; });
        sessionStreamEvents.sort(function (a, b) {
            var sb = Number(b.seq || 0);
            var sa = Number(a.seq || 0);
            if (sb !== sa) return sb - sa;
            return String(b.at || '').localeCompare(String(a.at || ''));
        });
        if (sessionStreamEvents.length > 200) {
            sessionStreamEvents = sessionStreamEvents.slice(0, 200);
        }
        saveSessionStream();
        return sessionStreamEvents;
    }

    function activateStreamTab(tab) {
        tab = (tab === 'system' || tab === 'custom') ? tab : 'stream';
        activeStreamTab = tab;
        document.querySelectorAll('[data-stream-tab]').forEach(function (btn) {
            var on = (btn.getAttribute('data-stream-tab') || '') === tab;
            btn.setAttribute('data-active', on ? '1' : '0');
            btn.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('[data-stream-panel]').forEach(function (panel) {
            var on = (panel.getAttribute('data-stream-panel') || '') === tab;
            if (on) panel.removeAttribute('hidden');
            else panel.setAttribute('hidden', 'hidden');
        });
    }

    function bindStreamTabs() {
        document.querySelectorAll('[data-stream-tab]').forEach(function (btn) {
            if (btn.__tvStreamBound) return;
            btn.__tvStreamBound = true;
            btn.addEventListener('click', function () {
                activateStreamTab(btn.getAttribute('data-stream-tab') || 'stream');
            });
        });
        activateStreamTab(activeStreamTab);
    }

    function aggregateHits(events, kind) {
        var counts = {};
        (events || []).forEach(function (ev) {
            if (ev && ev.event_hit === false) return;
            var hk = String(ev.hit_kind || '').toLowerCase();
            if (hk !== 'system' && hk !== 'custom') return;
            if (hk !== kind) return;
            var name = String(ev.weline_event || '');
            if (!name) return;
            counts[name] = (counts[name] || 0) + 1;
        });
        return Object.keys(counts).sort().map(function (name) {
            return { name: name, count: counts[name] };
        });
    }

    function renderHitList(listEl, hits, tone) {
        if (!listEl) return;
        if (!hits.length) {
            listEl.innerHTML = '<li class="tvp-acc-empty">本会话尚无' + (tone === 'system' ? '系统' : '自定义') + '命中。</li>';
            return;
        }
        listEl.innerHTML = hits.map(function (h) {
            return '<li class="tvp-acc-item" data-hit-kind="' + tone + '" data-testid="tv-acc-hit-row">' +
                '<div class="tvp-acc-item__name">' + String(h.name).replace(/</g, '') +
                ' <span class="tvp-acc-badge" data-tone="' + (tone === 'system' ? 'system' : 'custom') + '">×' + h.count + '</span></div>' +
                '</li>';
        }).join('');
    }

    function bindParamCopyActions(root) {
        if (!root) return;
        root.querySelectorAll('[data-copy-text]').forEach(function (btn) {
            if (btn.__tvCopyBound) return;
            btn.__tvCopyBound = true;
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                copyText(btn.getAttribute('data-copy-text') || '', btn);
            });
        });
        root.querySelectorAll('[data-acc-bar]').forEach(function (bar) {
            if (bar.__tvExpandBound) return;
            bar.__tvExpandBound = true;
            bar.addEventListener('click', function (e) {
                if (e.target && e.target.closest && e.target.closest('[data-acc-star],button,a,input,select,textarea')) {
                    return;
                }
                e.preventDefault();
                var key = String(bar.getAttribute('data-acc-bar') || '');
                var next = !expandedAccIdx[key];
                setExclusiveExpanded(key, next);
                renderSessionStream();
            });
        });
    }

    function bindAccActions(list) {
        if (!list) return;
        list.querySelectorAll('[data-acc-add]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                addMapRow(btn.getAttribute('data-weline'), btn.getAttribute('data-third'));
            });
        });
        list.querySelectorAll('[data-acc-create]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                focusCreateEvent({
                    name: btn.getAttribute('data-weline') || '',
                    third: btn.getAttribute('data-third') || '',
                    paramsHint: decodeURIComponent(btn.getAttribute('data-params') || '')
                });
            });
        });
        list.querySelectorAll('[data-acc-star]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var n = btn.getAttribute('data-weline') || '';
                var next = btn.getAttribute('data-starred') === '1' ? '0' : '1';
                annotateEvent(n, { starred: next }).then(function (data) {
                    if (data && data.ok) refreshAccumulate();
                });
            });
        });
        bindParamCopyActions(list);
    }

    function streamEventItemHtml(ev, idx, opts) {
        opts = opts || {};
        var compact = !!opts.compact;
        var name = String(ev.weline_event || '');
        var third = String(ev.third_party_event || name);
        var kind = String(ev.kind || 'single');
        var steps = Number(ev.chain_steps || 0);
        var rawUrl = String(ev.path || ev.summary || '');
        var insights = parseUrlInsights(rawUrl);
        var hitKind = String(ev.hit_kind || '').toLowerCase();
        if (ev.event_hit === false || (hitKind !== 'system' && hitKind !== 'custom' && hitKind !== 'dedupe')) {
            hitKind = '';
        }
        var pairs = collectParamPairs(ev, insights);
        var expandKey = streamEventExpandKey(ev, idx);
        var open = !!expandedAccIdx[expandKey];
        var metaBits = [ev.source || '', kind === 'chain' ? ('链' + steps + '步') : '', ev.at || ''].filter(Boolean);
        if (insights.host) metaBits.push(insights.host);
        if (insights.channelHints && insights.channelHints.length) {
            metaBits.push('渠道线索 ' + insights.channelHints.slice(0, 2).join(', '));
        }
        var badge = kind === 'chain' ? ' <span class="tvp-acc-badge">链</span>' : '';
        var valued = ev.has_value ? ' <span class="tvp-acc-badge" data-tone="value">有值</span>' : '';
        var kindBadge = hitKind === 'system'
            ? ' <span class="tvp-acc-badge" data-tone="system">系统</span>'
            : (hitKind === 'custom'
                ? ' <span class="tvp-acc-badge" data-tone="custom">自定义</span>'
                : (hitKind === 'dedupe'
                    ? ' <span class="tvp-acc-badge" data-tone="dedupe">去重丢弃</span>'
                    : ' <span class="tvp-acc-badge" data-tone="cat">流过</span>'));
        var paramsBlock = open
            ? copyableParamsHtml(pairs, idx)
            : '';
        var actions = compact
            ? ''
            : ('<div class="w-cluster tvp-acc-item__actions" style="--w-gap:var(--weline-space-1);">' +
                '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="neutral" data-acc-create data-testid="tv-acc-create" data-weline="' + name.replace(/"/g, '') + '" data-third="' + third.replace(/"/g, '') + '" data-params="' + encodeURIComponent((insights.channelHints || []).join('&')) + '">创建事件</button>' +
                '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="neutral" data-acc-add data-testid="tv-acc-add" data-weline="' + name.replace(/"/g, '') + '" data-third="' + third.replace(/"/g, '') + '">加入搭接</button>' +
                '</div>');
        return '<li class="tvp-acc-item" data-acc-idx="' + idx + '" data-acc-key="' + expandKey.replace(/"/g, '') + '" data-hit-kind="' + (hitKind || 'stream') + '" data-expanded="' + (open ? '1' : '0') + '" data-has-params="' + (pairs.length ? '1' : '0') + '" data-testid="' + (compact ? 'tv-companion-row' : 'tv-acc-stream-row') + '">' +
            '<div class="tvp-acc-item__bar" data-acc-bar="' + expandKey.replace(/"/g, '') + '" data-testid="tv-acc-bar" role="button" tabindex="0" aria-expanded="' + (open ? 'true' : 'false') + '" title="点击事件栏展开或折叠">' +
            '<div class="tvp-acc-item__name">' +
            (compact ? '' : ('<button type="button" class="tvp-star-btn" data-acc-star data-weline="' + name.replace(/"/g, '') + '" data-starred="' + (ev.starred ? '1' : '0') + '" title="标星">' + (ev.starred ? '★' : '☆') + '</button> ')) +
            name.replace(/</g, '') + badge + valued + kindBadge +
            (pairs.length ? ' <span class="tvp-acc-badge" data-tone="cat">参数 · ' + pairs.length + '</span>' : '') +
            '</div>' +
            '<div class="tvp-acc-item__meta">' + metaBits.join(' · ').replace(/</g, '') + '</div>' +
            '<div class="tvp-acc-item__path" title="' + rawUrl.replace(/"/g, '&quot;') + '">' + String(insights.path || rawUrl).replace(/</g, '') + '</div>' +
            '</div>' +
            paramsBlock +
            actions +
            '</li>';
    }

    function showSandboxCompanion() {
        var panel = document.getElementById('tv-map-accumulate') || document.querySelector('[data-testid="tv-map-accumulate"]');
        var dlg = document.getElementById('tv-ga4-create-dialog');
