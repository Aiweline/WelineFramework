<script>
(function () {
    var mappable = <?= $mappable_events_json ?: '[]' ?>;
    var customEvents = <?= $custom_events_json ?: '[]' ?>;
    var recentUrl = <?= \json_encode((string)($recent_events_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var startPickerUrl = <?= \json_encode((string)($start_picker_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var customEventsUrl = <?= \json_encode((string)($custom_events_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var deleteCustomEventUrl = <?= \json_encode((string)($delete_custom_event_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var addCustomEventUrl = <?= \json_encode((string)($add_custom_event_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var autosaveUrl = <?= \json_encode((string)($autosave_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var annotateEventUrl = <?= \json_encode((string)($annotate_event_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var categoryOptions = <?= $event_category_options_json ?: '[]' ?>;
    var matchParamOptions = <?= $match_param_options_json ?: '[]' ?>;
    var matchOpOptions = <?= $match_op_options_json ?: '[]' ?>;
    var ensureDemoChainUrl = <?= \json_encode((string)($ensure_demo_chain_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var eventChainsUrl = <?= \json_encode((string)($event_chains_url ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var websiteId = <?= (int)($website_id ?? 0) ?>;
    var storageScope = <?= \json_encode((string)($storage_scope ?? ($scopeQuery['target_scope'] ?? '')), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var scopeQuery = <?= \json_encode($scopeQuery ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var selectedCode = <?= \json_encode((string)$selectedCode, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var csrfToken = <?= \json_encode((string)$csrfToken, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var TAB_STORE_KEY = 'tvp_ui_tab_v1';
    var ALLOWED_TABS = { config: 1, scope: 1, map: 1, js: 1 };
    var activeTab = 'config';
    var autosaveTimer = null;
    var autosaveInFlight = false;
    var autosaveQueued = false;
    var autosaveEnabled = false;

    function tabStorageKey() {
        return TAB_STORE_KEY + ':' + String(selectedCode || '') + ':' + String(storageScope || websiteId || '');
    }

    function readStoredTab() {
        try {
            var raw = sessionStorage.getItem(tabStorageKey());
            if (raw && ALLOWED_TABS[raw]) return raw;
        } catch (e) {}
        return '';
    }

    function writeStoredTab(tab) {
        try {
            sessionStorage.setItem(tabStorageKey(), tab);
        } catch (e) {}
    }

    function resolveInitialTab() {
        try {
            var q = new URLSearchParams(window.location.search || '');
            var fromUrl = String(q.get('tab') || '').toLowerCase();
            if (ALLOWED_TABS[fromUrl]) return fromUrl;
        } catch (e) {}
        return readStoredTab() || 'config';
    }

    function setAutosaveStatus(text, tone) {
        var el = document.getElementById('tv-autosave-status');
        if (!el) return;
        el.textContent = text || '';
        if (tone) el.setAttribute('data-tone', tone);
        else el.removeAttribute('data-tone');
    }

    function flushJsEditors() {
        try {
            if (typeof window.__tvFlushJsEditors === 'function') {
                window.__tvFlushJsEditors();
            }
        } catch (e) {}
        document.querySelectorAll('.CodeMirror').forEach(function (wrap) {
            try {
                if (wrap.CodeMirror) wrap.CodeMirror.save();
            } catch (err) {}
        });
    }

    function activateTab(tab, opts) {
        opts = opts || {};
        tab = ALLOWED_TABS[tab] ? tab : 'config';
        activeTab = tab;
        var tabs = document.getElementById('tv-tabs');
        if (tabs) {
            tabs.querySelectorAll('[data-tab]').forEach(function (b) {
                b.setAttribute('data-active', b.getAttribute('data-tab') === tab ? '1' : '0');
            });
        }
        document.querySelectorAll('[data-panel]').forEach(function (p) {
            p.hidden = p.getAttribute('data-panel') !== tab;
        });
        var uiTab = document.getElementById('tv-ui-tab');
        if (uiTab) uiTab.value = tab;
        writeStoredTab(tab);
        if (!opts.skipUrl) {
            try {
                var u = new URL(window.location.href);
                u.searchParams.set('tab', tab);
                window.history.replaceState({}, '', u.toString());
            } catch (e) {}
        }
        if (tab === 'map') {
            refreshAccumulate();
            refreshCustomEvents();
        }
    }

    var tabs = document.getElementById('tv-tabs');
    if (tabs) {
        tabs.querySelectorAll('[data-tab]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                activateTab(btn.getAttribute('data-tab') || 'config');
            });
        });
    }
    // activateTab(resolveInitialTab) 延后到函数定义之后，避免 refreshAccumulate 未就绪

    function optionHtml(selected) {
        return (mappable || []).map(function (ev) {
            var name = typeof ev === 'string' ? ev : (ev.name || '');
            var label = typeof ev === 'string' ? ev : ((ev.name || '') + (ev.label_zh && ev.label_zh !== ev.name ? (' — ' + ev.label_zh) : ''));
            var sel = name === selected ? ' selected' : '';
            return '<option value="' + String(name).replace(/"/g, '&quot;') + '"' + sel + '>' + String(label).replace(/</g, '') + '</option>';
        }).join('');
    }

    function collectCredentials() {
        var out = {};
        document.querySelectorAll('#tv-cred-fields [data-cred-key]').forEach(function (el) {
            out[el.getAttribute('data-cred-key')] = el.value;
        });
        return out;
    }

    function markMapCustomized() {
        var cb = document.getElementById('tv-use-default-map');
        if (cb && cb.checked) {
            cb.checked = false;
        }
        scheduleAutosave(true);
    }

    function collectMap() {
        var rows = [];
        document.querySelectorAll('#tv-map-table tbody tr').forEach(function (tr) {
            var w = tr.querySelector('[data-map-weline]');
            var t = tr.querySelector('[data-map-third]');
            if (w && t) rows.push({ weline_event: w.value, third_party_event: t.value });
        });
        return rows;
    }

    function collectScope() {
        var includeEl = document.getElementById('tv-scope-include');
        var excludeEl = document.getElementById('tv-scope-exclude');
        var areas = [];
        var fe = document.getElementById('tv-scope-area-frontend');
        var be = document.getElementById('tv-scope-area-backend');
        if (fe && fe.checked) areas.push('frontend');
        if (be && be.checked) areas.push('backend');
        function lines(el) {
            if (!el) return [];
            return String(el.value || '').split(/\r\n|\r|\n/).map(function (s) { return s.trim(); }).filter(Boolean);
        }
        return {
            path_include: lines(includeEl),
            path_exclude: lines(excludeEl),
            areas: areas
        };
    }

    function fillHiddenJsonFields() {
        flushJsEditors();
        var credEl = document.getElementById('tv-credentials-json');
        var mapEl = document.getElementById('tv-event-map-json');
        var scopeEl = document.getElementById('tv-scope-json');
        var uiTab = document.getElementById('tv-ui-tab');
        if (credEl) credEl.value = JSON.stringify(collectCredentials());
        if (mapEl) mapEl.value = JSON.stringify(collectMap());
        if (scopeEl) scopeEl.value = JSON.stringify(collectScope());
        if (uiTab) uiTab.value = activeTab || 'config';
    }

    function scheduleAutosave(immediate) {
        if (!autosaveEnabled || !autosaveUrl || !form) return;
        if (autosaveTimer) {
            clearTimeout(autosaveTimer);
            autosaveTimer = null;
        }
        var delay = immediate ? 120 : 700;
        autosaveTimer = setTimeout(function () {
            autosaveTimer = null;
            runAutosave();
        }, delay);
    }

    function runAutosave() {
        if (!autosaveEnabled || !autosaveUrl || !form) return;
        if (autosaveInFlight) {
            autosaveQueued = true;
            return;
        }
        autosaveInFlight = true;
        setAutosaveStatus('自动保存中…', 'muted');
        fillHiddenJsonFields();
        var body = new URLSearchParams();
        var fd = new FormData(form);
        fd.forEach(function (v, k) {
            if (k === 'enabled' || k === 'use_default_map') {
                // FormData 对未勾选 checkbox 不带字段；勾选时可能重复，下面统一处理
                return;
            }
            body.set(k, String(v));
        });
        var enabledCb = form.querySelector('input[name="enabled"][type="checkbox"]');
        var enabledHidden = form.querySelector('input[name="enabled"][type="hidden"]');
        if (enabledHidden) {
            body.set('enabled', '1');
        } else if (enabledCb) {
            body.set('enabled', enabledCb.checked ? '1' : '0');
        }
        var defMap = document.getElementById('tv-use-default-map');
        body.set('use_default_map', defMap && defMap.checked ? '1' : '0');
        body.set('ui_tab', activeTab || 'config');
        if (csrfToken && !body.get('csrf_token')) body.set('csrf_token', csrfToken);

        fetch(autosaveUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        }).then(function (r) { return r.json().then(function (data) { return { okHttp: r.ok, data: data }; }); })
          .then(function (res) {
            autosaveInFlight = false;
            var data = res.data || {};
            if (res.okHttp && data.ok) {
                var def = document.getElementById('tv-use-default-map');
                if (def && typeof data.use_default_map === 'boolean') {
                    def.checked = !!data.use_default_map;
                }
                setAutosaveStatus('已自动保存' + (data.map_count != null ? (' · 映射 ' + data.map_count + ' 条') : ''), 'success');
            } else {
                setAutosaveStatus('自动保存失败：' + ((data && (data.error || data.message)) || 'unknown'), 'danger');
            }
            if (autosaveQueued) {
                autosaveQueued = false;
                scheduleAutosave(true);
            }
        }).catch(function () {
            autosaveInFlight = false;
            setAutosaveStatus('自动保存失败：网络异常', 'danger');
            if (autosaveQueued) {
                autosaveQueued = false;
                scheduleAutosave(true);
            }
        });
    }

    var form = document.getElementById('tv-save-form');
    if (form) {
        form.addEventListener('submit', function () {
            fillHiddenJsonFields();
        });
        form.addEventListener('change', function (ev) {
            var t = ev.target;
            if (!t || !autosaveEnabled) return;
            if (t.closest && t.closest('#tv-map-table, #tv-cred-fields, [data-panel="config"], [data-panel="scope"], [data-panel="js"]')) {
                scheduleAutosave(false);
            }
        });
        form.addEventListener('input', function (ev) {
            var t = ev.target;
            if (!t || !autosaveEnabled) return;
            if (t.matches && (t.matches('[data-map-third], [data-cred-key], #tv-name, #tv-scope-include, #tv-scope-exclude, textarea[name="sandbox_js"], textarea[name="inject_js"]') || t.closest('[data-panel="scope"]'))) {
                scheduleAutosave(false);
            }
        });
    }

    document.addEventListener('tv:js-dirty', function () {
        scheduleAutosave(false);
    });

    function ensureMappableOption(name) {
        name = String(name || '').trim();
        if (!name) return;
        var exists = (mappable || []).some(function (ev) {
            return (typeof ev === 'string' ? ev : ev.name) === name;
        });
        if (!exists) {
            mappable = (mappable || []).concat([{ name: name, label_zh: name + '（自定义）', event_family: 'custom', ga4_event: name, custom: true }]);
            document.querySelectorAll('[data-map-weline]').forEach(function (sel) {
                var cur = sel.value;
                sel.innerHTML = optionHtml(cur);
            });
        }
    }

    function addMapRow(welineEvent, thirdParty) {
        var tb = document.querySelector('#tv-map-table tbody');
        if (!tb) return;
        markMapCustomized();
        ensureMappableOption(welineEvent);
        var tr = document.createElement('tr');
        tr.innerHTML = '<td><select class="w-input" data-size="sm" data-map-weline>' + optionHtml(welineEvent || '') + '</select></td>' +
            '<td><input class="w-input" data-size="sm" data-map-third value="' + String(thirdParty || welineEvent || '').replace(/"/g, '&quot;') + '"></td>' +
            '<td><button type="button" class="w-button" data-size="sm" data-map-remove>删</button></td>';
        tb.appendChild(tr);
        bindRemove(tr);
        bindMapEdit(tr);
    }

    var addMap = document.getElementById('tv-map-add');
    if (addMap) {
        addMap.addEventListener('click', function () {
            addMapRow((mappable[0] && (mappable[0].name || mappable[0])) || 'cta_click', '');
        });
    }

    function bindMapEdit(scope) {
        (scope || document).querySelectorAll('[data-map-weline], [data-map-third]').forEach(function (el) {
            el.addEventListener('change', markMapCustomized);
            el.addEventListener('input', markMapCustomized);
        });
    }

    function bindRemove(scope) {
        (scope || document).querySelectorAll('[data-map-remove]').forEach(function (btn) {
            btn.onclick = function () {
                markMapCustomized();
                var tr = btn.closest('tr');
                if (tr && tr.parentNode) tr.parentNode.removeChild(tr);
            };
        });
    }
    bindRemove();
    bindMapEdit();

    var eventFilter = 'all';

    function categorySelectHtml(selected) {
        selected = String(selected || 'custom');
        var opts = (categoryOptions || []).map(function (c) {
            var id = String(c.id || '');
            var label = String(c.label || id);
            return '<option value="' + id.replace(/"/g, '') + '"' + (id === selected ? ' selected' : '') + '>' + label.replace(/</g, '') + '</option>';
        }).join('');
        return '<select class="w-input tvp-cat-select" data-size="sm" data-event-category>' + opts + '</select>';
    }

    function eventBadgesHtml(ev) {
        var bits = [];
        if (ev.custom) bits.push('<span class="tvp-acc-badge">自定义</span>');
        if (ev.has_value) bits.push('<span class="tvp-acc-badge" data-tone="value">有值</span>');
        var cat = String(ev.category_label || ev.category || '');
        if (cat) bits.push('<span class="tvp-acc-badge" data-tone="cat">' + cat.replace(/</g, '') + '</span>');
        return bits.join(' ');
    }

    function annotateEvent(name, patch) {
        name = String(name || '').trim();
        if (!name || !annotateEventUrl) return Promise.resolve(null);
        var body = new URLSearchParams();
        body.set('weline_event', name);
        body.set('csrf_token', csrfToken || '');
        Object.keys(patch || {}).forEach(function (k) {
            body.set(k, String(patch[k]));
        });
        var q = scopeQuery || {};
        ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind', 'website_id'].forEach(function (k) {
            if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
        });
        if (storageScope) body.set('target_scope', storageScope);
        return fetch(annotateEventUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        }).then(function (r) { return r.json(); });
    }

    function filteredCustomEvents() {
        return (customEvents || []).filter(function (ev) {
            if (eventFilter === 'starred') return !!ev.starred;
            if (eventFilter === 'valued') return !!ev.has_value;
            return true;
        });
    }

    function renderCustomEvents(events) {
        customEvents = Array.isArray(events) ? events : [];
        var list = document.getElementById('tv-custom-list');
        var countEl = document.getElementById('tv-custom-count');
        var shown = filteredCustomEvents();
        if (countEl) countEl.textContent = String(customEvents.length);
        if (!list) return;
        if (!customEvents.length) {
            list.innerHTML = '<li class="tvp-acc-empty">本范围暂无自定义事件。上方按 GA4 填写自定义事件名与匹配条件后点「创建」。</li>';
            return;
        }
        if (!shown.length) {
            list.innerHTML = '<li class="tvp-acc-empty">当前筛选无事件。</li>';
            return;
        }
        list.innerHTML = shown.map(function (ev) {
            var name = String(ev.name || ev.weline_event || '');
            var label = String(ev.label_zh || name);
            var starred = !!ev.starred;
            var matchSummary = String(ev.match_summary || '');
            var matchType = String(ev.match_type_label || ev.match_type || '');
            var matchBits = '';
            if (matchType) matchBits += '<span class="tvp-acc-badge" data-tone="match">' + matchType.replace(/</g, '') + '</span> ';
            if (matchSummary) {
                matchBits += '<div class="tvp-acc-item__match" title="' + matchSummary.replace(/"/g, '&quot;') + '">' + matchSummary.replace(/</g, '') + '</div>';
            }
            return '<li class="tvp-acc-item" data-testid="tv-custom-row" data-starred="' + (starred ? '1' : '0') + '" data-has-value="' + (ev.has_value ? '1' : '0') + '">' +
                '<div class="tvp-acc-item__name">' +
                '<button type="button" class="tvp-star-btn" data-event-star data-weline="' + name.replace(/"/g, '') + '" data-starred="' + (starred ? '1' : '0') + '" title="标星" aria-label="标星">' + (starred ? '★' : '☆') + '</button> ' +
                name.replace(/</g, '') + ' ' + eventBadgesHtml(ev) +
                '</div>' +
                '<div class="tvp-acc-item__meta">' + label.replace(/</g, '') + '</div>' +
                matchBits +
                '<div class="w-cluster tvp-acc-item__actions" style="--w-gap:var(--weline-space-1);align-items:center;">' +
                categorySelectHtml(ev.category || 'custom') +
                '<button type="button" class="w-button" data-size="sm" data-custom-add data-weline="' + name.replace(/"/g, '') + '" data-third="' + name.replace(/"/g, '') + '">加入搭接</button>' +
                '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="danger" data-custom-del data-testid="tv-custom-del" data-weline="' + name.replace(/"/g, '') + '">删除</button>' +
                '</div>' +
                '</li>';
        }).join('');
        list.querySelectorAll('[data-custom-add]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                addMapRow(btn.getAttribute('data-weline'), btn.getAttribute('data-third'));
            });
        });
        list.querySelectorAll('[data-custom-del]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                deleteCustomEvent(btn.getAttribute('data-weline') || '', btn);
            });
        });
        list.querySelectorAll('[data-event-star]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var n = btn.getAttribute('data-weline') || '';
                var next = btn.getAttribute('data-starred') === '1' ? '0' : '1';
                annotateEvent(n, { starred: next }).then(function (data) {
                    if (data && data.ok) {
                        customEvents = (customEvents || []).map(function (ev) {
                            if (String(ev.name || ev.weline_event) === n) {
                                ev.starred = next === '1';
                            }
                            return ev;
                        });
                        // 星标置顶
                        customEvents.sort(function (a, b) {
                            return (!!b.starred) - (!!a.starred) || String(a.name || '').localeCompare(String(b.name || ''));
                        });
                        renderCustomEvents(customEvents);
                    }
                });
            });
        });
        list.querySelectorAll('[data-event-category]').forEach(function (sel) {
            sel.addEventListener('change', function () {
                var li = sel.closest('[data-testid="tv-custom-row"]');
                var starBtn = li && li.querySelector('[data-event-star]');
                var n = starBtn ? (starBtn.getAttribute('data-weline') || '') : '';
                if (!n) return;
                annotateEvent(n, { category: sel.value }).then(function (data) {
                    if (data && data.ok && data.annotation) {
                        customEvents = (customEvents || []).map(function (ev) {
                            if (String(ev.name || ev.weline_event) === n) {
                                ev.category = data.annotation.category;
                                ev.category_label = data.category_label || data.annotation.category;
                            }
                            return ev;
                        });
                        renderCustomEvents(customEvents);
                    }
                });
            });
        });
    }

    document.querySelectorAll('[data-event-filter]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            eventFilter = btn.getAttribute('data-event-filter') || 'all';
            document.querySelectorAll('[data-event-filter]').forEach(function (b) {
                b.setAttribute('data-active', b === btn ? '1' : '0');
            });
            renderCustomEvents(customEvents);
        });
    });

    function themeConfirm(message, options) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.confirm === 'function') {
            return Promise.resolve(window.Weline.UI.dialog.confirm(String(message || ''), options || {}));
        }
        return Promise.resolve(false);
    }

    function themeToastError(message) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast.error === 'function') {
            window.Weline.UI.toast.error(String(message || ''));
            return;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast.show === 'function') {
            window.Weline.UI.toast.show(String(message || ''), { tone: 'danger' });
        }
    }

    function themeToastSuccess(message) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast.success === 'function') {
            window.Weline.UI.toast.success(String(message || ''));
            return;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast.show === 'function') {
            window.Weline.UI.toast.show(String(message || ''), { tone: 'success' });
        }
    }

    function deleteCustomEvent(name, btn) {
        name = String(name || '').trim();
        if (!name || !deleteCustomEventUrl) return;
        // 禁止原生 confirm/alert：走主题 Weline.UI.dialog.confirm
        themeConfirm('从本范围删除自定义事件「' + name + '」？搭接表里已有行不会自动删。', {
            tone: 'danger',
            dangerous: true
        }).then(function (ok) {
            if (!ok) return;
            if (btn) {
                btn.disabled = true;
                btn.textContent = '删除中…';
            }
            var body = new URLSearchParams();
            body.set('weline_event', name);
            body.set('csrf_token', csrfToken || '');
            var q = scopeQuery || {};
            ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind', 'website_id'].forEach(function (k) {
                if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
            });
            if (storageScope) body.set('target_scope', storageScope);
            return fetch(deleteCustomEventUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (data && data.ok && Array.isArray(data.events)) {
                    renderCustomEvents(data.events);
                    return;
                }
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = '删除失败';
                }
                themeToastError((data && (data.error || data.message)) || '删除失败');
            }).catch(function () {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = '删除';
                }
                themeToastError('删除失败：网络异常');
            });
        });
    }

    function appendScopeParams(url) {
        var u = url + (url.indexOf('?') >= 0 ? '&' : '?');
        var q = scopeQuery || {};
        ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind', 'website_id'].forEach(function (k) {
            if (q[k] != null && String(q[k]) !== '') {
                u += encodeURIComponent(k) + '=' + encodeURIComponent(String(q[k])) + '&';
            }
        });
        if (storageScope) u += 'target_scope=' + encodeURIComponent(storageScope) + '&';
        return u;
    }

    function refreshCustomEvents() {
        if (!customEventsUrl) {
            renderCustomEvents(customEvents);
            return;
        }
        var url = appendScopeParams(customEventsUrl);
        fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.ok && Array.isArray(data.events)) {
                    renderCustomEvents(data.events);
                } else {
                    renderCustomEvents(customEvents);
                }
            })
            .catch(function () {
                renderCustomEvents(customEvents);
            });
    }

    var customRefresh = document.getElementById('tv-custom-refresh');
    if (customRefresh) customRefresh.addEventListener('click', refreshCustomEvents);
    renderCustomEvents(customEvents);

    function parseUrlInsights(raw) {
        var text = String(raw || '').trim();
        if (!text) {
            return { path: '', params: [], channelHints: [] };
        }
        try {
            var u = new URL(text, window.location.origin);
            var params = [];
            var channelHints = [];
            u.searchParams.forEach(function (value, key) {
                params.push({ key: key, value: value });
                var lk = String(key).toLowerCase();
                if (lk.indexOf('utm_') === 0 || lk === 'channel' || lk === 'channel_code'
                    || lk === 'store' || lk === 'store_code' || lk === 'gclid' || lk === 'fbclid'
                    || lk === 'from' || lk === 'source' || lk === 'medium' || lk === 'campaign') {
                    channelHints.push(key + '=' + value);
                }
            });
            return {
                path: (u.pathname || '/') + (u.search || ''),
                host: u.host || '',
                params: params.slice(0, 12),
                channelHints: channelHints.slice(0, 6)
            };
        } catch (e) {
            return { path: text.slice(0, 160), params: [], channelHints: [] };
        }
    }

    function urlParamsHtml(insights) {
        if (!insights || !insights.params || !insights.params.length) {
            return '<div class="tvp-acc-params" data-empty="1">无查询参数</div>';
        }
        return '<div class="tvp-acc-params" data-testid="tv-acc-params">' +
            insights.params.map(function (p) {
                var tone = '';
                var lk = String(p.key || '').toLowerCase();
                if (lk.indexOf('utm_') === 0 || lk === 'channel' || lk === 'channel_code' || lk === 'gclid' || lk === 'fbclid') {
                    tone = ' data-tone="channel"';
                }
                return '<span class="tvp-acc-param"' + tone + '><b>' + String(p.key).replace(/</g, '') + '</b>=' + String(p.value).replace(/</g, '') + '</span>';
            }).join('') +
            '</div>';
    }

    function refreshAccumulate() {
        var list = document.getElementById('tv-acc-list');
        if (!list || !recentUrl) return;
        var url = recentUrl + (recentUrl.indexOf('?') >= 0 ? '&' : '?') + 'limit=40';
        fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var events = (data && data.events) || [];
                if (!events.length) {
                    list.innerHTML = '<li class="tvp-acc-empty">沙盒暂无事件。启动拾取后在前台操作，或等待像素入库。</li>';
                    return;
                }
                list.innerHTML = events.map(function (ev, idx) {
                    var name = String(ev.weline_event || '');
                    var third = String(ev.third_party_event || name);
                    var kind = String(ev.kind || 'single');
                    var steps = Number(ev.chain_steps || 0);
                    var rawUrl = String(ev.path || ev.summary || '');
                    var insights = parseUrlInsights(rawUrl);
                    var metaBits = [ev.source || '', kind === 'chain' ? ('链' + steps + '步') : '', ev.at || ''].filter(Boolean);
                    if (insights.host) metaBits.push(insights.host);
                    if (insights.channelHints && insights.channelHints.length) {
                        metaBits.push('渠道线索 ' + insights.channelHints.slice(0, 2).join(', '));
                    }
                    var badge = kind === 'chain' ? ' <span class="tvp-acc-badge">链</span>' : '';
                    var valued = ev.has_value ? ' <span class="tvp-acc-badge" data-tone="value">有值</span>' : '';
                    var cat = ev.category_label ? (' <span class="tvp-acc-badge" data-tone="cat">' + String(ev.category_label).replace(/</g, '') + '</span>') : '';
                    var custom = ev.custom ? ' <span class="tvp-acc-badge">自定义</span>' : '';
                    return '<li class="tvp-acc-item" data-acc-idx="' + idx + '" data-has-params="' + (insights.params.length ? '1' : '0') + '">' +
                        '<div class="tvp-acc-item__name">' +
                        '<button type="button" class="tvp-star-btn" data-acc-star data-weline="' + name.replace(/"/g, '') + '" data-starred="' + (ev.starred ? '1' : '0') + '" title="标星">' + (ev.starred ? '★' : '☆') + '</button> ' +
                        name.replace(/</g, '') + badge + valued + cat + custom + '</div>' +
                        '<div class="tvp-acc-item__meta">' + metaBits.join(' · ').replace(/</g, '') + '</div>' +
                        '<div class="tvp-acc-item__path" title="' + rawUrl.replace(/"/g, '&quot;') + '">' + String(insights.path || rawUrl).replace(/</g, '') + '</div>' +
                        urlParamsHtml(insights) +
                        '<div class="w-cluster tvp-acc-item__actions" style="--w-gap:var(--weline-space-1);">' +
                        '<button type="button" class="w-button" data-size="sm" data-tone="primary" data-acc-create data-weline="' + name.replace(/"/g, '') + '" data-third="' + third.replace(/"/g, '') + '" data-params="' + encodeURIComponent((insights.channelHints || []).join('&')) + '">创建事件</button>' +
                        '<button type="button" class="w-button" data-size="sm" data-acc-add data-weline="' + name.replace(/"/g, '') + '" data-third="' + third.replace(/"/g, '') + '">加入搭接</button>' +
                        '</div>' +
                        '</li>';
                }).join('');
                list.querySelectorAll('[data-acc-add]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        addMapRow(btn.getAttribute('data-weline'), btn.getAttribute('data-third'));
                    });
                });
                list.querySelectorAll('[data-acc-create]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        focusCreateEvent({
                            name: btn.getAttribute('data-weline') || '',
                            third: btn.getAttribute('data-third') || '',
                            paramsHint: decodeURIComponent(btn.getAttribute('data-params') || '')
                        });
                    });
                });
                list.querySelectorAll('[data-acc-star]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var n = btn.getAttribute('data-weline') || '';
                        var next = btn.getAttribute('data-starred') === '1' ? '0' : '1';
                        annotateEvent(n, { starred: next }).then(function (data) {
                            if (data && data.ok) refreshAccumulate();
                        });
                    });
                });
            })
            .catch(function () {
                list.innerHTML = '<li class="tvp-acc-empty">加载失败</li>';
            });
    }

    function setCreateHint(text, tone) {
        var el = document.getElementById('tv-create-event-hint');
        if (!el) return;
        if (!text) {
            el.hidden = true;
            el.textContent = '';
            return;
        }
        el.hidden = false;
        el.textContent = String(text);
        el.setAttribute('data-tone', tone || 'muted');
    }

    var currentMatchType = 'event_name';

    function matchParamSelectHtml(selected) {
        selected = String(selected || 'event_name');
        return '<select class="w-input" data-size="sm" data-cond-param>' +
            (matchParamOptions || []).map(function (o) {
                var id = String(o.id || '');
                return '<option value="' + id.replace(/"/g, '') + '"' + (id === selected ? ' selected' : '') + '>' + String(o.label || id).replace(/</g, '') + '</option>';
            }).join('') +
            '</select>';
    }

    function matchOpSelectHtml(selected) {
        selected = String(selected || 'equals');
        return '<select class="w-input" data-size="sm" data-cond-op>' +
            (matchOpOptions || []).map(function (o) {
                var id = String(o.id || '');
                return '<option value="' + id.replace(/"/g, '') + '"' + (id === selected ? ' selected' : '') + '>' + String(o.label || id).replace(/</g, '') + '</option>';
            }).join('') +
            '</select>';
    }

    function addConditionRow(param, op, value) {
        var body = document.getElementById('tv-ga4-cond-body');
        if (!body) return;
        var tr = document.createElement('tr');
        tr.innerHTML = '<td>' + matchParamSelectHtml(param || 'event_name') + '</td>' +
            '<td>' + matchOpSelectHtml(op || 'equals') + '</td>' +
            '<td><input class="w-input" data-size="sm" data-cond-value value="' + String(value || '').replace(/"/g, '&quot;') + '" placeholder="值"></td>' +
            '<td><button type="button" class="w-button" data-size="sm" data-cond-remove>删</button></td>';
        body.appendChild(tr);
        var rm = tr.querySelector('[data-cond-remove]');
        if (rm) {
            rm.addEventListener('click', function () {
                if (body.querySelectorAll('tr').length <= 1) {
                    themeToastError('至少保留一条匹配条件');
                    return;
                }
                tr.remove();
            });
        }
    }

    function collectConditions() {
        var rows = [];
        document.querySelectorAll('#tv-ga4-cond-body tr').forEach(function (tr) {
            var param = (tr.querySelector('[data-cond-param]') || {}).value || '';
            var op = (tr.querySelector('[data-cond-op]') || {}).value || 'equals';
            var value = String((tr.querySelector('[data-cond-value]') || {}).value || '').trim();
            if (!param || !value) return;
            rows.push({ param: param, op: op, value: value });
        });
        return rows;
    }

    function seedConditionsForType(type, keepValues) {
        var body = document.getElementById('tv-ga4-cond-body');
        if (!body) return;
        var existing = keepValues ? collectConditions() : [];
        var byParam = {};
        existing.forEach(function (c) { byParam[c.param] = c.value; });
        body.innerHTML = '';
        currentMatchType = type || 'event_name';
        var hint = document.getElementById('tv-match-type-hint');
        document.querySelectorAll('[data-match-type]').forEach(function (btn) {
            btn.setAttribute('data-active', btn.getAttribute('data-match-type') === currentMatchType ? '1' : '0');
        });
        if (currentMatchType === 'url') {
            if (hint) hint.textContent = 'URL 匹配（GA4 常见）：event_name 等于 page_view，且 page_location / page_path 包含目标路径。';
            addConditionRow('event_name', 'equals', byParam.event_name || 'page_view');
            addConditionRow('page_location', 'contains', byParam.page_location || byParam.page_path || '');
        } else if (currentMatchType === 'custom') {
            if (hint) hint.textContent = '自定义条件：自行添加参数 / 运算符 / 值（多条件为 AND）。';
            if (existing.length) {
                existing.forEach(function (c) { addConditionRow(c.param, c.op, c.value); });
            } else {
                addConditionRow('event_name', 'equals', '');
            }
        } else {
            if (hint) hint.textContent = '事件名匹配：当源事件名等于某值时生成新事件（GA4：event_name equals …）。';
            addConditionRow('event_name', 'equals', byParam.event_name || '');
        }
    }

    function focusCreateEvent(opts) {
        opts = opts || {};
        var nameEl = document.getElementById('tv-ga4-name');
        var thirdEl = document.getElementById('tv-ga4-third');
        var intake = document.querySelector('[data-testid="tv-map-intake"]');
        if (nameEl && opts.name) nameEl.value = String(opts.name);
        if (thirdEl && opts.third) thirdEl.value = String(opts.third);
        if (opts.matchType) {
            seedConditionsForType(opts.matchType, false);
        }
        if (opts.paramsHint) {
            seedConditionsForType('url', false);
            var loc = document.querySelector('#tv-ga4-cond-body [data-cond-param]');
            // fill page_location value from first channel hint if present
            var pathVal = String(opts.paramsHint || '').split('&')[0] || '';
            if (pathVal.indexOf('=') >= 0) pathVal = pathVal.split('=').slice(1).join('=');
            document.querySelectorAll('#tv-ga4-cond-body tr').forEach(function (tr) {
                var p = (tr.querySelector('[data-cond-param]') || {}).value;
                var v = tr.querySelector('[data-cond-value]');
                if (p === 'page_location' && v && !v.value) v.value = pathVal || '/';
            });
            setCreateHint('已按沙盒链接切到 URL 匹配，请核对条件后点「创建」。', 'info');
        } else if (opts.name && !opts.matchType) {
            seedConditionsForType('event_name', false);
            var firstVal = document.querySelector('#tv-ga4-cond-body [data-cond-value]');
            if (firstVal && !firstVal.value) firstVal.value = String(opts.name);
            setCreateHint('已带入事件名条件，可改成 URL 匹配或继续编辑条件。', 'muted');
        } else {
            setCreateHint('填写自定义事件名与匹配条件后点「创建」。', 'muted');
        }
        if (intake && intake.scrollIntoView) intake.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        if (nameEl) {
            nameEl.focus();
            if (!opts.name) nameEl.select();
        }
    }

    function submitGa4Event() {
        var nameEl = document.getElementById('tv-ga4-name');
        var thirdEl = document.getElementById('tv-ga4-third');
        var btn = document.getElementById('tv-ga4-add');
        var copyEl = document.getElementById('tv-ga4-copy-params');
        var name = nameEl ? String(nameEl.value || '').trim() : '';
        var third = thirdEl ? String(thirdEl.value || '').trim() : '';
        var conditions = collectConditions();
        if (!name) {
            themeToastError('请填写自定义事件名称');
            setCreateHint('请填写自定义事件名称（如 confirm_signup）。', 'danger');
            if (nameEl) nameEl.focus();
            return;
        }
        if (!conditions.length) {
            themeToastError('请至少填写一条完整匹配条件（含值）');
            setCreateHint('匹配条件的「值」不能为空。', 'danger');
            return;
        }
        if (!addCustomEventUrl) {
            addMapRow(name, third || name);
            themeToastSuccess('已加入搭接表（未配置创建接口）');
            return;
        }
        if (btn) {
            btn.disabled = true;
            btn.textContent = '创建中…';
        }
        var body = new URLSearchParams();
        body.set('weline_event', name);
        if (third) body.set('third_party_event', third);
        body.set('match_type', currentMatchType || 'custom');
        body.set('conditions_json', JSON.stringify(conditions));
        body.set('copy_params', copyEl && copyEl.checked ? '1' : '0');
        body.set('csrf_token', csrfToken || '');
        var q = scopeQuery || {};
        ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind', 'website_id'].forEach(function (k) {
            if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
        });
        if (storageScope) body.set('target_scope', storageScope);
        fetch(addCustomEventUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (btn) {
                btn.disabled = false;
                btn.textContent = '创建';
            }
            if (!data || !data.ok) {
                themeToastError((data && (data.error || data.message)) || '创建失败');
                setCreateHint((data && (data.message || data.error)) || '创建失败', 'danger');
                return;
            }
            if (Array.isArray(data.events)) {
                renderCustomEvents(data.events);
            } else {
                refreshCustomEvents();
            }
            addMapRow(data.weline_event || name, data.third_party_event || third || name);
            if (data.is_custom) {
                themeToastSuccess('已创建到本范围');
                setCreateHint('已创建「' + (data.weline_event || name) + '」' + (data.match_summary ? (' · ' + data.match_summary) : ''), 'success');
                if (nameEl) nameEl.value = '';
                if (thirdEl) thirdEl.value = '';
                seedConditionsForType(currentMatchType, false);
            } else {
                themeToastSuccess(data.message || '系统事件已加入搭接');
                setCreateHint(data.message || ('「' + (data.weline_event || name) + '」是系统字典事件，不会进入自定义池。'), 'warning');
            }
        }).catch(function () {
            if (btn) {
                btn.disabled = false;
                btn.textContent = '创建';
            }
            themeToastError('创建失败：网络异常');
            setCreateHint('创建失败：网络异常', 'danger');
        });
    }

    var ga4Add = document.getElementById('tv-ga4-add');
    if (ga4Add) ga4Add.addEventListener('click', submitGa4Event);
    var condAdd = document.getElementById('tv-ga4-cond-add');
    if (condAdd) {
        condAdd.addEventListener('click', function () {
            addConditionRow(currentMatchType === 'url' ? 'page_path' : 'event_name', currentMatchType === 'url' ? 'contains' : 'equals', '');
        });
    }
    document.querySelectorAll('[data-match-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            seedConditionsForType(btn.getAttribute('data-match-type') || 'event_name', true);
        });
    });
    seedConditionsForType('event_name', false);
    ['tv-custom-create'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', function () {
                focusCreateEvent({});
            });
        }
    });
    var ga4Name = document.getElementById('tv-ga4-name');
    if (ga4Name) {
        ga4Name.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitGa4Event();
            }
        });
    }
    var ga4Third = document.getElementById('tv-ga4-third');
    if (ga4Third) {
        ga4Third.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitGa4Event();
            }
        });
    }

    var accRefresh = document.getElementById('tv-acc-refresh');
    if (accRefresh) accRefresh.addEventListener('click', refreshAccumulate);
    setInterval(function () {
        var mapPanel = document.querySelector('[data-panel="map"]');
        if (mapPanel && !mapPanel.hidden) {
            refreshAccumulate();
            refreshCustomEvents();
        }
    }, 8000);

    var startPicker = document.getElementById('tv-start-picker');
    if (startPicker && startPickerUrl) {
        startPicker.addEventListener('click', function () {
            var body = new URLSearchParams();
            body.set('website_id', String(websiteId));
            body.set('vendor', selectedCode || '');
            body.set('csrf_token', csrfToken || '');
            var q = scopeQuery || {};
            ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind'].forEach(function (k) {
                if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
            });
            if (storageScope) body.set('target_scope', storageScope);
            fetch(startPickerUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (!data || !data.ok || !data.url) {
                    themeToastError((data && data.error) || '无法启动拾取');
                    return;
                }
                window.open(data.url, '_blank', 'noopener');
            }).catch(function () {
                themeToastError('启动拾取失败');
            });
        });
    }

    function refreshChainStatus() {
        var el = document.getElementById('tv-chain-status');
        if (!el || !eventChainsUrl) return;
        fetch(eventChainsUrl, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.ok) return;
                var n = (data.chains && data.chains.length) || 0;
                el.textContent = '事件链 version=' + (data.version || 0) + '，共 ' + n + ' 条（按序跨页凑齐后上报闭环总事件）';
            }).catch(function () {});
    }
    refreshChainStatus();

    var ensureDemo = document.getElementById('tv-ensure-demo-chain');
    if (ensureDemo && ensureDemoChainUrl) {
        ensureDemo.addEventListener('click', function () {
            var body = new URLSearchParams();
            body.set('website_id', String(websiteId));
            body.set('csrf_token', csrfToken || '');
            fetch(ensureDemoChainUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (!data || !data.ok) {
                    themeToastError((data && data.error) || '发布失败');
                    return;
                }
                refreshChainStatus();
                themeToastSuccess('已发布演示链 demo_cross_page → demo_funnel_complete（version ' + data.version + '）');
            }).catch(function () {
                themeToastError('发布演示链失败');
            });
        });
    }

    var credAdd = document.getElementById('tv-cred-add');
    if (credAdd) {
        credAdd.addEventListener('click', function () {
            var k = (document.getElementById('tv-cred-key') || {}).value || '';
            var v = (document.getElementById('tv-cred-val') || {}).value || '';
            if (!k) return;
            var wrap = document.getElementById('tv-cred-fields');
            var div = document.createElement('div');
            div.className = 'tvp-field';
            div.innerHTML = '<label>' + k.replace(/[<>]/g,'') + '</label><input class="w-input" data-size="sm" data-cred-key="' + k.replace(/"/g,'') + '" value="' + String(v).replace(/"/g,'&quot;') + '">';
            wrap.insertBefore(div, credAdd.closest('.tvp-field'));
            scheduleAutosave(true);
        });
    }

    var dlg = document.getElementById('tv-create-dialog');
    var openBtn = document.getElementById('tv-open-create');
    var cancelBtn = document.getElementById('tv-create-cancel');
    if (openBtn && dlg) openBtn.addEventListener('click', function () { dlg.showModal(); });
    if (cancelBtn && dlg) cancelBtn.addEventListener('click', function () { dlg.close(); });

    activateTab(resolveInitialTab(), { skipUrl: false });
    autosaveEnabled = true;
    setAutosaveStatus('改动将自动保存', 'muted');
})();
</script>
<script src="<?= $h($cmJs) ?>"></script>
