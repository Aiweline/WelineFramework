                return '<div class="tvp-acc-copy-row" data-testid="tv-acc-copy-row">' +
                    '<code class="tvp-acc-copy-row__pair" title="' + escapeAttr(p.key + '=' + p.value) + '"><b>' + String(p.key).replace(/</g, '') + '</b>=' + String(p.value).replace(/</g, '') + '</code>' +
                    '<span class="w-cluster tvp-acc-copy-row__actions" style="--w-gap:var(--weline-space-1);">' +
                    '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="neutral" data-copy-kind="key" data-copy-text="' + escapeAttr(p.key) + '" data-testid="tv-acc-copy-key">名</button>' +
                    '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="neutral" data-copy-kind="value" data-copy-text="' + escapeAttr(p.value) + '" data-testid="tv-acc-copy-value">值</button>' +
                    '<button type="button" class="w-button" data-size="sm" data-variant="outline" data-tone="neutral" data-copy-kind="pair" data-copy-text="' + escapeAttr(p.key + '=' + p.value) + '" data-testid="tv-acc-copy-pair">键值</button>' +
                    '</span></div>';
            }).join('') +
            '</div>';
    }

    function copyText(text, btn) {
        var value = String(text == null ? '' : text);
        function done(ok) {
            if (!btn) return;
            var prev = btn.getAttribute('data-label-prev') || btn.textContent;
            if (!btn.getAttribute('data-label-prev')) btn.setAttribute('data-label-prev', prev);
            btn.textContent = ok ? '已复制' : '失败';
            window.setTimeout(function () {
                btn.textContent = btn.getAttribute('data-label-prev') || prev;
            }, 900);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(function () { done(true); }).catch(function () {
                try {
                    var ta = document.createElement('textarea');
                    ta.value = value;
                    ta.setAttribute('readonly', 'readonly');
                    ta.style.position = 'fixed';
                    ta.style.insetInlineStart = '-9999px';
                    document.body.appendChild(ta);
                    ta.select();
                    done(document.execCommand('copy'));
                    document.body.removeChild(ta);
                } catch (e) {
                    done(false);
                }
            });
            return;
        }
        try {
            var ta2 = document.createElement('textarea');
            ta2.value = value;
            document.body.appendChild(ta2);
            ta2.select();
            done(document.execCommand('copy'));
            document.body.removeChild(ta2);
        } catch (e2) {
            done(false);
        }
    }

    function urlParamsHtml(insights) {
