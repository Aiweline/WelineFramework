    function renderSessionStream() {
        var list = document.getElementById('tv-acc-list');
        var systemList = document.getElementById('tv-acc-hit-system');
        var customList = document.getElementById('tv-acc-hit-custom');
        var searchEl = document.getElementById('tv-acc-search');
        if (searchEl && !searchEl.__tvSearchBound) {
            searchEl.__tvSearchBound = true;
            searchEl.addEventListener('input', function () {
                streamSearchQuery = String(searchEl.value || '').trim().toLowerCase();
                renderSessionStream();
            });
        }
        streamSearchQuery = searchEl ? String(searchEl.value || '').trim().toLowerCase() : streamSearchQuery;
        var events = sessionStreamEvents || [];
        var systemHits = aggregateHits(events, 'system');
        var customHits = aggregateHits(events, 'custom');
        var sysCount = systemHits.reduce(function (s, h) { return s + h.count; }, 0);
        var custCount = customHits.reduce(function (s, h) { return s + h.count; }, 0);
        var sysEl = document.getElementById('tv-stream-system-count');
        var custEl = document.getElementById('tv-stream-custom-count');
        var allEl = document.getElementById('tv-stream-all-count');
        if (sysEl) sysEl.textContent = String(sysCount);
        if (custEl) custEl.textContent = String(custCount);
        if (allEl) allEl.textContent = String(events.length);
        renderHitList(systemList, systemHits, 'system');
        renderHitList(customList, customHits, 'custom');
        if (!list) return;
        if (!events.length) {
            list.innerHTML = '<li class="tvp-acc-empty">沙盒暂无事件。前台点击/emit 会打洞即时出现；可点「清理」后重新监听。</li>';
            return;
        }
        var shown = events.map(function (ev, idx) { return { ev: ev, idx: idx }; }).filter(function (row) {
            if (!streamSearchQuery) return true;
            var n = String(row.ev.weline_event || '').toLowerCase();
            var t = String(row.ev.third_party_event || '').toLowerCase();
            return n.indexOf(streamSearchQuery) >= 0 || t.indexOf(streamSearchQuery) >= 0;
        });
        if (!shown.length) {
            list.innerHTML = '<li class="tvp-acc-empty">当前搜索无匹配事件。</li>';
            return;
        }
        list.innerHTML = shown.map(function (row) {
            return streamEventItemHtml(row.ev, row.idx, { compact: false });
        }).join('');
        bindAccActions(list);
    }

    var streamCursor = 0;
    var liveTunnelAbort = null;
    var liveTunnelActive = false;

    function bumpStreamCursor(events, fallback) {
        var max = Number(fallback || streamCursor || 0);
        (events || []).forEach(function (ev) {
            var seq = Number(ev && ev.seq || 0);
            if (seq > max) max = seq;
        });
        streamCursor = max;
        return streamCursor;
    }

    function refreshAccumulate() {
        var list = document.getElementById('tv-acc-list');
        if (!list || !recentUrl) return;
        bindStreamTabs();
        var url = recentUrl + (recentUrl.indexOf('?') >= 0 ? '&' : '?') + 'limit=80&sandbox_only=1';
        fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var events = (data && data.events) || [];
                if (data && data.cursor != null) {
                    streamCursor = Math.max(streamCursor, Number(data.cursor) || 0);
                }
                bumpStreamCursor(events, streamCursor);
                mergeSessionStream(events);
                renderSessionStream();
            })
            .catch(function () {
                loadSessionStream();
                if (sessionStreamEvents.length) {
                    renderSessionStream();
                    return;
                }
                list.innerHTML = '<li class="tvp-acc-empty">加载失败</li>';
            });
    }

    function clearSessionSandbox() {
        stopLiveTunnel();
        var clearGen = ++sandboxClearEpoch;
        sessionStreamEvents = [];
        streamCursor = 0;
        try { sessionStorage.removeItem(streamSessionKey()); } catch (e) {}
        saveSessionStream();
        renderSessionStream();
        var restart = function () {
            if (clearGen !== sandboxClearEpoch) return;
            startLiveTunnel();
        };
        if (!clearSessionSandboxUrl) {
            restart();
            return;
        }
        var body = new URLSearchParams();
        body.set('website_id', String(websiteId));
        body.set('csrf_token', csrfToken || '');
        fetch(clearSessionSandboxUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
            },
            body: body.toString()
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (clearGen !== sandboxClearEpoch) return;
            // 服务端确认清空后再次本地归零，避免短轮询把旧缓冲 merge 回来
            sessionStreamEvents = [];
            streamCursor = Number((data && data.cursor) || 0) || 0;
            if (data && data.generation != null) {
                sandboxGeneration = Math.max(sandboxGeneration, Number(data.generation) || 0);
            }
            try { sessionStorage.removeItem(streamSessionKey()); } catch (e2) {}
            saveSessionStream();
            renderSessionStream();
            if (!data || data.ok === false) {
                try {
                    if (window.Weline && Weline.UI && Weline.UI.toast) {
                        Weline.UI.toast({ type: 'error', message: '沙盒清理失败，请重试' });
                    }
                } catch (e3) {}
            }
            restart();
        }).catch(function () {
            if (clearGen !== sandboxClearEpoch) return;
            try {
                if (window.Weline && Weline.UI && Weline.UI.toast) {
                    Weline.UI.toast({ type: 'error', message: '沙盒清理请求失败' });
                }
            } catch (e4) {}
            restart();
        });
    }

    function stopLiveTunnel() {
        liveTunnelActive = false;
        if (liveTunnelAbort && typeof liveTunnelAbort.abort === 'function') {
            try { liveTunnelAbort.abort(); } catch (e) {}
        }
        liveTunnelAbort = null;
    }

    // 店面已继电入缓冲：后台短间隔即时拉即可，禁止 wait_ms 服务端长轮询。
    var LIVE_POLL_MS = 1000;
    function startLiveTunnel() {
        if (!liveEventsUrl || liveTunnelActive) return;
        liveTunnelActive = true;
        var tunnelGen = sandboxClearEpoch;
        var tick = function () {
            if (!liveTunnelActive || tunnelGen !== sandboxClearEpoch) return;
            var mapPanel = document.querySelector('[data-panel="map"]');
            if (!mapPanel || mapPanel.hidden) {
                setTimeout(tick, LIVE_POLL_MS);
                return;
            }
            var ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
            liveTunnelAbort = ctrl;
            var url = liveEventsUrl
                + (liveEventsUrl.indexOf('?') >= 0 ? '&' : '?')
                + 'since=' + encodeURIComponent(String(streamCursor || 0))
                + '&generation=' + encodeURIComponent(String(sandboxGeneration || 0))
                + '&limit=80';
            fetch(url, {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' },
                signal: ctrl ? ctrl.signal : undefined
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (!liveTunnelActive || tunnelGen !== sandboxClearEpoch) return;
                var nextGen = Number((data && data.generation) || 0) || 0;
                if (sandboxGeneration > 0 && nextGen > sandboxGeneration) {
                    sessionStreamEvents = [];
                    streamCursor = 0;
                    try { sessionStorage.removeItem(streamSessionKey()); } catch (eGen) {}
                }
                if (nextGen > 0) {
                    sandboxGeneration = Math.max(sandboxGeneration, nextGen);
                }
                var events = (data && data.events) || [];
                if (data && data.cursor != null) {
                    streamCursor = Math.max(streamCursor, Number(data.cursor) || 0);
                }
                if (events.length) {
                    bumpStreamCursor(events, streamCursor);
                    mergeSessionStream(events);
                    renderSessionStream();
                } else if (data && data.changed) {
                    renderSessionStream();
                }
            }).catch(function () {
                /* aborted or network — short poll will retry */
            }).then(function () {
                if (!liveTunnelActive || tunnelGen !== sandboxClearEpoch) return;
                setTimeout(tick, LIVE_POLL_MS);
            });
        };
        tick();
    }

    function setCreateHint(text, tone) {
        var el = document.getElementById('tv-create-event-hint');
        if (!el) return;
        if (!text) {
            el.hidden = true;
            el.textContent = '';
            return;
        }
        el.hidden = false;
        el.textContent = String(text);
        el.setAttribute('data-tone', tone || 'muted');
    }

    var currentMatchType = 'event_name';

    var SOURCE_PARAM_PICKS = ['event_name', 'className', 'text', 'href', 'id', 'tag', 'page_path', 'page_location', 'page_referrer', 'value'];

    function normalizeMappingList(raw) {
        if (!raw) return [];
        if (typeof raw === 'string') {
            var t = raw.trim();
            if (!t) return [];
            if (t.charAt(0) === '[' || t.charAt(0) === '{') {
                try { raw = JSON.parse(t); } catch (e) { raw = t.split(/[\s,，;；]+/); }
            } else {
                raw = t.split(/[\s,，;；]+/);
            }
        }
        if (!Array.isArray(raw)) return [];
        var out = [];
        var seen = {};
        raw.forEach(function (item) {
            var name = '';
            var from = '';
            if (item && typeof item === 'object') {
                name = String(item.name || item.param || item.key || item.to || '').trim();
                from = String(item.from || item.source || item.expr || item.template || '').trim();
            } else {
                name = String(item || '').trim();
            }
            name = name.replace(/[^a-zA-Z0-9_.\[\]-]+/g, '');
            if (!name) return;
            if (!from) from = '{' + name + '}';
            if (seen[name]) {
                out[seen[name] - 1] = { name: name, from: from };
                return;
            }
            seen[name] = out.length + 1;
            out.push({ name: name, from: from });
        });
        return out.slice(0, 24);
    }

    function isSimpleSourcePick(from, name) {
        from = String(from || '').trim();
        name = String(name || '').trim();
        return from === '{' + name + '}' || from === name;
    }

    function renderParamPick() {
        var box = document.getElementById('tv-ga4-param-pick');
        if (!box) return;
        var opts = [];
        var seen = {};
        (matchParamOptions || []).forEach(function (o) {
            var id = String(o.id || o.value || '').trim();
            if (!id || seen[id]) return;
            seen[id] = 1;
            opts.push({ id: id, label: String(o.label || id) });
        });
        SOURCE_PARAM_PICKS.forEach(function (id) {
            if (seen[id]) return;
            seen[id] = 1;
            opts.push({ id: id, label: id });
        });
        var selected = {};
        collectParamMappings().forEach(function (m) {
            if (isSimpleSourcePick(m.from, m.name)) selected[m.name] = 1;
        });
        box.innerHTML = opts.map(function (o) {
            var id = o.id;
            var checked = selected[id] ? ' checked' : '';
            return '<label class="tvp-param-pick__item tvp-check" data-testid="tv-ga4-param-pick-item">' +
                '<input type="checkbox" data-source-param="' + id.replace(/"/g, '') + '"' + checked + '>' +
                '<span>' + String(o.label || id).replace(/</g, '') + '</span></label>';
        }).join('');
        box.querySelectorAll('input[data-source-param]').forEach(function (inp) {
            inp.addEventListener('change', function () {
                var key = String(inp.getAttribute('data-source-param') || '');
                if (!key) return;
                var rows = collectParamMappings();
                if (inp.checked) {
                    var exists = rows.some(function (r) { return r.name === key; });
                    if (!exists) rows.push({ name: key, from: '{' + key + '}' });
                } else {
                    rows = rows.filter(function (r) {
                        return !(r.name === key && isSimpleSourcePick(r.from, r.name));
                    });
                }
                seedParamMappings(rows);
            });
        });
    }

    function addMappingRow(name, from) {
        var body = document.getElementById('tv-ga4-map-body');
        if (!body) return;
        var tr = document.createElement('tr');
        tr.innerHTML = '<td><input class="w-input" data-size="sm" data-map-name data-testid="tv-map-name" list="tv-ga4-param-list" value="' +
            String(name || '').replace(/"/g, '&quot;') +
            '" placeholder="产出名" autocomplete="off" spellcheck="false"></td>' +
            '<td><input class="w-input" data-size="sm" data-map-from data-testid="tv-map-from" list="tv-ga4-param-list" value="' +
            String(from || '').replace(/"/g, '&quot;') +
            '" placeholder="{text} 或 {className}:{text}" autocomplete="off" spellcheck="false"></td>' +
            '<td><button type="button" class="w-button" data-size="sm" data-map-remove data-testid="tv-map-remove">删</button></td>';
        body.appendChild(tr);
        var rm = tr.querySelector('[data-map-remove]');
        if (rm) {
            rm.addEventListener('click', function () {
                tr.remove();
                renderParamPick();
            });
        }
        ['data-map-name', 'data-map-from'].forEach(function (sel) {
            var el = tr.querySelector('[' + sel + ']');
            if (el) el.addEventListener('change', function () { renderParamPick(); });
            if (el) el.addEventListener('blur', function () { renderParamPick(); });
        });
    }

    function collectParamMappings() {
        var rows = [];
        document.querySelectorAll('#tv-ga4-map-body tr').forEach(function (tr) {
            var name = String((tr.querySelector('[data-map-name]') || {}).value || '').trim();
            var from = String((tr.querySelector('[data-map-from]') || {}).value || '').trim();
            name = name.replace(/[^a-zA-Z0-9_.\[\]-]+/g, '');
            if (!name) return;
            if (!from) from = '{' + name + '}';
            rows.push({ name: name, from: from });
        });
        return rows.slice(0, 24);
    }

    function seedParamMappings(list) {
        var body = document.getElementById('tv-ga4-map-body');
        if (!body) return;
        ensureMatchParamDatalist();
        body.innerHTML = '';
        var rows = normalizeMappingList(list);
        rows.forEach(function (m) { addMappingRow(m.name, m.from); });
        renderParamPick();
    }

        function ensureMatchParamDatalist() {
        var list = document.getElementById('tv-ga4-param-list');
        if (!list || list.getAttribute('data-ready') === '1') {
            return;
        }
        list.innerHTML = (matchParamOptions || []).map(function (o) {
            var id = String(o.id || '');
            var label = String(o.label || id);
            return '<option value="' + id.replace(/"/g, '&quot;') + '" label="' + label.replace(/"/g, '&quot;') + '"></option>';
        }).join('');
        list.setAttribute('data-ready', '1');
    }

    function matchParamSelectHtml(selected) {
        selected = String(selected || 'event_name');
        ensureMatchParamDatalist();
        return '<input class="w-input" data-size="sm" data-cond-param data-testid="tv-cond-param" list="tv-ga4-param-list" value="'
            + selected.replace(/"/g, '&quot;')
            + '" placeholder="参数名，可选或手写" autocomplete="off" spellcheck="false">';
    }

    function matchOpSelectHtml(selected) {
        selected = String(selected || 'equals');
        return '<select class="w-input" data-size="sm" data-cond-op>' +
            (matchOpOptions || []).map(function (o) {
                var id = String(o.id || '');
                return '<option value="' + id.replace(/"/g, '') + '"' + (id === selected ? ' selected' : '') + '>' + String(o.label || id).replace(/</g, '') + '</option>';
            }).join('') +
            '</select>';
    }

    function addConditionRow(param, op, value) {
        var body = document.getElementById('tv-ga4-cond-body');
        if (!body) return;
        var tr = document.createElement('tr');
        tr.innerHTML = '<td>' + matchParamSelectHtml(param || 'event_name') + '</td>' +
            '<td>' + matchOpSelectHtml(op || 'equals') + '</td>' +
            '<td><input class="w-input" data-size="sm" data-cond-value value="' + String(value || '').replace(/"/g, '&quot;') + '" placeholder="值"></td>' +
            '<td><button type="button" class="w-button" data-size="sm" data-cond-remove>删</button></td>';
        body.appendChild(tr);
        var rm = tr.querySelector('[data-cond-remove]');
        if (rm) {
            rm.addEventListener('click', function () {
                if (body.querySelectorAll('tr').length <= 1) {
                    themeToastError('至少保留一条匹配条件');
                    return;
                }
                tr.remove();
            });
        }
    }

    function collectConditions() {
        var rows = [];
        document.querySelectorAll('#tv-ga4-cond-body tr').forEach(function (tr) {
            var param = String((tr.querySelector('[data-cond-param]') || {}).value || '').trim();
            var op = (tr.querySelector('[data-cond-op]') || {}).value || 'equals';
            var value = String((tr.querySelector('[data-cond-value]') || {}).value || '').trim();
            if (!param || !value) return;
            rows.push({ param: param, op: op, value: value });
        });
        return rows;
    }

    function seedConditionsForType(type, keepValues) {
        var body = document.getElementById('tv-ga4-cond-body');
        if (!body) return;
        var existing = keepValues ? collectConditions() : [];
        var byParam = {};
        existing.forEach(function (c) { byParam[c.param] = c.value; });
        body.innerHTML = '';
        currentMatchType = type || 'event_name';
        var hint = document.getElementById('tv-match-type-hint');
        document.querySelectorAll('[data-match-type]').forEach(function (btn) {
            btn.setAttribute('data-active', btn.getAttribute('data-match-type') === currentMatchType ? '1' : '0');
        });
        if (currentMatchType === 'url') {
            if (hint) hint.textContent = 'URL 匹配（GA4 常见）：event_name 等于 page_view，且 page_location / page_path 包含目标路径。';
            addConditionRow('event_name', 'equals', byParam.event_name || 'page_view');
            addConditionRow('page_location', 'contains', byParam.page_location || byParam.page_path || '');
        } else if (currentMatchType === 'custom') {
            if (hint) hint.textContent = '自定义条件：参数可选手写；支持多级点如 elementInfo.text；运算符 / 值（多条件为 AND）。';
            if (existing.length) {
                existing.forEach(function (c) { addConditionRow(c.param, c.op, c.value); });
            } else {
                addConditionRow('className', 'contains', '');
            }
        } else {
            if (hint) hint.textContent = '事件名匹配：当源事件名等于某值时生成新事件（GA4：event_name equals …）。';
            addConditionRow('event_name', 'equals', byParam.event_name || '');
        }
    }

    function openGa4CreateDialog() {
        var dlg = document.getElementById('tv-ga4-create-dialog');
        if (!dlg) return;
        showSandboxCompanion();
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.open === 'function') {
            window.Weline.UI.dialog.open(dlg);
            return;
        }
        dlg.hidden = false;
        dlg.setAttribute('data-state', 'open');
        dlg.setAttribute('aria-hidden', 'false');
    }

    function closeGa4CreateDialog() {
        var dlg = document.getElementById('tv-ga4-create-dialog');
        if (!dlg) return;
        hideSandboxCompanion();
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.close === 'function') {
            window.Weline.UI.dialog.close(dlg);
            ga4EditOriginalName = '';
            setGa4DialogMode(false);
            return;
        }
        dlg.hidden = true;
        dlg.setAttribute('data-state', 'closed');
        dlg.setAttribute('aria-hidden', 'true');
        ga4EditOriginalName = '';
        setGa4DialogMode(false);
    }

    function focusCreateEvent(opts) {
        opts = opts || {};
        ga4EditOriginalName = '';
        setGa4DialogMode(false);
        var nameEl = document.getElementById('tv-ga4-name');
        var thirdEl = document.getElementById('tv-ga4-third');
        if (nameEl && !opts.name) nameEl.value = '';
        if (thirdEl && !opts.third) thirdEl.value = '';
        var copyEl = document.getElementById('tv-ga4-copy-params');
        if (copyEl && opts.copy_params == null) copyEl.checked = true;
        if (opts.param_mappings) seedParamMappings(opts.param_mappings);
        else if (opts.extract_params) seedParamMappings(opts.extract_params);
        else seedParamMappings([]);
        if (nameEl && opts.name) nameEl.value = String(opts.name);
        if (thirdEl && opts.third) thirdEl.value = String(opts.third);
        if (opts.matchType) {
            seedConditionsForType(opts.matchType, false);
        }
        if (opts.paramsHint) {
            seedConditionsForType('url', false);
            var pathVal = String(opts.paramsHint || '').split('&')[0] || '';
            if (pathVal.indexOf('=') >= 0) pathVal = pathVal.split('=').slice(1).join('=');
            document.querySelectorAll('#tv-ga4-cond-body tr').forEach(function (tr) {
                var p = (tr.querySelector('[data-cond-param]') || {}).value;
                var v = tr.querySelector('[data-cond-value]');
                if (p === 'page_location' && v && !v.value) v.value = pathVal || '/';
            });
            setCreateHint('已按沙盒链接切到 URL 匹配，请核对条件后点「创建」。', 'info');
        } else if (opts.name && !opts.matchType) {
            seedConditionsForType('event_name', false);
            var firstVal = document.querySelector('#tv-ga4-cond-body [data-cond-value]');
            if (firstVal && !firstVal.value) firstVal.value = String(opts.name);
            setCreateHint('已带入事件名条件，可改成 URL 匹配或继续编辑条件。', 'muted');
        } else {
            if (!opts.matchType) seedConditionsForType(currentMatchType || 'event_name', false);
            setCreateHint('填写自定义事件名与匹配条件后点「创建」。', 'muted');
        }
        openGa4CreateDialog();
        if (nameEl) {
            window.setTimeout(function () {
                nameEl.focus();
                if (!opts.name) nameEl.select();
            }, 30);
        }
    }

    function submitGa4Event() {
        var nameEl = document.getElementById('tv-ga4-name');
        var thirdEl = document.getElementById('tv-ga4-third');
        var btn = document.getElementById('tv-ga4-add');
        var copyEl = document.getElementById('tv-ga4-copy-params');
        var editing = !!ga4EditMode;
        var name = nameEl ? String(nameEl.value || '').trim() : '';
        if (editing && ga4EditOriginalName) {
            name = ga4EditOriginalName;
            if (nameEl) nameEl.value = name;
        }
        var third = thirdEl ? String(thirdEl.value || '').trim() : '';
        var conditions = collectConditions();
        if (!name) {
            themeToastError('请填写自定义事件名称');
            setCreateHint('请填写自定义事件名称（如 confirm_signup）。', 'danger');
            if (nameEl) nameEl.focus();
            return;
        }
        if (!conditions.length) {
            themeToastError('请至少填写一条完整匹配条件（含值）');
            setCreateHint('匹配条件的「值」不能为空。', 'danger');
            return;
        }
        if (!addCustomEventUrl) {
            addMapRow(name, third || name);
            themeToastSuccess('已加入搭接表（未配置创建接口）');
            return;
        }
        if (btn) {
            btn.disabled = true;
            btn.textContent = editing ? '保存中…' : '创建中…';
        }
        var body = new URLSearchParams();
        body.set('weline_event', name);
        if (third) body.set('third_party_event', third);
        body.set('match_type', currentMatchType || 'custom');
        body.set('conditions_json', JSON.stringify(conditions));
        body.set('copy_params', copyEl && copyEl.checked ? '1' : '0');
        body.set('param_mappings_json', JSON.stringify(collectParamMappings()));
        body.set('csrf_token', csrfToken || '');
        var q = scopeQuery || {};
        ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind', 'website_id'].forEach(function (k) {
            if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
        });
        if (storageScope) body.set('target_scope', storageScope);
        fetch(addCustomEventUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (btn) {
                btn.disabled = false;
                btn.textContent = editing ? '保存' : '创建';
            }
            if (!data || !data.ok) {
                themeToastError((data && (data.error || data.message)) || (editing ? '保存失败' : '创建失败'));
                setCreateHint((data && (data.message || data.error)) || (editing ? '保存失败' : '创建失败'), 'danger');
                return;
            }
            if (Array.isArray(data.events)) {
                renderCustomEvents(data.events);
            } else {
                refreshCustomEvents();
            }
            broadcastTrackingReload(data);
            if (!editing) {
                addMapRow(data.weline_event || name, data.third_party_event || third || name);
            }
            if (data.is_custom) {
                themeToastSuccess((editing ? '已保存' : '已创建到本范围') + formatRevisionTip(data.configRevision || data.config_revision));
                setCreateHint((editing ? '已保存「' : '已创建「') + (data.weline_event || name) + '」' + (data.match_summary ? (' · ' + data.match_summary) : '') + formatRevisionTip(data.configRevision || data.config_revision), 'success');
                if (nameEl) nameEl.value = '';
                if (thirdEl) thirdEl.value = '';
                seedParamMappings([]);
                var copyReset = document.getElementById('tv-ga4-copy-params');
                if (copyReset) copyReset.checked = true;
                seedConditionsForType(currentMatchType, false);
                ga4EditOriginalName = '';
                setGa4DialogMode(false);
                closeGa4CreateDialog();
                activateMapSubtab('custom');
            } else {
                themeToastSuccess((data.message || '系统事件已加入搭接') + formatRevisionTip(data.configRevision || data.config_revision));
                setCreateHint(data.message || ('「' + (data.weline_event || name) + '」是系统字典事件，不会进入自定义池。'), 'warning');
            }
        }).catch(function () {
            if (btn) {
                btn.disabled = false;
                btn.textContent = editing ? '保存' : '创建';
            }
            themeToastError(editing ? '保存失败：网络异常' : '创建失败：网络异常');
            setCreateHint(editing ? '保存失败：网络异常' : '创建失败：网络异常', 'danger');
        });
    }

    var ga4Add = document.getElementById('tv-ga4-add');
    if (ga4Add) ga4Add.addEventListener('click', submitGa4Event);
    var mapAdd = document.getElementById('tv-ga4-map-add');
    if (mapAdd) {
        mapAdd.addEventListener('click', function () {
            addMappingRow('', '');
        });
    }
    seedParamMappings([]);
    var condAdd = document.getElementById('tv-ga4-cond-add');
    if (condAdd) {
        condAdd.addEventListener('click', function () {
            addConditionRow(currentMatchType === 'url' ? 'page_path' : 'event_name', currentMatchType === 'url' ? 'contains' : 'equals', '');
        });
    }
    document.querySelectorAll('[data-match-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            seedConditionsForType(btn.getAttribute('data-match-type') || 'event_name', true);
        });
    });
    seedConditionsForType('event_name', false);
    ['tv-custom-create', 'tv-open-ga4-create'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', function () {
                focusCreateEvent({});
            });
        }
    });
    var ga4Name = document.getElementById('tv-ga4-name');
    if (ga4Name) {
        ga4Name.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitGa4Event();
            }
        });
    }
    var ga4Third = document.getElementById('tv-ga4-third');
    if (ga4Third) {
        ga4Third.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitGa4Event();
            }
        });
    }

    var accRefresh = document.getElementById('tv-acc-refresh');
    if (accRefresh) accRefresh.addEventListener('click', refreshAccumulate);
    var accClear = document.getElementById('tv-acc-clear');
    if (accClear) accClear.addEventListener('click', clearSessionSandbox);
    bindStreamTabs();
    loadSessionStream();
    bumpStreamCursor(sessionStreamEvents, 0);
    if (sessionStreamEvents.length) renderSessionStream();
    var companionClose = document.getElementById('tv-sandbox-float-close');
    if (companionClose) {
        companionClose.addEventListener('click', function () {
            hideSandboxCompanion(true);
        });
    }
    var ga4Dlg = document.getElementById('tv-ga4-create-dialog');
    if (ga4Dlg && typeof MutationObserver === 'function') {
        var dlgObs = new MutationObserver(function () {
            var open = ga4Dlg.getAttribute('data-state') === 'open' && !ga4Dlg.hidden;
            if (open && !sandboxCompanionOpen && !companionUserClosed) showSandboxCompanion();
            if (!open) {
                companionUserClosed = false;
                if (sandboxCompanionOpen) hideSandboxCompanion(false);
            }
        });
        dlgObs.observe(ga4Dlg, { attributes: true, attributeFilter: ['data-state', 'hidden'] });
    }
    refreshAccumulate();
    startLiveTunnel();
    setInterval(function () {
        var mapPanel = document.querySelector('[data-panel="map"]');
        if (mapPanel && !mapPanel.hidden) {
            refreshCustomEvents();
        }
    }, 8000);

    var startPicker = document.getElementById('tv-start-picker');
    if (startPicker && startPickerUrl) {
        startPicker.addEventListener('click', function () {
            var body = new URLSearchParams();
            body.set('website_id', String(websiteId));
            body.set('vendor', selectedCode || '');
            body.set('csrf_token', csrfToken || '');
            var q = scopeQuery || {};
            ['target_scope', 'website_code', 'store_code', 'channel_code', 'scope_kind'].forEach(function (k) {
                if (q[k] != null && String(q[k]) !== '') body.set(k, String(q[k]));
            });
            if (storageScope) body.set('target_scope', storageScope);
            fetch(startPickerUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (!data || !data.ok || !data.url) {
                    themeToastError((data && data.error) || '无法启动拾取');
                    return;
                }
                window.open(data.url, '_blank', 'noopener');
            }).catch(function () {
                themeToastError('启动拾取失败');
            });
        });
    }

    function refreshChainStatus() {
        var el = document.getElementById('tv-chain-status');
        if (!el || !eventChainsUrl) return;
        fetch(eventChainsUrl, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.ok) return;
                var n = (data.chains && data.chains.length) || 0;
                el.textContent = '事件链 version=' + (data.version || 0) + '，共 ' + n + ' 条（按序跨页凑齐后上报闭环总事件）';
            }).catch(function () {});
    }
    refreshChainStatus();

    var credAdd = document.getElementById('tv-cred-add');
    if (credAdd) {
        credAdd.addEventListener('click', function () {
            var k = (document.getElementById('tv-cred-key') || {}).value || '';
            var v = (document.getElementById('tv-cred-val') || {}).value || '';
            if (!k) return;
            var wrap = document.getElementById('tv-cred-fields');
            var div = document.createElement('div');
            div.className = 'tvp-field';
            div.innerHTML = '<label>' + k.replace(/[<>]/g,'') + '</label><input class="w-input" data-size="sm" data-cred-key="' + k.replace(/"/g,'') + '" value="' + String(v).replace(/"/g,'&quot;') + '">';
            wrap.insertBefore(div, credAdd.closest('.tvp-field'));
            scheduleAutosave(true);
        });
    }

    var dlg = document.getElementById('tv-create-dialog');
    var openBtn = document.getElementById('tv-open-create');
    var cancelBtn = document.getElementById('tv-create-cancel');
    if (openBtn && dlg) openBtn.addEventListener('click', function () { dlg.showModal(); });
    if (cancelBtn && dlg) cancelBtn.addEventListener('click', function () { dlg.close(); });

    activateTab(resolveInitialTab(), { skipUrl: false });
    autosaveEnabled = true;
    setConfigRevisionDisplay(pageConfigRevision);
    setAutosaveStatus('改动将自动保存' + formatRevisionTip(pageConfigRevision), 'muted');
    // 整页保存/创建后回到本页时，通知店面标签页重载 runtime
    broadcastTrackingReload({ reload_tracking: true, configRevision: pageConfigRevision, config_revision: pageConfigRevision });
})();
</script>
