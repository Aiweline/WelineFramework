<!DOCTYPE html>
<html lang="zh-CN" data-w-area="frontend" data-theme-preference="system" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>像素数据分析面板</title>
    <css>Weline_Theme::ui/weline-foundation.css</css>
    <css>Weline_Theme::ui/weline-frontend.css</css>
    <css>Weline_Visitor::css/tokens/analytics.css</css>
    <css>Weline_Visitor::css/analytics-panel.css</css>
    <script type="application/json" data-weline-runtime-config>{"modulesConfigUrl":"/Weline/Frontend/view/statics/base/weline.modules.js","modulesBaseUrl":"/Weline/Frontend/view/statics/js/weline-api","api":{"workerUrl":"/Weline/Frontend/view/statics/js/weline-api-worker.js","endpoint":"/api/framework/query-bin","queryBinUrl":"/api/framework/query-bin"}}</script>
    <js>Weline_Frontend::js/runtime.js</js>
    <js>Weline_Frontend::js/weline-api-business.js</js>
    <js>Weline_Frontend::js/weline.js</js>
    <js type="module">Weline_Theme::ui/weline-ui.js</js>
</head>
<body>
    <div class="w-container w-visitor-panel" data-w-component="tabs">
        <div class="w-visitor-header">
            <h1>像素数据分析面板</h1>
            <p>全面的数据分析和可视化工具</p>
        </div>

        <div class="w-tabs__list w-visitor-tab-list" role="tablist" aria-label="像素数据分析">
            <button class="w-tabs__tab w-visitor-tab" type="button" role="tab" aria-controls="business" aria-selected="true">商业价值</button>
            <button class="w-tabs__tab w-visitor-tab" type="button" role="tab" aria-controls="dashboard" aria-selected="false">实时大屏</button>
            <button class="w-tabs__tab w-visitor-tab" type="button" role="tab" aria-controls="comparison" aria-selected="false">数据对比</button>
            <button class="w-tabs__tab w-visitor-tab" type="button" role="tab" aria-controls="abtest" aria-selected="false">A/B测试</button>
            <button class="w-tabs__tab w-visitor-tab" type="button" role="tab" aria-controls="report" aria-selected="false">综合报告</button>
        </div>

        <!-- 商业价值分析 -->
        <div id="business" class="w-tabs__panel" role="tabpanel">
            <div class="w-card">
                <h3>查询条件</h3>
                <div class="w-visitor-grid" data-w-columns="4">
                    <div class="w-field">
                        <label class="w-field__label" for="business-websiteId">站点ID</label>
                        <input class="w-input" type="number" id="business-websiteId" value="0" min="0">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="business-period">时间维度</label>
                        <select class="w-select" id="business-period">
                            <option value="daily">每天</option>
                            <option value="weekly">每周</option>
                            <option value="monthly">每月</option>
                            <option value="quarterly">每季度</option>
                            <option value="yearly">每年</option>
                        </select>
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="business-startDate">开始日期</label>
                        <input class="w-input" type="date" id="business-startDate">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="business-endDate">结束日期</label>
                        <input class="w-input" type="date" id="business-endDate">
                    </div>
                </div>
                <button class="w-button" data-visitor-action="load-business-value">查询</button>
            </div>

            <div class="w-visitor-grid">
                <div class="w-card">
                    <h3>总价值</h3>
                    <div class="w-visitor-stat" id="total-value" data-size="xl">0</div>
                </div>
                <div class="w-card">
                    <h3>总事件数</h3>
                    <div class="w-visitor-stat" id="total-events" data-size="xl">0</div>
                </div>
                <div class="w-card w-visitor-chart-card">
                    <h3>价值趋势</h3>
                    <div class="w-visitor-chart">
                        <canvas id="business-value-chart"></canvas>
                    </div>
                </div>
                <div class="w-card w-visitor-chart-card">
                    <h3>事件趋势</h3>
                    <div class="w-visitor-chart">
                        <canvas id="business-events-chart"></canvas>
                    </div>
                </div>
            </div>

            <div class="w-card">
                <h3>详细数据</h3>
                <table class="w-table">
                    <thead>
                        <tr>
                            <th><lang>日期</lang></th>
                            <th><lang>价值</lang></th>
                            <th><lang>事件数</lang></th>
                            <th><lang>事件类型数</lang></th>
                            <th><lang>平均价值</lang></th>
                            <th><lang>转化率</lang></th>
                        </tr>
                    </thead>
                    <tbody id="business-table-body">
                        <tr><td colspan="6" class="w-visitor-loading">请点击查询按钮加载数据</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 实时大屏 -->
        <div id="dashboard" class="w-tabs__panel" role="tabpanel" hidden>
            <div class="w-card">
                <h3>查询条件</h3>
                <div class="w-visitor-grid" data-w-columns="3">
                    <div class="w-field">
                        <label class="w-field__label" for="dashboard-websiteId">站点ID</label>
                        <input class="w-input" type="number" id="dashboard-websiteId" value="0" min="0">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="dashboard-interval">时间间隔</label>
                        <select class="w-select" id="dashboard-interval">
                            <option value="10">10分钟</option>
                            <option value="30">30分钟</option>
                        </select>
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="dashboard-hours">时间范围（小时）</label>
                        <input class="w-input" type="number" id="dashboard-hours" value="24" min="1" max="168">
                    </div>
                </div>
                <button class="w-button" data-visitor-action="load-dashboard">查询</button>
                <button class="w-button" data-visitor-action="toggle-auto-refresh" id="auto-refresh-btn" data-tone="neutral">开启自动刷新</button>
            </div>

            <div class="w-visitor-grid">
                <div class="w-card">
                    <h3>当前价值</h3>
                    <div class="w-visitor-stat" id="dashboard-current-value" data-size="xl">0</div>
                    <div class="w-visitor-stat__label" id="dashboard-current-time">--</div>
                </div>
                <div class="w-card">
                    <h3>当前事件数</h3>
                    <div class="w-visitor-stat" id="dashboard-current-events" data-size="xl">0</div>
                </div>
                <div class="w-card">
                    <h3>变化百分比</h3>
                    <div class="w-visitor-stat" id="dashboard-change-percent" data-size="xl">0%</div>
                </div>
                <div class="w-card w-visitor-chart-card">
                    <h3>价值趋势（实时）</h3>
                    <div class="w-visitor-chart">
                        <canvas id="dashboard-value-chart"></canvas>
                    </div>
                </div>
                <div class="w-card w-visitor-chart-card">
                    <h3>事件趋势（实时）</h3>
                    <div class="w-visitor-chart">
                        <canvas id="dashboard-events-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- 数据对比 -->
        <div id="comparison" class="w-tabs__panel" role="tabpanel" hidden>
            <div class="w-card">
                <h3>每日对比分析</h3>
                <div class="w-visitor-grid" data-w-columns="2">
                    <div class="w-field">
                        <label class="w-field__label" for="comparison-websiteId">站点ID</label>
                        <input class="w-input" type="number" id="comparison-websiteId" value="0" min="0">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="comparison-days">天数</label>
                        <input class="w-input" type="number" id="comparison-days" value="7" min="1" max="30">
                    </div>
                </div>
                <button class="w-button" data-visitor-action="load-comparison">查询</button>
            </div>

            <div class="w-card">
                <h3>对比数据</h3>
                <table class="w-table">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>今天价值</th>
                            <th>昨天价值</th>
                            <th>变化值</th>
                            <th>变化百分比</th>
                            <th>今天事件</th>
                            <th>昨天事件</th>
                        </tr>
                    </thead>
                    <tbody id="comparison-table-body">
                        <tr><td colspan="7" class="w-visitor-loading">请点击查询按钮加载数据</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="w-card w-visitor-chart-card">
                <h3>对比趋势图</h3>
                <div class="w-visitor-chart">
                    <canvas id="comparison-chart"></canvas>
                </div>
            </div>
        </div>

        <!-- A/B测试 -->
        <div id="abtest" class="w-tabs__panel" role="tabpanel" hidden>
            <div class="w-card">
                <h3>A/B测试管理</h3>
                <div class="w-visitor-grid" data-w-columns="2">
                    <div class="w-field">
                        <label class="w-field__label" for="abtest-websiteId">站点ID</label>
                        <input class="w-input" type="number" id="abtest-websiteId" value="0" min="0">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="abtest-status">状态筛选</label>
                        <select class="w-select" id="abtest-status">
                            <option value="">全部</option>
                            <option value="active">进行中</option>
                            <option value="paused">暂停</option>
                            <option value="completed">已完成</option>
                            <option value="draft">草稿</option>
                        </select>
                    </div>
                </div>
                <button class="w-button" data-visitor-action="load-abtest-list">加载测试列表</button>
                <button class="w-button" data-visitor-action="show-create-abtest" data-tone="neutral">创建新测试</button>
            </div>

            <div class="w-card">
                <h3>测试列表</h3>
                <table class="w-table">
                    <thead>
                        <tr>
                            <th>测试ID</th>
                            <th>名称</th>
                            <th>状态</th>
                            <th>开始时间</th>
                            <th>结束时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody id="abtest-table-body">
                        <tr><td colspan="6" class="w-visitor-loading">请点击加载测试列表</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="w-card" id="abtest-detail" hidden>
                <h3>测试详情</h3>
                <div class="w-field">
                    <label class="w-field__label" for="abtest-detail-testId">测试ID</label>
                    <input class="w-input" type="text" id="abtest-detail-testId" readonly>
                </div>
                <button class="w-button" data-visitor-action="load-abtest-data">查看数据</button>
                <div class="w-visitor-abtest-result" id="abtest-detail-result"></div>
            </div>
        </div>

        <!-- 综合报告 -->
        <div id="report" class="w-tabs__panel" role="tabpanel" hidden>
            <div class="w-card">
                <h3>查询条件</h3>
                <div class="w-visitor-grid" data-w-columns="3">
                    <div class="w-field">
                        <label class="w-field__label" for="report-websiteId">站点ID</label>
                        <input class="w-input" type="number" id="report-websiteId" value="0" min="0">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="report-startDate">开始日期</label>
                        <input class="w-input" type="date" id="report-startDate">
                    </div>
                    <div class="w-field">
                        <label class="w-field__label" for="report-endDate">结束日期</label>
                        <input class="w-input" type="date" id="report-endDate">
                    </div>
                </div>
                <button class="w-button" data-visitor-action="load-report">生成报告</button>
                <button class="w-button" data-visitor-action="export-data" data-tone="neutral">导出数据</button>
            </div>

            <div class="w-visitor-grid">
                <div class="w-card">
                    <h3><lang>总记录数</lang></h3>
                    <div class="w-visitor-stat" id="report-total" data-size="xl">0</div>
                </div>
                <div class="w-card">
                    <h3><lang>总价值</lang></h3>
                    <div class="w-visitor-stat" id="report-total-value" data-size="xl">0</div>
                </div>
                <div class="w-card">
                    <h3><lang>事件类型数</lang></h3>
                    <div class="w-visitor-stat" id="report-event-count" data-size="xl">0</div>
                </div>
                <div class="w-card">
                    <h3><lang>未处理记录</lang></h3>
                    <div class="w-visitor-stat" id="report-undeal" data-size="xl">0</div>
                </div>
            </div>

            <div class="w-card">
                <h3>热门事件 Top 10</h3>
                <table class="w-table">
                    <thead>
                        <tr>
                            <th>排名</th>
                            <th>事件名称</th>
                            <th>事件数量</th>
                            <th>占比</th>
                        </tr>
                    </thead>
                    <tbody id="report-top-events">
                        <tr><td colspan="4" class="w-visitor-loading">请点击生成报告</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="w-card w-visitor-chart-card">
                <h3>事件分布图</h3>
                <div class="w-visitor-chart">
                    <canvas id="report-events-chart"></canvas>
                </div>
            </div>

            <div class="w-card w-visitor-chart-card">
                <h3>每日趋势</h3>
                <div class="w-visitor-chart">
                    <canvas id="report-daily-chart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <js type="module">Weline_Visitor::js/analytics-panel.js</js>
</body>
</html>
