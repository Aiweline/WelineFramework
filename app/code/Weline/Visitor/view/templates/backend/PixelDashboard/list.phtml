<?php
/**
 * C01–C03：像素事件明细 list（热表分页 + 归因筛选表单）。
 *
 * @var \Weline\Framework\View\Template $this
 * @var string $page_title
 * @var array $rows
 * @var array $filters
 * @var array $pagination
 * @var list<string> $traffic_type_options
 * @var list<array{value:string,label:string,meta:string}> $website_select_options
 * @var string $website_select_options_json
 * @var bool $list_ready
 * @var string $list_error
 */

$pageTitle = (string)($page_title ?? __('像素事件列表'));
$rows = $rows ?? [];
$filters = $filters ?? [];
$pagination = $pagination ?? ['page' => 1, 'page_size' => 50, 'page_count' => 0, 'total' => 0];
$trafficTypeOptions = $traffic_type_options ?? \Weline\Visitor\Model\PixelChannel::TRAFFIC_TYPES;
$websiteSelectOptions = is_array($website_select_options ?? null) ? $website_select_options : [];
$websiteSelectOptionsJson = (string)($website_select_options_json ?? '');
if ($websiteSelectOptionsJson === '') {
    $websiteSelectOptionsJson = json_encode($websiteSelectOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';
}
$listReady = (bool)($list_ready ?? false);
$listError = (string)($list_error ?? '');
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$page = max(1, (int)($pagination['page'] ?? 1));
$pageSize = max(1, (int)($pagination['page_size'] ?? 50));
$pageCount = max(0, (int)($pagination['page_count'] ?? 0));
$total = max(0, (int)($pagination['total'] ?? 0));

$selectedWebsite = (string)($filters['website_id_raw'] ?? '');
$selectedWebsiteDisplay = \Weline\Visitor\Service\PixelStatisticsService::resolveWebsiteSelectDisplay(
    $websiteSelectOptions,
    $selectedWebsite
);
$selectedEvent = (string)($filters['event'] ?? '');
$selectedRange = (string)($filters['range'] ?? '30d');
$rangeLabels = [
    'today' => (string)__('今天'),
    'yesterday' => (string)__('昨天'),
    '7d' => (string)__('近 7 天'),
    '30d' => (string)__('近 30 天'),
    '90d' => (string)__('近 90 天'),
    'custom' => (string)__('自定义'),
];
$startInput = $selectedRange === 'custom' ? (string)($filters['start_day'] ?? '') : '';
$endInput = $selectedRange === 'custom' ? (string)($filters['end_day'] ?? '') : '';
$selectedChannel = (string)($filters['channel_code'] ?? '');
$selectedTrafficType = (string)($filters['traffic_type'] ?? '');
$selectedUtmSource = (string)($filters['utm_source'] ?? '');
$selectedUtmMedium = (string)($filters['utm_medium'] ?? '');
$selectedUtmCampaign = (string)($filters['utm_campaign'] ?? '');
$utmAdvancedOpen = ($selectedUtmSource !== '' || $selectedUtmMedium !== '' || $selectedUtmCampaign !== '');

$queryBase = array_filter([
    'websiteId' => $selectedWebsite,
    'event' => $selectedEvent,
    'range' => $selectedRange,
    'startDate' => (string)($filters['start_day'] ?? ''),
    'endDate' => (string)($filters['end_day'] ?? ''),
    'channel_code' => $selectedChannel,
    'traffic_type' => $selectedTrafficType,
    'utm_source' => $selectedUtmSource,
    'utm_medium' => $selectedUtmMedium,
    'utm_campaign' => $selectedUtmCampaign,
    'pageSize' => (string)$pageSize,
], static fn($v): bool => $v !== null && $v !== '');

$formAction = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list');
$indexUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/index', $queryBase);
$listUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', $queryBase);
$archiveListUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/archive-list', $queryBase);
$resetUrl = $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list');
$exportUrl = $this->getBackendUrlPath(
    'visitor/backend/pixel-dashboard/export',
    array_merge($queryBase, ['format' => 'csv'])
);
$prevUrl = $page > 1
    ? $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', array_merge($queryBase, ['page' => $page - 1]))
    : '';
$nextUrl = ($pageCount > 0 && $page < $pageCount)
    ? $this->getBackendUrlPath('visitor/backend/pixel-dashboard/list', array_merge($queryBase, ['page' => $page + 1]))
    : '';
?>
