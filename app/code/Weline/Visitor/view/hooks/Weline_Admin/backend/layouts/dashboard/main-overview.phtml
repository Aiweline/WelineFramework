<?php
/**
 * 后台首页主要概览区域 Hook 实现
 *
 * Hook 名称：Weline_Admin::backend::layouts::dashboard::main-overview
 *
 * 功能：
 * - 在 Admin 后台首页中部展示像素统计的趋势与热门事件摘要
 *
 * @hook-priority 150
 * @hook-sort-order 0
 * @hook-solo false
 */

/** @var \Weline\Framework\View\Template $this */

use Weline\Visitor\Service\PixelStatisticsService;

try {
    $overview   = PixelStatisticsService::getGlobalDashboardOverview(7, 5);
    $trends     = $overview['trends']      ?? [];
    $topEvents  = $overview['top_events']  ?? [];
} catch (\Throwable $e) {
    // 失败时直接回退到默认实现
    return;
}
?>
<div class="w-grid">
    <div style="--w-span-lg:8;">
        <div class="w-card">
            <div class="w-card__body">
                <div class="w-cluster" data-align="center" style="--w-mb:var(--weline-space-4);">
                    <div data-grow="true">
                        <h5 class="w-card__title" style="--w-mb:0;">
                            <lang>最近 7 天像素趋势</lang>
                        </h5>
                    </div>
                    <div data-shrink="false">
                        <span class="w-badge w-text" data-w-background="primary" data-tone="primary" style="--w-font-size:0.75rem;">
                            <lang>像素统计</lang>
                        </span>
                    </div>
                </div>

                <?php if (!empty($trends)): ?>
                    <div class="w-table-wrap">
                        <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                            <thead>
                            <tr>
                                <th><lang>日期</lang></th>
                                <th class="w-text" data-align="end"><lang>事件数</lang></th>
                                <th class="w-text" data-align="end"><lang>价值</lang></th>
                            </tr>
                            </thead>
                            <tbody>
                            <?php foreach ($trends as $row): ?>
                                <tr>
                                    <td><?= htmlspecialchars($row['date'] ?? '') ?></td>
                                    <td class="w-text" data-align="end"><?= number_format((int)($row['count'] ?? 0)) ?></td>
                                    <td class="w-text" data-align="end"><?= number_format((float)($row['value'] ?? 0), 2) ?></td>
                                </tr>
                            <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                <?php else: ?>
                    <p class="w-text" data-tone="muted" style="--w-mb:0;">
                        <lang>暂无像素趋势数据。</lang>
                    </p>
                <?php endif; ?>
            </div>
        </div>
    </div>

    <div style="--w-span-lg:4;">
        <div class="w-card">
            <div class="w-card__body">
                <div class="w-cluster" data-align="center" style="--w-mb:var(--weline-space-4);">
                    <div data-grow="true">
                        <h5 class="w-card__title" style="--w-mb:0;">
                            <lang>热门事件 Top 5</lang>
                        </h5>
                    </div>
                </div>

                <?php if (!empty($topEvents)): ?>
                    <ul class="w-list-group">
                        <?php foreach ($topEvents as $eventName => $count): ?>
                            <li class="w-list-group__item w-cluster" data-justify="between" data-align="center" style="--w-ps:0;--w-pe:0;">
                                <span class="w-text" title="<?= htmlspecialchars($eventName) ?>" data-truncate="true">
                                    <?= htmlspecialchars($eventName) ?>
                                </span>
                                <span class="w-badge" data-w-background="primary" data-w-radius="round">
                                    <?= number_format((int)$count) ?>
                                </span>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php else: ?>
                    <p class="w-text" data-tone="muted" style="--w-mb:0;">
                        <lang>暂无事件统计数据。</lang>
                    </p>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
