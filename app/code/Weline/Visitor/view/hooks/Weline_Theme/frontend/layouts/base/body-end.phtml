<?php
/**
 * Global storefront visitor pixel bootstrap.
 *
 * Hook: Weline_Theme::frontend::layouts::base::body-end
 * @hook-priority 120
 * @hook-sort-order 50
 * @hook-solo false
 */
?>
<?php
$__request_path_raw = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$__request_path_parsed = parse_url($__request_path_raw, PHP_URL_PATH);
$__request_path = strtolower((string)(is_string($__request_path_parsed) && $__request_path_parsed !== '' ? $__request_path_parsed : $__request_path_raw));
if ($__request_path === '/customer/account'
    || $__request_path === 'customer/account'
    || str_contains($__request_path, '/customer/account/')
) {
    return;
}

$__visitor_tracking_config = [
    'module' => 'Weline_Visitor',
    'pixel' => ['enabled' => true],
    'hotBuffer' => [
        'enabled' => true,
        'flushInterval' => 15,
        'batchSize' => 500,
        'ttl' => 300,
        'source' => 'Weline_Visitor default',
    ],
    'consent' => [
        'enabled' => false,
        'marketingStorageKey' => 'ad_storage',
        'source' => 'Weline_Visitor default',
    ],
    'sticky' => [
        'ttlHours' => 24,
        'linkerEnabled' => true,
        'formMergeEnabled' => false,
        'source' => 'Weline_Visitor default',
    ],
    'attribution' => [
        'backfillDone' => false,
        'legacyCronSourceEnabled' => false,
        'source' => 'Weline_Visitor default',
    ],
    'retention' => [
        'hotDays' => 365,
        'warmDays' => 1095,
        'coldArchiveEnabled' => true,
        'source' => 'Weline_Visitor default',
    ],
    'trafficRules' => [
        'source' => 'Weline_Visitor default',
        'excludeLocalForwarding' => true,
        'excludedHosts' => [],
        'excludedPathPrefixes' => [],
        'excludedQueryKeys' => [],
        'excludedReferrerHosts' => [],
        'excludedUserAgentKeywords' => [],
    ],
    'ga4' => [
        'enabled' => false,
        'configured' => false,
        'measurementId' => '',
        'enableInDev' => false,
        'autoTrackVisitorEvents' => true,
        'ctaEventName' => 'cta_click',
        'debugMode' => false,
        'source' => 'Weline_Visitor default',
    ],
    'forwarders' => [
        'eventBus' => ['enabled' => true, 'contractVersion' => 'weline-visitor-event/v1'],
        'ga4' => ['enabled' => false, 'configured' => false, 'measurementId' => '', 'autoTrackVisitorEvents' => true],
        'custom' => ['enabled' => false, 'script' => ''],
    ],
];
try {
    $__visitor_tracking_config = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Visitor\Service\VisitorTrackingConfig::class)
        ->getRuntimeConfig();
} catch (\Throwable $throwable) {
    if (defined('DEV') && DEV) {
        w_log_error('读取 Visitor 前台统计配置失败: ' . $throwable->getMessage());
    }
}
$__visitor_pixel_enabled = !empty($__visitor_tracking_config['pixel']['enabled']);
$__visitor_ga4_enabled = !empty($__visitor_tracking_config['ga4']['enabled']);
// 开发面板「访问事件」Tab 由 VisitorPanelBootstrapObserver 全局注入，不在此 hook 输出。

$__pixel_name = 'weshop_storefront_behavior';
$__data = new \Weline\Framework\DataObject\DataObject([
    'pixel_code' => '',
    'name' => $__pixel_name,
    'enable' => $__visitor_pixel_enabled ? 1 : 0,
]);
$__event = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Event\EventsManager::class);
$__event->dispatch('Weline_Visitor::taglib_pixel', $__data);
$__visitor_pixel_enabled = $__visitor_pixel_enabled && !empty($__data->getData('enable'));

$__visitor_tracking_config['pixel']['enabled'] = $__visitor_pixel_enabled;
$__visitor_tracking_json = json_encode(
    $__visitor_tracking_config,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
if ($__visitor_tracking_json === false) {
    $__visitor_tracking_json = '{}';
}

$__pixel_env = [
    'website_id' => (string)\Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_ID', (string)($_SERVER['WELINE_WEBSITE_ID'] ?? '')),
    'website_code' => (string)\Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_CODE', (string)($_SERVER['WELINE_WEBSITE_CODE'] ?? '')),
    'website_url' => (string)\Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_URL', (string)($_SERVER['WELINE_WEBSITE_URL'] ?? '')),
    'language' => (string)\Weline\Framework\Env\WelineEnv::server('WELINE_USER_LANG', (string)($_SERVER['WELINE_USER_LANG'] ?? '')),
    'currency' => (string)\Weline\Framework\Env\WelineEnv::server('WELINE_USER_CURRENCY', (string)($_SERVER['WELINE_USER_CURRENCY'] ?? '')),
];
try {
    if ($__pixel_env['website_url'] !== '' && str_contains($__pixel_env['website_url'], '%')) {
        $__decoded_website_url = rawurldecode($__pixel_env['website_url']);
        if (is_string($__decoded_website_url) && $__decoded_website_url !== '') {
            $__pixel_env['website_url'] = $__decoded_website_url;
        }
    }
} catch (\Throwable) {
}
$__pixel_env_json = json_encode(
    $__pixel_env,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
if ($__pixel_env_json === false) {
    $__pixel_env_json = '{}';
}

if ($__visitor_pixel_enabled || $__visitor_ga4_enabled) {
    $__pixel_script_url = '@static(Weline_Visitor::js/pixel.js)?v=20260724-section-code-1';
    ?>
<script>
(function () {
    'use strict';

    var visitorTrackingConfig = <?= $__visitor_tracking_json ?>;
    window.__WelineVisitorTrackingConfig = visitorTrackingConfig;
    window.__WelinePixelEnv = Object.assign({}, window.__WelinePixelEnv || {}, <?= $__pixel_env_json ?>);
    window.__SITE_GA4__ = Object.assign({}, window.__SITE_GA4__ || {}, visitorTrackingConfig.ga4 || {}, {
        source: (visitorTrackingConfig.ga4 && visitorTrackingConfig.ga4.source) || 'Weline_Visitor SystemConfig'
    });
    try {
        window.dispatchEvent(new CustomEvent('weline:visitor-tracking-config', { detail: visitorTrackingConfig }));
    } catch (error) {
    }

    if (window.__WelinePixelLazyScheduled) {
        return;
    }
    window.__WelinePixelLazyScheduled = true;

    function isLocalDevHost() {
        try {
            var host = String(window.location && window.location.hostname || '');
            return !!(window.DEV
                || window.WELINE_ENV === 'DEV'
                || window.__WELINE_DEBUG__
                || host === 'localhost'
                || host === '127.0.0.1'
                || /\.weline\.test$/i.test(host));
        } catch (e) {
            return !!(window.DEV || window.WELINE_ENV === 'DEV');
        }
    }

    function devLog() {
        if (!isLocalDevHost() || typeof console === 'undefined' || typeof console.log !== 'function') {
            return;
        }
        var args = Array.prototype.slice.call(arguments);
        args.unshift('[WelinePixel]');
        console.log.apply(console, args);
    }

    function loadWelinePixel(reason) {
        if (window.__WelinePixelLazyLoaded || window.__WelinePixelLoaded) {
            return;
        }

        window.__WelinePixelLazyLoaded = true;
        window.__WelinePixelName = '<?= htmlspecialchars($__pixel_name, ENT_QUOTES, 'UTF-8') ?>';
        var script = document.createElement('script');
        script.src = '<?= $__pixel_script_url ?>';
        script.async = true;
        script.onload = function () {
            devLog('loaded', { reason: reason || 'schedule', hasTrack: !!(window.WelinePixel && window.WelinePixel.track) });
        };
        script.onerror = function () {
            devLog('load-failed', { reason: reason || 'schedule', src: script.src });
        };
        document.head.appendChild(script);
        devLog('loading', { reason: reason || 'schedule', src: script.src });
    }

    function scheduleWelinePixel() {
        // Local/dev hosts: load immediately so CTA clicks are measurable while debugging.
        if (isLocalDevHost()) {
            loadWelinePixel('eager-dev');
            return;
        }
        window.setTimeout(function () {
            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(function () { loadWelinePixel('idle'); }, { timeout: 8000 });
                return;
            }
            window.setTimeout(function () { loadWelinePixel('timeout'); }, 1000);
        }, 3500);
    }

    function closestCta(node) {
        if (!node || !node.closest) {
            return null;
        }
        return node.closest([
            '[data-cta]',
            '[data-cta-event]',
            '[data-pixel-event]',
            '[data-pb-ai-action]',
            '[class*="weline-pixel::"]',
            'a[class*="-cta"]',
            'button[class*="-cta"]',
            '.pb-c-cta'
        ].join(','));
    }

    // Capture CTA clicks even before pixel.js finishes loading.
    document.addEventListener('click', function (event) {
        var cta = closestCta(event.target);
        if (!cta) {
            return;
        }
        var className = typeof cta.className === 'string' ? cta.className : '';
        var pixelClass = '';
        className.split(/\s+/).forEach(function (token) {
            if (token.indexOf('weline-pixel::') === 0 && token.indexOf(':value') === -1) {
                pixelClass = token.replace('weline-pixel::', '');
            }
        });
        var info = {
            tag: cta.tagName,
            text: ((cta.innerText || cta.textContent || '') + '').trim().slice(0, 80),
            href: cta.getAttribute('href') || cta.href || '',
            action: cta.getAttribute('data-pb-ai-action') || '',
            dataCtaEvent: cta.getAttribute('data-cta-event') || '',
            pixelClass: pixelClass,
            className: className,
            pixelReady: !!(window.WelinePixel && typeof window.WelinePixel.track === 'function')
        };
        if (isLocalDevHost()) {
            console.log('[WelineCTA] click', info);
        }
        if (!window.WelinePixel || typeof window.WelinePixel.track !== 'function') {
            loadWelinePixel('cta-click');
        }
    }, true);

    window.__WelineLoadPixel = loadWelinePixel;
    if (document.readyState === 'complete') {
        scheduleWelinePixel();
    } else {
        window.addEventListener('load', scheduleWelinePixel, { once: true });
    }
})();
</script>
<?php
}
?>
