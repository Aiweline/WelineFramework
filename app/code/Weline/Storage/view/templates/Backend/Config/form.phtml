<script>
(function(g){
  if(g.__bqAdmin_storage) return;
  g.__bqAdmin_storage=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['storage']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('storage').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script type="module">

const driverSelect = document.getElementById('driver-select');
const driverConfigs = document.querySelectorAll('.driver-config');

driverSelect.addEventListener('change', function() {
    driverConfigs.forEach(el => el.style.display = 'none');
    const target = document.getElementById('config-' + this.value);
    if (target) target.style.display = '';
});

const form = document.getElementById('storage-config-form');

form.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(form);
    const params = new URLSearchParams();
    for (const [key, value] of formData) {
        params.append(key, value);
    }
    
    try {
        var saveUrl = '<?= $this->getUrl('storage/backend/config/save') ?>';
        var saveOpts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() };
        var res = await bqAdmin['storage'](saveUrl, saveOpts);
        var data = (res && res.data) !== undefined ? res.data : res;
        
        if (data.code === 200) {
            Weline.UI.toast.success(data.msg);
            setTimeout(() => {
                location.href = '<?= $this->getUrl('storage/backend/config') ?>';
            }, 1000);
        } else {
            Weline.UI.toast.error(data.msg);
        }
    } catch (e) {
        Weline.UI.toast.error('<?= __('保存失败') ?>');
    }
});

document.getElementById('btn-test').addEventListener('click', async function() {
    const formData = new FormData(form);
    const params = new URLSearchParams();
    for (const [key, value] of formData) {
        params.append(key, value);
    }
    
    this.disabled = true;
    this.innerHTML = '<span class="w-spinner" data-size="sm"></span> <?= __('测试中...') ?>';
    
    try {
        var url = '<?= $this->getUrl('storage/backend/config/test') ?>';
        var opts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() };
        var res = await bqAdmin['storage'](url, opts);
        var data = (res && res.data) !== undefined ? res.data : res;
        
        if (data.code === 200) {
            Weline.UI.toast.success(data.msg);
        } else {
            Weline.UI.toast.error(data.msg);
        }
    } catch (e) {
        Weline.UI.toast.error('<?= __('测试失败') ?>');
    } finally {
        this.disabled = false;
        this.innerHTML = '<w:icon name="circle" size="sm"></w:icon> <?= __('测试连接') ?>';
    }
});
</script>
