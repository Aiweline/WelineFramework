<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$type = in_array(($type ?? 'info'), ['success', 'error', 'info'], true) ? (string)$type : 'info';
$tone = $type === 'error' ? 'danger' : $type;
$icon = ['success' => 'check-circle', 'error' => 'x-circle', 'info' => 'info'][$type];
$title = ['success' => __('操作成功'), 'error' => __('操作失败'), 'info' => __('操作提示')][$type];
?>
<section
    class="w-card"
    data-w-offcanvas-result
    data-result-type="<?= $escape($type) ?>"
    data-result-message="<?= $escape($msg ?? '') ?>"
    data-result-url="<?= $escape($url ?? '') ?>"
    data-result-reload="<?= !empty($reload) ? 'true' : 'false' ?>"
    data-result-delay="<?= max(0, min(30, (int)($time ?? 3))) ?>"
    data-result-countdown-label="<?= $escape(__('%s 秒后完成')) ?>"
>
    <div class="w-card__body w-empty" role="<?= $type === 'error' ? 'alert' : 'status' ?>">
        <w-icon name="<?= $escape($icon) ?>" size="xl"></w-icon>
        <div class="w-stack">
            <h1 class="w-card__title" data-tone="<?= $escape($tone) ?>"><?= $escape($title) ?></h1>
            <p><?= $escape($msg ?? '') ?></p>
            <?php if (trim((string)($content ?? '')) !== ''): ?>
                <p class="w-text" data-tone="muted"><?= $escape($content) ?></p>
            <?php endif; ?>
            <p class="w-text" data-tone="muted" data-result-countdown aria-live="polite"></p>
        </div>
        <button type="button" class="w-button" data-result-finish data-tone="<?= $escape($tone) ?>">
            <lang>立即完成</lang>
        </button>
    </div>
</section>
<script type="module" src="@static(Weline_Theme::ui/pages/weline-offcanvas-result.js)"></script>
