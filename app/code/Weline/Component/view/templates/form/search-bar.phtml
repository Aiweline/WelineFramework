<?php
/**
 * 搜索框 + 提交按钮联合组件（Weline UI 2.0）
 *
 * 变量：
 * - $name         字段名，默认 search（仅服务端筛选模式）
 * - $value        当前值
 * - $placeholder  占位文案
 * - $submit_label 提交按钮 aria-label
 * - $form_id      可选，关联外部 form（同页多表单时使用）
 * - $client_mode  true 时在前端异步筛选，不触发表单跳转
 */
$name = (string)($name ?? 'search');
$value = htmlspecialchars((string)($value ?? ''), ENT_QUOTES, 'UTF-8');
$placeholder = htmlspecialchars((string)($placeholder ?? __('搜索')), ENT_QUOTES, 'UTF-8');
$submitLabel = htmlspecialchars((string)($submit_label ?? __('搜索')), ENT_QUOTES, 'UTF-8');
$formId = trim((string)($form_id ?? ''));
$clientMode = filter_var($client_mode ?? false, FILTER_VALIDATE_BOOLEAN);
$formAttr = (!$clientMode && $formId !== '') ? ' form="' . htmlspecialchars($formId, ENT_QUOTES, 'UTF-8') . '"' : '';
$nameAttr = $clientMode ? '' : ' name="' . htmlspecialchars($name, ENT_QUOTES, 'UTF-8') . '"';
$submitType = $clientMode ? 'button' : 'submit';
$searchRootAttr = $clientMode ? ' data-w-system-config-search="1"' : '';
$inputHookAttr = $clientMode ? ' data-w-system-config-search-input="1"' : '';
$triggerHookAttr = $clientMode ? ' data-w-system-config-search-trigger="1"' : '';
$clearHookAttr = $clientMode ? ' data-w-system-config-search-clear="1"' : '';
$clearLabel = htmlspecialchars((string)__('清除搜索'), ENT_QUOTES, 'UTF-8');
?>
<div class="w-search-bar" id="wsc-search-root" data-w-search-bar<?= $searchRootAttr ?>>
    <div class="w-search-bar__control">
        <input
            type="search"
            class="w-search-bar__input"
            id="wsc-search-input"
            <?= $nameAttr ?>
            value="<?= $value ?>"
            placeholder="<?= $placeholder ?>"
            autocomplete="off"
            <?= $formAttr ?>
            <?= $inputHookAttr ?>
        >
        <?php if ($clientMode): ?>
        <button type="button" class="w-search-bar__clear" hidden aria-label="<?= $clearLabel ?>"<?= $clearHookAttr ?>>
            <svg class="w-search-bar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
        </button>
        <?php endif; ?>
        <button type="<?= $submitType ?>" class="w-search-bar__submit" aria-label="<?= $submitLabel ?>"<?= $formAttr ?><?= $triggerHookAttr ?>>
            <svg class="w-search-bar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M20 20l-4.2-4.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
        </button>
    </div>
</div>
