<?php
/**
 * Weline UI 2.0 remote drawer.
 *
 * @var string $id
 * @var string $target_tag
 * @var string $target_button_text
 * @var string $target_tone
 * @var string $target_variant
 * @var string $target_size
 * @var string $target_class
 * @var string $target_hidden
 * @var string $drawer_side
 * @var string $drawer_size
 * @var string $action
 */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$targetAttributes = [
    'class="w-button' . ($target_class !== '' ? ' ' . $escape($target_class) : '') . '"',
    'type="button"',
    'data-w-action="drawer.open"',
    'data-w-target="#' . $escape($id) . '"',
    'data-tone="' . $escape($target_tone) . '"',
    'aria-controls="' . $escape($id) . '"',
    'title="' . $escape($title ?? '') . '"',
];
if ($target_variant !== '') {
    $targetAttributes[] = 'data-variant="' . $escape($target_variant) . '"';
}
if ($target_size !== '') {
    $targetAttributes[] = 'data-size="' . $escape($target_size) . '"';
}
if (filter_var($target_hidden, FILTER_VALIDATE_BOOLEAN)) {
    $targetAttributes[] = 'hidden';
}
?>
<<?= $target_tag ?> <?= implode(' ', $targetAttributes) ?>>
    <?php if (!empty($icon)): ?>
        <w:icon name="<?= $escape($icon) ?>" size="sm"></w:icon>
    <?php endif; ?>
    <?= $escape(__($target_button_text ?? '')) ?>
</<?= $target_tag ?>>

<section
    class="w-drawer w-remote-drawer"
    id="<?= $escape($id) ?>"
    data-w-component="drawer remote-drawer"
    data-w-side="<?= $escape($drawer_side) ?>"
    data-size="<?= $escape($drawer_size) ?>"
    data-state="closed"
    data-w-keep-mounted="true"
    data-w-remote-save="<?= filter_var($save ?? false, FILTER_VALIDATE_BOOLEAN) ? 'true' : 'false' ?>"
    data-w-remote-form="<?= $escape($save_form ?? '') ?>"
    tabindex="-1"
    aria-labelledby="<?= $escape($id) ?>-title"
    aria-hidden="true"
    hidden
>
    <header class="w-drawer__header">
        <h2 class="w-drawer__title" id="<?= $escape($id) ?>-title">
            <?php if (!empty($icon)): ?>
                <w:icon name="<?= $escape($icon) ?>" size="sm"></w:icon>
            <?php endif; ?>
            <?= $escape(__($title ?? '')) ?>
        </h2>
        <?php if (filter_var($close_button_show ?? true, FILTER_VALIDATE_BOOLEAN)): ?>
            <button
                type="button"
                class="w-button"
                data-tone="quiet"
                data-size="sm"
                data-w-close
                data-w-action="drawer.close"
                data-w-target="#<?= $escape($id) ?>"
                aria-label="<?= $escape($close_button_text ?? __('关闭')) ?>"
            ></button>
        <?php endif; ?>
    </header>

    <div class="w-drawer__body">
        <?php if (filter_var($flush ?? false, FILTER_VALIDATE_BOOLEAN) || filter_var($save ?? false, FILTER_VALIDATE_BOOLEAN)): ?>
            <div class="w-toolbar w-remote-drawer__toolbar">
                <?php if (filter_var($flush ?? false, FILTER_VALIDATE_BOOLEAN)): ?>
                    <button type="button" class="w-button" data-tone="<?= $escape($flush_tone) ?>" data-w-remote-action="reload">
                        <w:icon name="refresh" size="sm"></w:icon>
                        <?= $escape(__($flush_button_text ?? '刷新')) ?>
                    </button>
                <?php endif; ?>
                <?php if (filter_var($save ?? false, FILTER_VALIDATE_BOOLEAN)): ?>
                    <button type="button" class="w-button" data-tone="<?= $escape($submit_tone) ?>" data-w-remote-action="submit">
                        <w:icon name="save" size="sm"></w:icon>
                        <?= $escape(__($submit_button_text ?? '保存')) ?>
                    </button>
                <?php endif; ?>
            </div>
        <?php endif; ?>
        <iframe
            class="w-remote-drawer__frame"
            data-w-remote-frame
            data-src="<?= $escape($action) ?>"
            title="<?= $escape($title ?? __('抽屉内容')) ?>"
        ></iframe>
    </div>
</section>
