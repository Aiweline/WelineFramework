<div class="w-container">
    <nav class='navbar navbar-light navbar-expand-lg topnav-menu'>
        <div class="w-disclosure__panel navbar-collapse" id='topnav-menu-content' data-w-disclosure-panel hidden>
            <ul class='navbar-nav'>
                <!--循环条件-->
                <foreach name='sorts' item='sort'>
                    <li class="@if{sort.target=>"active"}">
                        <a href='{{sort.href}}'>{{sort.name}}{{sort.icon}}</a>
                    </li>
                </foreach>
            </ul>
            <a href='{{action}}' data-tag='{{sort.tag.sort}}'>
                <lang>清空条件</lang>
            </a>
        </div>
    </nav>
</div>