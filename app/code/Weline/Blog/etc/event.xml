<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Theme::layout_resolve">
        <observer name="Weline_Blog::layout_resolve"
                  instance="Weline\Blog\Observer\LayoutResolveObserver"
                  disabled="false"
                  shared="true"
                  sort="30"/>
    </event>
    <event name="Weline_Framework_Router::process_uri_before">
        <observer name="Weline_Blog::claim_blog_namespace_uri_before"
                  instance="Weline\Blog\Observer\ClaimBlogNamespaceUriBefore"
                  disabled="false"
                  shared="true"
                  sort="-16"/>
    </event>
    <event name="Weline_Cms::page_save_after">
        <observer name="Weline_Blog::cms_blog_page_seo_sync"
                  instance="Weline\Blog\Observer\CmsBlogPageSeoSyncObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Cms::page_delete_after">
        <observer name="Weline_Blog::cms_blog_page_seo_delete"
                  instance="Weline\Blog\Observer\CmsBlogPageSeoSyncObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Blog::post_search_index_changed">
        <observer name="Weline_Blog::post_search_index_sync"
                  instance="Weline\Blog\Observer\BlogPostSearchIndexObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
</config>
