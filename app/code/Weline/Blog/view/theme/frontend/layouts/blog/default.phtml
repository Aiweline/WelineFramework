/**
 * Layout: blog/default — Weline-style blog article detail.
 *
 * @meta.name {default="博客详情页布局",name="博客详情页布局",description="亚马逊风格博客文章详情布局"}
 * @meta.description {default="包含面包屑、文章正文与相关推荐的可部件化布局",name="描述",description="博客文章详情页布局"}
 * @param.title {default="博客文章",name="页面标题",description="页面标题"}
 * @param.content {default="",name="文章内容",description="文章内容 HTML"}
 * @param.showHeader {default=true,name="是否显示header",description="是否显示顶栏"}
 * @param.showFooter {default=true,name="是否显示footer",description="是否显示底栏"}
 * @param.showBreadcrumb {default=true,name="是否显示面包屑",description="是否显示主题面包屑"}
 * @param.showReviews {default=true,name="是否显示评论容器",description="是否显示博客评论容器槽（由评论模块 default_injections 注入）"}
 * @param.class {default="",name="额外CSS类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$coerceBool = static function (mixed $value, bool $default): bool {
    if ($value === null) {
        return $default;
    }
    if (is_bool($value)) {
        return $value;
    }
    if (is_int($value) || is_float($value)) {
        return ((int)$value) !== 0;
    }
    $normalized = strtolower(trim((string)$value));
    if ($normalized === '' || $normalized === 'default') {
        return $default;
    }
    if (in_array($normalized, ['1', 'true', 'yes', 'on'], true)) {
        return true;
    }
    if (in_array($normalized, ['0', 'false', 'no', 'off'], true)) {
        return false;
    }
    return $default;
};
$showReviews = $coerceBool($meta['showReviews'] ?? $this->getData('showReviews'), true);
$meta['showReviews'] = $showReviews;
$this->assign('meta', $meta);
?>
