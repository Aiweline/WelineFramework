<?php
/**
 * Layout: blog_category/default — Amazon-style blog list / category page.
 *
 * @meta.name {default="博客分类页布局",name="博客分类页布局",description="亚马逊风格博客列表与分类布局"}
 * @meta.description {default="左侧分类筛选 + 右侧文章卡片网格",name="描述",description="博客列表/分类页布局"}
 * @param.title {default="博客",name="页面标题",description="页面标题"}
 * @param.content {default="",name="列表内容",description="列表内容 HTML"}
 * @param showHeader {default=true,name="是否显示header",description="是否显示顶栏"}
 * @param showFooter {default=true,name="是否显示footer",description="是否显示底栏"}
 * @param showFilters {default=true,name="是否显示分类筛选",description="是否显示左侧分类筛选"}
 * @param.class {default="",name="额外CSS类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$showFilters = ($meta['showFilters'] ?? $this->getData('showFilters') ?? true);
$showFilters = !in_array($showFilters, [false, 0, '0', 'false', 'off'], true);
$categories = $this->getData('blog_categories') ?? [];
$categories = is_array($categories) ? $categories : [];
$activeCategoryId = (int)($this->getData('blog_active_category_id') ?? 0);
$bodyClass = 'blog-category-layout__body' . ($showFilters ? ' blog-category-layout__body--with-sidebar' : '');
?>
