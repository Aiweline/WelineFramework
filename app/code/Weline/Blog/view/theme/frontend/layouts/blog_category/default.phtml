    <div class="weline-page-wrapper blog-category-layout">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::blog_category::header-before</w:hook>
