 * @param.rss_label_category {default="订阅本分类 RSS",name="分类RSS标签",description="分类页的 RSS 订阅标签；后台可按语言改写",translatable=1}
 * @param.list_title {default="文章列表",name="列表区标题",description="文章网格区标题；后台可按语言改写",translatable=1}
 * @param.total_label {default="共 %{1} 条",name="总数标签",description="文章总数标签，%{1}=数量；后台可按语言改写",translatable=1}
 * @param.empty_text {default="暂无文章",name="空态文案",description="无文章时的提示；后台可按语言改写",translatable=1}
 * @param.back_link {default="返回博客",name="返回链接文案",description="空态下返回列表的链接文案；后台可按语言改写",translatable=1}
