            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
        <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
        <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>

        <div class="weline-main-content">
            <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::blog_category::content-before</w:hook>

            <main class="blog-category-layout__shell <?= htmlspecialchars((string)($meta['class'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                  id="main-content"
                  data-layout="blog_category">
                <w:hook>Weline_Theme::frontend::layouts::blog_category::main-before</w:hook>
                <w:slot id="content"
                        name="内容区"
                        accept="layout-blog-category-content,layout-default-content,content,blog-filters,blog-results"
                        reject="header,footer"
                        multiple="true"
                        position="content">
                    <div class="<?= htmlspecialchars($bodyClass, ENT_QUOTES, 'UTF-8') ?>">
                        <aside class="blog-category-layout__filters" aria-label="<?= htmlspecialchars((string)__('博客分类'), ENT_QUOTES, 'UTF-8') ?>">
                            <?php if ($showFilters): ?>
                                <?php
                                echo $this->fetch('Weline_Blog::templates/frontend/partials/category-filter.phtml', [
                                    'blog_categories' => $categories,
                                    'blog_active_category_id' => $activeCategoryId,
                                ]);
                                ?>
                            <?php endif; ?>
                            <w:slot id="blog-filters"
                                    name="分类筛选区"
                                    accept="layout-blog-filters,blog-filters"
                                    multiple="true"
                                    position="sidebar">
                                <w:hook>Weline_Theme::frontend::layouts::blog_category::filters</w:hook>
                            </w:slot>
                        </aside>

                        <section class="blog-category-layout__results" weline-code="theme.blog_category.results">
                            <w:slot id="blog-results"
                                    name="文章列表区"
                                    accept="layout-blog-results,blog-results,content"
                                    multiple="true"
                                    position="content">
                                <if condition="meta.content">
                                    {{meta.content}}
                                <elseif condition="content"/>
                                    {{content}}
                                <elseif condition="meta.contentTemplate"/>
                                    <?php echo $this->fetch($this->getData('meta.contentTemplate')); ?>
                                <elseif condition="contentTemplate"/>
                                    <?php echo $this->fetch($this->getData('contentTemplate')); ?>
                                <else/>
                                    <w:hook>Weline_Theme::frontend::layouts::blog_category::results</w:hook>
                                </if>
                            </w:slot>
                        </section>
                    </div>
                </w:slot>
                <w:hook>Weline_Theme::frontend::layouts::blog_category::main-after</w:hook>
            </main>

            <w:hook>Weline_Theme::frontend::layouts::blog_category::content-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
        </div>


        <w:slot id="blog-category-bottom"
                name="博客分类底部扩展"
                accept="layout-blog-category-bottom,banner,promo-banner,content,container,product,category,carousel,trust-badges"
                reject="header,footer,navigation"
                multiple="true"
                append="true"
                position="content"
                class="blog-category-bottom-slot">
