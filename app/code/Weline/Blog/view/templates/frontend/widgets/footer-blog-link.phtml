<?php
/**
 * 页脚「了解我们」扩展：博客入口链接。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-blog-link}
 * @widget.name {页脚博客链接}
 * @widget.description {页脚了解我们扩展槽：博客列表入口；默认注入 footer-about-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-about-links}
 * @widget.supports {["footer-blog-link","layout-footer-about-links"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer-about-links", "area":"footer", "sort_order":0, "required":true, "reason":"页脚了解我们默认展示博客入口", "config":{"label":"博客"} }]}
 *
 * @param label {default="博客",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-blog-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '博客';
$label = WidgetI18n::label($labelSource, '博客');
?>
<a class="footer-about-link footer-blog-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-blog-link"
   href="@url{'blog'}"><?= $esc($label) ?></a>
