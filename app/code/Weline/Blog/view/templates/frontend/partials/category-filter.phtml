<?php
/**
 * Blog category sidebar filter (Amazon-style left nav) — expandable 2-level tree.
 *
 * @var list<array<string,mixed>> $blog_categories
 * @var int $blog_active_category_id
 */
$categories = is_array($blog_categories ?? null) ? $blog_categories : [];
$activeId = (int)($blog_active_category_id ?? 0);
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$template = $this;
$buildUrl = static function (string $path) use ($template): string {
    $path = trim($path);
    if ($path === '') {
        return '';
    }
    if (preg_match('#^(?:https?:)?//#i', $path) === 1) {
        return $path;
    }

    return (string)$template->getUrl(ltrim($path, '/'));
};

$containsId = static function (array $nodes, int $id) use (&$containsId): bool {
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        if ((int)($node['category_id'] ?? 0) === $id) {
            return true;
        }
        $children = is_array($node['children'] ?? null)
            ? $node['children']
            : (is_array($node['nodes'] ?? null) ? $node['nodes'] : []);
        if ($children !== [] && $containsId($children, $id)) {
            return true;
        }
    }

    return false;
};

$renderNodes = static function (
    array $nodes,
    int $activeId,
    int $depth,
    callable $escape,
    callable $containsId,
    callable $buildUrl,
) use (&$renderNodes): void {
    foreach ($nodes as $category) {
        if (!is_array($category)) {
            continue;
        }
        $id = (int)($category['category_id'] ?? 0);
        $label = trim((string)($category['name'] ?? ''));
        $url = $buildUrl(trim((string)($category['url'] ?? '')));
        if ($id <= 0 || $label === '' || $url === '') {
            continue;
        }
        $children = is_array($category['children'] ?? null)
            ? $category['children']
            : (is_array($category['nodes'] ?? null) ? $category['nodes'] : []);
        $hasChildren = $children !== [];
        $isActive = $id === $activeId;
        $isAncestor = $hasChildren && $activeId > 0 && $containsId($children, $activeId);
        $isOpen = $isActive || $isAncestor;
        $itemId = 'blog-cat-node-' . $id;
        ?>
        <li class="amazon-blog-filter__node<?= $hasChildren ? ' has-children' : '' ?><?= $isOpen ? ' is-open' : '' ?>"
            data-blog-filter-node
            data-state="<?= $isOpen ? 'open' : 'closed' ?>">
            <div class="amazon-blog-filter__row">
                <?php if ($hasChildren): ?>
                    <button type="button"
                            class="amazon-blog-filter__toggle"
                            data-blog-filter-toggle
                            aria-expanded="<?= $isOpen ? 'true' : 'false' ?>"
                            aria-controls="<?= $escape($itemId) ?>"
                            title="<?= $escape((string)__('展开/收起')) ?>">
                        <span class="amazon-blog-filter__toggle-icon" aria-hidden="true"></span>
                    </button>
                <?php else: ?>
                    <span class="amazon-blog-filter__toggle-spacer" aria-hidden="true"></span>
                <?php endif; ?>
                <a class="amazon-blog-filter__option<?= $isActive ? ' is-active' : '' ?>"
                   href="<?= $escape($url) ?>"
                   <?= $isActive ? 'aria-current="page"' : '' ?>>
                    <?= $escape($label) ?>
                </a>
            </div>
            <?php if ($hasChildren): ?>
                <div class="amazon-blog-filter__children"
                     id="<?= $escape($itemId) ?>"
                     data-blog-filter-children
                     <?= $isOpen ? '' : 'hidden' ?>>
                    <ul class="amazon-blog-filter__list amazon-blog-filter__list--nested" role="list">
                        <?php $renderNodes($children, $activeId, $depth + 1, $escape, $containsId, $buildUrl); ?>
                    </ul>
                </div>
            <?php endif; ?>
        </li>
        <?php
    }
};
?>
<div class="amazon-blog-filter"
     data-testid="blog-category-filter"
     data-blog-category-filter>
    <?php /* Non-heading label: must not precede page H1 in the SEO outline. */ ?>
    <p class="amazon-blog-filter__title"><lang>博客分类</lang></p>
    <ul class="amazon-blog-filter__list" role="list">
        <li>
            <a class="amazon-blog-filter__option<?= $activeId <= 0 ? ' is-active' : '' ?>"
               href="@url{'blog'}"
               <?= $activeId <= 0 ? 'aria-current="page"' : '' ?>>
                <lang>全部文章</lang>
            </a>
        </li>
        <?php $renderNodes($categories, $activeId, 1, $escape, $containsId, $buildUrl); ?>
    </ul>
</div>
<script>
(function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.getAttribute || root.getAttribute('data-blog-category-filter') === null) {
        root = document.querySelector('[data-blog-category-filter]');
    }
    if (!root) return;
    root.addEventListener('click', function (event) {
        var toggle = event.target && event.target.closest ? event.target.closest('[data-blog-filter-toggle]') : null;
        if (!toggle || !root.contains(toggle)) return;
        event.preventDefault();
        var node = toggle.closest('[data-blog-filter-node]');
        if (!node) return;
        var children = node.querySelector('[data-blog-filter-children]');
        var open = node.getAttribute('data-state') !== 'open';
        node.setAttribute('data-state', open ? 'open' : 'closed');
        node.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (children) {
            if (open) children.removeAttribute('hidden');
            else children.setAttribute('hidden', '');
        }
    });
})();
</script>
