                    <label class="w-field__label" for="blog-search"><lang>搜索</lang></label>
                    <input class="w-input" id="blog-search" name="search" type="search"
                           value="<?= $escape($currentSearch) ?>" placeholder="@lang(标题 / slug / 作者)">
                </div>
                <div class="w-blog-post-admin__filter-actions">
                    <button class="w-button" type="submit" data-tone="primary"><lang>搜索</lang></button>
                    <?php if ($currentStatus !== '' || $currentLocale !== '' || $currentSearch !== '' || (string)($website_id_filter ?? '') !== ''): ?>
                        <a class="w-button" data-tone="neutral" data-variant="outline"
                           href="@url{'blog/backend/post-admin/index'}"><lang>重置</lang></a>
                    <?php endif; ?>
                </div>
