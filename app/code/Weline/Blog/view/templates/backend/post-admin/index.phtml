<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var list<array<string,mixed>> $table_rows
 * @var string $row_actions_json
 * @var array<string,mixed> $pagination
 * @var int $total
 * @var string $status_filter
 * @var string $locale_filter
 * @var string $search_filter
 * @var string $website_id_filter
 * @var list<string> $allowed_statuses
 * @var array<string,string> $status_labels
 * @var string $websiteSelectValue
 * @var string $websiteSelectDisplay
 * @var string $websiteSelectOptionsJson
 * @var string $catalog_category_url
 * @var string $blogLocaleEmptyText
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : (string)json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$tableRows = is_array($table_rows ?? null) ? $table_rows : [];
$rowActionsJson = (string)($row_actions_json ?? '[]');
$currentStatus = (string)($status_filter ?? '');
$currentLocale = (string)($locale_filter ?? '');
$currentSearch = (string)($search_filter ?? '');
$statusLabels = is_array($status_labels ?? null) ? $status_labels : [];
$totalText = $escape($total ?? 0);
$currentPage = max(1, (int)($pagination['page'] ?? 1));
$totalPages = max(1, (int)($pagination['lastPage'] ?? 1));

$filterQuery = [];
if ($currentStatus !== '') {
    $filterQuery['status'] = $currentStatus;
}
if ($currentLocale !== '') {
    $filterQuery['locale'] = $currentLocale;
}
if ($currentSearch !== '') {
    $filterQuery['search'] = $currentSearch;
}
if ((string)($website_id_filter ?? '') !== '') {
    $filterQuery['website_id'] = (string)$website_id_filter;
}
$filterQueryBase = $filterQuery === [] ? '?' : ('?' . http_build_query($filterQuery) . '&');

$statusOptionsHtml = '<option value=""' . ($currentStatus === '' ? ' selected' : '') . '>'
    . $escape(__('全部状态')) . '</option>';
foreach (($allowed_statuses ?? []) as $statusOption) {
    $statusOption = (string)$statusOption;
    $statusOptionsHtml .= '<option value="' . $escape($statusOption) . '"'
        . ($currentStatus === $statusOption ? ' selected' : '') . '>'
        . $escape($statusLabels[$statusOption] ?? $statusOption) . '</option>';
}

$paginationHtml = '';
if ($totalPages > 1) {
    $paginationHtml = '<nav class="w-blog-post-admin__pagination" aria-label="' . $escape(__('文章分页')) . '">';
    if ($currentPage > 1) {
        $paginationHtml .= '<a class="w-button" data-tone="neutral" data-variant="outline" href="'
            . $escape($filterQueryBase . 'page=' . ($currentPage - 1)) . '">' . $escape(__('上一页')) . '</a>';
    }
    $paginationHtml .= '<span class="w-text" data-tone="muted" data-size="sm">'
        . $escape(__('第 %{1} / %{2} 页', [$currentPage, $totalPages])) . '</span>';
    if ($currentPage < $totalPages) {
        $paginationHtml .= '<a class="w-button" data-tone="neutral" data-variant="outline" href="'
            . $escape($filterQueryBase . 'page=' . ($currentPage + 1)) . '">' . $escape(__('下一页')) . '</a>';
    }
    $paginationHtml .= '</nav>';
}
?>
