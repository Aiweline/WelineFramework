                <w:field belong="t-header" name="meta_cluster" type="text" width="12rem"><lang>语言 / 分类 / 状态</lang></w:field>
                <w:field belong="t-header" name="updated_at" type="text" width="11rem" sortable="true"><lang>更新时间</lang></w:field>
            </w:t-header>
