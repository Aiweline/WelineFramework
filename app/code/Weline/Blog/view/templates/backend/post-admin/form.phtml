<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array<string,mixed> $postRow
 * @var int $post_id
 * @var string $postLocale
 * @var string $coverImageValue
 * @var list<string> $statuses
 * @var array<string,string> $status_labels
 * @var list<array<string,mixed>> $categories
 * @var string $websiteSelectValue
 * @var string $websiteSelectDisplay
 * @var string $websiteSelectOptionsJson
 * @var bool $cms_available
 * @var int $cms_page_id
 * @var string $theme_editor_url
 * @var string $preview_url
 * @var string $list_url
 * @var string $suggest_slug_url
 */
$postRow = is_array($this->getData('post') ?? null) ? $this->getData('post') : [];
$postId = (int)($post_id ?? (int)($postRow['post_id'] ?? 0));
$statuses = is_array($this->getData('statuses') ?? null) ? $this->getData('statuses') : [];
$categories = is_array($this->getData('categories') ?? null) ? $this->getData('categories') : [];
$statusLabels = is_array($status_labels ?? null) ? $status_labels : [];
$currentLocale = (string)($postLocale ?? 'zh_Hans_CN');
$coverImageValue = (string)($coverImageValue ?? '');
$themeEditorUrl = (string)($theme_editor_url ?? '');
$previewUrl = (string)($preview_url ?? '');
$listUrl = (string)($list_url ?? '');
$suggestSlugUrl = (string)($suggest_slug_url ?? '');
$cmsAvailable = (bool)($cms_available ?? false);
$hasEditor = $themeEditorUrl !== '';
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : (string)json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$slugMode = trim((string)($postRow['slug_mode'] ?? ''));
if ($slugMode === '') {
    $slugMode = 'auto';
}
$formTitle = $postId > 0 ? (string)__('编辑文章') : (string)__('新建文章');
$formSubtitle = $postId > 0
    ? (string)__('调整元信息、封面与发布状态，正文在下方 Theme 编辑器中维护')
    : (string)__('先保存文章设置，再进入 Theme 可视化编辑正文');
$currentStatus = (string)($postRow['status'] ?? '');
$currentStatusLabel = $statusLabels[$currentStatus] ?? $currentStatus;
$coverPanelClass = $coverImageValue !== '' ? 'has-cover' : 'is-empty';
$hasTitle = trim((string)($postRow['title'] ?? '')) !== '';
$coverPreviewUrl = '';
if ($coverImageValue !== '') {
  $lower = strtolower($coverImageValue);
  if (str_starts_with($lower, 'https://') || str_starts_with($lower, 'http://') || str_starts_with($lower, 'data:image/')) {
      $coverPreviewUrl = $coverImageValue;
  } elseif (!str_contains($coverImageValue, '..') && !str_contains($coverImageValue, '\\') && !str_contains($coverImageValue, '://')) {
      $resolved = \Weline\FileManager\Api\Image::pathToMediaUrl($coverImageValue, 240, 240);
      $coverPreviewUrl = is_string($resolved) ? $resolved : '';
  }
}
