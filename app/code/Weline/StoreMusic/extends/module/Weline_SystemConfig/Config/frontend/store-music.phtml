<w:config:group code="store_music_general" label="基础设置" description="控制前台是否展示进店音乐浮层。" sort="10">
    <w:config:field
        key="store_music/general/enabled"
        label="启用进店音乐"
        description="关闭后前台不再展示进店音乐浮层；需同时配置曲目才会显示。默认关闭。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global,website,store"
    />
</w:config:group>

<w:config:group code="store_music_music" label="进店音乐" description="进店 BGM 与延迟播放策略。" sort="20">
    <w:config:field
        key="store_music/music/playlist"
        label="播放列表 JSON"
        description="JSON 歌单：[{url,title,intro},…]。推荐在「进店音乐」业务页用媒体库多选并填写简介。"
        type="textarea"
        value-type="string"
        default="[]"
        scope="global,website,store"
    />
    <w:config:field
        key="store_music/music/track"
        label="首曲 URL"
        description="与歌单同步的首曲媒体路径；有 playlist 时以前者为准。业务页媒体库会自动维护。"
        type="text"
        value-type="string"
        default=""
        scope="global,website,store"
        ext="mp3,wav,ogg,oga,m4a,aac,flac,opus,wma,weba"
    />
    <w:config:field
        key="store_music/music/delay_seconds"
        label="延迟秒数"
        description="页面 load 完成后再等待的秒数（1–15），然后再尝试加载/播放。"
        type="number"
        value-type="int"
        default="3"
        scope="global,website,store"
        validation="min:1|max:15"
    />
    <w:config:field
        key="store_music/music/try_autoplay"
        label="尝试自动播放"
        description="延迟后尝试自动出声；浏览器拦截时浮层提示点击播放。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website,store"
    />
    <w:config:field
        key="store_music/music/loop"
        label="循环播放"
        description="单曲或歌单循环。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website,store"
    />
    <w:config:field
        key="store_music/music/default_volume"
        label="默认音量"
        description="0–100。进店氛围请保持轻声（建议 6–10，默认 8）。"
        type="number"
        value-type="int"
        default="8"
        scope="global,website,store"
        validation="min:0|max:100"
    />
</w:config:group>

<w:config:group code="store_music_visual" label="视觉氛围" description="头像动效与全页波形默认状态（访客可在浮层上开关波形）。" sort="30">
    <w:config:field
        key="store_music/visual/avatar_spin"
        label="播放时旋转头像"
        description="开启后播放中头像匀速旋转；默认关闭。关闭时使用边缘向外脉冲，播放强度驱动波浪。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global,website,store"
    />
    <w:config:field
        key="store_music/visual/waveform_default"
        label="默认开启波形背景"
        description="开启后访客首次进入默认打开全页波形；仍可在浮层上关闭。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global,website,store"
    />
</w:config:group>
