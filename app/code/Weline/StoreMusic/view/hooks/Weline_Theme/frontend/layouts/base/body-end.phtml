<?php
/**
 * StoreMusic: simple floating portrait player — entrance music (进店音乐).
 *
 * Hook: Weline_Theme::frontend::layouts::base::body-end
 *
 * @hook-priority 190
 * @hook-sort-order 8
 * @hook-solo false
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\StoreMusic\Service\StoreMusicSettings;

$requestPathRaw = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$requestPathParsed = parse_url($requestPathRaw, PHP_URL_PATH);
$requestPath = strtolower((string)(is_string($requestPathParsed) && $requestPathParsed !== '' ? $requestPathParsed : $requestPathRaw));
$isAccountRoute = $requestPath === '/customer/account'
    || $requestPath === 'customer/account'
    || str_contains($requestPath, '/customer/account/');
$isWorkspacePreview = (string)$this->request->getGet('visual_editor', '') === '1'
    || (string)$this->request->getGet('preview', '') === '1'
    || str_contains($requestPath, 'workspace-preview');
$isBackend = str_contains($requestPath, '/admin');
if ($isAccountRoute || $isWorkspacePreview || $isBackend) {
    return;
}

/** @var StoreMusicSettings $settings */
$settings = ObjectManager::getInstance(StoreMusicSettings::class);
if (!$settings->isWidgetActive()) {
    return;
}

$payload = $settings->frontendPayload();
$websiteId = '0';
$storeId = '0';
try {
    if (class_exists(\Weline\Framework\Runtime\RequestContext::class)) {
        $websiteId = (string)\Weline\Framework\Runtime\RequestContext::getWelineWebsiteId();
        $storeId = (string)\Weline\Framework\Runtime\RequestContext::getWelineStoreId();
    }
} catch (\Throwable) {
    // Soft: ids only affect localStorage key names.
}

$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$configJson = $esc((string)json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
$defaultVol = (int)$payload['default_volume'];
?>
