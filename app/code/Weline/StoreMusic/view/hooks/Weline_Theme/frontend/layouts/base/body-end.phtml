        aria-hidden="true"></canvas>
<aside id="weline-store-music"
       class="w-store-music w-store-music--simple"
       data-store-music
       data-weline-load="storeMusic"
       data-store-music-config="<?= $configJson ?>"
       data-website-id="<?= $esc($websiteId) ?>"
       data-store-id="<?= $esc($storeId) ?>"
