<?php
/**
 * StoreMusic: floating entrance music (进店音乐).
 *
 * Hook: Weline_Theme::frontend::layouts::base::body-end
 * Prefer layout placement when present; Hook covers pages without the widget.
 * Same rule on storefront and editor/preview — never preview-only discard.
 *
 * @hook-priority 190
 * @hook-sort-order 8
 * @hook-solo false
 */

use Weline\StoreMusic\Service\StoreMusicLayoutPresence;

$requestPathRaw = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$requestPathParsed = parse_url($requestPathRaw, PHP_URL_PATH);
$requestPath = strtolower((string)(is_string($requestPathParsed) && $requestPathParsed !== '' ? $requestPathParsed : $requestPathRaw));
$isAccountRoute = $requestPath === '/customer/account'
    || $requestPath === 'customer/account'
    || str_contains($requestPath, '/customer/account/');
$isBackend = str_contains($requestPath, '/admin');
if ($isAccountRoute || $isBackend) {
    return;
}

// Layout already places store-music → Hook yields (widget owns the float).
// Applies equally to storefront publish and theme-preview/editor drafts.
if (StoreMusicLayoutPresence::layoutPlacesWidget($this->request)) {
    return;
}

// Use BP — compiled hook tpl changes its directory and would break a relative include.
include BP . '/app/code/Weline/StoreMusic/view/templates/frontend/widgets/store-music.phtml';
