<script>
(function () {
    var root = document.querySelector('[data-store-music-config]');
    if (!root) {
        return;
    }
    var scopeRoot = document.getElementById('store-music-config-scope');
    if (scopeRoot) {
        var field = scopeRoot.querySelector('input[type="hidden"][name="target_scope"]')
            || scopeRoot.querySelector('input[name="target_scope"]');
        if (field) {
            field.addEventListener('change', function () {
                var next = String(field.value || '').trim();
                if (!next) {
                    return;
                }
                var url = new URL(window.location.href);
                url.searchParams.set('target_scope', next);
                var parts = next.split('.');
                url.searchParams.set('website_code', parts[0] && parts[0] !== 'default' ? parts[0] : '');
                url.searchParams.set('store_code', parts[1] && parts[1] !== 'default' ? parts[1] : '');
                url.searchParams.set('channel_code', parts[2] && parts[2] !== 'default' ? parts[2] : '');
                window.location.assign(url.toString());
            });
        }
    }

    function toast(type, message) {
        var ui = window.Weline && window.Weline.UI && window.Weline.UI.toast;
        if (ui && typeof ui[type] === 'function') {
            ui[type](message);
            return;
        }
        if (typeof console !== 'undefined' && console.log) {
            console.log('[store-music-config]', message);
        }
    }

    function titleFromUrl(url) {
        try {
            var path = String(url || '').split('?')[0];
            var base = path.split('/').pop() || '';
            base = decodeURIComponent(base);
            base = base.replace(/\.[a-z0-9]{2,5}$/i, '');
            base = base.replace(/[_+]+/g, ' ').trim();
            return base || '进店音乐';
        } catch (e) {
            return '进店音乐';
        }
    }

    function normalizeUrl(value) {
        var v = String(value || '').trim();
        if (!v) return '';
        if (/^https?:\/\//i.test(v)) return v;
        v = v.replace(/\\/g, '/').replace(/^\/+/, '');
        if (v.indexOf('pub/media/') === 0) v = v.slice('pub/media/'.length);
        if (v.indexOf('media/') === 0) return '/' + v;
        return '/media/' + v.replace(/^\/+/, '');
    }

    function parseIntroMap(raw) {
        if (!raw) return {};
        if (typeof raw === 'object' && !Array.isArray(raw)) {
            return Object.assign({}, raw);
        }
        try {
            var parsed = JSON.parse(String(raw));
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                return parsed;
            }
        } catch (e) {
            var text = String(raw || '').trim();
            if (text) {
                return { default: text };
            }
        }
        return {};
    }

    function normalizeIntroMap(map) {
        var out = {};
        if (!map || typeof map !== 'object') {
            return out;
        }
        Object.keys(map).forEach(function (locale) {
            var code = String(locale || '').trim();
            var text = String(map[locale] || '').trim().slice(0, 500);
            if (code && text) {
                out[code] = text;
            }
        });
        return out;
    }

    function getEditLocale() {
        var input = document.getElementById('store-music-intro-edit-locale');
        var locale = input ? String(input.value || '').trim() : '';
        if (!locale) {
            locale = String(root.dataset.introEditLocale || '').trim();
        }
        return locale || 'zh_Hans_CN';
    }

    function flushIntroFromRow(row) {
        var locale = getEditLocale();
        var introEl = row.querySelector('[data-store-music-track-intro]');
        var map = parseIntroMap(row.getAttribute('data-intro-i18n'));
        var text = introEl ? String(introEl.value || '').trim().slice(0, 500) : '';
        if (locale) {
            if (text) {
                map[locale] = text;
            } else {
                delete map[locale];
            }
        }
        map = normalizeIntroMap(map);
        row.setAttribute('data-intro-i18n', JSON.stringify(map));
        return map;
    }

    function fillIntroForLocale(row, locale) {
        var map = parseIntroMap(row.getAttribute('data-intro-i18n'));
        var introEl = row.querySelector('[data-store-music-track-intro]');
        if (introEl) {
            introEl.value = map[locale] || '';
        }
    }

    function flushAllIntros() {
        root.querySelectorAll('[data-store-music-playlist-row]').forEach(function (row) {
            flushIntroFromRow(row);
        });
    }

    function readPreviousByUrl() {
        flushAllIntros();
        var map = {};
        root.querySelectorAll('[data-store-music-playlist-row]').forEach(function (row) {
            var url = normalizeUrl(row.dataset.url || '');
            if (!url) return;
            var titleEl = row.querySelector('[data-store-music-track-title]');
            map[url] = {
                url: url,
                title: titleEl ? String(titleEl.value || '').trim() : '',
                intro: parseIntroMap(row.getAttribute('data-intro-i18n'))
            };
        });
        return map;
    }

    function collectTracksFromEditor() {
        flushAllIntros();
        var tracks = [];
        root.querySelectorAll('[data-store-music-playlist-row]').forEach(function (row) {
            var url = normalizeUrl(row.dataset.url || '');
            if (!url) return;
            var titleEl = row.querySelector('[data-store-music-track-title]');
            var title = titleEl ? String(titleEl.value || '').trim() : '';
            tracks.push({
                url: url,
                title: title || titleFromUrl(url),
                intro: normalizeIntroMap(parseIntroMap(row.getAttribute('data-intro-i18n')))
            });
        });
        return tracks;
    }

    function rebuildEditor(tracks) {
        var editor = root.querySelector('[data-store-music-playlist-editor]');
        if (!editor) return;
        editor.innerHTML = '';
        if (!tracks.length) {
            var empty = document.createElement('p');
            empty.className = 'w-text';
            empty.dataset.tone = 'muted';
            empty.dataset.size = 'sm';
            empty.style.setProperty('--w-m', '0');
            empty.setAttribute('data-store-music-playlist-empty', '1');
            empty.textContent = '尚未选择曲目。请用上方媒体库添加多首进店音乐。';
            editor.appendChild(empty);
            return;
        }
        var locale = getEditLocale();
        tracks.forEach(function (track) {
            var introMap = normalizeIntroMap(
                typeof track.intro === 'object' ? track.intro : parseIntroMap(track.intro || '')
            );
            var row = document.createElement('div');
            row.className = 'w-stack store-music-playlist-row';
            row.style.setProperty('--w-gap', 'var(--weline-space-2)');
            row.style.padding = 'var(--weline-space-3)';
            row.style.border = '1px solid var(--color-border, rgba(0,0,0,.12))';
            row.style.borderRadius = 'var(--weline-radius-md, 8px)';
            row.setAttribute('data-store-music-playlist-row', '1');
            row.setAttribute('data-w-reorder-item', '');
            row.dataset.url = track.url;
            row.setAttribute('data-intro-i18n', JSON.stringify(introMap));

            var head = document.createElement('div');
            head.className = 'w-cluster';
            head.dataset.align = 'center';
            head.dataset.justify = 'between';
            head.style.setProperty('--w-gap', 'var(--weline-space-2)');

            var handle = document.createElement('button');
            handle.type = 'button';
            handle.className = 'w-button';
            handle.dataset.tone = 'neutral';
            handle.dataset.variant = 'ghost';
            handle.dataset.size = 'sm';
            handle.setAttribute('data-w-reorder-handle', '');
            handle.setAttribute('aria-label', '拖拽排序');
            handle.textContent = '拖拽排序';

            var urlLine = document.createElement('div');
            urlLine.className = 'w-text';
            urlLine.dataset.size = 'sm';
            urlLine.dataset.tone = 'muted';
            urlLine.style.setProperty('--w-m', '0');
            urlLine.style.wordBreak = 'break-all';
            urlLine.style.flex = '1';
            urlLine.textContent = track.url;

            head.appendChild(handle);
            head.appendChild(urlLine);

            var titleField = document.createElement('div');
            titleField.className = 'w-field';
            titleField.innerHTML = '<label class="w-field__label">曲名</label><div class="w-field__control"></div>';
            var titleInput = document.createElement('input');
            titleInput.className = 'w-input';
            titleInput.type = 'text';
            titleInput.setAttribute('data-store-music-track-title', '1');
            titleInput.maxLength = 120;
            titleInput.dataset.size = 'sm';
            titleInput.value = track.title || titleFromUrl(track.url);
            titleField.querySelector('.w-field__control').appendChild(titleInput);

            var introField = document.createElement('div');
            introField.className = 'w-field';
            introField.innerHTML = '<label class="w-field__label">简介</label><div class="w-field__control"></div>';
            var introInput = document.createElement('textarea');
            introInput.className = 'w-input';
            introInput.setAttribute('data-store-music-track-intro', '1');
            introInput.rows = 2;
            introInput.maxLength = 500;
            introInput.placeholder = '播放时展示给访客的短简介';
            introInput.value = introMap[locale] || '';
            introField.querySelector('.w-field__control').appendChild(introInput);

            row.appendChild(head);
            row.appendChild(titleField);
            row.appendChild(introField);
            editor.appendChild(row);
        });
    }

    function grantVersion() {
        var embed = document.querySelector('.w-config-embed[data-module="' + root.dataset.module + '"]')
            || document.querySelector('.w-config-embed');
        return embed && embed.dataset.grantVersion ? String(embed.dataset.grantVersion) : '1';
    }

    function resolveApi() {
        if (window.Weline && typeof Weline.load === 'function') {
            return Weline.load('api');
        }
        if (window.Weline && Weline.Api && typeof Weline.Api.resource === 'function') {
            return Promise.resolve(Weline.Api);
        }
        return Promise.reject(new Error('Weline.Api unavailable'));
    }

    var saveTimer = null;
    var saving = false;
    var pendingSave = false;

    function scheduleSave(delay) {
        if (saveTimer) {
            clearTimeout(saveTimer);
        }
        saveTimer = setTimeout(function () {
            saveTimer = null;
            savePlaylist();
        }, typeof delay === 'number' ? delay : 400);
    }

    function savePlaylist() {
        var playlistInput = root.querySelector('[data-store-music-playlist-input]');
        var mediaInput = root.querySelector('[data-store-music-media-input]');
        if (!playlistInput) {
            return;
        }
        var tracks = collectTracksFromEditor();
        var nextJson = JSON.stringify(tracks);
        var previous = String(playlistInput.dataset.lastValue || '');
        if (previous === nextJson) {
            return;
        }
        if (saving) {
            pendingSave = true;
            return;
        }
        saving = true;
        var firstUrl = tracks.length ? tracks[0].url : '';
        resolveApi().then(function (api) {
            return Promise.resolve(api.resource('system_config')).then(function (sc) {
                var base = {
                    module: root.dataset.module,
                    area: root.dataset.area,
                    target_scope: root.dataset.targetScope,
                    locale: root.dataset.locale || 'default',
                    expected_grant_version: grantVersion(),
                    value_type: 'string',
                    reason: 'store_music_playlist_autosave'
                };
                return sc.setScopedConfig(Object.assign({}, base, {
                    key: root.dataset.playlistKey,
                    value: nextJson
                })).then(function (playlistResult) {
                    if (playlistResult && playlistResult.success === false) {
                        return playlistResult;
                    }
                    return sc.setScopedConfig(Object.assign({}, base, {
                        key: root.dataset.trackKey,
                        value: firstUrl
                    })).then(function (trackResult) {
                        if (trackResult && trackResult.success === false) {
                            return trackResult;
                        }
                        return playlistResult || trackResult;
                    });
                });
            });
        }).then(function (result) {
            saving = false;
            if (result && result.success === false) {
                toast('error', (result && result.message) || '保存失败');
                if (pendingSave) {
                    pendingSave = false;
                    scheduleSave(200);
                }
                return;
            }
            playlistInput.value = nextJson;
            playlistInput.dataset.lastValue = nextJson;
            if (mediaInput) {
                var csv = tracks.map(function (t) { return t.url; }).join(',');
                mediaInput.value = csv;
                mediaInput.dataset.lastValue = csv;
            }
            toast('success', '进店曲目已保存');
            if (pendingSave) {
                pendingSave = false;
                scheduleSave(200);
            }
        }).catch(function (err) {
            saving = false;
            var msg = err && err.message ? String(err.message) : '进店曲目保存失败';
            toast('error', msg.indexOf('expected_grant_version') >= 0
                ? '进店曲目保存失败：缺少授权版本，请刷新页面后重试'
                : ('进店曲目保存失败：' + msg));
            if (pendingSave) {
                pendingSave = false;
                scheduleSave(400);
            }
        });
    }

    function syncFromMediaValue(raw) {
        var csv = String(raw || '').trim();
        var prev = readPreviousByUrl();
        var parts = csv ? csv.split(/\s*,\s*/) : [];
        var tracks = [];
        parts.forEach(function (part) {
            var url = normalizeUrl(part);
            if (!url) return;
            var old = prev[url] || {};
            tracks.push({
                url: url,
                title: old.title || titleFromUrl(url),
                intro: old.intro && typeof old.intro === 'object' ? old.intro : {}
            });
        });
        rebuildEditor(tracks);
        scheduleSave(0);
    }

    var mediaInput = root.querySelector('[data-store-music-media-input]');
    if (mediaInput) {
        var observer = new MutationObserver(function () {
            if (String(mediaInput.value || '') === String(mediaInput.dataset.lastValue || '')) {
                return;
            }
            syncFromMediaValue(mediaInput.value);
        });
        observer.observe(mediaInput, { attributes: true, attributeFilter: ['value'] });
        mediaInput.addEventListener('change', function () {
            syncFromMediaValue(mediaInput.value);
        });
        mediaInput.addEventListener('input', function () {
            syncFromMediaValue(mediaInput.value);
        });
    }

    var fallback = root.querySelector('[data-store-music-media-fallback]');
    if (fallback) {
        fallback.addEventListener('change', function () {
            if (mediaInput) {
                mediaInput.value = fallback.value;
            }
            syncFromMediaValue(fallback.value);
        });
    }

    var editor = root.querySelector('[data-store-music-playlist-editor]');
    if (editor) {
        editor.addEventListener('input', function (ev) {
            var t = ev.target;
            if (!t || !t.closest) return;
            if (t.matches('[data-store-music-track-title], [data-store-music-track-intro]')) {
                scheduleSave(800);
            }
        });
        editor.addEventListener('change', function (ev) {
            var t = ev.target;
            if (!t || !t.closest) return;
            if (t.matches('[data-store-music-track-title], [data-store-music-track-intro]')) {
                flushAllIntros();
                scheduleSave(0);
            }
        });
        editor.addEventListener('weline:ui:reorder-list:change', function () {
            scheduleSave(0);
        });
    }

    var localeInput = document.getElementById('store-music-intro-edit-locale');
    if (localeInput) {
        var onLocaleChange = function () {
            var previous = String(root.dataset.introEditLocale || '').trim();
            var next = String(localeInput.value || '').trim();
            if (!next || next === previous) {
                if (next) {
                    root.dataset.introEditLocale = next;
                }
                return;
            }
            // Flush textarea into previous locale, then load next.
            if (previous) {
                root.dataset.introEditLocale = previous;
            }
            flushAllIntros();
            root.dataset.introEditLocale = next;
            root.querySelectorAll('[data-store-music-playlist-row]').forEach(function (row) {
                fillIntroForLocale(row, next);
            });
        };
        localeInput.addEventListener('change', onLocaleChange);
        localeInput.addEventListener('input', onLocaleChange);
    }
})();
</script>
