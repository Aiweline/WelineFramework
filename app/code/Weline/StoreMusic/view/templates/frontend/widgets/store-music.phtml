/**
 * StoreMusic float — required default_injection + Hook share this template.
 *
 * @widget.code {store-music}
 * @widget.name {进店音乐}
 * @widget.description {左下角进店氛围音乐浮层；曲目与播放在部件配置中设置；应用默认注入，恢复原始布局后回填。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {content}
 * @widget.supports {["store-music","layout-homepage-content","content"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"content", "area":"content", "sort_order":900, "required":true, "reason":"店面默认进店音乐浮层；恢复原始布局后 required 回填", "config":{"enabled":true,"tracks":[],"delay_seconds":3,"try_autoplay":true,"loop":true,"default_volume":8,"avatar_spin":false,"waveform_default":false} }]}
 *
 * @param enabled {default=true,type="bool",label="启用进店音乐",i18n=false}
 * @param tracks {default=[],type="array",label="进店曲目",i18n=false}
 * @param delay_seconds {default=3,type="range",label="延迟秒数",min=1,max=15,i18n=false}
 * @param try_autoplay {default=true,type="bool",label="尝试自动播放",i18n=false}
 * @param loop {default=true,type="bool",label="循环播放",i18n=false}
 * @param default_volume {default=8,type="range",label="默认音量",min=0,max=100,i18n=false}
 * @param avatar_spin {default=false,type="bool",label="播放时旋转头像",i18n=false}
 * @param waveform_default {default=false,type="bool",label="默认开启波形背景",i18n=false}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\View\Data\DataInterface;
use Weline\StoreMusic\Service\StoreMusicRenderGate;
use Weline\StoreMusic\Service\StoreMusicSettings;

/** @var StoreMusicSettings $settings */
$settings = ObjectManager::getInstance(StoreMusicSettings::class);
$widgetConfig = StoreMusicSettings::widgetConfigFromTemplate($this);
if (!$settings->isWidgetActive($widgetConfig)) {
    return;
}
if (!StoreMusicRenderGate::claim()) {
    return;
}

$payload = $settings->frontendPayload($widgetConfig);
$websiteId = '0';
$storeId = '0';
try {
    if (class_exists(\Weline\Framework\Runtime\RequestContext::class)) {
        $websiteId = (string)\Weline\Framework\Runtime\RequestContext::getWelineWebsiteId();
        $storeId = (string)\Weline\Framework\Runtime\RequestContext::getWelineStoreId();
    }
} catch (\Throwable) {
    // Soft: ids only affect localStorage key names.
}

$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
// Hook body-end raw-includes this file (no Taglib pass). Prefer runtime __()
// over compile-time lang tags so storefront locales translate; keep Chinese source keys.
$t = static fn (string $word): string => $esc((string)__($word));
$configJson = $esc((string)json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
$defaultVol = (int)$payload['default_volume'];
$cssUrl = '';
$faceUrl = '';
try {
    // This template is also included directly by the base::body-end Hook. In
    // that path the @static tag is not passed through the template renderer,
    // so resolve asset URLs through Template::fetchTagSource before emitting
    // markup. fetchTagSource also applies the normal development cache key.
    $cssUrl = (string)$this->fetchTagSource(
        DataInterface::dir_type_STATICS,
        'Weline_StoreMusic::css/store-music.css',
    );
    $faceUrl = (string)$this->fetchTagSource(
        DataInterface::dir_type_STATICS,
        'Weline_StoreMusic::images/guofeng-cameo.png',
    );
} catch (\Throwable) {
    // Keep the widget renderable if a host view does not expose static URLs.
}
$cssUrl = $esc($cssUrl);
$faceUrl = $esc($faceUrl);
?>
<script data-weline-store-music-purge="1">
/* Immediate cold purge: stop orphan StoreMusic decoders before deferred module boots. */
(function () {
    try {
        var reg = window.__WelineStoreMusicAudioRegistry;
        if (reg && reg.length) {
            for (var i = 0; i < reg.length; i++) {
                var a = reg[i];
                if (!a) continue;
                try { a.pause(); } catch (e0) {}
                try { a.muted = true; a.volume = 0; a.removeAttribute('src'); a.src = ''; a.load(); } catch (e1) {}
            }
        }
        window.__WelineStoreMusicAudioRegistry = [];
        var shared = window.__WelineStoreMusicSharedAudio;
        if (shared) {
            try { shared.pause(); shared.muted = true; shared.src = ''; shared.load(); } catch (e2) {}
        }
        window.__WelineStoreMusicSharedAudio = null;
        if (window.__WelineStoreMusicSharedCtx && window.__WelineStoreMusicSharedCtx.close) {
            try { window.__WelineStoreMusicSharedCtx.close(); } catch (e3) {}
        }
        window.__WelineStoreMusicSharedCtx = null;
        window.__WelineStoreMusicSharedAnalyser = null;
        window.__WelineStoreMusicSharedSource = null;
        window.__WelineStoreMusicLive = null;
        var nodes = document.querySelectorAll('audio,video');
        for (var j = 0; j < nodes.length; j++) {
            var el = nodes[j];
            var src = '';
            try {
                src = String(el.currentSrc || el.src || '') + String(el.getAttribute('data-store-music-src') || '');
            } catch (e4) { src = ''; }
            if (src.indexOf('store-music') !== -1 || el.getAttribute('data-store-music-audio') === '1') {
                try { el.pause(); el.muted = true; el.removeAttribute('src'); el.src = ''; el.load(); } catch (e5) {}
            }
        }
        if (navigator.mediaSession) {
            try { navigator.mediaSession.playbackState = 'none'; navigator.mediaSession.metadata = null; } catch (e6) {}
        }
    } catch (e) {}
})();
</script>
