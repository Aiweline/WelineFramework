/**
 * @widget.source {Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_StoreMusic::js/widgets/widget-store-music-0.js,Weline_StoreMusic::js/widgets/widget-store-music-1.js,Weline_StoreMusic::css/widgets/widget-store-music.css,Weline_StoreMusic::css/store-music.css}
 * StoreMusic float — required default_injection + Hook share this template.
 *
 * @widget.code {store-music}
 * @widget.name {进店音乐}
 * @widget.description {左下角进店氛围音乐浮层；曲目与播放在部件配置中设置；应用默认注入，恢复原始布局后回填。}
