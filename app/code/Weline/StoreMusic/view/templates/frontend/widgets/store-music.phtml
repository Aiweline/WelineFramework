.w-store-music-host[data-store-music-host]{position:static;display:block;width:0;height:0;margin:0;padding:0;border:0;overflow:visible}
.w-store-music[data-store-music]{position:fixed!important;left:max(.85rem,env(safe-area-inset-left,0px));bottom:calc(max(.95rem,env(safe-area-inset-bottom,0px)) + var(--weline-product-sticky-purchase-clearance,0px) + var(--w-store-music-heading-lift,0px));z-index:2147483001}
</style>
