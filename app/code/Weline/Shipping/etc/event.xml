<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Websites::website_save_after">
        <observer name="Weline_Shipping::website_save_after_embargo"
                  instance="Weline\Shipping\Observer\WebsiteSaveAfter"
                  disabled="false"
                  shared="true"
                  sort="40"/>
    </event>
    <event name="Weline_Websites::store_save_after">
        <observer name="Weline_Shipping::store_save_after_embargo"
                  instance="Weline\Shipping\Observer\StoreSaveAfter"
                  disabled="false"
                  shared="true"
                  sort="40"/>
    </event>
    <event name="Weline_Websites::channel_save_after">
        <observer name="Weline_Shipping::channel_save_after_embargo"
                  instance="Weline\Shipping\Observer\ChannelSaveAfter"
                  disabled="false"
                  shared="true"
                  sort="40"/>
    </event>
</config>
