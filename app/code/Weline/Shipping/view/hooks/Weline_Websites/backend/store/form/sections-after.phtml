<?php
/**
 * @hook-priority 100
 * @hook-sort-order 40
 */

$store = (array)($this->getData('store') ?? []);
$storeId = array_key_exists('store_id', $store) || array_key_exists('store_id', (array)$this->getData())
    ? (int)($this->getData('store_id') ?? $store['store_id'] ?? -1)
    : -1;
$hookId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'store'));
if (!is_string($hookId) || $hookId === '' || preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'store_' . (is_string($hookId) ? $hookId : '');
}
$scopeType = 'store';
$scopeId = $storeId;
$hasIdentity = $storeId >= 0;
$sectionId = $hookId . '_shipping_embargo';
$pendingHint = (string)__('请先保存商店，再配置禁运区域。');
include BP . 'app/code/Weline/Shipping/view/templates/backend/partials/embargo-form-section.phtml';

$sectionId = $hookId . '_shipping_destination';
$pendingHint = (string)__('请先保存商店，再配置可售目的地。');
include BP . 'app/code/Weline/Shipping/view/templates/backend/partials/destination-form-section.phtml';
