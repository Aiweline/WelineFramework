<?php
/**
 * @hook-priority 50
 * @hook-sort-order 0
 * @hook-solo false
 *
 * Always emit signed-in address links; hide when guest so FPC soft-reconcile
 * can reveal them without re-rendering the hook.
 */

use Weline\Framework\Session\SessionFactory;

$session = SessionFactory::getInstance()->createFrontendSession();
$isLoggedIn = $session->isLoggedIn();
$signedHidden = $isLoggedIn ? '' : ' hidden';
?>

<li role="none" data-account-menu-auth="signed-in"<?= $signedHidden ?>><a href="@url{'customer/account/index'}#shipping-address" role="menuitem"><?= __('发货地址') ?></a></li>
<li role="none" data-account-menu-auth="signed-in"<?= $signedHidden ?>><a href="@url{'customer/account/index'}#delivery-address" role="menuitem"><?= __('收货地址') ?></a></li>
