<?php
/**
 * @widget.source {Weline_Shipping::css/widgets/widget-checkout-delivery-context-quick-add.css}
 * Header Checkout 配送弹窗：快速添加地址（Shipping owned）
 *
 * @hook-priority 100
 * @hook-sort-order 0
 * @hook-solo true
 */
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\Session\SessionCookieNameResolver;

$countryCode = 'CN';
$locationCookie = \w_env_cookie('weline_delivery_location');
if (is_string($locationCookie) && $locationCookie !== '') {
    $decoded = json_decode($locationCookie, true);
    if (is_array($decoded)) {
        $fromCookie = strtoupper(substr((string)preg_replace('/[^A-Za-z]/', '', (string)($decoded['country_code'] ?? $decoded['countryCode'] ?? '')), 0, 2));
        if ($fromCookie !== '') {
            $countryCode = $fromCookie;
        }
    }
}
$sessionCountry = '';
try {
    $hasSessionCookie = SessionCookieNameResolver::hasRequestCookie();
    if ($hasSessionCookie) {
        $session = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Session\SessionFactory::class)->createSession();
        $sessionCountry = strtoupper(substr((string)preg_replace('/[^A-Za-z]/', '', (string)$session->get('checkout_delivery_country_code')), 0, 2));
    }
} catch (\Throwable) {
    $sessionCountry = '';
}
if ($sessionCountry !== '') {
    $countryCode = $sessionCountry;
}
$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
\Weline\Theme\Helper\WidgetI18n::prefetchLabels([
    '快速添加地址',
    '收货人',
    '电话',
    '详细地址',
    '同时用作结账地址',
    '保存并使用',
]);
?>
<details class="quick-add" data-quick-add data-shipping-delivery-quick-add>
    <summary><?= \Weline\Theme\Helper\WidgetI18n::label('快速添加地址') ?></summary>
    <w:form id="checkout-delivery-quick-add-form"
            method="post"
            csrf="off"
            captcha="lazy"
            intent="checkout.save_delivery_address"
            data-quick-add-form
            class="checkout-delivery-quick-add-form">
        <div class="field-grid">
            <div class="w-field">
                <label class="w-field__label"><?= \Weline\Theme\Helper\WidgetI18n::label('收货人') ?></label>
                <input class="w-input" name="contact_name" required autocomplete="shipping name">
            </div>
            <div class="w-field">
                <label class="w-field__label"><?= \Weline\Theme\Helper\WidgetI18n::label('电话') ?></label>
                <input class="w-input" name="contact_phone" required autocomplete="shipping tel">
            </div>
            <div class="span-full">
                <w:theme:address
                    levels="province,city,district"
                    code="checkout-delivery-quick-add"
                    country="<?= $esc($countryCode) ?>"
                    country-name="country"
                    province-name="province"
                    city-name="city"
                    district-name="district"
                    searchable="true"
                    cascade="true"
                    district="true" />
            </div>
            <div class="w-field span-full">
                <label class="w-field__label"><?= \Weline\Theme\Helper\WidgetI18n::label('详细地址') ?></label>
                <input class="w-input" name="street" required autocomplete="shipping street-address">
            </div>
            <input type="hidden" name="postal_code" autocomplete="shipping postal-code">
        </div>
        <label class="w-shipping-checkout-address__same" data-widget-style-class="fa7f06306bd58a8c">
            <input type="checkbox" name="also_use_checkout" value="1" data-also-use-checkout>
            <span><?= \Weline\Theme\Helper\WidgetI18n::label('同时用作结账地址') ?></span>
        </label>
        <div data-weline-form-captcha-slot></div>
        <button type="submit" class="w-button" data-tone="primary"><?= \Weline\Theme\Helper\WidgetI18n::label('保存并使用') ?></button>
    </w:form>
</details>
