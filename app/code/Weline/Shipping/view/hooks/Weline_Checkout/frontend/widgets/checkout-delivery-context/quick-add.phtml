<?php
/**
 * Header Checkout 配送弹窗：快速添加地址（Shipping owned）
 *
 * @hook-priority 100
 * @hook-sort-order 0
 * @hook-solo true
 */
/** @var \Weline\Framework\View\Template $this */

$countryCode = 'CN';
$locationCookie = \w_env_cookie('weline_delivery_location');
if (is_string($locationCookie) && $locationCookie !== '') {
    $decoded = json_decode($locationCookie, true);
    if (is_array($decoded)) {
        $fromCookie = strtoupper(substr((string)preg_replace('/[^A-Za-z]/', '', (string)($decoded['country_code'] ?? $decoded['countryCode'] ?? '')), 0, 2));
        if ($fromCookie !== '') {
            $countryCode = $fromCookie;
        }
    }
}
$sessionCountry = '';
try {
    $session = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Session\SessionFactory::class)->createSession();
    $sessionCountry = strtoupper(substr((string)preg_replace('/[^A-Za-z]/', '', (string)$session->get('checkout_delivery_country_code')), 0, 2));
} catch (\Throwable) {
    $sessionCountry = '';
}
if ($sessionCountry !== '') {
    $countryCode = $sessionCountry;
}
$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
?>
<details class="quick-add" data-quick-add data-shipping-delivery-quick-add>
    <summary><?= __('快速添加地址') ?></summary>
    <w:form id="checkout-delivery-quick-add-form"
            method="post"
            captcha="lazy"
            intent="checkout.save_delivery_address"
            data-quick-add-form
            class="checkout-delivery-quick-add-form">
        <div class="field-grid">
            <label class="w-field">
                <span class="w-form-label w-field__label"><?= __('收货人') ?></span>
                <input class="w-form-control w-input" name="contact_name" required autocomplete="shipping name">
            </label>
            <label class="w-field">
                <span class="w-form-label w-field__label"><?= __('电话') ?></span>
                <input class="w-form-control w-input" name="contact_phone" required autocomplete="shipping tel">
            </label>
            <div class="span-full">
                <w:theme:address
                    levels="province,city,district"
                    code="checkout-delivery-quick-add"
                    country="<?= $esc($countryCode) ?>"
                    country-name="country"
                    province-name="province"
                    city-name="city"
                    district-name="district"
                    searchable="true"
                    cascade="true"
                    district="true" />
            </div>
            <label class="w-field span-full">
                <span class="w-form-label w-field__label"><?= __('详细地址') ?></span>
                <input class="w-form-control w-input" name="street" required autocomplete="shipping street-address">
            </label>
            <input type="hidden" name="postal_code" autocomplete="shipping postal-code">
        </div>
        <div data-weline-form-captcha-slot></div>
        <button type="submit" class="w-button" data-tone="primary"><?= __('保存并使用') ?></button>
    </w:form>
</details>
