<?php
/**@var \Weline\Framework\View\Template $this */
$addresses = $this->getData('addresses') ?? [];
$dialogJsonFlags = JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_THROW_ON_ERROR;
$dialogMessages = [
    'confirmTitle' => (string)__('确认操作'),
    'confirmButton' => (string)__('确定'),
    'cancelButton' => (string)__('取消'),
    'operationFailed' => (string)__('操作失败'),
    'setDefault' => (string)__('确定要设置为默认地址吗？'),
    'deleteAddress' => (string)__('确定要删除此地址吗？'),
];
?>
<div class="shipping-address-list" data-weline-load="shippingAddressPage">
    <div class="page-header" style="--w-mb:var(--weline-space-6);">
        <h2><lang>发货地址管理</lang></h2>
        <a href="@url{'shipping/address/form'}" class="w-button" data-tone="primary">
            <w:icon name="plus" size="sm"></w:icon> <lang>新增地址</lang>
        </a>
    </div>

    <?php if (empty($addresses)): ?>
        <div class="w-alert" data-tone="info">
            <w:icon name="info" size="sm"></w:icon> <lang>暂无地址，请添加发货地址</lang>
        </div>
    <?php else: ?>
        <div class="address-grid">
            <?php foreach ($addresses as $address): ?>
                <div class="address-card <?= $address->isDefault() ? 'default-address' : '' ?>">
                    <div class="address-header">
                        <h4><?= htmlspecialchars($address->getData('name')) ?></h4>
                        <?php if ($address->isDefault()): ?>
                            <span class="w-badge" data-w-background="primary"><lang>默认</lang></span>
                        <?php endif; ?>
                    </div>
                    <div class="address-content">
                        <p><strong><lang>联系人</lang>:</strong> <?= htmlspecialchars($address->getData('contact_name')) ?></p>
                        <p><strong><lang>电话</lang>:</strong> <?= htmlspecialchars($address->getData('contact_phone')) ?></p>
                        <p><strong><lang>地址</lang>:</strong> <?= htmlspecialchars($address->getFullAddress()) ?></p>
                        <?php if ($address->getData('postal_code')): ?>
                            <p><strong><lang>邮编</lang>:</strong> <?= htmlspecialchars($address->getData('postal_code')) ?></p>
                        <?php endif; ?>
                    </div>
                    <div class="address-actions">
                        <a href="@url{'shipping/address/form'|['id' => $address->getId()]}" class="w-button" data-tone="primary" data-variant="outline" data-size="sm">
                            <w:icon name="edit" size="sm"></w:icon> <lang>编辑</lang>
                        </a>
                        <?php if (!$address->isDefault()): ?>
                            <button type="button" class="w-button set-default-btn" data-id="<?= $address->getId() ?>" data-tone="success" data-variant="outline" data-size="sm">
                                <w:icon name="star" size="sm"></w:icon> <lang>设为默认</lang>
                            </button>
                        <?php endif; ?>
                        <button type="button" class="w-button delete-btn" data-id="<?= $address->getId() ?>" data-tone="danger" data-variant="outline" data-size="sm">
                            <w:icon name="trash" size="sm"></w:icon> <lang>删除</lang>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<script type="application/json" id="shipping-address-config"><?= json_encode(["messages" => $dialogMessages], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?></script>
