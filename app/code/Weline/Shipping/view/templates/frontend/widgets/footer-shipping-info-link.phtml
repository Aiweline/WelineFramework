<?php
/**
 * 页脚「帮助中心」扩展：配送说明入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-shipping-info-link}
 * @widget.name {页脚配送说明链接}
 * @widget.description {页脚帮助中心扩展槽：配送说明入口；默认注入 footer-help-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-help-links}
 * @widget.supports {["footer-shipping-info-link","layout-footer-help-links"]}
 * @widget.default_injections {[{ "layout_type":"*", "slot":"footer-help-links", "area":"footer", "sort_order":20, "required":true, "reason":"页脚帮助中心默认展示配送说明", "config":{"label":"配送说明"} }]}
 *
 * @param label {default="配送说明",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-shipping-info-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '配送说明';
$label = WidgetI18n::label($labelSource, '配送说明');
?>
<a class="footer-help-link footer-shipping-info-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-shipping-info-link"
   href="@url{'guide/shipping'}"><?= $esc($label) ?></a>
