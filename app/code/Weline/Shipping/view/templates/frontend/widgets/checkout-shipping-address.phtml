<?php
/** @var \Weline\Framework\View\Template $this */
/**
 * @widget.code {checkout-shipping-address}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-shipping-address","area":"content","sort_order":10,"required":true,"reason":"结账收货信息默认由 Shipping 地址部件提供（theme:address + 已存地址选择）","config":{"title":"收货地址"}}]}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('checkout-shipping-address');
$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;

$title = trim((string)($this->getData('title') ?? ''));
$title = $title === '' ? (string)__('收货地址') : (string)__($title);

$context = [
    'country_code' => 'CN',
    'country_name' => (string)__('China'),
    'addresses' => [],
    'selected' => null,
    'is_logged_in' => false,
    'checkout_address' => [
        'name' => '',
        'phone' => '',
        'email' => '',
        'country_code' => 'CN',
        'province' => '',
        'city' => '',
        'district' => '',
        'address1' => '',
        'postal_code' => '',
    ],
];

try {
    if (class_exists(\Weline\Checkout\Service\CheckoutDeliveryContextService::class)) {
        $context = ObjectManager::getInstance(\Weline\Checkout\Service\CheckoutDeliveryContextService::class)->getContext();
    }
} catch (\Throwable) {
    // Checkout 可选：部件仍渲染可编辑表单
}

$addresses = is_array($context['addresses'] ?? null) ? $context['addresses'] : [];
$formAddress = is_array($context['checkout_address'] ?? null) ? $context['checkout_address'] : [];
$selected = is_array($context['selected'] ?? null) ? $context['selected'] : [];
if (!isset($formAddress['district']) || trim((string)$formAddress['district']) === '') {
    $formAddress['district'] = (string)($selected['district'] ?? '');
}

$seed = [
    'name' => (string)($formAddress['name'] ?? ''),
    'phone' => (string)($formAddress['phone'] ?? ''),
    'email' => (string)($formAddress['email'] ?? ''),
    'country_code' => strtoupper((string)($formAddress['country_code'] ?? $context['country_code'] ?? 'CN')) ?: 'CN',
    'country' => (string)($formAddress['country'] ?? $context['country_name'] ?? ''),
    'province' => (string)($formAddress['province'] ?? ''),
    'city' => (string)($formAddress['city'] ?? ''),
    'district' => (string)($formAddress['district'] ?? ''),
    'address1' => (string)($formAddress['address1'] ?? $formAddress['street'] ?? ''),
    'postal_code' => (string)($formAddress['postal_code'] ?? ''),
    'address_id' => (string)($formAddress['address_id'] ?? ''),
];
?>
<section class="<?= $esc($scope->cssClass) ?> w-shipping-checkout-address"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="shipping-checkout-address"
         data-shipping-checkout-address
         data-weline-load="shippingCheckoutAddress"
         data-initial-address="<?= $esc(json_encode($seed, $jsonFlags) ?: '{}') ?>">
    <?php if ($addresses !== []): ?>
    <div class="w-shipping-checkout-address__saved" data-saved-addresses>
        <span class="w-shipping-checkout-address__saved-label"><?= __('选择已存地址') ?></span>
        <div class="w-shipping-checkout-address__tags" role="list">
            <?php foreach ($addresses as $address): ?>
                <?php
                $id = (string)($address['id'] ?? '');
                $label = (string)($address['display_label'] ?? $address['full_address'] ?? $id);
                $isSelected = !empty($address['is_selected']);
                $payload = [
                    'id' => $id,
                    'name' => (string)($address['contact_name'] ?? $address['name'] ?? ''),
                    'phone' => (string)($address['contact_phone'] ?? $address['phone'] ?? ''),
                    'email' => (string)($seed['email'] ?? ''),
                    'country_code' => (string)($address['country_code'] ?? ''),
                    'country' => (string)($address['country'] ?? $address['country_name'] ?? ''),
                    'province' => (string)($address['province'] ?? ''),
                    'city' => (string)($address['city'] ?? ''),
                    'district' => (string)($address['district'] ?? ''),
                    'address1' => (string)($address['street'] ?? $address['address1'] ?? ''),
                    'postal_code' => (string)($address['postal_code'] ?? ''),
                ];
                ?>
                <button type="button"
                        class="w-shipping-checkout-address__tag<?= $isSelected ? ' is-selected' : '' ?>"
                        role="listitem"
                        data-address-id="<?= $esc($id) ?>"
                        data-address-json="<?= $esc(json_encode($payload, $jsonFlags) ?: '{}') ?>"
                        aria-pressed="<?= $isSelected ? 'true' : 'false' ?>">
                    <?= $esc($label) ?>
                </button>
            <?php endforeach; ?>
        </div>
    </div>
    <?php endif; ?>

    <div class="w-shipping-checkout-address__grid">
        <label class="w-shipping-checkout-address__field">
            <span class="w-form-label"><?= __('收货人') ?></span>
            <input class="w-form-control w-input" name="name" type="text" required autocomplete="shipping name" value="<?= $esc($seed['name']) ?>">
        </label>
        <label class="w-shipping-checkout-address__field">
            <span class="w-form-label"><?= __('电话') ?></span>
            <input class="w-form-control w-input" name="phone" type="tel" required autocomplete="shipping tel" value="<?= $esc($seed['phone']) ?>">
        </label>
        <label class="w-shipping-checkout-address__field w-shipping-checkout-address__field--wide">
            <span class="w-form-label"><?= __('邮箱') ?></span>
            <input class="w-form-control w-input" name="email" type="email" required autocomplete="email" value="<?= $esc($seed['email']) ?>">
        </label>
        <div class="w-shipping-checkout-address__field w-shipping-checkout-address__field--wide" data-shipping-address-cascade>
            <w:theme:address
                levels="country,province,city"
                code="checkout-shipping-address"
                searchable="true"
                cascade="true"
                district="true" />
        </div>
        <label class="w-shipping-checkout-address__field w-shipping-checkout-address__field--wide">
            <span class="w-form-label"><?= __('详细地址') ?></span>
            <input class="w-form-control w-input" name="address1" type="text" required autocomplete="shipping street-address" value="<?= $esc($seed['address1']) ?>">
        </label>
        <label class="w-shipping-checkout-address__field">
            <span class="w-form-label"><?= __('邮编') ?></span>
            <input class="w-form-control w-input" name="postal_code" type="text" autocomplete="shipping postal-code" value="<?= $esc($seed['postal_code']) ?>">
        </label>
    </div>
</section>
<link rel="stylesheet" href="@static(Weline_Shipping::css/widgets/checkout-shipping-address.css)?v=20260828-csa1">
<?php // shippingCheckoutAddress：由部件根 data-weline-load 声明，禁止 @static 直引 ?>
