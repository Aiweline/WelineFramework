            <div class="w-shipping-checkout-address__grid">
                <div class="w-field w-shipping-checkout-address__field">
                    <label class="w-field__label"><?= __('收货人') ?></label>
                    <input class="w-input" name="name" type="text" <?= $hasSaved ? '' : 'required' ?> autocomplete="shipping name" value="<?= $esc($seed['name']) ?>" placeholder="<?= $esc(__('请输入收货人姓名')) ?>" data-shipping-field>
                    <span class="w-shipping-checkout-address__field-error" data-field-error-for="name" role="alert" hidden></span>
                </div>
                <div class="w-field w-shipping-checkout-address__field">
                    <label class="w-field__label"><?= __('电话') ?></label>
                    <input class="w-input" name="phone" type="tel" <?= $hasSaved ? '' : 'required' ?> autocomplete="shipping tel" value="<?= $esc($seed['phone']) ?>" placeholder="<?= $esc(__('请输入联系电话')) ?>" data-shipping-field>
                    <span class="w-shipping-checkout-address__field-error" data-field-error-for="phone" role="alert" hidden></span>
                </div>
                <div class="w-field w-shipping-checkout-address__field w-shipping-checkout-address__field--wide">
                    <label class="w-field__label"><?= __('邮箱') ?></label>
                    <input class="w-input" name="email" type="email" <?= $hasSaved ? '' : 'required' ?> autocomplete="email" value="<?= $esc($seed['email']) ?>" placeholder="<?= $esc(__('请输入邮箱地址')) ?>" data-shipping-field>
                    <span class="w-shipping-checkout-address__field-error" data-field-error-for="email" role="alert" hidden></span>
                </div>
                <div class="w-field w-shipping-checkout-address__field">
                    <label class="w-field__label"><lang>邮编</lang></label>
                    <input class="w-input" name="postal_code" type="text" autocomplete="shipping postal-code" value="<?= $esc($seed['postal_code']) ?>" placeholder="<?= $esc(__('请输入邮政编码')) ?>" data-shipping-field data-postal-first>
                    <span class="w-shipping-checkout-address__field-error" data-field-error-for="postal_code" role="alert" hidden></span>
                </div>
                <div class="w-shipping-checkout-address__field w-shipping-checkout-address__field--wide" data-shipping-address-cascade>
                    <w:theme:address
                        levels="country,province,city"
                        code="checkout-shipping-address"
                        searchable="true"
                        cascade="true"
                        district="true"
                        postal="false"
                        postal-lookup="true" />
                </div>
                <div class="w-field w-shipping-checkout-address__field w-shipping-checkout-address__field--wide">
                    <label class="w-field__label"><lang>详细地址</lang></label>
                    <input class="w-input" name="address1" type="text" <?= $hasSaved ? '' : 'required' ?> autocomplete="shipping street-address" value="<?= $esc($seed['address1']) ?>" data-shipping-field placeholder="<?= $esc(__('门牌号 / 楼栋单元等')) ?>">
                    <span class="w-shipping-checkout-address__field-error" data-field-error-for="address1" role="alert" hidden></span>
                </div>
            </div>
            <?php /* 始终渲染：登录无已存地址时也可点「保存此地址」收起为卡片；不点仍可用表单下单 */ ?>
            <div class="w-shipping-checkout-address__editor-actions">
                <?php if (!$isLoggedIn): ?>
                <div class="w-shipping-checkout-address__captcha"
                     data-weline-captcha-lazy
                     data-form-id="checkout-shipping-address-editor"
                     data-intent="checkout.save_delivery_address"></div>
                <?php endif; ?>
                <div class="w-shipping-checkout-address__editor-action-row">
                    <p class="w-shipping-checkout-address__message" data-shipping-message aria-live="polite" hidden></p>
                    <div class="w-shipping-checkout-address__editor-action-buttons">
                <?php if ($hasSaved): ?>
                <button type="button" class="w-shipping-checkout-address__secondary-btn" data-cancel-edit>
                    <?= $esc($ui['cancel']) ?>
                </button>
                <?php endif; ?>
                <button type="button" class="w-shipping-checkout-address__primary-btn" data-use-edited-address>
                    <?= $esc($ui['save_use']) ?>
                </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <?php if (!$hideBillingSame): ?>
    <div class="w-shipping-checkout-address__section w-shipping-checkout-address__section--billing" data-billing-section>
        <h3 class="w-shipping-checkout-address__heading"><?= $esc($ui['billing_title']) ?></h3>
        <label class="w-shipping-checkout-address__same">
            <input type="checkbox" name="billing_same_as_shipping" value="1" checked data-billing-same>
            <span><?= $esc($ui['billing_same']) ?></span>
        </label>
        <div class="w-shipping-checkout-address__editor" data-billing-editor hidden>
