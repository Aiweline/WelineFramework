<?php
/** @var \Weline\Framework\View\Template $this */
/**
 * @widget.code {checkout-shipping-address}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-shipping-address","area":"content","sort_order":10,"required":true,"reason":"结账收货信息默认由 Shipping 地址部件提供（theme:address + 已存地址选择）","config":{"title":"收货地址"}}]}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('checkout-shipping-address');
$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;

$title = trim((string)($this->getData('title') ?? ''));
// 忽略 Template 单例泄漏的模块名标题（如 Weline_Framework / Weline_Checkout）
if ($title === '' || preg_match('/^Weline_[A-Za-z][A-Za-z0-9]*$/', $title) === 1) {
    $title = (string)__('收货地址');
} else {
    $title = (string)__($title);
}
$savedHeading = trim((string)($this->getData('saved_heading') ?? ''));
$savedHeading = $savedHeading === '' ? (string)__('选择收货地址') : (string)__($savedHeading);
$hideBillingSame = !empty($this->getData('hide_billing_same'));

$context = [
    'country_code' => 'CN',
    'country_name' => (string)__('China'),
    'addresses' => [],
    'selected' => null,
    'is_logged_in' => false,
    'checkout_address' => [
        'name' => '',
        'phone' => '',
        'email' => '',
        'country_code' => 'CN',
        'province' => '',
        'city' => '',
        'district' => '',
        'address1' => '',
        'postal_code' => '',
    ],
];

try {
    if (class_exists(\Weline\Checkout\Service\CheckoutDeliveryContextService::class)) {
        $context = ObjectManager::getInstance(\Weline\Checkout\Service\CheckoutDeliveryContextService::class)->getContext();
    }
} catch (\Throwable) {
    // Checkout 可选：部件仍渲染可编辑表单
}

$addresses = is_array($context['addresses'] ?? null) ? $context['addresses'] : [];
$formAddress = is_array($context['checkout_address'] ?? null) ? $context['checkout_address'] : [];
$selected = is_array($context['selected'] ?? null) ? $context['selected'] : [];
if (!isset($formAddress['district']) || trim((string)$formAddress['district']) === '') {
    $formAddress['district'] = (string)($selected['district'] ?? '');
}

$seed = [
    'name' => (string)($formAddress['name'] ?? ''),
    'phone' => (string)($formAddress['phone'] ?? ''),
    'email' => (string)($formAddress['email'] ?? ''),
    'country_code' => strtoupper((string)($formAddress['country_code'] ?? $context['country_code'] ?? 'CN')) ?: 'CN',
    'country' => (string)($formAddress['country'] ?? $context['country_name'] ?? ''),
    'province' => (string)($formAddress['province'] ?? ''),
    'city' => (string)($formAddress['city'] ?? ''),
    'district' => (string)($formAddress['district'] ?? ''),
    'address1' => (string)($formAddress['address1'] ?? $formAddress['street'] ?? ''),
    'postal_code' => (string)($formAddress['postal_code'] ?? ''),
    'address_id' => (string)($formAddress['address_id'] ?? $selected['id'] ?? ''),
];

$hasSaved = $addresses !== [];
$addressCount = count($addresses);
$selectedId = (string)($seed['address_id'] ?? '');
if ($selectedId === '' && $hasSaved) {
    foreach ($addresses as $address) {
        if (!empty($address['is_selected'])) {
            $selectedId = (string)($address['id'] ?? '');
            break;
        }
    }
    if ($selectedId === '') {
        $selectedId = (string)($addresses[0]['id'] ?? '');
    }
}
$displayAddresses = [];
if ($hasSaved) {
    foreach ($addresses as $address) {
        $id = (string)($address['id'] ?? '');
        if ($id !== '' && $id === $selectedId) {
            $displayAddresses[] = $address;
            break;
        }
    }
    if ($displayAddresses === [] && $addresses !== []) {
        $displayAddresses[] = $addresses[0];
        $selectedId = (string)($addresses[0]['id'] ?? $selectedId);
    }
}
$listLoaded = $addressCount <= 1;
$initialMode = $hasSaved ? 'collapsed' : 'new';
$isLoggedIn = !empty($context['is_logged_in']);
$ui = [
    'edit' => (string)__('编辑'),
    'add_new' => (string)__('使用新地址'),
    'cancel' => (string)__('取消'),
    'save_use' => (string)__('保存此地址'),
    'billing_same' => (string)__('账单地址与收货地址相同'),
    'billing_title' => (string)__('账单地址'),
    'shipping_title' => $title,
    'saved_heading' => $savedHeading,
    'change_address' => (string)__('更换地址'),
    'done_change' => (string)__('收起地址列表'),
    'load_addresses_failed' => (string)__('地址列表加载失败，请稍后重试。'),
    'embargo_hint' => (string)__('该地址所在地区暂不支持配送（禁运）。'),
    'err_name' => (string)__('请填写收货人。'),
    'err_phone' => (string)__('请填写电话。'),
    'err_address1' => (string)__('请填写详细地址。'),
];
?>
<section class="<?= $esc($scope->cssClass) ?> w-shipping-checkout-address"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="shipping-checkout-address"
         data-shipping-checkout-address
         data-weline-load="shippingCheckoutAddress"
         data-mode="<?= $esc($initialMode) ?>"
         data-has-saved="<?= $hasSaved ? '1' : '0' ?>"
         data-address-count="<?= (int)$addressCount ?>"
         data-list-loaded="<?= $listLoaded ? '1' : '0' ?>"
         data-is-logged-in="<?= $isLoggedIn ? '1' : '0' ?>"
         data-selected-id="<?= $esc($selectedId) ?>"
         data-initial-address="<?= $esc(json_encode($seed, $jsonFlags) ?: '{}') ?>"
         data-i18n="<?= $esc(json_encode($ui, $jsonFlags) ?: '{}') ?>">

    <div class="w-shipping-checkout-address__section" data-shipping-section>
        <h3 class="w-shipping-checkout-address__heading"><?= $esc($ui['shipping_title']) ?></h3>

        <?php /* 始终输出 saved shell：访客首存后可无刷新渲染地址卡，避免 collapsed 后空白 */ ?>
        <div class="w-shipping-checkout-address__saved"
             data-saved-addresses
             <?= $hasSaved ? '' : 'hidden' ?>>
            <div class="w-shipping-checkout-address__saved-toolbar">
                <p class="w-shipping-checkout-address__saved-label"><?= $esc($ui['saved_heading']) ?></p>
                <button type="button"
                        class="w-shipping-checkout-address__link-btn"
                        data-change-address
                        aria-expanded="false"
                        <?= $hasSaved ? '' : 'hidden' ?>>
                    <?= $esc($ui['change_address']) ?>
                </button>
            </div>
            <div class="w-shipping-checkout-address__cards" role="radiogroup" aria-label="<?= $esc($ui['saved_heading']) ?>">
                <?php foreach ($displayAddresses as $address): ?>
                    <?php
                    $id = (string)($address['id'] ?? '');
                    $name = (string)($address['contact_name'] ?? $address['name'] ?? '');
                    $phone = (string)($address['contact_phone'] ?? $address['phone'] ?? '');
                    $label = (string)($address['display_label'] ?? $address['full_address'] ?? $id);
                    $line = trim(implode(' / ', array_filter([
                        (string)($address['country'] ?? $address['country_name'] ?? $address['country_code'] ?? ''),
                        (string)($address['province'] ?? ''),
                        (string)($address['city'] ?? ''),
                        (string)($address['district'] ?? ''),
                        (string)($address['street'] ?? $address['address1'] ?? ''),
                    ], static fn (string $part): bool => $part !== '')));
                    $isSelected = $id !== '' && $id === $selectedId;
                    $isEmbargoed = !empty($address['embargo_blocked']);
                    $embargoMessage = trim((string)($address['embargo_message'] ?? ''));
                    if ($isEmbargoed && $embargoMessage === '') {
                        $embargoMessage = (string)$ui['embargo_hint'];
                    }
                    $payload = [
                        'id' => $id,
                        'name' => $name,
                        'phone' => $phone,
                        'email' => (string)($seed['email'] ?? ''),
                        'country_code' => (string)($address['country_code'] ?? ''),
                        'country' => (string)($address['country'] ?? $address['country_name'] ?? ''),
                        'province' => (string)($address['province'] ?? ''),
                        'province_region_id' => (int)($address['province_region_id'] ?? 0),
                        'city' => (string)($address['city'] ?? ''),
                        'city_region_id' => (int)($address['city_region_id'] ?? 0),
                        'district' => (string)($address['district'] ?? ''),
                        'district_region_id' => (int)($address['district_region_id'] ?? 0),
                        'address1' => (string)($address['street'] ?? $address['address1'] ?? ''),
                        'postal_code' => (string)($address['postal_code'] ?? ''),
                        'embargo_blocked' => $isEmbargoed,
                        'embargo_message' => $embargoMessage,
                    ];
                    $cardClass = 'w-shipping-checkout-address__card'
                        . ($isSelected ? ' is-selected' : '')
                        . ($isEmbargoed ? ' is-embargoed' : '');
                    ?>
                    <label class="<?= $esc($cardClass) ?>"
                           data-address-card
                           data-address-id="<?= $esc($id) ?>"
                           data-embargo-blocked="<?= $isEmbargoed ? '1' : '0' ?>"
                           data-address-json="<?= $esc(json_encode($payload, $jsonFlags) ?: '{}') ?>">
                        <input class="w-shipping-checkout-address__radio"
                               type="radio"
                               name="shipping_address_id"
                               value="<?= $esc($id) ?>"
                               <?= $isSelected ? 'checked' : '' ?>
                               data-address-radio>
                        <span class="w-shipping-checkout-address__card-body">
                            <?php if ($name !== ''): ?>
                                <strong class="w-shipping-checkout-address__card-name"><?= $esc($name) ?></strong>
                            <?php endif; ?>
                            <?php if ($phone !== ''): ?>
                                <span class="w-shipping-checkout-address__card-meta"><?= $esc($phone) ?></span>
                            <?php endif; ?>
                            <span class="w-shipping-checkout-address__card-line"><?= $esc($line !== '' ? $line : $label) ?></span>
                            <span class="w-shipping-checkout-address__card-embargo"
                                  data-address-embargo
                                  role="status"
                                  <?= $isEmbargoed ? '' : 'hidden' ?>><?= $esc($embargoMessage) ?></span>
                        </span>
                        <button type="button"
                                class="w-shipping-checkout-address__card-edit"
                                data-edit-address
                                data-address-id="<?= $esc($id) ?>">
                            <?= $esc($ui['edit']) ?>
                        </button>
                    </label>
                <?php endforeach; ?>
            </div>
            <button type="button" class="w-shipping-checkout-address__link-btn" data-add-address>
                <?= $esc($ui['add_new']) ?>
            </button>
