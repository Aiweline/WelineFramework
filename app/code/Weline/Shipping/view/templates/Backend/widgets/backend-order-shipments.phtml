<?php
/**
 * @widget.source {Weline_Shipping::css/widgets/widget-backend-order-shipments.css}
 * 后台订单详情：发货/物流记录（Shipping 默认注入）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {backend-order-shipments}
 * @widget.name {订单发货记录}
 * @widget.description {订单后台详情发货记录槽：从 OrderShipment 投影；默认注入 backend-order-shipments；内联展示物流进程记录。}
 * @widget.type {content}
 * @widget.area {backend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["backend-order-view"]}
 * @widget.slot {backend-order-shipments}
 * @widget.supports {["backend-order-shipments","order-shipments","shipping-shipments","shipping"]}
 * @widget.default_injections {[{"layout_type":"backend-order-view","layout_option":"default","slot":"backend-order-shipments","area":"content","sort_order":15,"required":true,"reason":"订单详情发货记录默认由配送模块提供","config":{"title":"发货记录"}}]}
 *
 * @param title {default="发货记录",type="string",label="标题"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Order\Model\Order;
use Weline\Shipping\Service\BackendOrderShipmentsService;
use Weline\Shipping\Service\OrderShipmentTrackingQueryService;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('backend-order-shipments');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$title = '发货记录';
// 仅接受部件配置标题；忽略页面级 assign('title')（如「Weline框架管理员」）污染。
$widgetConfig = $this->getData('config');
$configuredTitle = '';
if (\is_array($widgetConfig)) {
    $configuredTitle = trim((string)($widgetConfig['title'] ?? ''));
}
if ($configuredTitle === '') {
    $configuredTitle = trim((string)($this->getData('widget_title') ?? ''));
}
if ($configuredTitle !== '' && !str_starts_with($configuredTitle, 'Weline_')) {
    $title = $configuredTitle;
}

$order = $this->getData('order');
$orderId = (int)($this->getData('order_id') ?? 0);
if ($orderId <= 0 && $order) {
    $orderData = is_object($order) ? $order->getData() : (array)$order;
    $orderId = (int)($orderData[Order::schema_fields_ID] ?? 0);
}
if ($orderId <= 0) {
    $orderId = (int)($this->request->getParam('id') ?? 0);
}

$returnUrl = trim((string)($this->getData('returnUrl') ?? ''));
if ($returnUrl === '' && $orderId > 0) {
    $returnUrl = 'order/backend/order/edit?id=' . $orderId . '&tab=shipment';
}
$fulfillGrantVersion = (int)($this->getData('fulfill_grant_version') ?? 0);

$requestPath = strtolower(trim((string)($this->request->getUrlPath() ?? '')));
$onOrderEditSurface = str_contains($requestPath, '/order/backend/order/edit')
    || str_contains($requestPath, '/order/backend/order/panel');
$showOpsLink = !$onOrderEditSurface && $orderId > 0;

/** @var BackendOrderShipmentsService $shipmentsService */
$shipmentsService = ObjectManager::getInstance(BackendOrderShipmentsService::class);
/** @var OrderShipmentTrackingQueryService $trackingQuery */
$trackingQuery = ObjectManager::getInstance(OrderShipmentTrackingQueryService::class);
$shipments = $shipmentsService->listForOrderId($orderId);
?>
<div class="w-card <?= $esc($wc) ?>"
     data-widget-style-class="a633806ca07c548c"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>"
     data-testid="backend-order-shipments">
    <div class="w-card__header w-cluster" data-align="center" data-justify="between">
        <h5 class="w-card__title" data-widget-style-class="31332dac1a0ef500"><?= $esc($title) ?></h5>
        <?php if ($showOpsLink): ?>
            <a class="w-button"
               data-tone="neutral"
               data-size="sm"
               href="@backend-url{'order/backend/order/edit'|['id' => $orderId, 'tab' => 'shipment']}"
               data-testid="backend-order-shipments-open-ops"><?= __('办理发货') ?></a>
        <?php endif; ?>
    </div>
    <div class="w-card__body">
        <div class="w-stack" data-widget-style-class="6f1f72c98234c9a2">
            <?php if ($shipments === []): ?>
                <p class="w-text" data-tone="muted" data-size="sm" data-align="center"><?= __('暂无发货记录') ?></p>
            <?php else: ?>
                <?php foreach ($shipments as $row):
                    $sid = (int)($row['shipment_id'] ?? 0);
                    $tn = trim((string)($row['tracking_number'] ?? ''));
                    $carrier = trim((string)($row['carrier'] ?? ''));
                    $track = ($tn !== '' && $sid > 0) ? $trackingQuery->queryByShipmentId($sid) : null;
                    $progress = \is_array($track['progress'] ?? null) ? $track['progress'] : [];
                    $trackingUrl = trim((string)($track['tracking_url'] ?? ''));
                    $trackOk = (bool)($track['ok'] ?? false);
                    $trackMessage = trim((string)($track['message'] ?? ''));
                    ?>
                    <div class="w-stack"
                         data-widget-style-class="b56c3d4b7dba8cd3"
                         data-testid="backend-order-shipment-row"
                         data-shipment-id="<?= $sid ?>">
                        <div class="w-text" data-size="sm">
                            #<?= $sid ?>
                            <?php if ($carrier !== ''): ?> · <?= $esc($carrier) ?><?php endif; ?>
                            ·
                            <?php if ($tn === ''): ?>
                                <span class="w-badge" data-tone="warning"><?= __('待补运单号') ?></span>
                            <?php else: ?>
                                <code data-testid="backend-order-shipment-tracking"><?= $esc($tn) ?></code>
                            <?php endif; ?>
                            <span class="w-badge"
                                  data-tone="<?= $esc((string)($row['status_tone'] ?? 'muted')) ?>"
                                  data-testid="backend-order-shipment-status"><?= $esc((string)($row['status_label'] ?? '')) ?></span>
                        </div>
                        <?php if ($tn === '' && $sid > 0): ?>
                            <w:form method="post" action="@backend-url{'order/backend/shipment/execute'}" class="w-cluster" data-widget-style-class="fe1977536c225e55">
                                <input type="hidden" name="shipment_action" value="update_tracking">
                                <input type="hidden" name="shipment_id" value="<?= $sid ?>">
                                <input type="hidden" name="expected_grant_version" value="<?= $fulfillGrantVersion ?>">
                                <?php if ($returnUrl !== ''): ?><input type="hidden" name="return_url" value="<?= $esc($returnUrl) ?>"><?php endif; ?>
                                <input class="w-input" type="text" name="tracking_number" required placeholder="<?= __('物流单号') ?>" data-size="sm" data-widget-style-class="c2dc5f2a875bd6a4" data-testid="backend-order-shipment-backfill-input">
                                <label class="w-check"><input type="checkbox" name="notify_customer" value="1"> <?= __('通知') ?></label>
                                <button class="w-button" type="submit" data-size="sm" data-testid="backend-order-shipment-backfill"><?= __('补充') ?></button>
                            </w:form>
                        <?php endif; ?>
                        <div class="w-text" data-tone="muted" data-size="sm" data-widget-style-class="475cdc0ffbf52fdf">
                            <?= __('发货时间') ?>：<?= $esc((string)($row['shipped_at'] ?? '—')) ?>
                            · <?= __('送达') ?>：<?= $esc((string)($row['delivered_at'] ?? '—')) ?>
                        </div>
                        <?php if ($tn !== '' && $sid > 0): ?>
                            <div class="w-stack" data-widget-style-class="37a69135d6bbfeb7" data-testid="backend-order-shipment-progress">
                                <h6 class="w-text" data-size="sm" data-widget-style-class="198fba75ccd75907"><?= __('物流进程记录') ?></h6>
                                <?php if (!$trackOk): ?>
                                    <p class="w-text" data-tone="warning" data-size="sm" data-widget-style-class="a8f0696be08211f9" data-testid="backend-order-shipment-progress-empty">
                                        <?= $esc($trackMessage !== '' ? $trackMessage : (string)__('暂无物流进程')) ?>
                                    </p>
                                <?php elseif ($progress === []): ?>
                                    <p class="w-text" data-tone="muted" data-size="sm" data-widget-style-class="da86e845cdd21151" data-testid="backend-order-shipment-progress-empty">
                                        <?= __('承运方尚未回传轨迹节点') ?>
                                    </p>
                                <?php else: ?>
                                    <ol class="w-stack" data-widget-style-class="8439ac01d14d3660" data-testid="backend-order-shipment-progress-list">
                                        <?php foreach ($progress as $step):
                                            $at = trim((string)($step['at'] ?? ''));
                                            $text = trim((string)($step['text'] ?? ''));
                                            if ($text === '') {
                                                continue;
                                            }
                                            ?>
                                            <li class="w-text" data-size="sm" data-widget-style-class="f8ba8289c5d7b423" data-testid="backend-order-shipment-progress-item">
                                                <?php if ($at !== ''): ?>
                                                    <span class="w-text" data-tone="muted"><?= $esc($at) ?></span>
                                                    ·
                                                <?php endif; ?>
                                                <?= $esc($text) ?>
                                            </li>
                                        <?php endforeach; ?>
                                    </ol>
                                <?php endif; ?>
                                <?php if ($trackingUrl !== ''): ?>
                                    <p class="w-text" data-size="sm" data-widget-style-class="d9db45a3251c15a0">
                                        <a class="w-link"
                                           href="<?= $esc($trackingUrl) ?>"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           data-testid="backend-order-shipment-track-url"><?= __('打开承运商轨迹页') ?></a>
                                    </p>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    </div>
</div>
