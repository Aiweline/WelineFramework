<script>
(function () {
    'use strict';

    const messages = <?= json_encode($confirmMessages, $dialogJsonFlags) ?>;
    const initialCountry = <?= json_encode($currentCountryCode, $dialogJsonFlags) ?>;
    const initialCountries = <?= json_encode($currentCountryCodes, $dialogJsonFlags) ?>;
    const countrySeedJson = <?= json_encode($countrySeed, $dialogJsonFlags) ?>;
    const listApiUrl = <?= json_encode($listApiUrl, $dialogJsonFlags) ?>;
    const i18n = {
        pickCountry: <?= json_encode((string)__('请先在上方筛选中选择国家。'), $dialogJsonFlags) ?>,
        loading: <?= json_encode((string)__('正在加载地区…'), $dialogJsonFlags) ?>,
        loadFail: <?= json_encode((string)__('地区加载失败，请稍后重试。'), $dialogJsonFlags) ?>,
        empty: <?= json_encode((string)__('当前国家暂无地区数据，请先执行 shipping:addresscatalog:import 或手动添加。'), $dialogJsonFlags) ?>,
        active: <?= json_encode((string)__('启用'), $dialogJsonFlags) ?>,
        inactive: <?= json_encode((string)__('禁用'), $dialogJsonFlags) ?>,
        needCountry: <?= json_encode((string)__('请先选择国家。'), $dialogJsonFlags) ?>,
        needProvince: <?= json_encode((string)__('请填写要新增的省份名称与代码。'), $dialogJsonFlags) ?>,
        needDistrictCode: <?= json_encode((string)__('请填写要新增的区县代码。'), $dialogJsonFlags) ?>,
        needDistrictName: <?= json_encode((string)__('请填写要新增的区县名称。'), $dialogJsonFlags) ?>,
        codeExists: <?= json_encode((string)__('该地区代码已存在，不能重复添加。'), $dialogJsonFlags) ?>
    };

    var listCache = {};
    var listRequestSeq = 0;

    function text(value) {
        return value == null ? '' : String(value).trim();
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function countryCodeOf(row) {
        return text(row && (row.country_code || row.region_code)).toUpperCase();
    }

    function parseSelection(root) {
        try {
            var raw = root.getAttribute('data-multi-selection') || '[]';
            var list = JSON.parse(raw);
            return Array.isArray(list) ? list : [];
        } catch (e) {
            return [];
        }
    }

    function uniqueSortedCodes(codes) {
        var map = {};
        (codes || []).forEach(function (code) {
            code = text(code).toUpperCase();
            if (/^[A-Z]{2}$/.test(code)) {
                map[code] = true;
            }
        });
        return Object.keys(map).sort();
    }

    function sameCodeSet(a, b) {
        return uniqueSortedCodes(a).join(',') === uniqueSortedCodes(b).join(',');
    }

    function syncUrlCountries(codes) {
        codes = uniqueSortedCodes(codes);
        var url = new URL(window.location.href);
        var currentMulti = uniqueSortedCodes((url.searchParams.get('country_codes') || '').split(/[,\s]+/));
        var currentSingle = text(url.searchParams.get('country_code')).toUpperCase();
        var current = currentMulti.length ? currentMulti : (currentSingle ? [currentSingle] : []);
        if (sameCodeSet(current, codes)) {
            return;
        }
        if (codes.length === 0) {
            url.searchParams.delete('country_code');
            url.searchParams.delete('country_codes');
        } else if (codes.length === 1) {
            url.searchParams.set('country_code', codes[0]);
            url.searchParams.delete('country_codes');
        } else {
            url.searchParams.set('country_codes', codes.join(','));
            url.searchParams.delete('country_code');
        }
        if (window.history && typeof window.history.replaceState === 'function') {
            window.history.replaceState({}, '', url.toString());
        }
    }

    function collectSelectionCountries(selected) {
        var codes = {};
        (selected || []).forEach(function (row) {
            var code = countryCodeOf(row);
            if (/^[A-Z]{2}$/.test(code)) {
                codes[code] = true;
            }
        });
        return Object.keys(codes).sort();
    }

    function statusEl() {
        return document.querySelector('[data-region-list-status]');
    }

    function setStatus(tone, message, visible) {
        var el = statusEl();
        if (!el) {
            return;
        }
        el.setAttribute('data-tone', tone || 'info');
        el.textContent = message || '';
        el.hidden = !visible;
    }

    function tableWrap() {
        return document.querySelector('[data-region-table-wrap]');
    }

    function tableBody() {
        return document.querySelector('[data-region-tree-body]');
    }

    function childrenUrl(countryCode) {
        var url = new URL(listApiUrl, window.location.origin);
        url.searchParams.set('mode', 'children');
        url.searchParams.set('country_code', countryCode);
        url.searchParams.set('limit', '500');
        return url.toString();
    }

    function fetchProvinces(countryCode) {
        if (listCache[countryCode]) {
            return Promise.resolve(listCache[countryCode]);
        }
        return fetch(childrenUrl(countryCode), {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (!res.ok) {
                throw new Error('HTTP ' + res.status);
            }
            return res.json();
        }).then(function (payload) {
            var rows = payload && payload.data;
            if (!Array.isArray(rows)) {
                rows = [];
            }
            listCache[countryCode] = rows;
            return rows;
        });
    }

    function renderRows(rows) {
        var body = tableBody();
        var wrap = tableWrap();
        if (!body || !wrap) {
            return;
        }
        if (!rows.length) {
            body.innerHTML = '';
            wrap.hidden = true;
            return;
        }
        var html = rows.map(function (row) {
            var regionId = Number(row.region_id || 0) || 0;
            var parentId = Number(row.parent_region_id || 0) || 0;
            var countryCode = text(row.country_code || row.region_code).toUpperCase();
            if (!/^[A-Z]{2}$/.test(countryCode)) {
                countryCode = '';
            }
            var active = row.is_active === undefined || row.is_active === null || Number(row.is_active) === 1;
            return '<tr data-region-row'
                + ' data-region-id="' + escapeHtml(regionId) + '"'
                + ' data-parent-id="' + escapeHtml(parentId) + '"'
                + ' data-country-code="' + escapeHtml(countryCode) + '"'
                + ' data-region-code="' + escapeHtml(row.region_code || '') + '"'
                + ' data-region-type="' + escapeHtml(row.region_type || 'province') + '"'
                + ' data-ancestor-ids="' + escapeHtml(regionId > 0 ? String(regionId) : '') + '">'
                + '<td>' + escapeHtml(row.region_name || '') + '</td>'
                + '<td>' + escapeHtml(row.region_code || '') + '</td>'
                + '<td>' + escapeHtml(row.region_type || 'province') + '</td>'
                + '<td><span class="w-badge" data-w-background="' + (active ? 'success' : 'muted') + '">'
                + escapeHtml(active ? i18n.active : i18n.inactive)
                + '</span></td></tr>';
        }).join('');
        body.innerHTML = html;
        wrap.hidden = false;
    }

    function applySelectionFilter(selected) {
        var table = document.querySelector('[data-region-tree-table]');
        if (!table) {
            return;
        }
        var rows = table.querySelectorAll('[data-region-row]');
        if (!selected || !selected.length) {
            rows.forEach(function (row) { row.hidden = false; });
            return;
        }

        var countryOnly = {};
        var provinceFocusIds = {};
        selected.forEach(function (row) {
            var type = text(row.region_type);
            var code = countryCodeOf(row);
            if (!/^[A-Z]{2}$/.test(code)) {
                return;
            }
            if (type === 'country') {
                countryOnly[code] = true;
                return;
            }
            var provinceId = 0;
            if (type === 'province') {
                provinceId = Number(row.region_id || 0) || 0;
            } else if (type === 'city') {
                provinceId = Number(row.parent_region_id || row.province_region_id || 0) || 0;
            } else if (type === 'district') {
                provinceId = Number(row.province_region_id || row.parent_region_id || 0) || 0;
            }
            if (provinceId > 0) {
                provinceFocusIds[provinceId] = true;
                delete countryOnly[code];
            }
        });

        var focusIdList = Object.keys(provinceFocusIds).map(Number);
        rows.forEach(function (row) {
            var id = Number(row.getAttribute('data-region-id') || 0) || 0;
            var rowCountry = text(row.getAttribute('data-country-code')).toUpperCase();
            var keep = false;
            if (rowCountry && countryOnly[rowCountry]) {
                keep = true;
            }
            if (!keep && focusIdList.length && focusIdList.indexOf(id) > -1) {
                keep = true;
            }
            row.hidden = !keep;
        });
    }

    function loadProvinceList(countryCodes, selected) {
        countryCodes = uniqueSortedCodes(countryCodes);
        var seq = ++listRequestSeq;
        if (!countryCodes.length) {
            renderRows([]);
            setStatus('info', i18n.pickCountry, true);
            return Promise.resolve();
        }
        setStatus('info', i18n.loading, true);
        return Promise.all(countryCodes.map(fetchProvinces)).then(function (chunks) {
            if (seq !== listRequestSeq) {
                return;
            }
            var merged = [];
            chunks.forEach(function (rows) {
                (rows || []).forEach(function (row) { merged.push(row); });
            });
            renderRows(merged);
            if (!merged.length) {
                setStatus('info', i18n.empty, true);
            } else {
                setStatus('info', '', false);
                applySelectionFilter(selected || []);
            }
        }).catch(function () {
            if (seq !== listRequestSeq) {
                return;
            }
            renderRows([]);
            setStatus('warning', i18n.loadFail, true);
        });
    }

    function bindCreateCountry(root) {
        if (!root || root.dataset.regionCreateCountryBound === '1') {
            return;
        }
        root.dataset.regionCreateCountryBound = '1';
        var form = root.closest('form');
        var codeHidden = document.getElementById('shipping-region-create-country-code');
        var nameHidden = document.getElementById('shipping-region-create-country-name');

        function syncCountry() {
            var metaCode = form ? form.querySelector('input[name="country_code"]') : null;
            var pick = form ? form.querySelector('input[name="address_country_pick"]') : null;
            var visible = root.querySelector('.w-address__input');
            var code = text(metaCode && metaCode.value).toUpperCase();
            if (!/^[A-Z]{2}$/.test(code)) {
                code = text(codeHidden && codeHidden.value).toUpperCase();
            }
            var label = text(pick && pick.value) || text(visible && visible.value);
            if (codeHidden && /^[A-Z]{2}$/.test(code)) {
                codeHidden.value = code;
            }
            if (nameHidden && label && !/^[A-Z]{2}$/.test(label)) {
                nameHidden.value = label;
            }
        }

        if (/^[A-Z]{2}$/.test(initialCountry) && window.WelineThemeAddress && typeof window.WelineThemeAddress.applyValues === 'function') {
            window.WelineThemeAddress.applyValues(root, {
                country_code: initialCountry,
                country: initialCountry
            }).then(function () { syncCountry(); }).catch(function () { syncCountry(); });
        }

        root.addEventListener('change', syncCountry);
        root.addEventListener('input', syncCountry);
        if (form) {
            form.addEventListener('change', syncCountry);
            form.addEventListener('input', syncCountry);
        }
        syncCountry();
    }

    function existingCodesForCountry(country) {
        var codes = {};
        country = text(country).toUpperCase();
        document.querySelectorAll('[data-region-tree-table] [data-region-row]').forEach(function (row) {
            var rowCountry = text(row.getAttribute('data-country-code')).toUpperCase();
            var code = text(row.getAttribute('data-region-code')).toUpperCase();
            if (country && rowCountry === country && code) {
                codes[code] = true;
            }
        });
        return codes;
    }

    function bindCreateForm(form) {
        if (!form || form.dataset.regionCreateFormBound === '1') {
            return;
        }
        form.dataset.regionCreateFormBound = '1';
        form.addEventListener('submit', function (event) {
            var countryInput = form.querySelector('[name="country_code"]');
            var provinceName = text((form.querySelector('[name="add_province_name"]') || {}).value);
            var provinceCode = text((form.querySelector('[name="add_province_code"]') || {}).value).toUpperCase();
            var districtName = text((form.querySelector('[name="add_district_name"]') || {}).value);
            var districtCode = text((form.querySelector('[name="add_district_code"]') || {}).value).toUpperCase();
            var country = text(countryInput && countryInput.value).toUpperCase();
            var message = '';
            if (!/^[A-Z]{2}$/.test(country)) {
                message = i18n.needCountry;
            } else if (!provinceName || !provinceCode) {
                message = i18n.needProvince;
            } else if (districtName && !districtCode) {
                message = i18n.needDistrictCode;
            } else if (districtCode && !districtName) {
                message = i18n.needDistrictName;
            } else {
                var existing = existingCodesForCountry(country);
                if (existing[provinceCode] && !districtName) {
                    message = i18n.codeExists;
                } else if (districtCode && existing[districtCode]) {
                    message = i18n.codeExists;
                }
            }
            if (!message) {
                return;
            }
            event.preventDefault();
            if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.request === 'function') {
                Weline.UI.dialog.request({
                    tone: 'warning',
                    title: messages.confirmTitle,
                    message: message,
                    cancelable: false,
                    confirmLabel: messages.confirmButton
                });
            } else {
                window.alert(message);
            }
        });
    }

    function bindFilterAddress(root) {
        if (!root || root.dataset.regionFilterBound === '1') {
            return;
        }
        root.dataset.regionFilterBound = '1';
        try { root.setAttribute('data-multi-seed', JSON.stringify(countrySeedJson || [])); } catch (e) {}
        var loadedCountries = [];

        function sync() {
            var selected = parseSelection(root);
            var neededCountries = collectSelectionCountries(selected);
            if (!neededCountries.length && initialCountries.length && !selected.length) {
                neededCountries = uniqueSortedCodes(initialCountries);
            }
            syncUrlCountries(neededCountries);
            if (!sameCodeSet(neededCountries, loadedCountries)) {
                loadedCountries = neededCountries.slice();
                loadProvinceList(neededCountries, selected);
                return;
            }
            applySelectionFilter(selected);
        }

        root.addEventListener('weline:address:multi-change', sync);
        sync();
    }

    function bootAddress() {
        if (!window.WelineThemeAddress || typeof window.WelineThemeAddress.boot !== 'function') {
            return false;
        }
        var createRoot = document.querySelector('[data-address-code="shipping-region-create-country"]')
            || document.querySelector('[data-testid="shipping-region-create-country"] [data-w-address]');
        var filterRoot = document.querySelector('[data-address-code="shipping-region-filter"]')
            || document.querySelector('[data-testid="shipping-region-filter-address"] [data-w-address]');
        if (createRoot) {
            createRoot.dataset.wAddressReady = '';
        }
        if (filterRoot) {
            try { filterRoot.setAttribute('data-multi-seed', JSON.stringify(countrySeedJson || [])); } catch (e) {}
            filterRoot.dataset.wAddressReady = '';
        }
        window.WelineThemeAddress.boot();
        bindCreateCountry(createRoot);
        bindCreateForm(document.querySelector('[data-testid="shipping-region-create-form-el"]'));
        bindFilterAddress(filterRoot);
        if (!filterRoot && initialCountries.length) {
            loadProvinceList(initialCountries, []);
        }
        return true;
    }

    var bootTries = 0;
    function waitBoot() {
        if (bootAddress()) {
            return;
        }
        bootTries += 1;
        if (bootTries < 120) {
            setTimeout(waitBoot, 50);
        } else if (initialCountries.length) {
            loadProvinceList(initialCountries, []);
        } else {
            setStatus('info', i18n.pickCountry, true);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', waitBoot);
    } else {
        waitBoot();
    }
})();
</script>
