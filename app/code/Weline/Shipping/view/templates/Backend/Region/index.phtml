<?php
/** @var \Weline\Framework\View\Template $this */
/** @var \Weline\Backend\Block\ThemeConfig $themeConfig */

$currentCountryCode = strtoupper(trim((string)($this->getData('current_country_code') ?? '')));
$currentCountryCodes = $this->getData('current_country_codes') ?? [];
if (!is_array($currentCountryCodes) || $currentCountryCodes === []) {
    $currentCountryCodes = $currentCountryCode !== '' ? [$currentCountryCode] : [];
}
$currentCountryCodes = array_values(array_unique(array_filter(array_map(
    static fn ($code): string => strtoupper(trim((string)$code)),
    $currentCountryCodes
), static fn (string $code): bool => preg_match('/^[A-Z]{2}$/D', $code) === 1)));
if ($currentCountryCodes === []) {
    $currentCountryCodes = ['CN'];
}
if ($currentCountryCode === '' || !preg_match('/^[A-Z]{2}$/D', $currentCountryCode)) {
    $currentCountryCode = $currentCountryCodes[0];
}
$embed = $this->getData('embed') ?? false;
$dialogJsonFlags = JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_THROW_ON_ERROR;
$confirmMessages = [
    'confirmTitle' => (string)__('确认操作'),
    'confirmButton' => (string)__('确定'),
    'cancelButton' => (string)__('取消'),
];

// 仅码级 seed，不查库；正式国名由 theme:address / region API 异步解析。
$countrySeed = [];
foreach ($currentCountryCodes as $seedCode) {
    $countrySeed[] = [
        'region_type' => 'country',
        'country_code' => $seedCode,
        'region_code' => $seedCode,
        'region_id' => 0,
        'region_name' => $seedCode,
        'label' => $seedCode,
    ];
}
$listApiUrl = (string)w_url('/shipping/frontend/region/list', [], 'frontend');
