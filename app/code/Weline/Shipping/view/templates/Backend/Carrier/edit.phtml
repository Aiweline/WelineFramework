                                                    : null;
                                                if (!root) {
                                                    root = document.querySelector('[data-address-code="carrier-coverage"]');
                                                }
                                                if (!root) return;
                                                function sync() {
                                                    var raw = root.getAttribute('data-multi-selection') || '[]';
                                                    try { JSON.parse(raw); hidden.value = raw; } catch (e) {}
                                                }
                                                root.addEventListener('weline:address:multi-change', sync);
                                                try {
                                                    root.setAttribute('data-multi-seed', hidden.value || '[]');
                                                    root.setAttribute('data-multi-defaults', <?= json_encode($this->getData('coverage_defaults_json') ?: '[]') ?>);
                                                } catch (e) {}
                                                function boot() {
                                                    if (!window.WelineThemeAddress || typeof window.WelineThemeAddress.boot !== 'function') {
                                                        return false;
                                                    }
                                                    root.dataset.wAddressReady = '';
                                                    window.WelineThemeAddress.boot();
                                                    sync();
                                                    return true;
                                                }
                                                window.__welineShippingAddressReady = function () {
                                                    if (!boot()) {
                                                        setTimeout(boot, 50);
                                                    }
                                                };
                                                if (window.WelineThemeAddress) {
                                                    window.__welineShippingAddressReady();
                                                }
                                                var form = hidden.closest('form');
                                                if (form && !form.dataset.coverageConfirmBound) {
                                                    form.dataset.coverageConfirmBound = '1';
                                                    form.addEventListener('submit', function (ev) {
                                                        sync();
                                                        var keep = document.getElementById('coverage_keep_current');
                                                        var applyingDefaults = !(keep && keep.checked);
                                                        var baseline = hidden.getAttribute('data-coverage-baseline') || '[]';
