<script>
(function () {
    var form = document.querySelector('[data-testid="system-embargo-add-form"]');
    if (!form || form.dataset.systemEmbargoBound === '1') {
        return;
    }
    form.dataset.systemEmbargoBound = '1';
    form.addEventListener('submit', function (event) {
        var codeInput = form.querySelector('[name="country_code"]');
        var code = String(codeInput && codeInput.value || '').trim().toUpperCase();
        if (!/^[A-Z]{2}$/.test(code)) {
            event.preventDefault();
            window.alert(<?= json_encode((string)__('请先用地址选择器选择国家/地区'), $jsonFlags) ?>);
            return;
        }
        var provinceId = String(form.querySelector('[name="province_region_id"]') && form.querySelector('[name="province_region_id"]').value || '').trim();
        var provinceCode = String(form.querySelector('[name="province_code"]') && form.querySelector('[name="province_code"]').value || '').trim();
        // 仅国家或国家+省份均可；校验由服务端二次确认。
        if (provinceId === '' && provinceCode === '') {
            return;
        }
    });
})();
</script>
