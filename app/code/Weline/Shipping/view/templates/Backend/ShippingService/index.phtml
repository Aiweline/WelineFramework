$laneLabelsByService = $this->getData('lane_labels_by_service') ?? [];
$embed = $this->getData('embed') ?? false;

$carrier_names_by_id = [];
foreach ($carriers as $carrier) {
    if (!$carrier instanceof Carrier) {
        continue;
    }
    $carrier_names_by_id[(int)$carrier->getId()] = (string)$carrier->getData(Carrier::schema_fields_CARRIER_NAME);
}

$template_names_by_id = [];
foreach ($templates as $tpl) {
    if (!$tpl instanceof RateTemplate) {
        continue;
    }
    $template_names_by_id[(int)$tpl->getId()] = (string)$tpl->getData(RateTemplate::schema_fields_TEMPLATE_NAME);
}

$origin_names_by_id = [];
foreach ($origins as $origin) {
    if (!$origin instanceof ShippingAddress) {
        continue;
    }
    $origin_names_by_id[(int)$origin->getId()] = (string)$origin->getData(ShippingAddress::schema_fields_NAME);
}
