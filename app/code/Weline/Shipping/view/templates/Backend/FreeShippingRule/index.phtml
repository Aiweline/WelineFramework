    'scope_kind' => (string)($this->getData('scope_kind') ?? ''),
    'embed' => !empty($embed) ? '1' : '',
], static fn ($v) => $v !== '' && $v !== null);
$scopeQuery = http_build_query($scopeQueryBase);
$scopeQs = $scopeQuery !== '' ? '?' . $scopeQuery : '';
$h = static fn (string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
$activateUrl = $h($this->getBackendUrl('shipping/backend/freeshippingrule/activate') . $scopeQs);
$deactivateUrl = $h($this->getBackendUrl('shipping/backend/freeshippingrule/deactivate') . $scopeQs);
$removeUrl = $h($this->getBackendUrl('shipping/backend/freeshippingrule/remove') . $scopeQs);
$indexBase = rtrim((string)$this->getBackendUrl('shipping/backend/freeshippingrule/index'), '?&');
$sectionUrl = static function (string $section) use ($scopeQueryBase, $indexBase, $h): string {
    $q = $scopeQueryBase;
    $q['section'] = $section;
    return $h($indexBase . '?' . http_build_query($q));
};
