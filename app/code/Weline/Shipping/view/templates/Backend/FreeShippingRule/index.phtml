                (function () {
                    var hidden = document.getElementById('free_region_selection');
                    if (!hidden) return;
                    var root = document.querySelector('[data-address-code="free-rule-region"]');
                    if (!root) return;
                    function sync() {
                        var raw = root.getAttribute('data-multi-selection') || '[]';
                        try { JSON.parse(raw); hidden.value = raw; } catch (e) {}
                    }
                    root.addEventListener('weline:address:multi-change', sync);
                    function boot() {
                        if (!window.WelineThemeAddress || typeof window.WelineThemeAddress.boot !== 'function') return false;
                        root.dataset.wAddressReady = '';
                        window.WelineThemeAddress.boot();
                        sync();
                        return true;
                    }
                    if (!boot()) {
                        document.addEventListener('DOMContentLoaded', boot);
                        setTimeout(boot, 400);
                    }
                })();
