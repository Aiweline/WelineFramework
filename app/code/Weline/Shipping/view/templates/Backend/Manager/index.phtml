<?php
/**
 * 配送总览入口：不再 iframe 嵌套分区。
 * 按 ?tab= 跳转到真实后台页，便于侧栏菜单定位与主题整页渲染。
 *
 * @var string $activeTab
 * @var string $redirectUrl
 * @var \Weline\Framework\View\Template $this
 */
$activeTab = (string)($activeTab ?? 'region');
$redirectUrl = (string)($redirectUrl ?? '');
$h = static fn(string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
?>
<div class="w-stack" data-gap="md" data-testid="shipping-overview-management">
    <?= $this->fetch('Weline_Shipping::templates/Backend/partials/manager-tabs.phtml', ['activeTab' => $activeTab]) ?>
    <div class="w-alert" data-tone="info">
        <w:icon name="info" size="sm"></w:icon>
        <div class="w-alert__content">
            <strong class="w-alert__title"><lang>配送管理</lang></strong>
            <p><lang>各分区已改为整页主题界面（不再使用 iframe）。请点击上方 Tab，或使用左侧菜单进入对应功能。</lang></p>
            <?php if ($redirectUrl !== ''): ?>
                <p>
                    <a class="w-button" data-tone="primary" data-size="sm" href="<?= $h($redirectUrl) ?>">
                        <lang>打开当前分区</lang>
                    </a>
                </p>
            <?php endif; ?>
        </div>
    </div>
</div>
