                                RateTemplate::CALC_TYPE_MIXED => (string)__('混合计费'),
                            ];
                            ?>
                            <?php foreach ($templates as $template): ?>
                                <?php /** @var RateTemplate $template */ ?>
                                <?php
                                $rowId = (int)$template->getData(RateTemplate::schema_fields_ID);
                                $rowCode = (string)$template->getData(RateTemplate::schema_fields_TEMPLATE_CODE);
                                $rowCurrency = strtoupper(trim((string)$template->getData(RateTemplate::schema_fields_CURRENCY_CODE))) ?: $baseCurrency;
                                $calcKey = (string)$template->getData(RateTemplate::schema_fields_CALCULATION_TYPE);
                                $calcLabel = $calcLabels[$calcKey] ?? $calcKey;
                                $isSeed = str_starts_with(strtoupper($rowCode), 'SEED_TPL_');
                                $fmtRate = static function ($value): string {
                                    if ($value === null || $value === '') {
                                        return '0.00';
                                    }

                                    return is_numeric($value) ? number_format((float)$value, 4, '.', '') : (string)$value;
                                };
                                $fmtMoney = static function ($value): string {
                                    if ($value === null || $value === '') {
                                        return '0.00';
                                    }

                                    return is_numeric($value) ? number_format((float)$value, 2, '.', '') : (string)$value;
                                };
                                ?>
