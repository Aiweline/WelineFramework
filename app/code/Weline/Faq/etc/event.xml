<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Theme::layout_resolve">
        <observer name="Weline_Faq::layout_resolve"
                  instance="Weline\Faq\Observer\LayoutResolveObserver"
                  disabled="false"
                  shared="true"
                  sort="40"/>
    </event>
    <event name="Weline_Theme::layout_preview_sample">
        <observer name="Weline_Faq::layout_preview_sample"
                  instance="Weline\Faq\Observer\LayoutPreviewSampleObserver"
                  disabled="false"
                  shared="true"
                  sort="40"/>
    </event>
    <event name="Weline_Framework_Router::process_uri_before">
        <observer name="Weline_Faq::claim_faq_namespace_uri_before"
                  instance="Weline\Faq\Observer\ClaimFaqNamespaceUriBefore"
                  disabled="false"
                  shared="true"
                  sort="-16"/>
    </event>
    <event name="Weline_Faq::item_search_index_changed">
        <observer name="Weline_Faq::item_search_index_sync"
                  instance="Weline\Faq\Observer\FaqItemSearchIndexObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Framework_Setup::before_schema_diff_commit">
        <observer name="Weline_Faq::before_schema_diff_commit_heal_faq_key"
                  instance="Weline\Faq\Observer\BeforeSchemaDiffCommitObserver"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>
</config>
