<?php
/**
 * Faq backend listing: pages grouped by website — Weline UI 2.0.
 *
 * 原型（对照 PlatformAppStore Module listing）：
 * [布局已有 heading] → 本区仅筛选工具条
 * [按网站分组：站头 + 主 CTA] → w-table / w-empty
 *
 * @var \Weline\Framework\View\Template $this
 */
$siteGroups = $this->getData('site_groups') ?: [];
$websites = $this->getData('websites') ?: [];
$websiteIdFilter = (string)($this->getData('website_id') ?: '');
$search = (string)($this->getData('search') ?: '');
$status = (string)($this->getData('status') ?: '');
$listingUrl = (string)($this->getData('listing_url') ?: '');
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$statusLabels = [
    'draft' => (string)__('草稿'),
    'published' => (string)__('已发布'),
    'disabled' => (string)__('已禁用'),
];
$hasFilters = $websiteIdFilter !== '' || $search !== '' || $status !== '';
$statusTone = static function (string $st): string {
    return match ($st) {
        'published' => 'success',
        'disabled' => 'danger',
        default => 'neutral',
    };
};
?>
<div class="w-container faq-page-admin" style="--w-pt:0;--w-pb:var(--weline-space-2);" data-testid="faq-page-listing">
    <form method="get" action="<?= $escape($listingUrl) ?>" class="w-cluster" data-align="center" data-wrap="true"
          style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);" data-testid="faq-page-filters">
        <select class="w-select" name="website_id" aria-label="<?= $escape(__('网站')) ?>" data-size="sm"
                style="width:auto;max-inline-size:16rem;flex:0 1 14rem;">
            <option value=""><?= $escape(__('全部网站')) ?></option>
            <?php foreach ($websites as $website): ?>
                <?php if (!is_array($website)) { continue; } ?>
                <?php $wid = (string)(int)($website['website_id'] ?? 0); ?>
                <option value="<?= $escape($wid) ?>" <?= $websiteIdFilter === $wid ? 'selected' : '' ?>>
                    <?= $escape($website['label'] ?? $website['name'] ?? $website['code'] ?? $wid) ?>
                </option>
            <?php endforeach; ?>
        </select>
        <input class="w-input" type="search" name="search" value="<?= $escape($search) ?>"
               aria-label="<?= $escape(__('搜索')) ?>"
               placeholder="<?= $escape(__('搜索标题/slug')) ?>"
               data-size="sm" style="width:auto;max-inline-size:16rem;flex:1 1 12rem;">
        <select class="w-select" name="status" aria-label="<?= $escape(__('状态')) ?>" data-size="sm"
                style="width:auto;max-inline-size:10rem;flex:0 1 8rem;">
            <option value=""><?= $escape(__('全部状态')) ?></option>
            <?php foreach ($statusLabels as $value => $label): ?>
                <option value="<?= $escape($value) ?>" <?= $status === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
            <?php endforeach; ?>
        </select>
        <button class="w-button" type="submit" data-tone="neutral" data-variant="outline" data-size="sm"><?= $escape(__('筛选')) ?></button>
        <?php if ($hasFilters): ?>
            <a class="w-button" href="<?= $escape($listingUrl) ?>" data-tone="neutral" data-variant="ghost" data-size="sm"><?= $escape(__('清空')) ?></a>
        <?php endif; ?>
    </form>

    <?php if ($siteGroups === []): ?>
        <div class="w-empty" data-testid="faq-page-empty-sites" style="min-height:max(14rem, calc(100dvh - 16rem));">
            <w:icon name="globe" size="lg"></w:icon>
            <div style="max-inline-size:24rem;">
                <div class="w-text" data-weight="strong" style="--w-mb:var(--weline-space-1);"><?= $escape(__('暂无网站')) ?></div>
                <div class="w-text" data-tone="muted" data-size="sm"><?= $escape(__('请先在 Websites 模块配置站点，然后再管理帮助中心页面。')) ?></div>
            </div>
        </div>
    <?php endif; ?>

    <?php foreach ($siteGroups as $group): ?>
        <?php if (!is_array($group)) { continue; } ?>
        <?php
        $pages = is_array($group['pages'] ?? null) ? $group['pages'] : [];
        $siteLabel = (string)($group['label'] ?? '');
        $siteUrl = (string)($group['url'] ?? '');
        $newUrl = (string)($group['new_url'] ?? '');
        ?>
        <section class="faq-page-admin__site" style="--w-mb:var(--weline-space-5);margin-block-end:var(--weline-space-5);" data-testid="faq-page-site-group">
            <div class="w-toolbar" style="--w-mb:var(--weline-space-3);">
                <div>
                    <div class="w-text" data-weight="strong"><?= $escape($siteLabel) ?></div>
                    <div class="w-text" data-tone="muted" data-size="sm">
                        ID <?= (int)($group['website_id'] ?? 0) ?>
                        · <?= $escape($group['website_code'] ?? '') ?>
                        <?php if ($siteUrl !== ''): ?> · <?= $escape($siteUrl) ?><?php endif; ?>
                        · <?= $escape(__('文章')) ?> <?= count($pages) ?>
                    </div>
                </div>
                <?php if ($newUrl !== ''): ?>
                    <a class="w-button" href="<?= $escape($newUrl) ?>" data-tone="primary" data-size="sm">
                        <w:icon name="plus" size="sm"></w:icon><?= $escape(__('在此网站新建')) ?>
                    </a>
                <?php endif; ?>
            </div>

            <?php if ($pages === []): ?>
                <div class="w-empty" data-testid="faq-page-empty-site" style="min-height:10rem;">
                    <w:icon name="file" size="md"></w:icon>
                    <div style="max-inline-size:22rem;">
                        <div class="w-text" data-weight="strong" style="--w-mb:var(--weline-space-1);"><?= $escape(__('该网站暂无帮助文章')) ?></div>
                        <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-3);"><?= $escape(__('新建后可在可视化编辑器中编排 faq 布局内容。')) ?></div>
                        <?php if ($newUrl !== ''): ?>
                            <a class="w-button" href="<?= $escape($newUrl) ?>" data-tone="primary" data-size="sm">
                                <w:icon name="plus" size="sm"></w:icon><?= $escape(__('在此网站新建')) ?>
                            </a>
                        <?php endif; ?>
                    </div>
                </div>
            <?php else: ?>
                <div class="w-table-wrap">
                    <table class="w-table" data-w-vertical="middle">
                        <thead>
                        <tr>
                            <th><?= $escape(__('ID')) ?></th>
                            <th><?= $escape(__('标题')) ?></th>
                            <th><?= $escape(__('公开路径')) ?></th>
                            <th><?= $escape(__('状态')) ?></th>
                            <th><?= $escape(__('操作')) ?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php foreach ($pages as $page): ?>
                            <?php if (!is_array($page)) { continue; } ?>
                            <?php $st = strtolower(trim((string)($page['status'] ?? 'draft'))); ?>
                            <tr>
                                <td><?= (int)($page['page_id'] ?? 0) ?></td>
                                <td>
                                    <div class="w-text" data-weight="strong"><?= $escape($page['title'] ?? '') ?></div>
                                </td>
                                <td><code><?= $escape($page['public_path'] ?? '') ?></code></td>
                                <td>
                                    <span class="w-badge" data-tone="<?= $escape($statusTone($st)) ?>">
                                        <?= $escape($statusLabels[$st] ?? $st) ?>
                                    </span>
                                </td>
                                <td>
                                    <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                                        <a class="w-button" href="<?= $escape($page['edit_url'] ?? '#') ?>" data-tone="neutral" data-variant="ghost" data-size="sm"><?= $escape(__('管理')) ?></a>
                                        <?php if (!empty($page['theme_editor_url'])): ?>
                                            <a class="w-button" href="<?= $escape($page['theme_editor_url']) ?>" target="_blank" rel="noopener" data-tone="neutral" data-variant="outline" data-size="sm"><?= $escape(__('可视化编辑')) ?></a>
                                        <?php endif; ?>
                                        <?php if (!empty($page['cms_edit_url'])): ?>
                                            <a class="w-button" href="<?= $escape($page['cms_edit_url']) ?>" data-tone="neutral" data-variant="ghost" data-size="sm"><?= $escape(__('CMS 字段')) ?></a>
                                        <?php endif; ?>
                                    </div>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php endif; ?>
        </section>
    <?php endforeach; ?>
</div>
