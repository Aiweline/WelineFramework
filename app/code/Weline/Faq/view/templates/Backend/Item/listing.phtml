<?php
/**
 * FAQ item listing (minimal usable admin).
 *
 * @var \Weline\Framework\View\Template $this
 */
$items = $this->getData('items') ?: [];
$websites = $this->getData('websites') ?: [];
$typeCodes = $this->getData('type_codes') ?: [];
$websiteId = (string)($this->getData('website_id') ?: '');
$typeCode = (string)($this->getData('type_code') ?: '');
$status = (string)($this->getData('status') ?: '');
$search = (string)($this->getData('search') ?: '');
$listingUrl = (string)($this->getData('listing_url') ?: '');
$editUrl = (string)($this->getData('edit_url') ?: '');
$newUrl = (string)($this->getData('new_url') ?: '');
$deleteUrl = (string)($this->getData('delete_url') ?: '');
$total = (int)($this->getData('total') ?: 0);
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<div class="faq-item-admin">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1"><?= $escape(__('FAQ 条目')) ?></h1>
            <div class="text-muted small"><?= $escape(__('管理站点 / 商品等实体的问答条目。共 %{1} 条。', [$total])) ?></div>
        </div>
        <a class="btn btn-sm btn-primary" href="<?= $escape($newUrl) ?>"><?= $escape(__('新建')) ?></a>
    </div>
    <form method="get" action="<?= $escape($listingUrl) ?>" class="d-flex flex-wrap gap-2 mb-3">
        <select class="form-select form-select-sm" name="website_id" style="min-width:180px">
            <option value=""><?= $escape(__('全部网站')) ?></option>
            <?php foreach ($websites as $website): ?>
                <?php if (!is_array($website)) { continue; } ?>
                <?php $wid = (string)(int)($website['website_id'] ?? 0); ?>
                <option value="<?= $escape($wid) ?>" <?= $websiteId === $wid ? 'selected' : '' ?>>
                    <?= $escape($website['label'] ?? $wid) ?>
                </option>
            <?php endforeach; ?>
        </select>
        <select class="form-select form-select-sm" name="type_code" style="min-width:140px">
            <option value=""><?= $escape(__('全部类型')) ?></option>
            <?php foreach ($typeCodes as $code): ?>
                <option value="<?= $escape($code) ?>" <?= $typeCode === (string)$code ? 'selected' : '' ?>><?= $escape($code) ?></option>
            <?php endforeach; ?>
        </select>
        <select class="form-select form-select-sm" name="status" style="min-width:120px">
            <option value=""><?= $escape(__('全部状态')) ?></option>
            <option value="enabled" <?= $status === 'enabled' ? 'selected' : '' ?>><?= $escape(__('启用')) ?></option>
            <option value="disabled" <?= $status === 'disabled' ? 'selected' : '' ?>><?= $escape(__('禁用')) ?></option>
        </select>
        <input class="form-control form-control-sm" type="search" name="search" value="<?= $escape($search) ?>"
               placeholder="<?= $escape(__('搜索问题 / UUID')) ?>" style="min-width:180px">
        <button class="btn btn-sm btn-outline-secondary" type="submit"><?= $escape(__('筛选')) ?></button>
    </form>
    <div class="table-responsive border rounded">
        <table class="table table-sm mb-0">
            <thead class="table-light">
            <tr>
                <th>ID</th>
                <th><?= $escape(__('网站')) ?></th>
                <th><?= $escape(__('类型')) ?></th>
                <th><?= $escape(__('实体 UUID')) ?></th>
                <th><?= $escape(__('问题')) ?></th>
                <th><?= $escape(__('状态')) ?></th>
                <th><?= $escape(__('排序')) ?></th>
                <th><?= $escape(__('操作')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php if ($items === []): ?>
                <tr><td colspan="8" class="text-center text-muted py-4"><?= $escape(__('暂无 FAQ 条目。')) ?></td></tr>
            <?php endif; ?>
            <?php foreach ($items as $item): ?>
                <?php if (!is_array($item)) { continue; } ?>
                <?php $id = (int)($item['faq_id'] ?? 0); ?>
                <tr>
                    <td><?= $id ?></td>
                    <td><?= (int)($item['website_id'] ?? 0) ?></td>
                    <td><?= $escape($item['type_code'] ?? '') ?></td>
                    <td><code><?= $escape($item['entity_uuid'] ?? '') ?></code></td>
                    <td><?= $escape(mb_substr((string)($item['question'] ?? ''), 0, 80)) ?></td>
                    <td><?= $escape($item['status'] ?? '') ?></td>
                    <td><?= (int)($item['sort_order'] ?? 0) ?></td>
                    <td class="text-nowrap">
                        <a href="<?= $escape($editUrl . (str_contains($editUrl, '?') ? '&' : '?') . 'faq_id=' . $id) ?>"><?= $escape(__('编辑')) ?></a>
                        <form method="post" action="<?= $escape($deleteUrl) ?>" class="d-inline" onsubmit="return confirm('<?= $escape(__('确认删除？')) ?>')">
                            <input type="hidden" name="faq_id" value="<?= $id ?>">
                            <button type="submit" class="btn btn-link btn-sm text-danger p-0"><?= $escape(__('删除')) ?></button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
