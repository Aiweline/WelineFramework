            <label class="w-label" for="faq-type-code"><?= $escape(__('类型')) ?></label>
            <select class="w-select" id="faq-type-code" name="type_code" required>
                <?php foreach ($typeCodes as $code): ?>
                    <option value="<?= $escape($code) ?>" <?= $typeCode === (string)$code ? 'selected' : '' ?>><?= $escape($code) ?></option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="w-label" for="faq-entity-uuid"><?= $escape(__('实体 UUID / 模板 pack')) ?></label>
            <input class="w-input" id="faq-entity-uuid" name="entity_uuid" required value="<?= $escape($item['entity_uuid'] ?? '') ?>"
                   placeholder="site / retail|cross_border|virtual|b2b / product uuid">
            <div class="w-help"><?= $escape(__('type=template 时填写 pack 编码（retail 等）。')) ?></div>
        </div>

        <div class="w-field">
            <label class="w-label" for="faq-faq-key"><?= $escape(__('FAQ Key')) ?></label>
            <input class="w-input" id="faq-faq-key" name="faq_key" value="<?= $escape($item['faq_key'] ?? '') ?>"
