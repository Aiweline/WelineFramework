<?php
/**
 * FAQ item edit form (minimal usable admin).
 *
 * @var \Weline\Framework\View\Template $this
 */
$item = $this->getData('item') ?: [];
$websites = $this->getData('websites') ?: [];
$typeCodes = $this->getData('type_codes') ?: [];
$listingUrl = (string)($this->getData('listing_url') ?: '');
$saveUrl = (string)($this->getData('save_url') ?: '');
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$faqId = (int)($item['faq_id'] ?? 0);
$websiteId = (string)(int)($item['website_id'] ?? 0);
$typeCode = (string)($item['type_code'] ?? 'site');
$status = (string)($item['status'] ?? 'enabled');
?>
<div class="faq-item-edit" style="max-width:720px">
    <div class="mb-3">
        <a href="<?= $escape($listingUrl) ?>">&larr; <?= $escape(__('返回列表')) ?></a>
        <h1 class="h4 mt-2"><?= $escape($faqId > 0 ? __('编辑 FAQ 条目') : __('新建 FAQ 条目')) ?></h1>
    </div>
    <form method="post" action="<?= $escape($saveUrl) ?>" class="d-grid gap-3">
        <input type="hidden" name="faq_id" value="<?= $faqId ?>">
        <div>
            <label class="form-label"><?= $escape(__('网站')) ?></label>
            <select class="form-select" name="website_id">
                <option value="0"><?= $escape(__('全局（0）')) ?></option>
                <?php foreach ($websites as $website): ?>
                    <?php if (!is_array($website)) { continue; } ?>
                    <?php $wid = (string)(int)($website['website_id'] ?? 0); ?>
                    <option value="<?= $escape($wid) ?>" <?= $websiteId === $wid ? 'selected' : '' ?>>
                        <?= $escape($website['label'] ?? $wid) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div>
            <label class="form-label"><?= $escape(__('语言代码')) ?></label>
            <input class="form-control" name="locale_code" value="<?= $escape($item['locale_code'] ?? '') ?>"
                   placeholder="zh_Hans_CN / en_US / 空=全部">
        </div>
        <div>
            <label class="form-label"><?= $escape(__('类型')) ?></label>
            <select class="form-select" name="type_code" required>
                <?php foreach ($typeCodes as $code): ?>
                    <option value="<?= $escape($code) ?>" <?= $typeCode === (string)$code ? 'selected' : '' ?>><?= $escape($code) ?></option>
                <?php endforeach; ?>
            </select>
        </div>
        <div>
            <label class="form-label"><?= $escape(__('实体 UUID')) ?></label>
            <input class="form-control" name="entity_uuid" required value="<?= $escape($item['entity_uuid'] ?? '') ?>"
                   placeholder="site / product offer or product uuid">
        </div>
        <div>
            <label class="form-label"><?= $escape(__('问题')) ?></label>
            <input class="form-control" name="question" required value="<?= $escape($item['question'] ?? '') ?>">
        </div>
        <div>
            <label class="form-label"><?= $escape(__('答案')) ?></label>
            <textarea class="form-control" name="answer" rows="6" required><?= $escape($item['answer'] ?? '') ?></textarea>
        </div>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label"><?= $escape(__('排序')) ?></label>
                <input class="form-control" type="number" name="sort_order" value="<?= (int)($item['sort_order'] ?? 0) ?>">
            </div>
            <div class="col-md-6">
                <label class="form-label"><?= $escape(__('状态')) ?></label>
                <select class="form-select" name="status">
                    <option value="enabled" <?= $status === 'enabled' ? 'selected' : '' ?>><?= $escape(__('启用')) ?></option>
                    <option value="disabled" <?= $status === 'disabled' ? 'selected' : '' ?>><?= $escape(__('禁用')) ?></option>
                </select>
            </div>
        </div>
        <div>
            <button class="btn btn-primary" type="submit"><?= $escape(__('保存')) ?></button>
        </div>
    </form>
</div>
