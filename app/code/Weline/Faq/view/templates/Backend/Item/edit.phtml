?>
<div class="w-container faq-item-edit" style="--w-pt:0;--w-pb:var(--weline-space-4);max-inline-size:40rem;" data-testid="faq-item-edit">
    <div class="w-toolbar" style="--w-mb:var(--weline-space-4);">
        <a class="w-button" href="<?= $escape($listingUrl) ?>" data-tone="neutral" data-variant="ghost" data-size="sm">
            <w:icon name="arrow-left" size="sm"></w:icon><?= $escape(__('返回列表')) ?>
        </a>
    </div>

    <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-4);">
        <?= $escape($faqId > 0 ? __('编辑 FAQ 条目') : __('新建 FAQ 条目')) ?>
    </div>

    <form method="post" action="<?= $escape($saveUrl) ?>" class="w-stack" style="--w-gap:var(--weline-space-4);">
