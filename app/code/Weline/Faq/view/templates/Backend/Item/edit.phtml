                <input class="w-input" id="faq-store-code" name="store_code" value="<?= $escape($item['store_code'] ?? '') ?>"
                       placeholder="<?= $escape(__('空=网站层')) ?>" autocomplete="off"
                       data-testid="faq-store-code">
            </div>
            <div class="w-field" style="flex:1 1 10rem;">
                <label class="w-label" for="faq-channel-code"><?= $escape(__('渠道 code')) ?></label>
                <input class="w-input" id="faq-channel-code" name="channel_code" value="<?= $escape($item['channel_code'] ?? '') ?>"
