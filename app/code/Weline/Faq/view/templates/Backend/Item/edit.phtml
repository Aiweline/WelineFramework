            <button class="w-button" type="submit" data-tone="primary"><?= $escape(__('保存')) ?></button>
            <a class="w-button" href="<?= $escape($listingUrl) ?>" data-tone="neutral" data-variant="ghost"><?= $escape(__('取消')) ?></a>
