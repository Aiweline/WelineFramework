            <select class="w-select" id="faq-website-id" name="website_id">
                <option value="0"><?= $escape(__('全局（0）')) ?></option>
                <?php foreach ($websites as $website): ?>
                    <?php if (!is_array($website)) { continue; } ?>
                    <?php $wid = (string)(int)($website['website_id'] ?? 0); ?>
                    <option value="<?= $escape($wid) ?>" <?= $websiteId === $wid ? 'selected' : '' ?>>
                        <?= $escape($website['label'] ?? $wid) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="w-label" for="faq-locale-code"><?= $escape(__('语言代码')) ?></label>
            <input class="w-input" id="faq-locale-code" name="locale_code" value="<?= $escape($item['locale_code'] ?? '') ?>"
                   placeholder="zh_Hans_CN / en_US / 空=全部">
            <div class="w-help"><?= $escape(__('留空表示适用于全部语言。')) ?></div>
        </div>

        <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-3);">
            <div class="w-field" style="flex:1 1 10rem;">
