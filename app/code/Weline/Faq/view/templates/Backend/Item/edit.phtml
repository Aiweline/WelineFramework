        </div>

        <div class="w-field">
            <label class="w-label" for="faq-question"><?= $escape(__('问题')) ?></label>
            <input class="w-input" id="faq-question" name="question" required value="<?= $escape($item['question'] ?? '') ?>">
        </div>

        <div class="w-field">
            <label class="w-label" for="faq-answer"><?= $escape(__('答案')) ?></label>
            <textarea class="w-input" id="faq-answer" name="answer" rows="6" required><?= $escape($item['answer'] ?? '') ?></textarea>
        </div>

        <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-3);">
            <div class="w-field" style="flex:1 1 10rem;">
                <label class="w-label" for="faq-sort-order"><?= $escape(__('排序')) ?></label>
                <input class="w-input" id="faq-sort-order" type="number" name="sort_order" value="<?= (int)($item['sort_order'] ?? 0) ?>">
            </div>
            <div class="w-field" style="flex:1 1 10rem;">
                <label class="w-label" for="faq-status"><?= $escape(__('状态')) ?></label>
                <select class="w-select" id="faq-status" name="status">
                    <option value="enabled" <?= $status === 'enabled' ? 'selected' : '' ?>><?= $escape(__('启用')) ?></option>
                    <option value="disabled" <?= $status === 'disabled' ? 'selected' : '' ?>><?= $escape(__('禁用')) ?></option>
