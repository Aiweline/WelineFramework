<?php
/**
 * Product FAQ accordion widget for the PDP product-faq slot.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-faq}
 * @widget.name {商品 FAQ}
 * @widget.description {商品详情问答手风琴}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.supports {["layout-product-faq","product-faq","faq"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-faq", "area":"content", "sort_order":0, "required":true, "reason":"商品详情默认 FAQ 槽", "config":{"title":"常见问题"} }]}
 *
 * @param title {default="常见问题",type="string",label="标题"}
 */

use Weline\Faq\Service\FaqPdpResolveService;
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\WidgetI18n;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '常见问题';
if (preg_match('/^Weline_[A-Za-z0-9_]+$/', $titleSource)) {
    $titleSource = '常见问题';
}
$widgetTitle = WidgetI18n::label($titleSource, '常见问题');

$offer = $this->getData('storefront_offer');
if (!is_array($offer) || $offer === []) {
    $product = $this->getData('product');
    $offer = is_array($product) ? $product : [];
}
$entityUuid = '';
foreach ([
    $offer['global_offer_uuid'] ?? null,
    $offer['global_product_uuid'] ?? null,
    $offer['product_uuid'] ?? null,
    $offer['uuid'] ?? null,
] as $candidate) {
    if (is_scalar($candidate) && trim((string)$candidate) !== '') {
        $entityUuid = trim((string)$candidate);
        break;
    }
}

$websiteId = 0;
$storeCode = '';
$channelCode = '';
$locale = '';
try {
    $websiteId = max(0, (int)($this->getRequest()->getWebsiteId() ?? 0));
} catch (\Throwable) {
    $websiteId = 0;
}
try {
    $locale = trim((string)($this->getRequest()->getLocal() ?? ''));
} catch (\Throwable) {
    $locale = '';
}
if ($locale === '') {
    try {
        $locale = trim((string)\Weline\Framework\App\State::getLangLocal());
    } catch (\Throwable) {
        $locale = '';
    }
}
if ($locale === '') {
    try {
        $locale = trim((string)\Weline\Framework\App\State::getLang());
    } catch (\Throwable) {
        $locale = '';
    }
}
if ($locale === '' && class_exists(\Weline\Framework\Runtime\RequestContext::class)) {
    try {
        $locale = trim((string)(\Weline\Framework\Runtime\RequestContext::locale() ?? ''));
    } catch (\Throwable) {
        $locale = '';
    }
}
try {
    if (method_exists($this->getRequest(), 'getStoreCode')) {
        $storeCode = strtolower(trim((string)$this->getRequest()->getStoreCode()));
    }
} catch (\Throwable) {
    $storeCode = '';
}
try {
    if (method_exists($this->getRequest(), 'getChannelCode')) {
        $channelCode = strtolower(trim((string)$this->getRequest()->getChannelCode()));
    }
} catch (\Throwable) {
    $channelCode = '';
}
if ($storeCode === '' || $channelCode === '') {
    try {
        if (class_exists(\Weline\Framework\Runtime\RequestContext::class)) {
            $meta = \Weline\Framework\Runtime\RequestContext::scopeMetadata();
            if (is_array($meta)) {
                if ($storeCode === '') {
                    $storeCode = strtolower(trim((string)($meta['store_code'] ?? '')));
                }
                if ($channelCode === '') {
                    $channelCode = strtolower(trim((string)($meta['channel_code'] ?? '')));
                }
            }
        }
    } catch (\Throwable) {
    }
}

$faqs = [];
try {
    $faqs = ObjectManager::getInstance(FaqPdpResolveService::class)->resolveForPdp([
        'website_id' => $websiteId,
        'store_code' => $storeCode,
        'channel_code' => $channelCode,
        'locale_code' => $locale,
        'product_uuid' => $entityUuid,
    ]);
} catch (\Throwable) {
    $faqs = [];
}

$isPreview = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false);
if ($faqs === [] && !$isPreview) {
    return;
}

$sourceLabels = [
    FaqPdpResolveService::SOURCE_WEBSITE => (string)__('站点'),
    FaqPdpResolveService::SOURCE_STORE => (string)__('店铺'),
    FaqPdpResolveService::SOURCE_CHANNEL => (string)__('渠道'),
    FaqPdpResolveService::SOURCE_PRODUCT => (string)__('本商品'),
];
?>
<section class="weline-product-faq wc-theme_widget_product_faq" data-widget="product-faq" aria-label="<?= $escape($widgetTitle) ?>" weline-code="faq.product.section_faq"<?php if ($locale !== ''): ?> lang="<?= $escape($locale) ?>"<?php endif; ?>>
    <h2 class="weline-product-faq__title"><?= $escape($widgetTitle) ?></h2>
    <?php if ($faqs === []): ?>
        <p class="weline-product-faq__empty"><lang>暂无常见问题。</lang></p>
    <?php else: ?>
        <div class="weline-product-faq__list">
            <?php foreach ($faqs as $index => $faq): ?>
                <?php if (!is_array($faq)) { continue; } ?>
                <?php
                $source = (string)($faq['source'] ?? '');
                $sourceLabel = $sourceLabels[$source] ?? '';
                ?>
                <details class="weline-product-faq__item" <?= $index === 0 ? 'open' : '' ?> data-faq-source="<?= $escape($source) ?>">
                    <summary class="weline-product-faq__question">
                        <span class="weline-product-faq__question-text" dir="auto"><?= $escape($faq['question'] ?? '') ?></span>
                        <?php if ($sourceLabel !== ''): ?>
                            <span class="weline-product-faq__source" data-source="<?= $escape($source) ?>"><?= $escape($sourceLabel) ?></span>
                        <?php endif; ?>
                    </summary>
                    <div class="weline-product-faq__answer" dir="auto"><?= nl2br($escape($faq['answer'] ?? '')) ?></div>
                </details>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>
<style>
.weline-product-faq { padding: var(--spacing-6, var(--weline-space-6, 1.5rem)) 0; }
.weline-product-faq__title { margin: 0 0 var(--spacing-4, var(--weline-space-4, 1rem)); font-size: var(--font-size-xl, 1.25rem); color: var(--color-text, var(--weline-theme-color-text, inherit)); }
.weline-product-faq__item { border-bottom: 1px solid var(--weline-theme-border-color-subtle, var(--color-border-subtle, #e5e7eb)); padding: .75rem 0; }
.weline-product-faq__question { cursor: pointer; font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: var(--weline-space-3, .75rem); color: var(--color-text, inherit); list-style: none; }
.weline-product-faq__question::-webkit-details-marker { display: none; }
.weline-product-faq__question::after {
    content: '';
    flex: 0 0 auto;
    width: .5rem;
    height: .5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    opacity: .55;
    transition: transform .15s ease;
}
.weline-product-faq__item[open] .weline-product-faq__question::after { transform: rotate(225deg); }
.weline-product-faq__question-text { flex: 1 1 auto; unicode-bidi: isolate; }
.weline-product-faq__answer { margin-top: .5rem; color: var(--color-text-secondary, var(--weline-theme-color-text-secondary, #4b5563)); line-height: 1.6; unicode-bidi: isolate; }
.weline-product-faq__source {
    flex: 0 0 auto;
    font-size: var(--font-size-xs, .75rem);
    font-weight: 500;
    color: var(--color-text-secondary, var(--weline-theme-color-text-secondary, #4b5563));
    background: var(--color-surface-muted, var(--weline-theme-color-surface-muted, transparent));
    border: 1px solid var(--weline-theme-border-color-subtle, var(--color-border-subtle, #e5e7eb));
    border-radius: var(--radius-sm, var(--weline-radius-sm, .25rem));
    padding: .125rem .5rem;
}
.weline-product-faq__empty { color: var(--color-text-tertiary, var(--weline-theme-color-text-tertiary, #9ca3af)); }
</style>
