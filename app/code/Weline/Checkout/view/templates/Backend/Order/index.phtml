<?php
/**
 * Checkout 后台订单列表（内容模板）
 * 由布局系统包裹后台 HTML 框架。orders 来自 fetchArray，按数组字段读取。
 * @var \Weline\Framework\View\Template $this
 */
$orders = $orders ?? [];
$total = (int)($total ?? 0);
$page = (int)($page ?? 1);
$limit = (int)($limit ?? 20);
$total_pages = (int)($total_pages ?? 1);
$status = (string)($status ?? '');
$payment_status = (string)($payment_status ?? '');
$keyword = (string)($keyword ?? '');
$action = $this->getUrl('*/backend/order/index');
?>
<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <h4 class="page-title"><i class="mdi mdi-cart me-2"></i><lang>订单管理</lang></h4>
        </div>
    </div>
</div>

<div class="row">
    <template>Weline_Component::message.phtml</template>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0"><lang>订单列表</lang></h4>
            </div>
            <div class="card-body">
                <w:form method="get" action="@var($action)" class="mb-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="text" name="keyword" class="form-control" value="<?= htmlspecialchars($keyword) ?>" placeholder="<?= __('订单号关键词') ?>">
                        </div>
                        <div class="col-md-3">
                            <select name="status" class="form-select">
                                <option value=""><?= __('全部状态') ?></option>
                                <option value="pending" <?= $status === 'pending' ? 'selected' : '' ?>><?= __('待处理') ?></option>
                                <option value="processing" <?= $status === 'processing' ? 'selected' : '' ?>><?= __('处理中') ?></option>
                                <option value="completed" <?= $status === 'completed' ? 'selected' : '' ?>><?= __('已完成') ?></option>
                                <option value="cancelled" <?= $status === 'cancelled' ? 'selected' : '' ?>><?= __('已取消') ?></option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="payment_status" class="form-select">
                                <option value=""><?= __('全部支付状态') ?></option>
                                <option value="pending" <?= $payment_status === 'pending' ? 'selected' : '' ?>><?= __('待支付') ?></option>
                                <option value="paid" <?= $payment_status === 'paid' ? 'selected' : '' ?>><?= __('已支付') ?></option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100"><lang>搜索</lang></button>
                        </div>
                    </div>
                </w:form>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th><?= __('订单号') ?></th>
                                <th><?= __('状态') ?></th>
                                <th><?= __('支付状态') ?></th>
                                <th><?= __('金额') ?></th>
                                <th><?= __('创建时间') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (empty($orders)): ?>
                                <tr>
                                    <td colspan="6" class="text-center text-muted"><?= __('暂无订单') ?></td>
                                </tr>
                            <?php else: ?>
                                <?php foreach ($orders as $order): ?>
                                    <?php
                                    $row = is_array($order) ? $order : (method_exists($order, 'getData') ? $order->getData() : []);
                                    $orderId = $row['order_id'] ?? '';
                                    $orderNumber = $row['order_number'] ?? '';
                                    ?>
                                    <tr>
                                        <td><?= htmlspecialchars((string)$orderNumber) ?></td>
                                        <td><?= htmlspecialchars((string)($row['status'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['payment_status'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['total_amount'] ?? '')) ?> <?= htmlspecialchars((string)($row['currency'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['created_time'] ?? $row['created_at'] ?? '')) ?></td>
                                        <td>
                                            <?php if ($orderId !== ''): ?>
                                                <a class="btn btn-sm btn-primary" href="<?= $this->getUrl('*/backend/order/view', ['order_id' => $orderId]) ?>">
                                                    <?= __('查看') ?>
                                                </a>
                                            <?php endif; ?>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
                <?php if ($total_pages > 1): ?>
                    <div class="text-muted small"><?= __('第 %{1} / %{2} 页，共 %{3} 条', [$page, $total_pages, $total]) ?></div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
