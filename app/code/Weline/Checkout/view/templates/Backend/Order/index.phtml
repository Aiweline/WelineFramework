<?php
/**
 * Checkout 后台订单列表（内容模板）
 * 由布局系统包裹后台 HTML 框架。orders 来自 fetchArray，按数组字段读取。
 * @var \Weline\Framework\View\Template $this
 */
$orders = $orders ?? [];
$total = (int)($total ?? 0);
$page = (int)($page ?? 1);
$limit = (int)($limit ?? 20);
$total_pages = (int)($total_pages ?? 1);
$status = (string)($status ?? '');
$payment_status = (string)($payment_status ?? '');
$keyword = (string)($keyword ?? '');
$action = $this->getUrl('*/backend/order/index');
?>
<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading">
            <h4 class="w-backend-page__title"><w:icon name="cart" size="sm"></w:icon><lang>订单管理</lang></h4>
        </div>
    </div>
</div>

<div class="w-grid">
    <template>Weline_Component::message.phtml</template>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-card">
            <div class="w-card__header">
                <h4 class="w-card__title" style="--w-mb:0;"><lang>订单列表</lang></h4>
            </div>
            <div class="w-card__body">
                <w:form method="get" action="@var($action)" style="--w-mb:var(--weline-space-4);">
                    <div class="w-grid" style="--w-gap:var(--weline-space-2);">
                        <div style="--w-span-md:4;">
                            <input type="text" name="keyword" class="w-input" value="<?= htmlspecialchars($keyword) ?>" placeholder="<?= __('订单号关键词') ?>">
                        </div>
                        <div style="--w-span-md:3;">
                            <select name="status" class="w-select">
                                <option value=""><?= __('全部状态') ?></option>
                                <option value="pending" <?= $status === 'pending' ? 'selected' : '' ?>><?= __('待处理') ?></option>
                                <option value="processing" <?= $status === 'processing' ? 'selected' : '' ?>><?= __('处理中') ?></option>
                                <option value="completed" <?= $status === 'completed' ? 'selected' : '' ?>><?= __('已完成') ?></option>
                                <option value="cancelled" <?= $status === 'cancelled' ? 'selected' : '' ?>><?= __('已取消') ?></option>
                            </select>
                        </div>
                        <div style="--w-span-md:3;">
                            <select name="payment_status" class="w-select">
                                <option value=""><?= __('全部支付状态') ?></option>
                                <option value="pending" <?= $payment_status === 'pending' ? 'selected' : '' ?>><?= __('待支付') ?></option>
                                <option value="paid" <?= $payment_status === 'paid' ? 'selected' : '' ?>><?= __('已支付') ?></option>
                            </select>
                        </div>
                        <div style="--w-span-md:2;">
                            <button type="submit" class="w-button" data-w-width="full" data-tone="primary"><lang>搜索</lang></button>
                        </div>
                    </div>
                </w:form>

                <div class="w-table-wrap">
                    <table class="w-table">
                        <thead>
                            <tr>
                                <th><?= __('订单号') ?></th>
                                <th><?= __('状态') ?></th>
                                <th><?= __('支付状态') ?></th>
                                <th><?= __('金额') ?></th>
                                <th><?= __('创建时间') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (empty($orders)): ?>
                                <tr>
                                    <td colspan="6" class="w-text" data-align="center" data-tone="muted"><?= __('暂无订单') ?></td>
                                </tr>
                            <?php else: ?>
                                <?php foreach ($orders as $order): ?>
                                    <?php
                                    $row = is_array($order) ? $order : (method_exists($order, 'getData') ? $order->getData() : []);
                                    $orderId = $row['order_id'] ?? '';
                                    $orderNumber = $row['order_number'] ?? '';
                                    ?>
                                    <tr>
                                        <td><?= htmlspecialchars((string)$orderNumber) ?></td>
                                        <td><?= htmlspecialchars((string)($row['status'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['payment_status'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['total_amount'] ?? '')) ?> <?= htmlspecialchars((string)($row['currency'] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string)($row['created_time'] ?? $row['created_at'] ?? '')) ?></td>
                                        <td>
                                            <?php if ($orderId !== ''): ?>
                                                <a class="w-button" href="<?= $this->getUrl('*/backend/order/view', ['order_id' => $orderId]) ?>" data-tone="primary" data-size="sm">
                                                    <?= __('查看') ?>
                                                </a>
                                            <?php endif; ?>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
                <?php if ($total_pages > 1): ?>
                    <div class="w-text" data-tone="muted" data-size="sm"><?= __('第 %{1} / %{2} 页，共 %{3} 条', [$page, $total_pages, $total]) ?></div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
