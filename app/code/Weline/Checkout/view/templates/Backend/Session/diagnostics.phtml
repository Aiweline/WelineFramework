<?php
$summary_tiles = is_array($summary_tiles ?? null) ? $summary_tiles : [];
$recent_sessions = is_array($recent_sessions ?? null) ? $recent_sessions : [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$sessionListUrl = $this->getUrl('*/backend/session');
?>
<div class="w-grid" data-testid="checkout-diagnostics">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <div>
        <h4 class="w-backend-page__title" style="--w-mb:0;"><?= __('结账诊断') ?></h4>
        <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);--w-mb:0;">
          <?= __('看当前样本里各进度有多少、哪些快过期。只读统计，不改数据。卡住原因请到「结账会话」看。') ?>
        </p>
      </div>
      <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
        <a class="w-button" data-tone="neutral" data-size="sm" href="<?= $escape($sessionListUrl) ?>" data-testid="checkout-diagnostics-open-sessions">
          <?= __('打开结账会话') ?>
        </a>
      </div>
    </div>

    <?php if ($load_error !== ''): ?>
      <div class="w-alert" data-testid="checkout-diagnostics-load-error" data-tone="danger"><?= $escape($load_error) ?></div>
    <?php endif; ?>

    <section class="w-stat-tiles" aria-label="<?= __('进度样本') ?>" data-testid="checkout-diagnostics-summary"
             style="--w-stat-tile-min:8rem;--w-gap:var(--weline-space-3);--w-mb:var(--weline-space-4);">
      <?php foreach ($summary_tiles as $tile):
        $tile = is_array($tile) ? $tile : [];
        $key = (string)($tile['key'] ?? '');
        $label = (string)($tile['label'] ?? $key);
        $tone = (string)($tile['tone'] ?? 'neutral');
        $count = (int)($tile['count'] ?? 0);
      ?>
        <div class="w-card" data-w-height="full">
          <div class="w-card__body" style="--w-py:var(--weline-space-3);">
            <div class="w-cluster" data-align="center" data-justify="between" style="--w-gap:var(--weline-space-2);">
              <span class="w-badge" data-tone="<?= $escape($tone) ?>"><?= $escape($label) ?></span>
              <span class="w-text" data-tone="muted" data-size="sm"><code><?= $escape($key) ?></code></span>
            </div>
            <div class="w-text" data-size="lg" style="--w-mt:var(--weline-space-2);--w-mb:0;font-weight:var(--weline-font-weight-semibold, 600);"
                 data-diagnostic-state="<?= $escape($key) ?>"><?= $count ?></div>
          </div>
        </div>
      <?php endforeach; ?>
    </section>

    <div class="w-card">
      <div class="w-card__body">
        <div class="w-cluster" data-align="center" data-justify="between" data-wrap="true"
             style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-3);">
          <h5 style="--w-mb:0;"><?= __('最近会话') ?></h5>
          <span class="w-text" data-tone="muted" data-size="sm"><?= __('按创建时间倒序；同凭证只显示一条') ?></span>
        </div>
        <div class="w-table-wrap">
          <table class="w-table" data-testid="checkout-diagnostics-recent">
            <thead>
            <tr>
              <th><?= __('进度') ?></th>
              <th><?= __('去向') ?></th>
              <th><?= __('问题') ?></th>
              <th><?= __('创建') ?></th>
              <th><?= __('有效期') ?></th>
              <th><?= __('凭证') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php if ($recent_sessions === []): ?>
              <tr>
                <td colspan="6" class="w-text" data-align="center" data-tone="muted"><?= __('暂无可诊断会话') ?></td>
              </tr>
            <?php else: foreach ($recent_sessions as $session):
              $session = is_array($session) ? $session : [];
              $state = (string)($session['state'] ?? '');
              $stateLabel = (string)($session['state_label'] ?? $state);
              $hasError = !empty($session['has_error']);
              $isExpired = !empty($session['is_expired']);
              $token = (string)($session['quote_token'] ?? '');
              $progressTone = $isExpired ? 'danger' : match ($state) {
                  'submitting' => 'warning',
                  'submitted' => 'success',
                  default => 'info',
              };
            ?>
              <tr data-testid="checkout-diagnostics-row" data-quote-token="<?= $escape($token) ?>" data-state="<?= $escape($state) ?>">
                <td>
                  <span class="w-badge" data-tone="<?= $escape($progressTone) ?>"><?= $escape($stateLabel) ?></span>
                  <?php if ($isExpired): ?>
                    <span class="w-badge" data-tone="danger" style="--w-ml:var(--weline-space-1);"><?= __('已过期') ?></span>
                  <?php endif; ?>
                </td>
                <td><?= $escape((string)($session['destination'] ?? __('去向未记录'))) ?></td>
                <td><?php if ($hasError): ?>
                  <span class="w-badge" data-tone="warning"><?= $escape((string)($session['error_label'] ?? '')) ?></span>
                <?php else: ?>
                  <span class="w-text" data-tone="muted"><?= __('正常') ?></span>
                <?php endif; ?></td>
                <td><?= $escape((string)($session['created_at'] ?? '—')) ?></td>
                <td>
                  <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                    <span><?= $escape((string)($session['expiry_status'] ?? '—')) ?></span>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $escape((string)($session['expires_at'] ?? '—')) ?></span>
                  </div>
                </td>
                <td><code class="w-text" data-tone="muted"><?= $escape($token) ?></code></td>
              </tr>
            <?php endforeach; endif; ?>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
