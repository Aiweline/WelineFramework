<?php
$summary = $summary ?? [];
$recent_sessions = $recent_sessions ?? [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="w-grid" data-testid="checkout-diagnostics">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading"><h4 class="w-backend-page__title"><?= __('结账诊断') ?></h4><p class="w-text" data-tone="muted"><?= __('统计来自当前结账会话样本，不执行迁移或写操作。') ?></p></div>
    <?php if ($load_error !== ''): ?><div class="w-alert" data-testid="checkout-diagnostics-load-error" data-tone="danger"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="w-grid" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-4);"><?php foreach (['quoted','submitting','submitted','expired','unknown'] as $key): ?>
      <div><div class="w-card"><div class="w-card__body"><div class="w-text" data-tone="muted"><?= $escape($key) ?></div><div class="fs-3" data-diagnostic-state="<?= $escape($key) ?>"><?= (int)($summary[$key] ?? 0) ?></div></div></div></div>
    <?php endforeach; ?></div>
    <div class="w-card"><div class="w-card__body"><h5><?= __('最近会话') ?></h5><div class="w-table-wrap"><table class="w-table">
      <thead><tr><th><?= __('Quote Token') ?></th><th><?= __('状态') ?></th><th><?= __('创建时间') ?></th><th><?= __('过期时间') ?></th></tr></thead><tbody>
      <?php if ($recent_sessions === []): ?><tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('暂无可诊断会话') ?></td></tr>
      <?php else: foreach ($recent_sessions as $session): ?><tr><td><code><?= $escape($session->getData('quote_token')) ?></code></td><td><?= $escape($session->getData('state')) ?></td><td><?= $escape($session->getData('created_at')) ?></td><td><?= $escape($session->getData('expires_at')) ?></td></tr><?php endforeach; endif; ?>
      </tbody></table></div></div></div>
  </div>
</div>
