<?php
$summary = $summary ?? [];
$recent_sessions = $recent_sessions ?? [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="row" data-testid="checkout-diagnostics">
  <div class="col-12">
    <div class="page-title-box"><h4 class="page-title"><?= __('结账诊断') ?></h4><p class="text-muted"><?= __('统计来自当前结账会话样本，不执行迁移或写操作。') ?></p></div>
    <?php if ($load_error !== ''): ?><div class="alert alert-danger" data-testid="checkout-diagnostics-load-error"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="row g-3 mb-3"><?php foreach (['quoted','submitting','submitted','expired','unknown'] as $key): ?>
      <div class="col"><div class="card"><div class="card-body"><div class="text-muted"><?= $escape($key) ?></div><div class="fs-3" data-diagnostic-state="<?= $escape($key) ?>"><?= (int)($summary[$key] ?? 0) ?></div></div></div></div>
    <?php endforeach; ?></div>
    <div class="card"><div class="card-body"><h5><?= __('最近会话') ?></h5><div class="table-responsive"><table class="table table-sm">
      <thead><tr><th><?= __('Quote Token') ?></th><th><?= __('状态') ?></th><th><?= __('创建时间') ?></th><th><?= __('过期时间') ?></th></tr></thead><tbody>
      <?php if ($recent_sessions === []): ?><tr><td colspan="4" class="text-center text-muted"><?= __('暂无可诊断会话') ?></td></tr>
      <?php else: foreach ($recent_sessions as $session): ?><tr><td><code><?= $escape($session->getData('quote_token')) ?></code></td><td><?= $escape($session->getData('state')) ?></td><td><?= $escape($session->getData('created_at')) ?></td><td><?= $escape($session->getData('expires_at')) ?></td></tr><?php endforeach; endif; ?>
      </tbody></table></div></div></div>
  </div>
</div>
