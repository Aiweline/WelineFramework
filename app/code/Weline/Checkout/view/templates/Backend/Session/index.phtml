<?php
$sessions = $sessions ?? [];
$state = $state ?? '';
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="row" data-testid="checkout-session-management">
  <div class="col-12">
    <div class="page-title-box"><h4 class="page-title"><?= __('结账会话') ?></h4></div>
    <?php if ($load_error !== ''): ?><div class="alert alert-danger" data-testid="checkout-session-load-error"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="card"><div class="card-body">
      <form method="get" class="row g-2 mb-3" data-testid="checkout-session-filter">
        <div class="col-md-4"><select name="state" class="form-select"><option value=""><?= __('全部状态') ?></option>
          <?php foreach (['quoted','submitting','submitted'] as $option): ?><option value="<?= $option ?>" <?= $state === $option ? 'selected' : '' ?>><?= $escape($option) ?></option><?php endforeach; ?>
        </select></div><div class="col-auto"><button class="btn btn-primary" type="submit"><?= __('筛选') ?></button></div>
      </form>
      <div class="table-responsive"><table class="table table-striped"><thead><tr>
        <th><?= __('会话 ID') ?></th><th><?= __('Quote Token') ?></th><th><?= __('状态') ?></th><th><?= __('货币') ?></th><th><?= __('配置版本') ?></th><th><?= __('创建时间') ?></th><th><?= __('过期时间') ?></th>
      </tr></thead><tbody>
      <?php if ($sessions === []): ?><tr><td colspan="7" class="text-center text-muted"><?= __('暂无结账会话') ?></td></tr>
      <?php else: foreach ($sessions as $session): ?><tr>
        <td><?= $escape($session->getData('session_id')) ?></td><td><code><?= $escape($session->getData('quote_token')) ?></code></td>
        <td><?= $escape($session->getData('state')) ?></td><td><?= $escape($session->getData('currency')) ?></td>
        <td><?= $escape($session->getData('config_version')) ?></td><td><?= $escape($session->getData('created_at')) ?></td><td><?= $escape($session->getData('expires_at')) ?></td>
      </tr><?php endforeach; endif; ?></tbody></table></div>
    </div></div>
  </div>
</div>
