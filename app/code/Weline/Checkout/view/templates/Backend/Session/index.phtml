<?php
$sessions = is_array($sessions ?? null) ? $sessions : [];
$state = $state ?? '';
$error_only = !empty($error_only);
$checkout_entry = $checkout_entry ?? '';
$checkout_entry_rows = is_array($checkout_entry_rows ?? null) ? $checkout_entry_rows : [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$stateOptions = [
    'quoted' => __('选配中'),
    'submitting' => __('正在提交'),
    'submitted' => __('已下单'),
];
?>
<div class="w-grid" data-testid="checkout-session-management">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <div>
        <h4 class="w-backend-page__title" style="--w-mb:0;"><?= __('结账会话') ?></h4>
        <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);--w-mb:0;"><?= __('看买家卡在哪一步：缺重量、缺汇率或地址还送不到。技术码收在明细里。') ?></p>
      </div>
    </div>
    <?php if ($load_error !== ''): ?><div class="w-alert" data-testid="checkout-session-load-error" data-tone="danger"><?= $escape($load_error) ?></div><?php endif; ?>
    <div class="w-card"><div class="w-card__body">
      <form method="get" class="w-cluster" data-wrap="true" data-align="center" data-testid="checkout-session-filter" style="--w-gap:var(--weline-space-3);--w-mb:var(--weline-space-4);">
        <select name="state" class="w-select" aria-label="<?= __('结账进度') ?>">
          <option value=""><?= __('全部进度') ?></option>
          <?php foreach ($stateOptions as $value => $label): ?>
            <option value="<?= $escape($value) ?>" <?= $state === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
          <?php endforeach; ?>
        </select>
        <select name="checkout_entry" class="w-select" data-testid="checkout-session-entry-filter" aria-label="<?= __('结账来源') ?>">
          <option value=""><?= __('全部来源') ?></option>
          <?php foreach ($checkout_entry_rows as $row): ?>
            <?php $code = (string)($row['code'] ?? ''); if ($code === '') { continue; } ?>
            <option value="<?= $escape($code) ?>" <?= $checkout_entry === $code ? 'selected' : '' ?>><?= $escape((string)($row['label'] ?? $code)) ?></option>
          <?php endforeach; ?>
          <option value="unknown" <?= $checkout_entry === 'unknown' ? 'selected' : '' ?>><?= __('未标记') ?></option>
        </select>
        <label class="w-text" data-testid="checkout-session-error-only">
          <input type="checkbox" name="error" value="1" <?= $error_only ? 'checked' : '' ?>>
          <?= __('只看卡住的结账') ?>
        </label>
        <button class="w-button" type="submit" data-tone="primary"><?= __('筛选') ?></button>
      </form>
      <div class="w-table-wrap"><table class="w-table"><thead><tr>
        <th><?= __('来源') ?></th>
        <th><?= __('问题') ?></th>
        <th><?= __('去向') ?></th>
        <th><?= __('进度') ?></th>
        <th><?= __('发生时间') ?></th>
        <th><?= __('货币') ?></th>
        <th><?= __('凭证') ?></th>
      </tr></thead><tbody>
      <?php if ($sessions === []): ?><tr><td colspan="7" class="w-text" data-align="center" data-tone="muted"><?= __('还没有结账记录') ?></td></tr>
      <?php else: foreach ($sessions as $session):
        $session = is_array($session) ? $session : [];
        $token = (string)($session['quote_token'] ?? '');
        $errorCode = (string)($session['error_code'] ?? '');
        $hasError = !empty($session['has_error']);
        $errorLabel = (string)($session['error_label'] ?? '');
        $operatorHint = (string)($session['operator_hint'] ?? '');
        $lines = is_array($session['lines'] ?? null) ? $session['lines'] : [];
        $pretty = (string)($session['snapshot_json'] ?? '');
        $entryLabel = (string)($session['checkout_entry_label'] ?? __('未标记'));
        $entryTone = (string)($session['checkout_entry_tone'] ?? 'muted');
        $entryCode = (string)($session['checkout_entry'] ?? 'unknown');
      ?>
      <tr data-testid="checkout-session-row" data-quote-token="<?= $escape($token) ?>" data-error-code="<?= $escape($errorCode) ?>" data-checkout-entry="<?= $escape($entryCode) ?>">
        <td><span class="w-badge" data-tone="<?= $escape($entryTone) ?>" data-testid="checkout-session-entry"><?= $escape($entryLabel) ?></span></td>
        <td><?php if ($hasError): ?>
          <span class="w-badge" data-tone="warning"><?= $escape($errorLabel) ?></span>
        <?php else: ?>
          <span class="w-text" data-tone="muted"><?= __('正常') ?></span>
        <?php endif; ?></td>
        <td><?= $escape((string)($session['destination'] ?? __('去向未记录'))) ?></td>
        <td><?= $escape((string)($session['state_label'] ?? '')) ?></td>
        <td><?= $escape((string)(($hasError ? $session['error_at'] : $session['created_at']) ?? '—')) ?></td>
        <td><?= $escape((string)($session['currency'] ?? '')) ?></td>
        <td><code class="w-text" data-tone="muted"><?= $escape($token) ?></code></td>
      </tr>
      <tr>
        <td colspan="7">
          <details class="w-card" data-testid="checkout-session-error-snapshot" <?= $hasError ? 'open' : '' ?>>
            <summary><?= $hasError ? $escape($errorLabel !== '' ? $errorLabel : __('卡住了')) : __('没有异常') ?></summary>
            <?php if ($hasError): ?>
            <div class="w-card__body">
              <?php if ($operatorHint !== ''): ?>
              <div class="w-alert" data-tone="warning"><?= $escape($operatorHint) ?></div>
              <?php endif; ?>
              <?php if ($lines !== []): ?>
              <div class="w-table-wrap" style="--w-mt:var(--weline-space-2);"><table class="w-table"><thead><tr>
                <th><?= __('货号') ?></th><th><?= __('数量') ?></th><th><?= __('重量') ?></th>
              </tr></thead><tbody>
              <?php foreach ($lines as $line): if (!is_array($line)) { continue; } ?>
              <tr>
                <td><?= $escape((string)($line['sku'] ?? '')) ?></td>
                <td><?= $escape((string)($line['qty'] ?? '')) ?></td>
                <td><?= $escape((string)($line['weight_label'] ?? '')) ?></td>
              </tr>
              <?php endforeach; ?>
              </tbody></table></div>
              <?php endif; ?>
              <?php if ($pretty !== ''): ?>
              <details style="--w-mt:var(--weline-space-3);">
                <summary class="w-text" data-tone="muted"><?= __('技术明细') ?></summary>
                <pre class="w-text" data-testid="checkout-session-error-json"><?= $escape($pretty) ?></pre>
              </details>
              <?php endif; ?>
            </div>
            <?php endif; ?>
          </details>
        </td>
      </tr>
      <?php endforeach; endif; ?></tbody></table></div>
    </div></div>
  </div>
</div>
