<?php

/**
 * 店面金额小计（购物车 / 结账 / 快捷 / 代付共用行序）
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {storefront-money-summary}
 * @widget.name {店面金额小计}
 * @widget.description {统一商品小计、运费、税费、优惠与应付行；各表面只算数并 paint}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content","footer"]}
 * @widget.page_layouts {["cart","checkout","mini-cart","*"]}
 * @widget.supports {["storefront-money-summary","checkout-money-summary","money-summary"]}
 * @widget.source {Weline_Checkout::css/widgets/storefront-money-summary.css,Weline_Checkout::js/widgets/storefront-money-summary.js}
 *
 * @param mode {default="checkout",type="select",label="表面模式",options="checkout,cart,mini-cart,express,helppay"}
 * @param note {default="",type="string",label="摘要说明（空则隐藏）"}
 * @param discounts_disabled {default=false,type="bool",label="禁用优惠行"}
 */

$escape = static fn(mixed $value): string => htmlspecialchars(
    (string) $value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);

$mode = strtolower(trim((string) ($this->getData('mode') ?? 'checkout')));
$allowedModes = ['checkout', 'cart', 'mini-cart', 'express', 'helppay'];
if (!in_array($mode, $allowedModes, true)) {
    $mode = 'checkout';
}

$note = trim((string) ($this->getData('note') ?? ''));
if ($note === '' && ($mode === 'cart' || $mode === 'mini-cart')) {
    $note = (string) __('税费与运费将在结算时计算');
}

$discountsDisabled = (bool) ($this->getData('discounts_disabled') ?? false);
$shippingPending = ($mode === 'cart' || $mode === 'mini-cart');
$hideShippingInitially = $shippingPending;
$showDiscountLinesHost = ($mode === 'cart' || $mode === 'mini-cart');

$labelGoods = (string) __('商品小计');
$labelShipping = (string) __('运费');
$labelDiscount = (string) __('优惠');
$labelDeposit = (string) __('批发定金');
$labelCredit = (string) __('批发信用抵扣');
// 销售税 / 进口关税 / 进口税费分开展示，避免混成一行让买家疑惑。
$labelSalesTax = (string) __('销售税');
$labelCustomsDuty = (string) __('进口关税');
$labelImportTax = (string) __('进口税费');
$salesTaxLabelOverride = trim((string) ($this->getData('sales_tax_label') ?? $this->getData('tax_label') ?? ''));
if ($salesTaxLabelOverride !== '') {
    $labelSalesTax = $salesTaxLabelOverride;
}
$labelCod = (string) __('货到付款手续费');
$labelIncentive = (string) __('支付方式优惠');
$labelPayable = (string) __('应付合计');
if ($mode === 'cart' || $mode === 'mini-cart') {
    $labelPayable = (string) __('小计');
}
if ($mode === 'express' || $mode === 'helppay') {
    $labelPayable = (string) __('应付');
}

// Optional SSR paint (HelpPay / express first paint before JS).
$goodsText = trim((string) ($this->getData('goods_text') ?? ''));
$shippingText = trim((string) ($this->getData('shipping_text') ?? ''));
$salesTaxText = trim((string) ($this->getData('sales_tax_text') ?? $this->getData('tax_text') ?? ''));
$customsDutyText = trim((string) ($this->getData('duty_text') ?? ''));
$importTaxText = trim((string) ($this->getData('import_tax_text') ?? ''));
$payableText = trim((string) ($this->getData('payable_text') ?? ''));
$shippingServiceLabel = trim((string) ($this->getData('shipping_service_label') ?? ''));
$salesTaxMinorSsr = max(0, (int) ($this->getData('sales_tax_minor') ?? 0));
$dutyMinorSsr = max(0, (int) ($this->getData('duty_minor') ?? 0));
$importTaxMinorSsr = max(0, (int) ($this->getData('import_tax_minor') ?? 0));
// Legacy SSR: combined tax_minor with no split → treat as sales tax only.
$taxMinorSsr = max(0, (int) ($this->getData('tax_minor') ?? 0));
if ($salesTaxMinorSsr === 0 && $dutyMinorSsr === 0 && $importTaxMinorSsr === 0 && $taxMinorSsr > 0) {
    $salesTaxMinorSsr = $taxMinorSsr;
}
$showSalesTaxInitially = $salesTaxText !== '' || $salesTaxMinorSsr > 0;
$showDutyInitially = $customsDutyText !== '' || $dutyMinorSsr > 0;
$showImportTaxInitially = $importTaxText !== '' || $importTaxMinorSsr > 0;
if ($shippingServiceLabel !== '') {
    $labelShipping = $labelShipping . ' · ' . $shippingServiceLabel;
}
if ($goodsText === '') {
    $goodsText = '—';
}
if ($shippingText === '') {
    $shippingText = '—';
}
if ($payableText === '') {
    $payableText = '—';
}
?>
<div class="w-storefront-money-summary"
     data-money-summary
     data-money-summary-mode="<?= $escape($mode) ?>"
     data-weline-load="storefrontMoneySummary"
     data-testid="storefront-money-summary"
     <?php if ($discountsDisabled): ?>data-discounts-disabled="1"<?php endif; ?>
     <?php if ($shippingPending): ?>data-shipping-pending="1"<?php endif; ?>
     role="list"
     weline-code="checkout.widget.storefront-money-summary">
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--goods"
         role="listitem"
         data-money-summary-row="goods"
         data-cart-discount-breakdown>
        <span data-money-summary-goods-label><?= $escape($labelGoods) ?></span>
        <strong data-money-summary-goods
                data-subtotal=""
                data-cart-goods-subtotal
                data-express-subtotal
                data-helppay-goods-amount
                data-testid="helppay-payment-goods-amount"><?= $escape($goodsText) ?></strong>
    </div>
    <?php if ($showDiscountLinesHost): ?>
        <div class="w-storefront-money-summary__discount-lines"
             data-money-summary-discount-lines
             data-cart-discount-lines
             data-mini-cart-discount-lines
             data-mini-cart-discount-breakdown></div>
    <?php endif; ?>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--shipping"
         role="listitem"
         data-money-summary-row="shipping"
         <?= $hideShippingInitially ? 'hidden' : '' ?>>
        <span data-money-summary-shipping-label
              data-helppay-ship-label
              data-label-base="<?= $escape((string) __('运费')) ?>"><?= $escape($labelShipping) ?></span>
        <strong data-money-summary-shipping
                data-shipping-amount=""
                data-express-shipping
                data-helppay-ship-amount
                data-testid="helppay-payment-ship-amount"><?= $escape($shippingText) ?></strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--discount"
         role="listitem"
         data-money-summary-row="discount"
         data-checkout-discount-row
         hidden>
        <span data-money-summary-discount-label
              data-checkout-discount-label><?= $escape($labelDiscount) ?></span>
        <strong data-money-summary-discount
                data-discount-amount=""
                data-express-discount>0.00</strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--deposit"
         role="listitem"
         data-money-summary-row="deposit"
         data-checkout-deposit-row
         hidden>
        <span><?= $escape($labelDeposit) ?></span>
        <strong data-money-summary-deposit data-deposit-amount="">0.00</strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--credit"
         role="listitem"
         data-money-summary-row="credit"
         data-checkout-credit-row
         hidden>
        <span><?= $escape($labelCredit) ?></span>
        <strong data-money-summary-credit data-credit-amount="">0.00</strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--sales-tax"
         role="listitem"
         data-money-summary-row="sales_tax"
         data-money-summary-row-legacy="tax"
         data-checkout-tax-row
         data-cart-tax-row
         data-mini-cart-tax-row
         <?= $showSalesTaxInitially ? '' : 'hidden' ?>>
        <span data-money-summary-sales-tax-label
              data-money-summary-tax-label
              data-cart-tax-label
              data-mini-cart-tax-label><?= $escape($labelSalesTax) ?></span>
        <strong data-money-summary-sales-tax
                data-money-summary-tax
                data-tax-amount=""
                data-cart-tax-amount
                data-express-tax><?= $escape($salesTaxText !== '' ? $salesTaxText : '0.00') ?></strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--customs-duty"
         role="listitem"
         data-money-summary-row="customs_duty"
         data-checkout-customs-duty-row
         <?= $showDutyInitially ? '' : 'hidden' ?>>
        <span data-money-summary-customs-duty-label><?= $escape($labelCustomsDuty) ?></span>
        <strong data-money-summary-customs-duty><?= $escape($customsDutyText !== '' ? $customsDutyText : '0.00') ?></strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--import-tax"
         role="listitem"
         data-money-summary-row="import_tax"
         data-checkout-import-tax-row
         <?= $showImportTaxInitially ? '' : 'hidden' ?>>
        <span data-money-summary-import-tax-label><?= $escape($labelImportTax) ?></span>
        <strong data-money-summary-import-tax><?= $escape($importTaxText !== '' ? $importTaxText : '0.00') ?></strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--cod"
         role="listitem"
         data-money-summary-row="cod"
         data-checkout-cod-fee-row
         hidden>
        <span><?= $escape($labelCod) ?></span>
        <strong data-money-summary-cod data-cod-fee-amount="">0.00</strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--incentive"
         role="listitem"
         data-money-summary-row="incentive"
         data-checkout-payment-incentive-row
         data-testid="checkout-payment-incentive-row"
         hidden>
        <span><?= $escape($labelIncentive) ?></span>
        <strong data-money-summary-incentive data-payment-incentive-amount="">0.00</strong>
    </div>
    <div class="w-storefront-money-summary__row w-storefront-money-summary__row--payable"
         role="listitem"
         data-money-summary-row="payable">
        <span data-money-summary-payable-label
              data-grand-total-label
              data-cart-subtotal-label><?= $escape($labelPayable) ?></span>
        <strong class="w-storefront-money-summary__grand total-amount"
                data-money-summary-payable
                data-grand-total=""
                data-cart-grand-total
                data-cart-total-amount
                data-express-grand
                data-helppay-total-amount
                data-helppay-payable-amount
                data-testid="helppay-payment-total"><?= $escape($payableText) ?></strong>
    </div>
    <p class="w-storefront-money-summary__note"
       data-money-summary-note
       data-cart-summary-note
       data-mini-cart-note
       dir="auto"
       <?= $note === '' ? 'hidden' : '' ?>><?= $escape($note) ?></p>
</div>
