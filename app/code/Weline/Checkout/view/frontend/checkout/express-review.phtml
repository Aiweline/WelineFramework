                multiple="false"
                position="content"
                class="w-express-review__shipping-address-slot"
                weline-code="checkout.express-review.shipping_address_slot">
        </w:slot>
        <div class="w-express-review__tax-identity-host" data-tax-identity-host hidden>
            <w:slot id="checkout-tax-identity"
                    name="<?= $esc((string) __('结账税号')) ?>"
                    accept="checkout-tax-identity,tax-identity,buyer-tax,tax"
                    exclusive="true"
                    multiple="false"
                    position="content"
                    class="w-express-review__tax-identity-slot"
                    weline-code="checkout.express-review.tax_identity_slot">
            </w:slot>
        </div>
        <div class="w-express-review__address" data-express-address-summary hidden></div>
        <p class="w-express-review__payer" data-express-payer-email hidden></p>
