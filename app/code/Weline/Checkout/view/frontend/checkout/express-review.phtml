<?php
/**
 * Express review — lightweight confirm after provider return (before capture).
 *
 * @var \Weline\Framework\View\Template $this
 */
$transactionNo = trim((string) ($this->getData('transaction_no') ?? ''));
$checkoutGroupUuid = trim((string) ($this->getData('checkout_group_uuid') ?? ''));
$alreadyPaid = !empty($this->getData('already_paid'));
$alreadyPaidMessage = trim((string) ($this->getData('already_paid_message') ?? ''));
$alreadyPaidMethod = trim((string) ($this->getData('already_paid_method_label') ?? ''));
$alreadyPaidRedirect = trim((string) ($this->getData('already_paid_redirect') ?? ''));
$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
?>
<section class="w-express-review<?= $alreadyPaid ? ' is-already-paid' : '' ?>"
         weline-code="checkout.express-review.root"
         data-testid="checkout-express-review"
         data-weline-checkout-express-review
         data-transaction-no="<?= $esc($transactionNo) ?>"
         data-checkout-group-uuid="<?= $esc($checkoutGroupUuid) ?>"
         data-already-paid="<?= $alreadyPaid ? '1' : '0' ?>"
         data-already-paid-redirect="<?= $esc($alreadyPaidRedirect) ?>"
         data-weline-load="checkoutExpressReview">
    <header class="w-express-review__header">
        <h1 class="w-express-review__title">
            <?= $esc((string) ($alreadyPaid ? __('订单已支付') : __('确认并付款'))) ?>
        </h1>
        <p class="w-express-review__hint" data-express-copy-pending>
            <?php if ($alreadyPaid): ?>
                <?= $esc($alreadyPaidMessage !== '' ? $alreadyPaidMessage : (string) __('该笔快捷支付已完成扣款')) ?>
                <?php if ($alreadyPaidMethod !== ''): ?>
                    <span class="w-express-review__paid-method">（<?= $esc($alreadyPaidMethod) ?>）</span>
                <?php endif; ?>
            <?php else: ?>
                <?= $esc((string) __('尚未扣款，确认后向支付商收款')) ?>
            <?php endif; ?>
        </p>
        <p class="w-express-review__method"
           data-express-payment-method
           data-testid="express-payment-method"
           hidden></p>
    </header>

    <div class="w-express-review__status<?= $alreadyPaid ? '' : '' ?>"
         data-express-status
         role="status"
         aria-live="polite"><?php
        if ($alreadyPaid) {
            echo $esc((string) __('该笔订单已支付，无需再次确认'));
        }
    ?></div>

    <?php if ($alreadyPaid): ?>
    <div class="w-express-review__card w-express-review__card--paid" data-express-already-paid>
        <p class="w-express-review__hint"><?= $esc((string) __('支付已完成，可返回首页或查看账户订单。')) ?></p>
        <div class="w-express-review__actions">
            <?php if ($alreadyPaidRedirect !== '' && $alreadyPaidRedirect !== '/'): ?>
            <a class="w-btn w-btn--primary"
               href="<?= $esc($alreadyPaidRedirect) ?>"
               data-express-paid-continue><?= $esc((string) __('查看订单')) ?></a>
            <?php endif; ?>
            <a class="w-btn w-btn--ghost" href="/"><?= $esc((string) __('返回首页')) ?></a>
        </div>
    </div>
    <?php else: ?>

    <form class="w-express-review__form"
          data-express-review-form
          onsubmit="return false;"
          weline-code="checkout.express-review.form">
    <section class="w-express-review__card" weline-code="checkout.express-review.address" data-express-address-block>
