<script>
(function () {
    try {
        if (window.opener && !window.opener.closed) {
            window.opener.location = window.location.href;
            window.close();
            return;
        }
        if (window.top && window.top !== window.self) {
            window.top.location = window.location.href;
        }
    } catch (e) {}
})();
</script>
