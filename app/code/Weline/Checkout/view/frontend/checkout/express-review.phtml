        <div class="w-express-review__shipping-packages" data-express-shipping-packages hidden data-testid="checkout-split-shipping-packages"></div>
        <p class="w-express-review__hint" data-express-shipping-empty hidden>
            <?= $esc((string) __('该地区暂不支持配送')) ?>
        </p>
    </section>

    <section class="w-express-review__card" weline-code="checkout.express-review.totals" data-express-totals-block>
        <h2 class="w-express-review__card-title"><?= $esc((string) __('应付合计')) ?></h2>
        <dl class="w-express-review__totals">
            <div><dt><?= $esc((string) __('小计')) ?></dt><dd data-express-subtotal>—</dd></div>
            <div><dt><?= $esc((string) __('运费')) ?></dt><dd data-express-shipping>—</dd></div>
