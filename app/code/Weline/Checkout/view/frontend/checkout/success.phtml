    }

    .checkout-success-page .order-info {
        margin-top: 16px;
    }

    .checkout-success-page .order-info h2 {
        margin: 0 0 18px;
        font-size: 20px;
    }

    .checkout-success-page .info-row {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        padding: 12px 0;
        border-top: 1px solid var(--weline-theme-border-color-subtle, #d1d5db);
    }

    .checkout-success-page .info-row span:first-child {
        color: var(--weline-layout-text-secondary, #64748b);
    }

    .checkout-success-page .order-actions {
