<?php
/**
 * 结账成功页（对齐 Payment return Amazon 订单确认风格）。
 */
$order = $this->getData('order');
$orderV2 = $this->getData('order_v2');
$orderV2DisplayNumber = (string)($this->getData('order_v2_display_number') ?? '');
$orderV2Status = (string)($this->getData('order_v2_status') ?? '');
$orderV2TotalLabel = (string)($this->getData('order_v2_total_label') ?? '');
$orderV2StatusLabels = [
    'pending' => (string) __('待处理'),
    'processing' => (string) __('处理中'),
    'paid' => (string) __('已支付'),
    'fulfilled' => (string) __('已发货'),
    'completed' => (string) __('已完成'),
    'cancelled' => (string) __('已取消'),
    'refunded' => (string) __('已退款'),
];
$requestOrderUuid = trim((string)$this->request->getParam('order_uuid'));
$requestCheckoutGroupUuid = trim((string)$this->request->getParam('checkout_group_uuid'));
$requestOutcome = strtolower(trim((string)$this->request->getParam('outcome')));
$paymentCancelled = !empty($this->getData('checkout_payment_cancelled'))
    || $requestOutcome === 'cancel';
$paidAck = !empty($this->getData('checkout_paid_ack'));
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$formatMoney = static fn(string $currency, int $minor): string => sprintf(
    '%s %s',
    $currency,
    number_format($minor / 100, 2, '.', ',')
);
if (is_array($orderV2)) {
    $orderV2DisplayNumber = $orderV2DisplayNumber !== ''
        ? $orderV2DisplayNumber
        : (string)($orderV2['display_number'] ?? $orderV2['order_uuid'] ?? '');
    $orderV2Status = $orderV2Status !== ''
        ? $orderV2Status
        : (string)($orderV2['status'] ?? '');
    if ($orderV2TotalLabel === '') {
        $currency = (string)($orderV2['currency'] ?? '');
        $money = is_array($orderV2['money'] ?? null) ? $orderV2['money'] : [];
        if ($currency !== '' && array_key_exists('grand_total_minor', $money)) {
            $orderV2TotalLabel = $formatMoney($currency, (int)$money['grand_total_minor']);
        }
    }
}
$orderV2DisplayNumber = $orderV2DisplayNumber !== '' ? $orderV2DisplayNumber : $requestOrderUuid;
$orderV2StatusLabel = $orderV2StatusLabels[$orderV2Status] ?? $orderV2Status;
$legacyOrderStatus = $order ? strtolower(trim((string)$order->getStatus())) : '';
$cancelAlready = !empty($this->getData('checkout_cancel_already'))
    || strtolower(trim((string)$this->request->getParam('cancel_state'))) === 'already'
    || ($paymentCancelled && in_array(strtolower($orderV2Status), ['cancelled', 'canceled'], true))
    || ($paymentCancelled && in_array($legacyOrderStatus, ['cancelled', 'canceled'], true));
$heroTone = $paymentCancelled ? 'danger' : 'success';
$orderCurrency = is_array($orderV2) ? (string)($orderV2['currency'] ?? '') : '';
$shipping = is_array($orderV2) && is_array($orderV2['shipping'] ?? null) ? $orderV2['shipping'] : [];
$shippingAddress = is_array($shipping['address'] ?? null) ? $shipping['address'] : [];
$billingAddress = is_array($orderV2) && is_array($orderV2['billing_address'] ?? null)
    ? $orderV2['billing_address']
    : [];
$formatAddressLines = static function (array $address): array {
    return array_values(array_filter([
        trim((string)($address['address'] ?? '')),
        trim((string)($address['address1'] ?? '')),
        trim((string)($address['address2'] ?? '')),
        implode(' ', array_filter([
            trim((string)($address['district'] ?? '')),
            trim((string)($address['city'] ?? '')),
            trim((string)($address['province'] ?? '')),
            trim((string)($address['postal_code'] ?? '')),
        ], static fn(string $v): bool => $v !== '')),
        trim((string)($address['country_code'] ?? $address['country'] ?? '')),
    ], static fn(string $v): bool => $v !== ''));
};
$addressHasContent = static function (array $address) use ($formatAddressLines): bool {
    if ($address === []) {
        return false;
    }
    $name = trim((string)($address['name'] ?? ''));
    $phone = trim((string)($address['phone'] ?? $address['telephone'] ?? $address['mobile'] ?? ''));
    $email = trim((string)($address['email'] ?? ''));

    return $name !== '' || $phone !== '' || $email !== '' || $formatAddressLines($address) !== [];
};
$shippingName = trim((string)($shippingAddress['name'] ?? ''));
$shippingPhone = trim((string)($shippingAddress['phone'] ?? ''));
$shippingEmail = trim((string)($shippingAddress['email'] ?? ''));
$shippingMethod = trim((string)($this->getData('shipping_method_label') ?? ''));
if ($shippingMethod === '') {
    $shippingMethod = trim((string)($shipping['method_label'] ?? ''));
}
if ($shippingMethod === '') {
    $shippingMethod = trim((string)($shipping['method'] ?? ''));
}
$shippingLines = $formatAddressLines($shippingAddress);
$showBillingAddress = $addressHasContent($billingAddress);
$billingName = trim((string)($billingAddress['name'] ?? ''));
$billingPhone = trim((string)($billingAddress['phone'] ?? $billingAddress['telephone'] ?? $billingAddress['mobile'] ?? ''));
$billingLines = $showBillingAddress ? $formatAddressLines($billingAddress) : [];
$billingSameAsShipping = $showBillingAddress
    && $shippingName === $billingName
    && $shippingPhone === $billingPhone
    && $shippingLines === $billingLines;
$orderItemsRaw = is_array($orderV2) && is_array($orderV2['items'] ?? null) ? $orderV2['items'] : [];
$orderItemsDisplay = $this->getData('order_v2_items_display');
$orderItems = is_array($orderItemsDisplay) && $orderItemsDisplay !== []
    ? $orderItemsDisplay
    : $orderItemsRaw;
$money = is_array($orderV2) && is_array($orderV2['money'] ?? null) ? $orderV2['money'] : [];
$totalsLines = [];
if ($orderCurrency !== '' && $money !== []) {
    $map = [
        ['key' => 'subtotal_minor', 'label' => (string) __('商品小计')],
        ['key' => 'shipping_amount_minor', 'label' => (string) __('运费')],
        ['key' => 'tax_amount_minor', 'label' => (string) __('税费')],
        ['key' => 'discount_amount_minor', 'label' => (string) __('优惠'), 'negate' => true],
        ['key' => 'cod_fee_amount_minor', 'label' => (string) \Weline\Theme\Helper\WidgetI18n::label('货到付款手续费')],
        ['key' => 'grand_total_minor', 'label' => (string) __('订单总额'), 'emphasis' => true],
    ];
    foreach ($map as $row) {
        if (!array_key_exists($row['key'], $money)) {
            continue;
        }
        $minor = (int)$money[$row['key']];
        if ($minor === 0 && empty($row['emphasis'])) {
            continue;
        }
        if (!empty($row['negate']) && $minor > 0) {
            $minor = -$minor;
        }
        $totalsLines[] = [
            'key' => $row['key'],
            'label' => $row['label'],
            'amount_minor' => $minor,
            'emphasis' => !empty($row['emphasis']),
        ];
    }
}
/** GA4 对齐：转化事件 value / currency / items（与 purchase 参数一致） */
$pixelCurrency = $orderCurrency;
$pixelValue = '';
if ($orderCurrency !== '' && array_key_exists('grand_total_minor', $money)) {
    $pixelValue = number_format(((int)$money['grand_total_minor']) / 100, 2, '.', '');
}
$pixelItems = [];
foreach ($orderItems as $pixelItemRow) {
    if (!is_array($pixelItemRow)) {
        continue;
    }
    $pid = trim((string)($pixelItemRow['product_id'] ?? ''));
    $sku = trim((string)($pixelItemRow['sku'] ?? ''));
    $itemId = $pid !== '' ? $pid : $sku;
    $itemName = trim((string)($pixelItemRow['name'] ?? $pixelItemRow['product_name'] ?? $sku));
    $qty = (int)($pixelItemRow['qty'] ?? $pixelItemRow['quantity'] ?? 0);
    if ($qty <= 0) {
        $qty = 1;
    }
    $unitMinor = (int)($pixelItemRow['unit_price_minor'] ?? 0);
    if ($unitMinor <= 0 && isset($pixelItemRow['row_total_minor'])) {
        $unitMinor = (int)round(((int)$pixelItemRow['row_total_minor']) / $qty);
    }
    $price = $unitMinor > 0 ? round($unitMinor / 100, 2) : null;
    if ($itemId === '' && $itemName === '' && $price === null) {
        continue;
    }
    $ga4Item = [
        'item_id' => $itemId,
        'item_name' => $itemName,
        'product_id' => $pid !== '' ? $pid : $itemId,
        'quantity' => $qty,
    ];
    if ($sku !== '') {
        $ga4Item['sku'] = $sku;
    }
    if ($price !== null) {
        $ga4Item['price'] = $price;
    }
    $pixelItems[] = $ga4Item;
    if (count($pixelItems) >= 20) {
        break;
    }
}
?>
