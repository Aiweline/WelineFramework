        <ul class="amz-order-confirm__items">
            <?php foreach ($orderItems as $item): ?>
                <?php if (!is_array($item)) {
                    continue;
                } ?>
                <?php
                $productId = (int)($item['product_id'] ?? 0);
                $imageSrc = trim((string)($item['image_src'] ?? $item['image'] ?? ''));
                $imageFallback = trim((string)($item['image_fallback'] ?? ''));
                if ($imageSrc === '' && $productId > 0 && class_exists(\Weline\Theme\Helper\StorefrontImagePlaceholder::class)) {
                    $imageResolved = \Weline\Theme\Helper\StorefrontImagePlaceholder::resolve('', $productId);
                    $imageSrc = $imageResolved['src'];
                    $imageFallback = $imageResolved['fallback'];
                }
                $qty = (int)($item['qty'] ?? $item['quantity'] ?? $item['qty_minor'] ?? 0);
                $unitMinor = (int)($item['unit_price_minor'] ?? 0);
                $rowMinor = (int)($item['row_total_minor'] ?? ($unitMinor * max(1, $qty)));
                $rowLabel = $orderCurrency !== '' ? $formatMoney($orderCurrency, $rowMinor) : '';
                $itemName = (string)($item['name'] ?? $item['product_name'] ?? $item['sku'] ?? '');
                ?>
                <li class="amz-order-confirm__item"
                    data-order-item="1"
                    <?php if ($productId > 0): ?>data-product-id="<?= $escape((string)$productId) ?>"<?php endif; ?>
                    <?php if ($itemName !== ''): ?>data-product-name="<?= $escape($itemName) ?>"<?php endif; ?>
                    <?php if ($unitMinor > 0): ?>data-price="<?= $escape(number_format($unitMinor / 100, 2, '.', '')) ?>"<?php endif; ?>
                    <?php if ($qty > 0): ?>data-qty="<?= $escape((string)$qty) ?>"<?php endif; ?>>
                    <div class="amz-order-confirm__item-media">
