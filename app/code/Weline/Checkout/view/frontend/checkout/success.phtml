$transactionNoParam = trim((string)$this->request->getParam('transaction_no'));
?>
<script>
(function () {
    var orderUuid = <?= json_encode($requestOrderUuid, JSON_UNESCAPED_UNICODE) ?>;
    var checkoutGroupUuid = <?= json_encode($requestCheckoutGroupUuid, JSON_UNESCAPED_UNICODE) ?>;
    var transactionNo = <?= json_encode($transactionNoParam, JSON_UNESCAPED_UNICODE) ?>;
    var orderId = <?= json_encode($orderV2DisplayNumber, JSON_UNESCAPED_UNICODE) ?>;
    if (!orderUuid && !checkoutGroupUuid && !transactionNo && !orderId) {
        return;
    }
    var attempts = 0;
    var maxAttempts = 80;
    function fire() {
        attempts += 1;
        if (typeof window.WelinePixel === 'undefined' || typeof window.WelinePixel.track !== 'function') {
            if (attempts < maxAttempts) {
                window.setTimeout(fire, 50);
            }
            return;
        }
        window.WelinePixel.track('checkout_success', {
            order_uuid: orderUuid,
            checkout_group_uuid: checkoutGroupUuid,
            transaction_id: transactionNo || orderUuid || checkoutGroupUuid || orderId,
            order_id: orderId || orderUuid,
            value: <?= json_encode($pixelValue !== '' ? (float)$pixelValue : null, JSON_UNESCAPED_UNICODE) ?>,
            currency: <?= json_encode($pixelCurrency, JSON_UNESCAPED_UNICODE) ?>,
            grand_total: <?= json_encode($pixelValue !== '' ? (float)$pixelValue : null, JSON_UNESCAPED_UNICODE) ?>,
            items: <?= json_encode($pixelItems, JSON_UNESCAPED_UNICODE) ?>
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fire);
    } else {
        fire();
    }
})();
</script>
<?php endif; ?>
