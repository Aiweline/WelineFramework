<?php
/**
 * 结账成功页面
 */
$order = $this->getData('order');
$orderV2 = $this->getData('order_v2');
$orderV2DisplayNumber = (string)($this->getData('order_v2_display_number') ?? '');
$orderV2Status = (string)($this->getData('order_v2_status') ?? '');
$orderV2TotalLabel = (string)($this->getData('order_v2_total_label') ?? '');
$orderV2StatusLabels = [
    'pending' => (string) __('待处理'),
    'processing' => (string) __('处理中'),
    'paid' => (string) __('已支付'),
    'fulfilled' => (string) __('已发货'),
    'completed' => (string) __('已完成'),
    'cancelled' => (string) __('已取消'),
    'refunded' => (string) __('已退款'),
];
$requestOrderUuid = trim((string)$this->request->getParam('order_uuid'));
$requestCheckoutGroupUuid = trim((string)$this->request->getParam('checkout_group_uuid'));
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
if (is_array($orderV2)) {
    $orderV2DisplayNumber = $orderV2DisplayNumber !== ''
        ? $orderV2DisplayNumber
        : (string)($orderV2['display_number'] ?? $orderV2['order_uuid'] ?? '');
    $orderV2Status = $orderV2Status !== ''
        ? $orderV2Status
        : (string)($orderV2['status'] ?? '');
    if ($orderV2TotalLabel === '') {
        $currency = (string)($orderV2['currency'] ?? '');
        $money = is_array($orderV2['money'] ?? null) ? $orderV2['money'] : [];
        if ($currency !== '' && array_key_exists('grand_total_minor', $money)) {
            $orderV2TotalLabel = sprintf(
                '%s %s',
                $currency,
                number_format(((int)$money['grand_total_minor']) / 100, 2, '.', ',')
            );
        }
    }
}
$orderV2DisplayNumber = $orderV2DisplayNumber !== '' ? $orderV2DisplayNumber : $requestOrderUuid;
$orderV2StatusLabel = $orderV2StatusLabels[$orderV2Status] ?? $orderV2Status;
$accountOrdersUrl = $this->getUrl('customer/account/index') . '#orders';
$accountOrderDetailUrl = $requestOrderUuid !== ''
    ? $this->getUrl('customer/account/index', ['order_uuid' => $requestOrderUuid]) . '#orders'
    : $accountOrdersUrl;
?>
<section class="checkout-success-page"
    data-testid="checkout-success"
    data-order-uuid="<?= $escape($requestOrderUuid) ?>"
    data-checkout-group-uuid="<?= $escape($requestCheckoutGroupUuid) ?>"
    weline-code="checkout.checkout.success.section_1"
>
    <div class="success-message">
        <span class="success-message__mark" aria-hidden="true">✓</span>
        <h1><?= __('结账成功') ?></h1>
        <p><?= __('感谢您的购买！您的订单已成功创建。') ?></p>
    </div>

    <?php if (is_array($orderV2) || $orderV2DisplayNumber !== ''): ?>
    <div class="order-info">
        <h2><?= __('订单信息') ?></h2>
        <div class="info-row">
            <span><?= __('订单号') ?>:</span>
            <strong><?= $escape($orderV2DisplayNumber) ?></strong>
        </div>
        <?php if ($orderV2Status !== ''): ?>
        <div class="info-row">
            <span><?= __('订单状态') ?>:</span>
            <span><?= $escape($orderV2StatusLabel) ?></span>
        </div>
        <?php endif; ?>
        <?php if ($orderV2TotalLabel !== ''): ?>
        <div class="info-row">
            <span><?= __('订单总额') ?>:</span>
            <strong><?= $escape($orderV2TotalLabel) ?></strong>
        </div>
        <?php endif; ?>
    </div>
    <?php endif; ?>

    <?php if ($order): ?>
    <div class="order-info">
        <h2><?= __('订单信息') ?></h2>
        <div class="info-row">
            <span><?= __('订单号') ?>:</span>
            <strong><?= $escape($order->getOrderNumber()) ?></strong>
        </div>
        <div class="info-row">
            <span><?= __('订单状态') ?>:</span>
            <span><?= $escape($order->getStatusText()) ?></span>
        </div>
        <div class="info-row">
            <span><?= __('支付状态') ?>:</span>
            <span><?= $escape($order->getPaymentStatusText()) ?></span>
        </div>
        <div class="info-row">
            <span><?= __('订单总额') ?>:</span>
            <strong><?= $escape($order->getCurrency()) ?> <?= number_format($order->getTotalAmount(), 2) ?></strong>
        </div>
        <div class="info-row">
            <span><?= __('创建时间') ?>:</span>
            <span><?= $escape($order->getCreatedTime()) ?></span>
        </div>
    </div>
    <?php endif; ?>

    <div class="order-actions">
        <?php if ($requestOrderUuid !== ''): ?>
        <a href="<?= $escape($accountOrderDetailUrl) ?>" class="w-button weline-pixel::view_order" data-tone="primary">
            <?= __('查看订单详情') ?>
        </a>
        <?php endif; ?>
        <a href="<?= $escape($accountOrdersUrl) ?>" class="w-button weline-pixel::view_orders" data-tone="neutral">
            <?= __('返回订单列表') ?>
        </a>
        <a href="<?= $this->getUrl('products') ?>" class="w-button weline-pixel::continue_shopping" data-tone="neutral">
            <?= __('继续购物') ?>
        </a>
    </div>
</section>

