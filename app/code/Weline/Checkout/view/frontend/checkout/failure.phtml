<?php
/**
 * 结算失败页业务内容（对齐结账成功页英雄区结构，danger 语气）。
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$title = trim((string)($this->getData('title') ?? __('订单尚未完成')));
$errorMessage = trim((string)($this->getData('error_message') ?? ''));
if ($errorMessage === '') {
    $errorMessage = (string)__(
        '本次结算没有生成有效订单，也不会在此页面重复扣款。您可以返回购物车核对商品，或前往帮助中心排查支付与配送问题。'
    );
}
$errorCode = trim((string)($this->getData('error_code') ?? ''));
$retryUrl = trim((string)($this->getData('retry_url') ?? ''));
?>
<main class="amz-order-confirm amz-order-confirm--danger checkout-failure-page weline-pixel::checkout_failure"
    weline-code="checkout.checkout.failure.section_1"
    data-testid="checkout-failure"
    data-weline-load="cart,checkoutLifecycle"
    data-checkout-lifecycle="failure"
    data-payment-outcome="failure"
    data-pixel-event="checkout_failure"
    <?php if ($errorCode !== ''): ?>
    data-error-code="<?= $escape($errorCode) ?>"
    <?php endif; ?>
>
    <header class="amz-order-confirm__banner amz-order-confirm__banner--hero">
        <div class="amz-order-confirm__banner-inner">
            <span class="amz-order-confirm__check" aria-hidden="true">×</span>
            <div class="amz-order-confirm__banner-copy">
                <h1><?= $escape($title) ?></h1>
                <p><?= $escape($errorMessage) ?></p>
                <?php if ($errorCode !== ''): ?>
                    <p class="amz-order-confirm__order-no">
                        <?= $escape(__('错误代码')) ?>：
                        <strong><?= $escape($errorCode) ?></strong>
                    </p>
                <?php endif; ?>
            </div>
        </div>
    </header>

    <section class="amz-order-confirm__panel" weline-code="checkout.checkout.failure.actions">
        <div class="amz-order-confirm__actions">
            <?php if ($retryUrl !== ''): ?>
                <a class="amz-order-confirm__btn amz-order-confirm__btn--primary"
                   href="<?= $escape($retryUrl) ?>"
                   data-testid="checkout-failure-retry"><?= $escape(__('重试结算')) ?></a>
            <?php endif; ?>
            <a class="amz-order-confirm__btn amz-order-confirm__btn--primary"
               href="@url{'cart'}"
               data-testid="checkout-failure-cart"><?= $escape(__('返回购物车')) ?></a>
            <a class="amz-order-confirm__btn amz-order-confirm__btn--secondary"
               href="@url{'checkout'}"
               data-testid="checkout-failure-checkout"><?= $escape(__('返回结账')) ?></a>
            <a class="amz-order-confirm__btn amz-order-confirm__btn--secondary"
               href="@url{'faq'}"
               data-testid="checkout-failure-help"><?= $escape(__('查看帮助中心')) ?></a>
        </div>
    </section>
</main>

