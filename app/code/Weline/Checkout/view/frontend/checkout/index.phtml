<script>
(function () {
    'use strict';

    const copy = <?= json_encode($copy, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    const successPageUrl = <?= json_encode($successPageUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    const root = document.querySelector('[data-weline-checkout]');
    if (!root) {
        return;
    }

    const form = root.querySelector('[data-checkout-form]');
    const message = root.querySelector('[data-checkout-message]');
    const emptyState = root.querySelector('[data-checkout-empty]');
    const paymentRecovery = root.querySelector('[data-checkout-payment-recovery]');
    const paymentRecoveryTitle = root.querySelector('[data-payment-recovery-title]');
    const paymentRecoveryDetail = root.querySelector('[data-payment-recovery-detail]');
    const paymentOrderReference = root.querySelector('[data-payment-order-reference]');
    const paymentRetryButton = root.querySelector('[data-payment-retry]');
    const submitButton = root.querySelector('[data-submit]');
    const shippingBox = root.querySelector('[data-shipping-methods]');
    const paymentBox = root.querySelector('[data-payment-methods]');
    const itemsBox = root.querySelector('[data-cart-items]');
    const subtotalNode = root.querySelector('[data-subtotal]');
    const shippingAmountNode = root.querySelector('[data-shipping-amount]');
    const grandTotalNode = root.querySelector('[data-grand-total]');

    let checkoutApi = null;
    let activePaymentRecovery = null;
    let customerAddressPrefilled = false;
    const guestTokenStorageKey = 'weline.cart.guest_token';
    let checkoutState = {
        currency: 'CNY',
        cart: {},
        shippingMethods: [],
        paymentMethods: [],
        identity: {
            checkout_mode: 'guest',
            is_guest_checkout: true,
            guest_allowed: true,
            requires_guest_email: true,
        },
    };

    function text(value) {
        return value == null ? '' : String(value);
    }

    function setMessage(value, type) {
        if (!message) {
            return;
        }
        message.textContent = text(value);
        message.classList.toggle('is-error', type === 'error');
        message.classList.toggle('is-success', type === 'success');
    }

    function setText(node, value) {
        if (node) {
            node.textContent = text(value);
        }
    }

    function money(amount) {
        const currency = checkoutState.currency || 'CNY';
        const numericAmount = Number(amount || 0);
        const formattedAmount = new Intl.NumberFormat(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }).format(Number.isFinite(numericAmount) ? numericAmount : 0);
        return currency + ' ' + formattedAmount;
    }

    function formAddress() {
        const data = new FormData(form);
        return {
            name: text(data.get('name')).trim(),
            phone: text(data.get('phone')).trim(),
            email: text(data.get('email')).trim(),
            country_code: text(data.get('country_code')).trim().toUpperCase() || 'CN',
            province: text(data.get('province')).trim(),
            city: text(data.get('city')).trim(),
            address1: text(data.get('address1')).trim(),
            postal_code: text(data.get('postal_code')).trim(),
        };
    }

    function applyDefaultShippingAddress(address) {
        if (customerAddressPrefilled || !form || !address || typeof address !== 'object') {
            return;
        }
        const fields = ['name', 'phone', 'email', 'country_code', 'province', 'city', 'address1', 'postal_code'];
        let applied = false;
        fields.forEach(function (field) {
            const input = form.querySelector('[name="' + field + '"]');
            const value = text(address[field]).trim();
            if (!input || !value || text(input.value).trim()) {
                return;
            }
            input.value = value;
            applied = true;
        });
        customerAddressPrefilled = applied;
    }

    function selectedValue(name) {
        const checked = form.querySelector('input[name="' + name + '"]:checked');
        return checked ? checked.value : '';
    }

    function guestToken() {
        try {
            return text(window.sessionStorage.getItem(guestTokenStorageKey)).trim();
        } catch (error) {
            return '';
        }
    }

    function newIdempotencyKey(prefix) {
        return prefix + (
            window.crypto && typeof window.crypto.randomUUID === 'function'
                ? window.crypto.randomUUID()
                : Date.now().toString(36) + Math.random().toString(36).slice(2)
        );
    }

    function paymentRecoveryFromLocation() {
        const prefix = '#payment-recovery?';
        if (!window.location.hash.startsWith(prefix)) {
            return null;
        }
        const params = new URLSearchParams(window.location.hash.slice(prefix.length));
        const state = {
            quote_token: text(params.get('quote_token')).trim(),
            idempotency_key: text(params.get('idempotency_key')).trim(),
            payment_method: text(params.get('payment_method')).trim(),
            country_code: text(params.get('country_code')).trim(),
            order_uuid: text(params.get('order_uuid')).trim(),
            checkout_group_uuid: text(params.get('checkout_group_uuid')).trim(),
            outcome: text(params.get('outcome')).trim(),
            redirect_url: text(params.get('redirect_url')).trim(),
            recoverable: params.get('recoverable') !== '0',
        };
        return state.quote_token && state.idempotency_key && state.payment_method && state.order_uuid
            ? state
            : null;
    }

    function persistPaymentRecovery(state) {
        const params = new URLSearchParams();
        Object.keys(state).forEach(function (key) {
            const value = typeof state[key] === 'boolean'
                ? (state[key] ? '1' : '0')
                : text(state[key]).trim();
            if (value) {
                params.set(key, value);
            }
        });
        window.history.replaceState(
            null,
            '',
            window.location.pathname + window.location.search + '#payment-recovery?' + params.toString()
        );
    }

    function safePaymentRedirect(value) {
        const raw = text(value).trim();
        if (!raw) {
            return '';
        }
        try {
            const url = new URL(raw, window.location.origin);
            return url.protocol === 'http:' || url.protocol === 'https:' ? url.toString() : '';
        } catch (error) {
            return '';
        }
    }

    function showPaymentRecovery(state) {
        activePaymentRecovery = state;
        if (form) {
            form.hidden = true;
        }
        if (emptyState) {
            emptyState.hidden = true;
        }
        if (paymentRecovery) {
            paymentRecovery.hidden = false;
        }
        if (message) {
            message.hidden = false;
        }
        const pending = state.outcome === 'pending';
        setText(paymentRecoveryTitle, pending ? copy.payment_pending : copy.payment_failed);
        setText(paymentRecoveryDetail, pending ? copy.payment_pending : copy.payment_failed);
        setText(paymentOrderReference, state.order_uuid);
        if (paymentRetryButton) {
            const canContinue = Boolean(safePaymentRedirect(state.redirect_url));
            paymentRetryButton.hidden = pending ? !canContinue : !state.recoverable;
            paymentRetryButton.disabled = false;
            setText(paymentRetryButton, canContinue ? copy.continue_payment : copy.retry_payment);
        }
        setMessage(pending ? copy.payment_pending : copy.payment_failed, pending ? 'success' : 'error');
    }

    function navigateToSuccess(state) {
        const successUrl = new URL(successPageUrl, window.location.origin);
        successUrl.searchParams.set('order_uuid', state.order_uuid);
        successUrl.searchParams.set('checkout_group_uuid', state.checkout_group_uuid);
        const checkoutToken = text(state.quote_token).trim();
        successUrl.searchParams.set('checkout_token', checkoutToken);
        window.location.assign(successUrl.toString());
    }

    function handlePaymentResult(result, state) {
        const data = result.data && typeof result.data === 'object' ? result.data : result;
        const orderUuids = Array.isArray(result.order_uuids)
            ? result.order_uuids
            : (Array.isArray(data.order_uuids) ? data.order_uuids : []);
        state.order_uuid = text(orderUuids[0] || state.order_uuid);
        state.checkout_group_uuid = text(
            result.checkout_group_uuid || data.checkout_group_uuid || state.checkout_group_uuid
        );
        state.quote_token = text(result.checkout_token || state.quote_token);
        if (!state.order_uuid || !state.checkout_group_uuid || !state.quote_token) {
            throw new Error(copy.load_failed);
        }

        const payment = result.payment && typeof result.payment === 'object' ? result.payment : {};
        const outcome = text(payment.outcome || (payment.paid ? 'paid' : payment.status)).toLowerCase();
        if (outcome === 'paid' || payment.paid) {
            navigateToSuccess(state);
            return;
        }

        state.outcome = outcome === 'failed' ? 'failed' : 'pending';
        state.redirect_url = safePaymentRedirect(payment.redirect_url || state.redirect_url);
        state.recoverable = payment.recoverable !== false;
        persistPaymentRecovery(state);
        showPaymentRecovery(state);
        if (state.outcome === 'pending' && state.redirect_url) {
            setMessage(copy.payment_redirect, 'success');
            window.location.assign(state.redirect_url);
        }
    }

    function selectedShippingAmount() {
        const code = selectedValue('shipping_method');
        const method = checkoutState.shippingMethods.find(function (entry) {
            return entry && entry.code === code;
        });
        return method ? Number(method.amount || method.fee || 0) : 0;
    }

    /**
     * P2E-003：只注入服务端 HTML，禁止 createElement 拼商品/选项 DOM。
     */
    function applyServerHtml(node, html) {
        if (!node || typeof html !== 'string') {
            return;
        }
        node.innerHTML = html;
    }

    function renderTotals() {
        const subtotal = Number(checkoutState.cart.subtotal || 0);
        const shipping = selectedShippingAmount();
        setText(subtotalNode, money(subtotal));
        setText(shippingAmountNode, money(shipping));
        setText(grandTotalNode, money(subtotal + shipping));
    }

    function render(data) {
        applyDefaultShippingAddress(data.default_shipping_address);
        checkoutState.currency = text(data.currency || data.cart && data.cart.currency || 'CNY') || 'CNY';
        checkoutState.cart = data.cart || {};
        checkoutState.shippingMethods = Array.isArray(data.shipping_methods) ? data.shipping_methods : [];
        checkoutState.paymentMethods = Array.isArray(data.payment_methods) ? data.payment_methods : [];
        checkoutState.identity = data.identity || checkoutState.identity || {
            checkout_mode: 'guest',
            is_guest_checkout: true,
            guest_allowed: true,
            requires_guest_email: true,
        };
        const cartIsEmpty = Boolean(checkoutState.cart.is_empty);
        if (form) {
            form.hidden = cartIsEmpty;
        }
        if (emptyState) {
            emptyState.hidden = !cartIsEmpty;
        }
        if (message) {
            message.hidden = cartIsEmpty;
        }
        const emailInput = form ? form.querySelector('input[name="email"]') : null;
        if (emailInput) {
            emailInput.required = Boolean(checkoutState.identity.is_guest_checkout);
        }
        applyServerHtml(itemsBox, data.items_html);
        applyServerHtml(shippingBox, data.shipping_methods_html);
        applyServerHtml(paymentBox, data.payment_methods_html);
        renderTotals();
        if (submitButton) {
            submitButton.disabled = cartIsEmpty || !checkoutState.shippingMethods.length || !checkoutState.paymentMethods.length;
        }
        if (cartIsEmpty) {
            setMessage(copy.empty_cart, 'error');
        } else {
            setMessage('<?= __('请确认收货信息、配送方式和支付方式。') ?>', 'success');
        }
    }

    async function getApi() {
        if (checkoutApi) {
            return checkoutApi;
        }
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error(copy.api_missing);
        }
        checkoutApi = await window.Weline.Api.resource('checkout');
        return checkoutApi;
    }

    async function loadCheckout() {
        const api = await getApi();
        const data = await api.getData({
            shipping_address: formAddress(),
            guest_token: guestToken(),
        });
        render(data || {});
    }

    let reloadTimer = null;
    function scheduleReload() {
        window.clearTimeout(reloadTimer);
        reloadTimer = window.setTimeout(function () {
            loadCheckout().catch(function (error) {
                setMessage(error.message || copy.load_failed, 'error');
            });
        }, 350);
    }

    if (form) {
        form.addEventListener('change', function (event) {
            if (event.target && event.target.name === 'shipping_method') {
                renderTotals();
                return;
            }
            if (event.target && ['country_code', 'province', 'city', 'postal_code'].indexOf(event.target.name) !== -1) {
                scheduleReload();
            }
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (!form.reportValidity()) {
                setMessage(copy.required, 'error');
                return;
            }
            const shippingMethod = selectedValue('shipping_method');
            const paymentMethod = selectedValue('payment_method');
            if (!shippingMethod || !paymentMethod) {
                setMessage(copy.required, 'error');
                return;
            }
            if (submitButton) {
                submitButton.disabled = true;
                setText(submitButton, copy.submitting);
            }
            setMessage(copy.submitting, '');
            try {
                const api = await getApi();
                const address = formAddress();
                const frozen = await api.freezeQuote({
                    address: address,
                    service_code: shippingMethod,
                    guest_token: guestToken(),
                });
                if (!frozen || frozen.success === false) {
                    throw new Error(text(frozen && frozen.message) || copy.load_failed);
                }
                const quoteToken = text(frozen.quote_token || frozen.data && frozen.data.quote_token);
                if (!quoteToken) {
                    throw new Error(copy.load_failed);
                }
                const idempotencyKey = newIdempotencyKey('checkout_ui_');
                const result = await api.submitV2({
                    quote_token: quoteToken,
                    payment_method: paymentMethod,
                    idempotency_key: idempotencyKey,
                    country_code: address.country_code,
                    guest_token: guestToken(),
                });
                if (!result || result.success === false) {
                    throw new Error(text(result && result.message) || copy.load_failed);
                }
                handlePaymentResult(result, {
                    quote_token: quoteToken,
                    idempotency_key: idempotencyKey,
                    payment_method: paymentMethod,
                    country_code: address.country_code,
                    order_uuid: '',
                    checkout_group_uuid: '',
                    outcome: '',
                    redirect_url: '',
                    recoverable: true,
                });
            } catch (error) {
                setMessage(error.message || copy.load_failed, 'error');
                if (submitButton) {
                    submitButton.disabled = false;
                    setText(submitButton, copy.submit);
                }
            }
        });
    }

    if (shippingBox) {
        shippingBox.addEventListener('change', renderTotals);
    }

    if (paymentRetryButton) {
        paymentRetryButton.addEventListener('click', async function () {
            if (!activePaymentRecovery) {
                return;
            }
            const redirectUrl = safePaymentRedirect(activePaymentRecovery.redirect_url);
            if (activePaymentRecovery.outcome === 'pending' && redirectUrl) {
                window.location.assign(redirectUrl);
                return;
            }
            paymentRetryButton.disabled = true;
            setText(paymentRetryButton, copy.retrying_payment);
            setMessage(copy.retrying_payment, '');
            try {
                const api = await getApi();
                const result = await api.resumePaymentV2({
                    quote_token: activePaymentRecovery.quote_token,
                    idempotency_key: activePaymentRecovery.idempotency_key,
                    payment_idempotency_key: newIdempotencyKey('checkout_payment_retry_'),
                    payment_method: activePaymentRecovery.payment_method,
                    country_code: activePaymentRecovery.country_code,
                });
                if (!result || result.success === false) {
                    throw new Error(text(result && result.message) || copy.load_failed);
                }
                handlePaymentResult(result, activePaymentRecovery);
            } catch (error) {
                setMessage(error.message || copy.payment_failed, 'error');
                paymentRetryButton.disabled = false;
                setText(paymentRetryButton, copy.retry_payment);
            }
        });
    }

    const initialPaymentRecovery = paymentRecoveryFromLocation();
    if (initialPaymentRecovery) {
        showPaymentRecovery(initialPaymentRecovery);
    } else {
        loadCheckout().catch(function (error) {
            setMessage(error.message || copy.load_failed, 'error');
            if (submitButton) {
                submitButton.disabled = true;
            }
        });
    }
})();
</script>
