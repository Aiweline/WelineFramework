    function handlePaymentResult(result, state) {
        const data = result.data && typeof result.data === 'object' ? result.data : result;
        const orderUuids = Array.isArray(result.order_uuids)
            ? result.order_uuids
            : (Array.isArray(data.order_uuids) ? data.order_uuids : []);
        state.order_uuid = text(orderUuids[0] || state.order_uuid);
        state.checkout_group_uuid = text(
            result.checkout_group_uuid || data.checkout_group_uuid || state.checkout_group_uuid
        );
        state.quote_token = text(result.checkout_token || state.quote_token);
        if (!state.order_uuid || !state.checkout_group_uuid || !state.quote_token) {
            throw new Error(copy.load_failed);
        }

        const payment = result.payment && typeof result.payment === 'object' ? result.payment : {};
        const outcome = text(payment.outcome || (payment.paid ? 'paid' : payment.status)).toLowerCase();
