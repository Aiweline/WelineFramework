        // issueGuestToken (server reuses the HttpOnly cookie when present).
        // Trusting a stale sessionStorage token alone caused: header SSR shows
        // items from cookie, while checkout.getData used an orphan empty token.
        const result = await cartApi.issueGuestToken({}, { silent: true });
        const payload = result && result.data && typeof result.data === 'object' ? result.data : result;
        const adopted = text(payload && payload.guest_token).trim();
        if (!adopted) {
            if (token) {
                guestTokenAligned = true;
                return token;
            }
            throw new Error(copy.guest_session_failed);
        }

        const expiresAt = Number(payload && payload.expires_at_ms || 0);
        if (window.WelineCart && typeof window.WelineCart.rememberGuestSession === 'function') {
            window.WelineCart.rememberGuestSession(adopted, expiresAt || undefined);
        } else {
            try {
                window.sessionStorage.setItem(guestTokenStorageKey, adopted);
            } catch (error) {
                // This request still owns the token even when storage is unavailable.
            }
        }
        guestTokenAligned = true;
        return adopted;
