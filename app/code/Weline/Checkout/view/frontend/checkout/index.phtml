        if (discountRowNode && discountAmountNode) {
            if (discount > 0) {
                discountRowNode.hidden = false;
                setText(discountAmountNode, '-' + money(discount));
            } else {
                discountRowNode.hidden = true;
                setText(discountAmountNode, money(0));
            }
        }
        setText(grandTotalNode, money(Math.max(0, subtotal + shipping - discount)));
    }

    function render(data) {
        const deliveryAddress = data && data.delivery && typeof data.delivery === 'object'
            ? data.delivery.checkout_address
            : null;
        if (deliveryAddress && typeof deliveryAddress === 'object') {
            applyDefaultShippingAddress(deliveryAddress);
        }
        applyDefaultShippingAddress(data.default_shipping_address);
        checkoutState.currency = text(data.currency || data.cart && data.cart.currency || 'CNY') || 'CNY';
        checkoutState.cart = data.cart || {};
        checkoutState.shippingMethods = Array.isArray(data.shipping_methods) ? data.shipping_methods : [];
        checkoutState.paymentMethods = Array.isArray(data.payment_methods) ? data.payment_methods : [];
        checkoutState.identity = data.identity || checkoutState.identity || {
            checkout_mode: 'guest',
            is_guest_checkout: true,
            guest_allowed: true,
            requires_guest_email: true,
        };
        const cartIsEmpty = Boolean(checkoutState.cart.is_empty);
        if (form) {
            form.hidden = cartIsEmpty;
        }
        if (expressHost) {
            expressHost.hidden = cartIsEmpty;
        }
        if (emptyState) {
            emptyState.hidden = !cartIsEmpty;
        }
        if (message) {
            message.hidden = cartIsEmpty;
        }
        const emailInput = form ? form.querySelector('input[name="email"]') : null;
        if (emailInput) {
            emailInput.required = Boolean(checkoutState.identity.is_guest_checkout);
        }
        applyServerHtml(itemsBox, data.items_html);
        applyServerHtml(shippingBox, data.shipping_methods_html);
        applyServerHtml(paymentBox, data.payment_methods_html);
        renderTotals();
        if (submitButton) {
            submitButton.disabled = cartIsEmpty || !checkoutState.shippingMethods.length || !checkoutState.paymentMethods.length;
        }
        if (cartIsEmpty) {
            setMessage(copy.empty_cart, 'error');
        } else {
            setMessage('<?= __('请确认收货信息、配送方式和支付方式。') ?>', 'success');
        }
    }

    async function getApi() {
        if (checkoutApi) {
            return checkoutApi;
        }
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error(copy.api_missing);
        }
        checkoutApi = await window.Weline.Api.resource('checkout');
        return checkoutApi;
    }

    async function loadCheckout() {
        const api = await getApi();
        let sellingMode = 'toc';
        try {
            if (window.WelineB2BSellingMode && typeof window.WelineB2BSellingMode.preferredMode === 'function') {
                sellingMode = window.WelineB2BSellingMode.preferredMode();
            } else {
                const match = document.cookie.match(/(?:^|; )weline_selling_mode=([^;]*)/);
                const value = match ? decodeURIComponent(match[1]).toLowerCase() : '';
                sellingMode = value === 'tob' ? 'tob' : 'toc';
            }
        } catch (error) {
            sellingMode = 'toc';
        }
        const data = await api.getData({
            shipping_address: formAddress(),
            guest_token: await ensureGuestToken(),
            cart_type: sellingMode,
            selling_mode: sellingMode,
        });
        if (root && data && data.cart && data.cart.cart_type) {
            root.setAttribute('data-cart-type', String(data.cart.cart_type).toLowerCase());
        }
        if (window.WelineB2BCheckoutTob && typeof window.WelineB2BCheckoutTob.applyCartType === 'function') {
            window.WelineB2BCheckoutTob.applyCartType(root, data && data.cart ? data.cart.cart_type : sellingMode);
        }
        render(data || {});
    }

    function isTransientWorkerAuthError(error) {
        const code = error && error.code ? String(error.code) : '';
        const message = error && error.message ? String(error.message) : '';
        return code === 'auth_error'
            || /nonce has already been used/i.test(message)
            || /worker session is unavailable/i.test(message);
    }

    async function loadCheckoutWithRetry() {
        try {
            await loadCheckout();
        } catch (error) {
            if (!isTransientWorkerAuthError(error)) {
                throw error;
            }
            await loadCheckout();
        }
    }

    let reloadTimer = null;
    let cartReloadFailures = 0;
    function scheduleReload(options) {
        const opts = options && typeof options === 'object' ? options : {};
        const hardOnFailure = opts.hardOnFailure !== false;
        window.clearTimeout(reloadTimer);
        reloadTimer = window.setTimeout(function () {
            loadCheckoutWithRetry().then(function () {
                cartReloadFailures = 0;
            }).catch(function (error) {
                cartReloadFailures += 1;
                setMessage(error.message || copy.load_failed, 'error');
                // Mini-cart already mutated the cart; soft getData failure would leave
                // checkout summary mismatched — fall back to a full page refresh.
                if (hardOnFailure && cartReloadFailures >= 1) {
                    window.location.reload();
                }
            });
        }, 350);
    }

    function validateCheckoutShippingFields(address) {
        const widget = window.WelineShippingCheckoutAddress;
        if (widget && typeof widget.validateShippingFields === 'function') {
            return widget.validateShippingFields(address);
        }
        const snap = address && typeof address === 'object' ? address : formAddress();
        const errors = {};
        if (!text(snap.name).trim()) {
            errors.name = '请填写收货人。';
        }
        if (!text(snap.phone).trim()) {
            errors.phone = '请填写电话。';
        }
        if (!text(snap.address1).trim()) {
            errors.address1 = '请填写详细地址。';
        }
        if (Object.keys(errors).length === 0) {
            return true;
        }
        if (widget && typeof widget.applyFieldErrors === 'function') {
            widget.applyFieldErrors(errors);
            if (typeof widget.focusFirstFieldError === 'function') {
                widget.focusFirstFieldError();
            }
        }
        return false;
    }

    async function submitCheckoutPayment(paymentMethod, options) {
        const opts = options && typeof options === 'object' ? options : {};
        const requireFormValidity = opts.require_form_validity !== false;
        if (!form) {
            throw new Error(copy.load_failed);
        }
        const address = formAddress();
        if (requireFormValidity && !validateCheckoutShippingFields(address)) {
            return { cancelled: true, reason: 'shipping_fields' };
        }
        if (requireFormValidity && !form.reportValidity()) {
            throw new Error(copy.required);
        }
        let shippingMethod = selectedValue('shipping_method');
        if (!shippingMethod && checkoutState.shippingMethods.length) {
            const first = checkoutState.shippingMethods.find(function (entry) {
                return entry && entry.code;
            });
            shippingMethod = first ? text(first.code) : '';
            if (shippingMethod) {
                const radio = form.querySelector('input[name="shipping_method"][value="' + shippingMethod + '"]');
                if (radio) {
                    radio.checked = true;
                }
            }
        }
        if (!shippingMethod || !paymentMethod) {
            throw new Error(copy.required);
        }
        const api = await getApi();
        const billingSameEl = form.querySelector('[data-billing-same]');
        const billingSame = billingSameEl ? !!billingSameEl.checked : true;
        const billingAddress = formBillingAddress(address);
        const frozen = await api.freezeQuote({
            address: address,
            billing_address: billingAddress,
            billing_same_as_shipping: billingSame,
            service_code: shippingMethod,
            payment_method: paymentMethod,
            guest_token: guestToken(),
        });
        if (!frozen || frozen.success === false) {
            const widget = window.WelineShippingCheckoutAddress;
            const fieldErrors = frozen && frozen.field_errors;
            if (widget && fieldErrors && typeof widget.applyFieldErrors === 'function') {
                widget.applyFieldErrors(fieldErrors);
                if (typeof widget.focusFirstFieldError === 'function') {
                    widget.focusFirstFieldError();
                }
                return { cancelled: true, reason: 'shipping_fields' };
            }
            throw new Error(text(frozen && frozen.message) || copy.load_failed);
        }
        const quoteToken = text(frozen.quote_token || frozen.data && frozen.data.quote_token);
        if (!quoteToken) {
            throw new Error(copy.load_failed);
        }
        const idempotencyKey = newIdempotencyKey(opts.idempotency_prefix || 'checkout_ui_');
        const result = await api.submitV2({
            quote_token: quoteToken,
            payment_method: paymentMethod,
            idempotency_key: idempotencyKey,
            country_code: address.country_code,
            guest_token: guestToken(),
        });
        if (!result || result.success === false) {
            throw new Error(text(result && result.message) || copy.load_failed);
        }
        handlePaymentResult(result, {
            quote_token: quoteToken,
            idempotency_key: idempotencyKey,
            payment_method: paymentMethod,
            country_code: address.country_code,
            order_uuid: '',
            checkout_group_uuid: '',
            outcome: '',
            redirect_url: '',
            recoverable: true,
        });
        return result;
    }

    if (form) {
        form.addEventListener('change', function (event) {
            if (event.target && event.target.name === 'shipping_method') {
                renderTotals();
                return;
            }
            if (event.target && ['country_code', 'province', 'city', 'district', 'postal_code'].indexOf(event.target.name) !== -1) {
                scheduleReload();
            }
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const shippingMethod = selectedValue('shipping_method');
            const paymentMethod = selectedValue('payment_method');
            if (!shippingMethod || !paymentMethod) {
                setMessage(copy.required, 'error');
                return;
            }
            if (submitButton) {
                submitButton.disabled = true;
                setText(submitButton, copy.submitting);
            }
            setMessage(copy.submitting, '');
            try {
                const result = await submitCheckoutPayment(paymentMethod, {
                    require_form_validity: true,
                    idempotency_prefix: 'checkout_ui_',
                });
                if (result && result.cancelled) {
                    setMessage('', '');
                    return;
                }
            } catch (error) {
                setMessage(error.message || copy.load_failed, 'error');
                if (submitButton) {
                    submitButton.disabled = false;
                    setText(submitButton, copy.submit);
                }
            }
        });
    }

    root.addEventListener('weline:checkout:express-pay', async function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        const paymentMethod = text(detail.payment_method || 'paypal').trim() || 'paypal';
        const expressButton = detail.button instanceof HTMLElement
            ? detail.button
            : (event.target && event.target.closest
                ? event.target.closest('[data-express-pay]')
                : null);
        if (expressButton) {
            expressButton.disabled = true;
        }
        setMessage(copy.submitting, '');
        try {
            const result = await submitCheckoutPayment(paymentMethod, {
                require_form_validity: false,
                idempotency_prefix: 'checkout_express_',
            });
            if (result && result.cancelled) {
                setMessage('', '');
                return;
            }
        } catch (error) {
            setMessage(error.message || copy.load_failed, 'error');
            if (expressButton) {
                expressButton.disabled = false;
            }
        }
    });

    if (shippingBox) {
        shippingBox.addEventListener('change', renderTotals);
    }

    // Soft-reload shipping methods/totals only; never hard-refresh — that wipes
    // the just-rendered address card before the next paint can settle.
    window.addEventListener('weline:checkout:address-updated', function () {
        scheduleReload({ hardOnFailure: false });
    });

    // Mini-cart (header drawer) and checkout-summary coupon share this event.
    // Soft-reload the checkout summary so line items/totals stay matched; never
    // swallow failures (stale summary after qty/remove is worse than a hard refresh).
    window.addEventListener('weline:cart-updated', function () {
        scheduleReload({ hardOnFailure: true });
    });

    if (paymentRetryButton) {
        paymentRetryButton.addEventListener('click', async function () {
            if (!activePaymentRecovery) {
                return;
            }
            const redirectUrl = safePaymentRedirect(activePaymentRecovery.redirect_url);
            if (activePaymentRecovery.outcome === 'pending' && redirectUrl) {
                window.location.assign(redirectUrl);
                return;
            }
            paymentRetryButton.disabled = true;
            setText(paymentRetryButton, copy.retrying_payment);
            setMessage(copy.retrying_payment, '');
            try {
                const api = await getApi();
                const result = await api.resumePaymentV2({
                    quote_token: activePaymentRecovery.quote_token,
                    idempotency_key: activePaymentRecovery.idempotency_key,
                    payment_idempotency_key: newIdempotencyKey('checkout_payment_retry_'),
                    payment_method: activePaymentRecovery.payment_method,
                    country_code: activePaymentRecovery.country_code,
                });
                if (!result || result.success === false) {
                    throw new Error(text(result && result.message) || copy.load_failed);
                }
                handlePaymentResult(result, activePaymentRecovery);
            } catch (error) {
                setMessage(error.message || copy.payment_failed, 'error');
                paymentRetryButton.disabled = false;
                setText(paymentRetryButton, copy.retry_payment);
            }
        });
    }

    const initialPaymentRecovery = paymentRecoveryFromLocation();
    if (initialPaymentRecovery) {
        showPaymentRecovery(initialPaymentRecovery);
    } else {
        loadCheckoutWithRetry().catch(function (error) {
            setMessage(error.message || copy.load_failed, 'error');
            if (submitButton) {
                submitButton.disabled = true;
            }
        });
    }
})();
</script>
