    function applyDefaultShippingAddress(address) {
        if (customerAddressPrefilled || !form || !address || typeof address !== 'object') {
            return;
        }
        const fields = ['name', 'phone', 'email', 'country_code', 'province', 'city', 'district', 'address1', 'postal_code'];
        let applied = false;
        fields.forEach(function (field) {
            const input = form.querySelector('[name="' + field + '"]');
            const value = text(address[field]).trim();
            if (!input || !value || text(input.value).trim()) {
                return;
            }
            input.value = value;
            applied = true;
        });
        if (window.WelineThemeAddress && typeof window.WelineThemeAddress.applyValues === 'function') {
            window.WelineThemeAddress.applyValues('checkout-shipping-address', {
                country_code: text(address.country_code).trim().toUpperCase(),
                country: text(address.country || address.country_name || address.country_code).trim(),
                province: text(address.province).trim(),
                city: text(address.city).trim(),
                district: text(address.district).trim(),
            });
            applied = true;
        }
        customerAddressPrefilled = applied;
    }

    function selectedValue(name) {
        const checked = form.querySelector('input[name="' + name + '"]:checked');
        return checked ? checked.value : '';
    }

    function guestToken() {
        if (window.WelineCart && typeof window.WelineCart.getGuestSession === 'function') {
            const session = window.WelineCart.getGuestSession();
            const sessionToken = session && session.token ? text(session.token).trim() : '';
            if (sessionToken) {
                return sessionToken;
            }
        }
        try {
            return text(window.sessionStorage.getItem(guestTokenStorageKey)).trim();
        } catch (error) {
            return '';
        }
    }

    async function ensureGuestToken() {
        if (window.Weline && typeof window.Weline.load === 'function') {
            try {
                await window.Weline.load('cart');
            } catch (error) {
                // The Query provider can still recover the trusted HttpOnly cookie.
            }
        }

        let token = guestToken();
        if (token) {
            return token;
        }
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error(copy.api_missing);
        }

        const cartApi = await window.Weline.Api.resource('cart');
        if (!cartApi || typeof cartApi.issueGuestToken !== 'function') {
            throw new Error(copy.guest_session_failed);
        }
        const result = await cartApi.issueGuestToken({}, { silent: true });
        const payload = result && result.data && typeof result.data === 'object' ? result.data : result;
        token = text(payload && payload.guest_token).trim();
        if (!token) {
            throw new Error(copy.guest_session_failed);
        }

        const expiresAt = Number(payload && payload.expires_at_ms || 0);
        if (window.WelineCart && typeof window.WelineCart.rememberGuestSession === 'function') {
            window.WelineCart.rememberGuestSession(token, expiresAt || undefined);
        } else {
            try {
                window.sessionStorage.setItem(guestTokenStorageKey, token);
            } catch (error) {
                // This request still owns the token even when storage is unavailable.
            }
        }
        return token;
