                : (continuePayBinding.order && continuePayBinding.order.discount_amount),
            grand_total: totals.grand_total != null
                ? Number(totals.grand_total) || 0
                : (continuePayBinding.order && continuePayBinding.order.grand_total),
            coupon_code: totals.coupon_code != null
                ? text(totals.coupon_code).trim().toUpperCase()
                : (continuePayBinding.order && continuePayBinding.order.coupon_code),
        });
        if (Array.isArray(checkoutState.shippingMethods)) {
            const shipCode = selectedValue('shipping_method')
                || text(continuePayBinding.order && continuePayBinding.order.shipping_method || '').trim();
            const fee = Number(continuePayBinding.order.shipping_amount || 0) || 0;
            checkoutState.shippingMethods = checkoutState.shippingMethods.map(function (entry) {
                if (!entry || (shipCode && text(entry.code) !== text(shipCode))) {
                    return entry;
                }
                return Object.assign({}, entry, { amount: fee, fee: fee });
            });
        }
        checkoutState.cart = checkoutState.cart && typeof checkoutState.cart === 'object'
            ? checkoutState.cart
            : {};
        checkoutState.cart.summary = checkoutState.cart.summary || {};
        checkoutState.cart.subtotal = Number(continuePayBinding.order.subtotal || 0) || 0;
        checkoutState.cart.shipping_amount = Number(continuePayBinding.order.shipping_amount || 0) || 0;
        checkoutState.cart.tax_amount = Number(continuePayBinding.order.tax_amount || 0) || 0;
        checkoutState.cart.discount_amount = Number(continuePayBinding.order.discount_amount || 0) || 0;
        checkoutState.cart.grand_total = Number(continuePayBinding.order.grand_total || 0) || 0;
        checkoutState.cart.summary.subtotal = checkoutState.cart.subtotal;
        checkoutState.cart.summary.shipping_amount = checkoutState.cart.shipping_amount;
        checkoutState.cart.summary.tax_amount = checkoutState.cart.tax_amount;
        checkoutState.cart.summary.discount_amount = checkoutState.cart.discount_amount;
        checkoutState.cart.summary.grand_total = checkoutState.cart.grand_total;
        if (Number(checkoutState.cart.discount_amount || 0) > 0 && continuePayBinding.order.coupon_code) {
            pendingCouponCode = text(continuePayBinding.order.coupon_code).trim().toUpperCase();
            pendingDiscountPreview = {
                coupon_code: pendingCouponCode,
                amount_minor: Math.round(Number(checkoutState.cart.discount_amount) * 100),
                currency: checkoutState.currency || continuePayBinding.order.currency || 'USD',
            };
            checkoutState.cart.discount_preview = pendingDiscountPreview;
        } else {
            pendingCouponCode = '';
            pendingDiscountPreview = null;
            delete checkoutState.cart.discount_preview;
        }
    }

    /**
     * 续付=旧结账会话可改：券/运费写回未付订单后摘要与 PayPal 同权威金额。
     * @param {{coupon_code?:string,clear_coupon?:boolean}|null} opts
     */
    async function amendContinuePayOrderMoney(opts) {
        if (!isContinuePayMode() || !continuePayBinding) {
            return null;
        }
        opts = opts && typeof opts === 'object' ? opts : {};
        const api = await getApi();
        let shippingMethodCp = selectedValue('shipping_method');
        if (!shippingMethodCp && checkoutState.shippingMethods && checkoutState.shippingMethods.length) {
            const firstCp = checkoutState.shippingMethods.find(function (entry) {
                return entry && entry.code;
            });
            shippingMethodCp = firstCp ? text(firstCp.code) : '';
        }
        if (!shippingMethodCp) {
            shippingMethodCp = text(continuePayBinding.order && continuePayBinding.order.shipping_method || '').trim();
        }
        const payload = {
            quote_token: continuePayBinding.quote_token,
            order_uuid: continuePayBinding.order_uuid,
            address: formAddress(),
            shipping_method: shippingMethodCp,
            service_code: shippingMethodCp,
            currency: (continuePayBinding.order && continuePayBinding.order.currency)
                || checkoutState.currency
                || '',
        };
        if (opts.clear_coupon === true) {
            payload.coupon_code = '';
        } else if (Object.prototype.hasOwnProperty.call(opts, 'coupon_code')) {
            payload.coupon_code = text(opts.coupon_code).trim().toUpperCase();
        }
        // 不传 coupon_code → 服务端读营销会话（旧结账 session 灌入）。
        let amended;
        try {
            amended = await api.amendUnpaidCheckoutAddress(payload);
        } catch (error) {
            const msg = text(error && error.message).trim();
            // 旧 worker 描述未声明 coupon_code：剥掉后仍改址/运费，券靠营销会话侧写回。
            if (
                Object.prototype.hasOwnProperty.call(payload, 'coupon_code')
                && /Unknown frontend worker param:\s*coupon_code/i.test(msg)
            ) {
                delete payload.coupon_code;
                amended = await api.amendUnpaidCheckoutAddress(payload);
            } else {
                throw error;
            }
        }
        if (!amended || amended.success === false) {
            throw new Error(text(amended && amended.message) || copy.load_failed);
        }
        if (amended.totals && typeof amended.totals === 'object') {
            mergeContinuePayOrderTotals(amended.totals);
            renderTotals();
        }
        return amended;
    }

    function syncContinuePayChrome() {
        if (!continueChrome) {
            return;
        }
        if (!isContinuePayMode()) {
            continueChrome.hidden = true;
            root.removeAttribute('data-checkout-payment-mode');
            root.removeAttribute('data-address-incomplete');
            return;
        }
        continueChrome.hidden = false;
        root.setAttribute('data-checkout-payment-mode', 'continue_pay');
        const incomplete = isContinuePayAddressIncomplete();
        if (incomplete) {
            root.setAttribute('data-address-incomplete', '1');
        } else {
            root.removeAttribute('data-address-incomplete');
        }
        if (continueChromeTitle) {
            setText(continueChromeTitle, (continuePayBinding.chrome && continuePayBinding.chrome.title) || copy.continue_pay_chrome || copy.continue_payment);
        }
        if (continueChromeDetail) {
            const detail = (continuePayBinding.chrome && continuePayBinding.chrome.detail)
                || (incomplete ? copy.continue_pay_address_incomplete : copy.continue_pay_detail)
                || copy.continue_pay_chrome
                || '';
            setText(continueChromeDetail, detail);
        }
        if (continueChromeOrder) {
            setText(continueChromeOrder, continuePayBinding.order_uuid || '');
        }
        if (paymentRecovery) {
            setShellHidden(paymentRecovery, true);
        }
        showCheckoutShell('continue_pay');
        if (submitButton) {
            setText(submitButton, (continuePayBinding.chrome && continuePayBinding.chrome.cta_label) || copy.continue_payment);
        }
        // 续付仍可加券/改券（旧结账会话能力），禁止藏券槽。
        root.querySelectorAll(
            '.weline-checkout__coupon-slot, [weline-code="checkout.checkout.coupon_slot"], .weline-checkout__extras'
        ).forEach(function (slot) {
            slot.hidden = false;
            slot.removeAttribute('hidden');
        });
        // Chrome 已承载续付状态，避免与下方 notice 同文案叠显。
        if (message) {
            setShellHidden(message, true);
            setMessage('', '');
        }
    }

    function isContinuePayAddressIncomplete() {
        if (!isContinuePayMode()) {
            return false;
        }
        const chrome = continuePayBinding && continuePayBinding.chrome
            ? continuePayBinding.chrome
            : null;
        if (chrome && typeof chrome.expand_address === 'boolean') {
            return chrome.expand_address;
        }
        if (chrome && typeof chrome.address_complete === 'boolean') {
            return !chrome.address_complete;
        }
        if (continuePayBinding && typeof continuePayBinding.address_complete === 'boolean') {
            return !continuePayBinding.address_complete;
        }
        const order = continuePayBinding && continuePayBinding.order
            ? continuePayBinding.order
            : null;
        if (order && typeof order.address_complete === 'boolean') {
            return !order.address_complete;
        }
        return !isShippingAddressPayloadComplete(order && order.shipping_address);
    }

    function isShippingAddressPayloadComplete(ship) {
        if (!ship || typeof ship !== 'object') {
            return false;
        }
        const name = text(ship.name || ship.contact_name).trim();
        const phone = text(ship.phone || ship.contact_phone).trim();
        const line = text(ship.address1 || ship.street).trim();
        const country = text(ship.country_code || ship.country).trim();
        return !!(name && phone && line && country);
    }

    function syncContinuePayAddressPanel() {
        if (!isContinuePayMode()) {
            return;
        }
        // 用户主动新增/编辑/选址时禁止再 present→collapsed（getData/render 会反复 sync）。
        // SSR 默认 mode=new 不拦，否则续付齐全地址无法首次收起。
        const widget = window.WelineShippingCheckoutAddress;
        const addrRoot = (widget && widget.root)
            || document.querySelector('.w-shipping-checkout-address, [data-shipping-checkout-address]');
        const liveMode = text(
            (widget && typeof widget.getMode === 'function' ? widget.getMode() : '')
            || (addrRoot && addrRoot.getAttribute('data-mode'))
            || ''
        ).trim();
        if (liveMode === 'edit' || liveMode === 'picking') {
            return;
        }
        if (addrRoot && addrRoot.getAttribute('data-user-address-editing') === '1') {
            return;
        }
        const order = continuePayBinding && continuePayBinding.order
            ? continuePayBinding.order
            : null;
        const ship = order && order.shipping_address && typeof order.shipping_address === 'object'
            ? order.shipping_address
            : {};
        if (widget && typeof widget.presentOrderAddress === 'function') {
            widget.presentOrderAddress(ship, {
                expand: isContinuePayAddressIncomplete(),
            });
            return;
        }
        // Fallback：仅回填字段，不全时保持默认展开。
        if (form && ship) {
            const map = {
                name: ship.name || ship.contact_name,
                phone: ship.phone || ship.contact_phone,
                email: ship.email,
                country_code: ship.country_code || ship.country,
                province: ship.province,
                city: ship.city,
                address1: ship.address1 || ship.street,
                postal_code: ship.postal_code,
            };
            Object.keys(map).forEach(function (key) {
                const el = form.querySelector('[name="' + key + '"]');
                if (el && map[key]) {
                    el.value = String(map[key]);
                }
            });
        }
    }

    function renderTypeSwitcher() {
        if (!typeSwitch || !typeSwitchMenu || !typeSwitchCurrent) {
            return;
        }
        const buckets = Array.isArray(sessionBuckets) ? sessionBuckets : [];
        const visible = buckets.length >= 2;
        typeSwitch.hidden = !visible;
        if (!visible) {
            typeSwitchMenu.hidden = true;
            if (typeSwitchTrigger) {
                typeSwitchTrigger.setAttribute('aria-expanded', 'false');
            }
            return;
        }
        const activeId = continuePayBinding && continuePayBinding.bucket_id
            ? continuePayBinding.bucket_id
            : (buckets[0] && buckets[0].bucket_id) || '';
        const active = buckets.find(function (b) { return b && b.bucket_id === activeId; }) || buckets[0];
        setText(typeSwitchCurrent, (active && (active.label || active.type_label)) || copy.switch_checkout_type || '');
        typeSwitchMenu.innerHTML = '';
        buckets.forEach(function (bucket) {
            if (!bucket || !bucket.bucket_id) {
                return;
            }
            const li = document.createElement('li');
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('role', 'option');
            btn.dataset.bucketId = bucket.bucket_id;
            setText(btn, bucket.label || bucket.type_label || bucket.type_code || bucket.bucket_id);
            if (bucket.bucket_id === activeId) {
                btn.setAttribute('aria-current', 'true');
            }
            btn.addEventListener('click', function () {
                switchSessionBucket(bucket);
                typeSwitchMenu.hidden = true;
                if (typeSwitchTrigger) {
                    typeSwitchTrigger.setAttribute('aria-expanded', 'false');
                }
            });
            li.appendChild(btn);
            typeSwitchMenu.appendChild(li);
        });
    }

    function switchSessionBucket(bucket) {
        if (!bucket || !bucket.bucket_id) {
            return;
        }
        if (bucket.payment_mode === 'continue_pay') {
            continuePayBinding = Object.assign({}, continuePayBinding || {}, bucket, {
                chrome: continuePayBinding && continuePayBinding.chrome ? continuePayBinding.chrome : {
                    title: copy.continue_pay_chrome || copy.continue_payment,
                    cta_label: copy.continue_payment,
                    submit_mode: 'resumePaymentV2',
                },
            });
            if (bucket.quote_token) {
                persistContinuePayQuoteToken(bucket.quote_token);
            }
            syncContinuePayChrome();
            renderTypeSwitcher();
            loadCheckoutWithRetry().catch(function (error) {
                setMessage(error.message || copy.load_failed, 'error');
            });
            return;
        }
        continuePayBinding = null;
        clearContinuePayQuoteToken();
        syncContinuePayChrome();
        if (bucket.cart_type === 'tob' || bucket.type_code === 'tob') {
            try {
                document.cookie = 'weline_selling_mode=tob; path=/; max-age=31536000';
            } catch (eCookie) {}
        } else {
            try {
                document.cookie = 'weline_selling_mode=toc; path=/; max-age=31536000';
            } catch (eCookie2) {}
        }
        const browseTok = text(bucket.quote_token).trim();
        releaseContinuePayIsolation().then(function () {
            if (browseTok && !/^qt_cpay_/i.test(browseTok)) {
                persistQuoteToken(browseTok);
            }
            renderTypeSwitcher();
            return loadCheckoutWithRetry();
        }).catch(function (error) {
            setMessage(error.message || copy.load_failed, 'error');
        });
    }

    function hydrateContinuePayOrderSummary(data) {
        const order = continuePayBinding && continuePayBinding.order
            ? continuePayBinding.order
            : null;
        if (!order) {
            return;
        }
        // P2E-003：商品 DOM 只吃服务端 renderItems HTML（图+规格+价），禁止手拼标题。
        if (itemsBox) {
            const bindingHtml = text(continuePayBinding && continuePayBinding.items_html || '').trim();
            const dataHtml = text(data && data.items_html || '').trim();
            const preferHtml = (bindingHtml.indexOf('weline-checkout__item-title') !== -1
                || bindingHtml.indexOf('weline-checkout__item-thumb') !== -1)
                ? bindingHtml
                : ((dataHtml.indexOf('weline-checkout__item-title') !== -1) ? dataHtml : bindingHtml);
            if (preferHtml !== '' && preferHtml.indexOf('weline-checkout__empty') === -1) {
                applyServerHtml(itemsBox, preferHtml);
            }
        }
        const lines = Array.isArray(order.lines) ? order.lines : (
            Array.isArray(continuePayBinding.items) ? continuePayBinding.items : []
        );
        checkoutState.cart = checkoutState.cart && typeof checkoutState.cart === 'object'
            ? checkoutState.cart
            : {};
        checkoutState.cart.is_empty = false;
        checkoutState.cart.item_count = lines.length || Number(checkoutState.cart.item_count || 1) || 1;
        checkoutState.cart.summary = checkoutState.cart.summary || {};
        if (order.subtotal != null) {
            checkoutState.cart.subtotal = Number(order.subtotal) || 0;
            checkoutState.cart.summary.subtotal = checkoutState.cart.subtotal;
        } else if (lines.length) {
            const fromLines = lines.reduce(function (sum, line) {
                if (!line || typeof line !== 'object') {
                    return sum;
                }
                if (line.row_total != null) {
                    return sum + (Number(line.row_total) || 0);
                }
                if (line.row_total_minor != null) {
                    return sum + ((Number(line.row_total_minor) || 0) / 100);
                }
                return sum;
            }, 0);
            if (fromLines > 0) {
                checkoutState.cart.subtotal = fromLines;
                checkoutState.cart.summary.subtotal = fromLines;
            }
        }
        if (order.grand_total != null) {
            checkoutState.cart.grand_total = Number(order.grand_total) || 0;
            checkoutState.cart.summary.grand_total = checkoutState.cart.grand_total;
        }
        // 续付金额以订单 money 为准（可经 amend 改运费/券后回写）；进续付时先用订单行，再灌会话券。
        const frozenShip = order.shipping_amount != null ? Number(order.shipping_amount) || 0 : null;
        const frozenTax = order.tax_amount != null ? Number(order.tax_amount) || 0 : 0;
        const frozenDiscount = order.discount_amount != null ? Number(order.discount_amount) || 0 : 0;
        if (frozenShip != null) {
            checkoutState.cart.shipping_amount = frozenShip;
            checkoutState.cart.summary.shipping_amount = frozenShip;
        }
        checkoutState.cart.tax_amount = frozenTax;
        checkoutState.cart.summary.tax_amount = frozenTax;
        checkoutState.cart.discount_amount = frozenDiscount;
        checkoutState.cart.summary.discount_amount = frozenDiscount;
        if (frozenDiscount > 0 && order.coupon_code) {
            pendingCouponCode = text(order.coupon_code).trim().toUpperCase();
            pendingDiscountPreview = {
                coupon_code: pendingCouponCode,
                amount_minor: Math.round(frozenDiscount * 100),
                currency: order.currency || checkoutState.currency || 'USD',
            };
            checkoutState.cart.discount_preview = pendingDiscountPreview;
        }
        checkoutState.taxEstimate = null;
        checkoutState.cart.summary.currency = order.currency || checkoutState.currency;
        if (order.currency) {
            checkoutState.currency = order.currency;
        }
        if (emptyState) {
            setShellHidden(emptyState, true);
        }
        // Ensure binding payment method shows name+icon even when cart getData is empty/blocked.
        // Prefer adopt/getData server HTML; never invent a bare code span label.
        const method = text(continuePayBinding.payment_method).trim();
        if (method && paymentBox) {
            const bindingHtml = text(continuePayBinding.payment_methods_html || '').trim();
            const dataHtml = text(data && data.payment_methods_html || '').trim();
            const currentHasRadio = !!paymentBox.querySelector('input[name="payment_method"]');
            const currentHasLogo = !!paymentBox.querySelector('.weline-checkout__payment-logo, img.weline-checkout__payment-logo');
            const currentLooksBare = currentHasRadio && !currentHasLogo
                && (paymentBox.innerText || '').indexOf(method) !== -1
                && !(paymentBox.querySelector('.weline-checkout__payment-title-row strong'));
            const preferHtml = (bindingHtml.indexOf('name="payment_method"') !== -1 && bindingHtml.indexOf('payment-logo') !== -1)
                ? bindingHtml
                : ((dataHtml.indexOf('name="payment_method"') !== -1) ? dataHtml : bindingHtml);
            if (preferHtml !== '' && preferHtml.indexOf('name="payment_method"') !== -1
                && (!currentHasRadio || currentLooksBare || (preferHtml.indexOf('payment-logo') !== -1 && !currentHasLogo))) {
                applyServerHtml(paymentBox, preferHtml);
            }
            const methods = Array.isArray(continuePayBinding.payment_methods) && continuePayBinding.payment_methods.length
                ? continuePayBinding.payment_methods
                : (Array.isArray(data && data.payment_methods) ? data.payment_methods : []);
            if (methods.length) {
                checkoutState.paymentMethods = methods;
            }
        }

        // Same for order shipping lane (empty cart cannot re-quote). Prefer binding
        // HTML so a stale getData Americas row cannot win over the order lane.
        if (shippingBox) {
            const shipBindingHtml = text(continuePayBinding.shipping_methods_html || '').trim();
            const shipDataHtml = text(data && data.shipping_methods_html || '').trim();
            const preferShipHtml = (shipBindingHtml.indexOf('name="shipping_method"') !== -1)
                ? shipBindingHtml
                : shipDataHtml;
            if (preferShipHtml !== '' && preferShipHtml.indexOf('name="shipping_method"') !== -1) {
                applyServerHtml(shippingBox, preferShipHtml);
            }
            const shipMethods = Array.isArray(continuePayBinding.shipping_methods) && continuePayBinding.shipping_methods.length
                ? continuePayBinding.shipping_methods
                : (Array.isArray(data && data.shipping_methods) ? data.shipping_methods : []);
            if (shipMethods.length) {
                checkoutState.shippingMethods = shipMethods;
            }
        }
    }

    async function adoptContinuePayFromRecovery(state) {
        const api = await getApi();
        const prior = text(typeof readStoredQuoteToken === 'function' ? readStoredQuoteToken() : '').trim();
        const adopted = await api.adoptContinuePaySession({
            quote_token: state.quote_token,
            order_uuid: state.order_uuid,
            idempotency_key: state.idempotency_key,
            payment_method: state.payment_method,
            prior_quote_token: prior && prior !== state.quote_token ? prior : '',
        });
        if (!adopted || adopted.success === false) {
            const adoptErr = new Error(text(adopted && adopted.message) || copy.load_failed);
            adoptErr.code = text(adopted && adopted.error_code || '');
            adoptErr.error_code = adoptErr.code;
            adoptErr.already_paid = !!(adopted && adopted.already_paid);
            adoptErr.checkout_group_uuid = text(adopted && adopted.checkout_group_uuid || '');
            throw adoptErr;
        }
        // 续付凭据只进 continue_pay 槽，禁止覆盖普通 browse quote_token（否则传统结账被污染）。
        persistContinuePayQuoteToken(state.quote_token);
        continuePayBinding = Object.assign({}, adopted.bucket || {}, {
            order_uuid: state.order_uuid,
            quote_token: state.quote_token,
            idempotency_key: state.idempotency_key,
            payment_method: state.payment_method,
            country_code: state.country_code,
            order: adopted.order || null,
            address_complete: adopted.address_complete,
            items: Array.isArray(adopted.items) ? adopted.items : [],
            items_html: text(adopted.items_html || ''),
            payment_methods: Array.isArray(adopted.payment_methods) ? adopted.payment_methods : [],
            payment_methods_html: text(adopted.payment_methods_html || ''),
            shipping_methods: Array.isArray(adopted.shipping_methods) ? adopted.shipping_methods : [],
            shipping_methods_html: text(adopted.shipping_methods_html || ''),
            shipping_method: text(adopted.order && adopted.order.shipping_method),
            chrome: adopted.chrome || {
                title: copy.continue_pay_chrome || copy.continue_payment,
                detail: copy.continue_pay_detail || copy.continue_pay_chrome,
                cta_label: copy.continue_payment,
                submit_mode: 'resumePaymentV2',
                address_complete: !!(adopted.order && adopted.order.address_complete),
                expand_address: !(adopted.order && adopted.order.address_complete),
            },
        });
        sessionBuckets = Array.isArray(adopted.buckets) ? adopted.buckets : [];
        activePaymentRecovery = state;
        syncContinuePayChrome();
        renderTypeSwitcher();
        syncContinuePayAddressPanel();
        await loadCheckoutWithRetry();
        syncContinuePayChrome();
        syncContinuePayAddressPanel();
        if (emptyState) {
            setShellHidden(emptyState, true);
        }
        // 旧结账会话券灌入未付订单并重算应付（有订单仍可改）。
        try {
            await amendContinuePayOrderMoney({});
        } catch (eAmendCoupon) {
            // 券灌入失败不阻断续付展示；摘要仍用订单当前 money。
        }
    }

    function announceCheckoutOrderCreated(state, paymentOutcome) {
        const cart = checkoutState.cart && typeof checkoutState.cart === 'object' ? checkoutState.cart : {};
        const summary = cart.summary && typeof cart.summary === 'object' ? cart.summary : {};
        const amountCandidate = [
            state && state.amount,
            summary.grand_total,
            summary.grand_total_amount,
            cart.grand_total,
            cart.total,
        ].map(function (v) { return text(v).trim(); }).find(function (v) { return v !== ''; }) || '';
        const detail = {
            source: 'checkout-payment-recovery',
            order_uuid: state && state.order_uuid ? state.order_uuid : '',
            checkout_group_uuid: state && state.checkout_group_uuid ? state.checkout_group_uuid : '',
            quote_token: state && state.quote_token ? state.quote_token : '',
            outcome: paymentOutcome || 'pending',
            amount: amountCandidate,
            currency: text((state && state.currency) || checkoutState.currency || summary.currency || '').trim(),
        };
        const outcome = paymentOutcome || 'pending';
        syncLifecycleDomFields(detail);
        try {
            if (window.DEV === true || window.WELINE_ENV === 'DEV'
                || window.WELINE_LIFECYCLE_DEBUG === true
                || (window.localStorage && window.localStorage.getItem('weline_lifecycle_debug') === '1')) {
                console.info('[WelineCheckout]', 'announceCheckoutOrderCreated', detail);
            }
        } catch (eDevLog) {}
        // Prefer module APIs (validate order fields; DEV anomaly without dispatch when incomplete).
        let emitted = false;
        try {
            if (window.WelineCheckout && typeof window.WelineCheckout.emitOrderCreated === 'function') {
                emitted = !!window.WelineCheckout.emitOrderCreated(detail);
            }
            if (window.WelineCheckout && typeof window.WelineCheckout.emitPaymentBridge === 'function') {
                window.WelineCheckout.emitPaymentBridge(outcome, detail);
            } else if (window.WelinePayment && typeof window.WelinePayment.emitOutcome === 'function') {
                window.WelinePayment.emitOutcome(outcome, detail);
            } else if (detail.order_uuid && detail.amount && detail.currency) {
                window.dispatchEvent(new CustomEvent('weline:checkout:order-created', { detail: detail }));
                window.dispatchEvent(new CustomEvent(
                    'weline:payment:' + (outcome === 'failed' ? 'failed' : (outcome === 'paid' ? 'paid' : 'pending')),
                    { detail: detail }
                ));
                window.dispatchEvent(new CustomEvent('weline:payment:outcome', {
                    detail: Object.assign({}, detail, { outcome: outcome }),
                }));
                emitted = true;
            } else {
                console.warn('[WelineCheckout][anomaly] 跳过派发：缺少订单字段', detail);
                emitted = false;
            }
        } catch (eApiEvt) {}
        // Race with async data-weline-load: ensure Cart invalidates once ready (only if emitted).
        if (!emitted) {
            return;
        }
        try {
            if (window.WelineCart && typeof window.WelineCart.invalidateAfterCheckout === 'function') {
                window.WelineCart.invalidateAfterCheckout({ reason: 'checkout-order-created', source: detail.source });
            } else if (window.Weline && typeof window.Weline.load === 'function') {
                window.Weline.load('cart').then(function () {
                    if (window.WelineCart && typeof window.WelineCart.invalidateAfterCheckout === 'function') {
                        window.WelineCart.invalidateAfterCheckout({
                            reason: 'checkout-order-created-deferred',
                            source: detail.source,
                        });
                    }
                }).catch(function () {});
            }
        } catch (eCartInv) {}
    }

    function navigateToSuccess(state) {
        if (isContinuePayMode()) {
            try {
                releaseContinuePayIsolation().catch(function () {});
            } catch (eRelease) {}
        }
        if (window.WelineCart && typeof window.WelineCart.invalidateAfterCheckout === 'function') {
            try {
                window.WelineCart.invalidateAfterCheckout({ reason: 'checkout-navigate-success' });
            } catch (eInvalidate) {}
        }
        try {
            const detail = {
                source: 'navigateToSuccess',
                order_uuid: state && state.order_uuid ? state.order_uuid : '',
                checkout_group_uuid: state && state.checkout_group_uuid ? state.checkout_group_uuid : '',
                quote_token: state && state.quote_token ? state.quote_token : '',
                amount: text(state && state.amount).trim(),
                currency: text((state && state.currency) || checkoutState.currency || '').trim(),
            };
            syncLifecycleDomFields(detail);
            if (window.WelineCheckout && typeof window.WelineCheckout.emitSuccess === 'function') {
                window.WelineCheckout.emitSuccess(detail);
            } else {
                window.dispatchEvent(new CustomEvent('weline:checkout:success', { detail: detail }));
                window.dispatchEvent(new CustomEvent('weline:checkout:order-created', { detail: detail }));
            }
            if (window.WelineCheckout && typeof window.WelineCheckout.emitPaymentBridge === 'function') {
                window.WelineCheckout.emitPaymentBridge('paid', detail);
            } else if (window.WelinePayment && typeof window.WelinePayment.emitOutcome === 'function') {
                window.WelinePayment.emitOutcome('paid', detail);
            }
        } catch (eEvent) {}
        const successUrl = new URL(successPageUrl, window.location.origin);
        successUrl.searchParams.set('order_uuid', state.order_uuid);
        successUrl.searchParams.set('checkout_group_uuid', state.checkout_group_uuid);
        const checkoutToken = text(state.quote_token).trim();
        successUrl.searchParams.set('checkout_token', checkoutToken);
        window.location.assign(successUrl.toString());
    }

    function handlePaymentResult(result, state) {
        const data = result.data && typeof result.data === 'object' ? result.data : result;
        const orderUuids = Array.isArray(result.order_uuids)
            ? result.order_uuids
            : (Array.isArray(data.order_uuids) ? data.order_uuids : []);
        state.order_uuid = text(orderUuids[0] || state.order_uuid);
        state.checkout_group_uuid = text(
            result.checkout_group_uuid || data.checkout_group_uuid || state.checkout_group_uuid
        );
        state.quote_token = text(result.checkout_token || state.quote_token);
        if (!state.order_uuid || !state.checkout_group_uuid || !state.quote_token) {
            throw new Error(copy.load_failed);
        }

        const payment = result.payment && typeof result.payment === 'object' ? result.payment : {};
        const outcome = text(payment.outcome || (payment.paid ? 'paid' : payment.status)).toLowerCase();
        if (outcome === 'paid' || payment.paid) {
            navigateToSuccess(state);
            return;
        }

        state.outcome = outcome === 'failed' ? 'failed' : 'pending';
        state.redirect_url = safePaymentRedirect(payment.redirect_url || state.redirect_url);
        state.recoverable = payment.recoverable !== false;
        persistPaymentRecovery(state);
        showPaymentRecovery(state);
        if (state.outcome === 'pending' && state.redirect_url) {
            setMessage(copy.payment_redirect, 'success');
            window.location.assign(state.redirect_url);
        }
    }

    function selectedShippingAmount() {
        const code = selectedValue('shipping_method');
        const method = checkoutState.shippingMethods.find(function (entry) {
            return entry && entry.code === code;
        });
        return method ? Number(method.amount || method.fee || 0) : 0;
    }

    function selectedCodFeeAmount() {
        const code = selectedValue('payment_method');
        const method = checkoutState.paymentMethods.find(function (entry) {
            return entry && entry.code === code;
        });
        if (!method) {
            return 0;
        }
        const minor = Number(method.cod_fee_amount_minor || 0);
        if (minor > 0) {
            return minor / 100;
        }
        return Number(method.cod_fee || method.fee_major || 0) || 0;
    }

    /** 选中支付方式的可兑现激励（正数 major）；来自列表扁字段，禁前端自算百分比。 */
    function selectedIncentiveSavingsMajor() {
        const code = selectedValue('payment_method');
        const method = checkoutState.paymentMethods.find(function (entry) {
            return entry && entry.code === code;
        });
        if (!method || !method.incentive_available) {
            return 0;
        }
        const minor = Number(method.incentive_savings_minor || 0);
        if (minor > 0) {
            return minor / 100;
        }
        return 0;
    }

    /** Server-enriched duty/tax on selected shipping method (never invent rates in browser). */
    function selectedTaxAmount() {
        const code = selectedValue('shipping_method');
        const method = checkoutState.shippingMethods.find(function (entry) {
            return entry && entry.code === code;
        });
        if (method) {
            const minor = Number(method.tax_amount_minor || 0);
            if (minor > 0) {
                return minor / 100;
            }
            const major = Number(method.tax_amount || 0) || 0;
            if (major > 0) {
                return major;
            }
        }
        const preview = checkoutState.taxEstimate;
        if (preview && typeof preview === 'object') {
            const previewMinor = Number(preview.tax_amount_minor || 0);
            if (previewMinor > 0) {
                return previewMinor / 100;
            }
        }
        return 0;
    }

    /**
     * P2E-003：只注入服务端 HTML，禁止 createElement 拼商品/选项 DOM。
     *
     * 支付方式面板的服务端 HTML 恒以首项选中渲染（selected_index=0）：传统 getData
     * 按硬隔离规则忽略 payment_method，不会回带 selected_code。选中支付方式后会用软刷新
     * 核对优惠（schedulePaymentIncentiveReconcile），若重渲染不保留用户已选方式，刚点的
     * PayPal 会被打回首项「本地测试支付」（表现：闪一下就跳回）。故注入前后保留已选方式。
     */
    function applyServerHtml(node, html) {
        if (!node || typeof html !== 'string') {
            return;
        }
        const keepPaymentMethod = node === paymentBox && form
            ? selectedValue('payment_method')
            : '';
        node.innerHTML = html;
        if (keepPaymentMethod !== '') {
            restorePaymentMethodSelection(node, keepPaymentMethod);
        }
        if (node === paymentBox) {
            enhancePaymentMethodIntros();
        }
    }

    /**
     * 重渲染后还原用户已选支付方式；该方式已不可用（disabled/已下线）则保留服务端默认项。
     * 只改 checked 属性，不派发 change，避免与优惠核对软刷新互相触发。
     */
    function restorePaymentMethodSelection(node, code) {
        const inputs = node.querySelectorAll('input[name="payment_method"]');
        let target = null;
        inputs.forEach(function (input) {
            if (target === null && input.value === code && !input.disabled) {
                target = input;
            }
        });
        if (target === null) {
            return;
        }
        inputs.forEach(function (input) {
            input.checked = input === target;
        });
    }

    function enhancePaymentMethodIntros() {
        if (!paymentBox) {
            return;
        }
        paymentBox.querySelectorAll('[data-payment-intro]').forEach(function (wrap) {
            const text = wrap.querySelector('.weline-checkout__payment-intro-text');
            const toggle = wrap.querySelector('[data-payment-intro-toggle]');
            if (!(text instanceof HTMLElement) || !(toggle instanceof HTMLElement)) {
                return;
            }
            wrap.classList.remove('is-expanded');
            toggle.hidden = text.scrollHeight <= text.clientHeight + 1;
            toggle.textContent = toggle.dataset.labelExpand || toggle.textContent;
            toggle.setAttribute('aria-expanded', 'false');
        });
    }

    if (paymentBox) {
        paymentBox.addEventListener('click', function (event) {
            const toggle = event.target && event.target.closest
                ? event.target.closest('[data-payment-intro-toggle]')
                : null;
            if (toggle) {
                event.preventDefault();
                event.stopPropagation();
                const wrap = toggle.closest('[data-payment-intro]');
                if (!wrap) {
                    return;
                }
                const expanded = wrap.classList.toggle('is-expanded');
                toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                toggle.textContent = expanded
                    ? (toggle.dataset.labelCollapse || toggle.textContent)
                    : (toggle.dataset.labelExpand || toggle.textContent);
                return;
            }
            const details = event.target && event.target.closest
                ? event.target.closest('[data-payment-details]')
                : null;
            if (details) {
                event.stopPropagation();
            }
        });
    }

    if (itemsBox) {
        itemsBox.addEventListener('click', function (event) {
            const trigger = event.target && event.target.closest
                ? event.target.closest('[data-checkout-swatch-trigger]')
                : null;
            if (!trigger || !swatchPreview || !swatchPreviewImg) {
                return;
            }
            event.preventDefault();
            const src = text(trigger.getAttribute('data-checkout-swatch-src')).trim();
            if (!src) {
                return;
            }
            swatchPreviewImg.setAttribute('src', src);
            swatchPreviewImg.setAttribute('alt', copy.swatch_preview || '');
            if (typeof swatchPreview.showModal === 'function') {
                swatchPreview.showModal();
            } else {
                swatchPreview.setAttribute('open', '');
            }
        });
    }

    if (swatchPreview) {
        swatchPreview.addEventListener('click', function (event) {
            if (event.target === swatchPreview && typeof swatchPreview.close === 'function') {
                swatchPreview.close();
            }
        });
    }

    function discountAmountMajor(cart) {
        const preview = cart && typeof cart === 'object' ? cart.discount_preview : null;
        if (!preview || typeof preview !== 'object') {
            return 0;
        }
        const minor = Number(preview.amount_minor || 0);
        if (!(minor > 0)) {
            return 0;
        }
        const precision = Number(preview.currency_precision == null ? 2 : preview.currency_precision);
        const divisor = Math.pow(10, Math.max(0, precision));
        return minor / divisor;
    }

    /**
     * 把结账生命周期所需字段写到 DOM，供 checkout-lifecycle / 生命周期小助手读取。
     * 下单前：amount + currency；recovery / 已下单：再补 order_uuid / session。
     */
    function syncLifecycleDomFields(extra) {
        if (!root) {
            return;
        }
        const cart = checkoutState.cart && typeof checkoutState.cart === 'object' ? checkoutState.cart : {};
        const summary = cart.summary && typeof cart.summary === 'object' ? cart.summary : {};
        const extraObj = extra && typeof extra === 'object' ? extra : {};
        const recovery = activePaymentRecovery && typeof activePaymentRecovery === 'object'
            ? activePaymentRecovery
            : {};
        const subtotal = Number(cart.subtotal || 0);
        const shipping = selectedShippingAmount();
        const discount = discountAmountMajor(cart);
        const computedGrand = Math.max(0, subtotal + shipping - discount);
        const amount = text(
            extraObj.amount
            || summary.grand_total
            || summary.grand_total_amount
            || cart.grand_total
            || cart.total
            || ''
        ).trim() || computedGrand.toFixed(2);
        const currency = text(
            extraObj.currency
            || checkoutState.currency
            || summary.currency
            || 'CNY'
        ).trim() || 'CNY';
        const orderUuid = text(extraObj.order_uuid || recovery.order_uuid || '').trim();
        const groupUuid = text(extraObj.checkout_group_uuid || recovery.checkout_group_uuid || '').trim();
        const sessionCode = text(
            extraObj.checkout_session_code
            || extraObj.quote_token
            || recovery.quote_token
            || ''
        ).trim();

        root.setAttribute('data-currency', currency);
        root.setAttribute('data-order-amount', amount);
        root.setAttribute('data-amount', amount);
        if (grandTotalNode) {
            grandTotalNode.setAttribute('data-amount', amount);
            grandTotalNode.setAttribute('data-currency', currency);
        }
        if (orderUuid) {
            root.setAttribute('data-order-uuid', orderUuid);
        } else {
            root.removeAttribute('data-order-uuid');
        }
        if (groupUuid) {
            root.setAttribute('data-checkout-group-uuid', groupUuid);
        } else {
            root.removeAttribute('data-checkout-group-uuid');
        }
        if (sessionCode) {
            root.setAttribute('data-checkout-session-code', sessionCode);
        } else {
            root.removeAttribute('data-checkout-session-code');
        }
        const fieldsSig = [amount, currency, orderUuid, groupUuid, sessionCode].join('|');
        if (root.getAttribute('data-lifecycle-fields-sig') === fieldsSig) {
            return;
        }
        root.setAttribute('data-lifecycle-fields-sig', fieldsSig);
        try {
            window.dispatchEvent(new CustomEvent('weline:checkout:fields-ready', {
                detail: {
                    source: 'syncLifecycleDomFields',
                    amount: amount,
                    currency: currency,
                    order_uuid: orderUuid,
                    checkout_group_uuid: groupUuid,
                    checkout_session_code: sessionCode,
                },
            }));
        } catch (eFieldsReady) {}
    }

    function continuePayFrozenMoney() {
        if (!isContinuePayMode() || !continuePayBinding || !continuePayBinding.order) {
            return null;
        }
        const order = continuePayBinding.order;
        const subtotal = Number(order.subtotal != null ? order.subtotal : checkoutState.cart.subtotal) || 0;
        const shipping = Number(order.shipping_amount != null ? order.shipping_amount : 0) || 0;
        const tax = Number(order.tax_amount != null ? order.tax_amount : 0) || 0;
        const discount = Number(order.discount_amount != null ? order.discount_amount : 0) || 0;
        let grand = Number(order.grand_total != null ? order.grand_total : NaN);
        if (!(grand >= 0)) {
            grand = Math.max(0, subtotal + shipping - discount + tax);
        }
        return {
            subtotal: subtotal,
            shipping: shipping,
            tax: tax,
            discount: discount,
            grand_total: grand,
        };
    }

    function paintCheckoutCouponTag(code, amountMinor, currency) {
        const couponCode = text(code).trim().toUpperCase();
        const minor = Math.max(0, Math.round(Number(amountMinor) || 0));
        try {
            window.dispatchEvent(new CustomEvent('weline:cart-updated', {
                detail: {
                    source: 'continue-pay-coupon-paint',
                    refresh: false,
                    coupon_code: couponCode,
                    clear_discount: !(couponCode && minor > 0),
                    discount_preview: (couponCode && minor > 0) ? {
                        coupon_code: couponCode,
                        amount_minor: minor,
                        currency: text(currency || checkoutState.currency || 'USD').trim() || 'USD',
                    } : null,
                },
            }));
        } catch (ePaint) {}
    }

    function setDiscountRowLabel(couponCode) {
        if (!discountLabelNode) {
            return;
        }
        const code = text(couponCode).trim().toUpperCase();
        if (code !== '') {
            setText(discountLabelNode, discountLabelDefault + ' (' + code + ')');
        } else {
            setText(discountLabelNode, discountLabelDefault);
        }
    }

    function applyContinuePayFrozenTotals(frozen) {
        // 小计/运费必须始终写出，禁止只露优惠行让人看不懂账。
        if (subtotalNode) {
            const subRow = subtotalNode.closest('[role="listitem"]');
            if (subRow) {
                subRow.hidden = false;
                subRow.removeAttribute('hidden');
            }
        }
        if (shippingAmountNode) {
            const shipRow = shippingAmountNode.closest('[role="listitem"]');
            if (shipRow) {
                shipRow.hidden = false;
                shipRow.removeAttribute('hidden');
            }
        }
        setText(subtotalNode, money(frozen.subtotal));
        setText(shippingAmountNode, money(frozen.shipping));
        const couponCode = text(
            continuePayBinding
            && continuePayBinding.order
            && continuePayBinding.order.coupon_code
        ).trim().toUpperCase();
        if (discountRowNode && discountAmountNode) {
            if (frozen.discount > 0) {
                discountRowNode.hidden = false;
                setDiscountRowLabel(couponCode);
                setText(discountAmountNode, '-' + money(frozen.discount));
            } else {
                discountRowNode.hidden = true;
                setDiscountRowLabel('');
                setText(discountAmountNode, money(0));
            }
        }
        if (depositRowNode && depositAmountNode) {
            depositRowNode.hidden = true;
            setText(depositAmountNode, money(0));
        }
        if (creditRowNode && creditAmountNode) {
            creditRowNode.hidden = true;
            setText(creditAmountNode, money(0));
        }
        if (taxRowNode && taxAmountNode) {
            if (frozen.tax > 0) {
                taxRowNode.hidden = false;
                setText(taxAmountNode, money(frozen.tax));
            } else {
                taxRowNode.hidden = true;
                setText(taxAmountNode, money(0));
            }
        }
        if (codFeeRowNode && codFeeAmountNode) {
            codFeeRowNode.hidden = true;
            setText(codFeeAmountNode, money(0));
        }
        if (paymentIncentiveRowNode && paymentIncentiveAmountNode) {
            paymentIncentiveRowNode.hidden = true;
            setText(paymentIncentiveAmountNode, money(0));
        }
        if (grandTotalLabelNode) {
            setText(grandTotalLabelNode, grandTotalLabelDefault || grandTotalLabelDeposit);
        }
        setText(grandTotalNode, money(frozen.grand_total));
        syncLifecycleDomFields({ amount: Number(frozen.grand_total || 0).toFixed(2) });
        if (frozen.discount > 0 && couponCode) {
            paintCheckoutCouponTag(
                couponCode,
                Math.round(Number(frozen.discount) * 100),
                (continuePayBinding.order && continuePayBinding.order.currency) || checkoutState.currency
            );
        } else if (!(frozen.discount > 0)) {
            paintCheckoutCouponTag('', 0, checkoutState.currency);
        }
    }

    function renderTotals() {
        const frozen = continuePayFrozenMoney();
        if (frozen) {
            applyContinuePayFrozenTotals(frozen);
            return;
        }
        const subtotal = Number(checkoutState.cart.subtotal || 0);
        const shipping = selectedShippingAmount();
        const discount = discountAmountMajor(checkoutState.cart);
        const cartType = checkoutCartType();
        const tob = cartType === 'tob';
        const tobApi = window.WelineB2BCheckoutTob;
        let creditApplyMajor = 0;
        let depositMajor = 0;
        let cashDepositMajor = null;
        if (tob && tobApi) {
            if (typeof tobApi.readApplyMinor === 'function') {
                creditApplyMajor = Math.max(0, Number(tobApi.readApplyMinor()) || 0) / 100;
            }
            if (typeof tobApi.estimateDepositMinor === 'function') {
                depositMajor = Math.max(0, Number(tobApi.estimateDepositMinor({
                    cart_type: 'tob',
                    subtotal: subtotal,
                    currency: checkoutState.currency || 'CNY',
                })) || 0) / 100;
            }
            if (typeof tobApi.cashDepositMinor === 'function') {
                const cashMinor = tobApi.cashDepositMinor();
                if (cashMinor !== null && cashMinor !== undefined) {
                    cashDepositMajor = Math.max(0, Number(cashMinor) || 0) / 100;
                }
            }
            // 有报价现金态时，定金行与信用面板同源（apply+cash），避免本地 30% 估算漂移。
            if (cashDepositMajor !== null) {
                depositMajor = cashDepositMajor + creditApplyMajor;
            } else if (depositMajor > 0) {
                cashDepositMajor = Math.max(0, depositMajor - creditApplyMajor);
            }
        }
        setText(subtotalNode, money(subtotal));
        setText(shippingAmountNode, money(shipping));
        if (discountRowNode && discountAmountNode) {
            // tob 禁营销折：优惠行只展示零售券预览。
            if (!tob && discount > 0) {
                discountRowNode.hidden = false;
                const previewCode = text(
                    (checkoutState.cart && checkoutState.cart.discount_preview && checkoutState.cart.discount_preview.coupon_code)
                    || pendingCouponCode
                    || ''
                ).trim().toUpperCase();
                setDiscountRowLabel(previewCode);
                setText(discountAmountNode, '-' + money(discount));
            } else {
                discountRowNode.hidden = true;
                setDiscountRowLabel('');
                setText(discountAmountNode, money(0));
            }
        }
        if (depositRowNode && depositAmountNode) {
            if (tob && depositMajor > 0) {
                depositRowNode.hidden = false;
                setText(depositAmountNode, money(depositMajor));
            } else {
                depositRowNode.hidden = true;
                setText(depositAmountNode, money(0));
            }
        }
        if (creditRowNode && creditAmountNode) {
            if (tob && creditApplyMajor > 0) {
                creditRowNode.hidden = false;
                setText(creditAmountNode, '-' + money(creditApplyMajor));
            } else {
                creditRowNode.hidden = true;
                setText(creditAmountNode, money(0));
            }
        }
        const tax = tob ? 0 : selectedTaxAmount();
        if (taxRowNode && taxAmountNode) {
            if (tax > 0) {
                taxRowNode.hidden = false;
                setText(taxAmountNode, money(tax));
            } else {
                taxRowNode.hidden = true;
                setText(taxAmountNode, money(0));
            }
        }
        const codFee = tob ? 0 : selectedCodFeeAmount();
        if (codFeeRowNode && codFeeAmountNode) {
            if (codFee > 0) {
                codFeeRowNode.hidden = false;
                setText(codFeeAmountNode, money(codFee));
            } else {
                codFeeRowNode.hidden = true;
                setText(codFeeAmountNode, money(0));
            }
        }
        const incentive = tob ? 0 : selectedIncentiveSavingsMajor();
        if (paymentIncentiveRowNode && paymentIncentiveAmountNode) {
            if (incentive > 0) {
                paymentIncentiveRowNode.hidden = false;
                setText(paymentIncentiveAmountNode, '-' + money(incentive));
            } else {
                paymentIncentiveRowNode.hidden = true;
                setText(paymentIncentiveAmountNode, money(0));
            }
        }
        if (grandTotalLabelNode) {
            setText(
                grandTotalLabelNode,
                tob ? grandTotalLabelDeposit : (grandTotalLabelDefault || grandTotalLabelDeposit)
            );
        }
        const payable = tob
            ? Math.max(0, cashDepositMajor == null ? depositMajor : cashDepositMajor)
            : Math.max(0, subtotal + shipping - discount + tax + codFee - incentive);
        setText(grandTotalNode, money(payable));
        syncLifecycleDomFields({ amount: payable.toFixed(2) });
    }

    function render(data) {
        const deliveryAddress = data && data.delivery && typeof data.delivery === 'object'
            ? data.delivery.checkout_address
            : null;
        if (deliveryAddress && typeof deliveryAddress === 'object') {
            applyDefaultShippingAddress(deliveryAddress);
        }
        applyDefaultShippingAddress(data.default_shipping_address);
        checkoutState.currency = text(data.currency || data.cart && data.cart.currency || 'CNY') || 'CNY';
        // 续付：禁止把 browse 券预览并进 cart，否则摘要应付会偏离订单/PayPal。
        checkoutState.cart = isContinuePayMode()
            ? (data.cart && typeof data.cart === 'object' ? data.cart : {})
            : applyPendingDiscountToCart(data.cart || {});
        checkoutState.shippingMethods = Array.isArray(data.shipping_methods) ? data.shipping_methods : [];
        checkoutState.paymentMethods = Array.isArray(data.payment_methods) ? data.payment_methods : [];
        checkoutState.taxEstimate = isContinuePayMode()
            ? null
            : (data.tax_estimate && typeof data.tax_estimate === 'object'
                ? data.tax_estimate
                : null);
        checkoutState.identity = data.identity || checkoutState.identity || {
            checkout_mode: 'guest',
            is_guest_checkout: true,
            guest_allowed: true,
            requires_guest_email: true,
        };
        const hangPurpose = (function () {
            try {
                const params = new URLSearchParams(window.location.search || '');
                const purpose = String(params.get('purpose') || '').toLowerCase();
                const orderUuid = String(params.get('order_uuid') || '').trim();
                return (purpose === 'deposit' || purpose === 'balance') && orderUuid !== '';
            } catch (error) {
                return false;
            }
        })();
        const cartIsEmpty = Boolean(checkoutState.cart.is_empty);
        // One-shot cache clear for mini-cart; must not re-enter loadCheckout via cart-updated.
        if (cartIsEmpty && !emptyCartInvalidateDone
            && window.WelineCart && typeof window.WelineCart.invalidateAfterCheckout === 'function') {
            emptyCartInvalidateDone = true;
            try {
                window.WelineCart.invalidateAfterCheckout({
                    reason: 'checkout-empty',
                    cartType: checkoutCartType(),
                });
            } catch (eEmptyInvalidate) {}
        }
        const checkoutBlocked = Boolean(
            (data && data.checkout_blocked)
            || (checkoutState.cart && checkoutState.cart.checkout_blocked)
        );
        const blockingMessage = text(
            (data && data.blocking_message)
            || (checkoutState.cart && checkoutState.cart.blocking_message)
            || ''
        ).trim();
        // Cookie-aligned guest only — never paint form/empty while still on loading shell.
        if (!guestTokenAligned && !isContinuePayMode()) {
            showCheckoutShell('loading');
            setMessage(copy.loading, '');
            return;
        }
        if (isContinuePayMode()) {
            showCheckoutShell('continue_pay');
        } else if (hangPurpose) {
            showCheckoutShell('ready');
            setFormVisible(false);
            setShellHidden(emptyState, true);
            setShellHidden(message, true);
        } else if (cartIsEmpty) {
            // Cart page claims items under the same guest cookie → mismatch, not silent empty.
            if (localCartClaimsItems(checkoutCartType())) {
                showCheckoutShell('mismatch');
                if (emptyDetail) {
                    setText(emptyDetail, copy.guest_cart_mismatch);
                }
                setMessage(copy.guest_cart_mismatch, 'error');
            } else {
                showCheckoutShell('empty');
                if (emptyDetail) {
                    setText(
                        emptyDetail,
                        '<?= __('先选择需要采购的商品，再回来完成配送与支付。') ?>'
                    );
                }
            }
        } else {
            showCheckoutShell('ready');
        }
        if (expressHost) {
            setShellHidden(
                expressHost,
                isContinuePayMode()
                    ? true
                    : (cartIsEmpty || hangPurpose || checkoutBlocked)
            );
        }
        syncContinuePayChrome();
        renderTypeSwitcher();
        const emailInput = form ? form.querySelector('input[name="email"]') : null;
        if (emailInput) {
            emailInput.required = Boolean(checkoutState.identity.is_guest_checkout);
        }
        applyServerHtml(itemsBox, data.items_html);
        applyServerHtml(shippingBox, data.shipping_methods_html);
        applyServerHtml(paymentBox, data.payment_methods_html);
        if (isContinuePayMode()) {
            hydrateContinuePayOrderSummary(data);
            // After getData injects rich payment HTML, keep binding cache in sync.
            if (data.payment_methods_html && paymentBox
                && paymentBox.querySelector('input[name="payment_method"]')
                && paymentBox.querySelector('.weline-checkout__payment-logo, img')) {
                continuePayBinding.payment_methods_html = data.payment_methods_html;
            }
            if (Array.isArray(data.payment_methods) && data.payment_methods.length) {
                const first = data.payment_methods[0] || {};
                const rich = text(first.label || first.title || '').trim()
                    && text(first.label || first.title || '').trim() !== text(first.code || '').trim();
                if (rich || text(first.icon_url || '').trim()) {
                    continuePayBinding.payment_methods = data.payment_methods;
                }
            }
            syncContinuePayAddressPanel();
        }
        setShippingMethodsBusy(false);
        syncMethodBlockPanels();
        renderTotals();
        if (submitButton) {
            if (isContinuePayMode()) {
                // Resume uses binding payment_method; do not gate on empty-cart method lists.
                const hasResumeMethod = Boolean(
                    text(continuePayBinding && continuePayBinding.payment_method).trim()
                    || selectedValue('payment_method')
                );
                submitButton.disabled = hangPurpose || !hasResumeMethod;
            } else {
                submitButton.disabled = hangPurpose
                    || cartIsEmpty
                    || checkoutBlocked
                    || !checkoutState.shippingMethods.length
                    || !checkoutState.paymentMethods.length;
            }
        }
        if (hangPurpose) {
            setMessage('', 'success');
        } else if (isContinuePayMode()) {
            setMessage('', '');
            if (message) {
                setShellHidden(message, true);
            }
        } else if (cartIsEmpty) {
            // Empty / mismatch shells own the copy — avoid stacking notice + empty SSR form.
            if (!localCartClaimsItems(checkoutCartType())) {
                setMessage(copy.empty_cart, 'error');
                setShellHidden(message, true);
            }
        } else if (checkoutBlocked) {
            setMessage(blockingMessage || '<?= __('购物车中有不可结算的商品，请返回购物车移除后重试') ?>', 'error');
        } else {
            const methodBlockMessage = readMethodBlockMessage();
            if (methodBlockMessage) {
                // Surface shipping/payment unavailability in the page notice so users
                // do not miss the in-panel alert and wonder why submit stays disabled.
                setMessage(methodBlockMessage, 'error');
            } else {
                setMessage('<?= __('请确认收货信息、配送方式和支付方式。') ?>', 'success');
            }
        }
    }

    function syncMethodBlockPanels() {
        document.querySelectorAll('.weline-checkout__panel').forEach(function (panel) {
            panel.classList.remove('is-method-blocked');
        });
        if (shippingBox) {
            const shippingPanel = shippingBox.closest('.weline-checkout__panel');
            if (shippingPanel) {
                shippingPanel.classList.toggle(
                    'is-method-blocked',
                    Boolean(shippingBox.querySelector('[data-checkout-method-empty="shipping_method"]'))
                );
            }
        }
        if (paymentBox) {
            const paymentPanel = paymentBox.closest('.weline-checkout__panel');
            if (paymentPanel) {
                paymentPanel.classList.toggle(
                    'is-method-blocked',
                    Boolean(paymentBox.querySelector('[data-checkout-method-empty="payment_method"]'))
                );
            }
        }
    }

    function readMethodBlockMessage() {
        const shippingAlert = shippingBox
            ? shippingBox.querySelector('[data-checkout-method-empty="shipping_method"] .weline-checkout__method-alert-body')
            : null;
        if (shippingAlert && text(shippingAlert.textContent).trim()) {
            return text(shippingAlert.textContent).trim();
        }
        const paymentAlert = paymentBox
            ? paymentBox.querySelector('[data-checkout-method-empty="payment_method"] .weline-checkout__method-alert-body')
            : null;
        if (paymentAlert && text(paymentAlert.textContent).trim()) {
            return text(paymentAlert.textContent).trim();
        }
        return '';
    }

    async function getApi() {
        if (checkoutApi) {
            return checkoutApi;
        }
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error(copy.api_missing);
        }
        checkoutApi = await window.Weline.Api.resource('checkout');
        return checkoutApi;
    }

    async function loadCheckout() {
        showCheckoutShell('loading');
        setMessage(copy.loading, '');
        const api = await getApi();
        let sellingMode = checkoutCartType();
        const continuePay = isContinuePayMode();
        const getDataParams = {
            shipping_address: formAddress(),
            guest_token: await ensureGuestToken(),
            cart_type: sellingMode,
            selling_mode: sellingMode,
            // 续付只用 binding/订单 token；普通结账只用 browse 槽——互不覆盖。
            quote_token: continuePay
                ? text(continuePayBinding && continuePayBinding.quote_token).trim()
                : readStoredQuoteToken(),
        };
        if (continuePay) {
            // Schema type=boolean；WQB1 保留 JS number，传 1 会 Invalid param type 并触发 toast 循环。
            getDataParams.continue_pay = true;
            const boundMethod = text(continuePayBinding && continuePayBinding.payment_method).trim();
            if (boundMethod) {
                getDataParams.payment_method = boundMethod;
            }
            const boundShipping = text(
                continuePayBinding
                && continuePayBinding.order
                && continuePayBinding.order.shipping_method
            ).trim() || text(continuePayBinding && continuePayBinding.shipping_method).trim();
            if (boundShipping) {
                getDataParams.shipping_method = boundShipping;
            }
        } else {
            // 普通结账：把当前选中方式传给 getData，便于激励列表/摘要与壳侧核对。
            const selectedPm = selectedValue('payment_method');
            if (selectedPm) {
                getDataParams.payment_method = selectedPm;
            }
        }
        if (pendingCouponCode) {
            getDataParams.coupon_code = pendingCouponCode;
        }
        let data;
        try {
            data = await api.getData(getDataParams);
        } catch (error) {
            const msg = text(error && error.message).trim();
            // Stale worker / type mismatch: strip or coerce once (stops reload toast loops).
            let stripped = false;
            if (getDataParams.payment_method && /Unknown frontend worker param:\s*payment_method/i.test(msg)) {
                delete getDataParams.payment_method;
                stripped = true;
            }
            if (getDataParams.shipping_method && /Unknown frontend worker param:\s*shipping_method/i.test(msg)) {
                delete getDataParams.shipping_method;
                stripped = true;
            }
            if (getDataParams.continue_pay !== undefined && /Unknown frontend worker param:\s*continue_pay/i.test(msg)) {
                delete getDataParams.continue_pay;
                stripped = true;
            }
            if (getDataParams.coupon_code !== undefined && /Unknown frontend worker param:\s*coupon_code/i.test(msg)) {
                delete getDataParams.coupon_code;
                stripped = true;
            }
            if (
                getDataParams.continue_pay !== undefined
                && /Invalid param type:\s*continue_pay/i.test(msg)
            ) {
                getDataParams.continue_pay = true;
                stripped = true;
            }
            if (stripped) {
                data = await api.getData(getDataParams);
            } else {
                throw error;
            }
        }
        const returnedToken = text(data && (data.quote_token || (data.data && data.data.quote_token)));
        if (continuePay) {
            // 续付 getData 可能 mint 临时 browse token——绝不能写进普通槽。
            if (returnedToken) {
                persistContinuePayQuoteToken(returnedToken);
            }
        } else {
            persistQuoteToken(returnedToken);
        }
        if (root && data && data.cart && data.cart.cart_type) {
            root.setAttribute('data-cart-type', String(data.cart.cart_type).toLowerCase());
        }
        if (window.WelineB2BCheckoutTob && typeof window.WelineB2BCheckoutTob.applyCartType === 'function') {
            window.WelineB2BCheckoutTob.applyCartType(root, data && data.cart ? data.cart.cart_type : sellingMode);
        }
        render(data || {});
        const cartType = String(
            (data && data.cart && data.cart.cart_type) || sellingMode || ''
        ).toLowerCase();
        if (cartType === 'tob') {
            const currency = text(data && (data.currency || (data.cart && data.cart.currency)) || checkoutState.currency || 'CNY') || 'CNY';
            checkoutState.currency = currency;
            const subtotal = Number(data && data.cart ? data.cart.subtotal : 0) || 0;
            const site = window.site || {};
            const quoteOpts = {
                cart_type: 'tob',
                currency: currency,
                subtotal: subtotal,
                website_id: Number(site.website_id || site.websiteId || 0) || 0,
            };
            if (root) {
                root.setAttribute('data-currency', currency);
                root.setAttribute('data-checkout-currency', currency);
            }
            // Wait briefly for b2bCheckoutTob — inline loadCheckout often races the module.
            let tobApi = window.WelineB2BCheckoutTob;
            if (!tobApi || typeof tobApi.ensureCreditQuote !== 'function') {
                for (let i = 0; i < 40 && !(window.WelineB2BCheckoutTob && window.WelineB2BCheckoutTob.ensureCreditQuote); i += 1) {
                    await new Promise(function (resolve) { window.setTimeout(resolve, 50); });
                }
                tobApi = window.WelineB2BCheckoutTob;
            }
            if (tobApi && typeof tobApi.rememberQuoteOpts === 'function') {
                tobApi.rememberQuoteOpts(quoteOpts);
            }
            // Prefetch once via ensureCreditQuote — do not also pass ensureQuote on applyCartType
            // (avoids double-flight). applyCartType here only syncs coupon/UI chrome.
            if (tobApi && typeof tobApi.applyCartType === 'function') {
                tobApi.applyCartType(root, 'tob');
            }
            if (tobApi && typeof tobApi.ensureCreditQuote === 'function') {
                const depositMinor = tobApi.estimateDepositMinor
                    ? tobApi.estimateDepositMinor(quoteOpts)
                    : Math.floor(Math.round(subtotal * 100) * 3000 / 10000);
                await tobApi.ensureCreditQuote(root, Object.assign({}, quoteOpts, {
                    deposit_amount_minor: depositMinor,
                }));
            } else if (tobApi && typeof tobApi.refreshCreditQuote === 'function') {
                await tobApi.refreshCreditQuote(root, quoteOpts);
            }
        }
    }

    function checkoutCartType() {
        try {
            const fromRoot = String((root && root.getAttribute('data-cart-type')) || '').toLowerCase();
            if (fromRoot === 'tob' || fromRoot === 'toc') {
                return fromRoot;
            }
            if (window.WelineB2BSellingMode && typeof window.WelineB2BSellingMode.preferredMode === 'function') {
                const preferred = String(window.WelineB2BSellingMode.preferredMode() || '').toLowerCase();
                if (preferred === 'tob' || preferred === 'toc') {
                    return preferred;
                }
            }
            const names = [];
            const site = window.site || {};
            const websiteId = String(site.website_id || site.websiteId || '').trim();
            if (websiteId !== '' && /^\d+$/.test(websiteId)) {
                names.push('weline_selling_mode_w' + websiteId);
            }
            String(document.cookie || '').split(';').forEach((part) => {
                const key = String(part.split('=')[0] || '').trim();
                if (/^weline_selling_mode_w\d+$/.test(key) && !names.includes(key)) {
                    names.push(key);
                }
            });
            names.push('weline_selling_mode');
            for (const name of names) {
                const match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)'));
                const value = match ? decodeURIComponent(match[1]).toLowerCase() : '';
                if (value === 'tob' || value === 'toc') {
                    return value;
                }
            }
        } catch (error) {
            // fall through
        }
        return 'toc';
    }

    function isTransientWorkerAuthError(error) {
        const code = error && error.code ? String(error.code) : '';
        const message = error && error.message ? String(error.message) : '';
        return code === 'auth_error'
            || /nonce has already been used/i.test(message)
            || /worker session is unavailable/i.test(message);
    }

    async function loadCheckoutWithRetry() {
        try {
            await loadCheckout();
        } catch (error) {
            if (!isTransientWorkerAuthError(error)) {
                throw error;
            }
            await loadCheckout();
        }
    }

    let reloadTimer = null;
    let cartReloadFailures = 0;
    let emptyCartInvalidateDone = false;

    function shippingMethodsBusyHost() {
        if (!shippingBox) {
            return null;
        }
        return shippingBox.closest('.weline-checkout__panel') || shippingBox;
    }

    function setShippingMethodsBusy(busy) {
        const host = shippingMethodsBusyHost();
        if (!host) {
            return;
        }
        const message = busy ? (copy.loading_shipping || copy.loading || '') : '';
        if (window.Weline && window.Weline.UI && typeof window.Weline.UI.setBusy === 'function') {
            window.Weline.UI.setBusy(host, !!busy, { message: message });
            return;
        }
        // Theme UI not ready: still block interaction.
        host.setAttribute('aria-busy', busy ? 'true' : 'false');
        host.style.pointerEvents = busy ? 'none' : '';
        host.style.opacity = busy ? '0.72' : '';
        host.style.cursor = busy ? 'wait' : '';
    }

    function scheduleReload(options) {
        const opts = options && typeof options === 'object' ? options : {};
        const hardOnFailure = opts.hardOnFailure !== false;
        const busyShipping = opts.busyShipping !== false;
        if (busyShipping) {
            setShippingMethodsBusy(true);
        }
        window.clearTimeout(reloadTimer);
        reloadTimer = window.setTimeout(function () {
            loadCheckoutWithRetry().then(function () {
                cartReloadFailures = 0;
                setShippingMethodsBusy(false);
            }).catch(function (error) {
                cartReloadFailures += 1;
                setShippingMethodsBusy(false);
                const errMsg = text(error && error.message).trim() || copy.load_failed;
                setMessage(errMsg, 'error');
                // Never hard-reload on frontend worker param validation — that loops forever.
                if (/Unknown frontend worker param|Invalid param type/i.test(errMsg)) {
                    return;
                }
                // Mini-cart already mutated the cart; soft getData failure would leave
                // checkout summary mismatched — fall back to a full page refresh.
                if (hardOnFailure && cartReloadFailures >= 1) {
                    window.location.reload();
                }
            });
        }, 350);
    }

    async function validateCheckoutShippingFields(address, options) {
        const opts = options && typeof options === 'object' ? options : {};
        const widget = window.WelineShippingCheckoutAddress;
        if (widget && typeof widget.validateShippingFields === 'function') {
            return await widget.validateShippingFields(address, {
                skipRequired: opts.skipRequired === true,
            });
        }
        if (opts.skipRequired === true) {
            return true;
        }
        const snap = address && typeof address === 'object' ? address : formAddress();
        const errors = {};
        if (!text(snap.name).trim()) {
            errors.name = '请填写收货人。';
        }
        if (!text(snap.phone).trim()) {
            errors.phone = '请填写电话。';
        }
        if (!text(snap.address1).trim()) {
            errors.address1 = '请填写详细地址。';
        }
        if (Object.keys(errors).length === 0) {
            return true;
        }
        if (widget && typeof widget.applyFieldErrors === 'function') {
            widget.applyFieldErrors(errors);
            if (typeof widget.focusFirstFieldError === 'function') {
                widget.focusFirstFieldError();
            }
        }
        return false;
    }

    async function submitCheckoutPayment(paymentMethod, options) {
        const opts = options && typeof options === 'object' ? options : {};
        const requireFormValidity = opts.require_form_validity !== false;
        if (!form) {
            throw new Error(copy.load_failed);
        }
        const address = formAddress();
        // Always run shipping validation for embargo (even express soft path).
        // Prior bug: validateShippingFields is async but was not awaited, so !Promise never blocked.
        if (!(await validateCheckoutShippingFields(address, {
            skipRequired: !requireFormValidity,
        }))) {
            // 显式提示：此前此处静默 return，用户点支付后页面毫无反馈（自动化也会误判「已取消」）。
            // 校验器可能已写 embargo / 字段级提示，只在通知区为空时兜底，避免覆盖更具体的文案。
            if (!hasCheckoutMessage()) {
                setMessage(copy.required, 'error');
            }
            focusFirstInvalidCheckoutField();
            return { cancelled: true, reason: 'shipping_fields' };
        }
        if (requireFormValidity && !form.reportValidity()) {
            throw new Error(copy.required);
        }

        // Continue-pay binding: amend unpaid order address then resumePaymentV2 (never submitV2).
        if (isContinuePayMode()) {
            const apiCp = await getApi();
            let shippingMethodCp = selectedValue('shipping_method');
            if (!shippingMethodCp && checkoutState.shippingMethods && checkoutState.shippingMethods.length) {
                const firstCp = checkoutState.shippingMethods.find(function (entry) {
                    return entry && entry.code;
                });
                shippingMethodCp = firstCp ? text(firstCp.code) : '';
            }
            const methodCp = paymentMethod || continuePayBinding.payment_method || selectedValue('payment_method');
            if (!methodCp) {
                throw new Error(copy.required);
            }
            const amended = await apiCp.amendUnpaidCheckoutAddress({
                quote_token: continuePayBinding.quote_token,
                order_uuid: continuePayBinding.order_uuid,
                address: address,
                shipping_method: shippingMethodCp,
                service_code: shippingMethodCp,
                currency: (continuePayBinding.order && continuePayBinding.order.currency)
                    || checkoutState.currency
                    || '',
                coupon_code: pendingCouponCode
                    || text(continuePayBinding.order && continuePayBinding.order.coupon_code || '').trim().toUpperCase()
                    || undefined,
            });
            if (!amended || amended.success === false) {
                throw new Error(text(amended && amended.message) || copy.load_failed);
            }
            // Amend 可能重算运费/税/券；摘要与 resume 金额必须跟订单 totals 对齐。
            if (amended.totals && typeof amended.totals === 'object') {
                mergeContinuePayOrderTotals(amended.totals);
                renderTotals();
            }
            const resumeState = {
                quote_token: continuePayBinding.quote_token,
                idempotency_key: continuePayBinding.idempotency_key,
                payment_method: methodCp,
                country_code: address.country_code || continuePayBinding.country_code || '',
                order_uuid: continuePayBinding.order_uuid,
                checkout_group_uuid: continuePayBinding.checkout_group_uuid || '',
                outcome: '',
                redirect_url: '',
                recoverable: true,
            };
            const resultCp = await apiCp.resumePaymentV2({
                quote_token: resumeState.quote_token,
                idempotency_key: resumeState.idempotency_key,
                payment_idempotency_key: newIdempotencyKey('checkout_payment_retry_'),
                payment_method: methodCp,
                country_code: resumeState.country_code,
            });
            if (!resultCp || resultCp.success === false) {
                throw new Error(text(resultCp && resultCp.message) || copy.load_failed);
            }
            handlePaymentResult(resultCp, resumeState);
            return { continued: true };
        }

        let shippingMethod = selectedValue('shipping_method');
        if (!shippingMethod && checkoutState.shippingMethods.length) {
            const first = checkoutState.shippingMethods.find(function (entry) {
                return entry && entry.code;
            });
            shippingMethod = first ? text(first.code) : '';
            if (shippingMethod) {
                const radio = form.querySelector('input[name="shipping_method"][value="' + shippingMethod + '"]');
                if (radio) {
                    radio.checked = true;
                }
            }
        }
        if (!shippingMethod || !paymentMethod) {
            const zeroCash = window.WelineB2BCheckoutTob
                && typeof window.WelineB2BCheckoutTob.cashDepositMinor === 'function'
                && window.WelineB2BCheckoutTob.cashDepositMinor() === 0;
            if (!(zeroCash && shippingMethod)) {
                throw new Error(copy.required);
            }
            // 资产结算（授信覆盖全额定金）不经过 Provider，空 payment_method 才是真实值。
            // 禁止编造 method code 兜底：壳列表为空时不得假按钮兜底。
        }
        const api = await getApi();
        const billingSameEl = form.querySelector('[data-billing-same]');
        const billingSame = billingSameEl ? !!billingSameEl.checked : true;
        const billingAddress = formBillingAddress(address);
        const frozen = await api.freezeQuote({
            address: address,
            billing_address: billingAddress,
            billing_same_as_shipping: billingSame,
            service_code: shippingMethod,
            payment_method: paymentMethod,
            guest_token: guestToken(),
            quote_token: readStoredQuoteToken(),
            cart_type: checkoutCartType(),
            selling_mode: checkoutCartType(),
            buyer_tax_identity: (function () {
                const vat = form.querySelector('[data-tax-vat-id], [name="tax_identity[tax_id]"], [name="buyer_tax_identity[vat_id]"]');
                const taxId = vat ? String(vat.value || '').trim() : '';
                return taxId ? { vat_id: taxId, tax_id: taxId } : {};
            })(),
            tax_identity: (function () {
                const vat = form.querySelector('[data-tax-vat-id], [name="tax_identity[tax_id]"], [name="buyer_tax_identity[vat_id]"]');
                const taxId = vat ? String(vat.value || '').trim() : '';
                return taxId ? { tax_id: taxId, tax_id_type: 'eu_vat' } : {};
            })(),
        });
        if (!frozen || frozen.success === false) {
            const widget = window.WelineShippingCheckoutAddress;
            const fieldErrors = frozen && frozen.field_errors;
            if (widget && fieldErrors && typeof widget.applyFieldErrors === 'function') {
                widget.applyFieldErrors(fieldErrors);
                if (typeof widget.focusFirstFieldError === 'function') {
                    widget.focusFirstFieldError();
                }
                return { cancelled: true, reason: 'shipping_fields' };
            }
            throw new Error(text(frozen && frozen.message) || copy.load_failed);
        }
        const quoteToken = text(frozen.quote_token || frozen.data && frozen.data.quote_token);
        if (!quoteToken) {
            throw new Error(copy.load_failed);
        }
        persistQuoteToken(quoteToken);
        if (window.WelineB2BCheckoutTob && typeof window.WelineB2BCheckoutTob.syncFromFrozen === 'function') {
            window.WelineB2BCheckoutTob.syncFromFrozen(frozen);
        }
        const idempotencyKey = newIdempotencyKey(opts.idempotency_prefix || 'checkout_ui_');
        const submitPayload = {
            quote_token: quoteToken,
            payment_method: paymentMethod,
            idempotency_key: idempotencyKey,
            country_code: address.country_code,
            guest_token: guestToken(),
            b2b_credit_apply_minor: (window.WelineB2BCheckoutTob
                && typeof window.WelineB2BCheckoutTob.readApplyMinor === 'function')
                ? window.WelineB2BCheckoutTob.readApplyMinor()
                : 0,
        };
        // Traditional checkout must omit this flag; only express/smart-button paths set it.
        if (opts.express_checkout) {
            submitPayload.express_checkout = true;
        }
        const result = await api.submitV2(submitPayload);
        if (!result || result.success === false) {
            throw new Error(text(result && result.message) || copy.load_failed);
        }
        handlePaymentResult(result, {
            quote_token: quoteToken,
            idempotency_key: idempotencyKey,
            payment_method: paymentMethod,
            country_code: address.country_code,
            order_uuid: '',
            checkout_group_uuid: '',
            outcome: '',
            redirect_url: '',
            recoverable: true,
        });
        return result;
    }

    if (form) {
        form.addEventListener('change', function (event) {
            if (event.target && event.target.name === 'shipping_method') {
                renderTotals();
                return;
            }
            if (event.target && event.target.name === 'payment_method') {
                renderTotals();
                return;
            }
            if (event.target && ['country_code', 'province', 'city', 'district', 'postal_code'].indexOf(event.target.name) !== -1) {
                scheduleReload();
            }
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const shippingMethod = selectedValue('shipping_method');
            const paymentMethod = selectedValue('payment_method')
                || text(continuePayBinding && continuePayBinding.payment_method).trim();
            // 资产结算（授信覆盖全额定金）无需 Provider 支付方式，只要求配送方式；
            // 与 submitCheckoutPayment 内的同款豁免保持一致，避免提交前被必填拦下。
            const zeroCashDeposit = window.WelineB2BCheckoutTob
                && typeof window.WelineB2BCheckoutTob.cashDepositMinor === 'function'
                && window.WelineB2BCheckoutTob.cashDepositMinor() === 0;
            if (isContinuePayMode()) {
                if (!paymentMethod) {
                    setMessage(copy.required, 'error');
                    return;
                }
            } else if (!shippingMethod || (!paymentMethod && !zeroCashDeposit)) {
                setMessage(copy.required, 'error');
                return;
            }
            // Validate shipping/embargo BEFORE flipping the button to "submitting".
            if (!(await validateCheckoutShippingFields(formAddress(), {
                skipRequired: isContinuePayMode(),
            }))) {
                return;
            }
            if (submitButton) {
                submitButton.disabled = true;
                setText(submitButton, isContinuePayMode()
                    ? (copy.continue_pay_submitting || copy.retrying_payment || copy.submitting)
                    : copy.submitting);
            }
            setMessage(isContinuePayMode()
                ? (copy.continue_pay_submitting || copy.submitting)
                : copy.submitting, '');
            try {
                const result = await submitCheckoutPayment(paymentMethod, {
                    require_form_validity: true,
                    idempotency_prefix: 'checkout_ui_',
                });
                if (result && result.cancelled) {
                    if (submitButton) {
                        submitButton.disabled = false;
                        setText(submitButton, isContinuePayMode()
                            ? (copy.continue_payment || copy.submit)
                            : copy.submit);
                    }
                    // Keep shipping/embargo validation messages visible.
                    if (result.reason !== 'shipping_fields') {
                        setMessage('', '');
                    }
                    return;
                }
            } catch (error) {
                setMessage(error.message || copy.load_failed, 'error');
                if (submitButton) {
                    submitButton.disabled = false;
                    setText(submitButton, isContinuePayMode()
                        ? (copy.continue_payment || copy.submit)
                        : copy.submit);
                }
            }
        });
    }

    root.addEventListener('weline:checkout:express-pay', async function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        const paymentMethod = text(detail.payment_method || 'paypal').trim() || 'paypal';
        const methodLabel = text(detail.method_label || '') || ('使用 ' + paymentMethod + ' 快捷支付');
        const expressButton = detail.button instanceof HTMLElement
            ? detail.button
            : (event.target && event.target.closest
                ? event.target.closest('[data-express-pay]')
                : null);
        // Embargo gate with skipRequired; do not flip UI before validation.
        if (!(await validateCheckoutShippingFields(formAddress(), { skipRequired: true }))) {
            return;
        }
        if (expressButton) {
            expressButton.disabled = true;
        }
        setMessage(copy.submitting, '');
        try {
            const result = await submitCheckoutPayment(paymentMethod, {
                require_form_validity: false,
                idempotency_prefix: 'checkout_express_',
                express_checkout: true,
            });
            if (result && result.cancelled) {
                if (expressButton) {
                    expressButton.disabled = false;
                }
                // Keep shipping/embargo messages; do not blank the notice.
                if (result.reason !== 'shipping_fields') {
                    setMessage('', '');
                }
                return;
            }
            try {
                if (window.WelinePixel && typeof window.WelinePixel.track === 'function') {
                    window.WelinePixel.track('express_pay_started', {
                        payment_method: paymentMethod,
                        method_label: methodLabel,
                        source: 'checkout_express_pay',
                        trigger: 'express_started',
                        transaction_no: text((result && result.transaction_no) || ''),
                    }, { element: expressButton, keepalive: true });
                }
            } catch (trackErr) {}
        } catch (error) {
            setMessage(error.message || copy.load_failed, 'error');
            if (expressButton) {
                expressButton.disabled = false;
            }
        }
    });

    if (shippingBox) {
        shippingBox.addEventListener('change', renderTotals);
    }
    if (paymentBox) {
        paymentBox.addEventListener('change', function () {
            // 即时用列表扁字段重算（禁先高后低）；再异步 getData 核对。
            renderTotals();
            schedulePaymentIncentiveReconcile();
        });
    }

    let paymentIncentiveReconcileTimer = 0;
    function schedulePaymentIncentiveReconcile() {
        if (isContinuePayMode()) {
            return;
        }
        window.clearTimeout(paymentIncentiveReconcileTimer);
        const seq = ++paymentIncentiveReconcileSeq;
        paymentIncentiveReconcileTimer = window.setTimeout(function () {
            loadCheckoutWithRetry().then(function () {
                if (seq !== paymentIncentiveReconcileSeq) {
                    return;
                }
                renderTotals();
            }).catch(function (error) {
                if (seq !== paymentIncentiveReconcileSeq) {
                    return;
                }
                const errMsg = text(error && error.message).trim() || copy.load_failed;
                if (/Unknown frontend worker param|Invalid param type/i.test(errMsg)) {
                    return;
                }
                setMessage(errMsg, 'error');
            });
        }, 200);
    }

    // tob 信用勾选/输入变更后刷新摘要抵扣行与本次应付定金。
    // 防重入：renderTotals→DOM 变更可能再触发 credit sync，避免 credit-changed 风暴。
    let creditTotalsBusy = false;
    window.addEventListener('weline:b2b-credit-changed', function () {
        if (creditTotalsBusy) {
            return;
        }
        creditTotalsBusy = true;
        try {
            renderTotals();
        } finally {
            creditTotalsBusy = false;
        }
    });

    // Soft-reload shipping methods/totals only; never hard-refresh — that wipes
    // the just-rendered address card before the next paint can settle.
    window.addEventListener('weline:checkout:address-updated', function () {
        scheduleReload({ hardOnFailure: false, busyShipping: true });
    });

    // Mini-cart (header drawer) and checkout-summary coupon share this event.
    // Soft-reload the checkout summary so line items/totals stay matched; never
    // swallow failures (stale summary after qty/remove is worse than a hard refresh).
    // Ignore self-emitted checkout-empty invalidation or loadCheckout↔cart-updated storms.
    // Coupon apply may race getData before Marketing session sticks — merge discount_preview
    // immediately (same as mini-cart pendingDiscountPreview) then reload when requested.
    window.addEventListener('weline:cart-updated', function (event) {
        const detail = event && event.detail && typeof event.detail === 'object' ? event.detail : {};
        const source = String(detail.source || detail.reason || '').trim();
        if (source === 'checkout-empty') {
            return;
        }
        // 续付：券加/撤写回未付订单，禁止只改 browse preview 导致摘要与 PayPal 分叉。
        if (isContinuePayMode()) {
            if (source === 'continue-pay-amend' || source === 'continue-pay-coupon-paint') {
                return;
            }
            const clear = detail.clear_discount === true;
            const code = clear
                ? ''
                : text(detail.coupon_code
                    || (detail.discount_preview && detail.discount_preview.coupon_code)
                    || '').trim().toUpperCase();
            if (clear || code || detail.discount_preview) {
                amendContinuePayOrderMoney(clear
                    ? { clear_coupon: true }
                    : (code ? { coupon_code: code } : {})
                ).then(function (amended) {
                    if (!amended || !amended.totals) {
                        return;
                    }
                    const discMinor = Math.round((Number(amended.totals.discount_amount) || 0) * 100);
                    const couponCode = text(amended.totals.coupon_code || code || '').trim().toUpperCase();
                    try {
                        window.dispatchEvent(new CustomEvent('weline:cart-updated', {
                            detail: {
                                source: 'continue-pay-amend',
                                refresh: false,
                                coupon_code: couponCode,
                                clear_discount: discMinor <= 0,
                                discount_preview: discMinor > 0 ? {
                                    coupon_code: couponCode,
                                    amount_minor: discMinor,
                                    currency: amended.totals.currency || checkoutState.currency || 'USD',
                                } : null,
                            },
                        }));
                    } catch (eNotify) {}
                }).catch(function (err) {
                    setMessage((err && err.message) || copy.load_failed, 'error');
                });
                if (detail.refresh === false) {
                    return;
                }
            }
        }
        rememberPendingDiscount(detail);
        if (detail.clear_discount === true) {
            checkoutState.cart = mergeDiscountPreviewIntoCart(checkoutState.cart, null, true);
            if (!isContinuePayMode()) {
                renderTotals();
            }
        } else {
            const preview = resolveEventDiscountPreview(detail);
            if (preview && !isContinuePayMode()) {
                checkoutState.cart = mergeDiscountPreviewIntoCart(checkoutState.cart, preview, false);
                renderTotals();
            }
        }
        if (detail.refresh === false) {
            return;
        }
        if (isContinuePayMode()) {
            return;
        }
        scheduleReload({ hardOnFailure: true });
    });

    if (paymentRetryButton) {
        paymentRetryButton.addEventListener('click', async function () {
            if (!activePaymentRecovery) {
                return;
            }
            const redirectUrl = safePaymentRedirect(activePaymentRecovery.redirect_url);
            if (activePaymentRecovery.outcome === 'pending' && redirectUrl) {
                window.location.assign(redirectUrl);
                return;
            }
            paymentRetryButton.disabled = true;
            setText(paymentRetryButton, copy.retrying_payment);
            setMessage(copy.retrying_payment, '');
            try {
                const api = await getApi();
                const result = await api.resumePaymentV2({
                    quote_token: activePaymentRecovery.quote_token,
                    idempotency_key: activePaymentRecovery.idempotency_key,
                    payment_idempotency_key: newIdempotencyKey('checkout_payment_retry_'),
                    payment_method: activePaymentRecovery.payment_method,
                    country_code: activePaymentRecovery.country_code,
                });
                if (!result || result.success === false) {
                    throw new Error(text(result && result.message) || copy.load_failed);
                }
                handlePaymentResult(result, activePaymentRecovery);
            } catch (error) {
                setMessage(error.message || copy.payment_failed, 'error');
                paymentRetryButton.disabled = false;
                setText(paymentRetryButton, copy.retry_payment);
            }
        });
    }

    function pendingExpressPayMethod() {
        try {
            const params = new URLSearchParams(window.location.search || '');
            const method = text(params.get('express_pay') || '').trim().toLowerCase();
            const flag = params.get('express_checkout');
            if (method) {
                return method;
            }
            if (flag === '1' || flag === 'true') {
                return 'paypal';
            }
        } catch (e) {}
        return '';
    }

    function maybeAutoStartExpressPay() {
        const method = pendingExpressPayMethod();
        if (!method || root.dataset.expressAutoStarted === '1') {
            return;
        }
        // Empty cart: do not start express.
        if (checkoutState && checkoutState.cart && checkoutState.cart.is_empty) {
            return;
        }
        if (!checkoutState || !checkoutState.cart || typeof checkoutState.cart !== 'object') {
            return;
        }
        root.dataset.expressAutoStarted = '1';
        try {
            const url = new URL(window.location.href);
            url.searchParams.delete('express_pay');
            url.searchParams.delete('express_checkout');
            window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        } catch (e) {}
        root.dispatchEvent(new CustomEvent('weline:checkout:express-pay', {
            bubbles: true,
            detail: {
                payment_method: method,
                express_checkout: true,
            },
        }));
    }

    if (typeSwitchTrigger && typeSwitchMenu) {
        typeSwitchTrigger.addEventListener('click', function () {
            const open = typeSwitchMenu.hidden;
            typeSwitchMenu.hidden = !open;
            typeSwitchTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    }

    const initialPaymentRecovery = paymentRecoveryFromLocation();
    showCheckoutShell('loading');
    setMessage(copy.loading, '');
    if (initialPaymentRecovery) {
        // Continue-pay entry: full checkout + binding (not recovery island).
        adoptContinuePayFromRecovery(initialPaymentRecovery).catch(function (error) {
            const response = error && error.response && typeof error.response === 'object'
                ? error.response
                : {};
            const nested = response.data && typeof response.data === 'object' ? response.data : {};
            const payload = nested.data && typeof nested.data === 'object'
                ? nested.data
                : (nested.error_code || nested.already_paid ? nested : response);
            const errCode = text(
                (error && error.error_code)
                || payload.error_code
                || nested.error_code
                || response.error_code
                || ''
            ).trim();
            const msg = text(
                (error && error.message)
                || payload.message
                || nested.message
                || response.message
                || ''
            );
            const alreadySettled = errCode === 'continue_pay_order_not_pending'
                || !!(error && error.already_paid)
                || !!(payload.already_paid)
                || !!(nested.already_paid)
                || /已不可继续支付|can no longer (be paid|continue payment)|already\s*paid|not_pending/i.test(msg);
            if (alreadySettled) {
                // 已付订单：禁止 fallback 成可点「继续支付」的 recovery 岛。
                navigateToSuccess({
                    order_uuid: initialPaymentRecovery.order_uuid,
                    checkout_group_uuid: initialPaymentRecovery.checkout_group_uuid
                        || text(payload.checkout_group_uuid || nested.checkout_group_uuid || ''),
                    quote_token: initialPaymentRecovery.quote_token,
                });
                return;
            }
            setMessage(msg || copy.load_failed, 'error');
            // Fallback：续付 token 只进 continue_pay 槽，勿污染 browse。
            persistContinuePayQuoteToken(initialPaymentRecovery.quote_token);
            continuePayBinding = Object.assign({}, initialPaymentRecovery, {
                chrome: {
                    title: copy.continue_pay_chrome || copy.continue_payment,
                    detail: copy.continue_pay_detail || copy.continue_pay_chrome,
                    cta_label: copy.continue_payment,
                    submit_mode: 'resumePaymentV2',
                    address_complete: false,
                    expand_address: true,
                },
            });
            syncContinuePayChrome();
            syncContinuePayAddressPanel();
            loadCheckoutWithRetry().catch(function () {});
        });
    } else {
        // 传统结账入口：释放续付 cookie 桶 + 清续付槽 + 丢掉污染 browse token。
        releaseContinuePayIsolation().then(function () {
            try {
                const migrateKey = 'weline_checkout_cpay_isolate_v2_' + quoteTokenStorageKey();
                if (!window.sessionStorage.getItem(migrateKey)) {
                    // 旧版把续付 getData mint 的 browse token 写进了普通槽；升迁清一次。
                    window.sessionStorage.removeItem(quoteTokenStorageKey());
                    window.sessionStorage.setItem(migrateKey, '1');
                }
            } catch (eTok) {}
            return loadCheckoutWithRetry();
        }).then(function () {
            maybeAutoStartExpressPay();
        }).catch(function (error) {
            setMessage(error.message || copy.load_failed, 'error');
            if (submitButton) {
                submitButton.disabled = true;
            }
        });
    }
})();
</script>
