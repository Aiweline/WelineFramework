        if (form) {
            form.hidden = true;
        }
        if (expressHost) {
            expressHost.hidden = true;
        }
        if (emptyState) {
            emptyState.hidden = true;
        }
        if (paymentRecovery) {
            paymentRecovery.hidden = false;
