<?php

declare(strict_types=1);

/** @var array<string, mixed>|null $order */
$order = $this->getData('order');
if (!is_array($order) || $order === []) {
    return;
}

$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$money = static fn (int $minor, string $currency): string => $currency . ' ' . number_format($minor / 100, 2, '.', ',');
$statusLabel = static fn (string $status): string => match ($status) {
    'pending' => __('待支付'),
    'processing' => __('处理中'),
    'paid' => __('已支付'),
    'fulfilled', 'shipped' => __('已发货'),
    'completed', 'delivered' => __('已完成'),
    'cancelled', 'canceled' => __('已取消'),
    'refunded' => __('已退款'),
    default => $status !== '' ? $status : __('状态待确认'),
};

$items = is_array($order['items'] ?? null) ? $order['items'] : [];
$moneyData = is_array($order['money'] ?? null) ? $order['money'] : [];
$currency = strtoupper(trim((string)($order['currency'] ?? 'CNY'))) ?: 'CNY';
$orderUuid = trim((string)($order['order_uuid'] ?? ''));
$displayNumber = trim((string)($order['display_number'] ?? '')) ?: $orderUuid;
$status = trim((string)($order['status'] ?? ''));
$accountOrdersUrl = $this->getUrl('customer/account/index') . '#orders';
?>
<main class="order-view-page" data-checkout-order-view data-order-uuid="<?= $escape($orderUuid) ?>">
    <header class="order-view-page__header">
        <div>
            <p class="order-view-page__eyebrow"><?= __('订单中心') ?></p>
            <h1><?= __('订单详情') ?></h1>
        </div>
        <a href="<?= $escape($accountOrdersUrl) ?>" class="order-view-page__back"><?= __('返回我的订单') ?></a>
    </header>

    <section class="order-info-section" aria-labelledby="order-info-heading" weline-code="checkout.order.view.info">
        <h2 id="order-info-heading"><?= __('订单信息') ?></h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="label"><?= __('订单号') ?></span>
                <strong class="value"><?= $escape($displayNumber) ?></strong>
            </div>
            <div class="info-item">
                <span class="label"><?= __('订单状态') ?></span>
                <strong class="value order-status" data-order-status="<?= $escape($status) ?>"><?= $escape($statusLabel($status)) ?></strong>
            </div>
            <div class="info-item">
                <span class="label"><?= __('订单标识') ?></span>
                <span class="value order-uuid"><?= $escape($orderUuid) ?></span>
            </div>
        </div>
    </section>

    <section class="order-items-section" aria-labelledby="order-items-heading" weline-code="checkout.order.view.items">
        <h2 id="order-items-heading"><?= __('订单商品') ?></h2>
        <?php if ($items === []): ?>
            <p class="order-items-empty"><?= __('暂无商品明细') ?></p>
        <?php else: ?>
            <div class="order-items-scroll" data-order-table-scroll role="region" tabindex="0" aria-label="<?= $escape(__('订单商品明细')) ?>">
                <table class="order-items-table">
                    <thead>
                    <tr>
                        <th><?= __('产品名称') ?></th>
                        <th><?= __('SKU') ?></th>
                        <th><?= __('数量') ?></th>
                        <th><?= __('单价') ?></th>
                        <th><?= __('小计') ?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($items as $item): ?>
                        <?php
                        $item = is_array($item) ? $item : [];
                        $quantity = max(0, (int)($item['qty_minor'] ?? 0));
                        $unitPriceMinor = (int)($item['unit_price_minor'] ?? 0);
                        $rowTotalMinor = isset($item['row_total_minor'])
                            ? (int)$item['row_total_minor']
                            : $quantity * $unitPriceMinor;
                        ?>
                        <tr>
                            <td><?= $escape($item['name'] ?? __('未命名商品')) ?></td>
                            <td><?= $escape($item['sku'] ?? '-') ?></td>
                            <td><?= $escape($quantity) ?></td>
                            <td><?= $escape($money($unitPriceMinor, $currency)) ?></td>
                            <td><?= $escape($money($rowTotalMinor, $currency)) ?></td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </section>

    <section class="order-totals-section" aria-labelledby="order-totals-heading" weline-code="checkout.order.view.totals">
        <h2 id="order-totals-heading"><?= __('费用明细') ?></h2>
        <div class="totals">
            <div class="total-row"><span><?= __('商品小计') ?></span><span><?= $escape($money((int)($moneyData['subtotal_minor'] ?? 0), $currency)) ?></span></div>
            <div class="total-row"><span><?= __('运费') ?></span><span><?= $escape($money((int)($moneyData['shipping_amount_minor'] ?? 0), $currency)) ?></span></div>
            <div class="total-row"><span><?= __('税费') ?></span><span><?= $escape($money((int)($moneyData['tax_amount_minor'] ?? 0), $currency)) ?></span></div>
            <div class="total-row total"><span><?= __('订单总额') ?></span><strong><?= $escape($money((int)($moneyData['grand_total_minor'] ?? 0), $currency)) ?></strong></div>
        </div>
    </section>
</main>

