 * layoutType=checkout/failure，option=default → layouts/checkout/failure/default.phtml
 * 历史输入别名 `checkout_failer` / `checkout_failure` 由 ThemePageTypeResolver 映射到本路径；不再保留下划线布局目录。
 *
 * @meta.name {default="结算失败页面布局",name="结算失败页面布局",description="结算失败页面布局，用于描述布局的名称"}
 * @meta.description {default="订单结算失败后的恢复页面布局",name="订单结算失败后的恢复页面布局",description="订单结算失败后的恢复页面布局，用于描述布局的用途"}
 * @param title {default="订单尚未完成",name="页面标题",description="页面标题，用于设置页面标题"}
 * @param content {default="",name="主要内容（HTML字符串）",description="主要内容（HTML字符串），用于设置页面内容"}
 * @param errorMessage {default="",name="错误说明",description="错误说明文案"}
 * @param errorCode {default="",name="错误代码",description="可选错误代码"}
 * @param retryUrl {default="",name="重试链接",description="可选重试结算链接"}
 * @param backToCart {default="/cart",name="返回购物车链接",description="返回购物车链接"}
 * @param class {default="",name="额外CSS类",description="额外CSS类，用于设置页面额外CSS类"}
 */
?>
<?php
$title = $this->getData('title') ?? __('订单尚未完成');
$content = $this->getData('content') ?? '';
$errorMessage = $this->getData('errorMessage') ?? __('本次结算没有生成有效订单，也不会在此页面重复扣款。您可以返回购物车核对商品，或前往帮助中心排查支付与配送问题。');
$errorCode = $this->getData('errorCode') ?? '';
$retryUrl = $this->getData('retryUrl') ?? '';
$backToCart = $this->getData('backToCart') ?? '/cart';
$class = $this->getData('class') ?? '';

$this->assign('title', $title);
?>
