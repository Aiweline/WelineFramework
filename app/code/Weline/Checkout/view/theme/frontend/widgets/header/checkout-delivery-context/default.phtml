         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="checkout-delivery-context"
         data-testid="checkout-delivery-context"
         data-checkout-delivery-widget>
    <button type="button"
            class="w-header-delivery-entry location-link delivery-entry"
            data-action="toggle"
            aria-haspopup="dialog">
        <w:icon name="pin" size="sm"></w:icon>
        <span class="location-text delivery-text">
            <span class="w-text-muted location-line-1 delivery-line-1"><?= $esc($title) ?></span>
            <span class="w-text location-line-2 delivery-line-2" data-delivery-display><?= $esc($displayText) ?></span>
        </span>
        <w:icon name="chevron-down" size="sm"></w:icon>
    </button>

    <div class="delivery-panel w-surface-body" data-surface="body" hidden data-panel>
        <div class="delivery-panel-head">
            <strong><?= $esc(WidgetI18n::label('配送地址')) ?></strong>
            <button type="button" class="w-button" data-action="close" data-size="xs" data-variant="outline"><?= $esc(WidgetI18n::label('关闭')) ?></button>
        </div>

        <div class="w-field country-picker">
            <label class="w-field__label"><?= $esc(WidgetI18n::label('国家/地区')) ?></label>
            <input type="hidden" data-country-code value="<?= $esc((string)($context['country_code'] ?? 'CN')) ?>">
            <input type="search"
