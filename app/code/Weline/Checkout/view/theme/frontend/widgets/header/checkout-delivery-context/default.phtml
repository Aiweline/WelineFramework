// preview_storefront_delivery_parity: editor/preview MUST use the same context
// + Hook + auto-detect path as the live storefront (no editor_mode stub/skip).
// Guest-safe SSR: never personalize by Session cookie; panel refreshes via QueryBin
// on first open (interactive auth contract).
$placeholderCountry = WidgetI18n::label('选择国家/地址');
$context = [
    'country_code' => 'CN',
    'country_name' => WidgetI18n::label('China', '中国'),
    'countries' => [],
    'addresses' => [],
    'selected' => null,
    'is_logged_in' => false,
    'can_auto_detect' => false,
    'display_text' => $placeholderCountry,
    'checkout_address' => [],
];

$displayText = trim((string)($context['display_text'] ?? '')) ?: $placeholderCountry;
?>
<section class="<?= $esc($wc) ?>"
