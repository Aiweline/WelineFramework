                   value="<?= $esc((string)($context['country_name'] ?? '')) ?>">
            <div class="country-results" data-country-results hidden></div>
        </div>

        <div class="address-list" data-address-list></div>

        <div data-delivery-quick-add-slot>
            <w:hook>Weline_Checkout::frontend::widgets::checkout-delivery-context::quick-add</w:hook>
        </div>

        <?php if ($autoDetect): ?>
            <button type="button" class="w-button" data-action="auto-detect" data-variant="outline" data-size="sm"><?= $esc(WidgetI18n::label('自动定位')) ?></button>
        <?php endif; ?>
        <p class="message" data-message hidden></p>
    </div>
</section>

