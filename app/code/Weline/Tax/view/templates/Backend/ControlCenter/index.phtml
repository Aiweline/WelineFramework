<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('税务管理'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$readOnly = (bool)($this->getData('workspace_read_only') ?? true);
$form = (array)($this->getData('workspace_form') ?? []);
$formActionUrl = $form === [] ? '' : $this->getBackendUrl((string)($form['action'] ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) {
        return $value ? (string)__('是') : (string)__('否');
    }
    if (is_array($value)) {
        return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    }
    return $escape($value);
};
?>
<section class="commerce-control-center" data-testid="tax-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
        <h4 style="--w-mb-sm:0;"><?= $escape($title) ?></h4>
        <span class="w-badge <?= $readOnly ? 'bg-info text-dark' : 'bg-success' ?>"><?= $readOnly ? __('只读诊断') : __('可配置') ?></span>
    </div>
    <div class="w-alert <?= $readOnly ? 'alert-info' : 'alert-warning' ?>" role="status">
        <?= $readOnly
            ? __('此页面只读取当前数据库事实；迁移及生产切流仍只能通过受控 CLI 执行。')
            : __('配置保存到当前数据库；生产迁移与切流仍只能通过受控 CLI 执行。') ?>
    </div>
    <?php if ($form !== []): ?>
        <?php $kind = (string)($form['kind'] ?? ''); ?>
        <div class="w-card" data-testid="tax-<?= $escape($code) ?>-create-form" style="--w-mb:var(--weline-space-4);">
            <div class="w-card__header"><h5 style="--w-mb:0;"><?= __('新增%{1}', $title) ?></h5></div>
            <div class="w-card__body">
                <w:form method="post" action="@var($formActionUrl)">
                    <div class="w-grid" style="--w-gap:var(--weline-space-4);">
                        <div style="--w-span-md:2;">
                            <label class="w-field__label"><?= __('网站 ID') ?></label>
                            <input class="w-input" type="number" min="0" name="website_id" value="0" required>
                        </div>
                        <div style="--w-span-md:3;">
                            <label class="w-field__label"><?= __('税类代码') ?></label>
                            <input class="w-input" name="class_code" maxlength="64" pattern="[a-z0-9][a-z0-9_\-]{0,63}" required>
                        </div>
                        <?php if ($kind === 'class'): ?>
                            <div style="--w-span-md:4;">
                                <label class="w-field__label"><?= __('税类名称') ?></label>
                                <input class="w-input" name="name" maxlength="255" required>
                            </div>
                        <?php else: ?>
                            <div style="--w-span-md:3;">
                                <label class="w-field__label"><?= __('管辖区') ?></label>
                                <input class="w-input" name="jurisdiction_key" maxlength="64" placeholder="CN| 或 US|CA" required>
                            </div>
                            <div style="--w-span-md:2;">
                                <label class="w-field__label"><?= __('税率（基点）') ?></label>
                                <input class="w-input" type="number" min="0" max="10000" name="rate_bps" required>
                            </div>
                            <?php if ($kind === 'rule'): ?>
                                <div style="--w-span-md:2;">
                                    <label class="w-field__label"><?= __('规则版本') ?></label>
                                    <input class="w-input" type="number" min="1" name="rule_version" value="1" required>
                                </div>
                                <div style="--w-span-md:2;">
                                    <label class="w-field__label"><?= __('舍入模式') ?></label>
                                    <select class="w-select" name="rounding"><option value="half_up">half_up</option></select>
                                </div>
                            <?php endif; ?>
                        <?php endif; ?>
                        <div class="w-cluster" data-align="end" style="--w-span-md:2;">
                            <input type="hidden" name="enabled" value="0">
                            <label class="w-check" style="--w-mb:var(--weline-space-2);"><input type="checkbox" name="enabled" value="1" checked> <span><?= __('启用') ?></span></label>
                        </div>
                        <div class="w-cluster" data-align="end" style="--w-span-md:2;">
                            <button class="w-button" type="submit" data-testid="tax-<?= $escape($code) ?>-submit" data-w-width="full" data-tone="primary"><?= __('创建') ?></button>
                        </div>
                    </div>
                </w:form>
            </div>
        </div>
    <?php endif; ?>
    <?php if ($status !== []): ?>
        <div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__body"><div class="w-grid" style="--w-gap:var(--weline-space-4);">
            <?php foreach ($status as $key => $value): ?>
                <div style="--w-span-md:4;"><div class="w-text" data-tone="muted" data-size="sm"><?= $escape($key) ?></div><div class="w-text" data-weight="strong"><?= $display($value) ?></div></div>
            <?php endforeach; ?>
        </div></div></div>
    <?php endif; ?>
    <?php foreach ($datasets as $dataset): ?>
        <div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__header"><h5 style="--w-mb:0;"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="w-card__body">
            <?php if (!empty($dataset['error'])): ?>
                <div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div>
            <?php elseif (empty($dataset['rows'])): ?>
                <div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div>
            <?php else: ?>
                <div class="w-table-wrap"><table class="w-table" data-w-vertical="middle" style="--w-mb:0;"><thead><tr>
                    <?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?>
                </tr></thead><tbody>
                    <?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?>
                </tbody></table></div>
            <?php endif; ?>
        </div></div>
    <?php endforeach; ?>
</section>
