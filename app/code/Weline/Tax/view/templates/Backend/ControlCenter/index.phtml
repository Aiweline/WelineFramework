<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('税务管理'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$readOnly = (bool)($this->getData('workspace_read_only') ?? true);
$form = (array)($this->getData('workspace_form') ?? []);
$formActionUrl = $form === [] ? '' : $this->getBackendUrl((string)($form['action'] ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) {
        return $value ? (string)__('是') : (string)__('否');
    }
    if (is_array($value)) {
        return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    }
    return $escape($value);
};
?>
<section class="commerce-control-center" data-testid="tax-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0"><?= $escape($title) ?></h4>
        <span class="badge <?= $readOnly ? 'bg-info text-dark' : 'bg-success' ?>"><?= $readOnly ? __('只读诊断') : __('可配置') ?></span>
    </div>
    <div class="alert <?= $readOnly ? 'alert-info' : 'alert-warning' ?>" role="status">
        <?= $readOnly
            ? __('此页面只读取当前数据库事实；迁移及生产切流仍只能通过受控 CLI 执行。')
            : __('配置保存到当前数据库；生产迁移与切流仍只能通过受控 CLI 执行。') ?>
    </div>
    <?php if ($form !== []): ?>
        <?php $kind = (string)($form['kind'] ?? ''); ?>
        <div class="card mb-3" data-testid="tax-<?= $escape($code) ?>-create-form">
            <div class="card-header"><h5 class="mb-0"><?= __('新增%{1}', $title) ?></h5></div>
            <div class="card-body">
                <w:form method="post" action="@var($formActionUrl)">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label"><?= __('网站 ID') ?></label>
                            <input class="form-control" type="number" min="0" name="website_id" value="0" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><?= __('税类代码') ?></label>
                            <input class="form-control" name="class_code" maxlength="64" pattern="[a-z0-9][a-z0-9_\-]{0,63}" required>
                        </div>
                        <?php if ($kind === 'class'): ?>
                            <div class="col-md-4">
                                <label class="form-label"><?= __('税类名称') ?></label>
                                <input class="form-control" name="name" maxlength="255" required>
                            </div>
                        <?php else: ?>
                            <div class="col-md-3">
                                <label class="form-label"><?= __('管辖区') ?></label>
                                <input class="form-control" name="jurisdiction_key" maxlength="64" placeholder="CN| 或 US|CA" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label"><?= __('税率（基点）') ?></label>
                                <input class="form-control" type="number" min="0" max="10000" name="rate_bps" required>
                            </div>
                            <?php if ($kind === 'rule'): ?>
                                <div class="col-md-2">
                                    <label class="form-label"><?= __('规则版本') ?></label>
                                    <input class="form-control" type="number" min="1" name="rule_version" value="1" required>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label"><?= __('舍入模式') ?></label>
                                    <select class="form-select" name="rounding"><option value="half_up">half_up</option></select>
                                </div>
                            <?php endif; ?>
                        <?php endif; ?>
                        <div class="col-md-2 d-flex align-items-end">
                            <input type="hidden" name="enabled" value="0">
                            <label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="enabled" value="1" checked> <span class="form-check-label"><?= __('启用') ?></span></label>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" type="submit" data-testid="tax-<?= $escape($code) ?>-submit"><?= __('创建') ?></button>
                        </div>
                    </div>
                </w:form>
            </div>
        </div>
    <?php endif; ?>
    <?php if ($status !== []): ?>
        <div class="card mb-3"><div class="card-body"><div class="row g-3">
            <?php foreach ($status as $key => $value): ?>
                <div class="col-md-4"><div class="text-muted small"><?= $escape($key) ?></div><div class="fw-semibold"><?= $display($value) ?></div></div>
            <?php endforeach; ?>
        </div></div></div>
    <?php endif; ?>
    <?php foreach ($datasets as $dataset): ?>
        <div class="card mb-3"><div class="card-header"><h5 class="mb-0"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="card-body">
            <?php if (!empty($dataset['error'])): ?>
                <div class="alert alert-warning mb-0"><?= $escape($dataset['error']) ?></div>
            <?php elseif (empty($dataset['rows'])): ?>
                <div class="text-muted"><?= __('当前没有记录。') ?></div>
            <?php else: ?>
                <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr>
                    <?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?>
                </tr></thead><tbody>
                    <?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?>
                </tbody></table></div>
            <?php endif; ?>
        </div></div>
    <?php endforeach; ?>
</section>
