 * @config.acl {Weline_SystemConfig::config}
 */
?>

<w:config:group code="tax_runtime" label="税务运行规则" description="由 Weline_Tax 提供；保存与 scope 继承由 SystemConfig 负责。" sort="10">
    <w:config:field
        key="tax/general/enabled"
        label="启用税务引擎"
        description="关闭时保持 checkout stub；开启后由服务端 TaxEngine 算税。可在 Global / 网站 / 店铺 / 渠道级开关（渠道覆盖店铺）。另需 commerce rollout tax 放行。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global,website,store,channel" />

    <w:config:field
        key="tax/general/default_jurisdiction"
        label="默认管辖区"
        description="格式 country|region，例如 CN| 或 US|CA。"
        type="text"
        value-type="string"
        default="CN|"
        scope="global,website,store,channel"
        validation="required|max:64" />

    <w:config:field
        key="tax/general/rule_schema_version"
        label="规则 Schema 版本"
        description="必须与引擎 TaxEngine::SCHEMA_VERSION 一致；跨版本 LKG 不可读。"
        type="text"
        value-type="string"
        default="tax-schema-v1"
        scope="global,website,store,channel"
        validation="required|max:64" />

    <w:config:field
        key="tax/general/rounding"
        label="舍入模式"
        description="开卡冻结：half_up（单项舍入误差 ≤1 minor）。"
        type="select"
        value-type="string"
        default="half_up"
        scope="global,website,store,channel"
        options="half_up:四舍五入（Half Up）"
        validation="required|in_options" />

    <w:config:field
        key="tax/general/prices_include_tax"
        label="商品价格已含税（价内税）"
        description="开启后：目录价含默认管辖区增值税。国内不再价外加收；跨境默认按目的地进口税/关税预估（避免与销售税双计）。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website,store,channel" />

    <w:config:field
        key="tax/general/collect_sales_tax_countries"
        label="结账代收目的地销售税的国家"
        description="逗号分隔 ISO2。通用默认留空：只种子税率，结账不代收目的地销售税（跨境关税/进口税仍可按 DDU 预估）。仅当已注册义务时填写——例：欧盟 IOSS 填 EU 各国；英国 VAT 填 GB；澳/新 GST 填 AU,NZ；美国某州 nexus 再填 US。整站不算税：关闭「启用税务引擎」；单品免税：tax_class=exempt。"
        type="text"
        value-type="string"
        default=""
        scope="global,website,store,channel"
        validation="max:255" />
</w:config:group>

<w:config:hint
    code="tax_freeze"
    label="开卡冻结"
    description="管辖区键=country|region；舍入=half_up 按行再汇总；失败禁止回零税；仅同 schema+rule_set_hash 的已验证 LKG 可读。" />

<w:config:group code="tax_ratesync" label="税率多源同步" description="离线聚合免费源并集（冲突取较高税率）；可选专业 HTTP 源覆盖已返回管辖区。不进入结账热路径。" sort="20">
    <w:config:field
        key="tax/ratesync/mode"
        label="同步模式"
        description="auto_free=允许 Cron/自动；manual_only=仅后台「立即同步」或 CLI --force。"
        type="select"
        value-type="string"
        default="auto_free"
        scope="global"
        options="auto_free:自动免费聚合,manual_only:仅手动"
        validation="required|in_options" />

    <w:config:field
        key="tax/ratesync/free_providers"
        label="启用的免费源"
        description="逗号分隔 provider code。默认 static,vatcomply。"
        type="text"
        value-type="string"
        default="static,vatcomply"
        scope="global"
        validation="required|max:255" />

    <w:config:field
        key="tax/ratesync/cron_enabled"
        label="启用日级 Cron 同步"
        description="需安装 Weline_Cron；表达式默认每天 03:00 UTC。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global" />

    <w:config:field
        key="tax/ratesync/professional/enabled"
        label="启用专业税率源"
        description="开启后对其返回的管辖区覆盖免费并集（即使专业税率更低）。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global" />

    <w:config:field
        key="tax/ratesync/professional/provider"
        label="专业源 Provider"
        description="首版仅 generic_http（配置驱动 HTTP）。"
        type="select"
        value-type="string"
        default="generic_http"
        scope="global"
        options="generic_http:通用 HTTP"
        validation="required|in_options" />

    <w:config:field
        key="tax/ratesync/professional/base_url"
        label="专业源 Base URL"
        description="HTTPS JSON 端点；密钥勿写入 Git。"
        type="text"
        value-type="string"
        default=""
        scope="global"
        validation="max:512" />

    <w:config:field
        key="tax/ratesync/professional/api_key"
        label="专业源 API Key"
        description="密文存储；日志禁止打印完整密钥。"
        type="password"
        value-type="string"
        default=""
        scope="global"
        validation="max:512" />

    <w:config:field
        key="tax/ratesync/professional/mapping"
        label="专业源 Mapping JSON"
        description='示例 VATcomply：{"mode":"vatcomply_eu"}。候选列表：{"mode":"candidates","list_path":"rates","jurisdiction_field":"jurisdiction_key","class_field":"class_code","rate_bps_field":"rate_bps","rate_is_percent":false,"api_key_header":"Authorization","api_key_prefix":"Bearer "}。TaxJar 风格可把 list_path 指到 rates 并用 rate_is_percent=true。'
        type="textarea"
        value-type="string"
        default='{"mode":"vatcomply_eu"}'
        scope="global"
        validation="max:4000" />
</w:config:group>
