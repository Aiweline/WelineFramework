<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn ($v) => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$filters = is_array($this->getData('filters')) ? $this->getData('filters') : [];
$tasks = is_array($this->getData('tasks')) ? $this->getData('tasks') : [];
$logs = is_array($this->getData('logs')) ? $this->getData('logs') : [];
$statuses = is_array($this->getData('statuses')) ? $this->getData('statuses') : [];
$assignees = is_array($this->getData('assignees')) ? $this->getData('assignees') : [];
$actions = is_array($this->getData('actions')) ? $this->getData('actions') : [];
$activeTab = (string)($this->getData('active_tab') ?? 'tasks');
if (!in_array($activeTab, ['tasks', 'logs'], true)) {
    $activeTab = 'tasks';
}

$statusMeta = static function (string $status): array {
    return match ($status) {
        'queued' => ['label' => (string)__('排队中'), 'tone' => 'neutral'],
        'running' => ['label' => (string)__('执行中'), 'tone' => 'info'],
        'awaiting_approval' => ['label' => (string)__('待审批'), 'tone' => 'warning'],
        'done' => ['label' => (string)__('已完成'), 'tone' => 'success'],
        'failed' => ['label' => (string)__('失败'), 'tone' => 'danger'],
        'cancelled' => ['label' => (string)__('已取消'), 'tone' => 'muted'],
        default => ['label' => $status !== '' ? $status : '—', 'tone' => 'neutral'],
    };
};
$agentLabel = static function (string $agent): string {
    return match ($agent) {
        'ops_analyst' => (string)__('分析智能体'),
        'blog_publish' => (string)__('博客智能体'),
        'social_ops' => (string)__('社媒智能体'),
        default => $agent !== '' ? $agent : '—',
    };
};
$shortSession = static function (string $sessionId) use ($escape): string {
    $sessionId = trim($sessionId);
    if ($sessionId === '') {
        return '—';
    }
    if (strlen($sessionId) <= 12) {
        return $escape($sessionId);
    }

    return $escape(substr($sessionId, 0, 8) . '…');
};
$filterQuery = static function (array $extra = []) use ($filters): string {
    $params = array_merge([
        'website_id' => (string)($filters['website_id'] ?? ''),
        'status' => (string)($filters['status'] ?? ''),
        'assignee_agent' => (string)($filters['assignee_agent'] ?? ''),
        'session_id' => (string)($filters['session_id'] ?? ''),
        'dispatch_only' => (string)($filters['dispatch_only'] ?? '1'),
    ], $extra);
    $pairs = [];
    foreach ($params as $key => $value) {
        if ($value === '' || $value === null) {
            continue;
        }
        $pairs[] = rawurlencode((string)$key) . '=' . rawurlencode((string)$value);
    }

    return $pairs === [] ? '' : ('?' . implode('&', $pairs));
};
$logTone = static function (string $status): string {
    return match ($status) {
        'ok', 'success', 'done' => 'success',
        'error', 'failed' => 'danger',
        default => 'neutral',
    };
};
?>
