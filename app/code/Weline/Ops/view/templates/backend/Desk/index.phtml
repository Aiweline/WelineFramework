<script>
(function () {
    var personaDialog = document.getElementById('ops-persona-dialog');
    var dispatchDialog = document.getElementById('ops-dispatch-dialog');
    var openPersonaBtn = document.getElementById('ops-open-persona-btn');
    var openDispatchBtn = document.getElementById('ops-open-dispatch-btn');
    var refreshBtn = document.getElementById('ops-refresh-persona-btn');
    var refreshInDialogBtn = document.getElementById('ops-refresh-persona-in-dialog');
    var panel = document.getElementById('ops-persona-sse-panel');
    var streamUrl = <?= json_encode($personaSseUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;

    function openDialog(el) {
        if (!el) {
            return;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog && typeof window.Weline.UI.dialog.open === 'function') {
            window.Weline.UI.dialog.open(el);
            return;
        }
        el.hidden = false;
        el.setAttribute('data-state', 'open');
        el.setAttribute('aria-hidden', 'false');
    }

    function startPersonaStream() {
        if (!streamUrl) {
            return;
        }
        openDialog(personaDialog);
        if (panel) {
            panel.style.display = '';
        }
        var progress = window.WelineSseProgress && window.WelineSseProgress['ops-persona-progress'];
        if (!progress) {
            if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                Weline.UI.toast.error(<?= json_encode((string)__('进度面板未就绪，请刷新页面后重试'), JSON_UNESCAPED_UNICODE) ?>);
            }
            return;
        }
        if (progress.isRunning && progress.isRunning()) {
            return;
        }
        progress.reset && progress.reset();
        progress.setUrl(streamUrl);
        progress.on('done', function () {
            if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                Weline.UI.toast.success(<?= json_encode((string)__('画像提取完成'), JSON_UNESCAPED_UNICODE) ?>);
            }
            window.setTimeout(function () {
                window.location.reload();
            }, 600);
        });
        progress.on('failed', function () {
            if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                Weline.UI.toast.error(<?= json_encode((string)__('画像提取失败，请查看进度日志'), JSON_UNESCAPED_UNICODE) ?>);
            }
        });
        progress.start();
    }

    if (openPersonaBtn) {
        openPersonaBtn.addEventListener('click', function () {
            openDialog(personaDialog);
        });
    }
    if (openDispatchBtn) {
        openDispatchBtn.addEventListener('click', function () {
            openDialog(dispatchDialog);
        });
    }
    if (refreshBtn) {
        refreshBtn.addEventListener('click', startPersonaStream);
    }
    if (refreshInDialogBtn) {
        refreshInDialogBtn.addEventListener('click', startPersonaStream);
    }

    var taskCreate = document.querySelector('[data-testid="ops-desk-task-create"]');
    if (taskCreate) {
        taskCreate.open = false;
    }
})();
</script>
