        <script>
        (function () {
            var btn = document.getElementById('ops-refresh-persona-btn');
            var panel = document.getElementById('ops-persona-sse-panel');
            var streamUrl = <?= json_encode($personaSseUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
            if (!btn || !streamUrl) {
                return;
            }
            btn.addEventListener('click', function () {
                if (panel) {
                    panel.style.display = '';
                }
                var progress = window.WelineSseProgress && window.WelineSseProgress['ops-persona-progress'];
                if (!progress) {
                    if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                        Weline.UI.toast.error(<?= json_encode((string)__('进度面板未就绪，请刷新页面后重试'), JSON_UNESCAPED_UNICODE) ?>);
                    }
                    return;
                }
                if (progress.isRunning && progress.isRunning()) {
                    return;
                }
                progress.reset && progress.reset();
                progress.setUrl(streamUrl);
                progress.on('done', function () {
                    if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                        Weline.UI.toast.success(<?= json_encode((string)__('画像提取完成'), JSON_UNESCAPED_UNICODE) ?>);
                    }
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 600);
                });
                progress.on('failed', function () {
                    if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
                        Weline.UI.toast.error(<?= json_encode((string)__('画像提取失败，请查看进度日志'), JSON_UNESCAPED_UNICODE) ?>);
                    }
                });
                progress.start();
            });
        })();
        </script>

