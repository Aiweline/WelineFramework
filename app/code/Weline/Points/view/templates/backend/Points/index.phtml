<?php
$page = (string) ($this->getData('points_page') ?? 'overview');
$title = (string) ($this->getData('points_title') ?? __('积分与会员'));
$summary = (array) ($this->getData('points_summary') ?? []);
$datasets = (array) ($this->getData('points_datasets') ?? []);
$selectedScope = (string) ($this->getData('points_selected_scope') ?? 'default.default.default');
$centerUrl = (string) ($this->getData('points_center_url') ?? '');
$escape = static fn (mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) {
        return $value ? (string) __('是') : (string) __('否');
    }
    if (is_array($value)) {
        return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    }

    return $escape($value);
};
?>
<section class="points-backend" data-testid="points-<?= $escape($page) ?>">
    <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="end">
        <div class="w-cluster" data-gap="2">
            <span class="w-badge bg-info text-dark"><?= __('万能积分') ?></span>
            <span class="w-badge bg-secondary text-white">Weline_Points</span>
        </div>
    </div>

    <?php if ($page === 'settings'): ?>
        <div class="points-settings w-stack" style="--w-gap:var(--weline-space-6);" data-testid="points-settings">
            <div class="w-cluster" data-align="center" data-justify="between" style="--w-gap:var(--weline-space-3);">
                <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                    <p class="w-text" data-tone="muted" data-size="sm" style="--w-m:0;">
                        <lang>配置写入当前作用范围；切换范围后页面按新范围加载。抵扣还需在 Payment 积分资产中打开启用与兑换比例。</lang>
                    </p>
                </div>
                <?php if ($centerUrl !== ''): ?>
                    <a class="w-button" data-tone="neutral" data-variant="outline" data-size="sm"
                       href="<?= $escape($centerUrl) ?>">
                        <lang>在统一配置中心打开</lang>
                    </a>
                <?php endif; ?>
            </div>

            <div class="w-field points-scope-field">
                <label class="w-field__label" for="points-config-scope"><lang>作用范围</lang></label>
                <div class="w-field__control">
                    <w:scope
                        id="points-config-scope"
                        name="target_scope"
                        value="selectedScope"
                        placeholder="@lang(选择网站、店铺或渠道)"
                        search-placeholder="@lang(搜索作用范围)"
                        aria-label="@lang(选择作用范围)"
                        searchable="true"
                        default-expand-all="true"
                        required="true"
                    />
                </div>
            </div>

            <w:config:embed
                module="Weline_Points"
                area="backend"
                fields="points/earn/enabled,points/earn/rate_per_currency_unit,points/growth/rate_per_currency_unit,points/product/default_ratio,points/product/default_fixed_points,points/discount/enabled,points/discount/max_ratio,points/vip/enabled,points/vip/basis,points/vip/multiplier_enabled"
                locale="default"
            />

            <div class="w-stack" style="--w-gap:var(--weline-space-2);">
                <h3 class="w-text" data-weight="semibold" style="--w-m:0;">
                    <lang>Payment 积分资产（抵扣前置条件）</lang>
                </h3>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-m:0;">
                    <lang>结账抵扣要求同时打开 Payment 的积分资产启用与正的兑换比例；折扣角色由积分模块策略自动声明，无需在此打开。</lang>
                </p>
                <w:config:embed
                    module="Weline_Payment"
                    area="backend"
                    fields="payment/asset/points/enabled,payment/asset/points/exchange_ratio"
                    locale="default"
                />
            </div>
        </div>
    <?php else: ?>
        <?php if ($summary !== []): ?>
            <div class="w-grid" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-4);">
                <?php foreach ($summary as $label => $count): ?>
                    <div class="w-card" style="--w-span-md:3;">
                        <div class="w-card__body">
                            <div class="w-text" data-tone="muted" data-size="sm"><?= $escape($label) ?></div>
                            <div class="w-text" data-weight="strong" data-size="xl"><?= $escape((string) $count) ?></div>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php foreach ($datasets as $dataset): ?>
            <div class="w-card" style="--w-mb:var(--weline-space-4);">
                <div class="w-card__header"><h5 style="--w-mb:0;"><?= $escape($dataset['label'] ?? '') ?></h5></div>
                <div class="w-card__body">
                    <?php if (!empty($dataset['error'])): ?>
                        <div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div>
                    <?php elseif (empty($dataset['rows'])): ?>
                        <div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div>
                    <?php else: ?>
                        <div class="w-table-wrap">
                            <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                                <thead>
                                <tr>
                                    <?php foreach (array_keys($dataset['rows'][0]) as $field): ?>
                                        <th><?= $escape($field) ?></th>
                                    <?php endforeach; ?>
                                </tr>
                                </thead>
                                <tbody>
                                <?php foreach ($dataset['rows'] as $row): ?>
                                    <tr>
                                        <?php foreach ($row as $value): ?>
                                            <td><?= $display($value) ?></td>
                                        <?php endforeach; ?>
                                    </tr>
                                <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>
</section>
