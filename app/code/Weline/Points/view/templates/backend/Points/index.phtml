<?php
$page = (string) ($this->getData('points_page') ?? 'overview');
$title = (string) ($this->getData('points_title') ?? __('积分与会员'));
$summary = (array) ($this->getData('points_summary') ?? []);
$datasets = (array) ($this->getData('points_datasets') ?? []);
$settingsUrl = (string) ($this->getData('points_settings_url') ?? 'weline_systemconfig/backend/config');
$escape = static fn (mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) {
        return $value ? (string) __('是') : (string) __('否');
    }
    if (is_array($value)) {
        return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    }

    return $escape($value);
};
?>
<section class="points-backend" data-testid="points-<?= $escape($page) ?>">
    <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="end">
        <div class="w-cluster" data-gap="2">
            <span class="w-badge bg-info text-dark"><?= __('万能积分') ?></span>
            <span class="w-badge bg-secondary text-white">Weline_Points</span>
        </div>
    </div>

    <?php if ($page === 'settings'): ?>
        <div class="w-card">
            <div class="w-card__header"><h5 style="--w-mb:0;"><?= __('积分设置') ?></h5></div>
            <div class="w-card__body">
                <div class="w-alert" data-tone="info"><?= __('赚分比例、成长值比例、商品默认值、抵扣上限与 VIP 开关在系统配置中维护。') ?></div>
                <a class="w-button" data-tone="primary" href="@backend-url{'weline_systemconfig/backend/config'|['area'=>'backend','search'=>'积分','guide_key'=>'points/discount/enabled,points/discount/max_ratio,payment/asset/points/enabled,payment/asset/points/exchange_ratio']}"><?= __('打开积分与会员配置') ?></a>
            </div>
        </div>
    <?php else: ?>
        <?php if ($summary !== []): ?>
            <div class="w-grid" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-4);">
                <?php foreach ($summary as $label => $count): ?>
                    <div class="w-card" style="--w-span-md:3;">
                        <div class="w-card__body">
                            <div class="w-text" data-tone="muted" data-size="sm"><?= $escape($label) ?></div>
                            <div class="w-text" data-weight="strong" data-size="xl"><?= $escape((string) $count) ?></div>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php foreach ($datasets as $dataset): ?>
            <div class="w-card" style="--w-mb:var(--weline-space-4);">
                <div class="w-card__header"><h5 style="--w-mb:0;"><?= $escape($dataset['label'] ?? '') ?></h5></div>
                <div class="w-card__body">
                    <?php if (!empty($dataset['error'])): ?>
                        <div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div>
                    <?php elseif (empty($dataset['rows'])): ?>
                        <div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div>
                    <?php else: ?>
                        <div class="w-table-wrap">
                            <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                                <thead>
                                <tr>
                                    <?php foreach (array_keys($dataset['rows'][0]) as $field): ?>
                                        <th><?= $escape($field) ?></th>
                                    <?php endforeach; ?>
                                </tr>
                                </thead>
                                <tbody>
                                <?php foreach ($dataset['rows'] as $row): ?>
                                    <tr>
                                        <?php foreach ($row as $value): ?>
                                            <td><?= $display($value) ?></td>
                                        <?php endforeach; ?>
                                    </tr>
                                <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>
</section>
