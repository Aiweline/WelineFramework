<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\Manager\ObjectManager;
use Weline\Compare\Service\ComparePagePresenter;
use Weline\Compare\Service\CompareSpecificationMatrix;

$view = ObjectManager::getInstance(ComparePagePresenter::class)->resolve($this);
$items = $view['items'];
$specRows = $view['specRows'];
$count = (int)$view['count'];
$max = (int)$view['max'];
$specMatrix = ObjectManager::getInstance(CompareSpecificationMatrix::class);
$esc = static fn (mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$labelHitClass = static fn (array $values): string => $specMatrix->labelIsHighlight($values) ? ' storefront-compare__label--hit' : '';
$cellHitClass = static fn (string $value, array $values): string => $specMatrix->cellIsHighlight($value, $values) ? ' storefront-compare__cell--hit' : '';
$specLabelClass = static fn (array $specRow): string => trim($specMatrix->specLabelHighlightClass($specRow));
$specCellClass = static fn (int $index, array $specRow): string => trim($specMatrix->specCellHighlightClass($index, $specRow));
?>
<div class="storefront-compare-layout">
<section class="storefront-compare" data-testid="storefront-compare-page" weline-code="compare.page.section_1">
    <header class="storefront-compare__header">
        <h1 class="storefront-compare__title"><?= __('商品对比') ?></h1>
        <p class="storefront-compare__meta"><?= $esc((string)__('已选 %{1} / %{2} 件', [$count, $max])) ?></p>
    </header>

    <?php if ($items === []): ?>
        <div class="storefront-compare__empty">
            <p><?= __('对比栏暂无商品') ?></p>
            <a class="storefront-compare__cta" href="/"><?= __('去逛逛') ?></a>
        </div>
    <?php else: ?>
        <?php
        $ratingValues = array_map(
            static fn (array $item): string => number_format((float)($item['rating'] ?? 0), 1) . ' (' . (int)($item['review_count'] ?? 0) . ')',
            $items
        );
        ?>
        <div class="storefront-compare__table-wrap" style="--compare-product-cols: <?= count($items) ?>">
            <table class="storefront-compare__table">
                <thead>
                    <tr>
                        <th scope="col"><?= __('属性') ?></th>
                        <?php foreach ($items as $item): ?>
                            <th scope="col">
                                <a href="<?= $esc((string)($item['url'] ?? '#')) ?>"><?= $esc((string)($item['name'] ?? '')) ?></a>
                            </th>
                        <?php endforeach; ?>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row"><?= __('图片') ?></th>
                        <?php foreach ($items as $item): ?>
                            <td>
                                <?php if (trim((string)($item['image'] ?? '')) !== ''): ?>
                                    <img src="<?= $esc((string)$item['image']) ?>" alt="" class="storefront-compare__thumb" loading="lazy">
                                <?php endif; ?>
                            </td>
                        <?php endforeach; ?>
                    </tr>
                    <tr class="storefront-compare__row">
                        <th scope="row"><?= __('价格') ?></th>
                        <?php foreach ($items as $index => $item): ?>
                            <td class="<?= $specMatrix->priceCellIsHighlight($index, $items) ? 'storefront-compare__cell--best-price' : '' ?>"><?= $esc((string)($item['formatted_price'] ?? '')) ?></td>
                        <?php endforeach; ?>
                    </tr>
                    <tr class="storefront-compare__row">
                        <th scope="row" class="<?= trim($labelHitClass($ratingValues)) ?>"><?= __('评分') ?></th>
                        <?php foreach ($items as $index => $item): ?>
                            <?php $ratingText = number_format((float)($item['rating'] ?? 0), 1) . ' (' . (int)($item['review_count'] ?? 0) . ')'; ?>
                            <td class="<?= trim($cellHitClass($ratingValues[$index] ?? '', $ratingValues)) ?>"><?= $esc($ratingText) ?></td>
                        <?php endforeach; ?>
                    </tr>
                    <tr class="storefront-compare__row">
                        <th scope="row"><?= __('SKU') ?></th>
                        <?php foreach ($items as $item): ?>
                            <td><?= $esc((string)($item['sku'] ?? '—')) ?></td>
                        <?php endforeach; ?>
                    </tr>
                    <?php if ($specRows !== []): ?>
                        <tr class="storefront-compare__section">
                            <th scope="row" colspan="<?= count($items) + 1 ?>"><?= __('规格参数') ?></th>
                        </tr>
                        <?php foreach ($specRows as $specRow): ?>
                            <?php $specValues = array_map(static fn ($value): string => trim((string)$value), (array)($specRow['values'] ?? [])); ?>
                            <tr class="storefront-compare__row">
                                <th scope="row" class="<?= $specLabelClass($specRow) ?>"><?= $esc((string)($specRow['label'] ?? '')) ?></th>
                                <?php foreach ($specValues as $index => $value): ?>
                                    <?php $display = $value !== '' ? $value : '—'; ?>
                                    <td class="<?= $specCellClass($index, $specRow) ?>"><?= $esc($display) ?></td>
                                <?php endforeach; ?>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                    <tr>
                        <th scope="row"><?= __('操作') ?></th>
                        <?php foreach ($items as $item): ?>
                            <td>
                                <button type="button"
                                        class="storefront-compare__remove"
                                        data-compare-remove
                                        data-product-id="<?= (int)($item['product_id'] ?? 0) ?>">
                                    <?= __('移除') ?>
                                </button>
                            </td>
                        <?php endforeach; ?>
                    </tr>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</section>
</div>

<style>
.storefront-compare-layout {
    box-sizing: border-box;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-block: var(--weline-space-2, 0.5rem) var(--weline-space-6, 1.5rem);
}
.storefront-compare {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--weline-layout-content-max-width, var(--weline-theme-container-max, 1400px));
    margin-inline: auto;
    padding-inline: var(--weline-layout-content-padding-inline, 1.5rem);
    min-width: 0;
    color: var(--weline-theme-body-text, #0f1111);
}
.storefront-compare__title { margin: 0 0 .5rem; font-size: 1.75rem; }
.storefront-compare__meta { margin: 0 0 1.5rem; color: #565959; }
.storefront-compare__empty {
    padding: 3rem 1.5rem;
    border: 1px dashed #e7e7e7;
    border-radius: 12px;
    text-align: center;
    background: #f8fafc;
}
.storefront-compare__cta {
    display: inline-block;
    margin-top: 1rem;
    padding: .5rem 1rem;
    border-radius: 8px;
    background: var(--weline-theme-primary, #ff9900);
    color: #111;
    text-decoration: none;
    font-weight: 600;
}
.storefront-compare__table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
}
.storefront-compare__table {
    width: max(100%, calc(var(--compare-label-col-width, 11rem) + (var(--compare-product-cols, 1) * var(--compare-product-col-width, 13rem))));
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: #fff;
    border: 1px solid #e7e7e7;
    border-radius: 12px;
    table-layout: fixed;
}
.storefront-compare__table th:first-child,
.storefront-compare__table td:first-child {
    width: var(--compare-label-col-width, 11rem);
    min-width: var(--compare-label-col-width, 11rem);
    max-width: var(--compare-label-col-width, 11rem);
    position: sticky;
    left: 0;
    z-index: 2;
    background: #fff;
    box-shadow: 1px 0 0 #f0f0f0;
}
.storefront-compare__table thead th:first-child {
    z-index: 3;
    background: #f8fafc;
}
.storefront-compare__table th:not(:first-child),
.storefront-compare__table td:not(:first-child) {
    min-width: var(--compare-product-col-width, 13rem);
    width: var(--compare-product-col-width, 13rem);
    scroll-snap-align: start;
}
.storefront-compare__table th,
.storefront-compare__table td {
    padding: .75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
    text-align: left;
    font-size: .875rem;
    word-break: break-word;
}
.storefront-compare__table thead th a {
    color: inherit;
    text-decoration: none;
}
.storefront-compare__table thead th a:hover {
    color: var(--weline-theme-primary, #ff9900);
    text-decoration: underline;
}
.storefront-compare__table thead th {
    background: #f8fafc;
    font-weight: 700;
}
.storefront-compare__section th {
    background: #eef2ff;
    color: #3730a3;
    font-size: .8125rem;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.storefront-compare__label--hit {
    color: var(--weline-theme-primary, #ff9900);
    font-weight: 700;
}
.storefront-compare__cell--hit {
    color: var(--weline-theme-primary, #ff9900);
    font-weight: 600;
}
.storefront-compare__cell--best-price {
    color: #b91c1c;
    font-weight: 700;
}
.storefront-compare__thumb {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 8px;
}
.storefront-compare__remove {
    border: 0;
    background: transparent;
    color: #007185;
    cursor: pointer;
    text-decoration: underline;
}
</style>

<script>
(function () {
    document.addEventListener('click', function (event) {
        var button = event.target && event.target.closest ? event.target.closest('[data-compare-remove]') : null;
        if (!button) return;
        event.preventDefault();
        var productId = Number(button.getAttribute('data-product-id') || 0);
        if (productId <= 0 || !window.Weline || !window.Weline.Api) return;
        window.Weline.Api.resource('compare').then(function (api) {
            return api.remove({ product_id: productId });
        }).then(function () {
            window.location.reload();
        });
    });
})();
</script>
