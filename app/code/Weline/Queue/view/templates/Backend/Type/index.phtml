<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$typeItems = is_array($types ?? null) ? $types : [];
$typePagination = is_array($pagination ?? null) ? $pagination : [];
$typePage = max(1, (int)($typePagination['page'] ?? 1));
$typePageSize = max(1, (int)($typePagination['pageSize'] ?? 10));
$typeLastPage = max(0, (int)($typePagination['lastPage'] ?? 0));
$typeTotalSize = max(0, (int)($typePagination['totalSize'] ?? count($typeItems)));
$typePageUrl = static fn(int $page): string => '?' . http_build_query([
    'q' => trim((string)($q ?? '')),
    'page' => max(1, $page),
    'pageSize' => $typePageSize,
]);
$config = [
    'messages' => [
        'enable' => (string)__('启用'),
        'disable' => (string)__('禁用'),
        'saved' => (string)__('队列类型状态已更新'),
        'networkError' => (string)__('网络错误，请检查网络后重试'),
    ],
];
$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE;
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-queue-admin.css)">

<main class="w-queue-type-admin w-stack" data-w-component="queue-type-admin" data-testid="queue-type-management">
    <header class="w-queue-type-admin__heading">
        <h1><w:icon name="settings" size="sm" /> <?= $escape($title ?? __('队列类型')) ?></h1>
    </header>

    <template>Weline_Component::message.phtml</template>

    <section class="w-card">
        <div class="w-card__body w-stack">
            <header class="w-stack" data-gap="sm">
                <h2 class="w-card__title"><lang>已注册的队列消费者</lang></h2>
                <p class="w-text" data-tone="muted"><lang>启用或禁用消费者类型；运行中的队列不受列表操作影响。</lang></p>
            </header>

            <form class="w-cluster" method="get" action="@backend-url('queue/backend/type')" data-wrap="true">
                <label class="w-field">
                    <span class="w-field__label"><lang>搜索类型</lang></span>
                    <input class="w-input" type="search" name="q" value="<?= $escape($q ?? '') ?>" maxlength="120" placeholder="<?= $escape(__('按名称或 ID 搜索')) ?>">
                </label>
                <button class="w-button" type="submit" data-tone="primary"><w:icon name="search" size="sm" /><lang>搜索</lang></button>
                <a class="w-button" href="@backend-url('queue/backend/type')" data-tone="neutral" data-variant="outline"><w:icon name="refresh" size="sm" /><lang>重置</lang></a>
            </form>

            <div class="w-table-wrap">
                <table class="w-table" data-w-vertical="middle">
                    <thead><tr><th><lang>ID</lang></th><th><lang>类型名称</lang></th><th><lang>所属模块</lang></th><th><lang>执行类</lang></th><th><lang>状态</lang></th><th><lang>更新时间</lang></th><th><lang>操作</lang></th></tr></thead>
                    <tbody>
                    <?php foreach ($typeItems as $type): ?>
                        <?php $enabled = (int)($type['enable'] ?? 0) === 1; ?>
                        <tr data-type-id="<?= (int)($type['type_id'] ?? 0) ?>">
                            <td><strong>#<?= (int)($type['type_id'] ?? 0) ?></strong></td>
                            <td><strong><?= $escape($type['name'] ?? '') ?></strong></td>
                            <td><span class="w-badge" data-tone="info"><w:icon name="puzzle" size="xs" /><?= $escape($type['module_name'] ?? '') ?></span></td>
                            <td><code class="w-queue-type-admin__class" title="<?= $escape($type['class'] ?? '') ?>"><?= $escape($type['class'] ?? '') ?></code></td>
                            <td><span class="w-badge" data-tone="<?= $enabled ? 'success' : 'danger' ?>"><?php if ($enabled): ?><w:icon name="check" size="xs" /><?php else: ?><w:icon name="close" size="xs" /><?php endif; ?><?= $escape($enabled ? __('启用') : __('禁用')) ?></span></td>
                            <td><span class="w-text" data-tone="muted" data-size="sm"><?= $escape($type['update_time'] ?? '') ?></span></td>
                            <td>
                                <div class="w-queue-type-admin__actions">
                                    <button type="button" class="w-button" data-w-queue-type-action="<?= $enabled ? 'disable' : 'enable' ?>" data-type-id="<?= (int)($type['type_id'] ?? 0) ?>" data-type-name="<?= $escape($type['name'] ?? '') ?>" data-tone="<?= $enabled ? 'warning' : 'success' ?>" data-variant="outline" data-size="sm"><w:icon name="switch" size="sm" /><?= $escape($enabled ? __('禁用') : __('启用')) ?></button>
                                    <button type="button" class="w-button" data-w-queue-type-action="view" data-type-id="<?= (int)($type['type_id'] ?? 0) ?>" data-tone="info" data-variant="outline" data-size="sm"><w:icon name="eye" size="sm" /><lang>详情</lang></button>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    <?php if ($typeItems === []): ?><tr><td colspan="7"><div class="w-empty w-queue-type-admin__empty"><w:icon name="box" size="lg" /><p><lang>暂无队列类型数据</lang></p></div></td></tr><?php endif; ?>
                    </tbody>
                </table>
            </div>

            <?php if ($typeLastPage > 1): ?>
                <nav class="w-queue-pagination" aria-label="<?= $escape(__('队列类型分页')) ?>">
                    <ul class="w-pagination">
                        <li class="w-pagination__item"><?php if ($typePage <= 1): ?><span class="w-pagination__link" aria-disabled="true"><lang>上一页</lang></span><?php else: ?><a class="w-pagination__link" href="<?= $escape($typePageUrl($typePage - 1)) ?>"><lang>上一页</lang></a><?php endif; ?></li>
                        <?php for ($pageNumber = max(1, $typePage - 2); $pageNumber <= min($typeLastPage, $typePage + 2); $pageNumber++): ?><li class="w-pagination__item"><a class="w-pagination__link" href="<?= $escape($typePageUrl($pageNumber)) ?>" <?= $pageNumber === $typePage ? 'aria-current="page"' : '' ?>><?= $pageNumber ?></a></li><?php endfor; ?>
                        <li class="w-pagination__item"><?php if ($typePage >= $typeLastPage): ?><span class="w-pagination__link" aria-disabled="true"><lang>下一页</lang></span><?php else: ?><a class="w-pagination__link" href="<?= $escape($typePageUrl($typePage + 1)) ?>"><lang>下一页</lang></a><?php endif; ?></li>
                    </ul>
                    <span class="w-queue-pagination__summary"><?= $escape(__('第 %{1} / %{2} 页，共 %{3} 条', [$typePage, $typeLastPage, $typeTotalSize])) ?></span>
                </nav>
            <?php endif; ?>
        </div>
    </section>

    <block class="Weline\Component\Block\OffCanvas"
           template="Weline_Component::off-canvas.phtml"
           title="查看详情"
           cache="0"
