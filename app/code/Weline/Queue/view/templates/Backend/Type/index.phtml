       direction='right'
       class-names='w-50'
       off-canvas-body-style=''
/>

<script>
(function() {
    'use strict';

    var queueText = <?= json_encode([
        'enable' => (string)__('启用'),
        'disable' => (string)__('禁用'),
        'networkError' => (string)__('网络错误，请检查网络后重试')
    ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var queueAdminPromise = null;

    async function getQueueAdmin() {
        if (!queueAdminPromise) {
            queueAdminPromise = (async function() {
                if (!window.Weline || typeof Weline.load !== 'function') {
                    throw new Error(queueText.networkError);
                }
                var api = await Weline.load('api');
                return api.resource('queue_admin');
            })().catch(function(error) {
                queueAdminPromise = null;
                throw error;
            });
        }
        return queueAdminPromise;
    }

    async function setTypeEnabled(typeId, enabled) {
        var api = await getQueueAdmin();
        if (!api || typeof api.setTypeEnabled !== 'function') {
            throw new Error(queueText.networkError);
        }
        return api.setTypeEnabled({ type_id: typeId, enabled: enabled }, {
            keepBusinessResult: true,
            silent: true
        });
    }

    function setButtonBusy(button, busy) {
        var icon = button ? button.querySelector('i') : null;
        if (!button) return;
        if (busy) {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
            if (icon) {
                button.dataset.queueOriginalIcon = icon.getAttribute('class') || '';
                icon.setAttribute('class', 'mdi mdi-loading');
            }
            return;
        }
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (icon && button.dataset.queueOriginalIcon) {
            icon.setAttribute('class', button.dataset.queueOriginalIcon);
            delete button.dataset.queueOriginalIcon;
        }
    }

    function openTypeOffcanvas(typeId) {
        var id = parseInt(String(typeId || ''), 10);
        var trigger = document.querySelector('.weline-queue-type-shared-view-trigger');
        if (!Number.isFinite(id) || id <= 0 || !trigger) {
            BackendToast.error(queueText.networkError);
            return;
        }
        var targetSelector = trigger.getAttribute('data-bs-target') || '';
        var panel = targetSelector ? document.querySelector(targetSelector) : null;
        var iframe = panel ? panel.querySelector('iframe[data-src]') : null;
        if (!panel || !iframe) {
            BackendToast.error(queueText.networkError);
            return;
        }
        var baseSrc = iframe.getAttribute('data-queue-type-base-src') || iframe.getAttribute('data-src') || '';
        if (!baseSrc) {
            BackendToast.error(queueText.networkError);
            return;
        }
        iframe.setAttribute('data-queue-type-base-src', baseSrc);
        var url = new URL(baseSrc, window.location.origin);
        url.searchParams.set('id', String(id));
        iframe.setAttribute('data-src', url.toString());
        iframe.removeAttribute('src');
        trigger.click();
    }

    async function handleTypeAction(button) {
        var action = button.getAttribute('data-action');
        var typeId = parseInt(button.getAttribute('data-id') || '0', 10);
        var typeName = button.getAttribute('data-name');
        var enabled = action === 'enable';
        var actionText = enabled ? queueText.enable : queueText.disable;

        if (!Number.isFinite(typeId) || typeId <= 0) {
            BackendToast.error(queueText.networkError);
            return;
        }

        var confirmed = false;
        try {
            confirmed = await BackendConfirm.show(actionText + ' · ' + String(typeName || typeId), {
                title: actionText,
                confirmText: actionText,
                type: enabled ? 'success' : 'warning'
            });
        } catch (error) {
            BackendToast.error(error && error.message ? error.message : queueText.networkError);
            return;
        }
        if (!confirmed) return;

        setButtonBusy(button, true);
        if (window.showLoading) showLoading();
        try {
            var result = await setTypeEnabled(typeId, enabled);
            if (result && result.success) {
                BackendToast.success(result.msg);
                setTimeout(function() {
                    window.location.reload();
                }, 600);
            } else {
                BackendToast.error((result && result.msg) || queueText.networkError);
            }
        } catch (error) {
            BackendToast.error(error && error.message ? error.message : queueText.networkError);
        } finally {
            setButtonBusy(button, false);
            if (window.hideLoading) hideLoading();
        }
    }
    
    function init() {
        document.querySelectorAll('[data-action="enable"], [data-action="disable"]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                handleTypeAction(this);
            });
        });
        document.querySelectorAll('.weline-queue-type-view-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                openTypeOffcanvas(this.getAttribute('data-id'));
            });
        });
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
