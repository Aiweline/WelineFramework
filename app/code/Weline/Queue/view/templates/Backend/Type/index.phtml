           target-hidden="1"
           target-class="w-queue-type-shared-view-trigger"
           flush="1"
           save="0"
           close-button-show="1"
           close-button-text="关闭"
           direction="right"
           drawer-size="md" />
</main>

<script type="application/json" data-w-queue-type-config><?= json_encode($config, $jsonFlags) ?: '{}' ?></script>
