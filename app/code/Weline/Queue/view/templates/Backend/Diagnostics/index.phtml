<?php
/** @var \Weline\Framework\View\Template $this */
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('队列诊断'));
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value): string {
    if ($value === null || $value === '') return '—';
    if (is_bool($value)) return (string)($value ? __('是') : __('否'));
    if (is_array($value) || is_object($value)) {
        $json = json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
        return is_string($json) ? $json : '—';
    }
    return (string)$value;
};
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-queue-admin.css)">

<main class="w-queue-diagnostics w-stack" data-testid="queue-<?= $escape($code) ?>-management">
    <header class="w-queue-admin__heading">
        <h1><w:icon name="database" size="sm" /> <?= $escape($title) ?></h1>
    </header>
    <div class="w-alert" role="status" data-tone="info"><w:icon name="info" size="sm" /><div class="w-alert__content"><?= $escape(__('此工作台仅显示脱敏运行事实，不执行消费、重试、删除或投递。')) ?></div></div>

    <?php foreach ($datasets as $dataset): ?>
        <?php
        if (!is_array($dataset)) continue;
        $rows = is_array($dataset['rows'] ?? null) ? $dataset['rows'] : [];
        $firstRow = is_array($rows[0] ?? null) ? $rows[0] : [];
        ?>
        <section class="w-card w-queue-diagnostics__dataset">
            <header class="w-card__header"><h2 class="w-card__title"><?= $escape($dataset['label'] ?? '') ?></h2></header>
            <div class="w-card__body">
                <?php if (!empty($dataset['error'])): ?>
                    <div class="w-alert" data-tone="warning"><w:icon name="warning" size="sm" /><div class="w-alert__content"><?= $escape($dataset['error']) ?></div></div>
                <?php elseif ($rows === []): ?>
                    <div class="w-empty"><w:icon name="database" size="lg" /><p><?= $escape(__('当前没有记录。')) ?></p></div>
                <?php else: ?>
                    <div class="w-table-wrap">
                        <table class="w-table">
                            <thead><tr><?php foreach (array_keys($firstRow) as $field): ?><th scope="col"><?= $escape($field) ?></th><?php endforeach; ?></tr></thead>
                            <tbody>
                            <?php foreach ($rows as $row): ?>
                                <?php if (!is_array($row)) continue; ?>
                                <tr><?php foreach (array_keys($firstRow) as $field): ?><td><span class="w-queue-diagnostics__value"><?= $escape($display($row[$field] ?? null)) ?></span></td><?php endforeach; ?></tr>
                            <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                <?php endif; ?>
            </div>
        </section>
    <?php endforeach; ?>
</main>
