<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('队列诊断'));
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static fn(mixed $value): string => is_bool($value) ? ($value ? (string)__('是') : (string)__('否')) : $escape($value);
?>
<section data-testid="queue-<?= $escape($code) ?>-management">
    <div class="page-title-box"><h4><?= $escape($title) ?></h4></div>
    <div class="alert alert-info" role="status"><?= __('此工作台仅显示脱敏运行事实，不执行消费、重试、删除或投递。') ?></div>
    <?php foreach ($datasets as $dataset): ?><div class="card mb-3"><div class="card-header"><?= $escape($dataset['label'] ?? '') ?></div><div class="card-body">
        <?php if (!empty($dataset['error'])): ?><div class="alert alert-warning mb-0"><?= $escape($dataset['error']) ?></div><?php elseif (empty($dataset['rows'])): ?><div class="text-muted"><?= __('当前没有记录。') ?></div><?php else: ?><div class="table-responsive"><table class="table table-sm"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody><?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
