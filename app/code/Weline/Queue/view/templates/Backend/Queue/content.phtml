<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$content = (string)($data ?? '');
$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE;
$config = ['messages' => [
    'copied' => (string)__('内容已复制到剪贴板'),
    'copyFailed' => (string)__('复制失败，请手动复制'),
]];
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-queue-admin.css)">

<main class="w-queue-content w-stack" data-w-component="queue-content" data-testid="queue-content-detail">
    <template>Weline_Component::message.phtml</template>
    <section class="w-card">
        <div class="w-card__body w-stack">
            <?php if ($content !== ''): ?>
                <pre class="w-queue-content__body" data-w-queue-content-body><?= $escape($content) ?></pre>
                <div class="w-queue-content__actions">
                    <button type="button" class="w-button" data-tone="primary" data-variant="outline" data-w-queue-copy-content>
                        <w:icon name="copy" size="sm" /> <?= $escape(__('复制内容')) ?>
                    </button>
                </div>
            <?php else: ?>
                <div class="w-empty"><w:icon name="minus" size="lg" /><p><?= $escape(__('暂无内容数据')) ?></p></div>
            <?php endif; ?>
        </div>
    </section>
</main>

<script type="application/json" data-w-queue-content-config><?= json_encode($config, $jsonFlags) ?: '{}' ?></script>
<script type="module" src="@static(Weline_Theme::ui/pages/weline-queue-content.js)"></script>
