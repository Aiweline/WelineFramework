<!-- 统计卡片 -->
<div class="w-grid weline-queue-stats">
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')" class="weline-queue-stat-card weline-queue-stat-all">
            <div class="weline-queue-stat-icon">
                <w:icon name="list" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['all'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>全部</lang></div>
            </div>
        </a>
    </div>
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')?status=pending" class="weline-queue-stat-card weline-queue-stat-pending">
            <div class="weline-queue-stat-icon">
                <w:icon name="clock" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['pending'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>等待中</lang></div>
            </div>
        </a>
    </div>
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')?status=running" class="weline-queue-stat-card weline-queue-stat-running">
            <div class="weline-queue-stat-icon">
                <w:icon name="play" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['running'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>运行中</lang></div>
            </div>
        </a>
    </div>
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')?status=done" class="weline-queue-stat-card weline-queue-stat-done">
            <div class="weline-queue-stat-icon">
                <w:icon name="check" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['done'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>已完成</lang></div>
            </div>
        </a>
    </div>
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')?status=error" class="weline-queue-stat-card weline-queue-stat-error">
            <div class="weline-queue-stat-icon">
                <w:icon name="warning" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['error'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>出错</lang></div>
            </div>
        </a>
    </div>
    <div style="--w-span-lg:2;--w-span-md:4;--w-span:6;">
        <a href="@backend-url('queue/backend/queue')?status=stop" class="weline-queue-stat-card weline-queue-stat-stop">
            <div class="weline-queue-stat-icon">
                <w:icon name="pause" size="sm"></w:icon>
            </div>
            <div class="weline-queue-stat-content">
                <div class="weline-queue-stat-number"><?= (int)($stats['stop'] ?? 0) ?></div>
                <div class="weline-queue-stat-label"><lang>已暂停</lang></div>
            </div>
        </a>
    </div>
</div>
