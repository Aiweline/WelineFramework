<script>
(function() {
    'use strict';

    var config = {
        pollIntervalMs: 10000,
        actionRefreshDelayMs: 600,
        text: {
            deleteConfirm: '<?= addslashes(__("确定要删除队列「%{1}」吗？此操作不可恢复。", ['__QUEUE_NAME__'])) ?>',
            stopConfirm: '<?= addslashes(__("确定要暂停此队列吗？")) ?>',
            continueConfirm: '<?= addslashes(__("确定要继续执行此队列吗？")) ?>',
            retryConfirm: '<?= addslashes(__("确定要重试此队列吗？")) ?>',
            resetConfirm: '<?= addslashes(__("确定要重新执行此队列吗？")) ?>',
            batchDeleteConfirm: '<?= addslashes(__("确定要删除选中的 %{1} 个队列吗？此操作不可恢复。", ['__QUEUE_COUNT__'])) ?>',
            batchStopConfirm: '<?= addslashes(__("确定要暂停选中的 %{1} 个队列吗？", ['__QUEUE_COUNT__'])) ?>',
            batchContinueConfirm: '<?= addslashes(__("确定要继续执行选中的 %{1} 个队列吗？", ['__QUEUE_COUNT__'])) ?>',
            selectRequired: '<?= addslashes(__("请至少选择一个队列")) ?>',
            networkError: '<?= addslashes(__("网络错误，请检查网络后重试")) ?>',
            apiUnavailable: '<?= addslashes(__("网络错误，请检查网络后重试")) ?>',
            resultCopied: '<?= addslashes(__("队列结果已复制到剪贴板")) ?>',
            resultCopyFailed: '<?= addslashes(__("复制失败，请手动复制")) ?>'
        }
    };
    var snapshotTimer = 0;
    var mutationRefreshTimer = 0;
    var snapshotInFlight = false;
    var snapshotRefreshPending = false;
    var snapshotMutationEpoch = 0;
    var lastSnapshotStatsHtml = '';
    var lastSnapshotListingHtml = '';
    var lastSnapshotRevision = '';
    var queueAdminPromise = null;

    async function getQueueAdmin() {
        if (!queueAdminPromise) {
            queueAdminPromise = (async function() {
                if (!window.Weline || typeof Weline.load !== 'function') {
                    throw new Error(config.text.apiUnavailable);
                }
                var api = await Weline.load('api');
                return api.resource('queue_admin');
            })().catch(function(error) {
                queueAdminPromise = null;
                throw error;
            });
        }
        return queueAdminPromise;
    }

    async function queueAdminCall(operation, params) {
        var api = await getQueueAdmin();
        if (!api || typeof api[operation] !== 'function') {
            throw new Error(config.text.apiUnavailable);
        }
        return api[operation](params || {}, { keepBusinessResult: true, silent: true });
    }

    function getSelectedIds() {
        var ids = [];
        document.querySelectorAll('.weline-queue-checkbox:checked').forEach(function(cb) {
            ids.push(cb.value);
        });
        return ids;
    }

    function restoreSelectedIds(ids) {
        if (!Array.isArray(ids) || ids.length === 0) {
            return;
        }
        document.querySelectorAll('.weline-queue-checkbox').forEach(function(cb) {
            cb.checked = ids.indexOf(String(cb.value || '')) !== -1;
        });
    }

    function updateBatchActionsVisibility() {
        var ids = getSelectedIds();
        var batchActions = document.querySelector('.weline-queue-batch-actions');
        var allCheckboxes = document.querySelectorAll('.weline-queue-checkbox');
        var selectAll = document.getElementById('weline-queue-select-all');
        if (batchActions) {
            if (ids.length > 0) {
                batchActions.classList.remove('d-none');
            } else {
                batchActions.classList.add('d-none');
            }
        }
        if (selectAll) {
            selectAll.checked = allCheckboxes.length > 0 && ids.length === allCheckboxes.length;
            selectAll.indeterminate = ids.length > 0 && ids.length < allCheckboxes.length;
        }
    }

    function shouldPauseSnapshotRefresh() {
        if (document.hidden) {
            return true;
        }
        return !!document.querySelector('.modal.show, .offcanvas.show');
    }

    function buildSnapshotParams() {
        var currentUrl = new URL(window.location.href);
        var params = {};
        ['module', 'status', 'q', 'biz_key'].forEach(function(key) {
            var value = currentUrl.searchParams.get(key);
            if (value !== null && value !== '') {
                params[key] = value;
            }
        });
        var page = parseInt(currentUrl.searchParams.get('page') || '1', 10);
        if (Number.isFinite(page) && page > 0) {
            params.page = page;
        }
        var queueId = parseInt(
            currentUrl.searchParams.get('queue_id') || currentUrl.searchParams.get('id') || '0',
            10
        );
        if (Number.isFinite(queueId) && queueId > 0) {
            params.queue_id = queueId;
        }
        if (lastSnapshotRevision) {
            params.known_revision = lastSnapshotRevision;
        }
        return params;
    }

    function cleanupManagedQueueResultModals() {
        document.querySelectorAll('.weline-queue-result-modal[data-live-managed="1"]').forEach(function(modal) {
            if (modal.parentElement) {
                modal.parentElement.removeChild(modal);
            }
        });
    }

    function sanitizeSnapshotHtml(html) {
        var template = document.createElement('template');
        template.innerHTML = String(html || '');

        template.content.querySelectorAll('script, style, iframe, object, embed, base, meta, link').forEach(function(node) {
            node.remove();
        });

        template.content.querySelectorAll('*').forEach(function(node) {
            Array.prototype.slice.call(node.attributes || []).forEach(function(attr) {
                var name = String(attr.name || '').toLowerCase();
                var compactValue = String(attr.value || '').replace(/[\u0000-\u001f\u007f\s]+/g, '').toLowerCase();

                if (
                    name.indexOf('on') === 0 ||
                    name === 'srcdoc' ||
                    name === 'style' ||
                    compactValue.indexOf('javascript:') === 0 ||
                    compactValue.indexOf('vbscript:') === 0 ||
                    compactValue.indexOf('data:text/html') === 0
                ) {
                    node.removeAttribute(attr.name);
                }
            });
        });

        return template.innerHTML;
    }

    function applySnapshot(payload) {
        var statsRegion = document.getElementById('weline-queue-stats-region');
        var listingRegion = document.getElementById('weline-queue-listing-region');
        var selectedIds = getSelectedIds();

        if (statsRegion && typeof payload.stats_html === 'string' && payload.stats_html !== lastSnapshotStatsHtml) {
            statsRegion.innerHTML = sanitizeSnapshotHtml(payload.stats_html);
            lastSnapshotStatsHtml = payload.stats_html;
        }
        if (listingRegion && typeof payload.listing_html === 'string' && payload.listing_html !== lastSnapshotListingHtml) {
            cleanupManagedQueueResultModals();
            listingRegion.innerHTML = sanitizeSnapshotHtml(payload.listing_html);
            lastSnapshotListingHtml = payload.listing_html;
        }

        restoreSelectedIds(selectedIds);
        updateBatchActionsVisibility();
        portalQueueResultModals();
    }

    async function refreshQueueSnapshot(options) {
        options = options || {};
        if (snapshotInFlight) {
            if (options.force) {
                snapshotRefreshPending = true;
            }
            return false;
        }
        if (!options.force && shouldPauseSnapshotRefresh()) {
            return false;
        }

        snapshotInFlight = true;
        var requestEpoch = snapshotMutationEpoch;
        var statsRegion = document.getElementById('weline-queue-stats-region');
        var listingRegion = document.getElementById('weline-queue-listing-region');
        if (statsRegion) statsRegion.setAttribute('aria-busy', 'true');
        if (listingRegion) listingRegion.setAttribute('aria-busy', 'true');
        try {
            var result = await queueAdminCall('snapshot', buildSnapshotParams());
            if (result && result.success) {
                if (requestEpoch !== snapshotMutationEpoch) {
                    snapshotRefreshPending = true;
                    return false;
                }
                if (result.changed !== false) {
                    applySnapshot(result);
                }
                if (typeof result.revision === 'string') {
                    lastSnapshotRevision = result.revision;
                }
                return true;
            }
            if (options.showError && typeof BackendToast !== 'undefined') {
                BackendToast.error((result && result.msg) || config.text.networkError);
            }
            return false;
        } catch (error) {
            if (options.showError && typeof BackendToast !== 'undefined') {
                BackendToast.error(config.text.networkError + (error && error.message ? ': ' + error.message : ''));
            }
            return false;
        } finally {
            snapshotInFlight = false;
            if (statsRegion) statsRegion.removeAttribute('aria-busy');
            if (listingRegion) listingRegion.removeAttribute('aria-busy');
            if (snapshotRefreshPending) {
                snapshotRefreshPending = false;
                window.setTimeout(function() {
                    refreshQueueSnapshot({ force: true });
                }, 0);
            }
        }
    }

    function requestQueueMutationRefresh(delayMs) {
        snapshotMutationEpoch += 1;
        lastSnapshotRevision = '';
        if (mutationRefreshTimer) {
            window.clearTimeout(mutationRefreshTimer);
        }
        mutationRefreshTimer = window.setTimeout(function() {
            refreshQueueSnapshot({ force: true, showError: true });
        }, typeof delayMs === 'number' ? delayMs : config.actionRefreshDelayMs);
    }

    function queueSnapshotRefresh(delayMs) {
        if (snapshotTimer) {
            window.clearTimeout(snapshotTimer);
        }
        snapshotTimer = window.setTimeout(function() {
            refreshQueueSnapshot().finally(function() {
                queueSnapshotRefresh(config.pollIntervalMs);
            });
        }, typeof delayMs === 'number' ? delayMs : config.pollIntervalMs);
    }

    function setButtonBusy(button, busy) {
        if (!button) {
            return;
        }
        var icon = button.querySelector('i');
        if (busy) {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
            if (icon && !button.dataset.queueOriginalIcon) {
                button.dataset.queueOriginalIcon = icon.getAttribute('class') || '';
                icon.setAttribute('class', 'mdi mdi-loading');
            }
            return;
        }
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (icon && button.dataset.queueOriginalIcon) {
            icon.setAttribute('class', button.dataset.queueOriginalIcon);
            delete button.dataset.queueOriginalIcon;
        }
    }

    function setBatchButtonsBusy(busy) {
        document.querySelectorAll('.weline-queue-batch-actions button').forEach(function(button) {
            setButtonBusy(button, busy);
        });
    }

    function openQueueOffcanvas(triggerSelector, queueId) {
        var id = parseInt(String(queueId || ''), 10);
        var trigger = document.querySelector(triggerSelector);
        if (!Number.isFinite(id) || id <= 0 || !trigger) {
            BackendToast.error(config.text.networkError);
            return;
        }
        var targetSelector = trigger.getAttribute('data-bs-target') || '';
        var panel = targetSelector ? document.querySelector(targetSelector) : null;
        var iframe = panel ? panel.querySelector('iframe[data-src]') : null;
        if (!panel || !iframe) {
            BackendToast.error(config.text.apiUnavailable);
            return;
        }
        var baseSrc = iframe.getAttribute('data-queue-base-src') || iframe.getAttribute('data-src') || '';
        if (!baseSrc) {
            BackendToast.error(config.text.apiUnavailable);
            return;
        }
        iframe.setAttribute('data-queue-base-src', baseSrc);
        var url = new URL(baseSrc, window.location.origin);
        url.searchParams.set('id', String(id));
        iframe.setAttribute('data-src', url.toString());
        iframe.removeAttribute('src');
        trigger.click();
    }

    function performAction(queueId, action, confirmMsg, sourceButton) {
        BackendConfirm.show(confirmMsg, {
            type: action === 'delete' ? 'danger' : 'warning'
        }).then(async function(confirmed) {
            if (!confirmed) return;
            var id = parseInt(String(queueId || ''), 10);
            if (!Number.isFinite(id) || id <= 0) {
                BackendToast.error(config.text.networkError);
                return;
            }
            setButtonBusy(sourceButton, true);
            try {
                var result = await queueAdminCall('action', { queue_id: id, action: action });
                if (result && result.success) {
                    BackendToast.success(result.msg);
                    requestQueueMutationRefresh(action === 'delete' ? 350 : config.actionRefreshDelayMs);
                } else {
                    BackendToast.error((result && result.msg) || config.text.networkError);
                }
            } catch (error) {
                BackendToast.error(config.text.networkError + (error && error.message ? ': ' + error.message : ''));
            } finally {
                setButtonBusy(sourceButton, false);
            }
        }).catch(function(error) {
            BackendToast.error(config.text.networkError + (error && error.message ? ': ' + error.message : ''));
        });
    }

    function performBatchAction(action, confirmMsg) {
        var ids = getSelectedIds();
        if (ids.length === 0) {
            BackendToast.warning(config.text.selectRequired);
            return;
        }

        var msg = confirmMsg.replace('__QUEUE_COUNT__', String(ids.length));

        BackendConfirm.show(msg, {
            type: action === 'delete' ? 'danger' : 'warning'
        }).then(async function(confirmed) {
            if (!confirmed) return;
            var queueIds = ids.map(function(id) {
                return parseInt(String(id || ''), 10);
            }).filter(function(id) {
                return Number.isFinite(id) && id > 0;
            });
            if (queueIds.length === 0) {
                BackendToast.warning(config.text.selectRequired);
                return;
            }
            BackendToast.info('<?= addslashes(__("正在执行批量操作...")) ?>');
            setBatchButtonsBusy(true);
            try {
                var result = await queueAdminCall('batchAction', { queue_ids: queueIds, action: action });
                if (result && result.partial) {
                    BackendToast.warning(result.msg || config.text.networkError);
                } else if (result && result.success) {
                    BackendToast.success(result.msg);
                } else {
                    BackendToast.error((result && result.msg) || config.text.networkError);
                }
                if (result && Number(result.success_count || 0) > 0) {
                    requestQueueMutationRefresh(config.actionRefreshDelayMs);
                }
            } catch (error) {
                BackendToast.error(config.text.networkError + (error && error.message ? ': ' + error.message : ''));
            } finally {
                setBatchButtonsBusy(false);
            }
        }).catch(function(error) {
            BackendToast.error(config.text.networkError + (error && error.message ? ': ' + error.message : ''));
        });
    }

    function copyQueueResult(modalId) {
        var modal = document.getElementById(modalId);
        var content = modal ? modal.querySelector('.weline-queue-result-modal-body') : null;
        if (!content) {
            return;
        }

        var text = content.innerText || content.textContent || '';
        var notifySuccess = function() {
            if (typeof BackendToast !== 'undefined') {
                BackendToast.success(config.text.resultCopied);
            }
        };
        var notifyError = function() {
            if (typeof BackendToast !== 'undefined') {
                BackendToast.error(config.text.resultCopyFailed);
            }
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(notifySuccess).catch(function() {
                fallbackCopyQueueResult(text, notifySuccess, notifyError);
            });
            return;
        }

        fallbackCopyQueueResult(text, notifySuccess, notifyError);
    }

    function fallbackCopyQueueResult(text, notifySuccess, notifyError) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', 'readonly');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        try {
            document.execCommand('copy') ? notifySuccess() : notifyError();
        } catch (e) {
            notifyError();
        }
        document.body.removeChild(textarea);
    }

    window.WelineQueueResultModal = {
        copy: copyQueueResult
    };

    function markQueueResultBackdrop() {
        document.querySelectorAll('.modal-backdrop').forEach(function(backdrop) {
            backdrop.classList.add('weline-queue-result-backdrop');
        });
    }

    function portalQueueResultModals() {
        document.querySelectorAll('.weline-queue-result-modal').forEach(function(modal) {
            modal.dataset.liveManaged = modal.dataset.liveManaged || '1';
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
            if (modal.dataset.portalBound === '1') {
                return;
            }
            modal.dataset.portalBound = '1';
            modal.addEventListener('show.bs.modal', function() {
                setTimeout(markQueueResultBackdrop, 0);
            });
            modal.addEventListener('shown.bs.modal', markQueueResultBackdrop);
            modal.addEventListener('hidden.bs.modal', function() {
                document.querySelectorAll('.modal-backdrop.weline-queue-result-backdrop').forEach(function(backdrop) {
                    if (!document.querySelector('.weline-queue-result-modal.show')) {
                        backdrop.classList.remove('weline-queue-result-backdrop');
                    }
                });
            });
        });
    }

    function initStaticActions() {
        document.addEventListener('change', function(event) {
            var target = event.target;
            if (!(target instanceof Element)) {
                return;
            }
            if (target.id === 'weline-queue-select-all') {
                var checked = !!target.checked;
                document.querySelectorAll('.weline-queue-checkbox').forEach(function(cb) {
                    cb.checked = checked;
                });
                updateBatchActionsVisibility();
                return;
            }
            if (target.classList.contains('weline-queue-checkbox')) {
                updateBatchActionsVisibility();
                return;
            }
            if (target.id === 'weline-queue-status-filter') {
                var status = String(target.value || '');
                var url = new URL(window.location.href);
                if (status) {
                    url.searchParams.set('status', status);
                } else {
                    url.searchParams.delete('status');
                }
                window.location.href = url.toString();
            }
        });

        document.addEventListener('click', function(event) {
            var target = event.target;
            if (!(target instanceof Element)) {
                return;
            }

            var copyResultBtn = target.closest('[data-queue-result-copy]');
            if (copyResultBtn) {
                event.preventDefault();
                copyQueueResult(copyResultBtn.dataset.queueResultModalId || '');
                return;
            }

            var showBtn = target.closest('.weline-queue-show-btn');
            if (showBtn) {
                event.preventDefault();
                openQueueOffcanvas('.weline-queue-shared-show-trigger', showBtn.dataset.queueId);
                return;
            }

            var editBtn = target.closest('.weline-queue-edit-btn');
            if (editBtn) {
                event.preventDefault();
                openQueueOffcanvas('.weline-queue-shared-edit-trigger', editBtn.dataset.queueId);
                return;
            }

            var deleteBtn = target.closest('.weline-queue-delete-btn');
            if (deleteBtn) {
                var queueId = deleteBtn.dataset.queueId;
                var queueName = deleteBtn.dataset.queueName || queueId;
                var deleteMsg = config.text.deleteConfirm.replace('__QUEUE_NAME__', queueName);
                performAction(queueId, 'delete', deleteMsg, deleteBtn);
                return;
            }

            var stopBtn = target.closest('.weline-queue-stop-btn');
            if (stopBtn) {
                performAction(stopBtn.dataset.queueId, 'stop', config.text.stopConfirm, stopBtn);
                return;
            }

            var continueBtn = target.closest('.weline-queue-continue-btn');
            if (continueBtn) {
                performAction(continueBtn.dataset.queueId, 'continue', config.text.continueConfirm, continueBtn);
                return;
            }

            var retryBtn = target.closest('.weline-queue-retry-btn');
            if (retryBtn) {
                performAction(retryBtn.dataset.queueId, 'retry', config.text.retryConfirm, retryBtn);
                return;
            }

            var resetBtn = target.closest('.weline-queue-reset-btn');
            if (resetBtn) {
                performAction(resetBtn.dataset.queueId, 'reset', config.text.resetConfirm, resetBtn);
                return;
            }

            var batchDelete = target.closest('#weline-queue-batch-delete');
            if (batchDelete) {
                performBatchAction('delete', config.text.batchDeleteConfirm);
                return;
            }

            var batchStop = target.closest('#weline-queue-batch-stop');
            if (batchStop) {
                performBatchAction('stop', config.text.batchStopConfirm);
                return;
            }

            var batchContinue = target.closest('#weline-queue-batch-continue');
            if (batchContinue) {
                performBatchAction('continue', config.text.batchContinueConfirm);
            }
        });
    }

    function init() {
        portalQueueResultModals();
        initStaticActions();
        updateBatchActionsVisibility();
        var statsRegion = document.getElementById('weline-queue-stats-region');
        var listingRegion = document.getElementById('weline-queue-listing-region');
        lastSnapshotStatsHtml = statsRegion ? statsRegion.innerHTML : '';
        lastSnapshotListingHtml = listingRegion ? listingRegion.innerHTML : '';
        queueSnapshotRefresh(config.pollIntervalMs);
        document.addEventListener('visibilitychange', function() {
            if (!document.hidden) {
                queueSnapshotRefresh(200);
            }
        });
        window.addEventListener('beforeunload', function() {
            if (snapshotTimer) {
                window.clearTimeout(snapshotTimer);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
