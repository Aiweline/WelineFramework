    function sanitizeAttributeHtml(html) {
        var template = document.createElement('template');
        template.innerHTML = String(html || '');
        template.content.querySelectorAll(
            'script, style, iframe, object, embed, link, meta, base'
        ).forEach(function(element) {
            element.remove();
        });
        template.content.querySelectorAll('*').forEach(function(element) {
            Array.prototype.slice.call(element.attributes || []).forEach(function(attribute) {
                var name = String(attribute.name || '').toLowerCase();
                var value = String(attribute.value || '');
                var compactValue = value.replace(/[\u0000-\u0020]+/g, '').toLowerCase();
                var isUrlAttribute = [
                    'href', 'src', 'xlink:href', 'action', 'formaction', 'poster', 'background'
