            if (!code) {
                return;
            }
            if (!groups.has(code)) {
                groups.set(code, []);
            }
            groups.get(code).push(element);
        });

        var attributes = [];
        var invalidElement = null;
        groups.forEach(function(elements, code) {
            if (invalidElement) {
                return;
            }
            var first = elements[0];
            var type = first && first.tagName === 'INPUT' ? String(first.type || '').toLowerCase() : '';
            var value;
            if (type === 'checkbox') {
                value = elements.filter(function(element) {
                    return element.checked;
                }).map(readAttributeValue);
            } else if (type === 'radio') {
                var selected = elements.find(function(element) {
                    return element.checked;
                });
                value = selected ? readAttributeValue(selected) : '';
            } else if (elements.length === 1) {
                value = readAttributeValue(first);
            } else {
                value = elements.map(readAttributeValue).filter(hasAttributeValue);
            }

            var required = elements.some(function(element) {
                return element.hasAttribute('required');
            });
            if (required && !hasAttributeValue(value)) {
                invalidElement = first;
                return;
            }
            attributes.push({
                name: String(first.getAttribute('title') || ''),
                code: code,
                value: value,
                value_alias: attributeValueAlias(elements, value)
            });
        });

        return {attributes: attributes, invalidElement: invalidElement};
    }

    function rememberAttributeDisabledState(element) {
        if (!element || element.dataset.queueOriginalDisabled !== undefined) {
            return;
        }
        element.dataset.queueOriginalDisabled = element.disabled ? '1' : '0';
    }

    function setAttributeAvailability(element, wrapper, available) {
        rememberAttributeDisabledState(element);
        wrapper.hidden = !available;
        wrapper.setAttribute('aria-hidden', available ? 'false' : 'true');
        element.disabled = !available || element.dataset.queueOriginalDisabled === '1';
    }

    function setDependenceLoading(element, wrapper, loading) {
        rememberAttributeDisabledState(element);
        if (loading) {
            wrapper.setAttribute('aria-busy', 'true');
            wrapper.setAttribute('aria-label', queueText.dependenceLoading);
            element.disabled = true;
            return;
        }
        wrapper.removeAttribute('aria-busy');
        wrapper.removeAttribute('aria-label');
        element.disabled = element.dataset.queueOriginalDisabled === '1';
    }

    function applyDependenceOptions(element, items) {
        var optionMap = items && typeof items === 'object' ? items : {};
        var keys = Object.keys(optionMap);
        if (element.tagName === 'SELECT') {
            var previous = readAttributeValue(element);
            var previousValues = Array.isArray(previous) ? previous.map(String) : [String(previous)];
            element.replaceChildren();
            keys.forEach(function(key) {
                var option = document.createElement('option');
                option.value = key;
                option.textContent = String(optionMap[key]);
                option.selected = previousValues.indexOf(String(key)) !== -1;
                element.appendChild(option);
            });
            return;
        }
        if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
            element.value = keys.map(function(key) {
                return String(optionMap[key]);
            }).join(',');
        }
    }

    function bindAttributeDependences(vm, root, items, dependenceGeneration) {
        items.forEach(function(item) {
            var dependenceCodes = Array.isArray(item && item.dependence) ? item.dependence : [];
            if (!item || !item.code || dependenceCodes.length === 0) {
                return;
            }
            var currentElement = findAttributeElement(root, item.code);
            if (!currentElement) {
                return;
            }
            var currentWrapper = currentElement.closest('.weline-queue-attribute-field');
            if (!currentWrapper) {
                return;
            }
            var dependenceElements = dependenceCodes.map(function(code) {
                return {code: code, element: findAttributeElement(root, code)};
            }).filter(function(entry) {
                return !!entry.element;
            });
            if (dependenceElements.length !== dependenceCodes.length) {
                setAttributeAvailability(currentElement, currentWrapper, false);
                vm.setDependenceUnresolved(item.code, true, dependenceGeneration);
                vm.registerDependenceRetry(item.code, function() {
                    notifyError(queueText.dependenceFailed);
                    return false;
                }, dependenceGeneration);
                return;
            }

            var requestVersion = 0;
            var lastDependenceCode = dependenceElements[0].code;
            var refresh = async function(changedDependenceCode) {
                if (dependenceGeneration !== vm.dependenceGeneration || !currentWrapper.isConnected) {
                    return;
                }
                var requestedDependence = dependenceElements.find(function(entry) {
                    return entry.code === changedDependenceCode;
                }) || dependenceElements[0];
                lastDependenceCode = requestedDependence.code;
                var emptyDependence = dependenceElements.some(function(entry) {
                    return entry.element.disabled || !hasAttributeValue(readAttributeValue(entry.element));
                });
                if (emptyDependence) {
                    requestVersion += 1;
                    vm.setDependenceUnresolved(item.code, false, dependenceGeneration);
                    setDependenceLoading(currentElement, currentWrapper, false);
                    setAttributeAvailability(currentElement, currentWrapper, false);
                    return;
                }

                var version = ++requestVersion;
                var applied = false;
                setAttributeAvailability(currentElement, currentWrapper, false);
                setDependenceLoading(currentElement, currentWrapper, true);
                vm.pendingDependenceRequests += 1;
                try {
                    var result = await queueAdminCall('resolveAttributeDependence', {
                        type_id: parseInt(String(vm.params.type_id), 10),
                        attribute: String(item.code),
                        dependence_attribute: String(requestedDependence.code),
                        dependence_value: readAttributeValue(requestedDependence.element),
                        attribute_value: readAttributeValue(currentElement)
                    });
                    if (dependenceGeneration !== vm.dependenceGeneration
                        || version !== requestVersion
                        || !currentWrapper.isConnected) {
                        return;
                    }
                    if (!result || !result.success) {
                        throw new Error(String((result && result.msg) || queueText.dependenceFailed));
                    }
                    applyDependenceOptions(currentElement, result.data);
                    vm.setDependenceUnresolved(item.code, false, dependenceGeneration);
                    applied = true;
                } catch (error) {
                    if (dependenceGeneration === vm.dependenceGeneration
                        && version === requestVersion) {
                        vm.setDependenceUnresolved(item.code, true, dependenceGeneration);
                        notifyError(error && error.message ? error.message : queueText.dependenceFailed);
                    }
                } finally {
                    if (dependenceGeneration === vm.dependenceGeneration) {
                        vm.pendingDependenceRequests = Math.max(0, vm.pendingDependenceRequests - 1);
                    }
                    if (dependenceGeneration === vm.dependenceGeneration
                        && version === requestVersion
                        && currentWrapper.isConnected) {
                        setDependenceLoading(currentElement, currentWrapper, false);
                        setAttributeAvailability(currentElement, currentWrapper, applied);
                    }
                }
            };

            vm.registerDependenceRetry(item.code, function() {
                return refresh(lastDependenceCode);
            }, dependenceGeneration);

            dependenceElements.forEach(function(entry) {
                var inputTimer = null;
                entry.element.addEventListener('input', function() {
                    window.clearTimeout(inputTimer);
                    inputTimer = window.setTimeout(function() {
                        refresh(entry.code);
                    }, 250);
                });
                entry.element.addEventListener('change', function() {
                    window.clearTimeout(inputTimer);
                    refresh(entry.code);
                });
            });
            refresh(dependenceElements[0].code);
        });
    }

    window.QueuePage = new Vue({
        el: '#QueuePage',
        data: {
            tip: '',
            dir: queueBoot.dir,
            module: queueBoot.module,
            params: queueBoot.params,
            activeName: queueBoot.active_name,
            QueueTypesSearchVal: '',
            queue_types: queueBoot.queue_types,
            typeAttributeParams: [],
            clickedParamsProcess: false,
            isSearchingTypes: false,
            isLoadingAttributes: false,
            isSubmitting: false,
            pendingDependenceRequests: 0,
            unresolvedDependenceCodes: [],
            dependenceRetryHandlers: {},
            dependenceGeneration: 0,
            attributeRequestVersion: 0
        },
        computed: {
            progressPercent: function() {
                var steps = ['progress-select-queueData', 'progress-params', 'progress-confirm'];
                var index = steps.indexOf(this.activeName);
                return index < 0 ? 0 : Math.round(((index + 1) / steps.length) * 100);
            },
            canSubmitQueue: function() {
                return this.activeName === 'progress-confirm'
                    && !this.isSubmitting
                    && !this.isLoadingAttributes
                    && this.clickedParamsProcess
                    && this.pendingDependenceRequests === 0
                    && this.unresolvedDependenceCodes.length === 0;
            }
        },
        mounted: function() {
            this.activeName = queueBoot.active_name;
            if (this.params.type_id) {
                this.renderSearchQueueTypeAttributes();
                for (var i = 0; i < this.queue_types.length; i++) {
                    if (this.queue_types[i].type_id == this.params.type_id) {
                        this.changeTypeTip(this.queue_types[i]);
                        break;
                    }
                }
            }
        },
        methods: {
            changeTypeTip: function(t) {
                this.tip = t && t.tip ? t.tip : '';
                this.clickedParamsProcess = false;
            },
            handleTypeSelection: function() {
                this.attributeRequestVersion += 1;
                this.invalidateDependenceState();
                this.isLoadingAttributes = false;
                this.typeAttributeParams = [];
                this.clickedParamsProcess = false;
                var queueParamsForm = document.getElementById('queueParamsForm');
                if (queueParamsForm) {
                    queueParamsForm.replaceChildren();
                }
                if (window.hideLoading) hideLoading();
                for (var i = 0; i < this.queue_types.length; i++) {
                    if (this.queue_types[i].type_id == this.params.type_id) {
                        this.changeTypeTip(this.queue_types[i]);
                        return;
                    }
                }
                this.tip = '';
                this.clickedParamsProcess = false;
            },
            submitQueue: async function() {
                if (!this.canSubmitQueue) {
                    return false;
                }
                if (!this.params.type_id) {
                    Weline.UI.dialog.request({
                        title: queueText.typeRequiredTitle,
                        message: queueText.typeRequiredText,
                        tone: 'warning',
                        confirmLabel: queueText.confirmText
                    });
                    return false;
                }
                var payload = {
                    type_id: parseInt(String(this.params.type_id), 10),
                    name: String(this.params.name || ''),
                    attributes: Array.isArray(this.params.attributes) ? this.params.attributes : []
                };
                var queueId = parseInt(String(this.params.queue_id || ''), 10);
                if (Number.isFinite(queueId) && queueId > 0) {
                    payload.queue_id = queueId;
                }
                if (this.params.biz_key) {
                    payload.biz_key = String(this.params.biz_key);
                }
                this.isSubmitting = true;
                var committed = false;
                if (window.showLoading) showLoading();
                try {
                    var res = await queueAdminCall('save', payload);
                    if (res && res.success) {
                        committed = true;
                        var savedQueueId = parseInt(String(res.queue_id || ''), 10);
                        if (Number.isFinite(savedQueueId) && savedQueueId > 0) {
                            this.params.queue_id = String(savedQueueId);
                        }
                        if (window.hideLoading) hideLoading();
                        await Weline.UI.dialog.request({
                            title: res.msg,
                            message: Array.isArray(res.warnings) ? res.warnings.join(' ') : '',
                            tone: 'success',
                            confirmLabel: queueText.confirmText,
                            dismissible: false,
                            dismissible: false
                        });
                        if (window.showLoading) showLoading();
                        window.parent.location.reload();
                        return true;
                    } else {
                        Weline.UI.dialog.request({
                            title: queueText.saveFailed,
                            message: String((res && res.msg) || queueText.apiUnavailable),
                            tone: 'danger',
                            confirmLabel: queueText.confirmText
                        });
                    }
                } catch (error) {
                    if (committed) {
                        if (window.showLoading) showLoading();
                        window.parent.location.reload();
                    } else {
                        notifyError(error && error.message ? error.message : queueText.apiUnavailable);
                    }
                } finally {
                    this.isSubmitting = committed;
                    if (!committed && window.hideLoading) hideLoading();
                }
            },
            renderSearchQueueTypes: debounce(async function() {
                this.isSearchingTypes = true;
                try {
                    var res = await queueAdminCall('searchTypes', {
                        q: String(this.QueueTypesSearchVal || ''),
                        module: String(this.module || ''),
                        dir: String(this.dir || '')
                    });
                    if (res && res.success) {
                        this.queue_types = Array.isArray(res.data) ? res.data : [];
                    } else {
                        notifyError((res && res.msg) || queueText.apiUnavailable);
                    }
                } catch (error) {
                    notifyError(error && error.message ? error.message : queueText.apiUnavailable);
                } finally {
                    this.isSearchingTypes = false;
                }
            }, 500),
            renderSearchQueueTypeAttributes: async function() {
                if (!this.params.type_id) {
                    return false;
                }
                var typeId = parseInt(String(this.params.type_id), 10);
                if (!Number.isFinite(typeId) || typeId <= 0) {
                    Weline.UI.dialog.request({
                        title: queueText.typeRequiredTitle,
                        message: queueText.typeRequiredText,
                        tone: 'warning',
                        confirmLabel: queueText.confirmText
                    });
                    return false;
                }
                var requestVersion = ++this.attributeRequestVersion;
                var dependenceGeneration = this.invalidateDependenceState();
                var params = { type_id: typeId };
                var queueId = parseInt(String(this.params.queue_id || ''), 10);
                if (Number.isFinite(queueId) && queueId > 0) {
                    params.queue_id = queueId;
                }
                this.isLoadingAttributes = true;
                this.clickedParamsProcess = false;
                if (window.showLoading) showLoading();
                try {
                    var res = await queueAdminCall('typeAttributes', params);
                    if (requestVersion !== this.attributeRequestVersion
                        || typeId !== parseInt(String(this.params.type_id || ''), 10)) {
                        return false;
                    }
                    if (!res || !res.success) {
                        this.clickedParamsProcess = false;
                        Weline.UI.dialog.request({
                            title: queueText.warningTitle,
                            message: String((res && res.msg) || queueText.apiUnavailable),
                            tone: 'danger',
                            confirmLabel: queueText.confirmText
                        });
                        return false;
                    }
                    var items = Array.isArray(res.data) ? res.data : [];
                    var queueParamsForm = document.getElementById('queueParamsForm');
                    if (!queueParamsForm) {
                        throw new Error(queueText.apiUnavailable);
                    }
                    queueParamsForm.replaceChildren();
                    items.forEach(function(item) {
                        var wrapper = document.createElement('div');
                        wrapper.className = 'weline-queue-attribute-field gap-2 col-lg-4 col-md-6 col-sm-12';
                        wrapper.appendChild(sanitizeAttributeHtml(item && item.html ? item.html : ''));
                        queueParamsForm.appendChild(wrapper);
                    });
                    if (items.length === 0) {
                        var empty = document.createElement('div');
                        empty.className = 'weline-queue-params-empty col-12';
                        var emptyIcon = document.createElement('i');
                        emptyIcon.className = 'mdi mdi-information-outline';
                        emptyIcon.setAttribute('aria-hidden', 'true');
                        var emptyText = document.createElement('p');
                        emptyText.className = 'mb-0';
                        emptyText.textContent = queueText.noAttributes;
                        empty.appendChild(emptyIcon);
                        empty.appendChild(emptyText);
                        queueParamsForm.appendChild(empty);
                    }
                    bindAttributeDependences(this, queueParamsForm, items, dependenceGeneration);
                    this.typeAttributeParams = items;
                    this.clickedParamsProcess = true;
                    return true;
                } catch (error) {
                    if (requestVersion === this.attributeRequestVersion
                        && typeId === parseInt(String(this.params.type_id || ''), 10)) {
                        this.clickedParamsProcess = false;
                        notifyError(error && error.message ? error.message : queueText.apiUnavailable);
                    }
                    return false;
                } finally {
                    if (requestVersion === this.attributeRequestVersion
                        && typeId === parseInt(String(this.params.type_id || ''), 10)) {
                        this.isLoadingAttributes = false;
                        if (window.hideLoading) hideLoading();
                    }
                }
            },
            findLabel: function(arr, id, key, name) {
                var label = '';
                arr.forEach(function(item) {
                    if (item[key] == id) {
                        label = item[name];
                    }
                });
                return label;
            },
            focusInvalidElement: function(element) {
                if (!element) {
                    return;
                }
                var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                element.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
                element.focus();
                element.style.border = '1px solid var(--backend-color-danger, #f46a6a)';
            },
            invalidateDependenceState: function() {
                this.dependenceGeneration += 1;
                this.pendingDependenceRequests = 0;
                this.unresolvedDependenceCodes = [];
                this.dependenceRetryHandlers = {};
                return this.dependenceGeneration;
            },
            setDependenceUnresolved: function(code, unresolved, generation) {
                if (generation !== this.dependenceGeneration) {
                    return;
                }
                var normalizedCode = String(code || '');
                if (!normalizedCode) {
                    return;
                }
                var codes = this.unresolvedDependenceCodes.slice();
                var index = codes.indexOf(normalizedCode);
                if (unresolved && index === -1) {
                    codes.push(normalizedCode);
                } else if (!unresolved && index !== -1) {
                    codes.splice(index, 1);
                }
                this.unresolvedDependenceCodes = codes;
            },
            registerDependenceRetry: function(code, handler, generation) {
                if (generation !== this.dependenceGeneration || typeof handler !== 'function') {
                    return;
                }
                var normalizedCode = String(code || '');
                if (!normalizedCode) {
                    return;
                }
                this.dependenceRetryHandlers[normalizedCode] = handler;
            },
            retryDependenceResolution: function() {
                if (this.isLoadingAttributes || this.pendingDependenceRequests > 0) {
                    return false;
                }
                var handlers = this.dependenceRetryHandlers;
                var started = false;
                this.unresolvedDependenceCodes.slice().forEach(function(code) {
                    if (typeof handlers[code] === 'function') {
                        started = true;
                        handlers[code]();
                    }
                });
                if (!started) {
                    notifyError(queueText.dependenceFailed);
                }
                return started;
            },
            changeNav: function(name, reload) {
                if (name !== 'progress-select-queueData' && !this.params.type_id) {
                    Weline.UI.dialog.request({
                        title: queueText.typeRequiredTitle,
                        message: queueText.typeRequiredText,
                        tone: 'warning',
                        confirmLabel: queueText.confirmText
                    });
                    this.activeName = 'progress-select-queueData';
                    return false;
                }
                if (name === 'progress-confirm'
                    && (this.isLoadingAttributes
                        || this.pendingDependenceRequests > 0
                        || this.unresolvedDependenceCodes.length > 0
                        || !this.clickedParamsProcess)) {
                    this.activeName = 'progress-params';
                    return false;
                }
                if (reload === undefined) reload = true;
                if (this.clickedParamsProcess) {
                    reload = false;
                }
                this.activeName = name;
                if (name === 'progress-params' && this.params.type_id !== '' && reload) {
                    this.renderSearchQueueTypeAttributes();
                }
                if (name === 'progress-confirm') {
                    if (!this.params.name) {
                        var queueName = document.getElementById('queueName');
                        this.changeNav('progress-params');
                        this.focusInvalidElement(queueName);
                        return false;
                    }
                    var queueParamsForm = document.getElementById('queueParamsForm');
                    if (!queueParamsForm) {
                        return false;
                    }
                    var collected = collectQueueAttributes(queueParamsForm);
                    if (collected.invalidElement) {
                        this.changeNav('progress-params', false);
                        this.focusInvalidElement(collected.invalidElement);
                        Weline.UI.dialog.request({
                            title: queueText.warningTitle,
                            message: queueText.requiredField.replace(
                                '%{1}',
                                collected.invalidElement.getAttribute('title') || ''
                            ),
                            tone: 'danger',
                            confirmLabel: queueText.confirmText
                        });
                        return false;
                    }
                    this.params.attributes = collected.attributes;
                }
                return true;
            }
        }
    });
})();
</script>
<w:scope url="@backend-url('system/user-data')" container-id="QueuePage" event="input change click"/>
