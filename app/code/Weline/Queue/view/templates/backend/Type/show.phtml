<?php
/**
 * Native Weline UI Queue type detail.
 *
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Queue\Model\Queue\Type $type
 */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$typeId = (int)$type->getData('type_id');
$name = (string)$type->getData('name');
$module = (string)$type->getData('module_name');
$class = (string)$type->getData('class');
$tip = trim((string)$type->getData('tip'));
$enabled = (int)$type->getData('enable') === 1;
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-queue-admin.css)">

<main class="w-queue-detail w-stack" data-testid="queue-type-detail">
    <template>Weline_Component::message.phtml</template>

    <section class="w-card">
        <div class="w-card__body w-stack">
            <header class="w-queue-detail__header">
                <span class="w-queue-detail__icon" data-tone="<?= $enabled ? 'success' : 'danger' ?>" aria-hidden="true">
                    <w:icon name="settings" size="lg" />
                </span>
                <div class="w-queue-detail__title">
                    <h1><?= $escape($name !== '' ? $name : __('未命名队列类型')) ?></h1>
                    <span class="w-text" data-tone="muted"><?= $escape(__('队列消费者类型详细信息')) ?></span>
                </div>
                <span class="w-badge" data-tone="<?= $enabled ? 'success' : 'danger' ?>">
                    <?php if ($enabled): ?><w:icon name="check" size="xs" /><?php else: ?><w:icon name="close" size="xs" /><?php endif; ?>
                    <?= $escape($enabled ? __('已启用') : __('已禁用')) ?>
                </span>
            </header>

            <section class="w-queue-detail__section" aria-labelledby="queue-type-basic-heading">
                <h2 class="w-queue-detail__section-title" id="queue-type-basic-heading">
                    <w:icon name="info" size="sm" /> <?= $escape(__('基本信息')) ?>
                </h2>
                <dl class="w-queue-detail__grid">
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="tag" size="xs" /><?= $escape(__('类型 ID')) ?></dt>
                        <dd class="w-queue-detail__value"><strong>#<?= $typeId ?></strong></dd>
                    </div>
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="puzzle" size="xs" /><?= $escape(__('所属模块')) ?></dt>
                        <dd class="w-queue-detail__value"><span class="w-badge" data-tone="info"><?= $escape($module !== '' ? $module : '—') ?></span></dd>
                    </div>
                    <div class="w-queue-detail__item" data-wide="true">
                        <dt class="w-queue-detail__label"><w:icon name="code" size="xs" /><?= $escape(__('执行类')) ?></dt>
                        <dd class="w-queue-detail__value"><code class="w-queue-detail__code"><?= $escape($class !== '' ? $class : '—') ?></code></dd>
                    </div>
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="calendar" size="xs" /><?= $escape(__('创建时间')) ?></dt>
                        <dd class="w-queue-detail__value"><?= $escape($type->getData('create_time') ?: '—') ?></dd>
                    </div>
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="refresh" size="xs" /><?= $escape(__('更新时间')) ?></dt>
                        <dd class="w-queue-detail__value"><?= $escape($type->getData('update_time') ?: '—') ?></dd>
                    </div>
                </dl>
            </section>

            <?php if ($tip !== ''): ?>
                <aside class="w-alert" data-tone="info">
                    <w:icon name="info" size="sm" />
                    <div class="w-alert__content">
                        <strong><?= $escape(__('执行注意事项')) ?></strong>
                        <p><?= $escape($tip) ?></p>
                    </div>
                </aside>
            <?php endif; ?>
        </div>
    </section>
</main>
