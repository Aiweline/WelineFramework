<?php
/**
 * Native Weline UI Queue detail.
 *
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Queue\Model\Queue $queue
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$iconRegistry = ObjectManager::getInstance(IconRegistry::class);
$displayValue = static function (mixed $value): string {
    if ($value === null || $value === '') return '—';
    if (is_bool($value)) return (string)($value ? __('是') : __('否'));
    if (is_array($value) || is_object($value)) {
        $json = json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
        return is_string($json) ? $json : '—';
    }
    return (string)$value;
};
$get = static fn(string $key, mixed $default = ''): mixed => $queue->getData($key) ?? $default;
$status = strtolower((string)$get('status', 'pending'));
$statusMeta = [
    'pending' => ['tone' => 'neutral', 'icon' => 'clock', 'label' => __('等待中')],
    'running' => ['tone' => 'info', 'icon' => 'play', 'label' => __('运行中')],
    'done' => ['tone' => 'success', 'icon' => 'check-circle', 'label' => __('已完成')],
    'error' => ['tone' => 'danger', 'icon' => 'warning', 'label' => __('错误')],
    'stop' => ['tone' => 'warning', 'icon' => 'pause', 'label' => __('已停止')],
][$status] ?? ['tone' => 'neutral', 'icon' => 'circle', 'label' => $status !== '' ? $status : __('未知')];
$queueId = (int)$get('queue_id', 0);
$name = (string)$get('name', '');
$typeName = (string)$get('t_name', '');
$typeClass = (string)$get('class', '');
$typeTip = trim((string)$get('tip', ''));
$result = (string)$get('result', '');
$attributes = is_array($queueAttributes ?? null) ? $queueAttributes : [];
$download = is_array($resultDownload ?? null) ? $resultDownload : null;
$basicItems = [
    ['label' => __('队列 ID'), 'icon' => 'tag', 'value' => '#' . $queueId],
    ['label' => __('业务键'), 'icon' => 'key', 'value' => $get('biz_key')],
    ['label' => __('进程 ID'), 'icon' => 'settings', 'value' => $get('pid') ?: '—'],
    ['label' => __('所属模块'), 'icon' => 'puzzle', 'value' => $get('module')],
    ['label' => __('开始时间'), 'icon' => 'play', 'value' => $get('start_at')],
    ['label' => __('结束时间'), 'icon' => 'stop', 'value' => $get('end_at')],
    ['label' => __('创建时间'), 'icon' => 'calendar', 'value' => $get('create_time')],
    ['label' => __('更新时间'), 'icon' => 'refresh', 'value' => $get('update_time')],
];
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-queue-admin.css)">

<main class="w-queue-detail w-stack" data-testid="queue-detail">
    <template>Weline_Component::message.phtml</template>

    <section class="w-card">
        <div class="w-card__body w-stack">
            <header class="w-queue-detail__header">
                <span class="w-queue-detail__icon" data-tone="<?= $escape($statusMeta['tone']) ?>" aria-hidden="true">
                    <?= $iconRegistry->render((string)$statusMeta['icon'], 'lg') ?>
                </span>
                <div class="w-queue-detail__title">
                    <h1><?= $escape($name !== '' ? $name : __('未命名队列')) ?></h1>
                    <span class="w-text" data-tone="muted"><?= $escape(__('队列 ID')) ?> #<?= $queueId ?> · <?= $escape(__('类型')) ?> <?= $escape($typeName !== '' ? $typeName : '—') ?></span>
                </div>
                <span class="w-badge" data-tone="<?= $escape($statusMeta['tone']) ?>">
                    <?= $iconRegistry->render((string)$statusMeta['icon'], 'xs') ?> <?= $escape($statusMeta['label']) ?>
                </span>
            </header>

            <section class="w-queue-detail__section" aria-labelledby="queue-basic-heading">
                <h2 class="w-queue-detail__section-title" id="queue-basic-heading"><w:icon name="info" size="sm" /><?= $escape(__('基本信息')) ?></h2>
                <dl class="w-queue-detail__grid">
                    <?php foreach ($basicItems as $item): ?>
                        <div class="w-queue-detail__item">
                            <dt class="w-queue-detail__label"><?= $iconRegistry->render((string)$item['icon'], 'xs') ?><?= $escape($item['label']) ?></dt>
                            <dd class="w-queue-detail__value"><?= $escape($displayValue($item['value'])) ?></dd>
                        </div>
                    <?php endforeach; ?>
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="check" size="xs" /><?= $escape(__('是否完成')) ?></dt>
                        <dd class="w-queue-detail__value"><span class="w-badge" data-tone="<?= (int)$get('finished', 0) === 1 ? 'success' : 'neutral' ?>"><?= $escape((int)$get('finished', 0) === 1 ? __('是') : __('否')) ?></span></dd>
                    </div>
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="bolt" size="xs" /><?= $escape(__('自动执行')) ?></dt>
                        <dd class="w-queue-detail__value"><span class="w-badge" data-tone="<?= (int)$get('auto', 0) === 1 ? 'success' : 'neutral' ?>"><?= $escape((int)$get('auto', 0) === 1 ? __('是') : __('否')) ?></span></dd>
                    </div>
                </dl>
            </section>

            <section class="w-queue-detail__section" aria-labelledby="queue-consumer-heading">
                <h2 class="w-queue-detail__section-title" id="queue-consumer-heading"><w:icon name="settings" size="sm" /><?= $escape(__('消费者信息')) ?></h2>
                <dl class="w-queue-detail__grid">
                    <div class="w-queue-detail__item">
                        <dt class="w-queue-detail__label"><w:icon name="tag" size="xs" /><?= $escape(__('类型名称')) ?></dt>
                        <dd class="w-queue-detail__value"><strong><?= $escape($typeName !== '' ? $typeName : '—') ?></strong></dd>
                    </div>
                    <div class="w-queue-detail__item" data-wide="true">
                        <dt class="w-queue-detail__label"><w:icon name="code" size="xs" /><?= $escape(__('执行类')) ?></dt>
                        <dd class="w-queue-detail__value"><code class="w-queue-detail__code"><?= $escape($typeClass !== '' ? $typeClass : '—') ?></code></dd>
                    </div>
                </dl>
                <?php if ($typeTip !== ''): ?><aside class="w-alert" data-tone="info"><w:icon name="info" size="sm" /><div class="w-alert__content"><strong><?= $escape(__('执行注意事项')) ?></strong><p><?= $escape($typeTip) ?></p></div></aside><?php endif; ?>
            </section>

            <?php if ($attributes !== []): ?>
                <section class="w-queue-detail__section" aria-labelledby="queue-attributes-heading">
                    <h2 class="w-queue-detail__section-title" id="queue-attributes-heading"><w:icon name="list" size="sm" /><?= $escape(__('队列参数')) ?></h2>
                    <dl class="w-queue-detail__attributes">
                        <?php foreach ($attributes as $attribute): ?>
                            <?php if (!is_array($attribute)) continue; ?>
                            <div class="w-queue-detail__attribute">
                                <dt class="w-queue-detail__label"><?= $escape($attribute['name'] ?? $attribute['code'] ?? __('参数')) ?><?php if (!empty($attribute['required'])): ?><span class="w-badge" data-tone="warning"><?= $escape(__('必填')) ?></span><?php endif; ?></dt>
                                <dd class="w-queue-detail__attribute-value"><?= $escape($displayValue($attribute['value'] ?? null)) ?></dd>
                            </div>
                        <?php endforeach; ?>
                    </dl>
                </section>
            <?php endif; ?>

            <section class="w-queue-detail__section" aria-labelledby="queue-result-heading">
                <h2 class="w-queue-detail__section-title" id="queue-result-heading"><w:icon name="terminal" size="sm" /><?= $escape(__('执行结果')) ?></h2>
                <?php if ($download !== null): ?>
                    <div class="w-alert" data-tone="info">
                        <w:icon name="download" size="sm" />
                        <div class="w-alert__content"><strong><?= $escape(__('结果文件较大')) ?></strong><p><?= $escape(__('当前结果约 %{1} MB，请下载后查看。', [$download['size_mb'] ?? 0])) ?></p></div>
                        <a class="w-button" data-tone="primary" href="<?= $escape($download['url'] ?? '') ?>"><w:icon name="download" size="sm" /><?= $escape(__('下载结果')) ?></a>
                    </div>
                <?php elseif ($result !== ''): ?>
                    <pre class="w-queue-detail__result"><?= $escape($result) ?></pre>
                <?php else: ?>
                    <div class="w-empty"><w:icon name="minus" size="lg" /><p><?= $escape(__('暂无执行结果')) ?></p></div>
                <?php endif; ?>
            </section>
        </div>
    </section>
</main>
