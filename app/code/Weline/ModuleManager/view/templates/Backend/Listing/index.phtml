<script>
(function () { 'use strict'; const messages = <?= json_encode([ 'title' => __('模块版本回滚'), 'loadingTargets' => __('正在读取可用目标版本...'), 'noTargets' => __('没有可用的精确版本制品，或当前状态不允许回滚'), 'selectTarget' => __('选择目标版本'), 'preflight' => __('生成只读预检计划'), 'cancel' => __('取消'), 'next' => __('继续预检'), 'cascade' => __('级联模块'), 'artifact' => __('代码制品'), 'schema' => __('Schema DDL'), 'scripts' => __('脚本迁移'), 'backup' => __('备份'), 'downtime' => __('预计停机'), 'seconds' => __('秒'), 'blockers' => __('阻断项'), 'warnings' => __('警告'), 'confirmHelp' => __('请分别输入根模块名和目标版本后启动'), 'modulePlaceholder' => __('输入根模块名'), 'versionPlaceholder' => __('输入目标版本'), 'execute' => __('确认并启动回滚'), 'confirmMismatch' => __('输入内容与计划不一致'), 'queued' => __('回滚任务已入队'), 'phase' => __('当前阶段'), 'status' => __('状态'), 'success' => __('模块代码与数据库已一致回滚'), 'recovered' => __('回滚失败，但已完成自动补偿'), 'manual' => __('自动补偿失败，系统保持维护状态'), 'recoveryCommand' => __('恢复命令'), 'error' => __('操作失败'), 'apiUnavailable' => __('后台业务 API 尚未加载'), 'close' => __('关闭'), ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>; function api() { if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') { return Promise.reject(new Error(messages.apiUnavailable)); } return Promise.resolve(window.Weline.Api.resource('moduleRollback')); } function errorMessage(error) { return error && error.message ? error.message : String(error || messages.error); } function appendTextRow(root, label, value) { const row = document.createElement('p'); const strong = document.createElement('strong'); strong.textContent = label + ': '; row.append(strong, document.createTextNode(String(value == null ? '' : value))); root.append(row); } function appendMessageList(root, title, items, tone) { if (!items.length) return; const alert = document.createElement('section'); alert.className = 'w-alert w-stack'; alert.dataset.tone = tone; const heading = document.createElement('strong'); heading.textContent = title; const list = document.createElement('ul'); items.forEach(function (text) { const item = document.createElement('li'); item.textContent = String(text || ''); list.append(item); }); alert.append(heading, list); root.append(alert); } function planContent(plan, includeConfirmation) { const items = Array.isArray(plan.cascade_modules) ? plan.cascade_modules : []; const blockers = Array.isArray(plan.blockers) ? plan.blockers : []; const warnings = Array.isArray(plan.warnings) ? plan.warnings : []; const content = document.createElement('div'); content.className = 'w-stack'; const heading = document.createElement('h3'); heading.textContent = messages.cascade; const list = document.createElement('ol'); items.forEach(function (item) { const artifact = item.artifact || {}; const row = document.createElement('li'); row.textContent = String(item.module_name || '') + ' ' + String(item.from_version || '') + ' → ' + String(item.to_version || '') + ' · ' + messages.artifact + ': ' + String(artifact.source || '-') + ' / ' + String(artifact.checksum || '').slice(0, 16) + ' · ' + messages.schema + ': ' + (item.schema_operations || []).length + ' · ' + messages.scripts + ': ' + (item.script_migrations || []).length; list.append(row); }); content.append(heading, list); appendTextRow(content, messages.backup, JSON.stringify(plan.backup_summary || {})); appendTextRow(content, messages.downtime, String(plan.estimated_downtime_seconds || 0) + ' ' + messages.seconds); appendMessageList(content, messages.blockers, blockers, 'danger'); appendMessageList(content, messages.warnings, warnings, 'warning'); if (includeConfirmation) { const help = document.createElement('p'); help.textContent = messages.confirmHelp; const moduleInput = document.createElement('input'); moduleInput.className = 'w-input'; moduleInput.placeholder = messages.modulePlaceholder; moduleInput.dataset.wRollbackConfirm = 'module'; const versionInput = document.createElement('input'); versionInput.className = 'w-input'; versionInput.placeholder = messages.versionPlaceholder; versionInput.dataset.wRollbackConfirm = 'version'; const validation = document.createElement('p'); validation.className = 'w-field__error'; validation.hidden = true; validation.dataset.wRollbackValidation = 'true'; content.append(help, moduleInput, versionInput, validation); } return content; } async function chooseTarget(moduleName) { const loading = Weline.UI.toast.info(messages.loadingTargets, {duration: 0}); const resource = await api(); let response; try { response = await resource.listTargets({module_name: moduleName}); } finally { loading.close(); } const items = Array.isArray(response.items) ? response.items : []; if (!items.length) { await Weline.UI.dialog.request({tone: 'info', title: messages.title, message: messages.noTargets}); return null; } const options = {}; items.forEach(function (item) { options[item.target_version] = item.target_version + ' (' + (item.source || '-') + ')' + (item.rollbackable ? '' : ' ⚠'); }); const selected = await Weline.UI.dialog.request({ tone: 'info', title: messages.selectTarget, cancelable: true, confirmLabel: messages.next, cancelLabel: messages.cancel, field: {type: 'select', choices: options, placeholder: messages.selectTarget, required: true}, validate: function (value) { return value ? true : messages.selectTarget; } }); return selected.confirmed ? selected.value : null; } async function confirmAndStart(resource, plan) { const blocked = Array.isArray(plan.blockers) && plan.blockers.length > 0; const content = planContent(plan, !blocked); const result = await Weline.UI.dialog.request({ tone: blocked ? 'danger' : 'warning', title: messages.preflight, message: content, size: 'lg', cancelable: !blocked, confirmLabel: blocked ? messages.close : messages.execute, cancelLabel: messages.cancel, beforeConfirm: function () { if (blocked) return true; const moduleValue = content.querySelector('[data-w-rollback-confirm="module"]').value.trim(); const versionValue = content.querySelector('[data-w-rollback-confirm="version"]').value.tri