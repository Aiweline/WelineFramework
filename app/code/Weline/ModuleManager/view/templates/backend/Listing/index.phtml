<css>Weline_ModuleManager::css/backend/module-manager-pages.css</css>  <div class="module-manager-page"> <div class="w-grid"> <div style="--w-span:12;"> <p class="w-text" data-tone="muted" style="--w-mb:0;"><?= __('集中检索模块状态、版本与 Schema 一致性') ?></p> </div> </div> <div class="w-grid"> <div style="--w-span:12;"> <div class="w-card"> <div class="w-card__body"> <div class="module-manager-header w-cluster" data-wrap="true" data-align="start" data-justify="between" style="--w-mb:var(--weline-space-4);"> <div> <h4 class="w-card__title" style="--w-mb:var(--weline-space-1);"><?= __('模组控制器') ?></h4> <p class="w-text" data-tone="muted" style="--w-mb:0;"> <?= __('显示 %{1}–%{2}，共 %{3} 个模块', [$rangeStart, $rangeEnd, $total]) ?> </p> </div> <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);"> <?php if ($activeFilterCount > 0): ?> <span class="w-badge w-text" data-w-background="info" data-tone="info"> <?= __('已启用 %{1} 个筛选条件', $activeFilterCount) ?> </span> <?php endif; ?> <span class="w-badge w-text" data-w-background="primary" data-tone="primary"> <?= __('当前页 %{1} 项', $visibleCount) ?> </span> </div> </div> <w:form method="get" id="module-manager-filters" class="module-filter-panel" style="--w-mb:var(--weline-space-4);"> <div class="module-filter-grid"> <div class="module-filter-field"> <label for="module-filter-search"><?= __('搜索模块') ?></label> <div class="module-search-control"> <w:icon name="search" size="sm"></w:icon> <input type="search" id="module-filter-search" name="search" class="w-input" value="<?= $escapeHtml($search) ?>" placeholder="<?= __('模块名、描述、命名空间、路由或版本') ?>" autocomplete="off"> </div> </div> <div class="module-filter-field"> <label for="module-filter-status"><?= __('运行状态') ?></label> <select id="module-filter-status" name="status" class="w-select" data-module-filter-auto> <option value=""><?= __('全部状态') ?></option> <option value="1" <?= $status === '1' ? 'selected' : '' ?>><?= __('已启用') ?></option> <option value="0" <?= $status === '0' ? 'selected' : '' ?>><?= __('已禁用') ?></option> </select> </div> <div class="module-filter-field"> <label for="module-filter-position"><?= __('模块类型') ?></label> <select id="module-filter-position" name="position" class="w-select" data-module-filter-auto> <option value=""><?= __('全部类型') ?></option> <?php foreach ($positionLabels as $positionValue => $positionLabel): ?> <option value="<?= $escapeHtml($positionValue) ?>" <?= $position === $positionValue ? 'selected' : '' ?>> <?= $escapeHtml($positionLabel) ?> </option> <?php endforeach; ?> </select> </div> <div class="module-filter-field"> <label for="module-filter-schema"><?= __('Schema 状态') ?></label> <select id="module-filter-schema" name="schema_status" class="w-select" data-module-filter-auto> <option value=""><?= __('全部 Schema 状态') ?></option> <?php foreach ($schemaStatusLabels as $schemaValue => $schemaLabel): ?> <option value="<?= $escapeHtml($schemaValue) ?>" <?= $schemaStatus === $schemaValue ? 'selected' : '' ?>> <?= $escapeHtml($schemaLabel) ?> </option> <?php endforeach; ?> </select> </div> <div class="module-filter-field"> <label for="module-filter-page-size"><?= __('每页显示') ?></label> <select id="module-filter-page-size" name="pageSize" class="w-select" data-module-filter-auto> <?php foreach ($pageSizes as $size): ?> <option value="<?= (int) $size ?>" <?= $pageSize === (int) $size ? 'selected' : '' ?>> <?= __('%{1} 项', (int) $size) ?> </option> <?php endforeach; ?> </select> </div> <div class="module-filter-actions w-cluster" style="--w-gap:var(--weline-space-2);"> <button type="submit" class="w-button" data-tone="primary"> <w:icon name="filter" size="sm"></w:icon><?= __('筛选') ?> </button> <a href="@backend-url('*/backend/listing')" class="w-button" data-tone="neutral" data-variant="outline"> <w:icon name="refresh" size="sm"></w:icon><?= __('重置') ?> </a> </div> </div> </w:form> <div class="module-result-bar w-cluster" data-wrap="true" data-align="center" data-justify="between" style="--w-mb:var(--weline-space-2);"> <small class="w-text" data-tone="muted"> <w:icon name="info" size="sm"></w:icon> <?= __('筛选会在全部模块中执行，分页会保留当前条件') ?> </small> <?php if ($activeFilterCount > 0): ?> <a href="@backend-url('*/backend/listing')" class="w-text" data-size="sm"> <?= __('清除全部筛选') ?> </a> <?php endif; ?> </div> <div class="w-table-wrap"> <table class="w-table module-manager-table" data-w-sticky-end data-w-vertical="middle" style="--w-mb:0;"> <thead> <tr> <th><?= __('模块') ?></th> <th><?= __('状态') ?></th> <th><?= __('类型') ?></th> <th><?= __('版本') ?></th> <th><?= __('Schema') ?></th> <th><?= __('路由') ?></th> <th><?= __('更新时间') ?></th> <th class="module-actions-cell" data-w-sticky="end"><?= __('操作') ?></th> </tr> </thead> <tbody> <?php if ($modules === []): ?> <tr> <td colspan="8"> <div class="module-empty-state w-text" data-align="center"> <w:icon name="close" size="sm"></w:icon> <h5 style="--w-mt:var(--weline-space-4);--w-mb:var(--weline-space-1);"><?= __('没有找到匹配的模块') ?></h5> <p class="w-text" data-tone="muted" style="--w-mb:var(--weline-space-4);"><?= __('请调整搜索词或筛选条件后重试') ?></p> <?php if ($activeFilterCount > 0): ?> <a href="@backend-url('*/backend/listing')" class="w-button" data-tone="primary" data-variant="outline" data-size="sm"> <?= __('清除筛选') ?> </a> <?php endif; ?> </div> </td> </tr> <?php else: ?> <?php foreach ($modules as $module): ?> <?php $moduleName = (string) $module->getName(); $modulePosition = (string) $module->getPosition(); $moduleEnabled = (bool) $module->getStatus(); $description = trim(html_entity_decode((string) $module->getDescription(), ENT_QUOTES | ENT_HTML5, 'UTF-8')); $namespacePath = (string) $module->getNamespacePath(); $basePath = (string) $module->getBasePath(); $schemaValue = (string) $module->getSchemaStatus() ?: 'unknown'; $schemaLabel = $schemaStatusLabels[$schemaValue] ?? $schemaValue; $schemaClass = match ($schemaValue) { 'consistent' => 'bg-success-subtle w-text', 'drifted' => 'bg-danger-subtle text-danger', 'unverified' => 'bg-warning-subtle w-text', default => 'bg-secondary-subtle text-secondary', }; $positionClass = match ($modulePosition) { 'system' => 'bg-danger-subtle text-danger', 'system_config' => 'bg-info-subtle text-info', 'composer' => 'bg-primary-subtle text-primary', default => 'bg-secondary-subtle text-secondary', }; $driftWarning = trim((string) $module->getDriftWarning());  ?> <tr> <td> <div class="module-identity"> <div class="w-cluster" data-wrap="true" data-align="center" style="--w-gap:var(--weline-space-2);"> <strong><?= $escapeHtml($moduleName) ?></strong> <span class="w-badge w-text" data-w-background="muted" data-tone="muted">#<?= (int) $module->getId() ?></span> </div> <div class="module-description"> <?= $escapeHtml($description !== '' ? $description : __('暂无描述')) ?> </div> <?php if ($namespacePath !== ''): ?> <span class="module-path" title="<?= $escapeHtml($namespacePath) ?>"> <w:icon name="code" size="sm"></w:icon><?= $escapeHtml($namespacePath) ?> </span> <?php endif; ?> <?php if ($basePath !== ''): ?> <span class="module-path" title="<?= $escapeHtml($basePath) ?>"> <w:icon name="folder" size="sm"></w:icon><?= $escapeHtml($basePath) ?> </span> <?php endif; ?> </div> </td> <td> <span class="w-badge <?= $moduleEnabled ? 'bg-success-subtle w-text' : 'bg-secondary-subtle text-secondary' ?>"> <i class="mdi <?= $moduleEnabled ? 'check' : 'pause' ?> me-1" aria-hidden="true"></i> <?= $moduleEnabled ? __('启用') : __('禁用') ?> </span> </td> <td> <span class="w-badge <?= $positionClass ?>"> <?= $escapeHtml($positionLabels[$modulePosition] ?? $modulePosition ?: __('未知')) ?> </span> </td> <td> <div class="module-versions"> <div class="module-version-row"> <small><?= __('当前') ?></small> <code><?= $escapeHtml($module->getVersion() ?: '-') ?></code> </div> <div class="module-version-row"> <small><?= __('代码') ?></small> <code><?= $escapeHtml($module->getCodeVersion() ?: '-') ?></code> </div> <div class="module-version-row"> <small><?= __('数据库') ?></small> <code><?= $escapeHtml($module->getDatabaseVersion() ?: '-') ?></code> </div> </div> </td> <td> <span class="w-badge <?= $schemaClass ?>"><?= $escapeHtml($schemaLabel) ?></span> <?php if ($driftWarning !== ''): ?> <div class="module-warning" title="<?= $escapeHtml($driftWarning) ?>"> <w:icon name="warning" size="sm"></w:icon><?= $escapeHtml($driftWarning) ?> </div> <?php endif; ?> </td> <td> <code class="module-router"><?= $escapeHtml($module->getRouter() ?: '-') ?></code> </td> <td> <small class="w-text" data-tone="muted"><?= $escapeHtml($module->getUpdateTime() ?: '-') ?></small> </td> <td class="module-actions-cell" data-w-sticky="end"> <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);"> <div title="<?= $moduleEnabled ? __('点击禁用模块') : __('点击启用模块') ?>"> <input class="w-switch" type="checkbox" alt="<?= $moduleEnabled ? __('开启') : __('关闭') ?>" id="<?= $escapeHtml($moduleName) ?>" switch="bool" <?= $moduleEnabled ? 'checked' : '' ?> <?= $modulePosition === 'system' ? 'disabled' : '' ?>> <label class="w-field__label" for="<?= $escapeHtml($moduleName) ?>" data-on-label="<?= __('开启') ?>" data-off-label="<?= __('关闭') ?>"></label> </div>  </div> </td> </tr> <?php endforeach; ?> <?php endif; ?> </tbody> </table> </div> </div> <?php if ($total > $visibleCount || $page > 1): ?> <div class="w-card__footer w-cluster" data-wrap="true" data-align="center" data-justify="between" style="--w-gap:var(--weline-space-2);"> <small class="w-text" data-tone="muted"> <?= __('第 %{1} 页，每页 %{2} 项', [$page, $pageSize]) ?> </small> <div><var>pagination</var></div> </div> <?php endif; ?> </div> </div> </div>
</div> <script>
