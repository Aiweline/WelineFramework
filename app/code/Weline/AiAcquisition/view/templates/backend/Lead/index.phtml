<script>
(function () {
    'use strict';
    var continents = <?= json_encode($continents, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]' ?>;
    var statuses = <?= json_encode($statuses, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var sourcePlatforms = <?= json_encode($sourcePlatforms, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var tagLabels = <?= json_encode(\Weline\AiAcquisition\Service\Tag\TagCatalog::allLabels(), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var websites = <?= json_encode($websites, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]' ?>;
    var entryChannelLabels = <?= json_encode($entryChannelLabels ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var runUrl = (document.getElementById('acq-run-url') || {}).href || '#';
    var leadMailUrl = (document.getElementById('acq-lead-mail-url') || {}).href || '';
    var leadConvertUrl = (document.getElementById('acq-lead-convert-url') || {}).href || '';
    var state = { items: [], page: 1, pageSize: 20, total: 0, lastPage: 1, selected: {} };

    function op(operation, data) {
        var run = function (api) {
            var resource = api.resource('ai_acquisition');
            if (!resource || typeof resource[operation] !== 'function') {
                return Promise.reject(new Error('AI 获客接口不可用，请刷新页面。'));
            }
            return resource[operation](data || {}).then(function (res) {
                return res && Object.prototype.hasOwnProperty.call(res, 'data') ? res.data : res;
            });
        };
        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(run);
        }
        if (window.Weline && window.Weline.Api) {
            return Promise.resolve(run(window.Weline.Api));
        }
        return Promise.reject(new Error('Weline.Api 不可用，请刷新页面。'));
    }

    function errorText(error, fallback) {
        var data = error && error.response && error.response.data ? error.response.data : null;
        return (data && (data.message || data.msg)) || (error && error.message) || fallback;
    }

    function byId(id) { return document.getElementById(id); }
    function value(id) { var el = byId(id); return el ? String(el.value || '').trim() : ''; }
    function setText(id, text) { var el = byId(id); if (el) { el.textContent = text == null ? '' : String(text); } }
    function escapeHtml(text) {
        return String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function statusLabel(code) { return statuses[code] || code || '-'; }
    var sourcePlatformFallback = { ddg_web: '网页搜索', bing: 'Bing 搜索', duckduckgo: 'DuckDuckGo', reddit: 'Reddit', linkedin: 'LinkedIn', facebook: 'Facebook', forum: '论坛/社区', directory: '目录/名录', marketplace: '电商平台', manual: '手动录入', ai_select: 'AI 选择录入', skill: '获客技能录入', web: '网页搜索' };
    function platformLabel(code) { return sourcePlatforms[code] || sourcePlatformFallback[code] || code || '来源'; }
    var entryChannelTone = { browser_model: 'info', ai_select: 'primary', skill: 'success' };
    function entryChannelBadge(code) {
        if (!code || code === 'default') { return ''; }
        var label = entryChannelLabels[code] || code;
        return '<span class="acq-entry acq-entry--' + escapeHtml(code) + '" data-entry="' + escapeHtml(code) + '">' + escapeHtml(label) + '</span>';
    }
    function tagLabel(tag) { return tagLabels[tag] || tag; }
    function leadTagsHtml(tags) {
        var list = Array.isArray(tags) ? tags : (function () {
            try { var d = JSON.parse(tags || '[]'); return Array.isArray(d) ? d : []; } catch (e) { return []; }
        })();
        if (!list.length) { return ''; }
        return '<div class="acq-lead-tags">' + list.slice(0, 3).map(function (tag) {
            return '<span class="acq-tag" data-tag="' + escapeHtml(tag) + '">' + escapeHtml(tagLabel(tag)) + '</span>';
        }).join('') + (list.length > 3 ? '<span class="acq-tag acq-tag--more">+' + (list.length - 3) + '</span>' : '') + '</div>';
    }
    function websiteName(websiteId) {
        for (var i = 0; i < websites.length; i += 1) {
            if (String(websites[i].website_id || '') === String(websiteId || '')) { return websites[i].name || ''; }
        }
        return '';
    }
    function continentLabel(code) {
        for (var i = 0; i < continents.length; i += 1) {
            if (String(continents[i].code || '') === String(code || '')) { return continents[i].name_zh || code; }
        }
        return code || '未知';
    }
    function statusTone(code) {
        if (code === 'converted' || code === 'qualified') { return 'success'; }
        if (code === 'rejected') { return 'danger'; }
        if (code === 'contacted' || code === 'replied') { return 'info'; }
        return 'warning';
    }
    function convertible(status) {
        // converted 也显示按钮：后端幂等（already_converted 只关联不重建），语义变为查看/补关联既有客户
        return status === 'replied' || status === 'qualified' || status === 'contacted' || status === 'converted';
    }
    function scoreTone(score) {
        if (score >= 8) { return 'success'; }
        if (score >= 6) { return 'warning'; }
        return 'danger';
    }
    function initials(name) {
        var text = String(name || '').trim();
        if (!text) { return '?'; }
        if (/^[\u4e00-\u9fff]/.test(text)) { return text.slice(0, 2); }
        var parts = text.split(/\s+/).filter(Boolean);
        return (parts[0] ? parts[0][0] : '') + (parts.length > 1 ? parts[1][0] : '');
    }
    function icon(name) {
        if (name === 'edit') {
            return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>';
        }
        if (name === 'trash') {
            return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/><path d="M10 11v5M14 11v5"/></svg>';
        }
        if (name === 'mail') {
            return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>';
        }
        if (name === 'convert') {
            return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="3"/><path d="M4 20c.6-4 2.9-6 6-6 1.4 0 2.6.4 3.6 1.1"/><path d="M17 14v6M14 17h6"/></svg>';
        }
        return '';
    }

    function filters() {
        var result = {
            keyword: value('filter-keyword'),
            website_id: value('filter-website'),
            continent: value('filter-continent'),
            status: value('filter-status'),
            source_platform: value('filter-source'),
            entry_channel: value('filter-entry'),
            min_score: value('filter-min-score'),
            tag: value('filter-tag'),
            page: state.page,
            page_size: state.pageSize
        };
        Object.keys(result).forEach(function (key) {
            if (result[key] === '') { delete result[key]; }
        });
        return result;
    }

    function runHref() {
        var websiteId = value('filter-website');
        if (websiteId === '') { return runUrl; }
        return runUrl + (runUrl.indexOf('?') === -1 ? '?' : '&') + 'website_id=' + encodeURIComponent(websiteId);
    }

    function emptyRow() {
        return '<tr><td colspan="8">' +
            '<div class="acq-empty">' +
            '<span class="acq-empty__icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c.6-4 2.7-6 6-6s5.4 2 6 6M15 15c3 0 4.8 1.7 5.3 5"/></svg></span>' +
            '<div class="acq-empty__title">还没有符合条件的线索</div>' +
            '<div class="acq-empty__text">先手动录入一条，或让获客智能体在公开网络上找一轮买家。</div>' +
            '<div class="acq-empty__actions">' +
            '<button type="button" class="w-button" data-tone="primary" data-lead-new>新建线索</button>' +
            '<a class="w-button" data-tone="neutral" data-variant="outline" href="' + escapeHtml(runHref()) + '">让智能体去找</a>' +
            '</div></div></td></tr>';
    }

    function render() {
        var tbody = byId('lead-tbody');
        if (!tbody) { return; }
        var items = state.items || [];
        if (!items.length) {
            tbody.innerHTML = emptyRow();
        } else {
            tbody.innerHTML = items.map(function (item) {
                var id = parseInt(item.id || 0, 10);
                var score = Number(item.ai_score || 0);
                var company = item.company_name || item.contact_name || '未命名公司';
                var contact = [item.contact_name || '', item.contact_role || '', websiteName(item.website_id)].filter(Boolean).join(' · ') || '未公开联系人';
                var location = [item.country_name || item.country_code || '', item.city || item.region || ''].filter(Boolean).join(' · ') || '待补充';
                var email = item.email
                    ? '<a class="acq-link" href="mailto:' + escapeHtml(item.email) + '">' + escapeHtml(item.email) + '</a>'
                    : '<span class="acq-muted">未公开</span>';
                return '<tr>' +
                    '<td><input type="checkbox" class="acq-check" data-lead-id="' + id + '"' + (state.selected[id] ? ' checked' : '') + ' aria-label="选择线索"></td>' +
                    '<td><div class="acq-company"><span class="acq-avatar">' + escapeHtml(initials(company)) + '</span><div class="acq-company__body">' +
                    '<div class="acq-company__name">' + escapeHtml(company) + '</div>' +
                    '<div class="acq-muted">' + escapeHtml(contact) + '</div>' +
                    (item.company_domain ? '<div class="acq-muted">' + escapeHtml(item.company_domain) + '</div>' : '') +
                    '</div></div></td>' +
                    '<td><div class="acq-location"><span class="w-badge" data-tone="muted">' + escapeHtml(continentLabel(item.continent_code)) + '</span>' +
                    '<div class="acq-muted">' + escapeHtml(location) + '</div></div></td>' +
                    '<td>' + email + '</td>' +
                    '<td><div class="acq-source"><span class="w-badge" data-tone="info">' + escapeHtml(platformLabel(item.source_platform)) + '</span>' + entryChannelBadge(item.entry_channel) + '</div>' +
                    leadTagsHtml(item.tags) + '</td>' +
                    '<td><span class="acq-score" data-tone="' + scoreTone(score) + '">' + (score > 0 ? '<span class="acq-score__ring">' + escapeHtml(Math.round(score)) + '</span>' : '') + score.toFixed(1) + '</span></td>' +
                    '<td><span class="w-badge" data-tone="' + statusTone(item.status) + '">' + escapeHtml(statusLabel(item.status)) + '</span></td>' +
                    '<td><div class="acq-actions">' +
                    '<button type="button" class="acq-icon-btn" data-lead-mail="' + id + '" title="邮件" aria-label="邮件">' + icon('mail') + '</button>' +
                    (convertible(item.status) ? '<button type="button" class="acq-icon-btn" data-lead-convert="' + id + '" title="转为客户" aria-label="转为客户">' + icon('convert') + '</button>' : '') +
                    '<button type="button" class="acq-icon-btn" data-lead-edit="' + id + '" title="编辑">' + icon('edit') + '</button>' +
                    '<button type="button" class="acq-icon-btn" data-tone="danger" data-lead-delete="' + id + '" title="删除">' + icon('trash') + '</button>' +
                    '</div></td></tr>';
            }).join('');
        }
        setText('lead-count', state.total + ' 条');
        setText('lead-status', '共 ' + state.total + ' 条 · 每页 ' + state.pageSize + ' 条');
        setText('lead-page-label', state.page + ' / ' + Math.max(1, state.lastPage));
        byId('lead-prev').disabled = state.page <= 1;
        byId('lead-next').disabled = state.page >= state.lastPage;
        var selectAll = byId('lead-select-all');
        if (selectAll) { selectAll.checked = items.length > 0 && items.every(function (item) { return !!state.selected[parseInt(item.id, 10)]; }); }
    }

    function renderStats(stats) {
        if (!stats) { return; }
        setText('stat-total', stats.total || 0);
        setText('stat-qualified', stats.qualified || 0);
        setText('stat-new', stats.by_status && stats.by_status.new ? stats.by_status.new : 0);
        setText('stat-continents', stats.by_continent ? Object.keys(stats.by_continent).filter(function (key) { return Number(stats.by_continent[key]) > 0; }).length : 0);
    }

    function load() {
        setText('lead-status', '加载中…');
        return Promise.all([
            op('leadList', filters()),
            op('leadStats', {})
        ]).then(function (results) {
            var list = results[0] || {};
            state.items = Array.isArray(list.items) ? list.items : [];
            state.total = Number(list.total || 0);
            state.lastPage = Number((list.pagination && list.pagination.lastPage) || 1);
            renderStats(results[1] || {});
            render();
        }).catch(function (error) {
            setText('lead-status', errorText(error, '线索加载失败'));
        });
    }

    function collect() {
        return {
            id: parseInt(value('lead-id') || '0', 10),
            website_id: parseInt(value('lead-website') || '0', 10),
            company_name: value('lead-company-name'),
            company_domain: value('lead-company-domain'),
            contact_name: value('lead-contact-name'),
            contact_role: value('lead-contact-role'),
            email: value('lead-email'),
            email_status: value('lead-email-status'),
            phone: value('lead-phone'),
            continent_code: value('lead-continent'),
            country_code: value('lead-country-code').toUpperCase(),
            country_name: value('lead-country-name'),
            region: value('lead-region'),
            city: value('lead-city'),
            timezone: value('lead-timezone'),
            source_url: value('lead-source-url'),
            source_title: value('lead-source-title'),
            source_platform: value('lead-source-platform'),
            entry_channel: value('lead-entry-channel'),
            source_excerpt: value('lead-source-excerpt'),
            status: value('lead-status'),
            ai_score: value('lead-ai-score'),
            ai_model_code: value('lead-ai-model'),
            ai_preference: value('lead-ai-preference'),
            ai_business_direction: value('lead-ai-direction'),
            ai_reason: value('lead-ai-reason')
        };
    }

    function fill(item) {
        item = item || {};
        var map = {
            'lead-id': item.id || '',
            'lead-website': item.website_id != null ? item.website_id : (value('filter-website') || '0'),
            'lead-company-name': item.company_name || '',
            'lead-company-domain': item.company_domain || '',
            'lead-contact-name': item.contact_name || '',
            'lead-contact-role': item.contact_role || '',
            'lead-email': item.email || '',
            'lead-email-status': item.email_status || 'unknown',
            'lead-phone': item.phone || '',
            'lead-continent': item.continent_code || 'UNKNOWN',
            'lead-country-code': item.country_code || '',
            'lead-country-name': item.country_name || '',
            'lead-region': item.region || '',
            'lead-city': item.city || '',
            'lead-timezone': item.timezone || '',
            'lead-source-url': item.source_url || '',
            'lead-source-title': item.source_title || '',
            'lead-source-platform': item.source_platform || 'web',
            'lead-entry-channel': item.entry_channel || 'default',
            'lead-source-excerpt': item.source_excerpt || '',
            'lead-status': item.status || 'new',
            'lead-ai-score': item.ai_score || '',
            'lead-ai-model': item.ai_model_code || '',
            'lead-ai-preference': item.ai_preference || '',
            'lead-ai-direction': item.ai_business_direction || '',
            'lead-ai-reason': item.ai_reason || ''
        };
        Object.keys(map).forEach(function (id) {
            var el = byId(id);
            if (el) { el.value = map[id]; }
        });
        setText('lead-form-title', item.id ? '编辑线索 #' + item.id : '新建线索');
        setText('lead-form-status', '');
        byId('lead-drawer').hidden = false;
        document.body.classList.add('acq-modal-open');
        window.setTimeout(function () {
            var first = byId('lead-company-name');
            if (first && typeof first.focus === 'function') { first.focus({ preventScroll: true }); }
        }, 30);
    }

    function closeDrawer() {
        byId('lead-drawer').hidden = true;
        document.body.classList.remove('acq-modal-open');
    }

    function save() {
        var payload = collect();
        if (!payload.company_name && !payload.email && !payload.source_url) {
            setFormStatus('公司、邮箱、来源 URL 至少填一项。', 'danger');
            return;
        }
        setFormStatus('保存中…', '');
        op('leadSave', { payload: payload }).then(function (result) {
            if (!result || result.success === false) { throw new Error((result && result.message) || '保存失败'); }
            setFormStatus(result.created === false ? '已合并到既有线索。' : '已保存。', 'success');
            closeDrawer();
            return load();
        }).catch(function (error) {
            setFormStatus(errorText(error, '保存失败'), 'danger');
        });
    }

    function setFormStatus(text, tone) {
        var el = byId('lead-form-status');
        if (!el) { return; }
        el.textContent = text || '';
        el.setAttribute('data-tone', tone || '');
    }

    function remove(id) {
        var confirmText = '确定删除线索 #' + id + '？该操作不可撤销。';
        var run = function () {
            op('leadDelete', { id: id }).then(function (result) {
                if (!result || result.success === false) { throw new Error((result && result.message) || '删除失败'); }
                delete state.selected[id];
                return load();
            }).catch(function (error) { setText('lead-status', errorText(error, '删除失败')); });
        };
        if (window.Weline && Weline.UI && Weline.UI.dialog && Weline.UI.dialog.confirm) {
            Weline.UI.dialog.confirm(confirmText, { title: '删除线索', confirmLabel: '删除', cancelLabel: '取消', onConfirm: run, tone: 'danger' });
        } else if (window.confirm) {
            if (window.confirm(confirmText)) { run(); }
        }
    }

    function selectedIds() {
        return Object.keys(state.selected).map(function (key) { return parseInt(key, 10); }).filter(function (id) { return id > 0; });
    }

    byId('lead-refresh').addEventListener('click', load);
    byId('lead-new').addEventListener('click', function () { fill({}); });
    byId('lead-tbody').addEventListener('click', function (event) {
        if (event.target.closest('[data-lead-new]')) { fill({}); return; }
        var mailButton = event.target.closest('[data-lead-mail]');
        if (mailButton) {
            openMailModal(parseInt(mailButton.getAttribute('data-lead-mail') || '0', 10));
            return;
        }
        var convertButton = event.target.closest('[data-lead-convert]');
        if (convertButton) {
            convertLead(parseInt(convertButton.getAttribute('data-lead-convert') || '0', 10));
            return;
        }
        var edit = event.target.closest('[data-lead-edit]');
        if (edit) {
            var id = parseInt(edit.getAttribute('data-lead-edit') || '0', 10);
            op('leadGet', { id: id }).then(function (result) {
                if (!result || result.success === false) { throw new Error((result && result.message) || '线索不存在'); }
                fill(result.lead || {});
            }).catch(function (error) { setText('lead-status', errorText(error, '加载线索失败')); });
            return;
        }
        var removeButton = event.target.closest('[data-lead-delete]');
        if (removeButton) { remove(parseInt(removeButton.getAttribute('data-lead-delete') || '0', 10)); }
    });

    function openMailModal(leadId) {
        if (!leadMailUrl || !(leadId > 0)) { setText('lead-status', '邮件组件不可用'); return; }
        var modal = byId('lead-mail-modal');
        var body = byId('lead-mail-body');
        if (!modal || !body) { return; }
        body.innerHTML = '<p class="w-text" data-tone="muted" data-size="sm">加载中…</p>';
        modal.hidden = false;
        document.body.classList.add('acq-modal-open');
        fetch(leadMailUrl + (leadMailUrl.indexOf('?') === -1 ? '?' : '&') + 'lead_id=' + encodeURIComponent(leadId), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        }).then(function (response) {
            return response.text().then(function (text) { return { ok: response.ok, text: text }; });
        }).then(function (result) {
            if (!result.ok) { throw new Error('邮件弹窗加载失败'); }
            body.innerHTML = result.text;
            var scripts = body.querySelectorAll('script');
            scripts.forEach(function (old) {
                var script = document.createElement('script');
                script.textContent = old.textContent;
                body.appendChild(script);
                old.remove();
            });
        }).catch(function (error) {
            body.innerHTML = '<p class="w-text" data-tone="danger" data-size="sm">' + escapeHtml(errorText(error, '加载失败')) + '</p>';
        });
    }

    function closeMailModal() {
        var modal = byId('lead-mail-modal');
        if (modal) { modal.hidden = true; }
        var body = byId('lead-mail-body');
        if (body) { body.innerHTML = ''; }
        document.body.classList.remove('acq-modal-open');
        load();
    }

    Array.prototype.forEach.call(document.querySelectorAll('[data-lead-mail-close]'), function (el) {
        el.addEventListener('click', closeMailModal);
    });

    function convertLead(leadId) {
        if (!leadConvertUrl || !(leadId > 0)) { setText('lead-status', '转化组件不可用'); return; }
        var run = function () {
            var separator = leadConvertUrl.indexOf('?') === -1 ? '?' : '&';
            fetch(leadConvertUrl + separator + 'lead_id=' + encodeURIComponent(leadId), {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            }).then(function (response) {
                return response.json().then(function (data) { return { ok: response.ok, data: data }; });
            }).then(function (result) {
                var data = result.data || {};
                if (!result.ok || data.success === false) { throw new Error(data.message || '转化失败'); }
                setText('lead-status', data.message || '已转为客户 #' + (data.customer_id || ''));
                return load();
            }).catch(function (error) { setText('lead-status', errorText(error, '转化失败')); });
        };
        if (window.Weline && Weline.UI && Weline.UI.dialog && Weline.UI.dialog.confirm) {
            Weline.UI.dialog.confirm('确定把线索 #' + leadId + ' 转为客户？', { title: '转为客户', confirmLabel: '转为客户', cancelLabel: '取消', onConfirm: run });
        } else if (window.confirm && window.confirm('确定把线索 #' + leadId + ' 转为客户？')) {
            run();
        }
    }


    byId('lead-tbody').addEventListener('change', function (event) {
        var target = event.target;
        var id = target && target.getAttribute ? parseInt(target.getAttribute('data-lead-id') || '0', 10) : 0;
        if (id > 0) { state.selected[id] = !!target.checked; }
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-lead-close]'), function (el) {
        el.addEventListener('click', closeDrawer);
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !byId('lead-drawer').hidden) { closeDrawer(); }
        if (event.key === 'Escape' && !byId('lead-mail-modal').hidden) { closeMailModal(); }
    });
    byId('lead-save').addEventListener('click', save);
    byId('filter-apply').addEventListener('click', function () { state.page = 1; load(); });
    byId('filter-reset').addEventListener('click', function () {
        ['filter-keyword', 'filter-website', 'filter-continent', 'filter-status', 'filter-source', 'filter-entry', 'filter-min-score'].forEach(function (id) { byId(id).value = ''; });
        state.page = 1;
        load();
    });
    byId('filter-keyword').addEventListener('keydown', function (event) { if (event.key === 'Enter') { state.page = 1; load(); } });
    byId('lead-prev').addEventListener('click', function () { if (state.page > 1) { state.page -= 1; load(); } });
    byId('lead-next').addEventListener('click', function () { if (state.page < state.lastPage) { state.page += 1; load(); } });
    byId('lead-select-all').addEventListener('change', function (event) {
        state.items.forEach(function (item) {
            var id = parseInt(item.id || 0, 10);
            if (id > 0) { state.selected[id] = event.target.checked; }
        });
        render();
    });
    byId('bulk-apply').addEventListener('click', function () {
        var ids = selectedIds();
        var status = value('bulk-status');
        if (!ids.length || !status) { setText('lead-status', '请选择线索与目标状态。'); return; }
        op('leadBulkStatus', { ids: ids, status: status }).then(function (result) {
            if (!result || result.success === false) { throw new Error((result && result.message) || '批量更新失败'); }
            state.selected = {};
            return load();
        }).catch(function (error) { setText('lead-status', errorText(error, '批量更新失败')); });
    });
    byId('bulk-delete').addEventListener('click', function () {
        var ids = selectedIds();
        if (!ids.length) { setText('lead-status', '请先选择线索。'); return; }
        var run = function () {
            op('leadBulkDelete', { ids: ids }).then(function (result) {
                if (!result || result.success === false) { throw new Error((result && result.message) || '批量删除失败'); }
                state.selected = {};
                return load();
            }).catch(function (error) { setText('lead-status', errorText(error, '批量删除失败')); });
        };
        if (window.Weline && Weline.UI && Weline.UI.dialog && Weline.UI.dialog.confirm) {
            Weline.UI.dialog.confirm('确定删除选中的 ' + ids.length + ' 条线索？', { title: '批量删除', confirmLabel: '删除', cancelLabel: '取消', onConfirm: run, tone: 'danger' });
        } else if (window.confirm && window.confirm('确定删除选中的 ' + ids.length + ' 条线索？')) {
            run();
        }
    });

    load();
})();
</script>
