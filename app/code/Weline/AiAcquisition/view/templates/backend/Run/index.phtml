<script>
(function () {
    'use strict';
    var statuses = <?= json_encode($statuses, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var websiteProfile = <?= json_encode($websiteProfile, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var initialRuns = <?= json_encode($runs, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]' ?>;
    var state = { runs: Array.isArray(initialRuns) ? initialRuns : [], ticket: '', modelMode: 'ai_module' };

    function op(operation, data) {
        var run = function (api) {
            var resource = api.resource('ai_acquisition');
            if (!resource || typeof resource[operation] !== 'function') {
                return Promise.reject(new Error('AI 获客接口不可用，请刷新页面。'));
            }
            return resource[operation](data || {}).then(function (res) {
                return res && Object.prototype.hasOwnProperty.call(res, 'data') ? res.data : res;
            });
        };
        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(run);
        }
        if (window.Weline && window.Weline.Api) {
            return Promise.resolve(run(window.Weline.Api));
        }
        return Promise.reject(new Error('Weline.Api 不可用，请刷新页面。'));
    }

    function byId(id) { return document.getElementById(id); }
    function value(id) { var el = byId(id); return el ? String(el.value || '').trim() : ''; }
    function setText(id, text) { var el = byId(id); if (el) { el.textContent = text == null ? '' : String(text); } }
    function escapeHtml(text) {
        return String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function errorText(error, fallback) {
        var data = error && error.response && error.response.data ? error.response.data : null;
        return (data && (data.message || data.msg)) || (error && error.message) || fallback;
    }
    function statusLabel(code) { return statuses[code] || code || '-'; }
    function money(value, currency) {
        var number = Number(value);
        if (!Number.isFinite(number)) { number = 0; }
        return (currency || 'CNY') + ' ' + number.toFixed(4);
    }
    function timeText(value) {
        var number = parseInt(value || 0, 10);
        if (!number) { return '-'; }
        return new Date(number * 1000).toLocaleString();
    }
    function statusTone(code) {
        if (code === 'completed') { return 'success'; }
        if (code === 'failed') { return 'danger'; }
        if (code === 'cancelled') { return 'muted'; }
        if (code === 'running') { return 'info'; }
        return 'warning';
    }

    function loadWebsiteProfile() {
        var websiteId = parseInt(value('run-website') || '-1', 10);
        var box = byId('run-website-profile');
        if (websiteId < 0) {
            box.innerHTML = '<span>选择网站后显示站点画像；获客提示词会自动注入画像，避免找错市场。</span>';
            return;
        }
        var profile = websiteProfile && String(websiteProfile.website_id) === String(websiteId) ? websiteProfile : {};
        var parts = [];
        (function () {
            parts.push('<div><strong>' + escapeHtml(profile.name || ('#' + websiteId)) + '</strong>' +
                (profile.url ? ' · <span class="acq-link">' + escapeHtml(profile.url) + '</span>' : '') + '</div>');
            if (profile.persona_summary) {
                parts.push('<div>运营画像：' + escapeHtml(profile.persona_summary) + '</div>');
            } else if (profile.description) {
                parts.push('<div>网站描述：' + escapeHtml(profile.description) + '</div>');
            }
            if (Array.isArray(profile.categories) && profile.categories.length) {
                parts.push('<div>核心类目：' + escapeHtml(profile.categories.slice(0, 8).join('、')) + '</div>');
            }
            if (Array.isArray(profile.locales) && profile.locales.length) {
                parts.push('<div>语种市场：' + escapeHtml(profile.locales.slice(0, 8).join('、')) + '</div>');
            }
            if (Array.isArray(profile.evidence_gaps) && profile.evidence_gaps.length) {
                parts.push('<div>画像缺口：' + escapeHtml(profile.evidence_gaps.slice(0, 6).join('、')) + '</div>');
            }
            parts.push('<div>已入库线索 ' + Number(profile.lead_count || 0) + ' 条 · 运行 ' + Number(profile.run_count || 0) + ' 次</div>');
            box.innerHTML = parts.join('');
            var baseInput = byId('run-bridge-base');
            if (baseInput && !baseInput.value) {
                // 桥接口挂在当前后台所在源的 frontend 控制器上，跨站前台域名会打不开票据
                baseInput.value = window.location.origin;
            }
        })();
    }

    var MODEL_CHOICE_KEY = 'weline.acq.modelChoice.v1';
    var restoringChoice = false;

    /** 记住上次的模型运行方式与具体模型，下次打开页面自动恢复。 */
    /** combobox 按值回填显示文本。 */
    function syncComboboxDisplay(inputId, listId, value) {
        var input = byId(inputId);
        var list = document.getElementById(listId);
        if (!input || !list) { return; }
        Array.prototype.forEach.call(list.querySelectorAll('[role="option"]'), function (option) {
            var label = (option.querySelector('.acq-option-label') || option).textContent.trim();
            if ((option.getAttribute('data-value') || '') === value) {
                input.value = label;
                option.setAttribute('aria-selected', 'true');
            } else {
                option.setAttribute('aria-selected', 'false');
            }
        });
    }

    function rememberModelChoice() {
        if (restoringChoice) {
            return; // 恢复过程中不回写，避免把刚恢复的值覆盖成默认值
        }
        var choice = {
            mode: state.modelMode,
            model: value('run-model'),
            browser_model: value('run-browser-model'),
            local_model: value('run-local-model'),
            local_endpoint: value('run-local-endpoint'),
        };
        try {
            window.localStorage.setItem(MODEL_CHOICE_KEY, JSON.stringify(choice));
        } catch (error) {
            // 隐私模式/存储被禁用时忽略
        }
    }

    function restoreModelChoice() {
        restoringChoice = true;
        var choice = null;
        try {
            choice = JSON.parse(window.localStorage.getItem(MODEL_CHOICE_KEY) || 'null');
        } catch (error) {
            choice = null;
        }
        if (!choice || typeof choice !== 'object') {
            setModelMode('ai_module');
            restoringChoice = false;
            return;
        }
        var mode = ['ai_module', 'local_computer', 'browser_local'].indexOf(choice.mode) === -1
            ? 'ai_module'
            : choice.mode;
        setModelMode(mode);
        if (mode === 'ai_module' && choice.model && byId('run-model')) {
            byId('run-model').value = choice.model;
            syncComboboxDisplay('run-model-input', 'run-model-list', choice.model);
            refreshPrice();
        }
        if (mode === 'browser_local' && choice.browser_model && byId('run-browser-model')) {
            byId('run-browser-model').value = choice.browser_model;
            syncComboboxDisplay('run-browser-model-input', 'run-browser-model-list', choice.browser_model);
        }
        if (mode === 'local_computer') {
            if (choice.local_endpoint && byId('run-local-endpoint') && !value('run-local-endpoint')) {
                byId('run-local-endpoint').value = choice.local_endpoint;
            }
            if (choice.local_model && byId('run-local-model')) {
                byId('run-local-model').value = choice.local_model;
            }
        }
        restoringChoice = false;
    }

    function setModelMode(mode) {
        if (['ai_module', 'local_computer', 'browser_local'].indexOf(mode) === -1) {
            mode = 'ai_module';
        }
        state.modelMode = mode;
        var aiMode = mode === 'ai_module';
        byId('run-ai-model-field').hidden = !aiMode;
        byId('run-model-price').hidden = !aiMode;
        byId('run-local-settings').hidden = mode !== 'local_computer';
        byId('run-browser-settings').hidden = mode !== 'browser_local';
        Array.prototype.forEach.call(document.querySelectorAll('#run-mode-picker [data-model-mode]'), function (button) {
            button.setAttribute('aria-checked', button.getAttribute('data-model-mode') === mode ? 'true' : 'false');
        });
        if (aiMode) {
            refreshPrice();
        }
        rememberModelChoice();
    }

    function refreshPrice() {
        if (state.modelMode !== 'ai_module') {
            return;
        }
        var model = value('run-model');
        var box = byId('run-model-price');
        if (!model) {
            box.innerHTML = '<span>选择模型后显示每千 token 价格与 8 轮预估。</span>';
            return;
        }
        var iterations = Math.max(1, parseInt(value('run-iterations') || '8', 10));
        op('modelQuote', { model_code: model, input_tokens: 4000, output_tokens: 1200, iterations: iterations }).then(function (result) {
            if (!result || !result.quote) {
                box.innerHTML = '<span>该模型缺少价格配置，运行成本将按 0 记录。</span>';
                return;
            }
            var quote = result.quote;
            var typical = result.estimate && result.estimate.typical ? Number(result.estimate.typical.total_cost) : Number(quote.total_cost);
            box.innerHTML =
                '<div><strong>每千 token</strong>：输入 ' + escapeHtml(quote.input_price) + ' / 输出 ' + escapeHtml(quote.output_price) + ' ' + escapeHtml(quote.currency) + '</div>' +
                '<div><strong>' + iterations + ' 轮预估</strong>：' + escapeHtml(money(typical, quote.currency)) + (quote.priced ? '' : '（未配置价格，仅记录 token）') + '</div>';
        }).catch(function (error) {
            box.textContent = errorText(error, '价格查询失败');
        });
    }

    function emptyRow() {
        return '<tr><td colspan="9"><div class="acq-empty">' +
            '<span class="acq-empty__icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 3 4-6"/></svg></span>' +
            '<div class="acq-empty__title">还没有运行记录</div>' +
            '<div class="acq-empty__text">在上方选择模型并创建运行，票据会在这里显示。</div>' +
            '</div></td></tr>';
    }

    function renderRuns() {
        var tbody = byId('run-tbody');
        if (!tbody) { return; }
        var runs = state.runs || [];
        if (!runs.length) {
            tbody.innerHTML = emptyRow();
        } else {
            tbody.innerHTML = runs.map(function (run) {
                var id = parseInt(run.id || 0, 10);
                var actions = '<div class="acq-actions">' +
                    '<button type="button" class="w-button" data-size="sm" data-tone="neutral" data-variant="outline" data-run-action="detail" data-run-id="' + id + '">详情</button>' +
                    runActions(run, id) +
                    '</div>';
                return '<tr>' +
                    '<td>#' + id + '</td>' +
                    '<td><code class="acq-code">' + escapeHtml(run.model_code || '-') + '</code></td>' +
                    '<td><span class="w-badge" data-tone="' + statusTone(run.status) + '">' + escapeHtml(statusLabel(run.status)) + '</span></td>' +
                    '<td>' + Number(run.leads_saved || 0) + ' / ' + Number(run.leads_found || 0) + '</td>' +
                    '<td>' + Number(run.searches_count || 0) + '</td>' +
                    '<td>' + Number(run.input_tokens || 0) + ' + ' + Number(run.output_tokens || 0) + '</td>' +
                    '<td>' + escapeHtml(money(run.cost, run.currency)) + '</td>' +
                    '<td>' + escapeHtml(timeText(run.created_at)) + '</td>' +
                    '<td>' + actions + '</td>' +
                    '</tr>';
            }).join('');
        }
        setText('run-list-status', state.runs.length + ' 条');
        syncLeaveGuard();
    }

    // 有「待连接 / 执行中」的智能体时，离开本页（关闭、刷新、跳菜单）先二次确认。
    var ACTIVE_RUN_STATUSES = { pending: 1, running: 1 };
    var leaveGuardBound = false;
    function activeRunCount() {
        var runs = state.runs || [];
        var count = 0;
        for (var i = 0; i < runs.length; i += 1) {
            if (ACTIVE_RUN_STATUSES[String(runs[i] && runs[i].status || '')] === 1) { count += 1; }
        }
        return count;
    }
    function onBeforeUnload(event) {
        if (activeRunCount() === 0) { return undefined; }
        event.preventDefault();
        event.returnValue = '有正在运行的获客智能体，确认离开本页？';
        return event.returnValue;
    }
    function syncLeaveGuard() {
        var count = activeRunCount();
        window.__acqActiveRuns = count;
        if (count > 0 && !leaveGuardBound) {
            window.addEventListener('beforeunload', onBeforeUnload);
            leaveGuardBound = true;
        } else if (count === 0 && leaveGuardBound) {
            window.removeEventListener('beforeunload', onBeforeUnload);
            leaveGuardBound = false;
        }
        setText('run-leave-hint', count > 0 ? '有 ' + count + ' 个智能体正在运行，离开本页会二次确认。' : '');
    }

    function loadRuns() {
        op('runList', { page: 1, page_size: 20 }).then(function (result) {
            state.runs = Array.isArray(result.items) ? result.items : [];
            renderRuns();
        }).catch(function (error) {
            setText('run-list-status', errorText(error, '运行记录加载失败'));
        });
    }

    function createRun() {
        var websiteId = parseInt(value('run-website') || '-1', 10);
        if (websiteId < 0) {
            setText('run-create-status', '请先选择要获客的网站。');
            return;
        }
        var mode = state.modelMode;
        var payload = {
            website_id: websiteId,
            model_mode: mode,
            prompt_profile_id: parseInt(value('run-prompt') || '0', 10),
            target_count: parseInt(value('run-target') || '10', 10),
            max_iterations: parseInt(value('run-iterations') || '8', 10),
            context: value('run-context')
        };
        if (mode === 'ai_module') {
            var modelCode = value('run-model');
            if (!modelCode) {
                setText('run-create-status', '请选择 AI 模块模型。');
                return;
            }
            payload.model_code = modelCode;
        } else if (mode === 'local_computer') {
            var localEndpoint = value('run-local-endpoint');
            var localModel = value('run-local-model');
            if (!localEndpoint || !localModel) {
                setText('run-create-status', '请填写本地模型服务地址与模型名。');
                return;
            }
            payload.local_endpoint = localEndpoint;
            payload.local_model = localModel;
        } else {
            payload.browser_model = value('run-browser-model') || 'chrome-builtin';
        }
        // 浏览器端侧 / 本机模型都依赖扩展执行：先确认扩展在线，未安装则弹窗引导且不创建运行记录。
        if (mode !== 'ai_module') {
            setText('run-create-status', '正在检测浏览器扩展…');
            waitForExtension(1500).then(function (online) {
                if (!online) {
                    setText('run-create-status', '');
                    openExtMissingModal();
                    return;
                }
                submitRun(payload);
            });
            return;
        }
        submitRun(payload);
    }

    function submitRun(payload) {
        setText('run-create-status', '创建中…');
        op('runCreate', {
            payload: payload
        }).then(function (result) {
            if (!result || result.success === false) { throw new Error((result && result.message) || '创建失败'); }
            state.ticket = result.ticket || '';
            var ticketCode = byId('run-ticket');
            ticketCode.textContent = state.ticket;
            ticketCode.setAttribute('data-acq-ticket', state.ticket);
            var ticketBox = byId('run-ticket-box');
            var bridgeBase = (value('run-bridge-base') || window.location.origin).replace(/\/+$/, '');
            ticketBox.hidden = false;
            ticketBox.setAttribute('data-acq-bridge-base', window.location.origin);
            byId('run-sse-url').textContent = bridgeBase + '/ai_acquisition/frontend/bridge/stream?ticket=' + encodeURIComponent(state.ticket);
            setText('run-create-status', '已签发运行 #' + (result.id || '') + '，等待扩展助手初始化模型…');
            loadRuns();
            // ai_module 在服务端跑模型，不需要扩展助手；只有本机/浏览器端侧模型才通知扩展。
            if (state.modelMode !== 'ai_module') {
                notifyExtension(result);
            } else {
                setText('run-create-status', '已创建运行 #' + (result.id || '') + '，AI 模块开始执行。');
            }
        }).catch(function (error) {
            setText('run-create-status', errorText(error, '创建失败'));
        });
    }

    function extensionOnline() {
        return Boolean(document.getElementById('weline-acq-assistant-host'));
    }

    // content script 是 document_idle 注入，刚进页面时可能还没挂上助手 host，短轮询等待。
    function waitForExtension(timeoutMs) {
        return new Promise(function (resolve) {
            if (extensionOnline()) { resolve(true); return; }
            var deadline = Date.now() + (timeoutMs || 1500);
            var timer = setInterval(function () {
                if (extensionOnline()) { clearInterval(timer); resolve(true); return; }
                if (Date.now() >= deadline) { clearInterval(timer); resolve(false); }
            }, 150);
        });
    }

    function openExtMissingModal() {
        var modal = byId('acq-ext-missing-modal');
        setText('acq-ext-missing-status', '');
        if (!modal) { showInstallGuide(); return; }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog) {
            window.Weline.UI.dialog.open('#acq-ext-missing-modal');
            return;
        }
        modal.hidden = false;
        modal.removeAttribute('hidden');
        modal.dataset.state = 'open';
        modal.setAttribute('aria-hidden', 'false');
    }

    function closeExtMissingModal() {
        var modal = byId('acq-ext-missing-modal');
        if (!modal) { return; }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog) {
            window.Weline.UI.dialog.close('#acq-ext-missing-modal');
            return;
        }
        modal.dataset.state = 'closed';
        modal.setAttribute('aria-hidden', 'true');
        modal.hidden = true;
    }

    function showInstallGuide() {
        setText('run-create-status', '未检测到浏览器扩展：请按右侧「浏览器扩展」卡片重新下载 ZIP（v1.3.0 起才有悬浮助手），解压后替换旧目录并刷新本页；旧版扩展没有悬浮助手。');
        var extCard = document.querySelector('section[aria-label="浏览器扩展"]');
        if (extCard) {
            extCard.classList.add('acq-ext-card-pulse');
            setTimeout(function () { extCard.classList.remove('acq-ext-card-pulse'); }, 8000);
        }
    }

    (function bindExtMissingModal() {
        var recheck = byId('acq-ext-modal-recheck');
        if (recheck) {
            recheck.addEventListener('click', function () {
                setText('acq-ext-missing-status', '正在检测…');
                recheck.setAttribute('aria-busy', 'true');
                waitForExtension(2500).then(function (online) {
                    recheck.removeAttribute('aria-busy');
                    if (!online) {
                        setText('acq-ext-missing-status', '仍未检测到扩展。若是刚加载扩展，请点「刷新本页」后重试。');
                        return;
                    }
                    closeExtMissingModal();
                    createRun();
                });
            });
        }
        var reload = byId('acq-ext-modal-reload');
        if (reload) {
            reload.addEventListener('click', function () { window.location.reload(); });
        }
    })();

    function notifyExtension(result) {
        // content script 运行在隔离环境，window 标记对页面不可见；
        // 助手的 Shadow DOM host 元素挂在主 DOM 上，用它判定扩展是否在线。
        if (!extensionOnline()) {
            // content script 是 document_idle 注入：慢渲染/刚进页面时可能还没挂上，
            // 等 2.5s 复检一次再下结论，避免误报「未安装」。
            setText('run-create-status', '正在检测浏览器扩展…');
            setTimeout(function () {
                if (extensionOnline()) {
                    dispatchStart(result);
                } else {
                    showInstallGuide();
                }
            }, 2500);
            return;
        }
        dispatchStart(result);
    }

    function dispatchStart(result) {
        var ponged = false;
        var retries = 0;
        function start() {
            if (ponged && retries >= 3) { return; }
            ponged = true;
            window.dispatchEvent(new CustomEvent('weline-acq-start', {
                detail: { ticket: state.ticket, baseUrl: window.location.origin }
            }));
            setText('run-create-status', '已自动启动扩展助手 #' + (result.id || '') + '，模型初始化中…');
            // 助手可能因标签页休眠/SW 睡眠漏掉事件：3s 后若 dataset.acqPhase 仍非运行态，补派一次（最多 3 次）
            setTimeout(function () {
                var host = document.getElementById('weline-acq-assistant-host');
                var phase = host && host.dataset ? host.dataset.acqPhase : '';
                if (phase === 'running' || phase === 'paused' || phase === 'done'
                    || phase === 'failed' || phase === 'stopped' || phase === 'init') {
                    return;
                }
                retries += 1;
                ponged = false;
                if (retries <= 3) {
                    log_retry(result, retries);
                    start();
                }
            }, 3000);
        }
        function log_retry(result, attempt) {
            setText('run-create-status', '已自动启动扩展助手 #' + (result.id || '') + '（第 ' + attempt + ' 次唤醒）');
        }
        window.addEventListener('weline-acq-pong', start, { once: true });
        setTimeout(start, 2000);
        window.dispatchEvent(new CustomEvent('weline-acq-ping'));
    }

    byId('run-website').addEventListener('change', function () {
        var websiteId = value('run-website');
        if (websiteId !== '' && websiteId !== '-1') {
            window.location.href = window.location.pathname + '?website_id=' + encodeURIComponent(websiteId);
        }
    });
    byId('run-site-input').addEventListener('change', function () {
        var wanted = this.value.trim();
        var list = document.getElementById('run-site-list');
        var matched = null;
        Array.prototype.forEach.call(list.querySelectorAll('[role="option"]'), function (option) {
            var value = option.getAttribute('data-value') || '';
            var label = option.querySelector('.acq-site-option__name').textContent.trim();
            if (wanted === value || wanted === label) {
                matched = value;
                this.value = label;
                option.setAttribute('aria-selected', 'true');
            } else {
                option.setAttribute('aria-selected', 'false');
            }
        }, this);
        byId('run-website').value = matched || '-1';
        byId('run-website').dispatchEvent(new Event('change', { bubbles: true }));
    });
    byId('run-mode-picker').addEventListener('click', function (event) {
        var option = event.target.closest('[data-model-mode]');
        if (!option) { return; }
        setModelMode(option.getAttribute('data-model-mode'));
    });
    // combobox 选择后同步隐藏域。框架组件会把 input.value 写成 data-value，
    // 因此同时按 data-value 与显示文本两种方式匹配 option。
    function bindCombobox(inputId, hiddenId) {
        var input = byId(inputId);
        var hidden = byId(hiddenId);
        if (!input || !hidden) { return; }
        var panel = document.getElementById(input.getAttribute('aria-controls') || '');
        input.addEventListener('change', function () {
            var wanted = input.value.trim();
            var matched = null;
            if (panel) {
                Array.prototype.forEach.call(panel.querySelectorAll('[role="option"]'), function (option) {
                    var value = option.getAttribute('data-value') || '';
                    var label = (option.querySelector('.acq-option-label') || option).textContent.trim();
                    if (wanted === value || wanted === label) {
                        matched = value;
                        input.value = label; // 显示文本，不把 code 露给用户
                        option.setAttribute('aria-selected', 'true');
                    } else {
                        option.setAttribute('aria-selected', 'false');
                    }
                });
            }
            hidden.value = matched || '';
            hidden.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }
    bindCombobox('run-model-input', 'run-model');
    bindCombobox('run-browser-model-input', 'run-browser-model');

    byId('run-model').addEventListener('change', function () {
        refreshPrice();
        rememberModelChoice();
    });
    byId('run-browser-model').addEventListener('change', rememberModelChoice);
    byId('run-local-model') && byId('run-local-model').addEventListener('change', rememberModelChoice);
    byId('run-local-endpoint') && byId('run-local-endpoint').addEventListener('change', rememberModelChoice);
    byId('run-iterations').addEventListener('change', refreshPrice);
    byId('run-create').addEventListener('click', createRun);
    byId('run-refresh').addEventListener('click', loadRuns);
    byId('run-copy-ticket').addEventListener('click', function () {
        if (!state.ticket) { return; }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(state.ticket).then(function () { setText('run-create-status', '票据已复制。'); });
        }
    });
    function runActionButton(action, id, tone) {
        return '<button type="button" class="w-button" data-size="sm" data-tone="' + (tone || 'neutral') + '" data-variant="outline" data-run-action="' + action + '" data-run-id="' + id + '">' +
            ({ pause: '暂停', resume: '继续', stop: '停止', delete: '删除' }[action] || action) + '</button>';
    }

    function runActions(run, id) {
        var paused = run.status === 'paused';
        var active = run.status === 'pending' || run.status === 'running' || paused;
        var html = '';
        if (run.status === 'running') { html += runActionButton('pause', id); }
        if (paused) { html += runActionButton('resume', id, 'primary'); }
        if (active) { html += runActionButton('stop', id, 'danger'); }
        if (!run.status || !active) { html += runActionButton('delete', id, 'danger'); }
        return html;
    }

    function renderDetail(result) {
        var run = (result && result.run) || {};
        var events = Array.isArray(result && result.events) ? result.events : [];
        var rows = [
            ['状态', statusLabel(run.status)],
            ['网站', run.website_name || ('#' + (run.website_id || 0))],
            ['模型', (run.model_label || run.model_code || '-') + (run.model_mode ? '（' + run.model_mode + '）' : '')],
            ['线索', (run.leads_saved || 0) + ' 已入库 / ' + (run.leads_found || 0) + ' 发现'],
            ['搜索', String(run.searches_count || 0)],
            ['Token', (run.input_tokens || 0) + ' + ' + (run.output_tokens || 0)],
            ['成本', money(run.cost, run.currency)],
            ['创建', timeText(run.created_at)],
            ['开始', timeText(run.started_at)],
            ['结束', timeText(run.finished_at)],
            ['票据到期', timeText(run.ticket_expires_at)]
        ];
        var html = '<dl class="acq-detail">' + rows.map(function (row) {
            return '<div class="acq-detail__row"><dt>' + escapeHtml(row[0]) + '</dt><dd>' + escapeHtml(row[1]) + '</dd></div>';
        }).join('') + '</dl>';
        if (run.error) {
            html += '<div class="acq-note">' + escapeHtml(run.error) + '</div>';
        }
        html += '<section class="acq-form-section"><h3 class="acq-form-section__title">运行事件</h3>';
        if (!events.length) {
            html += '<p class="acq-muted">还没有事件；扩展接入后这里会显示每一次搜索与入库。</p>';
        } else {
            var typeLabels = { search: '检索', step: '模型步进', lead: '线索', complete: '结束', control: '控制', ready: '就绪', context: '连接' };
            html += '<ol class="acq-event-list">' + events.slice(0, 50).map(function (event) {
                var payload = event.payload || {};
                var detail = [];
                if (payload.query) { detail.push('“' + payload.query + '”'); }
                if (payload.results != null) { detail.push(payload.results + ' 条'); }
                if (payload.model_code) { detail.push(payload.model_code); }
                if (payload.tool_calls != null) { detail.push('工具 ' + payload.tool_calls); }
                if (payload.prompt_tokens != null) { detail.push('token ' + payload.prompt_tokens + '+' + payload.completion_tokens); }
                if (payload.created != null) { detail.push(payload.created ? '新线索' : '已存在'); }
                if (payload.status) { detail.push(statusLabel(payload.status)); }
                if (payload.action) { detail.push({ pause: '暂停', resume: '继续', stop: '停止' }[payload.action] || payload.action); }
                if (!detail.length) {
                    Object.keys(payload).slice(0, 2).forEach(function (key) {
                        var value = payload[key];
                        if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
                            detail.push(key + ': ' + value);
                        }
                    });
                }
                return '<li><span class="acq-event-list__time">' + escapeHtml(timeText(event.created_at)) + '</span>' +
                    '<span class="w-badge" data-tone="muted">' + escapeHtml(typeLabels[event.type] || event.type || '-') + '</span>' +
                    '<span class="acq-event-list__text">' + escapeHtml(detail.join(' · ') || '-') + '</span></li>';
            }).join('') + '</ol>';
        }
        html += '</section>';
        byId('run-detail-body').innerHTML = html;
        byId('run-detail-title').textContent = '运行 #' + (run.id || '');
        byId('run-detail-subtitle').textContent = statusLabel(run.status) + ' · ' + timeText(run.created_at);
        byId('run-detail-actions').innerHTML = runActions(run, parseInt(run.id || 0, 10));
    }

    function openDetail(id) {
        setText('run-list-status', '加载中…');
        op('runDetail', { id: id }).then(function (result) {
            renderDetail(result);
            byId('run-drawer').hidden = false;
            setText('run-list-status', state.runs.length + ' 条');
        }).catch(function (error) {
            setText('run-list-status', errorText(error, '详情加载失败'));
        });
    }

    function runAction(action, id) {
        if (action === 'detail') {
            openDetail(id);
            return;
        }
        if (action === 'delete' && !window.confirm('删除运行 #' + id + ' 的运行记录与桥事件？')) {
            return;
        }
        var operation = { pause: 'runPause', resume: 'runResume', stop: 'runCancel', delete: 'runDelete' }[action];
        if (!operation) { return; }
        op(operation, { id: id }).then(function () {
            loadRuns();
            if (!byId('run-drawer').hidden) { openDetail(id); }
        }).catch(function (error) {
            setText('run-list-status', errorText(error, '操作失败'));
        });
    }

    byId('run-tbody').addEventListener('click', function (event) {
        var button = event.target.closest('[data-run-action]');
        if (!button) { return; }
        var id = parseInt(button.getAttribute('data-run-id') || '0', 10);
        if (!id) { return; }
        runAction(button.getAttribute('data-run-action'), id);
    });
    byId('run-detail-actions').addEventListener('click', function (event) {
        var button = event.target.closest('[data-run-action]');
        if (!button) { return; }
        var id = parseInt(button.getAttribute('data-run-id') || '0', 10);
        if (!id) { return; }
        runAction(button.getAttribute('data-run-action'), id);
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-run-close]'), function (node) {
        node.addEventListener('click', function () { byId('run-drawer').hidden = true; });
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !byId('run-drawer').hidden) {
            byId('run-drawer').hidden = true;
        }
    });

    renderRuns();
    loadWebsiteProfile();
    // 常驻扩展在线指示：3s 后仍未挂上助手 host → 卡片标注「未在线」
    setTimeout(function () {
        var card = document.querySelector('section[aria-label="浏览器扩展"]');
        if (!card) { return; }
        if (document.getElementById('weline-acq-assistant-host')) {
            card.classList.add('acq-ext-online');
        } else {
            card.classList.add('acq-ext-offline');
        }
    }, 3000);
    restoreModelChoice();
    window.setInterval(loadRuns, 5000);
})();
</script>
