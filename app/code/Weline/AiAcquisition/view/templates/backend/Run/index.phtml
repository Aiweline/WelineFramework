<script>
(function () {
    'use strict';
    var statuses = <?= json_encode($statuses, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var websiteProfile = <?= json_encode($websiteProfile, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}' ?>;
    var initialRuns = <?= json_encode($runs, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]' ?>;
    var state = { runs: Array.isArray(initialRuns) ? initialRuns : [], ticket: '', modelMode: 'ai_module' };

    function op(operation, data) {
        var run = function (api) {
            var resource = api.resource('ai_acquisition');
            if (!resource || typeof resource[operation] !== 'function') {
                return Promise.reject(new Error('AI 获客接口不可用，请刷新页面。'));
            }
            return resource[operation](data || {}).then(function (res) {
                return res && Object.prototype.hasOwnProperty.call(res, 'data') ? res.data : res;
            });
        };
        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(run);
        }
        if (window.Weline && window.Weline.Api) {
            return Promise.resolve(run(window.Weline.Api));
        }
        return Promise.reject(new Error('Weline.Api 不可用，请刷新页面。'));
    }

    function byId(id) { return document.getElementById(id); }
    function value(id) { var el = byId(id); return el ? String(el.value || '').trim() : ''; }
    function setText(id, text) { var el = byId(id); if (el) { el.textContent = text == null ? '' : String(text); } }
    function escapeHtml(text) {
        return String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function errorText(error, fallback) {
        var data = error && error.response && error.response.data ? error.response.data : null;
        return (data && (data.message || data.msg)) || (error && error.message) || fallback;
    }
    function statusLabel(code) { return statuses[code] || code || '-'; }
    function money(value, currency) {
        var number = Number(value);
        if (!Number.isFinite(number)) { number = 0; }
        return (currency || 'CNY') + ' ' + number.toFixed(4);
    }
    function timeText(value) {
        var number = parseInt(value || 0, 10);
        if (!number) { return '-'; }
        return new Date(number * 1000).toLocaleString();
    }
    function statusTone(code) {
        if (code === 'completed') { return 'success'; }
        if (code === 'failed') { return 'danger'; }
        if (code === 'cancelled') { return 'muted'; }
        if (code === 'running') { return 'info'; }
        return 'warning';
    }

    function loadWebsiteProfile() {
        var websiteId = parseInt(value('run-website') || '-1', 10);
        var box = byId('run-website-profile');
        if (websiteId < 0) {
            box.innerHTML = '<span>选择网站后显示站点画像；获客提示词会自动注入画像，避免找错市场。</span>';
            return;
        }
        var profile = websiteProfile && String(websiteProfile.website_id) === String(websiteId) ? websiteProfile : {};
        var parts = [];
        (function () {
            parts.push('<div><strong>' + escapeHtml(profile.name || ('#' + websiteId)) + '</strong>' +
                (profile.url ? ' · <span class="acq-link">' + escapeHtml(profile.url) + '</span>' : '') + '</div>');
            if (profile.persona_summary) {
                parts.push('<div>运营画像：' + escapeHtml(profile.persona_summary) + '</div>');
            } else if (profile.description) {
                parts.push('<div>网站描述：' + escapeHtml(profile.description) + '</div>');
            }
            if (Array.isArray(profile.categories) && profile.categories.length) {
                parts.push('<div>核心类目：' + escapeHtml(profile.categories.slice(0, 8).join('、')) + '</div>');
            }
            if (Array.isArray(profile.locales) && profile.locales.length) {
                parts.push('<div>语种市场：' + escapeHtml(profile.locales.slice(0, 8).join('、')) + '</div>');
            }
            if (Array.isArray(profile.evidence_gaps) && profile.evidence_gaps.length) {
                parts.push('<div>画像缺口：' + escapeHtml(profile.evidence_gaps.slice(0, 6).join('、')) + '</div>');
            }
            parts.push('<div>已入库线索 ' + Number(profile.lead_count || 0) + ' 条 · 运行 ' + Number(profile.run_count || 0) + ' 次</div>');
            box.innerHTML = parts.join('');
            var baseInput = byId('run-bridge-base');
            if (baseInput && !baseInput.value) {
                var candidateUrl = /^https:\/\//i.test(profile.url || '') ? profile.url : window.location.origin;
                baseInput.value = candidateUrl;
            }
        })();
    }

    function setModelMode(mode) {
        if (['ai_module', 'local_computer', 'browser_local'].indexOf(mode) === -1) {
            mode = 'ai_module';
        }
        state.modelMode = mode;
        var aiMode = mode === 'ai_module';
        byId('run-ai-model-field').hidden = !aiMode;
        byId('run-model-price').hidden = !aiMode;
        byId('run-local-settings').hidden = mode !== 'local_computer';
        byId('run-browser-settings').hidden = mode !== 'browser_local';
        Array.prototype.forEach.call(document.querySelectorAll('#run-mode-picker [data-model-mode]'), function (button) {
            button.setAttribute('aria-checked', button.getAttribute('data-model-mode') === mode ? 'true' : 'false');
        });
        if (aiMode) {
            refreshPrice();
        }
    }

    function refreshPrice() {
        if (state.modelMode !== 'ai_module') {
            return;
        }
        var model = value('run-model');
        var box = byId('run-model-price');
        if (!model) {
            box.innerHTML = '<span>选择模型后显示每千 token 价格与 8 轮预估。</span>';
            return;
        }
        var iterations = Math.max(1, parseInt(value('run-iterations') || '8', 10));
        op('modelQuote', { model_code: model, input_tokens: 4000, output_tokens: 1200, iterations: iterations }).then(function (result) {
            if (!result || !result.quote) {
                box.innerHTML = '<span>该模型缺少价格配置，运行成本将按 0 记录。</span>';
                return;
            }
            var quote = result.quote;
            var typical = result.estimate && result.estimate.typical ? Number(result.estimate.typical.total_cost) : Number(quote.total_cost);
            box.innerHTML =
                '<div><strong>每千 token</strong>：输入 ' + escapeHtml(quote.input_price) + ' / 输出 ' + escapeHtml(quote.output_price) + ' ' + escapeHtml(quote.currency) + '</div>' +
                '<div><strong>' + iterations + ' 轮预估</strong>：' + escapeHtml(money(typical, quote.currency)) + (quote.priced ? '' : '（未配置价格，仅记录 token）') + '</div>';
        }).catch(function (error) {
            box.textContent = errorText(error, '价格查询失败');
        });
    }

    function emptyRow() {
        return '<tr><td colspan="9"><div class="acq-empty">' +
            '<span class="acq-empty__icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 3 4-6"/></svg></span>' +
            '<div class="acq-empty__title">还没有运行记录</div>' +
            '<div class="acq-empty__text">在上方选择模型并创建运行，票据会在这里显示。</div>' +
            '</div></td></tr>';
    }

    function renderRuns() {
        var tbody = byId('run-tbody');
        if (!tbody) { return; }
        var runs = state.runs || [];
        if (!runs.length) {
            tbody.innerHTML = emptyRow();
        } else {
            tbody.innerHTML = runs.map(function (run) {
                var id = parseInt(run.id || 0, 10);
                var terminal = run.status === 'completed' || run.status === 'cancelled' || run.status === 'failed';
                return '<tr>' +
                    '<td>#' + id + '</td>' +
                    '<td><code class="acq-code">' + escapeHtml(run.model_code || '-') + '</code></td>' +
                    '<td><span class="w-badge" data-tone="' + statusTone(run.status) + '">' + escapeHtml(statusLabel(run.status)) + '</span></td>' +
                    '<td>' + Number(run.leads_saved || 0) + ' / ' + Number(run.leads_found || 0) + '</td>' +
                    '<td>' + Number(run.searches_count || 0) + '</td>' +
                    '<td>' + Number(run.input_tokens || 0) + ' + ' + Number(run.output_tokens || 0) + '</td>' +
                    '<td>' + escapeHtml(money(run.cost, run.currency)) + '</td>' +
                    '<td>' + escapeHtml(timeText(run.created_at)) + '</td>' +
                    '<td><button type="button" class="w-button" data-size="sm" data-tone="danger" data-variant="outline" data-run-cancel="' + id + '"' + (terminal ? ' disabled' : '') + '>取消</button></td>' +
                    '</tr>';
            }).join('');
        }
        setText('run-list-status', state.runs.length + ' 条');
    }

    function loadRuns() {
        op('runList', { page: 1, page_size: 20 }).then(function (result) {
            state.runs = Array.isArray(result.items) ? result.items : [];
            renderRuns();
        }).catch(function (error) {
            setText('run-list-status', errorText(error, '运行记录加载失败'));
        });
    }

    function createRun() {
        var websiteId = parseInt(value('run-website') || '-1', 10);
        if (websiteId < 0) {
            setText('run-create-status', '请先选择要获客的网站。');
            return;
        }
        var mode = state.modelMode;
        var payload = {
            website_id: websiteId,
            model_mode: mode,
            prompt_profile_id: parseInt(value('run-prompt') || '0', 10),
            target_count: parseInt(value('run-target') || '10', 10),
            max_iterations: parseInt(value('run-iterations') || '8', 10),
            context: value('run-context')
        };
        if (mode === 'ai_module') {
            var modelCode = value('run-model');
            if (!modelCode) {
                setText('run-create-status', '请选择 AI 模块模型。');
                return;
            }
            payload.model_code = modelCode;
        } else if (mode === 'local_computer') {
            var localEndpoint = value('run-local-endpoint');
            var localModel = value('run-local-model');
            if (!localEndpoint || !localModel) {
                setText('run-create-status', '请填写本地模型服务地址与模型名。');
                return;
            }
            payload.local_endpoint = localEndpoint;
            payload.local_model = localModel;
        } else {
            payload.browser_model = value('run-browser-model') || 'chrome-builtin';
        }
        setText('run-create-status', '创建中…');
        op('runCreate', {
            payload: payload
        }).then(function (result) {
            if (!result || result.success === false) { throw new Error((result && result.message) || '创建失败'); }
            state.ticket = result.ticket || '';
            byId('run-ticket').textContent = state.ticket;
            byId('run-ticket-box').hidden = false;
            var bridgeBase = (value('run-bridge-base') || window.location.origin).replace(/\/+$/, '');
            byId('run-sse-url').textContent = bridgeBase + '/ai_acquisition/frontend/bridge/stream?ticket=' + encodeURIComponent(state.ticket);
            setText('run-create-status', '已创建运行 #' + (result.id || ''));
            loadRuns();
        }).catch(function (error) {
            setText('run-create-status', errorText(error, '创建失败'));
        });
    }

    byId('run-website').addEventListener('change', function () {
        var websiteId = value('run-website');
        if (websiteId !== '' && websiteId !== '-1') {
            window.location.href = window.location.pathname + '?website_id=' + encodeURIComponent(websiteId);
        }
    });
    byId('run-site-picker').addEventListener('click', function (event) {
        var option = event.target.closest('[data-acq-site-id]');
        if (!option) { return; }
        var select = byId('run-website');
        select.value = option.getAttribute('data-acq-site-id');
        select.dispatchEvent(new Event('change', { bubbles: true }));
    });
    byId('run-mode-picker').addEventListener('click', function (event) {
        var option = event.target.closest('[data-model-mode]');
        if (!option) { return; }
        setModelMode(option.getAttribute('data-model-mode'));
    });
    byId('run-model').addEventListener('change', refreshPrice);
    byId('run-iterations').addEventListener('change', refreshPrice);
    byId('run-create').addEventListener('click', createRun);
    byId('run-refresh').addEventListener('click', loadRuns);
    byId('run-copy-ticket').addEventListener('click', function () {
        if (!state.ticket) { return; }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(state.ticket).then(function () { setText('run-create-status', '票据已复制。'); });
        }
    });
    byId('run-tbody').addEventListener('click', function (event) {
        var button = event.target.closest('[data-run-cancel]');
        if (!button) { return; }
        var id = parseInt(button.getAttribute('data-run-cancel') || '0', 10);
        if (!id) { return; }
        op('runCancel', { id: id }).then(function () { return loadRuns(); }).catch(function (error) {
            setText('run-list-status', errorText(error, '取消失败'));
        });
    });

    renderRuns();
    loadWebsiteProfile();
    setModelMode('ai_module');
    window.setInterval(loadRuns, 5000);
})();
</script>
