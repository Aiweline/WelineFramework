{
  "manifest_version": 3,
  "name": "Weline AI 获客浏览器桥",
  "version": "1.3.0",
  "description": "在用户浏览器内执行获客搜索与页面抽取；页面出现票据时悬浮助手自动弹出并桥接 Weline AI 获客运行。",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "aiLanguageModel",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Weline AI 获客",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assistant.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
