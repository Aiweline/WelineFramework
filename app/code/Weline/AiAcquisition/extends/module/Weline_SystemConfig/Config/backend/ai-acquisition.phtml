        default="你是面向零售商 {{company}} 的开发信写手。该公司位于 {country}。请根据来源证据「{evidence}」（来源页面：{site}）撰写一封英文开发信，强调批发合作、稳定供货与零售终端的吸引力，以一个问题结尾引导回复。不报价、不报 MOQ、不承诺交期。"
        scope="global,website"
    />
    <w:config:field
        key="ai_acquisition/prompt/rental_studio"
        label="租赁工作室提示词模板"
        description="线索类型 rental_studio。变量：{company} {country} {type} {evidence} {site}。"
        type="textarea"
        value-type="string"
        default="你是面向租赁工作室 {company} 的开发信写手。该公司位于 {country}。请根据来源证据「{evidence}」（来源页面：{site}）撰写一封英文开发信，强调汉服/礼服租赁场景的品类合作与长租供货，以一个问题结尾引导回复。不报价、不报 MOQ、不承诺交期。"
        scope="global,website"
    />
    <w:config:field
        key="ai_acquisition/prompt/supplier_factory"
        label="供应商工厂提示词模板"
        description="线索类型 supplier_factory。变量：{company} {country} {type} {evidence} {site}。"
        type="textarea"
        value-type="string"
        default="你是面向供应商/工厂 {company} 的开发信写手。该公司位于 {country}。请根据来源证据「{evidence}」（来源页面：{site}）撰写一封英文开发信，强调 OEM/ODM 合作、品质与产能互补，以一个问题结尾引导回复。不报价、不报 MOQ、不承诺交期。"
        scope="global,website"
    />
    <w:config:field
        key="ai_acquisition/prompt/media_guide"
        label="媒体/导购提示词模板"
        description="线索类型 media_guide。变量：{company} {country} {type} {evidence} {site}。"
        type="textarea"
        value-type="string"
        default="你是面向媒体/导购平台 {company} 的开发信写手。该公司位于 {country}。请根据来源证据「{evidence}」（来源页面：{site}）撰写一封英文开发信，提出内容合作、品牌曝光与联合推广的可能性，以一个问题结尾引导回复。不报价、不报 MOQ、不承诺交期。"
        scope="global,website"
    />
    <w:config:field
        key="ai_acquisition/prompt/directory"
        label="目录/名录提示词模板"
        description="线索类型 directory。变量：{company} {country} {type} {evidence} {site}。"
        type="textarea"
        value-type="string"
        default="你是面向目录/名录站点 {company} 的开发信写手。该公司位于 {country}。请根据来源证据「{evidence}」（来源页面：{site}）撰写一封英文开发信，提出收录、列表合作或资源互换的可能性，以一个问题结尾引导回复。不报价、不报 MOQ、不承诺交期。"
        scope="global,website"
    />
</w:config:group>
