                                    if ($isSelf || $isDescendant) { continue; }
                                    ?>
                                    <option value="<?= $optionId ?>"
                                            data-path="<?= $escape($option['path']) ?>"
                                            <?= $optionId === $parentId ? 'selected' : '' ?>>
