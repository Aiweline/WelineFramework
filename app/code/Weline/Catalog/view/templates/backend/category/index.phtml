<?php
/** @var \Weline\Framework\View\Template $this */
$catalogs = is_array($this->getData('categories_tree')) ? $this->getData('categories_tree') : [];
$category = $this->getData('category');
$websiteId = max(0, (int)($this->getData('website_id') ?? 0));
$storeId = max(0, (int)($this->getData('store_id') ?? 0));
$channelId = max(0, (int)($this->getData('channel_id') ?? 0));
$grantVersionCreate = max(0, (int)($this->getData('grant_version_create') ?? 0));
$grantVersionUpdate = max(0, (int)($this->getData('grant_version_update') ?? 0));
$grantVersionDelete = max(0, (int)($this->getData('grant_version_delete') ?? 0));
$space = trim((string)($this->getData('space') ?? 'product'));
$scopeLevel = trim((string)($this->getData('scope_level') ?? 'website'));
$isStructureMode = (bool)($this->getData('is_structure_mode') ?? ($scopeLevel === 'website'));
$spaces = is_array($this->getData('spaces')) ? $this->getData('spaces') : [];
$displaySelection = is_array($this->getData('display_selection')) ? $this->getData('display_selection') : [];
$error = (string)($this->getData('error') ?? '');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$enabledMap = [];
foreach ($displaySelection as $row) {
    if (!is_array($row)) {
        continue;
    }
    $cid = max(0, (int)($row['category_id'] ?? 0));
    if ($cid > 0) {
        $enabledMap[$cid] = (int)($row['enabled'] ?? 0) === 1;
    }
}
$catalogValue = static function (mixed $row, string $key, mixed $default = ''): mixed {
    if (is_array($row)) {
        return $row[$key] ?? $default;
    }
    if (is_object($row) && method_exists($row, 'getData')) {
        $value = $row->getData($key);
        return $value === null ? $default : $value;
    }
    return $default;
};
$selectedId = is_array($category)
    ? max(0, (int)($category['category_id'] ?? $category['id'] ?? 0))
    : max(0, (int)($this->getData('selected_category_id') ?? 0));
$isNew = (int)($this->getData('is_new_category') ?? 0) === 1 || (int)($this->request->getGet('new') ?? 0) === 1;
$editing = $isNew || $selectedId > 0;
$parentId = $isNew
    ? max(0, (int)($this->getData('create_parent_id') ?? (int)($this->request->getGet('pid') ?? 0)))
    : max(0, (int)$catalogValue($category, 'parent_id', 0));
$isActive = $isNew || (int)$catalogValue($category, 'is_active', 1) === 1;
$categoryCode = $isNew ? '' : (string)$catalogValue($category, 'code', '');
$categoryPath = $isNew ? '' : (string)$catalogValue($category, 'path', '');
$googleTaxonomyId = $isNew ? '' : (string)$catalogValue($category, 'google_taxonomy_id', '');
$categoryImage = $isNew ? '' : (string)$catalogValue($category, 'image', '');
$categoryBanner = $isNew ? '' : (string)$catalogValue($category, 'banner', '');
$categorySummary = $isNew ? '' : (string)$catalogValue($category, 'summary', '');
$categoryDescription = $isNew ? '' : (string)$catalogValue($category, 'description', '');
$imageMaxBytes = \Weline\Catalog\Service\CategoryMediaConstraints::IMAGE_MAX_BYTES;
$bannerMaxBytes = \Weline\Catalog\Service\CategoryMediaConstraints::BANNER_MAX_BYTES;
$imageRecW = \Weline\Catalog\Service\CategoryMediaConstraints::IMAGE_RECOMMEND_WIDTH;
$imageRecH = \Weline\Catalog\Service\CategoryMediaConstraints::IMAGE_RECOMMEND_HEIGHT;
$bannerRecW = \Weline\Catalog\Service\CategoryMediaConstraints::BANNER_RECOMMEND_WIDTH;
$bannerRecH = \Weline\Catalog\Service\CategoryMediaConstraints::BANNER_RECOMMEND_HEIGHT;
$flatCatalogs = [];
$flatten = function (array $nodes, int $depth = 0, array $ancestors = []) use (&$flatten, &$flatCatalogs): void {
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        $id = max(0, (int)($node['category_id'] ?? $node['id'] ?? 0));
        if ($id === 0) {
            continue;
        }
        $flatCatalogs[] = [
            'id' => $id,
            'name' => (string)($node['name'] ?? ''),
            'path' => (string)($node['path'] ?? ''),
            'code' => (string)($node['code'] ?? ''),
            'depth' => $depth,
            'ancestors' => $ancestors,
        ];
        $children = is_array($node['nodes'] ?? null) ? $node['nodes'] : [];
        if ($children !== []) {
            $flatten($children, $depth + 1, [...$ancestors, $id]);
        }
    }
};
$flatten($catalogs);
$catalogPath = 'weline_catalog/backend/category/index';
$catalogPageParams = function (array $params = []) use ($websiteId, $storeId, $channelId, $space, $scopeLevel): array {
    return [
        'space' => $space,
        'scope_level' => $scopeLevel,
        'website_id' => $websiteId,
        'store_id' => $storeId,
        'channel_id' => $channelId,
        ...$params,
    ];
};
// PHP echo 树链接仍需绝对 URL
$catalogPageUrl = function (array $params = []) use ($catalogPath, $catalogPageParams): string {
    return (string)$this->getBackendUrl($catalogPath, $catalogPageParams($params));
};
$renderTree = function (array $nodes) use (&$renderTree, $escape, $selectedId, $catalogPageUrl, $isStructureMode): void {
    if ($nodes === []) {
        return;
    }
    echo '<ul class="w-tree" data-category-tree-list role="group">';
    foreach (array_values($nodes) as $index => $node) {
        if (!is_array($node)) {
            continue;
        }
        $id = max(0, (int)($node['category_id'] ?? $node['id'] ?? 0));
        if ($id === 0) {
            continue;
        }
        $name = (string)($node['name'] ?? '');
        $pid = max(0, (int)($node['parent_id'] ?? $node['pid'] ?? 0));
        $level = max(1, (int)($node['level'] ?? 1));
        $path = (string)($node['path'] ?? '');
        $status = strtolower(trim((string)($node['status'] ?? 'active')));
        $isActive = (int)($node['is_active'] ?? 1) === 1 && $status !== 'inactive';
        $pathNorm = strtolower(trim(str_replace('\\', '/', $path), '/'));
        // Hide retired dropship shell branch (and inactive rows) — no blunt「货源」top folders.
        if (!$isActive || $pathNorm === 'sourcing' || str_starts_with($pathNorm, 'sourcing/')) {
            continue;
        }
        $nodeImage = trim((string)($node['image'] ?? ''));
        $children = is_array($node['nodes'] ?? null) ? $node['nodes'] : [];
        $hasChildren = false;
        foreach ($children as $child) {
            if (!is_array($child)) {
                continue;
            }
            $childId = max(0, (int)($child['category_id'] ?? $child['id'] ?? 0));
            if ($childId <= 0) {
                continue;
            }
            $childStatus = strtolower(trim((string)($child['status'] ?? 'active')));
            $childActive = (int)($child['is_active'] ?? 1) === 1 && $childStatus !== 'inactive';
            $childPath = strtolower(trim(str_replace('\\', '/', (string)($child['path'] ?? '')), '/'));
            if ($childActive && $childPath !== 'sourcing' && !str_starts_with($childPath, 'sourcing/')) {
                $hasChildren = true;
                break;
            }
        }
        $rowState = $selectedId === $id ? 'selected' : 'idle';
        $rowClass = $isStructureMode
            ? 'w-tree__row w-catalog-tree__row w-catalog-tree__row--draggable'
            : 'w-tree__row w-catalog-tree__row';
        $itemAttrs = ' class="w-catalog-tree__item" data-category-node data-id="' . $id . '" data-pid="' . $pid . '" data-level="' . $level . '" role="treeitem"';
        if ($hasChildren) {
            $itemAttrs .= ' aria-expanded="true"';
        }
        echo '<li' . $itemAttrs . '>';
        if ($isStructureMode) {
            echo '<div class="w-drop-indicator w-drop-indicator--before" data-drop-zone="before" hidden aria-hidden="true"></div>';
        }
        echo '<div class="' . $rowClass . '"' . ($isStructureMode ? ' draggable="true"' : '') . ' data-state="' . $rowState . '" data-id="' . $id . '" data-pid="' . $pid . '" data-level="' . $level . '" data-position="' . max(1, $index + 1) . '">';
        if ($hasChildren) {
            echo '<button class="w-catalog-tree__toggle" type="button" data-w-tree-toggle data-catalog-tree-toggle aria-label="'
                . $escape(__('折叠/展开')) . '"><w-icon name="chevron-right" size="sm"></w-icon></button>';
        } else {
            echo '<span class="w-catalog-tree__toggle w-catalog-tree__toggle--spacer" aria-hidden="true"></span>';
        }
        if ($isStructureMode) {
            echo '<button class="w-catalog-tree__handle" type="button" tabindex="-1" aria-hidden="true" data-drag-handle><w-icon name="menu" size="sm"></w-icon></button>';
        }
        if ($isStructureMode) {
            echo '<a class="w-catalog-tree__link" href="' . $escape($catalogPageUrl(['id' => $id])) . '"' . ($selectedId === $id ? ' aria-current="page"' : '') . '>';
        } else {
            echo '<span class="w-catalog-tree__link">';
        }
        if ($nodeImage !== '') {
            echo '<img class="w-catalog-tree__thumb" src="' . $escape($nodeImage) . '" alt="" width="20" height="20" loading="lazy">';
        } else {
            echo '<w-icon name="folder" size="sm"></w-icon>';
        }
        echo '<span>' . $escape($name) . '</span>';
        // Ops tag only — never invent blunt top-level「货源」folders; slug stays in title/editor.
        $sourcePlatform = strtoupper(trim((string)($node['source_platform'] ?? '')));
        if ($sourcePlatform !== '' && !in_array(strtolower($sourcePlatform), ['dropship', 'sourcing'], true)) {
            echo '<span class="w-badge" data-tone="info" title="' . $escape($path !== '' ? $path : '') . '">' . $escape($sourcePlatform) . '</span>';
        }
        echo $isStructureMode ? '</a>' : '</span>';
        echo '</div>';
        if ($isStructureMode) {
            echo '<div class="w-drop-indicator w-drop-indicator--inside" data-drop-zone="inside" hidden aria-hidden="true"></div>';
        }
        if ($hasChildren) {
            $renderTree($children);
        }
        if ($isStructureMode) {
            echo '<div class="w-drop-indicator w-drop-indicator--after" data-drop-zone="after" hidden aria-hidden="true"></div>';
            echo '<a class="w-catalog-tree__add" href="' . $escape($catalogPageUrl(['new' => 1, 'pid' => $id])) . '"><w-icon name="plus" size="sm"></w-icon>' . $escape(__('添加子分类')) . '</a>';
        }
        echo '</li>';
    }
    echo '</ul>';
};
