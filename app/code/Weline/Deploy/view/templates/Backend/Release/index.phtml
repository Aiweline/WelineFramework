<?php
/** * @var \Weline\Deploy\Controller\Backend\Release $this * @var array $records * @var array|null $current */
$records = $this->getData('records') ?: [];
$current = $this->getData('current');
$rollbackUrl = (string)($this->getData('rollbackUrl') ?: '');
$isProduction = !empty($this->getData('isProduction'));
$attr = static fn(string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
?>
<style> .weline-release-history .wrh-alert { background: var(--backend-color-bg-secondary, #1e293b); border: 1px solid var(--backend-color-border, #334155); color: var(--backend-color-text, #e2e8f0); }
</style> <w:backend:card class="weline-release-history"> <w:slot:header> <h5 style="--w-mb:0;"><?= __('发布历史') ?></h5> </w:slot:header> <w:slot:body> <?php if ($current): ?> <div class="w-alert wrh-alert" style="--w-mb:var(--weline-space-4);"> <strong><?= __('当前版本') ?>:</strong> <code><?= $attr((string)($current['deploy_version'] ?? '')) ?></code> <span class="w-badge ms-2" data-w-background="muted"><?= $attr((string)($current['git_ref_type'] ?? '')) ?></span> <?php if (!empty($current['git_tag'])): ?> <span class="w-badge ms-1" data-w-background="info"><?= $attr((string)$current['git_tag']) ?></span> <?php endif; ?> <span class="w-text ms-2" data-tone="muted"><?= date('Y-m-d H:i:s', (int)($current['deployed_at'] ?? 0)) ?></span> </div> <?php else: ?> <div class="w-alert wrh-alert" style="--w-mb:var(--weline-space-4);"><?= __('尚未发布过') ?></div> <?php endif; ?> <if condition="$isProduction"> <div class="w-alert wrh-alert" style="--w-mb:var(--weline-space-4);"><?= __('正式站回滚前将自动整站备份。') ?></div> </if> <?php if (empty($records)): ?> <p class="w-text" data-tone="muted"><?= __('暂无发布记录') ?></p> <?php else: ?> <div class="w-table-wrap"> <table class="w-table" style="--w-mb:0;"> <thead> <tr> <th><?= __('时间') ?></th> <th><?= __('版本') ?></th> <th><?= __('类型') ?></th> <th><?= __('触发') ?></th> <th><?= __('范围') ?></th> <th><?= __('状态') ?></th> <th><?= __('耗时') ?></th> <th><?= __('Commit') ?></th> <th></th> </tr> </thead> <tbody> <?php foreach ($records as $record): ?> <?php $status = (string)$record->getData('status'); $badgeClass = match ($status) { 'success' => 'bg-success', 'failed' => 'bg-danger', 'running' => 'bg-warning text-dark', default => '', }; $startedAt = (int)$record->getData('started_at'); $duration = $record->getData('duration_ms'); $scope = trim((string)$record->getData('project_id')); if ($scope === '') { $scope = trim((string)$record->getData('domain')); } if ($scope === '') { $scope = trim((string)$record->getData('profile_key')); } $projectType = trim((string)$record->getData('project_type')); $releaseId = (string)$record->getData('release_id'); $isCurrent = (int)$record->getData('is_current') === 1; $canRollback = $status === 'success' && !$isCurrent; ?> <tr> <td data-wrap="false"><?= $startedAt ? date('Y-m-d H:i:s', $startedAt) : '-' ?></td> <td> <code><?= $attr((string)$record->getData('deploy_version')) ?></code> <?php if ($isCurrent): ?> <span class="w-badge ms-1" data-w-background="primary"><?= __('当前') ?></span> <?php endif; ?> </td> <td> <?php if ((string)$record->getData('git_ref_type') === 'tag'): ?> <span class="w-badge" data-w-background="info"><?= __('tag') ?></span> <?php if ($record->getData('git_tag')): ?> <small class="w-text ms-1" data-tone="muted"><?= $attr((string)$record->getData('git_tag')) ?></small> <?php endif; ?> <?php else: ?> <span class="w-badge" data-w-background="muted"><?= $attr((string)$record->getData('git_ref_type')) ?></span> <?php endif; ?> </td> <td><?= $attr((string)$record->getData('trigger_type')) ?></td> <td> <?php if ($scope !== ''): ?> <code><?= $attr($scope) ?></code> <?php if ($projectType !== ''): ?> <small class="w-text ms-1" data-tone="muted"><?= $attr($projectType) ?></small> <?php endif; ?> <?php else: ?> <span class="w-text" data-tone="muted"><?= __('全局') ?></span> <?php endif; ?> </td> <td><span class="w-badge <?= $badgeClass ?>"><?= __($status) ?></span></td> <td data-wrap="false"><?= $duration ? round($duration / 1000, 1) . 's' : '-' ?></td> <td><code class="w-text" data-size="sm"><?= $attr(substr((string)$record->getData('git_commit'), 0, 8)) ?></code></td> <td class="w-text" data-align="end"> <?php if ($canRollback): ?> <button type="button" class="w-button" data-action="rollback" data-release-id="<?= $attr($releaseId) ?>" data-version="<?= $attr((string)$record->getData('deploy_version')) ?>" data-tone="warning" data-variant="outline" data-size="sm"> <?= __('回滚到此版本') ?> </button> <?php endif; ?> </td> </tr> <?php if ($status === 'failed' && $record->getData('error_message')): ?> <tr> <td colspan="9" class="w-text ps-3" data-tone="danger" data-size="sm" style="--w-pt:var(--weline-space-1);--w-pe:var(--weline-space-1);--w-pb:var(--weline-space-1);--w-ps:var(--weline-space-1);"> <?= $attr((string)$record->getData('error_message')) ?> </td> </tr> <?php endif; ?> <?php endforeach; ?> </tbody> </table> </div> <?php endif; ?> </w:slot:body>
</w:backend:card> <w:form method="post" action="@var($rollbackUrl)" id="wrh-rollback-form" hidden> <input type="hidden" name="release_id" id="wrh-release-id" value=""> <input type="hidden" name="confirm_rollback" id="wrh-confirm-rollback" value="0"> <input type="hidden" name="confirm_older_version" id="wrh-confirm-older" value="0">
</w:form> <div class="w-dialog" id="wrh-rollback-modal" tabindex="-1" aria-hidden="true" data-w-component="dialog" data-state="closed" hidden> <div class="w-dialog__frame"> <div class="w-dialog__surface"> <div class="w-dialog__header"> <h5 class="w-dialog__title"><?= __('确认回滚') ?></h5> <button type="button" class="w-button" aria-label="Close" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm"></button> </div> <div class="w-dialog__body"> <p id="wrh-rollback-summary"></p> <div class="w-alert" data-tone="warning"><?= __('回滚可能导致数据迁移、配置或代码不兼容。') ?></div> <div class="w-check" style="--w-mb:var(--weline-space-2);"> <input type="checkbox" id="wrh-ui-confirm-rollback" value="1"> <label for="wrh-ui-confirm-rollback"><?= __('我确认要回滚到此版本') ?></label> </div> <div class="w-check"> <input type="checkbox" id="wrh-ui-confirm-older" value="1"> <label for="wrh-ui-confirm-older"><?= __('我确认要回滚到更旧版本') ?></label> </div> </div> <div class="w-dialog__footer"> <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><?= __('取消') ?></button> <button type="button" class="w-button" id="wrh-run-rollback" disabled data-tone="warning"><?= __('执行回滚') ?></button> </div> </div> </div>
</div> <script>
(function () { const modalEl = document.getElementById('wrh-rollback-modal'); const modal = modalEl; const form = document.getElementById('wrh-rollback-form'); const releaseIdInput = document.getElementById('wrh-release-id'); const confirmRollbackInput = document.getElementById('wrh-confirm-rollback'); const confirmOlderInput = document.getElementById('wrh-confirm-older'); const uiConfirmRollback = document.getElementById('wrh-ui-confirm-rollback'); const uiConfirmOlder = document.getElementById('wrh-ui-confirm-older'); const runBtn = document.getElementById('wrh-run-rollback'); const summaryEl = document.getElementById('wrh-rollback-summary'); function syncState() { if (runBtn) runBtn.disabled = !(uiConfirmRollback && uiConfirmRollback.checked); } document.body.addEventListener('click', (event) => { const btn = event.target.closest('[data-action="rollback"]'); if (!btn) return; if (releaseIdInput) releaseIdInput.value = btn.dataset.releaseId || ''; if (summaryEl) summaryEl.textContent = '<?= $attr((string)__('回滚到版本')) ?> ' + (btn.dataset.version || ''); if (uiConfirmRollback) uiConfirmRollback.checked = false; if (uiConfirmOlder) uiConfirmOlder.checked = false; syncState(); if (modal) Weline.UI.dialog.open(modal); }); uiConfirmRollback?.addEventListener('change', syncState); runBtn?.addEventListener('click', () => { if (confirmRollbackInput) confirmRollbackInput.value = uiConfirmRollback && uiConfirmRollback.checked ? '1' : '0'; if (confirmOlderInput) confirmOlderInput.value = uiConfirmOlder && uiConfirmOlder.checked ? '1' : '0'; if (form) form.submit(); });
})();
</script>
