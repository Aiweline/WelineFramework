<w:config:group
    code="b2b_selling_mode"
    label="售卖模式开关"
    description="控制当前作用范围内是否开放零售与批发。商品级关闭仍优先生效。"
    sort="10"
>
    <w:config:field
        key="selling_mode_toc_enabled"
        label="启用零售（ToC）"
        description="关闭后前台不再提供零售售卖模式（已启用的批发仍可独立使用）。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website,store"
    />
    <w:config:field
        key="selling_mode_tob_enabled"
        label="启用批发（ToB）"
        description="关闭后前台不再展示批发切换入口，也无法进入批发加购与结账。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website,store"
    />
    <w:config:field
        key="b2b_credit_enabled"
        label="启用批发信用额度"
        description="开启后按 VIP 等级目标额度授信（钱包补差额），并允许 tob 订单使用 b2b_credit 优惠抵扣；关闭后不授信、不抵扣、不自动升额。与全站支付信用资产无关。"
        type="switch"
        value-type="bool"
        default="0"
        scope="global"
    />
    <w:config:field
        key="b2b_credit_min_cash_deposit_percent"
        label="定金最低现金占比（%）"
        description="使用批发信用抵扣定金时，现金定金不得低于「定金×该占比」。例：20 表示至少付 20% 现金，信用最多抵 80%，避免定金被额度抵成 0。填 0 表示允许全额抵扣。"
        type="number"
        value-type="int"
        default="20"
        scope="global"
        validation="min:0|max:100"
    />
</w:config:group>

<w:config:group
    code="b2b_default_wholesale_policy"
    label="默认批发模板与亏损护栏"
    description="商品启用批发后默认按 VIP 档继承本站模板（改模板只影响新报价/PDP，不回刷已有价目表或历史订单）。显式价目覆盖优先。"
    sort="20"
>
    <w:config:field
        key="b2b_max_discount_bps"
        label="相对零售最大折扣（基点）"
        description="100=1%。默认 2000（20%）。任意 VIP 模板档与手填批发价不得超过该上限。"
        type="number"
        value-type="int"
        default="2000"
        scope="global,website"
        validation="min:0|max:10000"
        data-testid="b2b-max-discount-bps"
        cache-namespaces="storefront/product"
    />
    <w:config:field
        key="b2b_min_margin_bps"
        label="相对成本最低毛利（基点）"
        description="0=关闭。大于 0 且商品有成本时，批发价不得低于成本×(1+毛利)。"
        type="number"
        value-type="int"
        default="0"
        scope="global,website"
        validation="min:0|max:10000"
        data-testid="b2b-min-margin-bps"
        cache-namespaces="storefront/product"
    />
    <w:config:field
        key="b2b_default_tier_policy_json"
        label="VIP0–VIP12 默认档"
        description="由批发配置页的 VIP 表格维护（起订量与折扣%）。空则按 VIP0=起订5/折扣5% 每档+5起订/+5% 并受最大折扣封顶。修改模板立即作用于继承商品的新报价/PDP；不会回刷已有价目表或历史订单。"
        type="textarea"
        value-type="json"
        default="[]"
        scope="global,website"
        data-testid="b2b-default-tier-policy-json"
        cache-namespaces="storefront/product"
    />
</w:config:group>
