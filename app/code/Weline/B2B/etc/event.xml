<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Order::order_created">
        <observer name="Weline_B2B::sync_hang_status_type_payload_created"
                  instance="Weline\B2B\Observer\SyncHangStatusTypePayloadObserver"
                  disabled="false"
                  shared="false"
                  sort="200"/>
    </event>
    <event name="Weline_Order::order_paid">
        <observer name="Weline_B2B::sync_hang_status_type_payload_paid"
                  instance="Weline\B2B\Observer\SyncHangStatusTypePayloadObserver"
                  disabled="false"
                  shared="false"
                  sort="200"/>
    </event>
    <event name="Weline_Order::order_status_changed">
        <observer name="Weline_B2B::sync_hang_status_type_payload_status"
                  instance="Weline\B2B\Observer\SyncHangStatusTypePayloadObserver"
                  disabled="false"
                  shared="false"
                  sort="200"/>
    </event>
    <event name="Weline_Framework::resource_changed"
           schema_version="1"
           async_mapper="Weline\Framework\Event\ResourceChange\ResourceChangePayloadMapper"
           data_contract="resource_change.v1">
        <observer name="Weline_B2B::default_wholesale_policy_config_resource_changed"
                  instance="Weline\B2B\Observer\DefaultWholesalePolicyConfigResourceChanged"
                  delivery="sync"
                  disabled="false"
                  shared="true"
                  sort="130"/>
    </event>
</config>
