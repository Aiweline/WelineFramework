        $hangTabHref = static function (string $tab) use ($hangTabQueryBase): string {
            $q = $hangTabQueryBase;
            $q['hang_tab'] = $tab;
            $parts = [];
            foreach ($q as $k => $v) {
                if ($v === null || $v === '') {
                    continue;
                }
                $parts[] = rawurlencode((string)$k) . '=' . rawurlencode((string)$v);
            }

            return '?' . implode('&', $parts);
        };
        $hangTabs = [
            'awaiting' => __('等待审批'),
            'deposit' => __('待付定金'),
