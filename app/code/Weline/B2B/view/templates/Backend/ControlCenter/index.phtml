        };
        $shortRef = static function (string $value, int $keep = 12) use ($escape): string {
            $value = trim($value);
            if ($value === '') {
                return '—';
            }
            if (strlen($value) <= $keep + 1) {
                return $escape($value);
            }

            return $escape(substr($value, 0, $keep) . '…');
        };
