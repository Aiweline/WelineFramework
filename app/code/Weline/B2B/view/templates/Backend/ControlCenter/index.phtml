<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('B2B 管理'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$form = (array)($this->getData('workspace_form') ?? []);
$kind = (string)($form['kind'] ?? '');
$formActionUrl = $form === [] ? '' : $this->getBackendUrl((string)($form['action'] ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) return $value ? (string)__('是') : (string)__('否');
    if (is_array($value)) return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    return $escape($value);
};
?>
<section class="commerce-control-center" data-testid="b2b-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between"><h4 class="mb-sm-0"><?= $escape($title) ?></h4><span class="badge <?= $form === [] ? 'bg-info text-dark' : 'bg-success' ?>"><?= $form === [] ? __('只读诊断') : __('可管理') ?></span></div>
    <div class="alert alert-info" role="status"><?= $form === [] ? __('此页面显示不可变报价与订单价格快照；生产迁移仍由受控 CLI 完成。') : __('写操作受 B2B rollout 门禁保护，并复用候选解析、报价重检与不可变快照服务。') ?></div>
    <?php if ($form !== []): ?>
        <div class="card mb-3" data-testid="b2b-<?= $escape($code) ?>-write-form"><div class="card-header"><h5 class="mb-0"><?= $kind === 'quote' ? __('签发并审批报价') : __('新增配置') ?></h5></div><div class="card-body">
            <w:form method="post" action="@var($formActionUrl)"><div class="row g-3">
                <?php if ($kind === 'group'): ?>
                    <div class="col-md-3"><label class="form-label"><?= __('客户组 ID') ?></label><input class="form-control" name="group_id" maxlength="64" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('网站 ID') ?></label><input class="form-control" type="number" min="0" name="website_id" value="0" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('代码') ?></label><input class="form-control" name="code" maxlength="64" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('状态') ?></label><select class="form-select" name="status"><option value="active">active</option><option value="disabled">disabled</option></select></div>
                <?php elseif ($kind === 'price-list'): ?>
                    <div class="col-md-3"><label class="form-label"><?= __('价目表 ID') ?></label><input class="form-control" name="list_id" maxlength="64" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('客户组 ID') ?></label><input class="form-control" name="group_id" maxlength="64" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('网站 ID') ?></label><input class="form-control" type="number" min="0" name="website_id" value="0" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('版本') ?></label><input class="form-control" type="number" min="1" name="version" value="1" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('SKU') ?></label><input class="form-control" name="sku" maxlength="128" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('金额（分）') ?></label><input class="form-control" type="number" min="0" name="amount_minor" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('渠道 ID（可选）') ?></label><input class="form-control" name="channel_id" maxlength="64"></div>
                <?php else: ?>
                    <div class="col-md-3"><label class="form-label"><?= __('客户 ID') ?></label><input class="form-control" name="customer_id" maxlength="64" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('网站 ID') ?></label><input class="form-control" type="number" min="0" name="website_id" value="0" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('SKU') ?></label><input class="form-control" name="sku" maxlength="128" required></div>
                    <div class="col-md-2"><label class="form-label"><?= __('零售价（分）') ?></label><input class="form-control" type="number" min="0" name="retail_amount_minor" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('订单引用') ?></label><input class="form-control" name="order_ref" maxlength="64" required></div>
                    <div class="col-md-3"><label class="form-label"><?= __('渠道 ID（可选）') ?></label><input class="form-control" name="channel_id" maxlength="64"></div>
                <?php endif; ?>
                <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit" data-testid="b2b-<?= $escape($code) ?>-submit"><?= $kind === 'quote' ? __('审批报价') : __('保存') ?></button></div>
            </div></w:form>
        </div></div>
    <?php endif; ?>
    <?php if ($status !== []): ?><div class="card mb-3"><div class="card-body"><div class="row g-3"><?php foreach ($status as $key => $value): ?><div class="col-md-4"><div class="text-muted small"><?= $escape($key) ?></div><div class="fw-semibold"><?= $display($value) ?></div></div><?php endforeach; ?></div></div></div><?php endif; ?>
    <?php foreach ($datasets as $dataset): ?><div class="card mb-3"><div class="card-header"><h5 class="mb-0"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="card-body">
        <?php if (!empty($dataset['error'])): ?><div class="alert alert-warning mb-0"><?= $escape($dataset['error']) ?></div><?php elseif (empty($dataset['rows'])): ?><div class="text-muted"><?= __('当前没有记录。') ?></div><?php else: ?>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody><?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
