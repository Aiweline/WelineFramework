            'rejected' => __('已驳回'),
            'expired' => __('已过期'),
            'all' => __('全部'),
        ];
        $hangStatusLabel = static function (string $status): string {
            return match ($status) {
                'awaiting_deposit' => (string)__('待付定金'),
                'awaiting_merchant_approval' => (string)__('待商家审批'),
                'awaiting_balance' => (string)__('待付尾款'),
                'completed' => (string)__('已完成'),
                'rejected' => (string)__('已驳回'),
                'expired' => (string)__('已过期'),
                default => $status,
            };
        };
        $hangStatusTone = static function (string $status): string {
            return match ($status) {
                'completed' => 'success',
                'rejected', 'expired' => 'danger',
                'awaiting_merchant_approval', 'awaiting_deposit', 'awaiting_balance' => 'warning',
                default => 'muted',
            };
        };
        $formatHangMinor = static function (mixed $minor) use ($baseCurrencyCode, $escape): string {
            $amount = number_format(((int)$minor) / 100, 2, '.', '');

