<?php
/** @var \Weline\Framework\View\Template $this */
$selectedScope = (string)($this->getData('selected_scope') ?? $this->getData('target_scope') ?? 'default.default.default');
$scopeKind = (string)($this->getData('scope_kind') ?? 'global');
$scopeId = (int)($this->getData('work_scope_id') ?? 0);
$storeCode = (string)($this->getData('scope_store_code') ?? '');
$channelCode = (string)($this->getData('scope_channel_code') ?? '');
$metaParts = [$scopeKind !== '' ? $scopeKind : 'global'];
if ($storeCode !== '') {
    $metaParts[] = 'store=' . $storeCode;
}
if ($channelCode !== '') {
    $metaParts[] = 'channel=' . $channelCode;
}
if ($scopeKind !== 'global') {
    $metaParts[] = 'website_id=' . $scopeId;
}
$globalHint = (string)__('Global 表示全部站点；选择具体网站 / 店铺 / 渠道后本页列表按范围过滤。');
