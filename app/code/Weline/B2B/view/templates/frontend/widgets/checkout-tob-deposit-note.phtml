<?php
/**
 * Wholesale credit apply panel (checkout / mini-cart / cart summary tabs).
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {b2b-checkout-credit}
 * @widget.name {批发信用}
 * @widget.description {结账/迷你车/购物车：批发信用抵扣本期定金（资产类，非营销券）}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["summary","content","footer"]}
 * @widget.page_layouts {["checkout","mini-cart","cart"]}
 * @widget.slot {checkout-summary-credit}
 * @widget.supports {["checkout-summary-credit","cart-summary-credit","footer-extras","layout-mini-cart-footer-extras","mini-cart-footer-extras","b2b-checkout-credit","b2b-deposit-note","b2b"]}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-summary-credit","area":"content","sort_order":15,"required":true,"reason":"批发结账时展示批发信用页签","config":{"title":"批发信用","surface":"checkout"}},{"layout_type":"mini-cart","layout_option":"default","slot":"footer-extras","area":"footer","sort_order":15,"required":true,"reason":"批发迷你车展示批发信用","config":{"title":"批发信用","surface":"mini-cart","compact":true}},{"layout_type":"cart","layout_option":"default","slot":"cart-summary-credit","area":"content","sort_order":15,"required":true,"reason":"批发购物车展示批发信用","config":{"title":"批发信用","surface":"cart"}}]}
 */

use Weline\B2B\Service\B2BPaymentAssetPolicyProvider;
use Weline\Framework\Manager\ObjectManager;

$creditEnabled = true;
$minCashPercent = B2BPaymentAssetPolicyProvider::DEFAULT_MIN_CASH_DEPOSIT_PERCENT;
try {
    /** @var B2BPaymentAssetPolicyProvider $policy */
    $policy = ObjectManager::getInstance(B2BPaymentAssetPolicyProvider::class);
    $creditEnabled = $policy->isEnabled();
    $minCashPercent = $policy->minCashDepositPercent();
} catch (\Throwable) {
    $creditEnabled = true;
    $minCashPercent = B2BPaymentAssetPolicyProvider::DEFAULT_MIN_CASH_DEPOSIT_PERCENT;
}
if (!$creditEnabled) {
    return;
}

$minCashPercent = max(0, min(100, (int)$minCashPercent));
$maxCreditPercent = max(0, 100 - $minCashPercent);

$rawTitle = trim((string)($this->getData('title') ?? ''));
$title = $rawTitle !== '' ? (string)__($rawTitle) : (string)__('批发信用');
$surfaceRaw = strtolower(trim((string)($this->getData('surface') ?? 'checkout')));
$surface = in_array($surfaceRaw, ['checkout', 'mini-cart', 'cart'], true) ? $surfaceRaw : 'checkout';
$inputId = 'b2b-credit-apply-input-' . preg_replace('/[^a-z0-9\-]+/', '-', $surface);
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<link rel="stylesheet" href="@static(Weline_B2B::css/b2b-storefront.css)&v=20260911-credit-contrast1" data-no-extract="true">
<div class="w-b2b-checkout-credit"
     data-b2b-checkout-credit
     data-b2b-credit-surface="<?= $esc($surface) ?>"
     data-cart-type="tob"
     data-b2b-min-cash-percent="<?= $esc((string)$minCashPercent) ?>"
     data-testid-credit="b2b-checkout-credit"
     data-weline-load="b2bCheckoutTob"
     data-mini-cart-tab-label="<?= $esc($title) ?>"
     data-i18n-toc-unavailable="<?= $esc((string)__('当前是零售结账，批发信用只能在「批发车」使用。请先到购物车切换到批发车，再回来结账。')) ?>"
     data-i18n-quote-missing="<?= $esc((string)__('暂时无法获取批发信用报价，请刷新后重试')) ?>"
     data-i18n-quote-loading="<?= $esc((string)__('正在获取批发信用报价…')) ?>"
     data-i18n-reason-disabled="<?= $esc((string)__('站点未开启批发信用额度')) ?>"
     data-i18n-reason-no-balance="<?= $esc((string)__('额度不够：暂无可用批发信用余额')) ?>"
     data-i18n-reason-fx="<?= $esc((string)__('暂无汇率，无法使用批发信用')) ?>"
     data-i18n-reason-na="<?= $esc((string)__('暂无法估算本期定金，无法用批发信用抵扣')) ?>"
     data-i18n-reason-login="<?= $esc((string)__('请先登录后再使用批发信用')) ?>"
     data-i18n-reason-zero="<?= $esc((string)__('额度不够：本单可抵扣额度为 0')) ?>"
     data-i18n-reason-quote-failed="<?= $esc((string)__('暂时无法获取批发信用报价，请刷新后重试')) ?>">
    <label class="w-b2b-checkout-credit__label" data-mini-cart-tab-label-source>
        <?= $esc($title) ?>
    </label>
    <div class="w-b2b-checkout-credit__body">
        <div class="b2b-checkout-credit"
             data-b2b-credit-panel
             data-testid="b2b-checkout-credit">
            <p class="w-text w-b2b-checkout-credit__blurb"
               data-size="sm"
               data-testid="b2b-credit-blurb"
               style="--w-mb:var(--weline-space-2);">
                <lang>只抵本期定金（约商品小计 30%），不抵尾款。现金定金须保留至少</lang>
                <strong data-testid="b2b-credit-min-cash-percent"><?= $esc((string)$minCashPercent) ?>%</strong>
                <lang>（信用最多可抵定金的</lang>
                <strong><?= $esc((string)$maxCreditPercent) ?>%</strong>
                <lang>）。额度用完同档不自动回补。</lang>
            </p>
            <div class="w-b2b-checkout-credit__row">
                <label class="w-b2b-checkout-credit__toggle">
                    <input type="checkbox"
                           data-b2b-credit-toggle
                           data-testid="b2b-credit-toggle">
                    <span><lang>使用批发信用抵扣本期定金</lang></span>
                </label>
                <button type="button"
                        class="w-b2b-checkout-credit__help"
                        data-w-component="tooltip"
                        data-b2b-credit-help
                        data-testid="b2b-credit-help"
                        aria-label="<?= $esc((string)__('批发信用说明')) ?>">?</button>
            </div>
            <?php /* 就地原因：勾选正下方；不可用时由 JS 写入，禁止藏到页签外 */ ?>
            <p class="w-text w-b2b-checkout-credit__reason"
               data-tone="danger"
               role="status"
               aria-live="polite"
               data-b2b-credit-reason
               data-b2b-credit-toc-msg
               data-b2b-credit-unavailable
               data-testid="b2b-credit-reason"
               hidden></p>
            <p class="w-text w-b2b-checkout-credit__fx"
               data-size="sm"
               data-b2b-credit-fx
               data-testid="b2b-credit-fx"
               hidden></p>
            <div class="w-b2b-checkout-credit__amount">
                <label class="w-b2b-checkout-credit__amount-label" for="<?= $esc($inputId) ?>"><lang>抵扣额度</lang></label>
                <div class="w-b2b-checkout-credit__amount-row">
                    <input id="<?= $esc($inputId) ?>"
                           type="text"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="0.00"
                           disabled
                           data-b2b-credit-input
                           data-testid="b2b-credit-input"
                           class="w-input w-b2b-checkout-credit__amount-input"
                           aria-describedby="<?= $esc($inputId) ?>-currency">
                    <span id="<?= $esc($inputId) ?>-currency"
                          class="w-text w-b2b-checkout-credit__currency"
                          data-b2b-credit-currency
                          data-testid="b2b-credit-currency"
                          hidden></span>
                </div>
            </div>
            <p class="w-text" data-tone="muted" data-b2b-credit-hint data-testid="b2b-credit-hint" hidden></p>
            <p class="w-text w-b2b-checkout-credit__cash" data-b2b-credit-cash data-testid="b2b-credit-cash" hidden></p>
            <div class="w-b2b-checkout-credit__links">
                <a class="w-text" data-tone="muted" href="/cart" data-b2b-credit-switch-cart data-testid="b2b-credit-switch-cart" hidden><lang>去购物车切换批发车</lang></a>
                <a class="w-text" data-tone="muted" href="/faq/b2b-wholesale" data-b2b-credit-faq data-testid="b2b-credit-faq"><lang>了解批发信用规则</lang></a>
            </div>
            <template data-b2b-credit-tooltip-body></template>
        </div>
    </div>
</div>
