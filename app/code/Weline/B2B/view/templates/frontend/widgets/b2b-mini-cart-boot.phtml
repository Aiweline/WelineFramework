use Weline\Framework\Runtime\RequestContext;
use Weline\Theme\Helper\WidgetI18n;

$isBackend = str_contains(strtolower((string)($_SERVER['REQUEST_URI'] ?? '')), '/admin');
if ($isBackend) {
    return;
}

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$sellingMode = 'toc';
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
WidgetI18n::prefetchLabels([
    '零售',
    '批发',
    '零售车',
    '批发车',
    '批发车是空的',
    '批发车需登录后使用',
    '开通批发身份后可使用批发车',
    '批发不可用',
    '关税与进口税费未计入本次定金，到港由买家另付',
]);
$t = static fn (string $word): string => $esc(WidgetI18n::label($word));
?>
