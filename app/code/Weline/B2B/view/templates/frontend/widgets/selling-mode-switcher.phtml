     data-i18n-submitted="<?= $escape(__('申请已提交，请等待审核')) ?>"
     data-i18n-waiting="<?= $escape(__('等待申请通过')) ?>"
     data-i18n-reapply="<?= $escape(__('修改后重新提交')) ?>"
     data-i18n-apply="<?= $escape(__('申请批发身份')) ?>"
     data-i18n-submit-failed="<?= $escape(__('申请提交失败')) ?>"
     data-i18n-login-required="<?= $escape(__('请先登录后再提交申请')) ?>"
     data-i18n-login-chooser-missing="<?= $escape(__('快捷登录暂不可用，请前往登录页。')) ?>"
     data-i18n-go-login="<?= $escape(__('前往登录')) ?>"
     data-login-url="@url{'customer/account/login'}"
     data-weline-load="b2bSellingMode"
     data-testid="b2b-selling-mode">
    <?php /* 复用本页 product-native-detail 尺码/类型轴：同一套标签+胶囊选项，不另造按钮体系 */ ?>
    <span class="product-native-detail__variant-axis-label" id="<?= $escape($drawerId) ?>-mode-label"><lang>购买方式</lang>:</span>
    <div class="product-native-detail__variant-axis-options"
         role="group"
         aria-labelledby="<?= $escape($drawerId) ?>-mode-label"
         data-testid="selling-mode-segment">
        <?php if ($tocEnabled): ?>
            <button type="button"
                    class="product-native-detail__variant-option<?= $sellingMode === 'toc' ? ' is-selected' : '' ?>"
                    data-selling-mode-option="toc"
                    data-state="<?= $sellingMode === 'toc' ? 'active' : 'inactive' ?>"
                    aria-pressed="<?= $sellingMode === 'toc' ? 'true' : 'false' ?>"
                    data-testid="selling-mode-toc">
                <lang>零售</lang>
            </button>
        <?php endif; ?>
        <?php if ($tobEnabled): ?>
            <button type="button"
                    class="product-native-detail__variant-option<?= $sellingMode === 'tob' ? ' is-selected' : '' ?>"
                    data-selling-mode-option="tob"
                    data-state="<?= $sellingMode === 'tob' ? 'active' : 'inactive' ?>"
                    aria-pressed="<?= $sellingMode === 'tob' ? 'true' : 'false' ?>"
                    data-testid="selling-mode-tob">
                <lang>批发</lang>
            </button>
        <?php endif; ?>
    </div>
    <p class="b2b-selling-mode__hint product-native-detail__price-label" data-b2b-tob-moq-hint <?= ($sellingMode === 'tob' && $loggedIn && $hasMembership) ? '' : 'hidden' ?>>
        <lang>批发起订</lang> <?= (int)$moq ?> <lang>件</lang> · <lang>步进</lang> <?= (int)$qtyStep ?>
    </p>
    <p class="b2b-selling-mode__hint product-native-detail__price-label" data-b2b-guest-tob-hint <?= ($sellingMode === 'tob' && !$loggedIn) ? '' : 'hidden' ?>>
        <lang>切换批发需先登录</lang>
    </p>
