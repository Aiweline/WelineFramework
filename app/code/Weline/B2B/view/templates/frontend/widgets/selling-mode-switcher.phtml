 * PDP selling-mode switcher + wholesale membership apply drawer.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {b2b-selling-mode-switcher}
 * @widget.name {售卖模式切换}
 * @widget.description {商品详情价格旁 ToC/ToB 分段切换；批发身份申请抽屉}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.slot {product-selling-mode}
 * @widget.supports {["product-selling-mode","layout-product-selling-mode","b2b-selling-mode"]}
