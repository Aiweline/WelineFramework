<?php
/**
 * PDP selling-mode switcher + wholesale membership apply drawer.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {b2b-selling-mode-switcher}
 * @widget.name {售卖模式切换}
 * @widget.description {商品详情价格旁 ToC/ToB 分段切换；批发身份申请抽屉}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.slot {product-selling-mode}
 * @widget.supports {["product-selling-mode","layout-product-selling-mode","b2b-selling-mode"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-selling-mode", "area":"content", "sort_order":0, "required":true, "reason":"商品详情价格旁默认展示 ToC/ToB 售卖模式切换", "config":{} }]}
 */

use Weline\B2B\Service\MembershipStatusProjection;
use Weline\B2B\Service\SellingModePolicy;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$storeId = max(0, (int)RequestContext::getWelineStoreId());

$tocEnabled = true;
$tobEnabled = true;
$moq = SellingModePolicy::DEFAULT_MOQ;
$qtyStep = SellingModePolicy::DEFAULT_QTY_STEP;
$offerForFlags = [];
try {
    if (class_exists(\Weline\Product\Helper\StorefrontOfferResolver::class)) {
        $offerForFlags = \Weline\Product\Helper\StorefrontOfferResolver::resolve($this);
    }
} catch (\Throwable) {
    $offerForFlags = [];
}
$skuForGate = trim((string)($offerForFlags['sku'] ?? ''));

// No active price-list tier: omit the widget. Do not hydrate EAV or selling-mode
// config on this path — those queries only matter when wholesale UI can render.
try {
    /** @var \Weline\B2B\Service\ProductWholesaleEligibility $eligibility */
    $eligibility = ObjectManager::getInstance(\Weline\B2B\Service\ProductWholesaleEligibility::class);
    if (!$eligibility->allowsWholesaleDisplay($websiteId, $storeId, null, $skuForGate)) {
        $tobEnabled = false;
    }
} catch (\Throwable) {
    $tobEnabled = false;
}

if (!$tobEnabled) {
    if (RequestContext::isInitialized()) {
        RequestContext::set('b2b.pdp_wholesale_display', false);
    }
    return;
}

$productFlags = null;
try {
    $productFlags = \Weline\B2B\Service\ProductSellingModeFlags::fromOffer(
        is_array($offerForFlags) ? $offerForFlags : []
    );
} catch (\Throwable) {
    $productFlags = null;
}
try {
    /** @var SellingModePolicy $policy */
    $policy = ObjectManager::getInstance(SellingModePolicy::class);
    $tocEnabled = $policy->isModeEnabled(SellingModePolicy::MODE_TOC, $websiteId, $storeId, $productFlags);
    $tobEnabled = $policy->isModeEnabled(SellingModePolicy::MODE_TOB, $websiteId, $storeId, $productFlags);
    $moq = $policy->defaultMoq();
    $qtyStep = $policy->defaultQtyStep();
} catch (\Throwable) {
}

if (!$tobEnabled) {
    if (RequestContext::isInitialized()) {
        RequestContext::set('b2b.pdp_wholesale_display', false);
    }
    return;
}

$customerId = 0;
$loggedIn = false;
$hasMembership = false;
$uiState = MembershipStatusProjection::UI_NEED_LOGIN;
$appStatus = '';
$shouldPoll = false;
$canSubmit = true;
$application = null;
$applicationId = '';
// Guest-safe SSR: identity/membership hydrated by selling-mode.js on interaction.
$sellingMode = 'toc';

$isResubmit = false;
$ctaPending = false;
$ctaHidden = !($sellingMode === 'tob' && $uiState !== MembershipStatusProjection::UI_ACTIVE);
$ctaLabel = (string)__('申请批发身份');
$submitLabel = (string)__('提交申请');
$drawerHint = '';

$drawerId = 'b2b-membership-apply-' . substr(sha1((string)$websiteId . '-guest'), 0, 10);
?>
<link rel="stylesheet" href="/Weline/B2B/view/statics/css/b2b-storefront.css?v=20260914-no-cart-chooser" data-no-extract="true">
<div class="b2b-selling-mode product-native-detail__variant-axis"
     data-b2b-selling-mode="1"
     data-selling-mode="<?= $escape($sellingMode) ?>"
     data-cart-type="<?= $escape($sellingMode) ?>"
     data-toc-enabled="<?= $tocEnabled ? '1' : '0' ?>"
     data-tob-enabled="<?= $tobEnabled ? '1' : '0' ?>"
     data-customer-logged-in="<?= $loggedIn ? '1' : '0' ?>"
     data-has-membership="<?= $hasMembership ? '1' : '0' ?>"
     data-membership-ui-state="<?= $escape($uiState) ?>"
     data-application-status="<?= $escape($appStatus) ?>"
     data-application-id="<?= $escape($applicationId) ?>"
     data-should-poll="<?= $shouldPoll ? '1' : '0' ?>"
     data-can-submit="<?= $canSubmit || $uiState === MembershipStatusProjection::UI_NEED_LOGIN ? '1' : '0' ?>"
     data-customer-id="<?= $escape((string)$customerId) ?>"
     data-website-id="<?= (int)$websiteId ?>"
     data-tob-moq="<?= (int)$moq ?>"
     data-tob-qty-step="<?= (int)$qtyStep ?>"
