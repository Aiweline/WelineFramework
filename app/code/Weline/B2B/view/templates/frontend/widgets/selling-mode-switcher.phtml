                   aria-live="polite"
                   hidden></p>
            </div>
            <div class="b2b-membership-apply-wrap"
                 data-b2b-apply-form-wrap
                 <?= ($loggedIn && !$hasMembership) ? '' : 'hidden' ?>>
                <form class="b2b-membership-apply"
                      data-b2b-apply-form
                      method="post"
                      action="#"
                      data-testid="b2b-membership-apply-form">
                    <?php if ($applicationId !== ''): ?>
                        <input type="hidden" name="application_id" value="<?= $escape($applicationId) ?>">
                    <?php endif; ?>
                    <?php if ($drawerHint !== ''): ?>
                        <p class="b2b-selling-mode__hint" role="status" data-testid="b2b-membership-resubmit-hint">
