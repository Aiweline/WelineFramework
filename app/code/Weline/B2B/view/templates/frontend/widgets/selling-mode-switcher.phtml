 *
 * @widget.cache {300}
 * @widget.placement {injection}
 */

use Weline\B2B\Service\MembershipStatusProjection;
use Weline\B2B\Service\SellingModePolicy;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$storeId = max(0, (int)RequestContext::getWelineStoreId());

$tocEnabled = true;
$tobEnabled = true;
$moq = SellingModePolicy::DEFAULT_MOQ;
$qtyStep = SellingModePolicy::DEFAULT_QTY_STEP;
$siteTobEnabled = true;
$skuForGate = '';
$sellingFromBag = null;
if (class_exists(\Weline\Product\Helper\StorefrontPdpBuyBoxBag::class)
    && \Weline\Product\Helper\StorefrontPdpBuyBoxBag::hasKey('selling')
) {
    $sellingFromBag = \Weline\Product\Helper\StorefrontPdpBuyBoxBag::get('selling', null);
    $sellingFromBag = is_array($sellingFromBag) ? $sellingFromBag : null;
}
if ($sellingFromBag !== null) {
    $siteTobEnabled = !empty($sellingFromBag['site_tob_enabled']);
    $tocEnabled = !array_key_exists('toc_enabled', $sellingFromBag) || !empty($sellingFromBag['toc_enabled']);
    $tobEnabled = !empty($sellingFromBag['tob_enabled']);
    $moq = max(1, (int)($sellingFromBag['moq'] ?? $moq));
    $qtyStep = max(1, (int)($sellingFromBag['qty_step'] ?? $qtyStep));
} else {
    $offerForFlags = [];
    try {
        if (class_exists(\Weline\Product\Helper\StorefrontOfferResolver::class)) {
            $offerForFlags = \Weline\Product\Helper\StorefrontOfferResolver::resolve($this);
        }
    } catch (\Throwable) {
        $offerForFlags = [];
    }
    $skuForGate = trim((string)($offerForFlags['sku'] ?? ''));
    try {
        /** @var SellingModePolicy $sitePolicy */
        $sitePolicy = ObjectManager::getInstance(SellingModePolicy::class);
        $siteTobEnabled = $sitePolicy->isModeEnabled(
            SellingModePolicy::MODE_TOB,
            $websiteId,
            $storeId,
            null
        );
    } catch (\Throwable) {
        $siteTobEnabled = true;
    }
}

/**
 * When site tob is on but this SKU cannot wholesale-display, emit a soft hint host
 * (JS shows it only while preferredMode=tob). Do not invent wholesale pricing UI.
 * CTA switches selling mode to toc (same as「支持批发」→ tob); do not open /cart.
 */
$emitRetailOnlyTobHint = static function () use ($escape, $websiteId): void {
    ?>
<div class="b2b-retail-only-hint b2b-selling-mode__soft-cta"
     data-b2b-retail-only-hint="1"
     data-website-id="<?= (int)$websiteId ?>"
     data-weline-load="b2bSellingMode"
     data-testid="b2b-retail-only-tob-hint"
     role="status"
     hidden>
    <span class="b2b-selling-mode__soft-note"><lang>本商品不支持批发</lang></span>
    <button type="button"
            class="b2b-selling-mode__soft-link"
            data-b2b-retail-only-switch-toc
            data-testid="b2b-retail-only-switch-toc">
        <lang>切换成零售车</lang>
    </button>
</div>
<?php
};

// No active price-list tier: omit wholesale switcher. Do not hydrate EAV on this path.
if ($sellingFromBag === null) {
    try {
        /** @var \Weline\B2B\Service\ProductWholesaleEligibility $eligibility */
        $eligibility = ObjectManager::getInstance(\Weline\B2B\Service\ProductWholesaleEligibility::class);
        if (!$eligibility->allowsWholesaleDisplay($websiteId, $storeId, null, $skuForGate)) {
            $tobEnabled = false;
        }
    } catch (\Throwable) {
        $tobEnabled = false;
    }

    if (!$tobEnabled) {
        if (RequestContext::isInitialized()) {
            RequestContext::set('b2b.pdp_wholesale_display', false);
        }
        if ($siteTobEnabled) {
            $emitRetailOnlyTobHint();
        }
        return;
    }

    $productFlags = null;
    try {
        $productFlags = \Weline\B2B\Service\ProductSellingModeFlags::fromOffer(
            is_array($offerForFlags ?? null) ? $offerForFlags : []
        );
    } catch (\Throwable) {
        $productFlags = null;
    }
    try {
        /** @var SellingModePolicy $policy */
        $policy = ObjectManager::getInstance(SellingModePolicy::class);
        $tocEnabled = $policy->isModeEnabled(SellingModePolicy::MODE_TOC, $websiteId, $storeId, $productFlags);
        $tobEnabled = $policy->isModeEnabled(SellingModePolicy::MODE_TOB, $websiteId, $storeId, $productFlags);
        $moq = $policy->defaultMoq();
        $qtyStep = $policy->defaultQtyStep();
    } catch (\Throwable) {
    }
}

if (!$tobEnabled) {
    if (RequestContext::isInitialized()) {
        RequestContext::set('b2b.pdp_wholesale_display', false);
    }
    if ($siteTobEnabled) {
        $emitRetailOnlyTobHint();
    }
    return;
}

