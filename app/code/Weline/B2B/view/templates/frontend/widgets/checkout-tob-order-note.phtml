<?php
/**
 * Checkout top ToB wholesale-order notice (deposit rules).
 * Credit controls live in the summary extras tab widget.
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\B2B\Service\B2BPaymentAssetPolicyProvider;
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\WidgetI18n;

$minCashPercent = B2BPaymentAssetPolicyProvider::DEFAULT_MIN_CASH_DEPOSIT_PERCENT;
$creditEnabled = true;
try {
    /** @var B2BPaymentAssetPolicyProvider $policy */
    $policy = ObjectManager::getInstance(B2BPaymentAssetPolicyProvider::class);
    $creditEnabled = $policy->isEnabled();
    $minCashPercent = $policy->minCashDepositPercent();
} catch (\Throwable) {
    $creditEnabled = true;
    $minCashPercent = B2BPaymentAssetPolicyProvider::DEFAULT_MIN_CASH_DEPOSIT_PERCENT;
}
$minCashPercent = max(0, min(100, (int)$minCashPercent));
$maxCreditPercent = max(0, 100 - $minCashPercent);
$t = static fn (string $source): string => WidgetI18n::label($source);
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<link rel="stylesheet" href="@static(Weline_B2B::css/b2b-storefront.css)&v=20260912-hang-done1" data-no-extract="true">
<div class="b2b-checkout-deposit-note"
     data-b2b-deposit-note
     data-cart-type="tob"
     hidden
     data-testid="b2b-checkout-deposit-note"
     data-weline-load="b2bCheckoutTob">
    <span class="w-badge" data-tone="primary"><?= $esc($t('批发订单')) ?></span>
    <p>
        <?= $esc($t('批发结账先付含税商品小计 30% 定金，尾款约 70%（含运费）待审批后再付；营销券与满减不可用。')) ?>
        <?php if ($creditEnabled): ?>
            <?= $esc($t('可用批发信用抵扣本期定金，但现金定金须保留至少')) ?>
            <strong data-testid="b2b-order-note-min-cash"><?= $esc((string)$minCashPercent) ?>%</strong>
            <?= $esc($t('（信用最多可抵定金的')) ?>
            <strong><?= $esc((string)$maxCreditPercent) ?>%</strong>
            <?= $esc($t('），不可将定金全部抵成 0；信用不抵尾款。')) ?>
        <?php endif; ?>
    </p>
</div>
