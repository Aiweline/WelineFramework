<?php
/**
 * B2B qty ladder prices for PDP / quick-add buybox.
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\B2B\Service\SellingModePolicy;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;
use Weline\Product\Helper\StorefrontOfferResolver;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

if (RequestContext::isInitialized() && RequestContext::get('b2b.pdp_wholesale_display') === false) {
    return;
}

// Always emit DOM: retail SSR used to early-return, so selling-mode.js could not
// unhide tiers when switching toc→tob without a full reload.
// Guest-safe SSR: start hidden (toc); wholesale amounts filled after ToB interaction.
$tiersHidden = true;

$offer = StorefrontOfferResolver::resolve($this);
$sku = trim((string)($offer['sku'] ?? ''));
$currencyCode = strtoupper(trim((string)($offer['currency'] ?? 'CNY'))) ?: 'CNY';
// Align with product-info main price: show symbol (¥) not ISO code (CNY).
$currency = match ($currencyCode) {
    'CNY', 'RMB' => '¥',
    'USD' => '$',
    'EUR' => '€',
    'GBP' => '£',
    'JPY' => '¥',
    default => $currencyCode,
};
$catalogMinor = max(0, (int)($offer['catalog_price_minor'] ?? $offer['unit_price_minor'] ?? 0));
if ($sku === '') {
    return;
}

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$storeId = max(0, (int)RequestContext::getWelineStoreId());
$moq = SellingModePolicy::DEFAULT_MOQ;
$step = SellingModePolicy::DEFAULT_QTY_STEP;
$allowsWholesaleDisplay = false;
$productFlags = [];
try {
    /** @var SellingModePolicy $policy */
    $policy = ObjectManager::getInstance(SellingModePolicy::class);
    $moq = max(1, (int)$policy->defaultMoq());
    $step = max(1, (int)$policy->defaultQtyStep());
    $productFlags = \Weline\B2B\Service\ProductSellingModeFlags::fromOffer(is_array($offer) ? $offer : []);
    /** @var \Weline\B2B\Service\ProductWholesaleEligibility $eligibility */
    $eligibility = ObjectManager::getInstance(\Weline\B2B\Service\ProductWholesaleEligibility::class);
    $allowsWholesaleDisplay = $eligibility->allowsWholesaleDisplay(
        $websiteId,
        $storeId,
        $productFlags,
        $sku
    );
} catch (\Throwable) {
}

if (!$allowsWholesaleDisplay) {
    return;
}

try {
    /** @var \Weline\B2B\Service\DefaultWholesalePolicy $defaultPolicy */
    $defaultPolicy = ObjectManager::getInstance(\Weline\B2B\Service\DefaultWholesalePolicy::class);
    if ($defaultPolicy instanceof \Weline\B2B\Service\DefaultWholesalePolicy) {
        $moq = max(1, $defaultPolicy->lowestMinQty($defaultPolicy->allTiers($websiteId)));
    }
} catch (\Throwable) {
}

// Never resolve customer-specific tier amounts during public SSR.
$tiers = [];
?>
<div class="b2b-qty-tiers"
     data-testid="b2b-qty-tiers"
     data-b2b-qty-tiers="1"
     data-b2b-qty-ladder="0"
     role="region"
     aria-label="<?= $escape(__('批发起订与阶梯价')) ?>"
     <?= $tiersHidden ? 'hidden' : '' ?>>
    <p class="b2b-qty-tiers__moq" data-testid="b2b-qty-tiers-moq">
        <?= $escape(__('起订 %{1} · 步进 %{2}', [$moq, $step])) ?>
    </p>
    <?php if ($tiers !== []): ?>
        <?php
        $hasLadder = false;
        $amounts = array_map(static fn(array $t): int => (int)$t['amount_minor'], $tiers);
        if (count(array_unique($amounts)) > 1) {
            $hasLadder = true;
        }
        ?>
        <ul class="b2b-qty-tiers__list<?= $hasLadder ? ' is-ladder' : ' is-flat' ?>"
            data-testid="b2b-qty-tiers-list"
            data-b2b-qty-ladder="<?= $hasLadder ? '1' : '0' ?>">
            <?php foreach ($tiers as $tier): ?>
                <?php
                $qty = (int)$tier['qty'];
                $amount = (int)$tier['amount_minor'];
                $unit = number_format($amount / 100, 2, '.', '');
                $saveVsRetail = $catalogMinor > $amount ? ($catalogMinor - $amount) : 0;
                $totalSaveMinor = $saveVsRetail > 0 ? ($saveVsRetail * $qty) : 0;
                $liClass = 'b2b-qty-tiers__item';
                if ($saveVsRetail > 0) {
                    $liClass .= ' is-drop is-save';
                }
                ?>
                <li class="<?= $escape($liClass) ?>"
                    data-qty="<?= $qty ?>"
                    data-amount-minor="<?= $amount ?>"
                    data-unit-save-minor="<?= $saveVsRetail ?>"
                    data-total-save-minor="<?= $totalSaveMinor ?>">
                    <span class="b2b-qty-tiers__price">
                        <?= $escape(__('%{1} 件 %{2} %{3}/件', [$qty, $currency, $unit])) ?>
                    </span>
                    <?php if ($saveVsRetail > 0): ?>
                        <span class="b2b-qty-tiers__delta" data-testid="b2b-qty-tiers-drop">
                            <?= $escape(__('每件低 %{1} %{2}', [
                                $currency,
                                number_format($saveVsRetail / 100, 2, '.', ''),
                            ])) ?>
                        </span>
                        <span class="b2b-qty-tiers__save" data-testid="b2b-qty-tiers-save">
                            <?= $escape(__('省 %{1} %{2}', [
                                $currency,
                                number_format($totalSaveMinor / 100, 2, '.', ''),
                            ])) ?>
                        </span>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php else: ?>
        <p class="b2b-qty-tiers__hint">
            <?= $escape(__('批发价按数量档计价；未开通批发身份或暂无档位时显示站内参考价。')) ?>
        </p>
    <?php endif; ?>
</div>
