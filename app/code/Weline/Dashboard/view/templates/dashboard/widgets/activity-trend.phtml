<?php
/** @widget.source {Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 *
 * @widget.code {activity_trend}
 * @widget.name {活跃趋势}
 * @widget.description {后台 Dashboard 默认趋势图部件。}
 * @widget.type {chart}
 * @widget.area {backend}
 * @widget.position {["dashboard-analysis"]}
 * @widget.page_layouts {["dashboard"]}
 * @widget.slot {dashboard-analysis}
 * @widget.supports {["dashboard-widget","dashboard-slot-analysis","dashboard-chart","dashboard-trend"]}
 *
 * @widget.default_injections {[{"layout_type":"dashboard","layout_option":"default","default_view":"default","target_type":"website","slot":"dashboard-analysis","area":"content","sort_order":20,"required":true,"reason":"Dashboard 默认面板需要展示活跃趋势","config":{"dashboard_layout":{"colSpan":5,"rowSpan":2,"sortOrder":20}}}]}
 */
$bars = [42, 58, 51, 68, 61, 74, 70];
$labels = [__('一'), __('二'), __('三'), __('四'), __('五'), __('六'), __('日')];
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$trendAria = $h(__('近 7 天活跃趋势'));
$barNodes = [];
foreach ($bars as $index => $height) {
    $barHeight = max(0, min(100, (int)$height));
    $label = $h($labels[$index] ?? '');
    $barStyle = '--dashboard-bar-height: ' . $barHeight . '%';
    $barNodes[] = [
        'style' => $h($barStyle),
        'label' => $label,
    ];
}
?>
<article class="w-card dashboard-widget dashboard-widget-trend" data-w-height="full">
    <div class="w-card__header">
        <h3 class="w-card__title"><?= __('活跃趋势') ?></h3>
        <span class="w-text" data-tone="muted" data-size="sm"><?= __('近 7 天') ?></span>
    </div>
    <div class="w-card__body">
        <div class="dashboard-widget-bars" role="img" aria-label="<?= $trendAria ?>">
            <?php foreach ($barNodes as $node): ?>
                <div>
                    <i data-widget-style="<?= $node['style'] ?>"></i>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $node['label'] ?></span>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
</article>
