<?php
$bars = [42, 58, 51, 68, 61, 74, 70];
$labels = [__('一'), __('二'), __('三'), __('四'), __('五'), __('六'), __('日')];
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$trendAria = $h(__('近 7 天活跃趋势'));
$barNodes = [];
foreach ($bars as $index => $height) {
    $barHeight = max(0, min(100, (int)$height));
    $label = $h($labels[$index] ?? '');
    $barStyle = '--dashboard-bar-height: ' . $barHeight . '%';
    $barNodes[] = [
        'style' => $h($barStyle),
        'label' => $label,
    ];
}
?>
<article class="w-card dashboard-widget dashboard-widget-trend" data-w-height="full">
    <div class="w-card__header">
        <h3 class="w-card__title"><?= __('活跃趋势') ?></h3>
        <span class="w-text" data-tone="muted" data-size="sm"><?= __('近 7 天') ?></span>
    </div>
    <div class="w-card__body">
        <div class="dashboard-widget-bars" role="img" aria-label="<?= $trendAria ?>">
            <?php foreach ($barNodes as $node): ?>
                <div>
                    <i style="<?= $node['style'] ?>"></i>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $node['label'] ?></span>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
</article>
