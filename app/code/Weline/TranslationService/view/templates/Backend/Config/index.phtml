<?php
/**
 * 翻译服务配置页面
 * 
 * @var \Weline\Framework\View\Template $this
 * @var array $providers 渠道配置列表
 */
$providers = $this->getData('providers') ?? [];
$dialogJsonFlags = JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_THROW_ON_ERROR;
$confirmMessages = [
    'confirmTitle' => (string)__('确认操作'),
    'confirmButton' => (string)__('确定'),
    'cancelButton' => (string)__('取消'),
    'deleteProvider' => (string)__('确定要删除此渠道配置吗？'),
];
?>
<div class="translation-service-config-page">
    <div class="page-header" style="--w-mb:var(--weline-space-6);">
        <h1><?= __('翻译服务配置') ?></h1>
        <p class="w-text" data-tone="muted"><?= __('配置和管理翻译服务渠道，支持Google、百度、DeepL、Microsoft等主流翻译服务') ?></p>
    </div>

    <div class="w-card">
        <div class="w-card__header w-cluster" data-justify="between" data-align="center">
            <h3><?= __('渠道列表') ?></h3>
            <a href="<?= $this->getBackendUrl('*/backend/config/edit') ?>" class="w-button" data-tone="primary">
                <w:icon name="plus" size="sm"></w:icon> <?= __('添加渠道') ?>
            </a>
        </div>
        <div class="w-card__body">
            <?php if (empty($providers)): ?>
                <div class="w-alert" data-tone="info">
                    <?= __('暂无渠道配置') ?>
                </div>
            <?php else: ?>
                <div class="w-table-wrap">
                    <table class="w-table">
                        <thead>
                            <tr>
                                <th><?= __('渠道名称') ?></th>
                                <th><?= __('渠道代码') ?></th>
                                <th><?= __('状态') ?></th>
                                <th><?= __('默认') ?></th>
                                <th><?= __('优先级') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($providers as $provider): ?>
                                <tr>
                                    <td><?= htmlspecialchars($provider->getData('provider_name')) ?></td>
                                    <td><code><?= htmlspecialchars($provider->getData('provider_code')) ?></code></td>
                                    <td>
                                        <?php if ($provider->isEnabled()): ?>
                                            <span class="w-badge" data-w-background="success"><?= __('启用') ?></span>
                                        <?php else: ?>
                                            <span class="w-badge" data-w-background="muted"><?= __('禁用') ?></span>
                                        <?php endif; ?>
                                    </td>
                                    <td>
                                        <?php if ($provider->isDefault()): ?>
                                            <span class="w-badge" data-w-background="primary"><?= __('是') ?></span>
                                        <?php else: ?>
                                            <span class="w-text" data-tone="muted"><?= __('否') ?></span>
                                        <?php endif; ?>
                                    </td>
                                    <td><?= htmlspecialchars($provider->getData('priority')) ?></td>
                                    <td>
                                        <div class="w-button-group">
                                            <a href="<?= $this->getBackendUrl('*/backend/config/edit', ['id' => $provider->getId()]) ?>" class="w-button" data-tone="primary" data-variant="outline">
                                                <w:icon name="edit" size="sm"></w:icon> <?= __('编辑') ?>
                                            </a>
                                            <button type="button" class="w-button test-connection-btn" data-id="<?= $provider->getId() ?>" data-tone="info" data-variant="outline">
                                                <w:icon name="circle" size="sm"></w:icon> <?= __('测试') ?>
                                            </button>
                                            <a href="<?= $this->getBackendUrl('*/backend/config/delete', ['id' => $provider->getId()]) ?>" class="w-button" data-translation-config-confirm="deleteProvider" data-tone="danger" data-variant="outline">
                                                <w:icon name="trash" size="sm"></w:icon> <?= __('删除') ?>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php endif; ?>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const translationConfigMessages = <?= json_encode($confirmMessages, $dialogJsonFlags) ?>;

    function showLocalChoice(message) {
        return new Promise(function(resolve) {
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;inset:0;z-index:1055;background:rgba(15,23,42,.45);display:flex;align-items:center;justify-content:center;padding:20px;';

            const dialog = document.createElement('div');
            dialog.setAttribute('role', 'dialog');
            dialog.setAttribute('aria-modal', 'true');
            dialog.style.cssText = 'width:min(420px,100%);background:#fff;border-radius:8px;box-shadow:0 20px 60px rgba(15,23,42,.25);padding:24px;';

            const title = document.createElement('h4');
            title.textContent = translationConfigMessages.confirmTitle;
            title.style.cssText = 'margin:0 0 12px;font-size:18px;';

            const body = document.createElement('p');
            body.textContent = message;
            body.style.cssText = 'margin:0 0 20px;color:#475569;';

            const actions = document.createElement('div');
            actions.style.cssText = 'display:flex;justify-content:flex-end;gap:10px;';

            const cancelButton = document.createElement('button');
            cancelButton.type = 'button';
            cancelButton.className = 'btn btn-secondary';
            cancelButton.textContent = translationConfigMessages.cancelButton;

            const confirmButton = document.createElement('button');
            confirmButton.type = 'button';
            confirmButton.className = 'btn btn-primary';
            confirmButton.textContent = translationConfigMessages.confirmButton;

            function close(value) {
                document.removeEventListener('keydown', onKeydown);
                overlay.remove();
                resolve(value);
            }

            function onKeydown(event) {
                if (event.key === 'Escape') {
                    close(false);
                }
            }

            cancelButton.addEventListener('click', function() { close(false); });
            confirmButton.addEventListener('click', function() { close(true); });
            overlay.addEventListener('click', function(event) {
                if (event.target === overlay) {
                    close(false);
                }
            });

            actions.append(cancelButton, confirmButton);
            dialog.append(title, body, actions);
            overlay.appendChild(dialog);
            document.body.appendChild(overlay);
            document.addEventListener('keydown', onKeydown);
            confirmButton.focus();
        });
    }

    function showTranslationConfigChoice(message) {
        return Weline.UI.dialog.request({
            tone: 'warning',
            title: translationConfigMessages.confirmTitle,
            message: message,
            cancelable: true,
            confirmLabel: translationConfigMessages.confirmButton,
            cancelLabel: translationConfigMessages.cancelButton
        }).then(function(result) {
            return !!(result && result.confirmed);
        });
    }

    document.querySelectorAll('[data-translation-config-confirm]').forEach(function(link) {
        link.addEventListener('click', function(event) {
            const key = link.getAttribute('data-translation-config-confirm');
            const message = translationConfigMessages[key];
            if (!message) {
                return;
            }

            event.preventDefault();
            showTranslationConfigChoice(message).then(function(confirmed) {
                if (confirmed) {
                    window.location.href = link.href;
                }
            });
        });
    });

    // 测试连接
    document.querySelectorAll('.test-connection-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const providerId = this.getAttribute('data-id');
            const btn = this;
            const originalText = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon> <?= __('测试中...') ?>';
            
            var testUrl = '<?= $this->getBackendUrl('*/backend/config/test') ?>?id=' + providerId;
            window.Weline.Api.get(testUrl, { silent: true })
                .then(function(res) {
                    var data = (res && res.data) !== undefined ? res.data : res;
                    if (data.success) {
                        Weline.UI.dialog.request({
                            tone: 'success',
                            title: '<?= __('测试成功') ?>',
                            message: '<?= __('连接测试成功') ?>',
                            duration: 2000,
                            confirmable: false
                        });
                    } else {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('连接测试失败') ?>',
                            message: data.message || '<?= __('未知错误') ?>',
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    }
                })
                .catch(error => {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('测试失败') ?>',
                        message: error.message,
                        confirmLabel: '<?= __('确定') ?>'
                    });
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
        });
    });
});
</script>
