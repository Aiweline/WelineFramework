<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <!-- Store save still queues SEO feed generation. -->
    <event name="WeShop_Store::store_save_after">
        <observer name="Weline_Seo::store_save_after" instance="Weline\Seo\Observer\StoreSaveAfter" />
    </event>

    <event name="Weline_Seo::integration::url_submit_request">
        <observer name="Weline_Seo::url_submit_request" instance="Weline\Seo\Observer\UrlSubmitRequest" />
    </event>

    <!-- Website-account binding remains event driven. URL rewrite cron only fills gaps missed by immediate URL submit events. -->
    <event name="Weline_Seo::domain::website_account_bind">
        <observer name="Weline_Seo::website_account_bind" instance="Weline\Seo\Observer\WebsiteAccountBind" />
    </event>

    <!-- Protocol file generation for /robots.txt and /sitemap.xml. -->
    <event name="Weline_Websites::website_save_after">
        <observer name="Weline_Seo::website_save_after" instance="Weline\Seo\Observer\WebsiteSaveAfter" disabled="false" shared="true" sort="20" />
    </event>

    <event name="Weline_Framework_Router::process_uri_before">
        <observer name="Weline_Seo::protocol_route_rewrite" instance="Weline\Seo\Observer\ProtocolRouteRewrite" disabled="false" shared="true" sort="-100" />
    </event>

    <event name="Weline_Framework::resource_changed"
           schema_version="1"
           async_mapper="Weline\Framework\Event\ResourceChange\ResourceChangePayloadMapper"
           data_contract="resource_change.v1">
        <observer name="seo_resource_changed"
                  instance="Weline\Seo\Observer\ResourceChanged"
                  delivery="sync"
                  failure="critical"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>

    <!-- WLS normal responses; FPM skips this registration at runtime. -->
    <event name="Weline_Framework::App::run_after">
        <observer name="Weline_Seo::store_mode_response_run_after"
                  instance="Weline\Seo\Observer\StoreModeSeoResponseObserver"
                  disabled="false"
                  shared="true"
                  sort="700"/>
    </event>

    <!-- FPM final responses; persistent runtimes skip this registration. -->
    <event name="Weline_Framework_Http::response_ready">
        <observer name="Weline_Seo::store_mode_response_ready"
                  instance="Weline\Seo\Observer\StoreModeSeoResponseObserver"
                  disabled="false"
                  shared="true"
                  sort="90"/>
    </event>

    <!-- Early FPC hits bypass App::run_after and need the same request gate. -->
    <event name="Weline_Framework_Fpc::cache_hit_response">
        <observer name="Weline_Seo::store_mode_response_fpc_hit"
                  instance="Weline\Seo\Observer\StoreModeSeoResponseObserver"
                  disabled="false"
                  shared="true"
                  sort="90"/>
    </event>

</config>
