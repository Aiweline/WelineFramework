$runs = is_array($runs ?? null) ? $runs : [];
$policyMatrix = is_array($policy_matrix ?? null) ? $policy_matrix : [];
$actions = is_array($actions ?? null) ? $actions : [];

$escape = static fn ($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$filters = [
    'issue' => (string)($filters['issue'] ?? ''),
    'q' => (string)($filters['q'] ?? ''),
    'state' => (string)($filters['state'] ?? ''),
    'locale' => (string)($filters['locale'] ?? ''),
];

$policyByCode = [];
foreach ($policyMatrix as $policyRow) {
    if (is_array($policyRow) && isset($policyRow['issue_code'])) {
        $policyByCode[(string)$policyRow['issue_code']] = $policyRow;
    }
}

$viewUrl = function (array $override = []) use ($websiteId, $view, $filters): string {
    $params = array_merge([
        'website_id' => $websiteId,
        'view' => $view,
        'issue' => $filters['issue'],
        'q' => $filters['q'],
        'state' => $filters['state'],
        'locale' => $filters['locale'],
    ], $override);
    $params = array_filter($params, static fn ($value): bool => $value !== '' && $value !== null);

    return (string)$this->getBackendUrl('seo/backend/health', $params);
};

$actionLabels = [
    'remove' => (string)__('移出 sitemap'),
    'replace' => (string)__('替换为重定向目标'),
