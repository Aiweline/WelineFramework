$websiteId = (int)($website_id ?? 0);
$website = is_array($website ?? null) ? $website : null;
$view = (string)($view ?? 'health');
$filters = is_array($filters ?? null) ? $filters : [];
$summary = is_array($summary ?? null) ? $summary : [];
$tabs = is_array($tabs ?? null) ? $tabs : [];
