                (string)__('4. 保持 robots.txt 中的 Sitemap 入口可访问'),
            ],
            'config_template' => $supportsIndexNow ? [
                'indexnow_key' => 'your-indexnow-key',
                'key_location' => 'https://example.com/your-indexnow-key.txt',
                'indexnow_endpoint' => 'https://api.indexnow.org/indexnow',
            ] : [
                'site_url' => 'https://example.com',
                'submission_note' => 'manual_webmaster_sitemap',
            ],
        ];
    }

    $platformFeatures[$code]['supports_submit'] = $supportsSubmit;
    $platformFeatures[$code]['supports_url_push'] = $supportsUrlPush;
    $platformFeatures[$code]['supports_sitemap_submit'] = $supportsSitemapSubmit;
    $platformFeatures[$code]['supports_indexnow'] = $supportsIndexNow;
    $platformFeatures[$code]['catalog_only'] = $catalogOnly;
    $platformFeatures[$code]['config_fields'] = is_array($info['config_fields'] ?? null) ? array_values($info['config_fields']) : [];
}


