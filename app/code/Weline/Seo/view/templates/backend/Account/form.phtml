                <!-- 平台配置 JavaScript（必须在表单之前定义） -->
                <script>
                // ==================== 平台配置数据 ====================
                const PLATFORM_DATA = <?= json_encode($platformFeatures, $jsonForScriptFlags) ?>;
                const ACCOUNT_SECRET_KEYS = <?= json_encode($configuredSecretKeys, $jsonForScriptFlags) ?>;
                const ACCOUNT_SAVED_PLATFORM = <?= json_encode($platform, $jsonForScriptFlags) ?>;
                const ACCOUNT_CONFIG_VALUES = <?= json_encode($configArray, $jsonForScriptFlags) ?> || {};
                const ACCOUNT_SERVICE_CLIENT_EMAIL = <?= json_encode($serviceAccountClientEmail, $jsonForScriptFlags) ?>;
                const SEO_ACCOUNT_WEBSITE_OPTIONS = <?= json_encode($seoAccountWebsiteSelectOptions, $jsonForScriptFlags) ?> || [];
                const GSC_OWNER_HINT_NEED_JSON = <?= json_encode((string)__('请先上传或粘贴上方 Service Account JSON；解析出 client_email 后，这里会显示要加成所有者的邮箱与操作步骤。'), $jsonForScriptFlags) ?>;
                const GSC_OWNER_HINT_NEED_SITE = <?= json_encode((string)__('已解析服务账号 %{1}。请填写上方「站点属性 URL」（如 sc-domain:example.com），再按此处提示到 GSC 授权。'), $jsonForScriptFlags) ?>;
                const GSC_OWNER_HINT_READY = <?= json_encode((string)__('操作：打开 Search Console → 左侧选属性「%{1}」→ 设置 → 用户和权限 → 添加用户，粘贴下方邮箱，权限选「所有者」。'), $jsonForScriptFlags) ?>;
                const GSC_OWNER_HINT_EMAIL_LABEL = <?= json_encode((string)__('要添加的服务账号'), $jsonForScriptFlags) ?>;
                let currentSelectedPlatform = <?= json_encode($platform, $jsonForScriptFlags) ?>;
                let seoAccountWebsiteUrlKey = '';

                function resolveServiceAccountClientEmail() {
                    const el = document.querySelector('#seoProviderConfigFields [data-seo-config-key="service_account"]');
                    const raw = el ? String(el.value || '').trim() : '';
                    if (raw !== '') {
                        try {
                            const obj = JSON.parse(raw);
                            const email = obj && typeof obj.client_email === 'string' ? String(obj.client_email).trim() : '';
                            if (email.indexOf('@') !== -1) {
                                return email;
                            }
                        } catch (e) {}
                    }
                    return String(ACCOUNT_SERVICE_CLIENT_EMAIL || '').trim();
                }

                function resolveGscSiteProperty() {
                    const el = document.querySelector('#seoProviderConfigFields [data-seo-config-key="site_url"]');
                    return el ? String(el.value || '').trim() : '';
                }

                function updateGscOwnerActionHint() {
                    const panel = document.querySelector('#seoProviderConfigFields [data-seo-gsc-owner-action]');
                    if (!panel) {
                        return;
                    }
                    panel.replaceChildren();
                    const email = resolveServiceAccountClientEmail();
                    const site = resolveGscSiteProperty();
                    const line = document.createElement('div');
                    line.className = 'w-stack';
                    line.setAttribute('data-gap', 'xs');

                    if (email === '') {
                        const tip = document.createElement('p');
                        tip.className = 'w-text';
                        tip.setAttribute('data-size', 'sm');
                        tip.setAttribute('data-tone', 'warning');
                        tip.style.margin = '0';
                        tip.textContent = GSC_OWNER_HINT_NEED_JSON;
                        line.appendChild(tip);
                        panel.appendChild(line);
                        return;
                    }

                    if (site === '') {
                        const tip = document.createElement('p');
                        tip.className = 'w-text';
                        tip.setAttribute('data-size', 'sm');
                        tip.style.margin = '0';
                        tip.textContent = String(GSC_OWNER_HINT_NEED_SITE).replace('%{1}', email);
                        line.appendChild(tip);
                        panel.appendChild(line);
                        return;
                    }

                    const tip = document.createElement('p');
                    tip.className = 'w-text';
                    tip.setAttribute('data-size', 'sm');
                    tip.style.margin = '0';
                    tip.textContent = String(GSC_OWNER_HINT_READY).replace('%{1}', site);
                    line.appendChild(tip);

                    const emailRow = document.createElement('p');
                    emailRow.className = 'w-text';
                    emailRow.setAttribute('data-size', 'sm');
                    emailRow.setAttribute('data-weight', 'strong');
                    emailRow.style.margin = '0';
                    emailRow.appendChild(document.createTextNode(GSC_OWNER_HINT_EMAIL_LABEL + '：'));
                    const code = document.createElement('code');
                    code.textContent = email;
                    emailRow.appendChild(code);
                    line.appendChild(emailRow);

                    const link = document.createElement('a');
                    link.href = 'https://search.google.com/search-console';
                    link.target = '_blank';
                    link.rel = 'noopener';
                    link.className = 'w-text';
                    link.setAttribute('data-size', 'sm');
                    link.textContent = <?= json_encode((string)__('打开 Google Search Console'), $jsonForScriptFlags) ?>;
                    line.appendChild(link);

                    panel.appendChild(line);
                }

                // ==================== 通用工具函数 ====================
                
                /**
                 * 显示消息提示
                 */
                function showMessage(type, message, title = null) {
                    const tone = type === 'error' ? 'danger' : type === 'success' ? 'success' : 'warning';
                    const content = title ? title + '：' + message : message;
                    Weline.UI.toast.show(content, {
                        tone: tone,
                        duration: type === 'success' ? 3000 : 5000
                    });
                }
                
                /**
                 * 显示确认对话框
                 */
                function showConfirm(message, onConfirm, onCancel) {
                    Weline.UI.dialog.request({
                        tone: 'warning',
                        title: '<?= __("确认操作") ?>',
                        message: message,
                        cancelable: true,
                        confirmLabel: '<?= __("确定") ?>',
                        cancelLabel: '<?= __("取消") ?>',
                        confirmTone: 'primary',
                        cancelTone: 'neutral'
                    }).then((result) => {
                        if (result.confirmed && onConfirm) {
                            onConfirm();
                        } else if (result.cancelled && onCancel) {
                            onCancel();
                        }
                    });
                }

                // ==================== 核心功能函数 ====================

                /**
                 * 处理平台选择变化
                 */
                function syncPlatformCards(platformCode) {
                    document.querySelectorAll('[data-seo-platform-card]').forEach(function(card) {
                        const active = card.getAttribute('data-seo-platform-card') === platformCode;
                        card.classList.toggle('active', active);
                        card.setAttribute('aria-pressed', active ? 'true' : 'false');
                    });
                    syncPlatformGroupTabs(platformCode);
                }

                function syncPlatformGroupTabs(platformCode) {
                    const code = String(platformCode || '');
                    let groupId = '';
                    if (code) {
                        const card = document.querySelector('[data-seo-platform-card="' + code.replace(/"/g, '') + '"]');
                        if (card) {
                            groupId = card.getAttribute('data-seo-platform-group') || '';
                        }
                    }
                    if (!groupId) {
                        const activeTab = document.querySelector('[data-seo-platform-tab][aria-selected="true"]');
                        groupId = activeTab ? (activeTab.getAttribute('data-seo-platform-tab') || '') : '';
                    }
                    if (!groupId) {
                        const firstTab = document.querySelector('[data-seo-platform-tab]');
                        groupId = firstTab ? (firstTab.getAttribute('data-seo-platform-tab') || '') : '';
                    }
                    document.querySelectorAll('[data-seo-platform-tab]').forEach(function(tab) {
                        const on = tab.getAttribute('data-seo-platform-tab') === groupId;
                        tab.setAttribute('aria-selected', on ? 'true' : 'false');
                        tab.classList.toggle('active', on);
                    });
                    document.querySelectorAll('[data-seo-platform-panel]').forEach(function(panel) {
                        const on = panel.getAttribute('data-seo-platform-panel') === groupId;
                        panel.hidden = !on;
                    });
                    const hint = document.getElementById('seoPlatformGroupHint');
                    const activeTabEl = document.querySelector('[data-seo-platform-tab][aria-selected="true"]');
                    if (hint && activeTabEl) {
                        hint.textContent = activeTabEl.getAttribute('data-seo-platform-tab-hint') || '';
                    }
                }

                function selectPlatformGroupTab(groupId) {
                    groupId = String(groupId || '');
                    if (!groupId) {
                        return;
                    }
                    document.querySelectorAll('[data-seo-platform-tab]').forEach(function(tab) {
                        const on = tab.getAttribute('data-seo-platform-tab') === groupId;
                        tab.setAttribute('aria-selected', on ? 'true' : 'false');
                        tab.classList.toggle('active', on);
                    });
                    document.querySelectorAll('[data-seo-platform-panel]').forEach(function(panel) {
                        panel.hidden = panel.getAttribute('data-seo-platform-panel') !== groupId;
                    });
                    const hint = document.getElementById('seoPlatformGroupHint');
                    const activeTabEl = document.querySelector('[data-seo-platform-tab][aria-selected="true"]');
                    if (hint && activeTabEl) {
                        hint.textContent = activeTabEl.getAttribute('data-seo-platform-tab-hint') || '';
                    }
                }

                function selectPlatformCard(platformCode) {
                    const select = document.getElementById('platformSelect');
                    if (!select) {
                        return;
                    }
                    select.value = platformCode;
                    handlePlatformChange(platformCode);
                }

                function getSelectedPlatformDisplayName(platformCode) {
                    const select = document.getElementById('platformSelect');
                    if (select) {
                        const code = String(platformCode || '');
                        for (let i = 0; i < select.options.length; i++) {
                            const option = select.options[i];
                            if (option.value !== code) {
                                continue;
                            }
                            const named = (option.getAttribute('data-name') || '').trim();
                            if (named !== '') {
                                return named;
                            }
                            break;
                        }
                    }
                    if (platformCode && PLATFORM_DATA[platformCode] && PLATFORM_DATA[platformCode].name) {
                        return String(PLATFORM_DATA[platformCode].name);
                    }
                    return String(platformCode || '');
                }

                function getAccountNamePrefix(platformCode) {
                    const displayName = getSelectedPlatformDisplayName(platformCode);
                    return displayName ? (displayName + '-') : '';
                }

                function extractAccountNameSuffix(value, prefix) {
                    const raw = String(value || '');
                    if (!prefix) {
                        return raw;
                    }
                    if (raw.startsWith(prefix)) {
                        return raw.slice(prefix.length);
                    }
                    const dash = raw.indexOf('-');
                    if (dash > 0) {
                        return raw.slice(dash + 1);
                    }
                    return raw;
                }

                function syncAccountNameFormat(platformCode) {
                    const field = document.getElementById('seoAccountNameField');
                    const input = document.getElementById('seoAccountNameInput');
                    const example = document.getElementById('seoAccountNameFormatExample');
                    if (!field || !input) {
                        return;
                    }

                    if (!platformCode) {
                        field.hidden = true;
                        input.required = false;
                        input.removeAttribute('data-name-prefix');
                        input.value = '';
                        if (example) {
                            example.textContent = '';
                        }
                        return;
                    }

                    const prefix = getAccountNamePrefix(platformCode);
                    const suffix = extractAccountNameSuffix(input.value.trim(), prefix).trim();
                    field.hidden = false;
                    input.required = true;
                    input.setAttribute('data-name-prefix', prefix);
                    input.value = prefix + suffix;
                    input.placeholder = prefix + (input.getAttribute('data-suffix-placeholder') || '');
                    if (example) {
                        example.textContent = prefix + (input.getAttribute('data-suffix-placeholder') || '');
                    }
                }

                function enforceAccountNamePrefix(input) {
                    if (!input) {
                        return;
                    }
                    const prefix = input.getAttribute('data-name-prefix') || '';
                    if (!prefix) {
                        return;
                    }
                    if (!input.value.startsWith(prefix)) {
                        const suffix = extractAccountNameSuffix(input.value, prefix);
                        input.value = prefix + suffix;
                    }
                }

                function handlePlatformChange(platformCode) {
                    currentSelectedPlatform = platformCode;
                    syncPlatformCards(platformCode);
                    syncAccountNameFormat(platformCode);
                    
                    if (!platformCode || !PLATFORM_DATA[platformCode]) {
                        hideAllPlatformInfo();
                        syncSubmitToggles(null);
                        return;
                    }
                    
                    showPlatformInfo(platformCode);
                }

                /**
                 * 隐藏所有平台信息
                 */
                function hideAllPlatformInfo() {
                    document.getElementById('platformFeaturesInfo').style.display = 'none';
                    document.getElementById('platformGuideInfo').style.display = 'none';
                    const outboundHint = document.getElementById('seoPlatformOutboundHint');
                    if (outboundHint) {
                        outboundHint.hidden = true;
                    }
                    renderProviderConfigFields(null);
                }

                /**
                 * 根据平台能力控制自动提交开关
                 * 不支持的能力：保持可点击，拦截后 toast 说明（避免 disabled 看起来像坏了）。
                 */
                function applyCapabilitySwitch(input, supported, unsupportedMessage, hint) {
                    if (!input) {
                        return;
                    }
                    const wrap = input.closest('[data-seo-capability-switch]');
                    const wasUnsupported = input.getAttribute('data-seo-unsupported') === '1';
                    input.disabled = false;
                    if (!supported) {
                        input.checked = false;
                        input.setAttribute('data-seo-unsupported', '1');
                        input.setAttribute('aria-disabled', 'true');
                        input.setAttribute('title', unsupportedMessage);
                        if (wrap) {
                            wrap.setAttribute('data-unsupported', 'true');
                            wrap.style.opacity = '0.65';
                            wrap.style.cursor = 'not-allowed';
                        }
                    } else {
                        input.removeAttribute('data-seo-unsupported');
                        input.removeAttribute('aria-disabled');
                        input.removeAttribute('title');
                        if (wrap) {
                            wrap.removeAttribute('data-unsupported');
                            wrap.style.opacity = '';
                            wrap.style.cursor = '';
                        }
                        // 平台从不支持切回可支持：自动选项默认勾上，除非用户之后主动取消
                        if (wasUnsupported) {
                            input.checked = true;
                        }
                    }
                    if (hint) {
                        hint.hidden = supported;
                        hint.textContent = unsupportedMessage;
                    }
                }

                function syncSubmitToggles(platform) {
                    const supportsUrlPush = !!(platform && platform.supports_url_push);
                    const supportsSitemapSubmit = !!(platform && platform.supports_sitemap_submit);
                    const pushUnsupported = <?= json_encode((string)__('当前平台不支持 URL 定时推送；Google 普通页面请改用 Sitemap 定时提交'), $jsonForScriptFlags) ?>;
                    const sitemapUnsupported = <?= json_encode((string)__('当前平台不支持 Sitemap 定时提交'), $jsonForScriptFlags) ?>;
                    applyCapabilitySwitch(
                        document.getElementById('enable_cron_push_urls'),
                        supportsUrlPush,
                        pushUnsupported,
                        document.getElementById('seoCronPushHint')
                    );
                    applyCapabilitySwitch(
                        document.getElementById('enable_cron_sitemap'),
                        supportsSitemapSubmit,
                        sitemapUnsupported,
                        document.getElementById('seoCronSitemapHint')
                    );
                }

                /**
                 * 安全渲染配置指南步骤：保留 http(s) 链接与强调色，去掉手写序号避免与 <ol> 双重编号。
                 */
                function appendSafeGuideStep(target, stepHtml) {
                    const raw = String(stepHtml || '').replace(/^\s*\d+\.\s*/, '');
                    const parsed = new DOMParser().parseFromString('<div>' + raw + '</div>', 'text/html');
                    const source = parsed.body.firstElementChild;
                    if (!source) {
                        target.textContent = raw;
                        return;
                    }

                    const appendNode = function(parent, node) {
                        if (node.nodeType === Node.TEXT_NODE) {
                            parent.appendChild(document.createTextNode(node.nodeValue || ''));
                            return;
                        }
                        if (node.nodeType !== Node.ELEMENT_NODE) {
                            return;
                        }
                        const tag = node.tagName.toLowerCase();
                        if (tag === 'a') {
                            const href = String(node.getAttribute('href') || '').trim();
                            if (!/^https?:\/\//i.test(href)) {
                                Array.from(node.childNodes).forEach(function(child) {
                                    appendNode(parent, child);
                                });
                                return;
                            }
                            const link = document.createElement('a');
                            link.href = href;
                            link.target = '_blank';
                            link.rel = 'noopener noreferrer';
                            Array.from(node.childNodes).forEach(function(child) {
                                appendNode(link, child);
                            });
                            parent.appendChild(link);
                            return;
                        }
                        if (tag === 'span' || tag === 'strong' || tag === 'em' || tag === 'code') {
                            const el = document.createElement(tag);
                            if (tag === 'span') {
                                const color = String(node.style && node.style.color ? node.style.color : '').trim();
                                if (color !== '') {
                                    el.style.color = color;
                                }
                            }
                            Array.from(node.childNodes).forEach(function(child) {
                                appendNode(el, child);
                            });
                            parent.appendChild(el);
                            return;
                        }
                        if (tag === 'br') {
                            parent.appendChild(document.createElement('br'));
                            return;
                        }
                        Array.from(node.childNodes).forEach(function(child) {
                            appendNode(parent, child);
                        });
                    };

                    Array.from(source.childNodes).forEach(function(child) {
                        appendNode(target, child);
                    });
                }

                /**
                 * 显示平台信息
                 */
                function showPlatformInfo(platformCode) {
                    const platform = PLATFORM_DATA[platformCode];
                    
                    // 显示功能说明
                    document.getElementById('platformFeaturesInfo').style.display = 'block';
                    document.getElementById('platformFeaturesTitle').textContent = platform.name;
                    
                    const featuresList = document.getElementById('platformFeaturesList');
                    featuresList.replaceChildren();
                    platform.features.forEach(function(feature) {
                        const item = document.createElement('li');
                        item.textContent = feature;
                        featuresList.appendChild(item);
                    });
                    
                    document.getElementById('platformConfigHint').textContent = platform.config_hint;

                    const outboundHint = document.getElementById('seoPlatformOutboundHint');
                    const outboundText = document.getElementById('seoPlatformOutboundHintText');
                    if (outboundHint && outboundText) {
                        if (platform.outbound_hint) {
                            outboundText.textContent = platform.outbound_hint;
                            outboundHint.hidden = false;
                        } else {
                            outboundHint.hidden = true;
                        }
                    }
                    
                    // 显示配置指南（默认展开）
                    document.getElementById('platformGuideInfo').style.display = 'block';
                    document.getElementById('platformGuideTitle').textContent = platform.guide_title;
                    
                    const guideSteps = document.getElementById('platformGuideSteps');
                    guideSteps.replaceChildren();
                    platform.guide_steps.forEach(function(step) {
                        const item = document.createElement('li');
                        appendSafeGuideStep(item, step);
                        guideSteps.appendChild(item);
                    });
                    
                    const templateEl = document.getElementById('platformConfigTemplate');
                    const templateWrap = document.getElementById('platformConfigTemplateWrap');
                    if (templateEl) {
                        const fields = Array.isArray(platform.config_fields) ? platform.config_fields : [];
                        if (fields.length) {
                            const preview = {};
                            fields.forEach(function(field) {
                                preview[field.key] = field.placeholder || '';
                            });
                            templateEl.textContent = JSON.stringify(preview, null, 2);
                            if (templateWrap) {
                                templateWrap.hidden = false;
                            }
                        } else if (templateWrap) {
                            templateWrap.hidden = true;
                        }
                    }
                    
                    // 默认展开指南内容
                    document.getElementById('platformGuideContent').style.display = 'block';
                    const guideIcon = document.getElementById('guideToggleIcon');
                    if (guideIcon) {
                        guideIcon.style.transform = 'rotate(180deg)';
                    }

                    renderProviderConfigFields(platform);
                    syncSubmitToggles(platform);
                }

                /**
                 * 切换指南内容展开/收起
                 */
                function toggleGuideContent() {
                    const content = document.getElementById('platformGuideContent');
                    const icon = document.getElementById('guideToggleIcon');
                    const isVisible = content.style.display !== 'none';
                    
                    content.style.display = isVisible ? 'none' : 'block';
                    icon.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
                }

                function parkSeoAccountWebsiteUrlField() {
                    const host = document.getElementById('seoAccountWebsiteUrlHost');
                    const wrap = document.getElementById('seoAccountWebsiteUrlField');
                    if (host && wrap && wrap.parentElement !== host) {
                        host.appendChild(wrap);
                    }
                    if (host) {
                        host.hidden = true;
                    }
                    seoAccountWebsiteUrlKey = '';
                    const hidden = document.getElementById('seoAccountWebsiteUrlValue');
                    if (hidden) {
                        hidden.removeAttribute('name');
                        hidden.removeAttribute('data-seo-config-key');
                        hidden.removeAttribute('required');
                    }
                }

                function resolveWebsiteOptionUrl(item) {
                    if (!item) {
                        return '';
                    }
                    let url = String(item.url || (item.raw && item.raw.url) || '').trim();
                    if (!url) {
                        const found = SEO_ACCOUNT_WEBSITE_OPTIONS.find(function(opt) {
                            return String(opt.value) === String(item.value || '');
                        });
                        url = found ? String(found.url || '').trim() : '';
                    }
                    return url.replace(/\/$/, '');
                }

                window.handleSeoAccountWebsiteSelect = function(item) {
                    const hidden = document.getElementById('seoAccountWebsiteUrlValue');
                    const preview = document.getElementById('seoAccountWebsiteUrlPreview');
                    if (!hidden || !seoAccountWebsiteUrlKey) {
                        return;
                    }
                    const url = resolveWebsiteOptionUrl(item);
                    hidden.value = url;
                    if (preview) {
                        preview.textContent = url;
                    }
                    syncConfigJsonFromFields();
                };

                function mountSeoAccountWebsiteUrlField(fieldsRoot, field, values) {
                    const host = document.getElementById('seoAccountWebsiteUrlHost');
                    const wrap = document.getElementById('seoAccountWebsiteUrlField');
                    const hidden = document.getElementById('seoAccountWebsiteUrlValue');
                    const label = document.getElementById('seoAccountWebsiteUrlLabel');
                    const preview = document.getElementById('seoAccountWebsiteUrlPreview');
                    const hint = document.getElementById('seoAccountWebsiteUrlHint');
                    if (!host || !wrap || !hidden || !fieldsRoot) {
                        return false;
                    }

                    const key = String(field.key || '');
                    if (!key) {
                        return false;
                    }
                    seoAccountWebsiteUrlKey = key;
                    fieldsRoot.appendChild(wrap);
                    host.hidden = true;

                    if (label) {
                        label.replaceChildren();
                        label.appendChild(document.createTextNode(String(field.label || key)));
                        if (field.required) {
                            const req = document.createElement('span');
                            req.className = 'w-text';
                            req.setAttribute('data-tone', 'danger');
                            req.textContent = ' *';
                            label.appendChild(req);
                        }
                    }

                    hidden.name = 'config[' + key + ']';
                    hidden.setAttribute('data-seo-config-key', key);
                    hidden.setAttribute('data-seo-config-type', 'website_url');
                    hidden.required = !!field.required;

                    const current = values[key];
                    const currentUrl = (current !== undefined && current !== null && typeof current !== 'object')
                        ? String(current).trim().replace(/\/$/, '')
                        : '';
                    hidden.value = currentUrl;
                    if (preview) {
                        preview.textContent = currentUrl;
                    }
                    if (hint) {
                        hint.textContent = field.hint ? String(field.hint) : '';
                        hint.hidden = !field.hint;
                    }

                    const match = SEO_ACCOUNT_WEBSITE_OPTIONS.find(function(opt) {
                        return String(opt.url || '').replace(/\/$/, '') === currentUrl;
                    });
                    const api = window.WelineWebsiteSelect && window.WelineWebsiteSelect.seo_account_website_pick;
                    if (api && typeof api.setValue === 'function') {
                        if (match) {
                            api.setValue(String(match.value));
                        } else {
                            const activeKey = seoAccountWebsiteUrlKey;
                            seoAccountWebsiteUrlKey = '';
                            api.setValue('');
                            seoAccountWebsiteUrlKey = activeKey;
                            hidden.value = currentUrl;
                            if (preview) {
                                preview.textContent = currentUrl;
                            }
                        }
                    }

                    return true;
                }

                /**
                 * 按 Provider 声明的字段渲染账户配置（禁止统一 JSON）
                 */
                function getCurrentConfigValues() {
                    const hidden = document.getElementById('configJsonTextarea');
                    if (hidden && hidden.value.trim()) {
                        try {
                            const parsed = JSON.parse(hidden.value);
                            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                                return parsed;
                            }
                        } catch (e) {}
                    }
                    return Object.assign({}, ACCOUNT_CONFIG_VALUES || {});
                }

                function syncConfigJsonFromFields() {
                    const hidden = document.getElementById('configJsonTextarea');
                    const root = document.getElementById('seoProviderConfigFields');
                    if (!hidden || !root) {
                        return;
                    }
                    const values = {};
                    root.querySelectorAll('[data-seo-config-key]').forEach(function(el) {
                        const key = el.getAttribute('data-seo-config-key') || '';
                        if (!key) {
                            return;
                        }
                        if (el.type === 'checkbox') {
                            values[key] = !!el.checked;
                            return;
                        }
                        let raw = String(el.value || '').trim();
                        if (el.getAttribute('data-seo-config-type') === 'json' && raw !== '') {
                            try {
                                values[key] = JSON.parse(raw);
                                return;
                            } catch (e) {
                                values[key] = raw;
                                return;
                            }
                        }
                        values[key] = raw;
                    });
                    hidden.value = JSON.stringify(values, null, 2);
                }

                function renderProviderConfigFields(platform) {
                    const section = document.getElementById('seoProviderConfigSection');
                    const fieldsRoot = document.getElementById('seoProviderConfigFields');
                    const empty = document.getElementById('seoProviderConfigEmpty');
                    const title = document.getElementById('seoProviderConfigTitle');
                    if (!section || !fieldsRoot || !empty) {
                        return;
                    }

                    parkSeoAccountWebsiteUrlField();

                    if (!platform) {
                        section.hidden = true;
                        fieldsRoot.replaceChildren();
                        empty.hidden = true;
                        return;
                    }

                    section.hidden = false;
                    const fields = Array.isArray(platform.config_fields) ? platform.config_fields : [];
                    const values = getCurrentConfigValues();
                    fieldsRoot.replaceChildren();

                    if (title) {
                        title.textContent = (platform.name || '') + ' ' + (title.getAttribute('data-label-suffix') || '');
                    }

                    if (!fields.length) {
                        empty.hidden = false;
                        syncConfigJsonFromFields();
                        return;
                    }

                    empty.hidden = true;
                    let websiteUrlMounted = false;
                    let channelGrid = null;
                    fields.forEach(function(field) {
                        const key = String(field.key || '');
                        if (!key) {
                            return;
                        }
                        const type = String(field.type || 'text');
                        if (type === 'section') {
                            channelGrid = null;
                            const section = document.createElement('div');
                            section.className = 'seo-config-section';
                            section.setAttribute('data-seo-config-section', key);
                            const title = document.createElement('h3');
                            title.className = 'seo-config-section__title';
                            title.textContent = String(field.label || key);
                            section.appendChild(title);
                            if (field.hint) {
                                const hint = document.createElement('p');
                                hint.className = 'seo-config-section__hint';
                                hint.textContent = String(field.hint);
                                section.appendChild(hint);
                            }
                            if (key.indexOf('channel') !== -1) {
                                const link = document.createElement('a');
                                link.className = 'seo-config-section__link';
                                link.href = 'https://search.google.com/search-console';
                                link.target = '_blank';
                                link.rel = 'noopener';
                                link.textContent = <?= json_encode((string)__('打开 Google Search Console 添加平台属性'), $jsonForScriptFlags) ?>;
                                section.appendChild(link);
                            }
                            fieldsRoot.appendChild(section);
                            return;
                        }
                        if (type === 'website_url') {
                            if (!websiteUrlMounted) {
                                websiteUrlMounted = mountSeoAccountWebsiteUrlField(fieldsRoot, field, values);
                            }
                            return;
                        }
                        const fieldId = 'seo_config_' + key;
                        const wrap = document.createElement('div');
                        wrap.className = 'w-field';
                        wrap.style.setProperty('--w-mb', 'var(--weline-space-3)');
                        if (String(field.group || '') === 'channels') {
                            if (!channelGrid) {
                                channelGrid = document.createElement('div');
                                channelGrid.className = 'seo-config-channel-grid';
                                fieldsRoot.appendChild(channelGrid);
                            }
                            wrap.classList.add('seo-config-channel-field');
                            channelGrid.appendChild(wrap);
                        } else {
                            channelGrid = null;
                            fieldsRoot.appendChild(wrap);
                        }

                        const label = document.createElement('label');
                        label.className = 'w-field__label';
                        label.setAttribute('for', fieldId);
                        label.appendChild(document.createTextNode(String(field.label || key)));
                        if (field.required) {
                            const req = document.createElement('span');
                            req.className = 'w-text';
                            req.setAttribute('data-tone', 'danger');
                            req.textContent = ' *';
                            label.appendChild(req);
                        }
                        wrap.appendChild(label);

                        let control;
                        const current = values[key];
                        if (type === 'checkbox') {
                            control = document.createElement('input');
                            control.type = 'checkbox';
                            control.className = 'w-checkbox';
                            control.checked = current === true || current === 1 || current === '1';
                        } else if (type === 'textarea' || type === 'json') {
                            control = document.createElement('textarea');
                            control.className = 'w-textarea';
                            control.rows = type === 'json' ? 10 : 4;
                            if (type === 'json') {
                                control.setAttribute('data-family', 'mono');
                                control.style.fontSize = '12px';
                            }
                            if (current !== undefined && current !== null) {
                                control.value = typeof current === 'string' ? current : JSON.stringify(current, null, 2);
                            }
                        } else {
                            control = document.createElement('input');
                            control.type = type === 'password' || type === 'url' ? type : 'text';
                            control.className = 'w-input';
                            if (current !== undefined && current !== null && typeof current !== 'object') {
                                control.value = String(current);
                            }
                        }

                        control.id = fieldId;
                        control.name = 'config[' + key + ']';
                        control.setAttribute('data-seo-config-key', key);
                        control.setAttribute('data-seo-config-type', type);
                        const hasSavedSecret = ACCOUNT_SAVED_PLATFORM === (document.getElementById('platformSelect') || {}).value && ACCOUNT_SECRET_KEYS.includes(key);
                        if (hasSavedSecret) {
                            control.placeholder = <?= json_encode((string)__('已配置，留空保留原凭证'), $jsonForScriptFlags) ?>;
                            control.autocomplete = 'new-password';
                        }
                        if (field.required && type !== 'checkbox' && !hasSavedSecret) {
                            control.required = true;
                        }
                        if (field.placeholder && !hasSavedSecret) {
                            control.placeholder = String(field.placeholder);
                        }
                        control.addEventListener('input', function() {
                            syncConfigJsonFromFields();
                            if (key === 'service_account' || key === 'site_url') {
                                updateGscOwnerActionHint();
                            }
                        });
                        control.addEventListener('change', function() {
                            syncConfigJsonFromFields();
                            if (key === 'service_account' || key === 'site_url') {
                                updateGscOwnerActionHint();
                            }
                        });
                        wrap.appendChild(control);

                        if (type === 'json') {
                            const tools = document.createElement('div');
                            tools.className = 'w-cluster';
                            tools.style.setProperty('--w-mt', 'var(--weline-space-2)');
                            tools.setAttribute('data-gap', 'sm');
                            const uploadBtn = document.createElement('button');
                            uploadBtn.type = 'button';
                            uploadBtn.className = 'w-button';
                            uploadBtn.setAttribute('data-tone', 'primary');
                            uploadBtn.setAttribute('data-variant', 'outline');
                            uploadBtn.setAttribute('data-size', 'sm');
                            uploadBtn.setAttribute('data-seo-json-upload-for', fieldId);
                            uploadBtn.textContent = <?= json_encode((string)__('上传 JSON 文件'), $jsonForScriptFlags) ?>;
                            tools.appendChild(uploadBtn);
                            const fileInput = document.createElement('input');
                            fileInput.type = 'file';
                            fileInput.accept = String(field.accept || '.json,application/json');
                            fileInput.hidden = true;
                            fileInput.setAttribute('data-seo-json-file-for', fieldId);
                            tools.appendChild(fileInput);
                            wrap.appendChild(tools);
                        }

                        if (field.hint) {
                            const hint = document.createElement('div');
                            hint.className = 'w-field__hint';
                            hint.textContent = String(field.hint);
                            wrap.appendChild(hint);
                        }

                        if (key === 'site_url') {
                            const action = document.createElement('div');
                            action.className = 'w-field__hint';
                            action.setAttribute('data-seo-gsc-owner-action', '1');
                            action.style.setProperty('--w-mt', 'var(--weline-space-2)');
                            wrap.appendChild(action);
                        }

                        if (!wrap.parentElement) {
                            fieldsRoot.appendChild(wrap);
                        }
                    });

                    syncConfigJsonFromFields();
                    updateGscOwnerActionHint();
                }

                /**
                 * 处理 JSON 文件上传到指定字段
                 */
                function handleJsonFileUpload(input) {
                    const file = input.files[0];
                    const targetId = input.getAttribute('data-seo-json-file-for') || '';
                    const target = targetId ? document.getElementById(targetId) : null;
                    if (!file || !target) {
                        return;
                    }

                    if (!file.name.endsWith('.json') && file.type !== 'application/json') {
                        showMessage('error', <?= json_encode((string)__('请上传 JSON 文件'), $jsonForScriptFlags) ?>);
                        input.value = '';
                        return;
                    }
                    if (file.size > 5 * 1024 * 1024) {
                        showMessage('error', <?= json_encode((string)__('文件大小不能超过 5MB'), $jsonForScriptFlags) ?>);
                        input.value = '';
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        try {
                            const jsonObj = JSON.parse(e.target.result);
                            target.value = JSON.stringify(jsonObj, null, 2);
                            target.focus();
                            syncConfigJsonFromFields();
                            updateGscOwnerActionHint();
                            showMessage('success', <?= json_encode((string)__('JSON 文件上传成功'), $jsonForScriptFlags) ?>);
                        } catch (err) {
                            showMessage('error', <?= json_encode((string)__('JSON 文件格式错误'), $jsonForScriptFlags) ?> + ': ' + err.message);
                        }
                        input.value = '';
                    };
                    reader.onerror = function() {
                        showMessage('error', <?= json_encode((string)__('文件读取失败，请重试'), $jsonForScriptFlags) ?>);
                        input.value = '';
                    };
                    reader.readAsText(file);
                }

                if (!window.__seoAccountFormActionsBound) {
                    window.__seoAccountFormActionsBound = true;

                    document.addEventListener('submit', function(event) {
                        if (!event.target || event.target.id !== 'seoAccountForm') {
                            return;
                        }
                        const nameInput = document.getElementById('seoAccountNameInput');
                        const platformCode = (document.getElementById('platformSelect') || {}).value || '';
                        if (!platformCode) {
                            event.preventDefault();
                            showMessage('warning', <?= json_encode((string)__('请先选择平台后再填写账户名称'), $jsonForScriptFlags) ?>);
                            return;
                        }
                        if (nameInput) {
                            enforceAccountNamePrefix(nameInput);
                            const prefix = nameInput.getAttribute('data-name-prefix') || getAccountNamePrefix(platformCode);
                            const suffix = extractAccountNameSuffix(nameInput.value.trim(), prefix).trim();
                            if (!prefix || suffix === '') {
                                event.preventDefault();
                                const template = nameInput.getAttribute('data-format-invalid') || '';
                                showMessage('warning', template.replace('%{1}', prefix));
                                nameInput.focus();
                                return;
                            }
                            nameInput.value = prefix + suffix;
                        }
                        document.getElementById('seoAccountConfigAction').value = event.submitter && event.submitter.hasAttribute('data-seo-account-verify') ? 'verify' : 'save';
                        syncConfigJsonFromFields();
                    }, true);

                    document.addEventListener('change', function(event) {
                        if (!event.target) {
                            return;
                        }
                        if (event.target.matches('#platformSelect')) {
                            handlePlatformChange(event.target.value);
                            return;
                        }
                        if (event.target.matches('[data-seo-json-file-for]')) {
                            handleJsonFileUpload(event.target);
                            return;
                        }
                        if (event.target.matches('[data-seo-capability-switch] input[type="checkbox"]')
                            && event.target.getAttribute('data-seo-unsupported') === '1') {
                            event.target.checked = false;
                            const tip = event.target.getAttribute('title')
                                || (event.target.id === 'enable_cron_push_urls'
                                    ? <?= json_encode((string)__('当前平台不支持 URL 定时推送；Google 普通页面请改用 Sitemap 定时提交'), $jsonForScriptFlags) ?>
                                    : <?= json_encode((string)__('当前平台不支持 Sitemap 定时提交'), $jsonForScriptFlags) ?>);
                            showMessage('warning', tip);
                        }
                    });

                    document.addEventListener('input', function(event) {
                        if (event.target && event.target.matches('#seoAccountNameInput')) {
                            enforceAccountNamePrefix(event.target);
                        }
                    });

                    document.addEventListener('click', function(event) {
                        const platformTab = event.target.closest('[data-seo-platform-tab]');
                        if (platformTab) {
                            event.preventDefault();
                            selectPlatformGroupTab(platformTab.getAttribute('data-seo-platform-tab') || '');
                            return;
                        }

                        const platformCard = event.target.closest('[data-seo-platform-card]');
                        if (platformCard) {
                            event.preventDefault();
                            selectPlatformCard(platformCard.getAttribute('data-seo-platform-card') || '');
                            return;
                        }

                        const guideToggle = event.target.closest('[data-seo-guide-toggle]');
                        if (guideToggle) {
                            event.preventDefault();
                            toggleGuideContent();
                            return;
                        }

                        const uploadTrigger = event.target.closest('[data-seo-json-upload-for]');
                        if (uploadTrigger) {
                            event.preventDefault();
                            const fieldId = uploadTrigger.getAttribute('data-seo-json-upload-for') || '';
                            const fileInput = document.querySelector('[data-seo-json-file-for="' + fieldId + '"]');
                            if (fileInput) {
                                fileInput.click();
                            }
                            return;
                        }
                    });

                    document.addEventListener('keydown', function(event) {
                        const guideToggle = event.target.closest('[data-seo-guide-toggle]');
                        if (!guideToggle || (event.key !== 'Enter' && event.key !== ' ')) {
                            return;
                        }
                        event.preventDefault();
                        toggleGuideContent();
                    });
                }

                // ==================== 页面初始化 ====================
                window.addEventListener('DOMContentLoaded', function() {
                    // 页面加载完成后，如果已选择平台，显示信息
                    if (currentSelectedPlatform) {
                        handlePlatformChange(currentSelectedPlatform);
                    }
                });
