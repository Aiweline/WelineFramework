/** @var \Weline\Seo\Model\SeoAccount $account */
$account = $account ?? null;
$scope = $scope ?? '';
$isAjax = $is_ajax ?? false;
$platforms = $platforms ?? [];
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;
$jsonForAttributeFlags = $jsonForScriptFlags;
/** @var PlatformVisual $platformVisual */
$platformVisual = ObjectManager::getInstance(PlatformVisual::class);
/** @var SeoPlatformGroupCatalog $platformGroupCatalog */
$platformGroupCatalog = ObjectManager::getInstance(SeoPlatformGroupCatalog::class);
$platformGroups = $platformGroupCatalog->build(is_array($platforms) ? $platforms : []);
$activePlatformGroupId = $platformGroupCatalog->groupIdForPlatform((string)$platform, is_array($platforms) ? $platforms : []);
if ($activePlatformGroupId === '' && $platformGroups !== []) {
    $activePlatformGroupId = (string)$platformGroups[0]['id'];
}

$id = $account ? (int)$account->getId() : 0;
$name = $account ? (string)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_NAME) : '';
$platform = $account ? (string)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_PLATFORM) : '';
$description = $account ? (string)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_DESCRIPTION) : '';
$isActive = $account ? (int)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_IS_ACTIVE) : 1;
$enableCronPush = $account ? (int)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_ENABLE_CRON_PUSH_URLS) : 1;
$enableCronSitemap = $account ? (int)$account->getData(\Weline\Seo\Model\SeoAccount::schema_fields_ENABLE_CRON_SITEMAP) : 1;

$configBoundary = new \Weline\Seo\Service\SeoAccountConfig();
$accountConfig = $account ? $account->getConfigArray() : [];
$configFields = (array)($platforms[$platform]['config_fields'] ?? []);
$configuredSecretKeys = $configBoundary->configuredSecrets($accountConfig, $configFields);
$configArray = $configBoundary->forDisplay($accountConfig, $configFields);
$configJson = $configArray ? json_encode($configArray, JSON_PRETTY_PRINT | $jsonForScriptFlags) : '';
$serviceAccountClientEmail = '';
$serviceAccountRaw = $accountConfig['service_account'] ?? null;
if (is_string($serviceAccountRaw) && $serviceAccountRaw !== '') {
    $decodedSa = json_decode($serviceAccountRaw, true);
    $serviceAccountRaw = is_array($decodedSa) ? $decodedSa : null;
}
if (is_array($serviceAccountRaw)) {
    $candidateEmail = trim((string)($serviceAccountRaw['client_email'] ?? ''));
    if ($candidateEmail !== '' && filter_var($candidateEmail, FILTER_VALIDATE_EMAIL)) {
        $serviceAccountClientEmail = $candidateEmail;
    }
}

$seoAccountWebsiteSelectOptions = [];
try {
    /** @var SeoWebsiteDirectory $seoWebsiteDirectory */
    $seoWebsiteDirectory = ObjectManager::getInstance(SeoWebsiteDirectory::class);
    foreach ($seoWebsiteDirectory->listWebsites() as $websiteRow) {
        if (!is_array($websiteRow)) {
            continue;
        }
        $websiteId = (int)($websiteRow['website_id'] ?? -1);
        if ($websiteId < 0) {
            continue;
        }
        $siteUrl = rtrim($seoWebsiteDirectory->effectivePublicBaseUrl($websiteRow), '/');
        $domain = strtolower((string)(parse_url($siteUrl, PHP_URL_HOST) ?: ($websiteRow['domain'] ?? '')));
        $code = trim((string)($websiteRow['code'] ?? ''));
        $label = trim((string)($websiteRow['name'] ?? ''));
        if ($label === '') {
            $label = (string)__('站点 %{1}', [$websiteId]);
        }
        $seoAccountWebsiteSelectOptions[] = [
            'value' => (string)$websiteId,
            'label' => $label,
            'meta' => $domain !== '' ? $domain : $code,
            'url' => $siteUrl,
            'domain' => $domain,
            'code' => $code,
        ];
    }
} catch (\Throwable) {
    $seoAccountWebsiteSelectOptions = [];
}
$seoAccountWebsiteSelectOptionsJson = json_encode($seoAccountWebsiteSelectOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';

$boundWebsiteIds = [];
if ($id > 0) {
    try {
        /** @var \Weline\Seo\Model\SeoWebsiteAccount $seoWebsiteAccountModel */
        $seoWebsiteAccountModel = ObjectManager::getInstance(\Weline\Seo\Model\SeoWebsiteAccount::class);
        foreach ($seoWebsiteAccountModel->reset()
            ->where(\Weline\Seo\Model\SeoWebsiteAccount::schema_fields_ACCOUNT_ID, $id)
            ->select()
            ->fetchArray() as $bindingRow) {
            $boundId = (int)($bindingRow[\Weline\Seo\Model\SeoWebsiteAccount::schema_fields_WEBSITE_ID] ?? -1);
            if ($boundId >= 0) {
                $boundWebsiteIds[] = $boundId;
            }
        }
        $boundWebsiteIds = array_values(array_unique($boundWebsiteIds));
    } catch (\Throwable) {
        $boundWebsiteIds = [];
    }
}
$boundWebsiteIdsValue = implode(',', array_map('strval', $boundWebsiteIds));

