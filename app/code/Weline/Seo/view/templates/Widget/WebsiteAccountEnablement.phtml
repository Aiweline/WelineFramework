$fieldName = static function (string $path, bool $isArray = false) use ($fieldPrefix): string {
    if ($fieldPrefix === '') {
        $parts = array_values(array_filter(explode('.', $path), static fn(string $part): bool => $part !== ''));
        $name = (string)array_shift($parts);
        foreach ($parts as $part) {
            $name .= '[' . $part . ']';
        }

        return $name . ($isArray ? '[]' : '');
    }

    $name = $fieldPrefix;
    foreach (explode('.', $path) as $part) {
        if ($part === '') {
            continue;
        }
        $name .= '[' . $part . ']';
    }

    return $name . ($isArray ? '[]' : '');
};

