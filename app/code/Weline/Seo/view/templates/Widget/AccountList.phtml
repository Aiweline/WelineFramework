<?php
/**
 * SEO 账户列表 Widget 模板
 * 
 * 可复用的 SEO 账户列表展示组件
 * 支持按 scope/module 过滤，以只读方式展示账户信息
 * 
 * @var \Weline\Framework\View\Template $this
 * @var string $widget_id Widget 唯一ID
 * @var string $scope 业务 scope
 * @var string $module 模块名
 * @var bool $readonly 是否只读模式
 * @var string $title 标题
 * @var array $accounts 账户列表
 * @var string $manage_url SEO 管理页面链接
 * @var bool $show_manage_link 是否显示管理链接
 * @var bool $has_accounts 是否有账户
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Seo\Service\PlatformVisual;

/** @var PlatformVisual $platformVisual */
$platformVisual = ObjectManager::getInstance(PlatformVisual::class);
?>
<div id="<?= htmlspecialchars($widget_id, ENT_QUOTES) ?>" class="seo-account-widget w-card">
    <div class="w-card__header w-cluster" data-justify="between" data-align="center">
        <h5 style="--w-mb:0;">
            <w:icon name="user" size="sm"></w:icon><?= htmlspecialchars($title, ENT_QUOTES) ?>
        </h5>
        <?php if ($show_manage_link): ?>
        <a href="<?= htmlspecialchars($manage_url, ENT_QUOTES) ?>" class="w-button" target="_blank" data-tone="primary" data-variant="outline" data-size="sm">
            <w:icon name="settings" size="sm"></w:icon>
            <lang>前往SEO管理配置</lang>
        </a>
        <?php endif; ?>
    </div>
    <div class="w-card__body">
        <?php if (!$has_accounts): ?>
        <div class="w-alert" data-tone="info" style="--w-mb:0;">
            <w:icon name="info" size="sm"></w:icon>
            <lang>暂无SEO账户配置</lang>
            <?php if ($show_manage_link): ?>
            <a href="<?= htmlspecialchars($manage_url, ENT_QUOTES) ?>" class="alert-link ms-2" target="_blank">
                <lang>点击前往配置</lang>
            </a>
            <?php endif; ?>
        </div>
        <?php else: ?>
        <div class="w-table-wrap">
            <table class="w-table" style="--w-mb:0;">
                <thead>
                    <tr>
                        <th width="60"><lang>ID</lang></th>
                        <th><lang>名称</lang></th>
                        <th><lang>供应商</lang></th>
                        <th width="80" class="w-text" data-align="center"><lang>状态</lang></th>
                        <th width="100" class="w-text" data-align="center"><lang>URL推送</lang></th>
                        <th width="100" class="w-text" data-align="center"><lang>Sitemap提交</lang></th>
                        <?php if (!$readonly): ?>
                        <th width="80" class="w-text" data-align="center"><lang>操作</lang></th>
                        <?php endif; ?>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($accounts as $account): ?>
                    <tr>
                        <td><?= (int)($account['account_id'] ?? 0) ?></td>
                        <td>
                            <strong><?= htmlspecialchars((string)($account['name'] ?? ''), ENT_QUOTES) ?></strong>
                            <?php if (!empty($account['description'])): ?>
                            <br><small class="w-text" data-tone="muted"><?= htmlspecialchars((string)$account['description'], ENT_QUOTES) ?></small>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php $platformCode = (string)($account['platform'] ?? $account['provider'] ?? ''); ?>
                            <span class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                                <?= $platformVisual->renderIcon($platformCode, $platformCode, null, 24) ?>
                                <code><?= htmlspecialchars((string)($account['provider'] ?? ''), ENT_QUOTES) ?></code>
                            </span>
                        </td>
                        <td class="w-text" data-align="center">
                            <?php if ((int)($account['is_active'] ?? 0) === 1): ?>
                            <span class="w-badge" data-w-background="success"><lang>启用</lang></span>
                            <?php else: ?>
                            <span class="w-badge" data-w-background="muted"><lang>禁用</lang></span>
                            <?php endif; ?>
                        </td>
                        <td class="w-text" data-align="center">
                            <?php if ((int)($account['enable_cron_push_urls'] ?? 0) === 1): ?>
                            <span class="w-badge" data-w-background="success"><w:icon name="check" size="sm"></w:icon></span>
                            <?php else: ?>
                            <span class="w-badge w-text" data-w-background="muted" data-tone="muted"><w:icon name="close" size="sm"></w:icon></span>
                            <?php endif; ?>
                        </td>
                        <td class="w-text" data-align="center">
                            <?php if ((int)($account['enable_cron_sitemap'] ?? 0) === 1): ?>
                            <span class="w-badge" data-w-background="success"><w:icon name="check" size="sm"></w:icon></span>
                            <?php else: ?>
                            <span class="w-badge w-text" data-w-background="muted" data-tone="muted"><w:icon name="close" size="sm"></w:icon></span>
                            <?php endif; ?>
                        </td>
                        <?php if (!$readonly): ?>
                        <td class="w-text" data-align="center">
                            <a href="<?= $this->getBackendUrl('seo/backend/account/form', [
                                'id' => (int)($account['account_id'] ?? 0),
                                'scope' => $scope
                            ]) ?>" class="w-button" target="_blank" data-tone="primary" data-variant="outline" data-size="sm">
                                <lang>编辑</lang>
                            </a>
                        </td>
                        <?php endif; ?>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        
        <div class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-4);">
            <w:icon name="info" size="sm"></w:icon>
            <lang>共</lang> <?= count($accounts) ?> <lang>个账户</lang>
            <?php if ($scope || $module): ?>
            <span class="ms-2">
                (<lang>过滤条件</lang>: 
                <?php if ($scope): ?>scope=<code><?= htmlspecialchars($scope, ENT_QUOTES) ?></code><?php endif; ?>
                <?php if ($scope && $module): ?>, <?php endif; ?>
                <?php if ($module): ?>module=<code><?= htmlspecialchars($module, ENT_QUOTES) ?></code><?php endif; ?>
                )
            </span>
            <?php endif; ?>
        </div>
        <?php endif; ?>
    </div>
</div>
