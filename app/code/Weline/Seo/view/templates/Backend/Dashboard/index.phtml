            </div>
        </section>
    <?php else: ?>
        <section class="w-stack" data-gap="md" aria-label="<?= htmlspecialchars((string)__('主体列表'), ENT_QUOTES, 'UTF-8') ?>" data-testid="seo-dashboard-subjects">
            <?php foreach ($subjects as $subject):
                if (!is_array($subject)) {
                    continue;
                }
                $subjectId = (int)($subject['subject_id'] ?? 0);
                $keywords = is_array($subject['keywords'] ?? null) ? $subject['keywords'] : [];
                $keywordCount = (int)($subject['keyword_count'] ?? count($keywords));
                ?>
                <article class="w-card seo-dashboard-subject" data-w-shadow="sm">
                    <div class="w-card__body w-stack" data-gap="sm">
                        <div class="w-cluster" data-align="start" data-justify="between" data-wrap="true" data-gap="md">
                            <div class="w-stack" data-gap="2xs">
                                <h2 class="seo-dashboard-subject__title">
                                    <?= htmlspecialchars((string)($subject['title'] ?? __('未命名主体')), ENT_QUOTES, 'UTF-8') ?>
                                </h2>
                                <?php if (!empty($subject['url'])): ?>
                                    <a class="w-text" data-tone="muted" data-size="sm" href="<?= htmlspecialchars((string)$subject['url'], ENT_QUOTES, 'UTF-8') ?>" target="_blank" rel="noopener">
                                        <?= htmlspecialchars((string)$subject['url'], ENT_QUOTES, 'UTF-8') ?>
                                    </a>
                                <?php endif; ?>
                            </div>
                            <div class="w-cluster" data-gap="sm" data-align="center">
                                <span class="w-badge" data-w-background="info">
                                    <?= number_format($keywordCount) ?> <lang>个关键词</lang>
                                </span>
                                <a class="w-button" href="@backend-url{'seo/backend/dashboard/subject'|['id' => $subjectId]}" data-variant="outline" data-size="sm">
                                    <w:icon name="eye" size="sm"></w:icon> <lang>查看详情</lang>
                                </a>
                            </div>
                        </div>

                        <?php if (!empty($subject['description'])): ?>
                            <p class="w-text" data-tone="muted" data-size="sm">
                                <?= htmlspecialchars(mb_substr((string)$subject['description'], 0, 200), ENT_QUOTES, 'UTF-8') ?>
                                <?= mb_strlen((string)$subject['description']) > 200 ? '…' : '' ?>
                            </p>
                        <?php endif; ?>

                        <?php if ($keywords !== []): ?>
                            <ul class="seo-dashboard-keywords">
                                <?php foreach ($keywords as $index => $keyword):
                                    if (!is_array($keyword)) {
                                        continue;
                                    }
                                    ?>
