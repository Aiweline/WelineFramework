<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array $subjects
 */
$subjects = is_array($subjects ?? null) ? $subjects : [];
$title = (string)($seo_page_title ?? __('SEO总览'));

$totalSubjects = count($subjects);
$totalKeywords = 0;
foreach ($subjects as $subject) {
    if (!is_array($subject)) {
        continue;
    }
    $totalKeywords += (int)($subject['keyword_count'] ?? 0);
}
$avgKeywords = $totalSubjects > 0 ? (int)round($totalKeywords / $totalSubjects) : 0;

$kpis = [
    ['icon' => 'file', 'value' => $totalSubjects, 'label' => __('SEO 主体')],
    ['icon' => 'tag', 'value' => $totalKeywords, 'label' => __('关键词')],
    ['icon' => 'check', 'value' => $totalSubjects, 'label' => __('已启用')],
    ['icon' => 'circle', 'value' => $avgKeywords, 'label' => __('平均关键词')],
];

$nextSteps = [
    [
        'title' => __('接入搜索平台'),
        'desc' => __('新增 Google / Bing / 百度等账户并完成验证。'),
        'href' => 'seo/backend/account/form',
        'cta' => __('新增账户'),
        'icon' => 'user',
        'primary' => false,
    ],
    [
        'title' => __('绑定站点'),
        'desc' => __('把已验证账户挂到要优化的网站。'),
        'href' => 'seo/backend/website-account',
        'cta' => __('去绑定'),
        'icon' => 'link',
        'primary' => false,
    ],
    [
        'title' => __('创建 SEO 主体'),
        'desc' => __('为主体挂关键词后，总览才会出现可运营数据。'),
        'href' => 'seo/backend/embed/index',
        'cta' => __('创建主体'),
        'icon' => 'plus',
        'primary' => true,
    ],
];
