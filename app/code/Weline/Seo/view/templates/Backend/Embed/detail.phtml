$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$config = [
    'subjectId' => (int)($subject['subject_id'] ?? 0),
    'text' => [
        'saveSuccess' => (string)__('保存成功'),
        'saveFailed' => (string)__('保存失败'),
        'generateFailed' => (string)__('生成建议失败'),
        'requestFailed' => (string)__('请求失败'),
    ],
];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
    | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE;
