    <script src="@static(Weline_Admin::backend/lib/bootstrap-5.1.3-dist/js/bootstrap.bundle.min.js)"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const saveUrl = <?= $jsString($this->getUrl('*/backend/embed/save')) ?>;
        const deleteUrl = <?= $jsString($this->getUrl('*/backend/embed/delete')) ?>;
        const text = {
            saveSuccess: <?= $jsString(__('保存成功')) ?>,
            saveFailed: <?= $jsString(__('保存失败')) ?>,
            deleteFailed: <?= $jsString(__('删除失败')) ?>,
            requestFailed: <?= $jsString(__('请求失败')) ?>,
            confirmDelete: <?= $jsString(__('确定要删除该SEO主体吗？')) ?>,
            confirmUnavailable: <?= $jsString(__('确认组件不可用，请刷新页面后重试。')) ?>
        };

        function getBackendTool(name) {
            if (window[name]) {
                return window[name];
            }
            try {
                if (window.parent && window.parent !== window && window.parent[name]) {
                    return window.parent[name];
                }
            } catch (error) {
                return null;
            }
            return null;
        }

        function notify(type, message) {
            var toast = getBackendTool('Weline.UI.toast');
            if (toast && typeof toast[type] === 'function') {
                toast[type](typeof message === 'string' ? message : String(message || ''));
            }
        }

        function requestFailedMessage(error) {
            return text.requestFailed + (error && error.message ? ': ' + error.message : '');
        }
        
        // 添加主体表单提交
        document.getElementById('addSubjectForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(this);
            var params = {};
            formData.forEach(function(v,k){ params[k]=v; });
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('seo_admin').saveEmbedSubject(params); })
            .then(function(data) {
                if (data && data.success !== false) {
                    notify('success', (data && data.message) || text.saveSuccess);
                    location.reload();
                } else {
                    notify('error', (window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError({response:{data:data}}, text.saveFailed)) || text.saveFailed);
                }
            })
            .catch(function(error) {
                notify('error', (window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError(error, text.requestFailed)) || requestFailedMessage(error));
            });
        });
        
        // 删除按钮
        document.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var subjectId = this.dataset.subjectId;
                var self = this;
                var doDelete = function(confirmed) {
                    if (!confirmed) return;
                    Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                    .then(function(api){ return api.resource('seo_admin').deleteEmbedSubject({ subject_id: subjectId }); })
                    .then(function(data) {
                        if (data && data.success !== false) {
                            var card = self.closest('.subject-card');
                            if (card) card.remove();
                        } else {
                            notify('error', (window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError({response:{data:data}}, text.deleteFailed)) || text.deleteFailed);
                        }
                    })
                    .catch(function(error) {
                        notify('error', (window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError(error, text.requestFailed)) || requestFailedMessage(error));
                    });
                };
                Weline.UI.dialog.confirm(text.confirmDelete, {
                    tone: 'danger',
                    dangerous: true
                }).then(doDelete);
            });
        });
    });
    </script>
