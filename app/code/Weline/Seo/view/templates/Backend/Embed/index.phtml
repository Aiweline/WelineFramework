<?php
/** @var \Weline\Framework\View\Template $this */
$subjects = is_array($this->getData('subjects')) ? $this->getData('subjects') : [];
$title = (string)($this->getData('title') ?: __('SEO主体管理'));
$module = (string)($this->getData('module') ?: '');
$scope = (string)($this->getData('scope') ?: '');
$search = (string)($this->getData('search') ?: '');
$status = $this->getData('status');
$baseParams = $scope !== '' ? ['scope' => $scope] : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$config = ['text' => [
    'saveSuccess' => (string)__('保存成功'),
    'saveFailed' => (string)__('保存失败'),
    'deleteFailed' => (string)__('删除失败'),
    'requestFailed' => (string)__('请求失败'),
    'confirmDelete' => (string)__('确定要删除该SEO主体吗？'),
]];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
    | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE;
?>
<!doctype html>
<html lang="zh-CN" data-w-area="backend" data-theme-preference="system" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $escape($title) ?></title>
    <w:block class="Weline\Backend\Block\Header\Base" template="Weline_Backend::header/base.phtml"/>
    <link rel="stylesheet" href="@static(Weline_Theme::ui/weline-foundation.css)">
    <link rel="stylesheet" href="@static(Weline_Theme::ui/weline-backend.css)">
    <link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-seo-embed.css)">
    <script type="module" src="@static(Weline_Theme::ui/weline-ui.js)"></script>
    <script type="module" src="@static(Weline_Theme::ui/pages/weline-seo-embed-index.js)"></script>
</head>
<body data-testid="seo-subject-management">
<main class="w-seo-embed w-stack">
    <header class="w-seo-embed__header w-cluster" data-justify="between">
        <div class="w-cluster"><h1 class="w-seo-embed__title"><w:icon name="chart" size="sm"></w:icon><?= $escape($title) ?></h1><span class="w-badge" data-tone="neutral"><?= count($subjects) ?></span></div>
        <button type="button" class="w-button" data-w-target="#addSubjectModal" data-w-action="dialog.open" data-tone="primary"><w:icon name="plus" size="sm"></w:icon><lang>添加主体</lang></button>
    </header>

    <section class="w-card">
        <div class="w-card__body">
            <w:form method="get" action="@var($this->getUrl('*/backend/embed', $baseParams))" class="w-grid">
                <?php if ($module !== ''): ?><input type="hidden" name="module" value="<?= $escape($module) ?>"><?php endif; ?>
                <?php if ($scope !== ''): ?><input type="hidden" name="scope" value="<?= $escape($scope) ?>"><?php endif; ?>
                <label class="w-field" style="--w-span:5;"><span class="w-field__label"><lang>搜索</lang></span><input class="w-input" name="search" value="<?= $escape($search) ?>" placeholder="<?= $escape(__('输入主体标题...')) ?>"></label>
                <label class="w-field" style="--w-span:3;"><span class="w-field__label"><lang>状态</lang></span><select class="w-select" name="status">
                    <option value=""><?= $escape(__('全部状态')) ?></option>
                    <option value="1" <?= $status === '1' ? 'selected' : '' ?>><?= $escape(__('启用')) ?></option>
                    <option value="0" <?= $status === '0' ? 'selected' : '' ?>><?= $escape(__('禁用')) ?></option>
                </select></label>
                <div class="w-cluster" data-self="end" style="--w-span:4;">
                    <button type="submit" class="w-button" data-tone="primary"><w:icon name="search" size="sm"></w:icon><lang>搜索</lang></button>
                    <a href="<?= $escape($this->getUrl('*/backend/embed', $baseParams)) ?>" class="w-button" data-tone="neutral"><w:icon name="refresh" size="sm"></w:icon><lang>重置</lang></a>
                </div>
            </w:form>
        </div>
    </section>

    <section class="w-stack" id="seoSubjectList">
        <?php if ($subjects === []): ?>
            <div class="w-empty"><w:icon name="file" size="lg"></w:icon><h2><lang>暂无SEO主体</lang></h2><p><lang>点击“添加主体”创建第一条记录。</lang></p></div>
        <?php else: ?>
            <?php foreach ($subjects as $subject): ?>
                <?php $detailUrl = $this->getUrl('*/backend/embed/detail', array_merge($baseParams, ['id' => $subject['subject_id']])); ?>
                <article class="w-card w-seo-embed__subject" data-subject-id="<?= (int)($subject['subject_id'] ?? 0) ?>">
                    <header class="w-card__header w-cluster" data-justify="between">
                        <div class="w-cluster"><a href="<?= $escape($detailUrl) ?>" class="w-card__title"><?= $escape($subject['title'] ?? __('未命名主体')) ?></a><span class="w-badge" data-tone="<?= (int)($subject['status'] ?? 0) === 1 ? 'success' : 'neutral' ?>"><?= (int)($subject['status'] ?? 0) === 1 ? __('启用') : __('禁用') ?></span></div>
                        <div class="w-cluster">
                            <span class="w-seo-embed__keyword"><w:icon name="tag" size="sm"></w:icon><?= (int)($subject['keyword_count'] ?? 0) ?> <lang>关键词</lang></span>
                            <a href="<?= $escape($detailUrl) ?>" class="w-button" aria-label="<?= $escape(__('查看详情')) ?>" data-tone="neutral" data-size="sm"><w:icon name="eye" size="sm"></w:icon></a>
                            <button type="button" class="w-button" data-seo-action="delete" data-subject-id="<?= (int)($subject['subject_id'] ?? 0) ?>" aria-label="<?= $escape(__('删除')) ?>" data-tone="danger" data-size="sm"><w:icon name="trash" size="sm"></w:icon></button>
                        </div>
                    </header>
                    <div class="w-card__body w-stack" style="--w-gap:var(--weline-space-2);">
                        <?php if (!empty($subject['url'])): ?><a href="<?= $escape($subject['url']) ?>" target="_blank" rel="noopener noreferrer"><w:icon name="link" size="sm"></w:icon><?= $escape($subject['url']) ?></a><?php endif; ?>
                        <?php if (!empty($subject['description'])): ?><p class="w-text" data-tone="muted"><?= $escape(mb_substr((string)$subject['description'], 0, 150)) ?><?= mb_strlen((string)$subject['description']) > 150 ? '…' : '' ?></p><?php endif; ?>
                        <div class="w-cluster w-text" data-tone="muted"><span><w:icon name="clock" size="sm"></w:icon><?= $escape($subject['updated_at'] ?? '-') ?></span><?php if (!empty($subject['locale'])): ?><span><w:icon name="language" size="sm"></w:icon><?= $escape($subject['locale']) ?></span><?php endif; ?></div>
                    </div>
                </article>
            <?php endforeach; ?>
        <?php endif; ?>
    </section>
</main>

<dialog class="w-dialog" id="addSubjectModal" aria-labelledby="addSubjectModalLabel" data-w-component="dialog" data-state="closed">
    <header class="w-dialog__header"><h2 class="w-dialog__title" id="addSubjectModalLabel"><w:icon name="plus" size="sm"></w:icon><lang>添加SEO主体</lang></h2><button type="button" class="w-button" data-w-action="dialog.close" data-tone="quiet" aria-label="<?= $escape(__('关闭')) ?>">×</button></header>
    <w:form id="addSubjectForm" class="w-stack">
        <div class="w-dialog__body w-stack">
            <input type="hidden" name="module" value="<?= $escape($module) ?>"><input type="hidden" name="scope" value="<?= $escape($scope) ?>">
            <div class="w-grid">
                <label class="w-field" style="--w-span:6;"><span class="w-field__label"><lang>标题</lang></span><input class="w-input" name="title" required></label>
                <label class="w-field" style="--w-span:6;"><span class="w-field__label">URL</span><input type="url" class="w-input" name="url" placeholder="https://"></label>
                <label class="w-field" style="--w-span:6;"><span class="w-field__label"><lang>主体类型</lang></span><select class="w-select" name="subject_type"><option value="page"><?= $escape(__('页面')) ?></option><option value="product"><?= $escape(__('商品')) ?></option><option value="store"><?= $escape(__('店铺')) ?></option><option value="website"><?= $escape(__('网站')) ?></option></select></label>
                <label class="w-field" style="--w-span:6;"><span class="w-field__label"><lang>状态</lang></span><select class="w-select" name="status"><option value="1"><?= $escape(__('启用')) ?></option><option value="0"><?= $escape(__('禁用')) ?></option></select></label>
            </div>
            <label class="w-field"><span class="w-field__label"><lang>描述</lang></span><textarea class="w-textarea" name="description" rows="3"></textarea></label>
        </div>
        <footer class="w-dialog__footer"><button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><lang>取消</lang></button><button type="submit" class="w-button" data-tone="primary"><w:icon name="save" size="sm"></w:icon><lang>保存</lang></button></footer>
    </w:form>
</dialog>
<script type="application/json" id="weline-seo-embed-index-config" data-seo-embed-index-config><?= json_encode($config, $jsonFlags) ?: '{}' ?></script>
</body>
</html>
