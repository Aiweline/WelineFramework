                                $wid = (int)($website['website_id'] ?? -1);
                                if ($wid < 0) {
                                    continue;
                                }
                                $label = (string)($website['name'] ?? ('#' . $wid));
                                ?>
                                <option value="<?= $wid ?>" <?= ($filter_website_id === $wid) ? 'selected' : '' ?>>
