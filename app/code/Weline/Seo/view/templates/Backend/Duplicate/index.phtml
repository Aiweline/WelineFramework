                <div class="seo-empty-state" data-testid="seo-dup-runs-empty">
                    <w:icon name="file" size="lg"></w:icon>
                    <p><lang>暂无跑批记录。选好站点后开始第一次扫描。</lang></p>
                </div>
            <?php else: ?>
                <div class="seo-admin__table-wrap">
                    <table class="seo-admin__table seo-account-table" data-testid="seo-dup-run-table">
                        <thead>
                        <tr>
                            <th>run_id</th>
                            <th><lang>站点</lang></th>
                            <th><lang>状态</lang></th>
                            <th><lang>问题数</lang></th>
                            <th><lang>开始</lang></th>
                            <th><lang>报告</lang></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php foreach ($runs as $run):
                            $path = (string)($run['report_path'] ?? '');
                            if ($path === '' && !empty($run['run_id'])) {
                                $path = (string)($panel_path ?? '') !== ''
                                    ? \rtrim((string)$panel_path, '/') . '/report?run_id=' . (int)$run['run_id']
                                    : '/seo/backend/duplicate/report?run_id=' . (int)$run['run_id'];
                            }
                            $status = (string)($run['status'] ?? '');
                            $statusClass = match ($status) {
                                'completed' => 'is-success',
                                'failed' => 'is-warning',
                                'running' => 'is-info',
                                default => 'is-muted',
                            };
                            ?>
                            <tr>
                                <td>#<?= (int)($run['run_id'] ?? 0) ?></td>
                                <td>#<?= (int)($run['website_id'] ?? 0) ?></td>
                                <td><span class="seo-status <?= $statusClass ?>"><?= htmlspecialchars($status, ENT_QUOTES, 'UTF-8') ?></span></td>
                                <td><?= (int)($run['issue_count'] ?? 0) ?></td>
                                <td><?= htmlspecialchars((string)($run['started_at'] ?? ''), ENT_QUOTES, 'UTF-8') ?></td>
                                <td>
                                    <?php if ($path !== ''): ?>
                                        <a class="w-button" data-variant="outline" data-size="sm" href="<?= htmlspecialchars($path, ENT_QUOTES, 'UTF-8') ?>" data-testid="seo-dup-view-report">
                                            <lang>查看报告</lang>
                                        </a>
                                    <?php endif; ?>
                                </td>
