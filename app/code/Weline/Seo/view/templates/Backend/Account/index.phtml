<?php
/** @var \Weline\Framework\View\Template $this */
use Weline\Framework\Manager\ObjectManager;
use Weline\Seo\Service\PlatformVisual;

$accounts = is_array($accounts ?? null) ? $accounts : [];
$scope = (string)($scope ?? '');
/** @var PlatformVisual $visual */
$visual = ObjectManager::getInstance(PlatformVisual::class);

$activeCount = 0;
$bindingCount = 0;
$indexed = 0;
$errors = 0;
foreach ($accounts as $account) {
    if (!is_array($account)) {
        continue;
    }
    $activeCount += (int)($account['is_active'] ?? 0) === 1 ? 1 : 0;
    $bindingCount += (int)($account['bound_websites_count'] ?? 0);
    $stats = is_array($account['stats'] ?? null) ? $account['stats'] : [];
    $indexed += (int)($stats['indexed_pages'] ?? 0);
    $errors += (int)($stats['error_count'] ?? 0);
}
$kpis = [
    ['icon' => 'users', 'value' => count($accounts), 'label' => __('账户')],
    ['icon' => 'check-circle', 'value' => $activeCount, 'label' => __('启用')],
    ['icon' => 'link', 'value' => $bindingCount, 'label' => __('站点绑定')],
    ['icon' => 'file', 'value' => $indexed, 'label' => __('已收录页面')],
    ['icon' => 'warning', 'value' => $errors, 'label' => __('平台错误')],
];
?>
