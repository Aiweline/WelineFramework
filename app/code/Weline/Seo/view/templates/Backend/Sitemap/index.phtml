                $locales = [];
                foreach ($scopeStats as $row) {
                    foreach ((array)($row['locales'] ?? []) as $locale) { $locales[(string)$locale] = true; }
                }
                $generated = !empty($fileTree['generated']);
                $submissionReady = !empty($website['submission_ready']);
