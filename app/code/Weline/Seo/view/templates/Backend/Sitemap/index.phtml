                                                    </div>
                                                <?php else: ?>
                                                    <p class="seo-language-group__pending"><lang>索引待生成；同步 URL 后执行“生成 canonical”。</lang></p>
                                                <?php endif; ?>

                                                <div class="seo-sitemap-target__branch">
                                                    <?php if ($targetGroups === []): ?>
                                                        <div class="seo-language-files__empty">
                                                            <i class="mdi mdi-translate-off" aria-hidden="true"></i>
                                                            <span><lang>暂无语言文件；请先同步 URL，再生成 canonical Sitemap。</lang></span>
                                                        </div>
                                                    <?php endif; ?>

                                                    <?php foreach ($targetGroups as $group):
                                                        if (!is_array($group)) { continue; }
                                                        $locale = (string)($group['locale'] ?? '');
                                                        $fileLocaleLabel = $locale === '' ? (string)__('默认桶（locale 未声明）') : $locale;
                                                        $fileLocaleText = (string)__('语言：%{1}', $fileLocaleLabel);
                                                        $groupFiles = is_array($group['files'] ?? null) ? $group['files'] : [];
                                                        $groupGenerated = !empty($group['generated']);
                                                        $urlCount = $group['url_count'] ?? null;
                                                    ?>
                                                        <details class="seo-sitemap-bucket <?= $groupGenerated ? 'is-generated' : 'is-pending' ?>">
                                                            <summary>
                                                                <span class="seo-tree-node__icon"><i class="mdi mdi-translate" aria-hidden="true"></i></span>
                                                                <span class="seo-tree-node__identity">
                                                                    <strong><?= htmlspecialchars($locale === '' ? (string)__('默认桶') : $locale, ENT_QUOTES, 'UTF-8') ?></strong>
                                                                    <span><code><?= htmlspecialchars((string)($group['module'] ?? ''), ENT_QUOTES, 'UTF-8') ?></code> · <?= htmlspecialchars((string)($group['scope'] ?? ''), ENT_QUOTES, 'UTF-8') ?></span>
                                                                </span>
                                                                <span class="seo-tree-node__metrics">
                                                                    <strong><?= $urlCount === null ? '—' : number_format((int)$urlCount) ?></strong> <lang>URL</lang>
                                                                    <span aria-hidden="true">·</span>
                                                                    <strong><?= number_format((int)($group['file_count'] ?? 0)) ?></strong> <lang>个 XML 分片</lang>
                                                                </span>
                                                                <i class="mdi mdi-chevron-down seo-tree-node__chevron" aria-hidden="true"></i>
                                                            </summary>

                                                            <div class="seo-sitemap-bucket__files">
                                                                <?php if (!$groupGenerated): ?>
                                                                    <p class="seo-language-group__pending"><lang>该语言已有 URL 数据，但当前 manifest 中还没有对应 XML 文件。</lang></p>
                                                                <?php endif; ?>

                                                                <?php foreach ($groupFiles as $file):
                                                                    if (!is_array($file)) { continue; }
                                                                    $fileUrl = trim((string)($file['url'] ?? ''));
                                                                ?>
                                                                    <div class="seo-sitemap-file">
                                                                        <div class="seo-sitemap-file__name">
                                                                            <i class="mdi mdi-file-xml-box" aria-hidden="true"></i>
                                                                            <code title="<?= htmlspecialchars((string)($file['filename'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string)($file['filename'] ?? ''), ENT_QUOTES, 'UTF-8') ?></code>
                                                                        </div>
                                                                        <div class="seo-sitemap-file__meta">
                                                                            <span class="seo-sitemap-file__locale" aria-label="<?= htmlspecialchars($fileLocaleText, ENT_QUOTES, 'UTF-8') ?>" title="<?= htmlspecialchars($fileLocaleText, ENT_QUOTES, 'UTF-8') ?>">
                                                                                <i class="mdi mdi-translate" aria-hidden="true"></i>
                                                                                <?= htmlspecialchars($fileLocaleText, ENT_QUOTES, 'UTF-8') ?>
                                                                            </span>
                                                                            <span><strong><?= number_format((int)($file['count'] ?? 0)) ?></strong> <lang>URL</lang></span>
                                                                            <span><?= number_format((int)($file['size'] ?? 0)) ?> <lang>字节</lang></span>
                                                                            <?php if (!empty($file['lastmod'])): ?>
                                                                                <span><lang>最近内容更新</lang> <?= htmlspecialchars((string)$file['lastmod'], ENT_QUOTES, 'UTF-8') ?></span>
                                                                            <?php endif; ?>
                                                                        </div>
                                                                        <?php if ($fileUrl !== ''): ?>
                                                                            <div class="seo-sitemap-file__actions">
                                                                                <button type="button" class="btn btn-sm btn-link" data-seo-copy="<?= htmlspecialchars($fileUrl, ENT_QUOTES, 'UTF-8') ?>" aria-label="<?= htmlspecialchars((string)__('复制 %{1} 的 URL', (string)($file['filename'] ?? '')), ENT_QUOTES, 'UTF-8') ?>">
                                                                                    <i class="mdi mdi-content-copy" aria-hidden="true"></i> <lang>复制文件地址</lang>
                                                                                </button>
                                                                                <a class="btn btn-sm btn-outline-primary" href="<?= htmlspecialchars($fileUrl, ENT_QUOTES, 'UTF-8') ?>" target="_blank" rel="noopener">
                                                                                    <lang>打开文件</lang> <i class="mdi mdi-open-in-new" aria-hidden="true"></i>
                                                                                </a>
                                                                            </div>
                                                                        <?php endif; ?>
                                                                    </div>
                                                                <?php endforeach; ?>
                                                            </div>
                                                        </details>
                                                    <?php endforeach; ?>
                                                </div>
                                            </div>
                                        </details>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                        </details>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
        <div class="seo-empty-state d-none" data-seo-filter-empty><i class="mdi mdi-filter-off-outline" aria-hidden="true"></i><p><lang>没有符合筛选条件的站点</lang></p></div>
    </section>

