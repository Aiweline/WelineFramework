                    $domainSearchParts[] = (string)($publicOriginRow['domain'] ?? '');
                    $domainSearchParts[] = (string)($publicOriginRow['url'] ?? '');
                }
                $searchText = strtolower(implode(' ', [
                    (string)($website['name'] ?? ''), (string)($website['code'] ?? ''),
                    (string)($website['domain'] ?? ''), (string)($website['url'] ?? ''),
