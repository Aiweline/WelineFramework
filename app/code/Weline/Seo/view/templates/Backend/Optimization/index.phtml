function renderSites(sites){var body=id('seoRtSiteRows'),cards=id('seoRtSiteCards');clear(body);clear(cards);setText('seoRtScopeLabel',rt.scope===null?'全部授权站点':'单站视图');if(!sites.length){var row=make('tr'),cell=make('td','seo-rt__empty','没有可显示的授权站点');cell.colSpan=6;row.appendChild(cell);body.appendChild(row);cards.appendChild(make('div','seo-rt__empty','没有可显示的授权站点'));return}sites.forEach(function(site){var row=make('tr');var identity=make('td');identity.appendChild(make('strong','',site.name||('网站 #'+site.website_id)));identity.appendChild(make('small','',site.domain||('#'+site.website_id)));row.appendChild(identity);var mode=make('td');mode.appendChild(make('span','seo-rt__pill',site.mode||'shadow'));row.appendChild(mode);var phase=make('td');phase.appendChild(make('span','seo-rt__pill '+(site.lifecycle_state==='running'?'is-running':''),phaseNames[site.phase]||site.phase||'等待调度'));phase.appendChild(renderProgress(site.progress));row.appendChild(phase);var issues=make('td');issues.appendChild(make('strong','',String(site.issue_count||0)));issues.appendChild(make('small','',site.failure_count?('异常 '+site.failure_count):'无异常'));row.appendChild(issues);var times=make('td');times.appendChild(make('strong','',formatTime(site.last_analysis_at)));times.appendChild(make('small','',site.schedule_state==='off'?'未启用':site.schedule_state==='due'?'等待系统调度':formatTime(site.next_analysis_at)+' · '+relativeTime(site.next_analysis_at)));row.appendChild(times);var action=make('td'),button=make('button','seo-rt__open');button.type='button';button.setAttribute('aria-label','查看 '+(site.name||('网站 '+site.website_id)));button.appendChild(make('i','chevron-right'));button.addEventListener('click',function(){openSite(site.website_id)});action.appendChild(button);row.appendChild(action);body.appendChild(row);
var card=make('article','seo-rt__site-card');var title=make('div');title.appendChild(make('strong','',site.name||('网站 #'+site.website_id)));title.appendChild(make('small','',site.domain||('#'+site.website_id)));card.appendChild(title);var state=make('div');state.appendChild(make('span','seo-rt__pill '+(site.lifecycle_state==='running'?'is-running':''),phaseNames[site.phase]||site.phase));state.appendChild(make('small','',progressText(site.progress)));card.appendChild(state);var cardButton=button.cloneNode(true);cardButton.addEventListener('click',function(){openSite(site.website_id)});card.appendChild(cardButton);cards.appendChild(card)})}
function renderStage(sites){var panel=id('seoRtStagePanel');if(rt.scope===null||!sites.length){panel.hidden=true;return}panel.hidden=false;var site=sites[0]||{},phase=site.phase||'scheduled',index=phases.indexOf(phase);setText('seoRtStageTitle',phaseNames[phase]||phase);setText('seoRtNextCheck',site.schedule_state==='off'?'未启用':site.schedule_state==='due'?'已到期，等待系统调度':formatTime(site.next_analysis_at)+'（'+relativeTime(site.next_analysis_at)+'）');var rail=id('seoRtStageRail');clear(rail);phases.forEach(function(item,position){var li=make('li','',phaseNames[item]);if(index>=0&&position<index){li.classList.add('is-past')}if(position===index){li.classList.add('is-current');li.setAttribute('aria-current','step')}rail.appendChild(li)});var readiness=id('seoRtReadiness'),data=site.data_readiness||{};readiness.textContent=data.state==='sample_insufficient'?'数据准备度：样本门槛尚未达成，系统不会调用 AI 或修改站点。':data.state==='not_checked'?'数据准备度：等待首次检测。':'数据准备度：最近一次检测已完成数据完整度检查。'}
