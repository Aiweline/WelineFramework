    }
    return Promise.reject(new Error('Weline.Api.resource unavailable'))
}
function message(text,isError){var target=byId('pageMessage');target.textContent=text||'';target.classList.toggle('is-error',Boolean(isError));target.hidden=!text}
function toast(text,isError){var target=byId('seoOptToast');window.clearTimeout(state.toastTimer);target.textContent=text;target.classList.toggle('is-error',Boolean(isError));target.hidden=false;state.toastTimer=window.setTimeout(function(){target.hidden=true},4200)}
