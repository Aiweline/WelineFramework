    if(window.Weline&&window.Weline.Api&&typeof window.Weline.Api.resource==='function'){
        return Promise.resolve(window.Weline.Api.resource(name))
    }
    if(window.Weline&&typeof window.Weline.load==='function'){
        return Promise.resolve(window.Weline.load('api')).then(function(){
            if(!window.Weline.Api||typeof window.Weline.Api.resource!=='function'){
                throw new Error('Weline.Api.resource unavailable')
