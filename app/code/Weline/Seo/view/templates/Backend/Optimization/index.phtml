function renderChanges(body,detail){var block=section('受限字段修改前后对比');var found=false;(Array.isArray(detail.runs)?detail.runs:[]).forEach(function(run){(Array.isArray(run.change_summary)?run.change_summary:[]).forEach(function(change){found=true;var row=make('div','seo-rt__change');row.appendChild(make('code','',change.path));var before=make('pre');before.textContent=String(change.before===null?'—':change.before);row.appendChild(before);row.appendChild(make('span','','→'));var after=make('pre');after.textContent=String(change.after===null?'—':change.after);row.appendChild(after);block.appendChild(row)})});if(!found){block.appendChild(make('div','seo-rt__empty','该任务没有受限字段摘要，或属于上线前的历史记录。回滚仍只读取 Owner optimization checkpoint。'))}body.appendChild(block)}
