function renderAudit(){var events=state.runs.map(function(run){return{title:status(run.status).label+' · '+target(run),description:recommendation(run).objective||value(run.error_code),time:run.updated_at||run.created_at,icon:'circle'}}).concat(state.experiments.map(function(experiment){return{title:status(experiment.status).label+' · '+target(experiment),description:value(experiment.primary_metric),time:experiment.updated_at||experiment.created_at,icon:'circle'}})).sort(function(left,right){return String(right.time||'').localeCompare(String(left.time||''))}).slice(0,30),targetElement=byId('auditList');if(!events.length){targetElement.innerHTML=empty('clock',copy.noAudit);return}targetElement.innerHTML=events.map(function(event){return'<article><i class="mdi '+event.icon+'"></i><div><strong>'+html(event.title)+'</strong><span>'+html(event.description)+'</span></div><time>'+html(formatDate(event.time))+'</time></article>'}).join('')}
function renderEvolve(){
    var cloud=byId('queryCloud'),events=byId('eventHeatList'),emptyCloud=state.gscBound?(copy.noQueryItems||copy.noQueryCloud):(copy.noGscBound||copy.noQueryCloud),emptyEvents=events?events.getAttribute('data-empty')||copy.noEventHeat:copy.noEventHeat;
