function openSite(websiteId){var url=new URL(window.location.href);url.searchParams.set('website_id',String(websiteId));window.location.assign(url.toString())}
function openAllSites(){var url=new URL(window.location.href);url.searchParams.delete('website_id');window.location.assign(url.toString())}
function openDetail(cycleId,runId,trigger){rt.returnFocus=trigger||document.activeElement;var drawer=id('seoRtDrawer');drawer.classList.add('is-open');drawer.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';setText('seoRtDrawerTitle',cycleId);var body=id('seoRtDrawerBody');clear(body);body.appendChild(make('div','seo-rt__empty','正在读取任务详情…'));api.optimizationTaskDetail({cycle_id:cycleId,run_id:runId||''}).then(function(detail){rt.detail=detail||{};renderDetail()}).catch(function(){clear(body);body.appendChild(make('div','seo-rt__error','任务详情读取失败，页面内容和队列状态未受到影响。'))});var close=id('seoRtDrawer').querySelector('[data-seo-rt-close]');if(close){close.focus()}}
