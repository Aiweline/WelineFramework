function renderPublication(body,detail){var publication=section('发布回执');var receipts=Array.isArray(detail.publication)?detail.publication:(detail.publication&&Object.keys(detail.publication).length?[detail.publication]:[]);if(!receipts.length){publication.appendChild(make('div','seo-rt__empty','该任务没有发布 Queue 回执。'))}receipts.forEach(function(receipt){var card=make('article','seo-rt__detail-card');card.appendChild(make('strong','','Queue #'+receipt.queue_id+' · '+(receipt.status||receipt.queue_status||'状态未知')));card.appendChild(make('small','','候选 revision '+(receipt.candidate_revision||'—')+' · '+formatTime(receipt.last_activity_at)));publication.appendChild(card)});body.appendChild(publication);var experiments=section('观察与实验');var list=Array.isArray(detail.experiments)?detail.experiments:[];if(!list.length){experiments.appendChild(make('div','seo-rt__empty','尚未创建效果实验。'))}list.forEach(function(experiment){var card=make('article','seo-rt__detail-card');card.appendChild(make('strong','',experiment.primary_metric||'效果实验'));card.appendChild(make('small','',(experiment.status||'')+' · 评估 '+formatTime(experiment.evaluate_after)+' · 到期 '+formatTime(experiment.expires_at)));var pre=make('pre');pre.textContent=JSON.stringify({baseline:experiment.baseline_metrics||{},candidate:experiment.candidate_metrics||{},guardrails:experiment.guardrails||[]},null,2);card.appendChild(pre);experiments.appendChild(card)});body.appendChild(experiments)}
function loadSnapshot(){setConnection('connecting','正在同步');return api.optimizationControlCenterSnapshot({website_id:rt.scope}).then(function(snapshot){renderSnapshot(snapshot||{});setConnection('live','实时已连接');rt.lastSignal=Date.now();startStream()}).catch(function(){setConnection('offline','实时不可用 · 轮询中');startPolling()})}
function scheduleSnapshot(){window.clearTimeout(rt.refreshTimer);rt.refreshTimer=window.setTimeout(function(){api.optimizationControlCenterSnapshot({website_id:rt.scope}).then(renderSnapshot).catch(function(){})},900)}
function closeStream(){if(rt.stream&&typeof rt.stream.close==='function'){rt.stream.close()}rt.stream=null}
function startStream(){closeStream();window.clearTimeout(rt.reconnectTimer);var requestedCursor=String(rt.cursor||'0');Weline.Api.stream('seo_optimization_control.optimizationActivityStream',{website_id:rt.scope,after:requestedCursor}).then(function(stream){rt.stream=stream;stream.addEventListener('open',function(){rt.lastSignal=Date.now();setConnection('live','实时已连接');stopPolling()});stream.addEventListener('seo_optimization_activity',function(event){rt.lastSignal=Date.now();try{addActivity(JSON.parse(event.data||'{}'))}catch(ignore){}});stream.addEventListener('resync_required',function(){rt.lastSignal=Date.now();closeStream();loadSnapshot()});stream.addEventListener('failed',function(){streamFailed()});stream.addEventListener('done',function(){reconnect(800)});stream.addEventListener('error',function(){streamFailed()})}).catch(function(){streamFailed()})}
