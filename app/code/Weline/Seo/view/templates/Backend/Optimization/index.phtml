function render(){var data=matches();list.replaceChildren();if(!data.length){var empty=document.createElement('div');empty.className='seo-opt__site-empty';empty.textContent=<?= json_encode((string) __('没有可用站点'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>;list.appendChild(empty);activeIndex=-1;search.removeAttribute('aria-activedescendant');return}data.forEach(function(record,index){var button=document.createElement('button');button.type='button';button.id='website-option-'+record.value;button.className='seo-opt__site-option';button.setAttribute('role','option');button.setAttribute('aria-selected',record.value===String(nativeSelect.value)?'true':'false');var label=document.createElement('span');label.className='seo-opt__site-option-label';label.textContent=record.label;var id=document.createElement('span');id.className='seo-opt__site-option-id';id.textContent='#'+record.value;button.append(label,id);button.addEventListener('pointerdown',function(event){event.preventDefault()});button.addEventListener('click',function(){choose(record.value)});list.appendChild(button);if(record.value===String(nativeSelect.value)){activeIndex=index}});setActive(activeIndex<0?0:activeIndex)}
function openList(){if(search.disabled){return}list.hidden=false;control.classList.add('is-open');search.setAttribute('aria-expanded','true');toggle.setAttribute('aria-expanded','true');render()}
function closeList(){list.hidden=true;control.classList.remove('is-open');search.setAttribute('aria-expanded','false');toggle.setAttribute('aria-expanded','false');search.removeAttribute('aria-activedescendant');activeIndex=-1}
search.addEventListener('focus',openList);search.addEventListener('input',function(){openList();activeIndex=0;render()});
search.addEventListener('keydown',function(event){if(event.key==='ArrowDown'){event.preventDefault();openList();setActive(activeIndex+1)}else if(event.key==='ArrowUp'){event.preventDefault();openList();setActive(activeIndex<0?matches().length-1:activeIndex-1)}else if(event.key==='Enter'&&!list.hidden){event.preventDefault();var buttons=list.querySelectorAll('.seo-opt__site-option');if(buttons[activeIndex]){buttons[activeIndex].click()}}else if(event.key==='Escape'){event.preventDefault();search.value='';closeList();sync()}});
toggle.addEventListener('click',function(){if(list.hidden){openList();search.focus()}else{closeList();search.focus()}});nativeSelect.addEventListener('change',sync);document.addEventListener('pointerdown',function(event){if(!picker.contains(event.target)){search.value='';closeList();sync()}});
new MutationObserver(function(){sync();if(!list.hidden){render()}}).observe(nativeSelect,{attributes:true,attributeFilter:['disabled'],childList:true,subtree:true});sync();
}());
</script>
