<script>
(function(){
'use strict';
var nativeSelect=document.getElementById('websiteSelect'),picker=document.getElementById('websitePicker'),control=document.getElementById('websiteControl'),tag=document.getElementById('websiteTag'),tagText=document.getElementById('websiteTagText'),search=document.getElementById('websiteSearch'),toggle=document.getElementById('websiteToggle'),list=document.getElementById('websiteOptions');
if(!nativeSelect||!picker||!control||!tag||!tagText||!search||!toggle||!list){return}
var activeIndex=-1;
function records(){return Array.prototype.slice.call(nativeSelect.options).filter(function(option){return /^(?:0|[1-9][0-9]*)$/.test(String(option.value))}).map(function(option){var fullLabel=String(option.textContent||option.value);return{value:String(option.value),label:fullLabel.replace(/\s·\s#\d+$/,''),fullLabel:fullLabel,search:String(option.getAttribute('data-search')||fullLabel||option.value).toLocaleLowerCase()}})}
function matches(){var term=search.value.trim().toLocaleLowerCase(),exactId=/^#?(?:0|[1-9][0-9]*)$/.test(term)?term.replace(/^#/,''):null;return records().filter(function(record){return exactId!==null?record.value===exactId:!term||record.search.indexOf(term)!==-1})}
