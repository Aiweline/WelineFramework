function renderDetail(){var body=id('seoRtDrawerBody');clear(body);var detail=rt.detail||{};if(rt.detailTab==='timeline'){renderTimeline(body,detail);return}if(rt.detailTab==='changes'){renderChanges(body,detail);return}if(rt.detailTab==='evidence'){renderEvidence(body,detail);return}renderPublication(body,detail)}
function section(title){var wrapper=make('section','seo-rt__detail-section');wrapper.appendChild(make('h3','',title));return wrapper}
