function authorize(active,changed){state.authorized=Boolean(Number(active)||active===true);byId('authorizationCard').classList.toggle('is-active',state.authorized);byId('authorizationLabel').textContent=state.authorized?copy.authorizationActive:copy.authorizationInactive;authorizationButton.textContent=state.authorized?copy.revoke:copy.authorize;if(changed){dirty(true)}}
function renderPolicy(policy){state.policy=policy||{};selectMode(value(state.policy.mode,'shadow'),false);authorize(state.policy.standing_authorized,false);root.querySelectorAll('[data-policy]').forEach(function(input){input.value=state.policy[input.dataset.policy]!==undefined?state.policy[input.dataset.policy]:''});root.querySelectorAll('[data-percent]').forEach(function(input){input.value=state.policy[input.dataset.percent]!==undefined?(Number(state.policy[input.dataset.percent])/100).toFixed(1).replace(/\.0$/,''):''});dirty(false)}
function recommendation(run){return json(run&&run.recommendation_json)}function evidence(run){return json(run&&run.evidence_json)}
