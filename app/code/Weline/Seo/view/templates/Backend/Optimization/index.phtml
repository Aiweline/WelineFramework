function status(statusValue){var key=String(statusValue||'pending').toLowerCase(),tone='';if(['recommended','applied','draft_ready','published','kept'].indexOf(key)!==-1){tone=' seo-opt__status--good'}else if(['failed','apply_failed','rolled_back','publish_failed_rolled_back','experiment_failed_rolled_back','manual_intervention'].indexOf(key)!==-1){tone=' seo-opt__status--bad'}else{tone=' seo-opt__status--warn'}return{label:(copy.status&&copy.status[key])||value(statusValue,copy.unknown),tone:tone}}
