<script>
(function(){
'use strict';
var root=document.getElementById('seoOptimizationConsole');
if(!root||root.dataset.initialized==='1'){return}
root.dataset.initialized='1';
var copy={};try{copy=JSON.parse(root.getAttribute('data-copy')||'{}')}catch(ignore){}
var state={websiteId:null,websites:[],policy:{},runs:[],experiments:[],queryCloud:[],eventHeat:[],eventHeatFallback:null,visitorAvailable:false,gscBound:false,mode:'shadow',authorized:false,dirty:false,seo:null,directoryApi:null,busy:false,returnFocus:null,toastTimer:null};
var byId=function(id){return document.getElementById(id)};
var websiteSelect=byId('websiteSelect'),refreshButton=byId('refreshButton'),analyzeButton=byId('analyzeButton'),saveButton=byId('saveButton');
var syncCloudButton=byId('syncCloudButton'),evolveHeatButton=byId('evolveHeatButton');
var authorizationButton=byId('authorizationButton'),modal=byId('authorizationModal'),confirmAuthorization=byId('authorizationConfirm');
var scopeCheck=byId('scopeCheck'),rollbackCheck=byId('rollbackCheck'),drawer=byId('decisionDrawer');
function value(input,fallback){return input===null||input===undefined||input===''?(fallback||copy.empty||'—'):String(input)}
function html(input){return value(input,'').replace(/[&<>"']/g,function(character){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]})}
function json(input){if(!input){return{}}if(typeof input==='object'){return input}try{var parsed=JSON.parse(String(input));return parsed&&typeof parsed==='object'?parsed:{}}catch(ignore){return{}}}
function items(payload){if(Array.isArray(payload)){return payload}if(!payload||typeof payload!=='object'){return[]}var choices=[payload.items,payload.websites,payload.list,payload.data];for(var i=0;i<choices.length;i+=1){if(Array.isArray(choices[i])){return choices[i]}}return[]}
function idOf(site){var raw=site&&(site.website_id!==undefined?site.website_id:site.id),id=Number(raw);return Number.isInteger(id)&&id>=0?id:null}
function nameOf(site){var id=idOf(site),name=value(site&&(site.name||site.website_name||site.title||site.code),copy.page);return name+(id===null?'':' · #'+id)}
