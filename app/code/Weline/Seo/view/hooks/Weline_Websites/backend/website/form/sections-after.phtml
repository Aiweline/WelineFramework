<?php
/**
 * @hook-priority 100
 * @hook-sort-order 10
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Seo\Model\WebsiteProtocolConfig;

$website = (array)($this->getData('website') ?? []);
$hasWebsiteIdentity = array_key_exists('website_id', $website) || array_key_exists('id', $website);
$websiteId = $hasWebsiteIdentity ? (int)($website['website_id'] ?? $website['id']) : -1;
$hookId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'website'));
if (!is_string($hookId) || $hookId === '' || preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'website_' . (is_string($hookId) ? $hookId : '');
}
$accordionParentId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('accordion_parent_id') ?? 'websiteFormAccordion'));
$sectionId = $hookId . '_seo_protocol';
$robotsFieldId = $sectionId . '_robots_enabled';
$sitemapFieldId = $sectionId . '_sitemap_enabled';
$googleExtendedFieldId = $sectionId . '_google_extended';
$robotsExtraFieldId = $sectionId . '_robots_extra';

$robotsEnabled = true;
$sitemapEnabled = true;
$googleExtended = 'allow';
$robotsExtra = '';

try {
    if ($hasWebsiteIdentity && $websiteId >= 0) {
        /** @var WebsiteProtocolConfig $protocolConfig */
        $protocolConfig = ObjectManager::getInstance(WebsiteProtocolConfig::class)->loadByWebsiteId($websiteId);
        $robotsEnabled = $protocolConfig->isRobotsEnabled();
        $sitemapEnabled = $protocolConfig->isSitemapEnabled();
        $googleExtended = $protocolConfig->getGoogleExtendedPolicy();
        $robotsExtra = $protocolConfig->getRobotsExtra();
    }
} catch (\Throwable) {
}
?>
<div class="w-disclosure" data-w-component="disclosure">
    <div id="<?= htmlspecialchars($sectionId . '_heading', ENT_QUOTES, 'UTF-8') ?>">
        <button class="w-disclosure__trigger collapsed" type="button" aria-expanded="false" aria-controls="<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" data-w-target="#<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" data-w-action="disclosure.toggle" data-w-disclosure-trigger>
            <w:icon name="search" size="sm"></w:icon>
            <span><lang>SEO 协议与搜索提交</lang></span>
            <w:icon name="chevron-down" size="sm"></w:icon>
        </button>
    </div>
    <div id="<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" class="w-disclosure__panel" aria-labelledby="<?= htmlspecialchars($sectionId . '_heading', ENT_QUOTES, 'UTF-8') ?>" data-w-disclosure-panel hidden>
        <div class="w-disclosure__body">
            <div class="w-grid">
                <div style="--w-span:12;--w-mb:var(--weline-space-4);">
                    <?= framework_view_process_block([
                        'class' => \Weline\Seo\Block\Widget\WebsiteAccountEnablement::class,
                        'website_id' => $websiteId,
                        'website' => $website,
                        'mode' => 'embedded',
                        'field_prefix' => 'extensions[seo]',
                        'show_submit' => false,
                    ]) ?>
                </div>
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>robots.txt</lang></label>
                    <input type="hidden" name="extensions[seo][robots_enabled]" value="0">
                    <div class="w-switch" style="--w-mt:var(--weline-space-2);">
                        <input type="checkbox" id="<?= htmlspecialchars($robotsFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[seo][robots_enabled]" value="1" <?= $robotsEnabled ? 'checked' : '' ?>>
                        <label for="<?= htmlspecialchars($robotsFieldId, ENT_QUOTES, 'UTF-8') ?>"><lang>启用站点 robots 协议输出</lang></label>
                    </div>
                </div>
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>Sitemap 声明</lang></label>
                    <input type="hidden" name="extensions[seo][sitemap_enabled]" value="0">
                    <div class="w-switch" style="--w-mt:var(--weline-space-2);">
                        <input type="checkbox" id="<?= htmlspecialchars($sitemapFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[seo][sitemap_enabled]" value="1" <?= $sitemapEnabled ? 'checked' : '' ?>>
                        <label for="<?= htmlspecialchars($sitemapFieldId, ENT_QUOTES, 'UTF-8') ?>"><lang>在 robots 中声明 sitemap.xml</lang></label>
                    </div>
                </div>
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label for="<?= htmlspecialchars($googleExtendedFieldId, ENT_QUOTES, 'UTF-8') ?>" class="w-field__label"><lang>Google-Extended</lang></label>
                    <select class="w-select" id="<?= htmlspecialchars($googleExtendedFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[seo][google_extended]">
                        <option value="allow" <?= $googleExtended === 'allow' ? 'selected' : '' ?>><lang>允许 AI 训练抓取</lang></option>
                        <option value="disallow" <?= $googleExtended === 'disallow' ? 'selected' : '' ?>><lang>禁止 Google-Extended</lang></option>
                    </select>
                </div>
                <div style="--w-span:12;--w-mb:var(--weline-space-4);">
                    <label for="<?= htmlspecialchars($robotsExtraFieldId, ENT_QUOTES, 'UTF-8') ?>" class="w-field__label"><lang>robots.txt 追加规则</lang></label>
                    <textarea class="w-textarea" id="<?= htmlspecialchars($robotsExtraFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[seo][robots_extra]" rows="5" placeholder="User-agent: *&#10;Disallow: /private/"><?= htmlspecialchars($robotsExtra, ENT_QUOTES, 'UTF-8') ?></textarea>
                    <div class="w-field__hint"><lang>每行一条 robots 指令；基础安全规则由 Weline_Seo 自动生成。</lang></div>
                </div>
            </div>
        </div>
    </div>
</div>
