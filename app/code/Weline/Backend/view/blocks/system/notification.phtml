<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Backend\Block\System\Notification;
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$block = ObjectManager::getInstance(Notification::class);
$notifications = $block->getNotifications();
$unreadCount = $block->getUnreadCount();
$iconRegistry = ObjectManager::getInstance(IconRegistry::class);
?>
<div class="w-backend-topbar__menu" data-w-component="menu" data-w-placement="bottom-end">
    <button
        class="w-button w-notification-trigger"
        data-tone="quiet"
        data-size="sm"
        type="button"
        data-w-menu-trigger
        aria-expanded="false"
        aria-controls="w-backend-notification-menu"
        aria-label="<?= htmlspecialchars((string)__('通知'), ENT_QUOTES, 'UTF-8') ?>"
    >
        <w:icon name="bell" />
        <?php if ($unreadCount > 0): ?>
            <span class="w-notification-trigger__badge" aria-label="<?= htmlspecialchars((string)__('未读通知'), ENT_QUOTES, 'UTF-8') ?>"><?= $unreadCount > 99 ? '99+' : (int)$unreadCount ?></span>
        <?php endif; ?>
    </button>
    <div id="w-backend-notification-menu" class="w-menu w-notification-menu" data-w-menu-panel role="menu" hidden>
        <div class="w-notification-menu__header">
            <strong><?= htmlspecialchars((string)__('通知'), ENT_QUOTES, 'UTF-8') ?></strong>
            <?php if ($unreadCount > 0): ?><span class="w-badge" data-tone="info"><?= (int)$unreadCount ?></span><?php endif; ?>
        </div>
        <div class="w-notification-menu__list">
            <?php if ($notifications === []): ?>
                <div class="w-empty-state" role="status">
                    <w:icon name="bell" size="lg" />
                    <p><?= htmlspecialchars((string)__('暂无通知'), ENT_QUOTES, 'UTF-8') ?></p>
                </div>
            <?php else: ?>
                <?php foreach ($notifications as $notification): ?>
                    <?php
                    $type = (string)($notification['type'] ?? 'info');
                    $notificationId = (int)($notification['notification_id'] ?? 0);
                    $detailUrl = $this->getBackendUrl('system/backend/notification/detail', ['id' => $notificationId]);
                    $isRead = (bool)($notification['is_read'] ?? false);
                    $content = strip_tags((string)($notification['content'] ?? ''));
                    ?>
                    <a
                        class="w-menu__item w-notification-item"
                        role="menuitem"
                        href="<?= htmlspecialchars($detailUrl, ENT_QUOTES, 'UTF-8') ?>"
                        data-state="<?= $isRead ? 'read' : 'unread' ?>"
                    >
                        <span class="w-notification-item__icon" data-tone="<?= htmlspecialchars($type, ENT_QUOTES, 'UTF-8') ?>"><?= $iconRegistry->render($block->getTypeIcon($type), 'sm') ?></span>
                        <span class="w-notification-item__content">
                            <strong><?= htmlspecialchars((string)($notification['title'] ?? ''), ENT_QUOTES, 'UTF-8') ?></strong>
                            <span><?= htmlspecialchars(mb_substr($content, 0, 80), ENT_QUOTES, 'UTF-8') ?><?= mb_strlen($content) > 80 ? '…' : '' ?></span>
                            <small><?= htmlspecialchars((string)($notification['notification_time'] ?? ''), ENT_QUOTES, 'UTF-8') ?></small>
                        </span>
                    </a>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
        <div class="w-notification-menu__footer">
            <a class="w-button" data-size="sm" href="<?= htmlspecialchars($this->getBackendUrl('system/backend/notification'), ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string)__('查看全部'), ENT_QUOTES, 'UTF-8') ?></a>
            <a class="w-button" data-size="sm" data-tone="neutral" href="<?= htmlspecialchars($this->getBackendUrl('system/backend/notificationsubscription'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="settings" size="sm" /><span class="w-visually-hidden"><?= htmlspecialchars((string)__('管理订阅'), ENT_QUOTES, 'UTF-8') ?></span></a>
        </div>
    </div>
</div>
