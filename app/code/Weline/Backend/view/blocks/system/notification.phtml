<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Backend\Block\System\Notification;
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$block = ObjectManager::getInstance(Notification::class);
$notifications = $block->getNotifications();
$unreadCount = $block->getUnreadCount();
$iconRegistry = ObjectManager::getInstance(IconRegistry::class);
$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$notificationLabel = $escape(__('通知'));
$unreadLabel = $escape(__('未读通知'));
$closeLabel = $escape(__('关闭通知'));
$emptyLabel = $escape(__('暂无通知'));
$allLabel = $escape(__('查看全部'));
$subscriptionLabel = $escape(__('管理订阅'));
$detailPath = 'system/backend/notification/detail';
?>
<div class="w-backend-topbar__menu w-menu-root" data-w-component="menu" data-w-placement="bottom-end" data-w-anchor-mode="element">
    <button
        id="w-backend-notification-trigger"
        class="w-button w-notification-trigger"
        data-tone="quiet"
        data-size="sm"
        type="button"
        data-w-menu-trigger
        aria-expanded="false"
        aria-controls="w-backend-notification-menu"
        aria-label="<?= $notificationLabel ?>"
    >
        <w:icon name="bell" />
        <?php if ($unreadCount > 0): ?>
            <span class="w-notification-trigger__badge" aria-label="<?= $unreadLabel ?>"><?= $unreadCount > 99 ? '99+' : (int)$unreadCount ?></span>
        <?php endif; ?>
    </button>
    <div id="w-backend-notification-menu" class="w-menu w-notification-menu" data-w-menu-panel data-state="closed" role="menu" aria-labelledby="w-backend-notification-trigger" aria-hidden="true" hidden>
        <div class="w-notification-menu__header">
            <strong><?= $notificationLabel ?></strong>
            <span class="w-notification-menu__header-actions">
                <?php if ($unreadCount > 0): ?>
                    <span class="w-badge" data-tone="info"><?= (int)$unreadCount ?></span>
                <?php endif; ?>
                <button
                    class="w-button w-notification-menu__close"
                    data-tone="quiet"
                    data-size="sm"
                    type="button"
                    data-w-menu-close
                    aria-label="<?= $closeLabel ?>"
                ><w:icon name="close" size="sm" /></button>
            </span>
        </div>
        <div class="w-notification-menu__list">
            <?php if ($notifications === []): ?>
                <div class="w-empty-state" role="status">
                    <?php echo $iconRegistry->render('bell', 'lg'); ?>
                    <p><?= $emptyLabel ?></p>
                </div>
            <?php else: ?>
                <?php foreach ($notifications as $notification): ?>
                    <?php
                    $type = strtolower((string)($notification['type'] ?? 'info'));
                    $notificationId = (int)($notification['notification_id'] ?? 0);
                    $detailParams = ['id' => $notificationId];
                    $isRead = (bool)($notification['is_read'] ?? false);
                    $content = strip_tags((string)($notification['content'] ?? ''));
                    $shortContent = mb_substr($content, 0, 80) . (mb_strlen($content) > 80 ? '…' : '');
                    $tone = in_array($type, ['success', 'warning', 'error', 'urgent', 'info'], true) ? $type : 'info';
                    ?>
                    <a class="w-menu__item w-notification-item" role="menuitem" href="@backend-url{$detailPath|$detailParams}" data-state="<?= $isRead ? 'read' : 'unread' ?>">
                        <span class="w-notification-item__icon" data-tone="<?= $escape($tone) ?>">
                            <?php echo $iconRegistry->render($block->getTypeIcon($type), 'sm'); ?>
                        </span>
                        <span class="w-notification-item__content">
                            <strong><?= $escape($notification['title'] ?? '') ?></strong>
                            <span><?= $escape($shortContent) ?></span>
                            <small><?= $escape($notification['notification_time'] ?? '') ?></small>
                        </span>
                    </a>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
        <div class="w-notification-menu__footer">
            <a class="w-button" data-size="sm" href="@backend-url{'system/backend/notification'}"><?= $allLabel ?></a>
            <a class="w-button" data-size="sm" data-tone="neutral" href="@backend-url{'system/backend/notificationsubscription'}"><w:icon name="settings" size="sm" /><span class="w-visually-hidden"><?= $subscriptionLabel ?></span></a>
        </div>
    </div>
</div>
