<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Backend\Block\ThemeConfig;
use Weline\Framework\App\Env;
use Weline\Framework\Env\WelineEnv;
use Weline\Framework\Deploy\DeployPublicUrlMode;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Session\SessionFactory;
use Weline\Framework\View\PublicStaticUrl;

/** @var ThemeConfig $themeConfig */
$themeConfig = ObjectManager::getInstance(ThemeConfig::class);
$host = rtrim((string)$this->request->getBaseHost(), '/');
$baseRouter = (string)$this->request->getRouterData('router');
$currentModule = (string)$this->request->getModuleName();
$backendArea = (string)(Env::getAreaRoutePrefix('backend') ?: Env::getInstance()->getConfig('admin'));
$frontendApiArea = (string)(Env::getAreaRoutePrefix('rest_frontend') ?: Env::getInstance()->getConfig('api'));
$backendApiArea = (string)(Env::getAreaRoutePrefix('rest_backend') ?: Env::getInstance()->getConfig('api_admin'));
$session = SessionFactory::backend();
$userId = (int)$session->getLoginUserID();
$backendHost = rtrim((string)$this->request->getUrlBuilder()->getBackendUrl('/', [], false), '/');
$apiHost = rtrim((string)$this->request->getUrlBuilder()->getApiUrl('/', [], false), '/');
$frontendApiHost = rtrim((string)$this->request->getUrlBuilder()->getFrontendApiUrl('/', [], false), '/');
$themePath = str_replace('\\', '/', (string)(Env::getInstance()->getTheme()['path'] ?? ''));
$useProdPublicUrls = DeployPublicUrlMode::useProduction();
$mediaTemplate = $host . '/' . (!$useProdPublicUrls
    ? '{module}/view/statics/{path}'
    : 'static/' . trim($themePath, '/') . '/{module}/view/statics/{path}');
$csrfToken = \Weline\Framework\Security\Token::create('csrf', 16, 600);

// Client JS dictionary loads from footer i18n-client bag (not head runtime-config).

\Weline\Framework\Runtime\FiberOutputBuffer::beginCapture();
try {
    $backendThemeConfig = $themeConfig->getThemeConfig();
    \Weline\Framework\Runtime\FiberOutputBuffer::discardCapture();
} catch (\Throwable) {
    \Weline\Framework\Runtime\FiberOutputBuffer::discardCapture();
    $backendThemeConfig = [];
}
if (!is_array($backendThemeConfig)) {
    $backendThemeConfig = [];
}

$deployMeta = @json_decode((string)@file_get_contents(BP . 'var/deploy/current.json'), true);
$deployVersion = is_array($deployMeta) ? (string)($deployMeta['deploy_version'] ?? 'dev') : 'dev';
$workerBuildId = is_array($deployMeta) ? (string)($deployMeta['worker_build_id'] ?? 'dev') : 'dev';
$themePublishedVersionId = '';
$themePublishedVersion = '';
try {
    if (class_exists(\Weline\Theme\Service\ThemePublishedVersionRuntimeResolver::class)) {
        /** @var \Weline\Theme\Service\ThemePublishedVersionRuntimeResolver $themeVersionResolver */
        $themeVersionResolver = ObjectManager::getInstance(
            \Weline\Theme\Service\ThemePublishedVersionRuntimeResolver::class
        );
        $themeVersions = $themeVersionResolver->resolve();
        $themePublishedVersionId = (string)($themeVersions['themePublishedVersionId'] ?? '');
        $themePublishedVersion = (string)($themeVersions['themePublishedVersion'] ?? '');
    }
} catch (\Throwable) {
}
$queryBinUrl = Env::getFrontendQueryBinPath();
$queryWorkerUrl = PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/js/weline-api-worker.js');
$queryWorkerUrl .= (str_contains($queryWorkerUrl, '?') ? '&' : '?') . 'v=' . rawurlencode($deployVersion . '-' . $workerBuildId);
$apiConfig = [
    'workerUrl' => $queryWorkerUrl,
    'queryWorkerUrl' => $queryWorkerUrl,
    'endpoint' => $queryBinUrl,
    'queryBinUrl' => $queryBinUrl,
    'deployVersion' => $deployVersion,
    'workerBuildId' => $workerBuildId,
    // Mirror Frontend: api subtree must carry theme stamp so QueryBin handshake
    // does not 409 deploy_reload_required with an empty client id.
    'themePublishedVersionId' => $themePublishedVersionId,
    'themePublishedVersion' => $themePublishedVersion,
    'requestTimeoutMs' => 60000,
];
$runtime = [
    'env' => [
        'WELINE_ENV' => $useProdPublicUrls ? 'PROD' : 'DEV',
        'DEV' => !$useProdPublicUrls,
        'PROD' => $useProdPublicUrls,
        'useProductionPublicUrls' => $useProdPublicUrls,
    ],
    'area' => 'backend',
    'modulesConfigUrl' => PublicStaticUrl::fromDevWebPath('/Weline/Backend/view/statics/base/weline.modules.js'),
    'modulesBaseUrl' => PublicStaticUrl::fromDevWebPath('/Weline/Backend/view/statics/js'),
    'assetVersion' => $deployVersion,
    'deployVersion' => $deployVersion,
    'workerBuildId' => $workerBuildId,
    'themePublishedVersionId' => $themePublishedVersionId,
    'themePublishedVersion' => $themePublishedVersion,
    'debug' => !$useProdPublicUrls,
    'api' => $apiConfig,
    'url' => [
        'origin' => $host,
        'backendHost' => $backendHost,
        'frontendHost' => $host,
        'apiHost' => $apiHost,
        'frontendApiHost' => $frontendApiHost,
        'baseRouter' => $baseRouter,
        'apiArea' => $frontendApiArea,
        'apiAdminArea' => $backendApiArea,
    ],
    'i18n' => [
        'locale' => WelineEnv::getLang(),
        'area' => 'backend',
    ],
    'theme' => $backendThemeConfig,
    'site' => [
        'user_id' => $userId,
        'csrf_token' => $csrfToken,
        'module' => $currentModule,
        'area' => $backendArea,
        'host' => $host . '/',
        'base_host' => (string)$this->request->getPrePath(),
        'base_router' => $baseRouter,
        'env_model' => (string)Env::system('deploy'),
        'env_model_media_base_path_template' => $mediaTemplate,
        'api_host' => $apiHost,
        'frontend_api_host' => $frontendApiHost,
        'api_area' => $frontendApiArea,
        'api_admin_area' => $backendApiArea,
        'url_host' => $backendHost,
        'currency' => WelineEnv::getCurrency(),
        'lang' => WelineEnv::getLang(),
        'themeConfig' => $backendThemeConfig,
    ],
];
$staticBuildId = '';
try {
    $staticBuildId = \Weline\Framework\Deploy\StaticBuildId::current();
} catch (\Throwable) {
}
$runtime['staticBaseUrl'] = \Weline\Framework\Deploy\StaticBuildId::flatUrlsEnabled()
    ? '/static'
    : ($staticBuildId !== '' ? '/static/' . $staticBuildId : '');
$runtime['assetVersion'] = $staticBuildId !== '' ? $staticBuildId : ($runtime['assetVersion'] ?? '');

$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
    | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE;
$runtimeJson = json_encode($runtime, $jsonFlags);
if (!is_string($runtimeJson) || $runtimeJson === '' || $runtimeJson[0] !== '{') {
    $runtimeJson = '{}';
}
$runtimeJsonTailBody = substr($runtimeJson, 1); // drop leading "{"
?>
<script type="application/json" id="weline-backend-runtime-config" data-weline-runtime-config>{"baseUrl":"@backend-url{'/'}",<?= $runtimeJsonTailBody ?></script>
<meta name="weline-worker-backend-bootstrap-slot" content="">
<?php
/**
 * Weline 后台启动桩（inline，必须早于下面所有 defer 脚本）。
 *
 * 与前台 Weline_Frontend::view/blocks/header/base.phtml 同构：
 * 把 Weline.declare / load / preLoad / mount / dom.observe 在真正实现到位前的调用
 * 排进 Weline.__bootQueue，由 Weline_Backend::js/weline.js 初始化后统一回放，
 * 这样下面这些核心脚本才能全部 defer（body 内联脚本会在解析期同步调用它们）。
 *
 * 放在本文件（所有后台主题共用的 header base）而不是主题 head 局部：
 * defer 脚本由本文件发出，桩必须与之同处一地。
 */
$welineBootDev = defined('DEV') ? (bool)DEV : null;
?>
<script data-weline-boot-stub="1">
(function (window) {
    'use strict';
    if (!window) { return; }
    if (window.Weline && window.Weline.__initialized) { return; }
    var W = window.Weline = window.Weline || {};
    if (W.__bootStubInstalled) { return; }
    W.__bootStubInstalled = true;
<?php if ($welineBootDev !== null): ?>
    if (typeof window.DEV === 'undefined') { window.DEV = <?= $welineBootDev ? 'true' : 'false' ?>; }
    if (typeof window.PROD === 'undefined') { window.PROD = !window.DEV; }
    if (typeof window.WELINE_ENV === 'undefined') { window.WELINE_ENV = window.DEV ? 'DEV' : 'PROD'; }
<?php endif; ?>
    var queue = W.__bootQueue = W.__bootQueue || [];
    function enqueue(api, args) {
        return new Promise(function (resolve, reject) {
            queue.push({ api: api, args: Array.prototype.slice.call(args), resolve: resolve, reject: reject });
        });
    }
    function install(apiPath) {
        var parts = apiPath.split('.');
        var host = W;
        for (var i = 0; i < parts.length - 1; i++) { host = host[parts[i]] = host[parts[i]] || {}; }
        var name = parts[parts.length - 1];
        if (typeof host[name] === 'function') { return; }
        var stubFn = function () { return enqueue(apiPath, arguments); };
        stubFn.__welineBootStub = true;
        host[name] = stubFn;
    }
    ['declare', 'load', 'preLoad', 'mount', 'observeMutationsCoalesced'].forEach(install);
    W.dom = W.dom || {};
    ['observe', 'observeMutations'].forEach(function (api) { install('dom.' + api); });
})(window);
</script>
<w:js defer>Weline_Backend::js/runtime.js</w:js>
<w:js defer>Weline_Backend::js/cookie.js</w:js>
<w:js defer>Weline_Backend::js/weline-api.js</w:js>
<w:js defer>Weline_Backend::js/weline-api-business.js</w:js>
<w:js defer>Weline_Framework::js/dom-observer.js</w:js>
<w:js defer>Weline_Backend::js/weline.js</w:js>
<hook>Weline_Backend::backend::partials::head::before</hook>
