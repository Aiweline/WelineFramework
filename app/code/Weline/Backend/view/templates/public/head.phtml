<?php
/**@var \Weline\Framework\View\Template $this */
$headTitle = trim((string)($this->getData('page_title') ?? ''));
if ($headTitle === '') {
    $headTitle = trim((string)($this->getData('controller_title') ?? ''));
}
if ($headTitle === '') {
    $headTitle = trim((string)($this->getData('title') ?? ''));
}
$defaultAdminTitle = (string)__('WelineFramework Admin');
if ($headTitle === '' || $headTitle === 'WelineFramework Admin' || $headTitle === $defaultAdminTitle) {
    $meta = $this->getData('meta');
    if (is_array($meta)) {
        foreach (['controller_title', 'title', 'meta_title'] as $metaKey) {
            $candidate = trim((string)($meta[$metaKey] ?? ''));
            if ($candidate !== '' && $candidate !== 'WelineFramework Admin' && $candidate !== $defaultAdminTitle) {
                $headTitle = $candidate;
                break;
            }
        }
    }
}
$headDescription = (string)($this->getData('description') ?? '');
?>
<meta charset="UTF-8">
<title><?= htmlspecialchars($headTitle, ENT_QUOTES, 'UTF-8') ?></title>
<meta content="<?= htmlspecialchars($headDescription, ENT_QUOTES, 'UTF-8') ?>" name="description"/>
<link rel="shortcut icon" href="@static(Weline_Backend::img/favicon.png)">
<!--加载基础JS-->
<w:block class='Weline\Backend\Block\Header\Base' template='Weline_Backend::header/base.phtml'/>
<!--加载配置页头-->
<?php
if($this->getHeader()){
    echo $this->getHeader()->getHtml();
}
?>
