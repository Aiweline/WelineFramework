<script>
(function() {
    'use strict';

    var configFieldsData = <?= json_encode($config_fields, $jsonForScriptFlags) ?>;

    function escapeHtml(value) {
        var div = document.createElement('div');
        div.textContent = value == null ? '' : String(value);
        return div.innerHTML;
    }

    function escapeAttr(value) {
        return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    var WelineChannelForm = {
        onChannelCodeChange: function(code) {
            var container = document.getElementById('channelConfigFields');
            if (!code || !configFieldsData[code]) {
                container.innerHTML = '<p class="w-text" data-tone="muted"><?= __('请先选择渠道类型') ?></p>';
                return;
            }

            var fields = configFieldsData[code];
            var html = '<h5 style="--w-mb:var(--weline-space-4);"><?= __('渠道配置') ?></h5>';

            fields.forEach(function(field) {
                var inputType = field.type === 'password' ? 'password' : 'text';
                var required = field.required ? 'required' : '';
                var requiredMark = field.required ? '<span class="w-text" data-tone="danger">*</span>' : '';

                html += '<div style="--w-mb:var(--weline-space-4);">';
                html += '<label class="w-field__label">' + escapeHtml(field.label || '') + ' ' + requiredMark + '</label>';
                html += '<input type="' + inputType + '" class="w-input" html escapeAttr required>';
                html += '</div>';
            });

            container.innerHTML = html;
        },

        save: function() {
            var form = document.getElementById('channelForm');
            var formData = new FormData(form);

            var url = '<?= $this->getBackendUrl('*/backend/notificationchannel/save') ?>';
            var opts = { method: 'POST', body: new URLSearchParams(formData) };
            Weline.adminRequest('backend_admin', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() {
                        window.location.href = '<?= $this->getBackendUrl('*/backend/notificationchannel') ?>';
                    }, 1000);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                Weline.UI.toast.error('<?= __('保存失败') ?>');
            });
        },

        test: function() {
            var form = document.getElementById('channelForm');
            var formData = new FormData(form);

            Weline.UI.toast.info('<?= __('正在测试连接...') ?>');

            var url = '<?= $this->getBackendUrl('*/backend/notificationchannel/test') ?>';
            var opts = { method: 'POST', body: new URLSearchParams(formData) };
            Weline.adminRequest('backend_admin', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                Weline.UI.toast.error('<?= __('测试失败') ?>');
            });
        }
    };

    window.WelineChannelForm = WelineChannelForm;

    var channelCode = document.getElementById('channelCode');
    if (channelCode) {
        channelCode.addEventListener('change', function(event) {
            WelineChannelForm.onChannelCodeChange(event.target.value);
        });
    }

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-channel-form-action]');
        if (!trigger) {
            return;
        }

        event.preventDefault();
        if (trigger.getAttribute('data-channel-form-action') === 'save') {
            WelineChannelForm.save();
            return;
        }

        if (trigger.getAttribute('data-channel-form-action') === 'test') {
            WelineChannelForm.test();
        }
    });
})();
</script>
