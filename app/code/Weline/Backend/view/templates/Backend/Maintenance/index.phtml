<?php
/**
 * 系统维护模式管理页面（内容模板）
 * 
 * 只包含页面内容，由布局系统自动包裹 HTML 框架
 * 布局由 BackendController::$layoutType = 'default.default' 控制
 *
 * @var \Weline\Framework\View\Template $this
 * @var bool $is_maintenance
 * @var string $maintenance_message
 */
$isMaintenance = (bool)($is_maintenance ?? false);
$maintenanceMessage = $maintenance_message ?? __('系统维护中，请稍后再试');
?>
<!-- 页面标题 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
            <h4 class="w-text" style="--w-mb-sm:0;--w-font-size:1.125rem;"><lang>系统维护模式</lang></h4>
        </div>
    </div>
</div>

<!-- 消息提示区域 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <template>Weline_Component::message.phtml</template>
    </div>
</div>

<!-- 提示信息 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-alert" data-tone="warning">
            <w:icon name="warning" size="sm"></w:icon>
            <strong><lang>重要提示</lang>:</strong> <lang>开启维护模式后，前台将显示维护页面，但后台仍可正常访问。</lang>
        </div>
    </div>
</div>

<!-- 维护模式设置 -->
<div class="w-grid">
    <div style="--w-span-lg:12;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title" style="--w-mb:var(--weline-space-6);"><lang>维护模式设置</lang></h4>
                
                <w:form id="maintenanceForm">
                    <div class="w-grid">
                        <div style="--w-span-md:12;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <div class="w-switch">
                                    <input type="checkbox" id="is_maintenance" name="enabled" <?= $isMaintenance ? 'checked' : '' ?>>
                                    <label for="is_maintenance">
                                        <strong><lang>启用维护模式</lang></strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div style="--w-span-md:12;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><lang>维护消息</lang></label>
                                <textarea class="w-textarea" id="maintenance_message" name="message" rows="5"><?= htmlspecialchars($maintenanceMessage) ?></textarea>
                                <div class="w-field__hint"><lang>此消息将显示给访问前台的用户</lang></div>
                            </div>
                        </div>
                        <div style="--w-span-md:12;">
                            <button type="submit" class="w-button" data-tone="primary">
                                <w:icon name="save" size="sm"></w:icon><lang>保存设置</lang>
                            </button>
                        </div>
                    </div>
                </w:form>
            </div>
        </div>
    </div>
</div>

<!-- 当前状态 -->
<div class="w-grid">
    <div style="--w-span-lg:12;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title" style="--w-mb:var(--weline-space-6);"><lang>当前状态</lang></h4>
                <div class="w-alert alert-<?= $isMaintenance ? 'warning' : 'success' ?>">
                    <i class="mdi mdi-<?= $isMaintenance ? 'alert' : 'check-circle' ?> me-2"></i>
                    <strong>
                        <?= $isMaintenance ? __('系统当前处于维护模式') : __('系统当前正常运行') ?>
                    </strong>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
(function() {
    'use strict';
    
    window.WelineMaintenance = {
        save: function(event) {
            event.preventDefault();
            var formData = new FormData(event.target);
            formData.append('enabled', document.getElementById('is_maintenance').checked ? '1' : '0');
            
            var url = '<?= $this->getBackendUrl('*/backend/maintenance/toggle') ?>';
            var opts = { method: 'POST', body: formData };
            Weline.adminRequest('backend_admin', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('保存失败') ?>');
            });
        }
    };

    var maintenanceForm = document.getElementById('maintenanceForm');
    if (maintenanceForm) {
        maintenanceForm.addEventListener('submit', window.WelineMaintenance.save);
    }
})();
</script>
