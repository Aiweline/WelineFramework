<script>
(function() {
    'use strict';

    var WelineUserContact = {
        modal: null,

        init: function() {
            var modalEl = document.getElementById('addContactModal');
            this.modal = modalEl;
        },

        showAddModal: function(channelCode) {
            document.getElementById('addContactForm').reset();
            if (channelCode) {
                document.getElementById('contactChannelCode').value = channelCode;
            }
            if (this.modal) {
                Weline.UI.dialog.open(this.modal);
            }
        },

        saveContact: function() {
            var form = document.getElementById('addContactForm');
            var formData = new FormData(form);
            var bodyStr = new URLSearchParams(formData).toString();

            var url = '<?= $this->getBackendUrl('*/backend/usercontact/save') ?>';
            var opts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: bodyStr };
            Weline.adminRequest('backend_admin', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    if (WelineUserContact.modal) {
                        WelineUserContact.modal.hide();
                    }
                    setTimeout(function() { window.location.reload(); }, 1000);
                } else {
                    var errMsg = (data && (data.message || data.msg)) || '<?= __('保存失败') ?>';
                    Weline.UI.toast.error(errMsg);
                }
            })
            .catch(function(error) {
                console.error('UserContact save error:', error);
                var errMsg = (error && (error.message || (error.data && (error.data.message || error.data.msg)))) || '<?= __('保存失败') ?>';
                Weline.UI.toast.error(errMsg);
            });
        },

        setDefault: function(contactId) {
            Weline.UI.dialog.confirm('<?= __('确定要将此联系人设为默认吗？') ?>').then(function(confirmed) {
                if (!confirmed) return;

                var url = '<?= $this->getBackendUrl('*/backend/usercontact/setDefault') ?>';
                var opts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'contact_id=' + contactId };
                Weline.adminRequest('backend_admin', url, opts)
                .then(function(res) {
                    var data = (res && res.data) !== undefined ? res.data : res;
                    if (data.success) {
                        Weline.UI.toast.success(data.message);
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else {
                        Weline.UI.toast.error(data.message);
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    Weline.UI.toast.error('<?= __('设置失败') ?>');
                });
            });
        },

        deleteContact: function(contactId) {
            Weline.UI.dialog.confirm('<?= __('确定要删除此联系人吗？') ?>').then(function(confirmed) {
                if (!confirmed) return;

                var url = '<?= $this->getBackendUrl('*/backend/usercontact/delete') ?>';
                var opts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'contact_id=' + contactId };
                Weline.adminRequest('backend_admin', url, opts)
                .then(function(res) {
                    var data = (res && res.data) !== undefined ? res.data : res;
                    if (data.success) {
                        Weline.UI.toast.success(data.message);
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else {
                        Weline.UI.toast.error(data.message);
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    Weline.UI.toast.error('<?= __('删除失败') ?>');
                });
            });
        }
    };

    window.WelineUserContact = WelineUserContact;

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-user-contact-action]');
        if (!trigger) {
            return;
        }

        event.preventDefault();
        var action = trigger.getAttribute('data-user-contact-action');
        if (action === 'add') {
            WelineUserContact.showAddModal(trigger.getAttribute('data-channel-code') || '');
            return;
        }

        if (action === 'set-default') {
            WelineUserContact.setDefault(trigger.getAttribute('data-contact-id') || '0');
            return;
        }

        if (action === 'delete') {
            WelineUserContact.deleteContact(trigger.getAttribute('data-contact-id') || '0');
            return;
        }

        if (action === 'save') {
            WelineUserContact.saveContact();
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        WelineUserContact.init();
    });
})();
</script>
