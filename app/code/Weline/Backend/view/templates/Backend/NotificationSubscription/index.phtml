<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array $topics_grouped
 * @var array $subscription_map
 * @var array $channels
 * @var array $types
 * @var array $user_contacts
 */
$topics_grouped = $topics_grouped ?? [];
$subscription_map = $subscription_map ?? [];
$channels = $channels ?? [];
$types = $types ?? [];
$user_contacts = $user_contacts ?? [];
$h = static function ($s): string {
    return htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');
};
$contactUrl = $this->getBackendUrl('*/backend/contact');
$toggleUrl = $this->getBackendUrl('*/backend/notificationsubscription/toggle');
$saveUrl = $this->getBackendUrl('*/backend/notificationsubscription/save');
$failToggle = __('操作失败');
$failSave = __('保存失败');
$labelConfigured = __('已配置联系人');
$labelUnconfigured = __('未配置联系人');
$labelMinPrefix = __('≥');
?>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
            <h4 class="w-text" style="--w-mb-sm:0;--w-font-size:1.125rem;"><lang>消息订阅</lang></h4>
            <div>
                <a href="<?= $h($contactUrl) ?>" class="w-button" data-tone="primary" data-variant="outline">
                    <w:icon name="user" size="sm"></w:icon><lang>管理联系人</lang>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <template>Weline_Component::message.phtml</template>
    </div>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-card">
            <div class="w-card__body">
                <div class="w-alert weline-subscription-tip" data-tone="info">
                    <w:icon name="info" size="sm"></w:icon>
                    <lang>选择您希望通过哪些渠道接收不同类型的消息通知。外部渠道需要先在联系人里配置对应渠道信息。</lang>
                    <a href="<?= $h($contactUrl) ?>"><lang>管理联系人</lang></a>
                </div>

                <?php if (empty($topics_grouped)): ?>
                    <div class="weline-subscription-empty w-text" data-align="center" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);">
                        <w:icon name="bell" size="sm"></w:icon>
                        <p style="--w-mt:var(--weline-space-4);"><lang>暂无可订阅的消息主题</lang></p>
                    </div>
                <?php else: ?>
                    <div class="weline-subscription-board w-stack" style="--w-gap:var(--weline-space-6);">
                        <?php foreach ($topics_grouped as $groupName => $groupData): ?>
                            <?php
                            $groupTopics = $groupData['topics'] ?? [];
                            $groupDisplayName = $groupData['group_name'] ?? $groupName;
                            $groupTitle = $h($groupDisplayName);
                            ?>
                            <section class="weline-subscription-group">
                                <h5 class="weline-subscription-group-title w-text">
                                    <w:icon name="folder" size="sm"></w:icon><?= $groupTitle ?>
                                </h5>

                                <div class="weline-subscription-topic-list w-stack" style="--w-gap:var(--weline-space-3);">
                                    <?php foreach ($groupTopics as $topic): ?>
                                        <?php
                                        $topicCode = (string) ($topic['topic_code'] ?? '');
                                        $topicName = $h($topic['topic_name'] ?? '');
                                        $topicDesc = (string) ($topic['description'] ?? '');
                                        $topicIcon = (string) ($topic['icon'] ?? '');
                                        $topicColor = (string) ($topic['color'] ?? 'inherit');
                                        $topicIconStyle = $topicIcon !== '' ? 'color:' . $topicColor . ';' : '';
                                        $topicAttr = $h($topicCode);
                                        ?>
                                        <article class="weline-subscription-topic">
                                            <div class="weline-subscription-topic__meta">
                                                <div class="w-cluster" data-align="start" style="--w-gap:var(--weline-space-3);">
                                                    <?php if ($topicIcon !== ''): ?>
                                                        <i class="weline-subscription-topic__icon <?= $h($topicIcon) ?>" style="<?= $h($topicIconStyle) ?>"></i>
                                                    <?php else: ?>
                                                        <span class="weline-subscription-topic__icon-fallback">
                                                            <w:icon name="bell" size="sm"></w:icon>
                                                        </span>
                                                    <?php endif; ?>
                                                    <div class="weline-subscription-topic__copy">
                                                        <strong class="w-text"><?= $topicName ?></strong>
                                                        <?php if ($topicDesc !== ''): ?>
                                                            <p class="w-text" data-tone="muted" data-size="sm"><?= $h($topicDesc) ?></p>
                                                        <?php endif; ?>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="weline-subscription-channels">
                                                <?php foreach ($channels as $channelCode => $channelInfo): ?>
                                                    <?php
                                                    $subKey = $topicCode . '_' . $channelCode;
                                                    $sub = $subscription_map[$subKey] ?? null;
                                                    $isEnabled = $sub ? (bool) ($sub['is_enabled'] ?? false) : false;
                                                    $minType = $sub ? (string) ($sub['min_type'] ?? 'info') : 'info';
                                                    $checkedAttr = $isEnabled ? ' checked' : '';
                                                    $channelAttr = $h($channelCode);
                                                    $channelIcon = $h($channelInfo['icon'] ?? 'circle');
                                                    $channelName = $h($channelInfo['name'] ?? $channelCode);
                                                    $isBackend = $channelCode === 'backend';
                                                    $hasContact = $isBackend || !empty($user_contacts[$channelCode]);
                                                    $channelState = $isEnabled ? 'on' : 'off';
                                                    $contactTone = $hasContact ? 'success' : 'muted';
                                                    $contactLabel = $hasContact ? $labelConfigured : $labelUnconfigured;
                                                    $chipClass = 'weline-subscription-channel';
                                                    if ($isEnabled) {
                                                        $chipClass .= ' is-enabled';
                                                    }
                                                    if (!$hasContact && !$isBackend) {
                                                        $chipClass .= ' is-unconfigured';
                                                    }
                                                    ?>
                                                    <div class="<?= $h($chipClass) ?>" data-state="<?= $h($channelState) ?>">
                                                        <div class="weline-subscription-channel__head">
                                                            <div class="weline-subscription-channel__label">
                                                                <i class="mdi <?= $channelIcon ?>"></i>
                                                                <span class="w-text" data-weight="medium"><?= $channelName ?></span>
                                                            </div>
                                                            <label class="w-switch">
                                                                <input class="weline-subscription-toggle" type="checkbox"<?= $checkedAttr ?> data-topic="<?= $topicAttr ?>" data-channel="<?= $channelAttr ?>">
                                                            </label>
                                                        </div>
                                                        <?php if (!$isBackend): ?>
                                                            <small class="w-text weline-subscription-channel__hint" data-tone="<?= $h($contactTone) ?>" data-size="sm"><?= $h($contactLabel) ?></small>
                                                        <?php endif; ?>
                                                        <?php if ($isEnabled): ?>
                                                            <div class="weline-subscription-channel__level">
                                                                <select class="w-select weline-subscription-min-type" data-topic="<?= $topicAttr ?>" data-channel="<?= $channelAttr ?>" data-size="sm">
                                                                    <?php foreach ($types as $value => $label): ?>
                                                                        <?php
                                                                        $optValue = $h($value);
                                                                        $optLabel = $h($label);
                                                                        $selectedAttr = ((string) $value === $minType) ? ' selected' : '';
                                                                        ?>
                                                                        <option value="<?= $optValue ?>"<?= $selectedAttr ?>>
                                                                            <?= $h($labelMinPrefix) ?> <?= $optLabel ?>
                                                                        </option>
                                                                    <?php endforeach; ?>
                                                                </select>
                                                            </div>
                                                        <?php endif; ?>
                                                    </div>
                                                <?php endforeach; ?>
                                            </div>
                                        </article>
                                    <?php endforeach; ?>
                                </div>
                            </section>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>

