<script>
(function() {
    'use strict';

    var WelineSubscription = {
        toggle: function(checkbox) {
            var topicCode = checkbox.dataset.topic;
            var channel = checkbox.dataset.channel;

            Weline.adminRequest('backend_admin', <?= json_encode($toggleUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'topic_code=' + encodeURIComponent(topicCode) + '&channel=' + encodeURIComponent(channel)
            })
            .then(function(response) {
                var data = (function(r){ var b=window.WelineApiBusiness||(window.Weline&&window.Weline.ApiBusiness); return (b&&typeof b.unwrapBusiness==='function')?b.unwrapBusiness(r):r.data; })(response);
                if (response.ok && data && data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() { window.location.reload(); }, 500);
                } else {
                    Weline.UI.toast.error((data && data.message) || <?= json_encode($failToggle, JSON_UNESCAPED_UNICODE) ?>);
                    checkbox.checked = !checkbox.checked;
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                Weline.UI.toast.error((error && error.message) || <?= json_encode($failToggle, JSON_UNESCAPED_UNICODE) ?>);
                checkbox.checked = !checkbox.checked;
            });
        },

        saveMinType: function(select) {
            var topicCode = select.dataset.topic;
            var channel = select.dataset.channel;
            var minType = select.value;

            Weline.adminRequest('backend_admin', <?= json_encode($saveUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'topic_code=' + encodeURIComponent(topicCode) +
                    '&channel=' + encodeURIComponent(channel) +
                    '&min_type=' + encodeURIComponent(minType) +
                    '&is_enabled=1'
            })
            .then(function(response) {
                var data = (function(r){ var b=window.WelineApiBusiness||(window.Weline&&window.Weline.ApiBusiness); return (b&&typeof b.unwrapBusiness==='function')?b.unwrapBusiness(r):r.data; })(response);
                if (response.ok && data && data.success) {
                    Weline.UI.toast.success(data.message);
                } else {
                    Weline.UI.toast.error((data && data.message) || <?= json_encode($failSave, JSON_UNESCAPED_UNICODE) ?>);
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                Weline.UI.toast.error((error && error.message) || <?= json_encode($failSave, JSON_UNESCAPED_UNICODE) ?>);
            });
        }
    };

    window.WelineSubscription = WelineSubscription;

    document.addEventListener('change', function(event) {
        if (event.target.matches('.weline-subscription-toggle')) {
            WelineSubscription.toggle(event.target);
            return;
        }

        if (event.target.matches('.weline-subscription-min-type')) {
            WelineSubscription.saveMinType(event.target);
        }
    });
})();
</script>
