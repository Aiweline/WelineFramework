<script>
(function(g){
  if(g.__bqAdmin_backend_admin) return;
  g.__bqAdmin_backend_admin=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['backend_admin']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('backend_admin').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
(function() {
    'use strict';
    
    window.WelineBackup = {
        createBackup: function(event) {
            event.preventDefault();
            var formData = new FormData(event.target);
            
            var url = '<?= $this->getBackendUrl('*/backup/create') ?>';
            var opts = { method: 'POST', body: formData };
            bqAdmin['backend_admin'](url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('创建备份失败') ?>');
            });
        },
        
        downloadBackup: function(filename) {
            Weline.UI.toast.info('<?= __('下载备份：') ?>' + filename);
        },
        
        deleteBackup: function(filename) {
            Weline.UI.dialog.confirm('<?= __('确定要删除这个备份吗？') ?>').then(function(confirmed) {
                if (confirmed) {
                    Weline.UI.toast.info('<?= __('删除备份：') ?>' + filename);
                }
            });
        }
    };

    var backupForm = document.getElementById('backupForm');
    if (backupForm) {
        backupForm.addEventListener('submit', window.WelineBackup.createBackup);
    }

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-backup-action]');
        if (!trigger) {
            return;
        }

        event.preventDefault();
        var filename = trigger.getAttribute('data-backup-filename') || '';
        if (trigger.getAttribute('data-backup-action') === 'download') {
            window.WelineBackup.downloadBackup(filename);
            return;
        }

        if (trigger.getAttribute('data-backup-action') === 'delete') {
            window.WelineBackup.deleteBackup(filename);
        }
    });
})();
</script>
