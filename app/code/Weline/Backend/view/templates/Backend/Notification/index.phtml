<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array $notifications
 * @var array $pagination
 * @var array $filter
 * @var array $type_options
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$notifications = is_array($notifications ?? null) ? $notifications : [];
$pagination = is_array($pagination ?? null) ? $pagination : ['page' => 1, 'pages' => 1, 'total' => 0];
$filter = is_array($filter ?? null) ? $filter : ['keyword' => '', 'type' => '', 'read' => 'all'];
$typeOptions = is_array($type_options ?? null) ? $type_options : [];
$baseUrl = $this->getBackendUrl('system/backend/notification');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$queryParams = static function (array $overrides = []) use ($filter): array {
    return array_merge(array_filter([
        'keyword' => (string)($filter['keyword'] ?? ''),
        'type' => (string)($filter['type'] ?? ''),
        'read' => ($filter['read'] ?? 'all') !== 'all' ? (string)($filter['read'] ?? '') : '',
    ], static fn(mixed $value): bool => $value !== ''), $overrides);
};
$pageLink = static function (int $page) use ($baseUrl, $queryParams): string {
    $params = $queryParams(['page' => max(1, $page)]);
    return $params === [] ? $baseUrl : $baseUrl . '?' . http_build_query($params);
};
$currentPage = max(1, (int)($pagination['page'] ?? 1));
$totalPages = max(1, (int)($pagination['pages'] ?? 1));
// Dynamic icon names cannot go into <w:icon> attributes — Taglib would leak PHP source.
$icons = ObjectManager::getInstance(IconRegistry::class);
$iconCache = [];
$renderIcon = static function (string $name, string $size = 'md') use ($icons, &$iconCache): string {
    $key = $name . ':' . $size;
    if (!isset($iconCache[$key])) {
        $iconCache[$key] = $icons->render($name, $size);
    }
    return $iconCache[$key];
};
?>

<section
    class="w-notification-center w-stack"
    data-w-component="notification-center"
    data-w-mode="index"
    data-w-mark-all-url="<?= $escape($this->getBackendUrl('system/backend/notification/markAllRead')) ?>"
    data-w-confirm-all="<?= $escape(__('确定要将所有通知标记为已读吗？')) ?>"
    data-w-success-message="<?= $escape(__('已标记全部已读')) ?>"
    data-w-failure-message="<?= $escape(__('操作失败')) ?>"
    data-w-request-failure-message="<?= $escape(__('网络错误，请重试')) ?>"
>
    <header class="w-notification-center__heading">
        <div class="w-stack">
            <h1 class="w-notification-center__title"><w:icon name="bell" size="md" /><lang>通知中心</lang></h1>
            <p class="w-text" data-tone="muted"><lang>集中查看系统消息、告警与业务提醒。</lang></p>
        </div>
        <div class="w-notification-center__actions">
            <a href="<?= $escape($this->getBackendUrl('system/backend/notificationsubscription')) ?>" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm">
                <w:icon name="settings" size="sm" /><lang>管理订阅</lang>
            </a>
            <?php if ($notifications !== []): ?>
                <button type="button" class="w-button" data-w-notification-action="mark-all-read" data-tone="primary" data-variant="outline" data-size="sm">
                    <w:icon name="check" size="sm" /><span><lang>全部已读</lang></span>
                </button>
            <?php endif; ?>
        </div>
    </header>

    <template>Weline_Component::message.phtml</template>

    <form class="w-card w-notification-filter" method="get" action="<?= $escape($baseUrl) ?>">
        <div class="w-card__body w-notification-filter__fields">
            <input type="hidden" name="page" value="1">
            <label class="w-field w-notification-filter__keyword">
                <span class="w-field__label"><lang>关键词</lang></span>
                <input type="search" name="keyword" class="w-input" placeholder="<?= $escape(__('搜索标题或内容')) ?>" value="<?= $escape($filter['keyword'] ?? '') ?>" data-size="sm">
            </label>
            <label class="w-field">
                <span class="w-field__label"><lang>类型</lang></span>
                <select name="type" class="w-select" data-size="sm">
                    <option value=""><lang>全部类型</lang></option>
                    <?php foreach ($typeOptions as $value => $label): ?>
                        <option value="<?= $escape($value) ?>" <?= ($filter['type'] ?? '') === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
                    <?php endforeach; ?>
                </select>
            </label>
            <label class="w-field">
                <span class="w-field__label"><lang>状态</lang></span>
                <select name="read" class="w-select" data-size="sm">
                    <option value="all" <?= ($filter['read'] ?? 'all') === 'all' ? 'selected' : '' ?>><lang>全部</lang></option>
                    <option value="unread" <?= ($filter['read'] ?? '') === 'unread' ? 'selected' : '' ?>><lang>未读</lang></option>
                    <option value="read" <?= ($filter['read'] ?? '') === 'read' ? 'selected' : '' ?>><lang>已读</lang></option>
                </select>
            </label>
            <div class="w-notification-filter__actions">
                <button type="submit" class="w-button" data-tone="primary" data-size="sm">
                    <w:icon name="search" size="sm" /><lang>搜索</lang>
                </button>
                <a href="<?= $escape($baseUrl) ?>" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm"><lang>重置</lang></a>
            </div>
        </div>
    </form>

    <?php if ($notifications === []): ?>
        <div class="w-card">
            <div class="w-card__body">
                <div class="w-empty-state w-notification-center__empty" role="status">
                    <w:icon name="bell" size="xl" />
                    <h2><lang>暂无通知消息</lang></h2>
                    <p class="w-text" data-tone="muted"><lang>新的系统消息会显示在这里。</lang></p>
                </div>
            </div>
        </div>
    <?php else: ?>
        <div class="w-notification-center__list" aria-label="<?= $escape(__('通知列表')) ?>">
            <?php foreach ($notifications as $notification): ?>
                <?php
                $isRead = (bool)($notification['is_read'] ?? false);
                $type = strtolower((string)($notification['type'] ?? 'info'));
                $tone = in_array($type, ['info', 'success', 'warning'], true) ? $type : 'danger';
                $icon = (string)($notification['type_icon'] ?? 'bell');
                $iconHtml = $renderIcon($icon !== '' ? $icon : 'bell', 'md');
                $content = strip_tags((string)($notification['content'] ?? ''));
                $notificationId = max(0, (int)($notification['notification_id'] ?? 0));
                $detailHref = $escape($this->getBackendUrl('system/backend/notification/detail', ['id' => $notificationId]));
                $itemState = $isRead ? 'read' : 'unread';
                $toneAttr = $escape($tone);
                ?>
                <a
                    href="<?= $detailHref ?>"
                    class="w-notification-center__item"
                    data-state="<?= $itemState ?>"
                >
                    <span class="w-notification-center__item-icon" data-tone="<?= $toneAttr ?>">
                        <?php echo $iconHtml; ?>
                    </span>
                    <span class="w-notification-center__item-content">
                        <span class="w-notification-center__item-header">
                            <strong class="w-notification-center__item-title"><?= $escape($notification['title'] ?? '') ?></strong>
                            <span class="w-notification-center__item-status">
                                <span class="w-badge" data-tone="<?= $escape($tone) ?>"><?= $escape($notification['type_label'] ?? __('信息')) ?></span>
                                <?php if (!$isRead): ?><span class="w-notification-center__unread" aria-label="<?= $escape(__('未读')) ?>"></span><?php endif; ?>
                            </span>
                        </span>
                        <span class="w-notification-center__item-text"><?= $escape(mb_substr($content, 0, 120)) ?><?= mb_strlen($content) > 120 ? '…' : '' ?></span>
                        <span class="w-notification-center__item-footer">
                            <span><w:icon name="clock" size="sm" /><?= $escape($notification['notification_time'] ?? '') ?></span>
                            <?php if (!empty($notification['topic_code'])): ?>
                                <span><w:icon name="tag" size="sm" /><?= $escape($notification['topic_name'] ?? $notification['topic_code']) ?></span>
                            <?php endif; ?>
                            <span class="w-notification-center__view"><lang>查看详情</lang><w:icon name="arrow-right" size="sm" /></span>
                        </span>
                    </span>
                </a>
            <?php endforeach; ?>
        </div>

        <?php if ($totalPages > 1): ?>
            <footer class="w-card w-notification-center__pagination">
                <div class="w-card__body w-stack">
                    <nav aria-label="<?= $escape(__('通知分页')) ?>">
                        <ul class="w-pagination" data-justify="center">
                            <?php if ($currentPage > 1): ?>
                                <li class="w-pagination__item"><a class="w-pagination__link" href="<?= $escape($pageLink($currentPage - 1)) ?>" aria-label="<?= $escape(__('上一页')) ?>"><w:icon name="chevron-left" size="sm" /></a></li>
                            <?php endif; ?>
                            <?php for ($page = max(1, $currentPage - 2); $page <= min($totalPages, $currentPage + 2); $page++): ?>
                                <li class="w-pagination__item"><a class="w-pagination__link" href="<?= $escape($pageLink($page)) ?>" <?= $page === $currentPage ? 'aria-current="page"' : '' ?>><?= $page ?></a></li>
                            <?php endfor; ?>
                            <?php if ($currentPage < $totalPages): ?>
                                <li class="w-pagination__item"><a class="w-pagination__link" href="<?= $escape($pageLink($currentPage + 1)) ?>" aria-label="<?= $escape(__('下一页')) ?>"><w:icon name="chevron-right" size="sm" /></a></li>
                            <?php endif; ?>
                        </ul>
                    </nav>
                    <p class="w-text" data-align="center" data-tone="muted" data-size="sm">
                        <lang>共</lang> <?= max(0, (int)($pagination['total'] ?? 0)) ?> <lang>条通知，第</lang> <?= $currentPage ?> / <?= $totalPages ?> <lang>页</lang>
                    </p>
                </div>
            </footer>
        <?php endif; ?>
    <?php endif; ?>
</section>
