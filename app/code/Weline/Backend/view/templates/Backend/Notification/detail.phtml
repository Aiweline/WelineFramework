<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array $notification
 * @var int|null $prev_id
 * @var string|null $prev_title
 * @var int|null $next_id
 * @var string|null $next_title
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$h = static fn(mixed $value): string => \htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$notification = \is_array($notification ?? null) ? $notification : [];
$prevId = !empty($prev_id) ? \max(0, (int)$prev_id) : 0;
$prevTitle = (string)($prev_title ?? '');
$nextId = !empty($next_id) ? \max(0, (int)$next_id) : 0;
$nextTitle = (string)($next_title ?? '');
$type = \strtolower((string)($notification['type'] ?? 'info'));
$tone = \in_array($type, ['info', 'success', 'warning'], true) ? $type : 'danger';
$typeIcon = (string)($notification['type_icon'] ?? 'bell');
$typeLabel = (string)($notification['type_label'] ?? __('信息'));
$title = (string)($notification['title'] ?? '');
$content = (string)($notification['content'] ?? '');
$contentHtml = \nl2br($h($content));
$notificationTime = (string)($notification['notification_time'] ?? '');
$displayTime = \preg_replace('/\.\d+$/', '', $notificationTime) ?? $notificationTime;
$isRead = !empty($notification['is_read']);
$readTone = $isRead ? 'success' : 'info';
$readIcon = $isRead ? 'check' : 'circle';
$readLabel = $isRead ? (string)__('已读') : (string)__('未读');
$topicCode = (string)($notification['topic_code'] ?? '');
$topicName = (string)($notification['topic_name'] ?? $topicCode);
$hasTopicCode = $topicCode !== '';
$showTopicInMeta = $topicName !== '' && $topicName !== $topicCode;
$metadata = (!empty($notification['metadata']) && \is_array($notification['metadata']))
    ? $notification['metadata']
    : [];
$channels = (!empty($notification['external_channels']) && \is_array($notification['external_channels']))
    ? $notification['external_channels']
    : [];
// Avoid `|` in template source: Taglib compiler may treat it as a filter and leak PHP.
$jsonFlags = \JSON_UNESCAPED_UNICODE + \JSON_UNESCAPED_SLASHES;
$metadataRows = [];
foreach ($metadata as $metaKey => $metaValue) {
    $metadataRows[] = [
        'key' => (string)$metaKey,
        'value' => \is_array($metaValue)
            ? (string)\json_encode($metaValue, $jsonFlags)
            : (string)$metaValue,
    ];
}
if ($hasTopicCode && !$showTopicInMeta) {
    $metadataRows[] = [
        'key' => (string)__('主题'),
        'value' => $topicCode,
    ];
}
$channelLabels = [];
foreach ($channels as $channel) {
    $channelLabels[] = (string)$channel;
}

$listUrl = $this->getBackendUrl('system/backend/notification');
$detailUrlBase = $this->getBackendUrl('system/backend/notification/detail');
$subscriptionUrl = $this->getBackendUrl('system/backend/notificationsubscription');
$markTopicUrl = $this->getBackendUrl('system/backend/notification/markTopicRead');
$prevUrl = $prevId > 0 ? $detailUrlBase . '?' . \http_build_query(['id' => $prevId]) : '';
$nextUrl = $nextId > 0 ? $detailUrlBase . '?' . \http_build_query(['id' => $nextId]) : '';

$icons = ObjectManager::getInstance(IconRegistry::class);
$iconArrowLeft = $icons->render('arrow-left', 'sm');
$iconArrowRight = $icons->render('arrow-right', 'sm');
$iconTag = $icons->render('tag', 'sm');
$iconClock = $icons->render('clock', 'sm');
$iconInfo = $icons->render('info', 'sm');
$iconShare = $icons->render('share', 'sm');
$iconKey = $icons->render('key', 'sm');
$iconCheck = $icons->render('check', 'sm');
$iconSettings = $icons->render('settings', 'sm');
$iconType = $icons->render($typeIcon, 'md');
$iconRead = $icons->render($readIcon, 'sm');

$attrPrevUrl = $h($prevUrl);
$attrNextUrl = $h($nextUrl);
$attrMarkTopicUrl = $h($markTopicUrl);
$attrConfirmTopic = $h((string)__('确定要将「%{name}」类的所有通知标记为已读吗？'));
$attrSuccessMessage = $h((string)__('已标记为已读'));
$attrFailureMessage = $h((string)__('操作失败'));
$attrRequestFailureMessage = $h((string)__('网络错误，请重试'));
$attrAdjacentNav = $h((string)__('相邻通知'));
$attrPrevTitle = $h($prevTitle);
$attrNextTitle = $h($nextTitle);
$attrFirstTitle = $h((string)__('已是第一条'));
$attrLastTitle = $h((string)__('已是最后一条'));
$attrTone = $h($tone);
$attrTypeLabel = $h($typeLabel);
$attrTopicName = $h($topicName);
$attrTopicCode = $h($topicCode);
$attrTitle = $h($title);
$attrTime = $h($displayTime);
$attrReadTone = $h($readTone);
$attrReadLabel = $h($readLabel);
$attrListUrl = $h($listUrl);
$attrSubscriptionUrl = $h($subscriptionUrl);

$hasPrev = $prevId > 0;
$hasNext = $nextId > 0;
$hasMetadata = $metadataRows !== [];
$hasChannels = $channelLabels !== [];
?>
<link rel="stylesheet" href="@static(Weline_Backend::css/notification-center.css)">

<section
    class="w-notification-detail w-stack"
    data-w-component="notification-center"
    data-w-mode="detail"
    data-w-prev-url="<?= $attrPrevUrl ?>"
    data-w-next-url="<?= $attrNextUrl ?>"
    data-w-mark-topic-url="<?= $attrMarkTopicUrl ?>"
    data-w-confirm-topic="<?= $attrConfirmTopic ?>"
    data-w-success-message="<?= $attrSuccessMessage ?>"
    data-w-failure-message="<?= $attrFailureMessage ?>"
    data-w-request-failure-message="<?= $attrRequestFailureMessage ?>"
>
    <header class="w-notification-detail__chrome">
        <a href="<?= $attrListUrl ?>" class="w-notification-detail__back"><?php echo $iconArrowLeft; ?><lang>返回通知中心</lang></a>
        <nav class="w-notification-detail__pager" aria-label="<?= $attrAdjacentNav ?>">
<?php if ($hasPrev) { ?>
            <a href="<?= $attrPrevUrl ?>" class="w-button" title="<?= $attrPrevTitle ?>" data-tone="neutral" data-variant="outline" data-size="sm">
                <?php echo $iconArrowLeft; ?><lang>上一条</lang>
            </a>
<?php } else { ?>
            <span class="w-button" title="<?= $attrFirstTitle ?>" aria-disabled="true" data-tone="neutral" data-variant="outline" data-size="sm">
                <?php echo $iconArrowLeft; ?><lang>上一条</lang>
            </span>
<?php } ?>
<?php if ($hasNext) { ?>
            <a href="<?= $attrNextUrl ?>" class="w-button" title="<?= $attrNextTitle ?>" data-tone="neutral" data-variant="outline" data-size="sm">
                <lang>下一条</lang><?php echo $iconArrowRight; ?>
            </a>
<?php } else { ?>
            <span class="w-button" title="<?= $attrLastTitle ?>" aria-disabled="true" data-tone="neutral" data-variant="outline" data-size="sm">
                <lang>下一条</lang><?php echo $iconArrowRight; ?>
            </span>
<?php } ?>
        </nav>
    </header>

    <article class="w-card w-notification-detail__card">
        <div class="w-card__body w-notification-detail__body">
            <header class="w-notification-detail__headline">
                <span class="w-notification-detail__type-icon" data-tone="<?= $attrTone ?>"><?php echo $iconType; ?></span>
                <div class="w-notification-detail__headline-main">
                    <h1 class="w-notification-detail__title"><?= $attrTitle ?></h1>
                    <div class="w-notification-detail__meta">
                        <span class="w-badge" data-tone="<?= $attrTone ?>"><?= $attrTypeLabel ?></span>
                        <span class="w-badge" data-tone="<?= $attrReadTone ?>"><?php echo $iconRead; ?><?= $attrReadLabel ?></span>
                        <span class="w-notification-detail__time"><?php echo $iconClock; ?><?= $attrTime ?></span>
<?php if ($showTopicInMeta) { ?>
                        <span class="w-notification-detail__topic"><?php echo $iconTag; ?><?= $attrTopicName ?></span>
<?php } ?>
                    </div>
                </div>
            </header>

            <div class="w-notification-detail__content"><?php echo $contentHtml; ?></div>

<?php if ($hasMetadata) { ?>
            <section class="w-notification-detail__supplement" aria-labelledby="w-notification-metadata-title">
                <h2 id="w-notification-metadata-title"><?php echo $iconInfo; ?><lang>附加信息</lang></h2>
                <div class="w-notification-detail__metadata">
<?php foreach ($metadataRows as $row) {
    $metaKeyHtml = $h($row['key']);
    $metaValueHtml = $h($row['value']);
?>
                    <div class="w-notification-detail__metadata-row">
                        <div class="w-notification-detail__metadata-key"><?= $metaKeyHtml ?></div>
                        <div class="w-notification-detail__metadata-value"><?= $metaValueHtml ?></div>
                    </div>
<?php } ?>
                </div>
            </section>
<?php } ?>

<?php if ($hasChannels) { ?>
            <section class="w-notification-detail__supplement" aria-labelledby="w-notification-channels-title">
                <h2 id="w-notification-channels-title"><?php echo $iconShare; ?><lang>已推送渠道</lang></h2>
                <div class="w-notification-detail__channels">
<?php foreach ($channelLabels as $channelLabel) {
    $channelHtml = $h($channelLabel);
?>
                    <span class="w-badge" data-tone="neutral"><?= $channelHtml ?></span>
<?php } ?>
                </div>
            </section>
<?php } ?>
        </div>

        <footer class="w-notification-detail__footer">
            <div class="w-notification-detail__footer-actions">
<?php if ($hasTopicCode) { ?>
                <button
                    type="button"
                    class="w-button"
                    data-w-notification-action="mark-topic-read"
                    data-w-topic-code="<?= $attrTopicCode ?>"
                    data-w-topic-name="<?= $attrTopicName ?>"
                    data-tone="neutral"
                    data-variant="outline"
                    data-size="sm"
                ><?php echo $iconCheck; ?><lang>此类全部已读</lang></button>
<?php } ?>
                <a href="<?= $attrSubscriptionUrl ?>" class="w-button" data-tone="primary" data-variant="outline" data-size="sm"><?php echo $iconSettings; ?><lang>订阅设置</lang></a>
            </div>
            <span class="w-notification-detail__keyboard-hint w-text" data-tone="muted" data-size="sm"><?php echo $iconKey; ?><lang>使用 ← → 方向键切换</lang></span>
        </footer>
    </article>
</section>
