<script>
(function(g){
  if(g.__bqAdmin_backend_admin) return;
  g.__bqAdmin_backend_admin=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['backend_admin']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('backend_admin').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
(function() {
    'use strict';
    var prevUrl = <?= $prevId ? json_encode($detailUrlBase . '?id=' . (int)$prevId, $jsonForScriptFlags) : 'null' ?>;
    var nextUrl = <?= $nextId ? json_encode($detailUrlBase . '?id=' . (int)$nextId, $jsonForScriptFlags) : 'null' ?>;
    var markTopicReadUrl = <?= json_encode($this->getBackendUrl('system/backend/notification/markTopicRead'), $jsonForScriptFlags) ?>;
    var confirmMsgTemplate = <?= json_encode((string)__('确定要将「%{name}」类的所有通知标记为已读吗？'), $jsonForScriptFlags) ?>;

    document.addEventListener('keydown', function(e) {
        if (/input|textarea|select/i.test(document.activeElement && document.activeElement.tagName || '')) {
            return;
        }
        if (e.key === 'ArrowLeft' && prevUrl) {
            window.location.href = prevUrl;
        } else if (e.key === 'ArrowRight' && nextUrl) {
            window.location.href = nextUrl;
        }
    });

    var btn = document.querySelector('.weline-nd-mark-topic-read');
    if (btn) {
        btn.addEventListener('click', function() {
            var topicCode = btn.getAttribute('data-topic-code');
            var topicName = btn.getAttribute('data-topic-name') || topicCode;
            var msg = confirmMsgTemplate.replace('%{name}', topicName || topicCode || '');
            Weline.UI.dialog.confirm(msg).then(function(confirmed) {
                if (!confirmed) return;
                var opts = { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ topic_code: topicCode }) };
                bqAdmin['backend_admin'](markTopicReadUrl, opts)
                    .then(function(res) {
                        var data = (res && res.data) !== undefined ? res.data : res;
                        if (data.success) {
                            Weline.UI.toast.success(data.message || '<?= __('已标记为已读') ?>');
                            setTimeout(function() { window.location.reload(); }, 800);
                        } else {
                            Weline.UI.toast.error(data.message || '<?= __('操作失败') ?>');
                        }
                    })
                    .catch(function(err) {
                        Weline.UI.toast.error('<?= __('网络错误，请重试') ?>');
                    });
            });
        });
    }
})();
</script>
