                <div class="text-muted"><lang>未找到当前发布标记文件</lang></div>
            <?php else: ?>
                <div class="table-responsive"><table class="table table-striped mb-0"><tbody>
                <?php foreach ($current as $key => $value): ?>
                    <tr><th><?= $escape($key) ?></th><td><?= $escape($value) ?></td></tr>
                <?php endforeach; ?>
                </tbody></table></div>
            <?php endif; ?>
