<?php
/**
 * w-ajax — bin-query 业务点击动作
 *
 * 必填（兼容窗后）：data-provider / data-operation
 * 可选：data-params JSON、data-* / jQuery data() 作为参数
 * 废弃：w-ajax="ControllerUrl"（兼容窗内仅警告；remove_by=2026-08-08）
 */
?>
<script>
    $("*[w-ajax]").on('click', function (event) {
        event.preventDefault()
        const target = $(this)
        let reload = target.data('reload')
        let confirm = target.data('confirm')
        let cancel = target.data('cancel')
        let success_confirm = target.data('success-confirm')
        let failure_confirm = target.data('failure-confirm')
        let message = target.data('msg')
        const provider = String(target.attr('data-provider') || target.data('provider') || '').trim()
        const operation = String(target.attr('data-operation') || target.data('operation') || '').trim()
        const legacyAction = String(target.attr('w-ajax') || '').trim()
        // Compat window for legacy action URL: remove_by=2026-08-08
        if ((!provider || !operation) && legacyAction && legacyAction !== 'true' && legacyAction !== '1') {
            console.warn('[w-ajax] deprecated action URL; use data-provider + data-operation. remove_by=2026-08-08', target.get(0))
        }

        const collectParams = function () {
            let params = {}
            const raw = target.attr('data-params') || target.data('params')
            if (raw) {
                if (typeof raw === 'object') {
                    params = Object.assign({}, raw)
                } else {
                    try { params = JSON.parse(String(raw)) || {} } catch (e) { params = {} }
                }
            }
            const data = target.data() || {}
            Object.keys(data).forEach(function (key) {
                if (['provider', 'operation', 'params', 'reload', 'confirm', 'cancel', 'successConfirm', 'failureConfirm', 'msg', 'method'].indexOf(key) !== -1) {
                    return
                }
                if (data[key] !== undefined && data[key] !== null) {
                    params[key] = data[key]
                }
            })
            return params
        }

        const requestAction = function () {
            if (!provider || !operation) {
                return Promise.reject(new Error('w-ajax requires data-provider and data-operation (remove_by=2026-08-08 for legacy action).'))
            }
            if (!window.Weline) {
                return Promise.reject(new Error('Weline.Api is unavailable.'))
            }
            const params = collectParams()
            const run = function (api) {
                const resource = api.resource(provider)
                if (!resource || typeof resource[operation] !== 'function') {
                    throw new Error('Unknown operation: ' + provider + '.' + operation)
                }
                return resource[operation](params)
            }
            if (typeof window.Weline.load === 'function') {
                return window.Weline.load('api').then(run)
            }
            return Promise.resolve(run(window.Weline.Api))
        }

        if (message) {
            Weline.UI.dialog.request({
                title: message,
                tone: 'warning',
                cancelable: true,
                confirmLabel: confirm??'@lang{好的}',
                cancelLabel: cancel??'@lang{算了}'
            }).then((result) => {
                if (result.confirmed) {
                    showLoading();
                    requestAction().then((res) => {
                        const ok = !res || res.success !== false
                        if (!ok) {
                            const errText = (window.Weline && window.Weline.ApiBusiness)
                                ? window.Weline.ApiBusiness.formatApiError({ response: { data: res } }, res.message || '')
                                : (res.message || res.title || '')
                            Weline.UI.dialog.request({
                                title: res.title || '@lang{失败}',
                                message: errText,
                                tone: 'danger',
                                confirmLabel: failure_confirm??'@lang{好的}'
                            })
                        } else {
                            Weline.UI.dialog.request({
                                title: res && res.title ? res.title : '@lang{成功}',
                                message: (res && res.message) ? res.message : __('操作成功!'),
                                tone: 'success',
                                confirmLabel: success_confirm??'@lang{好的}'
                            })
                        }
                        if (reload) {
                            location.reload()
                        }
                        hideLoading();
                    }).catch(function (err) {
                        hideLoading();
                        const errText = (window.Weline && window.Weline.ApiBusiness)
                            ? window.Weline.ApiBusiness.formatApiError(err)
                            : (err && err.message ? err.message : String(err))
                        Weline.UI.dialog.request({
                            title: '@lang{失败}',
                            message: errText,
                            tone: 'danger',
                            confirmLabel: failure_confirm??'@lang{好的}'
                        })
                    })
                }
            })
        } else {
            showLoading();
            requestAction().then(function (res) {
                hideLoading();
                if (reload) location.reload()
                return res
            }).catch(function (err) {
                hideLoading();
                console.error(err)
            })
        }
    })
</script>
