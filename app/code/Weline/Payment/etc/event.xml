<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Theme::layout_resolve">
        <observer name="Weline_Payment::layout_resolve"
                  instance="Weline\Payment\Observer\LayoutResolveObserver"
                  disabled="false"
                  shared="true"
                  sort="60"/>
    </event>
    <event name="Weline_Framework_Setup::upgrade_after">
        <observer name="Weline_Payment::setup_upgrade_validate_payment_guide_i18n"
                  instance="Weline\Payment\Observer\SetupUpgradeValidatePaymentGuideI18n"
                  disabled="false"
                  shared="true"
                  sort="90"/>
        <observer name="Weline_Payment::setup_upgrade_paypal_sandbox_bootstrap"
                  instance="Weline\Payment\Observer\SetupUpgradePayPalSandboxBootstrap"
                  disabled="false"
                  shared="true"
                  sort="95"/>
    </event>
    <event name="Weline_Payment::webhook_inbox_received">
        <observer name="Weline_Payment::webhook_inbox_received_dev_relay"
                  instance="Weline\Payment\Observer\WebhookInboxReceivedObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
        <observer name="Weline_Payment::paypal_webhook_notification"
                  instance="Weline\Payment\Observer\PayPalWebhookNotificationObserver"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>
    <event name="Weline_Order::order_shipped">
        <observer name="Weline_Payment::order_shipped_shipment_tracking"
                  instance="Weline\Payment\Observer\OrderShippedShipmentTrackingObserver"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>
    <event name="Weline_Checkout::checkout::freeze_quote::enrich">
        <observer name="Weline_Payment::checkout_freeze_quote_asset_enrich"
                  instance="Weline\Payment\Observer\CheckoutFreezeQuoteAssetEnrichObserver"
                  disabled="false"
                  shared="false"
                  sort="200"/>
    </event>
    <event name="Weline_Checkout::checkout::asset_discount::apply">
        <observer name="Weline_Payment::checkout_asset_discount_apply"
                  instance="Weline\Payment\Observer\CheckoutAssetDiscountApplyObserver"
                  disabled="false"
                  shared="false"
                  sort="200"/>
    </event>
    <event name="Weline_Payment::checkout::available_methods::enrich">
        <observer name="Weline_Payment::checkout_available_methods_incentive_enrich"
                  instance="Weline\Payment\Observer\CheckoutAvailableMethodsIncentiveEnrichObserver"
                  disabled="false"
                  shared="false"
                  sort="100"/>
    </event>
</config>
