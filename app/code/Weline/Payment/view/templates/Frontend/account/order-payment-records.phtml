<?php
/**
 * 账户订单详情：支付历史（含 payment_entry 来源徽章）。
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Payment\Service\BackendOrderPaymentRecordsService;
use Weline\Payment\Service\BackendPaymentOutcomeChip;

$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$orderUuid = trim((string)($this->getData('account_payment_order_uuid') ?? ''));
if ($orderUuid === '') {
    $orderUuid = trim((string)($this->getData('order_uuid') ?? ''));
}
if ($orderUuid === '' && isset($this->request) && is_object($this->request)) {
    $orderUuid = trim((string)$this->request->getParam('order_uuid', ''));
}
if ($orderUuid === '') {
    return;
}

/** @var BackendOrderPaymentRecordsService $recordsService */
$recordsService = ObjectManager::getInstance(BackendOrderPaymentRecordsService::class);
$payments = $recordsService->listForPayable('order', $orderUuid);
?>
<section class="account-order-detail__payments"
         data-account-order-payments="true"
         data-testid="account-order-payment-records"
         data-order-uuid="<?= $esc($orderUuid) ?>"
         aria-labelledby="account-order-payments-title"
         weline-code="payment.account.order.payment_records">
    <h4 id="account-order-payments-title"><?= __('支付历史') ?></h4>
    <?php if ($payments === []): ?>
        <p class="account-order-detail__payments-empty" data-testid="account-order-payments-empty"><?= __('暂无支付记录') ?></p>
    <?php else: ?>
        <div class="account-order-detail__payments-table" role="table" aria-label="<?= __('支付历史') ?>">
            <div class="account-order-detail__payments-row account-order-detail__payments-row--head" role="row">
                <span role="columnheader"><?= __('支付方式') ?></span>
                <span role="columnheader"><?= __('来源') ?></span>
                <span role="columnheader"><?= __('金额') ?></span>
                <span role="columnheader"><?= __('状态') ?></span>
                <span role="columnheader"><?= __('时间') ?></span>
            </div>
            <?php foreach ($payments as $payment): ?>
                <?php
                if (!\is_array($payment)) {
                    continue;
                }
                $methodLabel = trim((string)($payment['method_label'] ?? ''));
                if ($methodLabel === '') {
                    $methodLabel = trim((string)($payment['payment_method'] ?? '')) ?: (string)__('未指定');
                }
                $entryCode = (string)($payment['payment_entry'] ?? 'unknown');
                $entryLabel = trim((string)($payment['payment_entry_label'] ?? ''));
                if ($entryLabel === '') {
                    $entryLabel = (string)__('未标记');
                }
                $entryTone = trim((string)($payment['payment_entry_tone'] ?? 'muted')) ?: 'muted';
                $currency = trim((string)($payment['currency'] ?? 'CNY')) ?: 'CNY';
                $amount = number_format((float)($payment['amount'] ?? 0), 2);
                $statusChip = BackendPaymentOutcomeChip::present((string)($payment['status'] ?? ''));
                $paidAt = trim((string)($payment['paid_at'] ?? ''));
                ?>
                <div class="account-order-detail__payments-row"
                     role="row"
                     data-testid="account-order-payment-row"
                     data-payment-entry="<?= $esc($entryCode) ?>"
                     data-status="<?= $esc((string)($payment['status'] ?? '')) ?>">
                    <span role="cell" data-label="<?= __('支付方式') ?>" data-testid="account-order-payment-method"><?= $esc($methodLabel) ?></span>
                    <span role="cell" data-label="<?= __('来源') ?>">
                        <span class="account-orders__badge"
                              data-tone="<?= $esc($entryTone) ?>"
                              data-payment-entry="<?= $esc($entryCode) ?>"
                              data-testid="account-order-payment-entry"><?= $esc($entryLabel) ?></span>
                    </span>
                    <span role="cell" data-label="<?= __('金额') ?>" data-testid="account-order-payment-amount"><?= $esc($currency . ' ' . $amount) ?></span>
                    <span role="cell" data-label="<?= __('状态') ?>" data-testid="account-order-payment-status">
                        <?= $this->fetch('Weline_Payment::templates/Backend/partials/outcome-chip.phtml', [
                            'chip' => $statusChip,
                            'testid' => 'account-order-payment-status-chip',
                        ]) ?>
                    </span>
                    <span role="cell" data-label="<?= __('时间') ?>" data-testid="account-order-payment-time"><?= $esc($paidAt !== '' ? $paidAt : '—') ?></span>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>
