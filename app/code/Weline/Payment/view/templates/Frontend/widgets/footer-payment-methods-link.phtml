<?php
/**
 * 页脚「支付与账户」扩展：支付方式指南入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-payment-methods-link}
 * @widget.name {页脚支付方式链接}
 * @widget.description {页脚支付与账户扩展槽：支付方式指南入口；默认注入 footer-payment-account-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-payment-account-links}
 * @widget.supports {["footer-payment-methods-link","layout-footer-payment-account-links"]}
 * @widget.default_injections {[{ "layout_type":"*", "slot":"footer-payment-account-links", "area":"footer", "sort_order":0, "required":true, "reason":"页脚支付与账户默认展示支付方式指南", "config":{"label":"支付方式"} }]}
 *
 * @param label {default="支付方式",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-payment-methods-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '支付方式';
$label = WidgetI18n::label($labelSource, '支付方式');
?>
<a class="footer-payment-account-link footer-payment-methods-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-payment-methods-link"
   href="@url{'guide/payment'}"><?= $esc($label) ?></a>
