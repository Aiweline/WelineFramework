<?php
/**
 * @widget.source {Weline_Payment::css/widgets/widget-checkout-express-payment.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Payment::js/widgets/widget-checkout-express-payment-0.js}
 * 结账快捷支付（Shopify Express checkout 布局 + Amazon 色板）。
 * 业务提交由结账页监听 weline:checkout:express-pay；本部件只渲染与派发。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {checkout-express-payment}
 * @widget.name {结账快捷支付}
 * @widget.description {结账页快捷支付（Shopify 布局 + Amazon 风格）：默认注入 PayPal 快捷支付；部件开关控制是否展示。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["checkout"]}
 * @widget.slot {checkout-express-payment}
 * @widget.supports {["checkout-express-payment","express-checkout","express-payment","payment"]}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-express-payment","area":"content","sort_order":10,"required":true,"reason":"结账页提示条下方默认由万能支付提供快捷支付（PayPal）","config":{"enabled":true,"title":"快捷支付","method_code":"paypal"}}]}
 *
 * @param enabled {default=true,type="bool",label="展示快捷支付"}
 * @param title {default="快捷支付",type="string",label="标题"}
 * @param method_code {default="paypal",type="string",label="支付方式代码"}
 * @param logo {default="",type="media_image",label="快捷支付 Logo",description="从媒体库选择 Logo；留空用支付方式默认图",i18n=false}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Payment\Api\PaymentExpressFacadeInterface;
use Weline\Payment\Service\ExpressCheckoutOrchestrator;
use Weline\Payment\Service\PaymentMethodIconResolver;
use Weline\SystemConfig\Api\ConfigStore;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$enabled = filter_var($this->getData('enabled') ?? true, FILTER_VALIDATE_BOOLEAN);
if (!$enabled) {
    return;
}

$scope = WidgetUiScope::forWidget('checkout-express-payment');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '快捷支付';
$title = WidgetI18n::label($titleSource, '快捷支付');
$configMethod = strtolower(trim((string)($this->getData('method_code') ?? 'paypal'))) ?: 'paypal';
$orLabel = (string)__('或使用下方结账');
$defaultLogoRef = 'Weline_Payment::img/payment/paypal-express.svg';
$logoFileHtml = trim((string)($this->getData('logo_file_html') ?? ''));
$logoRaw = LegacyMediaUrl::sanitize($this->getData('logo') ?? '');
$iconResolver = ObjectManager::getInstance(PaymentMethodIconResolver::class);

$expressMethods = [];
try {
    $facade = ObjectManager::getInstance(PaymentExpressFacadeInterface::class);
    if (!$facade instanceof PaymentExpressFacadeInterface) {
        $facade = new ExpressCheckoutOrchestrator();
    }
    $expressMethods = $facade->listExpressMethods([]);
} catch (\Throwable) {
    $expressMethods = [];
}
if ($expressMethods === []) {
    return;
}

if ($logoFileHtml === '' && $logoRaw === '') {
    try {
        $logoRaw = trim((string) ObjectManager::getInstance(ConfigStore::class)->getConfig(
            'payment/method/paypal/express_logo',
            'Weline_Payment',
            ConfigStore::area_BACKEND,
            ''
        ));
    } catch (\Throwable) {
        $logoRaw = '';
    }
}
?>
<section class="w-payment-express <?= $esc($wc) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="checkout-express-payment"
         data-widget-code="checkout-express-payment"
         data-payment-express
         data-method-code="<?= $esc($configMethod) ?>">
    <header class="w-payment-express__header">
        <h2 class="w-payment-express__title"><?= $esc($title) ?></h2>
    </header>
    <div class="w-payment-express__methods" role="group" aria-label="<?= $esc($title) ?>">
        <?php foreach ($expressMethods as $method):
            $code = strtolower(trim((string) ($method['method_code'] ?? '')));
            if ($code === '') {
                continue;
            }
            $label = trim((string) ($method['title'] ?? $code)) ?: $code;
            $btnLogoHtml = ($code === 'paypal') ? $logoFileHtml : '';
            $btnLogoRaw = '';
            if ($btnLogoHtml === '') {
                if ($code === 'paypal' && $logoRaw !== '') {
                    $btnLogoRaw = $logoRaw;
                } elseif ($code === 'paypal') {
                    $btnLogoRaw = $defaultLogoRef;
                } else {
                    $btnLogoRaw = trim((string) ($method['icon_url'] ?? ''));
                }
            }
            $btnLogoUrl = $btnLogoRaw !== '' ? $iconResolver->toPublicUrl($btnLogoRaw) : '';
            $isPaypal = $code === 'paypal';
            ?>
        <button type="button"
                class="w-payment-express__btn<?= $isPaypal ? ' w-payment-express__paypal' : '' ?> weline-pixel::express_pay"
                data-express-pay
                data-pixel-event="express_pay"
                data-method-code="<?= $esc($code) ?>"
                data-method-label="<?= $esc((string)__('使用 %{1} 快捷支付', [$label])) ?>"
                data-testid="checkout-express-<?= $esc($code) ?>"
                aria-label="<?= $esc((string)__('使用 %{1} 快捷支付', [$label])) ?>">
            <?php if ($btnLogoHtml !== ''): ?>
                <span class="w-payment-express__logo" aria-hidden="true"><?= $btnLogoHtml ?></span>
            <?php elseif ($btnLogoUrl !== ''): ?>
                <img class="w-payment-express__logo-img"
                     src="<?= $esc($btnLogoUrl) ?>"
                     alt="<?= $esc($label) ?>"
                     width="90"
                     height="24"
                     decoding="async" />
            <?php else: ?>
                <span class="w-payment-express__paypal-mark" aria-hidden="true"><?= $esc($label) ?></span>
            <?php endif; ?>
        </button>
        <?php endforeach; ?>
    </div>
    <div class="w-payment-express__divider" role="separator" aria-label="<?= $esc($orLabel) ?>">
        <span><?= $esc($orLabel) ?></span>
    </div>
</section>
<span hidden data-widget-script="payment-checkout-express-payment-0"></span>
