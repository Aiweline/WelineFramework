<?php
/**
 * 结账快捷支付（Shopify Express checkout 布局 + Amazon 色板）。
 * 业务提交由结账页监听 weline:checkout:express-pay；本部件只渲染与派发。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {checkout-express-payment}
 * @widget.name {结账快捷支付}
 * @widget.description {结账页快捷支付（Shopify 布局 + Amazon 风格）：默认注入 PayPal 快捷支付；部件开关控制是否展示。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["checkout"]}
 * @widget.slot {checkout-express-payment}
 * @widget.supports {["checkout-express-payment","express-checkout","express-payment","payment"]}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-express-payment","area":"content","sort_order":10,"required":true,"reason":"结账页提示条下方默认由万能支付提供快捷支付（PayPal）","config":{"enabled":true,"title":"快捷支付","method_code":"paypal"}}]}
 *
 * @param enabled {default=true,type="bool",label="展示快捷支付"}
 * @param title {default="快捷支付",type="string",label="标题"}
 * @param method_code {default="paypal",type="string",label="支付方式代码"}
 * @param logo {default="",type="image",label="快捷支付 Logo"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Payment\Api\PaymentExpressFacadeInterface;
use Weline\Payment\Service\ExpressCheckoutOrchestrator;
use Weline\Payment\Service\PaymentMethodIconResolver;
use Weline\SystemConfig\Api\ConfigStore;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$enabled = filter_var($this->getData('enabled') ?? true, FILTER_VALIDATE_BOOLEAN);
if (!$enabled) {
    return;
}

$scope = WidgetUiScope::forWidget('checkout-express-payment');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '快捷支付';
$title = WidgetI18n::label($titleSource, '快捷支付');
$configMethod = strtolower(trim((string)($this->getData('method_code') ?? 'paypal'))) ?: 'paypal';
$orLabel = (string)__('或使用下方结账');
$defaultLogoRef = 'Weline_Payment::img/payment/paypal-express.svg';
$logoFileHtml = trim((string)($this->getData('logo_file_html') ?? ''));
$logoRaw = trim((string)($this->getData('logo') ?? ''));
$iconResolver = ObjectManager::getInstance(PaymentMethodIconResolver::class);

$expressMethods = [];
try {
    $facade = ObjectManager::getInstance(PaymentExpressFacadeInterface::class);
    if (!$facade instanceof PaymentExpressFacadeInterface) {
        $facade = new ExpressCheckoutOrchestrator();
    }
    $expressMethods = $facade->listExpressMethods([]);
} catch (\Throwable) {
    $expressMethods = [];
}
if ($expressMethods === []) {
    return;
}

if ($logoFileHtml === '' && $logoRaw === '') {
    try {
        $logoRaw = trim((string) ObjectManager::getInstance(ConfigStore::class)->getConfig(
            'payment/method/paypal/express_logo',
            'Weline_Payment',
            ConfigStore::area_BACKEND,
            ''
        ));
    } catch (\Throwable) {
        $logoRaw = '';
    }
}
?>
<section class="w-payment-express <?= $esc($wc) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="checkout-express-payment"
         data-payment-express
         data-method-code="<?= $esc($configMethod) ?>">
    <header class="w-payment-express__header">
        <h2 class="w-payment-express__title"><?= $esc($title) ?></h2>
    </header>
    <div class="w-payment-express__methods" role="group" aria-label="<?= $esc($title) ?>">
        <?php foreach ($expressMethods as $method):
            $code = strtolower(trim((string) ($method['method_code'] ?? '')));
            if ($code === '') {
                continue;
            }
            $label = trim((string) ($method['title'] ?? $code)) ?: $code;
            $btnLogoHtml = ($code === 'paypal') ? $logoFileHtml : '';
            $btnLogoRaw = '';
            if ($btnLogoHtml === '') {
                if ($code === 'paypal' && $logoRaw !== '') {
                    $btnLogoRaw = $logoRaw;
                } elseif ($code === 'paypal') {
                    $btnLogoRaw = $defaultLogoRef;
                } else {
                    $btnLogoRaw = trim((string) ($method['icon_url'] ?? ''));
                }
            }
            $btnLogoUrl = $btnLogoRaw !== '' ? $iconResolver->toPublicUrl($btnLogoRaw) : '';
            $isPaypal = $code === 'paypal';
            ?>
        <button type="button"
                class="w-payment-express__btn<?= $isPaypal ? ' w-payment-express__paypal' : '' ?>"
                data-express-pay
                data-method-code="<?= $esc($code) ?>"
                data-testid="checkout-express-<?= $esc($code) ?>"
                aria-label="<?= $esc((string)__('使用 %{1} 快捷支付', [$label])) ?>">
            <?php if ($btnLogoHtml !== ''): ?>
                <span class="w-payment-express__logo" aria-hidden="true"><?= $btnLogoHtml ?></span>
            <?php elseif ($btnLogoUrl !== ''): ?>
                <img class="w-payment-express__logo-img"
                     src="<?= $esc($btnLogoUrl) ?>"
                     alt="<?= $esc($label) ?>"
                     width="90"
                     height="24"
                     decoding="async" />
            <?php else: ?>
                <span class="w-payment-express__paypal-mark" aria-hidden="true"><?= $esc($label) ?></span>
            <?php endif; ?>
        </button>
        <?php endforeach; ?>
    </div>
    <div class="w-payment-express__divider" role="separator" aria-label="<?= $esc($orLabel) ?>">
        <span><?= $esc($orLabel) ?></span>
    </div>
</section>
<style>
.w-payment-express {
    --express-text: var(--color-text-primary, #0f1111);
    --express-text-secondary: var(--color-text-secondary, #565959);
    --express-border: var(--color-border-default, #ddd);
    --express-surface: var(--color-bg-primary, #fff);
    --express-surface-muted: var(--color-bg-secondary, #f0f2f2);
    --express-btn-min: 148px;
    --express-btn-max: 200px;
    --express-paypal-bg: #ffc439;
    --express-paypal-bg-hover: #f2b824;
    --express-paypal-text: #003087;
    box-sizing: border-box;
    display: grid;
    gap: 14px;
    margin: 0 0 4px;
    padding: 16px 18px 18px;
    border: 1px solid var(--express-border);
    border-radius: 8px;
    background: var(--express-surface);
    color: var(--express-text);
}
.w-payment-express__header {
    margin: 0;
}
.w-payment-express__title {
    margin: 0;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--express-text);
}
/* Shopify Express：多按钮等宽网格，单按钮不再通栏 */
.w-payment-express__methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--express-btn-min), var(--express-btn-max)));
    justify-content: center;
    gap: 10px 12px;
}
.w-payment-express__btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 8px 14px;
    border-radius: 8px;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
}
.w-payment-express__paypal {
    border: 1px solid #f0b90b;
    background: var(--express-paypal-bg);
    color: var(--express-paypal-text);
}
.w-payment-express__paypal:hover:not(:disabled) {
    background: var(--express-paypal-bg-hover);
}
.w-payment-express__btn:disabled {
    opacity: 0.65;
    cursor: wait;
}
.w-payment-express__logo,
.w-payment-express__logo-img {
    display: block;
    max-width: 96px;
    max-height: 24px;
    width: auto;
    height: auto;
    object-fit: contain;
}
.w-payment-express__logo img {
    display: block;
    max-width: 96px;
    max-height: 24px;
    width: auto;
    height: auto;
    object-fit: contain;
}
.w-payment-express__paypal-mark {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 18px;
    letter-spacing: 0.02em;
    line-height: 1;
}
.w-payment-express__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    color: var(--express-text-secondary);
    font-size: 13px;
}
.w-payment-express__divider::before,
.w-payment-express__divider::after {
    content: "";
    height: 1px;
    background: var(--express-border);
}
.w-payment-express__divider span {
    white-space: nowrap;
}
@media (max-width: 420px) {
    .w-payment-express__methods {
        grid-template-columns: minmax(0, 1fr);
    }
}
</style>
<script>
(function () {
    const section = document.querySelector('[data-payment-express][data-testid="checkout-express-payment"]');
    if (!section || section.dataset.expressBound === '1') {
        return;
    }
    section.dataset.expressBound = '1';
    section.addEventListener('click', function (event) {
        const button = event.target && event.target.closest
            ? event.target.closest('[data-express-pay]')
            : null;
        if (!button || button.disabled) {
            return;
        }
        event.preventDefault();
        const methodCode = (button.getAttribute('data-method-code')
            || section.getAttribute('data-method-code')
            || 'paypal').trim() || 'paypal';
        const checkoutRoot = section.closest('[data-weline-checkout]') || document.querySelector('[data-weline-checkout]');
        if (!checkoutRoot) {
            return;
        }
        checkoutRoot.dispatchEvent(new CustomEvent('weline:checkout:express-pay', {
            bubbles: true,
            detail: {
                payment_method: methodCode,
                button: button,
            },
        }));
    });
})();
</script>
