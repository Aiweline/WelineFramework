<?php
/**
 * @widget.source {Weline_Payment::css/widgets/widget-product-express-payment.css}
 * PDP 快捷智能支付（万能支付壳 listExpressMethods；点击加车后 startExpressCheckout 打开支付商窗体）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-express-payment}
 * @widget.name {商品快捷支付}
 * @widget.description {商品基础信息：立即结账下方快捷智能支付；默认注入；与结账 express 同一壳逻辑}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.slot {product-express-payment}
 * @widget.supports {["layout-product-express-payment","product-express-payment","express-checkout","express-payment","payment"]}
 * @widget.default_injections {[{"layout_type":"product","layout_option":"default","slot":"product-express-payment","area":"content","sort_order":20,"required":true,"reason":"商品基础信息默认由万能支付注入快捷智能支付","config":{"enabled":true,"title":"快捷支付","method_code":"paypal"}}]}
 *
 * @param enabled {default=true,type="bool",label="展示快捷支付"}
 * @param title {default="快捷支付",type="string",label="标题"}
 * @param method_code {default="paypal",type="string",label="支付方式代码"}
 * @param logo {default="",type="media_image",label="快捷支付 Logo",description="从媒体库选择 Logo；留空用支付方式默认图",i18n=false}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Payment\Api\PaymentExpressFacadeInterface;
use Weline\Payment\Service\ExpressCheckoutOrchestrator;
use Weline\Payment\Service\PaymentMethodIconResolver;
use Weline\Product\Helper\StorefrontOfferResolver;
use Weline\SystemConfig\Api\ConfigStore;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-express-payment');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$titleSource = trim((string) ($this->getData('title') ?? '')) ?: '快捷支付';
$title = WidgetI18n::label($titleSource, '快捷支付');
$configMethod = strtolower(trim((string) ($this->getData('method_code') ?? 'paypal'))) ?: 'paypal';

$renderEmptyShell = static function (string $hint) use ($esc, $wc, $scope, $title, $configMethod): void {
    ?>
    <section class="w-payment-express w-payment-express--empty <?= $esc($wc) ?>"
             weline-code="<?= $esc($scope->code) ?>"
             data-uid="<?= $esc($scope->uid) ?>"
             data-testid="product-express-payment"
             data-payment-express
             data-express-empty="1"
             data-method-code="<?= $esc($configMethod) ?>">
        <header class="w-payment-express__header">
            <h2 class="w-payment-express__title"><?= $esc($title) ?></h2>
        </header>
        <p class="w-payment-express__empty-hint"><?= $esc($hint) ?></p>
    </section>
    <?php
};

$enabled = filter_var($this->getData('enabled') ?? true, FILTER_VALIDATE_BOOLEAN);
if (!$enabled) {
    $renderEmptyShell((string) __('快捷支付已关闭。'));
    return;
}

$isPreviewMode = (bool) ($this->getData('preview_mode') ?? false)
    || (bool) ($this->getData('editor_mode') ?? false);
$offer = [];
try {
    $offer = StorefrontOfferResolver::resolve($this);
} catch (\Throwable) {
    $offer = [];
}
$quoteOnly = !empty($offer['quote_only']);
if ($quoteOnly) {
    $renderEmptyShell((string) __('该商品仅支持询价，暂无快捷支付。'));
    return;
}
$sellable = !empty($offer['sellable']) || $isPreviewMode;
$offerUuid = trim((string) ($offer['global_offer_uuid'] ?? ''));
$productId = max(0, (int) ($offer['product_id'] ?? $this->getData('card_product_id') ?? 0));

$hint = (string) __('使用支付商账户直接付款，地址可由支付商带回');
$moreLabel = (string) __('更多支付说明');
$defaultLogoRef = 'Weline_Payment::img/payment/paypal-express.svg';
$logoFileHtml = trim((string) ($this->getData('logo_file_html') ?? ''));
$logoRaw = LegacyMediaUrl::sanitize($this->getData('logo') ?? '');
$iconResolver = ObjectManager::getInstance(PaymentMethodIconResolver::class);

$expressMethods = [];
try {
    $facade = ObjectManager::getInstance(PaymentExpressFacadeInterface::class);
    if (!$facade instanceof PaymentExpressFacadeInterface) {
        $facade = new ExpressCheckoutOrchestrator();
    }
    $expressMethods = $facade->listExpressMethods([]);
} catch (\Throwable) {
    $expressMethods = [];
}
// Keep a visible slot shell when required injection is present but no method is ready.
// Empty early-return made the whole express region vanish (looked like widget loss).
if ($expressMethods === []) {
    $renderEmptyShell((string) __('快捷支付暂不可用，请使用上方加入购物车或立即结账。'));
    return;
}

if ($logoFileHtml === '' && $logoRaw === '') {
    try {
        $logoRaw = trim((string) ObjectManager::getInstance(ConfigStore::class)->getConfig(
            'payment/method/paypal/express_logo',
            'Weline_Payment',
            ConfigStore::area_BACKEND,
            ''
        ));
    } catch (\Throwable) {
        $logoRaw = '';
    }
}
?>
<section class="w-payment-express w-payment-express--pdp w-payment-express--collapsible <?= $esc($wc) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-testid="product-express-payment"
         data-payment-express
         data-product-express
         data-weline-load="productExpressPay"
         data-method-code="<?= $esc($configMethod) ?>"
         data-product-id="<?= (int) $productId ?>"
         data-global-offer-uuid="<?= $esc($offerUuid) ?>"
         data-checkout-base="@url{'checkout'}">
    <?php /* PayPal 等快捷按钮始终展示；说明文案默认收起，底部居中箭头展开 */ ?>
    <div class="w-payment-express__methods w-payment-express__methods--always" role="group" aria-label="<?= $esc($title) ?>">
        <?php foreach ($expressMethods as $method):
            $code = strtolower(trim((string) ($method['method_code'] ?? '')));
            if ($code === '') {
                continue;
            }
            $label = trim((string) ($method['title'] ?? $code)) ?: $code;
            $btnLogoHtml = ($code === 'paypal') ? $logoFileHtml : '';
            $btnLogoRaw = '';
            if ($btnLogoHtml === '') {
                if ($code === 'paypal' && $logoRaw !== '') {
                    $btnLogoRaw = $logoRaw;
                } elseif ($code === 'paypal') {
                    $btnLogoRaw = $defaultLogoRef;
                } else {
                    $btnLogoRaw = trim((string) ($method['icon_url'] ?? ''));
                }
            }
            $btnLogoUrl = $btnLogoRaw !== '' ? $iconResolver->toPublicUrl($btnLogoRaw) : '';
            $isPaypal = $code === 'paypal';
            ?>
        <button type="button"
                class="w-payment-express__btn<?= $isPaypal ? ' w-payment-express__paypal' : '' ?> weline-pixel::express_pay"
                data-express-pay
                data-product-express-pay
                data-pixel-event="express_pay"
                data-method-code="<?= $esc($code) ?>"
                data-method-label="<?= $esc((string) __('使用 %{1} 快捷支付', [$label])) ?>"
                data-product-id="<?= (int) $productId ?>"
                data-testid="product-express-<?= $esc($code) ?>"
                aria-label="<?= $esc((string) __('使用 %{1} 快捷支付', [$label])) ?>"
                <?= ($sellable || $isPreviewMode) ? '' : 'disabled' ?>>
            <?php if ($btnLogoHtml !== ''): ?>
                <span class="w-payment-express__logo" aria-hidden="true"><?= $btnLogoHtml ?></span>
            <?php elseif ($btnLogoUrl !== ''): ?>
                <img class="w-payment-express__logo-img"
                     src="<?= $esc($btnLogoUrl) ?>"
                     alt="<?= $esc($label) ?>"
                     width="90"
                     height="24"
                     decoding="async" />
            <?php else: ?>
                <span class="w-payment-express__paypal-mark" aria-hidden="true"><?= $esc($label) ?></span>
            <?php endif; ?>
        </button>
        <?php endforeach; ?>
    </div>
    <details class="w-payment-express__disclosure">
        <summary class="w-payment-express__summary w-payment-express__summary--more"
                 aria-label="<?= $esc($moreLabel) ?>">
            <span class="w-payment-express__more-label"><?= $esc($moreLabel) ?></span>
            <span class="w-payment-express__chevron" aria-hidden="true"></span>
        </summary>
        <div class="w-payment-express__panel">
            <p class="w-payment-express__hint"><?= $esc($hint) ?></p>
        </div>
    </details>
</section>
