    --express-gap: var(--weline-space-3, var(--space-3, 0.75rem));
    --express-paypal-bg: #ffc439;
    --express-paypal-bg-hover: #f2bb36;
    --express-text: var(--color-text-primary, #0f1111);
    --express-btn-min: 148px;
    --express-btn-max: 200px;
    margin-block: var(--express-gap);
    padding: var(--express-gap);
    border: 1px solid var(--color-border-subtle, rgba(15, 17, 17, 0.12));
    border-radius: var(--radius-3, 0.5rem);
    background: var(--color-surface-raised, var(--color-bg, #fff));
}
.w-payment-express--pdp .w-payment-express__header {
    margin-bottom: var(--weline-space-2, var(--space-2, 0.5rem));
}
.w-payment-express--pdp .w-payment-express__title {
    margin: 0;
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 600;
    color: var(--color-text-primary, inherit);
}
.w-payment-express--pdp .w-payment-express__hint {
    margin: 0.25rem 0 0;
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #565959);
}
.w-payment-express--pdp .w-payment-express__methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--express-btn-min), var(--express-btn-max)));
    gap: var(--weline-space-2, var(--space-2, 0.5rem));
    justify-content: center;
}
.w-payment-express--pdp .w-payment-express__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: var(--radius-2, 0.375rem);
    cursor: pointer;
    background: var(--color-surface-muted, #f0f2f2);
    color: var(--express-text);
}
.w-payment-express--pdp .w-payment-express__paypal {
    background: var(--express-paypal-bg);
}
.w-payment-express--pdp .w-payment-express__paypal:hover:not(:disabled) {
    background: var(--express-paypal-bg-hover);
}
.w-payment-express--pdp .w-payment-express__btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}
.w-payment-express--pdp .w-payment-express__logo-img {
    max-height: 24px;
    width: auto;
}
</style>
