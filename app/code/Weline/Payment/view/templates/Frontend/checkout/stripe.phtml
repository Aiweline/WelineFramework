<?php
/** @var \Weline\Framework\View\Template $this */

$esc = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$redirectUrl = trim((string)$this->getData('redirect_url'));
?>
<section class="weline-payment-stripe" weline-code="payment.checkout.stripe">
    <header class="weline-payment-stripe__header">
        <h2><?= __('Stripe') ?></h2>
        <p><?= __('使用 Stripe Checkout 完成卡与本地支付方式。') ?></p>
    </header>

    <?php if ($redirectUrl !== ''): ?>
        <div class="weline-payment-stripe__action">
            <a class="w-button" data-tone="primary" href="<?= $esc($redirectUrl) ?>">
                <?= __('Continue to Stripe') ?>
            </a>
        </div>
    <?php else: ?>
        <div class="w-alert" data-tone="info">
            <?= __('Stripe Checkout will open after you confirm payment.') ?>
        </div>
    <?php endif; ?>
</section>

