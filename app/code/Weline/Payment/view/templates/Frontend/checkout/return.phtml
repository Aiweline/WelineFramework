<?php if ($paymentSuccessTerminal && $transactionNo !== ''): ?>
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof window.WelinePixel === 'undefined') {
        return;
    }
    var dedupeKey = 'weline_pixel_dedupe:payment_success:' + <?= json_encode($transactionNo, JSON_UNESCAPED_UNICODE) ?>;
    try {
        if (window.sessionStorage.getItem(dedupeKey)) {
            return;
        }
    } catch (e) {}
    window.WelinePixel.track('payment_success', {
        transaction_id: <?= json_encode($transactionNo, JSON_UNESCAPED_UNICODE) ?>,
        value: <?= json_encode($pixelValue, JSON_UNESCAPED_UNICODE) ?>,
        currency: <?= json_encode($pixelCurrency, JSON_UNESCAPED_UNICODE) ?>,
        payment_method: <?= json_encode($paymentMethodLabel, JSON_UNESCAPED_UNICODE) ?>
    });
    try {
        window.sessionStorage.setItem(dedupeKey, '1');
    } catch (e) {}
});
</script>
<?php endif; ?>
