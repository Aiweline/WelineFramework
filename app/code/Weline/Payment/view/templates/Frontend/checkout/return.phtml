            <div class="weline-payment-return__facts">
                <div>
                    <span class="weline-payment-return__fact-label"><?= htmlspecialchars((string) __('交易号'), ENT_QUOTES, 'UTF-8') ?></span>
                    <span class="weline-payment-return__fact-value"><?= htmlspecialchars((string) $transaction->getData('transaction_no'), ENT_QUOTES, 'UTF-8') ?></span>
                </div>
                <div>
                    <span class="weline-payment-return__fact-label"><?= htmlspecialchars((string) __('支付金额'), ENT_QUOTES, 'UTF-8') ?></span>
                    <span class="weline-payment-return__fact-value">
                        <?= htmlspecialchars((string) $transaction->getData('amount'), ENT_QUOTES, 'UTF-8') ?>
                        <?= htmlspecialchars((string) $transaction->getData('currency'), ENT_QUOTES, 'UTF-8') ?>
                    </span>
                </div>
            </div>
        <?php else: ?>
            <div class="weline-payment-return__badge weline-payment-return__badge--danger" aria-hidden="true">
