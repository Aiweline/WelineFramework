        <w:hook>Weline_Payment::frontend::checkout::payment-result</w:hook>

        <div class="weline-payment-return__actions">
            <a class="weline-payment-return__btn" href="@url{'/'}"><?= htmlspecialchars((string) __('返回首页'), ENT_QUOTES, 'UTF-8') ?></a>
        </div>
    </section>
