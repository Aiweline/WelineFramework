            </div>
            <h1 class="weline-payment-return__title"><?= htmlspecialchars((string) __('支付失败'), ENT_QUOTES, 'UTF-8') ?></h1>
            <p class="weline-payment-return__lead"><?= htmlspecialchars((string) __('支付未完成，请重试'), ENT_QUOTES, 'UTF-8') ?></p>
