<?php
/** @var \Weline\Framework\View\Template $this */

$entries = (array) ($this->getData('payment_guide_entries') ?? []);
$subtitle = (string) ($this->getData('payment_guide_page_subtitle') ?? '');
$escape = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>

<?php echo $this->fetch('Weline_Payment::templates/Frontend/guide/payment/partials/amazon-shell-open.phtml'); ?>
<?php echo $this->fetch('Weline_Payment::templates/Frontend/guide/payment/partials/amazon-sidebar.phtml'); ?>

<section class="amazon-payment-guide-layout__main amazon-payment-guide-listing" data-testid="payment-guide-hub" weline-code="payment.guide.hub">
    <header class="amazon-payment-guide-listing__header">
        <h1 class="amazon-payment-guide-listing__title"><lang>支付方式指南</lang></h1>
        <?php if ($subtitle !== ''): ?>
            <p class="amazon-payment-guide-listing__subtitle"><?= $escape($subtitle) ?></p>
        <?php else: ?>
            <p class="amazon-payment-guide-listing__subtitle"><lang>查看各支付供应商的客户支付指南、支付政策与用户协议。</lang></p>
        <?php endif; ?>
        <p class="amazon-payment-guide-listing__meta">
            <lang args="[(string) count($entries)]">共 %{1} 个支付供应商</lang>
        </p>
    </header>

    <?php if ($entries === []): ?>
        <div class="amazon-payment-guide-listing__empty">
            <p><lang>当前暂无已接入的支付供应商指南。</lang></p>
        </div>
    <?php else: ?>
        <div class="amazon-payment-guide-listing__grid" data-testid="payment-guide-grid">
            <?php foreach ($entries as $entry): ?>
                <?php
                if (!is_array($entry)) {
                    continue;
                }
                $title = (string) ($entry['title'] ?? '');
                $summary = (string) ($entry['summary'] ?? '');
                $guideRoute = (string) ($entry['guide_route'] ?? '');
                $policyRoute = (string) ($entry['policy_route'] ?? '');
                $agreementRoute = (string) ($entry['agreement_route'] ?? '');
                $providerCode = strtoupper((string) ($entry['provider_code'] ?? ''));
                ?>
                <article class="amazon-payment-guide-card" data-testid="payment-guide-card">
                    <?php if ($providerCode !== ''): ?>
                        <span class="amazon-payment-guide-card__badge"><?= $escape($providerCode) ?></span>
                    <?php endif; ?>
                    <h2 class="amazon-payment-guide-card__title"><?= $escape($title) ?></h2>
                    <p class="amazon-payment-guide-card__summary"><?= $escape($summary) ?></p>
                    <div class="amazon-payment-guide-card__actions">
                        <a class="amazon-payment-guide-card__link" href="@url{$guideRoute}">
                            <lang>查看支付指南</lang>
                        </a>
                        <a class="amazon-payment-guide-card__link amazon-payment-guide-card__link--muted" href="@url{$policyRoute}">
                            <lang>查看支付政策</lang>
                        </a>
                        <a class="amazon-payment-guide-card__link amazon-payment-guide-card__link--muted" href="@url{$agreementRoute}">
                            <lang>查看用户协议</lang>
                        </a>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>
<?php echo $this->fetch('Weline_Payment::templates/Frontend/guide/payment/partials/amazon-shell-close.phtml'); ?>
