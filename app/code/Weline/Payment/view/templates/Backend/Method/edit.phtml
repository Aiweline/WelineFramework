                <pre class="rounded-2" data-w-background="muted" data-w-border="border" style="--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);--w-mb:0;"><code><?= $h($json($runtimeConfig)) ?></code></pre>

