<?php
/**
 * 支付方式只读详情页。
 *
 * 普通 key/value 配置由 Weline_SystemConfig 统一保存；本页只展示 Provider 元数据和跳转入口。
 */
$scope = $this->getData('scope') ?? ['scope' => 'default.default.default', 'environment' => 'sandbox'];
$metadata = is_array($this->getData('metadata')) ? $this->getData('metadata') : [];
$runtimeConfig = is_array($this->getData('runtimeConfig')) ? $this->getData('runtimeConfig') : [];
$configFields = is_array($this->getData('configFields')) ? $this->getData('configFields') : [];
$methodCode = (string)$method->getData('code');
$providerModule = (string)$method->getData('provider_module');
$configModule = $providerModule !== '' ? $providerModule : 'Weline_Payment';
$storageScope = (string)($scope['scope'] ?? 'default.default.default');
$methodEnvironment = strtolower(trim((string)($runtimeConfig['environment'] ?? 'sandbox')));
if ($methodEnvironment !== 'live') {
    $methodEnvironment = 'sandbox';
}
$configUrl = \Weline\Framework\Manager\ObjectManager::getInstance(
    \Weline\Payment\Service\PaymentMethodConfigDeepLinkBuilder::class
)->build($methodCode, $storageScope, ['module' => $configModule]);
$backUrl = $this->getUrl('*/backend/method/index', [
    'target_scope' => $target_scope ?? $storageScope,
]);
$h = static function (mixed $value): string {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$json = static function (mixed $value): string {
    return json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) ?: '{}';
};
?>
