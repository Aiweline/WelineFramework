                </div>

                <?php if ($configFields !== []): ?>
                    <h5 style="--w-mt:var(--weline-space-6);--w-mb:var(--weline-space-4);"><?= __('Provider 动态字段') ?></h5>
                    <div class="w-table-wrap">
                        <table class="w-table" data-w-vertical="middle">
                            <thead>
                            <tr>
                                <th><?= __('代码') ?></th>
                                <th><?= __('类型') ?></th>
                                <th><?= __('是否必填') ?></th>
                                <th><?= __('说明') ?></th>
                            </tr>
                            </thead>
                            <tbody>
                            <?php foreach ($configFields as $fieldName => $fieldConfig): ?>
                                <?php $fieldConfig = is_array($fieldConfig) ? $fieldConfig : []; ?>
                                <tr>
                                    <td><code><?= $h($fieldConfig['key'] ?? $fieldName) ?></code></td>
                                    <td><?= $h($fieldConfig['type'] ?? 'text') ?></td>
                                    <td><?= !empty($fieldConfig['required']) ? __('是') : __('否') ?></td>
