                </h4>
                <a href="<?= $h($configUrl) ?>" class="w-button" data-tone="primary" data-testid="payment-method-config-deeplink" target="_blank" rel="noopener noreferrer">
                    <w:icon name="settings" size="sm"></w:icon><?= __('配置深度链接') ?>
                </a>
            </div>
            <div class="w-card__body">
