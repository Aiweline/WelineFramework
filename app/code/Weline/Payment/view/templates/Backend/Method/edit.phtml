                            <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= __('支付方式名称') ?></div>
                            <div class="w-text" data-weight="strong"><?= $h($method->getData('name')) ?></div>
