 */
$listTargetScope = (string)($target_scope ?? 'default.default.default');
$expectedGrantVersion = (int)($expected_grant_version ?? 0);
$canReorder = !empty($can_reorder_methods);
$listScopeContext = \is_array($list_scope_context ?? null)
    ? $list_scope_context
    : [
        'scope' => $listTargetScope === 'global' ? 'default.default.default' : $listTargetScope,
        'environment' => 'sandbox',
    ];
$colspan = $canReorder ? 8 : 7;
?>
<div class="w-grid" data-testid="payment-method-management" data-target-scope="<?= htmlspecialchars($listTargetScope, ENT_QUOTES) ?>">
    <div style="--w-span:12;">
        <div class="w-card">
            <?php if (!empty($can_register_providers)): ?>
                <div class="w-card__header">
                    <div class="w-cluster" data-align="center" data-justify="end" style="--w-gap:var(--weline-space-2);">
                        <button type="button" class="w-button" id="payment-method-sync-providers" data-testid="payment-method-sync-providers" data-target-scope="<?= htmlspecialchars($listTargetScope, ENT_QUOTES) ?>" data-grant-version="<?= $expectedGrantVersion ?>" data-tone="primary" data-size="sm">
                            <w:icon name="refresh" size="sm"></w:icon><?= __('同步支付提供商') ?>
                        </button>
                    </div>
                </div>
            <?php endif; ?>
            <div class="w-card__body">
                <?php if ($canReorder): ?>
                    <p class="w-text" data-tone="muted" data-size="sm" style="margin-block-end:var(--weline-space-3);" data-testid="payment-method-sort-hint">
                        <?= __('拖拽左侧手柄调整顺序；排序仅对当前 Scope 生效，结账页按此顺序展示支付方式。') ?>
                        <span data-testid="payment-method-sort-scope"><?= htmlspecialchars($listTargetScope, ENT_QUOTES) ?></span>
                    </p>
                <?php endif; ?>
                <div class="w-table-wrap">
                    <table class="w-table">
                        <thead>
                            <tr>
                                <?php if ($canReorder): ?>
                                    <th style="inline-size:2.5rem;"><?= __('拖拽') ?></th>
                                <?php endif; ?>
                                <th><?= __('图标') ?></th>
                                <th><?= __('支付方式代码') ?></th>
                                <th><?= __('支付方式名称') ?></th>
                                <th><?= __('支付提供商') ?></th>
                                <th><?= __('是否启用') ?></th>
                                <th><?= __('排序') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody id="payment-method-sort-list"
                               data-testid="payment-method-sort-list"
                               data-target-scope="<?= htmlspecialchars($listTargetScope, ENT_QUOTES) ?>"
                               data-grant-version="<?= $expectedGrantVersion ?>"
                               data-can-reorder="<?= $canReorder ? '1' : '0' ?>">
                            <?php if (empty($methods)): ?>
                                <tr>
                                    <td colspan="<?= $colspan ?>" class="w-text" data-align="center" data-tone="muted">
                                        <?= __('暂无支付方式') ?>
                                    </td>
                                </tr>
                            <?php else: ?>
                                <?php
                                /** @var \Weline\Payment\Service\PaymentMethodConfigDeepLinkBuilder $configDeepLinkBuilder */
                                $configDeepLinkBuilder = \Weline\Framework\Manager\ObjectManager::getInstance(
                                    \Weline\Payment\Service\PaymentMethodConfigDeepLinkBuilder::class
                                );
                                /** @var \Weline\Payment\Service\PaymentMethodManager $methodManager */
                                $methodManager = \Weline\Framework\Manager\ObjectManager::getInstance(
                                    \Weline\Payment\Service\PaymentMethodManager::class
                                );
                                ?>
                                <?php foreach ($methods as $method): ?>
                                    <?php
                                    $methodCode = (string)$method->getData('code');
                                    $providerModule = (string)$method->getData('provider_module');
                                    if ($providerModule === '') {
                                        $providerModule = 'Weline_Payment';
                                    }
                                    $configDeepLink = $configDeepLinkBuilder->build(
                                        $methodCode,
                                        $listTargetScope,
                                        ['module' => $providerModule],
                                    );
                                    $display = $methodManager->getEffectiveDisplayMetadata($method, $listScopeContext);
                                    $iconUrl = (string)($display['icon_url'] ?? '');
                                    $scopedSort = $methodManager->getScopedSortOrder($method, $listScopeContext);
                                    $enabledField = 'payment/method/' . $methodCode . '/enabled';
                                    $embedModule = $providerModule;
                                    $embedField = $enabledField;
                                    ?>
                                    <tr class="payment-method-sort-row"
                                        data-method-code="<?= htmlspecialchars($methodCode, ENT_QUOTES, 'UTF-8') ?>"
                                        <?php if ($canReorder): ?>draggable="true"<?php endif; ?>>
                                        <?php if ($canReorder): ?>
                                            <td class="payment-method-sort-handle"
                                                data-testid="payment-method-sort-handle"
                                                style="cursor:grab;user-select:none;text-align:center;"
                                                title="<?= htmlspecialchars((string)__('拖拽排序'), ENT_QUOTES) ?>">
                                                <w:icon name="menu" size="sm"></w:icon>
                                            </td>
                                        <?php endif; ?>
                                        <td>
                                            <?php if ($iconUrl !== ''): ?>
                                                <img src="<?= htmlspecialchars($iconUrl, ENT_QUOTES, 'UTF-8') ?>"
                                                     alt="<?= htmlspecialchars((string)$method->getData('name'), ENT_QUOTES, 'UTF-8') ?>"
                                                     width="48"
                                                     height="32"
                                                     style="object-fit:contain;max-inline-size:48px;max-block-size:32px;"
                                                     data-testid="payment-method-icon"
                                                     data-method-code="<?= htmlspecialchars($methodCode, ENT_QUOTES, 'UTF-8') ?>"
                                                     draggable="false">
                                            <?php else: ?>
                                                <span class="w-text" data-tone="muted" data-size="sm">—</span>
                                            <?php endif; ?>
                                        </td>
                                        <td><?= htmlspecialchars($methodCode) ?></td>
                                        <td><?= htmlspecialchars($method->getData('name')) ?></td>
                                        <td><?= htmlspecialchars($providerModule) ?></td>
                                        <td>
                                            <w:config:embed
                                                module="embedModule"
                                                field="embedField"
                                                area="backend"
                                                layout="inline"
                                            />
                                        </td>
                                        <td class="payment-method-sort-value"
                                            data-testid="payment-method-sort-value"
                                            data-method-code="<?= htmlspecialchars($methodCode, ENT_QUOTES, 'UTF-8') ?>">
                                            <?= (int)$scopedSort ?>
                                        </td>
                                        <td>
                                            <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                                                <a href="<?= htmlspecialchars($this->getUrl('*/backend/method/edit', [
                                                    'code' => $methodCode,
                                                    'target_scope' => $target_scope,
                                                ]), ENT_QUOTES, 'UTF-8') ?>" class="w-button" data-tone="primary" data-size="sm">
                                                    <w:icon name="eye" size="sm"></w:icon> <?= __('查看配置') ?>
                                                </a>
                                                <a href="<?= htmlspecialchars($configDeepLink, ENT_QUOTES, 'UTF-8') ?>"
                                                   class="w-button"
                                                   data-tone="neutral"
                                                   data-variant="outline"
                                                   data-size="sm"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   data-testid="payment-method-config-deeplink"
                                                   data-method-code="<?= htmlspecialchars($methodCode, ENT_QUOTES, 'UTF-8') ?>">
                                                    <w:icon name="settings" size="sm"></w:icon> <?= __('配置深度链接') ?>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.payment-method-sort-row.is-dragging { opacity: 0.55; }
.payment-method-sort-row.is-drop-target > td { box-shadow: inset 0 2px 0 var(--weline-color-primary, #3b82f6); }
</style>

<script>
(function () {
    'use strict';

    function initSyncProviders() {
        var button = document.getElementById('payment-method-sync-providers');
        if (!button) return;
        button.addEventListener('click', function () {
            button.disabled = true;
            button.dataset.state = 'pending';
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                .then(function (api) {
                    return api.resource('payment').registerProviders({
                        target_scope: button.dataset.targetScope,
                        expected_grant_version: button.dataset.grantVersion
                    });
                })
                .then(function (data) {
                    if (!data || data.success === false) throw new Error((data && data.message) || 'provider_sync_failed');
                    button.dataset.state = 'success';
                    button.dataset.registered = String(data.providers_registered || 0);
                    if (typeof Weline.UI.toast !== 'undefined') Weline.UI.toast.success('<?= __('支付提供商同步成功') ?>');
                })
                .catch(function (error) {
                    button.dataset.state = 'error';
                    console.error('Payment provider sync failed:', error);
                    if (typeof Weline.UI.toast !== 'undefined') Weline.UI.toast.error('<?= __('支付提供商同步失败') ?>');
                })
                .finally(function () { button.disabled = false; });
        });
    }

    function initDragSort() {
        var list = document.getElementById('payment-method-sort-list');
        if (!list || list.dataset.canReorder !== '1') return;

        var dragging = null;
        var saveTimer = null;
        var saving = false;

        function rows() {
            return Array.prototype.slice.call(list.querySelectorAll('tr.payment-method-sort-row'));
        }

        function orderedCodes() {
            return rows().map(function (row) { return row.dataset.methodCode || ''; }).filter(Boolean);
        }

        function applySortValues(map) {
            if (!map || typeof map !== 'object') return;
            rows().forEach(function (row) {
                var code = row.dataset.methodCode || '';
                var cell = row.querySelector('.payment-method-sort-value');
                if (cell && Object.prototype.hasOwnProperty.call(map, code)) {
                    cell.textContent = String(map[code]);
                }
            });
        }

        function persistOrder() {
            if (saving) return;
            saving = true;
            list.dataset.sortState = 'pending';
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                .then(function (api) {
                    return api.resource('payment').reorderPaymentMethods({
                        target_scope: list.dataset.targetScope,
                        expected_grant_version: list.dataset.grantVersion,
                        ordered_codes: orderedCodes()
                    });
                })
                .then(function (data) {
                    if (!data || data.success === false) {
                        throw new Error((data && data.message) || 'reorder_failed');
                    }
                    applySortValues(data.sort_orders || {});
                    list.dataset.sortState = 'success';
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.success(data.message || '<?= __('支付方式排序已保存') ?>');
                    }
                })
                .catch(function (error) {
                    list.dataset.sortState = 'error';
                    console.error('Payment method reorder failed:', error);
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.error('<?= __('支付方式排序保存失败') ?>');
                    }
                })
                .finally(function () { saving = false; });
        }

        function schedulePersist() {
            if (saveTimer) clearTimeout(saveTimer);
            saveTimer = setTimeout(persistOrder, 280);
        }

        list.addEventListener('dragstart', function (event) {
            var row = event.target && event.target.closest ? event.target.closest('tr.payment-method-sort-row') : null;
            if (!row || !list.contains(row)) return;
            dragging = row;
            row.classList.add('is-dragging');
            if (event.dataTransfer) {
                event.dataTransfer.effectAllowed = 'move';
                try { event.dataTransfer.setData('text/plain', row.dataset.methodCode || ''); } catch (e) {}
            }
        });

        list.addEventListener('dragend', function () {
            rows().forEach(function (row) {
                row.classList.remove('is-dragging', 'is-drop-target');
            });
            dragging = null;
            schedulePersist();
        });

        list.addEventListener('dragover', function (event) {
            event.preventDefault();
            var row = event.target && event.target.closest ? event.target.closest('tr.payment-method-sort-row') : null;
            if (!dragging || !row || row === dragging) return;
            rows().forEach(function (r) { r.classList.toggle('is-drop-target', r === row); });
            var rect = row.getBoundingClientRect();
            var before = (event.clientY - rect.top) < (rect.height / 2);
            if (before) {
                list.insertBefore(dragging, row);
            } else {
                list.insertBefore(dragging, row.nextSibling);
            }
        });

        list.addEventListener('drop', function (event) {
            event.preventDefault();
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        initSyncProviders();
        initDragSort();
    });
})();
</script>
