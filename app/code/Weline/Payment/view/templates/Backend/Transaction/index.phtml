<script>
(function() {
    'use strict';
    
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.weline-payment-query-status').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-id');
                var grantVersion = this.getAttribute('data-grant-version');
                
                Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                .then(function(api){
                    return api.resource('payment').queryTransactionStatus({
                        id: id,
                        expected_grant_version: grantVersion
                    });
                })
                .then(function(data) {
                    if (data && data.success !== false) {
                        if (typeof Weline.UI.toast !== 'undefined') {
                            Weline.UI.toast.success((data && data.message) || '<?= __('查询成功') ?>');
                        }
                        setTimeout(function() { location.reload(); }, 1500);
                    } else {
                        if (typeof Weline.UI.toast !== 'undefined') {
                            Weline.UI.toast.error((window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError({response:{data:data}}, '<?= __('查询失败') ?>')) || '<?= __('查询失败') ?>');
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.error((window.Weline.ApiBusiness && window.Weline.ApiBusiness.formatApiError(error, '<?= __('查询失败，请重试') ?>')) || '<?= __('查询失败，请重试') ?>');
                    }
                });
            });
        });
    });
})();
</script>
