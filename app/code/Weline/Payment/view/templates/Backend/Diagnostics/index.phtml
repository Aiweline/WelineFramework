<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('支付诊断'));
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static fn(mixed $value): string => is_bool($value) ? ($value ? (string)__('是') : (string)__('否')) : $escape($value);
?>
<section data-testid="payment-<?= $escape($code) ?>-management">
    <div class="w-backend-page__heading"><h4><?= $escape($title) ?></h4></div>
    <div class="w-alert" role="status" data-tone="info"><?= __('此工作台仅显示脱敏支付事实，不触发真实资金、修复或退款动作。') ?></div>
    <?php foreach ($datasets as $dataset): ?><div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__header"><?= $escape($dataset['label'] ?? '') ?></div><div class="w-card__body">
        <?php if (!empty($dataset['error'])): ?><div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div><?php elseif (empty($dataset['rows'])): ?><div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div><?php else: ?><div class="w-table-wrap"><table class="w-table"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody><?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
