$reconciliationMetrics = $reconciliation['metrics'] ?? [];
$reconciliationByCode = $reconciliationMetrics['diff_by_code'] ?? [];

$escape = static function (mixed $value): string {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$countValue = static function (mixed $value): string {
    return number_format((int)$value);
};
$rateValue = static function (mixed $value): string {
    return number_format((float)$value, 2) . '%';
};
$amountList = static function (array $amounts) use ($escape): string {
    if ($amounts === []) {
        return '-';
    }

    $items = [];
    foreach ($amounts as $currency => $amount) {
        $items[] = $escape($currency) . ' ' . number_format((float)$amount, 2);
    }

    return implode('<br>', $items);
};
