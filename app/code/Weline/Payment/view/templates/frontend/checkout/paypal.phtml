<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\Manager\ObjectManager;
use Weline\Payment\Service\PayPalJsSdkUrlBuilder;
use Weline\SystemConfig\Api\ConfigStore;

$esc = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$redirectUrl = trim((string)$this->getData('redirect_url'));

$googleOn = true;
$appleOn = true;
$sdkSrc = '';
try {
    $store = ObjectManager::getInstance(ConfigStore::class);
    $googleRaw = $store->getConfig(
        'payment/method/paypal/google_pay_enabled',
        'Weline_Payment',
        ConfigStore::area_BACKEND,
        '1'
    );
    $appleRaw = $store->getConfig(
        'payment/method/paypal/apple_pay_enabled',
        'Weline_Payment',
        ConfigStore::area_BACKEND,
        '1'
    );
    $googleOn = !($googleRaw === false || $googleRaw === 0 || $googleRaw === '0' || $googleRaw === '');
    $appleOn = !($appleRaw === false || $appleRaw === 0 || $appleRaw === '0' || $appleRaw === '');
    $env = strtolower(trim((string) $store->getConfig(
        'payment/method/paypal/environment',
        'Weline_Payment',
        ConfigStore::area_BACKEND,
        'sandbox'
    )));
    $clientIdKey = $env === 'live'
        ? 'payment/method/paypal/live_client_id'
        : 'payment/method/paypal/sandbox_client_id';
    $clientId = trim((string) $store->getConfig(
        $clientIdKey,
        'Weline_Payment',
        ConfigStore::area_BACKEND,
        ''
    ));
    $currency = trim((string) $store->getConfig(
        'payment/method/paypal/default_currency',
        'Weline_Payment',
        ConfigStore::area_BACKEND,
        'USD'
    )) ?: 'USD';
    $sdkSrc = (new PayPalJsSdkUrlBuilder())->build([
        'client_id' => $clientId,
        'environment' => $env,
        'google_pay_enabled' => $googleOn,
        'apple_pay_enabled' => $appleOn,
        'default_currency' => $currency,
    ], ['currency' => $currency]);
} catch (\Throwable) {
    // 配置不可用时仍渲染 redirect CTA
}
$showWallet = $sdkSrc !== '' && ($googleOn || $appleOn);
?>
<section class="weline-payment-paypal" weline-code="payment.checkout.paypal"
         data-testid="payment-checkout-paypal"
         data-paypal-google-pay="<?= $googleOn ? '1' : '0' ?>"
         data-paypal-apple-pay="<?= $appleOn ? '1' : '0' ?>"
         <?php if ($sdkSrc !== ''): ?>data-paypal-sdk-src="<?= $esc($sdkSrc) ?>"<?php endif; ?>>
    <header class="weline-payment-paypal__header">
        <h2><?= __('PayPal') ?></h2>
        <p><?= __('使用 PayPal 账户或卡完成支付。支持 Google Pay / Apple Pay（可在后台关闭）。') ?></p>
    </header>

    <?php if ($showWallet): ?>
        <div class="weline-payment-paypal__wallets"
             data-testid="paypal-wallet-buttons"
             data-weline-load="paypalWalletButtons"
             data-paypal-sdk-src="<?= $esc($sdkSrc) ?>">
            <div id="paypal-button-container" class="weline-payment-paypal__buttons"></div>
            <p class="weline-payment-paypal__wallet-hint"><?= __('若设备支持，将显示 Google Pay / Apple Pay。也可继续使用下方 PayPal 跳转。') ?></p>
        </div>
    <?php endif; ?>

    <?php if ($redirectUrl !== ''): ?>
        <div class="weline-payment-paypal__action">
            <a class="w-button" data-tone="primary" href="<?= $esc($redirectUrl) ?>">
                <?= __('Continue to PayPal') ?>
            </a>
        </div>
    <?php else: ?>
        <div class="w-alert" data-tone="info">
            <?= __('PayPal checkout will open after you confirm payment.') ?>
        </div>
    <?php endif; ?>
</section>

<style>
.weline-payment-paypal {
    box-sizing: border-box;
    display: grid;
    gap: 16px;
    padding: 16px 0;
}
.weline-payment-paypal__header h2 {
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 6px;
}
.weline-payment-paypal__header p {
    color: #57606a;
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
}
.weline-payment-paypal__wallet-hint {
    color: #57606a;
    font-size: 13px;
    margin: 8px 0 0;
}
.weline-payment-paypal__buttons {
    min-height: 40px;
}
</style>
