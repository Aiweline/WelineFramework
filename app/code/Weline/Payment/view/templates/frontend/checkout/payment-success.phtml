<?php
/** L1 支付成功终端页（与 L3 共用 amz-order-confirm 视觉壳） */
$transaction = $transaction ?? null;
$paymentMethodLabel = trim((string) ($payment_method_label ?? ''));
$paymentPaidAtLabel = trim((string) ($payment_paid_at_label ?? ''));
$orderV2DisplayNumber = trim((string) ($order_v2_display_number ?? ''));
$transactionNo = $transaction ? (string) $transaction->getData('transaction_no') : '';
$transactionAmountLabel = '';
if ($transaction) {
    $transactionAmountLabel = trim(sprintf(
        '%s %s',
        (string) $transaction->getData('amount'),
        (string) $transaction->getData('currency')
    ));
}
$escape = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$pixelValue = $transaction ? (string) $transaction->getData('amount') : '';
$pixelCurrency = $transaction ? (string) $transaction->getData('currency') : '';
?>
<main class="amz-order-confirm amz-order-confirm--success weline-pixel::payment_success"
      weline-code="payment.checkout_success_l1"
      data-testid="payment-success"
      data-weline-load="cart,paymentLifecycle,paymentPixel"
    data-payment-lifecycle="paid"
    data-payment-outcome="paid"
    data-payment-event-source="payment-success-page"
    data-pixel-event="payment_success"
    data-transaction-id="<?= $escape($transactionNo) ?>"
    data-pixel-value="<?= $escape($pixelValue) ?>"
    data-pixel-currency="<?= $escape($pixelCurrency) ?>">
    <header class="amz-order-confirm__banner">
        <div class="amz-order-confirm__banner-inner">
            <span class="amz-order-confirm__check" aria-hidden="true">✓</span>
            <div class="amz-order-confirm__banner-copy">
                <h1><lang>支付成功</lang></h1>
                <p><lang>您的支付已完成。</lang></p>
                <?php if ($transactionNo !== ''): ?>
                    <p class="amz-order-confirm__order-no">
                        <lang>交易号</lang>：
                        <strong><?= $escape($transactionNo) ?></strong>
                    </p>
                <?php endif; ?>
                <?php if ($orderV2DisplayNumber !== ''): ?>
                    <p class="amz-order-confirm__order-no">
                        <lang>订单号</lang>：
                        <strong><?= $escape($orderV2DisplayNumber) ?></strong>
                    </p>
                <?php endif; ?>
            </div>
        </div>
    </header>
    <section class="amz-order-confirm__panel" weline-code="payment.checkout_success_l1.panel">
        <div class="amz-order-confirm__meta-grid">
            <div class="amz-order-confirm__meta-block">
                <h2><lang>支付信息</lang></h2>
                <?php if ($paymentMethodLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付方式</lang></span> <?= $escape($paymentMethodLabel) ?></p>
                <?php endif; ?>
                <?php if ($transactionAmountLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付金额</lang></span> <?= $escape($transactionAmountLabel) ?></p>
                <?php endif; ?>
                <?php if ($paymentPaidAtLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付时间</lang></span> <?= $escape($paymentPaidAtLabel) ?></p>
                <?php endif; ?>
            </div>
        </div>
    </section>
</main>
<?php
$paymentPixelPayload = [
    'transaction_id' => $transactionNo,
    'value' => $pixelValue,
    'currency' => $pixelCurrency,
    'payment_method' => $paymentMethodLabel,
];
$paymentPixelConfig = ['enabled' => $transactionNo !== '', 'event' => 'payment_success', 'payload' => $paymentPixelPayload];
?>
<script type="application/json" id="payment-pixel-config"><?= json_encode($paymentPixelConfig, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?></script>
