<?php
/**
 * 支付返回页面（Amazon 订单确认风格）。
 */
$transaction = $transaction ?? null;
$paymentReturnEmpty = !empty($payment_return_empty);
$paymentReturnCancelled = !empty($payment_return_cancelled);
$paymentCancelAlready = !empty($payment_cancel_already);
$orderV2 = is_array($order_v2 ?? null) ? $order_v2 : null;
$orderUuid = trim((string) ($order_uuid ?? ''));
$orderV2DisplayNumber = trim((string) ($order_v2_display_number ?? ''));
$orderV2Status = trim((string) ($order_v2_status ?? ''));
$orderV2StatusLabel = trim((string) ($order_v2_status_label ?? ''));
$orderV2TotalLabel = trim((string) ($order_v2_total_label ?? ''));
$orderV2TotalsLines = is_array($order_v2_totals_lines ?? null) ? $order_v2_totals_lines : [];
$paymentMethodLabel = trim((string) ($payment_method_label ?? ''));
$paymentPaidAtLabel = trim((string) ($payment_paid_at_label ?? ''));
$paymentSuccessTerminal = !empty($payment_success_terminal);
$isSuccess = $transaction && method_exists($transaction, 'isSuccess') && $transaction->isSuccess();
$isPending = $transaction && method_exists($transaction, 'isPending') && $transaction->isPending();
$isProcessing = $transaction && method_exists($transaction, 'isProcessing') && $transaction->isProcessing();
$orderV2StatusLabels = [
    'pending' => (string) __('待处理'),
    'processing' => (string) __('处理中'),
    'paid' => (string) __('已支付'),
    'fulfilled' => (string) __('已发货'),
    'completed' => (string) __('已完成'),
    'cancelled' => (string) __('已取消'),
    'refunded' => (string) __('已退款'),
];
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string) $value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$formatMoney = static fn(string $currency, int $minor): string => sprintf(
    '%s %s',
    $currency,
    number_format($minor / 100, 2, '.', ',')
);
if ($orderV2 !== null) {
    $orderV2DisplayNumber = $orderV2DisplayNumber !== ''
        ? $orderV2DisplayNumber
        : (string) ($orderV2['display_number'] ?? $orderV2['order_uuid'] ?? '');
    $orderV2Status = $orderV2Status !== ''
        ? $orderV2Status
        : (string) ($orderV2['status'] ?? '');
    if ($orderV2TotalLabel === '') {
        $currency = (string) ($orderV2['currency'] ?? '');
        $money = is_array($orderV2['money'] ?? null) ? $orderV2['money'] : [];
        if ($currency !== '' && array_key_exists('grand_total_minor', $money)) {
            $orderV2TotalLabel = $formatMoney($currency, (int) $money['grand_total_minor']);
        }
    }
    if ($orderUuid === '') {
        $orderUuid = trim((string) ($orderV2['order_uuid'] ?? ''));
    }
}
$orderCurrency = (string) ($orderV2['currency'] ?? ($transaction ? (string) $transaction->getData('currency') : ''));
if ($orderV2StatusLabel === '') {
    $orderV2StatusLabel = $orderV2StatusLabels[$orderV2Status] ?? $orderV2Status;
}
$orderItems = $orderV2 !== null && is_array($orderV2['items'] ?? null) ? $orderV2['items'] : [];
$orderItemsDisplay = is_array($order_v2_items_display ?? null) && $order_v2_items_display !== []
    ? $order_v2_items_display
    : $orderItems;
$transactionAmountLabel = '';
if ($transaction) {
    $transactionAmountLabel = trim(sprintf(
        '%s %s',
        (string) $transaction->getData('amount'),
        (string) $transaction->getData('currency')
    ));
}
$shipping = is_array($orderV2['shipping'] ?? null) ? $orderV2['shipping'] : [];
$shippingAddress = is_array($shipping['address'] ?? null) ? $shipping['address'] : [];
$shippingName = trim((string) ($shippingAddress['name'] ?? ''));
$shippingPhone = trim((string) ($shippingAddress['phone'] ?? ''));
$shippingEmail = trim((string) ($shippingAddress['email'] ?? ''));
$shippingMethod = trim((string) ($shipping_method_label ?? ''));
if ($shippingMethod === '') {
    $shippingMethod = trim((string) ($shipping['method'] ?? ''));
}
$shippingLines = array_values(array_filter([
    trim((string) ($shippingAddress['address'] ?? '')),
    trim((string) ($shippingAddress['address1'] ?? '')),
    trim((string) ($shippingAddress['address2'] ?? '')),
    implode(' ', array_filter([
        trim((string) ($shippingAddress['district'] ?? '')),
        trim((string) ($shippingAddress['city'] ?? '')),
        trim((string) ($shippingAddress['province'] ?? '')),
        trim((string) ($shippingAddress['postal_code'] ?? '')),
    ], static fn(string $v): bool => $v !== '')),
    trim((string) ($shippingAddress['country_code'] ?? '')),
], static fn(string $v): bool => $v !== ''));
$transactionNo = $transaction ? (string) $transaction->getData('transaction_no') : '';
$pixelValue = $transaction ? (string) $transaction->getData('amount') : '';
$pixelCurrency = $transaction ? (string) $transaction->getData('currency') : '';
if ($pixelCurrency === '' && $orderCurrency !== '') {
    $pixelCurrency = $orderCurrency;
}
$orderMoney = is_array($orderV2['money'] ?? null) ? $orderV2['money'] : [];
if ($pixelValue === '' && $orderCurrency !== '' && array_key_exists('grand_total_minor', $orderMoney)) {
    $pixelValue = number_format(((int) $orderMoney['grand_total_minor']) / 100, 2, '.', '');
}
$pixelItems = [];
foreach ($orderItemsDisplay as $pixelItemRow) {
    if (!is_array($pixelItemRow)) {
        continue;
    }
    $pid = trim((string) ($pixelItemRow['product_id'] ?? ''));
    $sku = trim((string) ($pixelItemRow['sku'] ?? ''));
    $itemId = $pid !== '' ? $pid : $sku;
    $itemName = trim((string) ($pixelItemRow['name'] ?? $pixelItemRow['product_name'] ?? $sku));
    $qty = (int) ($pixelItemRow['qty'] ?? $pixelItemRow['quantity'] ?? 0);
    if ($qty <= 0) {
        $qty = 1;
    }
    $unitMinor = (int) ($pixelItemRow['unit_price_minor'] ?? 0);
    if ($unitMinor <= 0 && isset($pixelItemRow['row_total_minor'])) {
        $unitMinor = (int) round(((int) $pixelItemRow['row_total_minor']) / $qty);
    }
    $price = $unitMinor > 0 ? round($unitMinor / 100, 2) : null;
    if ($itemId === '' && $itemName === '' && $price === null) {
        continue;
    }
    $ga4Item = [
        'item_id' => $itemId,
        'item_name' => $itemName,
        'product_id' => $pid !== '' ? $pid : $itemId,
        'quantity' => $qty,
    ];
    if ($sku !== '') {
        $ga4Item['sku'] = $sku;
    }
    if ($price !== null) {
        $ga4Item['price'] = $price;
    }
    $pixelItems[] = $ga4Item;
    if (count($pixelItems) >= 20) {
        break;
    }
}
$heroTone = $paymentReturnCancelled
    ? 'danger'
    : ($isSuccess ? 'success' : (($isPending || $isProcessing) ? 'pending' : ($paymentReturnEmpty ? 'info' : 'danger')));
$paymentLifecycle = '';
if ($paymentReturnCancelled) {
    $paymentLifecycle = 'cancelled';
} elseif ($isSuccess) {
    $paymentLifecycle = 'paid';
} elseif ($isPending || $isProcessing) {
    $paymentLifecycle = 'pending';
} elseif ($transaction) {
    $paymentLifecycle = 'failed';
}
?>
<main class="amz-order-confirm amz-order-confirm--<?= $escape($heroTone) ?><?= $paymentSuccessTerminal ? ' weline-pixel::payment_success' : '' ?>"
    weline-code="payment.checkout_return"
    data-testid="payment-return"
    data-weline-load="cart,paymentLifecycle,paymentPixel"
    <?php if ($paymentLifecycle !== ''): ?>
    data-payment-lifecycle="<?= $escape($paymentLifecycle) ?>"
    data-payment-outcome="<?= $escape($paymentLifecycle === 'cancelled' ? 'cancel' : $paymentLifecycle) ?>"
    data-payment-event-source="payment-return-page"
    <?php endif; ?>
    <?php if ($orderUuid !== ''): ?>
    data-order-uuid="<?= $escape($orderUuid) ?>"
    <?php endif; ?>
    <?php if ($transactionNo !== ''): ?>
    data-transaction-id="<?= $escape($transactionNo) ?>"
    <?php endif; ?>
    <?php if ($transactionAmountLabel !== '' || $pixelValue !== ''): ?>
    data-amount="<?= $escape($pixelValue !== '' ? $pixelValue : (string) ($transaction ? $transaction->getData('amount') : '')) ?>"
    data-currency="<?= $escape($pixelCurrency !== '' ? $pixelCurrency : (string) ($transaction ? $transaction->getData('currency') : '')) ?>"
    <?php endif; ?>
    <?php if ($paymentSuccessTerminal && $isSuccess): ?>
    data-pixel-event="payment_success"
    data-pixel-value="<?= $escape($pixelValue) ?>"
    data-pixel-currency="<?= $escape($pixelCurrency) ?>"
    <?php endif; ?>>
    <header class="amz-order-confirm__banner">
        <div class="amz-order-confirm__banner-inner">
            <span class="amz-order-confirm__check" aria-hidden="true">
                <?php if ($paymentReturnCancelled): ?>×<?php elseif ($isSuccess): ?>✓<?php elseif ($isPending || $isProcessing): ?>…<?php elseif ($paymentReturnEmpty): ?>i<?php else: ?>×<?php endif; ?>
            </span>
            <div class="amz-order-confirm__banner-copy">
                <?php if ($paymentReturnCancelled): ?>
                    <?php if ($paymentCancelAlready): ?>
                        <h1><lang>已取消</lang></h1>
                        <p><lang>该支付已取消，无需再次操作。</lang></p>
                    <?php else: ?>
                        <h1><lang>已取消成功</lang></h1>
                        <p><lang>支付已取消成功，订单尚未完成付款。可返回结账页重新选择支付方式。</lang></p>
                    <?php endif; ?>
                <?php elseif ($paymentReturnEmpty): ?>
                    <h1><lang>支付结果</lang></h1>
                    <p><lang>当前没有可查询的支付交易号。若刚从网关返回，请确认回跳参数完整。</lang></p>
                <?php elseif ($isSuccess): ?>
                    <h1><lang>感谢您的订购！</lang></h1>
                    <p><lang>您的订单已支付成功，我们正在为您准备发货。</lang></p>
                <?php elseif ($isPending || $isProcessing): ?>
                    <h1><lang>支付处理中</lang></h1>
                    <p><lang>支付网关正在确认交易，请稍候刷新本页或前往订单中心查看状态。</lang></p>
                <?php else: ?>
                    <h1><lang>支付未完成</lang></h1>
                    <p><lang>支付未成功或已被取消，您可以返回结账页重新尝试。</lang></p>
                <?php endif; ?>
                <?php if ($orderV2DisplayNumber !== ''): ?>
                    <p class="amz-order-confirm__order-no">
                        <lang>订单号</lang>：
                        <strong><?= $escape($orderV2DisplayNumber) ?></strong>
                    </p>
                <?php endif; ?>
                <?php if ($shippingEmail !== '' && $isSuccess): ?>
                    <p class="amz-order-confirm__email-hint">
                        <lang>确认信息将发送至</lang> <span><?= $escape($shippingEmail) ?></span>
                    </p>
                <?php endif; ?>
            </div>
        </div>
    </header>

    <?php if ($isSuccess && ($shippingAddress !== [] || $paymentMethodLabel !== '' || $transaction)): ?>
    <section class="amz-order-confirm__panel" weline-code="payment.checkout_return.fulfillment_payment">
        <div class="amz-order-confirm__meta-grid">
            <?php if ($shippingAddress !== []): ?>
            <div class="amz-order-confirm__meta-block">
                <h2><lang>配送地址</lang></h2>
                <?php if ($shippingName !== ''): ?>
                    <p class="amz-order-confirm__meta-strong"><?= $escape($shippingName) ?></p>
                <?php endif; ?>
                <?php foreach ($shippingLines as $line): ?>
                    <p><?= $escape($line) ?></p>
                <?php endforeach; ?>
                <?php if ($shippingPhone !== ''): ?>
                    <p><?= $escape($shippingPhone) ?></p>
                <?php endif; ?>
            </div>
            <?php endif; ?>
            <div class="amz-order-confirm__meta-block">
                <h2><lang>支付信息</lang></h2>
                <?php if ($paymentMethodLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付方式</lang></span> <?= $escape($paymentMethodLabel) ?></p>
                <?php endif; ?>
                <?php if ($transactionAmountLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付金额</lang></span> <?= $escape($transactionAmountLabel) ?></p>
                <?php endif; ?>
                <?php if ($transaction): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>交易号</lang></span> <?= $escape((string) $transaction->getData('transaction_no')) ?></p>
                <?php endif; ?>
                <?php if ($paymentPaidAtLabel !== ''): ?>
                    <p><span class="amz-order-confirm__meta-label"><lang>支付时间</lang></span> <?= $escape($paymentPaidAtLabel) ?></p>
                <?php endif; ?>
            </div>
        </div>
    </section>
    <?php endif; ?>

    <?php if ($orderItemsDisplay !== []): ?>
    <section class="amz-order-confirm__panel" weline-code="payment.checkout_return.order_items">
        <header class="amz-order-confirm__panel-head">
            <h2><lang>订单商品</lang></h2>
            <?php if ($orderV2StatusLabel !== ''): ?>
                <span class="amz-order-confirm__status-pill amz-order-confirm__status-pill--<?= $escape($isSuccess ? 'paid' : 'default') ?>"><?= $escape($orderV2StatusLabel) ?></span>
            <?php endif; ?>
        </header>
        <?php if ($shippingMethod !== ''): ?>
            <p class="amz-order-confirm__ship-method">
                <lang>配送方式</lang>：<strong><?= $escape(__($shippingMethod)) ?></strong>
            </p>
        <?php elseif ($isSuccess): ?>
            <p class="amz-order-confirm__ship-method amz-order-confirm__ship-method--estimate">
                <lang>预计 2–5 个工作日内发货</lang>
            </p>
        <?php endif; ?>

        <ul class="amz-order-confirm__items">
            <?php foreach ($orderItemsDisplay as $item): ?>
                <?php if (!is_array($item)) {
                    continue;
                } ?>
                <?php
                $productId = (int) ($item['product_id'] ?? 0);
                $imageSrc = trim((string) ($item['image_src'] ?? ''));
                $imageFallback = trim((string) ($item['image_fallback'] ?? ''));
                if ($imageSrc === '' && $productId > 0) {
                    $imageResolved = \Weline\Theme\Helper\StorefrontImagePlaceholder::resolve('', $productId);
                    $imageSrc = $imageResolved['src'];
                    $imageFallback = $imageResolved['fallback'];
                }
                $qty = (int) ($item['qty_minor'] ?? 0);
                $unitMinor = (int) ($item['unit_price_minor'] ?? 0);
                $rowMinor = (int) ($item['row_total_minor'] ?? ($unitMinor * max(1, $qty)));
                $rowLabel = $orderCurrency !== '' ? $formatMoney($orderCurrency, $rowMinor) : '';
                ?>
                <li class="amz-order-confirm__item">
                    <div class="amz-order-confirm__item-media">
                        <img src="<?= $escape($imageSrc) ?>"
                             alt=""
                             data-storefront-img="1"
                             data-fallback="<?= $escape($imageFallback !== '' ? $imageFallback : $imageSrc) ?>"
                             loading="lazy"
                             decoding="async">
                    </div>
                    <div class="amz-order-confirm__item-main">
                        <p class="amz-order-confirm__item-title"><?= $escape($item['name'] ?? '') ?></p>
                        <p class="amz-order-confirm__item-qty"><lang>数量</lang>：<?= $escape((string) $qty) ?></p>
                    </div>
                    <?php if ($rowLabel !== ''): ?>
                    <div class="amz-order-confirm__item-price"><?= $escape($rowLabel) ?></div>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if ($orderV2TotalsLines !== []): ?>
        <div class="amz-order-confirm__totals" weline-code="payment.checkout_return.totals">
            <?php foreach ($orderV2TotalsLines as $line): ?>
                <?php if (!is_array($line)) {
                    continue;
                } ?>
                <?php
                $lineLabel = trim((string) ($line['label'] ?? ''));
                $lineMinor = (int) ($line['amount_minor'] ?? 0);
                $lineKey = (string) ($line['key'] ?? '');
                $isEmphasis = !empty($line['emphasis']);
                if ($lineLabel === '' || $orderCurrency === '') {
                    continue;
                }
                $lineAmountLabel = $formatMoney($orderCurrency, abs($lineMinor));
                if ($lineMinor < 0) {
                    $lineAmountLabel = '-' . $lineAmountLabel;
                }
                ?>
                <div class="amz-order-confirm__total-row<?= $isEmphasis ? ' amz-order-confirm__total-row--grand' : '' ?>">
                    <span><?= $escape($lineLabel) ?></span>
                    <strong><?= $escape($lineAmountLabel) ?></strong>
                </div>
            <?php endforeach; ?>
        </div>
        <?php elseif ($orderV2TotalLabel !== ''): ?>
        <footer class="amz-order-confirm__total">
            <span><lang>订单总额</lang></span>
            <strong><?= $escape($orderV2TotalLabel) ?></strong>
        </footer>
        <?php endif; ?>
    </section>
    <?php elseif ($orderV2 !== null || $orderV2DisplayNumber !== ''): ?>
    <section class="amz-order-confirm__panel" weline-code="payment.checkout_return.order_summary">
        <h2><lang>订单信息</lang></h2>
        <div class="amz-order-confirm__kv">
            <span><lang>订单号</lang></span>
            <strong><?= $escape($orderV2DisplayNumber) ?></strong>
        </div>
        <?php if ($orderV2Status !== ''): ?>
        <div class="amz-order-confirm__kv">
            <span><lang>订单状态</lang></span>
            <span><?= $escape($orderV2StatusLabel) ?></span>
        </div>
        <?php endif; ?>
        <?php if ($orderV2TotalLabel !== ''): ?>
        <div class="amz-order-confirm__kv">
            <span><lang>订单总额</lang></span>
            <strong><?= $escape($orderV2TotalLabel) ?></strong>
        </div>
        <?php endif; ?>
    </section>
    <?php endif; ?>

    <?php if (!$isSuccess && $transaction && !$paymentReturnEmpty): ?>
    <section class="amz-order-confirm__panel" weline-code="payment.checkout_return.failure_summary">
        <h2><lang>支付摘要</lang></h2>
        <div class="amz-order-confirm__kv">
            <span><lang>交易号</lang></span>
            <strong><?= $escape((string) $transaction->getData('transaction_no')) ?></strong>
        </div>
        <?php if ($transactionAmountLabel !== ''): ?>
        <div class="amz-order-confirm__kv">
            <span><lang>支付金额</lang></span>
            <strong><?= $escape($transactionAmountLabel) ?></strong>
        </div>
        <?php endif; ?>
    </section>
    <?php endif; ?>

    <w:hook>Weline_Payment::frontend::checkout::payment-result</w:hook>

    <nav class="amz-order-confirm__actions" aria-label="@lang('订单操作')">
        <?php if ($orderUuid !== ''): ?>
            <a href="@url{'customer/account/index'|['order_uuid' => $orderUuid]}#orders"
                class="amz-order-confirm__btn amz-order-confirm__btn--link weline-pixel::view_order">
                <lang>查看或管理订单</lang>
            </a>
        <?php endif; ?>
        <a href="@url{'products'}"
            class="amz-order-confirm__btn amz-order-confirm__btn--primary weline-pixel::continue_shopping">
            <lang>继续购物</lang>
        </a>
        <?php if (!$isSuccess && !$paymentReturnEmpty): ?>
            <a href="@url{'checkout'}" class="amz-order-confirm__btn amz-order-confirm__btn--secondary weline-pixel::retry_checkout">
                <lang>返回结账</lang>
            </a>
        <?php endif; ?>
    </nav>
</main>

<style>
