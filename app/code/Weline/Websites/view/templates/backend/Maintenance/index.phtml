<?php
/**
 * 网站维护模式管理页面
 *
 * @var \Weline\Framework\View\Template $this
 * @var array $websites
 * @var array $maintenance_status
 */


$websites = $websites ?? [];
$maintenanceStatus = $maintenance_status ?? [];
?>
<div data-weline-load="websiteMaintenance">
<div class="w-grid" data-testid="website-maintenance-management">
                <div class="w-grid">
                    <div style="--w-span:12;">
                        <template>Weline_Component::message.phtml</template>
                    </div>
                </div>

                <!-- 提示信息 -->
                <div class="w-grid">
                    <div style="--w-span:12;">
                        <div class="w-alert" data-tone="info">
                            <w:icon name="info" size="sm"></w:icon>
                            <strong><lang>提示</lang>:</strong> <lang>开启维护模式后，前台将显示维护页面，但后台仍可正常访问。</lang>
                        </div>
                    </div>
                </div>

                <!-- 网站列表 -->
                <div class="w-grid">
                    <div style="--w-span-lg:12;">
                        <div class="w-card">
                            <div class="w-card__body">
                                <h4 class="w-card__title" style="--w-mb:var(--weline-space-6);"><lang>网站列表</lang></h4>
                                
                                <?php if (!empty($websites)): ?>
                                <div class="w-table-wrap">
                                    <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                                        <thead>
                                            <tr>
                                                <th><lang>网站ID</lang></th>
                                                <th><lang>网站名称</lang></th>
                                                <th><lang>域名</lang></th>
                                                <th><lang>维护模式</lang></th>
                                                <th><lang>操作</lang></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <?php foreach ($websites as $website): ?>
                                            <?php 
                                            $websiteId = $website['website_id'] ?? $website['id'] ?? 0;
                                            $websiteName = $website['name'] ?? __('网站') . ' ' . $websiteId;
                                            $domain = $website['domain'] ?? $website['url'] ?? '-';
                                            $isMaintenance = $maintenanceStatus[$websiteId] ?? false;
                                            ?>
                                            <tr>
                                                <td><?= $websiteId ?></td>
                                                <td><?= htmlspecialchars($websiteName) ?></td>
                                                <td><?= htmlspecialchars($domain) ?></td>
                                                <td>
                                                    <span class="w-badge" data-w-background="<?= $isMaintenance ? 'warning' : 'success' ?>">
                                                        <?= $isMaintenance ? __('维护中') : __('正常') ?>
                                                    </span>
                                                </td>
                                                <td>
                                                    <button type="button" class="w-button" data-tone="<?= $isMaintenance ? 'success' : 'warning' ?>" data-maintenance-action="toggle" data-website-id="<?= (int)$websiteId ?>" data-website-code="<?= htmlspecialchars((string)($website['code'] ?? ''), ENT_QUOTES, 'UTF-8') ?>" data-maintenance-enabled="<?= $isMaintenance ? '0' : '1' ?>" data-size="sm">
                                                        <w:icon name="switch" size="sm"></w:icon>
                                                        <?= $isMaintenance ? __('关闭维护模式') : __('开启维护模式') ?>
                                                    </button>
                                                </td>
                                            </tr>
                                            <?php endforeach; ?>
                                        </tbody>
                                    </table>
                                </div>
                                <?php else: ?>
                                <div class="w-empty">
                                    <w:icon name="globe" size="sm"></w:icon>
                                    <p class="w-text" data-tone="muted" style="--w-mb:0;"><lang>暂无网站</lang></p>
                                </div>
                                <?php endif; ?>
                            </div>
                        </div>
                    </div>
                </div>
</div>

<?php
$maintenanceJsConfig = [
    'text' => [
        'updateFail' => (string)__('更新失败'),
        'updated' => (string)__('维护模式状态已更新'),
    ],
];
$maintenanceJsConfigJson = json_encode($maintenanceJsConfig, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
$maintenanceJsConfigJson = is_string($maintenanceJsConfigJson) ? $maintenanceJsConfigJson : '{}';
?>
<script type="application/json" id="website-maintenance-config"><?= $maintenanceJsConfigJson ?></script>
