<?php
/**
 * 一站式配置订单列表
 * @var \Weline\Framework\View\Template $this
 */
$items = $this->getData('items') ?: [];
$total = (int) $this->getData('total');
$page = (int) $this->getData('page');
$pageSize = (int) $this->getData('pageSize');
$totalPages = (int) $this->getData('totalPages');
$search = (string) $this->getData('search');
$status = (string) $this->getData('status');
$statusList = $this->getData('statusList') ?: [];
$orderIdField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_ORDER_ID;
$domainField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_DOMAIN;
$statusField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_STATUS;
$currentStepField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_CURRENT_STEP;
$errorField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_ERROR_MESSAGE;
$createdField = \Weline\Websites\Model\ProvisioningOrder::schema_fields_CREATED_AT;
?>
<div class="w-grid"><template>Weline_Component::message.phtml</template></div>

<div class="w-grid" style="--w-mb:var(--weline-space-4);">
    <div style="--w-span:12;">
        <w:form method="get" class="w-grid" data-align="end" style="--w-gap:var(--weline-space-3);">
            <div style="--w-span-md:5;--w-span-lg:4;">
                <label class="w-field__label" for="provisioning-search"><lang>搜索域名</lang></label>
                <input type="text" id="provisioning-search" name="search" class="w-input" placeholder="<?= __('搜索域名') ?>" value="<?= htmlspecialchars($search) ?>" data-size="sm">
            </div>
            <div style="--w-span-md:4;--w-span-lg:3;">
                <label class="w-field__label" for="provisioning-status"><lang>状态</lang></label>
                <select id="provisioning-status" name="status" class="w-select" data-size="sm">
                    <?php foreach ($statusList as $k => $v): ?>
                        <option value="<?= htmlspecialchars((string) $k) ?>" <?= $status === (string) $k ? 'selected' : '' ?>><?= htmlspecialchars((string) $v) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="w-cluster" style="--w-span-md:6;--w-span-lg:5;--w-gap:var(--weline-space-2);">
                <button type="submit" class="w-button" data-shrink="false" data-tone="primary" data-size="sm"><w:icon name="search" size="sm"></w:icon> <?= __('搜索') ?></button>
                <a href="@backend-url{'*/backend/provisioning/index'}" class="w-button" data-shrink="false" data-tone="neutral" data-size="sm"><w:icon name="refresh" size="sm"></w:icon> <?= __('重置') ?></a>
            </div>
        </w:form>
    </div>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-card">
            <div class="w-card__body">
                <div class="w-table-wrap">
                    <table class="w-table">
                        <thead>
                            <tr>
                                <th><?= __('订单ID') ?></th>
                                <th><?= __('域名') ?></th>
                                <th><?= __('状态') ?></th>
                                <th><?= __('当前步骤') ?></th>
                                <th><?= __('错误信息') ?></th>
                                <th><?= __('创建时间') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (empty($items)): ?>
                                <tr><td colspan="6" class="w-text" data-align="center" data-tone="muted"><?= __('暂无数据') ?></td></tr>
                            <?php else: ?>
                                <?php foreach ($items as $row): ?>
                                    <tr>
                                        <td><?= (int) ($row[$orderIdField] ?? 0) ?></td>
                                        <td><?= htmlspecialchars((string) ($row[$domainField] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string) ($row[$statusField] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string) ($row[$currentStepField] ?? '')) ?></td>
                                        <td class="w-text" data-tone="danger" data-size="sm"><?= htmlspecialchars((string) ($row[$errorField] ?? '')) ?></td>
                                        <td><?= htmlspecialchars((string) ($row[$createdField] ?? '')) ?></td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
                <?php if ($totalPages > 1): ?>
                <div class="w-cluster" data-justify="between" data-align="center" style="--w-mt:var(--weline-space-2);">
                    <span class="w-text" data-tone="muted"><?= __('共 %{total} 条', ['total' => $total]) ?></span>
                    <nav>
                        <ul class="w-pagination" style="--w-mb:0;">
                            <?php for ($i = 1; $i <= $totalPages; $i++): ?>
                                <li class="w-pagination__item" <?= $i === $page ? 'data-state="active"' : '' ?>>
                                    <a class="w-pagination__link" href="?page=<?= $i ?>&search=<?= urlencode($search) ?>&status=<?= urlencode($status) ?>"><?= $i ?></a>
                                </li>
                            <?php endfor; ?>
                        </ul>
                    </nav>
                </div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
