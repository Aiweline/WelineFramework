<script type="application/json" id="store-copy-config"><?= json_encode(
    $config,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT,
) ?></script>
<script>
(function () {
    'use strict';

    var configNode = document.getElementById('store-copy-config');
    var config = configNode ? JSON.parse(configNode.textContent || '{}') : {};
    var messages = config.messages || {};
    var state = {
        websites: [],
        stores: [],
        draft: null,
        preview: null,
        requestHash: ''
    };
    var elements = {
        entry: document.getElementById('store-copy-entry'),
        targetWebsite: document.getElementById('store-copy-target-website'),
        targetStore: document.getElementById('store-copy-target-store'),
        sourceWebsite: document.getElementById('store-copy-source-website'),
        sourceStore: document.getElementById('store-copy-source-store'),
        categories: document.getElementById('store-copy-category-ids'),
        excludedCategories: document.getElementById('store-copy-excluded-category-ids'),
        includeProducts: document.getElementById('store-copy-include-products'),
        inventoryCopyQty: document.getElementById('store-copy-inventory-copy-qty'),
        duplicatePolicy: document.getElementById('store-copy-duplicate-policy'),
        previewButton: document.getElementById('store-copy-preview'),
        commitButton: document.getElementById('store-copy-commit'),
        cancelButton: document.getElementById('store-copy-cancel'),
        status: document.getElementById('store-copy-status'),
        result: document.getElementById('store-copy-result')
    };

    function toast(type, message) {
        if (window.BackendToast && typeof window.BackendToast[type] === 'function') {
            window.BackendToast[type](message);
        }
    }

    function formatError(error, fallback) {
        var business = window.WelineApiBusiness || (window.Weline && window.Weline.ApiBusiness);
        if (business && typeof business.formatApiError === 'function') {
            return business.formatApiError(error, fallback);
        }
        return error && error.message ? error.message : fallback;
    }

    function setStatus(message, type) {
        elements.status.className = 'alert mb-3 alert-' + (type || 'secondary');
        elements.status.textContent = message;
    }

    function resource() {
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error(messages.apiUnavailable || 'product_copy_api_unavailable');
        }
        return Promise.resolve(window.Weline.Api.resource(config.provider || 'product_copy'));
    }

    function fillWebsiteSelect(select, selectedValue) {
        select.innerHTML = '';
        state.websites.forEach(function (website) {
            var option = document.createElement('option');
            option.value = String(website.website_id);
            option.textContent = website.name + ' (' + website.code + ', ID=' + website.website_id + ')';
            select.appendChild(option);
        });
        if (selectedValue !== undefined && selectedValue !== null) {
            select.value = String(selectedValue);
        }
    }

    function fillStoreSelect(select, websiteId, selectedValue) {
        select.innerHTML = '';
        var stores = state.stores.filter(function (store) {
            return Number(store.website_id) === Number(websiteId);
        });
        if (stores.length === 0) {
            var empty = document.createElement('option');
            empty.value = '';
            empty.textContent = messages.noStores || '';
            select.appendChild(empty);
            select.disabled = true;
            return;
        }
        select.disabled = false;
        stores.forEach(function (store) {
            var option = document.createElement('option');
            option.value = String(store.store_id);
            option.textContent = store.name + ' (' + store.code + ', ID=' + store.store_id + ')';
            select.appendChild(option);
        });
        if (selectedValue !== undefined && selectedValue !== null) {
            select.value = String(selectedValue);
        }
    }

    function updateEntryFields() {
        var entry = elements.entry.value;
        var blank = entry === 'blank';
        var inherit = entry === 'store_inherit';
        document.querySelectorAll('[data-copy-source-field="website"]').forEach(function (node) {
            node.classList.toggle('d-none', blank);
        });
        document.querySelectorAll('[data-copy-source-field="store"]').forEach(function (node) {
            node.classList.toggle('d-none', !inherit);
        });
        document.querySelectorAll('[data-copy-catalog-field]').forEach(function (node) {
            node.classList.toggle('d-none', blank);
        });
        elements.sourceWebsite.disabled = blank;
        elements.sourceStore.disabled = !inherit;
        elements.categories.disabled = blank;
        elements.excludedCategories.disabled = blank;
        elements.includeProducts.disabled = blank;
    }

    function parseIdList(value) {
        var unique = {};
        String(value || '').split(/[\s,，;；]+/).forEach(function (raw) {
            if (!/^[1-9][0-9]*$/.test(raw)) {
                return;
            }
            unique[Number(raw)] = true;
        });
        return Object.keys(unique).map(Number).sort(function (a, b) { return a - b; });
    }

    function selectedPackages() {
        return Array.prototype.slice.call(
            document.querySelectorAll('input[name="store-copy-package"]:checked')
        ).map(function (input) {
            return input.value;
        });
    }

    function payload() {
        var entry = elements.entry.value;
        var data = {
            entry: entry,
            target_website_id: Number(elements.targetWebsite.value),
            target_store_id: Number(elements.targetStore.value),
            category_ids: parseIdList(elements.categories.value),
            excluded_category_ids: parseIdList(elements.excludedCategories.value),
            include_products: !!elements.includeProducts.checked,
            field_packages: selectedPackages(),
            inventory_copy_qty: !!elements.inventoryCopyQty.checked,
            duplicate_policy: elements.duplicatePolicy.value
        };
        if (entry === 'site_pull' || entry === 'store_inherit') {
            data.source_website_id = Number(elements.sourceWebsite.value);
        }
        if (entry === 'store_inherit') {
            data.source_store_id = Number(elements.sourceStore.value);
        }
        return data;
    }

    function validatePayload(data) {
        if (!Number.isInteger(data.target_website_id) || !Number.isInteger(data.target_store_id) || data.target_store_id <= 0) {
            throw new Error(messages.targetRequired || '');
        }
        if (data.entry === 'site_pull' && !Number.isInteger(data.source_website_id)) {
            throw new Error(messages.sourceWebsiteRequired || '');
        }
        if (data.entry === 'store_inherit'
            && (!Number.isInteger(data.source_website_id)
                || !Number.isInteger(data.source_store_id)
                || data.source_store_id <= 0)) {
            throw new Error(messages.sourceRequired || '');
        }
    }

    function isDraftCancellable() {
        return state.draft && state.draft.state === 'draft';
    }

    function setBusy(busy) {
        elements.previewButton.disabled = busy || state.websites.length === 0;
        elements.commitButton.disabled = busy || !state.draft || !state.preview;
        elements.cancelButton.disabled = busy || !isDraftCancellable();
    }

    function renderPreview(preview) {
        document.querySelector('[data-testid="store-copy-count-categories"]').textContent = String(preview.category_count || 0);
        document.querySelector('[data-testid="store-copy-count-products"]').textContent = String(preview.product_count || 0);
        document.querySelector('[data-testid="store-copy-count-offers"]').textContent = String(preview.offer_count || 0);
        document.querySelector('[data-testid="store-copy-count-actions"]').textContent = [
            preview.create_count || 0,
            preview.skip_count || 0,
            preview.update_count || 0
        ].join(' / ');
        document.querySelector('[data-testid="store-copy-preview-inventory"]').textContent =
            preview.inventory_will_copy_qty ? 'true' : 'false';
        elements.result.textContent = JSON.stringify({
            draft_id: preview.draft_id,
            warnings: preview.warnings || [],
            items: preview.items || []
        }, null, 2);
    }

    function randomHashMaterial() {
        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
            var bytes = new Uint8Array(32);
            window.crypto.getRandomValues(bytes);
            return Array.prototype.map.call(bytes, function (value) {
                return value.toString(16).padStart(2, '0');
            }).join('');
        }
        var seed = String(Date.now()) + ':' + String(Math.random());
        var output = '';
        for (var i = 0; i < 64; i += 1) {
            output += ((seed.charCodeAt(i % seed.length) + i * 17) % 16).toString(16);
        }
        return output;
    }

    async function requestHash(draft) {
        var material = JSON.stringify(draft);
        if (!window.crypto || !window.crypto.subtle || typeof window.TextEncoder === 'undefined') {
            return randomHashMaterial();
        }
        var digest = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(material));
        return Array.prototype.map.call(new Uint8Array(digest), function (value) {
            return value.toString(16).padStart(2, '0');
        }).join('');
    }

    async function loadScopes() {
        try {
            var api = await resource();
            var response = await api.scopeOptions({}, {silent: true});
            state.websites = response.websites || [];
            state.stores = response.stores || [];
            fillWebsiteSelect(elements.targetWebsite, 0);
            fillWebsiteSelect(elements.sourceWebsite, 0);
            fillStoreSelect(elements.targetStore, elements.targetWebsite.value);
            fillStoreSelect(elements.sourceStore, elements.sourceWebsite.value);
            updateEntryFields();
            setStatus(messages.ready || '', 'secondary');
        } catch (error) {
            var message = formatError(error, messages.scopeLoadFailed || '');
            setStatus(message, 'danger');
            toast('error', message);
        } finally {
            setBusy(false);
        }
    }

    async function createAndPreview() {
        setBusy(true);
        setStatus(messages.previewing || '', 'info');
        try {
            var data = payload();
            validatePayload(data);
            var api = await resource();
            var created = await api.createDraft(data, {silent: true});
            state.draft = created.draft;
            state.requestHash = await requestHash(state.draft);
            var previewed = await api.preview({draft_id: state.draft.draft_id}, {silent: true});
            state.preview = previewed.preview;
            renderPreview(state.preview);
            setStatus(messages.previewReady || '', 'success');
            toast('success', messages.previewReady || '');
        } catch (error) {
            state.draft = null;
            state.preview = null;
            state.requestHash = '';
            var message = formatError(error, messages.previewFailed || '');
            setStatus(message, 'danger');
            toast('error', message);
        } finally {
            setBusy(false);
        }
    }

    async function commitDraft() {
        if (!state.draft || !state.preview) {
            return;
        }
        setBusy(true);
        setStatus(messages.committing || '', 'info');
        try {
            var api = await resource();
            var result = await api.commit({
                draft_id: state.draft.draft_id,
                request_hash: state.requestHash
            }, {silent: true});
            elements.result.textContent = JSON.stringify(result, null, 2);
            state.draft.state = 'committed';
            state.preview = null;
            setStatus(messages.committed || '', 'success');
            toast('success', messages.committed || '');
        } catch (error) {
            var message = formatError(error, messages.commitFailed || '');
            setStatus(message, 'danger');
            toast('error', message);
        } finally {
            setBusy(false);
        }
    }

    async function cancelDraft() {
        if (!isDraftCancellable()) {
            return;
        }
        setBusy(true);
        setStatus(messages.cancelling || '', 'info');
        try {
            var api = await resource();
            var result = await api.cancel({draft_id: state.draft.draft_id}, {silent: true});
            elements.result.textContent = JSON.stringify(result, null, 2);
            state.draft = null;
            state.preview = null;
            state.requestHash = '';
            setStatus(messages.cancelled || '', 'secondary');
            toast('success', messages.cancelled || '');
        } catch (error) {
            var message = formatError(error, messages.cancelFailed || '');
            setStatus(message, 'danger');
            toast('error', message);
        } finally {
            setBusy(false);
        }
    }

    elements.entry.addEventListener('change', updateEntryFields);
    elements.targetWebsite.addEventListener('change', function () {
        fillStoreSelect(elements.targetStore, elements.targetWebsite.value);
    });
    elements.sourceWebsite.addEventListener('change', function () {
        fillStoreSelect(elements.sourceStore, elements.sourceWebsite.value);
    });
    elements.previewButton.addEventListener('click', createAndPreview);
    elements.commitButton.addEventListener('click', commitDraft);
    elements.cancelButton.addEventListener('click', cancelDraft);

    setBusy(true);
    loadScopes();
})();
</script>
