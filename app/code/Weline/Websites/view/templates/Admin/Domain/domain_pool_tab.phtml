<script>
(function(){
'use strict';
var poolListUrl = <?= json_encode($poolListUrl) ?>;
var cleanInvalidUrl = <?= json_encode($cleanInvalidUrl) ?>;
var cleanMispointedUrl = <?= json_encode($cleanMispointedUrl) ?>;
var formKey = <?= json_encode($formKey) ?>;
var currentPage = <?= (int) $poolPage ?>;
var pageSize = <?= (int) $poolLimit ?>;
var totalRows = <?= (int) $poolTotal ?>;

function rowHtml(row) {
    var d = row.domain || '';
    var r = row.root_domain || '';
    var rs = row.resolve_status || 'pending';
    var il = parseInt(row.is_local_server, 10) === 1;
    var hs = row.https_status || 'none';
    var sr = parseInt(row.site_ready, 10) === 1;
    var sc = parseInt(row.site_created, 10) === 1;
    var pid = parseInt(row.pool_id, 10) || 0;
    var flowH = row._flow_html || '';
    var reg = row._registrar_name || '-';
    var dns = row._dns_provider_name || '-';
    var cdn = row._cdn_provider_name || '-';
    var connDetail = (row.connectivity_detail || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    var connTitle = connDetail || (row.connectivity_checked_at ? ('<?= __('检测于') ?> ' + (row.connectivity_checked_at || '')) : '<?= __('待检测') ?>');
    var connCell = '<span class="w-badge w-text" title="' + connTitle + '" data-w-background="muted" data-tone="muted"><w:icon name="search" size="sm"></w:icon><?= __('连通性') ?></span>';
    function rb(s, a, b, c, e) {
        if (s === 'resolved') return '<span class="w-badge w-text" data-w-background="success" data-tone="success">' + a + '</span>';
        if (s === 'resolving') return '<span class="w-badge w-text" data-w-background="info" data-tone="info">' + b + '</span>';
        if (s === 'error') return '<span class="w-badge w-text" data-w-background="danger" data-tone="danger">' + c + '</span>';
        return '<span class="w-badge w-text" data-w-background="warning" data-tone="warning">' + e + '</span>';
    }
    var resolveBadge = rb(rs, '<?= __('已解析') ?>', '<?= __('解析中') ?>', '<?= __('异常') ?>', '<?= __('待检测') ?>');
    var localBadge = il ? '<span class="w-badge w-text" data-w-background="primary" data-tone="primary"><?= __('本机') ?></span>' : '';
    var httpsBadge = hs === 'valid' ? '<span class="w-badge w-text" data-w-background="success" data-tone="success"><?= __('有效') ?></span>' : (hs === 'pending' ? '<span class="w-badge w-text" data-w-background="warning" data-tone="warning"><?= __('申请中') ?></span>' : '<span class="w-badge w-text" data-w-background="muted" data-tone="muted"><?= __('无') ?></span>');
    var readyBadge = sr ? '<span class="w-badge" data-w-background="success"><?= __('可用') ?></span>' : '<span class="w-badge" data-w-background="muted"><?= __('未就绪') ?></span>';
    var createdBadge = sc ? '<span class="w-badge" data-w-background="info"><?= __('已建站') ?></span>' : '<span class="w-badge" data-w-background="muted"><?= __('未建站') ?></span>';
    var flowCell = flowH || '<span class="w-text" data-tone="muted" data-size="sm">—</span>';
    if (pid > 0) {
        flowCell += '<div style="--w-mt:var(--weline-space-1);"><button type="button" class="w-button weline-pool-flow-log-btn" data-pool-id="' + pid + '" data-tone="quiet" data-size="sm" style="--w-pt:0;--w-pe:0;--w-pb:0;--w-ps:0;"><?= __('时间线') ?></button></div>';
    }
    var domainCell = '<div class="weline-pool-domain-cell"><strong>' + escapeHtml(d) + '</strong>' +
        ((r && r !== d) ? '<span class="weline-pool-domain-sub">' + escapeHtml(r) + '</span>' : '') +
        '</div>';
    var providerCell = '<div class="weline-pool-provider-cell">' +
        '<div class="weline-pool-provider-row"><span class="weline-pool-provider-label"><?= __('注册') ?></span><span class="w-badge w-text" data-w-background="primary" data-tone="primary">' + escapeHtml(reg) + '</span></div>' +
        '<div class="weline-pool-provider-row"><span class="weline-pool-provider-label">DNS</span><span class="w-badge w-text" data-w-background="warning" data-tone="warning">' + escapeHtml(dns) + '</span></div>' +
        '<div class="weline-pool-provider-row"><span class="weline-pool-provider-label">CDN</span><span class="w-badge w-text" data-w-background="info" data-tone="info">' + escapeHtml(cdn) + '</span></div>' +
        '</div>';
    var summaryCell = '<div class="weline-pool-summary-cell">' +
        '<div class="weline-pool-summary-row">' + resolveBadge + httpsBadge + localBadge + '</div>' +
        '<div class="weline-pool-summary-row">' + readyBadge + createdBadge + connCell + '</div>' +
        '</div>';
    return '<tr><td>' + domainCell + '</td><td>' + providerCell + '</td><td>' + summaryCell + '</td><td class="weline-pool-flow-cell">' + flowCell + '</td></tr>';
}
function openWelinePoolFlowLogModal(title, htmlInner) {
    var overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10002;display:flex;align-items:center;justify-content:center;padding:1rem;';
    var dlg = document.createElement('div');
    dlg.style.cssText = 'background:var(--backend-color-card-bg,#fff);border-radius:.75rem;padding:1.25rem;max-width:90vw;width:720px;max-height:85vh;overflow:auto;box-shadow:0 8px 32px rgba(0,0,0,.2);';
    dlg.innerHTML = '<h5 style="margin:0 0 12px;font-size:1.1rem;">' + escapeHtml(title) + '</h5>' +
        '<div class="weline-pool-flow-body">' + htmlInner + '</div>' +
        '<button type="button" class="w-button weline-pool-flow-close" data-tone="primary" style="--w-mt:var(--weline-space-4);"><?= __('关闭') ?></button>';
    overlay.appendChild(dlg);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    function close() {
        overlay.remove();
        document.body.style.overflow = '';
    }
    dlg.querySelector('.weline-pool-flow-close').addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
    document.addEventListener('keydown', function kw(e) {
        if (e.key === 'Escape') { document.removeEventListener('keydown', kw); close(); }
    });
}
function escapeHtml(s) {
    if (!s) return '';
    var el = document.createElement('div');
    el.textContent = s;
    return el.innerHTML;
}
function loadPage(page) {
    currentPage = page || 1;
    var tbody = document.getElementById('weline-pool-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="4" class="w-text" data-align="center" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);"><w:icon name="circle" size="sm"></w:icon> <?= __('加载中...') ?></td></tr>';
    var u = poolListUrl + (poolListUrl.indexOf('?') >= 0 ? '&' : '?') + 'page=' + encodeURIComponent(currentPage) + '&page_size=' + encodeURIComponent(pageSize);
    Weline.adminRequest('websites', u, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function(r){ return r.json(); }).then(function(data){
        if (data.code !== 200 || !data.data) {
            tbody.innerHTML = '<tr><td colspan="4" class="w-text" data-align="center" data-tone="danger" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);">' + escapeHtml(data.msg || 'Error') + '</td></tr>';
            return;
        }
        var d = data.data;
        totalRows = d.total || 0;
        var pages = Math.max(1, d.pages || 1);
        document.getElementById('weline-pool-total-badge').textContent = '<?= __('共') ?> ' + totalRows + ' <?= __('条') ?>';
        var lim = d.limit || pageSize;
        document.getElementById('weline-pool-page-info').textContent = totalRows > 0
            ? '<?= __('第') ?> ' + d.page + ' / ' + pages + ' <?= __('页，每页') ?> ' + lim + ' <?= __('条，合计') ?> ' + totalRows + ' <?= __('条') ?>'
            : '<?= __('暂无数据') ?>';
        var items = d.items || [];
        if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);"><w:icon name="minus" size="sm"></w:icon><p style="--w-mb:0;--w-mt:var(--weline-space-2);"><?= __('域名池暂无数据') ?></p></td></tr>';
        } else {
            tbody.innerHTML = items.map(rowHtml).join('');
        }
        renderPager(parseInt(d.page, 10) || 1, pages);
    }).catch(function(){
        tbody.innerHTML = '<tr><td colspan="4" class="w-text" data-align="center" data-tone="danger" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);"><?= __('请求失败') ?></td></tr>';
    });
}
function renderPager(page, lastPage) {
    var nav = document.getElementById('weline-pool-pagination');
    if (!nav) return;
    var h = '';
    if (lastPage > 1) {
        h += '<li class="w-pagination__item ' + (page <= 1 ? 'disabled' : '')"><a class="w-pagination__link" href="#" data-p="' + (page - 1) + '">&laquo;</a></li>';
        var s = Math.max(1, page - 2), e = Math.min(lastPage, page + 2);
        for (var i = s; i <= e; i++) {
            h += '<li class="w-pagination__item ' + (i === page ? 'active' : '')"><a class="w-pagination__link" href="#" data-p="' + i + '">' + i + '</a></li>';
        }
        h += '<li class="w-pagination__item ' + (page >= lastPage ? 'disabled' : '')"><a class="w-pagination__link" href="#" data-p="' + (page + 1) + '">&raquo;</a></li>';
    } else if (totalRows > 0) {
        h = '<li class="w-pagination__item" aria-disabled="true"><span class="w-pagination__link"><?= __('共 1 页') ?></span></li>';
    }
    nav.innerHTML = h;
    nav.querySelectorAll('a.page-link[data-p]').forEach(function(a){
        a.addEventListener('click', function(e){
            e.preventDefault();
            var p = parseInt(a.getAttribute('data-p'), 10);
            if (p >= 1 && p <= lastPage) loadPage(p);
        });
    });
}
renderPager(<?= (int) $poolPage ?>, <?= (int) max(1, $poolPages) ?>);

document.getElementById('weline-pool-page-size').addEventListener('change', function(){
    pageSize = parseInt(this.value, 10) || 20;
    loadPage(1);
});

function postJson(url, dry) {
    var fd = new FormData();
    fd.append('dry_run', dry ? '1' : '0');
    if (formKey) fd.append('form_key', formKey);
    return Weline.adminRequest('websites', url, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function(r){ return r.json(); });
}
function showInlineAlert(message, type) {
    var el = document.getElementById('weline-pool-alert');
    if (!el) return;
    el.textContent = message || '';
    el.classList.remove('d-none');
    el.classList.remove('alert-success', 'alert-danger', 'alert-warning', 'alert-info', 'alert-primary');
    var map = {
        success: 'alert-success',
        danger: 'alert-danger',
        error: 'alert-danger',
        warning: 'alert-warning',
        info: 'alert-info',
        primary: 'alert-primary'
    };
    el.classList.add(map[type] || 'alert-primary');
}
function toastError(message) {
    if (typeof Weline.UI.toast !== 'undefined' && Weline.UI.toast.error) return Weline.UI.toast.error(message);
    showInlineAlert(message, 'danger');
}
function toastSuccess(message) {
    if (typeof Weline.UI.toast !== 'undefined' && Weline.UI.toast.success) return Weline.UI.toast.success(message);
    showInlineAlert(message, 'success');
}
function backendConfirmPromise(title, options) {
    options = options || {};
    return Weline.UI.dialog.confirm(title, {
        title: options.title || '',
        tone: options.type || 'warning',
        dangerous: options.type === 'danger',
        confirmLabel: options.confirmText || '<?= __('确认') ?>',
        cancelLabel: options.cancelText || '<?= __('取消') ?>'
    });
}
function toastResult(data) {
    if (data.code !== 200) {
        toastError(data.msg || 'Error');
        return;
    }
    var extra = '';
    if (data.data && data.data.domains && data.data.domains.length) {
        extra = ' ' + data.data.domains.slice(0, 12).join(', ');
    }
    if (data.data && data.data.dns_deleted && data.data.dns_deleted.length) {
        extra += ' | DNS: ' + data.data.dns_deleted.slice(0, 6).map(function(x){ return x.root + ' ' + x.type; }).join('; ');
    }
    if (data.data && data.data.errors && data.data.errors.length) {
        extra += ' | ' + data.data.errors.slice(0, 3).join('; ');
    }
    toastSuccess((data.msg || '') + extra);
}
function runDryThenCommit(url, titleDry) {
    var doCommit = function() {
        postJson(url, false).then(function(data){
            toastResult(data);
            if (data.code === 200) loadPage(1);
        }).catch(function(){
            toastError('<?= __('请求失败') ?>');
        });
    };
    var p = backendConfirmPromise(titleDry, { title: '<?= __('试运行') ?>', type: 'info', confirmText: '<?= __('开始试运行') ?>' });
    p.then(function(ok){
        if (!ok) return;
        postJson(url, true).then(function(data){
            toastResult(data);
            if (data.code !== 200) return;
            var q = backendConfirmPromise('<?= __('试运行已完成。是否正式执行删除？此操作不可撤销。') ?>', { title: '<?= __('确认') ?>', type: 'danger', confirmText: '<?= __('正式执行？') ?>' });
            q.then(function(ok2){ if (ok2) doCommit(); });
        }).catch(function(){
            toastError('<?= __('请求失败') ?>');
        });
    });
}
document.getElementById('weline-pool-btn-clean-invalid').addEventListener('click', function(){
    runDryThenCommit(cleanInvalidUrl, '<?= __('将列出含 [] 的非法池记录（不删除）。继续？') ?>');
});
document.getElementById('weline-pool-btn-clean-dns').addEventListener('click', function(){
    runDryThenCommit(cleanMispointedUrl, '<?= __('将检查根域 @ 的 A/AAAA 是否指向本机公网（橙云代理不删）。继续试运行？') ?>');
});
document.getElementById('weline-pool-tbody').addEventListener('click', function(ev){
    var t = ev.target;
    if (!t || !t.classList || !t.classList.contains('weline-pool-flow-log-btn')) return;
    var id = t.getAttribute('data-pool-id');
    if (!id) return;
    var u = poolFlowLogUrl + (poolFlowLogUrl.indexOf('?') >= 0 ? '&' : '?') + 'pool_id=' + encodeURIComponent(id);
    Weline.adminRequest('websites', u, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function(r){ return r.json(); }).then(function(data){
        if (data.code !== 200 || !data.data || !data.data.items) {
            toastError(data.msg || 'Error');
            return;
        }
        var lines = data.data.items.map(function(x){ return (x.at || '') + ' [' + (x.kind || '') + '] ' + (x.message || ''); });
        var body = lines.length ? '<pre class="w-text" style="white-space:pre-wrap;max-height:70vh;overflow:auto;" data-align="start" data-size="sm">' +
            lines.map(function(s){ return escapeHtml(s); }).join('\n') + '</pre>' : '<?= __('暂无记录') ?>';
        openWelinePoolFlowLogModal('<?= __('流转记录') ?> #' + id, body);
    }).catch(function(){ toastError('<?= __('请求失败') ?>'); });
});
})();
</script>
