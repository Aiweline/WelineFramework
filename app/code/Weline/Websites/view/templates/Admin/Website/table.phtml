<?php
/**
 * 网站列表表格 - Weline_Websites
 *
 * @var \Weline\Framework\View\Template $this
 */
$websites = $this->getData('websites') ?: [];
$pagination = $this->getData('pagination') ?: '';
$storeModeLabels = [
    'normal' => __('正式'),
    'dev' => __('开发'),
    'test' => __('测试'),
];
$storeLifecycleLabels = [
    'active' => __('活动'),
    'tombstone' => __('墓碑'),
];
?>
<div class="table-responsive weline-websites-table-wrap">
    <table class="table table-hover align-middle weline-websites-compact-table">
        <thead>
        <tr>
            <th><lang>站点</lang></th>
            <th><lang>Store / SalesChannel 目录</lang></th>
            <th><lang>访问入口</lang></th>
            <th><lang>语言 / 货币</lang></th>
            <th class="text-end"><lang>操作</lang></th>
        </tr>
        </thead>
        <tbody>
        <?php if (empty($websites)): ?>
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="mdi mdi-web-off" style="font-size: 2rem;"></i>
                    <p class="mt-2 mb-0"><lang>暂无网站数据</lang></p>
                </td>
            </tr>
        <?php else: ?>
            <?php foreach ($websites as $website): ?>
                <?php
                if (!array_key_exists('website_id', $website)) {
                    throw new \RuntimeException((string)__('网站目录行缺少 website_id'));
                }
                $websiteId = (int)$website['website_id'];
                $name = (string)($website['name'] ?? '');
                $code = (string)($website['code'] ?? '');
                $timezone = (string)($website['default_timezone'] ?? '');
                $domainList = $website['domain_list'] ?? [];
                if (!is_array($domainList)) {
                    $domainList = [];
                }
                $siteUrl = (string)($website['url'] ?? '');
                if ($siteUrl === '' && $domainList !== []) {
                    $firstDomain = $domainList[0] ?? [];
                    $firstHost = (string)($firstDomain['domain'] ?? '');
                    if ($firstHost !== '') {
                        $siteUrl = (!empty($firstDomain['https_enabled']) ? 'https://' : 'http://') . $firstHost;
                    }
                }
                $defaultCurrency = (string)($website['default_currency'] ?? '');
                $currencyCodes = $website['currency_codes'] ?? [];
                if (!is_array($currencyCodes)) {
                    $currencyCodes = [];
                }
                $languageCodes = $website['language_codes'] ?? [];
                if (!is_array($languageCodes)) {
                    $languageCodes = [];
                }
                $storeChannelDirectory = $website['store_channel_directory'] ?? [];
                if (!is_array($storeChannelDirectory)) {
                    $storeChannelDirectory = [];
                }
                ?>
                <tr>
                    <td>
                        <div class="weline-websites-site-cell">
                            <div class="weline-websites-site-name"><?= htmlspecialchars($name) ?></div>
                            <div class="weline-websites-site-meta">
                                <span class="weline-websites-inline-code"><?= htmlspecialchars($code) ?></span>
                                <span class="weline-websites-meta-chip">#<?= $websiteId ?></span>
                                <?php if ($timezone !== ''): ?>
                                    <span class="weline-websites-meta-chip"><?= htmlspecialchars($timezone) ?></span>
                                <?php endif; ?>
                            </div>
                        </div>
                    </td>
                    <td class="weline-websites-directory-cell">
                        <div class="weline-websites-directory"
                             aria-label="<?= htmlspecialchars((string)__('Store 与 SalesChannel 只读目录'), ENT_QUOTES, 'UTF-8') ?>">
                            <div class="weline-websites-directory-heading">
                                <span>
                                    <i class="mdi mdi-sitemap me-1" aria-hidden="true"></i>
                                    <?= __('%{1} 个 Store', [count($storeChannelDirectory)]) ?>
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary"><lang>只读</lang></span>
                            </div>
                            <?php if ($storeChannelDirectory === []): ?>
                                <div class="weline-websites-directory-empty" role="status">
                                    <i class="mdi mdi-database-alert-outline" aria-hidden="true"></i>
                                    <span><lang>暂无 Store/Channel 目录，请运行 setup:upgrade 补齐默认目录。</lang></span>
                                </div>
                            <?php else: ?>
                                <ul class="weline-websites-store-list">
                                    <?php foreach ($storeChannelDirectory as $store): ?>
                                        <?php
                                        $storeName = (string)($store['name'] ?? '');
                                        $storeCode = (string)($store['code'] ?? '');
                                        $storeId = (int)($store['store_id'] ?? 0);
                                        $storeMode = (string)($store['store_mode'] ?? '');
                                        $storeLifecycle = (string)($store['lifecycle_status'] ?? '');
                                        $channels = $store['channels'] ?? [];
                                        if (!is_array($channels)) {
                                            $channels = [];
                                        }
                                        ?>
                                        <li class="weline-websites-store-item">
                                            <div class="weline-websites-store-header">
                                                <div>
                                                    <strong><?= htmlspecialchars($storeName, ENT_QUOTES, 'UTF-8') ?></strong>
                                                    <span class="weline-websites-inline-code"><?= htmlspecialchars($storeCode, ENT_QUOTES, 'UTF-8') ?></span>
                                                    <span class="weline-websites-meta-chip">#<?= $storeId ?></span>
                                                </div>
                                                <div class="weline-websites-directory-badges">
                                                    <?php if (!empty($store['is_default'])): ?>
                                                        <span class="badge bg-primary-subtle text-primary"><lang>默认</lang></span>
                                                    <?php endif; ?>
                                                    <span class="badge bg-info-subtle text-info">
                                                        <?= htmlspecialchars((string)($storeModeLabels[$storeMode] ?? $storeMode), ENT_QUOTES, 'UTF-8') ?>
                                                    </span>
                                                    <span class="badge <?= !empty($store['enabled']) ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' ?>">
                                                        <?= !empty($store['enabled']) ? __('启用') : __('停用') ?>
                                                    </span>
                                                    <span class="badge <?= $storeLifecycle === 'active' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' ?>">
                                                        <?= htmlspecialchars((string)($storeLifecycleLabels[$storeLifecycle] ?? $storeLifecycle), ENT_QUOTES, 'UTF-8') ?>
                                                    </span>
                                                </div>
                                            </div>
                                            <?php if ($channels === []): ?>
                                                <div class="weline-websites-channel-empty">
                                                    <i class="mdi mdi-source-branch-remove" aria-hidden="true"></i>
                                                    <span><lang>此 Store 暂无 SalesChannel</lang></span>
                                                </div>
                                            <?php else: ?>
                                                <ul class="weline-websites-channel-list"
                                                    aria-label="<?= htmlspecialchars((string)__('SalesChannel 列表'), ENT_QUOTES, 'UTF-8') ?>">
                                                    <?php foreach ($channels as $channel): ?>
                                                        <li>
                                                            <i class="mdi mdi-source-branch" aria-hidden="true"></i>
                                                            <span class="weline-websites-channel-name"><?= htmlspecialchars((string)($channel['name'] ?? ''), ENT_QUOTES, 'UTF-8') ?></span>
                                                            <span class="weline-websites-inline-code"><?= htmlspecialchars((string)($channel['code'] ?? ''), ENT_QUOTES, 'UTF-8') ?></span>
                                                            <span class="weline-websites-meta-chip">#<?= (int)($channel['channel_id'] ?? 0) ?></span>
                                                            <?php if (!empty($channel['is_default'])): ?>
                                                                <span class="badge bg-primary-subtle text-primary"><lang>默认</lang></span>
                                                            <?php endif; ?>
                                                            <span class="badge <?= !empty($channel['effective_enabled']) ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' ?>">
                                                                <?= !empty($channel['effective_enabled']) ? __('有效') : __('不可用') ?>
                                                            </span>
                                                        </li>
                                                    <?php endforeach; ?>
                                                </ul>
                                            <?php endif; ?>
                                        </li>
                                    <?php endforeach; ?>
                                </ul>
                            <?php endif; ?>
                        </div>
                    </td>
                    <td>
                        <div class="weline-websites-access-cell">
                            <?php if ($siteUrl !== ''): ?>
                                <a href="<?= htmlspecialchars($siteUrl) ?>" target="_blank" rel="noopener" class="weline-websites-url-link weline-websites-url-row">
                                    <span><?= htmlspecialchars($siteUrl) ?></span>
                                    <i class="mdi mdi-open-in-new"></i>
                                </a>
                            <?php else: ?>
                                <span class="text-muted small"><lang>未生成访问地址</lang></span>
                            <?php endif; ?>

                            <div class="weline-websites-domain-list">
                                <?php if ($domainList !== []): ?>
                                    <?php foreach ($domainList as $domainRow): ?>
                                        <?php
                                        $domain = (string)($domainRow['domain'] ?? '');
                                        if ($domain === '') {
                                            continue;
                                        }
                                        $isPrimary = !empty($domainRow['is_primary']);
                                        $protocol = !empty($domainRow['https_enabled']) ? 'https' : 'http';
                                        $domainUrl = $protocol . '://' . $domain;
                                        ?>
                                        <span class="weline-websites-domain-badge">
                                            <a href="<?= htmlspecialchars($domainUrl) ?>" target="_blank" rel="noopener" class="weline-websites-domain-link" title="<?= htmlspecialchars($domain) ?>">
                                                <?= htmlspecialchars($domain) ?>
                                                <i class="mdi mdi-open-in-new ms-1 small"></i>
                                            </a>
                                            <?php if ($isPrimary): ?>
                                                <span class="badge bg-primary-subtle text-primary ms-1"><lang>主</lang></span>
                                            <?php endif; ?>
                                        </span>
                                    <?php endforeach; ?>
                                <?php else: ?>
                                    <span class="text-muted small">-</span>
                                <?php endif; ?>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="weline-websites-market-cell">
                            <div class="weline-websites-market-row">
                                <span class="weline-websites-market-label"><lang>货币</lang></span>
                                <div class="weline-websites-chip-group">
                                    <?php if ($defaultCurrency !== ''): ?>
                                        <span class="badge bg-primary-subtle text-primary"><?= __('默认') ?> <?= htmlspecialchars($defaultCurrency) ?></span>
                                    <?php endif; ?>
                                    <?php if ($currencyCodes !== []): ?>
                                        <?php foreach ($currencyCodes as $currencyCode): ?>
                                            <span class="badge bg-info-subtle text-info"><?= htmlspecialchars((string)$currencyCode) ?></span>
                                        <?php endforeach; ?>
                                    <?php elseif ($defaultCurrency === ''): ?>
                                        <span class="text-muted small"><lang>全部</lang></span>
                                    <?php endif; ?>
                                </div>
                            </div>
                            <div class="weline-websites-market-row">
                                <span class="weline-websites-market-label"><lang>语言</lang></span>
                                <div class="weline-websites-chip-group">
                                    <?php if ($languageCodes !== []): ?>
                                        <?php foreach ($languageCodes as $languageCode): ?>
                                            <span class="badge bg-success-subtle text-success"><?= htmlspecialchars((string)$languageCode) ?></span>
                                        <?php endforeach; ?>
                                    <?php else: ?>
                                        <span class="text-muted small"><lang>全部</lang></span>
                                    <?php endif; ?>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end weline-websites-op-cell">
                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                            <?php
                            $frontendUrl = (string)($website['frontend_url'] ?? $siteUrl);
                            $backendUrl = (string)($website['backend_url'] ?? '');
                            ?>
                            <?php if ($frontendUrl !== ''): ?>
                                <a href="<?= htmlspecialchars($frontendUrl) ?>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="<?= __('访问前端') ?>">
                                    <i class="mdi mdi-open-in-new"></i> <lang>访问前端</lang>
                                </a>
                            <?php else: ?>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="<?= __('请先绑定域名') ?>">
                                    <i class="mdi mdi-open-in-new"></i> <lang>访问前端</lang>
                                </button>
                            <?php endif; ?>
                            <?php if ($backendUrl !== ''): ?>
                                <a href="<?= htmlspecialchars($backendUrl) ?>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success" title="<?= __('有功能授权时从主站直进子站后台，无需再登录') ?>">
                                    <i class="mdi mdi-monitor-dashboard"></i> <lang>管理后端</lang>
                                </a>
                            <?php else: ?>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="<?= __('请先绑定域名') ?>">
                                    <i class="mdi mdi-monitor-dashboard"></i> <lang>管理后端</lang>
                                </button>
                            <?php endif; ?>
                            <block class='Weline\Component\Block\OffCanvas'
                                   cache='0'
                                   id='edit_website_{{website.website_id}}'
                                   action='*/admin/website/edit'
                                   vars='website'
                                   action-params='{id:website.website_id}'
                                   title='编辑网站'
                                   close-button-show='1'
                                   close-button-text='关闭'
                                   direction='right'
                                   class-names='w-75 h-100'
                                   off-canvas-body-style=''
                                   target-button-text='编辑'
                                   icon='mdi mdi-pencil'
                                   target-button-class='btn btn-sm btn-outline-info'
                                   target-tag='a'
                                   save='1'
                            />
                            <button type="button"
                               w-delete="true"
                               data-provider="websites"
                               data-operation="deleteWebsite"
                               w-var-website_id="<?= $websiteId ?>"
                               w-msg="<?= __('您确定要删除此网站吗？') ?>"
                               class="btn btn-sm btn-outline-danger"
                               title="<?= __('删除') ?>">
                                <i class="mdi mdi-delete"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            <?php endforeach; ?>
        <?php endif; ?>
        </tbody>
    </table>

    <?= $pagination ?>
</div>
