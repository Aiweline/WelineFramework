    <w:form method="post" action="@backend-url('*/backend/scope-management/create-store')" csrf="auto" class="w-grid" data-testid="store-management-create-form" style="--w-gap:var(--weline-space-4);">
        <input type="hidden" name="website_id" value="<?= $websiteId ?>">
        <input type="hidden" name="return_to" value="tree">
        <input type="hidden" name="return_node" value="<?= $escape($returnNode) ?>">
        <?php if ($returnUrl !== ''): ?>
            <input type="hidden" name="return_url" value="<?= $escape($returnUrl) ?>">
        <?php endif; ?>
        <div style="--w-span-md:3;">
            <label class="w-field__label"><lang>商店代码</lang></label>
            <input class="w-input" name="code" maxlength="64" required>
        </div>
        <div style="--w-span-md:4;">
            <label class="w-field__label"><lang>商店名称</lang></label>
            <input class="w-input" name="name" maxlength="128" required>
        </div>
        <div style="--w-span-md:2;">
            <label class="w-field__label"><lang>模式</lang></label>
            <select class="w-select" name="store_mode">
                <option value="normal">normal</option>
                <option value="dev">dev</option>
                <option value="test">test</option>
            </select>
