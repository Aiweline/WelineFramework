<js:part name="debounce"/>
<script>
(function() {
    'use strict';

    function querySelectorSafe(selector) {
        if (!selector) {
            return null;
        }

        try {
            return document.querySelector(selector);
        } catch (e) {
            return null;
        }
    }

    function getCollapseTarget(button) {
        var selector = button.getAttribute('data-bs-target') || button.getAttribute('data-target') || button.getAttribute('href');
        var target = querySelectorSafe(selector);

        if (target) {
            return target;
        }

        var controls = button.getAttribute('aria-controls');
        return controls ? document.getElementById(controls) : null;
    }

    function getButtonForTarget(root, target) {
        var buttons = root.querySelectorAll('.accordion-button[data-bs-toggle="collapse"], .accordion-button[data-toggle="collapse"]');

        for (var i = 0; i < buttons.length; i++) {
            if (getCollapseTarget(buttons[i]) === target) {
                return buttons[i];
            }
        }

        return null;
    }

    function setCollapseState(root, target, expanded) {
        var button = getButtonForTarget(root, target);

        target.classList.remove('collapsing');
        target.classList.toggle('show', expanded);
        target.style.height = '';

        if (button) {
            button.classList.toggle('collapsed', !expanded);
            button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        }
    }

    function closeSiblingSections(root, target) {
        var parent = querySelectorSafe(target.getAttribute('data-bs-parent')) || root;
        var openTargets = parent.querySelectorAll('.accordion-collapse.show');

        for (var i = 0; i < openTargets.length; i++) {
            if (openTargets[i] !== target) {
                setCollapseState(root, openTargets[i], false);
            }
        }
    }

    function toggleCollapse(root, button, target) {
        var willExpand = !target.classList.contains('show');

        if (willExpand) {
            closeSiblingSections(root, target);
        }

        setCollapseState(root, target, willExpand);
    }

    function syncInitialState(root) {
        var targets = root.querySelectorAll('.accordion-collapse');

        for (var i = 0; i < targets.length; i++) {
            setCollapseState(root, targets[i], targets[i].classList.contains('show'));
        }
    }

    function bindAccordion(root) {
        if (!root || root.getAttribute('data-weline-accordion-bound') === 'true') {
            return;
        }

        root.setAttribute('data-weline-accordion-bound', 'true');
        syncInitialState(root);

        root.addEventListener('click', function(event) {
            var eventTarget = event.target && event.target.nodeType === 1 ? event.target : event.target.parentElement;
            var button = eventTarget ? eventTarget.closest('.accordion-button[data-bs-toggle="collapse"], .accordion-button[data-toggle="collapse"]') : null;

            if (!button || !root.contains(button)) {
                return;
            }

            var target = getCollapseTarget(button);

            if (!target) {
                return;
            }

            var targetClassBefore = target.className;
            var buttonExpandedBefore = button.getAttribute('aria-expanded');

            window.setTimeout(function() {
                var nativeHandled = target.className !== targetClassBefore || button.getAttribute('aria-expanded') !== buttonExpandedBefore;

                if (!nativeHandled) {
                    toggleCollapse(root, button, target);
                }
            }, 50);
        });
    }

    function initAccordions() {
        var accordions = document.querySelectorAll('.website-form-accordion');

        for (var i = 0; i < accordions.length; i++) {
            bindAccordion(accordions[i]);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAccordions);
    } else {
        initAccordions();
    }
})();

(function() {
    'use strict';

    var utils = window.WelineLanguageSelectUtils;
    if (!utils || typeof utils.bindDefaultToMultiple !== 'function') {
        return;
    }

    utils.bindDefaultToMultiple({
        singleId: 'website_default_language_selector',
        multipleId: 'website_related_languages_selector'
    });
})();

(function() {
    'use strict';
    
    var timezoneSearch = document.getElementById('timezone-search');
    var timezoneSelect = document.getElementById('default_timezone');
    
    if (!timezoneSearch || !timezoneSelect) return;
    
    var allOptions = [];
    for (var i = 1; i < timezoneSelect.options.length; i++) {
        var option = timezoneSelect.options[i];
        allOptions.push({
            value: option.value,
            text: option.textContent,
            selected: option.selected
        });
    }
    
    function filterTimezones(searchTerm) {
        var term = searchTerm.toLowerCase().trim();
        
        timezoneSelect.innerHTML = '<option value="">-- 请选择 --</option>';
        
        if (!term) {
            allOptions.forEach(function(opt) {
                var option = document.createElement('option');
                option.value = opt.value;
                option.textContent = opt.text;
                if (opt.selected) {
                    option.selected = true;
                    timezoneSearch.value = opt.text;
                }
                timezoneSelect.appendChild(option);
            });
        } else {
            var matched = allOptions.filter(function(opt) {
                return opt.text.toLowerCase().includes(term);
            });
            
            matched.forEach(function(opt) {
                var option = document.createElement('option');
                option.value = opt.value;
                option.textContent = opt.text;
                if (opt.selected) {
                    option.selected = true;
                    timezoneSearch.value = opt.text;
                }
                timezoneSelect.appendChild(option);
            });
            
            if (matched.length === 1) {
                timezoneSelect.selectedIndex = 1;
                timezoneSearch.value = matched[0].text;
            }
        }
    }
    
    var searchTimeout;
    timezoneSearch.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        var self = this;
        searchTimeout = setTimeout(function() {
            filterTimezones(self.value);
        }, 200);
    });
    
    timezoneSelect.addEventListener('change', function() {
        if (timezoneSelect.value) {
            timezoneSearch.value = timezoneSelect.options[timezoneSelect.selectedIndex].textContent;
        } else {
            timezoneSearch.value = '';
        }
    });
    
    if (timezoneSelect.value) {
        timezoneSearch.value = timezoneSelect.options[timezoneSelect.selectedIndex].textContent;
    }
})();

