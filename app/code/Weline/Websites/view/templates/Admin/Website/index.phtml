<js:part name="w-delete"/>
<script>
(function () {
    'use strict';

    var guideToggle = document.getElementById('weline-websites-guide-toggle');
    if (guideToggle) {
        guideToggle.addEventListener('click', function () {
            var body = document.getElementById('weline-websites-guide-body');
            var icon = document.getElementById('weline-websites-guide-icon');
            if (!body) {
                return;
            }
            var expanded = body.classList.toggle('is-open');
            guideToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            if (icon) {
                icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        });
    }

    var tableEl = document.getElementById('w-datatable-website-admin-list')
        || document.querySelector('#website-admin-table-container [data-w-component="data-table"]');
    if (!tableEl) {
        return;
    }

    function openWebsiteEditDrawer(editUrl) {
        if (editUrl === '') {
            return;
        }
        var drawer = document.getElementById('website_edit_drawer');
        var frame = drawer ? drawer.querySelector('[data-w-remote-frame]') : null;
        if (!frame) {
            window.location.href = editUrl;
            return;
        }
        frame.setAttribute('data-src', editUrl);
        frame.src = editUrl;
        if (window.Weline && window.Weline.UI && typeof window.Weline.UI.drawer.open === 'function') {
            window.Weline.UI.drawer.open('#website_edit_drawer');
            return;
        }
        var opener = document.getElementById('website-edit-drawer-open');
        if (opener) {
            opener.click();
        }
    }

    tableEl.addEventListener('weline:datatable:row-action', function (event) {
        var detail = event.detail || {};
        var action = String(detail.action || '');
        var row = detail.row || {};
        if (action === 'edit') {
            openWebsiteEditDrawer(String(row.edit_url || ''));
            return;
        }
        if (action === 'delete') {
            var websiteId = String(row.website_id || '');
            if (websiteId === '') {
                return;
            }
            var tempBtn = document.createElement('button');
            tempBtn.type = 'button';
            tempBtn.setAttribute('w-delete', 'true');
            tempBtn.setAttribute('data-provider', 'websites');
            tempBtn.setAttribute('data-operation', 'deleteWebsite');
            tempBtn.setAttribute('w-var-website_id', websiteId);
            tempBtn.setAttribute('w-msg', <?= json_encode((string)__('您确定要删除此网站吗？'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP) ?>);
            tempBtn.style.position = 'fixed';
            tempBtn.style.left = '-9999px';
            document.body.appendChild(tempBtn);
            tempBtn.click();
            tempBtn.remove();
        }
    });
})();
</script>
