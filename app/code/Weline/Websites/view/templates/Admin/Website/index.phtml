<?php
/**
 * 网站管理：左树（Website→Store→Channel）+ 右编辑（对齐分类管理）
 *
 * @var \Weline\Framework\View\Template $this
 * @var list<array<string,mixed>> $scope_tree
 * @var string $search
 * @var string $selected_node
 * @var string $editor_kind
 * @var bool $editor_acl_ok
 * @var string $editor_error
 * @var int $editor_website_id
 * @var int $editor_store_id
 * @var int $editor_channel_id
 * @var string $focus
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : (string)json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$searchValue = trim((string)($search ?? ''));
$selectedNode = (string)($selected_node ?? '');
$editorKind = (string)($editor_kind ?? '');
$editorAclOk = (bool)($editor_acl_ok ?? false);
$editorError = (string)($editor_error ?? '');
$tree = is_array($scope_tree ?? null) ? $scope_tree : [];
$focusValue = trim((string)($focus ?? ''));
$template = $this;

$treeUrl = static function (array $params = []) use ($template, $searchValue, $focusValue): string {
    $query = [];
    $search = array_key_exists('search', $params) ? $params['search'] : $searchValue;
    $focus = array_key_exists('focus', $params) ? $params['focus'] : $focusValue;
    if (is_string($search) && $search !== '') {
        $query['search'] = $search;
    }
    if (is_string($focus) && $focus !== '') {
        $query['focus'] = $focus;
    }
    foreach (['node', 'new'] as $key) {
        if (!array_key_exists($key, $params)) {
            continue;
        }
        $value = $params[$key];
        if ($value === null || $value === '') {
            continue;
        }
        $query[$key] = (string)$value;
    }
    $base = (string)$template->getUrl('*/admin/website/index');
    return $query === [] ? $base : ($base . '?' . http_build_query($query));
};

$renderItems = null;
$renderTree = function (array $nodes) use (&$renderItems): void {
    if ($nodes === []) {
        return;
    }
    echo '<ul class="w-tree" role="group">';
    $renderItems($nodes);
    echo '</ul>';
};

$renderItems = function (array $nodes) use (&$renderItems, $escape, $selectedNode, $treeUrl): void {
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        $kind = (string)($node['kind'] ?? '');
        $id = (int)($node['id'] ?? 0);
        $key = (string)($node['node'] ?? ($kind . ':' . $id));
        $name = (string)($node['name'] ?? '');
        $code = (string)($node['code'] ?? '');
        $logo = trim((string)($node['logo'] ?? ''));
        $aclOk = (bool)($node['acl_ok'] ?? false);
        $children = is_array($node['children'] ?? null) ? $node['children'] : [];
        $hasChildren = $children !== [];
        $showAddStore = $kind === 'website' && $aclOk;
        $showAddChannel = $kind === 'store' && $aclOk;
        $hasGroup = $hasChildren || $showAddStore || $showAddChannel;
        $isSelected = $selectedNode === $key;
        $icon = $kind === 'website' ? 'globe' : ($kind === 'store' ? 'store' : 'branch');
        $rowState = $isSelected ? 'selected' : ($aclOk ? 'idle' : 'locked');

        echo '<li class="w-catalog-tree__item" data-scope-node data-kind="' . $escape($kind) . '" data-id="' . $id . '" role="treeitem"'
            . ($hasGroup ? ' aria-expanded="true"' : '') . '>';
        echo '<div class="w-tree__row w-catalog-tree__row" data-state="' . $escape($rowState) . '">';
        if ($hasGroup) {
            echo '<button class="w-catalog-tree__toggle" type="button" data-w-tree-toggle aria-label="'
                . $escape(__('折叠/展开')) . '"><w-icon name="chevron-right" size="sm"></w-icon></button>';
        } else {
            echo '<span class="w-catalog-tree__toggle w-catalog-tree__toggle--spacer" aria-hidden="true"></span>';
        }
        echo '<a class="w-catalog-tree__link" href="' . $escape($treeUrl(['node' => $key])) . '"'
            . ($isSelected ? ' aria-current="page"' : '') . '>';
        // Logo 在范围徽章前（对齐分类树 thumb）；无 Logo 时保留 kind 图标
        if ($logo !== '') {
            echo '<img class="w-catalog-tree__thumb" src="' . $escape($logo) . '" alt="" width="20" height="20" loading="lazy"'
                . ' data-testid="websites-scope-tree-logo">';
        } else {
            echo '<w-icon name="' . $escape($icon) . '" size="sm"></w-icon>';
        }
        echo '<span>' . $escape($name !== '' ? $name : $code) . '</span>';
        if ($code !== '') {
            echo '<span class="w-badge" data-tone="neutral" data-testid="websites-scope-tree-scope">' . $escape($code) . '</span>';
        }
        if (!$aclOk) {
            echo '<span class="w-badge" data-tone="warning">' . $escape(__('只读')) . '</span>';
        }
        echo '</a></div>';

        if ($hasGroup) {
            echo '<ul class="w-tree" role="group">';
            if ($showAddStore) {
                echo '<li class="w-catalog-tree__action-item" role="none">'
                    . '<a class="w-catalog-tree__add" href="' . $escape($treeUrl(['node' => $key, 'new' => 'store'])) . '">'
                    . '<w-icon name="plus" size="sm"></w-icon>' . $escape(__('新建商店')) . '</a></li>';
            }
            if ($showAddChannel) {
                echo '<li class="w-catalog-tree__action-item" role="none">'
                    . '<a class="w-catalog-tree__add" href="' . $escape($treeUrl(['node' => $key, 'new' => 'channel'])) . '">'
                    . '<w-icon name="plus" size="sm"></w-icon>' . $escape(__('新建渠道')) . '</a></li>';
            }
            if ($hasChildren) {
                $renderItems($children);
            }
            echo '</ul>';
        }
        echo '</li>';
    }
};

$editorTitle = match ($editorKind) {
    'website' => __('编辑网站'),
    'store' => __('编辑商店'),
    'channel' => __('编辑渠道'),
    'new_store' => __('新建商店'),
    'new_channel' => __('新建渠道'),
    default => __('范围编辑'),
};
$editorTitle = (string)($editor_title ?? $editorTitle);
?>
