<js:part name="w-delete"/>

<script>
(function() {
    'use strict';

    var guideToggle = document.getElementById('weline-websites-guide-toggle');
    if (guideToggle) {
        guideToggle.addEventListener('click', function() {
            var body = document.getElementById('weline-websites-guide-body');
            var icon = document.getElementById('weline-websites-guide-icon');
            if (body && icon) {
                body.classList.toggle('show');
                var expanded = body.classList.contains('show');
                guideToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        });
    }

    var searchForm = document.getElementById('search-form');
    var searchInput = document.getElementById('search-input');
    if (searchForm && searchInput) {
        searchForm.addEventListener('submit', function(event) {
            event.preventDefault();
            var currentParams = new URLSearchParams(window.location.search);
            var pageSize = currentParams.get('pageSize') || '10';
            var params = new URLSearchParams();
            params.append('page', '1');
            params.append('pageSize', pageSize);
            var searchValue = searchInput.value.trim();
            if (searchValue) {
                params.append('search', searchValue);
            }
            window.location.assign(searchForm.action + '?' + params.toString());
        });
    }

})();
</script>
