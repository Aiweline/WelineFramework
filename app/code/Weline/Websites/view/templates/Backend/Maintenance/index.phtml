<script>
(function() {
    'use strict';

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-maintenance-action="toggle"]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            return;
        }
        var websiteId = parseInt(trigger.getAttribute('data-website-id') || '-1', 10);
        var websiteCode = trigger.getAttribute('data-website-code') || '';
        var enabled = trigger.getAttribute('data-maintenance-enabled') === '1';
        if (websiteId < 0 || !websiteCode) {
            return;
        }
        trigger.disabled = true;
        var scope = {
            scope_kind: 'website',
            website_id: websiteId,
            website_code: websiteCode,
            store_code: null,
            channel_code: null,
            store_mode: null,
            context_version: 'v1'
        };
        Promise.resolve(window.Weline.Api.resource('websiteMaintenance').set({
            scope: scope,
            enabled: enabled,
            reason: ''
        }, { keepBusinessResult: true, silent: true })).then(function(response) {
            var result = response && response.data ? response.data : response;
            if (!result || result.success === false) {
                throw new Error((result && result.message) || '<?= addslashes((string) __('更新失败')) ?>');
            }
            if (window.BackendToast && typeof window.BackendToast.success === 'function') {
                window.BackendToast.success('<?= addslashes((string) __('维护模式状态已更新')) ?>');
            }
            window.location.reload();
        }).catch(function(error) {
            trigger.disabled = false;
            if (window.BackendToast && typeof window.BackendToast.error === 'function') {
                window.BackendToast.error(error && error.message ? error.message : '<?= addslashes((string) __('更新失败')) ?>');
            }
        });
    });
})();
</script>
