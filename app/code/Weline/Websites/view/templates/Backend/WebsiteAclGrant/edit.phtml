<?php
/** @var \Weline\Framework\View\Template $this */
$website = is_array($this->getData('website')) ? $this->getData('website') : [];
$websiteId = max(0, (int)($this->getData('website_id') ?: ($website['website_id'] ?? $website['id'] ?? 0)));
$websiteName = trim((string)($website['website_name'] ?? $website['name'] ?? ''));
$websiteCode = trim((string)($website['website_code'] ?? $website['code'] ?? ''));
if ($websiteName === '') {
    $websiteName = (string)__('网站 #%{1}', [$websiteId]);
}
$contextName = $websiteCode !== '' ? (string)__('默认站授权目录') . ' · ' . $websiteCode : (string)__('默认站授权目录');
?>
<?= $this->fetch('Weline_Acl::templates/Backend/Acl/Role/assign.phtml', [
    'assignment_mode' => 'website',
    'assignment_action' => (string)$this->getData('action'),
    'assignment_identifier_name' => 'website_id',
    'assignment_identifier_value' => $websiteId,
    'assignment_title' => (string)__('网站功能授权'),
    'assignment_description' => (string)__('只向子站开放实际需要的菜单、接口、任务与运维能力。'),
    'assignment_back_url' => $this->getBackendUrl('*/backend/website-acl-grant/index'),
    'assignment_back_label' => (string)__('返回网站列表'),
    'assignment_subject_label' => (string)__('授权网站'),
    'assignment_subject_name' => $websiteName,
    'assignment_subject_icon' => 'globe',
    'assignment_context_label' => (string)__('授权来源'),
    'assignment_context_name' => $contextName,
    'assignment_context_icon' => 'shield',
]) ?>
