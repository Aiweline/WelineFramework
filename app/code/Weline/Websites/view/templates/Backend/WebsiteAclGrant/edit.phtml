<script src='@static(Weline_Acl::libs/vakata-jstree-3.3.14-0/dist/jstree.min.js)'></script>
<script>
(function() {
    'use strict';

    window.__aclSharedSourceIds = new Set(<?php echo json_encode(array_values($this->getData('selected_source_ids') ?: []), JSON_UNESCAPED_UNICODE); ?>);
    window.__aclTagGrants = new Set(<?php echo json_encode(array_values($this->getData('tag_grants') ?: []), JSON_UNESCAPED_UNICODE); ?>);
    window.__aclTagPathLeaves = <?php echo json_encode($this->getData('tag_path_leaves') ?: [], JSON_UNESCAPED_UNICODE); ?>;
    window.__aclSyncing = false;
    window.__aclActiveView = 'menu';

    var searchTimeout = null;
    var totalPermissions = <?php echo $totalAll; ?>;
    var initialSelected = <?php echo json_encode(array_values($this->getData('selected_source_ids') ?: []), JSON_UNESCAPED_UNICODE); ?>;
    var initialTagGrants = <?php echo json_encode(array_values($this->getData('tag_grants') ?: []), JSON_UNESCAPED_UNICODE); ?>;

    var jstreeCommon = {
        core: {
            themes: { variant: 'large', responsive: true },
            animation: 150
        },
        checkbox: {
            keep_selected_style: false,
            three_state: true,
            cascade: 'up'
        },
        search: {
            show_only_matches: true,
            show_only_matches_children: true,
            search_leaves_only: false,
            fuzzy: true
        },
        plugins: ['wholerow', 'checkbox', 'search']
    };

    function activeTreeSelector() {
        return window.__aclActiveView === 'tag' ? '#acl-tag' : '#acl';
    }

    function activeTree() {
        return $(activeTreeSelector()).jstree(true);
    }

    function isTagNodeId(id) {
        return String(id || '').indexOf('tag:') === 0;
    }

    function tagPathFromId(id) {
        return String(id || '').slice(4);
    }

    function updateStatistics() {
        var shared = window.__aclSharedSourceIds || new Set();
        var selectedCount = shared.size;
        var percent = totalPermissions > 0 ? Math.round((selectedCount / totalPermissions) * 100) : 0;
        $('#stat-selected').text(selectedCount);
        $('#stat-percent').text(percent + '%');
        $('#stat-progress').css('width', percent + '%');
    }

    function addLeavesToShared(path) {
        var leaves = (window.__aclTagPathLeaves && window.__aclTagPathLeaves[path]) || [];
        leaves.forEach(function(id) { window.__aclSharedSourceIds.add(id); });
        return leaves;
    }

    function removeLeavesFromShared(path) {
        var leaves = (window.__aclTagPathLeaves && window.__aclTagPathLeaves[path]) || [];
        leaves.forEach(function(id) { window.__aclSharedSourceIds.delete(id); });
        return leaves;
    }

    function removeTagGrantsForPath(path) {
        var next = new Set();
        window.__aclTagGrants.forEach(function(p) {
            if (p === path || String(p).indexOf(path + ':') === 0) {
                return;
            }
            next.add(p);
        });
        window.__aclTagGrants = next;
    }

    function removeTagGrantsCoveringLeaf(sourceId) {
        var next = new Set();
        window.__aclTagGrants.forEach(function(path) {
            var leaves = (window.__aclTagPathLeaves && window.__aclTagPathLeaves[path]) || [];
            if (leaves.indexOf(sourceId) >= 0) {
                return;
            }
            next.add(path);
        });
        window.__aclTagGrants = next;
    }

    function rebuildTagGrantsFromTree() {
        var tree = $('#acl-tag').jstree(true);
        var grants = new Set();
        if (!tree) {
            window.__aclTagGrants = grants;
            return;
        }
        tree.get_selected().forEach(function(id) {
            if (isTagNodeId(id)) {
                grants.add(tagPathFromId(id));
            }
        });
        window.__aclTagGrants = grants;
        grants.forEach(function(path) { addLeavesToShared(path); });
    }

    function syncMenuTreeFromShared() {
        var tree = $('#acl').jstree(true);
        if (!tree) return;
        window.__aclSyncing = true;
        try {
            var selected = tree.get_selected();
            selected.forEach(function(id) {
                if (!window.__aclSharedSourceIds.has(id)) {
                    tree.deselect_node(id, true);
                }
            });
            window.__aclSharedSourceIds.forEach(function(id) {
                if (tree.get_node(id) && !tree.is_selected(id)) {
                    tree.select_node(id, true, true);
                }
            });
        } finally {
            window.__aclSyncing = false;
        }
    }

    function syncTagTreeFromShared() {
        var tree = $('#acl-tag').jstree(true);
        if (!tree) return;
        window.__aclSyncing = true;
        try {
            tree.deselect_all(true);
            window.__aclSharedSourceIds.forEach(function(id) {
                if (tree.get_node(id)) {
                    tree.select_node(id, true, true);
                }
            });
            window.__aclTagGrants.forEach(function(path) {
                var id = 'tag:' + path;
                if (tree.get_node(id)) {
                    tree.select_node(id, true, true);
                }
                addLeavesToShared(path);
            });
        } finally {
            window.__aclSyncing = false;
        }
    }

    function applyMenuDeselectCascade(tree, node) {
        if (node.parent !== '#') {
            var parentNode = tree.get_node(node.parent);
            var hasSelectedChildren = parentNode.children.some(function(childId) {
                return tree.is_selected(childId);
            });
            if (!hasSelectedChildren) {
                tree.deselect_node(parentNode);
            }
        }
        if (node.children.length > 0) {
            node.children.forEach(function(childId) {
                tree.deselect_node(childId);
            });
        }
    }

    $('#acl').jstree(jstreeCommon);
    $('#acl-tag').jstree(jstreeCommon);

    $('#acl').on('ready.jstree', function() {
        updateStatistics();
    });

    $('#acl-tag').on('ready.jstree', function() {
        syncTagTreeFromShared();
        updateStatistics();
    });

    $('#acl').on('select_node.jstree', function(e, data) {
        if (window.__aclSyncing) return;
        if (!isTagNodeId(data.node.id)) {
            window.__aclSharedSourceIds.add(data.node.id);
        }
        updateStatistics();
    });

    $('#acl').on('deselect_node.jstree', function(e, data) {
        if (window.__aclSyncing) return;
        var tree = $('#acl').jstree(true);
        var node = data.node;
        applyMenuDeselectCascade(tree, node);
        if (!isTagNodeId(node.id)) {
            window.__aclSharedSourceIds.delete(node.id);
        }
        // also drop any still-deselected children from shared
        (node.children_d || []).forEach(function(id) {
            if (!isTagNodeId(id) && tree && !tree.is_selected(id)) {
                window.__aclSharedSourceIds.delete(id);
            }
        });
        updateStatistics();
    });

    $('#acl-tag').on('select_node.jstree', function(e, data) {
        if (window.__aclSyncing) return;
        var id = data.node.id;
        if (isTagNodeId(id)) {
            var path = tagPathFromId(id);
            window.__aclTagGrants.add(path);
            addLeavesToShared(path);
        } else {
            window.__aclSharedSourceIds.add(id);
        }
        updateStatistics();
    });

    $('#acl-tag').on('deselect_node.jstree', function(e, data) {
        if (window.__aclSyncing) return;
        var tree = $('#acl-tag').jstree(true);
        var node = data.node;
        var id = node.id;

        if (isTagNodeId(id)) {
            var path = tagPathFromId(id);
            // D-1: cancel tag = remove ALL leaves under this tag path prefix
            removeTagGrantsForPath(path);
            removeLeavesFromShared(path);
            if (node.children.length > 0) {
                node.children.forEach(function(childId) {
                    tree.deselect_node(childId);
                });
            }
        } else {
            window.__aclSharedSourceIds.delete(id);
            removeTagGrantsCoveringLeaf(id);
            applyMenuDeselectCascade(tree, node);
        }
        updateStatistics();
    });

    $('#acl-view-menu').on('click', function() {
        // flush tag tree into shared/grants before leaving
        rebuildTagGrantsFromTree();
        $('#acl-tag').jstree(true) && $('#acl-tag').jstree('get_selected').forEach(function(id) {
            if (!isTagNodeId(id)) window.__aclSharedSourceIds.add(id);
        });
        window.__aclActiveView = 'menu';
        $('#acl-menu-panel').show();
        $('#acl-tag-panel').hide();
        $(this).addClass('active');
        $('#acl-view-tag').removeClass('active');
        syncMenuTreeFromShared();
        updateStatistics();
        applyFilters();
    });

    $('#acl-view-tag').on('click', function() {
        // flush menu tree selection into shared
        var menuTree = $('#acl').jstree(true);
        if (menuTree) {
            var visibleIds = {};
            $('#acl li').each(function() { visibleIds[this.id] = true; });
            menuTree.get_selected().forEach(function(id) {
                if (!isTagNodeId(id)) window.__aclSharedSourceIds.add(id);
            });
            window.__aclSharedSourceIds.forEach(function(id) {
                if (visibleIds[id] && !menuTree.is_selected(id)) {
                    window.__aclSharedSourceIds.delete(id);
                }
            });
        }
        window.__aclActiveView = 'tag';
        $('#acl-menu-panel').hide();
        $('#acl-tag-panel').show();
        $(this).addClass('active');
        $('#acl-view-menu').removeClass('active');
        syncTagTreeFromShared();
        updateStatistics();
        applyFilters();
    });

    $('#save_button').on('click', function() {
        var shared = window.__aclSharedSourceIds || new Set(initialSelected);
        var menuTree = $('#acl').jstree(true);
        var tagTree = $('#acl-tag').jstree(true);

        if (menuTree) {
            menuTree.get_selected().forEach(function(id) {
                if (!isTagNodeId(id)) shared.add(id);
            });
            var menuVisible = {};
            $('#acl li').each(function() { menuVisible[this.id] = true; });
            shared.forEach(function(id) {
                if (menuVisible[id] && !menuTree.is_selected(id)) {
                    shared.delete(id);
                }
            });
        }

        if (tagTree) {
            tagTree.get_selected().forEach(function(id) {
                if (!isTagNodeId(id)) shared.add(id);
            });
            var tagVisibleLeaves = {};
            $('#acl-tag li[data-node-kind="leaf"]').each(function() { tagVisibleLeaves[this.id] = true; });
            shared.forEach(function(id) {
                if (tagVisibleLeaves[id] && !tagTree.is_selected(id)) {
                    shared.delete(id);
                }
            });
            rebuildTagGrantsFromTree();
            window.__aclTagGrants.forEach(function(path) {
                ((window.__aclTagPathLeaves && window.__aclTagPathLeaves[path]) || []).forEach(function(id) {
                    shared.add(id);
                });
            });
        }

        window.__aclSharedSourceIds = shared;

        $('#aclForm input[name="ids[]"]').remove();
        $('#aclForm input[name="tag_paths[]"]').remove();
        shared.forEach(function(id) {
            $('#aclForm').append('<input type="hidden" name="ids[]" value="' + id + '">');
        });
        (window.__aclTagGrants || new Set(initialTagGrants)).forEach(function(path) {
            $('#aclForm').append('<input type="hidden" name="tag_paths[]" value="' + path + '">');
        });

        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> <?php echo __("保存中..."); ?>');
        setTimeout(function() {
            $btn.closest('form').submit();
        }, 100);
    });

    function runSearch(searchVal) {
        var sel = activeTreeSelector();
        if (searchVal.length > 0) {
            $(sel).jstree('search', searchVal);
        } else {
            $(sel).jstree('clear_search');
            $('#acl-search-result').removeClass('visible');
        }
    }

    $('#acl-search').on('keyup', function() {
        var searchVal = $(this).val().trim();
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() { runSearch(searchVal); }, 300);
    });

    $('#acl, #acl-tag').on('search.jstree', function(e, data) {
        var count = data.nodes.length;
        var $result = $('#acl-search-result');
        var $text = $('#acl-search-result-text');
        if (count > 0) {
            $text.text('<?php echo __("找到"); ?> ' + count + ' <?php echo __("个匹配权限"); ?>');
            $result.addClass('visible');
        } else if ($('#acl-search').val().trim().length > 0) {
            $text.text('<?php echo __("未找到匹配的权限，请尝试其他关键词"); ?>');
            $result.addClass('visible');
        }
    });

    $('#acl, #acl-tag').on('clear_search.jstree', function() {
        $('#acl-search-result').removeClass('visible');
    });

    $('#acl-search-clear').on('click', function() {
        $('#acl-search').val('').focus();
        $('#acl').jstree('clear_search');
        $('#acl-tag').jstree('clear_search');
        $('#acl-search-result').removeClass('visible');
    });

    $('#acl-select-all').on('click', function() {
        var sel = activeTreeSelector();
        $(sel).jstree('select_all');
        if (sel === '#acl-tag') {
            rebuildTagGrantsFromTree();
            $('#acl-tag').jstree('get_selected').forEach(function(id) {
                if (!isTagNodeId(id)) window.__aclSharedSourceIds.add(id);
            });
        } else {
            $('#acl').jstree('get_selected').forEach(function(id) {
                if (!isTagNodeId(id)) window.__aclSharedSourceIds.add(id);
            });
        }
        updateStatistics();
        if (typeof BackendToast !== 'undefined') {
            BackendToast.info('<?php echo __("已全选所有权限"); ?>');
        }
    });

    $('#acl-deselect-all').on('click', function() {
        var sel = activeTreeSelector();
        $(sel).jstree('deselect_all');
        if (sel === '#acl-tag') {
            // clear tag grants and their leaves; keep menu-only shared ids not in tag tree
            var tagLeafIds = {};
            $('#acl-tag li[data-node-kind="leaf"]').each(function() { tagLeafIds[this.id] = true; });
            Object.keys(tagLeafIds).forEach(function(id) { window.__aclSharedSourceIds.delete(id); });
            window.__aclTagGrants = new Set();
        } else {
            var menuIds = {};
            $('#acl li').each(function() { menuIds[this.id] = true; });
            Object.keys(menuIds).forEach(function(id) {
                if (!isTagNodeId(id)) window.__aclSharedSourceIds.delete(id);
            });
        }
        updateStatistics();
        if (typeof BackendToast !== 'undefined') {
            BackendToast.info('<?php echo __("已清空所有选择"); ?>');
        }
    });

    $('#acl-expand-all').on('click', function() {
        $(activeTreeSelector()).jstree('open_all');
    });

    $('#acl-collapse-all').on('click', function() {
        $(activeTreeSelector()).jstree('close_all');
    });

    function applyFilters() {
        var moduleApi = window.WelineModuleSelect && window.WelineModuleSelect['acl-filter-module'];
        var moduleFilter = moduleApi
            ? String(moduleApi.getValue() || '')
            : String($('#acl-filter-module').val() || '');
        var typeFilter = String($('#acl-filter-type').val() || '');
        var tree = activeTree();
        if (!tree) return;
        var rootSel = activeTreeSelector();
        var hasFilter = !!(moduleFilter || typeFilter);

        if (rootSel === '#acl-tag') {
            applyTagFilters(tree, moduleFilter, typeFilter, hasFilter);
        } else {
            applyMenuFilters(tree, moduleFilter, typeFilter, hasFilter);
        }
    }

    // 菜单维度：按顶层分组（li[data-module]）进行模块/类型过滤
    function applyMenuFilters(tree, moduleFilter, typeFilter, hasFilter) {
        var visibleCount = 0;
        $('#acl li[data-module]').each(function() {
            var $node = $(this);
            var nodeModule = $node.attr('data-module') || '';
            var nodeType = $node.attr('data-type') || '';
            var nodeId = $node.attr('id');
            var moduleMatch = !moduleFilter || nodeModule.indexOf(moduleFilter) !== -1;
            var typeMatch = !typeFilter || nodeType === typeFilter;
            if (moduleMatch && typeMatch) {
                tree.show_node(nodeId);
                visibleCount++;
            } else {
                tree.hide_node(nodeId);
            }
        });
        if (hasFilter && typeof BackendToast !== 'undefined') {
            BackendToast.info('<?php echo __("筛选结果"); ?>: ' + visibleCount + ' <?php echo __("个分组"); ?>');
        }
    }

    // 标签维度：先按模块/类型过滤叶子，再按“是否含可见叶子”上卷父标签节点
    function applyTagFilters(tree, moduleFilter, typeFilter, hasFilter) {
        var leafVisible = 0;
        $('#acl-tag li[data-node-kind="leaf"]').each(function() {
            var $leaf = $(this);
            var nodeModule = $leaf.attr('data-module') || '';
            var nodeType = $leaf.attr('data-type') || '';
            var nodeId = this.id;
            var moduleMatch = !moduleFilter || nodeModule.indexOf(moduleFilter) !== -1;
            var typeMatch = !typeFilter || nodeType === typeFilter;
            if (moduleMatch && typeMatch) {
                tree.show_node(nodeId);
                leafVisible++;
            } else {
                tree.hide_node(nodeId);
            }
        });
        // 标签父节点：只要其下仍有可见叶子就显示，否则隐藏（支持多级标签）
        $('#acl-tag li[data-node-kind="tag"]').each(function() {
            var $tag = $(this);
            var hasVisibleLeaf = $tag.find('li[data-node-kind="leaf"]').filter(function() {
                return !$(this).hasClass('jstree-hidden');
            }).length > 0;
            if (hasVisibleLeaf) {
                tree.show_node(this.id);
            } else {
                tree.hide_node(this.id);
            }
        });
        if (hasFilter && typeof BackendToast !== 'undefined') {
            BackendToast.info('<?php echo __("筛选结果"); ?>: ' + leafVisible + ' <?php echo __("项权限"); ?>');
        }
    }

    window.__aclApplyFilters = applyFilters;

    $('#acl-filter-module, #acl-filter-type').on('change', function() {
        applyFilters();
    });

    $(document).on('keydown', function(e) {
        if (e.ctrlKey || e.metaKey) {
            if (e.key === 'f' || e.key === 'F') {
                e.preventDefault();
                $('#acl-search').focus();
            } else if (e.key === 's' || e.key === 'S') {
                e.preventDefault();
                $('#save_button').click();
            }
        }
    });
})();
</script>
