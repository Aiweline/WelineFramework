<?php
/**
 * @var \Weline\Framework\View\Template $this
 */
$website = $this->getData('website') ?: [];
$websiteId = (int)$this->getData('website_id');
$trees = $this->getData('trees') ?: [];
$selected = $this->getData('selected_source_ids') ?: [];
$selectedSet = array_fill_keys(array_map('strval', $selected), true);
$action = (string)$this->getData('action');

$renderNode = function ($node, int $depth = 0) use (&$renderNode, $selectedSet): string {
    $sourceId = (string)$node->getSourceId();
    $name = (string)$node->getSourceName();
    $checked = isset($selectedSet[$sourceId]) ? ' checked' : '';
    $pad = max(0, $depth) * 18;
    $html = '<label class="d-block py-1" style="padding-left:' . $pad . 'px">'
        . '<input type="checkbox" name="ids[]" value="' . htmlspecialchars($sourceId, ENT_QUOTES, 'UTF-8') . '"' . $checked . '> '
        . htmlspecialchars($name !== '' ? $name : $sourceId)
        . ' <small class="text-muted">' . htmlspecialchars($sourceId) . '</small>'
        . '</label>';
    foreach ($node->getSub() ?: [] as $sub) {
        $html .= $renderNode($sub, $depth + 1);
    }
    return $html;
};
?>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0"><lang>编辑网站功能授权</lang></h4>
            <div class="text-muted">
                <?= htmlspecialchars((string)($website['name'] ?? '')) ?>
                <code><?= htmlspecialchars((string)($website['code'] ?? '')) ?></code>
                #<?= $websiteId ?>
            </div>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="@backend-url('*/backend/website-acl-grant/index')">
            <i class="mdi mdi-arrow-left"></i> <lang>返回列表</lang>
        </a>
    </div>

    <form method="post" action="<?= htmlspecialchars($action) ?>">
        <input type="hidden" name="website_id" value="<?= $websiteId ?>">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span><lang>菜单 / 控制器资源</lang></span>
                <span class="text-muted small"><lang>勾选后保存为该站授权包上限</lang></span>
            </div>
            <div class="card-body" style="max-height: 70vh; overflow: auto;">
                <?php if ($trees === []): ?>
                    <p class="text-muted mb-0"><lang>暂无 ACL 资源</lang></p>
                <?php else: ?>
                    <?php foreach ($trees as $tree): ?>
                        <?= $renderNode($tree) ?>
                    <?php endforeach; ?>
                <?php endif; ?>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="mdi mdi-content-save"></i> <lang>保存授权</lang>
            </button>
            <a class="btn btn-outline-secondary" href="@backend-url('*/backend/website-acl-grant/index')"><lang>取消</lang></a>
        </div>
    </form>
</div>
