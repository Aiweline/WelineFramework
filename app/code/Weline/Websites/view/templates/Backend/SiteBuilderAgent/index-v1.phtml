    var st={draftId:'',planConfirmed:false,planBusy:false,planSse:null,recSse:null,recDomain:'',poolId:0,poolDomain:'',selectedDomain:'',selectedSource:''};
    function toast(t,m){if(window.Weline.UI.toast&&typeof window.Weline.UI.toast[t]==='function'){window.Weline.UI.toast[t](String(m||''));return;}console[t==='error'?'error':'log'](m);}
    function byId(id){return document.getElementById(id);}
    function setStatus(id,text,kind){var n=byId(id);if(!n)return;n.textContent=String(text||'');n.className='sbv1-status'+(kind?(' '+kind):'');}
    function setDisabled(id,disabled){var n=byId(id);if(!n)return;n.disabled=!!disabled;}
    function setPlanModalBusy(busy){
        st.planBusy=!!busy;
        var modal=byId('sbv1-plan-modal');
        if(modal){
            modal.setAttribute('data-plan-busy',st.planBusy?'1':'0');
            modal.setAttribute('aria-busy',st.planBusy?'true':'false');
        }
        setDisabled('sbv1-plan-close',st.planBusy);
        setDisabled('sbv1-revise',st.planBusy);
        setDisabled('sbv1-confirm-plan',st.planBusy);
        setDisabled('sbv1-revise-msg',st.planBusy);
        setDisabled('sbv1-generate',st.planBusy);
    }
    function post(url,p){var body=new URLSearchParams();Object.keys(p||{}).forEach(function(k){if(p[k]!==undefined&&p[k]!==null){body.append(k,String(p[k]));}});return siteBuilderWorkbenchRequest(url,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:body.toString()}).then(function(r){return r.json();}).catch(function(err){var msg=(err&&err.payload&&err.payload.message)?String(err.payload.message):((err&&err.message)?String(err.message):'网络错误，请稍后重试。');return {success:false,message:msg,_network:true,error:err};});}
    function get(url){return siteBuilderWorkbenchRequest(url,{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(r){return r.json();}).catch(function(err){var msg=(err&&err.payload&&err.payload.message)?String(err.payload.message):((err&&err.message)?String(err.message):'网络错误，请稍后重试。');return {success:false,message:msg,_network:true,error:err};});}
    function parse(e){if(!e||typeof e.data!=='string'||e.data===''){return {};}try{return JSON.parse(e.data);}catch(_){return {};}}
    function open(id){var m=byId(id);if(m)m.classList.add('open');}
    function close(id){
        if(id==='sbv1-plan-modal'&&st.planBusy){
            toast('warning','方案生成中，请等待完成后再关闭。');
            return;
        }
        var m=byId(id);if(m)m.classList.remove('open');
    }
    function refs(){return String((byId('sbv1-refs')||{}).value||'').trim();}
    function desc(){return String((byId('sbv1-desc')||{}).value||'').trim();}
    function account(){return String((byId('sbv1-account')||{}).value||'').trim();}
    function languageSelector(selectorId){
        var root=byId(selectorId+'_wrapper');
        return root&&window.Weline&&window.Weline.UI
            ? window.Weline.UI.get(root,'language-select')
            : null;
    }
    // WLS 拒绝 request-line 中的 %0A/%0D；GET SSE 只能传压缩后的种子，完整文案走 draft_public_id。
    function domainRecommendSeed(raw){
        var text=String(raw||'');
        var m=text.match(/\*\*项目名称\*\*\s*[:：]\s*([^\n*]+)/);
        if(!m){m=text.match(/\*\*Project name\*\*\s*[:：]\s*([^\n*]+)/i);}
        if(m&&m[1]){text=m[1];}
        text=text.replace(/[\u0000-\u001F\u007F]+/g,' ').replace(/\s+/g,' ').trim();
        if(text.length>400){text=text.slice(0,400);}
        return text;
    }
    function readLocale(selectorId,inputId){
        var sel=languageSelector(selectorId);
        if(sel&&typeof sel.getValue==='function'){
            var v=String(sel.getValue()||'').trim();
            if(v){return v;}
        }
        var el=byId(inputId);
        return el?String(el.value||'').trim():'';
    }
    function readLocales(selectorId,inputId){
        var sel=languageSelector(selectorId);
        if(sel&&typeof sel.getValues==='function'){
            var vals=sel.getValues();
            if(Array.isArray(vals)&&vals.length){
                return vals.map(function(v){return String(v||'').trim();}).filter(Boolean);
            }
        }
        var el=byId(inputId);
        if(el&&el.selectedOptions){
            return Array.prototype.slice.call(el.selectedOptions).map(function(option){
                return String(option.value||'').trim();
            }).filter(Boolean);
        }
        var raw=el?String(el.value||'').trim():'';
        if(!raw){return [];}
        return raw.split(/[\s,]+/).map(function(v){return String(v||'').trim();}).filter(Boolean);
    }
    function setLocale(selectorId,inputId,value){
        var code=String(value||'').trim();
        if(!code){return;}
        var sel=languageSelector(selectorId);
        if(sel&&typeof sel.setValue==='function'){sel.setValue(code);return;}
        var el=byId(inputId);
        if(el){el.value=code;el.dispatchEvent(new Event('change',{bubbles:true}));}
    }
    function setLocales(selectorId,inputId,values){
        var list=Array.isArray(values)?values.map(function(v){return String(v||'').trim();}).filter(Boolean):[];
        var sel=languageSelector(selectorId);
        if(sel&&typeof sel.setValues==='function'){sel.setValues(list);return;}
        var el=byId(inputId);
        if(el){
            Array.prototype.slice.call(el.options||[]).forEach(function(option){
                option.selected=list.indexOf(String(option.value||''))!==-1;
            });
            el.dispatchEvent(new Event('change',{bubbles:true}));
        }
    }
    function currentLanguagePayload(){
        var content=readLocale('sbv1-content-locale-select','sbv1-content-locale');
        var plan=readLocale('sbv1-plan-locale-select','sbv1-plan-locale');
        var codes=readLocales('sbv1-language-codes-select','sbv1-language-codes');
        if(content&&codes.indexOf(content)<0){codes=[content].concat(codes);}
        return {
            content_locale:content,
            default_locale:content,
            plan_locale:plan,
            language_codes:codes
        };
    }
    function setDraftStatus(text){var n=byId('sbv1-draft-status');if(n)n.textContent=String(text||'');}
    function formatDraftTime(ts){try{var d=new Date(ts||Date.now());if(isNaN(d.getTime()))return '';return d.toLocaleString();}catch(_){return '';}}
    function saveIntakeDraft(immediate){
        var langs=currentLanguagePayload();
        var payload={
            description:String((byId('sbv1-desc')||{}).value||''),
            reference_urls:String((byId('sbv1-refs')||{}).value||''),
            content_locale:langs.content_locale,
            plan_locale:langs.plan_locale,
            language_codes:langs.language_codes,
            draft_public_id:String(st.draftId||''),
            plan_confirmed:!!st.planConfirmed,
            saved_at:Date.now()
        };
        var write=function(){try{localStorage.setItem(DRAFT_KEY,JSON.stringify(payload));setDraftStatus('浏览器本地草稿已保存 · '+formatDraftTime(payload.saved_at));}catch(_){setDraftStatus('浏览器本地草稿保存失败（存储不可用）');}};
        if(immediate){if(draftTimer){clearTimeout(draftTimer);draftTimer=null;}write();return;}
        if(draftTimer)clearTimeout(draftTimer);
        setDraftStatus('浏览器本地草稿保存中…');
        draftTimer=setTimeout(function(){draftTimer=null;write();},250);
    }
    function restoreIntakeDraft(){
        try{
            var raw=localStorage.getItem(DRAFT_KEY);
            if(!raw){setDraftStatus('浏览器本地草稿：尚未保存');return;}
            var data=JSON.parse(raw);
            if(!data||typeof data!=='object')return;
            if(byId('sbv1-desc')&&typeof data.description==='string'){byId('sbv1-desc').value=data.description;}
            if(byId('sbv1-refs')&&typeof data.reference_urls==='string'){byId('sbv1-refs').value=data.reference_urls;}
            if(typeof data.content_locale==='string'&&data.content_locale){setLocale('sbv1-content-locale-select','sbv1-content-locale',data.content_locale);}
            if(typeof data.plan_locale==='string'&&data.plan_locale){setLocale('sbv1-plan-locale-select','sbv1-plan-locale',data.plan_locale);}
            if(Array.isArray(data.language_codes)&&data.language_codes.length){setLocales('sbv1-language-codes-select','sbv1-language-codes',data.language_codes);}
            if(typeof data.draft_public_id==='string'&&data.draft_public_id){st.draftId=String(data.draft_public_id);}
            st.planConfirmed=!!data.plan_confirmed&&!!st.draftId;
            // 已确认方案后刷新页面：自动回到选域名步骤，避免“都到这里了却说没确认”
            if(st.planConfirmed){open('sbv1-domain-modal');}
            setDraftStatus((desc()||refs()||st.draftId)?'已恢复浏览器本地草稿 · '+formatDraftTime(data.saved_at):'浏览器本地草稿：尚未保存');
        }catch(_){setDraftStatus('浏览器本地草稿读取失败');}
    }
    function clearRequirement(){
        if(byId('sbv1-desc')){byId('sbv1-desc').value='';}
        saveIntakeDraft(true);
        setStatus('sbv1-main-status','需求已清空','');
        toast('success','已清空一句话需求，并同步到浏览器本地草稿。');
        if(byId('sbv1-desc')){byId('sbv1-desc').focus();}
    }
    function polishRequirement(){
        var text=desc();
        if(!text){toast('warning','请先输入一句话需求。');return;}
        setDisabled('sbv1-polish-desc',true);
        setDisabled('sbv1-clear-desc',true);
        setStatus('sbv1-main-status','正在润色需求','info');
        var done=function(){setDisabled('sbv1-polish-desc',false);setDisabled('sbv1-clear-desc',false);};
        var langs=currentLanguagePayload();
        var params={
            description:text,
            content_locale:langs.content_locale,
            plan_locale:langs.plan_locale,
            language_codes:langs.language_codes
        };
        if(cfg.fake){params.fake_mode='1';}
        var run=function(api){return api.resource('websites').polishSiteBrief(params,{requestTimeoutMs:180000});};
        var p=(window.Weline&&window.Weline.load)?window.Weline.load('api').then(run):Promise.resolve(run(window.Weline.Api));
        p.then(function(res){
            done();
            var body=res&&res.data&&typeof res.data.description==='string'?res.data:(res&&typeof res.description==='string'?res:null);
            var polished=body&&typeof body.description==='string'?String(body.description).trim():'';
            var ok=!!(res&&res.success!==false&&polished);
            if(!ok){var m=(res&&res.message)?String(res.message):'润色失败';setStatus('sbv1-main-status',m,'err');toast('error',m);return;}
            if(byId('sbv1-desc')){byId('sbv1-desc').value=polished;}
            saveIntakeDraft(true);
            setStatus('sbv1-main-status','需求已润色','ok');
            toast('success',(res&&res.message)?String(res.message):'润色完成');
        }).catch(function(err){
            done();
            var msg='网络错误，请稍后重试。';
            var biz=window.WelineApiBusiness||(window.Weline&&window.Weline.ApiBusiness);
            if(biz&&typeof biz.formatApiError==='function'){msg=biz.formatApiError(err,msg);}
            else if(err&&err.message){msg=String(err.message);}
            setStatus('sbv1-main-status',msg,'err');
            toast('error',msg);
        });
    }
    function addLog(text){var box=byId('sbv1-plan-log');if(!box||!text)return;var div=document.createElement('div');div.textContent=String(text);box.appendChild(div);box.scrollTop=box.scrollHeight;}
    function renderPlan(plan){if(!plan||typeof plan!=='object')return;byId('sbv1-plan-content').textContent=String(plan.plan_markdown||'');byId('sbv1-plan-meta').textContent='模式：'+String(plan.build_mode||'')+' | 页面：'+(Array.isArray(plan.page_types)?plan.page_types.join('、'):'');}

    // 后台页无 backend worker（HTTP/无安全上下文）时，用同域 fetch + ReadableStream 逐帧读取
    // 控制器 SSE，实现真正的边生成边显示；不再用 collect=1 缓冲整条流（否则长耗时会一直"连接中"）。
    // 若浏览器不支持流式读取，则回退到 collect 一次性拉取。
    function bqCollectSse(url, handlers){
        handlers=handlers||{};
        var base=String(url||'');
        var closed=false;
        var api={close:function(){closed=true;}};

        var dispatch=function(name,dataStr){
            if(closed) return;
            var fake={data: typeof dataStr==='string'?dataStr:JSON.stringify(dataStr==null?{}:dataStr)};
            if(typeof handlers[name]==='function'){ handlers[name](fake); }
            if(name==='error'&&typeof handlers.error==='function'){ handlers.error(fake); }
        };
        var emitFrame=function(frame){
            if(!frame) return;
            var name='message', dataLines=[];
            frame.split(/\r?\n/).forEach(function(line){
                if(line.indexOf('event:')===0){ name=line.slice(6).trim(); }
                else if(line.indexOf('data:')===0){ dataLines.push(line.slice(5).replace(/^ /,'')); }
            });
            dispatch(name, dataLines.join('\n'));
        };

        var runCollectFallback=function(){
            var u=base+(base.indexOf('?')>=0?'&':'?')+'collect=1&_ts='+Date.now();
            siteBuilderWorkbenchRequest(u,{method:'GET',credentials:'same-origin',headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}})
                .then(function(r){
                    return r.text().then(function(t){
                        var payload=null;
                        try{payload=t?JSON.parse(t):null;}catch(_){payload=null;}
                        if(!r.ok){
                            var msg=(payload&&payload.message)?String(payload.message):(t&&String(t).length<200?String(t).trim():('HTTP '+r.status));
                            throw new Error(msg||('HTTP '+r.status));
                        }
                        if(!payload){throw new Error((t&&String(t).length<200?String(t).trim():'')||'SSE collect returned non-JSON');}
                        return payload;
                    });
                })
                .then(function(payload){
                    if(closed) return;
                    ((payload&&payload.events)||[]).forEach(function(ev){
                        emitFrameData(String(ev&&ev.event||'message'), ev&&ev.data);
                    });
                    if(typeof handlers._done==='function'){ handlers._done(payload); }
                }).catch(function(err){
                    if(closed) return;
                    var msg=(err&&err.message)||'SSE collect failed';
                    if(/^Bad Request$/i.test(String(msg).trim())){msg='请求参数含非法字符或过长，请缩短需求描述后重试。';}
                    dispatch('error', JSON.stringify({message:msg}));
                });
        };
        var emitFrameData=function(name,data){
            dispatch(name, typeof data==='string'?data:JSON.stringify(data==null?{}:data));
        };

        var supportsStream=(typeof fetch==='function') && (typeof ReadableStream!=='undefined');
        if(!supportsStream){ runCollectFallback(); return api; }

        var u=base+(base.indexOf('?')>=0?'&':'?')+'_ts='+Date.now();
        siteBuilderWorkbenchRequest(u,{method:'GET',credentials:'same-origin',headers:{'Accept':'text/event-stream','X-Requested-With':'XMLHttpRequest'}})
            .then(function(r){
                if(!r.ok){
                    return r.text().then(function(t){
                        var msg=(t&&String(t).length<200&&String(t).indexOf('{')<0)?String(t).trim():('HTTP '+r.status);
                        throw new Error(msg||('HTTP '+r.status));
                    });
                }
                if(!r.body||typeof r.body.getReader!=='function'){ runCollectFallback(); return null; }
                var reader=r.body.getReader();
                var dec=new TextDecoder();
                var buf='';
                var pump=function(){
                    return reader.read().then(function(res){
                        if(closed){ try{reader.cancel();}catch(_){ } return; }
                        if(res.done){
                            buf+=dec.decode();
                            if(buf.trim()!==''){ buf.split(/\r?\n\r?\n/).forEach(emitFrame); }
                            if(typeof handlers._done==='function'){ handlers._done({}); }
                            return;
                        }
                        buf+=dec.decode(res.value,{stream:true});
                        var parts=buf.split(/\r?\n\r?\n/);
                        buf=parts.pop();
                        parts.forEach(emitFrame);
                        return pump();
                    });
                };
                return pump();
            })
            .catch(function(err){
                if(closed) return;
                var msg=String((err&&err.message)||'');
                // 400 Bad Request（如 query 含 %0A）再走 collect 仍会失败，直接报错
                if(/^Bad Request$/i.test(msg.trim()) || /^HTTP 400\b/.test(msg)){
                    dispatch('error', JSON.stringify({message:/^Bad Request$/i.test(msg.trim())?'请求参数含非法字符或过长，请缩短需求描述后重试。':msg}));
                    return;
                }
                // 流式失败时回退到 collect 再试一次
                runCollectFallback();
            });
        return api;
    }

    function closeSse(key){if(st[key]){try{st[key].close();}catch(_){ }st[key]=null;}}
    function runPlan(action){var langs=currentLanguagePayload();var url=action==='revise'?cfg.revise:cfg.gen;var msg=action==='revise'?String((byId('sbv1-revise-msg')||{}).value||'').trim():desc();if(action!=='revise'&&!msg){toast('warning','请先输入一句话需求。');return;}open('sbv1-plan-modal');setStatus('sbv1-main-status',action==='revise'?'正在修订方案':'正在生成方案','info');post(url,{provider_code:'websites_default',draft_public_id:st.draftId,description:desc(),message:msg,reference_urls:refs(),content_locale:langs.content_locale,plan_locale:langs.plan_locale,language_codes:(langs.language_codes||[]).join(',')}).then(function(d){if(!d||!d.success){toast('error',d&&d.message?d.message:'方案初始化失败');return;}st.draftId=String(d.draft_public_id||st.draftId||'');st.planConfirmed=false;saveIntakeDraft(true);if(d.draft&&d.draft.payload&&d.draft.payload.current_plan){renderPlan(d.draft.payload.current_plan);}byId('sbv1-plan-log').innerHTML='';closeSse('planSse');setStatus('sbv1-plan-stream-status','连接中','info');var s=(function(u){ var L={}; var api={close:function(){if(api._h)api._h.close();}, addEventListener:function(n,f){L[n]=f;}}; setTimeout(function(){ api._h=bqCollectSse(u, Object.assign({}, L, {_done:function(){}})); },0); return api; })(String(d.stream_url||''));st.planSse=s;s.addEventListener('start',function(ev){var p=parse(ev);addLog(p.message||'已开始');setStatus('sbv1-plan-stream-status','生成中','info');});s.addEventListener('status',function(ev){var p=parse(ev);addLog(p.message||'');});s.addEventListener('chunk',function(ev){var p=parse(ev);addLog(p.chunk||p.message||'');});s.addEventListener('warning',function(ev){var p=parse(ev);addLog(p.message||'');});s.addEventListener('plan_completed',function(ev){var p=parse(ev);if(p.plan){renderPlan(p.plan);}});s.addEventListener('done',function(ev){var p=parse(ev);if(p.plan){renderPlan(p.plan);}setStatus('sbv1-plan-stream-status',p.success===false?'失败':'已完成',p.success===false?'err':'ok');closeSse('planSse');});s.addEventListener('error',function(){setStatus('sbv1-plan-stream-status','连接重试中','info');});}).catch(function(){toast('error','网络错误，请稍后重试。');});
    }
    function confirmPlan(){if(st.planBusy){toast('warning','方案生成中，请等待完成后再确认。');return;}if(!st.draftId){toast('warning','请先生成方案。');return;}post(cfg.confirm,{draft_public_id:st.draftId}).then(function(d){if(!d||!d.success){toast('error',d&&d.message?d.message:'方案确认失败');return;}st.planConfirmed=true;saveIntakeDraft(true);setStatus('sbv1-main-status','方案已确认','ok');close('sbv1-plan-modal');open('sbv1-domain-modal');}).catch(function(err){toast('error',(err&&err.message)?String(err.message):'网络错误，请稍后重试。');});}
    function renderRec(list){var box=byId('sbv1-rec-list');if(!box)return;box.innerHTML='';(list||[]).forEach(function(domain){var btn=document.createElement('button');btn.type='button';btn.className='sbv1-item';btn.setAttribute('data-rec',String(domain));btn.textContent=String(domain);btn.onclick=function(){st.recDomain=String(domain);document.querySelectorAll('[data-rec]').forEach(function(n){n.classList.toggle('pick',String(n.getAttribute('data-rec')||'')===st.recDomain);});};box.appendChild(btn);});}
    function recommendDomain(){
        var seed=domainRecommendSeed(desc());
        if(!seed){toast('warning','请先输入一句话需求。');return;}
        // 推荐本身只依赖需求种子；draftId 丢失时仍可推荐，后续选域名/建会话再校验
        closeSse('recSse');
        renderRec([]);
        setStatus('sbv1-rec-status','推荐中','info');
        var params=new URLSearchParams();
        params.set('description',seed);
        if(st.draftId){params.set('draft_public_id',st.draftId);}
        params.set('account_id',account()||'0');
        if(cfg.fake){params.set('fake_mode','1');}
        var url=cfg.recSse+(cfg.recSse.indexOf('?')>=0?'&':'?')+params.toString();
        var s=(function(u){ var L={}; var api={close:function(){if(api._h)api._h.close();}, addEventListener:function(n,f){L[n]=f;}}; setTimeout(function(){ api._h=bqCollectSse(u, Object.assign({}, L, {_done:function(){}})); },0); return api; })(url);
        st.recSse=s;
        s.addEventListener('batch',function(ev){var p=parse(ev);if(Array.isArray(p.candidate_domains)){renderRec(p.candidate_domains);}setStatus('sbv1-rec-status',p.message||'推荐中','info');});
        s.addEventListener('success',function(ev){var p=parse(ev);if(Array.isArray(p.candidate_domains)){renderRec(p.candidate_domains);}if(p.domain){st.recDomain=String(p.domain);document.querySelectorAll('[data-rec]').forEach(function(n){n.classList.toggle('pick',String(n.getAttribute('data-rec')||'')===st.recDomain);});}setStatus('sbv1-rec-status',p.message||'推荐完成','ok');});
        s.addEventListener('done',function(){closeSse('recSse');});
        s.addEventListener('error',function(ev){var p=parse(ev);if(p&&p.message){setStatus('sbv1-rec-status',p.message,'err');toast('error',p.message);closeSse('recSse');return;}setStatus('sbv1-rec-status','连接重试中','info');});
    }
    function selectDomain(domain,source){if(!st.draftId){toast('warning','方案会话已丢失，请重新生成并确认方案后再保存域名。');return Promise.resolve(false);}return post(cfg.selectDomain,{draft_public_id:st.draftId,domain:domain,domain_source:source,account_id:account()}).then(function(d){if(!d||!d.success){toast('error',d&&d.message?d.message:'域名保存失败');return false;}st.selectedDomain=String(domain);st.selectedSource=String(source);byId('sbv1-domain-summary').textContent='已选择域名：'+st.selectedDomain+'（'+st.selectedSource+'）';return true;});}
    function checkManual(){var domain=String((byId('sbv1-manual-domain')||{}).value||'').trim().toLowerCase();if(!domain){toast('warning','请先输入域名。');return;}setStatus('sbv1-manual-status','校验中','info');post(cfg.check,{domain:domain,account_id:account()}).then(function(d){if(!d||!d.success||!d.available){setStatus('sbv1-manual-status',d&&d.message?d.message:'域名不可用','err');return;}setStatus('sbv1-manual-status',d.message||'域名可用','ok');}).catch(function(){setStatus('sbv1-manual-status','网络错误，请稍后重试。','err');});}
    function loadPool(){if(!st.draftId){toast('warning','方案会话已丢失，请重新生成并确认方案。');return;}setStatus('sbv1-pool-status','加载中','info');setDisabled('sbv1-use-pool-domain',true);st.poolId=0;st.poolDomain='';get(cfg.pool+'?draft_public_id='+encodeURIComponent(st.draftId)).then(function(d){var box=byId('sbv1-pool-list');if(!box)return;box.innerHTML='';if(!d||!d.success){setStatus('sbv1-pool-status',d&&d.message?d.message:'加载失败','err');return;}var items=Array.isArray(d.items)?d.items:[];if(!items.length){var empty=document.createElement('div');empty.className='text-muted small';empty.textContent='域名池暂无可用域名，请切换到“手动填写”或“AI 推荐”。';box.appendChild(empty);setStatus('sbv1-pool-status','暂无可用域名','warn');return;}items.forEach(function(item){var btn=document.createElement('button');btn.type='button';btn.className='sbv1-item';btn.setAttribute('data-pool-id',String(item.pool_id||'0'));btn.textContent=String(item.domain||'');btn.onclick=function(){st.poolId=parseInt(String(item.pool_id||'0'),10)||0;st.poolDomain=String(item.domain||'');setDisabled('sbv1-use-pool-domain',st.poolId<=0);document.querySelectorAll('[data-pool-id]').forEach(function(n){n.classList.toggle('pick',String(n.getAttribute('data-pool-id')||'')===String(st.poolId));});};box.appendChild(btn);});setStatus('sbv1-pool-status','已加载 '+String(items.length)+' 个域名','ok');}).catch(function(){setStatus('sbv1-pool-status','网络错误，请稍后重试。','err');});}
    function reservePool(){if(!st.poolId){toast('warning','请先从本地域名池选择域名。');return;}post(cfg.reservePool,{draft_public_id:st.draftId,pool_id:st.poolId,account_id:account()}).then(function(d){if(!d||!d.success){toast('error',d&&d.message?d.message:'本地域名池预占用失败');return;}st.selectedDomain=String(d.domain||st.poolDomain);st.selectedSource='local_pool';byId('sbv1-domain-summary').textContent='已选择域名：'+st.selectedDomain+'（本地域名池）';setStatus('sbv1-pool-status',d.message||'已预占用','ok');}).catch(function(){toast('error','网络错误，请稍后重试。');});}
    function createSession(){if(!st.draftId){toast('warning','方案会话已丢失，请重新生成并确认方案。');return;}if(!st.selectedDomain){toast('warning','请先选择域名。');return;}post(cfg.createSession,{draft_public_id:st.draftId}).then(function(d){if(!d||!d.success){toast('error',d&&d.message?d.message:'创建会话失败');return;}window.location.href=String(d.workspace_url||'');}).catch(function(){toast('error','网络错误，请稍后重试。');});}
    function runPlanStrict(action){
        if(st.planBusy){
            toast('warning','方案正在生成中，请稍候。');
            return;
        }
        var url=action==='revise'?cfg.revise:cfg.gen;
        var msg=action==='revise'?String((byId('sbv1-revise-msg')||{}).value||'').trim():desc();
        if(action!=='revise'&&!msg){
            toast('warning','\u8bf7\u5148\u8f93\u5165\u4e00\u53e5\u8bdd\u9700\u6c42\u3002');
            return;
        }
        open('sbv1-plan-modal');
        setPlanModalBusy(true);
        setStatus('sbv1-main-status',action==='revise'?'\u6b63\u5728\u4fee\u8ba2\u65b9\u6848':'\u6b63\u5728\u751f\u6210\u65b9\u6848','info');
        setStatus('sbv1-plan-stream-status','\u672a\u8fde\u63a5','');
        byId('sbv1-plan-content').textContent='\u7b49\u5f85\u751f\u6210\u65b9\u6848...';
        var langs=currentLanguagePayload();
        var genPayload={provider_code:'websites_default',draft_public_id:st.draftId,description:desc(),message:msg,reference_urls:refs(),content_locale:langs.content_locale,plan_locale:langs.plan_locale,language_codes:(langs.language_codes||[]).join(',')};
        if(cfg.fake){genPayload.fake_mode='1';}
        post(url,genPayload).then(function(d){
            if(!d||!d.success){
                var initMsg=d&&d.message?d.message:'\u65b9\u6848\u521d\u59cb\u5316\u5931\u8d25';
                setPlanModalBusy(false);
                setStatus('sbv1-main-status',initMsg,'err');
                toast('error',initMsg);
                return;
            }
            st.draftId=String(d.draft_public_id||st.draftId||'');
            st.planConfirmed=false;
            saveIntakeDraft(true);
            if(d.draft&&d.draft.payload&&d.draft.payload.current_plan){renderPlan(d.draft.payload.current_plan);}
            byId('sbv1-plan-log').innerHTML='';
            closeSse('planSse');
            setStatus('sbv1-plan-stream-status','\u8fde\u63a5\u4e2d','info');
            var streamUrl=new URL(String(d.stream_url||''),window.location.href);
            if(streamUrl.origin!==window.location.origin){
                streamUrl=new URL(streamUrl.pathname+streamUrl.search,window.location.origin);
            }
            if(cfg.fake){streamUrl.searchParams.set('fake_mode','1');}
            var s=(function(u){ var L={}; var api={close:function(){if(api._h)api._h.close();}, addEventListener:function(n,f){L[n]=f;}}; setTimeout(function(){ api._h=bqCollectSse(u, Object.assign({}, L, {_done:function(){ if(st.planBusy){ setPlanModalBusy(false); } }})); },0); return api; })(streamUrl.toString());
            st.planSse=s;
            s.addEventListener('start',function(ev){
                var p=parse(ev);
                addLog(p.message||'\u5df2\u5f00\u59cb');
                setStatus('sbv1-plan-stream-status','\u751f\u6210\u4e2d','info');
            });
            s.addEventListener('status',function(ev){var p=parse(ev);addLog(p.message||'');});
            s.addEventListener('chunk',function(ev){var p=parse(ev);addLog(p.chunk||p.message||'');});
            s.addEventListener('warning',function(ev){var p=parse(ev);addLog(p.message||'');});
            s.addEventListener('plan_completed',function(ev){
                var p=parse(ev);
                if(p.plan){renderPlan(p.plan);}
            });
            s.addEventListener('done',function(ev){
                var p=parse(ev);
                if(p.plan){renderPlan(p.plan);}
                var versionId=parseInt(String(p.version_id||'0'),10)||0;
                if(p.success===false || versionId<=0){
                    if(p.message){addLog(p.message);}
                    if(versionId<=0&&p.success!==false){addLog('方案未落库，请重新生成。');}
                    setStatus('sbv1-plan-stream-status','\u5931\u8d25','err');
                    setStatus('sbv1-main-status',versionId<=0?'方案未落库，请重新生成':'方案生成失败','err');
                    if(versionId<=0){toast('error','方案未落库，请重新生成后再确认。');}
                }else{
                    setStatus('sbv1-plan-stream-status','\u5df2\u5b8c\u6210','ok');
                    setStatus('sbv1-main-status','\u65b9\u6848\u5df2\u751f\u6210','ok');
                }
                closeSse('planSse');
                setPlanModalBusy(false);
            });
            s.addEventListener('error',function(ev){
                var p=parse(ev);
                if(p.message){
                    addLog(p.message);
                    setStatus('sbv1-plan-stream-status','\u5931\u8d25','err');
                    setStatus('sbv1-main-status','\u65b9\u6848\u751f\u6210\u5931\u8d25','err');
                    closeSse('planSse');
                    setPlanModalBusy(false);
                    return;
                }
                setStatus('sbv1-plan-stream-status','\u8fde\u63a5\u91cd\u8bd5\u4e2d','info');
            });
        }).catch(function(){
            setPlanModalBusy(false);
            setStatus('sbv1-main-status','\u7f51\u7edc\u9519\u8bef\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5\u3002','err');
            toast('error','\u7f51\u7edc\u9519\u8bef\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5\u3002');
        });
    }
    byId('sbv1-generate').onclick=function(){runPlanStrict('generate');};
    byId('sbv1-revise').onclick=function(){runPlanStrict('revise');};
    if(byId('sbv1-clear-desc')){byId('sbv1-clear-desc').onclick=clearRequirement;}
    if(byId('sbv1-polish-desc')){byId('sbv1-polish-desc').onclick=polishRequirement;}
    ['sbv1-desc','sbv1-refs'].forEach(function(id){var n=byId(id);if(!n)return;n.addEventListener('input',function(){saveIntakeDraft(false);});n.addEventListener('change',function(){saveIntakeDraft(true);});});
    function syncSbv1Languages(){
        var single=languageSelector('sbv1-content-locale-select');
        var multiple=languageSelector('sbv1-language-codes-select');
        if(!single||!multiple){return;}
        var current=String(single.getValue()||'').trim();
        var values=multiple.getValues();
        if(current&&values.indexOf(current)<0){values.unshift(current);}
        multiple.setReadonlyValues(current?[current]:[]);
        multiple.setValues(values);
    }
    document.addEventListener('weline:ui:language-select:ready',function(event){
        if(event.target&&(/^sbv1-(?:content-locale|language-codes)-select_wrapper$/).test(event.target.id||'')){syncSbv1Languages();}
    });
    document.addEventListener('weline:ui:language-select:change',function(event){
        if(event.target&&event.target.id==='sbv1-content-locale-select_wrapper'){syncSbv1Languages();}
    });
    ['sbv1-content-locale','sbv1-plan-locale','sbv1-language-codes'].forEach(function(id){
        var n=byId(id);
        if(!n)return;
        n.addEventListener('change',function(){saveIntakeDraft(true);});
    });
    restoreIntakeDraft();
    byId('sbv1-confirm-plan').onclick=confirmPlan;
    byId('sbv1-recommend-domain').onclick=recommendDomain;
    byId('sbv1-use-rec-domain').onclick=function(){if(!st.recDomain){toast('warning','请先选择推荐域名。');return;}selectDomain(st.recDomain,'recommended');};
    byId('sbv1-check-domain').onclick=checkManual;
    byId('sbv1-use-manual-domain').onclick=function(){var domain=String((byId('sbv1-manual-domain')||{}).value||'').trim().toLowerCase();if(!domain){toast('warning','请先输入域名。');return;}selectDomain(domain,'manual');};
    byId('sbv1-load-pool').onclick=loadPool;
    byId('sbv1-use-pool-domain').onclick=reservePool;
    byId('sbv1-create-session').onclick=createSession;
    setDisabled('sbv1-use-pool-domain',true);
    document.querySelectorAll('[data-close]').forEach(function(btn){btn.onclick=function(){close(String(btn.getAttribute('data-close')||''));};});
    document.querySelectorAll('[data-pane-btn]').forEach(function(btn){btn.onclick=function(){var pane=String(btn.getAttribute('data-pane-btn')||'');document.querySelectorAll('[data-pane-btn]').forEach(function(n){n.classList.toggle('on',n===btn);});document.querySelectorAll('[data-pane]').forEach(function(p){p.classList.toggle('on',String(p.getAttribute('data-pane')||'')===pane);});};});
})();
</script>
