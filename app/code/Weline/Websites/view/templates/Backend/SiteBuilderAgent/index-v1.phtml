<script>
(function(g){
  if(g.siteBuilderWorkbenchRequest) return;
  var routes=[
    ['/site-builder-plan/stream-sse','completePlan'],
    ['/site-builder-plan/stream','completePlan'],
    ['/site-builder-agent/recommend-domain-sse','recommendDomain'],
    ['/site-builder-agent/generate-virtual-theme-sse','generateVirtualTheme'],
    ['/site-builder-agent/domain-purchase-sse','domainPurchaseStatus'],
    ['/site-builder-agent/stream-sse','workspaceEvents'],
    ['/site-builder-plan/generate','preparePlan'],
    ['/site-builder-plan/revise','preparePlanRevision'],
    ['/site-builder-plan/confirm','confirmPlan'],
    ['/site-builder-plan/local-pool','listLocalPool'],
    ['/site-builder-plan/reserve-local-pool','reserveLocalPool'],
    ['/site-builder-plan/select-domain','selectDomain'],
    ['/site-builder-plan/create-session','createSession'],
    ['/site-builder-agent/recommend-domain','recommendDomain'],
    ['/site-builder-agent/check-domain','checkDomain'],
    ['/site-builder-agent/merge-scope','mergeScope'],
    ['/site-builder-agent/replace-scope','replaceScope'],
    ['/site-builder-agent/set-stage','setStage'],
    ['/site-builder-agent/delete-session','deleteSession'],
    ['/site-builder-agent/save-virtual-theme','saveVirtualTheme'],
    ['/site-builder-agent/save-page-type-layout','savePageTypeLayout'],
    ['/site-builder-agent/save-virtual-component','saveVirtualComponent'],
    ['/site-builder-agent/append-message','appendMessage'],
    ['/site-builder-agent/start-domain-purchase','startDomainPurchase']
  ];
  function commandFor(route){
    var path='';
    try{path=new URL(String(route||''),window.location.href).pathname.toLowerCase();}catch(_){path=String(route||'').toLowerCase();}
    for(var i=0;i<routes.length;i++){if(path.indexOf(routes[i][0])!==-1)return routes[i][1];}
    throw new Error('Unsupported Site Builder command route');
  }
  function payloadFor(route,request){
    var payload={};
    try{new URL(String(route||''),window.location.href).searchParams.forEach(function(v,k){payload[k]=v;});}catch(_){}
    var body=request&&request.body;
    if(body&&typeof FormData!=='undefined'&&body instanceof FormData){
      body.forEach(function(v,k){if(!(typeof File!=='undefined'&&v instanceof File))payload[k]=String(v);});
    }else if(typeof body==='string'&&body!==''){
      try{new URLSearchParams(body).forEach(function(v,k){payload[k]=v;});}catch(_){}
    }else if(body&&typeof body==='object'){
      Object.keys(body).forEach(function(k){payload[k]=body[k];});
    }
    return payload;
  }
  function unwrap(result){
    if(result&&result.data&&typeof result.data==='object'&&!Array.isArray(result.data)
      &&(result.data.success!==undefined||result.data.events!==undefined)){return result.data;}
    return result&&typeof result==='object'?result:{success:true,data:result};
  }
  function eventsFor(command,data){
    if(Array.isArray(data&&data.events))return data.events;
    if(command==='recommendDomain'){
      return [
        {event:'batch',data:data},
        {event:data&&data.success===false?'error':'success',data:data},
        {event:'done',data:{success:!(data&&data.success===false)}}
      ];
    }
    return [{event:data&&data.success===false?'error':'done',data:data||{}}];
  }
  function responseFor(command,data,request){
    var ok=!(data&&data.success===false);
    var text=JSON.stringify(data==null?{}:data);
    var response={
      ok:ok,
      status:ok?200:400,
      headers:{get:function(name){return String(name||'').toLowerCase()==='content-type'?'application/json':'';}},
      json:function(){return Promise.resolve(data);},
      text:function(){return Promise.resolve(text);}
    };
    var accept=String(request&&request.headers&&(request.headers.Accept||request.headers.accept)||'');
    if(accept.indexOf('text/event-stream')>=0){
      var raw=eventsFor(command,data).map(function(ev){
        return 'event: '+String(ev&&ev.event||'message')+'\n'+'data: '+JSON.stringify(ev&&ev.data!==undefined?ev.data:{})+'\n\n';
      }).join('');
      response.headers={get:function(){return 'text/event-stream';}};
      response.body=new ReadableStream({start:function(controller){
        controller.enqueue(new TextEncoder().encode(raw));
        controller.close();
      }});
    }
    Object.keys(data||{}).forEach(function(k){if(response[k]===undefined)response[k]=data[k];});
    if(!ok&&accept.indexOf('text/event-stream')<0){
      var error=new Error(String(data&&data.message||'Site Builder command failed'));
      error.response=response;
      error.payload=data;
      return Promise.reject(error);
    }
    return Promise.resolve(response);
  }
  g.siteBuilderWorkbenchRequest=function(route,request){
    request=request||{};
    var command=commandFor(route);
    var payload=payloadFor(route,request);
    var invoke=function(api){
      return api.resource('websites').siteBuilderWorkbench(
        {command:command,payload:payload},
        {requestTimeoutMs:300000}
      );
    };
    var pending=(g.Weline&&g.Weline.load)
      ?g.Weline.load('api').then(invoke)
      :Promise.resolve(invoke(g.Weline.Api));
    return pending.then(unwrap).then(function(data){return responseFor(command,data,request);});
  };
})(window);
</script>
