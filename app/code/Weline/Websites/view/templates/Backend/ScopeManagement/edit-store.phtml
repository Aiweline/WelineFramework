<?php
/** @var array $entity @var string $error @var int $website_id @var bool $tree_embed @var string $tree_return_node @var string $tree_return_url */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$storeId = (int)($entity['store_id'] ?? 0);
$mode = (string)($entity['store_mode'] ?? $entity['mode'] ?? 'normal');
$treeEmbed = !empty($tree_embed);
$returnNode = (string)($tree_return_node ?? ('store:' . $storeId));
$returnUrl = trim((string)($tree_return_url ?? ''));
$error = (string)($error ?? '');
?>
<div class="w-container" data-testid="store-management-edit" data-store-id="<?= $storeId ?>">
    <?php if (!$treeEmbed): ?>
        <div class="w-cluster" data-align="center" data-justify="between" style="--w-mb:var(--weline-space-4);">
            <div>
                <h4 style="--w-mb:var(--weline-space-1);"><lang>编辑商店</lang></h4>
                <div class="w-text" data-tone="muted">store_id=<?= $storeId ?> · website_id=<?= (int)$website_id ?></div>
            </div>
            <a class="w-button" href="@backend-url('*/backend/scope-management/stores')?website_id=<?= (int)$website_id ?>"><lang>返回列表</lang></a>
        </div>
    <?php endif; ?>

    <?php if ($error !== ''): ?>
        <div class="w-alert" role="alert" data-tone="danger"><?= $escape($error) ?></div>
    <?php elseif (!\array_key_exists('code', $entity)): ?>
        <div class="w-alert" role="alert" data-tone="danger"><lang>商店不存在</lang></div>
    <?php else: ?>
        <div class="<?= $treeEmbed ? '' : 'w-card' ?>" style="--w-mb:var(--weline-space-4);"><div class="<?= $treeEmbed ? '' : 'w-card__body' ?>">
            <w:form method="post" action="@backend-url('*/backend/scope-management/update-store')" csrf="auto" class="w-grid" data-testid="store-management-edit-form" style="--w-gap:var(--weline-space-4);">
                <input type="hidden" name="store_id" value="<?= $storeId ?>">
                <?php if ($treeEmbed): ?>
                    <input type="hidden" name="return_to" value="tree">
                    <input type="hidden" name="return_node" value="<?= $escape($returnNode) ?>">
                    <?php if ($returnUrl !== ''): ?>
                        <input type="hidden" name="return_url" value="<?= $escape($returnUrl) ?>">
                    <?php endif; ?>
                <?php endif; ?>
                <div style="--w-span-md:3;">
                    <label class="w-field__label"><lang>商店代码</lang></label>
                    <input class="w-input" value="<?= $escape($entity['code'] ?? '') ?>" disabled>
                </div>
                <div style="--w-span-md:4;">
                    <label class="w-field__label"><lang>商店名称</lang></label>
                    <input class="w-input" name="name" maxlength="128" required value="<?= $escape($entity['name'] ?? '') ?>">
                </div>
                <div style="--w-span-md:2;">
                    <label class="w-field__label"><lang>模式</lang></label>
                    <select class="w-select" name="store_mode">
                        <?php foreach (['normal', 'dev', 'test'] as $opt): ?>
                            <option value="<?= $opt ?>" <?= $mode === $opt ? 'selected' : '' ?>><?= $opt ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div style="--w-span-md:3;">
                    <label class="w-field__label"><lang>独立 URL</lang></label>
                    <input class="w-input" type="url" name="url" maxlength="255" value="<?= $escape($entity['url'] ?? '') ?>">
                </div>
                <div class="w-cluster" data-align="end" style="--w-span-md:12;">
                    <button class="w-button" type="submit" data-tone="primary"><lang>保存商店</lang></button>
                </div>
                <?php
                $this->assign('id', 'store_edit_' . $storeId);
                $this->assign('store', $entity);
                $this->assign('store_id', $storeId);
                $this->assign('website_id', (int)$website_id);
                echo $this->getHook('Weline_Websites::backend::store::form::sections-after');
                ?>
            </w:form>
        </div></div>
    <?php endif; ?>
</div>
