<?php
/**
 * @hook-priority 100
 * @hook-sort-order 25
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Websites\Service\SiteContactScopeMapper;

$channel = (array)($this->getData('channel') ?? $this->getData('entity') ?? []);
$channelId = array_key_exists('channel_id', $channel) || $this->getData('channel_id') !== null
    ? (int)($this->getData('channel_id') ?? $channel['channel_id'] ?? -1)
    : -1;
$hookId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'channel'));
if (!is_string($hookId) || $hookId === '' || preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'channel_' . (is_string($hookId) ? $hookId : '');
}

/** @var SiteContactScopeMapper $mapper */
$mapper = ObjectManager::getInstance(SiteContactScopeMapper::class);
$scopeMeta = $channelId >= 0
    ? $mapper->forChannel($channel)
    : ['ok' => false, 'storage_scope' => '', 'website_code' => '', 'store_code' => '', 'channel_code' => '', 'scope_kind' => '', 'label' => ''];

echo $this->fetch('Weline_Websites::templates/Admin/partials/site-contact-embed-section.phtml', [
    'sectionId' => $hookId . '_site_contact',
    'hasIdentity' => $channelId >= 0,
    'pendingHint' => (string)__('请先保存渠道，再配置本渠道联系信息。'),
    'scopeMeta' => $scopeMeta,
    'scopeHint' => (string)__('本组写入当前渠道范围；未覆盖时继承 Store → Website → Global。'),
]);
