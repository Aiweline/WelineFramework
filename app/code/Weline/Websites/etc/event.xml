<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Framework::App::storefront_scope_ready_gate">
        <observer name="Weline_Websites::scope_maintenance"
                  instance="Weline\Websites\Observer\ScopeMaintenanceObserver"
                  disabled="false"
                  shared="true" sort="-45"/>
    </event>

    <!--控制器注解属性-->
    <event name="Weline_Framework_Url::detect_website">
        <observer name="Weline_Websites::detect_website" instance="Weline\Websites\Observer\DetectWebsite"
                  disabled="false"
                  shared="true" sort="0"/>
    </event>

    <event name="Weline_Acl::role_acl_entries_after">
        <observer name="Weline_Websites::filter_role_acl_entries"
                  instance="Weline\Websites\Observer\FilterRoleAclEntriesByWebsiteGrant"
                  disabled="false" shared="true" sort="10"/>
    </event>
    <event name="Weline_Acl::super_admin_bypass_check">
        <observer name="Weline_Websites::deny_super_admin_bypass"
                  instance="Weline\Websites\Observer\DenySuperAdminBypassOnNonDefaultWebsite"
                  disabled="false" shared="true" sort="10"/>
    </event>
    <event name="Weline_Acl::role_access_save_before">
        <observer name="Weline_Websites::validate_role_access_grant"
                  instance="Weline\Websites\Observer\ValidateRoleAccessAgainstWebsiteGrant"
                  disabled="false" shared="true" sort="10"/>
    </event>
    <event name="Weline_Acl::role_listing_filter">
        <observer name="Weline_Websites::filter_role_listing"
                  instance="Weline\Websites\Observer\FilterRoleListingByWebsite"
                  disabled="false" shared="true" sort="10"/>
    </event>
    <event name="Weline_Acl::acl_assignment_rows_after">
        <observer name="Weline_Websites::filter_acl_assignment_rows"
                  instance="Weline\Websites\Observer\FilterAclAssignmentRowsByWebsiteGrant"
                  disabled="false" shared="true" sort="10"/>
    </event>
    <event name="Weline_Admin_Login::password_verified">
        <observer name="Weline_Websites::enforce_backend_user_website_bind"
                  instance="Weline\Websites\Observer\EnforceBackendUserWebsiteBindOnLogin"
                  disabled="false" shared="true" sort="-20"/>
    </event>
    <event name="Weline_Framework_Router::backend_whitelist_url">
        <observer name="Weline_Websites::backend_whitelist_url"
                  instance="Weline\Websites\Observer\BackendWhitelistUrl"
                  disabled="false" shared="true" sort="20"/>
    </event>

    <!--货币验证观察者：在网站检测之后验证货币是否被允许-->
    <event name="Weline_Framework_Url::detect_currency">
        <observer name="Weline_Websites::validate_currency" instance="Weline\Websites\Observer\ValidateCurrency"
                  disabled="false"
                  shared="true" sort="100"/>
    </event>
    <!--语言验证观察者：在网站检测之后验证语言是否被允许-->
    <event name="Weline_Framework_Url::detect_language">
        <observer name="Weline_Websites::validate_language" instance="Weline\Websites\Observer\ValidateLanguage"
                  disabled="false"
                  shared="true" sort="100"/>
    </event>
    
    <!-- ========== Server 模块事件观察者 ========== -->
    
    <!--证书签发完成：同步域名 HTTPS 状态-->
    <event name="Weline_Server::domain::certificate_issued">
        <observer name="Weline_Websites::sync_https_status" 
                  instance="Weline\Websites\Observer\SyncHttpsStatus"
                  disabled="false"
                  shared="true" sort="10"/>
        <observer name="Weline_Websites::certificate_issued_lifecycle"
                  instance="Weline\Websites\Observer\CertificateIssuedLifecycle"
                  disabled="false"
                  shared="true" sort="20"/>
    </event>
    
    <!--证书禁用：回退 HTTPS 状态-->
    <event name="Weline_Server::domain::certificate_disabled">
        <observer name="Weline_Websites::rollback_https_status" 
                  instance="Weline\Websites\Observer\RollbackHttpsStatus"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>
    
    <!--证书删除：清除域名池 HTTPS 和可建站状态-->
    <event name="Weline_Server::domain::certificate_deleted">
        <observer name="Weline_Websites::clear_domain_pool_certificate" 
                  instance="Weline\Websites\Observer\ClearDomainPoolCertificate"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>
    
    <!--证书更新：同步更新状态-->
    <event name="Weline_Server::domain::certificate_renewed">
        <observer name="Weline_Websites::update_certificate_status" 
                  instance="Weline\Websites\Observer\UpdateCertificateStatus"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>
    
    <!--请求域名列表：提供域名数据-->
    <event name="Weline_Server::integration::domain_list_requested">
        <observer name="Weline_Websites::provide_domain_list" 
                  instance="Weline\Websites\Observer\ProvideDomainList"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>
    <!-- 域名池解析偏离本站：发送通知 -->
    <event name="Weline_Websites::domain_pool::resolve_off_local">
        <observer name="Weline_Websites::domain_pool_resolve_off_local_notify"
                  instance="Weline\Websites\Observer\DomainPoolResolveOffLocalObserver"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>

    <event name="Weline_Websites::domain::purchase_success">
        <observer name="Weline_Websites::domain_purchase_success_lifecycle"
                  instance="Weline\Websites\Observer\DomainPurchaseSuccess"
                  disabled="false"
                  shared="true" sort="20"/>
    </event>

    <event name="Weline_Seo::integration::head_context_resolve">
        <observer name="Weline_Websites::seo_head_context_resolve"
                  instance="Weline\Websites\Observer\SeoHeadContextResolve"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>

    <event name="Weline_Captcha::domains::collect">
        <observer name="Weline_Websites::captcha_domains"
                  instance="Weline\Websites\Observer\CollectCaptchaDomains"
                  disabled="false"
                  shared="true" sort="10"/>
    </event>

    <!-- WLS normal responses. FPM skips this registration at runtime. -->
    <event name="Weline_Framework::App::run_after">
        <observer name="Weline_Websites::frontend_worker_scope_bootstrap_run_after"
                  instance="Weline\Websites\Observer\FrontendWorkerScopeBootstrapResponse"
                  disabled="false"
                  shared="true" sort="800"/>
    </event>

    <!-- FPM final responses. Persistent runtimes skip this registration. -->
    <event name="Weline_Framework_Http::response_ready">
        <observer name="Weline_Websites::frontend_worker_scope_bootstrap_response_ready"
                  instance="Weline\Websites\Observer\FrontendWorkerScopeBootstrapResponse"
                  disabled="false"
                  shared="true" sort="100"/>
    </event>

    <!-- Early and router-level FPC hits bypass one of the normal response hooks. -->
    <event name="Weline_Framework_Fpc::cache_hit_response">
        <observer name="Weline_Websites::frontend_worker_scope_bootstrap_fpc_hit"
                  instance="Weline\Websites\Observer\FrontendWorkerScopeBootstrapResponse"
                  disabled="false"
                  shared="true" sort="100"/>
    </event>
</config>
