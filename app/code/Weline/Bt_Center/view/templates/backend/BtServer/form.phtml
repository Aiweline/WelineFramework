<?php
/**
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Bt_Center\Model\BtServer;

/** @var BtServer|null $server */
$server = $server ?? null;
$platformOptions = $platformOptions ?? [];
$hasServer = $server && $server->getId();

$id = $hasServer ? (int) $server->getId() : 0;
$name = $hasServer ? (string) $server->getData(BtServer::schema_fields_NAME) : '';
$platform = $hasServer ? (string) $server->getData(BtServer::schema_fields_PLATFORM) : BtServer::PLATFORM_AWS;
$externalUrl = $hasServer ? (string) $server->getData(BtServer::schema_fields_EXTERNAL_URL) : '';
$internalUrl = $hasServer ? (string) $server->getData(BtServer::schema_fields_INTERNAL_URL) : '';
$username = $hasServer ? (string) $server->getData(BtServer::schema_fields_USERNAME) : '';
$password = $hasServer ? (string) $server->getData(BtServer::schema_fields_PASSWORD) : '';
$port = $hasServer ? (int) $server->getData(BtServer::schema_fields_PORT) : 22248;
$description = $hasServer ? (string) $server->getData(BtServer::schema_fields_DESCRIPTION) : '';
$isEnabled = $hasServer ? (bool) $server->getData(BtServer::schema_fields_IS_ENABLED) : true;
$lastCheckStatus = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_CHECK_STATUS) : BtServer::CHECK_STATUS_UNKNOWN;
$lastCheckAt = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_CHECK_AT) : '';
$lastHttpCode = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_HTTP_CODE) : '';
$lastResponseTime = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_RESPONSE_TIME_MS) : '';
$lastErrorMessage = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_ERROR_MESSAGE) : '';
$lastStateChangedAt = $hasServer ? (string) $server->getData(BtServer::schema_fields_LAST_STATE_CHANGED_AT) : '';

$statusTone = match ($lastCheckStatus) {
    BtServer::CHECK_STATUS_UP => 'success',
    BtServer::CHECK_STATUS_DOWN => 'danger',
    default => 'muted',
};
