     data-text-delete-failed="<?= htmlspecialchars((string)__('删除失败'), ENT_QUOTES) ?>"
     data-text-request-failed="<?= htmlspecialchars((string)__('请求失败'), ENT_QUOTES) ?>">
    <div class="w-cluster" data-justify="between" data-align="center" data-wrap="true">
        <p class="w-text" data-tone="muted" data-size="sm">
            <?= __('健康检查定时任务每 10 分钟执行一次，检测面板地址是否可访问。') ?>
        </p>
        <a href="@backend-url{'*/backend/bt-server/form'}" class="w-button" data-tone="primary">
            <w:icon name="plus" size="sm"></w:icon><?= __('新增服务器') ?>
        </a>
    </div>

    <template>Weline_Component::message.phtml</template>

    <div class="w-card">
        <div class="w-card__body">
            <form method="get" action="@backend-url{'*/backend/bt-server'}" class="w-cluster" data-align="end" data-wrap="true" style="--w-gap:var(--weline-space-3);">
                <div class="w-field">
                    <label class="w-field__label" for="bt-filter-platform"><?= __('云平台') ?></label>
                    <select name="platform" id="bt-filter-platform" class="w-select">
                        <option value=""><?= __('全部平台') ?></option>
                        <?php foreach ($platformOptions as $key => $label): ?>
                            <option value="<?= htmlspecialchars((string) $key, ENT_QUOTES) ?>" <?= $platform === $key ? 'selected' : '' ?>>
                                <?= htmlspecialchars((string) $label, ENT_QUOTES) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="bt-filter-status"><?= __('健康状态') ?></label>
                    <select name="status" id="bt-filter-status" class="w-select">
                        <option value=""><?= __('全部状态') ?></option>
                        <?php foreach ($healthStatusOptions as $key => $label): ?>
                            <option value="<?= htmlspecialchars((string) $key, ENT_QUOTES) ?>" <?= $status === $key ? 'selected' : '' ?>>
                                <?= htmlspecialchars((string) $label, ENT_QUOTES) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="bt-filter-keyword"><?= __('关键词') ?></label>
                    <input type="text"
                           id="bt-filter-keyword"
                           name="keyword"
                           class="w-input"
                           value="<?= htmlspecialchars((string) $keyword, ENT_QUOTES) ?>"
                           placeholder="<?= __('搜索名称、地址、用户名') ?>">
                </div>
                <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
                    <button type="submit" class="w-button" data-tone="primary">
                        <w:icon name="search" size="sm"></w:icon><?= __('搜索') ?>
                    </button>
                    <a href="@backend-url{'*/backend/bt-server'}" class="w-button" data-tone="neutral" data-variant="outline">
                        <w:icon name="refresh" size="sm"></w:icon><?= __('重置') ?>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="w-card">
        <div class="w-card__header">
            <h2 class="w-card__title"><?= __('服务器列表') ?></h2>
        </div>
        <div class="w-table-wrap">
            <table class="w-table">
                <thead>
                <tr>
                    <th><?= __('ID') ?></th>
                    <th><?= __('服务器') ?></th>
                    <th><?= __('云平台') ?></th>
                    <th><?= __('外网地址') ?></th>
                    <th><?= __('监控') ?></th>
                    <th><?= __('健康状态') ?></th>
                    <th><?= __('最后检测') ?></th>
                    <th><?= __('操作') ?></th>
                </tr>
                </thead>
                <tbody>
                <?php if (empty($servers)): ?>
                    <tr>
                        <td colspan="8">
                            <div class="w-empty"><p class="w-text" data-tone="muted"><?= __('暂无服务器') ?></p></div>
                        </td>
                    </tr>
                <?php else: ?>
                    <?php foreach ($servers as $server): ?>
                        <?php
                        $serverStatus = (string) ($server[BtServer::schema_fields_LAST_CHECK_STATUS] ?? BtServer::CHECK_STATUS_UNKNOWN);
                        $statusTone = match ($serverStatus) {
                            BtServer::CHECK_STATUS_UP => 'success',
                            BtServer::CHECK_STATUS_DOWN => 'danger',
                            default => 'muted',
                        };
                        $platformCode = (string) ($server[BtServer::schema_fields_PLATFORM] ?? '');
                        $platformLabel = $platformOptions[$platformCode] ?? $platformCode;
                        $isEnabled = (bool) ($server[BtServer::schema_fields_IS_ENABLED] ?? 0);
                        $httpCode = $server[BtServer::schema_fields_LAST_HTTP_CODE] ?? null;
                        $responseTime = $server[BtServer::schema_fields_LAST_RESPONSE_TIME_MS] ?? null;
                        $lastError = (string) ($server[BtServer::schema_fields_LAST_ERROR_MESSAGE] ?? '');
                        ?>
                        <tr>
                            <td><?= (int) ($server[BtServer::schema_fields_SERVER_ID] ?? 0) ?></td>
                            <td>
                                <div class="w-text" data-weight="strong"><?= htmlspecialchars((string) ($server[BtServer::schema_fields_NAME] ?? ''), ENT_QUOTES) ?></div>
                                <div class="w-text" data-tone="muted" data-size="sm">
                                    <?= __('用户：%{1}', (string) ($server[BtServer::schema_fields_USERNAME] ?? '')) ?>
                                    <?php if (!empty($server[BtServer::schema_fields_PORT])): ?>
                                        | <?= __('端口：%{1}', (string) $server[BtServer::schema_fields_PORT]) ?>
                                    <?php endif; ?>
                                </div>
                            </td>
                            <td><span class="w-badge" data-w-background="info"><?= htmlspecialchars((string) $platformLabel, ENT_QUOTES) ?></span></td>
                            <td>
                                <a href="<?= htmlspecialchars((string) ($server[BtServer::schema_fields_EXTERNAL_URL] ?? ''), ENT_QUOTES) ?>" target="_blank" rel="noopener" class="w-text" data-tone="primary">
                                    <?= htmlspecialchars((string) ($server[BtServer::schema_fields_EXTERNAL_URL] ?? ''), ENT_QUOTES) ?>
                                </a>
                            </td>
                            <td>
                                <span class="w-badge" data-w-background="<?= $isEnabled ? 'success' : 'muted' ?>">
                                    <?= $isEnabled ? __('已启用') : __('已停用') ?>
                                </span>
                            </td>
                            <td>
                                <div><span class="w-badge" data-w-background="<?= $statusTone ?>"><?= htmlspecialchars(BtServer::getHealthStatusLabel($serverStatus), ENT_QUOTES) ?></span></div>
                                <div class="w-text" data-tone="muted" data-size="sm">
                                    <?= __('HTTP：%{1}', $httpCode !== null && $httpCode !== '' ? (string) $httpCode : '-') ?>
                                    |
                                    <?= __('耗时：%{1}', $responseTime !== null && $responseTime !== '' ? (string) $responseTime . ' ms' : '-') ?>
                                </div>
                                <?php if ($lastError !== ''): ?>
                                    <div class="w-text" data-tone="danger" data-size="sm"><?= htmlspecialchars($lastError, ENT_QUOTES) ?></div>
                                <?php endif; ?>
                            </td>
                            <td>
                                <div><?= !empty($server[BtServer::schema_fields_LAST_CHECK_AT]) ? htmlspecialchars((string) $server[BtServer::schema_fields_LAST_CHECK_AT], ENT_QUOTES) : '-' ?></div>
                                <div class="w-text" data-tone="muted" data-size="sm">
                                    <?= __('变化：%{1}', !empty($server[BtServer::schema_fields_LAST_STATE_CHANGED_AT]) ? (string) $server[BtServer::schema_fields_LAST_STATE_CHANGED_AT] : '-') ?>
                                </div>
                            </td>
                            <td>
                                <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
                                    <a href="@backend-url{'*/backend/bt-server/form'|['id' => (int) ($server[BtServer::schema_fields_SERVER_ID] ?? 0)]}"
                                       class="w-button" data-size="sm" data-tone="primary" data-variant="outline">
                                        <w:icon name="edit" size="sm"></w:icon><?= __('编辑') ?>
                                    </a>
                                    <button type="button"
                                            class="w-button" data-size="sm" data-tone="danger" data-variant="outline"
                                            data-bt-server-delete="<?= (int) ($server[BtServer::schema_fields_SERVER_ID] ?? 0) ?>">
                                        <w:icon name="trash" size="sm"></w:icon><?= __('删除') ?>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
