<?php
/**
 * Help backend listing: pages grouped by website.
 *
 * @var \Weline\Framework\View\Template $this
 */
$siteGroups = $this->getData('site_groups') ?: [];
$websites = $this->getData('websites') ?: [];
$websiteIdFilter = (string)($this->getData('website_id') ?: '');
$search = (string)($this->getData('search') ?: '');
$status = (string)($this->getData('status') ?: '');
$listingUrl = (string)($this->getData('listing_url') ?: '');
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$statusLabels = [
    'draft' => (string)__('草稿'),
    'published' => (string)__('已发布'),
    'disabled' => (string)__('已禁用'),
];
?>
<style>
.help-admin { --ha-border:#dbe3ef; --ha-text:#162033; --ha-muted:#64748b; --ha-soft:#f8fafc; --ha-surface:#fff; }
.help-admin__toolbar { display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; align-items:flex-end; margin-bottom:16px; }
.help-admin__filters { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
.help-admin__site {
    margin-bottom:16px; border:1px solid var(--ha-border); border-radius:8px; background:var(--ha-surface); overflow:hidden;
}
.help-admin__site-head {
    display:flex; flex-wrap:wrap; gap:10px; justify-content:space-between; align-items:center;
    padding:12px 14px; background:var(--ha-soft); border-bottom:1px solid var(--ha-border);
}
.help-admin__site-title { margin:0; color:var(--ha-text); font-size:1rem; font-weight:700; }
.help-admin__site-meta { color:var(--ha-muted); font-size:12px; }
.help-admin__table { width:100%; margin:0; }
.help-admin__table th, .help-admin__table td { padding:10px 12px; vertical-align:middle; border-top:1px solid var(--ha-border); }
.help-admin__table th { background:var(--ha-soft); color:var(--ha-muted); font-weight:600; font-size:12px; border-top:0; }
.help-admin__empty { padding:18px 12px; color:var(--ha-muted); text-align:center; }
.help-admin__badge { display:inline-block; padding:2px 8px; border-radius:999px; border:1px solid var(--ha-border); font-size:12px; }
.help-admin__badge.is-published { color:#0f5132; background:#d1e7dd; border-color:#a3cfbb; }
.help-admin__badge.is-draft { color:#664d03; background:#fff3cd; border-color:#ffecb5; }
.help-admin__badge.is-disabled { color:#842029; background:#f8d7da; border-color:#f5c2c7; }
.help-admin__actions a { white-space:nowrap; }
</style>
<div class="help-admin">
    <div class="help-admin__toolbar">
        <div>
            <h1 class="h4 mb-1"><?= $escape(__('帮助中心页面')) ?></h1>
            <div class="text-muted small"><?= $escape(__('按网站管理 path_group=help 的 CMS 页面；可视化编辑锁定 help 布局。')) ?></div>
        </div>
        <form method="get" action="<?= $escape($listingUrl) ?>" class="help-admin__filters">
            <select class="form-select form-select-sm" name="website_id" style="min-width:220px">
                <option value=""><?= $escape(__('全部网站')) ?></option>
                <?php foreach ($websites as $website): ?>
                    <?php if (!is_array($website)) { continue; } ?>
                    <?php $wid = (string)(int)($website['website_id'] ?? 0); ?>
                    <option value="<?= $escape($wid) ?>" <?= $websiteIdFilter === $wid ? 'selected' : '' ?>>
                        <?= $escape($website['label'] ?? $website['name'] ?? $website['code'] ?? $wid) ?>
                    </option>
                <?php endforeach; ?>
            </select>
            <input class="form-control form-control-sm" type="search" name="search" value="<?= $escape($search) ?>"
                   placeholder="<?= $escape(__('搜索标题/slug')) ?>" style="min-width:180px">
            <select class="form-select form-select-sm" name="status">
                <option value=""><?= $escape(__('全部状态')) ?></option>
                <?php foreach ($statusLabels as $value => $label): ?>
                    <option value="<?= $escape($value) ?>" <?= $status === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
                <?php endforeach; ?>
            </select>
            <button class="btn btn-sm btn-outline-secondary" type="submit"><?= $escape(__('筛选')) ?></button>
        </form>
    </div>

    <?php if ($siteGroups === []): ?>
        <div class="help-admin__empty"><?= $escape(__('暂无网站。请先在 Websites 模块配置站点。')) ?></div>
    <?php endif; ?>

    <?php foreach ($siteGroups as $group): ?>
        <?php if (!is_array($group)) { continue; } ?>
        <?php
        $pages = is_array($group['pages'] ?? null) ? $group['pages'] : [];
        $siteLabel = (string)($group['label'] ?? '');
        $siteUrl = (string)($group['url'] ?? '');
        $newUrl = (string)($group['new_url'] ?? '');
        ?>
        <section class="help-admin__site">
            <header class="help-admin__site-head">
                <div>
                    <h2 class="help-admin__site-title"><?= $escape($siteLabel) ?></h2>
                    <div class="help-admin__site-meta">
                        ID <?= (int)($group['website_id'] ?? 0) ?>
                        · <?= $escape($group['website_code'] ?? '') ?>
                        <?php if ($siteUrl !== ''): ?> · <?= $escape($siteUrl) ?><?php endif; ?>
                        · <?= $escape(__('文章')) ?> <?= count($pages) ?>
                    </div>
                </div>
                <?php if ($newUrl !== ''): ?>
                    <a class="btn btn-sm btn-primary" href="<?= $escape($newUrl) ?>"><?= $escape(__('在此网站新建')) ?></a>
                <?php endif; ?>
            </header>
            <?php if ($pages === []): ?>
                <div class="help-admin__empty"><?= $escape(__('该网站暂无帮助文章。')) ?></div>
            <?php else: ?>
                <div class="table-responsive">
                    <table class="help-admin__table table table-sm mb-0">
                        <thead>
                        <tr>
                            <th><?= $escape(__('ID')) ?></th>
                            <th><?= $escape(__('标题')) ?></th>
                            <th><?= $escape(__('公开路径')) ?></th>
                            <th><?= $escape(__('状态')) ?></th>
                            <th><?= $escape(__('操作')) ?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php foreach ($pages as $page): ?>
                            <?php if (!is_array($page)) { continue; } ?>
                            <?php $st = strtolower(trim((string)($page['status'] ?? 'draft'))); ?>
                            <tr>
                                <td><?= (int)($page['page_id'] ?? 0) ?></td>
                                <td><?= $escape($page['title'] ?? '') ?></td>
                                <td><code><?= $escape($page['public_path'] ?? '') ?></code></td>
                                <td>
                                    <span class="help-admin__badge is-<?= $escape($st) ?>">
                                        <?= $escape($statusLabels[$st] ?? $st) ?>
                                    </span>
                                </td>
                                <td class="help-admin__actions">
                                    <a href="<?= $escape($page['edit_url'] ?? '#') ?>"><?= $escape(__('管理')) ?></a>
                                    <?php if (!empty($page['theme_editor_url'])): ?>
                                        · <a href="<?= $escape($page['theme_editor_url']) ?>" target="_blank" rel="noopener"><?= $escape(__('可视化编辑')) ?></a>
                                    <?php endif; ?>
                                    <?php if (!empty($page['cms_edit_url'])): ?>
                                        · <a href="<?= $escape($page['cms_edit_url']) ?>"><?= $escape(__('CMS 字段')) ?></a>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php endif; ?>
        </section>
    <?php endforeach; ?>
</div>
