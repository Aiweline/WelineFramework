<?php
/** @var array<string,mixed> $article */
$article = is_array($this->getData('help_article')) ? $this->getData('help_article') : [];
$payload = is_array($this->getData('help_article_payload')) ? $this->getData('help_article_payload') : [];
$contentHtml = '';
if (is_array($payload['content'] ?? null)) {
    $contentHtml = (string)($payload['content']['html'] ?? $payload['content']['body'] ?? '');
}
$title = htmlspecialchars((string)($article['title'] ?? ''), ENT_QUOTES, 'UTF-8');
?>
<article class="help-article w-container" data-help-article="1">
    <h1 class="help-article__title"><?= $title ?></h1>
    <?php if ($contentHtml !== ''): ?>
        <div class="help-article__body"><?= $contentHtml ?></div>
    <?php else: ?>
        <p class="help-article__empty"><?= htmlspecialchars((string)__('此帮助文章暂无正文，请在帮助中心后台使用可视化编辑器完善。'), ENT_QUOTES, 'UTF-8') ?></p>
    <?php endif; ?>
    <p class="help-article__back"><a href="/help"><?= htmlspecialchars((string)__('返回帮助中心'), ENT_QUOTES, 'UTF-8') ?></a></p>
</article>
