/**
 * 自包含页面也要吃主题 Token：只挂 tokens + overlay（colors/variables），不挂店面 storefront 皮肤，
 * 保证「默认主题=默认中性观感；设计主题（如汉服）=继承自己的色盘」，模块内不再内联品牌色。
 */
$themeTokensHtml = '';
$themeOverlayHtml = '';
try {
    $cssPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeCssPack::class
    );
    $themeTokensHtml = (string)($cssPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS,
        ['include_disk' => false, 'include_theme_overlay' => false]
    ) ?? '');
    $themeOverlayHtml = (string)($cssPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_OVERLAY,
        ['include_disk' => false, 'include_theme_overlay' => true]
    ) ?? '');
} catch (\Throwable) {
    $themeTokensHtml = '';
    $themeOverlayHtml = '';
}
?>
