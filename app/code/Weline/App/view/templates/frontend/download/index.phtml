<?php
/**
 * 下载中心（店面）：/app/download —— 自包含页面，不套主题布局。
 *
 * 只列已发布产物；构建发布后本页即时更新（不写死平台状态）。
 *
 * @var array<string, array{label: string, version: string, size_bytes: int, build_ts: int, path: string}> $platforms
 * @var string $qrUrl
 * @var string $storeUrl
 * @var string $builtAt
 * @var string $iosStoreUrl
 * @var string $htmlLang
 */
/**
 * 翻译兜底：已翻译的语言用 __() 结果；未翻译（返回中文原文）且非中文站点时回退英文，
 * 避免小语种页面出现整段中文。$isZh 由 $htmlLang 推导。
 */
$isZh = \str_starts_with(\strtolower((string)$htmlLang), 'zh');
$t = static function (string $zh, string $en) use ($isZh): string {
    $translated = (string)\__($zh);
    if ($isZh) {
        return $translated;
    }

    return ($translated === $zh || $translated === '') ? $en : $translated;
};
$fmtSize = static function (int $bytes): string {
    if ($bytes <= 0) {
        return '';
    }
    if ($bytes >= 1048576) {
        return \number_format($bytes / 1048576, 1) . ' MB';
    }

    return \number_format($bytes / 1024, 0) . ' KB';
};
$actions = [
    'android' => '/api/weline_app/rest/v1/download/download?platform=android',
    'web' => $storeUrl,
    'ios' => '',
];
$actionLabels = [
    'android' => $t('下载安装包', 'Download APK'),
    'web' => $t('立即打开', 'Open'),
    'ios' => '',
];
?>
