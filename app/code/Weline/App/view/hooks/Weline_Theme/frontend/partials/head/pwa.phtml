<?php
/**
 * 前台 head PWA 安装信息。
 *
 * 站点名 / 图标 / 主题色来自 Website 品牌；lang / currency 来自当前店面上下文。
 * 本文件随页面进入 FPC，不写死任何站点品牌字面量。
 *
 * @hook-priority 200
 * @hook-sort-order 0
 * @hook-solo false
 *
 * @var \Weline\Framework\View\Template $this
 */

$pwaLang = '';
$pwaCurrency = '';
try {
    $pwaLang = \trim((string)\Weline\Framework\Env\WelineEnv::getLang());
    $pwaCurrency = \strtoupper(\trim((string)\Weline\Framework\Env\WelineEnv::getCurrency()));
} catch (\Throwable) {
    $pwaLang = '';
    $pwaCurrency = '';
}

$pwaHref = '/manifest.webmanifest';
if ($pwaLang !== '' || $pwaCurrency !== '') {
    $pwaQuery = [];
    if ($pwaLang !== '') {
        $pwaQuery['lang'] = $pwaLang;
    }
    if ($pwaCurrency !== '') {
        $pwaQuery['currency'] = $pwaCurrency;
    }
    $pwaHref .= '?' . \http_build_query($pwaQuery);
}
$pwaTitle = '';
$pwaThemeColor = '';
$pwaAppleIcon = '';

try {
    $pwaBuilder = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\App\Service\Pwa\PwaManifestBuilder::class
    );
    $pwaWebsiteId = 0;
    try {
        $pwaWebsiteId = (int)(\Weline\Framework\Env\WelineEnv::getWebsiteId() ?? 0);
    } catch (\Throwable) {
        $pwaWebsiteId = 0;
    }
    if ($pwaWebsiteId === 0 && \class_exists(\Weline\Websites\Data\WebsiteData::class)) {
        try {
            $pwaWebsiteId = (int)(\Weline\Websites\Data\WebsiteData::getWebsiteId() ?? 0);
        } catch (\Throwable) {
            $pwaWebsiteId = 0;
        }
    }

    $pwaHref = $pwaBuilder->manifestHref($pwaLang, $pwaCurrency);
    $pwaTitle = $pwaBuilder->appTitle($pwaWebsiteId);
    $pwaThemeColor = $pwaBuilder->themeColorForWebsite($pwaWebsiteId);
    $pwaAppleIcon = $pwaBuilder->appleTouchIcon();
} catch (\Throwable) {
}
?>
<link rel="manifest" href="<?= \htmlspecialchars($pwaHref, ENT_QUOTES, 'UTF-8') ?>">
<?php if ($pwaThemeColor !== ''): ?>
<meta name="theme-color" content="<?= \htmlspecialchars($pwaThemeColor, ENT_QUOTES, 'UTF-8') ?>">
<?php endif; ?>
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<?php if ($pwaTitle !== ''): ?>
<meta name="apple-mobile-web-app-title" content="<?= \htmlspecialchars($pwaTitle, ENT_QUOTES, 'UTF-8') ?>">
<?php endif; ?>
<?php if ($pwaAppleIcon !== ''): ?>
<link rel="apple-touch-icon" sizes="180x180" href="<?= \htmlspecialchars($pwaAppleIcon, ENT_QUOTES, 'UTF-8') ?>">
<?php endif; ?>
