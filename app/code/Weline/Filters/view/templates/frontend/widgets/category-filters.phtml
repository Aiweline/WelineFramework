<?php
/**
 * @widget.source {Weline_Filters::css/widgets/widget-category-filters.css}
 * 部件：分类/列表左侧筛选（Filters）
 *
 * @widget.code {category-filters}
 * @widget.name {分类筛选}
 * @widget.description {分类页左侧筛选器：部门、价格与 EAV 属性筛选}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["category","search","products"]}
 * @widget.supports {["layout-category-filters","layout-products-filters","category-filters","attribute-filter","price-filter"]}
 * @widget.default_injections {[{"layout_type":"category","layout_option":"default","slot":"category-filters","area":"sidebar","sort_order":0,"required":true,"reason":"分类页默认注入 Filters 筛选部件"},{"layout_type":"products","layout_option":"default","slot":"list-filters","area":"sidebar","sort_order":0,"required":true,"reason":"商品列表默认注入 Filters 筛选部件"}]}
 */

use Weline\Filters\Service\StorefrontFilterPanelService;
use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;
use Weline\Framework\Runtime\StorefrontPageContext;

/** @var \Weline\Framework\View\Template $this */

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$offers = StorefrontPageContext::listingOffers();
if ($offers === null) {
    $offers = $this->getData('storefront_offers_unfiltered');
    if (!is_array($offers) || $offers === []) {
        $offers = $this->getData('storefront_offers');
    }
    $offers = is_array($offers) ? $offers : [];
}

/** @var Request $request */
$request = ObjectManager::getInstance(Request::class);
$requestUri = (string)(
    $request->getServer('WELINE_ORIGIN_REQUEST_URI')
    ?: $request->getServer('REQUEST_URI')
    ?: $request->getUri()
    ?: ''
);
$requestPath = strtolower(trim(str_replace('\\', '/', (string)(parse_url($requestUri, PHP_URL_PATH) ?: '')), '/'));

/** @var StorefrontFilterPanelService $panelService */
$panelService = ObjectManager::getInstance(StorefrontFilterPanelService::class);
// PDP / unrelated pages: never rebuild the full catalog just because the widget rendered empty.
if ($offers === [] && StorefrontPageContext::listingOffers() === null) {
    if (StorefrontFilterPanelService::isListingLikePath($requestPath)) {
        $offers = $panelService->resolveListingOffers($requestPath);
    }
}

$listingUrl = '/categories';
$rootCurrent = false;
if (preg_match('#(?:^|/)(categories|products)(?:/|$)#', $requestPath, $m) === 1) {
    $listingUrl = '/' . ($m[1]);
    $rootCurrent = in_array($m[1], ['categories', 'products'], true)
        && !str_contains($requestPath, 'category/');
} elseif (preg_match('#(?:^|/)category/(.+)$#', $requestPath, $m) === 1) {
    $listingUrl = '/category/' . trim($m[1], '/');
    $rootCurrent = false;
} else {
    $category = $this->getData('storefront_category');
    if (is_array($category)) {
        $url = trim((string)($category['url'] ?? ''));
        $path = trim(str_replace('\\', '/', (string)($category['path'] ?? '')), '/');
        if ($url !== '') {
            $listingUrl = '/' . ltrim((string)(parse_url($url, PHP_URL_PATH) ?: $url), '/');
        } elseif ($path !== '') {
            $listingUrl = '/category/' . $path;
        }
    }
}

// WLS 下 REQUEST_URI 常无 query 段；优先用 Request 已解析的 GET，再回退 URI/QUERY_STRING。
$query = [];
if (method_exists($request, 'getQueryParams')) {
    $fromRequest = $request->getQueryParams();
    if (is_array($fromRequest) && $fromRequest !== []) {
        $query = $fromRequest;
    }
}
if ($query === []) {
    parse_str((string)(parse_url($requestUri, PHP_URL_QUERY) ?: ''), $query);
}
if ($query === []) {
    $qs = (string)($request->getServer('QUERY_STRING') ?? '');
    if ($qs !== '') {
        parse_str($qs, $query);
    }
}
if (!is_array($query)) {
    $query = [];
}

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$panel = $panelService->buildPanel($offers, $listingUrl, $query, $websiteId, $rootCurrent);

$departments = $panel['departments'];
$priceOptions = $panel['price'];
$attributeGroups = $panel['attributes'];
$hasActive = (bool)$panel['has_active'];
$clearUrl = (string)$panel['clear_url'];
$visibleOptionLimit = 6;
?>
<aside class="w-filters wc-theme_widget_category_filters"
       data-widget-code="category-filters"
       data-testid="storefront-filters-panel"
       data-hook-source="Weline_Filters"
       weline-code="filters.widget.category_filters">
    <?php if ($hasActive): ?>
        <div class="w-filters__clear-row">
            <a class="w-filters__clear" href="<?= $escape($clearUrl) ?>"><lang>清除筛选条件</lang></a>
        </div>
    <?php endif; ?>

    <section class="w-filters__section" weline-code="filters-department">
        <h3 class="w-filters__heading"><lang>部门</lang></h3>
        <ul class="w-filters__list" data-testid="storefront-filters-departments">
            <li>
                <?php if (!empty($panel['root_current'])): ?>
                    <span class="w-filters__current" data-testid="storefront-filters-dept-root-current"><lang>全部类目</lang></span>
                <?php else: ?>
                    <a class="w-filters__link" href="@url{'categories'}" data-testid="storefront-filters-dept-root">
                        <span aria-hidden="true">‹</span>
                        <lang>全部类目</lang>
                    </a>
                <?php endif; ?>
            </li>
            <?php foreach ($departments as $dept): ?>
                <?php $depth = max(0, (int)($dept['depth'] ?? 0)); ?>
                <li class="w-filters__dept" data-depth="<?= $depth ?>" data-testid="storefront-filters-dept-item">
                    <?php if (!empty($dept['current'])): ?>
                        <span class="w-filters__current" data-testid="storefront-filters-dept-current"><?= $escape($dept['name']) ?></span>
                    <?php else: ?>
                        <a class="w-filters__link" href="<?= $escape($dept['url']) ?>"><?= $escape($dept['name']) ?></a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </section>

    <?php if ($priceOptions !== []): ?>
        <section class="w-filters__section" weline-code="filters-price">
            <h3 class="w-filters__heading"><lang>价格</lang></h3>
            <ul class="w-filters__list" data-testid="storefront-filters-price">
                <?php foreach ($priceOptions as $opt): ?>
                    <li>
                        <a
                            class="w-filters__option<?= !empty($opt['selected']) ? ' is-active' : '' ?>"
                            href="<?= $escape($opt['url']) ?>"
                            aria-current="<?= !empty($opt['selected']) ? 'true' : 'false' ?>"
                        >
                            <span class="w-filters__radio" aria-hidden="true"></span>
                            <span class="w-filters__label"><?= $escape((string)($opt['label'] ?? '')) ?></span>
                            <span class="w-filters__count"><?= (int)$opt['count'] ?></span>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </section>
    <?php endif; ?>

    <?php foreach ($attributeGroups as $groupIndex => $group): ?>
        <?php
        $groupOptions = is_array($group['options'] ?? null) ? $group['options'] : [];
        usort($groupOptions, static function (array $left, array $right): int {
            $selectionOrder = (int)!empty($right['selected']) <=> (int)!empty($left['selected']);
            return $selectionOrder !== 0
                ? $selectionOrder
                : strcasecmp((string)($left['label'] ?? ''), (string)($right['label'] ?? ''));
        });
        $groupHasSelection = count(array_filter(
            $groupOptions,
            static fn(array $option): bool => !empty($option['selected']),
        )) > 0;
        $visibleOptions = array_slice($groupOptions, 0, $visibleOptionLimit);
        $moreOptions = array_slice($groupOptions, $visibleOptionLimit);
        $groupOpen = $groupIndex < 4 || $groupHasSelection;
        ?>
        <details
            class="w-filters__section w-filters__disclosure"
            weline-code="filters-attr-<?= $escape($group['code']) ?>"
            data-filter-code="<?= $escape($group['code']) ?>"
            <?= $groupOpen ? 'open' : '' ?>
        >
            <summary class="w-filters__summary"><?= $escape((string)($group['name'] ?? '')) ?></summary>
            <ul class="w-filters__list" data-testid="storefront-filters-attribute">
                <?php foreach ($visibleOptions as $opt): ?>
                    <li>
                        <a
                            class="w-filters__option<?= !empty($opt['selected']) ? ' is-active' : '' ?>"
                            href="<?= $escape($opt['url']) ?>"
                            aria-current="<?= !empty($opt['selected']) ? 'true' : 'false' ?>"
                        >
                            <span class="w-filters__check" aria-hidden="true"></span>
                            <span class="w-filters__label"><?= $escape((string)($opt['label'] ?? '')) ?></span>
                            <span class="w-filters__count"><?= (int)$opt['count'] ?></span>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>
            <?php if ($moreOptions !== []): ?>
                <details class="w-filters__more">
                    <summary class="w-filters__more-summary">
                        <lang>查看更多</lang>
                        <span aria-hidden="true">(<?= count($moreOptions) ?>)</span>
                    </summary>
                    <ul class="w-filters__list w-filters__list--more" data-testid="storefront-filters-attribute-more">
                        <?php foreach ($moreOptions as $opt): ?>
                            <li>
                                <a
                                    class="w-filters__option<?= !empty($opt['selected']) ? ' is-active' : '' ?>"
                                    href="<?= $escape($opt['url']) ?>"
                                    aria-current="<?= !empty($opt['selected']) ? 'true' : 'false' ?>"
                                >
                                    <span class="w-filters__check" aria-hidden="true"></span>
                                    <span class="w-filters__label"><?= $escape((string)($opt['label'] ?? '')) ?></span>
                                    <span class="w-filters__count"><?= (int)$opt['count'] ?></span>
                                </a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </details>
            <?php endif; ?>
        </details>
    <?php endforeach; ?>

    <?php if ($priceOptions === [] && $attributeGroups === [] && $departments === []): ?>
        <p class="w-filters__empty" data-testid="storefront-filters-empty"><lang>暂无可用筛选条件</lang></p>
    <?php endif; ?>
</aside>
