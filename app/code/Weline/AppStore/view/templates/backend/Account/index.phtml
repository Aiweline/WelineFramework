<?php
$account = $account ?? null;
$isBound = !empty($is_bound);
$authorizeUrl = (string)($authorize_url ?? '');
$redirectUri = trim((string)($redirect_uri ?? ''));
$platformUrl = trim((string)($platform_url ?? ''));
$bindResult = is_array($bind_result ?? null) ? $bind_result : null;

if (($platformUrl === '' || $redirectUri === '') && $authorizeUrl !== '') {
    $authorizeParts = parse_url($authorizeUrl);
    if ($platformUrl === '' && is_array($authorizeParts) && !empty($authorizeParts['scheme']) && !empty($authorizeParts['host'])) {
        $platformUrl = $authorizeParts['scheme'] . '://' . $authorizeParts['host'];
        if (!empty($authorizeParts['port'])) {
            $platformUrl .= ':' . $authorizeParts['port'];
        }
    }
    if ($redirectUri === '' && is_array($authorizeParts) && !empty($authorizeParts['query'])) {
        parse_str((string)$authorizeParts['query'], $authorizeQuery);
        $redirectUri = trim((string)($authorizeQuery['redirect_uri'] ?? ''));
    }
}
?>
<div class="appstore-backend-page">
    <div class="w-cluster" data-align="center" data-justify="end" data-wrap="true" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
        <?php if ($authorizeUrl): ?>
            <a class="w-button" href="<?= htmlspecialchars($authorizeUrl, ENT_QUOTES, 'UTF-8') ?>" target="_blank" rel="noopener noreferrer" data-tone="primary">
                <w:icon name="check" size="sm"></w:icon><?= __('去官网授权') ?>
            </a>
        <?php endif; ?>
    </div>

    <?php if ($bindResult): ?>
        <div class="w-alert <?= !empty($bindResult['success']) ? 'alert-success' : 'alert-danger' ?>" role="alert">
            <?= htmlspecialchars((string)($bindResult['message'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
        </div>
    <?php endif; ?>

    <?php if ($isBound && $account): ?>
        <div class="w-alert" role="alert" data-tone="success">
            <div class="w-text" data-weight="strong"><?= __('当前终端已绑定官方账户') ?></div>
            <div><?= __('邮箱：') ?><?= htmlspecialchars((string)($account->getPlatformEmail() ?: __('未知邮箱')), ENT_QUOTES, 'UTF-8') ?></div>
            <div><?= __('名称：') ?><?= htmlspecialchars((string)($account->getPlatformUsername() ?: __('未设置')), ENT_QUOTES, 'UTF-8') ?></div>
            <?php if ($account->getBoundDomain()): ?>
                <div><?= __('店铺域名：') ?><?= htmlspecialchars((string)$account->getBoundDomain(), ENT_QUOTES, 'UTF-8') ?></div>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="w-alert" role="alert" data-tone="warning">
            <?= __('当前终端尚未绑定官方账户。请点击“去官网授权”，在官网注册或登录后自动回到当前终端。') ?>
        </div>
    <?php endif; ?>

    <div class="w-card">
        <div class="w-card__body">
            <h2 class="h6" style="--w-mb:var(--weline-space-4);"><?= __('授权配置') ?></h2>
            <div class="w-grid" style="--w-row-gap:var(--weline-space-2);--w-mb:0;">
                <div class="w-text" data-weight="strong" style="--w-span:2;"><?= __('官网地址') ?></div>
                <div style="--w-span:10;">
                    <span class="w-text" data-family="mono" data-w-text-wrap="break"><?= htmlspecialchars($platformUrl !== '' ? $platformUrl : '-', ENT_QUOTES, 'UTF-8') ?></span>
                </div>
                <div class="w-text" data-weight="strong" style="--w-span:2;"><?= __('回调地址') ?></div>
                <div style="--w-span:10;">
                    <span class="w-text" data-family="mono" data-w-text-wrap="break"><?= htmlspecialchars($redirectUri !== '' ? $redirectUri : '-', ENT_QUOTES, 'UTF-8') ?></span>
                </div>
            </div>
        </div>
    </div>
</div>
