<?php
$module = is_array($module ?? null) ? $module : [];
$permissions = is_array($required_permissions ?? null) ? $required_permissions : [];
$licenseKey = (string)($license_key ?? '');
$version = (string)($version ?? '');
$installAction = (string)($install_action ?? '');
$storeUrl = (string)($store_url ?? '');
$installedUrl = (string)($installed_url ?? '');
$wlsPanelReturn = !empty($wls_panel_return);
$wlsPanelUrl = (string)($wls_panel_url ?? '');
$authorizeError = trim((string)($authorize_error ?? ''));
$installedState = is_array($installed_state ?? null) ? $installed_state : [];
$isInstalled = !empty($installedState['is_installed']);
$updateAvailable = !empty($installedState['update_available']);
$installedVersion = (string)($installedState['installed_version'] ?? '');
$esc = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$moduleId = (int)($module['module_id'] ?? 0);
$displayName = (string)($module['display_name'] ?? $module['name'] ?? '');
?>
<div class="appstore-install-authorization">
    <?php if ($authorizeError !== ''): ?>
        <div class="w-alert" role="alert" data-tone="danger">
            <div class="w-text" data-weight="strong"><?= __('安装授权未完成') ?></div>
            <div class="w-text" data-size="sm" style="--w-mt:var(--weline-space-1);"><?= $esc($authorizeError) ?></div>
        </div>
    <?php endif; ?>

    <div class="w-card" style="--w-mb:var(--weline-space-4);">
        <div class="w-card__body">
            <div class="w-cluster" data-align="start" data-justify="between" data-wrap="true" style="--w-gap:var(--weline-space-4);">
                <div>
                    <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= __('应用安装授权') ?></div>
                    <h2 class="h4" style="--w-mb:var(--weline-space-2);"><?= $esc($displayName ?: __('待安装应用')) ?></h2>
                    <div class="w-text w-cluster" data-wrap="true" data-tone="muted" data-size="sm" style="--w-gap:var(--weline-space-2);">
                        <span><?= __('模块') ?>: <?= $esc($module['name'] ?? '') ?></span>
                        <span><?= __('版本') ?>: <?= $esc($version) ?></span>
                        <span><?= __('当前终端') ?>: <?= $esc($store_domain ?? \w_env('server.http_host', 'localhost')) ?></span>
                    </div>
                </div>
                <a class="w-button" href="<?= $esc($storeUrl) ?>" data-tone="neutral" data-variant="outline">
                    <w:icon name="arrow-left" size="sm"></w:icon><?= __('返回应用商城') ?>
                </a>
                <?php if ($wlsPanelReturn && $wlsPanelUrl !== ''): ?>
                    <a class="w-button" href="<?= $esc($wlsPanelUrl) ?>" data-tone="primary" data-variant="outline">
                        <w:icon name="circle" size="sm"></w:icon><?= __('Back To WLS Panel') ?>
                    </a>
                <?php endif; ?>
            </div>
        </div>
    </div>

    <?php if ($moduleId > 0 && $licenseKey !== '' && $isInstalled): ?>
        <div class="w-card border-success-subtle">
            <div class="w-card__body w-cluster" data-align="center" data-justify="between" data-wrap="true" style="--w-gap:var(--weline-space-4);">
                <div>
                    <div class="w-text" data-weight="strong" data-tone="success">
                        <w:icon name="check" size="sm"></w:icon><?= __('该应用已安装') ?>
                    </div>
                    <div class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-1);">
                        <?= __('当前终端已安装该应用，不需要重复执行安装授权。') ?>
                        <?php if ($installedVersion !== ''): ?>
                            <?= __('本地版本：') ?><?= $esc($installedVersion) ?>
                        <?php endif; ?>
                    </div>
                    <?php if ($updateAvailable): ?>
                        <div class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-1);"><?= __('检测到商城存在新版本，请进入我的模块走更新流程。') ?></div>
                    <?php endif; ?>
                </div>
                <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                    <a class="w-button" href="<?= $esc($storeUrl) ?>" data-tone="neutral" data-variant="outline">
                        <w:icon name="circle" size="sm"></w:icon><?= __('返回应用商城') ?>
                    </a>
                    <a class="w-button <?= $updateAvailable ? 'btn-primary' : 'btn-outline-primary' ?>" href="<?= $esc($installedUrl ?: $storeUrl) ?>">
                        <i class="bi <?= $updateAvailable ? 'circle' : 'puzzle' ?> me-1"></i><?= $updateAvailable ? __('去更新') : __('我的模块') ?>
                    </a>
                </div>
            </div>
        </div>
    <?php elseif ($moduleId > 0 && $licenseKey !== ''): ?>
        <w:form method="post" action="@var($installAction)">
            <?php if ($wlsPanelReturn): ?>
                <input type="hidden" name="wls_panel_return" value="1">
            <?php endif; ?>
            <input type="hidden" name="module_id" value="<?= $moduleId ?>">
            <input type="hidden" name="license_key" value="<?= $esc($licenseKey) ?>">
            <input type="hidden" name="version" value="<?= $esc($version) ?>">
            <input type="hidden" name="permission_consent" value="1">

            <div class="w-card" style="--w-mb:var(--weline-space-4);">
                <div class="w-card__header" data-w-background="inverse">
                    <div class="w-text" data-weight="strong"><?= __('该应用请求访问以下资源') ?></div>
                    <div class="w-text" data-tone="muted" data-size="sm"><?= __('勾选全部必需权限后，终端才会下载安装到本系统。') ?></div>
                </div>
                <div class="w-list-group list-group-flush">
                    <?php foreach ($permissions as $permission): ?>
                        <?php
                        if (!is_array($permission)) {
                            continue;
                        }
                        $code = (string)($permission['code'] ?? '');
                        if ($code === '') {
                            continue;
                        }
                        ?>
                        <label class="w-list-group__item w-cluster" data-align="start" style="--w-gap:var(--weline-space-4);">
                            <input type="checkbox" name="permissions[]" value="<?= $esc($code) ?>" required style="--w-mt:var(--weline-space-1);">
                            <span class="w-stack" style="--w-gap:var(--weline-space-1);">
                                <span class="w-text" data-weight="strong"><?= $esc($permission['label'] ?? $code) ?></span>
                                <?php if (!empty($permission['description'])): ?>
                                    <span class="w-text" data-tone="muted" data-size="sm"><?= $esc($permission['description']) ?></span>
                                <?php endif; ?>
                                <code class="w-text" data-size="sm"><?= $esc($code) ?></code>
                            </span>
                        </label>
                    <?php endforeach; ?>
                    <?php if (!$permissions): ?>
                        <div class="w-list-group__item w-text" data-tone="muted">
                            <?= __('该应用未声明额外资源权限，将只执行模块包下载、校验和安装。') ?>
                        </div>
                    <?php endif; ?>
                </div>
            </div>

            <div class="w-card">
                <div class="w-card__body w-cluster" data-align="center" data-justify="between" data-wrap="true" style="--w-gap:var(--weline-space-4);">
                    <div>
                        <div class="w-text" data-weight="strong"><?= __('确认授权并安装') ?></div>
                        <div class="w-text" data-tone="muted" data-size="sm"><?= __('授权记录与安装记录会保留在当前终端，用于后续更新、卸载和审计。') ?></div>
                    </div>
                    <button class="w-button" type="submit" data-tone="primary">
                        <w:icon name="check" size="sm"></w:icon><?= __('授权并安装') ?>
                    </button>
                </div>
            </div>
        </w:form>
    <?php endif; ?>
</div>
