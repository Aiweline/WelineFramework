<?php
$logs = is_iterable($logs ?? null) ? $logs : []; $rows = [];
foreach ($logs as $log) { $data = is_object($log) && method_exists($log, 'getData') ? $log->getData() : (array)$log; $rows[] = [ 'log_id' => (int)($data['log_id'] ?? 0), 'module_name' => (string)($data['module_name'] ?? ''), 'version' => (string)($data['version'] ?? ''), 'license_key' => (string)($data['license_key'] ?? ''), 'status' => (string)($data['status'] ?? ''), 'file_path' => (string)($data['file_path'] ?? ''), 'file_size' => (int)($data['file_size'] ?? 0), 'file_hash' => (string)($data['file_hash'] ?? ''), 'error_message' => (string)($data['error_message'] ?? ''), 'download_ip' => (string)($data['download_ip'] ?? ''), 'download_at' => (string)($data['download_at'] ?? ''), 'completed_at' => (string)($data['completed_at'] ?? ''), ];
} $formatSize = static function (int $bytes): string { if ($bytes <= 0) { return '-'; } if ($bytes >= 1048576) { return number_format($bytes / 1048576, 2) . ' MB'; } return number_format($bytes / 1024, 2) . ' KB';
}; $maskSecret = static function (string $value): string { if ($value === '') { return '-'; } if (strlen($value) <= 8) { return str_repeat('*', strlen($value)); } return substr($value, 0, 4) . str_repeat('*', max(0, strlen($value) - 8)) . substr($value, -4);
}; $statusClass = static function (string $status): string { return match ($status) { 'success' => 'bg-success', 'failed' => 'bg-danger', 'pending' => 'bg-warning text-dark', default => '', };
};
?>
