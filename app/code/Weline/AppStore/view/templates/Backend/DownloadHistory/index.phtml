'UTF-8') ?></div> <?php endif; ?> </td> <td> <div><?= $formatSize($row['file_size']) ?></div> <?php if ($row['file_hash'] !== ''): ?> <div class="w-text" data-tone="muted" data-size="sm"><?= __('哈希：') ?><code><?= htmlspecialchars(substr($row['file_hash'], 0, 12), ENT_QUOTES, 'UTF-8') ?></code></div> <?php endif; ?> <?php if ($row['file_path'] !== ''): ?> <div class="w-text" data-w-text-wrap="break" data-tone="muted" data-size="sm"><code><?= htmlspecialchars($row['file_path'], ENT_QUOTES, 'UTF-8') ?></code></div> <?php endif; ?> </td> <td><code><?= htmlspecialchars($maskSecret($row['license_key']), ENT_QUOTES, 'UTF-8') ?></code></td> <td> <div><?= htmlspecialchars($row['download_ip'] ?: '-', ENT_QUOTES, 'UTF-8') ?></div> <div class="w-text" data-tone="muted" data-size="sm"><?= __('官方 App 商店') ?></div> </td> </tr> <?php endforeach; ?> </tbody> </table> </div> <?php else: ?> <div class="w-alert" role="alert" data-tone="info"> <?= __('暂无下载历史。完成一次 App 商店下载后，这里会显示实际下载版本。') ?> </div> <?php endif; ?>
