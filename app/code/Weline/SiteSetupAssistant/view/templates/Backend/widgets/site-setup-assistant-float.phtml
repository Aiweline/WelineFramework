        'href' => $page('websites/admin/domain/index'),
        'module' => 'Weline_Websites',
    ],
];

$total = count($tips);
$done = count(array_filter($tips, static fn(array $t): bool => $t['status'] === 'done'));
$todo = count(array_filter($tips, static fn(array $t): bool => $t['status'] === 'todo'));
$doing = count(array_filter($tips, static fn(array $t): bool => $t['status'] === 'doing'));
$pct = $total > 0 ? (int)round(($done / $total) * 100) : 0;
$remaining = $todo + $doing;
$allDone = $remaining <= 0;

$statusLabel = static function (string $s): string {
    return match ($s) {
        'done' => (string)__('已完成'),
        'doing' => (string)__('进行中'),
        default => (string)__('待办'),
    };
};

$buildVariantUrl = static function (string $v) use ($websiteId): string {
    $params = $_GET;
    $params['variant'] = $v;
    $params['website_id'] = (string)$websiteId;
    $q = http_build_query($params);
    $path = strtok((string)($_SERVER['REQUEST_URI'] ?? ''), '?') ?: '';
    return $path . ($q !== '' ? '?' . $q : '');
};

if ($allDone) {
    return;
}
?>

<div class="ssa-float"
     id="ssa-float-root"
     data-ssa-float="1"
     data-ssa-variant="<?= $h($variant) ?>"
     data-ssa-website-id="<?= $h((string)$websiteId) ?>"
     data-ssa-remaining="<?= $h((string)$remaining) ?>"
     hidden>
    <div class="ssa-float__panel" data-ssa-panel hidden>
        <div class="ssa-float__head">
            <div>
                <p class="ssa-float__kicker"><?= $h(__('建站助手')) ?></p>
                <p class="ssa-float__title"><?= $h($websiteLabel) ?></p>
                <p class="ssa-float__meta"><?= $h(__('进度 %{1}/%{2} · 还差 %{3} 项', [(string)$done, (string)$total, (string)$remaining])) ?></p>
            </div>
            <button type="button" class="ssa-float__icon-btn" data-ssa-close aria-label="<?= $h(__('收起助手')) ?>">×</button>
