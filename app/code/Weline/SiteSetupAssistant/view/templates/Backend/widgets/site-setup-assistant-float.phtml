$h = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$variant = strtoupper(trim((string)($_GET['variant'] ?? 'B')));
if (!in_array($variant, ['A', 'B', 'C'], true)) {
    $variant = 'B';
}
$websiteId = (int)($dashboard_website_id ?? $this->getData('dashboard_website_id') ?? $this->getData('website_id') ?? ($_GET['website_id'] ?? 0));
$websiteLabel = (string)($dashboard_website_display ?? $this->getData('dashboard_website_display') ?? $this->getData('website_name') ?? '');
if ($websiteLabel === '') {
    $websiteLabel = '#' . $websiteId;
}

$backendPrefix = '';
try {
    $env = \Weline\Framework\App\Env::getInstance()->getConfig('router')['area_routes']['backend']['prefix'] ?? '';
    $backendPrefix = is_string($env) ? trim($env, '/') : '';
} catch (\Throwable) {
    $backendPrefix = '';
}
$cfg = static function (string $module, string $area, string $guideKey, string $title = '') use ($backendPrefix): string {
    $q = http_build_query(array_filter([
        'module' => $module,
        'area' => $area,
        'guide_key' => $guideKey,
        'guide_title' => $title !== '' ? $title : null,
    ], static fn($v) => $v !== null && $v !== ''));
    $path = 'weline_systemconfig/backend/config?' . $q;
    return $backendPrefix !== '' ? '/' . $backendPrefix . '/' . $path : '/' . $path;
};
$page = static function (string $action) use ($backendPrefix): string {
    $action = ltrim($action, '/');
    return $backendPrefix !== '' ? '/' . $backendPrefix . '/' . $action : '/' . $action;
};

