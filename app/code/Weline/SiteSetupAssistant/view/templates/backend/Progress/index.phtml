<script>
(function () {
    'use strict';
    var root = document.querySelector('[data-testid="ssa-progress-page"]');
    var input = document.querySelector('[data-testid="ssa-progress-search"]');
    var empty = document.querySelector('[data-testid="ssa-progress-search-empty"]');
    var statusEmpty = document.querySelector('[data-testid="ssa-progress-status-empty"]');
    var form = document.getElementById('ssa-progress-filter');
    var tablist = document.querySelector('[data-testid="ssa-progress-status-tabs"]');
    var panel = document.getElementById('ssa-progress-task-panel');
    if (!root) {
        return;
    }
    if (form && input) {
        form.addEventListener('submit', function (e) {
            // 搜索框回车只做前端筛选，避免误触维度表单提交
            if (document.activeElement === input) {
                e.preventDefault();
            }
        });
    }
    var activeStatus = 'todo';
    if (tablist) {
        var activeBtn = tablist.querySelector('.ssa-progress__status-tab.is-active');
        if (activeBtn) {
            activeStatus = activeBtn.getAttribute('data-status-tab') || 'todo';
        }
    }
    function norm(s) {
        return String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }
    function applyFilter() {
        var q = input ? norm(input.value) : '';
        var tasks = root.querySelectorAll('.ssa-progress__task');
        var visibleTasks = 0;
        var statusMatched = 0;
        tasks.forEach(function (task) {
            var status = task.getAttribute('data-status') || 'todo';
            var statusOk = !activeStatus || status === activeStatus;
            task.classList.toggle('is-status-hidden', !statusOk);
            if (!statusOk) {
                return;
            }
            statusMatched += 1;
            var coverItems = task.querySelectorAll('.ssa-progress__coverage-item');
            var taskBlob = norm(
                (task.getAttribute('data-code') || '') + ' ' + (task.textContent || '')
            );
            var taskMatch = q === '' || taskBlob.indexOf(q) !== -1;
            var anyCoverVisible = coverItems.length === 0;
            coverItems.forEach(function (item) {
                var coverMatch = q === '' || taskMatch || norm(item.textContent).indexOf(q) !== -1;
                item.classList.toggle('is-search-hidden', q !== '' && !coverMatch);
                if (coverMatch) {
                    anyCoverVisible = true;
                }
            });
            var show = q === '' || taskMatch || anyCoverVisible;
            task.classList.toggle('is-search-hidden', !show);
            if (show) {
                visibleTasks += 1;
            }
        });
        if (empty) {
            empty.hidden = !(q !== '' && visibleTasks === 0 && statusMatched > 0);
        }
        if (statusEmpty) {
            statusEmpty.hidden = !(statusMatched === 0);
        }
    }
    function setStatusTab(status, btn) {
        activeStatus = status || 'todo';
        if (!tablist) {
            applyFilter();
            return;
        }
        tablist.querySelectorAll('.ssa-progress__status-tab').forEach(function (tab) {
            var on = tab === btn;
            tab.classList.toggle('is-active', on);
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        if (panel && btn && btn.id) {
            panel.setAttribute('aria-labelledby', btn.id);
        }
        applyFilter();
    }
    if (tablist) {
        tablist.querySelectorAll('.ssa-progress__status-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                setStatusTab(tab.getAttribute('data-status-tab') || 'todo', tab);
            });
            tab.addEventListener('keydown', function (e) {
                var tabs = Array.prototype.slice.call(tablist.querySelectorAll('.ssa-progress__status-tab'));
                var idx = tabs.indexOf(tab);
                if (idx < 0) {
                    return;
                }
                var next = -1;
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                    next = (idx + 1) % tabs.length;
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                    next = (idx - 1 + tabs.length) % tabs.length;
                } else if (e.key === 'Home') {
                    next = 0;
                } else if (e.key === 'End') {
                    next = tabs.length - 1;
                }
                if (next < 0) {
                    return;
                }
                e.preventDefault();
                tabs[next].focus();
                setStatusTab(tabs[next].getAttribute('data-status-tab') || 'todo', tabs[next]);
            });
        });
    }
    if (input) {
        input.addEventListener('input', applyFilter);
        input.addEventListener('search', applyFilter);
    }
    applyFilter();
})();
</script>
