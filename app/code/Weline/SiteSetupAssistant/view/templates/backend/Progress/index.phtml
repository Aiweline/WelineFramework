<?php
/**
 * 建站助手进度：默认全局总览；选择站点后为单站维度
 *
 * @var \Weline\Framework\View\Template $this
 */
$h = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$tasks = is_array($this->getData('tasks')) ? $this->getData('tasks') : [];
$stats = is_array($this->getData('stats')) ? $this->getData('stats') : [];
$siteCapsules = is_array($this->getData('site_capsules')) ? $this->getData('site_capsules') : [];
$isGlobal = (bool)$this->getData('is_global');
$dimension = (string)$this->getData('dimension');
$websiteLabel = (string)$this->getData('website_label');
$websiteIdRaw = $this->getData('website_id');
$currentWebsiteId = $websiteIdRaw === null ? null : (int)$websiteIdRaw;
$total = (int)($stats['total'] ?? 0);
$done = (int)($stats['done'] ?? 0);
$todo = (int)($stats['todo'] ?? 0);
$doing = (int)($stats['doing'] ?? 0);
$remaining = (int)($stats['remaining'] ?? 0);
$pct = (int)($stats['pct'] ?? 0);

$statusLabel = static function (string $s): string {
    return match ($s) {
        'done' => (string)__('已完成'),
        'doing' => (string)__('进行中'),
        default => (string)__('待办'),
    };
};

// 后台有 <base href="/{backend_prefix}/">：相对 "?website_id=" 会落到前缀根而不是本页，必须用进度页绝对路径
$progressPath = '/weline_sitesetupassistant/backend/progress/index';
try {
    $env = \Weline\Framework\App\Env::getInstance()->getConfig('router')['area_routes']['backend']['prefix'] ?? '';
    $prefix = is_string($env) ? trim($env, '/') : '';
    if ($prefix !== '') {
        $progressPath = '/' . $prefix . '/weline_sitesetupassistant/backend/progress/index';
    }
} catch (\Throwable) {
}
$buildProgressUrl = static function (array $params = []) use ($progressPath): string {
    $q = http_build_query($params);
    return $progressPath . ($q !== '' ? '?' . $q : '');
};
?>
<div class="w-backend-page ssa-progress" data-testid="ssa-progress-page" data-dimension="<?= $h($dimension) ?>">
    <header class="w-backend-page__header">
        <div>
            <p class="w-backend-page__kicker"><?= $h(__('网站服务')) ?></p>
            <h1 class="w-backend-page__title">
                <?= $h($isGlobal ? __('建站助手 · 全站') : __('建站助手进度')) ?>
            </h1>
            <p class="w-backend-page__desc">
                <?= $h($isGlobal
                    ? __('默认全站视图：下方胶囊提示各站未完成数，点击即可切到该站。')
                    : __('站点维度：仅当前站点任务；点「全站」或其它胶囊可切换。')) ?>
            </p>
        </div>
    </header>

    <section class="w-card ssa-progress__toolbar">
        <div class="w-card__body">
            <form method="get" action="<?= $h($progressPath) ?>" class="ssa-progress__filter" id="ssa-progress-filter" data-testid="ssa-progress-filter">
                <label class="ssa-progress__label" for="ssa_progress_website_select"><?= $h(__('维度')) ?></label>
                <div class="ssa-progress__site">
                    <w:websites:website:select
                        id="ssa_progress_website_select"
                        name="website_id"
                        value="websiteId"
                        display="websiteDisplay"
                        options="websiteSelectOptionsJson"
                        multiple="false"
                        allow-empty="true"
                        empty-label="@lang(全站)"
                        placeholder="@lang(搜索站点或选全站)"
                        auto-submit="true"
                        form="ssa-progress-filter"
                    />
                </div>
                <label class="ssa-progress__label" for="ssa_progress_task_search"><?= $h(__('搜索')) ?></label>
                <div class="ssa-progress__search">
                    <input
                        type="search"
                        id="ssa_progress_task_search"
                        class="ssa-progress__search-input"
                        data-testid="ssa-progress-search"
                        placeholder="<?= $h(__('搜索任务、模块、站点…')) ?>"
                        autocomplete="off"
                        enterkeyhint="search"
                    />
                </div>
                <noscript>
                    <button type="submit" class="w-button" data-variant="primary"><?= $h(__('切换')) ?></button>
                </noscript>
            </form>

            <div class="ssa-progress__capsules" data-testid="ssa-progress-capsules" role="navigation" aria-label="<?= $h(__('站点未完成提示')) ?>">
                <a class="ssa-progress__capsule<?= $isGlobal ? ' is-active' : '' ?>"
                   href="<?= $h($buildProgressUrl([])) ?>"
                   data-website-id="global"
                   title="<?= $h(__('全站视图')) ?>">
                    <span class="ssa-progress__capsule-name"><?= $h(__('全站')) ?></span>
                </a>
                <?php foreach ($siteCapsules as $cap): ?>
                    <?php
                    $capId = (int)($cap['website_id'] ?? -1);
                    $capRem = (int)($cap['remaining'] ?? 0);
                    $capLabel = (string)($cap['label'] ?? ('#' . $capId));
                    $capActive = !$isGlobal && $currentWebsiteId !== null && $currentWebsiteId === $capId;
                    $capHref = $buildProgressUrl(['website_id' => $capId]);
                    ?>
                    <a class="ssa-progress__capsule<?= $capActive ? ' is-active' : '' ?>"
                       href="<?= $h($capHref) ?>"
                       data-website-id="<?= $h((string)$capId) ?>"
                       title="<?= $h(__('切到该站查看未完成任务')) ?>">
                        <span class="ssa-progress__capsule-name">#<?= $h((string)$capId) ?> <?= $h($capLabel) ?></span>
                        <span class="ssa-progress__capsule-count"><?= $h((string)$capRem) ?></span>
                    </a>
                <?php endforeach; ?>
                <?php if ($siteCapsules === []): ?>
                    <span class="ssa-progress__capsule-empty"><?= $h(__('各站任务均已完成')) ?></span>
                <?php endif; ?>
            </div>

            <p class="ssa-progress__meta" data-testid="ssa-progress-meta">
                <?= $h(__('当前：%{1} · 进度 %{2}/%{3} · 还差 %{4} 项（%{5}%）', [
                    $websiteLabel,
                    (string)$done,
                    (string)$total,
                    (string)$remaining,
                    (string)$pct,
                ])) ?>
            </p>
            <div class="ssa-progress__meter" role="progressbar" aria-valuenow="<?= $h((string)$pct) ?>" aria-valuemin="0" aria-valuemax="100">
                <span style="width:<?= $h((string)$pct) ?>%"></span>
