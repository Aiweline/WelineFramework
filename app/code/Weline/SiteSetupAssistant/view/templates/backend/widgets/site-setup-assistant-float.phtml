<?php
/**
 * @widget.source {Weline_SiteSetupAssistant::css/widgets/widget-site-setup-assistant-float.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_SiteSetupAssistant::js/widgets/widget-site-setup-assistant-float-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 建站助手悬浮部件（backend-float）
 * 默认全站；主界面胶囊提示各站未完成数，点击切站。不默认跟随仪表盘子站。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {site-setup-assistant-float}
 * @widget.name {建站助手（悬浮）}
 * @widget.description {按站点展示上线/迁站贴士与任务进度；右下角悬浮，完成后不展示。由 backend base::body-end hook 挂载（主题编辑器自有壳 theme-editor 不挂）。}
 * @widget.type {float}
 * @widget.area {backend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["default","dashboard","fullscreen"]}
 * @widget.slot {}
 * @widget.supports {["backend-shell-float","site-setup-assistant"]}
 */
$h = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$variant = strtoupper(trim((string)($_GET['variant'] ?? 'B')));
if (!in_array($variant, ['A', 'B', 'C'], true)) {
    $variant = 'B';
}
$showProto = ((string)($_GET['ssa_proto'] ?? '')) === '1';

// 悬浮助手固定全站：不跟随仪表盘/其它页的 website_id（避免默认落到子站）
$progressPath = '';
try {
    $env = \Weline\Framework\App\Env::getInstance()->getConfig('router')['area_routes']['backend']['prefix'] ?? '';
    $prefix = is_string($env) ? trim($env, '/') : '';
    $action = 'weline_sitesetupassistant/backend/progress/index';
    $progressPath = $prefix !== '' ? '/' . $prefix . '/' . $action : '/' . $action;
} catch (\Throwable) {
    $progressPath = '/weline_sitesetupassistant/backend/progress/index';
}

$tips = [];
$siteCapsules = [];
$websiteLabel = (string)__('全站');
try {
    /** @var \Weline\SiteSetupAssistant\Service\SetupTaskCollector $taskCollector */
    $taskCollector = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\SiteSetupAssistant\Service\SetupTaskCollector::class
    );
    $tips = $taskCollector->collectGlobalOverview();
    $siteCapsules = $taskCollector->summarizeIncompleteSites($tips);
} catch (\Throwable) {
    $tips = [];
    $siteCapsules = [];
}

$groupOf = static fn(array $t): string => (string)($t['group'] ?? 'setup');
$setupTips = array_values(array_filter(
    $tips,
    static fn(array $t): bool => $groupOf($t) !== 'performance'
));
$perfTipsOpen = array_values(array_filter(
    $tips,
    static fn(array $t): bool => $groupOf($t) === 'performance' && ($t['status'] ?? '') !== 'done'
));
$total = count($setupTips);
$done = count(array_filter($setupTips, static fn(array $t): bool => ($t['status'] ?? '') === 'done'));
$todo = count(array_filter($setupTips, static fn(array $t): bool => ($t['status'] ?? '') === 'todo'));
$doing = count(array_filter($setupTips, static fn(array $t): bool => ($t['status'] ?? '') === 'doing'));
$pct = $total > 0 ? (int)round(($done / $total) * 100) : 0;
$remaining = $todo + $doing;
$perfRemaining = count($perfTipsOpen);
$capsuleRemainingSum = 0;
foreach ($siteCapsules as $cap) {
    $capsuleRemainingSum += (int)($cap['remaining'] ?? 0);
}
$fabRemaining = max($remaining + $perfRemaining, $capsuleRemainingSum + $perfRemaining);
$allDone = $capsuleRemainingSum <= 0 && $remaining <= 0 && $perfRemaining <= 0;

$statusLabel = static function (string $s): string {
    return match ($s) {
        'done' => (string)__('已完成'),
        'doing' => (string)__('进行中'),
        default => (string)__('待办'),
    };
};

$buildUrl = static function (array $overrides) use ($progressPath): string {
    $params = [];
    if (array_key_exists('website_id', $overrides) && $overrides['website_id'] !== null && $overrides['website_id'] !== '') {
        $params['website_id'] = (string)$overrides['website_id'];
    }
    if (isset($overrides['variant'])) {
        $params['variant'] = (string)$overrides['variant'];
    }
    $q = http_build_query($params);
    return $progressPath . ($q !== '' ? '?' . $q : '');
};

$buildVariantUrl = static function (string $v) use ($buildUrl): string {
    $url = $buildUrl(['variant' => $v]);
    return $url . (str_contains($url, '?') ? '&' : '?') . 'ssa_proto=1';
};

if ($allDone) {
    return;
}
?>

<div class="ssa-float"
     id="ssa-float-root"
     data-ssa-float="1"
     data-ssa-variant="<?= $h($variant) ?>"
     data-ssa-dimension="global"
     data-ssa-website-id="global"
     data-ssa-remaining="<?= $h((string)$fabRemaining) ?>">
    <button type="button"
            class="ssa-float__scrim"
            data-ssa-close
            data-ssa-scrim
            data-testid="ssa-float-scrim"
            hidden
            aria-label="<?= $h(__('收起助手')) ?>"></button>
    <div class="ssa-float__panel" data-ssa-panel hidden>
        <div class="ssa-float__head">
            <div>
                <p class="ssa-float__kicker"><?= $h(__('建站助手')) ?></p>
                <p class="ssa-float__title"><?= $h($websiteLabel) ?></p>
                <p class="ssa-float__meta"><?= $h(__('进度 %{1}/%{2} · 还差 %{3} 项', [(string)$done, (string)$total, (string)$remaining])) ?></p>
            </div>
            <button type="button"
                    class="ssa-float__icon-btn"
                    data-ssa-close
                    data-testid="ssa-float-close"
                    title="<?= $h(__('收起助手')) ?>"
                    aria-label="<?= $h(__('收起助手')) ?>">×</button>
        </div>

        <div class="ssa-float__body">
        <div class="ssa-float__capsules" data-testid="ssa-float-capsules" role="navigation" aria-label="<?= $h(__('站点未完成提示')) ?>">
            <a class="ssa-float__capsule is-active"
               href="<?= $h($buildUrl([])) ?>"
               data-website-id="global">
                <span><?= $h(__('全站')) ?></span>
            </a>
            <?php foreach ($siteCapsules as $cap): ?>
                <?php
                $capId = (int)($cap['website_id'] ?? -1);
                $capRem = (int)($cap['remaining'] ?? 0);
                $capLabel = (string)($cap['label'] ?? ('#' . $capId));
                ?>
                <a class="ssa-float__capsule"
                   href="<?= $h($buildUrl(['website_id' => (string)$capId])) ?>"
                   data-website-id="<?= $h((string)$capId) ?>"
                   title="<?= $h(__('切到该站')) ?>">
                    <span>#<?= $h((string)$capId) ?> <?= $h($capLabel) ?></span>
                    <em><?= $h((string)$capRem) ?></em>
                </a>
            <?php endforeach; ?>
        </div>

        <div class="ssa-float__meter" role="progressbar" aria-valuenow="<?= $h((string)$pct) ?>" aria-valuemin="0" aria-valuemax="100">
            <span data-widget-style="width:<?= $h((string)$pct) ?>%"></span>
        </div>

        <div class="ssa-float__scenes" role="group" aria-label="<?= $h(__('场景')) ?>">
            <button type="button" class="is-active" data-ssa-scene="new"><?= $h(__('新站上线')) ?></button>
            <button type="button" data-ssa-scene="migrate"><?= $h(__('迁站核对')) ?></button>
        </div>

        <?php
        $renderTaskB = static function (array $tip) use ($h, $statusLabel): void {
            ?>
            <div class="ssa-float-b__task"
                 data-status="<?= $h($tip['status']) ?>"
                 data-group="<?= $h((string)($tip['group'] ?? 'setup')) ?>"
                 data-scenes="<?= $h(implode(',', $tip['scenarios'] ?? ['new', 'migrate'])) ?>">
                <label>
                    <input type="checkbox"
                           <?= ($tip['status'] ?? '') === 'done' ? 'checked' : '' ?>
                           disabled
                           aria-label="<?= $h($statusLabel((string)($tip['status'] ?? 'todo'))) ?>">
                </label>
                <div>
                    <p class="ssa-float-b__name">
                        <em class="ssa-float-b__status"><?= $h($statusLabel((string)($tip['status'] ?? 'todo'))) ?></em>
                        <?= $h($tip['title'] ?? '') ?>
                    </p>
                    <p class="ssa-float-b__tip"><?= $h($tip['tip'] ?? '') ?></p>
                    <small><?= $h(($tip['module'] ?? '') . (($tip['category'] ?? '') !== '' ? ' · ' . $tip['category'] : '')) ?></small>
                </div>
                <?php if (($tip['href'] ?? '') !== ''): ?>
                    <a class="w-button" data-variant="outline" data-size="sm" href="<?= $h($tip['href']) ?>"><?= $h(__('深度链接')) ?></a>
                <?php endif; ?>
            </div>
            <?php
        };
        ?>

        <?php if ($variant === 'A'): ?>
            <?php if ($perfTipsOpen !== []): ?>
                <div class="ssa-float__group" data-ssa-group="performance">
                    <p class="ssa-float__group-title"><?= $h(__('性能优化')) ?></p>
                    <ul class="ssa-float-a">
                        <?php foreach ($perfTipsOpen as $tip): ?>
                            <li data-scenes="<?= $h(implode(',', $tip['scenarios'])) ?>" data-group="performance">
                                <div>
                                    <strong><?= $h($tip['title']) ?></strong>
                                    <span><?= $h($tip['tip']) ?></span>
                                </div>
                                <a href="<?= $h($tip['href']) ?>"><?= $h(__('去处理')) ?></a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </div>
            <?php endif; ?>
            <div class="ssa-float__group" data-ssa-group="setup">
                <p class="ssa-float__group-title"><?= $h(__('建站任务')) ?></p>
                <ul class="ssa-float-a">
                    <?php foreach ($setupTips as $tip): ?>
                        <?php if ($tip['status'] === 'done') { continue; } ?>
                        <li data-scenes="<?= $h(implode(',', $tip['scenarios'])) ?>" data-group="setup">
                            <div>
                                <strong><?= $h($tip['title']) ?></strong>
                                <span><?= $h($tip['tip']) ?></span>
                            </div>
                            <a href="<?= $h($tip['href']) ?>"><?= $h(__('去配置')) ?></a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
        <?php elseif ($variant === 'C'): ?>
            <?php if ($perfTipsOpen !== []): ?>
                <div class="ssa-float__group" data-ssa-group="performance">
                    <p class="ssa-float__group-title"><?= $h(__('性能优化')) ?></p>
                    <div class="ssa-float-c">
                        <?php foreach ($perfTipsOpen as $tip): ?>
                            <div class="ssa-float-c__card" data-scenes="<?= $h(implode(',', $tip['scenarios'])) ?>" data-group="performance">
                                <strong><?= $h($tip['title']) ?></strong>
                                <a href="<?= $h($tip['href']) ?>"><?= $h(__('打开')) ?></a>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endif; ?>
            <div class="ssa-float__group" data-ssa-group="setup">
                <p class="ssa-float__group-title"><?= $h(__('建站任务')) ?></p>
                <div class="ssa-float-c">
                    <?php
                    $columns = [
                        'todo' => (string)__('待办'),
                        'doing' => (string)__('进行中'),
                        'done' => (string)__('已完成'),
                    ];
                    foreach ($columns as $key => $label):
                        $colTips = array_values(array_filter($setupTips, static fn(array $t): bool => $t['status'] === $key));
                        ?>
                        <div class="ssa-float-c__col" data-status="<?= $h($key) ?>">
                            <div class="ssa-float-c__col-head"><strong><?= $h($label) ?></strong><em><?= $h((string)count($colTips)) ?></em></div>
                            <?php foreach ($colTips as $tip): ?>
                                <div class="ssa-float-c__card" data-scenes="<?= $h(implode(',', $tip['scenarios'])) ?>" data-group="setup">
                                    <strong><?= $h($tip['title']) ?></strong>
                                    <a href="<?= $h($tip['href']) ?>"><?= $h(__('打开')) ?></a>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php else: ?>
            <?php if ($perfTipsOpen !== []): ?>
                <div class="ssa-float__group" data-ssa-group="performance" data-testid="ssa-float-perf-group">
                    <p class="ssa-float__group-title"><?= $h(__('性能优化')) ?>
                        <em><?= $h((string)$perfRemaining) ?></em>
                    </p>
                    <div class="ssa-float-b">
                        <?php foreach ($perfTipsOpen as $tip): ?>
                            <?php $renderTaskB($tip); ?>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endif; ?>
            <div class="ssa-float__group" data-ssa-group="setup" data-testid="ssa-float-setup-group">
                <p class="ssa-float__group-title"><?= $h(__('建站任务')) ?></p>
                <div class="ssa-float-b">
                    <?php foreach ($setupTips as $tip): ?>
                        <?php $renderTaskB($tip); ?>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endif; ?>
        </div><!-- /.ssa-float__body -->

        <?php if ($showProto): ?>
            <div class="ssa-float__foot ssa-float__foot--proto">
                <span data-ssa-state>variant=<?= $h($variant) ?>; dim=global; website=global; open=?</span>
                <div class="ssa-float__variants" aria-label="<?= $h(__('面板布局原型')) ?>">
                    <a href="<?= $h($buildVariantUrl('A')) ?>" class="<?= $variant === 'A' ? 'is-active' : '' ?>">A</a>
                    <a href="<?= $h($buildVariantUrl('B')) ?>" class="<?= $variant === 'B' ? 'is-active' : '' ?>">B</a>
                    <a href="<?= $h($buildVariantUrl('C')) ?>" class="<?= $variant === 'C' ? 'is-active' : '' ?>">C</a>
                </div>
            </div>
        <?php else: ?>
            <div class="ssa-float__foot ssa-float__foot--prod">
                <button type="button" class="ssa-float__foot-close" data-ssa-close><?= $h(__('收起')) ?></button>
                <a href="<?= $h($buildUrl([])) ?>"><?= $h(__('查看完整进度')) ?></a>
            </div>
        <?php endif; ?>
    </div>

    <button type="button"
            class="ssa-float__fab"
            data-ssa-toggle
            data-label-open="<?= $h(__('建站助手')) ?>"
            data-label-close="<?= $h(__('收起')) ?>"
            aria-expanded="false">
        <span class="ssa-float__fab-label" data-ssa-fab-label><?= $h(__('建站助手')) ?></span>
        <span class="ssa-float__badge" data-ssa-fab-badge title="<?= $h(__('未完成项')) ?>"><?= $h((string)$fabRemaining) ?></span>
    </button>
</div>

<span hidden data-widget-script="sitesetupassistant-site-setup-assistant-float-0"></span>
