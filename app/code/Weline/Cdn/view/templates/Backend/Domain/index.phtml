<js:part>
(function() {
    'use strict';

    function confirmAction(message, onConfirm) {
        Weline.UI.dialog.confirm(message).then(function(confirmed) {
            if (confirmed) {
                onConfirm();
            }
        });
        return;
        if (window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
            window.Weline.UI.toast.error('<?= __('确认组件不可用，请刷新页面后重试。') ?>');
        }
    }

    document.addEventListener('click', function(event) {
        var target = event.target instanceof Element
            ? event.target.closest('[data-cdn-domain-action]')
            : null;
        if (!target) {
            return;
        }

        if (target.dataset.cdnDomainAction === 'toggle-enable') {
            window.CdnDomainManager.toggleEnable(target.dataset.domainId || '', target.dataset.enabled || '0');
            return;
        }

        if (target.dataset.cdnDomainAction === 'clear-cache') {
            window.CdnDomainManager.clearCache(target.dataset.domainId || '');
        }
    });

    window.CdnDomainManager = {
        toggleEnable: function(id, enabled) {
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').toggleDomainEnable({ domain_id: id, enabled: enabled }); })
            .then(function(data) {
                if (data && data.success !== false) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: data.message,
                        duration: 2000,
                        confirmable: false
                    }).then(function() { location.reload(); });
                } else {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('操作失败') ?>',
                        message: data.message,
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            });
        },

        clearCache: function(id) {
            Weline.UI.dialog.request({
                title: '<?= __('确认清理缓存') ?>',
                message: '<?= __('确定要清理该域名的所有缓存吗？') ?>',
                tone: 'info',
                cancelable: true,
                confirmLabel: '<?= __("确定清理") ?>',
                cancelLabel: '<?= __("取消") ?>',
                confirmTone: 'warning'
            }).then(function(result) {
                if (result.confirmed) {
                    window.CdnDomainManager.performClearCache(id);
                }
            });
        },

        performClearCache: function(id) {
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').clearDomainCache({ domain_id: id, mode: 'everything' }); })
            .then(function(data) {
                if (data && data.success !== false) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: data.message,
                        duration: 2000,
                        confirmable: false
                    });
                } else {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('清理失败') ?>',
                        message: data.message,
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            });
        }
    };
})();
</js:part>
