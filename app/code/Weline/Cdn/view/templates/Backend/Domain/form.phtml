<js:part>
(function() {
    'use strict';

    var isIframe = <?= $isIframe ? 'true' : 'false' ?>;
    var indexUrl = '@backend-url{'*/backend/domain/index'}';
    var accountsByAdapter = <?= json_encode($accounts, $jsonForScriptFlags) ?>;
    var currentDomainAccountId = <?= $domain && $domain->getData('account_id') ? (int)$domain->getData('account_id') : 'null' ?>;

    var domainForm = document.getElementById('domainForm');
    var adapterSelect = document.getElementById('adapterSelect');
    var accountSelect = document.getElementById('accountSelect');
    var accountEmptyHint = document.getElementById('accountEmptyHint');
    var inheritDefault = document.getElementById('inheritDefault');
    var siteSelect = document.getElementById('siteSelect');
    var domainNameInput = document.getElementById('domainNameInput');

    function setAccountEmptyHint(visible) {
        if (!accountEmptyHint) {
            return;
        }
        if (visible) {
            accountEmptyHint.removeAttribute('hidden');
        } else {
            accountEmptyHint.setAttribute('hidden', 'hidden');
        }
    }

    function updateAccountSelect(adapterCode) {
        accountSelect.innerHTML = '<option value=""><?= __('请选择账户（可选）') ?></option>';
        setAccountEmptyHint(false);

        if (!adapterCode) {
            accountSelect.disabled = true;
            accountSelect.innerHTML = '<option value=""><?= __('请先选择适配器') ?></option>';
            return;
        }

        var accounts = accountsByAdapter[adapterCode] || [];

        if (accounts.length === 0) {
            accountSelect.disabled = inheritDefault ? inheritDefault.checked : false;
            accountSelect.innerHTML = '<option value=""><?= __('该适配器暂无可用账户') ?></option>';
            setAccountEmptyHint(true);
            return;
        }

        accounts.forEach(function(account) {
            var option = document.createElement('option');
            option.value = account.account_id;
            option.textContent = account.name + (account.is_default ? ' (<?= __('默认') ?>)' : '');

            if (currentDomainAccountId && currentDomainAccountId == account.account_id) {
                option.selected = true;
            }

            accountSelect.appendChild(option);
        });

        accountSelect.disabled = inheritDefault.checked;
    }

    if (adapterSelect) {
        adapterSelect.addEventListener('change', function() {
            updateAccountSelect(this.value);
        });
    }

    if (inheritDefault) {
        inheritDefault.addEventListener('change', function() {
            accountSelect.disabled = this.checked;
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (adapterSelect && adapterSelect.value) {
            updateAccountSelect(adapterSelect.value);
        }
    });

    if (siteSelect) {
        siteSelect.addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];
            var siteUrl = selectedOption.getAttribute('data-url');

            if (siteUrl && domainNameInput && !domainNameInput.value) {
                try {
                    var url = new URL(siteUrl);
                    var hostname = url.hostname;

                    if (hostname) {
                        domainNameInput.value = hostname;
                    }
                } catch (e) {
                    var match = siteUrl.match(/^(?:https?:\/\/)?(?:www\.)?([^\/]+)/i);
                    if (match && match[1]) {
                        domainNameInput.value = match[1];
                    }
                }
            }
        });
    }

    if (domainForm && !isIframe) {
        domainForm.addEventListener('submit', function(e) {
            e.preventDefault();

            var formData = new FormData(this);
            var params = {};
            formData.forEach(function(v, k) { params[k] = v; });
            if (params.id) { params.domain_id = params.id; }
            delete params.id;
            delete params.csrf;
            if (!params.account_id) { delete params.account_id; }
            params.site_id = Number(params.site_id);
            params.warmup_interval_seconds = Number(params.warmup_interval_seconds || 300);
            // 必须传 0/1 整数：PostgreSQL integer 列不能绑 JS boolean（false→空串会保存失败）
            params.inherit_default = params.inherit_default === '1' ? 1 : 0;
            params.enabled = params.enabled === '1' ? 1 : 0;
            domainForm.dataset.state = 'saving';
            domainForm.dataset.message = '';
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').saveDomain(params); })
            .then(function(data) {
                if (data.success) {
                    domainForm.dataset.state = 'saved';
                    domainForm.dataset.message = data.message || '';
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: data.message,
                        duration: 2000,
                        confirmable: false
                    }).then(function() {
                        window.location.href = data.redirect || indexUrl;
                    });
                } else {
                    domainForm.dataset.state = 'error';
                    domainForm.dataset.message = data.message || '<?= __('保存失败') ?>';
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('保存失败') ?>',
                        message: data.message,
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            })
            .catch(function(error) {
                domainForm.dataset.state = 'error';
                domainForm.dataset.message = error && error.message ? error.message : String(error);
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('保存失败') ?>',
                    message: (error && error.message) ? error.message : '<?= __('保存失败，请稍后重试') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
            });
        });
    }
})();
</js:part>
