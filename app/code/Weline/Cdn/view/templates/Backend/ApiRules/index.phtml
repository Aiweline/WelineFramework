                    <div class="w-field__control"><input type="number" class="w-input" id="cdn-fpc-edit-ttl" name="ttl" min="1" step="1" inputmode="numeric" aria-describedby="cdn-fpc-ttl-error cdn-fpc-ttl-hint"></div>
                    <small class="w-field__hint" id="cdn-fpc-ttl-hint" data-cdn-ttl-hint></small>
                    <small class="w-field__hint" id="cdn-fpc-ttl-error" data-tone="danger" hidden><lang>请输入大于 0 的整数秒；关闭缓存请使用启用开关。</lang></small>
                    <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm" data-cdn-action="restore" data-fields="ttl"><lang>恢复 TTL 继承</lang></button>
                </div>
                <div class="w-alert cdn-fpc-error" data-tone="danger" role="alert" data-cdn-editor-error hidden></div>
            </div>
            <div class="w-dialog__footer"><button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm" data-cdn-action="restore" data-fields="enabled,ttl"><lang>恢复全部继承</lang></button><button type="button" class="w-button" data-tone="neutral" data-size="sm" data-cdn-action="cancel"><lang>取消</lang></button><button type="submit" class="w-button" data-tone="primary" data-size="sm" data-cdn-save><lang>保存覆盖</lang></button></div>
        </form>
    </dialog>
</div>
