<js:part>
(function() {
    'use strict';

    var indexUrl = "@backend-url{'*/backend/api-rules/index'}";
    var viewUrl = "@backend-url{'*/backend/api-rules/view'}";

    function requestDialog(options) {
        return Weline.UI.dialog.request(options);
    }

    document.addEventListener('change', function(event) {
        var target = event.target instanceof Element ? event.target.closest('[data-cdn-api-rules-action]') : null;
        if (!target) {
            return;
        }
        if (target.dataset.cdnApiRulesAction === 'filter') {
            window.CdnApiRulesManager.filterRules();
            return;
        }
        if (target.dataset.cdnApiRulesAction === 'toggle') {
            if (!event.isTrusted) {
                return;
            }
            window.CdnApiRulesManager.toggleRule(target.dataset.ruleId || '', target.checked);
        }
    });

    document.addEventListener('click', function(event) {
        var target = event.target instanceof Element ? event.target.closest('[data-cdn-api-rules-action]') : null;
        if (!target) {
            return;
        }
        if (target.dataset.cdnApiRulesAction === 'collect') {
            window.CdnApiRulesManager.collectRules();
            return;
        }
        if (target.dataset.cdnApiRulesAction === 'view') {
            window.CdnApiRulesManager.viewRule(target.dataset.ruleId || '');
            return;
        }
        if (target.dataset.cdnApiRulesAction === 'delete') {
            window.CdnApiRulesManager.deleteRule(target.dataset.ruleId || '');
        }
    });

    window.CdnApiRulesManager = {
        filterRules: function() {
            var module = document.getElementById('moduleFilter').value;
            var trigger = document.getElementById('triggerFilter').value;
            var params = new URLSearchParams();
            if (module) params.append('module', module);
            if (trigger) params.append('trigger', trigger);
            window.location.href = indexUrl + (params.toString() ? '?' + params.toString() : '');
        },

        collectRules: function() {
            requestDialog({
                title: '<?= __('确认收集规则') ?>',
                message: '<?= __('确定要重新收集规则吗？这将扫描所有Api和Controller目录。') ?>',
                tone: 'info',
                cancelable: true,
                confirmLabel: '<?= __("确定收集") ?>',
                cancelLabel: '<?= __("取消") ?>'
            }).then(function(result) {
                if (result.confirmed) {
                    Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                    .then(function(api){ return api.resource('cdn').collectApiRules({}); })
                    .then(function(data) {
                        if (data && data.success !== false) {
                            requestDialog({
                                tone: 'success',
                                title: '<?= __('成功') ?>',
                                message: data.message,
                                duration: 2000,
                                confirmable: false
                            }).then(function() { window.location.reload(); });
                        } else {
                            requestDialog({
                                tone: 'danger',
                                title: '<?= __('收集失败') ?>',
                                message: (data && data.message) || '<?= __('收集失败') ?>',
                                confirmLabel: '<?= __('确定') ?>'
                            });
                        }
                    })
                    .catch(function(error) {
                        requestDialog({
                            tone: 'danger',
                            title: '<?= __('收集失败') ?>',
                            message: (error && error.message) || '<?= __('请重试') ?>',
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    });
                }
            });
        },

        toggleRule: function(ruleId, enabled) {
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').toggleApiRule({ id: ruleId, enabled: enabled ? 1 : 0 }); })
            .then(function(data) {
                if (!(data && data.success !== false)) {
                    requestDialog({
                        tone: 'danger',
                        title: '<?= __('操作失败') ?>',
                        message: data.message || '<?= __('操作失败') ?>',
                        confirmLabel: '<?= __('确定') ?>'
                    });
                    document.getElementById('rule_' + ruleId).checked = !enabled;
                }
            })
            .catch(function() {
                requestDialog({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: '<?= __('请重试') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
                document.getElementById('rule_' + ruleId).checked = !enabled;
            });
        },

        viewRule: function(ruleId) {
            window.location.href = viewUrl + '?id=' + encodeURIComponent(ruleId);
        },

        deleteRule: function(ruleId) {
            requestDialog({
                title: '<?= __('确认删除') ?>',
                message: '<?= __('确定要删除这条规则吗？') ?>',
                tone: 'warning',
                cancelable: true,
                confirmLabel: '<?= __("确定删除") ?>',
                cancelLabel: '<?= __("取消") ?>',
                confirmTone: 'danger'
            }).then(function(result) {
                if (result.confirmed) {
                    Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                    .then(function(api){ return api.resource('cdn').deleteApiRule({ id: ruleId }); })
                    .then(function(data) {
                        if (data && data.success !== false) {
                            requestDialog({
                                tone: 'success',
                                title: '<?= __('成功') ?>',
                                message: data.message,
                                duration: 2000,
                                confirmable: false
                            }).then(function() { window.location.reload(); });
                        } else {
                            requestDialog({
                                tone: 'danger',
                                title: '<?= __('删除失败') ?>',
                                message: data.message || '<?= __('删除失败') ?>',
                                confirmLabel: '<?= __('确定') ?>'
                            });
                        }
                    })
                    .catch(function(error) {
                        requestDialog({
                            tone: 'danger',
                            title: '<?= __('删除失败') ?>',
                            message: (error && error.message) || '<?= __('请重试') ?>',
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    });
                }
            });
        }
    };
})();
</js:part>
