<js:part>
(function() {
    'use strict';

    var indexUrl = "@backend-url{'*/backend/api-rules/index'}";

    document.addEventListener('click', function(event) {
        var target = event.target instanceof Element
            ? event.target.closest('[data-cdn-api-rule-detail-action]')
            : null;
        if (!target) {
            return;
        }
        if (target.dataset.cdnApiRuleDetailAction === 'toggle') {
            window.CdnApiRuleDetailManager.toggleRule(target.dataset.ruleId || '', target.dataset.enabled === '1');
            return;
        }
        if (target.dataset.cdnApiRuleDetailAction === 'delete') {
            window.CdnApiRuleDetailManager.deleteRule(target.dataset.ruleId || '');
        }
    });

    window.CdnApiRuleDetailManager = {
        toggleRule: function(ruleId, enabled) {
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').toggleApiRule({ id: ruleId, enabled: enabled ? 1 : 0 }); })
            .then(function(data) {
                if (data && data.success !== false) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: data.message,
                        duration: 2000,
                        confirmable: false
                    }).then(function() { window.location.reload(); });
                } else {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('操作失败') ?>',
                        message: (data && data.message) || '<?= __('操作失败') ?>',
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            })
            .catch(function() {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: '<?= __('请重试') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
            });
        },

        deleteRule: function(ruleId) {
            Weline.UI.dialog.request({
                title: '<?= __('确认删除') ?>',
                message: '<?= __('确定要删除这条规则吗？') ?>',
                tone: 'warning',
                cancelable: true,
                confirmLabel: '<?= __("确定删除") ?>',
                cancelLabel: '<?= __("取消") ?>',
                confirmTone: 'danger'
            }).then(function(result) {
                if (result.confirmed) {
                    Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                    .then(function(api){ return api.resource('cdn').deleteApiRule({ id: ruleId }); })
                    .then(function(data) {
                        if (data && data.success !== false) {
                            Weline.UI.dialog.request({
                                tone: 'success',
                                title: '<?= __('成功') ?>',
                                message: data.message,
                                duration: 2000,
                                confirmable: false
                            }).then(function() { window.location.href = indexUrl; });
                        } else {
                            Weline.UI.dialog.request({
                                tone: 'danger',
                                title: '<?= __('删除失败') ?>',
                                message: (data && data.message) || '<?= __('删除失败') ?>',
                                confirmLabel: '<?= __('确定') ?>'
                            });
                        }
                    })
                    .catch(function() {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('删除失败') ?>',
                            message: '<?= __('请重试') ?>',
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    });
                }
            });
        }
    };
})();
</js:part>
