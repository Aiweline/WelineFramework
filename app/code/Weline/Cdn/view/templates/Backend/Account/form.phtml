<?php
/**
 * CDN 账户整页编辑（无 iframe）
 *
 * 提交：Weline.Api → BinQuery cdn.saveAccount
 *
 * @var \Weline\Framework\View\Template $this
 */

$account = $this->getData('account');
$adapters = $this->getData('adapters') ?: [];
$isEdit = $account && $account->getData('account_id');
$credentials = $account ? $account->getCredentialsArray() : [];
$originToken = (string)($this->getData('originToken') ?? '');
$accountIndexUrl = (string)($this->getData('accountIndexUrl') ?? '');
$escapeAttr = static function (mixed $value): string {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE;
?>

<div class="w-grid w-backend-page" data-testid="cdn-account-editor" data-cdn-embed="page">
    <div style="--w-span:12;">
        <div class="w-grid" style="--w-mb:var(--weline-space-4);">
            <template>Weline_Component::message.phtml</template>
        </div>

        <header
            class="w-backend-page__heading w-cluster"
            style="--w-mb:var(--weline-space-4);"
            data-align="start"
            data-justify="between"
            data-wrap="true"
        >
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <p class="w-text" data-tone="primary" data-size="sm" style="--w-mb:0;"><?= __('CDN 运维') ?></p>
                <h4 class="w-backend-page__title" style="--w-mb:0;">
                    <?= $isEdit ? __('编辑 CDN 账户') : __('添加 CDN 账户') ?>
                </h4>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-2);--w-mb:0;">
                    <?= __('Cloudflare 推荐先走 OAuth 一键授权；也可在此手工填写 API Token。') ?>
                </p>
            </div>
            <a href="@backend-url{'cdn/backend/account/index'}" class="w-button" data-tone="neutral" data-size="sm" data-variant="outline">
                <w:icon name="arrow-left" size="sm"></w:icon> <?= __('返回账户列表') ?>
            </a>
        </header>

        <div class="w-card" data-w-shadow="sm">
            <div class="w-card__body">
                <w:form
                    id="accountForm"
                    class="w-form"
                    method="post"
                    action="#"
                    data-testid="cdn-account-editor-form"
                    data-state="idle"
                    data-message=""
                    data-cdn-binquery-save="1"
                    novalidate
                    style="gap:var(--weline-space-8);"
                >
                    <?php
                    $this->assign('adapters', $adapters);
                    $this->assign('account', $account);
                    $this->assign('credentials', $credentials);
                    $this->assign('originToken', $originToken);
                    $this->assign('isEdit', (bool)$isEdit);
                    $this->assign('showConnectionTest', (bool)$isEdit);
                    ?>
                    <template>Weline_Cdn::Backend/Account/form-fields.phtml</template>
                    <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                        <button type="submit" class="w-button" data-testid="cdn-account-editor-submit" data-tone="primary">
                            <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?>
                        </button>
                        <a href="@backend-url('*/backend/account/index')" class="w-button" data-tone="neutral">
                            <w:icon name="close" size="sm"></w:icon> <?= __('取消') ?>
                        </a>
                    </div>
                </w:form>
            </div>
        </div>
    </div>
</div>

