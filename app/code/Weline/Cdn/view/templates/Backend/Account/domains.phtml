<?php
/**
 * 账户关联域名列表页
 *
 * @var \Weline\Framework\View\Template $this
 */

$account = $this->getData('account');
$domains = $this->getData('domains') ?: [];
?>

<!-- 消息提示 -->
<div class="w-grid" style="--w-mb:var(--weline-space-4);">
    <template>Weline_Component::message.phtml</template>
</div>

<!-- 域名列表 -->
<div class="w-card">
    <div class="w-card__header">
        <h5 style="--w-mb:0;">
            <w:icon name="globe" size="sm"></w:icon> 
            <?= __('账户关联域名') ?>: <?= htmlspecialchars($account->getData('name')) ?>
        </h5>
    </div>
    <div class="w-card__body">
        <?php if (empty($domains)): ?>
            <div class="w-alert" data-tone="info">
                <w:icon name="info" size="sm"></w:icon> <?= __('该账户暂无关联的域名') ?>
            </div>
        <?php else: ?>
            <div class="w-table-wrap">
                <table class="w-table">
                    <thead>
                        <tr>
                            <th><?= __('域名ID') ?></th>
                            <th><?= __('域名名称') ?></th>
                            <th><?= __('适配器') ?></th>
                            <th><?= __('状态') ?></th>
                            <th><?= __('操作') ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($domains as $domain): ?>
                            <tr>
                                <td><?= $domain->getData('domain_id') ?></td>
                                <td><?= htmlspecialchars($domain->getData('domain_name')) ?></td>
                                <td>
                                    <span class="w-badge" data-w-background="info"><?= htmlspecialchars($domain->getData('adapter')) ?></span>
                                </td>
                                <td>
                                    <?php if ($domain->getData('enabled')): ?>
                                        <span class="w-badge" data-w-background="success"><?= __('启用') ?></span>
                                    <?php else: ?>
                                        <span class="w-badge" data-w-background="muted"><?= __('禁用') ?></span>
                                    <?php endif; ?>
                                </td>
                                <td>
                                    <a href="<?= $this->getBackendUrl('*/backend/domain/form', ['id' => $domain->getData('domain_id')]) ?>" class="w-button" data-tone="primary" data-size="sm">
                                        <w:icon name="edit" size="sm"></w:icon> <?= __('编辑') ?>
                                    </a>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>

        <div style="--w-mt:var(--weline-space-4);">
            <a href="<?= $this->getBackendUrl('*/backend/account/index') ?>" class="w-button" data-tone="neutral">
                <w:icon name="arrow-left" size="sm"></w:icon> <?= __('返回') ?>
            </a>
        </div>
    </div>
</div>
