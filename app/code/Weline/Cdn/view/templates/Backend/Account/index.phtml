<js:part>
(function() {
    'use strict';

    function confirmAction(message, onConfirm) {
        Weline.UI.dialog.confirm(message).then(function(confirmed) {
            if (confirmed) {
                onConfirm();
            }
        });
        return;
        if (window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
            window.Weline.UI.toast.error('<?= __('确认组件不可用，请刷新页面后重试。') ?>');
        }
    }

    document.addEventListener('click', function(event) {
        var createBtn = event.target instanceof Element
            ? event.target.closest('[data-cdn-account-action="create"]')
            : null;
        if (createBtn && window.CdnAccountForm) {
            window.CdnAccountForm.resetForCreate();
            return;
        }
        var editBtn = event.target instanceof Element
            ? event.target.closest('[data-cdn-account-action="edit"]')
            : null;
        if (editBtn && window.CdnAccountForm) {
            var raw = editBtn.getAttribute('data-account') || '{}';
            try {
                window.CdnAccountForm.fill(JSON.parse(raw));
            } catch (e) {}
            return;
        }
        var target = event.target instanceof Element
            ? event.target.closest('[data-cdn-account-action]')
            : null;
        if (!target || target.dataset.cdnAccountAction !== 'set-default') {
            return;
        }
        window.CdnAccountManager.setDefault(target.dataset.accountId || '');
    });

    document.addEventListener('click', function(event) {
        var copyBtn = event.target instanceof Element
            ? event.target.closest('[data-cdn-oauth-copy-target]')
            : null;
        if (!copyBtn) {
            return;
        }
        var targetId = copyBtn.getAttribute('data-cdn-oauth-copy-target') || '';
        var el = targetId ? document.getElementById(targetId) : null;
        var text = el ? String(el.textContent || '').trim() : '';
        if (!text) {
            return;
        }
        var done = function() {
            if (window.Weline && window.Weline.UI && window.Weline.UI.toast && typeof window.Weline.UI.toast.success === 'function') {
                window.Weline.UI.toast.success('<?= __('回调 URL 已复制') ?>');
            }
        };
        var fail = function() {
            if (window.Weline && window.Weline.UI && window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
                window.Weline.UI.toast.error('<?= __('复制失败，请手动选中黄框整段复制') ?>');
            }
        };
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            navigator.clipboard.writeText(text).then(done).catch(fail);
            return;
        }
        try {
            var range = document.createRange();
            range.selectNodeContents(el);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            document.execCommand('copy');
            sel.removeAllRanges();
            done();
        } catch (e) {
            fail();
        }
    });

    window.CdnAccountManager = {
        setDefault: function(id) {
            confirmAction('<?= __('确定要设置此账户为默认账户吗？') ?>', function() {
                Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').setDefaultAccount({ account_id: id }); })
                .then(function(data) {
                    if (data.success) {
                        Weline.UI.dialog.request({
                            tone: 'success',
                            title: '<?= __('成功') ?>',
                            message: data.message,
                            duration: 2000,
                            confirmable: false
                        }).then(function() { location.reload(); });
                    } else {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('操作失败') ?>',
                            message: data.message,
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    }
                });
            });
        }
    };
})();
</js:part>
