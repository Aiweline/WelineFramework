<?php
/**
 * CDN账户管理列表页
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Cdn\Api\OauthCapableProviderInterface;
use Weline\Framework\Manager\ObjectManager;
use Weline\Cdn\Service\AdapterResolver;

$accounts = $this->getData('accounts') ?: [];
$total = (int)$this->getData('total');
$activeCount = (int)$this->getData('activeCount');
$defaultCount = (int)$this->getData('defaultCount');
$page = (int)$this->getData('page');
$pageSize = (int)$this->getData('pageSize');
$totalPages = (int)$this->getData('totalPages');
$search = $this->getData('search') ?: '';
$adapter = $this->getData('adapter') ?: '';
$adapters = $this->getData('adapters') ?: [];
/** @var array<string, OauthCapableProviderInterface> $oauthProviders */
$oauthProviders = $this->getData('oauthProviders');
if (!is_array($oauthProviders)) {
    // 兜底：避免旧 OPcache 控制器未 assign 时整页无 CTA
    try {
        $oauthProviders = ObjectManager::getInstance(AdapterResolver::class)->getOauthCapableAdapters();
    } catch (\Throwable) {
        $oauthProviders = [];
    }
}
$escapeAttr = static function (mixed $value): string {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$oauthError = trim((string)($this->request->getGet('oauth_error', ''))) === '1';
$oauthErrorAdapter = trim((string)($this->request->getGet('oauth_adapter', '')));
if ($oauthErrorAdapter === '') {
    $oauthErrorAdapter = 'cloudflare';
}
$oauthCfError = strtolower(trim((string)($this->request->getGet('oauth_cf_error', ''))));
$oauthCfDesc = trim((string)($this->request->getGet('oauth_cf_desc', '')));
$oauthRedirectError = in_array($oauthCfError, ['invalid_request', 'redirect_uri_mismatch'], true)
    || str_contains(strtolower($oauthCfDesc), 'redirect_uri');
/** @var OauthCapableProviderInterface|null $oauthErrorProvider */
$oauthErrorProvider = $oauthProviders[$oauthErrorAdapter] ?? null;
$oauthErrorProviderName = $oauthErrorProvider !== null && method_exists($oauthErrorProvider, 'getAdapterName')
    ? (string)$oauthErrorProvider->getAdapterName()
    : $oauthErrorAdapter;
$oauthErrorTitle = (string)__('%{1} OAuth 未能开始', $oauthErrorProviderName);
$oauthErrorBody = (string)__('发起授权时出错。请先看下方凭据状态；若 Client ID / Secret 已正确，可再点「%{1}」。', $oauthErrorProvider !== null ? $oauthErrorProvider->getOauthConnectLabel() : __('连接'));
if ($oauthCfError === 'access_denied') {
    $oauthErrorTitle = (string)__('%{1} 授权已取消', $oauthErrorProviderName);
    $oauthErrorBody = (string)__('你在授权页拒绝了授权，或关闭了授权页。若要继续，请再点「%{1}」。', $oauthErrorProvider !== null ? $oauthErrorProvider->getOauthConnectLabel() : __('连接'));
} elseif ($oauthCfError === 'invalid_scope') {
    $oauthErrorTitle = (string)__('%{1} 拒绝了本次授权（scope 不匹配）', $oauthErrorProviderName);
    $oauthErrorBody = (string)__('权限要在 Cloudflare 控制台勾，不在本页填写。打开 OAuth clients → 编辑该 Client →「选择权限范围」，勾选 Zone Read、DNS Write、Cache Purge、Cache Settings Write 并保存，再点连接。授权页无法带回未勾选的权限。');
} elseif (in_array($oauthCfError, ['invalid_request', 'redirect_uri_mismatch'], true)
    || str_contains(strtolower($oauthCfDesc), 'redirect_uri')
) {
    $oauthErrorTitle = (string)__('%{1} 拒绝了本次授权（回调 URL 不匹配）', $oauthErrorProviderName);
    $oauthErrorBody = (string)__('请展开下方「回调 URL 与权限准备」，把回调 URL 整段原样粘进供应商 OAuth Client 的 Redirect URLs（可登记多条），保存后再点连接。');
} elseif ($oauthCfError === 'invalid_client') {
    $oauthErrorTitle = (string)__('%{1} 拒绝了本次授权（invalid_client）', $oauthErrorProviderName);
    $oauthErrorBody = (string)__('Client ID / Secret 无效或填错。请到系统配置核对两项。');
} elseif ($oauthCfError === 'connect_failed' || $oauthCfError === 'exchange_failed') {
    $oauthErrorTitle = (string)__('%{1} OAuth 未能完成', $oauthErrorProviderName);
    $oauthErrorBody = $oauthCfDesc !== ''
        ? $oauthCfDesc
        : (string)__('发起或换票失败。请核对 OAuth 凭据与回调 URL 后重试。');
} elseif ($oauthCfError !== '') {
    $oauthErrorTitle = (string)__('%{1} OAuth 返回错误：%{2}', $oauthErrorProviderName, $oauthCfError);
    if ($oauthCfDesc !== '') {
        $oauthErrorBody = $oauthCfDesc;
    }
}
$kpis = [
    ['icon' => 'cloud', 'value' => $total, 'label' => __('账户总数')],
    ['icon' => 'check-circle', 'value' => $activeCount, 'label' => __('已激活')],
    ['icon' => 'star', 'value' => $defaultCount, 'label' => __('默认账户')],
];
?>

<div class="w-grid w-backend-page" data-testid="cdn-account-management">
    <div style="--w-span:12;">
        <div class="w-grid" style="--w-mb:var(--weline-space-4);">
            <template>Weline_Component::message.phtml</template>
        </div>

        <?php if ($oauthError): ?>
            <div class="w-alert" data-tone="danger" data-testid="cdn-oauth-error" style="--w-mb:var(--weline-space-4);">
                <div class="w-alert__content" style="gap:var(--weline-space-2);">
                    <strong class="w-alert__title"><?= $escapeAttr($oauthErrorTitle) ?></strong>
                    <p class="w-text" data-size="sm" style="--w-mb:0;">
                        <?= $escapeAttr($oauthErrorBody) ?>
                    </p>
                    <?php if ($oauthCfError !== '' && $oauthCfDesc !== '' && !in_array($oauthCfError, ['connect_failed', 'exchange_failed'], true)): ?>
                        <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;" data-testid="cdn-oauth-cf-desc">
                            <?= $escapeAttr(__('供应商原文：%{1}', $oauthCfDesc)) ?>
                        </p>
