                        </p>
                        <?php if ($oauthErrorAdapter === 'cloudflare'): ?>
                            <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
                                <a class="w-button" href="https://dash.cloudflare.com/?to=/:account/oauth-clients" target="_blank" rel="noopener noreferrer" data-tone="primary" data-size="sm" data-testid="cdn-oauth-open-cf-clients-from-error">
                                    <w:icon name="external-link" size="sm"></w:icon> <?= __('去 Cloudflare 勾选权限') ?>
                                </a>
                            </div>
                        <?php endif; ?>
                    <?php endif; ?>
                </div>
            </div>
        <?php endif; ?>

