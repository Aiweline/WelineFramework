<js:part name="w-delete"/>

<js:part>
(function() {
    'use strict';
    
    var setDefaultUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/account/setDefault')) ?>;

    function confirmAction(message, onConfirm) {
        Weline.UI.dialog.confirm(message).then(function(confirmed) {
            if (confirmed) {
                onConfirm();
            }
        });
        return;
        if (window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
            window.Weline.UI.toast.error('<?= __('确认组件不可用，请刷新页面后重试。') ?>');
        }
    }

    document.addEventListener('click', function(event) {
        var target = event.target instanceof Element
            ? event.target.closest('[data-cdn-account-action]')
            : null;
        if (!target || target.dataset.cdnAccountAction !== 'set-default') {
            return;
        }
        window.CdnAccountManager.setDefault(target.dataset.accountId || '');
    });
    
    window.CdnAccountManager = {
        setDefault: function(id) {
            confirmAction('<?= __('确定要设置此账户为默认账户吗？') ?>', function() {
                Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').setDefaultAccount({ account_id: id }); })
                .then(function(data) {
                    if (data.success) {
                        Weline.UI.dialog.request({
                            tone: 'success',
                            title: '<?= __('成功') ?>',
                            message: data.message,
                            duration: 2000,
                            confirmable: false
                        }).then(function() { location.reload(); });
                    } else {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('操作失败') ?>',
                            message: data.message,
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    }
                });
            });
        }
    };
})();
</js:part>
