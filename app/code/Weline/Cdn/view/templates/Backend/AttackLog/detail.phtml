$escapeAttr = static function (mixed $value): string {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
$statusVal = $log->getData('status');
$statusTone = match ($statusVal) {
    'active' => 'danger',
    'recovered' => 'success',
    default => 'neutral',
};
$statusIcon = match ($statusVal) {
    'active' => 'warning',
    'recovered' => 'check-circle',
    default => 'close',
};
