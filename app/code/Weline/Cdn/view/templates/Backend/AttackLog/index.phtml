(function() { 'use strict'; var deleteUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/attackLog/delete')) ?>; var batchDeleteUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/attackLog/batchDelete')) ?>; var cleanupUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/attackLog/cleanup')) ?>; function getSelectedIds() { var checkboxes = document.querySelectorAll('.log-checkbox:checked'); return Array.from(checkboxes).map(function(cb) { return cb.value; }); } document.addEventListener('change', function(event) { var target = event.target instanceof Element ? event.target.closest('[data-cdn-attack-log-action]') : null; if (!target || target.dataset.cdnAttackLogAction !== 'select-all') { return; } window.CdnAttackLogManager.toggleSelectAll(); }); document.addEventListener('click', function(event) { var target = event.target instanceof Element ? event.target.closest('[data-cdn-attack-log-action]') : null; if (!target) { return; } if (target.dataset.cdnAttackLogAction === 'batch-delete') { window.CdnAttackLogManager.batchDelete(); return; } if (target.dataset.cdnAttackLogAction === 'delete') { window.CdnAttackLogManager.deleteLog(target.dataset.logId || ''); return; } if (target.dataset.cdnAttackLogAction === 'cleanup') { window.CdnAttackLogManager.cleanupLogs(); } }); window.CdnAttackLogManager = { toggleSelectAll: function() { var selectAll = document.getElementById('selectAll'); var checkboxes = document.querySelectorAll('.log-checkbox'); checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; }); }, deleteLog: function(id) { Weline.UI.dialog.request({ title: '<?= __("确定删除？") ?>', message: '<?= __("此操作不可恢复！") ?>', tone: 'warning', cancelable: true, confirmTone: 'danger', cancelTone: 'neutral', confirmLabel: '<?= __("确定删除") ?>', cancelLabel: '<?= __("取消") ?>' }).then(function(result) { if (result.confirmed) { Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api) .then(function(api){ return api.resource('cdn').deleteAttackLog({ id: id }); }) .then(function(data) { if (data.success) { Weline.UI.dialog.request({ tone: 'success', title: '<?= __("成功") ?>', message: data.message, duration: 1500, confirmable: false }).then(function() { location.reload(); }); } else { Weline.UI.dialog.request({ tone: 'danger', title: '<?= __("失败") ?>', message: data.message }); } }); } }); }, batchDelete: function() { var ids = getSelectedIds(); if (ids.length === 0) { Weline.UI.dialog.request({ tone: 'warning', title: '<?= __("请先选择要删除的日志") ?>' }); return; } Weline.UI.dialog.request({ title: '<?= __("确定批量删除？") ?>', message: '<?= __("将删除 ") ?>' + ids.length + '<?= __(" 条日志，此操作不可恢复！") ?>', tone: 'warning', cancelable: true, confirmTone: 'danger', cancelTone: 'neutral', confirmLabel: '<?= __("确定删除") ?>', cancelLabel: '<?= __("取消") ?>' }).then(function(result) { if (result.confirmed) { var formData = new FormData(); ids.forEach(function(id) { formData.append('ids[]', id); }); Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api) .then(function(api){ return api.resource('cdn').batchDeleteAttackLogs({ ids: ids }); }) .then(function(data) { if (data.success) { Weline.UI.dialog.request({ tone: 'success', title: '<?= __("成功") ?>', message: data.message, duration: 1500, confirmable: false }).then(function() { location.reload(); }); } else { Weline.UI.dialog.request({ tone: 'danger', title: '<?= __("失败") ?>', message: data.message }); } }); } }); }, cleanupLogs: function() { var days = document.getElementById('cleanupDays').value; Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api) .then(function(api){ return api.resource('cdn').cleanupAttackLogs({ days: days }); }) .then(function(data) { Weline.UI.dialog.close('#cleanupModal'); if (data.success) { Weline.UI.dialog.request({ tone: 'success', title: '<?= __("成功") ?>', message: data.message, duration: 1500, confirmable: false }).then(function() { location.reload(); }); } else { Weline.UI.dialog.request({ tone: 'danger', title: '<?= __("失败") ?>', message: data.message }); } }); } };
