<script>
(function () {
    var root = document.querySelector('[data-testid="cdn-warmup-management"]');
    if (!root || !window.Weline || !Weline.Api) return;

    var scopeRoot = document.getElementById('cdn-warmup-scope');
    var scopeField = scopeRoot
        ? (scopeRoot.querySelector('input[type="hidden"][name="target_scope"]')
            || scopeRoot.querySelector('input[name="target_scope"]'))
        : null;
    var hintEl = document.getElementById('cdn-warmup-scope-hint');
    var summaryEl = document.getElementById('cdn-warmup-scope-summary');
    var kpiEl = document.getElementById('cdn-warmup-kpi');
    var executeLabel = root.querySelector('[data-cdn-warmup-execute-label]');
    var busy = false;
    var pages = {};
    var initialScope = <?= json_encode($selectedScope, JSON_UNESCAPED_UNICODE) ?>;

    function targetScope() {
        var v = scopeField ? String(scopeField.value || '').trim() : '';
        return v || initialScope || 'default.default.default';
    }

    function isGlobalScope(scope) {
        return !scope || scope === 'default.default.default' || scope === 'global';
    }

    function scopeParams() {
        var scope = targetScope();
        return scope ? { target_scope: scope } : {};
    }

    function toast(ok, message) {
        var uiToast = window.Weline && Weline.UI && Weline.UI.toast;
        if (uiToast && typeof uiToast[ok ? 'success' : 'error'] === 'function') {
            uiToast[ok ? 'success' : 'error'](message || (ok ? 'OK' : 'Error'));
            return;
        }
        if (window.Weline && Weline.Message) {
            Weline.Message[ok ? 'success' : 'error'](message || (ok ? 'OK' : 'Error'));
            return;
        }
        if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.alert === 'function') {
            Weline.UI.dialog.alert(message || '');
            return;
        }
        console[ok ? 'info' : 'error'](message || '');
    }

    function confirmAction(message) {
        var dialog = window.Weline && Weline.UI && Weline.UI.dialog;
        if (dialog && typeof dialog.confirm === 'function') {
            return dialog.confirm(message, {
                title: <?= json_encode((string)__('请确认'), JSON_UNESCAPED_UNICODE) ?>,
                confirmLabel: <?= json_encode((string)__('确定'), JSON_UNESCAPED_UNICODE) ?>,
                cancelLabel: <?= json_encode((string)__('取消'), JSON_UNESCAPED_UNICODE) ?>
            });
        }
        toast(false, <?= json_encode((string)__('确认组件不可用，请刷新页面后重试。'), JSON_UNESCAPED_UNICODE) ?>);
        return Promise.resolve(false);
    }

    function setBusy(on) {
        busy = !!on;
        root.querySelectorAll('[data-cdn-warmup-action]').forEach(function (btn) {
            btn.disabled = busy;
            if (busy) btn.setAttribute('aria-busy', 'true');
            else btn.removeAttribute('aria-busy');
        });
    }

    function refreshExecuteLabel() {
        if (!executeLabel) return;
        executeLabel.textContent = isGlobalScope(targetScope())
            ? <?= json_encode((string)__('执行预热'), JSON_UNESCAPED_UNICODE) ?>
            : <?= json_encode((string)__('执行本范围预热'), JSON_UNESCAPED_UNICODE) ?>;
    }

    function renderKpi(scope) {
        if (!kpiEl) return;
        var tiles = [
            { label: <?= json_encode((string)__('总URL数'), JSON_UNESCAPED_UNICODE) ?>, value: scope.total || 0 },
            { label: <?= json_encode((string)__('成功'), JSON_UNESCAPED_UNICODE) ?>, value: scope.success || 0 },
            { label: <?= json_encode((string)__('失败'), JSON_UNESCAPED_UNICODE) ?>, value: scope.fail || 0 },
            { label: <?= json_encode((string)__('待处理'), JSON_UNESCAPED_UNICODE) ?>, value: scope.pending || 0 }
        ];
        kpiEl.innerHTML = tiles.map(function (t) {
            return '<article class="w-card" data-w-height="full" data-w-shadow="sm"><div class="w-card__body w-stack" style="--w-gap:var(--weline-space-1);"><strong>' +
                Number(t.value).toLocaleString() + '</strong><span class="w-text" data-tone="muted" data-size="sm">' +
                t.label + '</span></div></article>';
        }).join('');
        if (hintEl) {
            if (scope.interval_seconds) {
                hintEl.textContent = <?= json_encode((string)__('该域名预热间隔 %{1} 秒'), JSON_UNESCAPED_UNICODE) ?>.replace('%{1}', String(scope.interval_seconds));
            } else if (isGlobalScope(targetScope())) {
                hintEl.textContent = <?= json_encode((string)__('全局将按各 Domain 各自间隔跳过过频 URL'), JSON_UNESCAPED_UNICODE) ?>;
            } else {
                hintEl.textContent = <?= json_encode((string)__('当前范围按 Website 过滤队列；间隔仍按各 Domain 配置'), JSON_UNESCAPED_UNICODE) ?>;
            }
        }
        if (summaryEl) {
            summaryEl.textContent = (scope.total || 0) + ' URL · pending ' + (scope.pending || 0) + ' · fail ' + (scope.fail || 0);
        }
    }

    function refreshProviders() {
        return Weline.Api.resource('cdn').listWarmupProviders(scopeParams()).then(function (res) {
            if (!res || !res.success) {
                toast(false, (res && res.message) || 'load failed');
                return;
            }
            var data = res.data || {};
            renderKpi(data.scope || {});
            (data.providers || []).forEach(function (p) {
                var card = root.querySelector('[data-cdn-warmup-provider="' + CSS.escape(p.fqcn) + '"]');
                if (!card) return;
                var badge = card.querySelector('[data-cdn-warmup-count]');
                if (badge) badge.textContent = String(p.url_count || 0);
            });
        });
    }

    function renderUrlRows(container, items) {
        if (!items.length) {
            container.innerHTML = '<div class="w-empty"><p class="w-text" data-tone="muted" data-size="sm">' +
                <?= json_encode((string)__('本 Provider×本范围暂无已入队 URL，请先收集'), JSON_UNESCAPED_UNICODE) ?> +
                '</p></div>';
            return;
        }
        var html = '<div class="w-table-wrap"><table class="w-table"><thead><tr>' +
            '<th>URL</th><th>' + <?= json_encode((string)__('状态'), JSON_UNESCAPED_UNICODE) ?> + '</th>' +
            '<th>' + <?= json_encode((string)__('进度'), JSON_UNESCAPED_UNICODE) ?> + '</th>' +
            '<th>' + <?= json_encode((string)__('重试'), JSON_UNESCAPED_UNICODE) ?> + '</th>' +
            '</tr></thead><tbody>';
        items.forEach(function (row) {
            html += '<tr><td style="word-break:break-all;">' + String(row.url || '').replace(/</g, '&lt;') +
                '</td><td>' + String(row.status || '') +
                '</td><td>' + String(row.processed_count || 0) + '/' + String(row.target_count || 1) +
                '</td><td>' + String(row.retries || 0) + '</td></tr>';
        });
        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    function pageWindow(current, totalPages) {
        var maxButtons = 7;
        if (totalPages <= maxButtons) {
            var all = [];
            for (var i = 1; i <= totalPages; i++) all.push(i);
            return all;
        }
        var half = Math.floor(maxButtons / 2);
        var start = Math.max(1, current - half);
        var end = Math.min(totalPages, start + maxButtons - 1);
        start = Math.max(1, end - maxButtons + 1);
        var pagesInWindow = [];
        for (var p = start; p <= end; p++) pagesInWindow.push(p);
        return pagesInWindow;
    }

    function renderPager(card, fqcn, page, pageSize, total) {
        var pager = card.querySelector('[data-cdn-warmup-pager]');
        var summary = card.querySelector('[data-cdn-warmup-pager-summary]');
        var list = card.querySelector('[data-cdn-warmup-pager-list]');
        if (!pager || !list) return;
        var totalPages = Math.max(1, Math.ceil((total || 0) / Math.max(1, pageSize || 20)));
        if (!total || totalPages <= 1) {
            pager.hidden = true;
            list.innerHTML = '';
            if (summary) summary.textContent = '';
            return;
        }
        pager.hidden = false;
        if (summary) {
            summary.textContent = <?= json_encode((string)__('共 %{1} 条记录，第 %{2}/%{3} 页'), JSON_UNESCAPED_UNICODE) ?>
                .replace('%{1}', String(total))
                .replace('%{2}', String(page))
                .replace('%{3}', String(totalPages));
        }
        var html = '';
        if (page > 1) {
            html += '<li class="w-pagination__item"><button type="button" class="w-pagination__link" data-cdn-warmup-action="goto-page" data-provider="' +
                String(fqcn).replace(/"/g, '&quot;') + '" data-page="' + (page - 1) + '">' +
                <?= json_encode((string)__('上一页'), JSON_UNESCAPED_UNICODE) ?> + '</button></li>';
        }
        pageWindow(page, totalPages).forEach(function (i) {
            html += '<li class="w-pagination__item' + (i === page ? ' active' : '') + '">' +
                '<button type="button" class="w-pagination__link" data-cdn-warmup-action="goto-page" data-provider="' +
                String(fqcn).replace(/"/g, '&quot;') + '" data-page="' + i + '"' +
                (i === page ? ' aria-current="page"' : '') + '>' + i + '</button></li>';
        });
        if (page < totalPages) {
            html += '<li class="w-pagination__item"><button type="button" class="w-pagination__link" data-cdn-warmup-action="goto-page" data-provider="' +
                String(fqcn).replace(/"/g, '&quot;') + '" data-page="' + (page + 1) + '">' +
                <?= json_encode((string)__('下一页'), JSON_UNESCAPED_UNICODE) ?> + '</button></li>';
        }
        list.innerHTML = html;
    }

    function loadUrls(fqcn, page) {
        var card = root.querySelector('[data-cdn-warmup-provider="' + CSS.escape(fqcn) + '"]');
        if (!card) return Promise.resolve();
        var targetPage = Math.max(1, Number(page) || 1);
        var pageSize = 20;
        var params = Object.assign({ provider: fqcn, page: targetPage, page_size: pageSize }, scopeParams());
        return Weline.Api.resource('cdn').listWarmupUrls(params).then(function (res) {
            if (!res || !res.success) {
                toast(false, (res && res.message) || 'load urls failed');
                return;
            }
            var data = res.data || {};
            var box = card.querySelector('[data-cdn-warmup-urls]');
            pages[fqcn] = Number(data.page || targetPage) || 1;
            renderUrlRows(box, data.items || []);
            renderPager(card, fqcn, pages[fqcn], Number(data.page_size || pageSize), Number(data.total || 0));
        });
    }

    function onScopeChanged() {
        pages = {};
        refreshExecuteLabel();
        root.querySelectorAll('[data-cdn-warmup-panel]').forEach(function (p) { p.hidden = true; });
        root.querySelectorAll('[data-cdn-warmup-action="toggle-expand"]').forEach(function (b) {
            b.setAttribute('aria-expanded', 'false');
            var c = b.querySelector('[data-cdn-warmup-chevron]');
            if (c) c.textContent = '▶';
        });
        var next = targetScope();
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('target_scope', next);
            window.history.replaceState({}, '', url.toString());
        } catch (e) {}
        refreshProviders();
    }

    root.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-cdn-warmup-action]');
        if (!btn || busy) return;
        var action = btn.getAttribute('data-cdn-warmup-action');
        var provider = btn.getAttribute('data-provider') || '';

        if (action === 'toggle-expand') {
            var card = btn.closest('[data-cdn-warmup-provider]');
            if (!card) return;
            var panel = card.querySelector('[data-cdn-warmup-panel]');
            var expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            var chev = btn.querySelector('[data-cdn-warmup-chevron]');
            if (chev) chev.textContent = expanded ? '▶' : '▼';
            if (panel) panel.hidden = expanded;
            if (!expanded) {
                loadUrls(card.getAttribute('data-cdn-warmup-provider'), 1);
            }
            return;
        }

        if (action === 'goto-page') {
            var page = Number(btn.getAttribute('data-page') || 1);
            setBusy(true);
            loadUrls(provider, page).finally(function () { setBusy(false); });
            return;
        }

        if (action === 'collect') {
            confirmAction(<?= json_encode((string)__('确认收集该 Provider 的 URL 到当前范围？'), JSON_UNESCAPED_UNICODE) ?>)
                .then(function (ok) {
                    if (!ok) return;
                    setBusy(true);
                    return Weline.Api.resource('cdn').collectWarmup(Object.assign({ provider: provider }, scopeParams()))
                        .then(function (res) {
                            if (!res || !res.success) {
                                toast(false, (res && res.message) || 'collect failed');
                                return;
                            }
                            var d = res.data || {};
                            toast(true, <?= json_encode((string)__('写入 %{1} · 范围未命中过滤 %{2} · 去重跳过 %{3}'), JSON_UNESCAPED_UNICODE) ?>
                                .replace('%{1}', String(d.inserted_count || 0))
                                .replace('%{2}', String(d.filtered_count || 0))
                                .replace('%{3}', String(d.updated_count || d.skipped_dedupe_hint || 0)));
                            return refreshProviders().then(function () {
                                var card = root.querySelector('[data-cdn-warmup-provider="' + CSS.escape(provider) + '"]');
                                var btnExpand = card && card.querySelector('[data-cdn-warmup-action="toggle-expand"]');
                                if (btnExpand && btnExpand.getAttribute('aria-expanded') === 'true') {
                                    return loadUrls(provider, 1);
                                }
                            });
                        })
                        .finally(function () { setBusy(false); });
                });
            return;
        }

        if (action === 'execute' || action === 'execute-provider') {
            var msg = action === 'execute-provider'
                ? <?= json_encode((string)__('确认预热该 Provider 已收集的 URL？'), JSON_UNESCAPED_UNICODE) ?>
                : <?= json_encode((string)__('确认执行当前范围的预热？'), JSON_UNESCAPED_UNICODE) ?>;
            confirmAction(msg).then(function (ok) {
                if (!ok) return;
                setBusy(true);
                var payload = Object.assign({ limit: 50 }, scopeParams());
                if (action === 'execute-provider') payload.provider = provider;
                return Weline.Api.resource('cdn').executeWarmup(payload)
                    .then(function (res) {
                        if (!res || !res.success) {
                            toast(false, (res && res.message) || 'execute failed');
                            return;
                        }
                        var d = res.data || {};
                        var processed = Number(d.processed || 0);
                        var successN = Number(d.success || 0);
                        var failN = Number(d.fail || 0);
                        var skippedN = Number(d.skipped || 0);
                        var summary = <?= json_encode((string)__('处理 %{1} · 成功 %{2} · 失败 %{3} · 跳过 %{4}'), JSON_UNESCAPED_UNICODE) ?>
                            .replace('%{1}', String(processed))
                            .replace('%{2}', String(successN))
                            .replace('%{3}', String(failN))
                            .replace('%{4}', String(skippedN));
                        if (processed === 0 && successN === 0 && failN === 0 && skippedN === 0) {
                            toast(false, <?= json_encode((string)__('未处理任何 URL（可能已全部完成或当前范围无待预热）'), JSON_UNESCAPED_UNICODE) ?> + ' · ' + summary);
                        } else {
                            toast(true, summary);
                        }
                        return refreshProviders().then(function () {
                            if (action === 'execute-provider' && provider) {
                                var card = root.querySelector('[data-cdn-warmup-provider="' + CSS.escape(provider) + '"]');
                                var btnExpand = card && card.querySelector('[data-cdn-warmup-action="toggle-expand"]');
                                if (btnExpand && btnExpand.getAttribute('aria-expanded') === 'true') {
                                    return loadUrls(provider, pages[provider] || 1);
                                }
                            }
                        });
                    })
                    .finally(function () { setBusy(false); });
            });
        }
    });

    if (scopeField) {
        scopeField.addEventListener('change', onScopeChanged);
    }

    refreshExecuteLabel();
    refreshProviders();
})();
</script>
