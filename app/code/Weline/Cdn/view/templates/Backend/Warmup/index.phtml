<js:part>
(function() {
    'use strict';
    
    var executeUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/warmup/execute')) ?>;
    var toggleEnableUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/warmup/toggleEnable')) ?>;
    var deleteUrl = <?= $jsonForScript($this->getBackendUrl('*/backend/warmup/delete')) ?>;

    function confirmAction(message, onConfirm) {
        Weline.UI.dialog.confirm(message).then(function(confirmed) {
            if (confirmed) {
                onConfirm();
            }
        });
        return;
        if (window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
            window.Weline.UI.toast.error('<?= __('确认组件不可用，请刷新页面后重试。') ?>');
        }
    }

    document.addEventListener('click', function(event) {
        var target = event.target instanceof Element
            ? event.target.closest('[data-cdn-warmup-action]')
            : null;
        if (!target) {
            return;
        }

        if (target.dataset.cdnWarmupAction === 'execute') {
            window.CdnWarmupManager.executeWarmup();
            return;
        }

        if (target.dataset.cdnWarmupAction === 'toggle-enable') {
            window.CdnWarmupManager.toggleEnable(target.dataset.urlId || '', target.dataset.enabled || '0');
            return;
        }

        if (target.dataset.cdnWarmupAction === 'delete') {
            window.CdnWarmupManager.deleteUrl(target.dataset.urlId || '');
        }
    });
    
    window.CdnWarmupManager = {
        executeWarmup: function() {
            Weline.UI.dialog.request({
                title: '<?= __('确认执行预热') ?>',
                message: '<?= __('确定要执行预热吗？这将处理所有待处理的URL。') ?>',
                tone: 'info',
                cancelable: true,
                confirmLabel: '<?= __("确定执行") ?>',
                cancelLabel: '<?= __("取消") ?>',
                confirmTone: 'success'
            }).then(function(result) {
                if (result.confirmed) {
                    Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api).then(function(api){ return api.resource('cdn').executeWarmup({}); })
                    .then(function(data) {
                        if (data && data.success !== false) {
                            Weline.UI.dialog.request({
                                tone: 'success',
                                title: '<?= __('成功') ?>',
                                message: data.message,
                                duration: 2000,
                                confirmable: false
                            }).then(function() { location.reload(); });
                        } else {
                            Weline.UI.dialog.request({
                                tone: 'danger',
                                title: '<?= __('执行失败') ?>',
                                message: data.message,
                                confirmLabel: '<?= __('确定') ?>'
                            });
                        }
                    })
                    .catch(function(error) {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('请求失败') ?>',
                            message: error.message,
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    });
                }
            });
        },
        
        toggleEnable: function(id, enabled) {
            var trigger = document.querySelector('[data-cdn-warmup-action="toggle-enable"][data-url-id="' + id + '"]');
            if (trigger) {
                trigger.dataset.state = 'saving';
                trigger.dataset.message = '';
            }
            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api){ return api.resource('cdn').toggleWarmupEnable({ id: Number(id), enabled: Number(enabled) }); })
            .then(function(data) {
                if (data && data.success !== false) {
                    if (trigger) {
                        trigger.dataset.state = 'saved';
                        trigger.dataset.message = data.message || '';
                    }
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: data.message,
                        duration: 2000,
                        confirmable: false
                    }).then(function() { location.reload(); });
                } else {
                    if (trigger) {
                        trigger.dataset.state = 'error';
                        trigger.dataset.message = data && data.message ? data.message : '<?= __('操作失败') ?>';
                    }
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('操作失败') ?>',
                        message: data.message,
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            })
            .catch(function(error) {
                if (trigger) {
                    trigger.dataset.state = 'error';
                    trigger.dataset.message = error && error.message ? error.message : String(error);
                }
            });
        },
        
        deleteUrl: function(id) {
            confirmAction('<?= __('确定要删除此URL吗？') ?>', function() {
                Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
                .then(function(api){ return api.resource('cdn').deleteWarmupUrl({ id: id }); })
                .then(function(data) {
                    if (data && data.success !== false) {
                        Weline.UI.dialog.request({
                            tone: 'success',
                            title: '<?= __('成功') ?>',
                            message: data.message,
                            duration: 2000,
                            confirmable: false
                        }).then(function() { location.reload(); });
                    } else {
                        Weline.UI.dialog.request({
                            tone: 'danger',
                            title: '<?= __('删除失败') ?>',
                            message: data.message,
                            confirmLabel: '<?= __('确定') ?>'
                        });
                    }
                });
            });
        }
    };
})();
</js:part>
