/**
 * @meta.title {default="CDN 注解三面打包",description="将控制器 @Cdn 注解按 api/backend/frontend 打包进 Cloudflare Cache Rules（省 Free 容量）"}
 * @meta.description {default="开启后，推送边缘时把启用中的注解规则按三面打包（同面 OR + 中位 TTL），不再逐条细推；关闭后 Free/低容量仅 defaults，付费才细推。默认开启。"}
 * @config.area {backend}
