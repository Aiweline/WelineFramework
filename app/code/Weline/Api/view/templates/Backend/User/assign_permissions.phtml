<?php
/** @var \Weline\Framework\View\Template $this */
$user = $this->getData('user');
$role = $this->getData('user_role');
$value = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) return $item[$key] ?? $default;
    if (is_object($item) && method_exists($item, 'getData')) return $item->getData($key) ?? $default;
    return $default;
};
$userId = max(0, (int)$value($user, 'user_id', is_object($user) && method_exists($user, 'getId') ? $user->getId() : 0));
$username = trim((string)$value($user, 'username'));
$email = trim((string)$value($user, 'email'));
$roleName = trim((string)$value($role, 'role_name'));
$subject = $username !== '' ? $username : (string)__('API 用户 #%{1}', [$userId]);
if ($email !== '') {
    $subject .= ' · ' . $email;
}
?>
<?= $this->fetch('Weline_Acl::templates/Backend/Acl/Role/assign.phtml', [
    'assignment_mode' => 'api-user',
    'assignment_action' => (string)$this->getData('action'),
    'assignment_identifier_name' => 'user_id',
    'assignment_identifier_value' => $userId,
    'assignment_title' => (string)__('API 用户权限分配'),
    'assignment_description' => (string)__('为 API 用户所属角色配置实际需要的权限资源。'),
    'assignment_back_url' => $this->getBackendUrl('*/api/backend/user/edit') . '?id=' . $userId,
    'assignment_back_label' => (string)__('返回用户'),
    'assignment_subject_label' => (string)__('API 用户'),
    'assignment_subject_name' => $subject,
    'assignment_subject_icon' => 'key',
    'assignment_context_label' => (string)__('所属角色'),
    'assignment_context_name' => $roleName !== '' ? $roleName : (string)__('未命名角色'),
    'assignment_context_icon' => 'shield',
    'assignment_show_tags' => false,
]) ?>
