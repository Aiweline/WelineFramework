<?php
/**
 * 发件记录阅读预览
 * @var \Weline\Framework\View\Template $this
 * @var array $log_view
 * @var string $back_url
 */
$log_view = is_array($log_view ?? null) ? $log_view : [];
$h = static function (mixed $v): string {
    return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
};
$content = (string)($log_view['content'] ?? '');
$isHtml = !empty($log_view['is_html_flag']);
$back = (string)($back_url ?? '');
?>
<div class="w-grid" data-testid="smtp-log-read">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading" style="--w-mb:var(--weline-space-4);">
      <div>
        <h4 class="w-backend-page__title" style="--w-mb:0;"><?= __('阅读邮件') ?></h4>
        <p class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-2);--w-mb:0;">
          <?= $h((string)($log_view['subject'] ?? '')) ?>
        </p>
      </div>
      <?php if ($back !== ''): ?>
        <a class="w-button" data-tone="neutral" data-size="sm" href="<?= $h($back) ?>"><?= __('返回列表') ?></a>
      <?php endif; ?>
    </div>

    <div class="w-card" style="--w-mb:var(--weline-space-4);">
      <div class="w-card__body">
        <dl class="w-stack" style="--w-gap:var(--weline-space-2);margin:0;">
          <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <dt class="w-text" data-tone="muted" data-size="sm"><?= __('时间') ?></dt>
            <dd style="margin:0;"><?= $h((string)($log_view['time_display'] ?? '')) ?></dd>
          </div>
          <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <dt class="w-text" data-tone="muted" data-size="sm"><?= __('收件人') ?></dt>
            <dd style="margin:0;"><?= $h((string)($log_view['to_display'] ?? '')) ?></dd>
          </div>
          <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <dt class="w-text" data-tone="muted" data-size="sm"><?= __('发件') ?></dt>
            <dd style="margin:0;"><?= $h((string)($log_view['from_display'] ?? '')) ?></dd>
          </div>
          <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <dt class="w-text" data-tone="muted" data-size="sm"><?= __('渠道') ?></dt>
            <dd style="margin:0;"><?= $h((string)($log_view['channel_label'] ?? '')) ?></dd>
          </div>
          <div class="w-cluster" style="--w-gap:var(--weline-space-2);">
            <dt class="w-text" data-tone="muted" data-size="sm"><?= __('语言') ?></dt>
            <dd style="margin:0;"><?= $h((string)($log_view['locale_display'] ?? '—')) ?></dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="w-card">
      <div class="w-card__body">
        <?php if ($isHtml): ?>
          <iframe
            title="<?= $h(__('邮件正文预览')) ?>"
            sandbox=""
            referrerpolicy="no-referrer"
            style="width:100%;min-height:28rem;border:1px solid var(--weline-theme-border, #d7e0e5);border-radius:var(--weline-radius-md, 8px);background:#fff;"
            srcdoc="<?= $h($content) ?>"
            data-testid="smtp-log-preview-frame"
          ></iframe>
        <?php else: ?>
          <pre class="w-text" style="white-space:pre-wrap;margin:0;" data-testid="smtp-log-preview-text"><?= $h($content) ?></pre>
        <?php endif; ?>
      </div>
    </div>
  </div>
</div>
