<?php
/**
 * 发件记录弹层 iframe 嵌入页：完整 HTML 文档，不包后台壳。
 * @var \Weline\Framework\View\Template $this
 * @var array $log_view
 * @var string $embed_error
 */
$log_view = is_array($log_view ?? null) ? $log_view : [];
$embedError = trim((string)($embed_error ?? ''));
$h = static function (mixed $v): string {
    return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
};
$content = (string)($log_view['content'] ?? '');
$isHtml = !empty($log_view['is_html_flag']);
$subject = (string)($log_view['subject'] ?? '');
$title = $subject !== '' ? $subject : (string)__('邮件预览');
?><!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $h($title) ?></title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #f4f6f8;
            color: #1a1a1a;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .smtp-log-embed-shell {
            box-sizing: border-box;
            max-width: 600px;
            margin: 0 auto;
            padding: 16px 12px 32px;
            min-height: 100vh;
        }
        .smtp-log-embed-error {
            padding: 24px 16px;
            text-align: center;
            color: #6b7280;
            font-size: 14px;
        }
        .smtp-log-embed-text {
            margin: 0;
            padding: 16px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 14px;
            line-height: 1.5;
        }
        .smtp-log-embed-html {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: auto;
        }
    </style>
</head>
<body data-testid="smtp-log-embed" data-smtp-embed-standalone="1">
<?php if ($embedError !== ''): ?>
    <div class="smtp-log-embed-shell">
        <p class="smtp-log-embed-error" data-testid="smtp-log-embed-error"><?= $h($embedError) ?></p>
    </div>
<?php elseif ($isHtml): ?>
    <div class="smtp-log-embed-shell">
        <div class="smtp-log-embed-html" data-testid="smtp-log-embed-html"><?= $content ?></div>
    </div>
<?php else: ?>
    <div class="smtp-log-embed-shell">
        <pre class="smtp-log-embed-text" data-testid="smtp-log-embed-text"><?= $h($content) ?></pre>
    </div>
<?php endif; ?>
</body>
</html>
