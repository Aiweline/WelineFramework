                <script>
                (function () {
                    var listingBase = <?= json_encode($listingBase, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
                    function withChannel(channel) {
                        var url = new URL(listingBase, window.location.origin);
                        if (channel) {
                            url.searchParams.set('channel', channel);
                        } else {
                            url.searchParams.delete('channel');
                        }
                        return url.toString();
                    }
                    var root = document.getElementById('smtp-log-scope');
                    if (root) {
                        var field = root.querySelector('input[type="hidden"][name="target_scope"]') || root.querySelector('input[name="target_scope"]');
                        if (field) {
                            field.addEventListener('change', function () {
                                var next = String(field.value || '').trim();
                                if (!next) { return; }
                                var url = new URL(window.location.href);
                                url.searchParams.set('target_scope', next);
                                var parts = next.split('.');
                                url.searchParams.set('website_code', parts[0] && parts[0] !== 'default' ? parts[0] : '');
                                url.searchParams.set('store_code', parts[1] && parts[1] !== 'default' ? parts[1] : '');
                                url.searchParams.set('channel_code', parts[2] && parts[2] !== 'default' ? parts[2] : '');
                                window.location.assign(url.toString());
                            });
                        }
                    }
                    var channelSelect = document.getElementById('smtp-log-channel');
                    if (channelSelect) {
                        channelSelect.addEventListener('change', function () {
                            window.location.assign(withChannel(String(channelSelect.value || '')));
                        });
                    }
                })();
                </script>

