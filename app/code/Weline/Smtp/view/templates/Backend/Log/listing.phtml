<?php
/**
 * 邮件发送记录 - 按作用范围 + 发信渠道筛选
 * @var \Weline\Framework\View\Template $this
 * @var array $mail_channels
 * @var string $channel_filter
 * @var array $logs
 * @var mixed $pagination
 * @var mixed $total
 */
$mail_channels = is_array($mail_channels ?? null) ? $mail_channels : [];
$channel_filter = (string)($channel_filter ?? '');
$selectedScope = (string)($this->getData('selected_scope') ?? $this->getData('target_scope') ?? 'default.default.default');
$scopeWebsite = (string)($this->getData('scope_website_code') ?? '');
$scopeStore = (string)($this->getData('scope_store_code') ?? '');
$scopeChannel = (string)($this->getData('scope_channel_code') ?? '');
$h = static function (mixed $v): string {
    return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
};
$listingQuery = [
    'target_scope' => $selectedScope,
    'website_code' => $scopeWebsite,
    'store_code' => $scopeStore,
    'channel_code' => $scopeChannel,
];
$listingBase = (string)$this->getBackendUrl('smtp/backend/log/listing', $listingQuery);
$tabHref = static function (string $channel) use ($listingBase): string {
    if ($channel === '') {
        return $listingBase;
    }
    return $listingBase . (str_contains($listingBase, '?') ? '&' : '?') . 'channel=' . rawurlencode($channel);
};
?>

<style>
.smtp-log-scope-bar {
    margin-block-end: var(--weline-space-4);
}
.smtp-log-channel-tabs.w-tabs__list {
    display: flex;
    flex-wrap: nowrap;
