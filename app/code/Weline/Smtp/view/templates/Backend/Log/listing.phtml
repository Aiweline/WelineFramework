<script>
(function () {
    var dialog = document.getElementById('smtp-log-preview-dialog');
    var iframe = document.getElementById('smtp-log-preview-iframe');
    var titleEl = document.getElementById('smtp-log-preview-title');
    if (!dialog || !iframe) { return; }

    function clearPreview() {
        try {
            iframe.removeAttribute('src');
            iframe.src = 'about:blank';
        } catch (e) {}
    }

    function openPreview(url, subject) {
        if (!url) { return; }
        iframe.src = url;
        if (titleEl) {
            titleEl.textContent = subject || <?= json_encode((string)__('邮件预览'), JSON_UNESCAPED_UNICODE) ?>;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog && typeof window.Weline.UI.dialog.open === 'function') {
            window.Weline.UI.dialog.open(dialog);
        } else {
            dialog.hidden = false;
            dialog.setAttribute('data-state', 'open');
            dialog.setAttribute('aria-hidden', 'false');
        }
    }

    document.addEventListener('click', function (ev) {
        var btn = ev.target && ev.target.closest ? ev.target.closest('[data-smtp-log-preview]') : null;
        if (!btn) { return; }
        ev.preventDefault();
        openPreview(String(btn.getAttribute('data-preview-url') || ''), String(btn.getAttribute('data-subject') || ''));
    });

    var observer = new MutationObserver(function () {
        if (dialog.getAttribute('data-state') === 'closed' || dialog.hidden) {
            clearPreview();
        }
    });
    observer.observe(dialog, { attributes: true, attributeFilter: ['data-state', 'hidden'] });
})();
</script>
