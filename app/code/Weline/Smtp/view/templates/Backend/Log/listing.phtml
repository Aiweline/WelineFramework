<?php
/**
 * 邮件发送记录管理器 - 内容模板
 * @var \Weline\Framework\View\Template $this
 */
?>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
            <h4 style="--w-mb-sm:0;"><?= __('邮件发送记录管理器') ?></h4>
            <div class="w-cluster">
                <ol class="w-breadcrumb" style="--w-mt:0;--w-me:0;--w-mb:0;--w-ms:0;">
                    <li class="w-breadcrumb__item"><span><?= __('系统') ?></span></li>
                    <li class="w-breadcrumb__item" data-state="active"><?= __('邮件发送记录管理器') ?></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <template>Weline_Component::message.phtml</template>
    </div>
</div>

<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title"><?= __('邮件发送记录管理器') ?>:
                    <lang>一共有</lang>
                    <var>total</var>
                    <lang>条数据</lang>
                </h4>

                <div class="w-table-wrap">
                    <table class="w-table table-editable table-edits" data-w-vertical="middle">
                        <thead>
                        <tr>
                            <th><lang>ID</lang></th>
                            <th><lang>模组</lang></th>
                            <th><lang>发送邮箱</lang></th>
                            <th><lang>发送者名称</lang></th>
                            <th><lang>接收者数据</lang></th>
                            <th><lang>主题</lang></th>
                            <th><lang>内容</lang></th>
                            <th><lang>创建时间</lang></th>
                            <th><lang>更新时间</lang></th>
                            <th><?= __('操作') ?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <foreach name="logs" item="log">
                            <tr>
                                <td>{{log.id}}</td>
                                <td>{{log.module}}</td>
                                <td>{{log.from_email}}</td>
                                <td>{{log.sender_name}}</td>
                                <td>
                                    {{log.to_email}}
                                    <if condition="log.cc !== '[]'">
                                        <lang>抄送：</lang>
                                        {{log.cc}}
                                    </if>
                                    <if condition="log.bcc  !== '[]'">
                                        <lang>密送：</lang>
                                        {{log.bcc}}
                                    </if>
                                </td>
                                <td>{{log.subject}}</td>
                                <td>
                                    <if condition="log.is_html=='1'">
                                        <span class="w-badge" data-w-background="success">html</span>
                                        <else/>
                                        <span class="w-badge" data-w-background="danger">text</span>
                                    </if>
                                    {{log.content}}
                                    <if condition="log.alt!=''">
                                        <br>
                                        <span class="w-badge" data-w-background="info">{{log.alt}}</span>
                                    </if>
                                </td>
                                <td>{{log.create_time}}</td>
                                <td>{{log.update_time}}</td>
                                <td>
                                    <w:form action="@backend-url('*/backend/log/delete')" method='post'>
                                        <input type='hidden' name='log_id' value='{{log.id}}'>
                                        <button class="w-button" data-tone="danger">
                                            <lang>删除</lang>
                                        </button>
                                    </w:form>
                                    <w:form action="@backend-url('*/backend/log')" method='get'>
                                        <input type='hidden' name='log_id' value='{{log.id}}'>
                                        <button class="w-button" data-tone="primary">
                                            <lang>阅读</lang>
                                        </button>
                                    </w:form>
                                </td>
                            </tr>
                        </foreach>
                        </tbody>
                    </table>
                    <div>
                        <var>pagination</var>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="@static(Weline_Admin::assets/libs/table-edits/build/table-edits.min.js)"></script>
<script src="@static(Weline_Admin::assets/js/pages/menus/table-editable.init.js)"></script>
