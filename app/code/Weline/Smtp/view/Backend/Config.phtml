<script>
(function () {
    var root = document.getElementById('smtp-config-scope');
    if (!root) {
        return;
    }
    var field = root.querySelector('input[type="hidden"][name="target_scope"]') || root.querySelector('input[name="target_scope"]');
    if (!field) {
        return;
    }
    field.addEventListener('change', function () {
        var next = String(field.value || '').trim();
        if (!next) {
            return;
        }
        var url = new URL(window.location.href);
        url.searchParams.set('target_scope', next);
        var parts = next.split('.');
        url.searchParams.set('website_code', parts[0] && parts[0] !== 'default' ? parts[0] : '');
        url.searchParams.set('store_code', parts[1] && parts[1] !== 'default' ? parts[1] : '');
        url.searchParams.set('channel_code', parts[2] && parts[2] !== 'default' ? parts[2] : '');
        window.location.assign(url.toString());
    });
})();
</script>

