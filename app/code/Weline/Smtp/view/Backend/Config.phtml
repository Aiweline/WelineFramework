<?php
/**
 * SMTP：传输账户管理 + 发信渠道绑定（theme:search-select 可搜索标签）
 * @var \Weline\Framework\View\Template $this
 * @var array $senders
 * @var array $mail_accounts
 * @var array $sender_contacts
 * @var array $legacy
 * @var array $mail_channels
 * @var array $channel_bindings
 */
$senders = $senders ?? [];
$mail_accounts = $mail_accounts ?? [];
$sender_contacts = $sender_contacts ?? [];
$legacy = $legacy ?? [];
$mail_channels = $mail_channels ?? [];
$channel_bindings = $channel_bindings ?? [];
$normalizeSecure = static function ($value, $port = '465'): string {
    $value = strtolower(trim((string)$value));
    if (in_array($value, ['ssl', 'smtps', '1', 'true', 'on', 'yes', '465'], true)) {
        return 'ssl';
    }
    if (in_array($value, ['tls', 'starttls', '2', '587'], true)) {
        return 'tls';
    }
    if (in_array($value, ['none', 'off', 'false'], true)) {
        return 'none';
    }
    if ($value === '0') {
        return (string)$port === '587' ? 'tls' : 'none';
    }
    return (string)$port === '587' ? 'tls' : 'ssl';
};
$normalizeAuth = static function ($value): string {
    return in_array(strtolower(trim((string)$value)), ['0', 'false', 'off', 'no'], true) ? '0' : '1';
};
$findMailAccount = static function ($accountId) use ($mail_accounts): ?array {
    $accountId = (int)$accountId;
    if ($accountId <= 0) {
        return null;
    }
    foreach ($mail_accounts as $account) {
        if ((int)($account['account_id'] ?? 0) === $accountId) {
            return $account;
        }
    }
    return null;
};
$mailAccountOptions = [];
foreach ($mail_accounts as $account) {
    $aid = (string)(int)($account['account_id'] ?? 0);
    if ($aid === '0') {
        continue;
    }
    $label = (string)($account['label'] ?? '');
    if ($label === '') {
        $label = trim((string)(($account['email'] ?? '') . ' · ' . ($account['domain_name'] ?? '') . ' · ' . ($account['engine'] ?? '')));
    }
    $mailAccountOptions[] = ['value' => $aid, 'label' => $label];
}
$channelOptions = [];
foreach ($mail_channels as $channel) {
    $code = trim((string)($channel['code'] ?? ''));
    if ($code === '') {
        continue;
    }
    $name = trim((string)($channel['name'] ?? $code));
    $channelOptions[] = ['value' => $code, 'label' => $name . ' (' . $code . ')'];
}
$transportOptions = [];
foreach ($senders as $transportRow) {
    $tid = trim((string)($transportRow['code'] ?? ''));
    if ($tid === '') {
        continue;
    }
    $tname = trim((string)($transportRow['name'] ?? ''));
    $transportOptions[] = [
        'value' => $tid,
        'label' => $tname !== '' ? ($tname . ' (' . $tid . ')') : $tid,
    ];
}
$channelsByTransport = [];
foreach ($channel_bindings as $ch => $tid) {
    $ch = trim((string)$ch);
    $tid = trim((string)$tid);
    if ($ch === '' || $tid === '') {
        continue;
    }
    $channelsByTransport[$tid][] = $ch;
}
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT;
$mailAccountsJson = json_encode($mail_accounts, $jsonFlags);
$mailAccountsJson = is_string($mailAccountsJson) && $mailAccountsJson !== '' ? $mailAccountsJson : '[]';
$mailAccountOptionsJson = json_encode($mailAccountOptions, $jsonFlags) ?: '[]';
$channelOptionsJson = json_encode($channelOptions, $jsonFlags) ?: '[]';
$transportOptionsJson = json_encode($transportOptions, $jsonFlags) ?: '[]';
$selectedScope = (string)($this->getData('selected_scope') ?? $target_scope ?? 'default.default.default');
$centerUrl = $this->request->getUrlBuilder()->getBackendUrl('weline_systemconfig/backend/config', [
    'module' => 'Weline_Smtp',
    'area' => 'backend',
    'target_scope' => $selectedScope,
]);
?>

