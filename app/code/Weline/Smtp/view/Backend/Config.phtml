<script>
(function() {
    'use strict';

    var senderIndex = <?= count($senders) ?>;
    var mailAccounts = <?= $mailAccountsJson ?>;
    var mailAccountOptions = <?= $mailAccountOptionsJson ?>;
    var channelOptions = <?= $channelOptionsJson ?>;
    var transportOptions = <?= $transportOptionsJson ?>;
    var syncingBindings = false;
    var text = {
        noMailAccount: '<?= __("暂无匹配的自建邮箱账号") ?>',
        externalSummary: '<?= __("外部 SMTP 需手动填写下方连接信息。") ?>',
        pickMailAccount: '<?= __("请选择自建邮箱账号") ?>',
        saveFailed: '<?= __("保存失败") ?>',
        enterRecipient: '<?= __("请输入收件邮箱") ?>',
        addSender: '<?= __("请至少添加一个发件人") ?>',
        invalidCode: '<?= __("传输账户 ID 格式无效") ?>',
        maintenance: '<?= __("网站维护中，请稍后再试") ?>',
        busy: '<?= __("正在处理，请稍候") ?>',
        testFailed: '<?= __("测试发送失败") ?>',
        testSubmitted: '<?= __("已提交测试发送") ?>',
        testSuccess: '<?= __("测试邮件已发送") ?>',
        sending: '<?= __("发送中…") ?>',
        loginRequired: '<?= __("登录已失效，请重新登录") ?>',
        searchMail: '<?= __("搜索并选择自建邮箱账号") ?>',
        searchChannels: '<?= __("搜索并多选发信渠道") ?>',
        searchTransport: '<?= __("搜索并选择传输账户") ?>',
        ssMissing: '<?= __("搜索选择组件未加载，请刷新页面") ?>'
    };

    function sanitizeSenderCode(value) {
        return String(value || '').replace(/[^A-Za-z0-9_]/g, '');
    }
    function isValidSenderCode(value) {
        return /^[A-Za-z][A-Za-z0-9_]*$/.test(String(value || ''));
    }
    function generateTransportId() {
        var bytes = new Uint8Array(6);
        if (window.crypto && window.crypto.getRandomValues) {
            window.crypto.getRandomValues(bytes);
        } else {
            for (var i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256);
        }
        var hex = Array.prototype.map.call(bytes, function(b) { return ('0' + b.toString(16)).slice(-2); }).join('');
        return 't' + hex;
    }
    function findAccount(id) {
        id = String(id || '');
        for (var i = 0; i < mailAccounts.length; i++) {
            if (String(mailAccounts[i].account_id || '') === id) return mailAccounts[i];
        }
        return null;
    }
    function ssApi() {
        return window.WelineThemeSearchSelect || null;
    }
    function hostValue(host) {
        if (!host) return '';
        var hidden = host.querySelector('input[type="hidden"]');
        return hidden ? String(hidden.value || '').trim() : String(host.getAttribute('data-value') || '').trim();
    }
    function setHostValueAttr(host, value) {
        if (host) host.setAttribute('data-value', String(value || ''));
    }
    function mountSearchSelect(host, cfg) {
        var api = ssApi();
        if (!host || !api || typeof api.mountInto !== 'function') return null;
        host.innerHTML = '';
        setHostValueAttr(host, cfg.value || '');
        return api.mountInto(host, cfg);
    }
    function remountTransportOptions() {
        transportOptions = [];
        document.querySelectorAll('.smtp-sender-card').forEach(function(card) {
            var code = sanitizeSenderCode((card.querySelector('.smtp-code') || {}).value || '');
            if (!code) return;
            var name = ((card.querySelector('.smtp-name') || {}).value || '').trim();
            transportOptions.push({ value: code, label: name ? (name + ' (' + code + ')') : code });
        });
        document.querySelectorAll('[data-smtp-ss="channel-transport"]').forEach(function(host) {
            var cur = hostValue(host);
            mountSearchSelect(host, {
                id: 'smtp-ch-transport-' + Math.random().toString(36).slice(2, 9),
                name: '',
                value: cur,
                options: transportOptions,
                clearable: true,
                multiple: false,
                placeholder: text.searchTransport,
                minChars: 0
            });
            bindChannelTransportHost(host);
        });
    }
    function setTransportReadonly(card, readonly) {
        ['.smtp-host', '.smtp-port', '.smtp-username'].forEach(function(selector) {
            var input = card.querySelector(selector);
            if (input) input.readOnly = readonly;
        });
        ['.smtp-secure', '.smtp-auth'].forEach(function(selector) {
            var select = card.querySelector(selector);
            if (select) select.disabled = readonly;
        });
    }
    function fillFromAccount(card, account) {
        if (!account) return;
        var map = {
            '.smtp-host': account.smtp_host || '',
            '.smtp-port': account.smtp_port || '587',
            '.smtp-username': account.email || ''
        };
        Object.keys(map).forEach(function(selector) {
            var input = card.querySelector(selector);
            if (input) input.value = map[selector];
        });
        var secure = card.querySelector('.smtp-secure');
        if (secure) secure.value = account.smtp_secure || 'tls';
        var auth = card.querySelector('.smtp-auth');
        if (auth) auth.value = account.smtp_auth || '1';
        updateSummary(card);
    }
    function updateSummary(card) {
        var summary = card.querySelector('.smtp-auto-summary');
        if (!summary) return;
        var source = (card.querySelector('.smtp-source-type') || {}).value || 'external';
        if (source !== 'mail_account') {
            summary.textContent = text.externalSummary;
            return;
        }
        var host = (card.querySelector('.smtp-host') || {}).value || '';
        var port = (card.querySelector('.smtp-port') || {}).value || '';
        var secure = (card.querySelector('.smtp-secure') || {}).value || '';
        var username = (card.querySelector('.smtp-username') || {}).value || '';
        summary.textContent = host ? (host + ':' + port + ' · ' + secure.toUpperCase() + ' · ' + username) : text.pickMailAccount;
    }
    function updateSource(card) {
        var source = (card.querySelector('.smtp-source-type') || {}).value || 'external';
        var mailRow = card.querySelector('.smtp-mail-account-row');
        var passwordHelp = card.querySelector('.smtp-mail-password-help');
        card.classList.toggle('smtp-source-mail', source === 'mail_account');
        card.classList.toggle('smtp-source-external', source !== 'mail_account');
        if (mailRow) mailRow.style.display = source === 'mail_account' ? '' : 'none';
        if (passwordHelp) passwordHelp.style.display = source === 'mail_account' ? '' : 'none';
        setTransportReadonly(card, source === 'mail_account');
        if (source === 'mail_account') {
            var account = findAccount(hostValue(card.querySelector('[data-smtp-ss="mail-account"]')));
            if (account) fillFromAccount(card, account);
        }
        updateSummary(card);
    }
    function escapeHtml(value) {
        return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }
    function syncCardTitle(card) {
        var heading = card.querySelector('.w-card__header h6');
        if (!heading) return;
        var code = sanitizeSenderCode((card.querySelector('.smtp-code') || {}).value || '');
        var name = ((card.querySelector('.smtp-name') || {}).value || '').trim();
        var title = name || '<?= __("新发件人") ?>';
        heading.innerHTML = escapeHtml(title) + (code ? ' <code class="w-text" data-size="sm">' + escapeHtml(code) + '</code>' : ' <code class="w-text" data-size="sm"></code>');
    }
    function toastError(message) {
        if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) Weline.UI.toast.error(message);
    }
    function toastSuccess(message) {
        if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) Weline.UI.toast.success(message);
    }
    function resolveTargetScope() {
        var scopeField = document.querySelector('#smtp-config-scope input[name="target_scope"]');
        var targetScope = scopeField ? String(scopeField.value || '').trim() : '';
        if (!targetScope) {
            try { targetScope = new URL(window.location.href).searchParams.get('target_scope') || ''; } catch (err) { targetScope = ''; }
        }
        return targetScope;
    }
    function csrfHeaders(extra) {
        var headers = Object.assign({ 'Accept': 'application/json, text/plain, */*' }, extra || {});
        if (window.site && window.site.csrf_token) headers['X-CSRF-TOKEN'] = String(window.site.csrf_token);
        return headers;
    }
    function readHeader(headers, name) {
        if (!headers) return '';
        if (typeof headers.get === 'function') return String(headers.get(name) || headers.get(String(name).toLowerCase()) || '');
        var lower = String(name).toLowerCase();
        if (headers[name] != null) return String(headers[name]);
        if (headers[lower] != null) return String(headers[lower]);
        return '';
    }
    function isMaintenanceResult(res, err) {
        if (err) {
            if (err.maintenance || err.status === 503) return true;
            if (err.response && (err.response.maintenance || err.response.status === 503)) return true;
            if (err.data && (err.data.code === 'maintenance' || err.data.maintenance === true)) return true;
        }
        if (!res) return false;
        if (res.maintenance || res.status === 503) return true;
        var payload = res.data !== undefined ? res.data : (res.body !== undefined ? res.body : res);
        if (payload && typeof payload === 'object' && (payload.code === 'maintenance' || payload.maintenance === true)) return true;
        return readHeader(res.headers, 'X-Weline-Maintenance') === '1';
    }
    function requestJson(url, options) {
        options = options || {};
        var headers = csrfHeaders(options.headers || {});
        if (options.body && typeof options.body === 'string' && !headers['Content-Type'] && !headers['content-type']) {
            headers['Content-Type'] = 'application/json';
        }
        var opts = Object.assign({}, options, { headers: headers, credentials: options.credentials || 'same-origin', cache: options.cache || 'no-store' });
        var runner;
        if (window.Weline && window.Weline.Api && typeof window.Weline.Api.request === 'function') {
            runner = window.Weline.Api.request(url, opts);
        } else if (typeof window.fetch === 'function') {
            runner = window.fetch(url, opts).then(function(res) {
                return res.text().then(function(rawText) {
                    var body = {};
                    var looksJson = false;
                    try { body = rawText ? JSON.parse(rawText) : {}; looksJson = true; }
                    catch (parseErr) { body = { success: false, message: rawText || text.saveFailed }; }
                    var maintenance = res.status === 503 || (looksJson && body && body.code === 'maintenance') || (res.headers && res.headers.get('X-Weline-Maintenance') === '1');
                    if (maintenance) {
                        var mErr = new Error(text.maintenance); mErr.maintenance = true; mErr.status = 503; mErr.data = body; throw mErr;
                    }
                    if (!res.ok) {
                        var fErr = new Error((body && body.message) || text.saveFailed); fErr.status = res.status; fErr.data = body; throw fErr;
                    }
                    return { ok: true, status: res.status, data: body, body: body, success: !!(body && body.success), headers: res.headers };
                });
            });
        } else {
            runner = Promise.reject(new Error(text.saveFailed));
        }
        return Promise.resolve(runner);
    }

    function bindMailHost(host, card) {
        var hidden = host.querySelector('input[type="hidden"]');
        if (!hidden || hidden.__smtpBound) return;
        hidden.__smtpBound = true;
        hidden.addEventListener('change', function() {
            var account = findAccount(hidden.value);
            if (account) fillFromAccount(card, account);
            else updateSummary(card);
        });
    }
    function syncFromAccountChannels(card) {
        if (syncingBindings) return;
        syncingBindings = true;
        try {
            var transport = sanitizeSenderCode((card.querySelector('.smtp-code') || {}).value || '');
            var selected = hostValue(card.querySelector('[data-smtp-ss="account-channels"]')).split(',').map(function(s){return s.trim();}).filter(Boolean);
            document.querySelectorAll('.smtp-channel-bind-row').forEach(function(row) {
                var channel = row.getAttribute('data-channel') || '';
                var host = row.querySelector('[data-smtp-ss="channel-transport"]');
                if (!channel || !host) return;
                var cur = hostValue(host);
                if (selected.indexOf(channel) !== -1) {
                    if (cur !== transport) {
                        mountSearchSelect(host, {
                            id: 'smtp-ch-transport-' + Math.random().toString(36).slice(2, 9),
                            value: transport,
                            options: transportOptions,
                            clearable: true,
                            multiple: false,
                            placeholder: text.searchTransport,
                            minChars: 0
                        });
                        bindChannelTransportHost(host);
                    }
                } else if (cur === transport) {
                    mountSearchSelect(host, {
                        id: 'smtp-ch-transport-' + Math.random().toString(36).slice(2, 9),
                        value: '',
                        options: transportOptions,
                        clearable: true,
                        multiple: false,
                        placeholder: text.searchTransport,
                        minChars: 0
                    });
                    bindChannelTransportHost(host);
                }
            });
        } finally {
            syncingBindings = false;
        }
    }
    function syncAccountChannelsFromRows() {
        if (syncingBindings) return;
        syncingBindings = true;
        try {
            var byTransport = {};
            document.querySelectorAll('.smtp-channel-bind-row').forEach(function(row) {
                var channel = row.getAttribute('data-channel') || '';
                var tid = hostValue(row.querySelector('[data-smtp-ss="channel-transport"]'));
                if (!channel || !tid) return;
                if (!byTransport[tid]) byTransport[tid] = [];
                byTransport[tid].push(channel);
            });
            document.querySelectorAll('.smtp-sender-card').forEach(function(card) {
                var code = sanitizeSenderCode((card.querySelector('.smtp-code') || {}).value || '');
                var host = card.querySelector('[data-smtp-ss="account-channels"]');
                if (!code || !host) return;
                var next = (byTransport[code] || []).join(',');
                if (hostValue(host) === next) return;
                mountSearchSelect(host, {
                    id: 'smtp-acc-ch-' + Math.random().toString(36).slice(2, 9),
                    value: next,
                    options: channelOptions,
                    clearable: true,
                    multiple: true,
                    placeholder: text.searchChannels,
                    minChars: 0
                });
                bindAccountChannelsHost(host, card);
            });
        } finally {
            syncingBindings = false;
        }
    }
    function bindAccountChannelsHost(host, card) {
        var hidden = host.querySelector('input[type="hidden"]');
        if (!hidden || hidden.__smtpBound) return;
        hidden.__smtpBound = true;
        hidden.addEventListener('change', function() { syncFromAccountChannels(card); });
    }
    function bindChannelTransportHost(host) {
        var hidden = host.querySelector('input[type="hidden"]');
        if (!hidden || hidden.__smtpBound) return;
        hidden.__smtpBound = true;
        hidden.addEventListener('change', function() { syncAccountChannelsFromRows(); });
    }
    function mountCardSelectors(card) {
        var mailHost = card.querySelector('[data-smtp-ss="mail-account"]');
        if (mailHost) {
            mountSearchSelect(mailHost, {
                id: 'smtp-mail-' + Math.random().toString(36).slice(2, 9),
                value: mailHost.getAttribute('data-value') || '',
                options: mailAccountOptions,
                clearable: true,
                multiple: false,
                placeholder: text.searchMail,
                minChars: 0
            });
            bindMailHost(mailHost, card);
        }
        var chHost = card.querySelector('[data-smtp-ss="account-channels"]');
        if (chHost) {
            mountSearchSelect(chHost, {
                id: 'smtp-acc-ch-' + Math.random().toString(36).slice(2, 9),
                value: chHost.getAttribute('data-value') || '',
                options: channelOptions,
                clearable: true,
                multiple: true,
                placeholder: text.searchChannels,
                minChars: 0
            });
            bindAccountChannelsHost(chHost, card);
        }
    }
    function mountAllSelectors() {
        if (!ssApi()) {
            toastError(text.ssMissing);
            return;
        }
        document.querySelectorAll('.smtp-sender-card').forEach(mountCardSelectors);
        document.querySelectorAll('[data-smtp-ss="channel-transport"]').forEach(function(host) {
            mountSearchSelect(host, {
                id: 'smtp-ch-transport-' + Math.random().toString(36).slice(2, 9),
                value: host.getAttribute('data-value') || '',
                options: transportOptions,
                clearable: true,
                multiple: false,
                placeholder: text.searchTransport,
                minChars: 0
            });
            bindChannelTransportHost(host);
        });
    }

    function collectSenders() {
        var list = [];
        var invalid = null;
        document.querySelectorAll('.smtp-sender-card').forEach(function(card) {
            var rawCode = (card.querySelector('.smtp-code') && card.querySelector('.smtp-code').value.trim()) || '';
            var code = sanitizeSenderCode(rawCode);
            if (!code) return;
            if (!isValidSenderCode(code)) { invalid = code; return; }
            var pwd = card.querySelector('.smtp-password');
            var source = (card.querySelector('.smtp-source-type') && card.querySelector('.smtp-source-type').value) || 'external';
            var accountId = hostValue(card.querySelector('[data-smtp-ss="mail-account"]'));
            var account = source === 'mail_account' ? findAccount(accountId) : null;
            list.push({
                code: code,
                name: (card.querySelector('.smtp-name') && card.querySelector('.smtp-name').value) || code,
                source_type: source,
                mail_account_id: account ? String(account.account_id || '') : '',
                mail_account_email: account ? (account.email || '') : '',
                mail_domain_id: account ? String(account.domain_id || '') : '',
                mail_domain_name: account ? (account.domain_name || '') : '',
                mail_engine: account ? (account.engine || '') : '',
                mail_is_fake: account && account.is_fake ? '1' : '0',
                smtp_host: (card.querySelector('.smtp-host') && card.querySelector('.smtp-host').value) || '',
                smtp_port: (card.querySelector('.smtp-port') && card.querySelector('.smtp-port').value) || '465',
                smtp_secure: (card.querySelector('.smtp-secure') && card.querySelector('.smtp-secure').value) || 'ssl',
                smtp_auth: (card.querySelector('.smtp-auth') && card.querySelector('.smtp-auth').value) || '1',
                smtp_username: (card.querySelector('.smtp-username') && card.querySelector('.smtp-username').value) || '',
                smtp_password: (pwd && pwd.value) ? pwd.value : (card.getAttribute('data-pwd') || ''),
                smtp_test_address: ''
            });
        });
        if (invalid !== null) return { error: text.invalidCode };
        return { items: list };
    }
    function collectContacts() {
        var obj = {};
        document.querySelectorAll('.smtp-sender-card').forEach(function(card) {
            var code = sanitizeSenderCode((card.querySelector('.smtp-code') && card.querySelector('.smtp-code').value) || '');
            var contact = (card.querySelector('.smtp-contact') && card.querySelector('.smtp-contact').value) || '';
            if (code) obj[code] = contact;
        });
        return obj;
    }
    function collectChannelBindings() {
        var obj = {};
        document.querySelectorAll('.smtp-channel-bind-row').forEach(function(row) {
            var channel = row.getAttribute('data-channel') || '';
            var transport = hostValue(row.querySelector('[data-smtp-ss="channel-transport"]'));
            if (channel && transport) obj[channel] = transport;
        });
        document.querySelectorAll('.smtp-sender-card').forEach(function(card) {
            var transport = sanitizeSenderCode((card.querySelector('.smtp-code') || {}).value || '');
            if (!transport) return;
            hostValue(card.querySelector('[data-smtp-ss="account-channels"]')).split(',').forEach(function(ch) {
                ch = String(ch || '').trim();
                if (ch) obj[ch] = transport;
            });
        });
        return obj;
    }

    function addSenderCard() {
        var tpl = document.getElementById('smtpSenderCardTemplate');
        var node = tpl.content.firstElementChild.cloneNode(true);
        node.setAttribute('data-index', String(senderIndex));
        var codeInput = node.querySelector('.smtp-code');
        if (codeInput) {
            codeInput.value = generateTransportId();
            codeInput.readOnly = true;
        }
        document.getElementById('sendersList').appendChild(node);
        senderIndex++;
        mountCardSelectors(node);
        updateSource(node);
        syncCardTitle(node);
        remountTransportOptions();
    }

    document.getElementById('btnAddSender').addEventListener('click', addSenderCard);
    document.getElementById('sendersList').addEventListener('change', function(e) {
        if (e.target.closest('.smtp-source-type')) {
            updateSource(e.target.closest('.smtp-sender-card'));
        }
    });
    document.getElementById('sendersList').addEventListener('input', function(e) {
        var card = e.target.closest('.smtp-sender-card');
        if (!card) return;
        if (e.target.closest('.smtp-host') || e.target.closest('.smtp-port') || e.target.closest('.smtp-username') || e.target.closest('.smtp-name')) {
            updateSummary(card);
            if (e.target.closest('.smtp-name')) {
                syncCardTitle(card);
                remountTransportOptions();
            }
        }
    });
    document.getElementById('sendersList').addEventListener('click', function(e) {
        var rm = e.target.closest('.weline-btn-remove-sender, .btn-remove-sender');
        if (!rm) return;
        var card = rm.closest('.smtp-sender-card');
        if (!card) return;
        if (document.querySelectorAll('.smtp-sender-card').length > 1) {
            card.remove();
            remountTransportOptions();
            syncAccountChannelsFromRows();
            return;
        }
        Weline.UI.dialog.confirm('<?= __("确定删除最后一个发件人吗？删除后仍可重新添加。") ?>').then(function(confirmed) {
            if (confirmed) {
                card.remove();
                remountTransportOptions();
                syncAccountChannelsFromRows();
            }
        });
    });

    var testModal = null;
    document.getElementById('sendersList').addEventListener('click', function(e) {
        var btn = e.target.closest('.weline-btn-test-sender, .btn-test-sender');
        if (!btn) return;
        var card = btn.closest('.smtp-sender-card');
        var code = btn.getAttribute('data-code') || (card && card.querySelector('.smtp-code') && card.querySelector('.smtp-code').value);
        document.getElementById('testSenderCode').value = code || '';
        document.getElementById('testEmailTo').value = '';
        setTestFeedback('', '');
        if (!testModal) testModal = document.getElementById('testEmailModal');
        Weline.UI.dialog.open(testModal);
    });

    var testingSender = false;
    function setTestFeedback(message, tone) {
        var el = document.getElementById('smtpTestFeedback');
        if (!el) return;
        if (!message) {
            el.hidden = true;
            el.textContent = '';
            el.removeAttribute('data-tone');
            return;
        }
        el.hidden = false;
        el.textContent = String(message);
        el.setAttribute('data-tone', tone || 'muted');
    }
    document.getElementById('btnDoTest').addEventListener('click', function() {
        var code = document.getElementById('testSenderCode').value;
        var to = document.getElementById('testEmailTo').value.trim();
        var sendBtn = document.getElementById('btnDoTest');
        if (!to) { toastError(text.enterRecipient); setTestFeedback(text.enterRecipient, 'danger'); return; }
        if (testingSender) { toastError(text.busy); return; }
        testingSender = true;
        setTestFeedback(text.sending, 'muted');
        if (sendBtn) {
            sendBtn.disabled = true;
            sendBtn.setAttribute('aria-busy', 'true');
        }
        var targetScope = resolveTargetScope();
        var params = new URLSearchParams();
        params.set('smtp_test_address', to);
        if (code) params.set('sender_code', code);
        if (targetScope) params.set('target_scope', targetScope);
        params.set('isAjax', '1');
        if (window.site && window.site.csrf_token) params.set('csrf_token', String(window.site.csrf_token));
        var url = '@backend-url{'smtp/backend/config/posttest'}';
        requestJson(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: params.toString()
        }).then(function(res) {
            testingSender = false;
            if (sendBtn) {
                sendBtn.disabled = false;
                sendBtn.removeAttribute('aria-busy');
            }
            if (isMaintenanceResult(res)) {
                toastError(text.maintenance);
                setTestFeedback(text.maintenance, 'danger');
                return;
            }
            if (res && (res.status === 401 || res.status === 403)) {
                toastError(text.loginRequired);
                setTestFeedback(text.loginRequired, 'danger');
                return;
            }
            var d = (res && res.data) !== undefined ? res.data : res;
            if (d && d.success) {
                var okMsg = (d && d.message) || text.testSuccess;
                toastSuccess(okMsg);
                setTestFeedback(okMsg, 'success');
                if (!testModal) testModal = document.getElementById('testEmailModal');
                if (testModal && Weline && Weline.UI && Weline.UI.dialog) {
                    try { Weline.UI.dialog.close(testModal); } catch (err) {}
                }
                return;
            }
            var failMsg = (d && d.message) || text.testFailed;
            if (/could not connect to smtp host/i.test(failMsg)) {
                failMsg += ' — ' + '<?= __("请核对主机/端口：QQ 邮箱 465 须 SMTPS/SSL，587 须 STARTTLS/TLS") ?>';
            }
            toastError(failMsg);
            setTestFeedback(failMsg, 'danger');
        }).catch(function(err) {
            testingSender = false;
            if (sendBtn) {
                sendBtn.disabled = false;
                sendBtn.removeAttribute('aria-busy');
            }
            var failMsg = text.testFailed;
            if (isMaintenanceResult(null, err)) failMsg = text.maintenance;
            else if (err && err.message) failMsg = err.message;
            if (/could not connect to smtp host/i.test(failMsg)) {
                failMsg += ' — ' + '<?= __("请核对主机/端口：QQ 邮箱 465 须 SMTPS/SSL，587 须 STARTTLS/TLS") ?>';
            }
            toastError(failMsg);
            setTestFeedback(failMsg, 'danger');
        });
    });

    var savingSenders = false;
    function saveSenders(e) {
        if (e) e.preventDefault();
        if (savingSenders) { toastError(text.busy); return; }
        savingSenders = true;
        var collected = collectSenders();
        if (collected.error) { toastError(collected.error); savingSenders = false; return; }
        var senders = collected.items || [];
        var contacts = collectContacts();
        if (senders.length === 0) { toastError(text.addSender); savingSenders = false; return; }
        var needsMailAccount = senders.some(function(sender) {
            return sender.source_type === 'mail_account' && !sender.mail_account_id;
        });
        if (needsMailAccount) { toastError(text.pickMailAccount); savingSenders = false; return; }
        var url = '@backend-url{'smtp/backend/config/saveSenders'}';
        var targetScope = resolveTargetScope();
        var bindings = collectChannelBindings();
        var body = JSON.stringify({
            senders: senders,
            sender_contacts: contacts,
            smtp_senders_json: JSON.stringify(senders),
            smtp_sender_contacts_json: JSON.stringify(contacts),
            channel_bindings: bindings,
            smtp_channel_bindings_json: JSON.stringify(bindings),
            target_scope: targetScope
        });
        requestJson(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body })
            .then(function(res) {
                if (isMaintenanceResult(res)) { toastError(text.maintenance); savingSenders = false; return; }
                var d = (res && res.data) !== undefined ? res.data : res;
                if (d && d.success) {
                    toastSuccess(d.message || '<?= __("保存成功") ?>');
                    setTimeout(function() { window.location.reload(); }, 800);
                    return;
                }
                toastError((d && d.message) || text.saveFailed);
                savingSenders = false;
            })
            .catch(function(err) {
                if (isMaintenanceResult(null, err)) toastError(text.maintenance);
                else if (err && (err.status === 401 || err.status === 403)) toastError(text.loginRequired);
                else toastError((err && err.message) || text.saveFailed);
                savingSenders = false;
            });
    }

    document.getElementById('smtpSendersForm').addEventListener('submit', saveSenders);
    var saveButton = document.getElementById('btnSaveSenders');
    if (saveButton) saveButton.addEventListener('click', saveSenders);

    document.querySelectorAll('.smtp-sender-card').forEach(updateSource);
    if (document.querySelectorAll('.smtp-sender-card').length === 0) {
        addSenderCard();
    } else {
        mountAllSelectors();
    }
})();
</script>
