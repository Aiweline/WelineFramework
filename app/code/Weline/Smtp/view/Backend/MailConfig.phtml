    'guide_locate' => 'smtp_mail_bg_header',
]);
$smtpConfigUrl = $urlBuilder->getBackendUrl('smtp/backend/config', [
    'target_scope' => $selectedScope,
]);
$channelUrl = $urlBuilder->getBackendUrl('smtp/backend/template/listing', [
    'target_scope' => $selectedScope,
]);
$logUrl = $urlBuilder->getBackendUrl('smtp/backend/log/listing');
