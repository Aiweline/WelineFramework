                            $inherit = is_array($localeItem['inherit'] ?? null) ? $localeItem['inherit'] : null;
                            $inheritTpl = $inherit['template'] ?? null;
                            $inheritScope = (string)($inherit['storage_scope'] ?? '');
                            $inheritLocale = (string)($inherit['locale'] ?? '');
                            $inheritChannel = (string)($inherit['resolved_channel'] ?? '');
                            $localSubject = $tpl ? (string)$tpl->getData('subject') : '';
                            $inheritSubject = ($inheritTpl && is_object($inheritTpl))
                                ? (string)$inheritTpl->getData('subject')
                                : '';
                            $displaySubject = $localSubject !== '' ? $localSubject : $inheritSubject;
                            $isLocaleFallback = $tpl === null
                                && $inherit !== null
                                && $inheritScope === $selectedScope
                                && $inheritChannel === $code
                                && $inheritLocale !== ''
                                && $inheritLocale !== $loc;
                            $inheritLabel = '';
