    <script>
        (function () {
            var root = document.querySelector('[data-smtp-channel-listing="1"]');
            if (!root) { return; }
            var restoreDone = false;

            function scopeField() {
                var el = document.getElementById('smtp-channel-scope');
                if (!el) { return null; }
                if (el.matches && el.matches('input[name="target_scope"]')) {
                    return el;
                }
                return el.querySelector('input[type="hidden"][name="target_scope"]')
                    || el.querySelector('input[name="target_scope"]');
            }
            function writeListingParams(url) {
                var input = root.querySelector('[data-smtp-channel-search="1"]');
                var q = input ? String(input.value || '').trim() : '';
                if (q) { url.searchParams.set('q', q); } else { url.searchParams.delete('q'); }
                var locales = selectedLocaleList().join(',');
                if (locales) { url.searchParams.set('locales', locales); } else { url.searchParams.delete('locales'); }
                var openCh = root.querySelector('details.w-smtp-channel[open]:not([hidden])')
                    || root.querySelector('details.w-smtp-channel[open]');
                var channel = openCh ? String(openCh.getAttribute('data-channel') || '').trim() : '';
                if (channel) { url.searchParams.set('channel', channel); } else { url.searchParams.delete('channel'); }
                var focus = String(root.getAttribute('data-focus-locale') || '').trim();
                if (focus) { url.searchParams.set('focus_locale', focus); } else { url.searchParams.delete('focus_locale'); }
                return url;
            }
            function syncListingUrl() {
                try {
                    var url = writeListingParams(new URL(window.location.href));
                    history.replaceState(null, '', url.toString());
                } catch (_e) {}
            }
            function goScope() {
                var field = scopeField();
                var url = writeListingParams(new URL(window.location.href));
                if (field && field.value) {
                    var next = String(field.value || '').trim();
                    url.searchParams.set('target_scope', next);
                    url.searchParams.delete('website_code');
                    url.searchParams.delete('store_code');
                    url.searchParams.delete('channel_code');
                    url.searchParams.delete('scope_kind');
                    url.searchParams.delete('locale');
                }
                window.location.assign(url.toString());
            }
            var scopeInput = scopeField();
            if (scopeInput) { scopeInput.addEventListener('change', goScope); }

            function languageSelectRoot() {
                return document.getElementById('smtp-locale-filter_wrapper')
                    || root.querySelector('[data-w-component-id="smtp-locale-filter"]')
                    || root.querySelector('[data-testid="smtp-locale-tag-filter"] [data-w-component="language-select"]');
            }

            function languageSelectApi() {
                var el = languageSelectRoot();
                if (!el || !window.Weline || !Weline.UI || typeof Weline.UI.get !== 'function') {
                    return null;
                }
                try {
                    return Weline.UI.get(el, 'language-select');
                } catch (_e) {
                    return null;
                }
            }

            function selectedLocaleList() {
                var api = languageSelectApi();
                if (api && typeof api.getValues === 'function') {
                    return (api.getValues() || []).map(String).filter(Boolean);
                }
                var field = document.getElementById('smtp-locale-filter-field')
                    || (languageSelectRoot() && languageSelectRoot().querySelector('[data-w-language-field]'));
                if (!field || !field.selectedOptions) {
                    return [];
                }
                return Array.prototype.map.call(field.selectedOptions, function (opt) {
                    return String(opt.value || '').trim();
                }).filter(Boolean);
            }

            function applyLocaleRowFilter(body) {
                var selected = selectedLocaleList();
                var selectedMap = {};
                selected.forEach(function (code) { selectedMap[code] = true; });
                var rows = body.querySelectorAll('[data-smtp-locale-row="1"]');
                var visible = 0;
                rows.forEach(function (row) {
                    var loc = String(row.getAttribute('data-locale') || '');
                    var show = selected.length === 0 || !!selectedMap[loc];
                    row.hidden = !show;
                    if (show) { visible += 1; }
                });
                body.setAttribute('data-filter-empty', visible === 0 ? '1' : '0');
            }

            function applyAllLocaleFilters() {
                root.querySelectorAll('.w-smtp-channel__body').forEach(applyLocaleRowFilter);
            }

            function applyChannelSearch() {
                var input = root.querySelector('[data-smtp-channel-search="1"]');
                var q = input ? String(input.value || '').trim().toLowerCase() : '';
                var list = root.querySelector('[data-testid="smtp-channel-list"]');
                var channels = root.querySelectorAll('details.w-smtp-channel');
                var visible = 0;
                channels.forEach(function (ch) {
                    var hay = String(ch.getAttribute('data-search') || '').toLowerCase();
                    var show = q === '' || hay.indexOf(q) !== -1;
                    ch.hidden = !show;
                    if (show) { visible += 1; }
                });
                if (list) {
                    list.setAttribute('data-channel-empty', visible === 0 ? '1' : '0');
                }
            }

            function clearLocaleFilter() {
                var api = languageSelectApi();
                if (api && typeof api.setValues === 'function') {
                    api.setValues([]);
                    applyAllLocaleFilters();
                    syncListingUrl();
                    return;
                }
                var field = document.getElementById('smtp-locale-filter-field')
                    || (languageSelectRoot() && languageSelectRoot().querySelector('[data-w-language-field]'));
                if (field && field.options) {
                    Array.prototype.forEach.call(field.options, function (opt) { opt.selected = false; });
                    field.dispatchEvent(new Event('change', { bubbles: true }));
                }
                applyAllLocaleFilters();
                syncListingUrl();
            }

            function scrollToReturnPosition() {
                var openChannel = String(root.getAttribute('data-open-channel') || '').trim();
                var focus = String(root.getAttribute('data-focus-locale') || '').trim();
                var target = null;
                if (openChannel) {
                    var ch = root.querySelector('details.w-smtp-channel[data-channel="' + openChannel.replace(/"/g, '') + '"]');
                    if (ch) {
                        ch.open = true;
                        if (focus) {
                            target = ch.querySelector('[data-smtp-locale-row="1"][data-locale="' + focus.replace(/"/g, '') + '"]');
                        }
                        if (!target) { target = ch; }
                    }
                }
                if (target && typeof target.scrollIntoView === 'function') {
                    target.scrollIntoView({ block: 'center', inline: 'nearest' });
                }
            }

            function restoreFromUrl(attempt) {
                var initialLocales = String(root.getAttribute('data-initial-locales') || '')
                    .split(',')
                    .map(function (s) { return String(s || '').trim(); })
                    .filter(Boolean);
                applyChannelSearch();
                if (initialLocales.length) {
                    var api = languageSelectApi();
                    if (api && typeof api.setValues === 'function') {
                        api.setValues(initialLocales);
                        applyAllLocaleFilters();
                        if (!restoreDone) {
                            restoreDone = true;
                            scrollToReturnPosition();
                            syncListingUrl();
                        }
                        return;
                    }
                    if ((attempt || 0) < 40) {
                        setTimeout(function () { restoreFromUrl((attempt || 0) + 1); }, 50);
                        return;
                    }
                }
                applyAllLocaleFilters();
                if (!restoreDone) {
                    restoreDone = true;
                    scrollToReturnPosition();
                    syncListingUrl();
                }
            }

            root.addEventListener('input', function (event) {
                var t = event.target;
                if (t && t.getAttribute && t.getAttribute('data-smtp-channel-search') === '1') {
                    applyChannelSearch();
                    syncListingUrl();
                }
            });
            root.addEventListener('change', function (event) {
                var t = event.target;
                if (!t) { return; }
                if (t.id === 'smtp-locale-filter-field' || (t.getAttribute && t.getAttribute('data-w-language-field') !== null
                    && languageSelectRoot() && languageSelectRoot().contains(t))) {
                    applyAllLocaleFilters();
                    syncListingUrl();
                }
            });
            root.addEventListener('toggle', function (event) {
                var t = event.target;
                if (t && t.matches && t.matches('details.w-smtp-channel')) {
                    syncListingUrl();
                }
            }, true);
            root.addEventListener('click', function (event) {
                var t = event.target;
                if (t && t.closest && t.closest('[data-smtp-locale-clear="1"]')) {
                    clearLocaleFilter();
                    return;
                }
                var editLink = t && t.closest ? t.closest('a[data-testid^="smtp-channel-edit-"]') : null;
                if (!editLink || !editLink.href) { return; }
                try {
                    var url = writeListingParams(new URL(editLink.href, window.location.origin));
                    var row = editLink.closest('[data-smtp-locale-row="1"]');
                    var loc = row ? String(row.getAttribute('data-locale') || '').trim() : '';
                    if (loc) {
                        url.searchParams.set('focus_locale', loc);
                        url.searchParams.set('locale', loc);
                    }
                    var ch = editLink.closest('details.w-smtp-channel');
                    if (ch) {
                        url.searchParams.set('channel', String(ch.getAttribute('data-channel') || '').trim());
                    }
                    editLink.href = url.toString();
                } catch (_e) {}
            });

            restoreFromUrl(0);
        })();
    </script>

