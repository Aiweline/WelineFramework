        <script>
            (function () {
                var localeRoot = document.getElementById('smtp-tpl-locale');
                var storageInput = document.getElementById('smtp-tpl-storage-scope');
                function scopeField() {
                    var el = document.getElementById('smtp-template-edit-scope');
                    if (!el) { return null; }
                    if (el.matches && el.matches('input[name="target_scope"]')) {
                        return el;
                    }
                    return el.querySelector('input[type="hidden"][name="target_scope"]')
                        || el.querySelector('input[name="target_scope"]');
                }
                function localeField() {
                    if (!localeRoot) { return null; }
                    if (localeRoot.matches && (localeRoot.matches('input[name="locale"]') || localeRoot.matches('select[name="locale"]'))) {
                        return localeRoot;
                    }
                    return localeRoot.querySelector('input[type="hidden"][name="locale"]')
                        || localeRoot.querySelector('input[name="locale"]')
                        || localeRoot.querySelector('select[name="locale"]');
                }
                function syncStorageScope() {
                    var field = scopeField();
                    if (storageInput && field && field.value) {
                        storageInput.value = String(field.value || '').trim();
                    }
                }
                function go() {
                    var field = scopeField();
                    var localeInput = localeField();
                    var url = new URL(window.location.href);
                    syncStorageScope();
                    if (field && field.value) {
                        var next = String(field.value || '').trim();
                        url.searchParams.set('target_scope', next);
                        // 仅用完整 target_scope；勿写分段键，否则空 website 会覆盖显式范围
                        url.searchParams.delete('website_code');
                        url.searchParams.delete('store_code');
                        url.searchParams.delete('channel_code');
                        url.searchParams.delete('scope_kind');
                    }
                    if (localeInput && localeInput.value) {
                        url.searchParams.set('locale', String(localeInput.value || '').trim());
                    }
                    var channelInput = document.querySelector('#smtp-template-save-form input[name="channel_code"]');
                    var channel = channelInput && channelInput.value
                        ? String(channelInput.value || '').trim()
                        : (url.searchParams.get('channel') || '');
                    if (channel) {
                        url.searchParams.set('channel', channel);
                    }
                    // 按 channel+scope+locale 重载，避免锁死旧范围的 template_id
                    url.searchParams.delete('template_id');
                    window.location.assign(url.toString());
                }
                var scopeInput = scopeField();
                if (scopeInput) {
                    scopeInput.addEventListener('change', go);
                }
                var localeInput = localeField();
                if (localeInput) {
                    localeInput.addEventListener('change', go);
                }
                var saveForm = document.getElementById('smtp-template-save-form');
                if (saveForm) {
                    saveForm.addEventListener('submit', syncStorageScope);
                }
            })();
        </script>

