</div>
<script>
(function () {
    var bodyField = document.getElementById('smtp-tpl-body');
    var bodySource = document.getElementById('smtp-tpl-body-source');
    var shellRegionsField = document.getElementById('smtp-shell-regions-json');
    var subjectEl = document.getElementById('smtp-tpl-subject');
    var frame = document.getElementById('smtp-tpl-preview');
    var shellHtml = <?= $previewShellJson ?>;
    var samples = <?= $previewSamplesJson ?> || {};
    var initialBody = bodyField ? String(bodyField.value || '') : '';
    var activeRegion = 'all';
    var selectedEl = null;
    var selectedIsVar = false;
    var selectedVarCode = '';
    var editorReady = false;
    var toolbar = document.getElementById('smtp-ve-toolbar');
    var selectionLabel = document.getElementById('smtp-ve-selection-label');
    var varHint = document.getElementById('smtp-ve-var-hint');

    function escapeAttr(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    }

    function stripScripts(html) {
        return String(html || '')
            .replace(/<script[\s\S]*?<\/script>/gi, '')
            .replace(/\son\w+\s*=\s*(['"]).*?\1/gi, '')
            .replace(/\shref\s*=\s*(['"])\s*javascript:[^'"]*\1/gi, ' href="#"');
    }

    function parseStyleMap(style) {
        var map = {};
        String(style || '').split(';').forEach(function (part) {
            part = String(part || '').trim();
            if (!part || part.indexOf(':') < 0) return;
            var i = part.indexOf(':');
            var k = part.slice(0, i).trim().toLowerCase();
            var v = part.slice(i + 1).trim();
            if (k && v) map[k] = v;
        });
        return map;
    }

    function styleMapToString(map) {
        return Object.keys(map).map(function (k) { return k + ':' + map[k]; }).join(';');
    }

    function expandHex(hex) {
        hex = String(hex || '').replace(/^#/, '').toLowerCase();
        if (hex.length === 3) {
            hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        }
        return hex.length === 6 ? '#' + hex : '';
    }

    function contrastTextColor(bgHex) {
        var hex = expandHex(bgHex).replace(/^#/, '');
        if (hex.length !== 6) return '#16333f';
        var r = parseInt(hex.slice(0, 2), 16);
        var g = parseInt(hex.slice(2, 4), 16);
        var b = parseInt(hex.slice(4, 6), 16);
        var luma = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luma > 0.55 ? '#16333f' : '#f7f4ef';
    }

    function extractTdBackground(td) {
        var bg = expandHex(td.getAttribute('bgcolor') || '');
        if (bg) return bg;
        var style = String(td.getAttribute('style') || '');
        var m = style.match(/background(?:-color)?\s*:\s*(#[0-9a-fA-F]{3,8})\b/i);
        return m ? expandHex(m[1]) : '';
    }

    function ensureCtaAnchorStyle(anchor, bgHex) {
        var map = parseStyleMap(anchor.getAttribute('style') || '');
        map.display = map.display || 'inline-block';
        map.padding = map.padding || '14px 26px';
        map['font-family'] = map['font-family'] || 'Arial,Helvetica,sans-serif';
        map['font-size'] = map['font-size'] || '15px';
        map['font-weight'] = map['font-weight'] || '700';
        if (bgHex) {
            map.color = contrastTextColor(bgHex) + ' !important';
        } else if (!map.color) {
            map.color = '#ffffff !important';
            map.background = map.background || map['background-color'] || '#16333f';
            map['background-color'] = map['background-color'] || '#16333f';
        }
        map['text-decoration'] = 'none !important';
        map.border = map.border || '0';
        map['text-decoration-line'] = 'none';
        map['border-radius'] = map['border-radius'] || '4px';
        anchor.setAttribute('style', styleMapToString(map));
    }

    function looksLikeMailCta(anchor) {
        if (!anchor) return false;
        var href = String(anchor.getAttribute('href') || '').toLowerCase();
        var text = String(anchor.textContent || '').trim();
        if (/checkout|pay|cart|payment|token=/i.test(href)) return true;
        if (/支付|结账|付款|pay|checkout|继续/i.test(text)) return true;
        return false;
    }

    /** 预览态：把条件块（#if var.x … /if）包成可还原标记；假值隐藏但仍保留 DOM 以便保存写回 */
    function renderPreviewIfBlocks(html) {
        var out = String(html || '');
        out = out.replace(/\{\{\s*#if\s+var\.([A-Za-z][A-Za-z0-9_.]*?)\s*\}\}([\s\S]*?)\{\{\s*\/if\s*\}\}/g, function (_m, path, inner) {
            var val = samples && Object.prototype.hasOwnProperty.call(samples, path) ? samples[path] : '';
            var truthy = !(val == null || (typeof val === 'string' && String(val).trim() === ''));
            var safe = escapeAttr(path);
            var style = truthy ? '' : ' style="display:none!important"';
            return '<div data-weline-mail-if="' + safe + '"' + style + '>' + inner + '</div>';
        });
        // 残留未配对标签：预览隐藏原文，避免漏到画布
        out = out.replace(/\{\{\s*#if\s+[^}]+\}\}/g, '');
        out = out.replace(/\{\{\s*\/if\s*\}\}/g, '');
        return out;
    }

    function restoreMailIfBlocks(html) {
        var raw = String(html || '');
        if (!raw || raw.indexOf('data-weline-mail-if') < 0) return raw;
        try {
            var doc = new DOMParser().parseFromString('<div id="weline-mail-if-restore-root">' + raw + '</div>', 'text/html');
            var root = doc.getElementById('weline-mail-if-restore-root');
            if (!root) return raw;
            // 先内层后外层（若未来支持嵌套）
            var nodes = Array.prototype.slice.call(root.querySelectorAll('[data-weline-mail-if]')).reverse();
            nodes.forEach(function (el) {
                var path = String(el.getAttribute('data-weline-mail-if') || '').trim();
                if (!path || !/^[A-Za-z][A-Za-z0-9_.]*$/.test(path)) {
                    el.outerHTML = el.innerHTML;
                    return;
                }
                el.outerHTML = '{' + '{#if var.' + path + '}}' + el.innerHTML + '{' + '{/if}}';
            });
            return root.innerHTML;
        } catch (e) {
            return raw;
        }
    }

    /** 预览态：清掉历史富文本残留的空表 / 单独省略号段，不写回保存 */
    function scrubPreviewDebris(html) {
        var raw = String(html || '');
        if (!raw) return '';
        try {
            var doc = new DOMParser().parseFromString('<div id="weline-mail-scrub-root">' + raw + '</div>', 'text/html');
            var root = doc.getElementById('weline-mail-scrub-root');
            if (!root) return raw;
            Array.prototype.slice.call(root.querySelectorAll('p,div')).forEach(function (el) {
                var t = String(el.textContent || '').replace(/\u00a0/g, ' ').trim();
                if (t === '…' || t === '...' || t === '') {
                    if (!el.querySelector('img,table,a[href]')) el.parentNode && el.parentNode.removeChild(el);
                }
            });
            Array.prototype.slice.call(root.querySelectorAll('table')).forEach(function (table) {
                var t = String(table.textContent || '').replace(/\u00a0/g, ' ').trim();
                var cells = table.querySelectorAll('td,th');
                if (cells.length <= 1 && (t === '' || t === '…' || t === '...') && !table.querySelector('img')) {
                    table.parentNode && table.parentNode.removeChild(table);
                }
            });
            return root.innerHTML;
        } catch (e) {
            return raw;
        }
    }

    function normalizeEmailBody(html) {
        var raw = stripScripts(html);
        if (!raw) return '';
        try {
            var tokens = [];
            var protectedHtml = String(raw).replace(/\{\{\s*[^}]+\}\}/g, function (m) {
                var key = 'WELINEMAILTOK' + tokens.length + 'X';
                tokens.push({ key: key, value: m });
                return key;
            });
            var doc = new DOMParser().parseFromString('<div id="weline-mail-normalize-root">' + protectedHtml + '</div>', 'text/html');
            var root = doc.getElementById('weline-mail-normalize-root');
            if (!root) return raw;
            Array.prototype.slice.call(root.querySelectorAll('figure.table')).forEach(function (figure) {
                var parent = figure.parentNode;
                if (!parent) return;
                while (figure.firstChild) parent.insertBefore(figure.firstChild, figure);
                parent.removeChild(figure);
            });
            Array.prototype.slice.call(root.querySelectorAll('td')).forEach(function (td) {
                var bg = extractTdBackground(td);
                if (bg) {
                    if (!td.getAttribute('bgcolor')) td.setAttribute('bgcolor', bg);
                    var tdStyle = String(td.getAttribute('style') || '');
                    if (!/background(-color)?\s*:/i.test(tdStyle)) {
                        td.setAttribute('style', (tdStyle ? tdStyle.replace(/;?\s*$/, ';') : '') + 'background:' + bg + ';');
                    }
                    Array.prototype.slice.call(td.querySelectorAll('a')).forEach(function (a) {
                        ensureCtaAnchorStyle(a, bg);
                    });
                }
                // 恢复键值表左列 nowrap（编辑器常剥掉导致中文竖排）
                var st = String(td.getAttribute('style') || '');
                if (/width\s*:\s*1%/i.test(st) && !/white-space\s*:/i.test(st)) {
                    td.setAttribute('style', st.replace(/;?\s*$/, ';') + 'white-space:nowrap;');
                }
            });
            // 裸 CTA（不在色底 TD 内）被编辑器剥样式后补回按钮态
            Array.prototype.slice.call(root.querySelectorAll('a')).forEach(function (a) {
                if (!looksLikeMailCta(a)) return;
                var st = String(a.getAttribute('style') || '');
                if (/padding\s*:/i.test(st) && /background/i.test(st)) return;
                ensureCtaAnchorStyle(a, '');
            });
            var out = root.innerHTML;
            tokens.forEach(function (item) {
                out = out.split(item.key).join(item.value);
            });
            return out;
        } catch (e) {
            return raw;
        }
    }

    function wrapSampleValue(code, value, isRaw) {
        var safeCode = escapeAttr(code);
        var rawAttr = isRaw ? ' data-weline-mail-var-raw="1"' : '';
        return '<span data-weline-mail-var="' + safeCode + '"' + rawAttr
            + ' contenteditable="false">' + String(value == null ? '' : value) + '</span>';
    }

    function replaceSamplesInChunk(chunk, wrap) {
        var out = String(chunk || '');
        Object.keys(samples).forEach(function (code) {
            var value = samples[code] == null ? '' : String(samples[code]);
            var reRaw = new RegExp('\\{\\{\\s*var\\.' + code.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*\\|\\s*raw\\s*\\}\\}', 'g');
            var rePlain = new RegExp('\\{\\{\\s*var\\.' + code.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*\\}\\}', 'g');
            if (wrap) {
                out = out.replace(reRaw, function () { return wrapSampleValue(code, value, true); });
                out = out.replace(rePlain, function () { return wrapSampleValue(code, value, false); });
            } else {
                out = out.replace(reRaw, value);
                out = out.replace(rePlain, value);
            }
        });
        return out;
    }

    function applySamples(html) {
        // 标签属性/样式内只做纯替换；标签外文本才包 data-weline-mail-var（避免破坏 HTML）
        var src = String(html || '');
        var out = '';
        var re = /(<[^>]*>)|([^<]+)/g;
        var m;
        while ((m = re.exec(src)) !== null) {
            if (m[1]) out += replaceSamplesInChunk(m[1], false);
            else out += replaceSamplesInChunk(m[2], true);
        }
        return out;
    }

    function restoreMailVarsHtml(html) {
        var raw = String(html || '');
        if (!raw || raw.indexOf('data-weline-mail-var') < 0) return raw;
        try {
            var doc = new DOMParser().parseFromString('<div id="weline-mail-restore-root">' + raw + '</div>', 'text/html');
            var root = doc.getElementById('weline-mail-restore-root');
            if (!root) return raw;
            Array.prototype.slice.call(root.querySelectorAll('[data-weline-mail-var]')).forEach(function (span) {
                var code = String(span.getAttribute('data-weline-mail-var') || '').trim();
                if (!code) return;
                var isRaw = span.getAttribute('data-weline-mail-var-raw') === '1';
                var token = '{' + '{var.' + code + (isRaw ? '|raw' : '') + '}}';
                var style = String(span.getAttribute('style') || '')
                    .replace(/(?:^|;)\s*cursor\s*:\s*[^;]*/gi, '')
                    .replace(/^;+|;+$/g, '')
                    .trim();
                if (style) {
                    span.outerHTML = '<span style="' + style.replace(/"/g, '&quot;') + '">' + token + '</span>';
                } else {
                    span.outerHTML = token;
                }
            });
            return root.innerHTML;
        } catch (e) {
            return raw;
        }
    }

    function getIframeDoc() {
        return frame && frame.contentDocument ? frame.contentDocument : null;
    }

    function regionNodes(doc, region) {
        return doc ? Array.prototype.slice.call(doc.querySelectorAll('[data-weline-mail-region="' + region + '"]')) : [];
    }

    function buildMailHtml(bodyHtml) {
        var subject = subjectEl ? String(subjectEl.value || '') : '';
        var html = String(shellHtml || '');
        var body = scrubPreviewDebris(normalizeEmailBody(bodyHtml));
        html = html.split('{' + '{MAIL_BODY}}').join(body);
        html = html.split('{' + '{PREHEADER}}').join(subject.replace(/[<>&]/g, function (c) {
            return ({'<': '&lt;', '>': '&gt;', '&': '&amp;'})[c] || c;
        }));
        // 先求条件块再填样例，避免 #if 原文漏到画布
        html = renderPreviewIfBlocks(html);
        html = applySamples(html);
        return stripScripts(html);
    }

    function injectEditorStyles(doc) {
        if (!doc || !doc.head) return;
        var style = doc.getElementById('w-smtp-ve-style');
        if (!style) {
            style = doc.createElement('style');
            style.id = 'w-smtp-ve-style';
            doc.head.appendChild(style);
        }
        // 选中高亮 + 预览约束（按真信宽度；页头 Logo 规则须写在通用 img 规则之后）
        style.textContent = ''
            + 'html,body{margin:0;overflow-x:hidden;}'
            + 'tr.w-smtp-ve-row-hidden{display:none!important;}'
            + '[contenteditable="true"]:focus{outline:none;}'
            + '.w-smtp-ve-selected{'
            + 'outline:2px dashed #b84a3c !important;'
            + 'outline-offset:-6px !important;'
            + 'box-shadow:inset 0 0 0 6px transparent;'
            + '}'
            + 'table[role="presentation"]{max-width:100% !important;}'
            + 'table[width="600"],table[style*="max-width:600"]{'
            + 'width:100% !important;max-width:600px !important;'
            + '}'
            + '[data-weline-mail-region] img{max-width:100% !important;height:auto !important;}'
            // 页头两列：Logo 固定窄列 + 文案列吃满剩余；禁止 anywhere 逐字竖排
            // 保留 shell 注入的 background-image（邮件配置三区背景图），与真信一致
            + '[data-weline-mail-region="header"]{'
            + 'width:100% !important;'
            + 'overflow:hidden !important;'
            + 'background-repeat:no-repeat !important;'
            + 'background-size:cover !important;'
            + 'background-position:center !important;'
            + '}'
            + '[data-weline-mail-region="body"],'
            + '[data-weline-mail-region="footer"]{'
            + 'background-repeat:no-repeat !important;'
            + 'background-size:cover !important;'
            + 'background-position:center !important;'
            + '}'
            + '[data-weline-mail-region="header"] > table{'
            + 'width:100% !important;'
            + 'max-width:100% !important;'
            + 'table-layout:fixed !important;'
            + '}'
            + '[data-weline-mail-region="header"] > table > tbody > tr > td:first-child,'
            + '[data-weline-mail-region="header"] > table > tr > td:first-child{'
            + 'width:72px !important;'
            + 'max-width:72px !important;'
            + 'white-space:nowrap !important;'
            + 'vertical-align:middle !important;'
            + '}'
            + '[data-weline-mail-region="header"] > table > tbody > tr > td:last-child,'
            + '[data-weline-mail-region="header"] > table > tr > td:last-child{'
            + 'width:auto !important;'
            + 'vertical-align:middle !important;'
            + 'word-break:normal !important;'
            + 'overflow-wrap:break-word !important;'
            + '}'
            + '[data-weline-mail-region="header"] img{'
            + 'max-height:56px !important;width:auto !important;max-width:64px !important;height:auto !important;'
            + 'display:block !important;'
            + '}'
            // 正文内联样式被剥光时的预览兜底（不写回邮件，仅画布可读）
            + '[data-weline-mail-region="body"] h1{'
            + 'margin:0 0 16px;font-family:Georgia,Palatino,serif;font-size:26px;line-height:1.25;font-weight:600;color:#16333f;'
            + '}'
            + '[data-weline-mail-region="body"] p{margin:0 0 12px;}'
            + '[data-weline-mail-region="body"] a[href]{'
            + 'color:#16333f;'
            + '}'
            // 键值表左列：若剥掉 nowrap，width:1% 会逐字竖排
            + '[data-weline-mail-region="body"] table td[style*="width:1%"],'
            + '[data-weline-mail-region="body"] table td[style*="width: 1%"]{'
            + 'white-space:nowrap !important;'
            + 'min-width:4.5em !important;'
            + 'width:1% !important;'
            + 'vertical-align:top !important;'
            + 'word-break:keep-all !important;'
            + 'overflow-wrap:normal !important;'
            + '}';
    }

    function clearActiveSelection() {
        var doc = getIframeDoc();
        if (selectedEl && selectedEl.removeAttribute) {
            try { selectedEl.removeAttribute('contenteditable'); } catch (e) {}
        }
        selectedEl = null;
        selectedIsVar = false;
        selectedVarCode = '';
        clearSelectionMark(doc);
        hideFloatingToolbar();
        if (varHint) { varHint.hidden = true; varHint.textContent = ''; }
        if (selectionLabel) {
            selectionLabel.textContent = isAllRegionView()
                ? '<?= $h(__('整体预览：点击任意区域文字可调样式')) ?>'
                : '<?= $h(__('点击文字以调整样式')) ?>';
        }
    }

    function clearSelectionMark(doc) {
        if (!doc) return;
        Array.prototype.slice.call(doc.querySelectorAll('.w-smtp-ve-selected')).forEach(function (el) {
            el.classList.remove('w-smtp-ve-selected');
        });
    }

    function regionRow(node) {
        return node && node.closest ? node.closest('tr') : null;
    }

    function isAllRegionView() {
        return activeRegion === 'all';
    }

    function resolveRegionRoot(node) {
        if (!node || !node.closest) return null;
        if (isAllRegionView()) return node.closest('[data-weline-mail-region]');
        return node.closest('[data-weline-mail-region="' + activeRegion + '"]');
    }

    function setActiveRegion(region) {
        activeRegion = region || 'body';
        document.querySelectorAll('.w-smtp-ve-region-tab').forEach(function (tab) {
            var on = tab.getAttribute('data-region') === activeRegion;
            tab.classList.toggle('is-active', on);
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        var doc = getIframeDoc();
        if (!doc) return;
        injectEditorStyles(doc);
        var showAll = isAllRegionView();
        var seenRows = [];
        ['header', 'body', 'footer'].forEach(function (name) {
            regionNodes(doc, name).forEach(function (node) {
                node.removeAttribute('contenteditable');
                var row = regionRow(node);
                if (row && seenRows.indexOf(row) < 0) {
                    seenRows.push(row);
                    row.classList.toggle('w-smtp-ve-row-hidden', !showAll && name !== activeRegion);
                }
            });
        });
        if (seenRows.length && seenRows[0].parentElement) {
            Array.prototype.slice.call(seenRows[0].parentElement.children).forEach(function (tr) {
                if (!tr || String(tr.tagName || '').toUpperCase() !== 'TR') return;
                if (tr.querySelector('[data-weline-mail-region]')) return;
                // 区间装饰行：整体视图全显；分区时仅正文保留（避免页头/页尾夹缝露馅）
                tr.classList.toggle('w-smtp-ve-row-hidden', !showAll && activeRegion !== 'body');
            });
        }
        clearActiveSelection();
        if (selectionLabel) {
            selectionLabel.textContent = showAll
                ? '<?= $h(__('整体预览：点击任意区域文字可调样式')) ?>'
                : '<?= $h(__('点击文字以调整样式')) ?>';
        }
    }

    function pickStyleTarget(el, regionRoot) {
        if (!el || !regionRoot) return null;
        if (el.nodeType === 3) el = el.parentElement;
        if (!el || !regionRoot.contains(el)) return null;
        var varNode = el.closest ? el.closest('[data-weline-mail-var]') : null;
        if (varNode && regionRoot.contains(varNode)) {
            // 变量点选：提到外层块（div/td/标题），便于框选整段并出工具条
            var styleEl = varNode;
            var p = varNode.parentElement;
            while (p && p !== regionRoot) {
                var pTag = String(p.tagName || '').toUpperCase();
                if (pTag === 'DIV' || pTag === 'TD' || pTag === 'TH' || pTag === 'P' || /^H[1-6]$/.test(pTag)) {
                    styleEl = p;
                    break;
                }
                p = p.parentElement;
            }
            return { el: styleEl, isVar: true, varCode: String(varNode.getAttribute('data-weline-mail-var') || '') };
        }
        var cur = el;
        while (cur && cur !== regionRoot) {
            var tag = String(cur.tagName || '').toUpperCase();
            if (tag && tag !== 'TABLE' && tag !== 'TBODY' && tag !== 'THEAD' && tag !== 'TR') {
                return { el: cur, isVar: false, varCode: '' };
            }
            cur = cur.parentElement;
        }
        return { el: regionRoot, isVar: false, varCode: '' };
    }

    function rgbToHex(rgb) {
        var m = String(rgb || '').match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([0-9.]+))?/i);
        if (!m) return expandHex(rgb) || '';
        if (m[4] !== undefined && parseFloat(m[4]) === 0) return '';
        function pad(n) {
            var h = Number(n).toString(16);
            return h.length === 1 ? '0' + h : h;
        }
        return '#' + pad(m[1]) + pad(m[2]) + pad(m[3]);
    }

    function syncToolbarFromSelection() {
        if (!selectedEl || !toolbar) return;
        var doc = getIframeDoc();
        var win = doc && doc.defaultView ? doc.defaultView : window;
        var style = win.getComputedStyle(selectedEl);
        var colorInput = document.getElementById('smtp-ve-color');
        var bgInput = document.getElementById('smtp-ve-bg');
        var sizeSelect = document.getElementById('smtp-ve-font-size');
        var fontSelect = document.getElementById('smtp-ve-font-family');
        var textHex = expandHex(selectedEl.style.getPropertyValue('color'))
            || rgbToHex(selectedEl.style.color)
            || rgbToHex(style.color)
            || '#1c1c1c';
        var bgHex = expandHex(selectedEl.style.getPropertyValue('background-color'))
            || rgbToHex(selectedEl.style.backgroundColor)
            || rgbToHex(style.backgroundColor)
            || '#ffffff';
        if (colorInput) colorInput.value = textHex;
        var colorHexInput = document.getElementById('smtp-ve-color-hex');
        if (colorHexInput) colorHexInput.value = textHex;
        if (bgInput) bgInput.value = bgHex;
        if (sizeSelect) {
            var fs = selectedEl.style.fontSize || '';
            if (!fs && style.fontSize) {
                var px = Math.round(parseFloat(style.fontSize));
                if (px > 0) fs = px + 'px';
            }
            sizeSelect.value = fs;
            if (fs && !Array.prototype.some.call(sizeSelect.options, function (o) { return o.value === fs; })) {
                var opt = document.createElement('option');
                opt.value = fs;
                opt.textContent = fs;
                sizeSelect.appendChild(opt);
                sizeSelect.value = fs;
            }
        }
        if (fontSelect) {
            var ff = selectedEl.style.fontFamily || style.fontFamily || '';
            fontSelect.value = '';
            Array.prototype.slice.call(fontSelect.options).forEach(function (opt) {
                if (!opt.value) return;
                var needle = opt.value.replace(/["']/g, '').split(',')[0].trim().toLowerCase();
                if (needle && ff.toLowerCase().indexOf(needle) >= 0) fontSelect.value = opt.value;
            });
        }
    }

    function hideFloatingToolbar() {
        if (!toolbar) return;
        toolbar.hidden = true;
        toolbar.style.left = '';
        toolbar.style.top = '';
        toolbar.style.visibility = '';
    }

    /**
     * iframe 内元素 getBoundingClientRect 在标准 Chromium 为顶层视口坐标，
     * 部分嵌入 WebView 则为 iframe 文档局部坐标。统一换算到顶层视口，避免工具条飞出。
     */
    function getViewportRectForEl(el) {
        var r = el.getBoundingClientRect();
        var out = { top: r.top, left: r.left, right: r.right, bottom: r.bottom, width: r.width, height: r.height };
        if (!el || !frame) return out;
        try {
            if (el.ownerDocument !== frame.contentDocument) return out;
        } catch (e) {
            return out;
        }
        var fr = frame.getBoundingClientRect();
        var midX = r.left + r.width / 2;
        var midY = r.top + r.height / 2;
        var insideFrame = midX >= (fr.left - 1) && midX <= (fr.right + 1)
            && midY >= (fr.top - 1) && midY <= (fr.bottom + 1);
        if (insideFrame) return out;
        return {
            top: fr.top + r.top,
            left: fr.left + r.left,
            right: fr.left + r.right,
            bottom: fr.top + r.bottom,
            width: r.width,
            height: r.height
        };
    }

    function positionFloatingToolbar() {
        if (!toolbar || !selectedEl || !frame || toolbar.hidden) return;
        var canvas = frame.closest('.w-smtp-ve-canvas') || frame.parentElement;
        if (!canvas) return;
        var elRect = getViewportRectForEl(selectedEl);
        var canvasRect = canvas.getBoundingClientRect();
        if (!elRect.width && !elRect.height) return;

        toolbar.style.visibility = 'hidden';
        toolbar.hidden = false;
        var gap = 10;
        var pad = 8;
        var tw = toolbar.offsetWidth || 280;
        var th = toolbar.offsetHeight || 160;

        var elTop = elRect.top - canvasRect.top;
        var elLeft = elRect.left - canvasRect.left;
        var elRight = elRect.right - canvasRect.left;
        var elBottom = elRect.bottom - canvasRect.top;

        // 优先右侧；不够则左侧；再贴内边
        var left = elRight + gap;
        if (left + tw > canvasRect.width - pad) {
            left = elLeft - tw - gap;
        }
        if (left < pad) {
            left = Math.max(pad, Math.min(canvasRect.width - tw - pad, elLeft));
        }

        var top = elTop;
        if (top + th > canvasRect.height - pad) {
            top = Math.max(pad, canvasRect.height - th - pad);
        }
        if (top < pad) top = pad;
        if (left < elRight && left + tw > elLeft && top < elBottom && top + th > elTop) {
            var below = elBottom + gap;
            if (below + th <= canvasRect.height - pad) {
                top = below;
                left = Math.max(pad, Math.min(canvasRect.width - tw - pad, elLeft));
            }
        }

        toolbar.style.left = Math.round(left) + 'px';
        toolbar.style.top = Math.round(top) + 'px';
        toolbar.style.visibility = '';
    }

    function showSelection(info) {
        var doc = getIframeDoc();
        clearSelectionMark(doc);
        selectedEl = info && info.el ? info.el : null;
        selectedIsVar = !!(info && info.isVar);
        selectedVarCode = info && info.varCode ? String(info.varCode) : '';
        if (!selectedEl || !toolbar) {
            hideFloatingToolbar();
            return;
        }
        selectedEl.classList.add('w-smtp-ve-selected');
        toolbar.hidden = false;
        if (selectionLabel) {
            selectionLabel.textContent = selectedEl.tagName.toLowerCase()
                + (selectedIsVar ? (' · {' + '{var.' + selectedVarCode + '}}') : '');
        }
        if (varHint) {
            if (selectedIsVar) {
                varHint.hidden = false;
                varHint.textContent = '<?= $h(__('此段为变量渲染：可改文字色、背景、字号、字体与左右对齐，不可修改文字内容。')) ?>'
                    + (selectedVarCode ? (' (' + selectedVarCode + ')') : '');
            } else {
                varHint.hidden = true;
                varHint.textContent = '';
            }
        }
        selectedEl.setAttribute('contenteditable', selectedIsVar ? 'false' : 'true');
        Array.prototype.slice.call(selectedEl.querySelectorAll('[data-weline-mail-var]')).forEach(function (n) {
            n.setAttribute('contenteditable', 'false');
        });
        syncToolbarFromSelection();
        // 等布局稳定后再贴边（含字号等控件撑开）
        requestAnimationFrame(function () {
            positionFloatingToolbar();
            requestAnimationFrame(positionFloatingToolbar);
        });
    }

    function applyTextColor(el, value) {
        if (!el || !value) return;
        var hex = expandHex(value) || String(value || '').trim();
        if (!hex) return;
        function paint(node) {
            if (!node || !node.style) return;
            node.style.setProperty('color', hex, 'important');
            if (node.hasAttribute && node.hasAttribute('color')) node.setAttribute('color', hex);
            // 邮件客户端更认 style 里的 hex；顺带写回属性串，避免只剩 computed
            var st = String(node.getAttribute('style') || '');
            if (/color\s*:/i.test(st)) {
                st = st.replace(/color\s*:[^;]*/ig, 'color:' + hex + ' !important');
            } else {
                st = (st ? st.replace(/;?\s*$/, ';') : '') + 'color:' + hex + ' !important';
            }
            node.setAttribute('style', st.replace(/;;+/g, ';').replace(/^;|;$/g, ''));
        }
        paint(el);
        Array.prototype.slice.call(el.querySelectorAll('*')).forEach(function (node) {
            var tag = String(node.tagName || '').toUpperCase();
            if (tag === 'BR' || tag === 'HR' || tag === 'IMG' || tag === 'SVG' || tag === 'PATH') return;
            var st = String(node.getAttribute('style') || '');
            var hasOwnColor = /color\s*:/i.test(st) || node.hasAttribute('color');
            var isTextish = /^(A|SPAN|FONT|STRONG|B|EM|I|U|P|H1|H2|H3|H4|H5|H6|DIV|TD|TH|LI|LABEL|SMALL|LABEL)$/.test(tag)
                || node.hasAttribute('data-weline-mail-var');
            if (hasOwnColor || isTextish || node.hasAttribute('data-weline-mail-var')) {
                paint(node);
            }
        });
    }

    function serializeRegionHtml(node) {
        if (!node) return '';
        // 克隆后去掉选中高亮 class，避免写入模板
        var clone = node.cloneNode(true);
        Array.prototype.slice.call(clone.querySelectorAll('.w-smtp-ve-selected')).forEach(function (el) {
            el.classList.remove('w-smtp-ve-selected');
        });
        clone.classList.remove('w-smtp-ve-selected');
        return restoreMailIfBlocks(restoreMailVarsHtml(String(clone.innerHTML || '').trim()));
    }

    function readBodyFromIframe() {
        var doc = getIframeDoc();
        if (!doc) return initialBody;
        var bodyCell = doc.querySelector('[data-weline-mail-region="body"]');
        return bodyCell ? serializeRegionHtml(bodyCell) : initialBody;
    }

    function readShellRegionsFromIframe() {
        var doc = getIframeDoc();
        if (!doc) return { header: '', footer: [] };
        var headerCell = doc.querySelector('[data-weline-mail-region="header"]');
        var footerCells = doc.querySelectorAll('[data-weline-mail-region="footer"]');
        return {
            header: headerCell ? serializeRegionHtml(headerCell) : '',
            footer: Array.prototype.map.call(footerCells, function (td) { return serializeRegionHtml(td); })
        };
    }

    function sanitizeMailRegionRows(doc) {
        // 壳合并若误切嵌套 </td>，会在区域 TR 上残留无 region 的兄弟 TD（页头竖条重影）
        if (!doc) return;
        Array.prototype.forEach.call(doc.querySelectorAll('[data-weline-mail-region]'), function (td) {
            var tr = td.parentElement;
            if (!tr || String(tr.tagName || '').toUpperCase() !== 'TR') return;
            Array.prototype.slice.call(tr.children).forEach(function (sib) {
                if (sib === td) return;
                if (String(sib.tagName || '').toUpperCase() !== 'TD') return;
                if (sib.hasAttribute('data-weline-mail-region')) return;
                if (sib.parentNode) sib.parentNode.removeChild(sib);
            });
        });
    }

    function applyRegionsToIframe(regions) {
        var doc = getIframeDoc();
        if (!doc || !regions) return;
        var headerCell = doc.querySelector('[data-weline-mail-region="header"]');
        if (headerCell && regions.header) headerCell.innerHTML = applySamples(regions.header);
        var footerCells = doc.querySelectorAll('[data-weline-mail-region="footer"]');
        var footers = (regions.footer && regions.footer.length) ? regions.footer : [];
        if (footerCells.length === 1 && footers.length > 1) {
            var joined = [];
            for (var fi = 0; fi < footers.length; fi++) {
                if (footers[fi]) joined.push(footers[fi]);
            }
            if (joined.length) footerCells[0].innerHTML = applySamples(joined.join('\n'));
        } else {
            Array.prototype.forEach.call(footerCells, function (td, idx) {
                if (footers[idx]) td.innerHTML = applySamples(footers[idx]);
            });
        }
        sanitizeMailRegionRows(doc);
    }

    var syncingFromVisual = false;

    function syncFormFields(rebuild) {
        if (rebuild && editorReady) {
            initialBody = readBodyFromIframe();
            var preservedRegions = readShellRegionsFromIframe();
            renderVisualEditor(initialBody);
            var tries = 0;
            (function waitRestore() {
                var doc = getIframeDoc();
                if (doc && doc.__smtpVeBound) {
                    applyRegionsToIframe(preservedRegions);
                    setActiveRegion(activeRegion);
                    return;
                }
                if (tries++ > 20) return;
                setTimeout(waitRestore, 60);
            })();
            return;
        }
        var bodyHtml = normalizeEmailBody(readBodyFromIframe());
        if (bodyField) bodyField.value = bodyHtml;
        // 样式微调时只同步隐藏字段与纯文本源码框，避免冲掉选中态
        if (bodySource && bodySource.value !== bodyHtml) {
            syncingFromVisual = true;
            bodySource.value = bodyHtml;
            syncingFromVisual = false;
        }
        if (shellRegionsField) shellRegionsField.value = JSON.stringify(readShellRegionsFromIframe());
    }

    function applyStyle(prop, value) {
        if (!selectedEl) return;
        if (prop === 'textAlign') {
            selectedEl.style.textAlign = value;
            if (selectedEl.tagName === 'TD') {
                selectedEl.setAttribute('align', value === 'right' ? 'right' : (value === 'center' ? 'center' : 'left'));
            }
        } else if (prop === 'color') {
            applyTextColor(selectedEl, value);
        } else if (prop === 'backgroundColor') {
            selectedEl.style.backgroundColor = value;
            if (selectedEl.tagName === 'TD' && value) selectedEl.setAttribute('bgcolor', value);
        } else if (prop === 'fontSize') {
            selectedEl.style.fontSize = value || '';
        } else if (prop === 'fontFamily') {
            selectedEl.style.fontFamily = value || '';
        }
        syncFormFields(false);
        positionFloatingToolbar();
    }

    function bindIframeEditor() {
        var doc = getIframeDoc();
        if (!doc || !doc.body) return false;
        if (doc.__smtpVeBound) return true;
        doc.__smtpVeBound = true;
        injectEditorStyles(doc);
        sanitizeMailRegionRows(doc);
        doc.addEventListener('click', function (e) {
            var t = e.target;
            if (t && t.nodeType === 3) t = t.parentElement;
            if (!t || !t.closest) return;
            var regionRoot = resolveRegionRoot(t);
            if (!regionRoot) {
                clearActiveSelection();
                return;
            }
            e.preventDefault();
            e.stopPropagation();
            var info = pickStyleTarget(t, regionRoot);
            if (info && info.el) showSelection(info);
            else clearActiveSelection();
        });
        doc.addEventListener('beforeinput', function (e) {
            if (selectedIsVar) e.preventDefault();
        });
        doc.addEventListener('input', function () {
            if (selectedIsVar) return;
            syncFormFields(false);
        });
        doc.addEventListener('scroll', function () {
            positionFloatingToolbar();
        }, true);
        setActiveRegion(activeRegion);
        return true;
    }

    function renderVisualEditor(bodyHtml) {
        if (!frame) return;
        var html = buildMailHtml(bodyHtml || initialBody);
        var doc = frame.contentDocument;
        if (!doc) return;
        try { doc.__smtpVeBound = false; } catch (e) {}
        doc.open();
        doc.write(html);
        doc.close();
        editorReady = false;
        try {
            var after = getIframeDoc();
            if (after) after.__smtpVeBound = false;
        } catch (e2) {}
        var tries = 0;
        (function waitDoc() {
            if (bindIframeEditor() || tries++ > 20) {
                editorReady = true;
                setActiveRegion(activeRegion);
                return;
            }
            setTimeout(waitDoc, 60);
        })();
    }

    function insertToken(token) {
        var doc = getIframeDoc();
        if (!doc) return;
        var region = null;
        if (selectedEl && selectedEl.closest) {
            region = selectedEl.closest('[data-weline-mail-region]');
        }
        if (!region) {
            var prefer = isAllRegionView() ? 'body' : activeRegion;
            region = doc.querySelector('[data-weline-mail-region="' + prefer + '"]');
        }
        if (!region) return;
        if (selectedEl && !selectedIsVar && region.contains(selectedEl)) {
            selectedEl.focus();
            try { doc.execCommand('insertText', false, token); } catch (e) { selectedEl.innerHTML += token; }
        } else {
            region.innerHTML += token;
        }
        syncFormFields(false);
    }

    document.querySelectorAll('[data-var-code]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            insertToken('{' + '{var.' + (btn.getAttribute('data-var-code') || '') + '}}');
        });
    });
    document.querySelectorAll('.w-smtp-ve-region-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            setActiveRegion(tab.getAttribute('data-region') || 'body');
        });
    });

    var colorInput = document.getElementById('smtp-ve-color');
    var colorHexInput = document.getElementById('smtp-ve-color-hex');
    var bgInput = document.getElementById('smtp-ve-bg');
    var sizeSelect = document.getElementById('smtp-ve-font-size');
    var fontSelect = document.getElementById('smtp-ve-font-family');
    function onTextColorPicked(raw) {
        var hex = expandHex(raw) || '';
        if (!hex) return;
        if (colorInput) colorInput.value = hex;
        if (colorHexInput) colorHexInput.value = hex;
        applyStyle('color', hex);
    }
    if (colorInput) {
        colorInput.addEventListener('input', function () { onTextColorPicked(colorInput.value); });
        colorInput.addEventListener('change', function () { onTextColorPicked(colorInput.value); });
    }
    if (colorHexInput) {
        colorHexInput.addEventListener('change', function () { onTextColorPicked(colorHexInput.value); });
        colorHexInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                onTextColorPicked(colorHexInput.value);
            }
        });
    }
    if (bgInput) {
        bgInput.addEventListener('input', function () { applyStyle('backgroundColor', bgInput.value); });
        bgInput.addEventListener('change', function () { applyStyle('backgroundColor', bgInput.value); });
    }
    if (sizeSelect) sizeSelect.addEventListener('change', function () { applyStyle('fontSize', sizeSelect.value); });
    if (fontSelect) fontSelect.addEventListener('change', function () { applyStyle('fontFamily', fontSelect.value); });
    var alignLeft = document.getElementById('smtp-ve-align-left');
    var alignCenter = document.getElementById('smtp-ve-align-center');
    var alignRight = document.getElementById('smtp-ve-align-right');
    if (alignLeft) alignLeft.addEventListener('click', function () { applyStyle('textAlign', 'left'); });
    if (alignCenter) alignCenter.addEventListener('click', function () { applyStyle('textAlign', 'center'); });
    if (alignRight) alignRight.addEventListener('click', function () { applyStyle('textAlign', 'right'); });

    if (subjectEl) subjectEl.addEventListener('input', function () { syncFormFields(true); });
    var refreshBtn = document.getElementById('smtp-tpl-preview-refresh');
    if (refreshBtn) refreshBtn.addEventListener('click', function () { syncFormFields(true); });
    if (bodySource) {
        bodySource.addEventListener('input', function () {
            if (syncingFromVisual) return;
            initialBody = String(bodySource.value || '');
            if (bodyField) bodyField.value = initialBody;
            renderVisualEditor(initialBody);
        });
