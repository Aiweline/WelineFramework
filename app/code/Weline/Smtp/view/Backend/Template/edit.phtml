<?php
/** @var \Weline\Framework\View\Template $this */
$template = $this->getData('template');
$variables = $this->getData('variables') ?? [];
$locale = (string)($this->getData('locale') ?? 'zh_Hans_CN');
$selectedScope = (string)($this->getData('selected_scope') ?? 'default.default.default');
$channelMeta = $this->getData('channel_meta') ?? [];
$previewShellHtml = (string)($this->getData('preview_shell_html') ?? '');
$previewSamples = is_array($this->getData('preview_samples') ?? null) ? $this->getData('preview_samples') : [];
$h = static fn($v) => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$channel = (string)$template->getData('channel_code');
$templateId = (int)$template->getId();
$listingReturn = is_array($this->getData('listing_return') ?? null) ? $this->getData('listing_return') : [];
$returnQ = trim((string)($listingReturn['q'] ?? ''));
$returnLocales = trim((string)($listingReturn['locales'] ?? ''));
$returnFocusLocale = trim((string)($listingReturn['focus_locale'] ?? $locale));
$saveUrl = $this->getBackendUrl('smtp/backend/template/post-save');
$resetUrl = $this->getBackendUrl('smtp/backend/template/post-reset');
$copyUrl = $this->getBackendUrl('smtp/backend/template/post-copy');
$listingUrlParams = [
    'target_scope' => $selectedScope,
    'channel' => $channel,
];
if ($returnQ !== '') {
    $listingUrlParams['q'] = $returnQ;
}
if ($returnLocales !== '') {
    $listingUrlParams['locales'] = $returnLocales;
}
if ($returnFocusLocale !== '') {
    $listingUrlParams['focus_locale'] = $returnFocusLocale;
}
$listingUrl = $this->getBackendUrl('smtp/backend/template/listing', $listingUrlParams);
$bodyHtml = (string)$template->getData('body_html');
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
if (defined('JSON_INVALID_UTF8_SUBSTITUTE')) {
    $jsonFlags |= JSON_INVALID_UTF8_SUBSTITUTE;
}
$previewShellJson = json_encode($previewShellHtml, $jsonFlags);
$previewSamplesJson = json_encode($previewSamples, $jsonFlags);
if (!is_string($previewShellJson)) {
    $previewShellJson = '""';
}
if (!is_string($previewSamplesJson)) {
    $previewSamplesJson = '{}';
}

$varsContent = [];
$varsIdentity = [];
$varsTone = [];
foreach ($variables as $var) {
    $code = trim((string)($var['code'] ?? ''));
    if ($code === '') {
        continue;
    }
    if ($code === 'brand_display_name'
        || str_starts_with($code, 'site_')
        || str_starts_with($code, 'store_')
        || str_starts_with($code, 'channel_')
        || str_starts_with($code, 'contact_')
        || $code === 'service_hours'
    ) {
        $varsIdentity[] = $var;
    } elseif (str_starts_with($code, 'brand_')) {
        $varsTone[] = $var;
    } else {
        $varsContent[] = $var;
    }
}

$renderVarButtons = static function (array $list) use ($h): void {
    foreach ($list as $var) {
        $code = (string)$var['code'];
        echo '<button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm"'
            . ' data-var-code="' . $h($code) . '"'
            . ' data-testid="smtp-template-var-' . $h($code) . '">'
            . $h('{{var.' . $code . '}}')
            . ' <span class="w-text" data-tone="muted" data-size="sm">— ' . $h((string)($var['label'] ?? $code)) . '</span>'
            . '</button>';
    }
};
