    // 高级区仅为纯 textarea，展开时把可视化正文灌入源码，避免两套内容漂移
    var advancedPanel = document.querySelector('[data-testid="smtp-template-advanced"]');
    if (advancedPanel) {
        advancedPanel.addEventListener('toggle', function () {
            if (!advancedPanel.open || !bodySource) return;
            var html = normalizeEmailBody(readBodyFromIframe() || initialBody);
            initialBody = html;
