    window.addEventListener('resize', function () { positionFloatingToolbar(); });
    window.addEventListener('scroll', function () { positionFloatingToolbar(); }, true);
    document.addEventListener('mousedown', function (e) {
        if (!toolbar || toolbar.hidden) return;
        var t = e.target;
        if (!t) return;
        if (toolbar.contains(t)) return;
        if (frame && (t === frame || frame.contains(t))) return;
        clearActiveSelection();
    }, true);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && toolbar && !toolbar.hidden) {
