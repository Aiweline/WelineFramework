<!DOCTYPE html>
<html lang="<?= $this->getLang() ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= $title ?> - Weline Framework</title>
    <style>
        :root {
            --bg-color: var(--color-header-bg);
            --card-bg: var(--color-header-bg-hover);
            --text-color: var(--color-info-soft);
            --text-muted: #94a3b8;
            --border-color: #334155;
            --warning-color: var(--color-warning);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--bg-color) 0%, var(--color-info) 100%);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .card {
            background: var(--card-bg);
            border: var(--border-width-thin) solid var(--border-color);
            border-radius: var(--border-radius-2xl);
            padding: var(--weline-space-12);
            max-width: 500px;
            text-align: center;
        }
        
        .icon {
            width: 80px;
            height: 80px;
            background: var(--color-warning-bg-subtle);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--weline-space-6);
            font-size: var(--weline-font-size-4xl);
        }
        
        h1 {
            font-size: var(--weline-font-size-2xl);
            margin-bottom: var(--weline-space-4);
            color: var(--warning-color);
        }
        
        p {
            color: var(--text-muted);
            line-height: 1.6;
        }
        
        .btn {
            display: inline-block;
            margin-top: var(--weline-space-6);
            padding: var(--weline-space-3) var(--weline-space-6);
            background: var(--color-info);
            color: white;
            text-decoration: none;
            border-radius: var(--border-radius-lg);
            transition: background 0.3s;
        }
        
        .btn:hover {
            background: var(--color-info);
        }
    </style>
</head>
<body>
    <div class="w-card">
        <div class="icon">🔒</div>
        <h1><?= $title ?></h1>
        <p><?= $message ?></p>
        <a href="@url{'/'}" class="w-button"><lang>返回首页</lang></a>
    </div>
</body>
</html>
