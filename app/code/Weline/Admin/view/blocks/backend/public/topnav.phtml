<?php
/** @var \Weline\Admin\Block\Backend\Page\Topnav $this */
$menus = is_iterable($this->getData('menus')) ? $this->getData('menus') : ($menus ?? []);
$request = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Http\Request::class);
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$menuUrl = static function (array $item) use ($request): string {
    $route = ltrim(trim((string)($item['route'] ?? '')), '/');
    $prefix = !array_key_exists('is_backend', $item) || (bool)$item['is_backend']
        ? rtrim($request->getUrlBuilder()->getBackendUrl('/'), '/')
        : '';
    return $route === '' ? '#' : $prefix . '/' . $route;
};
$renderItems = function (iterable $items, int $depth = 0) use (&$renderItems, $escape, $menuUrl): void {
    foreach ($items as $item) {
        if (!is_array($item)) continue;
        $children = is_array($item['nodes'] ?? null) ? $item['nodes'] : [];
        $name = trim((string)($item['source_name'] ?? ''));
        if ($name === '') continue;
        $sourceId = trim((string)($item['source_id'] ?? ''));
        $triggerId = 'w-topnav-' . substr(hash('sha256', $sourceId !== '' ? $sourceId : $name . '-' . $depth), 0, 12);
        $icon = trim((string)($item['icon'] ?? '')) ?: 'circle';
        if ($children === []) {
            echo '<li><a class="w-menu__item" href="' . $escape($menuUrl($item)) . '" role="menuitem"><w-icon name="' . $escape($icon) . '" size="sm"></w-icon><span>' . $escape($name) . '</span></a></li>';
            continue;
        }
        echo '<li class="w-menu-root" data-w-component="menu">';
        echo '<button class="w-button" type="button" data-tone="quiet" id="' . $escape($triggerId) . '" data-w-menu-trigger aria-haspopup="menu" aria-expanded="false"><w-icon name="' . $escape($icon) . '" size="sm"></w-icon><span>' . $escape($name) . '</span><w-icon name="chevron-down" size="sm"></w-icon></button>';
        echo '<ul class="w-menu" data-w-menu-panel role="menu" aria-labelledby="' . $escape($triggerId) . '" hidden>';
        $renderItems($children, $depth + 1);
        echo '</ul></li>';
    }
};
?>
<nav class="w-topnav" aria-label="<?= $escape(__('后台快捷导航')) ?>">
    <div class="w-container">
        <ul class="w-cluster" role="menubar"><?php $renderItems($menus); ?></ul>
    </div>
</nav>
