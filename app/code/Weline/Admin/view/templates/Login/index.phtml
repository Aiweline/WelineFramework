<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Backend\Api\View\BackendThemeConfigInterface;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Session\Session;

$siteName = (string)($this->getData('login_site_name') ?: 'Weline');
$siteDescription = trim((string)$this->getData('login_site_description'));
$defaultLogo = (string)(
    $this->fetchTagSourceFile('statics', 'Weline_Theme::theme/backend/assets/images/theme/logo.png')
    ?: '/Weline/Theme/view/theme/backend/assets/images/theme/logo.png'
);
$logo = (string)($this->getData('login_logo_dark') ?: $this->getData('login_logo_light') ?: $defaultLogo);
$background = trim((string)$this->getData('login_bg_url'));
$postUrl = (string)$this->getData('post_url');
$returnUrl = (string)$this->getData('return_url');
$needCode = (bool)$this->getData('need_backend_verification_code');
$codeUrl = (string)$this->getData('backend_verification_code_url');
$session = ObjectManager::getInstance(Session::class);
$locked = (bool)$session->getData('backend_disable_login');
$remember = (bool)$session->getData('remember_expire_time');
$themeConfig = ObjectManager::getInstance(BackendThemeConfigInterface::class);
$plainMessage = static function (mixed $message): string {
    return trim(html_entity_decode(strip_tags((string)$message), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
};
$noAccessMessage = $plainMessage($this->getData('no_access_message'));
$flashMessage = $plainMessage($this->getData('login_flash_message'));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" data-local="{{lang_local}}" data-lang="{{lang}}" <?= $themeConfig->getThemeHtmlAttributes() ?>>
<head>
    <w:template>Weline_Admin::templates/Login/head.phtml</w:template>
</head>
<body>
    <main class="w-login-shell">
        <?php if ($background !== ''): ?>
            <img class="w-login-shell__background" src="<?= htmlspecialchars($background, ENT_QUOTES, 'UTF-8') ?>" alt="">
        <?php endif; ?>
        <section class="w-card w-login-card" aria-labelledby="w-login-title">
            <div class="w-card__body w-login-card__body">
                <header class="w-login-header">
                    <img
                        class="w-login-logo"
                        src="<?= htmlspecialchars($logo, ENT_QUOTES, 'UTF-8') ?>"
                        data-fallback-src="<?= htmlspecialchars($defaultLogo, ENT_QUOTES, 'UTF-8') ?>"
                        data-w-login-logo
                        alt="<?= htmlspecialchars($siteName, ENT_QUOTES, 'UTF-8') ?>"
                    >
                    <div class="w-stack" data-w-gap="sm">
                        <p class="w-login-eyebrow"><?= htmlspecialchars((string)__('安全管理入口'), ENT_QUOTES, 'UTF-8') ?></p>
                        <h1 id="w-login-title"><?= htmlspecialchars((string)__('登录 %{name} 管理面板', ['name' => $siteName]), ENT_QUOTES, 'UTF-8') ?></h1>
                        <?php if ($siteDescription !== ''): ?><p class="w-login-description"><?= htmlspecialchars($siteDescription, ENT_QUOTES, 'UTF-8') ?></p><?php endif; ?>
                    </div>
                </header>

                <?php if ($noAccessMessage !== '' || $flashMessage !== ''): ?>
                    <div class="w-stack" role="alert">
                        <?php if ($noAccessMessage !== ''): ?><div class="w-alert" data-tone="warning"><w:icon name="warning" /><span><?= htmlspecialchars($noAccessMessage, ENT_QUOTES, 'UTF-8') ?></span></div><?php endif; ?>
                        <?php if ($flashMessage !== ''): ?><div class="w-alert" data-tone="danger"><w:icon name="warning" /><span><?= htmlspecialchars($flashMessage, ENT_QUOTES, 'UTF-8') ?></span></div><?php endif; ?>
                    </div>
                <?php endif; ?>

                <w:hook name="Weline_Admin::backend::partials::login::providers"/>

                <form class="w-form" action="<?= htmlspecialchars($postUrl, ENT_QUOTES, 'UTF-8') ?>" method="post" data-w-login-form>
                    <?= $this->getFormKey($postUrl) ?>
                    <?php if ($returnUrl !== ''): ?><input type="hidden" name="return_url" value="<?= htmlspecialchars($returnUrl, ENT_QUOTES, 'UTF-8') ?>"><?php endif; ?>

                    <div class="w-field">
                        <label class="w-field__label" for="w-login-username"><?= htmlspecialchars((string)__('管理员'), ENT_QUOTES, 'UTF-8') ?></label>
                        <input id="w-login-username" class="w-input" type="text" name="username" autocomplete="username" required autofocus placeholder="<?= htmlspecialchars((string)__('请输入管理员账号'), ENT_QUOTES, 'UTF-8') ?>">
                    </div>

                    <div class="w-field">
                        <label class="w-field__label" for="w-login-password"><?= htmlspecialchars((string)__('密码'), ENT_QUOTES, 'UTF-8') ?></label>
                        <input id="w-login-password" class="w-input" type="password" name="password" autocomplete="current-password" required placeholder="<?= htmlspecialchars((string)__('请输入密码'), ENT_QUOTES, 'UTF-8') ?>">
                    </div>

                    <?php if ($needCode): ?>
                        <div class="w-field">
                            <label class="w-field__label" for="w-login-code"><?= htmlspecialchars((string)__('验证码'), ENT_QUOTES, 'UTF-8') ?></label>
                            <div class="w-login-verification">
                                <input id="w-login-code" class="w-input" type="text" name="code" autocomplete="one-time-code" required placeholder="<?= htmlspecialchars((string)__('请输入验证码'), ENT_QUOTES, 'UTF-8') ?>">
                                <button class="w-login-verification__refresh" type="button" data-w-captcha-refresh aria-label="<?= htmlspecialchars((string)__('刷新验证码'), ENT_QUOTES, 'UTF-8') ?>">
                                    <img src="<?= htmlspecialchars($codeUrl, ENT_QUOTES, 'UTF-8') ?>?t=<?= time() ?>" data-base-src="<?= htmlspecialchars($codeUrl, ENT_QUOTES, 'UTF-8') ?>" data-w-captcha-image alt="<?= htmlspecialchars((string)__('验证码'), ENT_QUOTES, 'UTF-8') ?>">
                                </button>
                            </div>
                        </div>
                    <?php endif; ?>

                    <label class="w-check" for="w-login-remember">
                        <input id="w-login-remember" type="checkbox" name="remember" <?= $remember ? 'checked' : '' ?>>
                        <span><?= htmlspecialchars((string)__('在受信任设备上记住我'), ENT_QUOTES, 'UTF-8') ?></span>
                    </label>

                    <button class="w-button" data-size="lg" type="submit" data-w-login-submit <?= $locked ? 'disabled aria-disabled="true"' : '' ?>>
                        <span data-w-login-label><?= htmlspecialchars((string)__('登录'), ENT_QUOTES, 'UTF-8') ?></span>
                        <span data-w-login-progress hidden><span class="w-spinner" aria-hidden="true"></span> <?= htmlspecialchars((string)__('登录中…'), ENT_QUOTES, 'UTF-8') ?></span>
                    </button>
                </form>
            </div>
            <footer class="w-card__footer w-login-footer">
                <small>&copy; <?= date('Y') ?> Weline</small>
                <a href="https://www.aiweline.com/">aiweline.com</a>
            </footer>
        </section>
    </main>
</body>
</html>
