<?php
/** @var \Weline\Framework\View\Template $this */

$loginSiteName = (string)($this->getData('login_site_name') ?: 'Weline');
$themeConfig = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Backend\Api\View\BackendThemeConfigInterface::class);
$themeModel = (string)$themeConfig->getThemeModel();
$themeCssSuffix = $themeModel !== '' ? '-' . $themeModel : '';
$backendThemePreference = (string)$themeConfig->getOriginThemeConfig('theme-mode-switch');
if (!in_array($backendThemePreference, ['system', 'light', 'dark'], true)) {
    $backendThemePreference = 'system';
}
$isDev = defined('DEV') && DEV;
$themeAssetBaseUrl = $isDev ? '/Weline/Theme/view/theme/' : '/static/Weline/Theme/theme/';
$themeAssetVersion = '20260810-color-mode';
$currentLang = (string)(\Weline\Framework\App\State::getLang() ?: 'zh_Hans_CN');
$currentCurrency = (string)(\Weline\Framework\App\State::getCurrency() ?: 'CNY');
$defaultCurrency = \w_env('website.currency', '') ?: \Weline\Framework\App\Env::get('currency', 'CNY') ?: 'CNY';
$availableCurrencies = [];
try {
    if (class_exists(\Weline\Websites\Data\WebsiteData::class)) {
        foreach (\Weline\Websites\Data\WebsiteData::getCurrencyCodes() as $currencyCode) {
            $currencyCode = strtoupper(trim((string)$currencyCode));
            if ($currencyCode !== '') {
                $availableCurrencies[] = $currencyCode;
            }
        }
    }
} catch (\Throwable) {
    $availableCurrencies = [];
}
$defaultCurrency = strtoupper(trim((string)$defaultCurrency)) ?: 'CNY';
$availableCurrencies[] = $defaultCurrency;
$availableCurrencies = array_values(array_unique($availableCurrencies));
$currentCurrency = strtoupper(trim((string)$currentCurrency));
if (!\Weline\Framework\App\State::isAllowedCurrencyCode($currentCurrency)) {
    $currentCurrency = $defaultCurrency;
}
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;
?>
<base href="@backend-url('/')">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
<meta name="description" content="<?= htmlspecialchars((string)__('后台登录'), ENT_QUOTES, 'UTF-8') ?>">
<meta name="author" content="<?= htmlspecialchars($loginSiteName, ENT_QUOTES, 'UTF-8') ?>">
<title><?= htmlspecialchars((string)__('登录 %{name} 管理面板', ['name' => $loginSiteName]), ENT_QUOTES, 'UTF-8') ?></title>
<link rel="Shortcut Icon" href="@static(Weline_Backend::img/favicon.png)">
<link rel="Bookmark" href="@static(Weline_Backend::img/favicon.png)">
<link rel="icon" type="image/png" sizes="128x128" href="@static(Weline_Backend::img/favicon.png)">
<script data-no-extract="true">
    (function(root, preference) {
        var media = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
        var apply = function () {
            var current = preference === 'dark' || (preference === 'system' && media && media.matches) ? 'dark' : 'light';
            root.setAttribute('data-theme-preference', preference);
            root.setAttribute('data-theme', current);
            root.setAttribute('data-bs-theme', current);
            root.setAttribute('data-theme-mode', current);
            root.setAttribute('data-layout-mode', current);
            root.style.colorScheme = current;
        };
        apply();
        if (preference === 'system' && media) {
            if (typeof media.addEventListener === 'function') media.addEventListener('change', apply);
            else if (typeof media.addListener === 'function') media.addListener(apply);
        }
    })(document.documentElement, <?= json_encode($backendThemePreference, $jsonForScriptFlags) ?>);
</script>
<link href="<?= $this->fetchTagSourceFile('statics', 'Weline_Admin::assets/css/bootstrap' . $themeCssSuffix . '.min.css') ?>" rel="stylesheet" type="text/css">
<css>Weline_Admin::assets/css/icons.min.css</css>
<link href="<?= $this->fetchTagSourceFile('statics', 'Weline_Admin::assets/css/app' . $themeCssSuffix . '.min.css') ?>" rel="stylesheet" type="text/css">
<!-- Canonical token foundation: a design theme may overlay palettes only. -->
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/variables/_colors.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/variables/_typography.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/variables/_spacing.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/variables/_borders.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/variables/_shadows.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/colors/_light.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<theme:css>Weline_Theme::theme/backend/colors/_light.css</theme:css>
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/colors/_dark.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<theme:css>Weline_Theme::theme/backend/colors/_dark.css</theme:css>
<link href="<?= htmlspecialchars($themeAssetBaseUrl . 'backend/assets/css/theme.css?v=' . $themeAssetVersion, ENT_QUOTES, 'UTF-8') ?>" rel="stylesheet" type="text/css">
<script data-no-extract="true">
window.__WelineLoginConfig = <?= json_encode([
    'currentLang' => $currentLang,
    'currentCurrency' => $currentCurrency,
    'defaultCurrency' => $defaultCurrency,
    'availableCurrencies' => $availableCurrencies,
    'themeMode' => $themeModel === '' ? 'light' : $themeModel,
], $jsonForScriptFlags) ?>;
</script>
