(function() { 'use strict'; var config = { apiSave: '<?= $this->getBackendUrl("*/backend/user/api-save") ?>', apiDelete: '<?= $this->getBackendUrl("*/backend/user/api-delete") ?>', apiToggle: '<?= $this->getBackendUrl("*/backend/user/api-toggle") ?>', text: { addTitle: '<?= addslashes(__("新增管理员")) ?>', editTitle: '<?= addslashes(__("编辑管理员")) ?>', saveSuccess: '<?= addslashes(__("保存成功")) ?>', saveFail: '<?= addslashes(__("保存失败")) ?>', deleteConfirm: '<?= addslashes(__("确定要删除用户「%{1}」吗？此操作不可恢复。")) ?>', deleteSuccess: '<?= addslashes(__("删除成功")) ?>', deleteFail: '<?= addslashes(__("删除失败")) ?>', enableConfirm: '<?= addslashes(__("确定要激活此用户吗？")) ?>', disableConfirm: '<?= addslashes(__("确定要禁用此用户吗？禁用后该用户将无法登录。")) ?>', toggleSuccess: '<?= addslashes(__("操作成功")) ?>', toggleFail: '<?= addslashes(__("操作失败")) ?>', networkError: '<?= addslashes(__("网络错误，请检查网络后重试")) ?>', validationError: '<?= addslashes(__("请填写必填项")) ?>' } }; var offcanvasEl = document.getElementById('welineUserOffcanvas'); var offcanvas = null; var form = document.getElementById('welineUserForm'); var isEditMode = false; function initOffcanvas() { offcanvas = offcanvasEl; } function openOffcanvas(mode, userData) { isEditMode = mode === 'edit'; var title = isEditMode ? config.text.editTitle : config.text.addTitle; document.getElementById('welineUserOffcanvasTitle').textContent = title; form.reset(); form.classList.remove('w-form--validated'); if (isEditMode && userData) { document.getElementById('weline-user-id').value = userData.userId; document.getElementById('weline-user-username').value = userData.username; document.getElementById('weline-user-email').value = userData.email; document.getElementById('weline-user-password').removeAttribute('required'); document.querySelector('.weline-password-required').style.display = 'none'; document.querySelector('.weline-password-hint').style.display = 'block'; } else { document.getElementById('weline-user-id').value = ''; document.getElementById('weline-user-password').setAttribute('required', ''); document.querySelector('.weline-password-required').style.display = 'inline'; document.querySelector('.weline-password-hint').style.display = 'none'; } if (offcanvas) { Weline.UI.drawer.open(offcanvas); } } function closeOffcanvas() { if (offcanvas) { Weline.UI.drawer.close(offcanvas, 'action'); } } function setLoading(loading) { var btn = document.getElementById('weline-user-submit'); btn.disabled = loading; btn.querySelector('.weline-submit-text').classList.toggle('d-none', loading); btn.querySelector('.weline-submit-loading').classList.toggle('d-none', !loading); } function normalizeApiResult(res) { if (!res || typeof res !== 'object') { return res; } if (Object.prototype.hasOwnProperty.call(res, 'success') || Object.prototype.hasOwnProperty.call(res, 'code') || Object.prototype.hasOwnProperty.call(res, 'msg') || Object.prototype.hasOwnProperty.call(res, 'message')) { return res; } if (Object.prototype.hasOwnProperty.call(res, 'data')) { return res.data; } return res; } function apiErrorMessage(error, fallback) { var response = error && error.response ? error.response : null; var data = response && response.data !== undefined ? normalizeApiResult(response.data) : null; if (data && typeof data === 'object') { return data.msg || data.message || (data.error && data.error.message) || fallback; } if (typeof data === 'string' && data.trim()) { return data; } if (response && response.status > 0 && error && error.message) { return error.message; } return config.text.networkError + (error && error.message ? ': ' + error.message : ''); } function handleSave(e) { e.preventDefault(); if (!form.checkValidity()) { form.classList.add('w-form--validated'); Weline.UI.toast.warning(config.text.validationError); return; } setLoading(true); var formData = new FormData(form); var data = {}; formData.forEach(function(value, key) { data[key] = value; }); var url = config.apiSave; var opts = { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(data) }; Weline.adminRequest('admin', url, opts) .then(function(res) { var result = normalizeApiResult(res); setLoading(false); if (result.success) { Weline.UI.toast.success(result.msg || config.text.saveSuccess); closeOffcanvas(); setTimeout(function() { location.reload(); }, 800); } else { Weline.UI.toast.error(result.msg || config.text.saveFail); } }) .catch(function(error) { setLoading(false); Weline.UI.toast.error(apiErrorMessage(error, config.text.saveFail)); }); } function handleDelete(userId, username) { var message = config.text.deleteConfirm.replace('%{1}', username); Weline.UI.dialog.confirm(message, { title: '<?= addslashes(__("确认删除")) ?>', confirmLabel: '<?= addslashes(__("删除")) ?>', cancelLabel: '<?= addslashes(__("取消")) ?>', tone: 'danger' }).then(function(confirmed) { if (!confirmed) return; var url = config.apiDelete; var opts = { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ id: userId }) }; Weline.adminRequest('admin', url, opts) .then(function(res) { var result = normalizeApiResult(res); if (result.success) { Weline.UI.toast.success(result.msg || config.text.deleteSuccess); setTimeout(function() { location.reload(); }, 800); } else { Weline.UI.toast.error(result.msg || config.text.deleteFail); } }) .catch(function(error) { Weline.UI.toast.error(apiErrorMessage(error, config.text.deleteFail)); }); }); } function handleToggle(userId, action) { var message = action === 'enable' ? config.text.enableConfirm : config.text.disableConfirm; var type = action === 'enable' ? 'info' : 'warning'; Weline.UI.dialog.confirm(message, { title: action === 'enable' ? '<?= addslashes(__("激活用户")) ?>' : '<?= addslashes(__("禁用用户")) ?>', confirmLabel: '<?= addslashes(__("确定")) ?>', cancelLabel: '<?= addslashes(__("取消")) ?>', tone: type }).then(function(confirmed) { if (!confirmed) return; var url = config.apiToggle; var opts = { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ id: userId, action: action }) }; Weline.adminRequest('admin', url, opts) .then(function(res) { var result = normalizeApiResult(res); if (result.success) { Weline.UI.toast.success(result.msg || config.text.toggleSuccess); setTimeout(function() { location.reload(); }, 800); } else { Weline.UI.toast.error(result.msg || config.text.toggleFail); } }) .catch(function(error) { Weline.UI.toast.error(apiErrorMessage(error, config.text.toggleFail)); }); }); } function togglePasswordVisibility(btn) { var input = btn.closest('.w-field__control').querySelector('input'); var icon = btn.querySelector('w\\:icon, [data-w-icon], .w-icon'); if (!input) { return; } if (input.type === 'password') { input.type = 'text'; if (icon) { icon.setAttribute('name', 'eye-off'); } } else { input.type = 'password'; if (icon) { icon.setAttribute('name', 'eye'); } } } function init() { initOffcanvas(); var addBtn = document.getElementById('weline-user-add-btn'); if (addBtn) { addBtn.addEventListener('click', function() { openOffcanvas('add'); }); } document.querySelectorAll('.weline-user-edit-btn').forEach(function(btn) { btn.addEventListener('click', function() { openOffcanvas('edit', { userId: this.dataset.userId, username: this.dataset.username, email: this.dataset.email }); }); }); document.querySelectorAll('.weline-user-delete-btn').forEach(function(btn) { btn.addEventListener('click', function() { handleDelete(this.dataset.userId, this.dataset.username); }); }); document.querySelectorAll('.weline-user-toggle-btn').forEach(function(btn) { btn.addEventListener('click', function() { handleToggle(this.dataset.userId, this.dataset.action); }); }); document.querySelectorAll('.weline-toggle-password').forEach(function(btn) { btn.addEventListener('click', function() { togglePasswordVisibility(this); }); }); form.addEventListener('submit', handleSave); } if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
