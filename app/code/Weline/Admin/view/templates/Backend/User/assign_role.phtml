<script>
(function(g){
  if(g.__bqAdmin_admin) return;
  g.__bqAdmin_admin=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['admin']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('admin').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
(function() {
    'use strict';

    var config = {
        apiAssign: '<?= $this->getBackendUrl("*/backend/user/api-assign-role") ?>',
        text: {
            assignSuccess: '<?= addslashes(__("角色分配成功")) ?>',
            assignFail: '<?= addslashes(__("角色分配失败")) ?>',
            networkError: '<?= addslashes(__("网络错误，请检查网络后重试")) ?>',
            cannotAssignSelf: '<?= addslashes(__("不能修改自己的角色")) ?>'
        }
    };

    function showSaving(selector) {
        selector.querySelector('.weline-role-saving').classList.remove('d-none');
        selector.querySelector('.weline-role-saved').classList.add('d-none');
        selector.closest('tr').classList.add('is-saving');
    }

    function showSaved(selector) {
        selector.querySelector('.weline-role-saving').classList.add('d-none');
        selector.querySelector('.weline-role-saved').classList.remove('d-none');
        selector.closest('tr').classList.remove('is-saving');
        
        setTimeout(function() {
            selector.querySelector('.weline-role-saved').classList.add('d-none');
        }, 2000);
    }

    function hideSaving(selector) {
        selector.querySelector('.weline-role-saving').classList.add('d-none');
        selector.closest('tr').classList.remove('is-saving');
    }

    function handleRoleChange(e) {
        var select = e.target;
        var userId = select.dataset.userId;
        var roleId = select.value;
        var selector = select.closest('.weline-role-selector');
        
        showSaving(selector);
        
        var url = config.apiAssign;
        var opts = { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ user_id: userId, role_id: roleId }) };
        bqAdmin['admin'](url, opts)
        .then(function(res) {
            var result = (res && res.data) !== undefined ? res.data : res;
            if (result.success) {
                showSaved(selector);
                Weline.UI.toast.success(result.msg || config.text.assignSuccess);
                
                var row = select.closest('tr');
                var statusCell = row.querySelector('.weline-assign-status');
                if (statusCell) {
                    var assignedBadge = statusCell.querySelector('.weline-status-assigned');
                    var unassignedBadge = statusCell.querySelector('.weline-status-unassigned');
                    if (roleId) {
                        assignedBadge.style.display = 'inline-block';
                        unassignedBadge.style.display = 'none';
                    } else {
                        assignedBadge.style.display = 'none';
                        unassignedBadge.style.display = 'inline-block';
                    }
                }
                
                selector.dataset.currentRole = roleId;
            } else {
                hideSaving(selector);
                Weline.UI.toast.error(result.msg || config.text.assignFail);
                
                var originalRole = selector.dataset.currentRole || '';
                select.value = originalRole;
            }
        })
        .catch(function(error) {
            hideSaving(selector);
            Weline.UI.toast.error(config.text.networkError + (error.message ? ': ' + error.message : ''));
            
            var originalRole = selector.dataset.currentRole || '';
            select.value = originalRole;
        });
    }

    function init() {
        document.querySelectorAll('.weline-role-select').forEach(function(select) {
            select.addEventListener('change', handleRoleChange);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
