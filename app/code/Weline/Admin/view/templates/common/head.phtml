<?php
/** @var \Weline\Framework\View\Template $this */
$headTitle = trim((string)($this->getData('title') ?? ''));
$meta = $this->getData('meta');
if (is_array($meta)) {
    $controllerTitle = trim((string)($meta['controller_title'] ?? ''));
    $metaTitle = trim((string)($meta['title'] ?? $meta['meta_title'] ?? ''));
    $preferred = $controllerTitle !== '' ? $controllerTitle : $metaTitle;
    $moduleTitle = trim((string)$this->getRequest()->getModuleName());
    // init()/ob_file 可能把 title 重置成模块名；优先用控制器写入的 meta 标题。
    if ($preferred !== '' && ($headTitle === '' || ($moduleTitle !== '' && $headTitle === $moduleTitle))) {
        $headTitle = $preferred;
    }
}
$headTitle = $headTitle !== '' ? $headTitle : (string)__('Weline 管理后台');
$headDescription = trim((string)($this->getData('description') ?? '')) ?: (string)__('Weline 管理后台');
?>
<base href="@backend-url('/')">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="<?= htmlspecialchars($headDescription, ENT_QUOTES, 'UTF-8') ?>">
<meta name="author" content="Weline">
<title><?= htmlspecialchars($headTitle, ENT_QUOTES, 'UTF-8') ?></title>
<template>Weline_Theme::partials/head/site-favicon.phtml</template>
<w:block class="Weline\Backend\Block\Header\Base" template="Weline_Admin::header/base.phtml"/>
<?php if ($this->getHeader()): ?>
    <?= $this->getHeader()->getHtml() ?>
<?php endif; ?>
