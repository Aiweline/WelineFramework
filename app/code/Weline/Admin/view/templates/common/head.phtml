<!-- Live Preview postMessage listener for Visual Editor -->
<script data-no-extract="true">
(function() {
    'use strict';
    // 监听来自Visual Editor的postMessage (Live Preview支持)
    window.addEventListener('message', function(event) {
        if (event.origin !== window.location.origin || !event.data || event.data.type !== 'WELINE_THEME_UPDATE') {
            return;
        }
        var cssVars = event.data.cssVars || {};
        var root = document.documentElement;
        for (var varName in cssVars) {
            var value = cssVars[varName];
            if (
                Object.prototype.hasOwnProperty.call(cssVars, varName)
                && /^--[A-Za-z0-9_-]+$/.test(varName)
                && (typeof value === 'string' || typeof value === 'number')
                && String(value).length > 0
                && String(value).length <= 1024
                && !/[;{}<>\\]/.test(String(value))
            ) {
                root.style.setProperty(varName, String(value));
            }
        }
        console.log('[Theme] Live preview updated:', Object.keys(cssVars).length, 'variables');
    });
})();
</script>
