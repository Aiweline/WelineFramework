$logo = $siteBrand->resolveMediaUrl('logo_sm', 40, 40);
if ($logo === '') {
    $logo = $siteBrand->resolveBackendLogoUrl($this, 'logo_dark', 40, 40);
}
$menus = $menuRenderService->getMenuTree();
?>
<aside
    id="w-backend-sidebar"
    class="w-backend-sidebar"
    data-w-component="drawer"
    data-state="closed"
    data-w-keep-mounted="true"
    data-w-responsive="desktop-persistent"
    aria-label="<?= htmlspecialchars((string)__('后台主导航'), ENT_QUOTES, 'UTF-8') ?>"
    tabindex="-1"
>
    <a class="w-backend-brand" href="<?= htmlspecialchars($this->getBackendUrl('admin'), ENT_QUOTES, 'UTF-8') ?>">
        <img class="w-backend-brand__logo" src="<?= htmlspecialchars($logo, ENT_QUOTES, 'UTF-8') ?>" alt="" width="40" height="40">
        <span>Weline</span>
    </a>

    <div class="w-backend-nav" data-w-component="nav-filter">
        <label class="w-visually-hidden" for="w-backend-nav-search"><?= htmlspecialchars((string)__('搜索菜单'), ENT_QUOTES, 'UTF-8') ?></label>
        <div class="w-backend-nav__search">
            <w:icon name="search" size="sm" />
            <input
                id="w-backend-nav-search"
                class="w-input"
                type="search"
                autocomplete="off"
                placeholder="<?= htmlspecialchars((string)__('搜索菜单…'), ENT_QUOTES, 'UTF-8') ?>"
                data-w-nav-filter-input
            >
        </div>
        <p class="w-backend-nav__empty" data-w-nav-filter-empty hidden><?= htmlspecialchars((string)__('没有匹配的菜单'), ENT_QUOTES, 'UTF-8') ?></p>
        <nav aria-label="<?= htmlspecialchars((string)__('后台菜单'), ENT_QUOTES, 'UTF-8') ?>">
            <ul class="w-backend-nav__list" data-w-nav-filter-list>
                <?= $menuRenderService->renderMenu($menus) ?>
            </ul>
        </nav>
    </div>
</aside>
