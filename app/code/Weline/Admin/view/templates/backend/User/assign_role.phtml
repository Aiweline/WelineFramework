<?php
/**
 * 管理员角色分配页面（内容模板）
 *
 * 直接在表格内选择角色并异步保存，无需独立提交按钮。
 *
 * @var \Weline\Framework\View\Template $this
 */
?>
<div class="w-stack"
     data-weline-load="adminRoleAssign"
     data-role-assign
     data-api-assign="@backend-url{'*/backend/user/api-assign-role'}"
     data-text-assign-success="<?= htmlspecialchars(__('角色分配成功')) ?>"
     data-text-assign-fail="<?= htmlspecialchars(__('角色分配失败')) ?>"
     data-text-network-error="<?= htmlspecialchars(__('网络错误，请检查网络后重试')) ?>">

    <section class="w-card">
        <div class="w-card__body">
            <div class="w-toolbar">
                <div class="w-cluster" data-grow="true">
                    <block class='Weline\Component\Block\Form\Search' id='assign-role-search' action='*/backend/user/assign-role' method='get' keyword='search' value='' params='' placeholder='<?= htmlspecialchars(__('搜索用户名或邮箱')) ?>'></block>
                </div>
                <div class="w-cluster" data-grow="false">
                    <a class="w-button" href="@backend-url('*/backend/user/listing')" data-tone="neutral" data-variant="outline">
                        <w:icon name="arrow-left" size="sm"></w:icon><lang>返回列表</lang>
                    </a>
                </div>
            </div>

            <div class="w-alert" role="alert" data-tone="info">
                <w:icon name="info" size="sm"></w:icon>
                <span class="w-text" data-size="sm"><lang>选择角色后自动保存，无需手动提交。当前用户无法修改自己的角色。</lang></span>
                <button type="button" class="w-button" data-w-action="element.remove" data-w-close data-tone="quiet" data-size="sm"></button>
            </div>

            <div class="w-table-wrap">
                <table class="w-table">
                    <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col"><lang>用户信息</lang></th>
                        <th scope="col"><lang>当前角色</lang></th>
                        <th scope="col"><lang>状态</lang></th>
                    </tr>
                    </thead>
                    <tbody>
                    <foreach name="users" item="user" key="key">
                        <tr data-role-assign-row data-user-id="{{user.user_id}}">
                            <td class="w-text" data-tone="muted" data-size="sm">{{user.user_id}}</td>
                            <td>
                                <div class="w-cluster" data-align="center">
                                    <span data-w-avatar="true">
                                        <if condition="user.avatar">
                                            <img src="{{user.avatar}}" alt="{{user.username}}" width="40" height="40">
                                        <else/>
                                            <span data-w-avatar-content="true"><w:icon name="user" size="sm"></w:icon></span>
                                        </if>
                                    </span>
                                    <div class="w-stack" style="--w-gap:0;">
                                        <div class="w-text" data-weight="strong">{{user.username}}</div>
                                        <div class="w-text" data-tone="muted" data-size="sm">{{user.email}}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <if condition="user.user_id != current_user.user_id">
                                    <div class="w-cluster" data-role-selector
                                         data-user-id="{{user.user_id}}"
                                         data-current-role="{{user.role_id}}">
                                        <select class="w-select" data-role-select data-user-id="{{user.user_id}}"
                                                aria-label="<?= htmlspecialchars(__('当前角色')) ?>">
                                            <option value=""><lang>-- 未分配角色 --</lang></option>
                                            <foreach name="roles" item="role">
                                                <option value="{{role.role_id}}" <if condition="role.role_id == user.role_id">selected</if> >{{role.role_name}}</option>
                                            </foreach>
                                        </select>
                                        <span class="w-spinner" data-role-saving hidden></span>
                                        <span class="w-text" data-role-saved data-tone="success" hidden>
                                            <w:icon name="check" size="sm"></w:icon>
                                        </span>
                                    </div>
                                <else/>
                                    <div class="w-cluster">
                                        <span class="w-badge" data-w-background="primary">
                                            <w:icon name="user" size="sm"></w:icon>
                                            <if condition="user.role_name">{{user.role_name}}<else/><lang>未分配</lang></if>
                                        </span>
                                        <span class="w-text" data-tone="muted" data-size="sm"><lang>（当前登录）</lang></span>
                                    </div>
                                </if>
                            </td>
                            <td data-assign-status data-role-id="{{user.role_id}}">
                                <span class="w-badge" data-status-assigned data-w-background="success" style="display:<?= $user['role_id'] ? 'inline-flex' : 'none' ?>;"><lang>已分配</lang></span>
                                <span class="w-badge" data-status-unassigned data-w-background="warning" style="display:<?= $user['role_id'] ? 'none' : 'inline-flex' ?>;"><lang>未分配</lang></span>
                            </td>
                        </tr>
                    </foreach>
                    <empty name="users">
                        <tr>
                            <td colspan="4">
                                <div class="w-empty">
                                    <w:icon name="user" size="lg"></w:icon>
                                    <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                                        <p class="w-text" data-weight="strong"><lang>暂无管理员数据</lang></p>
                                        <p class="w-text" data-tone="muted"><lang>调整搜索条件后重试，或先在管理员列表新增用户。</lang></p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </empty>
                    </tbody>
                </table>
            </div>
            <var>pagination</var>
        </div>
    </section>
</div>
