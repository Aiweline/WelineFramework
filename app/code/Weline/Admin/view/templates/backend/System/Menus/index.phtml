<?php
/**
 * 菜单管理页面 - 树状管理（内容模板）
 *
 * @var \Weline\Framework\View\Template $this
 */
$menuTree = $this->getData('menuTree') ?? [];
$allMenus = $this->getData('allMenus') ?? [];
$search = $this->getData('search') ?? '';
$totalMenus = count($allMenus);
$systemMenus = count(array_filter($allMenus, static fn(array $menu): bool => !empty($menu['is_system'])));
$customMenus = $totalMenus - $systemMenus;
$rootMenus = count($menuTree);
$buildMenuTree = static function (array $items, int $depth = 0) use (&$buildMenuTree): string {
    $html = '<ul class="w-tree"' . ($depth > 0 ? ' data-menu-children hidden' : '') . '>';
    foreach ($items as $item) {
        $hasChildren = !empty($item['children']);
        $isSystem = !empty($item['is_system']);
        $isEnabled = $item['is_enable'] ?? 1;
        $rawMenuIcon = (string)($item['icon'] ?? 'menu');
        $menuIconName = preg_replace('/^(?:mdi\\s+mdi-|mdi-|fa[brs]?-|ri-)/i', '', $rawMenuIcon) ?: 'menu';
        $menuIconName = preg_replace('/[^a-z0-9_-]/i', '', $menuIconName) ?: 'menu';
        $title = (string)__($item['title'] ?? $item['name'] ?? '');
        $source = (string)($item['source'] ?? '');
        $rowId = (int)($item['menu_id'] ?? 0);
        $html .= '<li data-menu-item data-id="' . $rowId . '" data-source="' . htmlspecialchars($source) . '" data-state="closed">';
        $html .= '<div class="w-tree__row" data-menu-row>';
        if ($hasChildren) {
            $html .= '<button type="button" class="w-button" data-menu-toggle aria-expanded="false" data-tone="quiet" data-size="sm" data-icon-only="true" aria-label="' . htmlspecialchars(__('展开子菜单')) . '"><w-icon name="chevron-right"></w-icon></button>';
        } else {
            $html .= '<span class="w-icon" aria-hidden="true"></span>';
        }
        $html .= '<span class="w-badge" data-w-background="primary"><w-icon name="' . htmlspecialchars($menuIconName) . '"></w-icon></span>';
        $html .= '<div data-grow="true"><div class="w-cluster" style="--w-gap:var(--weline-space-2);">';
        $html .= '<span class="w-text" data-weight="medium">' . htmlspecialchars($title) . '</span>';
        $html .= '<span class="w-badge" data-w-background="muted" title="' . htmlspecialchars(__('菜单代码')) . '">' . htmlspecialchars($source) . '</span>';
        if ($hasChildren) {
            $html .= '<span class="w-text" data-tone="muted" data-size="sm">(' . count($item['children']) . ')</span>';
        }
        $html .= '</div><div class="w-cluster" style="--w-gap:var(--weline-space-3);">';
        $html .= '<span class="w-text" data-tone="muted" data-size="sm" title="' . htmlspecialchars(__('资源标识')) . '"><w-icon name="puzzle"></w-icon> ' . htmlspecialchars($source) . '</span>';
        $html .= '<span class="w-text" data-tone="muted" data-size="sm" title="' . htmlspecialchars(__('模块')) . '"><w-icon name="puzzle"></w-icon> ' . htmlspecialchars((string)($item['module'] ?? '')) . '</span>';
        $html .= '<span class="w-text" data-tone="muted" data-size="sm" title="' . htmlspecialchars(__('排序')) . '"><w-icon name="circle"></w-icon> ' . (int)($item['order'] ?? 0) . '</span>';
        $html .= '</div></div>';
        $html .= '<div class="w-cluster" data-grow="false">';
        $html .= $isSystem
            ? '<span class="w-badge" data-w-background="info">' . htmlspecialchars(__('系统')) . '</span>'
            : '<span class="w-badge" data-w-background="success">' . htmlspecialchars(__('自定义')) . '</span>';
        if (!$isEnabled) {
            $html .= '<span class="w-badge" data-w-background="danger">' . htmlspecialchars(__('禁用')) . '</span>';
        }
        $html .= '</div>';
        $html .= '<div class="w-cluster" data-grow="false">';
        $html .= '<button type="button" class="w-button" data-menu-edit data-id="' . $rowId . '" title="' . htmlspecialchars(__('编辑')) . '" data-tone="primary" data-variant="outline" data-size="sm" data-icon-only="true"><w-icon name="edit"></w-icon></button>';
        $html .= '<button type="button" class="w-button" data-menu-add-child data-parent-source="' . htmlspecialchars($source) . '" title="' . htmlspecialchars(__('添加子菜单')) . '" data-tone="success" data-variant="outline" data-size="sm" data-icon-only="true"><w-icon name="plus"></w-icon></button>';
        if (!$isSystem) {
            $html .= '<button type="button" class="w-button" data-menu-delete data-id="' . $rowId . '" data-name="' . htmlspecialchars($title) . '" title="' . htmlspecialchars(__('删除')) . '" data-tone="danger" data-variant="outline" data-size="sm" data-icon-only="true"><w-icon name="trash"></w-icon></button>';
        } else {
            $html .= '<button type="button" class="w-button" disabled title="' . htmlspecialchars(__('系统菜单无法删除')) . '" data-tone="neutral" data-variant="outline" data-size="sm" data-icon-only="true"><w-icon name="trash"></w-icon></button>';
        }
        $html .= '</div></div>';
        if ($hasChildren) {
            $html .= $buildMenuTree($item['children'], $depth + 1);
        }
        $html .= '</li>';
    }
    return $html . '</ul>';
};
$menuTreeHtml = $buildMenuTree($menuTree);
