<?php
/**
 * 路由管理页面（内容模板）
 *
 * @var \Weline\Framework\View\Template $this
 */
$routers = $this->getData('routers') ?: [];
$totalRoutes = 0;
$moduleCount = count($routers);
$getRoutes = 0;
$postRoutes = 0;
foreach ($routers as $module => $routes) {
    foreach ($routes as $path => $info) {
        $totalRoutes++;
        if (str_contains($path, '::GET') || !str_contains($path, '::')) {
            $getRoutes++;
        }
        if (str_contains($path, '::POST')) {
            $postRoutes++;
        }
    }
}
$stats = [
    ['icon' => 'circle', 'tone' => 'primary', 'value' => $totalRoutes, 'label' => __('路由总数')],
    ['icon' => 'box', 'tone' => 'success', 'value' => $moduleCount, 'label' => __('涉及模块')],
    ['icon' => 'eye', 'tone' => 'info', 'value' => $getRoutes, 'label' => __('GET 路由')],
    ['icon' => 'save', 'tone' => 'warning', 'value' => $postRoutes, 'label' => __('POST 路由')],
];
?>
<div class="w-stack"
     data-collector-browser
     data-weline-load="adminCollectorBrowser"
     data-collector-summary="<?= htmlspecialchars(__('找到') . ' %count% ' . __('条路由，来自') . ' %groups% ' . __('个模块')) ?>"
     data-collector-empty="<?= htmlspecialchars(__('没有匹配项')) ?>">

    <div class="w-auto-grid">
        <?php foreach ($stats as $stat): ?>
            <div class="w-card">
                <div class="w-card__body">
                    <div class="w-cluster" data-align="center">
                        <span class="w-badge" data-w-background="<?= htmlspecialchars($stat['tone']) ?>">
                            <w:icon name="<?= htmlspecialchars($stat['icon']) ?>" size="sm"></w:icon>
                        </span>
                        <div class="w-stack" style="--w-gap:0;">
                            <span class="w-text" data-size="lg" data-weight="strong"><?= (int)$stat['value'] ?></span>
                            <span class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$stat['label']) ?></span>
                        </div>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

