                                                data-method="<?= htmlspecialchars($methodUpper) ?>"
                                                data-module="<?= htmlspecialchars((string)$module) ?>"
                                                data-searchable="<?= htmlspecialchars(strtolower((string)$path . ' ' . ($classInfo['namespace'] ?? '') . ' ' . ($classInfo['controller_name'] ?? '') . ' ' . ($classInfo['method'] ?? ''))) ?>">
