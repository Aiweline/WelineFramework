                                                        <?php endif; ?>
                                                        <?php if (isset($classInfo['controller_name'])): ?>
                                                            <span class="w-text" data-size="sm"><span class="w-text" data-tone="muted" data-size="sm"><lang>控制器</lang>：</span><?= htmlspecialchars((string)$classInfo['controller_name']) ?></span>
                                                        <?php endif; ?>
                                                        <?php if (isset($classInfo['method'])): ?>
