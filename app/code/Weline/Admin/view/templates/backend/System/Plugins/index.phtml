<?php
/**
 * 插件管理页面（内容模板）
 *
 * @var \Weline\Framework\View\Template $this
 */
$plugins = $this->getData('plugins') ?: [];
$totalFiles = count($plugins);
$totalPlugins = 0;
$totalInterceptors = 0;
$enabledPlugins = 0;
$disabledPlugins = 0;
$moduleSet = [];
foreach ($plugins as $file => $pluginGroups) {
    foreach ($pluginGroups as $name => $instances) {
        $totalPlugins++;
        foreach ($instances as $instance) {
            $totalInterceptors++;
            $disabled = $instance['plugins']['disabled'] ?? 'false';
            if ($disabled === 'true' || $disabled === true || $disabled === '1') {
                $disabledPlugins++;
            } else {
                $enabledPlugins++;
            }
            if (!empty($instance['plugins']['module'])) {
                $moduleSet[$instance['plugins']['module']] = true;
            }
        }
    }
}
$moduleCount = count($moduleSet);
$stats = [
    ['icon' => 'file', 'tone' => 'primary', 'value' => $totalFiles, 'label' => __('配置文件')],
    ['icon' => 'puzzle', 'tone' => 'info', 'value' => $totalPlugins, 'label' => __('插件数')],
    ['icon' => 'check', 'tone' => 'success', 'value' => $enabledPlugins, 'label' => __('已启用')],
    ['icon' => 'close', 'tone' => 'danger', 'value' => $disabledPlugins, 'label' => __('已禁用')],
    ['icon' => 'box', 'tone' => 'warning', 'value' => $moduleCount, 'label' => __('涉及模块')],
];
?>
<div class="w-stack"
     data-collector-browser
     data-weline-load="adminCollectorBrowser"
     data-collector-summary="<?= htmlspecialchars(__('找到') . ' %count% ' . __('个拦截器，来自') . ' %groups% ' . __('个配置文件')) ?>"
     data-collector-empty="<?= htmlspecialchars(__('没有匹配项')) ?>">

    <div class="w-auto-grid">
        <?php foreach ($stats as $stat): ?>
            <div class="w-card">
                <div class="w-card__body">
                    <div class="w-cluster" data-align="center">
                        <span class="w-badge" data-w-background="<?= htmlspecialchars($stat['tone']) ?>">
                            <w:icon name="<?= htmlspecialchars($stat['icon']) ?>" size="sm"></w:icon>
                        </span>
                        <div class="w-stack" style="--w-gap:0;">
                            <span class="w-text" data-size="lg" data-weight="strong"><?= (int)$stat['value'] ?></span>
                            <span class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$stat['label']) ?></span>
                        </div>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <section class="w-card">
        <div class="w-card__header">
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <h2 class="w-card__title"><lang>插件管理</lang></h2>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;"><lang>查看系统中所有已注册的插件（拦截器），了解函数修改情况</lang></p>
            </div>
            <div class="w-card__actions w-cluster">
                <button type="button" class="w-button" data-collector-expand-all data-tone="neutral" data-variant="outline" data-size="sm">
                    <w:icon name="more-horizontal" size="sm"></w:icon><lang>展开全部</lang>
                </button>
                <button type="button" class="w-button" data-collector-collapse-all data-tone="neutral" data-variant="outline" data-size="sm">
                    <w:icon name="circle" size="sm"></w:icon><lang>折叠全部</lang>
                </button>
            </div>
        </div>
        <div class="w-card__body">
            <div class="w-toolbar">
                <div class="w-cluster" data-grow="true">
                    <label class="w-visually-hidden" for="plugin-search"><lang>搜索插件类、实例类、名称...</lang></label>
                    <input type="search" id="plugin-search" class="w-input" data-collector-search
                           placeholder="<?= htmlspecialchars(__('搜索插件类、实例类、名称...')) ?>"
                           data-w-width="auto">
                    <button type="button" class="w-button" data-collector-search-clear data-tone="neutral" data-variant="outline" data-size="sm">
                        <w:icon name="close" size="sm"></w:icon><span class="w-visually-hidden"><lang>清除搜索</lang></span>
                    </button>
                </div>
                <div class="w-cluster">
                    <label class="w-visually-hidden" for="plugin-filter-status"><lang>所有状态</lang></label>
                    <select id="plugin-filter-status" class="w-select" data-collector-filter="status" data-w-width="auto">
                        <option value=""><lang>所有状态</lang></option>
                        <option value="enabled"><lang>已启用</lang></option>
                        <option value="disabled"><lang>已禁用</lang></option>
                    </select>
                    <label class="w-visually-hidden" for="plugin-filter-module"><lang>所有模块</lang></label>
                    <select id="plugin-filter-module" class="w-select" data-collector-filter="module" data-w-width="auto">
                        <option value=""><lang>所有模块</lang></option>
                        <?php foreach (array_keys($moduleSet) as $mod): ?>
                            <option value="<?= htmlspecialchars((string)$mod) ?>"><?= htmlspecialchars((string)$mod) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

            <p class="w-text" data-tone="info" data-size="sm" data-collector-result hidden>
                <w:icon name="info" size="sm"></w:icon>
                <span data-collector-result-text></span>
            </p>

            <?php if (empty($plugins)): ?>
                <div class="w-empty">
                    <w:icon name="puzzle" size="lg"></w:icon>
                    <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                        <p class="w-text" data-weight="strong"><lang>暂无插件配置</lang></p>
                        <p class="w-text" data-tone="muted"><lang>系统中还没有注册任何插件。</lang></p>
                    </div>
                </div>
            <?php else: ?>
                <div class="w-stack">
                    <?php foreach ($plugins as $file => $pluginGroups): ?>
                        <?php
                        $filePluginCount = 0;
                        foreach ($pluginGroups as $instances) {
                            $filePluginCount += count($instances);
                        }
                        ?>
                        <div class="w-disclosure"
                             data-w-component="disclosure"
                             data-state="closed"
                             data-collector-group
                             data-name="<?= htmlspecialchars(strtolower((string)$file)) ?>"
                             data-searchable="<?= htmlspecialchars(strtolower((string)$file)) ?>">
                            <button type="button" class="w-disclosure__trigger" data-w-disclosure-trigger aria-expanded="false">
                                <w:icon name="file" size="sm"></w:icon>
                                <span class="w-text" data-weight="strong"><?= htmlspecialchars((string)$file) ?></span>
                                <span class="w-badge" data-w-background="primary"><?= $filePluginCount ?> <lang>个拦截器</lang></span>
                                <w:icon name="chevron-down" size="sm"></w:icon>
                            </button>
                            <div class="w-disclosure__panel" data-w-disclosure-panel hidden>
                                <?php foreach ($pluginGroups as $name => $instances): ?>
                                    <div class="w-stack" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
                                        <div class="w-cluster">
                                            <w:icon name="puzzle" size="sm"></w:icon>
                                            <span class="w-text" data-weight="medium"><lang>插件：</lang><?= htmlspecialchars((string)$name) ?></span>
                                        </div>
                                        <div class="w-table-wrap" data-w-border="none">
                                            <table class="w-table">
                                                <thead>
                                                <tr>
                                                    <th scope="col"><lang>拦截器名</lang></th>
                                                    <th scope="col"><lang>目标类</lang></th>
                                                    <th scope="col"><lang>实例类</lang></th>
                                                    <th scope="col"><lang>状态</lang></th>
                                                    <th scope="col"><lang>排序</lang></th>
                                                    <th scope="col"><lang>模块</lang></th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <?php foreach ($instances as $instance): ?>
                                                    <?php
                                                    $disabled = $instance['plugins']['disabled'] ?? 'false';
                                                    $isDisabled = ($disabled === 'true' || $disabled === true || $disabled === '1');
                                                    $statusClass = $isDisabled ? 'disabled' : 'enabled';
                                                    $statusText = $isDisabled ? __('已禁用') : __('已启用');
                                                    $module = $instance['plugins']['module'] ?? '';
                                                    ?>
                                                    <tr data-collector-row
                                                        data-status="<?= $statusClass ?>"
                                                        data-module="<?= htmlspecialchars((string)$module) ?>"
                                                        data-searchable="<?= htmlspecialchars(strtolower(($instance['class'] ?? '') . ' ' . ($instance['plugins']['instance'] ?? '') . ' ' . ($instance['plugins']['name'] ?? ''))) ?>">
                                                        <td><span class="w-text" data-weight="medium"><?= htmlspecialchars((string)($instance['plugins']['name'] ?? '-')) ?></span></td>
                                                        <td><code class="w-text" data-size="sm" title="<?= htmlspecialchars((string)($instance['class'] ?? '')) ?>"><?= htmlspecialchars((string)($instance['class'] ?? '')) ?></code></td>
                                                        <td><code class="w-text" data-size="sm" title="<?= htmlspecialchars((string)($instance['plugins']['instance'] ?? '-')) ?>"><?= htmlspecialchars((string)($instance['plugins']['instance'] ?? '-')) ?></code></td>
                                                        <td>
                                                            <span class="w-badge" data-w-background="<?= $isDisabled ? 'danger' : 'success' ?>">
                                                                <w:icon name="<?= $isDisabled ? 'close' : 'check' ?>" size="sm"></w:icon>
                                                                <?= htmlspecialchars((string)$statusText) ?>
                                                            </span>
                                                        </td>
                                                        <td><span class="w-badge" data-w-background="muted"><?= htmlspecialchars((string)($instance['plugins']['sort'] ?? '0')) ?></span></td>
                                                        <td>
                                                            <?php if ($module): ?>
                                                                <span class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$module) ?></span>
                                                            <?php else: ?>
                                                                <span class="w-text" data-tone="muted">—</span>
                                                            <?php endif; ?>
                                                        </td>
                                                    </tr>
                                                <?php endforeach; ?>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <?php endforeach; ?>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    </section>
</div>
