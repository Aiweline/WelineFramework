<?php
/**
 * 系统事件管理页面（内容模板）
 *
 * @var \Weline\Framework\View\Template $this
 */
$events = $this->getData('events') ?: [];
$totalFiles = count($events);
$totalEvents = 0;
$totalObservers = 0;
$enabledObservers = 0;
$disabledObservers = 0;
$sharedObservers = 0;
$eventNames = [];
$moduleSet = [];
foreach ($events as $file => $eventGroups) {
    $moduleName = explode('::', $file)[0] ?? '';
    if ($moduleName) {
        $moduleSet[$moduleName] = true;
    }
    foreach ($eventGroups as $name => $observers) {
        $totalEvents++;
        $eventNames[$name] = ($eventNames[$name] ?? 0) + count($observers);
        foreach ($observers as $observer) {
            $totalObservers++;
            $disabled = $observer['disabled'] ?? 'false';
            if ($disabled === 'true' || $disabled === true || $disabled === '1') {
                $disabledObservers++;
            } else {
                $enabledObservers++;
            }
            $shared = $observer['shared'] ?? 'true';
            if ($shared === 'true' || $shared === true || $shared === '1') {
                $sharedObservers++;
            }
        }
    }
}
$moduleCount = count($moduleSet);
$uniqueEventCount = count($eventNames);
$stats = [
    ['icon' => 'file', 'tone' => 'primary', 'value' => $totalFiles, 'label' => __('配置文件')],
    ['icon' => 'bolt', 'tone' => 'warning', 'value' => $uniqueEventCount, 'label' => __('事件类型')],
    ['icon' => 'eye', 'tone' => 'info', 'value' => $totalObservers, 'label' => __('观察者总数')],
    ['icon' => 'check', 'tone' => 'success', 'value' => $enabledObservers, 'label' => __('已启用')],
    ['icon' => 'close', 'tone' => 'danger', 'value' => $disabledObservers, 'label' => __('已禁用')],
];
?>
<div class="w-stack"
     data-collector-browser
     data-weline-load="adminCollectorBrowser"
     data-collector-summary="<?= htmlspecialchars(__('找到') . ' %count% ' . __('个观察者，来自') . ' %groups% ' . __('个配置文件')) ?>"
     data-collector-empty="<?= htmlspecialchars(__('没有匹配项')) ?>">

    <div class="w-auto-grid">
        <?php foreach ($stats as $stat): ?>
            <div class="w-card">
                <div class="w-card__body">
                    <div class="w-cluster" data-align="center">
                        <span class="w-badge" data-w-background="<?= htmlspecialchars($stat['tone']) ?>">
                            <w:icon name="<?= htmlspecialchars($stat['icon']) ?>" size="sm"></w:icon>
                        </span>
                        <div class="w-stack" style="--w-gap:0;">
                            <span class="w-text" data-size="lg" data-weight="strong"><?= (int)$stat['value'] ?></span>
                            <span class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$stat['label']) ?></span>
                        </div>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <section class="w-card">
        <div class="w-card__header">
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <h2 class="w-card__title"><lang>系统事件</lang></h2>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;"><lang>查看系统中所有已注册的事件和观察者，方便开发者使用观察者模式订阅系统事件</lang></p>
            </div>
            <div class="w-card__actions w-cluster">
                <button type="button" class="w-button" data-collector-expand-all data-tone="neutral" data-variant="outline" data-size="sm">
                    <w:icon name="more-horizontal" size="sm"></w:icon><lang>展开全部</lang>
                </button>
                <button type="button" class="w-button" data-collector-collapse-all data-tone="neutral" data-variant="outline" data-size="sm">
                    <w:icon name="circle" size="sm"></w:icon><lang>折叠全部</lang>
                </button>
            </div>
        </div>
        <div class="w-card__body">
            <div class="w-toolbar">
                <div class="w-cluster" data-grow="true">
                    <label class="w-visually-hidden" for="event-search"><lang>搜索事件名、观察者、实例类...</lang></label>
                    <input type="search" id="event-search" class="w-input" data-collector-search
                           placeholder="<?= htmlspecialchars(__('搜索事件名、观察者、实例类...')) ?>"
                           data-w-width="auto">
                    <button type="button" class="w-button" data-collector-search-clear data-tone="neutral" data-variant="outline" data-size="sm">
                        <w:icon name="close" size="sm"></w:icon><span class="w-visually-hidden"><lang>清除搜索</lang></span>
                    </button>
                </div>
                <div class="w-cluster">
                    <label class="w-visually-hidden" for="event-filter-status"><lang>所有状态</lang></label>
                    <select id="event-filter-status" class="w-select" data-collector-filter="status" data-w-width="auto">
                        <option value=""><lang>所有状态</lang></option>
                        <option value="enabled"><lang>已启用</lang></option>
                        <option value="disabled"><lang>已禁用</lang></option>
                    </select>
                    <label class="w-visually-hidden" for="event-filter-module"><lang>所有模块</lang></label>
                    <select id="event-filter-module" class="w-select" data-collector-filter="module" data-w-width="auto">
                        <option value=""><lang>所有模块</lang></option>
                        <?php foreach (array_keys($moduleSet) as $mod): ?>
                            <option value="<?= htmlspecialchars((string)$mod) ?>"><?= htmlspecialchars((string)$mod) ?></option>
                        <?php endforeach; ?>
                    </select>
                    <label class="w-visually-hidden" for="event-filter-event"><lang>所有事件</lang></label>
                    <select id="event-filter-event" class="w-select" data-collector-filter="event" data-w-width="auto">
                        <option value=""><lang>所有事件</lang></option>
                        <?php foreach (array_keys($eventNames) as $eName): ?>
                            <option value="<?= htmlspecialchars((string)$eName) ?>"><?= htmlspecialchars((string)$eName) ?> (<?= (int)$eventNames[$eName] ?>)</option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

            <p class="w-text" data-tone="info" data-size="sm" data-collector-result hidden>
                <w:icon name="info" size="sm"></w:icon>
                <span data-collector-result-text></span>
            </p>

            <?php if (empty($events)): ?>
                <div class="w-empty">
                    <w:icon name="bolt" size="lg"></w:icon>
                    <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                        <p class="w-text" data-weight="strong"><lang>暂无事件配置</lang></p>
                        <p class="w-text" data-tone="muted"><lang>系统中还没有注册任何事件观察者。</lang></p>
                    </div>
                </div>
            <?php else: ?>
                <div class="w-stack">
                    <?php foreach ($events as $file => $eventGroups): ?>
                        <?php
                        $moduleName = explode('::', $file)[0] ?? '';
                        $fileEventCount = count($eventGroups);
                        $fileObserverCount = 0;
                        foreach ($eventGroups as $observers) {
                            $fileObserverCount += count($observers);
                        }
                        ?>
                        <div class="w-disclosure"
                             data-w-component="disclosure"
