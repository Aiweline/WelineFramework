                                <span class="w-text" data-weight="strong"><?= htmlspecialchars((string)$file) ?></span>
                                <span class="w-badge" data-w-background="warning"><?= $fileEventCount ?> <lang>个事件</lang></span>
                                <span class="w-badge" data-w-background="info"><?= $fileObserverCount ?> <lang>个观察者</lang></span>
                                <w:icon name="chevron-down" size="sm"></w:icon>
                            </button>
                            <div class="w-disclosure__panel" data-w-disclosure-panel hidden>
                                <?php foreach ($eventGroups as $eventName => $observers): ?>
                                    <div class="w-stack" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
                                        <div class="w-cluster" data-justify="between">
                                            <div class="w-cluster">
                                                <w:icon name="bolt" size="sm"></w:icon>
                                                <code class="w-text" data-size="sm" data-weight="strong"><?= htmlspecialchars((string)$eventName) ?></code>
                                            </div>
                                            <span class="w-text" data-tone="muted" data-size="sm"><?= count($observers) ?> <lang>个观察者</lang></span>
                                        </div>
                                        <div class="w-table-wrap" data-w-border="none">
                                            <table class="w-table">
                                                <thead>
                                                <tr>
                                                    <th scope="col"><lang>观察者名</lang></th>
                                                    <th scope="col"><lang>实例类</lang></th>
                                                    <th scope="col"><lang>状态</lang></th>
                                                    <th scope="col"><lang>共享</lang></th>
                                                    <th scope="col"><lang>排序</lang></th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <?php foreach ($observers as $observer): ?>
                                                    <?php
                                                    $disabled = $observer['disabled'] ?? 'false';
                                                    $isDisabled = ($disabled === 'true' || $disabled === true || $disabled === '1');
                                                    $statusClass = $isDisabled ? 'disabled' : 'enabled';
                                                    $statusText = $isDisabled ? __('已禁用') : __('已启用');
                                                    $shared = $observer['shared'] ?? 'true';
                                                    $isShared = ($shared === 'true' || $shared === true || $shared === '1');
                                                    $sharedText = $isShared ? __('共享') : __('独占');
                                                    ?>
                                                    <tr data-collector-row
                                                        data-status="<?= $statusClass ?>"
                                                        data-module="<?= htmlspecialchars((string)$moduleName) ?>"
                                                        data-event="<?= htmlspecialchars(strtolower((string)$eventName)) ?>"
                                                        data-searchable="<?= htmlspecialchars(strtolower(($observer['name'] ?? '') . ' ' . ($observer['instance'] ?? '') . ' ' . $eventName)) ?>">
                                                        <td><span class="w-text" data-weight="medium"><?= htmlspecialchars((string)($observer['name'] ?? '-')) ?></span></td>
                                                        <td><code class="w-text" data-size="sm" title="<?= htmlspecialchars((string)($observer['instance'] ?? '-')) ?>"><?= htmlspecialchars((string)($observer['instance'] ?? '-')) ?></code></td>
                                                        <td>
                                                            <span class="w-badge" data-w-background="<?= $isDisabled ? 'danger' : 'success' ?>">
                                                                <w:icon name="<?= $isDisabled ? 'close' : 'check' ?>" size="sm"></w:icon>
                                                                <?= htmlspecialchars((string)$statusText) ?>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="w-badge" data-w-background="<?= $isShared ? 'info' : 'muted' ?>">
                                                                <w:icon name="<?= $isShared ? 'share' : 'lock' ?>" size="sm"></w:icon>
                                                                <?= htmlspecialchars((string)$sharedText) ?>
                                                            </span>
                                                        </td>
                                                        <td><span class="w-badge" data-w-background="muted"><?= htmlspecialchars((string)($observer['sort'] ?? '10000')) ?></span></td>
                                                    </tr>
                                                <?php endforeach; ?>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <?php endforeach; ?>
