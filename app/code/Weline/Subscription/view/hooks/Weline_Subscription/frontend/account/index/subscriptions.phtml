<?php
/**
 * Subscription list partial inside official Customer account layout.
 *
 * @hook-priority 10
 * @hook-sort-order 10
 */
use Weline\Customer\Api\View\AccountSidebarProjectionProviderInterface;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RuntimeProviderResolver;
use Weline\Subscription\Service\SubscriptionBuyerService;
use Weline\Subscription\Service\SubscriptionConflictException;

$subscriptions = [];
$error = '';
$projectionProvider = ObjectManager::getInstance(RuntimeProviderResolver::class)
    ->resolve(AccountSidebarProjectionProviderInterface::class);
if ($projectionProvider instanceof AccountSidebarProjectionProviderInterface) {
    $projection = $projectionProvider->forSections('subscriptions');
    if ($projection !== null && $projection->getCustomerId() !== null && $projection->getCustomerId() > 0) {
        try {
            $buyer = ObjectManager::getInstance(SubscriptionBuyerService::class);
            if ($buyer instanceof SubscriptionBuyerService) {
                $subscriptions = $buyer->listForCustomer(
                    (string)$projection->getCustomerId(),
                    $projection->getWebsiteId(),
                );
            }
        } catch (SubscriptionConflictException $exception) {
            $error = $exception->getMessage();
        } catch (\InvalidArgumentException $exception) {
            $error = $exception->getMessage();
        }
    }
}
?>
<div class="subscription-account-list" data-testid="subscription-account-list" weline-code="subscription.account.list">
    <h3><lang>我的订阅</lang></h3>
    <p class="w-text" data-tone="muted"><lang>开通、续费和取消都在订阅页面完成。</lang></p>
    <?php if ($error !== ''): ?>
        <p class="w-text" data-tone="danger"><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></p>
    <?php elseif ($subscriptions === []): ?>
        <p class="w-text" data-tone="muted"><lang>还没有订阅</lang></p>
    <?php else: ?>
        <ul class="subscription-account-list__items">
            <?php foreach ($subscriptions as $row): ?>
                <li>
                    <?= htmlspecialchars((string)($row['plan_code'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
                    · <?= htmlspecialchars((string)($row['status_label'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
    <p class="subscription-account-list__links">
        <a class="w-button" data-size="sm" href="@url{'subscription/frontend/buyer'}"><lang>我的订阅</lang></a>
        <a class="w-button" data-variant="outline" data-size="sm" href="@url{'subscription/frontend/buyer'}#subscribe"><lang>开通订阅</lang></a>
    </p>
</div>
<style>
.subscription-account-list { display: grid; gap: var(--weline-space-3, .75rem); }
.subscription-account-list__items { margin: 0; padding-left: 1.1rem; }
.subscription-account-list__links { display: flex; flex-wrap: wrap; gap: var(--weline-space-2, .5rem); }
</style>
