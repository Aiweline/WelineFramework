<script>
(function(g){
  if(g.__bqAdmin_multipass) return;
  g.__bqAdmin_multipass=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['multipass']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('multipass').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
(function() {
    'use strict';
    
    var selectedUserId = null;
    var selectedUserType = '<?= $userType ?>';
    var getUserListUrl = '<?= $this->getBackendUrl('multipass/backend/account/get-user-list', ['user_type' => $userType, 'search' => '']) ?>';
    var generateTokenUrl = '<?= $this->getBackendUrl('multipass/backend/account/generate-token') ?>';
    
    function searchUsers() {
        var search = document.getElementById('user-search').value.trim();
        var userList = document.getElementById('user-list');
        
        if (!search) {
            userList.innerHTML = '<div class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);"><w:icon name="info" size="sm"></w:icon> <?= __('请输入搜索关键词查找用户') ?></div>';
            return;
        }
        
        if (window.showLoading) showLoading();
        
        var url = getUserListUrl + encodeURIComponent(search);
        bqAdmin['multipass'](url, { silent: true })
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (window.hideLoading) hideLoading();
                if (data.code === 200) {
                    displayUsers(data.data.users);
                } else {
                    showMessage('error', data.msg || '<?= __('获取用户列表失败') ?>');
                }
            })
            .catch(function(error) {
                if (window.hideLoading) hideLoading();
                showMessage('error', '<?= __('请求失败') ?>');
            });
    }
    
    function displayUsers(users) {
        var userList = document.getElementById('user-list');
        
        if (!users || users.length === 0) {
            userList.innerHTML = '<div class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);"><w:icon name="user" size="sm"></w:icon> <?= __('未找到用户') ?></div>';
            return;
        }
        
        function escapeHtml(value) {
            var div = document.createElement('div');
            div.textContent = value === null || value === undefined ? '' : String(value);
            return div.innerHTML;
        }

        function escapeAttr(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        function safeImageUrl(value) {
            if (!value) {
                return '';
            }

            try {
                var url = new URL(String(value), window.location.origin);
                return (url.protocol === 'http:' || url.protocol === 'https:') ? url.href : '';
            } catch (e) {
                return '';
            }
        }

        var html = '';
        users.forEach(function(user) {
            var username = (user.username || user.user_id || '').toString();
            var email = (user.email || '').toString();
            var avatar = safeImageUrl(user.avatar || '');
            var userId = user.user_id || user.id;
            var firstLetter = username ? username.charAt(0).toUpperCase() : '?';
            
            html += '<div class="weline-multipass-user-card" data-user-id="' + escapeAttr(userId) + '" data-username="' + escapeAttr(username) + '" data-email="' + escapeAttr(email) + '">' +
                '<div class="w-cluster" data-align="center">' +
                (avatar ? '<img src="' + escapeAttr(avatar) + '" class="me-2" width="40" height="40" data-avatar-fallback data-w-radius="round">' : '') +
                '<div class="w-text me-2 w-cluster" style="width:40px;height:40px;' + (avatar ? 'display:none;' : '') + '" data-w-radius="round" data-w-background="primary" data-align="center" data-justify="center" data-tone="inverse">' + escapeHtml(firstLetter) + '</div>' +
                '<div data-grow="true">' +
                '<div class="w-text" data-weight="strong">' + escapeHtml(username) + '</div>' +
                (email ? '<div class="w-text" data-tone="muted" data-size="sm">' + escapeHtml(email) + '</div>' : '') +
                '</div>' +
                '<w:icon name="check" size="sm"></w:icon>' +
                '</div>' +
                '</div>';
        });
        
        userList.innerHTML = html;
        
        // Bind click events
        document.querySelectorAll('.weline-multipass-user-card').forEach(function(card) {
            card.addEventListener('click', function() {
                selectUser(this);
            });
        });

        document.querySelectorAll('[data-avatar-fallback]').forEach(function(avatarImage) {
            avatarImage.addEventListener('error', function() {
                avatarImage.style.display = 'none';
                if (avatarImage.nextElementSibling) {
                    avatarImage.nextElementSibling.style.display = 'flex';
                }
            });
        });
    }
    
    function selectUser(element) {
        selectedUserId = element.getAttribute('data-user-id');
        
        document.querySelectorAll('.weline-multipass-user-card').forEach(function(card) {
            card.classList.remove('selected');
            var checkIcon = card.querySelector('.mdi-check-circle');
            if (checkIcon) checkIcon.style.display = 'none';
        });
        
        element.classList.add('selected');
        var checkIcon = element.querySelector('.mdi-check-circle');
        if (checkIcon) checkIcon.style.display = 'block';
        
        var siteSelect = document.getElementById('site-select');
        var generateBtn = document.getElementById('generate-btn');
        
        if (siteSelect && siteSelect.value) {
            generateBtn.disabled = false;
        }
        
        var tokenResult = document.getElementById('token-result');
        if (tokenResult) tokenResult.classList.remove('show');
    }
    
    function generateToken() {
        var siteId = document.getElementById('site-select').value;
        
        if (!siteId || !selectedUserId) {
            showMessage('error', '<?= __('请先选择用户和站点') ?>');
            return;
        }
        
        if (window.showLoading) showLoading();
        
        var formData = new FormData();
        formData.append('user_id', selectedUserId);
        formData.append('site_id', siteId);
        formData.append('user_type', selectedUserType);
        
        var opts = { method: 'POST', body: formData };
        bqAdmin['multipass'](generateTokenUrl, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (window.hideLoading) hideLoading();
                if (data.code === 200) {
                    displayTokenResult(data.data);
                } else {
                    showMessage('error', data.msg || '<?= __('生成令牌失败') ?>');
                }
            })
            .catch(function(error) {
                if (window.hideLoading) hideLoading();
                showMessage('error', '<?= __('请求失败') ?>');
            });
    }
    
    function displayTokenResult(data) {
        document.getElementById('result-site-name').textContent = data.site_name;
        document.getElementById('result-username').textContent = data.username;
        document.getElementById('result-token').textContent = data.token;
        document.getElementById('result-login-url').textContent = data.login_url;
        document.getElementById('open-login-url').href = data.login_url;
        
        document.getElementById('token-result').classList.add('show');
        document.getElementById('token-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    
    function copyToClipboard(text) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
    }
    
    function showMessage(type, message) {
        if (window.Weline.UI.toast) {
            Weline.UI.toast[type === 'success' ? 'success' : 'error'](message);
        }
    }
    
    // Event bindings
    document.getElementById('multipass-search-btn').addEventListener('click', searchUsers);
    document.getElementById('user-search').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') searchUsers();
    });
    document.getElementById('site-select').addEventListener('change', function() {
        document.getElementById('generate-btn').disabled = !this.value || !selectedUserId;
    });
    document.getElementById('generate-btn').addEventListener('click', generateToken);
    document.getElementById('copy-token-btn').addEventListener('click', function() {
        copyToClipboard(document.getElementById('result-token').textContent);
        showMessage('success', '<?= __('Token已复制到剪贴板') ?>');
    });
    document.getElementById('copy-login-url-btn').addEventListener('click', function() {
        copyToClipboard(document.getElementById('result-login-url').textContent);
        showMessage('success', '<?= __('登录链接已复制到剪贴板') ?>');
    });
})();
</script>
