lass="w-text" data-tone="muted"><?= __('密钥') ?></small> <div class="weline-multipass-secret-key"> <?= htmlspecialchars(substr($site->getData('secret_key') ?? '', 0, 20)) ?>... <button type="button" class="w-button" data-multipass-site-action="copy-secret" data-secret-key="<?= htmlspecialchars((string)($site->getData('secret_key') ?? ''), ENT_QUOTES, 'UTF-8') ?>" data-tone="quiet" data-size="sm" style="--w-pt:0;--w-pe:0;--w-pb:0;--w-ps:0;"> <w:icon name="copy" size="sm"></w:icon> </button> </div> </div> <div class="w-cluster" style="--w-gap:var(--weline-space-2);"> <button type="button" class="w-button" data-multipass-site-action="edit" data-site="<?= htmlspecialchars(json_encode($site->getData(), $jsonForScriptFlags) ?: '{}', ENT_QUOTES, 'UTF-8') ?>" data-tone="primary" data-variant="outline" data-size="sm"> <w:icon name="edit" size="sm"></w:icon> <?= __('编辑') ?> </button> <button type="button" class="w-button" data-multipass-site-action="delete" data-site-id="<?= (int)$site->getData('site_id') ?>" data-site-name="<?= htmlspecialchars((string)($site->getData('site_name') ?? ''), ENT_QUOTES, 'UTF-8') ?>" data-tone="danger" data-variant="outline" data-size="sm"> <w:icon name="trash" size="sm"></w:icon> <?= __('删除') ?> </button> </div> </div> </div> <?php endforeach; ?> </div> <?php endif; ?> </div> </div> </div>
