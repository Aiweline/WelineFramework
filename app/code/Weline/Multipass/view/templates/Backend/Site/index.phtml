> <small class="w-field__hint w-text" data-tone="muted"><?= __('该站点用于登录哪类用户') ?></small> </div> <div style="--w-mb:var(--weline-space-4);"> <div class="w-switch"> <input type="checkbox" name="is_enabled" id="is_enabled" value="1" checked> <label for="is_enabled"><?= __('启用站点') ?></label> </div> </div> <div class="w-stack" style="--w-gap:var(--weline-space-2);"> <button type="submit" class="w-button" data-tone="primary"> <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?> </button> </div> </w:form> </div>
</div> <script>
(function() { 'use strict'; var saveUrl = <?= json_encode($this->getBackendUrl('multipass/backend/site/save'), $jsonForScriptFlags) ?>; var deleteUrl = <?= json_encode($this->getBackendUrl('multipass/backend/site/delete'), $jsonForScriptFlags) ?>; var listUrl = <?= json_encode($this->getBackendUrl('multipass/backend/site/index'), $jsonForScriptFlags) ?>; var deleteConfirmTemplate = <?= json_encode((string)__('确定要删除站点 "%{1}" 吗？此操作不可恢复。'), $jsonForScriptFlags) ?>; function generateRandomKey(length) { var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'; var result = ''; for (var i = 0; i < length; i++) { result += chars.charAt(Math.floor(Math.random() * chars.length)); } return result; } window.generateKey = function() { document.getElementById('secret_key').value = generateRandomKey(32); }; window.copySecretKey = function(key) { var textarea = document.createElement('textarea'); textarea.value = key; textarea.style.position = 'fixed'; textarea.style.opacity = '0'; document.body.appendChild(textarea); textarea.select(); document.execCommand('copy'); document.body.removeChild(textarea); Weline.UI.toast.success('<?= __('密钥已复制到剪贴板') ?>'); }; window.editSite = function(siteData) { document.getElementById('offcanvasTitle').textContent = '<?= __('编辑站点') ?>'; document.getElementById('site_id').value = siteData.site_id || ''; document.getElementById('site_name').value = siteData.site_name || ''; document.getElementById('site_url').value = siteData.site_url || ''; document.getElementById('secret_key').value = siteData.secret_key || ''; document.getElementById('user_type').value = siteData.user_type || 'frontend'; document.getElementById('is_enabled').checked = siteData.is_enabled == 1; Weline.UI.drawer.open('#addSiteOffcanvas'); }; window.deleteSite = function(siteId, siteName) { Weline.UI.dialog.confirm(deleteConfirmTemplate.replace('%{1}', siteName || '')) .then(function(confirmed) { if (confirmed) { var formData = new FormData(); formData.append('site_id', siteId); Weline.adminRequest('multipass', deleteUrl, formData) .then(function(res) { var data = (res && res.data) !== undefined ? res.data : res; if (data.success || data.code === 200) { Weline.UI.toast.success('<?= __('站点删除成功') ?>'); setTimeout(function() { window.location.reload(); }, 1000); } else { Weline.UI.toast.error(data.message || data.msg || '<?= __('删除失败') ?>'); } }) .catch(function() { Weline.UI.toast.error('<?= __('请求失败') ?>'); }); } }); }; document.querySelectorAll('[data-multipass-site-action]').forEach(function(button) { button.addEventListener('click', function() { var action = button.getAttribute('data-multipass-site-action') || ''; if (action === 'copy-secret') { copySecretKey(button.getAttribute('data-secret-key') || ''); return; } if (action === 'edit') { try { editSite(JSON.parse(button.getAttribute('data-site') || '{}')); } catch (e) { Weline.UI.toast.error('<?= __('站点数据解析失败') ?>'); } return; } if (action === 'delete') { deleteSite(parseInt(button.getAttribute('data-site-id') || '0', 10), button.getAttribute('data-site-name') || ''); return; } if (action === 'generate-key') { generateKey(); } }); }); document.getElementById('siteForm').addEventListener('submit', function(e) { e.preventDefault(); var formData = new FormData(this); Weline.adminRequest('multipass', saveUrl, formData) .then(function(res) { var data = (res && res.data) !== undefined ? res.data : res; if (data.success || data.code === 200) { Weline.UI.toast.success('<?= __('站点保存成功') ?>'); setTimeout(function() { window.location.reload(); }, 1000); } else { Weline.UI.toast.error(data.message || data.msg || '<?= __('保存失败') ?>'); } }) .catch(function() { Weline.UI.toast.error('<?= __('请求失败') ?>'); }); }); document.getElementById('addSiteOffcanvas').addEventListener('weline:ui:drawer:close', function() { document.getElementById('offcanvasTitle').textContent = '<?= __('添加站点') ?>'; document.getElementById('siteForm').reset(); document.getElementById('site_id').value = ''; document.getElementById('is_enabled').checked = true; });
})();
</script>
