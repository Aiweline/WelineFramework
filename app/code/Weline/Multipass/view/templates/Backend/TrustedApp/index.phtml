lass="w-field__label"><?= __('授权范围') ?></label> <div data-w-border="border" data-w-radius="md" style="--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);"> <?php foreach (['profile.basic', 'profile.email', 'account.bind', 'appstore.account', 'community.account'] as $scope): ?> <div class="w-check"> <input class="scope-checkbox" type="checkbox" name="allowed_scopes[]" value="<?= $scope ?>" id="scope_<?= str_replace('.', '_', $scope) ?>" <?= in_array($scope, ['profile.basic', 'profile.email', 'account.bind'], true) ? 'checked' : '' ?>> <label for="scope_<?= str_replace('.', '_', $scope) ?>"><?= $scope ?></label> </div> <?php endforeach; ?> </div> </div> <div style="--w-mb:var(--weline-space-4);"> <label class="w-field__label"><?= __('状态') ?></label> <select class="w-select" name="status" id="status"> <option value="active"><?= __('启用') ?></option> <option value="disabled"><?= __('禁用') ?></option> <option value="deleted"><?= __('删除态') ?></option> </select> </div> <div style="--w-mb:var(--weline-space-4);"> <label class="w-field__label"><?= __('申请状态') ?></label> <select class="w-select" name="application_status" id="application_status"> <option value="pending"><?= __('待审核') ?></option> <option value="approved"><?= __('已通过') ?></option> <option value="rejected"><?= __('已拒绝') ?></option> </select> <small class="w-field__hint w-text" data-tone="muted"><?= __('前台用户提交的 Multipass 管理申请会带有申请人和申请状态。') ?></small> </div> <div class="w-stack" style="--w-gap:var(--weline-space-2);"> <button type="submit" class="w-button" data-tone="primary"> <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?> </button> </div> </w:form> </div>
</div> <script>
(function() { 'use strict'; var saveUrl = '<?= $this->getBackendUrl('multipass/backend/trusted-app/save') ?>'; var rotateUrl = '<?= $this->getBackendUrl('multipass/backend/trusted-app/rotate-secret') ?>'; function normalizeResponse(res) { return (res && res.data) !== undefined ? res.data : res; } function showSecret(secret) { document.getElementById('secretValue').textContent = secret || ''; document.getElementById('secretPanel').style.display = secret ? 'block' : 'none'; } window.copyIdentitySecret = function() { var secret = document.getElementById('secretValue').textContent || ''; if (!secret) { return; } var textarea = document.createElement('textarea'); textarea.value = secret; textarea.style.position = 'fixed'; textarea.style.opacity = '0'; document.body.appendChild(textarea); textarea.select(); document.execCommand('copy'); document.body.removeChild(textarea); Weline.UI.toast.success('<?= __('client_secret 已复制') ?>'); }; window.editTrustedApp = function(button) { var appData = JSON.parse(button.getAttribute('data-app') || '{}'); document.getElementById('trustedAppOffcanvasTitle').textContent = '<?= __('编辑互通应用') ?>'; document.getElementById('app_id').value = appData.app_id || ''; document.getElementById('name').value = appData.name || ''; document.getElementById('app_type').value = appData.app_type || 'app'; document.getElementById('redirect_uri').value = appData.redirect_uri || ''; document.getElementById('trusted_domain').value = appData.trusted_domain || ''; document.getElementById('status').value = appData.status || 'active'; document.getElementById('application_status').value = appData.application_status || 'approved'; document.querySelectorAll('.scope-checkbox').forEach(function(input) { input.checked = (appData.allowed_scopes || []).indexOf(input.value) !== -1; }); Weline.UI.drawer.open('#trustedAppOffcanvas'); }; window.rotateIdentitySecret = function(appId) { Weline.UI.dialog.confirm('<?= __('确定要轮换该应用的 client_secret 吗？旧密钥会立即失效。') ?>') .then(function(confirmed) { if (!confirmed) { return; } var formData = new FormData(); formData.append('app_id', appId); Weline.adminRequest('multipass', rotateUrl, formData) .then(function(res) { var data = normalizeResponse(res); if (data.success || data.code === 200) { showSecret(data.client_secret || ''); Weline.UI.toast.success(data.message || '<?= __('密钥已轮换') ?>'); } else { Weline.UI.toast.error(data.message || data.msg || '<?= __('密钥轮换失败') ?>'); } }) .catch(function() { Weline.UI.toast.error('<?= __('请求失败') ?>'); }); }); }; document.getElementById('trustedAppForm').addEventListener('submit', function(e) { e.preventDefault(); var formData = new FormData(this); Weline.adminRequest('multipass', saveUrl, formData) .then(function(res) { var data = normalizeResponse(res); if (data.success || data.code === 200) { showSecret(data.client_secret || ''); Weline.UI.toast.success(data.message || '<?= __('保存成功') ?>'); if (!data.client_secret) { setTimeout(function() { window.location.reload(); }, 700); } } else { Weline.UI.toast.error(data.message || data.msg || '<?= __('保存失败') ?>'); } }) .catch(function() { Weline.UI.toast.error('<?= __('请求失败') ?>'); }); }); document.querySelectorAll('[data-multipass-app-action]').forEach(function(button) { button.addEventListener('click', function() { var action = button.getAttribute('data-multipass-app-action') || ''; if (action === 'copy-secret') { copyIdentitySecret(); return; } if (action === 'edit') { editTrustedApp(button); return; } if (action === 'rotate') { rotateIdentitySecret(parseInt(button.getAttribute('data-app-id') || '0', 10)); } }); }); document.getElementById('trustedAppOffcanvas').addEventListener('weline:ui:drawer:close', function() { document.getElementById('trustedAppOffcanvasTitle').textContent = '<?= __('添加互通应用') ?>'; document.getElementById('trustedAppForm').reset(); document.getElementById('app_id').value = ''; document.getElementById('application_status').value = 'approved'; document.querySelectorAll('.scope-checkbox').forEach(function(input) { input.checked = ['profile.basic', 'profile.email', 'account.bind'].indexOf(input.value) !== -1; }); });
})();
</script>
