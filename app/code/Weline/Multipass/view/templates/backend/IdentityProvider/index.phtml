$providers = $this->getData('providers') ?? [];
$scopeOptions = ['profile.basic', 'profile.email', 'account.bind', 'appstore.account', 'community.account'];
$h = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$providerRows = [];
foreach ($providers as $provider) {
    if (!is_object($provider)) {
        continue;
    }
    $providerRows[] = [
        'provider_id' => (int)$provider->getId(),
        'name' => (string)$provider->getName(),
        'issuer_base_url' => (string)$provider->getIssuerBaseUrl(),
        'rest_base_url' => (string)$provider->getRestBaseUrl(),
        'client_id' => (string)$provider->getClientId(),
        'redirect_uri' => (string)$provider->getRedirectUri(),
        'scopes' => array_values($provider->getScopes()),
        'status' => (string)$provider->getStatus(),
        'sort_order' => (int)$provider->getSortOrder(),
        'masked_secret' => (string)$provider->getMaskedClientSecret(),
        'is_active' => (bool)$provider->isActive(),
    ];
}
$providerRowsJson = json_encode($providerRows, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';
$scopeOptionsJson = json_encode($scopeOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';
