<script>
(function () {
    var providers = <?= $providerRowsJson ?>;
    var defaultScopes = <?= $scopeOptionsJson ?>;
    var form = document.getElementById('multipass-idp-form');
    var dialog = document.getElementById('multipass-idp-dialog');
    if (!form || !dialog) return;
    var statusEl = form.querySelector('[data-idp-status]');
    var titleEl = dialog.querySelector('[data-multipass-idp-title]');
    var secretRequired = form.querySelector('[data-idp-secret-required]');
    var secretHint = form.querySelector('[data-idp-secret-hint]');
    var unavailableMsg = <?= json_encode((string)__('Multipass API 不可用'), JSON_UNESCAPED_UNICODE) ?>;
    var createTitle = <?= json_encode((string)__('添加官网登录提供方'), JSON_UNESCAPED_UNICODE) ?>;
    var editTitle = <?= json_encode((string)__('编辑官网登录提供方'), JSON_UNESCAPED_UNICODE) ?>;
    var providerMap = {};
    (Array.isArray(providers) ? providers : []).forEach(function (row) {
        providerMap[String(row.provider_id || 0)] = row;
    });

    function toast(kind, message) {
        var ui = window.Weline && window.Weline.UI;
        var api = ui && ui.toast;
        var text = String(message || '').trim();
        if (!text) return;
        if (api && typeof api[kind] === 'function') { api[kind](text); return; }
        if (api && typeof api.show === 'function') {
            api.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
        }
    }
    function setStatus(tone, text) {
        if (!statusEl) return;
        statusEl.setAttribute('data-tone', tone || 'muted');
        statusEl.textContent = text || '';
    }
    function openDialog() {
        var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
        if (ui && typeof ui.open === 'function') { ui.open(dialog); return; }
        dialog.hidden = false; dialog.setAttribute('data-state', 'open'); dialog.setAttribute('aria-hidden', 'false');
    }
    function closeDialog() {
        var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
        if (ui && typeof ui.close === 'function') { ui.close(dialog); return; }
        dialog.hidden = true; dialog.setAttribute('data-state', 'closed'); dialog.setAttribute('aria-hidden', 'true');
    }
    function multipassApi() {
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            return Promise.reject(new Error(unavailableMsg));
        }
        if (typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(function () { return window.Weline.Api.resource('multipass'); });
        }
        return Promise.resolve(window.Weline.Api.resource('multipass'));
    }
    function field(name) { return form.querySelector('[data-idp-field="' + name + '"]'); }
    function setScopes(selected) {
        var set = {};
        (Array.isArray(selected) ? selected : []).forEach(function (s) { set[String(s)] = true; });
        form.querySelectorAll('[data-idp-scope]').forEach(function (input) {
            input.checked = !!set[input.getAttribute('data-idp-scope') || ''];
        });
    }
    function resetForm() {
        field('provider_id').value = '0';
        field('name').value = '';
        field('issuer_base_url').value = '';
        field('rest_base_url').value = '';
        field('client_id').value = '';
        field('client_secret').value = '';
        field('client_secret').required = true;
        field('redirect_uri').value = '';
        field('status').value = 'active';
        field('sort_order').value = '100';
        setScopes(['profile.basic', 'profile.email', 'account.bind']);
        if (titleEl) titleEl.textContent = createTitle;
        if (secretRequired) secretRequired.hidden = false;
        if (secretHint) secretHint.hidden = true;
        setStatus('muted', '');
    }
    function fillForm(row) {
        field('provider_id').value = String(row.provider_id || 0);
        field('name').value = row.name || '';
        field('issuer_base_url').value = row.issuer_base_url || '';
        field('rest_base_url').value = row.rest_base_url || '';
        field('client_id').value = row.client_id || '';
        field('client_secret').value = '';
        field('client_secret').required = false;
        field('redirect_uri').value = row.redirect_uri || '';
        field('status').value = row.status || 'active';
        field('sort_order').value = String(row.sort_order || 100);
        setScopes(row.scopes || []);
        if (titleEl) titleEl.textContent = editTitle;
        if (secretRequired) secretRequired.hidden = true;
        if (secretHint) secretHint.hidden = false;
        setStatus('muted', '');
    }

    var createOpen = document.getElementById('multipass-idp-create-open');
    if (createOpen) {
        createOpen.addEventListener('click', function () {
            resetForm();
            openDialog();
        });
    }
    document.querySelectorAll('[data-multipass-idp-edit]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var row = providerMap[String(btn.getAttribute('data-multipass-idp-edit') || '')] || null;
            if (!row) return;
            fillForm(row);
            openDialog();
        });
    });
    document.querySelectorAll('[data-multipass-idp-delete]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = parseInt(btn.getAttribute('data-multipass-idp-delete') || '0', 10) || 0;
            if (!id) return;
            var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
            var ask = (ui && typeof ui.confirm === 'function')
                ? ui.confirm(<?= json_encode((string)__('确认删除该官网登录提供方？'), JSON_UNESCAPED_UNICODE) ?>)
                : Promise.resolve(window.confirm(<?= json_encode((string)__('确认删除该官网登录提供方？'), JSON_UNESCAPED_UNICODE) ?>));
            Promise.resolve(ask).then(function (ok) {
                if (!ok) return;
                return multipassApi().then(function (api) {
                    return api.deleteIdentityProvider({ provider_id: id });
                }).then(function (res) {
                    var success = !!(res && res.success);
                    var msg = (res && res.message) ? String(res.message) : (success ? 'ok' : 'fail');
                    toast(success ? 'success' : 'error', msg);
                    if (success) window.location.reload();
                });
            }).catch(function (err) {
                toast('error', (err && err.message) ? String(err.message) : unavailableMsg);
            });
        });
    });

    form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var scopes = [];
        form.querySelectorAll('[data-idp-scope]').forEach(function (input) {
            if (input.checked) scopes.push(input.getAttribute('data-idp-scope'));
        });
        var payload = {
            provider_id: parseInt((field('provider_id') || {}).value || '0', 10) || 0,
            name: String((field('name') || {}).value || '').trim(),
            issuer_base_url: String((field('issuer_base_url') || {}).value || '').trim(),
            rest_base_url: String((field('rest_base_url') || {}).value || '').trim(),
            client_id: String((field('client_id') || {}).value || '').trim(),
            client_secret: String((field('client_secret') || {}).value || ''),
            redirect_uri: String((field('redirect_uri') || {}).value || '').trim(),
            scopes: scopes,
            status: String((field('status') || {}).value || 'active'),
            sort_order: parseInt((field('sort_order') || {}).value || '100', 10) || 100
        };
        setStatus('muted', <?= json_encode((string)__('保存中…'), JSON_UNESCAPED_UNICODE) ?>);
        multipassApi().then(function (api) {
            return api.saveIdentityProvider(payload);
        }).then(function (res) {
            var ok = !!(res && res.success);
            var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
            setStatus(ok ? 'success' : 'danger', msg);
            toast(ok ? 'success' : 'error', msg);
            if (ok) { closeDialog(); window.location.reload(); }
        }).catch(function (err) {
            var msg = (err && err.message) ? String(err.message) : unavailableMsg;
            setStatus('danger', msg);
            toast('error', msg);
        });
    });
})();
</script>
