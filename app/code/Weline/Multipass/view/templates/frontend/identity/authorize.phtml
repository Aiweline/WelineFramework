.multipass-auth__scope-list{display:grid;gap:var(--spacing-2_5)}
.multipass-auth__scope{display:grid;grid-template-columns:1fr auto;gap:var(--spacing-3);align-items:start;padding:var(--spacing-3_5) 0;border-bottom:var(--border-width-thin) solid var(--color-border-slate)}
.multipass-auth__scope:last-child{border-bottom:0}
.multipass-auth__scope-title{margin:0 0 var(--spacing-1);color:var(--mp-text);font-size:var(--font-size-sm);font-weight:800}
.multipass-auth__scope-desc{margin:0;color:var(--mp-muted);font-size:var(--font-size-13);line-height:1.55}
.multipass-auth__risk{min-width:56px;padding:var(--spacing-1) var(--spacing-0_55);border-radius:var(--radius-full);background:var(--color-success-bg-soft);color:var(--color-text-secondary);font-size:var(--font-size-xs);font-weight:800;text-align:center}
.multipass-auth__risk[data-risk=medium],.multipass-auth__risk[data-risk=high]{background:var(--color-bg-canvas);color:var(--mp-warning)}
.multipass-auth__actions{display:flex;justify-content:flex-end;gap:var(--spacing-3);margin-top:var(--spacing-6)}
.multipass-auth__button,.multipass-auth__link{min-height:var(--control-height-lg);padding:0 var(--spacing-4_5);border-radius:var(--radius-lg);display:inline-flex;align-items:center;justify-content:center;font-weight:800;text-decoration:none;cursor:pointer}
.multipass-auth__button{border:var(--border-width-thin) solid var(--mp-primary);background:var(--mp-primary);color:var(--color-text-light)}
.multipass-auth__button:hover{background:var(--mp-primary-strong)}
.multipass-auth__link{border:var(--border-width-thin) solid var(--color-border-muted);background:var(--color-bg-primary);color:var(--color-secondary-text-emphasis)}
.multipass-auth__footnote{margin:var(--spacing-4) 0 0;color:var(--mp-muted);font-size:var(--font-size-xs);line-height:1.6}
@media (max-width:640px){.multipass-auth__header,.multipass-auth__body{padding-left:var(--spacing-5);padding-right:var(--spacing-5)}.multipass-auth__title{font-size:var(--font-size-2xl)}.multipass-auth__actions{flex-direction:column-reverse}.multipass-auth__button,.multipass-auth__link{width:100%}}
</style>

<section class="multipass-auth" aria-labelledby="multipass-auth-title" weline-code="multipass.identity.multipass_auth_title">
    <div class="multipass-auth__card">
        <header class="multipass-auth__header">
            <p class="multipass-auth__eyebrow"><lang>Weline 账号授权</lang></p>
            <h1 class="multipass-auth__title" id="multipass-auth-title"><lang>授权应用访问你的 Weline 账号</lang></h1>
            <p class="multipass-auth__subtitle"><lang>请确认应用来源和请求权限。授权后，该应用可以用你的 Weline 账号完成登录和账号关联。</lang></p>
        </header>

        <div class="multipass-auth__body">
            <?php if ($error !== ''): ?>
                <div class="multipass-auth__notice multipass-auth__notice--error"><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></div>
            <?php elseif (!$user): ?>
                <div class="multipass-auth__notice"><lang>你还没有登录。登录后会回到这里继续确认授权。</lang></div>
            <?php endif; ?>

            <div class="multipass-auth__section">
                <p class="multipass-auth__label"><lang>请求授权的应用</lang></p>
                <div class="multipass-auth__identity">
                    <div class="multipass-auth__mark" aria-hidden="true">ID</div>
                    <div>
                        <p class="multipass-auth__name"><?= htmlspecialchars($appName, ENT_QUOTES, 'UTF-8') ?></p>
                        <?php if ($trustedDomain !== ''): ?><p class="multipass-auth__meta"><?= htmlspecialchars($trustedDomain, ENT_QUOTES, 'UTF-8') ?></p><?php endif; ?>
                    </div>
                </div>
            </div>

            <div class="multipass-auth__section">
                <p class="multipass-auth__label"><lang>当前 Weline 账号</lang></p>
                <?php if ($user): ?>
                    <div class="multipass-auth__identity">
                        <?php if ($avatar !== ''): ?>
                            <img class="multipass-auth__avatar" src="<?= htmlspecialchars($avatar, ENT_QUOTES, 'UTF-8') ?>" alt="<?= htmlspecialchars($username, ENT_QUOTES, 'UTF-8') ?>">
                        <?php else: ?>
                            <div class="multipass-auth__avatar-fallback" aria-hidden="true"><?= htmlspecialchars($avatarInitial, ENT_QUOTES, 'UTF-8') ?></div>
                        <?php endif; ?>
                        <div>
                            <p class="multipass-auth__name"><?= htmlspecialchars($username !== '' ? $username : (string) __('已登录用户'), ENT_QUOTES, 'UTF-8') ?></p>
                            <?php if ($email !== ''): ?><p class="multipass-auth__meta"><?= htmlspecialchars($email, ENT_QUOTES, 'UTF-8') ?></p><?php endif; ?>
                        </div>
                    </div>
                <?php else: ?>
                    <p class="multipass-auth__meta"><lang>登录后将显示你的账号信息，并由你决定是否继续授权。</lang></p>
                <?php endif; ?>
            </div>

            <div class="multipass-auth__section">
                <p class="multipass-auth__label"><lang>应用请求的权限</lang></p>
                <div class="multipass-auth__scope-list">
                    <?php foreach ($requestedScopeDetails as $scope): ?>
                        <?php
                        $scopeCode = (string) ($scope['scope'] ?? '');
                        $copy = $scopeCopy[$scopeCode] ?? [];
                        $scopeLabel = (string) ($copy['label'] ?? $scope['label'] ?? $scopeCode);
                        $scopeDescription = (string) ($copy['description'] ?? $scope['description'] ?? '');
                        $risk = (string) ($scope['risk'] ?? 'medium');
                        $riskLabel = $risk === 'low' ? (string) __('低风险') : (string) __('需确认');
                        ?>
                        <article class="multipass-auth__scope">
                            <div>
                                <p class="multipass-auth__scope-title"><?= htmlspecialchars($scopeLabel, ENT_QUOTES, 'UTF-8') ?></p>
                                <p class="multipass-auth__scope-desc"><?= htmlspecialchars($scopeDescription, ENT_QUOTES, 'UTF-8') ?></p>
                            </div>
                            <span class="multipass-auth__risk" data-risk="<?= htmlspecialchars($risk, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($riskLabel, ENT_QUOTES, 'UTF-8') ?></span>
                        </article>
                    <?php endforeach; ?>
                </div>
            </div>

            <?php if ($user && $error === ''): ?>
                <w:form method="post" action="@frontend-url{'multipass/frontend/identity/authorize'}" csrf="off">
                    <?= $this->getFormKey('multipass/frontend/identity/authorize') ?>
                    <input type="hidden" name="client_id" value="<?= htmlspecialchars($clientId, ENT_QUOTES, 'UTF-8') ?>">
                    <input type="hidden" name="redirect_uri" value="<?= htmlspecialchars($redirectUri, ENT_QUOTES, 'UTF-8') ?>">
                    <input type="hidden" name="scopes" value="<?= htmlspecialchars(implode(',', $requestedScopes), ENT_QUOTES, 'UTF-8') ?>">
                    <input type="hidden" name="state" value="<?= htmlspecialchars($state, ENT_QUOTES, 'UTF-8') ?>">
                    <div class="multipass-auth__actions">
                        <a class="multipass-auth__link" href="<?= htmlspecialchars($cancelUrl, ENT_QUOTES, 'UTF-8') ?>"><lang>取消</lang></a>
                        <button class="multipass-auth__button" type="submit"><lang>同意并继续</lang></button>
                    </div>
                </w:form>
            <?php else: ?>
                <div class="multipass-auth__actions">
                    <a class="multipass-auth__link" href="<?= htmlspecialchars($cancelUrl, ENT_QUOTES, 'UTF-8') ?>"><lang>取消</lang></a>
                    <a class="multipass-auth__button" href="<?php if ($loginUrl !== ''): ?><?= htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8') ?><?php else: ?>@url{$loginPath}<?php endif; ?>"><lang>登录后继续</lang></a>
                </div>
            <?php endif; ?>

            <p class="multipass-auth__footnote"><lang>如果你不认识这个应用或域名，请取消授权。</lang></p>
        </div>
    </div>
</section>
