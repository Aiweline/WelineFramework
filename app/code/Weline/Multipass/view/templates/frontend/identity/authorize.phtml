<?php
/** @var \Weline\Framework\View\Template $this */
/** @var \Weline\Multipass\Model\TrustedApp|null $app */
/** @var \Weline\Customer\Model\Customer|null $user */

$app = $this->getData('app');
$user = $this->getData('user');
$error = (string) ($this->getData('authorization_error') ?? '');
$redirectUri = (string) ($this->getData('redirect_uri') ?? '');
$state = (string) ($this->getData('state') ?? '');
$requestedScopes = (array) ($this->getData('requested_scopes') ?? []);
$requestedScopeDetails = (array) ($this->getData('requested_scope_details') ?? []);
$clientId = $app && method_exists($app, 'getClientId') ? (string) $app->getClientId() : '';
$appName = $app && method_exists($app, 'getName') ? (string) $app->getName() : (string) __('未知应用');
$trustedDomain = $app && method_exists($app, 'getTrustedDomain') ? (string) $app->getTrustedDomain() : '';
$email = $user && method_exists($user, 'getEmail') ? (string) $user->getEmail() : '';
$username = $user && method_exists($user, 'getUsername') ? (string) ($user->getUsername() ?? '') : '';
$avatar = $user && method_exists($user, 'getAvatar') ? (string) ($user->getAvatar() ?? '') : '';
$avatarInitial = $username !== '' ? mb_strtoupper(mb_substr($username, 0, 1)) : 'W';
$loginUrl = (string) ($this->getData('login_url') ?? '');
$loginPath = 'customer/account/login';
$cancelUrl = '/';
$scopeCopy = [
    'profile.basic' => ['label' => '基础资料', 'description' => '读取用户 ID、昵称和头像，用于识别当前账号。'],
    'profile.email' => ['label' => '邮箱地址', 'description' => '读取账号邮箱，用于登录识别和账号关联。'],
    'account.bind' => ['label' => '账号绑定', 'description' => '创建或更新该应用与你的 Weline 账号之间的关联。'],
    'appstore.account' => ['label' => '应用商城账号', 'description' => '创建或关联应用商城账号，实现一键登录和授权互通。'],
    'community.account' => ['label' => '社区账号', 'description' => '创建或关联论坛/社区账号，实现一键登录和授权互通。'],
];

if ($redirectUri !== '') {
    $cancelParams = ['error' => 'access_denied'];
    if ($state !== '') {
        $cancelParams['state'] = $state;
    }
    $cancelUrl = $redirectUri . (str_contains($redirectUri, '?') ? '&' : '?') . http_build_query($cancelParams);
}
?>
<style>
.multipass-auth{--mp-primary: var(--color-primary);--mp-primary-strong: var(--color-primary);--mp-warning: var(--color-warning);--mp-panel: var(--color-bg-primary);--mp-muted:#64748b;--mp-border: var(--color-border-slate);--mp-text:#0f172a;width:min(100%,760px);margin:0 auto;color:var(--mp-text)}
.multipass-auth__card{background:var(--mp-panel);border:var(--border-width-thin) solid var(--mp-border);border-radius:var(--radius-lg);box-shadow: var(--weline-shadow-md);overflow:hidden}
.multipass-auth__header{padding:var(--spacing-7) var(--spacing-7) var(--spacing-6);background:linear-gradient(135deg,var(--color-bg-panel) 0%,var(--color-bg-slate) 68%,var(--color-success-bg-soft) 100%);border-bottom:var(--border-width-thin) solid var(--mp-border)}
.multipass-auth__eyebrow{margin:0 0 var(--spacing-2);color:var(--mp-primary-strong);font-size:var(--font-size-13);font-weight:800}
.multipass-auth__title{margin:0;color:var(--mp-text);font-size:var(--font-size-3xl);line-height:1.25;letter-spacing:0}
.multipass-auth__subtitle{margin:var(--spacing-2_5) 0 0;max-width:620px;color:var(--color-product-label-demo-text);font-size:var(--font-size-sm);line-height:1.7}
.multipass-auth__body{padding:var(--spacing-7) var(--spacing-7) var(--spacing-7)}
.multipass-auth__notice{margin-bottom:var(--spacing-4_5);padding:var(--spacing-3_5) var(--spacing-4);border:var(--border-width-thin) solid #fed7aa;border-radius:var(--radius-lg);background:var(--color-bg-canvas);color:var(--color-text-muted);font-size:var(--font-size-sm);line-height:1.6}
.multipass-auth__notice--error{border-color:#fecaca;background:var(--color-bg-canvas);color:var(--color-link)}
.multipass-auth__section{padding:var(--spacing-4_5) 0;border-bottom:var(--border-width-thin) solid var(--color-border-slate)}
.multipass-auth__section:first-of-type{padding-top:0}
.multipass-auth__section:last-of-type{border-bottom:0}
