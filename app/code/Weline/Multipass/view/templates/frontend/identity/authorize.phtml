.multipass-auth__mark,.multipass-auth__avatar,.multipass-auth__avatar-fallback{width:50px;height:50px;border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;flex:0 0 auto;background:var(--mp-primary);color:var(--color-text-light);font-weight:900}
.multipass-auth__avatar,.multipass-auth__avatar-fallback{border-radius:50%}
.multipass-auth__avatar{object-fit:cover}
