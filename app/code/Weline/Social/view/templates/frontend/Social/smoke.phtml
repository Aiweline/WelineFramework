<?php
$accountResult = (array)($this->getData('account_result') ?? []);
$creativeResult = (array)($this->getData('creative_result') ?? []);
$batchResult = (array)($this->getData('batch_result') ?? []);
$website = (array)($this->getData('website') ?? []);
$relationResult = (array)($this->getData('relation_result') ?? []);
$resolveResult = (array)($this->getData('resolve_result') ?? []);
$noPublish = (bool)($this->getData('no_publish') ?? false);
$batch = is_array($batchResult['batch'] ?? null) ? $batchResult['batch'] : [];
$draft = is_array($creativeResult['draft'] ?? null) ? $creativeResult['draft'] : [];
$account = is_array($accountResult['account'] ?? null) ? $accountResult['account'] : [];
$resolvedAccounts = is_array($resolveResult['accounts'] ?? null) ? $resolveResult['accounts'] : [];
$relationPassed = !empty($relationResult['success']) && !empty($resolveResult['success']) && $resolvedAccounts !== [];
$passed = $noPublish
    ? (!empty($accountResult['success']) && $relationPassed)
    : (!empty($accountResult['success']) && !empty($creativeResult['success']) && !empty($batchResult['success']) && (string)($batch['status'] ?? '') === 'done');
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><lang>Weline Social Fake Smoke</lang></title>
    <style>
        body { margin: 0; font-family: Arial, sans-serif; background: var(--color-bg-panel); color: var(--color-text); }
        main { width: min(100%, var(--weline-layout-content-max-width)); margin: var(--weline-space-10) auto; padding: 0 var(--spacing-4_5); }
        .panel { background: var(--color-bg-primary); border: var(--border-width-thin) solid var(--color-border-muted); border-radius: var(--radius-lg); padding: var(--spacing-5_5); box-shadow: var(--weline-shadow-md); }
        .status { display: inline-flex; align-items: center; gap: var(--spacing-2); padding: var(--spacing-2) var(--spacing-3); border-radius: var(--radius-full); font-weight: 700; }
        .passed { background: var(--color-bg-muted); color: var(--color-text-secondary); }
        .failed { background: var(--color-bg-canvas); color: var(--color-link); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--spacing-3); margin-top: var(--spacing-4_5); }
        .card { border: var(--border-width-thin) solid var(--color-border-slate); border-radius: var(--radius-lg); padding: var(--spacing-3_5); background: var(--color-bg-slate); }
        .label { color: var(--color-link); font-size: var(--font-size-13); }
        .widget-smoke { margin-top: var(--spacing-4_5); border-top: var(--border-width-thin) solid var(--color-border-slate); padding-top: var(--spacing-4_5); }
        code { background: var(--color-bg-panel); padding: var(--spacing-0_5) var(--spacing-1_5); border-radius: var(--radius-md); }
    </style>
</head>
<body>
<main data-social-smoke="<?= $passed ? 'passed' : 'failed' ?>">
    <section class="panel" weline-code="social.smoke.section_1">
        <span class="status <?= $passed ? 'passed' : 'failed' ?>">
            <?= $passed ? __('Fake 验证通过') : __('Fake 验证失败') ?>
        </span>
        <h1><lang>Weline_Social Fake 模式</lang></h1>
        <p><?= $noPublish ? __('该页面只验证 fake 账户与站点默认社媒关系，不创建发布批次。') : __('该页面只调用 fake_browser Provider，不访问任何外部社媒平台。') ?></p>
        <div class="grid">
            <div class="w-card">
                <div class="label"><lang>账户</lang></div>
                <strong><?= $h((string)($account['account_name'] ?? '')) ?></strong>
                <div><code><?= $h((string)($account['test_status'] ?? '')) ?></code></div>
            </div>
            <div class="w-card">
                <div class="label"><lang>站点</lang></div>
                <strong><?= $h((string)($website['name'] ?? '')) ?></strong>
                <div><code><?= $h((string)($website['code'] ?? '')) ?></code></div>
            </div>
            <div class="w-card" data-social-site-account-smoke="<?= $relationPassed ? 'passed' : 'failed' ?>">
                <div class="label"><lang>站点社媒关系</lang></div>
                <strong><?= $relationPassed ? __('已打通') : __('未打通') ?></strong>
                <div><?= $h((string)($relationResult['message'] ?? '')) ?></div>
            </div>
            <div class="w-card">
                <div class="label"><lang>默认发布账户</lang></div>
                <strong><?= count($resolvedAccounts) ?></strong>
                <?php foreach ($resolvedAccounts as $resolvedAccount): ?>
                    <?php if (!is_array($resolvedAccount)) { continue; } ?>
                    <div><?= $h((string)($resolvedAccount['account_name'] ?? '')) ?> · <?= $h((string)($resolvedAccount['platform_code'] ?? '')) ?></div>
                <?php endforeach; ?>
            </div>
            <?php if (!$noPublish): ?>
            <div class="w-card">
                <div class="label"><lang>创意草稿</lang></div>
                <strong>#<?= (int)($draft['draft_id'] ?? 0) ?></strong>
                <div><?= $h((string)($draft['content'] ?? '')) ?></div>
            </div>
            <div class="w-card">
                <div class="label"><lang>发布批次</lang></div>
                <strong>#<?= (int)($batch['batch_id'] ?? 0) ?></strong>
                <div><code><?= $h((string)($batch['status'] ?? '')) ?></code></div>
            </div>
            <div class="w-card">
                <div class="label"><lang>目标结果</lang></div>
                <strong><?= (int)($batch['success_count'] ?? 0) ?>/<?= (int)($batch['target_count'] ?? 0) ?></strong>
                <?php foreach ((array)($batch['targets'] ?? []) as $target): ?>
                    <?php if (!is_array($target)) { continue; } ?>
                    <div><?= $h((string)($target['platform_code'] ?? '')) ?> · <?= $h((string)($target['status'] ?? '')) ?></div>
                <?php endforeach; ?>
            </div>
            <?php endif; ?>
        </div>
        <div class="widget-smoke" data-social-widget-smoke="mounted">
            <div class="label"><lang>社媒账户部件</lang></div>
            <w:widget type="social" name="social-accounts" params='{"title":"社媒账户部件","show_label":"1","limit":"8"}'/>
        </div>
    </section>
</main>
</body>
</html>
