<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('客户资产'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$form = (array)($this->getData('workspace_form') ?? []);
$kind = (string)($form['kind'] ?? '');
$formActionUrl = $form === [] ? '' : $this->getBackendUrl((string)($form['action'] ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) return $value ? (string)__('是') : (string)__('否');
    if (is_array($value)) return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    return $escape($value);
};
$websiteSelectValue = '0';
$websiteSelectOptions = [];
try {
    $queried = \w_query('websites', 'getWebsiteSelectOptions', [], 'backend');
    if (\is_array($queried)) {
        $websiteSelectOptions = $queried;
    }
} catch (\Throwable) {
    $websiteSelectOptions = [];
}
$websiteSelectDisplay = '';
foreach ($websiteSelectOptions as $option) {
    if (!\is_array($option)) {
        continue;
    }
    if ((string)($option['value'] ?? '') === $websiteSelectValue) {
        $websiteSelectDisplay = \trim((string)($option['label'] ?? ''));
        break;
    }
}
if ($websiteSelectDisplay === '' && $websiteSelectValue !== '') {
    $websiteSelectDisplay = '#' . $websiteSelectValue;
}
$websiteSelectOptionsJson = \json_encode($websiteSelectOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';
?>
<section class="commerce-control-center" data-testid="customer-asset-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="end"><span class="w-badge <?= $form === [] ? 'bg-info text-dark' : 'bg-success' ?>"><?= $form === [] ? __('只读诊断') : __('可管理') ?></span></div>
    <div class="w-alert" role="status" data-tone="info"><?= $form === [] ? __('此页面复用真实资产账本事实和迁移一致性算法；生产迁移不在后台触发。') : __('写操作复用 CustomerAsset 的事务、幂等和追加账本服务；测试验收使用 sandbox 命名空间。') ?></div>
    <?php if ($form !== []): ?>
        <div class="w-card" data-testid="customer-asset-<?= $escape($code) ?>-write-form" style="--w-mb:var(--weline-space-4);"><div class="w-card__header"><h5 style="--w-mb:0;"><?= __('资产操作') ?></h5></div><div class="w-card__body">
            <w:form method="post" action="@var($formActionUrl)"><div class="w-grid" style="--w-gap:var(--weline-space-4);">
                <?php if ($kind === 'credit' || $kind === 'reserve'): ?>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('客户 ID') ?></label><input class="w-input" name="customer_id" maxlength="64" required></div>
                    <div style="--w-span-md:3;"><label class="w-field__label"><?= __('网站') ?></label>
                        <w:websites:website:select
                            id="customer-asset-cc-website"
                            name="website_id"
                            value="websiteSelectValue"
                            display="websiteSelectDisplay"
                            options="websiteSelectOptionsJson"
                            multiple="false"
                            allow-empty="false"
                            empty-label="@lang(请选择站点)"
                            placeholder="@lang(搜索站点名称或编码)"
                        />
                    </div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('资产代码') ?></label><input class="w-input" name="asset_code" value="credit" maxlength="64" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('命名空间') ?></label><select class="w-select" name="namespace"><option value="sandbox">sandbox</option><option value="live">live</option></select></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('金额（分）') ?></label><input class="w-input" type="number" min="1" name="amount_minor" required></div>
                    <div style="--w-span-md:4;"><label class="w-field__label"><?= __('事件 ID') ?></label><input class="w-input" name="event_id" maxlength="128" required></div>
                <?php elseif ($kind === 'commit'): ?>
                    <div style="--w-span-md:5;"><label class="w-field__label"><?= __('预留 ID') ?></label><input class="w-input" name="reservation_id" maxlength="64" required></div>
                    <div style="--w-span-md:5;"><label class="w-field__label"><?= __('结算事件 ID') ?></label><input class="w-input" name="event_id" maxlength="128" required></div>
                <?php else: ?>
                    <div style="--w-span-md:4;"><label class="w-field__label"><?= __('已结算预留 ID') ?></label><input class="w-input" name="reservation_id" maxlength="64" required></div>
                    <div style="--w-span-md:2;"><label class="w-field__label"><?= __('退回金额（分）') ?></label><input class="w-input" type="number" min="1" name="amount_minor" required></div>
                    <div style="--w-span-md:4;"><label class="w-field__label"><?= __('退回事件 ID') ?></label><input class="w-input" name="event_id" maxlength="128" required></div>
                <?php endif; ?>
                <div class="w-cluster" data-align="end" style="--w-span-md:2;"><button class="w-button" type="submit" data-testid="customer-asset-<?= $escape($code) ?>-submit" data-w-width="full" data-tone="primary"><?= match ($kind) { 'credit' => __('入账'), 'reserve' => __('预留'), 'commit' => __('结算'), default => __('退回') } ?></button></div>
            </div></w:form>
        </div></div>
    <?php endif; ?>
    <?php if ($status !== []): ?><div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__body"><div class="w-grid" style="--w-gap:var(--weline-space-4);"><?php foreach ($status as $key => $value): ?><div style="--w-span-md:4;"><div class="w-text" data-tone="muted" data-size="sm"><?= $escape($key) ?></div><div class="w-text" data-weight="strong"><?= $display($value) ?></div></div><?php endforeach; ?></div></div></div><?php endif; ?>
    <?php foreach ($datasets as $dataset): ?><div class="w-card" style="--w-mb:var(--weline-space-4);"><div class="w-card__header"><h5 style="--w-mb:0;"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="w-card__body">
        <?php if (!empty($dataset['error'])): ?><div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= $escape($dataset['error']) ?></div><?php elseif (empty($dataset['rows'])): ?><div class="w-text" data-tone="muted"><?= __('当前没有记录。') ?></div><?php else: ?>
        <div class="w-table-wrap"><table class="w-table" data-w-vertical="middle" style="--w-mb:0;"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody><?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?></tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
