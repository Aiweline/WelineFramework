<?php
/**
 * Weline_CustomerAsset — official Customer account sidebar entry.
 *
 * Hook: account.sidebar
 *
 * @hook-priority 165
 * @hook-sort-order 11
 * @hook-solo false
 */
$accountIndexPath = parse_url(
    $this->getFrontendUrl('customer/account/index'),
    PHP_URL_PATH,
);
if (!is_string($accountIndexPath) || $accountIndexPath === '') {
    $accountIndexPath = '/customer/account/index';
}
$accountIndexPath = rtrim($accountIndexPath, '/');
?>
<a class="account-hook-nav-link" href="<?= htmlspecialchars($accountIndexPath, ENT_QUOTES, 'UTF-8') ?>#assets" data-section="assets" data-account-nav-link="true">
    <span class="account-hook-nav-link__label">
        <w:icon name="circle" size="sm"></w:icon>
        <span class="account-hook-nav-link__text">
            <strong><lang>我的资产</lang></strong>
            <span><lang>查看余额与最近变动</lang></span>
        </span>
    </span>
    <span class="account-hook-nav-link__arrow" aria-hidden="true">
        <w:icon name="circle" size="sm"></w:icon>
    </span>
</a>
