<?php
/**
 * Weline_CustomerAsset — read-only asset projection in the official account
 * layout. No Customer model/session access and no browser business request.
 *
 * Hook: account.sidebar.content
 *
 * @hook-priority 165
 * @hook-sort-order 11
 * @hook-solo false
 */
use Weline\Customer\Api\View\AccountSidebarProjectionProviderInterface;
use Weline\Customer\Service\AccountSidebarContentGate;
use Weline\CustomerAsset\Model\AssetLedger;
use Weline\CustomerAsset\Service\AccountAssetPresenter;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RuntimeProviderResolver;

if (!AccountSidebarContentGate::accepts('assets')) {
    return;
}
$projectionProvider = ObjectManager::getInstance(RuntimeProviderResolver::class)
    ->resolve(AccountSidebarProjectionProviderInterface::class);
if (!$projectionProvider instanceof AccountSidebarProjectionProviderInterface) {
    throw new \LogicException(
        'Required Customer account sidebar projection provider is unavailable.',
    );
}
$projection = $projectionProvider->forSections('assets');
if ($projection === null) {
    return;
}
/** @var AccountAssetPresenter $presenter */
$presenter = ObjectManager::getInstance(AccountAssetPresenter::class);
$assetView = $presenter->present(
    $projection->getCustomerId(),
    $projection->getWebsiteId(),
);
$escape = static fn (mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES,
    'UTF-8',
);
$amount = static fn (int $value): string => number_format($value, 0, '.', ',');
$assetLabels = [
    'credit' => (string)__('储值余额'),
    'points' => (string)__('积分'),
    'wcoin' => (string)__('WCoin'),
];
$eventLabels = [
    AssetLedger::TYPE_CREDIT => (string)__('增加'),
    AssetLedger::TYPE_RESERVE => (string)__('预占'),
    AssetLedger::TYPE_RELEASE => (string)__('释放'),
    AssetLedger::TYPE_COMMIT => (string)__('扣减'),
    AssetLedger::TYPE_RETURN => (string)__('返还'),
];
?>
<section class="account-hook-section account-index__section motor-account-section customer-asset-account" id="assets-section" data-account-section="assets" hidden aria-labelledby="customerAssetTitle" weline-code="customer_asset.hook.account_sidebar_content.assets_section">
    <div class="account-card customer-asset-account__panel">
        <header class="account-card__header customer-asset-account__header">
            <div>
                <h2 class="account-card__title" id="customerAssetTitle"><lang>我的资产</lang></h2>
                <p class="customer-asset-account__description"><lang>当前站点的资产余额与最近账本记录。</lang></p>
            </div>
            <span class="customer-asset-account__scope"><lang>当前站点</lang></span>
        </header>
        <div class="account-card__body">
            <?php if ($assetView['state'] === 'unauthenticated'): ?>
                <div class="customer-asset-account__state" role="status">
                    <w:icon name="lock" size="sm"></w:icon>
                    <div>
                        <strong><lang>需要登录</lang></strong>
                        <p><lang>登录后可查看当前站点的资产余额和最近变动。</lang></p>
                    </div>
                </div>
            <?php elseif ($assetView['state'] === 'error'): ?>
                <div class="customer-asset-account__state customer-asset-account__state--error" role="alert">
                    <w:icon name="warning" size="sm"></w:icon>
                    <div>
                        <strong><lang>暂时无法读取资产</lang></strong>
                        <p><lang>请稍后重试；资产账本不会因此发生变化。</lang></p>
                    </div>
                </div>
            <?php elseif ($assetView['state'] === 'empty'): ?>
                <div class="customer-asset-account__state" role="status">
                    <w:icon name="circle" size="sm"></w:icon>
                    <div>
                        <strong><lang>还没有资产账户</lang></strong>
                        <p><lang>使用支持的储值、积分或 WCoin 后，余额会显示在这里。</lang></p>
                    </div>
                </div>
            <?php else: ?>
                <div class="customer-asset-account__grid" role="list">
                    <?php foreach ($assetView['accounts'] as $account): ?>
                        <?php
                        $assetCode = (string)$account['asset_code'];
                        $assetLabel = $assetLabels[$assetCode] ?? strtoupper($assetCode);
                        ?>
                        <article class="customer-asset-account__asset" role="listitem">
                            <header class="customer-asset-account__asset-header">
                                <div>
                                    <span class="customer-asset-account__eyebrow"><lang>资产账户</lang></span>
                                    <h3><?= $escape($assetLabel) ?></h3>
                                </div>
                                <span class="customer-asset-account__code"><?= $escape($assetCode) ?></span>
                            </header>
                            <div class="customer-asset-account__balances" role="list">
                                <div class="customer-asset-account__balance customer-asset-account__balance--primary" role="listitem">
                                    <span class="customer-asset-account__balance-label"><lang>可用余额</lang></span>
                                    <strong class="customer-asset-account__amount"><?= $amount((int)$account['available_minor']) ?></strong>
                                </div>
                                <div class="customer-asset-account__balance" role="listitem">
                                    <span class="customer-asset-account__balance-label"><lang>已预占</lang></span>
                                    <strong class="customer-asset-account__amount"><?= $amount((int)$account['reserved_minor']) ?></strong>
                                </div>
                                <div class="customer-asset-account__balance" role="listitem">
                                    <span class="customer-asset-account__balance-label"><lang>当前可使用</lang></span>
                                    <strong class="customer-asset-account__amount"><?= $amount((int)$account['reservable_minor']) ?></strong>
                                </div>
                            </div>
                            <p class="customer-asset-account__unit"><lang>余额按资产最小单位展示</lang></p>
                            <div class="customer-asset-account__ledger">
                                <h4><lang>最近变动</lang></h4>
                                <?php if ($account['ledger'] === []): ?>
                                    <p class="customer-asset-account__ledger-empty"><lang>暂无账本记录</lang></p>
                                <?php else: ?>
                                    <ol>
                                        <?php foreach ($account['ledger'] as $entry): ?>
                                            <?php
                                            $eventType = (string)$entry['event_type'];
                                            $eventLabel = $eventLabels[$eventType] ?? $eventType;
                                            $eventModifier = isset($eventLabels[$eventType])
                                                ? $eventType
                                                : 'unknown';
                                            $timestamp = strtotime((string)$entry['created_at']);
                                            ?>
                                            <li>
                                                <span class="customer-asset-account__event customer-asset-account__event--<?= $escape($eventModifier) ?>"><?= $escape($eventLabel) ?></span>
                                                <strong><?= $amount((int)$entry['amount_minor']) ?></strong>
                                                <time datetime="<?= $timestamp ? date('c', $timestamp) : '' ?>"><?= $timestamp ? date('Y-m-d H:i', $timestamp) : '-' ?></time>
                                            </li>
                                        <?php endforeach; ?>
                                    </ol>
                                <?php endif; ?>
                            </div>
                        </article>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
</section>

