<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var list<array<string,mixed>> $reviews
 * @var array<string,mixed> $pagination
 * @var int $total
 * @var string $status_filter
 * @var string $website_id_filter
 * @var string $store_id_filter
 * @var list<string> $allowed_statuses
 * @var string $websiteSelectValue
 * @var string $websiteSelectDisplay
 * @var string $websiteSelectOptionsJson
 * @var string $storeSelectValue
 * @var string $storeSelectDisplay
 * @var string $storeSelectOptionsJson
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : (string)json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$statusLabels = [
    'pending' => __('等待 AI 预审'),
    'ai_pending_blocked' => __('AI 审核待人工'),
    'approved' => __('已通过'),
    'rejected' => __('已拒绝'),
];
$statusBackgrounds = [
    'pending' => 'warning',
    'ai_pending_blocked' => 'info',
    'approved' => 'success',
    'rejected' => 'danger',
];
$currentStatus = (string)($status_filter ?? '');
$currentWebsiteId = trim((string)($website_id_filter ?? ''));
$currentStoreId = trim((string)($store_id_filter ?? ''));
$websiteSelectValue = (string)($websiteSelectValue ?? $currentWebsiteId);
$websiteSelectDisplay = (string)($websiteSelectDisplay ?? '');
$websiteSelectOptionsJson = (string)($websiteSelectOptionsJson ?? '[]');
$storeSelectValue = (string)($storeSelectValue ?? $currentStoreId);
$storeSelectDisplay = (string)($storeSelectDisplay ?? '');
$storeSelectOptionsJson = (string)($storeSelectOptionsJson ?? '[]');
$totalText = $escape($total ?? 0);
$statusOptionsHtml = '<option value=""' . ($currentStatus === '' ? ' selected' : '') . '>'
    . $escape(__('全部状态')) . '</option>';
foreach (($allowed_statuses ?? []) as $statusOption) {
    $statusOption = (string)$statusOption;
    $statusOptionsHtml .= '<option value="' . $escape($statusOption) . '"'
        . ($currentStatus === $statusOption ? ' selected' : '') . '>'
        . $escape($statusLabels[$statusOption] ?? $statusOption) . '</option>';
}
$filterQuery = [];
if ($currentStatus !== '') {
    $filterQuery['status'] = $currentStatus;
}
if ($currentWebsiteId !== '') {
    $filterQuery['website_id'] = $currentWebsiteId;
}
if ($currentStoreId !== '') {
    $filterQuery['store_id'] = $currentStoreId;
}
$filterQueryBase = $filterQuery === [] ? '?' : ('?' . http_build_query($filterQuery) . '&');

$rowsHtml = '';
foreach (($reviews ?? []) as $review) {
    $reviewId = (int)($review['review_id'] ?? 0);
    $status = (string)($review['status'] ?? '');
    $media = is_array($review['media'] ?? null) ? $review['media'] : [];
    $ratings = is_array($review['ratings'] ?? null) ? $review['ratings'] : [];
    $emailHtml = (string)($review['reviewer_email'] ?? '') !== ''
        ? '<small class="w-text" data-tone="muted" data-size="sm">' . $escape($review['reviewer_email']) . '</small>'
        : '';
    $titleHtml = (string)($review['title'] ?? '') !== ''
        ? '<strong class="w-text" data-weight="strong">' . $escape($review['title']) . '</strong>'
        : '';
    $ratingsHtml = '<strong class="w-text" data-tone="warning" data-weight="strong">'
        . str_repeat('★', max(1, min(5, (int)($review['rating'] ?? 5))))
        . '</strong>';
    if ($ratings !== []) {
        $ratingsHtml = '<div class="w-stack" data-review-role="rating-breakdown" style="--w-gap:var(--weline-space-1)">';
        foreach ($ratings as $ratingItem) {
            $ratingValue = max(1, min((int)($ratingItem['max'] ?? 5), (int)($ratingItem['value'] ?? 0)));
            $ratingsHtml .= '<div><small class="w-text" data-tone="muted" data-size="sm">' . $escape($ratingItem['label'] ?? '')
                . '</small><strong class="w-text" data-tone="warning" data-weight="strong" aria-label="'
                . $escape(($ratingItem['label'] ?? '') . ' ' . $ratingValue . '/5') . '">'
                . str_repeat('★', $ratingValue) . '</strong></div>';
        }
        $ratingsHtml .= '</div>';
    }
    $mediaHtml = '<span class="w-text" data-tone="muted">' . $escape(__('无媒体')) . '</span>';
    if ($media !== []) {
        $mediaHtml = '<div class="w-cluster w-review-media" data-wrap="true" data-review-role="media">';
        foreach ($media as $item) {
            $kind = (string)($item['kind'] ?? '');
            $url = $escape($item['url'] ?? '');
            $mediaHtml .= '<figure class="w-review-media__item">';
            if ($kind === 'video') {
                $mediaHtml .= '<video src="' . $url
                    . '" controls preload="metadata"></video>';
            } else {
                $mediaHtml .= '<img src="' . $url . '" alt="'
                    . $escape($item['name'] ?? __('评论图片'))
                    . '" loading="lazy">';
            }
            $mediaHtml .= '<figcaption class="w-text" data-tone="muted" data-size="xs">'
                . ($kind === 'video' ? 'VIDEO' : 'PHOTO') . '</figcaption></figure>';
        }
        $mediaHtml .= '</div>';
    }
    $approveDisabled = $status === 'approved' ? ' disabled' : '';
    $rejectDisabled = $status === 'rejected' ? ' disabled' : '';
    $awaitingAi = $status === 'pending';
    $humanActions = $status === 'ai_pending_blocked'
        || $status === 'approved'
        || $status === 'rejected';
    $actionsHtml = '';
    if ($awaitingAi) {
        $actionsHtml = '<span class="w-badge" data-w-background="info" data-review-role="awaiting-ai">'
            . $escape(__('等待 AI 预审')) . '</span>';
    } elseif ($humanActions) {
        $actionsHtml = '<div class="w-cluster" data-wrap="true">'
            . '<button class="w-button" data-size="sm" data-tone="success" type="button" data-review-role="approve" data-review-action="approved"'
            . ' data-review-id="' . $escape($reviewId) . '"' . $approveDisabled
            . '>' . $escape(__('通过')) . '</button>'
            . '<button class="w-button" data-size="sm" data-tone="danger" data-variant="outline" type="button" data-review-role="reject" data-review-action="rejected"'
            . ' data-review-id="' . $escape($reviewId) . '"' . $rejectDisabled
            . '>' . $escape(__('拒绝')) . '</button>'
            . '</div>';
    } else {
        $actionsHtml = '<span class="w-text" data-tone="muted" data-size="sm">—</span>';
    }
    $rowsHtml .= '<tr data-review-role="row" data-review-id="' . $escape($reviewId) . '">'
        . '<td style="width:18%">' . $ratingsHtml
        . '<div class="w-text" data-weight="strong">' . $escape($review['reviewer'] ?? '') . '</div>'
        . $emailHtml . '</td>'
        . '<td style="width:34%">' . $titleHtml
        . '<details><summary class="w-text" data-size="sm">' . $escape(__('查看详细内容'))
        . '</summary><p class="w-text">'
        . $escape($review['content'] ?? '') . '</p></details></td>'
        . '<td style="width:22%">' . $mediaHtml . '</td>'
        . '<td><div class="w-stack" data-gap="sm"><span class="w-badge" data-w-background="muted">'
        . $escape($review['type_code'] ?? 'product') . '</span><code class="w-review-admin__entity-id">'
        . $escape($review['entity_uuid'] ?? '') . '</code><small class="w-text" data-tone="muted" data-size="sm">Website '
        . $escape($review['website_id'] ?? 0) . ' / Store ' . $escape($review['store_id'] ?? 0)
        . '</small></div></td>'
        . '<td><span class="w-badge" data-w-background="' . $escape($statusBackgrounds[$status] ?? 'muted')
        . '" data-review-role="status">' . $escape($statusLabels[$status] ?? $status) . '</span></td>'
        . '<td><span class="w-text" data-tone="muted" data-size="sm">' . $escape($review['created_at'] ?? '') . '</span></td>'
        . '<td><div class="w-cluster" data-gap="sm">' . $actionsHtml . '</div></td></tr>';
}

$tableHeadHtml = '<thead><tr><th>' . $escape(__('评分与评论者')) . '</th><th>' . $escape(__('评论内容'))
    . '</th><th>' . $escape(__('图片与视频')) . '</th><th>' . $escape(__('评论对象'))
    . '</th><th>' . $escape(__('状态')) . '</th><th>' . $escape(__('提交时间'))
    . '</th><th>' . $escape(__('操作')) . '</th></tr></thead>';
$tableBodyHtml = $rowsHtml !== ''
    ? $rowsHtml
    : ('<tr><td colspan="7"><div class="w-empty" data-review-role="empty">'
        . '<p class="w-text" data-tone="muted" style="--w-mb:0">' . $escape(__('暂无评论')) . '</p></div></td></tr>');
$tableInnerHtml = $tableHeadHtml . '<tbody>' . $tableBodyHtml . '</tbody>';

$currentPage = max(1, (int)($pagination['page'] ?? 1));
$totalPages = max(1, (int)($pagination['lastPage'] ?? 1));
$paginationHtml = '';
if ($totalPages > 1) {
    $paginationHtml = '<nav class="w-pagination" aria-label="' . $escape(__('评论分页')) . '">';
    if ($currentPage > 1) {
        $paginationHtml .= '<a class="w-pagination__link" href="' . $escape($filterQueryBase . 'page=' . ($currentPage - 1))
            . '">' . $escape(__('上一页')) . '</a>';
    }
    $paginationHtml .= '<span class="w-pagination__item" aria-current="page">' . $escape((string)$currentPage) . ' / ' . $escape((string)$totalPages) . '</span>';
    if ($currentPage < $totalPages) {
        $paginationHtml .= '<a class="w-pagination__link" href="' . $escape($filterQueryBase . 'page=' . ($currentPage + 1))
            . '">' . $escape(__('下一页')) . '</a>';
    }
    $paginationHtml .= '</nav>';
}
?>
<css>Weline_Review::css/backend/review-admin.css</css>
<div class="w-stack" data-review-role="management" data-weline-load="reviewAdmin">
    <div class="w-card">
        <div class="w-card__body">
            <form method="get" class="w-cluster" data-align="end" data-wrap="true" data-review-role="filters" style="--w-gap:var(--weline-space-3);">
                <div class="w-field">
                    <label class="w-field__label" for="review-website_trigger"><lang>网站</lang></label>
                    <w:websites:website:select
                        id="review-website"
                        name="website_id"
                        value="websiteSelectValue"
                        display="websiteSelectDisplay"
                        options="websiteSelectOptionsJson"
                        multiple="false"
                        allow-empty="true"
                        clearable="true"
                        empty-label="@lang(全部网站)"
                        placeholder="@lang(搜索网站名称或编码)"
                        on-change="var s=document.getElementById('review-store');if(s){s.value='';s.dispatchEvent(new Event('change',{bubbles:true}));}"
                    />
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="review-store_trigger"><lang>店铺</lang></label>
                    <w:websites:store:select
                        id="review-store"
                        name="store_id"
                        value="storeSelectValue"
                        options="storeSelectOptionsJson"
                        allow-empty="true"
                        clearable="true"
                        empty-label="@lang(全部店铺)"
                        placeholder="@lang(搜索店铺)"
                    />
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="review-status"><lang>状态</lang></label>
                    <select class="w-select" id="review-status" name="status"><?php echo $statusOptionsHtml; ?></select>
                </div>
                <button class="w-button" type="submit" data-tone="primary"><lang>筛选</lang></button>
                <span class="w-text" data-tone="muted" data-size="sm"><lang>统一管理文字、图片与视频评论</lang> · <?php echo $totalText; ?></span>
            </form>
        </div>
    </div>
    <div class="w-card">
        <div class="w-table-wrap" data-review-role="table-scroll" aria-label="@lang(评论列表)">
            <table class="w-table">
                <?php echo $tableInnerHtml; ?>
            </table>
        </div>
    </div>
    <?php echo $paginationHtml; ?>
    <w:form method="post" action="@backend-url('*/backend/review/moderate')" csrf="auto" data-review-role="moderation-form" style="display:none">
        <input type="hidden" name="review_id" value="">
        <input type="hidden" name="status" value="">
        <input type="hidden" name="status_filter" value="">
        <input type="hidden" name="website_id_filter" value="">
        <input type="hidden" name="store_id_filter" value="">
    </w:form>
</div>
