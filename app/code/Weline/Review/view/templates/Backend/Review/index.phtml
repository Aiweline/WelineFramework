<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var list<array<string,mixed>> $reviews
 * @var array<string,mixed> $pagination
 * @var int $total
 * @var string $status_filter
 * @var string $website_id_filter
 * @var string $store_id_filter
 * @var list<string> $allowed_statuses
 * @var string $websiteSelectValue
 * @var string $websiteSelectDisplay
 * @var string $websiteSelectOptionsJson
 * @var string $storeSelectValue
 * @var string $storeSelectDisplay
 * @var string $storeSelectOptionsJson
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : (string)json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$statusLabels = [
    'pending' => __('等待 AI 预审'),
    'ai_pending_blocked' => __('AI 审核待人工'),
    'approved' => __('已通过'),
    'rejected' => __('已拒绝'),
];
$statusClasses = [
    'pending' => 'is-warning',
    'ai_pending_blocked' => 'is-info',
    'approved' => 'is-success',
    'rejected' => 'is-danger',
];
$currentStatus = (string)($status_filter ?? '');
$currentWebsiteId = trim((string)($website_id_filter ?? ''));
$currentStoreId = trim((string)($store_id_filter ?? ''));
$websiteSelectValue = (string)($websiteSelectValue ?? $currentWebsiteId);
$websiteSelectDisplay = (string)($websiteSelectDisplay ?? '');
$websiteSelectOptionsJson = (string)($websiteSelectOptionsJson ?? '[]');
$storeSelectValue = (string)($storeSelectValue ?? $currentStoreId);
$storeSelectDisplay = (string)($storeSelectDisplay ?? '');
$storeSelectOptionsJson = (string)($storeSelectOptionsJson ?? '[]');
$totalText = $escape($total ?? 0);
$statusOptionsHtml = '<option value=""' . ($currentStatus === '' ? ' selected' : '') . '>'
    . $escape(__('全部状态')) . '</option>';
foreach (($allowed_statuses ?? []) as $statusOption) {
    $statusOption = (string)$statusOption;
    $statusOptionsHtml .= '<option value="' . $escape($statusOption) . '"'
        . ($currentStatus === $statusOption ? ' selected' : '') . '>'
        . $escape($statusLabels[$statusOption] ?? $statusOption) . '</option>';
}
$filterQuery = [];
if ($currentStatus !== '') {
    $filterQuery['status'] = $currentStatus;
}
if ($currentWebsiteId !== '') {
    $filterQuery['website_id'] = $currentWebsiteId;
}
if ($currentStoreId !== '') {
    $filterQuery['store_id'] = $currentStoreId;
}
$filterQueryBase = $filterQuery === [] ? '?' : ('?' . http_build_query($filterQuery) . '&');

$rowsHtml = '';
foreach (($reviews ?? []) as $review) {
    $reviewId = (int)($review['review_id'] ?? 0);
    $status = (string)($review['status'] ?? '');
    $media = is_array($review['media'] ?? null) ? $review['media'] : [];
    $ratings = is_array($review['ratings'] ?? null) ? $review['ratings'] : [];
    $emailHtml = (string)($review['reviewer_email'] ?? '') !== ''
        ? '<small class="w-text" data-tone="muted" data-size="sm">' . $escape($review['reviewer_email']) . '</small>'
        : '';
    $titleHtml = (string)($review['title'] ?? '') !== ''
        ? '<strong class="w-review-admin__title">' . $escape($review['title']) . '</strong>'
        : '';
    $ratingsHtml = '<strong class="w-review-admin__stars">'
        . str_repeat('★', max(1, min(5, (int)($review['rating'] ?? 5))))
        . '</strong>';
    if ($ratings !== []) {
        $ratingsHtml = '<div class="w-stack" data-review-role="rating-breakdown" style="--w-gap:var(--weline-space-1)">';
        foreach ($ratings as $ratingItem) {
            $ratingValue = max(1, min((int)($ratingItem['max'] ?? 5), (int)($ratingItem['value'] ?? 0)));
            $ratingsHtml .= '<div><small class="w-text" data-tone="muted" data-size="sm">' . $escape($ratingItem['label'] ?? '')
                . '</small><strong class="w-review-admin__stars" aria-label="'
                . $escape(($ratingItem['label'] ?? '') . ' ' . $ratingValue . '/5') . '">'
                . str_repeat('★', $ratingValue) . '</strong></div>';
        }
        $ratingsHtml .= '</div>';
    }
    $mediaHtml = '<span class="w-text" data-tone="muted">' . $escape(__('无媒体')) . '</span>';
    if ($media !== []) {
        $mediaHtml = '<div class="w-cluster" data-wrap="true" data-review-role="media">';
        foreach ($media as $item) {
            $kind = (string)($item['kind'] ?? '');
            $url = $escape($item['url'] ?? '');
            $mediaHtml .= '<figure class="w-review-admin__media-item">';
            if ($kind === 'video') {
                $mediaHtml .= '<video src="' . $url
                    . '" controls preload="metadata"></video>';
            } else {
                $mediaHtml .= '<img src="' . $url . '" alt="'
                    . $escape($item['name'] ?? __('评论图片'))
                    . '" loading="lazy">';
            }
            $mediaHtml .= '<figcaption class="w-review-admin__media-cap">'
                . ($kind === 'video' ? 'VIDEO' : 'PHOTO') . '</figcaption></figure>';
        }
        $mediaHtml .= '</div>';
    }
    $approveDisabled = $status === 'approved' ? ' disabled' : '';
    $rejectDisabled = $status === 'rejected' ? ' disabled' : '';
    $awaitingAi = $status === 'pending';
    $humanActions = $status === 'ai_pending_blocked'
        || $status === 'approved'
        || $status === 'rejected';
    $actionsHtml = '';
    if ($awaitingAi) {
        $actionsHtml = '<span class="w-badge is-info" data-review-role="awaiting-ai">'
            . $escape(__('等待 AI 预审')) . '</span>';
    } elseif ($humanActions) {
        $actionsHtml = '<div class="w-cluster" data-wrap="true">'
            . '<button class="w-button" data-size="sm" data-tone="success" type="button" data-review-role="approve" data-review-action="approved"'
            . ' data-review-id="' . $escape($reviewId) . '"' . $approveDisabled
            . '>' . $escape(__('通过')) . '</button>'
            . '<button class="w-button" data-size="sm" data-tone="danger" data-variant="outline" type="button" data-review-role="reject" data-review-action="rejected"'
            . ' data-review-id="' . $escape($reviewId) . '"' . $rejectDisabled
            . '>' . $escape(__('拒绝')) . '</button>'
            . '</div>';
    } else {
        $actionsHtml = '<span class="w-text" data-tone="muted" data-size="sm">—</span>';
    }
    $rowsHtml .= '<tr data-review-role="row" data-review-id="' . $escape($reviewId) . '">'
        . '<td style="min-width:190px">' . $ratingsHtml
        . '<div class="w-text" data-weight="strong">' . $escape($review['reviewer'] ?? '') . '</div>'
        . $emailHtml . '</td>'
        . '<td style="min-width:280px;max-width:460px">' . $titleHtml
        . '<details><summary class="w-review-admin__summary">' . $escape(__('查看详细内容'))
        . '</summary><p class="w-review-admin__body">'
        . $escape($review['content'] ?? '') . '</p></details></td>'
        . '<td style="min-width:240px">' . $mediaHtml . '</td>'
        . '<td style="min-width:210px"><span class="w-badge">'
        . $escape($review['type_code'] ?? 'product') . '</span><code>'
        . $escape($review['entity_uuid'] ?? '') . '</code><small class="w-text" data-tone="muted" data-size="sm">Website '
        . $escape($review['website_id'] ?? 0) . ' / Store ' . $escape($review['store_id'] ?? 0)
        . '</small></td>'
        . '<td><span class="w-badge ' . $escape($statusClasses[$status] ?? '')
        . '" data-review-role="status">' . $escape($statusLabels[$status] ?? $status) . '</span></td>'
        . '<td style="min-width:150px">' . $escape($review['created_at'] ?? '') . '</td>'
        . '<td data-w-sticky="end">' . $actionsHtml . '</td></tr>';
}

$tableHeadHtml = '<thead><tr><th>' . $escape(__('评分与评论者')) . '</th><th>' . $escape(__('评论内容'))
    . '</th><th>' . $escape(__('图片与视频')) . '</th><th>' . $escape(__('评论对象'))
    . '</th><th>' . $escape(__('状态')) . '</th><th>' . $escape(__('提交时间'))
    . '</th><th data-w-sticky="end">' . $escape(__('操作')) . '</th></tr></thead>';
$tableBodyHtml = $rowsHtml !== ''
    ? $rowsHtml
    : ('<tr><td colspan="7"><div class="w-text" data-align="center" data-tone="muted" data-review-role="empty" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12)">'
        . '<p style="--w-mb:0">' . $escape(__('暂无评论')) . '</p></div></td></tr>');
$tableInnerHtml = $tableHeadHtml . '<tbody>' . $tableBodyHtml . '</tbody>'; else {
    $emptyHtml = '';
    $tableInnerHtml = '<thead><tr><th>' . $escape(__('评分与评论者')) . '</th><th>' . $escape(__('评论内容'))
        . '</th><th>' . $escape(__('图片与视频')) . '</th><th>' . $escape(__('评论对象'))
        . '</th><th>' . $escape(__('状态')) . '</th><th>' . $escape(__('提交时间'))
        . '</th><th data-w-sticky="end">' . $escape(__('操作')) . '</th></tr></thead><tbody>'
        . $rowsHtml . '</tbody>';
}

$currentPage = max(1, (int)($pagination['page'] ?? 1));
$totalPages = max(1, (int)($pagination['lastPage'] ?? 1));
$paginationHtml = '';
if ($totalPages > 1) {
    $paginationHtml = '<nav class="w-cluster" style="--w-mt:var(--weline-space-3)" aria-label="' . $escape(__('评论分页')) . '">';
    if ($currentPage > 1) {
        $paginationHtml .= '<a class="w-button" data-tone="neutral" data-variant="outline" href="' . $escape($filterQueryBase . 'page=' . ($currentPage - 1))
            . '">' . $escape(__('上一页')) . '</a>';
    }
    if ($currentPage < $totalPages) {
        $paginationHtml .= '<a class="w-button" data-tone="neutral" data-variant="outline" href="' . $escape($filterQueryBase . 'page=' . ($currentPage + 1))
            . '">' . $escape(__('下一页')) . '</a>';
    }
    $paginationHtml .= '</nav>';
}
?>
