<script>
(function(){
    'use strict';
    const messages=<?= $json($messages) ?>;
    const unwrap=result=>result&&result.data&&typeof result.data==='object'&&result.success===undefined?result.data:result;
    const make=(tag,className,text)=>{const node=document.createElement(tag);if(className)node.className=className;if(typeof text==='string')node.textContent=text;return node;};
    const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
    async function resolveApi(){
        for(let attempt=0;attempt<60;attempt+=1){
            if(window.Weline&&window.Weline.Api&&typeof window.Weline.Api.resource==='function')return window.Weline.Api.resource('review');
            if(window.Weline&&typeof window.Weline.load==='function'){try{await window.Weline.load('api');}catch(error){}}
            await wait(100);
        }
        throw new Error(messages.loadFailed);
    }
    function fileToBase64(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||'').split(',').pop()||'');reader.onerror=()=>reject(new Error(messages.mediaInvalid));reader.readAsDataURL(file);});}
    document.querySelectorAll('[data-review-root]').forEach(function(root){
        if(root.dataset.reviewBound==='1')return;root.dataset.reviewBound='1';
        const typeCode=root.dataset.typeCode||'product';const entityUuid=root.dataset.entityUuid||'';
        const fieldsRoot=root.querySelector('[data-review-fields]');const itemsRoot=root.querySelector('[data-review-items]');const previewRoot=root.querySelector('[data-review-preview]');const form=root.querySelector('[data-review-form]');const submit=root.querySelector('[data-review-submit]');const feedback=root.querySelector('[data-review-message]');const average=root.querySelector('[data-review-average]');const count=root.querySelector('[data-review-count]');
        let apiPromise=null;let schemaFields=[];const api=()=>apiPromise||(apiPromise=resolveApi());
        function paintRatingGroup(group,preview){const inputs=Array.from(group.querySelectorAll('input[type=radio]'));const selected=Number((inputs.find(input=>input.checked)||{}).value||0);const active=preview===undefined?selected:Number(preview||0);group.querySelectorAll('.weline-review__rating-choice').forEach((choice,index)=>{const value=Number(choice.dataset.value||0);choice.classList.toggle('is-filled',value<=active);choice.classList.toggle('is-preview',preview!==undefined&&value<=active);choice.classList.toggle('is-current',value===selected);choice.setAttribute('aria-checked',value===selected?'true':'false');choice.tabIndex=(selected?value===selected:index===0)?0:-1;});}
        function chooseRating(group,value,focus){const input=group.querySelector('input[value="'+String(value)+'"]');if(!input)return;input.checked=true;input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));paintRatingGroup(group);if(focus)input.closest('.weline-review__rating-choice')?.focus();}
        function fieldInput(field){
            const wrap=make('div','weline-review__field');const id='review-'+field.key+'-'+entityUuid;const label=make('label','',String(field.label||field.key));label.htmlFor=id;if(field.required)label.appendChild(make('span','weline-review__required',' *'));
            if(field.type==='checkbox'){
                const row=make('label','weline-review__checkbox');const input=make('input');input.type='checkbox';input.id=id;input.name=field.key;input.checked=field.default===true;row.append(input,document.createTextNode(String(field.label||field.key)));wrap.appendChild(row);return wrap;
            }
            if(field.type==='image'||field.type==='video'){
                const upload=make('label','weline-review__upload');upload.htmlFor=id;const icon=make('span','weline-review__upload-icon',field.type==='image'?'IMG':'VID');const copy=make('span','weline-review__upload-copy');copy.append(make('strong','',String(field.label||field.key)),make('small','',field.type==='image'?messages.imageLimit:messages.videoLimit));const action=make('span','weline-review__upload-action',String(field.label||field.key));const input=make('input');input.type='file';input.id=id;input.name=field.key;input.accept=field.accept||'';input.multiple=Number(field.max_files||1)>1;input.dataset.kind=field.type;input.dataset.maxFiles=String(field.max_files||1);input.dataset.maxSize=String(field.max_size||0);input.addEventListener('change',renderPreviews);upload.append(icon,copy,action,input);wrap.appendChild(upload);return wrap;
            }
            wrap.appendChild(label);
            if(field.type==='rating'){
                const group=make('div','weline-review__rating-stars');group.setAttribute('role','radiogroup');group.setAttribute('aria-label',String(field.label||field.key));const min=Math.max(1,Number(field.min||1));const max=Math.max(min,Number(field.max||5));
                for(let star=min;star<=max;star+=1){const choice=make('label','weline-review__rating-choice');choice.dataset.value=String(star);choice.setAttribute('role','radio');choice.setAttribute('aria-label',String(field.label||field.key)+' '+star+'/'+max);choice.addEventListener('keydown',event=>{let next=star;if(event.key==='ArrowRight'||event.key==='ArrowUp')next=Math.min(max,star+1);else if(event.key==='ArrowLeft'||event.key==='ArrowDown')next=Math.max(min,star-1);else if(event.key==='Home')next=min;else if(event.key==='End')next=max;else if(event.key!=='Enter'&&event.key!==' '&&event.key!=='Spacebar')return;event.preventDefault();chooseRating(group,next,true);});const input=make('input');input.type='radio';input.id=id+'-'+star;input.name=field.key;input.value=String(star);input.required=field.required===true;input.tabIndex=-1;input.setAttribute('aria-hidden','true');if(Number(field.default||0)===star)input.checked=true;input.addEventListener('change',()=>paintRatingGroup(group));choice.addEventListener('mouseenter',()=>paintRatingGroup(group,star));choice.append(input,document.createTextNode('★'));group.appendChild(choice);}
                group.addEventListener('mouseleave',()=>paintRatingGroup(group));wrap.appendChild(group);paintRatingGroup(group);return wrap;
            }
            let input;if(field.type==='textarea'){input=make('textarea');input.rows=6;}else{input=make('input');input.type=field.type==='email'?'email':'text';}
            input.id=id;input.name=field.key;if(field.required)input.required=true;if(field.min_length)input.minLength=Number(field.min_length);if(field.max_length)input.maxLength=Number(field.max_length);if(field.placeholder)input.placeholder=String(field.placeholder);if(field.default!==undefined)input.value=String(field.default);wrap.appendChild(input);return wrap;
        }
        function renderForm(data){schemaFields=Array.isArray(data.fields)?data.fields:[];fieldsRoot.replaceChildren(...schemaFields.map(fieldInput));submit.disabled=false;}
        function renderPreviews(){previewRoot.replaceChildren();form.querySelectorAll('input[type=file]').forEach(input=>{Array.from(input.files||[]).forEach(file=>{const item=make('div','weline-review__preview-item');const kind=input.dataset.kind||'image';const media=make(kind==='video'?'video':'img');media.src=URL.createObjectURL(file);if(kind==='video'){media.muted=true;media.controls=true;media.preload='metadata';}else media.alt=file.name;item.append(media,make('span','weline-review__preview-kind',kind==='video'?messages.video:messages.photo));previewRoot.appendChild(item);});});}
        function validateFiles(){let valid=true;form.querySelectorAll('input[type=file]').forEach(input=>{const files=Array.from(input.files||[]);const maxFiles=Number(input.dataset.maxFiles||1);const maxSize=Number(input.dataset.maxSize||0);if(files.length>maxFiles||files.some(file=>maxSize>0&&file.size>maxSize))valid=false;});return valid;}
        function renderReviews(data){const reviews=Array.isArray(data.items)?data.items:[];itemsRoot.replaceChildren();average.textContent=reviews.length?Number(data.average_rating||0).toFixed(1)+' / 5':'—';count.textContent=String(Number(data.total||0))+' '+String(messages.countSuffix);if(!reviews.length){itemsRoot.appendChild(make('p','weline-review__empty',messages.empty));return;}reviews.forEach(review=>{const article=make('article','weline-review__item');const head=make('div','weline-review__item-head');head.append(make('span','weline-review__stars','★'.repeat(Math.max(1,Math.min(5,Number(review.rating||5))))),make('span','weline-review__meta',String(review.reviewer||'')+(review.created_at?' · '+String(review.created_at).slice(0,10):'')));article.appendChild(head);if(review.title)article.appendChild(make('h3','',String(review.title)));article.appendChild(make('p','weline-review__item-copy',String(review.content||'')));const extra=review.extra&&typeof review.extra==='object'?review.extra:{};const ratingFields=schemaFields.filter(field=>field.type==='rating'&&field.key!=='rating'&&Number(extra[field.key]||0)>0);if(ratingFields.length){const scores=make('div','weline-review__score-list');ratingFields.forEach(field=>{const score=Math.max(1,Math.min(Number(field.max||5),Number(extra[field.key]||0)));const item=make('div','weline-review__score');item.append(make('span','weline-review__score-label',String(field.label||field.key)),make('span','weline-review__score-stars','★'.repeat(score)));scores.appendChild(item);});article.appendChild(scores);}const mediaItems=Array.isArray(review.media)?review.media:[];if(mediaItems.length){const gallery=make('div','weline-review__media');mediaItems.forEach(item=>{const figure=make('figure');const media=make(item.kind==='video'?'video':'img');media.src=String(item.url||'');if(item.kind==='video'){media.controls=true;media.preload='metadata';}else{media.loading='lazy';media.alt=String(item.name||messages.photo);}figure.append(media,make('span','weline-review__media-label',item.kind==='video'?'VIDEO':'PHOTO'));gallery.appendChild(figure);});article.appendChild(gallery);}itemsRoot.appendChild(article);});}
        async function boot(){try{const client=await api();const [formResult,listResult]=await Promise.all([client.form({type_code:typeCode,entity_uuid:entityUuid}),client.list({type_code:typeCode,entity_uuid:entityUuid,page:1,page_size:10})]);const formData=unwrap(formResult);const listData=unwrap(listResult);if(!formData||formData.success===false)throw new Error(formData&&formData.message?formData.message:messages.schemaFailed);renderForm(formData);if(!listData||listData.success===false)throw new Error(listData&&listData.message?listData.message:messages.loadFailed);renderReviews(listData);}catch(error){fieldsRoot.replaceChildren(make('p','weline-review__form-loading',error&&error.message?error.message:messages.schemaFailed));itemsRoot.replaceChildren(make('p','weline-review__empty',error&&error.message?error.message:messages.loadFailed));count.textContent=messages.loadFailed;feedback.classList.add('is-error');feedback.textContent=error&&error.message?error.message:messages.loadFailed;}}
        form.addEventListener('submit',async function(event){event.preventDefault();feedback.classList.remove('is-error');const missingRating=schemaFields.find(field=>field.type==='rating'&&field.required&&!String(form.elements.namedItem(field.key)?.value||''));if(missingRating){feedback.classList.add('is-error');feedback.textContent=messages.ratingRequired;form.querySelector('.weline-review__rating-stars [role=radio]')?.focus();return;}if(!form.reportValidity())return;if(!validateFiles()){feedback.classList.add('is-error');feedback.textContent=messages.mediaInvalid;return;}submit.disabled=true;feedback.textContent=messages.submitting;try{const client=await api();const mediaTokens=[];for(const input of form.querySelectorAll('input[type=file]')){for(const file of Array.from(input.files||[])){const uploadResult=unwrap(await client.upload({type_code:typeCode,entity_uuid:entityUuid,media_kind:input.dataset.kind||'image',upload_base64:[{name:file.name,type:file.type,data:await fileToBase64(file)}]}));if(!uploadResult||uploadResult.success===false)throw new Error(uploadResult&&uploadResult.message?uploadResult.message:messages.submitFailed);const token=uploadResult.media&&uploadResult.media.token;if(token)mediaTokens.push(String(token));}}
            const values={};schemaFields.forEach(field=>{if(field.type==='image'||field.type==='video')return;const input=form.elements.namedItem(field.key);if(!input)return;values[field.key]=field.type==='checkbox'?Boolean(input.checked):String(input.value||'');});const result=unwrap(await client.submit({type_code:typeCode,entity_uuid:entityUuid,values:values,media_tokens:mediaTokens}));if(!result||result.success===false)throw new Error(result&&result.message?result.message:messages.submitFailed);feedback.textContent=String(result.message||'');form.reset();form.querySelectorAll('.weline-review__rating-stars').forEach(group=>paintRatingGroup(group));previewRoot.replaceChildren();}catch(error){feedback.classList.add('is-error');feedback.textContent=error&&error.message?error.message:messages.submitFailed;}finally{submit.disabled=false;}});
        boot();
    });
})();
</script>
