<?php
/**
 * 页头右侧导航扩展：今日特价入口（默认注入 header-nav-extensions）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {header-deals-link}
 * @widget.cache {3600}
 * @widget.share {true}
 * @widget.name {页头今日特价链接}
 * @widget.description {页头右侧导航扩展槽：今日特价入口（/promotion/deals）；默认注入 header-nav-extensions。}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {header-nav-extensions}
 * @widget.supports {["header-deals-link","header-nav-link","layout-header-nav-extensions"]}
 * @widget.default_injections {[{"layout_type":"homepage","slot":"header-nav-extensions","area":"header","sort_order":10,"required":true,"reason":"页头右侧扩展槽默认展示今日特价（活动模块）","config":{"label":"今日特价"}}]}
 *
 * @param label {default="今日特价",type="string",label="链接文字"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Promotion\Service\PromotionStorefrontPageService;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

// A site without an active `deals` promotion page must not advertise the link:
// /promotion/deals would answer 404 (Deals::index redirects when unavailable).
// Sites that renamed their deals page keep their own nav-tab entry elsewhere.
// Marker: promotion-header-deals-link-guard-v1
if (!ObjectManager::getInstance(PromotionStorefrontPageService::class)->isPageAvailable('deals')) {
    return;
}

$scope = WidgetUiScope::forWidget('header-deals-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '今日特价';
$label = WidgetI18n::label($labelSource, '今日特价');
?>
<a class="header-nav-extension-link header-deals-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="header-deals-link"
   href="@url{'promotion/deals'}"><?= $esc($label) ?></a>
