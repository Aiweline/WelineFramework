<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn (mixed $value): string => htmlspecialchars((string)($value ?? ''), ENT_QUOTES, 'UTF-8');
$label = (string)$this->getData('localFieldLabelText');
$for = (string)$this->getData('localFieldFor');
$field = (string)$this->getData('localFieldName');
$recordId = (int)$this->getData('localFieldRecordId');
$source = (string)$this->getData('localFieldSource');
$triggerLabel = (string)$this->getData('localTriggerLabel');
$localModel = 'Weline\\Promotion\\Model\\PromotionActivityThemeLocal';
?>
<div class="w-field__label-row promotion-theme-local-label" data-align="center" data-justify="between" data-gap="sm">
    <label class="w-field__label" for="<?= $escape($for) ?>"><?= $label ?></label>
    <?php if ($recordId > 0): ?>
        <span class="promotion-theme-local-label__trigger" style="--promotion-local-label: '<?= $escape($triggerLabel !== '' ? $triggerLabel : (string)__('多语言')) ?>'">
            <local model="<?= $escape($localModel) ?>" field="<?= $escape($field) ?>" id="activityTheme.id"><?= $escape($source) ?></local>
        </span>
    <?php else: ?>
        <span class="w-field__hint" data-size="sm"><?= __('保存后可翻译多语言') ?></span>
    <?php endif; ?>
</div>
