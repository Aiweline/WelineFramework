<script data-no-extract="true">
function promotionThemeIndexReloadScope(level) {
    var root = document.querySelector('[data-testid="promotion-theme-filter-form"]');
    if (!root) {
        return;
    }
    var params = new URLSearchParams(window.location.search);
    var websiteInput = root.querySelector('[name="website_id"]');
    var storeInput = root.querySelector('[name="store_code"]');
    var channelInput = root.querySelector('[name="channel_code"]');
    var websiteId = websiteInput ? String(websiteInput.value || '0').trim() : '0';
    var storeCode = storeInput ? String(storeInput.value || '').trim() : '';
    var channelCode = channelInput ? String(channelInput.value || '').trim() : '';
    if (level === 'website') {
        storeCode = '';
        channelCode = '';
    } else if (level === 'store') {
        channelCode = '';
    }
    if (websiteId === '0' || websiteId === '') {
        params.delete('website_id');
    } else {
        params.set('website_id', websiteId);
    }
    if (storeCode === '') {
        params.delete('store_code');
    } else {
        params.set('store_code', storeCode);
    }
    if (channelCode === '') {
        params.delete('channel_code');
    } else {
        params.set('channel_code', channelCode);
    }
    window.location.search = params.toString();
}
</script>
