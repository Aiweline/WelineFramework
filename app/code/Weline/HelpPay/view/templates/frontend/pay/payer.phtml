<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
/** @var array<string,mixed> $bill */
$bill = is_array($this->getData('bill')) ? $this->getData('bill') : [];
$goodsMinor = max(0, (int) ($bill['goods_amount_minor'] ?? $bill['amount_minor'] ?? 0));
$shipMinor = max(0, (int) ($bill['shipping_amount_minor'] ?? 0));
$currency = (string) ($bill['currency_code'] ?? 'USD');
$serviceCode = trim((string) ($bill['service_code'] ?? ''));
$serviceLabel = trim((string) ($bill['service_label'] ?? ''));
/** @var list<array<string,mixed>> $shippingOptions */
$shippingOptions = is_array($bill['shipping_options'] ?? null) ? $bill['shipping_options'] : [];
$missingWeight = !empty($bill['missing_weight']);
$normalizedOptions = [];
foreach ($shippingOptions as $option) {
    if (!is_array($option)) {
        continue;
    }
    $code = trim((string) ($option['service_code'] ?? $option['code'] ?? ''));
    if ($code === '') {
        continue;
    }
    $label = trim((string) ($option['label'] ?? $option['service_name'] ?? $option['title'] ?? $code));
    $optShip = max(0, (int) ($option['amount_minor'] ?? 0));
    $normalizedOptions[] = [
        'service_code' => $code,
        'label' => $label,
        'amount_minor' => $optShip,
    ];
}
if ($normalizedOptions !== []) {
    $matched = null;
    foreach ($normalizedOptions as $option) {
        if ($serviceCode !== '' && $option['service_code'] === $serviceCode) {
            $matched = $option;
            break;
        }
    }
    if ($matched === null) {
        $matched = $normalizedOptions[0];
    }
    $serviceCode = (string) $matched['service_code'];
    $serviceLabel = (string) $matched['label'];
    $shipMinor = (int) $matched['amount_minor'];
}
$taxMinor = max(0, (int) ($bill['tax_amount_minor'] ?? 0));
$amountMinor = $goodsMinor + $shipMinor + $taxMinor;
if ($amountMinor <= 0) {
    $amountMinor = max(0, (int) ($bill['amount_minor'] ?? 0));
}
$amount = $amountMinor / 100;
$goods = $goodsMinor / 100;
$ship = $shipMinor / 100;
$tax = $taxMinor / 100;
$rulesUrl = (string) ($this->getData('help_rules_url') ?? '/faq/help-pay-payer');
$privacyUrl = (string) ($this->getData('privacy_url') ?? '/faq/help-pay-privacy');
$token = (string) ($this->getData('token') ?? '');
$billingHtml = (string) ($this->getData('billing_address_html') ?? '');
$moneySummaryHtml = (string) ($this->getData('money_summary_html') ?? '');
/** @var list<array{code:string,title:string,requires_billing:bool}> $paymentMethods */
$paymentMethods = is_array($this->getData('payment_methods')) ? $this->getData('payment_methods') : [];
$paymentMethodsHtml = (string) ($this->getData('payment_methods_html') ?? '');
$billingRequiredInitially = !empty($this->getData('billing_required_initially'));
$defaultMethodIndex = (int) ($this->getData('payment_method_default_index') ?? 0);
?>
<section class="w-helppay-payer"
         data-testid="help-pay-payer"
         data-shipping-redacted="1"
         data-helppay-token="<?= $escape($token) ?>"
         data-helppay-currency="<?= $escape($currency) ?>"
         data-helppay-goods-minor="<?= $escape((string) $goodsMinor) ?>"
         data-helppay-ship-minor="<?= $escape((string) $shipMinor) ?>"
         data-helppay-service-code="<?= $escape($serviceCode) ?>"
         data-helppay-missing-weight="<?= $missingWeight ? '1' : '0' ?>"
         data-weline-load="helpPayShare,storefrontMoneySummary"
         weline-code="helppay.payer.page">
    <header class="w-helppay-payer__head w-stack" style="--w-gap:var(--weline-space-2, var(--space-2));">
        <p class="w-text" data-tone="muted" data-size="sm" style="--w-m:0;"><lang>帮我付</lang></p>
        <h1 class="w-text" data-weight="strong" style="--w-m:0;"><?= $escape(__('帮他人付款')) ?></h1>
        <p class="w-text" data-tone="muted" style="--w-m:0;">
            <a data-testid="help-pay-payer-rules" href="<?= $escape($rulesUrl) ?>" target="_blank" rel="noopener noreferrer"><?= $escape(__('付款说明')) ?></a>
            ·
            <a data-testid="help-pay-payer-privacy" href="<?= $escape($privacyUrl) ?>" target="_blank" rel="noopener noreferrer"><?= $escape(__('隐私说明')) ?></a>
        </p>
    </header>

    <div class="w-helppay-payer__grid" data-testid="help-pay-payer-grid">
        <div class="w-helppay-payer__main w-stack" style="--w-gap:var(--weline-space-4, var(--space-4));">
            <div class="w-helppay-panel" data-testid="help-pay-summary">
                <p class="w-text" data-size="sm" data-tone="muted" style="--w-m:0;"><?= $escape(__('应付金额')) ?></p>
                <p class="w-helppay-panel__amount" style="--w-m:0;">
                    <strong data-helppay-payable-amount><?= $escape($currency) ?> <?= $escape(number_format($amount, 2)) ?></strong>
                </p>
                <p class="w-text" data-size="sm" data-tone="muted" data-testid="help-pay-shipping-redacted-note">
                    <?= $escape(__('收货地址已由发起人确认。')) ?>
                </p>
            </div>

            <div class="w-helppay-panel" data-testid="help-pay-shipping-method">
                <h2 class="w-text" data-weight="strong"><?= $escape(__('物流方式')) ?></h2>
                <p class="w-text" data-size="sm" data-tone="muted">
                    <?= $escape(__('请选择物流（仅影响运费，不展示收货地址）。')) ?>
                </p>
                <?php if ($missingWeight): ?>
                    <div class="w-alert" data-tone="warning" role="alert" data-testid="help-pay-shipping-missing-weight">
                        <div class="w-alert__content">
                            <p><?= $escape(__('商品缺少重量，无法计算运费。请联系发起人或客服后再试。')) ?></p>
                        </div>
                    </div>
                <?php elseif ($normalizedOptions === []): ?>
                    <div class="w-alert" data-tone="warning" role="alert" data-testid="help-pay-shipping-empty">
                        <div class="w-alert__content">
                            <p><?= $escape(__('该地址暂无可用配送方式，请联系发起人更换地址后重试。')) ?></p>
                        </div>
                    </div>
                <?php else: ?>
                    <label class="w-field">
                        <span class="w-field__label"><?= $escape(__('配送方式')) ?></span>
                        <select class="w-select" data-helppay-shipping-method data-testid="help-pay-shipping-select">
                            <?php foreach ($normalizedOptions as $option): ?>
                                <option value="<?= $escape((string) $option['service_code']) ?>"
                                        data-amount-minor="<?= $escape((string) $option['amount_minor']) ?>"
                                        <?= ((string) $option['service_code'] === $serviceCode) ? 'selected' : '' ?>>
                                    <?= $escape((string) $option['label'] . ' · ' . $currency . ' ' . number_format(((int) $option['amount_minor']) / 100, 2)) ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                    </label>
                    <p class="w-text" data-size="sm" data-tone="danger" data-helppay-shipping-msg hidden role="alert" data-testid="help-pay-shipping-msg"></p>
                <?php endif; ?>
            </div>
        </div>

        <aside class="w-helppay-payer__pay w-helppay-panel" data-testid="help-pay-payment">
            <h2 class="w-text" data-weight="strong"><?= $escape(__('支付方式')) ?></h2>
            <p class="w-text" data-size="sm" data-tone="muted">
                <?= $escape(__('请选择适合您的支付方式完成付款。')) ?>
            </p>

            <fieldset class="w-stack w-helppay-payer__methods weline-checkout__options"
                      style="--w-gap:var(--weline-space-2, var(--space-2)); border:0; margin:0; padding:0;"
                      data-testid="help-pay-payment-methods"
                      data-helppay-payment-methods>
                <legend class="w-text" data-weight="strong" style="--w-m:0;"><?= $escape(__('选择支付方式')) ?></legend>
                <?php if ($paymentMethodsHtml !== ''): ?>
                    <?= $paymentMethodsHtml ?>
                <?php elseif ($paymentMethods !== []): ?>
                    <?php foreach ($paymentMethods as $i => $method): ?>
                        <?php
                        $code = (string) ($method['code'] ?? '');
                        $title = (string) ($method['title'] ?? $method['label'] ?? $code);
                        $needsBilling = !empty($method['requires_billing']);
                        $iconUrl = trim((string) ($method['icon_url'] ?? ''));
                        $checked = $i === $defaultMethodIndex;
                        ?>
                        <label class="weline-checkout__option weline-checkout__option--payment">
                            <input type="radio"
                                   name="helppay_payment_method"
                                   value="<?= $escape($code) ?>"
                                   data-helppay-payment-method
                                   data-requires-billing="<?= $needsBilling ? '1' : '0' ?>"
                                   data-testid="help-pay-method-<?= $escape($code) ?>"
                                   <?= $checked ? 'checked' : '' ?>>
                            <?php if ($iconUrl !== ''): ?>
                                <img class="weline-checkout__payment-logo" src="<?= $escape($iconUrl) ?>" alt="<?= $escape($title) ?>" loading="lazy" decoding="async" width="40" height="28">
                            <?php else: ?>
                                <span class="weline-checkout__payment-logo weline-checkout__payment-logo--empty" aria-hidden="true"></span>
                            <?php endif; ?>
                            <span class="weline-checkout__payment-body">
                                <span class="weline-checkout__payment-title-row">
                                    <strong><?= $escape($title) ?></strong>
                                </span>
                            </span>
                        </label>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="w-alert" data-tone="warning" role="alert" data-testid="help-pay-payment-empty">
                        <div class="w-alert__content">
                            <div class="w-alert__title"><?= $escape(__('暂无可用支付方式')) ?></div>
                            <p><?= $escape(__('暂无可用支付方式。')) ?></p>
                        </div>
                    </div>
                <?php endif; ?>
            </fieldset>

            <div class="w-helppay-pay-summary w-helppay-payer__totals"
                 data-testid="help-pay-totals"
                 data-helppay-payment-summary
                 data-helppay-money-summary-host>
                <?php if ($moneySummaryHtml !== ''): ?>
                    <?= $moneySummaryHtml ?>
                <?php else: ?>
                    <div class="w-storefront-money-summary w-helppay-pay-summary__money"
                         data-testid="helppay-payment-money"
                         data-money-summary
                         data-money-summary-mode="helppay"
                         data-discounts-disabled="1">
                        <div class="w-storefront-money-summary__row w-storefront-money-summary__row--goods" role="listitem" data-money-summary-row="goods">
                            <span><?= $escape(__('商品小计')) ?></span>
                            <strong data-money-summary-goods data-helppay-goods-amount data-testid="helppay-payment-goods-amount">
                                <?= $escape($currency) ?> <?= $escape(number_format($goods, 2)) ?>
                            </strong>
                        </div>
                        <div class="w-storefront-money-summary__row w-storefront-money-summary__row--shipping" role="listitem" data-money-summary-row="shipping">
                            <span data-money-summary-shipping-label data-helppay-ship-label data-label-base="<?= $escape(__('运费')) ?>">
                                <?= $escape(__('运费')) ?><?= $serviceLabel !== '' ? ' · ' . $escape($serviceLabel) : '' ?>
                            </span>
                            <strong data-money-summary-shipping data-helppay-ship-amount data-testid="helppay-payment-ship-amount">
                                <?= $escape($currency) ?> <?= $escape(number_format($ship, 2)) ?>
                            </strong>
                        </div>
                        <div class="w-storefront-money-summary__row w-storefront-money-summary__row--tax" role="listitem" data-money-summary-row="tax" data-checkout-tax-row <?= $tax > 0 ? '' : 'hidden' ?>>
                            <span data-money-summary-tax-label><?= $escape(__('税费（预估）')) ?></span>
                            <strong data-money-summary-tax data-tax-amount="">
                                <?= $escape($currency) ?> <?= $escape(number_format($tax, 2)) ?>
                            </strong>
                        </div>
                        <div class="w-storefront-money-summary__row w-storefront-money-summary__row--payable" role="listitem" data-money-summary-row="payable">
                            <span data-money-summary-payable-label><?= $escape(__('应付')) ?></span>
                            <strong data-money-summary-payable data-helppay-total-amount data-testid="helppay-payment-total">
                                <?= $escape($currency) ?> <?= $escape(number_format($amount, 2)) ?>
                            </strong>
                        </div>
                    </div>
                <?php endif; ?>
            </div>

            <div class="w-stack w-helppay-payer__billing"
                 style="--w-gap:var(--weline-space-3, var(--space-3));"
                 data-testid="help-pay-billing"
                 data-helppay-billing-panel
                 <?= $billingRequiredInitially ? '' : 'hidden' ?>>
                <h3 class="w-text" data-weight="strong" style="--w-m:0;"><?= $escape(__('付款账单地址')) ?></h3>
                <p class="w-text" data-size="sm" data-tone="muted" style="--w-m:0;">
                    <?= $escape(__('卡支付时填写付款人自己的账单地址，不会写回收货地址。')) ?>
                </p>
                <div data-helppay-billing-mount data-testid="helppay-billing-mount">
                    <?php if ($billingHtml !== ''): ?>
                        <?= $billingHtml ?>
                    <?php else: ?>
                        <p class="w-text" data-tone="danger" data-size="sm" data-testid="helppay-billing-unavailable" role="alert">
                            <?= $escape(__('账单地址组件暂不可用，请稍后重试。')) ?>
                        </p>
                    <?php endif; ?>
                </div>
                <p class="w-text" data-tone="danger" data-size="sm" data-helppay-billing-msg hidden role="alert"></p>
            </div>
            <div class="w-helppay-payer__actions">
                <p class="w-text" data-size="sm" data-helppay-pay-msg hidden role="alert" data-testid="help-pay-confirm-msg"></p>
                <button type="button" class="w-button w-button--primary" data-helppay-pay data-testid="help-pay-confirm">
                    <?= $escape(__('确认付款')) ?>
                </button>
            </div>
        </aside>
    </div>
</section>
