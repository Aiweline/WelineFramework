<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$bill = is_array($this->getData('bill')) ? $this->getData('bill') : [];
$shipping = is_array($this->getData('shipping')) ? $this->getData('shipping') : [];
$shareUrl = trim((string) ($this->getData('share_url') ?? ''));
$shareTitle = (string) ($this->getData('share_title') ?? __('跨设备支付'));
$shareHint = (string) ($this->getData('share_hint') ?? '');
$token = trim((string) ($this->getData('token') ?? ($bill['token'] ?? '')));
$amount = ((int) ($bill['amount_minor'] ?? 0)) / 100;
$currency = (string) ($bill['currency_code'] ?? 'USD');
// 可用支付方式由 Provider 列表决定（QuickPay 控制器下发）。列表为空时保持空串，
// 由前端提示「暂无可用支付方式」，壳不得编造 code 兜底。
$preferredMethod = strtolower(trim((string) ($this->getData('preferred_payment_method') ?? '')));
$host = (string) ($_SERVER['HTTP_HOST'] ?? '');
$scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
if (isset($_SERVER['REQUEST_SCHEME']) && is_string($_SERVER['REQUEST_SCHEME']) && $_SERVER['REQUEST_SCHEME'] !== '') {
    $scheme = $_SERVER['REQUEST_SCHEME'];
}
$absoluteShare = $shareUrl;
if ($shareUrl !== '' && !str_starts_with($shareUrl, 'http') && $host !== '') {
    $absoluteShare = $scheme . '://' . $host . (str_starts_with($shareUrl, '/') ? $shareUrl : '/' . $shareUrl);
}
?>
<section class="w-helppay-quick w-stack"
         style="--w-gap:var(--weline-space-5, var(--space-5));"
         data-testid="quick-pay-self"
         data-weline-load="helpPayShare"
         weline-code="helppay.quick.page">
    <header class="w-helppay-quick__head w-stack" style="--w-gap:var(--weline-space-2, var(--space-2));">
        <p class="w-text" data-tone="muted" data-size="sm" style="--w-m:0;"><lang>本人快捷购买</lang></p>
        <h1 class="w-text" data-weight="strong" style="--w-m:0;"><?= $escape(__('快捷购买')) ?></h1>
        <p class="w-text" data-tone="muted" style="--w-m:0;">
            <lang>订单归属你本人。请在此页完成支付。</lang>
        </p>
    </header>

    <div class="w-helppay-panel" data-testid="quick-pay-summary">
        <p class="w-text" data-size="sm" data-tone="muted" style="--w-m:0;"><lang>应付金额</lang></p>
        <p class="w-helppay-panel__amount" style="--w-m:0;">
            <strong><?= $escape($currency) ?> <?= $escape(number_format($amount, 2)) ?></strong>
        </p>
        <?php if ($shipping !== []): ?>
            <div class="w-helppay-panel__shipping" data-testid="quick-pay-shipping">
                <p class="w-text" data-size="sm" style="--w-m:0;">
                    <?= $escape(trim((string) (($shipping['name'] ?? '') . ' · ' . ($shipping['line1'] ?? '')), ' ·')) ?>
                </p>
            </div>
        <?php endif; ?>
    </div>

    <div class="w-helppay-quick__actions">
        <button type="button"
                class="w-button w-button--primary"
                data-testid="quick-pay-submit"
                data-helppay-pay
                data-helppay-quick-self-pay="1"
                data-payment-method="<?= $escape($preferredMethod) ?>"
                data-token="<?= $escape($token) ?>">
            <?= $escape(__('立即支付')) ?>
        </button>
        <?php if ($preferredMethod === ''): ?>
            <p class="w-text" data-size="sm" data-tone="muted" style="--w-m:var(--weline-space-2, var(--space-2)) 0 0;">
                <lang>暂无可用支付方式，请稍后再试或联系客服。</lang>
            </p>
        <?php endif; ?>
    </div>

    <?php if ($absoluteShare !== ''): ?>
        <details class="w-helppay-quick__cross-device" data-testid="quick-pay-cross-device">
            <summary class="w-text" data-size="sm">
                <lang>换设备支付（链接 / 二维码）</lang>
            </summary>
            <?php
            $this->assign('url', $absoluteShare);
            $this->assign('share_title', $shareTitle);
            $this->assign('share_hint', $shareHint);
            $this->assign('link_section', (string) __('付款链接'));
            $this->assign('qr_section', (string) __('扫码付款'));
            $this->assign('qr_aria', (string) __('快捷购买付款二维码'));
            $this->assign('url_tip', (string) __('复制后在浏览器打开，用你自己的账号完成支付'));
            $this->assign('url_tip_copied', (string) __('已复制，请自行打开链接付款'));
            $this->assign('qr_tip', (string) __('扫码后在本机打开付款页，完成你自己的支付'));
            $this->assign('qr_tip_copied', (string) __('已复制，可粘贴到本机浏览器打开付款'));
            echo $this->fetch('Weline_HelpPay::templates/frontend/widgets/help-pay-share-result.phtml');
            ?>
        </details>
    <?php endif; ?>
</section>
