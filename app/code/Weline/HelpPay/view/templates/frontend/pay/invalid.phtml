<?php
/** @var \Weline\Framework\View\Template $this */
$escape = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$error = (string) ($this->getData('error') ?? '');
$heading = trim((string) ($this->getData('invalid_heading') ?? ''));
$message = trim((string) ($this->getData('invalid_message') ?? ''));
if ($heading === '') {
    $heading = (string) __('链接不可用');
}
if ($message === '') {
    $message = (string) __('该分享或代付链接已过期、撤销或无效。');
}
?>
<section class="w-helppay-invalid w-stack"
         style="--w-gap:var(--weline-space-4, var(--space-4));"
         data-testid="help-pay-invalid"
         weline-code="helppay.invalid.page">
    <div class="w-helppay-panel">
        <h1 class="w-text" data-weight="strong"><?= $escape($heading) ?></h1>
        <p class="w-text" data-tone="muted"><?= $escape($message) ?></p>
        <?php if ($error !== ''): ?>
            <p class="w-helppay-invalid__code" hidden><?= $escape($error) ?></p>
        <?php endif; ?>
        <a class="w-button w-button--primary" href="/"><?= $escape(__('返回首页')) ?></a>
    </div>
</section>
