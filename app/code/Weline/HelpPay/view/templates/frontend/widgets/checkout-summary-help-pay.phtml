<?php
/** @var \Weline\Framework\View\Template $this
 *
 * @widget.code {checkout-summary-help-pay}
 * @widget.name {结账帮我付}
 * @widget.description {结账摘要旁帮我付 CTA；placement.checkout 可关。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["checkout"]}
 * @widget.slot {checkout-summary-help-pay}
 * @widget.supports {["checkout-summary-help-pay","help-pay","helppay"]}
 * @param enabled {default=true,type="bool",label="展结账帮我付"}
 *
 * @widget.cache {3600}
 * @widget.share {true}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-summary-help-pay","area":"content","sort_order":20,"required":true,"reason":"结账摘要默认由 HelpPay 注入帮我付（可关）","config":{"enabled":true,"placement":"checkout"}}]}
