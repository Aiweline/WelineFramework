<?php
/** @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-help-pay}
 * @widget.name {商品找朋友代付}
 * @widget.description {PDP 帮我付弱入口：主购买下方 quiet 文字链；rules→address-pick→/h/ 出链。}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.slot {product-purchase-actions}
 * @widget.supports {["product-purchase-actions","help-pay","helppay"]}
 * @param enabled {default=true,type="bool",label="展示找朋友代付"}
 *
 * @widget.cache {3600}
 * @widget.share {true}
 * @widget.default_injections {[{"layout_type":"product","layout_option":"default","slot":"product-purchase-actions","area":"content","sort_order":50,"required":true,"reason":"商品页默认提供找朋友代付弱入口（可关）","config":{"enabled":true,"placement":"product"}}]}
 */
use Weline\Product\Helper\StorefrontOfferResolver;

$enabled = filter_var($this->getData('enabled') ?? true, FILTER_VALIDATE_BOOLEAN);
$escape = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
if (!$enabled) {
    return;
}
$offer = [];
try {
    $offer = StorefrontOfferResolver::resolve($this);
} catch (\Throwable) {
    $offer = [];
}
if (!empty($offer['currency_unavailable'])) {
    echo '<p class="product-native-detail__unavailable" hidden data-currency-purchase-blocked="1">'
        . $escape(__('当前货币暂不可用'))
        . '</p>';
    return;
}
$productId = max(0, (int) ($offer['product_id'] ?? $this->getData('card_product_id') ?? 0));
$i18nJson = \Weline\HelpPay\Service\ShareModalI18n::json();
?>
<div class="w-helppay-cta w-helppay-cta--quiet"
     data-testid="product-help-pay"
     data-helppay-placement="product"
     data-helppay-toc-only="1"
     data-weline-load="helpPayShare"
     data-helppay-i18n="<?= $escape($i18nJson) ?>">
    <button type="button"
            class="w-helppay-cta__link weline-pixel::friend_help_pay"
            data-testid="help-pay-open"
            data-pixel-event="friend_help_pay"
            data-helppay-open="1"
            data-helppay-product-help-pay="1"
            data-product-id="<?= (int) $productId ?>">
        <?= $escape(__('找朋友代付')) ?>
    </button>
</div>
