<?php
/** @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-selection-share}
 * @widget.name {商品纯分享}
 * @widget.description {PDP 纯分享（selection_share）：预选规格分享给朋友灌入对方购物车。}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.slot {product-purchase-actions}
 * @widget.supports {["product-purchase-actions","selection-share","helppay"]}
 * @param enabled {default=true,type="bool",label="展示纯分享"}
 *
 * @widget.cache {3600}
 * @widget.share {true}
 * @widget.default_injections {[{"layout_type":"product","layout_option":"default","slot":"product-purchase-actions","area":"content","sort_order":40,"required":true,"reason":"商品页默认提供纯分享入口（可关）","config":{"enabled":true}}]}
 */
use Weline\Product\Helper\StorefrontOfferResolver;

$enabled = filter_var($this->getData('enabled') ?? true, FILTER_VALIDATE_BOOLEAN);
$escape = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
if (!$enabled) {
    return;
}
$offer = [];
try {
    $offer = StorefrontOfferResolver::resolve($this);
} catch (\Throwable) {
    $offer = [];
}
$productId = max(0, (int) ($offer['product_id'] ?? $this->getData('card_product_id') ?? 0));
$i18nJson = \Weline\HelpPay\Service\ShareModalI18n::json();
?>
<div class="w-helppay-cta w-helppay-cta--quiet"
     data-testid="product-selection-share-wrap"
     data-helppay-placement="product-selection-share"
     data-weline-load="helpPayShare"
     data-helppay-i18n="<?= $escape($i18nJson) ?>">
    <button type="button"
            class="w-helppay-cta__link weline-pixel::selection_share"
            data-testid="product-selection-share"
            data-pixel-event="selection_share"
            data-helppay-selection-share="1"
            data-product-id="<?= (int) $productId ?>">
        <?= $escape(__('分享给朋友')) ?>
    </button>
</div>
