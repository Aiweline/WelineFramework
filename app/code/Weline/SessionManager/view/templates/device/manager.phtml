<?php

/** @var \Weline\Framework\View\Template $this */
$area = (string)($this->getData('device_manager_area') ?: 'frontend');
$backend = $area === 'backend';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$labels = [
    'loading' => (string)__('正在加载登录设备…'),
    'load_error' => (string)__('设备列表加载失败，请稍后重试。'),
    'empty' => (string)__('当前没有可显示的登录设备。'),
    'current' => (string)__('本设备'),
    'active' => (string)__('已登录'),
    'remembered' => (string)__('可自动登录'),
    'revoke' => (string)__('下线'),
    'confirm' => (string)__('确认下线'),
    'cancel' => (string)__('取消'),
    'retry' => (string)__('重试'),
    'revoked' => (string)__('设备已下线。'),
    'revoke_error' => (string)__('设备下线失败，请重试。'),
    'last_active' => (string)__('最近活动'),
    'first_seen' => (string)__('首次登录'),
    'remember_until' => (string)__('记住登录至'),
    'ip' => (string)__('最近 IP'),
    'previous' => (string)__('上一页'),
    'next' => (string)__('下一页'),
    'page' => (string)__('第 %{1} 页'),
    'unknown_device' => (string)__('Unknown device'),
];
?>
<section class="session-device-manager"
         data-device-manager="<?= $escape($area) ?>"
         data-list-operation="<?= $backend ? 'listBackendDevices' : 'listFrontendDevices' ?>"
         data-revoke-operation="<?= $backend ? 'revokeBackendDevice' : 'revokeFrontendDevice' ?>"
         data-labels="<?= $escape(json_encode($labels, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)) ?>">
    <header class="session-device-manager__header">
        <div>
            <span class="session-device-manager__eyebrow"><lang>账户安全</lang></span>
            <h2><lang>设备管理</lang></h2>
            <p><lang>查看当前身份仍可登录的设备，并让不再使用的设备下线。</lang></p>
        </div>
        <span class="session-device-manager__privacy"><i class="mdi mdi-shield-lock-outline" aria-hidden="true"></i> <lang>仅显示本账号</lang></span>
    </header>

    <div class="session-device-manager__notice" data-device-notice role="status" hidden></div>
    <div class="session-device-manager__state" data-device-loading role="status">
        <span class="session-device-manager__spinner" aria-hidden="true"></span>
        <span><?= $escape($labels['loading']) ?></span>
    </div>
    <div class="session-device-manager__state session-device-manager__state--error" data-device-error role="alert" hidden>
        <span data-device-error-message><?= $escape($labels['load_error']) ?></span>
        <button type="button" data-device-retry><?= $escape($labels['retry']) ?></button>
    </div>
    <div class="session-device-manager__state" data-device-empty role="status" hidden>
        <i class="mdi mdi-laptop-off" aria-hidden="true"></i>
        <span><?= $escape($labels['empty']) ?></span>
    </div>
    <div class="session-device-manager__list" data-device-list role="list"></div>
    <nav class="session-device-manager__pagination" data-device-pagination aria-label="<?= $escape(__('设备列表分页')) ?>" hidden>
        <button type="button" data-device-previous><?= $escape($labels['previous']) ?></button>
        <span data-device-page-label></span>
        <button type="button" data-device-next><?= $escape($labels['next']) ?></button>
    </nav>
</section>
<link href="@static(Weline_SessionManager::css/device-manager.css)" rel="stylesheet" type="text/css"/>
<script src="@static(Weline_SessionManager::js/device-manager.js)" defer></script>
