<?php
/**
 * Recently-viewed products owned by Weline_RecentlyViewed.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {recently-viewed}
 * @widget.name {最近浏览}
 * @widget.description {展示当前访客真实浏览过的产品（Cookie MRU）}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-product-recently-viewed","layout-product-sidebar","layout-product-list-recommendations","layout-search-recommendations","recently-viewed"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-recently-viewed", "area":"content", "sort_order":0, "required":true, "reason":"商品详情默认最近浏览槽", "config":{"title":"最近浏览","limit":24,"columns":"6","layout":"carousel"} }]}
 *
 * @param title {default="最近浏览",type="string",label="标题"}
 * @param limit {default=24,type="number",label="显示数量"}
 * @param columns {default="6",type="select",label="每行列数",options={3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param layout {default="carousel",type="select",label="布局方式",options={grid:"网格",carousel:"轮播"}}
 * @param show_price {default=true,type="bool",label="显示价格"}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 */

use Weline\Framework\Env\WelineEnv;
use Weline\Framework\Http\Url;
use Weline\Framework\Manager\ObjectManager;
use Weline\RecentlyViewed\Service\RecentlyViewedService;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('recently-viewed');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false);
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '最近浏览';
if (preg_match('/^Weline_[A-Za-z0-9_]+$/', $titleSource)) {
    $titleSource = '最近浏览';
}
$widgetTitle = WidgetI18n::label($titleSource, '最近浏览');
$limit = max(1, min(24, (int)($this->getData('limit') ?? 24)));
$columns = (string)($this->getData('columns') ?? '6');
$layout = (string)($this->getData('layout') ?? 'carousel');
$showPrice = (bool)($this->getData('show_price') ?? true);
if (!in_array($columns, ['3', '4', '5', '6'], true)) {
    $columns = '6';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'carousel';
}

$excludeProductId = (int)($this->getData('product_id') ?? 0);
$offer = $this->getData('storefront_offer');
if ($excludeProductId <= 0 && is_array($offer)) {
    $excludeProductId = (int)($offer['product_id'] ?? 0);
}
$currentProduct = $this->getData('product');
if ($excludeProductId <= 0 && is_array($currentProduct)) {
    $excludeProductId = (int)($currentProduct['product_id'] ?? $currentProduct['entity_id'] ?? 0);
} elseif ($excludeProductId <= 0 && is_object($currentProduct) && method_exists($currentProduct, 'getId')) {
    $excludeProductId = (int)$currentProduct->getId();
}
if ($excludeProductId <= 0) {
    $requestUri = (string)(WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
    $requestPath = (string)(parse_url($requestUri, PHP_URL_PATH) ?: '');
    $pathParts = array_values(array_filter(
        explode('/', trim($requestPath, '/')),
        static fn(string $part): bool => $part !== '',
    ));
    $productPartIndex = array_search('product', $pathParts, true);
    if ($productPartIndex !== false && isset($pathParts[$productPartIndex + 1]) && ctype_digit((string)$pathParts[$productPartIndex + 1])) {
        $excludeProductId = (int)$pathParts[$productPartIndex + 1];
    }
}

$products = [];
try {
    // Editor / theme-preview: cookie MRU may still hold real product ids, and
    // cards() → publishedOffersForProductIds() cold-builds the full catalog.
    // Prefer demo cards so the product-layout iframe cannot stall.
    if ($isPreviewMode) {
        $products = \Weline\Theme\Helper\ThemeDemoCatalog::products($limit, 7);
    } else {
        $products = ObjectManager::getInstance(RecentlyViewedService::class)
            ->cards($limit, $excludeProductId);
    }
} catch (\Throwable) {
    $products = [];
}

foreach ($products as &$product) {
    $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
    $product['id'] = $productId;
    $route = trim((string)($product['url'] ?? ''));
    $slug = strtolower(trim((string)($product['slug'] ?? '')));
    if ($route === '' && $slug !== '') {
        $route = 'product/' . $slug;
    } elseif ($route === '' && $productId > 0) {
        $route = 'product/' . $productId;
    }
    if (str_starts_with($route, 'http://') || str_starts_with($route, 'https://') || str_starts_with($route, '//')) {
        $product['url'] = $route;
    } else {
        $path = '/' . ltrim($route, '/');
        $prefix = rtrim(Url::getPrefix(), '/');
        $hasCurrentPrefix = $prefix !== ''
            && ($path === $prefix || str_starts_with($path, $prefix . '/'));
        $product['url'] = $hasCurrentPrefix
            ? $path
            : ($prefix !== '' ? $prefix : '') . $path;
    }
}
unset($product);

$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);

if ($products === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty HTML as a warning toast.
    ?>
<section class="<?= $esc($wc) ?> weline-recently-viewed<?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="recently-viewed-empty">
    <header class="wrv-header">
        <h2 class="wrv-title"><?= $esc($widgetTitle) ?></h2>
        <p class="wrv-subtitle"><?= $esc((string)__('浏览商品后会显示在这里')) ?></p>
    </header>
    <p class="wrv-empty"><?= $esc((string)__('暂无浏览记录')) ?></p>
</section>
    <?php
    return;
}
?>
<link rel="stylesheet"
      href="@static(Weline_RecentlyViewed::css/widgets/recently-viewed.css)?v=20260912-bg-transparent"
      data-no-extract="true">

<section class="<?= $esc($wc) ?> weline-recently-viewed<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-testid="storefront-recently-viewed"
         data-weline-load="recentlyViewed"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-layout="<?= $esc($layout) ?>"
         data-columns="<?= $esc($columns) ?>">
    <header class="wrv-header">
        <h2 class="wrv-title"><?= $esc($widgetTitle) ?></h2>
        <p class="wrv-subtitle"><?= $esc(WidgetI18n::label('Based on your recent browsing')) ?></p>
    </header>

    <div class="wrv-stage" data-wrv-stage>
        <div class="wrv-viewport" data-wrv-viewport>
            <?php if ($layout === 'carousel'): ?>
                <button class="wrv-nav wrv-nav--prev" type="button" data-wrv-prev aria-label="<?= $esc((string)__('上一组')) ?>">
                    <span aria-hidden="true">‹</span>
                </button>
            <?php endif; ?>
            <div class="wrv-track columns-<?= $esc($columns) ?> layout-<?= $esc($layout) ?>" data-wrv-track>
                <?php foreach ($products as $product): ?>
                    <w:product:card product="product" show-price="showPrice" show-rating="false" show-add-to-cart="true" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" show-sku="true" density="standard" class="wpc-listing-card wrv-card" wishlist-pixel="true" />
                <?php endforeach; ?>
            </div>
            <?php if ($layout === 'carousel'): ?>
                <button class="wrv-nav wrv-nav--next" type="button" data-wrv-next aria-label="<?= $esc((string)__('下一组')) ?>">
                    <span aria-hidden="true">›</span>
                </button>
            <?php endif; ?>
        </div>
    </div>
</section>

<?php // recentlyViewed：由部件根 data-weline-load 声明，禁止 @static 直引 ?>
