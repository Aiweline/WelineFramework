    "description": "Google Gemini API service",
    "website": "https://ai.google.dev",
    "documentation": "https://ai.google.dev/gemini-api/docs",
    "account_setup_guide": {
        "title": "Google Gemini / Nano Banana 接入指南",
        "summary": "用于 AI 建站工作台文生图与 Gemini 文本/多模态推理。Google Gemini API 需要在 Google AI Studio 创建 API Key；生产额度和更高限额需要绑定 Google Cloud 账单。",
        "links": [
            {
                "label": "创建或查看 Gemini API Key",
                "url": "https://aistudio.google.com/app/apikey"
            },
            {
                "label": "Gemini API Models",
                "url": "https://ai.google.dev/gemini-api/docs/models"
            },
            {
                "label": "Gemini API 价格与付费层级",
                "url": "https://ai.google.dev/gemini-api/docs/pricing"
            }
        ],
        "steps": [
            "打开 Google AI Studio 的 API Keys 页面，登录 Google 账号。",
            "选择已有 Google Cloud 项目，或按页面提示创建/导入项目。",
            "点击 Create API key 生成 Gemini API Key，并复制完整密钥。",
            "如果免费额度不够或要生产使用，在该 Google Cloud 项目绑定 Billing 账号并启用付费层级。",
            "回到 Weline 后台 AI > 供应商账户，供应商选择 Google。",
            "账户名称建议填写 Google Gemini / Nano Banana。",
            "API密钥粘贴从 Google AI Studio 复制的 Gemini API Key。",
            "API基础URL建议留空，系统会使用默认 Gemini REST 地址；如需显式填写，可填 https://generativelanguage.googleapis.com 或 https://generativelanguage.googleapis.com/v1beta。",
            "保存后点击连接测试；测试通过后启用账户，并设为默认账户。",
            "到 AI 模型同步 Google 模型，然后按实际业务适配器绑定文生图型号（如 gemini-nano-banana-2.1 或 gemini-2.5-flash-image）。"
        ],
        "field_hints": {
            "provider_code": "Google",
            "account_name": "Google Gemini / Nano Banana",
            "api_key": "粘贴 Google AI Studio API Keys 页面生成的 Gemini API Key",
            "base_url": "建议留空；也支持 https://generativelanguage.googleapis.com 或 https://generativelanguage.googleapis.com/v1beta",
            "balance": "可填预计可用额度，仅用于后台排序/展示；不了解可先填 1",
            "currency": "USD"
        },
        "notes": [
            "新项目文本主力：gemini-3.8-flash；高性价比可用 gemini-3.5-flash-lite。",
            "文生图：Nano Banana 2.1 = gemini-nano-banana-2.1；Nano Banana Pro = gemini-3-pro-image；兼容旧 Nano Banana = gemini-2.5-flash-image。",
            "API Key 属于敏感凭证，只应保存在服务端后台，不要放到前端代码或公开仓库。"
        ]
    },
    "supported_features": {
        "chat": true,
        "completion": true,
        "embedding": true,
        "image": true,
        "audio": false
