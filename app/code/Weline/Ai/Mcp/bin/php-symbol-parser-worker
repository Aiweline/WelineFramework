#!/usr/bin/env php
<?php

declare(strict_types=1);

use LearningMcp\PhpSymbolParser;

require dirname(__DIR__) . '/src/PhpTokenBuffer.php';
require dirname(__DIR__) . '/src/PhpSymbolParser.php';

$relativePath = isset($argv[1]) ? (string) $argv[1] : '';
if ($relativePath === ''
    || str_contains($relativePath, "\0")
    || str_starts_with($relativePath, '/')
    || str_starts_with($relativePath, '\\')
    || preg_match('~^[A-Za-z]:[\\\\/]~D', $relativePath) === 1
    || preg_match('~(?:^|/)\.\.(?:/|$)~D', str_replace('\\', '/', $relativePath)) === 1) {
    fwrite(STDERR, "PHP symbol parser worker requires a relative path\n");
    exit(64);
}

$content = stream_get_contents(STDIN);
if (!is_string($content)) {
    fwrite(STDERR, "PHP symbol parser worker could not read stdin\n");
    exit(65);
}

try {
    $parsed = (new PhpSymbolParser())->parse($content, $relativePath);
    fwrite(STDOUT, json_encode($parsed, JSON_THROW_ON_ERROR));
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, 'PHP symbol parser worker failed: ' . $exception->getMessage() . "\n");
    exit(70);
}
