{
  "manifest_version": 3,
  "name": "Weline AI Browser Assistant",
  "version": "1.1.0",
  "permissions": ["storage", "alarms", "aiLanguageModel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
