        </div>
    </div>
</div>

<!-- 按模型排名（倒序：消耗 tokens 最多在前） -->
<section class="w-card">
    <header class="w-card__header">
        <h2 class="w-card__title"><lang>按模型消耗排名</lang></h2>
    </header>
    <div class="w-card__body">
        <div class="w-table-wrap">
            <table class="w-table">
                <thead>
                    <tr>
                        <th><lang>排名</lang></th>
                        <th><lang>模型</lang></th>
                        <th><lang>总令牌数</lang></th>
                        <th><lang>约花费</lang></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    $rank = 1;
                    foreach ($modelRanking as $row):
                        $code = $row['model_code'] ?? '';
                        $tokens = (int)($row['total_tokens'] ?? 0);
                        $costFormatted = $row['total_cost_formatted'] ?? '0.00';
                    ?>
                    <tr>
                        <td><?= $rank++ ?></td>
                        <td><code><?= htmlspecialchars($code) ?></code></td>
                        <td><?= number_format($tokens) ?></td>
                        <td>¥ <?= htmlspecialchars($costFormatted) ?></td>
                    </tr>
                    <?php endforeach; ?>
                    <?php if (empty($modelRanking)): ?>
                    <tr>
                        <td colspan="4">
                            <div class="w-empty"><lang>暂无数据</lang></div>
                        </td>
                    </tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</section>
