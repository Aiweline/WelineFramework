    <a class="w-tabs__tab <?= $period === 'month' ? 'active' : '' ?>" role="tab" aria-selected="<?= $period === 'month' ? 'true' : 'false' ?>" href="@backend-url{'ai/backend/statistics'}?period=month<?= !empty($embed) ? '&embed=1' : '' ?>"><lang>本月</lang></a>
    <a class="w-tabs__tab <?= $period === 'year' ? 'active' : '' ?>" role="tab" aria-selected="<?= $period === 'year' ? 'true' : 'false' ?>" href="@backend-url{'ai/backend/statistics'}?period=year<?= !empty($embed) ? '&embed=1' : '' ?>"><lang>本年</lang></a>
</nav>
