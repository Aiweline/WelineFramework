<!-- 汇总卡片 -->
<div class="w-stat-tiles" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-6);">
    <div class="w-card">
        <div class="w-card__body">
            <div class="w-text" data-tone="muted" data-size="sm"><lang>总请求数</lang></div>
            <div class="w-text" data-size="lg" data-weight="strong"><?= (int)($summary['total_requests'] ?? 0) ?></div>
        </div>
    </div>
    <div class="w-card">
        <div class="w-card__body">
            <div class="w-text" data-tone="muted" data-size="sm"><lang>总令牌数</lang></div>
            <div class="w-text" data-size="lg" data-weight="strong"><?= number_format((int)($summary['total_tokens'] ?? 0)) ?></div>
        </div>
    </div>
    <div class="w-card">
        <div class="w-card__body">
            <div class="w-text" data-tone="muted" data-size="sm"><lang>约花费</lang></div>
