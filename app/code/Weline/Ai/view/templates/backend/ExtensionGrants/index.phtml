<script>
(function () {
  'use strict';
  function post(url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(data || {})
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (payload) {
        if (!response.ok || payload.success === false) {
          throw new Error(payload.message || (response.statusText || 'Request failed'));
        }
        return payload;
      });
    });
  }
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-revoke-grant]');
    if (!button) { return; }
    event.preventDefault();
    var grantId = button.getAttribute('data-revoke-grant') || '';
    if (!grantId) { return; }
    button.setAttribute('aria-busy', 'true');
    post("@backend-url{'ai/backend/extensiongrants/revoke'}", { grant_id: grantId }).then(function () {
      window.location.reload();
    }).catch(function () {
      button.removeAttribute('aria-busy');
    });
  });
  var copyButton = document.getElementById('ai-extension-copy');
  if (copyButton) {
    copyButton.addEventListener('click', function () {
      var text = copyButton.parentElement.querySelector('code');
      if (!text || !navigator.clipboard) { return; }
      navigator.clipboard.writeText(text.textContent || '');
    });
  }
})();
</script>

<script>
(function () {
  'use strict';
  var TYPE = 'weline-ai-ext';
  function post(url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(data || {})
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (payload) {
        if (!response.ok || payload.success === false) {
          throw new Error(payload.message || (response.statusText || 'Request failed'));
        }
        return payload;
      });
    });
  }
  function ask(action, payload) {
    return new Promise(function (resolve, reject) {
      var nonce = 'pg-' + action + '-' + Date.now();
      var timer = setTimeout(function () {
        window.removeEventListener('weline-ai-ext-reply', onReply);
        reject(new Error(action === 'status' ? 'extension not installed' : 'extension not responding'));
      }, 1500);
      function onReply(event) {
        var data = event.detail;
        if (!data || data.type !== TYPE || data.nonce !== nonce) { return; }
        clearTimeout(timer);
        window.removeEventListener('weline-ai-ext-reply', onReply);
        if (data.payload && data.payload.ok) { resolve(data.payload); }
        else { reject(new Error((data.payload && data.payload.error) || 'rejected')); }
      }
      window.addEventListener('weline-ai-ext-reply', onReply);
      window.dispatchEvent(new CustomEvent('weline-ai-ext-request', { detail: { type: TYPE, action: action, nonce: nonce, payload: payload || {} } }));
    });
  }
  var stateEl = document.getElementById('ai-extension-ext-status');
  var authStateEl = document.getElementById('ai-extension-authorize-state');
  function refreshExtStatus() {
    if (!stateEl) { return; }
    ask('status', {}).then(function (p) {
      stateEl.textContent = p.authorized ? '已授权，运行中' : '已安装，待授权';
    }).catch(function () {
      stateEl.textContent = '未安装或未启用';
    });
  }
  var authButton = document.getElementById('ai-extension-authorize');
  if (authButton) {
    authButton.addEventListener('click', function () {
      authButton.setAttribute('aria-busy', 'true');
      if (authStateEl) { authStateEl.textContent = ''; }
      post("@backend-url{'ai/backend/extension/pairing/execute'}", {
        ext_id: 'weline-ai-assistant',
        device_fp: 'browser-' + (navigator.platform || 'unknown')
      }).then(function (payload) {
        if (!payload.access) { throw new Error(payload.message || 'pairing failed'); }
        return ask('pairing', { access: payload.access, origin: window.location.origin });
      }).then(function () {
        if (authStateEl) { authStateEl.textContent = '已授权'; }
        setTimeout(function () { window.location.reload(); }, 800);
      }).catch(function (error) {
        if (authStateEl) { authStateEl.textContent = '授权失败：' + (error.message || '未知错误'); }
      }).finally(function () {
        authButton.removeAttribute('aria-busy');
      });
    });
  }
  refreshExtStatus();
})();
</script>
