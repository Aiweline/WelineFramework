    font-weight: 600;
}

.weline-ai-model-detail-container .table td {
    vertical-align: middle;
}
</style>


<script>
(function() {
    'use strict';

    window.testConnection = function(button) {
        Weline.UI.dialog.confirm('<?= __('确定要测试此模型的连接吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
        var btn = button;
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon> <?= __('测试中...') ?>';

        var url = '<?= $this->getBackendUrl('*/backend/model/testConnection') ?>';
        var opts = { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model_code: '<?= addslashes((string)$model->getModelCode()) ?>' }) };
        var req = window.Weline.Api.request(url, opts);
        req.then(function(res) {
            var data = (res && res.data) || res;
            var collectImages = function() {
                var collected = [];
                if (data && data.data && data.data.results) {
                    var s = data.data.results.self_config || {};
                    var p = data.data.results.provider_account || {};
                    if (Array.isArray(s.images)) collected = collected.concat(s.images);
                    if (Array.isArray(p.images)) collected = collected.concat(p.images);
                }
                if (Array.isArray(data && data.images)) collected = collected.concat(data.images);
                return collected;
            };
            var normalizeImageUrl = function(image) {
                var source = (image && image.url)
                    ? String(image.url)
                    : (image && image.b64_json ? ('data:' + ((image.mime_type) || 'image/png') + ';base64,' + image.b64_json) : '');
                if (/^data:image\/[a-z0-9.+-]+;base64,[a-z0-9+/=]+$/i.test(source)) return source;
                try {
                    var parsed = new URL(source, window.location.origin);
                    return ['http:', 'https:'].includes(parsed.protocol) ? parsed.href : '';
                } catch (_error) {
                    return '';
                }
            };
            var buildResultContent = function(parts, images) {
                var content = document.createElement('div');
                content.className = 'w-stack';
                var summary = document.createElement('div');
                (parts.length ? parts : [String((data && data.message) || '')]).forEach(function(text) {
                    var line = document.createElement('div');
                    line.textContent = text;
                    summary.appendChild(line);
                });
                content.appendChild(summary);
                if (!Array.isArray(images) || !images.length) return content;
                var title = document.createElement('strong');
                title.textContent = '<?= __('返回的测试图片') ?>';
                var gallery = document.createElement('div');
                gallery.className = 'w-grid';
                images.forEach(function(image) {
                    var source = normalizeImageUrl(image);
                    if (!source) return;
                    var link = document.createElement('a');
                    link.href = source;
                    link.target = '_blank';
                    link.rel = 'noopener';
                    link.style.setProperty('--w-span', '6');
                    var preview = document.createElement('img');
                    preview.src = source;
                    preview.alt = '<?= __('测试返回图片') ?>';
                    preview.className = 'w-ai-test-image';
                    link.appendChild(preview);
                    gallery.appendChild(link);
                });
                content.append(title, gallery);
                return content;
            };
            var images = collectImages();
            var summaryParts = [];
            if (data && data.data && data.data.results) {
                var s = data.data.results.self_config || {};
                var p = data.data.results.provider_account || {};
                if (s.tested) summaryParts.push('<?= __('自配置') ?>: ' + (s.success ? '<?= __('成功') ?>' : '<?= __('失败') ?>') + (s.message ? ' (' + s.message + ')' : ''));
                if (p.tested) summaryParts.push('<?= __('供应商账户') ?>: ' + (p.success ? '<?= __('成功') ?>' : '<?= __('失败') ?>') + (p.message ? ' (' + p.message + ')' : ''));
            }
            var resultContent = buildResultContent(summaryParts, images);
            if (data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('连接测试成功') ?>',
                    message: resultContent,
                    confirmLabel: '<?= __('确定') ?>',
                    size: images.length ? 'lg' : 'sm'
                });
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('连接测试失败') ?>',
                    message: resultContent,
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
        })
        .catch(function(err) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('请求失败') ?>',
                message: (err && err.message) || '<?= __('请重试') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<w:icon name="link" size="sm"></w:icon> <?= __('测试连接') ?>';
        });
        });
    };

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-ai-model-detail-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        if (trigger.getAttribute('data-ai-model-detail-action') === 'test-connection') {
            window.testConnection(trigger);
        }
    });
})();
</script>
