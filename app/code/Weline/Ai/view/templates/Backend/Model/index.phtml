<script>
(function() {
    'use strict';

    function apiRequest(url, opts) {
        var operation = url;
        var payload = opts || {};
        if (payload && payload.body) {
            if (typeof payload.body === 'string') {
                try { payload = JSON.parse(payload.body); } catch (e) { payload = {}; }
            } else if (typeof FormData !== 'undefined' && payload.body instanceof FormData) {
                payload = Object.fromEntries(payload.body.entries());
            }
        }
        return Promise.resolve(window.Weline.Api.resource('ai')[operation](payload)).then(function(result) {
            // 保留 bin-query 的完整业务响应；调用方统一从 response.data 读取 success/message/data。
            return { ok: true, data: result };
        });
    }

    function aiApi() {
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            return Promise.reject(new Error('Weline.Api.resource is unavailable.'));
        }
        return Promise.resolve(window.Weline.Api.resource('ai'));
    }

    // 批量选择功能
    window.toggleSelectAll = function() {
        const selectAll = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.model-checkbox');
        checkboxes.forEach(cb => {
            cb.checked = selectAll.checked;
        });
        updateBulkActions();
    };

    window.updateBulkActions = function() {
        const checkboxes = document.querySelectorAll('.model-checkbox:checked');
        const count = checkboxes.length;
        const bulkActions = document.getElementById('bulkActions');
        const selectedCount = document.getElementById('selectedCount');
        
        if (count > 0) {
            bulkActions.style.display = 'block';
            selectedCount.textContent = count;
        } else {
            bulkActions.style.display = 'none';
        }
    };

    function getSelectedIds() {
        const checkboxes = document.querySelectorAll('.model-checkbox:checked');
        return Array.from(checkboxes).map(cb => cb.value);
    }

    function getSelectedDeletableIds() {
        return Array.from(document.querySelectorAll('.model-checkbox:checked'))
            .filter(function(checkbox) { return checkbox.dataset.canDelete === '1'; })
            .map(function(checkbox) { return checkbox.value; });
    }

    function modelIndexUrl() {
        return window.location.pathname;
    }

    function queryErrorMessage(error, fallback) {
        var response = error && error.response && error.response.data ? error.response.data : null;
        return (response && (response.message || response.msg)) || (error && error.message) || fallback;
    }

    // 批量激活
    window.bulkActivate = function() {
        const ids = getSelectedIds();
        if (ids.length === 0) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请先选择要激活的模型') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        Weline.UI.dialog.confirm('<?= __('确定要激活选中的模型吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
            apiRequest('modelBulkToggleStatus', {ids: ids, status: 1})
            .then(function(response) {
                var data = response.data;
                if (response.ok && data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('成功') ?>',
                    message: data.message,
                    duration: 2000,
                    confirmable: false
                }).then(() => location.reload());
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
        });
        });
    };

    // 批量禁用
    window.bulkDeactivate = function() {
        const ids = getSelectedIds();
        if (ids.length === 0) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请先选择要禁用的模型') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        Weline.UI.dialog.confirm('<?= __('确定要禁用选中的模型吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
            apiRequest('modelBulkToggleStatus', {ids: ids, status: 0})
            .then(function(response) {
                var data = response.data;
                if (response.ok && data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('成功') ?>',
                    message: data.message,
                    duration: 2000,
                    confirmable: false
                }).then(() => location.reload());
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
        });
        });
    };

    // 批量删除
    window.bulkDelete = function() {
        const ids = getSelectedIds();
        const deletableIds = getSelectedDeletableIds();
        const protectedCount = ids.length - deletableIds.length;
        if (ids.length === 0) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请先选择要删除的模型') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }

        if (deletableIds.length === 0) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('选中的模型均受保护；只有复制模型或自定义模型可以删除') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        Weline.UI.dialog.confirm('<?= __('确定要删除选中的可删除模型吗？此操作不可恢复。') ?>').then(function(confirmed) {
            if (!confirmed) return;
            aiApi().then(function(api) { return api.modelBulkDelete({ids: deletableIds}); })
            .then(function(data) {
                if (data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('成功') ?>',
                    message: data.message + (protectedCount > 0 ? '；<?= __('已跳过') ?> ' + protectedCount + ' <?= __('个受保护模型') ?>' : ''),
                    duration: 2000,
                    confirmable: false
                }).then(() => location.reload());
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
            })
            .catch(function(error) {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('删除失败') ?>',
                    message: queryErrorMessage(error, '<?= __('删除失败，请重试') ?>'),
                    confirmLabel: '<?= __('确定') ?>'
                });
            });
        });
    };

    // 批量测试连接
    window.bulkTestConnection = function() {
        const ids = getSelectedIds();
        if (ids.length === 0) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请先选择要测试的模型') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        var progressModal = createProgressModal();
        Weline.UI.dialog.open(progressModal);
        
        updateProgress(progressModal, '开始测试 ' + ids.length + ' 个模型...');
        
        apiRequest('modelBulkTestConnection', {model_ids: ids})
        .then(function(response) {
            var data = response.data;
            if (response.ok && data && data.success) {
                showTestResults(data.results, data.summary);
                Weline.UI.dialog.close(progressModal);
                setTimeout(() => location.reload(), 3000);
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('测试失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
                Weline.UI.dialog.close(progressModal);
            }
        })
        .catch(function(error) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('请求失败') ?>',
                message: (error && error.message) || '<?= __('请求失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            Weline.UI.dialog.close(progressModal);
        });
    };

    // 创建进度弹窗
    function createProgressModal() {
        var modalHtml = '<div class="w-dialog" id="progressModal" tabindex="-1" data-w-component="dialog" data-state="closed" hidden aria-hidden="true">' +
            '<div class="w-dialog__frame">' +
            '<div class="w-dialog__surface">' +
            '<div class="w-dialog__body w-text" data-align="center" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);">' +
            '<div class="w-spinner w-text" role="status" data-tone="primary" style="--w-mb:var(--weline-space-4);">' +
            '<span class="w-visually-hidden"><?= __('加载中...') ?></span>' +
            '</div>' +
            '<h5 id="progressText">正在测试...</h5>' +
            '<p class="w-text" id="progressDetail" data-tone="muted" style="--w-mb:0;">请稍候，正在测试模型连接</p>' +
            '</div></div></div></div>';
        
        var existingModal = document.getElementById('progressModal');
        if (existingModal) {
            existingModal.remove();
        }
        
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        var progressDialog = document.getElementById('progressModal');
        progressDialog.dataset.wBackdrop = 'static';
        progressDialog.dataset.wClosable = 'false';
        return progressDialog;
    }

    // 更新进度文本
    function updateProgress(modal, text, detail) {
        var progressText = document.getElementById('progressText');
        var progressDetail = document.getElementById('progressDetail');
        if (progressText) progressText.textContent = text;
        if (progressDetail) progressDetail.textContent = detail || '';
    }

    // 显示测试结果
    function showTestResults(results, summary) {
        var resultHtml = '<div class="w-dialog" id="testResultModal" tabindex="-1" data-w-component="dialog" data-state="closed" hidden aria-hidden="true">' +
            '<div class="w-dialog__frame" data-size="lg">' +
            '<div class="w-dialog__surface">' +
            '<div class="w-dialog__header">' +
            '<h5 class="w-dialog__title">批量测试结果</h5>' +
            '<button type="button" class="w-button" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm"></button>' +
            '</div>' +
            '<div class="w-dialog__body">' +
            '<div class="w-alert" data-tone="info" style="--w-mb:var(--weline-space-4);">' +
            '<strong>测试统计：</strong> 总计 ' + summary.total + ' 个，成功 <span class="w-text" data-tone="success">' + summary.success + '</span> 个，失败 <span class="w-text" data-tone="danger">' + summary.failed + '</span> 个' +
            '</div>' +
            '<div class="w-table-wrap">' +
            '<table class="w-table"><thead><tr><th>模型</th><th>状态</th><th>消息</th><th>耗时</th></tr></thead><tbody>';
        
        results.forEach(function(result) {
            var statusClass = result.success ? 'success' : 'danger';
            var statusText = result.success ? '成功' : '失败';
            var duration = result.duration ? (result.duration + 'ms') : '-';
            
            resultHtml += '<tr>' +
                '<td>' + (result.model_name || result.model_code) + '</td>' +
                '<td><span class="w-badge bg-' + statusClass '">' + statusText + '</span></td>' +
                '<td>' + result.message + '</td>' +
                '<td>' + duration + '</td>' +
                '</tr>';
        });
        
        resultHtml += '</tbody></table></div></div>' +
            '<div class="w-dialog__footer">' +
            '<button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral">关闭</button>' +
            '</div></div></div></div>';
        
        var existingModal = document.getElementById('testResultModal');
        if (existingModal) {
            existingModal.remove();
        }
        
        document.body.insertAdjacentHTML('beforeend', resultHtml);
        Weline.UI.dialog.open('#testResultModal');
    }

    // 删除单个模型
    window.deleteModel = function(modelId, modelCode, canDelete) {
        if (!canDelete) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('受保护模型不能删除，只能删除复制模型或自定义模型') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        Weline.UI.dialog.confirm('<?= __('确定要删除模型') ?> ' + modelCode + ' <?= __('吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
            aiApi().then(function(api) { return api.modelDelete({id: modelId}); })
            .then(function(data) {
                if (data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('成功') ?>',
                    message: data.message || '<?= __('删除成功') ?>',
                    duration: 2000,
                    confirmable: false
                }).then(() => window.location.reload());
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('删除失败') ?>',
                    message: data.message || '<?= __('删除失败') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
        })
        .catch(error => {
            console.error('<?= __('删除失败:') ?>', error);
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('错误') ?>',
                message: '<?= __('删除失败，请重试') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        });
        });
    };

    window.toggleStatusByCode = function(modelCode) {
        apiRequest('modelToggleStatus', {model_code: modelCode})
        .then(function(response) {
            var data = response.data;
            if (response.ok && data && data.success) {
                location.reload();
                return;
            }
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('操作失败') ?>',
                message: (data && data.message) || '<?= __('操作失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        })
        .catch(function(error) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('操作失败') ?>',
                message: queryErrorMessage(error, '<?= __('操作失败，请重试') ?>'),
                confirmLabel: '<?= __('确定') ?>'
            });
        });
    };

    window.applyFilters = function() {
        var vendor = document.getElementById('vendorFilter').value;
        var status = document.getElementById('statusFilter').value;
        var search = document.getElementById('searchInput').value;

        var params = new URLSearchParams();
        if (vendor) params.append('vendor', vendor);
        if (status) params.append('status', status);
        if (search) params.append('search', search);

        window.location.href = modelIndexUrl() + '?' + params.toString();
    };

    window.resetFilters = function() {
        window.location.href = modelIndexUrl();
    };

    window.goPage = function(page) {
        var vendor = document.getElementById('vendorFilter').value;
        var status = document.getElementById('statusFilter').value;
        var search = document.getElementById('searchInput').value;
        var params = new URLSearchParams();
        if (vendor) params.append('vendor', vendor);
        if (status) params.append('status', status);
        if (search) params.append('search', search);
        params.append('page', String(page || 1));
        window.location.href = modelIndexUrl() + '?' + params.toString();
    };

    // 测试模型连通性
    window.testModelConnection = function(modelCode, trigger) {
        if (!modelCode) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('模型代码不能为空') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        var btn = trigger || (window.event && window.event.target ? window.event.target.closest('button') : null);
        var originalHtml = btn ? btn.innerHTML : '';
        if (btn) {
            btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon>';
            btn.disabled = true;
        }
        
        var testModal = createTestModal();
        document.body.appendChild(testModal);
        
        apiRequest('modelTestConnection', {model_code: modelCode})
        .then(function(response) {
            var data = response.data;
            if (btn) {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
            document.body.removeChild(testModal);
            
            if (data && data.data && data.data.results) {
                var r = data.data.results;
                var s = r.self_config || {};
                var p = r.provider_account || {};
                var sStatus = s.tested ? (s.success ? '<span class="w-badge" data-w-background="success">成功</span>' : '<span class="w-badge" data-w-background="danger">失败</span>') : '<span class="w-badge w-text" data-w-background="warning" data-tone="muted">未配置，未执行</span>';
                var pStatus = p.tested ? (p.success ? '<span class="w-badge" data-w-background="success">成功</span>' : '<span class="w-badge" data-w-background="danger">失败</span>') : '<span class="w-badge" data-w-background="muted">未测</span>';
                var html = '自配置结果：' + sStatus + '\n' +
                    (s.tested ? '消息：' + (s.message || '') + '\n耗时：' + (s.duration || 0) + 'ms\n响应：' + ((s.response || '').toString().slice(0,500)) + '\n\n' : '说明：' + (s.message || '<?= __('未配置独立 API Key，未执行自配置测试') ?>') + '\n\n') +
                    '供应商账户结果：' + pStatus + '\n' +
                    (p.tested ? '消息：' + (p.message || '') + '\n耗时：' + (p.duration || 0) + 'ms\n账户：' + (p.account_name || '') + '\n响应：' + ((p.response || '').toString().slice(0,500)) : '');
                var __ok = !!data.success;
                var __retryName = null;
                if (!__ok) {
                    __retryName = '__retry_test_' + Date.now();
                    window[__retryName] = function() { testModelConnection(modelCode); };
                }
                var images = [];
                if (Array.isArray(s.images)) images = images.concat(s.images);
                if (Array.isArray(p.images)) images = images.concat(p.images);
                showResultModal(__ok ? 'success' : 'error', '连通测试结果', html, __ok, __retryName, null, images);
            } else if (data.success) {
                var images2 = Array.isArray(data.images) ? data.images : [];
                showResultModal('success', '连通测试成功', data.message || '', true, null, null, images2);
            } else {
                var fnName = '__retry_test_' + Date.now();
                window[fnName] = function() { testModelConnection(modelCode); };
                showResultModal('error', '连通测试失败', data.message, false, fnName);
            }
        })
        .catch(error => {
            if (btn) {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
            document.body.removeChild(testModal);
            
            var fnName = '__retry_test_' + Date.now();
            window[fnName] = function() { testModelConnection(modelCode); };
            showResultModal('error', '连通测试失败', queryErrorMessage(error, '<?= __('测试失败，请重试') ?>'), false, fnName);
        });
    };

    // 测试自配置连通性
    window.testSelfConfigConnection = function(modelCode, trigger) {
        if (!modelCode) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('模型代码不能为空') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            return;
        }
        
        var btn = trigger || (window.event && window.event.target ? window.event.target.closest('button') : null);
        var originalHtml = btn ? btn.innerHTML : '';
        if (btn) {
            btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon>';
            btn.disabled = true;
        }
        
        var testModal = createTestModal();
        document.body.appendChild(testModal);
        
        apiRequest('modelTestSelfConfig', {model_code: modelCode})
        .then(function(response) {
            var data = response.data;
            if (btn) {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
            document.body.removeChild(testModal);
            
            if (data.success) {
                var message = data.data ?
                    data.message + '\n\n响应时间: ' + data.data.duration + 'ms\n响应内容: ' + data.data.response :
                    data.message;
                var imagesSelf = (data.data && Array.isArray(data.data.images)) ? data.data.images : (Array.isArray(data.images) ? data.images : []);
                showResultModal('success', '自配置连通测试成功', message, true, null, null, imagesSelf);
            } else {
                var fnName = '__retry_self_' + Date.now();
                window[fnName] = function() { testSelfConfigConnection(modelCode); };
                showResultModal('error', '自配置连通测试失败', data.message, false, fnName);
            }
        })
        .catch(error => {
            if (btn) {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
            document.body.removeChild(testModal);
            
            var fnName = '__retry_self_' + Date.now();
            window[fnName] = function() { testSelfConfigConnection(modelCode); };
            showResultModal('error', '自配置连通测试失败', queryErrorMessage(error, '<?= __('测试失败，请重试') ?>'), false, fnName);
        });
    };

    // 创建测试中弹窗
    function createTestModal() {
        var modal = document.createElement('div');
        modal.className = 'modal fade show';
        modal.style.display = 'block';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        modal.innerHTML = '<div class="w-dialog__frame">' +
            '<div class="w-dialog__surface">' +
            '<div class="w-dialog__body w-text" data-align="center">' +
            '<div class="w-spinner w-text" role="status" data-tone="primary" style="--w-mb:var(--weline-space-4);">' +
            '<span class="w-visually-hidden"><?= __('加载中...') ?></span>' +
            '</div>' +
            '<h5>正在测试连通性...</h5>' +
            '<p class="w-text" data-tone="muted">请稍候，正在连接AI服务</p>' +
            '</div></div></div>';
        return modal;
    }

    function escapeHtmlForResult(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function renderTestImagesBlock(images) {
        if (!Array.isArray(images) || images.length === 0) {
            return '';
        }
        var items = images.map(function(image) {
            var src = (image && image.url)
                ? image.url
                : (image && image.b64_json ? ('data:' + ((image.mime_type) || 'image/png') + ';base64,' + image.b64_json) : '');
            if (!src) return '';
            var safeSrc = escapeHtmlForResult(src);
            var revised = image && image.revised_prompt ? '<div class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-1);">' + escapeHtmlForResult(image.revised_prompt) + '</div>' : '';
            return '<div style="--w-span:12;--w-span-md:6;--w-mb:var(--weline-space-2);">'
                + '<a href="' + safeSrc + '" target="_blank" rel="noopener">'
                + '<img src="' + safeSrc + '" class="img-fluid" style="max-height: 280px; width: 100%; object-fit: contain; background: #fff;" alt="<?= __('测试图片') ?>" data-w-radius="md" data-w-border="border">'
                + '</a>' + revised + '</div>';
        }).join('');
        if (!items) return '';
        return '<div class="w-grid" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-4);">'
            + '<div class="w-text" data-weight="strong" style="--w-span:12;--w-mb:var(--weline-space-1);"><w:icon name="image" size="sm"></w:icon><?= __('返回的测试图片') ?></div>'
            + items
            + '</div>';
    }

    // 显示结果弹窗
    function showResultModal(type, title, message, refreshOnClose, retryFnName, retryLabel, images) {
        retryLabel = retryLabel || '<?= __('重试') ?>';
        var modal = document.createElement('div');
        modal.className = 'modal fade show';
        modal.style.display = 'block';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        if (refreshOnClose) {
            modal.setAttribute('data-refresh-on-close', '1');
        }
        var uid = 'retryBtn_' + Date.now();
        var retryButtonHtml = retryFnName ? '<button type="button" class="w-button" id="' + uid + '" data-tone="primary" data-variant="outline">' + retryLabel + '</button>' : '';
        var imagesHtml = renderTestImagesBlock(images);
        var dialogClass = imagesHtml !== '' ? 'modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable' : 'modal-dialog modal-dialog-centered';
        modal.innerHTML = '<div class="' + dialogClass + '">' +
            '<div class="w-dialog__surface">' +
            '<div class="w-dialog__header">' +
            '<h5 class="w-dialog__title">' +
            '<i class="mdi mdi-' + (type === 'success' ? 'check-circle text-success' : 'alert-circle text-danger') + '"></i> ' + title +
            '</h5>' +
            '<button type="button" class="w-button" data-model-action="close-result-modal" data-w-close="" data-tone="quiet" data-size="sm"></button>' +
            '</div>' +
            '<div class="w-dialog__body">' +
            '<pre style="white-space: pre-wrap; font-size: 14px;">' + message + '</pre>' +
            imagesHtml +
            '</div>' +
            '<div class="w-dialog__footer">' +
            retryButtonHtml +
            '<button type="button" class="w-button" data-model-action="close-result-modal" data-tone="primary"><?= __('确定') ?></button>' +
            '</div></div></div>';
        document.body.appendChild(modal);
        if (retryFnName && typeof window[retryFnName] === 'function') {
            var btn = modal.querySelector('#' + uid);
            if (btn) {
                btn.addEventListener('click', function() {
                    try { window[retryFnName](); } catch (e) {}
                    closeResultModal(btn);
                });
            }
        }
    }

    // 关闭结果弹窗
    window.closeResultModal = function(btn) {
        var modal = btn.closest('.modal');
        var shouldRefresh = modal && modal.getAttribute('data-refresh-on-close') === '1';
        document.body.removeChild(modal);
        if (shouldRefresh) {
            window.location.reload();
        }
    };

    window.showActivateBlocked = function(btn) {
        try {
            var reason = btn.getAttribute('data-reason') || '<?= __('条件不足') ?>';
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('无法激活') ?>',
                message: reason,
                confirmLabel: '<?= __('确定') ?>'
            });
        } catch (e) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('无法激活') ?>',
                message: '<?= __('条件不足') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        }
    };
    function readModelInt(trigger, name, fallback) {
        var value = parseInt(trigger.getAttribute(name) || '', 10);
        return Number.isNaN(value) ? fallback : value;
    }

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-model-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();

        var action = trigger.getAttribute('data-model-action') || '';
        var modelCode = trigger.getAttribute('data-model-code') || '';
        var modelId = readModelInt(trigger, 'data-model-id', 0);
        var page = readModelInt(trigger, 'data-page', 1);

        switch (action) {
            case 'bulk-test':
                window.bulkTestConnection();
                break;
            case 'bulk-activate':
                window.bulkActivate();
                break;
            case 'bulk-deactivate':
                window.bulkDeactivate();
                break;
            case 'bulk-delete':
                window.bulkDelete();
                break;
            case 'reset-filters':
                window.resetFilters();
                break;
            case 'test-provider':
                window.testModelConnection(modelCode, trigger);
                break;
            case 'test-self':
                window.testSelfConfigConnection(modelCode, trigger);
                break;
            case 'toggle-status':
                window.toggleStatusByCode(modelCode);
                break;
            case 'show-activate-blocked':
                window.showActivateBlocked(trigger);
                break;
            case 'delete':
                window.deleteModel(modelId, modelCode, trigger.getAttribute('data-can-delete') === '1');
                break;
            case 'page':
                window.goPage(page);
                break;
            case 'close-result-modal':
                window.closeResultModal(trigger);
                break;
        }
    });

    document.addEventListener('change', function(event) {
        var trigger = event.target.closest('[data-model-change]');
        if (trigger && (trigger.getAttribute('data-model-change') || '') === 'select-all') {
            window.toggleSelectAll();
            return;
        }
        if (event.target && event.target.classList && event.target.classList.contains('model-checkbox')) {
            window.updateBulkActions();
        }
    });

    var filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.addEventListener('submit', function(event) {
            event.preventDefault();
            window.applyFilters();
        });
    }
})();
</script>
