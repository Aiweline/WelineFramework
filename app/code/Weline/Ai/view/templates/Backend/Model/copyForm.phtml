<script>
(function() {
    'use strict';

    function closeCopyOffcanvas() {
        var frame = window.frameElement;
        var drawer = frame ? frame.closest('[data-w-component~="drawer"]') : null;
        if (window.parent && window.parent.Weline && window.parent.Weline.UI && drawer) {
            window.parent.Weline.UI.drawer.close(drawer, 'complete');
        }
    }

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-ai-model-copy-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        if (trigger.getAttribute('data-ai-model-copy-action') === 'close') {
            closeCopyOffcanvas();
        }
    });
    
    document.getElementById('copy-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        var modelName = document.getElementById('model_name').value.trim();
        var modelCode = document.getElementById('model_code').value.trim();
        
        if (!modelName) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请输入新模型名称') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            document.getElementById('model_name').focus();
            return false;
        }
        
        if (!modelCode) {
            Weline.UI.dialog.request({
                tone: 'warning',
                title: '<?= __('提示') ?>',
                message: '<?= __('请输入新模型代码') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            document.getElementById('model_code').focus();
            return false;
        }
        
        var codePattern = /^[a-zA-Z0-9._-]+$/;
        if (!codePattern.test(modelCode)) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('格式错误') ?>',
                message: '<?= __('模型代码只能包含字母、数字、点号(.)、下划线(_)和中划线(-)') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            document.getElementById('model_code').focus();
            return false;
        }
        
        var btn = this.querySelector('button[type="submit"]');
        var originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon> <?= __('复制中...') ?>';
        
        var formData = new FormData(this);
        window.Weline.Api.request('<?= $this->getBackendUrl('*/backend/model/copy') ?>', { method: 'POST', body: formData })
        .then(function(response) {
            var data = response.data;
            if (response.ok && data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('复制成功') ?>',
                    message: '<?= __('模型已成功复制') ?>',
                    duration: 2000,
                    confirmable: false
                }).then(function() {
                    closeCopyOffcanvas();
                    setTimeout(function() {
                        window.parent.location.reload();
                    }, 500);
                });
            } else {
                var errMsg = (data && (data.message || data.msg)) || '<?= __('复制失败') ?>';
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('复制失败') ?>',
                    message: errMsg,
                    confirmLabel: '<?= __('确定') ?>'
                });
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        })
        .catch(function(error) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('请求失败') ?>',
                message: error.message,
                confirmLabel: '<?= __('确定') ?>'
            });
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        });
        
        return false;
    });
    
    document.getElementById('model_name').select();
})();
</script>

