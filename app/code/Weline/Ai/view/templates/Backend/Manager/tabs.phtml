<?php
/**
 * AI 管理顶部 Tab 栏（页面级导航，官方 w-tabs soft 变体）
 * @var string $activeTab 当前 Tab：model | adapter | agent | skill | style | custom_vendor | account
 * @var \Weline\Framework\View\Template $this
 */
$activeTab = $activeTab ?? 'model';
$h = static function ($s): string {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
};

$modelUrl = $h($this->getBackendUrl('ai/backend/model'));
$adapterUrl = $h($this->getBackendUrl('ai/backend/adapter'));
$agentUrl = $h($this->getBackendUrl('ai/backend/agent'));
$skillUrl = $h($this->getBackendUrl('ai/backend/skill'));
$styleUrl = $h($this->getBackendUrl('ai/backend/style'));
$customVendorUrl = $h($this->getBackendUrl('ai/backend/customvendor'));
$providerUrl = $h($this->getBackendUrl('ai/backend/provider'));

$modelSelected = $activeTab === 'model' ? 'true' : 'false';
$adapterSelected = $activeTab === 'adapter' ? 'true' : 'false';
$agentSelected = $activeTab === 'agent' ? 'true' : 'false';
$skillSelected = $activeTab === 'skill' ? 'true' : 'false';
$styleSelected = $activeTab === 'style' ? 'true' : 'false';
$customVendorSelected = $activeTab === 'custom_vendor' ? 'true' : 'false';
$accountSelected = $activeTab === 'account' ? 'true' : 'false';

$modelTabIndex = $activeTab === 'model' ? '0' : '-1';
$adapterTabIndex = $activeTab === 'adapter' ? '0' : '-1';
$agentTabIndex = $activeTab === 'agent' ? '0' : '-1';
$skillTabIndex = $activeTab === 'skill' ? '0' : '-1';
$styleTabIndex = $activeTab === 'style' ? '0' : '-1';
$customVendorTabIndex = $activeTab === 'custom_vendor' ? '0' : '-1';
$accountTabIndex = $activeTab === 'account' ? '0' : '-1';

$tabsAriaLabel = $h(__('AI 管理'));
$modelLabel = $h(__('模型'));
$adapterLabel = $h(__('适配器'));
$agentLabel = $h(__('智能体'));
$skillLabel = $h(__('技能'));
$styleLabel = $h(__('风格'));
$customVendorLabel = $h(__('本地供应商'));
$accountLabel = $h(__('供应商账户'));
?>
<style>
/* AI 管理 Tab：强制图标+文案横排、垂直居中（不依赖外部 CSS 缓存） */
.weline-ai-manager-tabs.w-tabs__list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--weline-space-1);
    overflow-x: auto;
}
.weline-ai-manager-tabs .w-tabs__tab {
    display: inline-flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: center;
    gap: var(--weline-space-2);
    white-space: nowrap;
}
.weline-ai-manager-tabs .w-tabs__tab > .w-icon,
.weline-ai-manager-tabs .w-tabs__tab > svg {
    display: block;
    flex: 0 0 auto;
}
.weline-ai-manager-tabs .w-tabs__tab > span {
    display: inline;
    line-height: 1.2;
}
</style>
<nav class="w-tabs__list weline-ai-manager-tabs" data-variant="soft" role="tablist" aria-label="<?= $tabsAriaLabel ?>" style="--w-mb:var(--weline-space-5);">
    <a class="w-tabs__tab" href="<?= $modelUrl ?>" role="tab" aria-selected="<?= $modelSelected ?>" tabindex="<?= $modelTabIndex ?>">
        <w:icon name="robot"></w:icon>
        <span><?= $modelLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $adapterUrl ?>" role="tab" aria-selected="<?= $adapterSelected ?>" tabindex="<?= $adapterTabIndex ?>">
        <w:icon name="puzzle"></w:icon>
        <span><?= $adapterLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $agentUrl ?>" role="tab" aria-selected="<?= $agentSelected ?>" tabindex="<?= $agentTabIndex ?>">
        <w:icon name="sparkles"></w:icon>
        <span><?= $agentLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $skillUrl ?>" role="tab" aria-selected="<?= $skillSelected ?>" tabindex="<?= $skillTabIndex ?>">
        <w:icon name="bolt"></w:icon>
        <span><?= $skillLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $styleUrl ?>" role="tab" aria-selected="<?= $styleSelected ?>" tabindex="<?= $styleTabIndex ?>">
        <w:icon name="palette"></w:icon>
        <span><?= $styleLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $customVendorUrl ?>" role="tab" aria-selected="<?= $customVendorSelected ?>" tabindex="<?= $customVendorTabIndex ?>">
        <w:icon name="server"></w:icon>
        <span><?= $customVendorLabel ?></span>
    </a>
    <a class="w-tabs__tab" href="<?= $providerUrl ?>" role="tab" aria-selected="<?= $accountSelected ?>" tabindex="<?= $accountTabIndex ?>">
        <w:icon name="user"></w:icon>
        <span><?= $accountLabel ?></span>
    </a>
</nav>
