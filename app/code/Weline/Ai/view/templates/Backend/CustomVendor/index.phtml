<script>
(function () {
    var listUrl = <?= json_encode($listUrl, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var deleteUrl = <?= json_encode($deleteUrl, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var toggleUrl = <?= json_encode($toggleUrl, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var drawerId = <?= json_encode($drawerId, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var addTitle = <?= json_encode($addTitle, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var editTitle = <?= json_encode($editTitle, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var tbody = document.getElementById('custom-vendor-tbody');
    var addBtn = document.getElementById('custom-vendor-add-btn');
    var drawer = document.getElementById(drawerId);
    var frame = drawer ? drawer.querySelector('[data-w-remote-frame]') : null;
    var titleEl = drawer ? drawer.querySelector('[data-cv-drawer-title]') : null;

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[ch];
        });
    }

    function openVendorDrawer(id) {
        if (!drawer || !frame || !addBtn) {
            return;
        }
        var baseSrc = frame.getAttribute('data-cv-base-src') || frame.getAttribute('data-src') || '';
        if (!baseSrc) {
            return;
        }
        var url = new URL(baseSrc, window.location.origin);
        url.searchParams.set('id', String(id || 0));
        url.searchParams.set('isIframe', 'true');
        frame.setAttribute('data-src', url.toString());
        frame.removeAttribute('src');
        if (titleEl) {
            titleEl.textContent = Number(id) > 0 ? editTitle : addTitle;
        }
        if (window.Weline && Weline.UI && Weline.UI.drawer && typeof Weline.UI.drawer.open === 'function') {
            Weline.UI.drawer.open(drawer);
            return;
        }
        addBtn.click();
    }

    function loadList() {
        fetch(listUrl, {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res || !res.success) {
                    tbody.innerHTML = '<tr><td colspan="2">' + esc((res && res.message) || '加载失败') + '</td></tr>';
                    return;
                }
                var rows = res.data || [];
                if (!rows.length) {
                    tbody.innerHTML = '<tr><td colspan="2"><?= __('暂无本地供应商，请点击「添加本地供应商」') ?></td></tr>';
                    return;
                }
                tbody.innerHTML = rows.map(function (row) {
                    var active = Number(row.is_active) === 1;
                    var status = active
                        ? '<span class="w-badge" data-w-background="success"><?= __('启用') ?></span>'
                        : '<span class="w-badge" data-w-background="muted"><?= __('停用') ?></span>';
                    var testModel = row.test_model ? esc(row.test_model) : '—';
                    var meta = '<div class="cv-vendor-meta">' +
                        '<span><code>' + esc(row.code) + '</code></span>' +
                        '<span><?= __('Base URL') ?>：<code>' + esc(row.base_url || '—') + '</code></span>' +
                        '<span><?= __('测试模型') ?>：' + testModel + '</span>' +
                        '</div>';
                    var foot = '<div class="cv-vendor-foot">' + status +
                        '<span>' + esc(String(row.accounts || 0)) + ' <?= __('账户') ?> · ' +
                        esc(String(row.models || 0)) + ' <?= __('模型') ?></span>' +
                        '</div>';
                    return '<tr data-id="' + esc(row.id) + '">' +
                        '<td class="cv-vendor-cell">' +
                        '<div class="cv-vendor-title">' + esc(row.name || row.code) + '</div>' +
                        meta + foot +
                        '</td>' +
                        '<td class="cv-actions">' +
                        '<div class="w-cluster" style="--w-gap:var(--weline-space-1);">' +
                        '<button type="button" class="w-button" data-size="sm" data-tone="primary" data-variant="outline" data-cv-edit="' + esc(row.id) + '"><?= __('编辑') ?></button>' +
                        '<button type="button" class="w-button" data-size="sm" data-tone="neutral" data-variant="outline" data-cv-toggle="' + esc(row.id) + '" data-active="' + esc(row.is_active) + '">' +
                        (active ? '<?= __('停用') ?>' : '<?= __('启用') ?>') +
                        '</button>' +
                        '<button type="button" class="w-button" data-size="sm" data-tone="danger" data-variant="outline" data-cv-del="' + esc(row.id) + '"><?= __('删除') ?></button>' +
                        '</div></td></tr>';
                }).join('');
            })
            .catch(function (e) {
                tbody.innerHTML = '<tr><td colspan="2">' + esc(e.message || '加载失败') + '</td></tr>';
            });
    }

    function showToast(type, message) {
        try {
            if (window.Weline && Weline.UI && Weline.UI.toast && typeof Weline.UI.toast[type] === 'function') {
                Weline.UI.toast[type](message);
            }
        } catch (e) {}
    }

    function confirmAction(message, tone) {
        try {
            if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.confirm === 'function') {
                return Weline.UI.dialog.confirm(message, {tone: tone || 'warning'});
            }
        } catch (e) {}
        return Promise.resolve(false);
    }

    function postForm(url, data) {
        var body = new URLSearchParams();
        Object.keys(data).forEach(function (k) { body.set(k, data[k]); });
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body.toString()
        }).then(function (r) { return r.json(); });
    }

    if (addBtn) {
        addBtn.addEventListener('click', function () {
            // 新建：重置到 id=0
            if (frame) {
                var baseSrc = frame.getAttribute('data-cv-base-src') || frame.getAttribute('data-src') || '';
                if (baseSrc) {
                    var url = new URL(baseSrc, window.location.origin);
                    url.searchParams.set('id', '0');
                    url.searchParams.set('isIframe', 'true');
                    frame.setAttribute('data-src', url.toString());
                    frame.removeAttribute('src');
                }
            }
            if (titleEl) {
                titleEl.textContent = addTitle;
            }
        });
    }

    document.getElementById('custom-vendor-refresh') && document.getElementById('custom-vendor-refresh').addEventListener('click', loadList);

    tbody.addEventListener('click', function (ev) {
        var t = ev.target.closest('[data-cv-edit],[data-cv-toggle],[data-cv-del]');
        if (!t) return;
        var id = t.getAttribute('data-cv-edit') || t.getAttribute('data-cv-toggle') || t.getAttribute('data-cv-del');
        if (t.hasAttribute('data-cv-edit')) {
            openVendorDrawer(id);
            return;
        }
        if (t.hasAttribute('data-cv-toggle')) {
            var next = Number(t.getAttribute('data-active')) === 1 ? 0 : 1;
            postForm(toggleUrl, {id: id, is_active: next}).then(function (res) {
                if (!res.success) {
                    showToast('error', res.message || '<?= __('操作失败') ?>');
                    return;
                }
                showToast('success', res.message || (next === 1 ? '<?= __('已启用') ?>' : '<?= __('已停用') ?>'));
                loadList();
            }).catch(function (e) {
                showToast('error', (e && e.message) || '<?= __('操作失败') ?>');
            });
            return;
        }
        if (t.hasAttribute('data-cv-del')) {
            confirmAction('<?= __('确认删除该本地供应商？') ?>', 'danger').then(function (ok) {
                if (!ok) return;
                postForm(deleteUrl, {id: id}).then(function (res) {
                    if (!res.success) {
                        showToast('error', res.message || '<?= __('删除失败') ?>');
                        return;
                    }
                    showToast('success', res.message || '<?= __('已删除') ?>');
                    loadList();
                }).catch(function (e) {
                    showToast('error', (e && e.message) || '<?= __('删除失败') ?>');
                });
            });
        }
    });

    loadList();
    window.addEventListener('message', function (ev) {
        if (ev && ev.data && ev.data.type === 'weline-ai-custom-vendor-saved') {
            loadList();
            if (drawer && window.Weline && Weline.UI && Weline.UI.drawer && typeof Weline.UI.drawer.close === 'function') {
                Weline.UI.drawer.close(drawer, 'saved');
            }
        }
    });
})();
</script>
