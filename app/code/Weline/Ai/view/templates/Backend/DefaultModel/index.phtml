                        <h5><?= __('受保护的模型') ?></h5>
                    </div>
                    <div class="w-card__body">
                        <p class="w-text" data-tone="muted"><?= __('以下模型被设置为默认模型，无法删除：') ?></p>
                        <div id="protectedModelsList"></div>
                    </div>
                </div>
            </div>
