                            <label class="w-field__label w-text" for="ai-style-description" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= __('描述') ?></label>
                            <textarea class="w-textarea" id="ai-style-description" rows="2" placeholder="<?= __('这个风格应该指导什么') ?>" data-size="sm"></textarea>
                        </div>

                        <?php foreach ($arrayFields as $field => $label): ?>
                            <div style="--w-mt:var(--weline-space-2);">
                                <label class="w-field__label w-text" for="ai-style-<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= \htmlspecialchars((string)$label, ENT_QUOTES, 'UTF-8') ?></label>
                                <textarea class="w-textarea style-editor" id="ai-style-<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" data-style-array="<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" rows="3" placeholder="<?= __('每行一个项目，或 JSON 数组') ?>" data-size="sm"></textarea>
                            </div>
                        <?php endforeach; ?>

                        <?php foreach ($objectFields as $field => $label): ?>
                            <div style="--w-mt:var(--weline-space-2);">
                                <label class="w-field__label w-text" for="ai-style-<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= \htmlspecialchars((string)$label, ENT_QUOTES, 'UTF-8') ?></label>
                                <textarea class="w-textarea style-editor is-large" id="ai-style-<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" data-style-object="<?= \htmlspecialchars($field, ENT_QUOTES, 'UTF-8') ?>" rows="4" placeholder='{"hero":"direction"}' data-size="sm"></textarea>
                            </div>
                        <?php endforeach; ?>

                        <div style="--w-mt:var(--weline-space-2);">
                            <label class="w-field__label w-text" for="ai-style-cta" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= __('CTA 风格') ?></label>
                            <textarea class="w-textarea" id="ai-style-cta" rows="2" data-size="sm"></textarea>
                        </div>

                        <div style="--w-mt:var(--weline-space-2);">
                            <label class="w-field__label w-text" for="ai-style-supplemental" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-1);"><?= __('补充提示词') ?></label>
                            <textarea class="w-textarea" id="ai-style-supplemental" rows="2" data-size="sm"></textarea>
                            <div class="w-field__hint"><?= __('自定义风格必须包含结构化字段，不能只填写补充说明。') ?></div>
                        </div>

                        <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-4);">
                            <button class="w-button" type="button" id="ai-style-save-btn" data-tone="success" data-size="sm">
                                <w:icon name="save" size="sm"></w:icon><?= __('保存') ?>
                            </button>
                            <button class="w-button" type="button" data-style-status-action="active" data-tone="success" data-variant="outline" data-size="sm"><?= __('启用') ?></button>
                            <button class="w-button" type="button" data-style-status-action="disabled" data-tone="danger" data-variant="outline" data-size="sm"><?= __('禁用') ?></button>
                            <button class="w-button" type="button" id="ai-style-clone-btn" data-tone="neutral" data-variant="outline" data-size="sm">
                                <w:icon name="copy" size="sm"></w:icon><?= __('克隆为自定义') ?>
                            </button>
                            <button class="w-button" type="button" id="ai-style-delete-btn" data-tone="danger" data-variant="outline" data-size="sm">
                                <w:icon name="trash" size="sm"></w:icon><?= __('删除') ?>
                            </button>
                        </div>

                        <div data-w-border="top" style="--w-pt:var(--weline-space-2);--w-mt:var(--weline-space-4);">
                            <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-2);"><?= __('当前上下文的适配器绑定') ?></div>
                            <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                                <button class="w-button" type="button" id="ai-style-bind-btn" data-tone="primary" data-size="sm"><?= __('绑定到适配器') ?></button>
                                <button class="w-button" type="button" id="ai-style-unbind-btn" data-tone="danger" data-variant="outline" data-size="sm"><?= __('移除手动绑定') ?></button>
                            </div>
                            <div class="w-text" id="ai-style-binding-help" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-2);"></div>
                        </div>

                        <div class="w-text" id="ai-style-form-status" data-size="sm" style="--w-mt:var(--weline-space-2);"></div>
                    </w:form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    var initialItems = <?= \json_encode($styles, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) ?: '[]' ?>;
    var initialAdapters = <?= \json_encode($adapters, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) ?: '[]' ?>;
    var i18n = <?= \json_encode($styleI18n, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) ?: '{}' ?>;

    var state = {
        items: Array.isArray(initialItems) ? initialItems : [],
        adapters: Array.isArray(initialAdapters) ? initialAdapters : [],
        selectedCode: '',
        selectedAdapter: '',
        draft: null
    };

    var els = {
        adapter: document.getElementById('ai-style-adapter'),
        adapterSummary: document.getElementById('ai-style-adapter-summary'),
        search: document.getElementById('ai-style-search'),
        statusFilter: document.getElementById('ai-style-status-filter'),
        sourceFilter: document.getElementById('ai-style-source-filter'),
        tableBody: document.getElementById('ai-style-table-body'),
        listStatus: document.getElementById('ai-style-status'),
        detailCard: document.querySelector('.weline-ai-style-page .style-detail-card'),
        empty: document.getElementById('ai-style-empty'),
        form: document.getElementById('ai-style-form'),
        detailTitle: document.getElementById('ai-style-detail-title'),
        detailMode: document.getElementById('ai-style-detail-mode'),
        badges: document.getElementById('ai-style-badges'),
        code: document.getElementById('ai-style-code'),
        name: document.getElementById('ai-style-name'),
        status: document.getElementById('ai-style-edit-status'),
        description: document.getElementById('ai-style-description'),
        cta: document.getElementById('ai-style-cta'),
        supplemental: document.getElementById('ai-style-supplemental'),
        save: document.getElementById('ai-style-save-btn'),
        remove: document.getElementById('ai-style-delete-btn'),
        clone: document.getElementById('ai-style-clone-btn'),
        bind: document.getElementById('ai-style-bind-btn'),
        unbind: document.getElementById('ai-style-unbind-btn'),
        bindingHelp: document.getElementById('ai-style-binding-help'),
        formStatus: document.getElementById('ai-style-form-status')
    };

    function aiOp(operation, data) {
        var run = function (api) {
            var resource = api.resource('ai');
            if (!resource || typeof resource[operation] !== 'function') {
                return Promise.reject(new Error(i18n.apiUnavailable));
            }
            return resource[operation](data || {}).then(function (res) {
                return res && Object.prototype.hasOwnProperty.call(res, 'data') ? res.data : res;
            });
        };
        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(run);
        }
        if (window.Weline && window.Weline.Api) {
            return Promise.resolve(run(window.Weline.Api));
        }
        return Promise.reject(new Error(i18n.apiUnavailable));
    }

    function responseErrorMessage(err, fallback) {
        var data = err && err.response && err.response.data ? err.response.data : null;
        var nested = data && data.error ? data.error : null;
        return (nested && (nested.message || nested.msg))
            || (data && (data.message || data.msg))
            || (err && err.message)
            || fallback;
    }

    function formatMessage(template, value) {
        return String(template || '').replace('%{1}', value);
    }

    function clearNode(node) {
        while (node && node.firstChild) {
            node.removeChild(node.firstChild);
        }
    }

    function text(tag, value, className) {
        var node = document.createElement(tag);
        if (className) {
            node.className = className;
        }
        node.textContent = value || '';
        return node;
    }

    function badge(value, className) {
        var span = document.createElement('span');
        span.className = 'badge ' + (className || 'text-bg-secondary');
        span.textContent = value || '';
        return span;
    }

    function chip(value) {
        var span = document.createElement('span');
        span.className = 'style-chip';
        span.textContent = value || '';
        return span;
    }

    function setStatus(el, message, isError) {
        if (!el) {
            return;
        }
        el.className = 'small mt-2 ' + (isError ? 'text-danger' : 'text-success');
        el.textContent = message || '';
    }

    function toList(value) {
        if (Array.isArray(value)) {
            return value;
        }
        if (value && typeof value === 'object') {
            return Object.keys(value).map(function (key) {
                var item = value[key];
                return typeof item === 'string' ? item : JSON.stringify(item);
            });
        }
        if (typeof value === 'string' && value !== '') {
            return [value];
        }
        return [];
    }

    function flatten(value) {
        return toList(value).join(' ');
    }

    function parseLines(value) {
        var raw = String(value || '').trim();
        if (raw === '') {
            return [];
        }
        try {
            var parsed = JSON.parse(raw);
            if (parsed && typeof parsed === 'object') {
                return parsed;
            }
        } catch (e) {}
        return raw.split(/\r?\n/).map(function (line) {
            return line.trim();
        }).filter(Boolean);
    }

    function parseObject(value) {
        var raw = String(value || '').trim();
        if (raw === '') {
            return {};
        }
        try {
            var parsed = JSON.parse(raw);
            if (parsed && typeof parsed === 'object') {
                return parsed;
            }
        } catch (e) {}
        return parseLines(raw);
    }

    function formatStructured(value) {
        if (Array.isArray(value)) {
            return value.map(function (item) {
                return typeof item === 'string' ? item : JSON.stringify(item);
            }).join("\n");
        }
        if (value && typeof value === 'object') {
            return JSON.stringify(value, null, 2);
        }
        return String(value || '');
    }

    function selectedAdapterCode() {
        return els.adapter ? String(els.adapter.value || '') : '';
    }

    function currentAdapter() {
        var code = selectedAdapterCode();
        return state.adapters.find(function (adapter) {
            return String(adapter.code || '') === code;
        }) || null;
    }

    function sourceGroup(style) {
        var sourceType = String(style.source_type || style.source || '');
        if (sourceType === 'system' || sourceType === 'module' || sourceType === 'builtin') {
            return 'module';
        }
        if (sourceType === 'custom') {
            return 'custom';
        }
        if (sourceType === 'missing') {
            return 'missing';
        }
        return sourceType;
    }

    function findSelectedStyle() {
        if (state.selectedCode === '__new__') {
            return state.draft;
        }
        return state.items.find(function (item) {
            return String(item.code || '') === state.selectedCode;
        }) || null;
    }

    function renderAdapters() {
        clearNode(els.adapter);
        if (!state.adapters.length) {
            state.selectedAdapter = '';
            return;
        }

        state.adapters.forEach(function (adapter) {
            var option = document.createElement('option');
            option.value = adapter.code || '';
            option.textContent = (adapter.name || adapter.code || '') + ' (' + (adapter.code || '') + ')';
            els.adapter.appendChild(option);
        });

        var preferred = state.adapters[0];
        state.selectedAdapter = preferred.code || '';
        els.adapter.value = state.selectedAdapter;
    }

    function renderAdapterSummary() {
        var adapter = currentAdapter();
        if (!adapter) {
            els.adapterSummary.textContent = i18n.adapterUnavailable;
            return;
        }
        var defaults = Array.isArray(adapter.default_style_codes) ? adapter.default_style_codes : [];
        var manual = Array.isArray(adapter.manual_style_codes) ? adapter.manual_style_codes : [];
        els.adapterSummary.textContent = i18n.defaultLabel + ': ' + (defaults.length ? defaults.join(', ') : i18n.noneLabel)
            + ' | ' + i18n.manualLabel + ': ' + (manual.length ? manual.join(', ') : i18n.noneLabel);
    }

    function filteredItems() {
        var q = String(els.search.value || '').trim().toLowerCase();
        var status = String(els.statusFilter.value || '');
        var source = String(els.sourceFilter.value || '');
        var items = state.items.slice();
        if (state.draft) {
            items.unshift(state.draft);
        }
        return items.filter(function (style) {
            var haystack = [
                style.code || '',
                style.name || '',
                style.description || '',
                style.source || '',
                style.source_type || '',
                style.source_module || '',
                flatten(style.industry_tags),
                flatten(style.match_keywords),
                flatten(style.visual_keywords),
                flatten(style.layout_patterns)
            ].join(' ').toLowerCase();
            if (q !== '' && haystack.indexOf(q) === -1) {
                return false;
            }
            if (status !== '' && String(style.status || '') !== status) {
                return false;
            }
            if (source !== '' && sourceGroup(style) !== source) {
                return false;
            }
            return true;
        });
    }

    function renderTable() {
        var items = filteredItems();
        clearNode(els.tableBody);
        if (!items.length) {
            var emptyRow = document.createElement('tr');
            var td = document.createElement('td');
            td.colSpan = 6;
            td.className = 'text-center text-muted py-4';
            td.textContent = i18n.noMatch;
            emptyRow.appendChild(td);
            els.tableBody.appendChild(emptyRow);
            els.listStatus.textContent = '0 / ' + state.items.length + i18n.stylesSuffix;
            return;
        }

        items.forEach(function (style) {
            var code = style._draft ? '__new__' : String(style.code || '');
            var tr = document.createElement('tr');
            tr.className = 'style-row' + (code === state.selectedCode ? ' is-selected' : '');
            tr.dataset.code = code;

            var codeTd = document.createElement('td');
            codeTd.setAttribute('data-label', i18n.codeLabel);
            codeTd.title = style._draft ? i18n.newCustomCode : String(style.code || '');
            codeTd.appendChild(text('code', style._draft ? i18n.newCustomCode : style.code || '', 'style-code-token'));
            var chipWrap = document.createElement('div');
            toList(style.industry_tags).slice(0, 3).forEach(function (item) {
                chipWrap.appendChild(chip(item));
            });
            codeTd.appendChild(chipWrap);
            tr.appendChild(codeTd);

            var nameTd = document.createElement('td');
            nameTd.setAttribute('data-label', i18n.styleLabel);
            nameTd.appendChild(text('div', style.name || style.code || i18n.untitledStyle, 'fw-semibold'));
            nameTd.appendChild(text('div', style.description || '', 'small text-muted style-muted-line'));
            tr.appendChild(nameTd);

            var sourceTd = document.createElement('td');
            sourceTd.setAttribute('data-label', i18n.sourceLabel);
            sourceTd.appendChild(text('div', style.source_module || style.source || style.source_type || '', 'small'));
            sourceTd.appendChild(text('div', style.source_type || '', 'small text-muted'));
            tr.appendChild(sourceTd);

            var statusTd = document.createElement('td');
            statusTd.setAttribute('data-label', i18n.statusLabel);
            var statusClass = style.status === 'active' ? 'text-bg-success' : (style.status === 'missing' ? 'text-bg-danger' : 'text-bg-secondary');
            statusTd.appendChild(badge(style.status || 'new', statusClass));
            tr.appendChild(statusTd);

            var bindingTd = document.createElement('td');
            bindingTd.setAttribute('data-label', i18n.bindingLabel);
            if (style.adapter_default) {
                bindingTd.appendChild(badge(i18n.defaultLabel, 'text-bg-primary'));
            } else if (style.manual) {
                bindingTd.appendChild(badge(i18n.manualLabel, 'text-bg-info'));
            } else if (style.temporary) {
                bindingTd.appendChild(badge(i18n.temporaryLabel, 'text-bg-light text-dark'));
            } else {
                bindingTd.appendChild(text('span', '-', 'small text-muted'));
            }
            tr.appendChild(bindingTd);

            var actionTd = document.createElement('td');
            actionTd.setAttribute('data-label', i18n.actionsLabel);
            var manageBtn = document.createElement('button');
            manageBtn.type = 'button';
            manageBtn.className = 'btn btn-outline-primary btn-sm';
            manageBtn.textContent = i18n.manageAction;
            manageBtn.dataset.styleManageAction = '1';
            manageBtn.setAttribute('aria-label', i18n.manageAction + ' ' + code);
            actionTd.appendChild(manageBtn);
            tr.appendChild(actionTd);

            els.tableBody.appendChild(tr);
        });

        els.listStatus.textContent = String(items.length) + ' / ' + state.items.length + i18n.stylesSuffix;
    }

    function setFieldsDisabled(disabled) {
        [els.name, els.status, els.description, els.cta, els.supplemental].forEach(function (input) {
            input.disabled = disabled;
        });
        document.querySelectorAll('[data-style-array], [data-style-object]').forEach(function (input) {
            input.disabled = disabled;
        });
    }

    function renderDetail() {
        var style = findSelectedStyle();
        if (!style) {
            els.empty.classList.remove('d-none');
            els.form.classList.add('d-none');
            els.detailTitle.textContent = i18n.styleDetail;
            els.detailMode.textContent = i18n.noSelection;
            return;
        }

        var readonly = !!style.readonly || sourceGroup(style) === 'module' || sourceGroup(style) === 'missing';
        els.empty.classList.add('d-none');
        els.form.classList.remove('d-none');
        els.detailTitle.textContent = style._draft ? i18n.newCustomStyle : i18n.managePrefix + (style.code || '');
        els.detailMode.textContent = readonly ? i18n.readOnly : (style.exists ? i18n.editable : i18n.newLabel);

        clearNode(els.badges);
        els.badges.appendChild(badge(style.status || 'new', style.status === 'active' ? 'text-bg-success' : 'text-bg-secondary'));
        els.badges.appendChild(badge(style.source_type || 'custom', 'text-bg-light text-dark'));
        if (style.adapter_default) {
            els.badges.appendChild(badge(i18n.defaultBinding, 'text-bg-primary'));
        }
        if (style.manual) {
            els.badges.appendChild(badge(i18n.manualBinding, 'text-bg-info'));
        }
        if (readonly) {
            els.badges.appendChild(badge(i18n.readonlyBadge, 'text-bg-dark'));
        }

        els.code.value = style._draft ? '' : String(style.code || '');
        els.name.value = String(style.name || '');
        els.status.value = String(style.status || 'active') === 'disabled' ? 'disabled' : 'active';
        els.description.value = String(style.description || '');
        els.cta.value = String(style.cta_style || '');
        els.supplemental.value = String(style.supplemental_prompt || '');

        document.querySelectorAll('[data-style-array]').forEach(function (input) {
            var field = input.getAttribute('data-style-array') || '';
            input.value = formatStructured(style[field] || []);
        });
        document.querySelectorAll('[data-style-object]').forEach(function (input) {
            var field = input.getAttribute('data-style-object') || '';
            input.value = formatStructured(style[field] || {});
        });

        els.code.readOnly = readonly || (!!style.exists && !style._draft);
        setFieldsDisabled(readonly);
        els.save.disabled = readonly;
        document.querySelectorAll('[data-style-status-action]').forEach(function (btn) {
            btn.disabled = readonly || style._draft || String(style.status || '') === String(btn.getAttribute('data-style-status-action') || '');
        });
        els.clone.disabled = !style.code || sourceGroup(style) === 'custom' || sourceGroup(style) === 'missing';
        els.remove.disabled = readonly || style._draft || !style.exists || sourceGroup(style) !== 'custom';

        var active = String(style.status || '') === 'active';
        els.bind.disabled = !active || !style.code || !!style.adapter_default || !!style.manual || !style.exists;
        els.unbind.disabled = !style.manual || !!style.adapter_default;
        if (style.adapter_default) {
            els.bindingHelp.textContent = i18n.bindingDefaultHelp;
        } else if (style.manual) {
            els.bindingHelp.textContent = i18n.bindingManualHelp;
        } else if (!active) {
            els.bindingHelp.textContent = i18n.bindingInactiveHelp;
        } else {
            els.bindingHelp.textContent = i18n.bindingReadyHelp;
        }
    }

    function selectStyle(code) {
        state.selectedCode = code || '';
        renderTable();
        renderDetail();
        setStatus(els.formStatus, '', false);
    }

    function focusManagedStyle() {
        if (!els.detailCard) {
            return;
        }
        if (typeof els.detailCard.scrollIntoView === 'function') {
            els.detailCard.scrollIntoView({behavior: 'smooth', block: 'nearest'});
        }
        els.detailCard.classList.remove('is-focus-pulse');
        window.setTimeout(function () {
            els.detailCard.classList.add('is-focus-pulse');
        }, 0);
        window.setTimeout(function () {
            els.detailCard.classList.remove('is-focus-pulse');
        }, 850);

        var focusTarget = els.detailCard.querySelector('input:not([disabled]), textarea:not([disabled]), select:not([disabled]), button:not([disabled])');
        if (focusTarget && typeof focusTarget.focus === 'function') {
            window.setTimeout(function () {
                try {
                    focusTarget.focus({preventScroll: true});
                } catch (e) {
                    focusTarget.focus();
                }
            }, 220);
        }
    }

    function newStyle() {
        state.draft = {
            _draft: true,
            exists: false,
            readonly: false,
            source: 'custom',
            source_type: 'custom',
            status: 'active',
            code: '',
            name: '',
            description: '',
            industry_tags: [],
            match_keywords: [],
            visual_keywords: [],
            color_system: {},
            layout_patterns: [],
            image_strategy: [],
            forbidden_patterns: [],
            block_rules: {},
            qa_rules: [],
            example_refs: [],
            cta_style: '',
            supplemental_prompt: ''
        };
        state.selectedCode = '__new__';
        renderTable();
        renderDetail();
        els.code.focus();
    }

    function collectPayload(statusOverride) {
        var payload = {
            code: els.code.value || '',
            name: els.name.value || '',
            description: els.description.value || '',
            status: statusOverride || els.status.value || 'active',
            cta_style: els.cta.value || '',
            supplemental_prompt: els.supplemental.value || ''
        };
        document.querySelectorAll('[data-style-array]').forEach(function (input) {
            payload[input.getAttribute('data-style-array') || ''] = parseLines(input.value);
        });
        document.querySelectorAll('[data-style-object]').forEach(function (input) {
            payload[input.getAttribute('data-style-object') || ''] = parseObject(input.value);
        });
        return payload;
    }

    function refreshCatalog() {
        var adapterCode = selectedAdapterCode();
        els.listStatus.textContent = i18n.loading;
        return aiOp('styleCatalog', {
            adapter_code: adapterCode,
            include_inactive: true
        }).then(function (payload) {
            if (!payload || payload.success === false) {
                throw new Error((payload && payload.message) || i18n.catalogLoadFailed);
            }
            state.items = Array.isArray(payload.items) ? payload.items : [];
            state.draft = null;
            var stillExists = state.items.some(function (item) {
                return String(item.code || '') === state.selectedCode;
            });
            if (!stillExists) {
                state.selectedCode = state.items.length ? String(state.items[0].code || '') : '';
            }
            renderAdapterSummary();
            renderTable();
            renderDetail();
        }).catch(function (err) {
            els.listStatus.textContent = responseErrorMessage(err, i18n.catalogLoadFailed);
        });
    }

    function saveCurrent(statusOverride) {
        setStatus(els.formStatus, i18n.saving, false);
        return aiOp('styleSave', collectPayload(statusOverride)).then(function (payload) {
            if (!payload || payload.success === false) {
                throw new Error((payload && payload.message) || i18n.saveFailed);
            }
            state.selectedCode = payload.item && payload.item.code ? String(payload.item.code) : String(els.code.value || '');
            setStatus(els.formStatus, i18n.saved, false);
            return refreshCatalog();
        }).catch(function (err) {
            setStatus(els.formStatus, responseErrorMessage(err, i18n.saveFailed), true);
        });
    }

    function cloneSelected() {
        var style = findSelectedStyle();
        if (!style || !style.code) {
            return;
        }
        setStatus(els.formStatus, i18n.cloning, false);
        return aiOp('styleCloneBuiltin', {code: style.code}).then(function (payload) {
            if (!payload || payload.success === false) {
                throw new Error((payload && payload.message) || i18n.cloneFailed);
            }
            state.selectedCode = payload.item && payload.item.code ? String(payload.item.code) : '';
            setStatus(els.formStatus, i18n.cloned, false);
            return refreshCatalog();
        }).catch(function (err) {
            setStatus(els.formStatus, responseErrorMessage(err, i18n.cloneFailed), true);
        });
    }

    function deleteSelected() {
        var style = findSelectedStyle();
        if (!style || !style.code || sourceGroup(style) !== 'custom' || !style.exists) {
            return;
        }
        Weline.UI.dialog.confirm(formatMessage(i18n.deleteConfirm, style.code), {
            title: i18n.deleteTitle,
            confirmLabel: i18n.deleteConfirmText,
            cancelLabel: i18n.cancelText,
            tone: 'danger'
        }).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            setStatus(els.formStatus, i18n.deleting, false);
            return aiOp('styleDelete', {code: style.code}).then(function (payload) {
                if (!payload || payload.success === false) {
                    throw new Error((payload && payload.message) || i18n.deleteFailed);
                }
                state.selectedCode = '';
                setStatus(els.formStatus, i18n.deleted, false);
                return refreshCatalog();
            }).catch(function (err) {
                setStatus(els.formStatus, responseErrorMessage(err, i18n.deleteFailed), true);
            });
        });
    }

    function bindSelected(bind) {
        var style = findSelectedStyle();
        if (!style || !style.code) {
            return;
        }
        setStatus(els.formStatus, bind ? i18n.binding : i18n.unbinding, false);
        return aiOp(bind ? 'styleBindAdapter' : 'styleUnbindAdapter', {
            adapter_code: selectedAdapterCode(),
            style_code: style.code
        }).then(function (payload) {
            if (!payload || payload.success === false) {
                throw new Error((payload && payload.message) || (bind ? i18n.bindFailed : i18n.unbindFailed));
            }
            setStatus(els.formStatus, bind ? i18n.bound : i18n.unbound, false);
            return refreshCatalog();
        }).catch(function (err) {
            setStatus(els.formStatus, responseErrorMessage(err, bind ? i18n.bindFailed : i18n.unbindFailed), true);
        });
    }

    renderAdapters();
    renderAdapterSummary();
    if (state.items.length) {
        state.selectedCode = String(state.items[0].code || '');
    }
    refreshCatalog();

    document.getElementById('ai-style-refresh').addEventListener('click', refreshCatalog);
    document.getElementById('ai-style-new').addEventListener('click', newStyle);
    els.adapter.addEventListener('change', function () {
        state.selectedAdapter = selectedAdapterCode();
        refreshCatalog();
    });
    [els.search, els.statusFilter, els.sourceFilter].forEach(function (input) {
        input.addEventListener('input', renderTable);
        input.addEventListener('change', renderTable);
    });
    els.tableBody.addEventListener('click', function (event) {
        var row = event.target.closest('tr[data-code]');
        if (!row) {
            return;
        }
        selectStyle(row.dataset.code || '');
        if (event.target.closest('[data-style-manage-action]')) {
            focusManagedStyle();
        }
    });
    els.save.addEventListener('click', function () {
        saveCurrent('');
    });
    document.querySelectorAll('[data-style-status-action]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            saveCurrent(btn.getAttribute('data-style-status-action') || '');
        });
    });
    els.clone.addEventListener('click', cloneSelected);
    els.remove.addEventListener('click', deleteSelected);
    els.bind.addEventListener('click', function () {
        bindSelected(true);
    });
    els.unbind.addEventListener('click', function () {
        bindSelected(false);
    });
})();
</script>
