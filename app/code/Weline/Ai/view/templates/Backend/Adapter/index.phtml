                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-4);"><lang>未关联可用供应商账户的模型会标注「未关联账户」，请优先选择已关联账户的供应商与模型。</lang></p>
                <div class="js-modality-binding" data-modality="text2text" style="--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>文本推理模型</lang> text2text</label>
                    <select class="w-select js-modality-supplier-filter" aria-label="<?= htmlspecialchars((string)__('供应商筛选')) ?>" data-size="sm" style="--w-mb:var(--weline-space-2);"></select>
                    <input type="search" class="w-input js-modality-model-search" placeholder="<?= htmlspecialchars((string)__('搜索模型名称或代码…')) ?>" autocomplete="off" data-size="sm" style="--w-mb:var(--weline-space-2);">
                    <select class="w-select js-modality-model-select" id="batchTextModelSelect" data-modality="text2text" size="7"><option value=""><lang>不启用</lang></option></select>
                </div>
                <div class="js-modality-binding" data-modality="text2image" style="--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>文生图模型</lang> text2image</label>
                    <select class="w-select js-modality-supplier-filter" aria-label="<?= htmlspecialchars((string)__('供应商筛选')) ?>" data-size="sm" style="--w-mb:var(--weline-space-2);"></select>
                    <input type="search" class="w-input js-modality-model-search" placeholder="<?= htmlspecialchars((string)__('搜索模型名称或代码…')) ?>" autocomplete="off" data-size="sm" style="--w-mb:var(--weline-space-2);">
                    <select class="w-select js-modality-model-select" id="batchImageModelSelect" data-modality="text2image" size="7"><option value=""><lang>不启用</lang></option></select>
                </div>
                <div class="js-modality-binding" data-modality="text2video">
                    <label class="w-field__label"><lang>文生视频模型</lang> text2video</label>
                    <select class="w-select js-modality-supplier-filter" aria-label="<?= htmlspecialchars((string)__('供应商筛选')) ?>" data-size="sm" style="--w-mb:var(--weline-space-2);"></select>
                    <input type="search" class="w-input js-modality-model-search" placeholder="<?= htmlspecialchars((string)__('搜索模型名称或代码…')) ?>" autocomplete="off" data-size="sm" style="--w-mb:var(--weline-space-2);">
                    <select class="w-select js-modality-model-select" id="batchVideoModelSelect" data-modality="text2video" size="7"><option value=""><lang>不启用</lang></option></select>
                </div>
            </div>
            <div class="w-dialog__footer">
                <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><lang>取消</lang></button>
                <button type="button" class="w-button" id="batchModelBindingSaveBtn" data-tone="primary">
                    <w:icon name="save" size="sm"></w:icon><lang>保存绑定</lang>
                </button>
            </div>
        </div>
    </div>
</div>

<w:form id="batchModelBindingForm" method="post" action="@var($this->getBackendUrl('*/backend/adapter/batchSaveModelBindings'))" hidden>
    <input type="hidden" name="ids" id="batchModelBindingIds" value="">
    <input type="hidden" name="model_bindings" id="batchModelBindingPayload" value="">
</w:form>

<script>
(function() {
    'use strict';
    
    var WelineAdapterManager = {
        aiApi: function() {
            if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
                return Promise.reject(new Error('Weline.Api.resource is unavailable.'));
            }
            return Promise.resolve(window.Weline.Api.resource('ai'));
        },
        urls: {
            scan: '<?= $this->getBackendUrl('*/backend/adapter/scan') ?>',
            toggleStatus: '<?= $this->getBackendUrl('*/backend/adapter/toggleStatus') ?>',
            delete: '<?= $this->getBackendUrl('*/backend/adapter/delete') ?>',
            batchDelete: '<?= $this->getBackendUrl('*/backend/adapter/batchDelete') ?>',
            batchToggle: '<?= $this->getBackendUrl('*/backend/adapter/batchToggle') ?>',
            batchSaveDefaultModel: '<?= $this->getBackendUrl('*/backend/adapter/batchSaveDefaultModel') ?>',
            batchSaveModelBindings: '<?= $this->getBackendUrl('*/backend/adapter/batchSaveModelBindings') ?>',
            getModelOptions: '<?= $this->getBackendUrl('*/backend/adapter/getModelOptions') ?>',
            cleanup: '<?= $this->getBackendUrl('*/backend/adapter/cleanup') ?>'
        },
        modelOptionsByModality: <?= $modelOptionsJson ?>,

        _showLoading: function() {
            if (typeof window.showLoading === 'function') {
                window.showLoading();
            }
        },
        _hideLoading: function() {
            if (typeof window.hideLoading === 'function') {
                window.hideLoading();
            }
        },

        scan: function() {
            Weline.UI.dialog.confirm('<?= __('确定要扫描场景适配器吗？这将发现所有模块中的适配器并更新数据库记录。') ?>', {
                title: '<?= __('扫描适配器') ?>',
                confirmLabel: '<?= __('确定扫描') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'info'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._showLoading();
                    window.location.href = WelineAdapterManager.urls.scan;
                }
            });
        },

        toggleStatus: function(id) {
            Weline.UI.dialog.confirm('<?= __('确定要切换此适配器的状态吗？') ?>', {
                title: '<?= __('切换状态') ?>',
                confirmLabel: '<?= __('确定') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'warning'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._doToggleStatus(id);
                }
            });
        },

        _doToggleStatus: function(id) {
            WelineAdapterManager._showLoading();
            this.aiApi().then(function(api) { return api.adapterToggleStatus({id: id}); }).then(function(data) {
                WelineAdapterManager._hideLoading();
                if (data.success) {
                    Weline.UI.toast.success(data.message || '<?= __('状态更新成功') ?>');
                    setTimeout(function() { location.reload(); }, 500);
                } else {
                    Weline.UI.toast.error(data.message || '<?= __('状态更新失败') ?>');
                }
            })
            .catch(function(e) {
                WelineAdapterManager._hideLoading();
                Weline.UI.toast.error('<?= __('请求失败：') ?>' + e.message);
            });
        },

        delete: function(id) {
            Weline.UI.dialog.confirm('<?= __('确定要删除此适配器吗？此操作不可恢复。') ?>', {
                title: '<?= __('删除适配器') ?>',
                confirmLabel: '<?= __('确定删除') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'danger'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._doDelete(id);
                }
            });
        },

        _doDelete: function(id) {
            WelineAdapterManager._showLoading();
            this.aiApi().then(function(api) { return api.adapterDelete({id: id}); }).then(function(data) {
                WelineAdapterManager._hideLoading();
                if (data.success) {
                    Weline.UI.toast.success(data.message || '<?= __('删除成功') ?>');
                    setTimeout(function() { location.reload(); }, 500);
                } else {
                    Weline.UI.toast.error(data.message || '<?= __('删除失败') ?>');
                }
            })
            .catch(function(e) {
                WelineAdapterManager._hideLoading();
                Weline.UI.toast.error('<?= __('请求失败：') ?>' + e.message);
            });
        },

        getSelectedIds: function() {
            var ids = [];
            document.querySelectorAll('.row-checkbox:checked').forEach(function(cb) {
                ids.push(parseInt(cb.value));
            });
            return ids;
        },

        updateSelection: function() {
            var ids = this.getSelectedIds();
            var toolbar = document.getElementById('batchToolbar');
            var countEl = document.getElementById('selectCount');
            var selectAll = document.getElementById('selectAll');
            var total = document.querySelectorAll('.row-checkbox').length;
            
            countEl.textContent = ids.length;
            
            if (ids.length > 0) {
                toolbar.classList.add('show');
            } else {
                toolbar.classList.remove('show');
            }
            
            selectAll.checked = ids.length === total && total > 0;
            selectAll.indeterminate = ids.length > 0 && ids.length < total;
        },

        toggleSelectAll: function(checkbox) {
            var checked = checkbox.checked;
            document.querySelectorAll('.row-checkbox').forEach(function(cb) {
                cb.checked = checked;
            });
            this.updateSelection();
        },

        clearSelection: function() {
            document.querySelectorAll('.row-checkbox').forEach(function(cb) {
                cb.checked = false;
            });
            document.getElementById('selectAll').checked = false;
            this.updateSelection();
        },

        batchDelete: function() {
            var ids = this.getSelectedIds();
            if (ids.length === 0) {
                Weline.UI.toast.warning('<?= __('请先选择要删除的适配器') ?>');
                return;
            }

            Weline.UI.dialog.confirm('<?= __('确定要删除选中的') ?> ' + ids.length + ' <?= __('个适配器吗？此操作不可恢复。') ?>', {
                title: '<?= __('批量删除') ?>',
                confirmLabel: '<?= __('确定删除') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'danger'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._doBatchDelete(ids);
                }
            });
        },

        _doBatchDelete: function(ids) {
            WelineAdapterManager._showLoading();
            this.aiApi().then(function(api) { return api.adapterBulkDelete({ids: ids}); }).then(function(data) {
                WelineAdapterManager._hideLoading();
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() { location.reload(); }, 500);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(e) {
                WelineAdapterManager._hideLoading();
                Weline.UI.toast.error('<?= __('请求失败：') ?>' + e.message);
            });
        },

        batchToggle: function(status) {
            var ids = this.getSelectedIds();
            if (ids.length === 0) {
                Weline.UI.toast.warning('<?= __('请先选择要操作的适配器') ?>');
                return;
            }

            var statusText = status ? '<?= __('激活') ?>' : '<?= __('禁用') ?>';
            Weline.UI.dialog.confirm('<?= __('确定要') ?>' + statusText + '<?= __('选中的') ?> ' + ids.length + ' <?= __('个适配器吗？') ?>', {
                title: '<?= __('批量') ?>' + statusText,
                confirmLabel: '<?= __('确定') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'warning'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._doBatchToggle(ids, status);
                }
            });
        },

        _doBatchToggle: function(ids, status) {
            WelineAdapterManager._showLoading();
            this.aiApi().then(function(api) { return api.adapterBulkToggle({ids: ids, status: status}); }).then(function(data) {
                WelineAdapterManager._hideLoading();
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() { location.reload(); }, 500);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(e) {
                WelineAdapterManager._hideLoading();
                Weline.UI.toast.error('<?= __('请求失败：') ?>' + e.message);
            });
        },

        cleanup: function() {
            Weline.UI.dialog.confirm('<?= __('确定要清理无效的适配器吗？这将删除代码文件已不存在的适配器记录。') ?>', {
                title: '<?= __('清理无效适配器') ?>',
                confirmLabel: '<?= __('确定清理') ?>',
                cancelLabel: '<?= __('取消') ?>',
                tone: 'warning'
            }).then(function(confirmed) {
                if (confirmed) {
                    WelineAdapterManager._showLoading();
                    window.location.href = WelineAdapterManager.urls.cleanup;
                }
            });
        },

        batchSetDefaultModel: function() {
            return this.batchSetModelBindings();
        },

        batchSetModelBindings: function(ids, presetBindings) {
            ids = Array.isArray(ids) && ids.length ? ids : this.getSelectedIds();
            presetBindings = this.normalizeModelBindingPreset(presetBindings || {});
            if (ids.length === 0) {
                Weline.UI.toast.warning('<?= __('请先选择要配置模型绑定的适配器') ?>');
                return;
            }
            if (Object.keys(presetBindings).length === 0 && ids.length === 1) {
                presetBindings = this.getSelectedRowModelBindings(ids[0]);
            }
            this.activeBindingIds = ids;
            var modal = document.getElementById('batchModelBindingModal');
            var blocks = Array.prototype.slice.call(document.querySelectorAll('.js-modality-binding'));
            if (!modal || !blocks.length) return;
            var saveBtn = document.getElementById('batchModelBindingSaveBtn');
            if (saveBtn) saveBtn.disabled = true;
            blocks.forEach(function(block) {
                WelineAdapterManager.initModalityBindingBlock(block, presetBindings);
            });
            if (saveBtn) saveBtn.disabled = false;
            Weline.UI.dialog.open(modal);
        },

        initModalityBindingBlock: function(block, presetBindings) {
            var modality = block.getAttribute('data-modality') || '';
            var supplierSelect = block.querySelector('.js-modality-supplier-filter');
            var searchInput = block.querySelector('.js-modality-model-search');
            var modelSelect = block.querySelector('.js-modality-model-select');
            if (!supplierSelect || !searchInput || !modelSelect) return;
            var items = (WelineAdapterManager.modelOptionsByModality[modality] || []).slice();
            var presetCode = presetBindings[modality] || '';
            var presetItem = items.find(function(item) { return (item.model_code || '') === presetCode; }) || null;
            var suppliers = [];
            items.forEach(function(item) {
                var supplier = String(item.supplier || '').trim();
                if (supplier && suppliers.indexOf(supplier) === -1) suppliers.push(supplier);
            });
            suppliers.sort();
            supplierSelect.innerHTML = '';
            var allOpt = document.createElement('option');
            allOpt.value = '';
            allOpt.textContent = '<?= __('全部供应商') ?>';
            supplierSelect.appendChild(allOpt);
            suppliers.forEach(function(supplier) {
                var hasReady = items.some(function(item) {
                    return String(item.supplier || '') === supplier && !!item.account_ready;
                });
                var opt = document.createElement('option');
                opt.value = supplier;
                opt.textContent = hasReady
                    ? supplier
                    : (supplier + ' <?= __('（未关联账户）') ?>');
                supplierSelect.appendChild(opt);
            });
            var preferredSupplier = '';
            if (presetItem && presetItem.supplier) {
                preferredSupplier = String(presetItem.supplier);
            } else {
                var readySupplier = suppliers.find(function(supplier) {
                    return items.some(function(item) {
                        return String(item.supplier || '') === supplier && !!item.account_ready;
                    });
                });
                preferredSupplier = readySupplier || '';
            }
            supplierSelect.value = preferredSupplier;
            searchInput.value = '';
            var firstPaint = true;
            var render = function() {
                var keep = firstPaint ? presetCode : (modelSelect.value || '');
                firstPaint = false;
                WelineAdapterManager.renderModalityModelOptions(block, keep);
            };
            supplierSelect.onchange = render;
            searchInput.oninput = render;
            modelSelect.disabled = false;
            render();
        },

        renderModalityModelOptions: function(block, preferredCode) {
            var modality = block.getAttribute('data-modality') || '';
            var supplierSelect = block.querySelector('.js-modality-supplier-filter');
            var searchInput = block.querySelector('.js-modality-model-search');
            var modelSelect = block.querySelector('.js-modality-model-select');
            if (!modelSelect) return;
            var supplierFilter = supplierSelect ? String(supplierSelect.value || '').trim().toLowerCase() : '';
            var keyword = searchInput ? String(searchInput.value || '').trim().toLowerCase() : '';
            var items = (WelineAdapterManager.modelOptionsByModality[modality] || []).filter(function(item) {
                var supplier = String(item.supplier || '').trim().toLowerCase();
                if (supplierFilter && supplier !== supplierFilter) return false;
                if (!keyword) return true;
                var hay = ((item.name || '') + ' ' + (item.model_code || '') + ' ' + (item.supplier || '')).toLowerCase();
                return hay.indexOf(keyword) !== -1;
            });
            var currentValue = preferredCode || modelSelect.value || '';
            modelSelect.innerHTML = '';
            var emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = '<?= __('不启用') ?>';
            modelSelect.appendChild(emptyOption);
            items.forEach(function(item) {
                var code = item.model_code || '';
                if (!code) return;
                var opt = document.createElement('option');
                opt.value = code;
                opt.dataset.supplier = item.supplier || '';
                opt.dataset.accountReady = item.account_ready ? '1' : '0';
                var label = ((item.name || code).trim() || code) + ' · ' + (item.supplier || '<?= __('未知供应商') ?>');
                if (!item.account_ready) {
                    label += ' <?= __('· 未关联账户') ?>';
                }
                opt.textContent = label;
                modelSelect.appendChild(opt);
            });
            if (currentValue) {
                modelSelect.value = currentValue;
                if (modelSelect.value !== currentValue) {
                    var presetOption = document.createElement('option');
                    presetOption.value = currentValue;
                    presetOption.textContent = currentValue + ' <?= __('（当前绑定，不在筛选结果中）') ?>';
                    presetOption.dataset.missingModel = '1';
                    modelSelect.appendChild(presetOption);
                    modelSelect.value = currentValue;
                }
            }
        },

        normalizeModelBindingPreset: function(presetBindings) {
            var normalized = {};
            if (!presetBindings || typeof presetBindings !== 'object') return normalized;
            ['text2text', 'text2image', 'text2video'].forEach(function(modality) {
                var value = presetBindings[modality];
                if (value == null || String(value).trim() === '') return;
                normalized[modality] = String(value).trim();
            });
            return normalized;
        },

        getSelectedRowModelBindings: function(id) {
            var checkbox = document.querySelector('.row-checkbox[value="' + String(id).replace(/"/g, '\\"') + '"]');
            if (!checkbox) return {};
            try {
                return this.normalizeModelBindingPreset(JSON.parse(checkbox.getAttribute('data-model-bindings') || '{}'));
            } catch (e) {
                return {};
            }
        },

        _doBatchSaveDefaultModel: function() {
            return this._doBatchSaveModelBindings();
        },

        _doBatchSaveModelBindings: function() {
            var ids = this.activeBindingIds && this.activeBindingIds.length ? this.activeBindingIds : this.getSelectedIds();
            var bindings = {};
            document.querySelectorAll('.js-modality-model-select').forEach(function(select) {
                var modality = select.getAttribute('data-modality') || '';
                var modelCode = (select.value || '').trim();
                if (modality && modelCode) bindings[modality] = modelCode;
            });
            if (Object.keys(bindings).length === 0) {
                Weline.UI.toast.warning('<?= __('请至少选择一个能力模型') ?>');
                return;
            }
            var form = document.getElementById('batchModelBindingForm');
            var idsInput = document.getElementById('batchModelBindingIds');
            var bindingsInput = document.getElementById('batchModelBindingPayload');
            if (!form || !idsInput || !bindingsInput) {
                Weline.UI.toast.error('<?= __('模型绑定保存失败') ?>');
                return;
            }
            idsInput.value = ids.join(',');
            bindingsInput.value = JSON.stringify(bindings);
            WelineAdapterManager._showLoading();
            form.submit();
        },

        filterRows: function(keyword) {
            var normalized = (keyword || '').trim().toLowerCase();
            var rows = document.querySelectorAll('.adapter-table tbody tr');
            var visibleCount = 0;

            rows.forEach(function(row) {
                var text = (row.innerText || '').toLowerCase();
                var matched = normalized === '' || text.indexOf(normalized) !== -1;
                row.style.display = matched ? '' : 'none';
                if (!matched) {
                    var checkbox = row.querySelector('.row-checkbox');
                    if (checkbox) checkbox.checked = false;
                } else {
                    visibleCount++;
                }
            });

            var emptyState = document.getElementById('adapterSearchEmpty');
            if (emptyState) {
                emptyState.classList.toggle('show', normalized !== '' && visibleCount === 0);
            }

            this.updateSelection();
        }
    };

    window.WelineAdapterManager = WelineAdapterManager;

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-adapter-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        var action = trigger.getAttribute('data-adapter-action');
        var id = parseInt(trigger.getAttribute('data-adapter-id') || '0', 10) || 0;
        if (action === 'scan') {
            WelineAdapterManager.scan();
        } else if (action === 'cleanup') {
            WelineAdapterManager.cleanup();
        } else if (action === 'batch-bind') {
            WelineAdapterManager.batchSetModelBindings();
        } else if (action === 'batch-toggle') {
            WelineAdapterManager.batchToggle(parseInt(trigger.getAttribute('data-adapter-status') || '0', 10) ? 1 : 0);
        } else if (action === 'batch-delete') {
            WelineAdapterManager.batchDelete();
        } else if (action === 'clear-selection') {
            WelineAdapterManager.clearSelection();
        } else if (action === 'toggle-status' && id > 0) {
            WelineAdapterManager.toggleStatus(id);
        } else if (action === 'bind' && id > 0) {
            var bindings = {};
            try {
                bindings = JSON.parse(trigger.getAttribute('data-model-bindings') || '{}');
            } catch (e) {
                bindings = {};
            }
            WelineAdapterManager.batchSetModelBindings([id], bindings);
        } else if (action === 'delete' && id > 0) {
            WelineAdapterManager.delete(id);
        }
    });

    document.addEventListener('change', function(event) {
        var trigger = event.target;
        if (trigger && trigger.getAttribute('data-adapter-change') === 'toggle-select-all') {
            WelineAdapterManager.toggleSelectAll(trigger);
            return;
        }
        if (trigger && trigger.classList && trigger.classList.contains('row-checkbox')) {
            WelineAdapterManager.updateSelection();
        }
    });

    (function bindBatchModelBindingSave() {
        var saveBtn = document.getElementById('batchModelBindingSaveBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function() {
                WelineAdapterManager._doBatchSaveDefaultModel();
            });
        }
    })();

    (function bindAdapterSearch() {
        var input = document.getElementById('adapterSearchInput');
        if (!input) return;
        input.addEventListener('input', function() {
            WelineAdapterManager.filterRows(input.value);
        });
    })();
})();
</script>
