<script>
(function() {
    'use strict';
    
    var WelineAdapter = {
        confirmAction: function(message, onConfirm) {
            Weline.UI.dialog.confirm(message).then(function(confirmed) {
                if (confirmed) {
                    onConfirm();
                }
            });
            return;
            if (window.Weline.UI.toast && typeof window.Weline.UI.toast.error === 'function') {
                window.Weline.UI.toast.error('<?= __('确认组件不可用，请刷新页面后重试。') ?>');
            }
        },

        toggleStatus: function(id) {
            Weline.UI.dialog.request({
                title: '<?= __('确认切换状态') ?>',
                message: '<?= __('确定要切换适配器状态吗？') ?>',
                tone: 'info',
                cancelable: true,
                confirmLabel: '<?= __("确定切换") ?>',
                cancelLabel: '<?= __("取消") ?>'
            }).then(function(result) {
                if (result.confirmed) {
                    WelineAdapter.performToggleStatus(id);
                }
            });
        },
        
        performToggleStatus: function(id) {
            var req = window.Weline.Api.resource('ai').adapterToggleStatus({ id: id });
            req.then(function(res) {
                var data = (res && res.data) || res;
                if (data && data.success) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('成功') ?>',
                        message: '<?= __('状态已切换') ?>',
                        duration: 2000,
                        confirmable: false
                    }).then(function() { location.reload(); });
                } else {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('操作失败') ?>',
                        message: data.message || '<?= __('未知错误') ?>',
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('网络错误') ?>',
                    message: '<?= __('请稍后重试') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
            });
        }
    };
    
    window.WelineAdapter = WelineAdapter;

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-adapter-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        if (trigger.getAttribute('data-adapter-action') === 'toggle-status') {
            WelineAdapter.toggleStatus(parseInt(trigger.getAttribute('data-adapter-id') || '0', 10) || 0);
        }
    });
})();
</script>
