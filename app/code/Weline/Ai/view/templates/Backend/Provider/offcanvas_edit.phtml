            <input type="url" class="w-input" id="weline-ai-oc-base-url" name="base_url" value="<?= $isEdit ? htmlspecialchars((string)$account->getData('base_url')) : '' ?>" placeholder="<?= __('留空使用默认值') ?>">
        </div>

        <div style="--w-mb:var(--weline-space-4);">
            <div class="w-check form-check-inline">
                <input type="checkbox" id="weline-ai-oc-is-active" name="is_active" value="1" <?= $isEdit && $account->getData('is_active') ? 'checked' : '' ?>>
                <label for="weline-ai-oc-is-active"><lang>激活账户</lang></label>
            </div>
            <div class="w-check form-check-inline">
                <input type="checkbox" id="weline-ai-oc-is-default" name="is_default" value="1" <?= $isEdit && $account->getData('is_default') ? 'checked' : '' ?>>
                <label for="weline-ai-oc-is-default"><lang>设为默认</lang></label>
            </div>
        </div>

        <input type="hidden" name="balance" value="<?= $isEdit ? (float)$account->getData('balance') : 0 ?>">
        <input type="hidden" name="currency" value="<?= $isEdit ? htmlspecialchars((string)$account->getData('currency')) : 'USD' ?>">

        <div class="w-cluster" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-4);">
            <button type="submit" class="w-button" data-tone="primary">
                <w:icon name="save" size="sm"></w:icon><lang>保存</lang>
            </button>
            <button type="button" class="w-button" data-ai-provider-offcanvas-action="close" data-tone="neutral">
                <w:icon name="close" size="sm"></w:icon><lang>关闭</lang>
            </button>
        </div>
    </w:form>
</div>

<script>
(function() {
    'use strict';

    var form = document.getElementById('weline-ai-provider-offcanvas-form');
    if (!form) return;

    function escapeHtml(text) {
        return String(text || '').replace(/[&<>"']/g, function(ch) {
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[ch];
        });
    }

    function renderProviderGuide(option) {
        var box = document.getElementById('weline-ai-oc-provider-guide');
        if (!box) return;
        var raw = option ? option.getAttribute('data-account-setup-guide') : '';
        var guide = {};
        try {
            guide = raw ? JSON.parse(raw) : {};
        } catch (e) {
            guide = {};
        }
        if (!guide || !guide.title) {
            box.style.display = 'none';
            return;
        }
        box.querySelector('[data-guide-title]').textContent = guide.title || '';
        box.querySelector('[data-guide-summary]').textContent = guide.summary || '';
        box.querySelector('[data-guide-steps]').innerHTML = (guide.steps || []).map(function(step) {
            return '<li>' + escapeHtml(step) + '</li>';
        }).join('');
        var fields = guide.field_hints || {};
        box.querySelector('[data-guide-fields]').innerHTML = Object.keys(fields).length
            ? '<div class="w-text" data-weight="strong" style="--w-mb:var(--weline-space-1);">后台填写参考</div>' + Object.keys(fields).map(function(key) {
                return '<div><code>' + escapeHtml(key) + '</code>: ' + escapeHtml(fields[key]) + '</div>';
            }).join('')
            : '';
        box.querySelector('[data-guide-links]').innerHTML = (guide.links || []).map(function(link) {
            return '<a href="' + escapeHtml(link.url) + '" target="_blank" rel="noopener noreferrer" class="me-2">' + escapeHtml(link.label) + '</a>';
        }).join('');
        box.style.display = '';
    }

    function hostWindow() {
        try {
            if (window.parent && window.parent !== window) {
                return window.parent;
            }
        } catch (e) {
        }
        return window;
    }

    /**
     * OffCanvas iframe 不会签发 backend bootstrap（仅顶层文档导航才签发），
     * 必须复用父页已鉴权的 Backend Worker API，否则 providerSaveAccount 会 403。
     */
    function resolveBackendApi() {
        var host = hostWindow();
        try {
            if (host.Weline && typeof host.Weline.load === 'function') {
                return host.Weline.load('api');
            }
            if (host.Weline && host.Weline.Api) {
                return Promise.resolve(host.Weline.Api);
            }
        } catch (e) {
        }
        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api');
        }
        return Promise.resolve(window.Weline && window.Weline.Api);
    }

    function unwrapBusiness(response) {
        var apiBiz = null;
        try {
            apiBiz = hostWindow().WelineApiBusiness || (hostWindow().Weline && hostWindow().Weline.ApiBusiness);
        } catch (e) {
        }
        if (!apiBiz) {
            apiBiz = window.WelineApiBusiness || (window.Weline && window.Weline.ApiBusiness);
        }
        if (apiBiz && typeof apiBiz.unwrapBusiness === 'function') {
            return apiBiz.unwrapBusiness(response);
        }
        if (response && typeof response === 'object' && response.ok !== undefined && response.data && typeof response.data === 'object' && !Array.isArray(response.data)) {
            return response.data;
        }
        return response;
    }

    function formatApiError(err, fallback) {
        var apiBiz = null;
        try {
            apiBiz = hostWindow().WelineApiBusiness || (hostWindow().Weline && hostWindow().Weline.ApiBusiness);
        } catch (e) {
        }
        if (!apiBiz) {
            apiBiz = window.WelineApiBusiness || (window.Weline && window.Weline.ApiBusiness);
        }
        if (apiBiz && typeof apiBiz.formatApiError === 'function') {
            return apiBiz.formatApiError(err, fallback);
        }
        return (err && err.message) ? String(err.message) : String(fallback || '');
    }

    function showToast(type, message) {
        var host = hostWindow();
        try {
            if (host.Weline.UI.toast && typeof host.Weline.UI.toast[type] === 'function') {
                host.Weline.UI.toast[type](message);
                return;
            }
        } catch (e) {
        }
        if (typeof Weline.UI.toast !== 'undefined' && Weline.UI.toast && typeof Weline.UI.toast[type] === 'function') {
            Weline.UI.toast[type](message);
        }
    }

    function closeProviderOffcanvas() {
        try {
            var w = hostWindow();
            if (w !== window && w.Weline && w.Weline.UI) {
                var drawer = window.frameElement ? window.frameElement.closest('[data-w-component~="drawer"]') : null;
                if (drawer) {
                    w.Weline.UI.drawer.close(drawer, 'saved');
                    return;
                }
            } else {
                w.location.reload();
                return;
            }
        } catch (e) {
        }
        window.location.reload();
    }

    document.addEventListener('click', function(event) {
        var trigger = event.target.closest('[data-ai-provider-offcanvas-action]');
        if (!trigger) {
            return;
        }
        event.preventDefault();
        if (trigger.getAttribute('data-ai-provider-offcanvas-action') === 'close') {
            closeProviderOffcanvas();
        }
    });

    // 供应商选择时自动填充：字段为空，或仍是某个供应商默认值时跟随切换
    var providerSelect = document.getElementById('weline-ai-oc-provider');

    function collectProviderDefaults(attr) {
        var values = {};
        if (!providerSelect) return values;
        Array.prototype.forEach.call(providerSelect.options, function(option) {
            var value = String(option.getAttribute(attr) || '').trim();
            if (value) values[value] = true;
        });
        return values;
    }

    function shouldFollowProviderDefault(currentValue, defaults) {
        var current = String(currentValue || '').trim();
        return current === '' || !!defaults[current];
    }

    function applyProviderDefaults(option) {
        var baseUrl = document.getElementById('weline-ai-oc-base-url');
        var accountName = document.getElementById('weline-ai-oc-account-name');
        var apiKey = document.getElementById('weline-ai-oc-api-key');
        if (!option || !option.value) {
            renderProviderGuide(option);
            return;
        }
        var url = option.getAttribute('data-base-url');
        var name = option.getAttribute('data-name');
        if (name && accountName && shouldFollowProviderDefault(accountName.value, collectProviderDefaults('data-name'))) {
            accountName.value = name;
        }
        if (url && baseUrl && shouldFollowProviderDefault(baseUrl.value, collectProviderDefaults('data-base-url'))) {
            baseUrl.value = url;
        }
        // 新建场景下供应商切换时清空旧密钥，避免误用上一供应商的 key
        if (apiKey && !form.querySelector('input[name="id"]')) {
            apiKey.value = '';
        }
        renderProviderGuide(option);
    }

    if (providerSelect && !providerSelect.readOnly) {
        providerSelect.addEventListener('change', function() {
            applyProviderDefaults(this.options[this.selectedIndex]);
        });
    }
    if (providerSelect && providerSelect.value) {
        applyProviderDefaults(providerSelect.options[providerSelect.selectedIndex]);
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        var submitBtn = form.querySelector('button[type="submit"]');
        var originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<w:icon name="circle" size="sm"></w:icon><?= __('保存中...') ?>';

        var data = {};
        new FormData(form).forEach(function(v, k) { data[k] = v; });
        if (!data.is_active) data.is_active = 0;
        if (!data.is_default) data.is_default = 0;

        resolveBackendApi().then(function(api) {
            if (!api || typeof api.resource !== 'function') {
                throw new Error('<?= __('后台 API 不可用，请刷新父页面后重试') ?>');
            }
            return api.resource('ai').providerSaveAccount({payload: data});
        }).then(function(res) {
            var resData = unwrapBusiness(res);
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
            if (resData && resData.success) {
                showToast('success', resData.message || '<?= __('保存成功') ?>');
                try {
                    var host = hostWindow();
                    if (host !== window) {
                        host.location.reload();
                    } else {
                        window.location.reload();
                    }
                } catch (err) {
                    window.location.reload();
                }
            } else {
                showToast('error', (resData && resData.message) || '<?= __('保存失败') ?>');
            }
        }).catch(function(err) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
            showToast('error', formatApiError(err, '<?= __('保存失败，请重试') ?>'));
        });
    });
})();
</script>
