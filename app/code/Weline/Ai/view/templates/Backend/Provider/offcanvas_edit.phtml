<div class="weline-ai-provider-edit-offcanvas">
    <div class="weline-ai-offcanvas-title-bar">
        <h5 style="--w-mb:0;">
            <w:icon name="user" size="sm"></w:icon><?= $title ?>
        </h5>
    </div>

    <w:form id="weline-ai-provider-offcanvas-form" method="post">
        <?php if ($isEdit): ?>
            <input type="hidden" name="id" value="<?= $account->getId() ?>">
        <?php endif; ?>

        <div style="--w-mb:var(--weline-space-4);">
            <label for="weline-ai-oc-provider" class="w-field__label required"><lang>供应商</lang></label>
            <select class="w-select" id="weline-ai-oc-provider" name="provider_code" required <?= $isEdit ? 'readonly' : '' ?>>
                <option value=""><?= __('请选择供应商') ?></option>
                <?php foreach ($providers as $code => $info): ?>
                    <option value="<?= $code ?>"
                            data-base-url="<?= htmlspecialchars($info['base_url'] ?? '') ?>"
                            data-name="<?= htmlspecialchars($info['name'] ?? '') ?>"
                            data-account-setup-guide="<?= htmlspecialchars(json_encode($info['account_setup_guide'] ?? [], $jsonForAttributeFlags) ?: '[]', ENT_QUOTES, 'UTF-8') ?>"
                            <?= $isEdit && $account->getData('provider_code') === $code ? 'selected' : '' ?>>
                        <?= htmlspecialchars($info['name'] ?? $code) ?>
                    </option>
                <?php endforeach; ?>
            </select>
