            <label for="weline-ai-oc-account-name" class="w-field__label required"><lang>账户名称</lang></label>
            <input type="text" class="w-input" id="weline-ai-oc-account-name" name="account_name" value="<?= $isEdit ? htmlspecialchars((string)$account->getData('account_name')) : '' ?>" required>
        </div>

        <div style="--w-mb:var(--weline-space-4);">
            <label for="weline-ai-oc-api-key" class="w-field__label <?= !$isEdit ? 'required' : '' ?>">API<lang>密钥</lang></label>
            <input type="password" class="w-input" id="weline-ai-oc-api-key" name="api_key" placeholder="<?= $isEdit ? __('留空保持不变') : __('请输入API密钥') ?>" <?= !$isEdit ? 'required' : '' ?>>
            <small class="w-field__hint"><?= __('API密钥将被加密存储') ?></small>
        </div>

