    // 为激活而保存账户
    function saveAccountForActivation() {
        var activateCheckbox = document.getElementById('is_active');
        var form = document.getElementById('accountForm');
        
        // 显示保存中状态
        var originalLabel = document.querySelector('label[for="is_active"]').textContent;
        document.querySelector('label[for="is_active"]').innerHTML = '<w:icon name="circle" size="sm"></w:icon>保存中...';
        activateCheckbox.disabled = true;
        
        // 验证表单
        if (!form.checkValidity()) {
            form.reportValidity();
            document.querySelector('label[for="is_active"]').textContent = originalLabel;
            activateCheckbox.disabled = false;
            activateCheckbox.checked = false;
            return;
        }
        
        var formData = new FormData(form);
        var data = Object.fromEntries(formData);
        
        // 确保激活状态为1
        data.is_active = '1';
        var req0 = providerAccountCall('saveAccount', { payload: data });
        req0.then(function(res) {
            var data = res || {};
            if (data && data.success) {
                // 保存成功，更新账户ID
                document.getElementById('accountId').value = data.account_id || data.id;
                
                // 进行连接测试
                testConnectionForActivation(data.account_id || data.id);
            } else {
                // 保存失败
                document.querySelector('label[for="is_active"]').textContent = originalLabel;
                activateCheckbox.disabled = false;
                activateCheckbox.checked = false;
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('保存失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
            }
        })
        .catch(function(error) {
            document.querySelector('label[for="is_active"]').textContent = originalLabel;
            activateCheckbox.disabled = false;
            activateCheckbox.checked = false;
            console.error('Error:', error);
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('保存失败') ?>',
                message: '<?= __('请重试') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        });
    }

    // 为激活而进行的连接测试
    function testConnectionForActivation(accountId) {
        var activateCheckbox = document.getElementById('is_active');
        
        // 更新状态为测试中
        document.querySelector('label[for="is_active"]').innerHTML = '<w:icon name="circle" size="sm"></w:icon>测试中...';
        
        var req = providerAccountCall('testConnection', { payload: { id: accountId } });
        req.then(function(res) {
            var data = res || {};
            // 恢复状态
            var originalLabel = '激活';
            document.querySelector('label[for="is_active"]').textContent = originalLabel;
            activateCheckbox.disabled = false;
            
            if (data.success) {
                // 测试成功，保持激活状态
                showResultModal('success', '连接测试成功', 
                    '连接测试成功！\n\n使用的测试模型: ' + (data.model_code || '未知') + '\n\n账户已激活。');
            } else {
                // 测试失败，取消激活状态
                activateCheckbox.checked = false;
                showResultModal('error', '连接测试失败', 
                    '连接测试失败，无法激活账户！\n\n错误信息: ' + data.message + '\n\n请检查API密钥和网络连接后重试。');
            }
        })
        .catch(function(error) {
            // 恢复状态
            var originalLabel = '激活';
            document.querySelector('label[for="is_active"]').textContent = originalLabel;
            activateCheckbox.disabled = false;
            activateCheckbox.checked = false;
            
            console.error('Error:', error);
            showResultModal('error', '连接测试失败', 
                '连接测试失败，无法激活账户！\n\n网络错误，请检查网络连接后重试。');
        });
    }

    // 供应商选择变化时的处理
    window.onProviderChange = function() {
        var providerSelect = document.getElementById('provider_code');
        var accountNameInput = document.getElementById('account_name');
        var baseUrlInput = document.getElementById('base_url');
        var apiKeyInput = document.getElementById('api_key');
        var selectedOption = providerSelect.options[providerSelect.selectedIndex];
        var nameDefaults = {};
        var urlDefaults = {};
        Array.prototype.forEach.call(providerSelect.options, function(option) {
            var name = String(option.getAttribute('data-name') || '').trim();
            var url = String(option.getAttribute('data-base-url') || '').trim();
            if (name) nameDefaults[name] = true;
            if (url) urlDefaults[url] = true;
        });

        function shouldFollow(current, defaults) {
            var value = String(current || '').trim();
            return value === '' || !!defaults[value];
        }

        if (selectedOption.value) {
            var providerName = selectedOption.getAttribute('data-name');
            if (providerName && shouldFollow(accountNameInput.value, nameDefaults)) {
                accountNameInput.value = providerName;
            }
            var baseUrl = selectedOption.getAttribute('data-base-url');
            if (baseUrl && shouldFollow(baseUrlInput.value, urlDefaults)) {
                baseUrlInput.value = baseUrl;
            }
            // 新建（accountId=0）切换供应商时清空旧密钥
            if (apiKeyInput && String(document.getElementById('accountId').value || '0') === '0') {
                apiKeyInput.value = '';
            }
        }
    };

