    // 加载账户列表
    function loadAccounts(page) {
        page = page || 1;
        currentPage = page;
        
        var params = {
            page: page,
            limit: 20,
            search: currentSearch,
            provider_code: currentProvider
        };

        var req = providerAccountCall('listAccounts', params);
        req.then(function(res) {
            var data = res || {};
            if (data && data.success) {
                    var rows = Array.isArray(data.data) ? data.data : [];
                    currentAccounts = rows;
                    displayAccounts(rows);
                    displayPagination(data.total, data.page, data.limit);
                } else {
                    document.getElementById('accountsList').innerHTML = '<tr><td colspan="10" class="w-text" data-align="center" data-tone="danger">' + escapeHtml(data.message || '<?= __('加载失败') ?>') + '</td></tr>';
                    if (typeof BackendModal !== 'undefined') {
                        BackendModal.alert('<?= __('加载失败') ?>', data.message);
                    } else if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.error(data.message);
                    } else {
                        console.error('加载失败: ' + data.message);
                    }
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                document.getElementById('accountsList').innerHTML = '<tr><td colspan="10" class="w-text" data-align="center" data-tone="danger"><?= __('加载失败') ?>: <?= __('请重试') ?></td></tr>';
                if (typeof BackendModal !== 'undefined') {
                    BackendModal.alert('<?= __('加载失败') ?>', '<?= __('请重试') ?>');
                } else if (typeof Weline.UI.toast !== 'undefined') {
                    Weline.UI.toast.error('<?= __('请重试') ?>');
                }
            });
    }
    window.loadAccounts = loadAccounts;

    // 显示账户列表
    function displayAccounts(accounts) {
        var tbody = document.getElementById('accountsList');
        accounts = Array.isArray(accounts) ? accounts : [];

        if (accounts.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="w-text" data-align="center">暂无数据</td></tr>';
            return;
        }
        
        tbody.innerHTML = accounts.map(function(account) {
            var accountId = parseInt(account.id || 0, 10) || 0;
            return '<tr>' +
                '<td>' + accountId + '</td>' +
                '<td>' + escapeHtml(account.provider_name) + '</td>' +
                '<td>' + escapeHtml(account.account_name) + (account.is_default == 1 ? ' <span class="w-badge" data-w-background="primary">默认</span>' : '') + '</td>' +
                '<td><span class="weline-ai-api-key-masked">' + escapeHtml(account.api_key_masked || '******') + '</span></td>' +
                '<td class="' + (account.balance > 10 ? 'weline-ai-balance-normal' : 'weline-ai-balance-low') + '">' + escapeHtml(account.balance_formatted) + '</td>' +
                '<td>' + escapeHtml(account.total_spent_formatted) + '</td>' +
                '<td>' + escapeHtml(account.connection_status_text) + '</td>' +
                '<td>' +
                    '<div class="w-switch">' +
                        '<input type="checkbox" data-provider-action="toggle-active" data-account-id="' + accountId + '"' + (account.is_active == 1 ? ' checked' : '') + '>' +
                    '</div>' +
                '</td>' +
                '<td>' + escapeHtml(account.created_at_formatted) + '</td>' +
                '<td>' +
                    '<button type="button" class="w-button" data-provider-action="test" data-account-id="' + accountId + '" title="测试连接" data-tone="info" data-size="sm"><w:icon name="wifi" size="sm"></w:icon></button> ' +
                    '<button type="button" class="w-button" data-provider-action="edit" data-account-id="' + accountId + '" title="编辑" data-tone="primary" data-size="sm"><w:icon name="edit" size="sm"></w:icon></button> ' +
                    '<button type="button" class="w-button" data-provider-action="usage" data-account-id="' + accountId + '" title="使用记录" data-tone="success" data-size="sm"><w:icon name="chart" size="sm"></w:icon></button> ' +
                    '<button type="button" class="w-button" data-provider-action="delete" data-account-id="' + accountId + '" title="删除" data-tone="danger" data-size="sm"><w:icon name="trash" size="sm"></w:icon></button>' +
                '</td>' +
            '</tr>';
        }).join('');
    }

    // 显示分页
    function displayPagination(total, page, limit) {
        var totalPages = Math.ceil(total / limit);
        var pagination = document.getElementById('pagination');
        
        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }
        
        var html = '<nav><ul class="w-pagination" data-justify="center">';
        
        // 上一页
        html += '<li class="w-pagination__item ' + (page === 1 ? 'disabled' : '') + '">' +
            '<a class="w-pagination__link" href="#" data-provider-action="page" data-page="' + (page - 1) + '">上一页</a>' +
        '</li>';
        
        // 页码
        for (var i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= page - 2 && i <= page + 2)) {
                html += '<li class="w-pagination__item ' + (i === page ? 'active' : '') + '">' +
                    '<a class="w-pagination__link" href="#" data-provider-action="page" data-page="' + i + '">' + i + '</a>' +
                '</li>';
            } else if (i === page - 3 || i === page + 3) {
                html += '<li class="w-pagination__item" aria-disabled="true"><span class="w-pagination__link">...</span></li>';
            }
        }
        
        // 下一页
        html += '<li class="w-pagination__item ' + (page === totalPages ? 'disabled' : '') + '">' +
            '<a class="w-pagination__link" href="#" data-provider-action="page" data-page="' + (page + 1) + '">下一页</a>' +
        '</li>';
        
        html += '</ul></nav>';
        pagination.innerHTML = html;
    }

