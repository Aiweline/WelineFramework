    function chooseProviderTestModel(account) {
        if (!account || !account.provider_code) {
            return Promise.resolve('');
        }
        var providerCode = String(account.provider_code || '').trim().toLowerCase();
        var params = {
            provider_code: providerCode,
            account_id: parseInt(account.id || 0, 10) || 0,
            require_remote: true
        };
        return providerAccountCall('remoteModelsForSelect', params).then(function(data) {
            if (!data || !data.success) {
                throw new Error((data && data.message) || 'models endpoint request failed');
            }
            if (!Array.isArray(data.data) || !data.data.length) {
                throw new Error('models endpoint returned empty list');
            }
            var options = {};
            window.__welineProviderTestModelMeta = {};
            var defaultModelCode = data.default_model_code || '';
            var modalityShortMap = {
                'text2text': '文生文',
                'text2image': '文生图',
                'text2video': '文生视频',
                'image2text': '图生文',
                'embedding': '向量',
                'audio2text': '语音转写',
                'text2audio': '语音合成',
                'multimodal': '多模态'
            };
            data.data.forEach(function(model) {
                var code = model.code || model.value || '';
                if (!code) return;
                var label = model.label || model.name || code;
                var modality = String(model.primary_modality || '').toLowerCase();
                if (modality && label.indexOf('[') === -1) {
                    var human = modalityShortMap[modality] || modality;
                    label += '  ·  [' + human + ']';
                }
                options[code] = label;
                window.__welineProviderTestModelMeta[code] = model;
            });
            if (!defaultModelCode) {
                var optionKeys = Object.keys(options);
                defaultModelCode = optionKeys.length ? optionKeys[0] : '';
            }
            var subtitle = data.source === 'preset'
                ? '远程 models 暂不可用，已使用供应商预置模型。' + (data.warning ? '\n原因: ' + data.warning : '')
                : '';
            return Weline.UI.dialog.request({
                title: '选择测试模型',
                message: subtitle,
                cancelable: true,
                confirmLabel: '开始测试',
                cancelLabel: '取消',
                field: {
                    type: 'select',
                    choices: options,
                    value: defaultModelCode,
                    placeholder: '请选择模型',
                    required: true
                },
                validate: function(value) {
                    if (!value) return '请选择一个模型';
                    return true;
                }
            }).then(function(result) {
                return result.confirmed ? (result.value || '') : null;
            });
        }).catch(function(error) {
            return Weline.UI.dialog.request({
                tone: 'warning',
                title: '无法拉取模型列表',
                message: error.message || '该供应商不支持 models 接口。',
                confirmLabel: '确定'
            }).then(function(result) {
                return null;
            });
        });
    }

    function runProviderConnectionTest(id, btn, originalHtml, modelCode) {
        btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon>';
        btn.disabled = true;

        var testModal = createTestModal();
        document.body.appendChild(testModal);

        var payload = { id: id };
        if (modelCode) payload.model_code = modelCode;
        var selectedMeta = modelCode && window.__welineProviderTestModelMeta ? window.__welineProviderTestModelMeta[modelCode] : null;
        if (selectedMeta && selectedMeta.primary_modality) payload.primary_modality = selectedMeta.primary_modality;
        if (selectedMeta && Array.isArray(selectedMeta.capabilities)) payload.capabilities = selectedMeta.capabilities;
        var req2 = providerAccountCall('testConnection', { payload: payload });
        req2.then(function(res) {
            var data = res || {};
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            document.body.removeChild(testModal);

            var images = Array.isArray(data && data.images) ? data.images : [];
            if (data && data.success) {
                var lines = [];
                if (data.message) lines.push(data.message);
                if (data.model_code) lines.push('使用的测试模型: ' + data.model_code);
                if (data.primary_modality) lines.push('模态: ' + data.primary_modality);
                if (data.duration) lines.push('耗时: ' + data.duration + ' ms');
                if (data.response) lines.push('响应: ' + String(data.response).slice(0, 500));
                if (data.request_url) lines.push('请求地址: ' + data.request_url);
                showResultModal('success', '连接测试成功', lines.join('\n'), images);
                loadAccounts(currentPage);
            } else {
                var lines2 = ['测试失败: ' + ((data && data.message) || '未知错误')];
                if (data && data.model_code) lines2.push('尝试使用的模型: ' + data.model_code);
                if (data && data.primary_modality) lines2.push('模态: ' + data.primary_modality);
                if (data && data.request_url) lines2.push('请求地址: ' + data.request_url);
                if (data && data.base_url) lines2.push('基础 URL: ' + data.base_url);
                showResultModal('error', '连接测试失败', lines2.join('\n'), []);
            }
        }).catch(function(error) {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            document.body.removeChild(testModal);
            console.error('Error:', error);
            showResultModal('error', '连接测试失败', '测试失败: 网络错误', []);
        });
    }

    // 测试连接
    window.testConnection = function(id, button) {
        var btn = button || document.querySelector('[data-provider-action="test"][data-account-id="' + (parseInt(id, 10) || 0) + '"]');
        if (!btn) {
            return;
        }
        var originalHtml = btn.innerHTML;
        btn.innerHTML = '<w:icon name="circle" size="sm"></w:icon>';
        btn.disabled = true;
        chooseProviderTestModel(getAccountById(id)).then(function(modelCode) {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            if (modelCode === null) return;
            runProviderConnectionTest(id, btn, originalHtml, modelCode || '');
        });
    };

    // 创建测试中弹窗
    function createTestModal() {
        var modal = document.createElement('div');
        modal.className = 'modal fade show';
        modal.style.display = 'block';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        modal.innerHTML = '<div class="w-dialog__frame">' +
            '<div class="w-dialog__surface">' +
                '<div class="w-dialog__body w-text" data-align="center" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);">' +
                    '<div class="w-spinner w-text" role="status" style="width: 3rem; height: 3rem;" data-tone="primary">' +
                        '<span class="w-visually-hidden">测试中...</span>' +
                    '</div>' +
                    '<h5 style="--w-mb:var(--weline-space-2);">正在测试连接</h5>' +
                    '<p class="w-text" data-tone="muted" style="--w-mb:0;">请稍候，正在验证API连接...</p>' +
                '</div>' +
            '</div>' +
        '</div>';
        return modal;
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function safeImageSrc(value) {
        var src = String(value || '').trim();
        if (/^https?:\/\//i.test(src) || /^data:image\/[a-z0-9.+-]+;base64,/i.test(src)) {
            return src;
        }
        return '';
    }

    function renderTestImagesHtml(images) {
        if (!Array.isArray(images) || images.length === 0) {
            return '';
        }
        var items = images.map(function(image) {
            var src = (image && image.url)
                ? image.url
                : (image && image.b64_json ? ('data:' + ((image.mime_type) || 'image/png') + ';base64,' + image.b64_json) : '');
            src = safeImageSrc(src);
            if (!src) {
                return '';
            }
            var safeSrc = escapeHtml(src);
            var revised = image && image.revised_prompt ? '<div class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-1);">' + escapeHtml(image.revised_prompt) + '</div>' : '';
            return '<div style="--w-span:12;--w-span-md:6;--w-mb:var(--weline-space-2);">'
                + '<a href="' + safeSrc + '" target="_blank" rel="noopener">'
                + '<img src="' + safeSrc + '" class="img-fluid" style="max-height: 260px; width: 100%; object-fit: contain; background: #fff;" alt="test image" data-w-radius="md" data-w-border="border">'
                + '</a>' + revised + '</div>';
        }).join('');
        if (!items) return '';
        return '<div class="w-grid" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-4);">'
            + '<div class="w-text" data-weight="strong" style="--w-span:12;--w-mb:var(--weline-space-1);"><w:icon name="image" size="sm"></w:icon>返回的测试图片</div>'
            + items
            + '</div>';
    }

    // 显示结果弹窗
    function showResultModal(type, title, message, images) {
        var modal = document.createElement('div');
        modal.className = 'modal fade show';
        modal.style.display = 'block';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';

        var iconClass = type === 'success' ? 'mdi-check-circle text-success' : 'mdi-alert-circle text-danger';
        var imagesHtml = renderTestImagesHtml(images);
        var hasImages = imagesHtml !== '';
        var dialogClass = hasImages ? 'modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable' : 'modal-dialog modal-dialog-centered';

        modal.innerHTML = '<div class="' + dialogClass + '">' +
            '<div class="w-dialog__surface">' +
                '<div class="w-dialog__header">' +
                    '<h5 class="w-dialog__title">' + escapeHtml(title) + '</h5>' +
                    '<button type="button" class="w-button" data-provider-action="close-result" data-w-close="" data-tone="quiet" data-size="sm"></button>' +
                '</div>' +
                '<div class="w-dialog__body" style="--w-pt:var(--weline-space-4);--w-pb:var(--weline-space-4);">' +
                    '<div class="w-text" data-align="center" style="--w-mb:var(--weline-space-4);"><i class="mdi ' + iconClass + '" style="font-size: 3rem;"></i></div>' +
                    '<div class="message-content" style="white-space: pre-line; text-align: left;">' +
                        escapeHtml(message) +
                    '</div>' +
                    imagesHtml +
                '</div>' +
                '<div class="w-dialog__footer">' +
                    '<button type="button" class="w-button" data-provider-action="close-result" data-tone="primary">确定</button>' +
                '</div>' +
            '</div>' +
        '</div>';

        document.body.appendChild(modal);
        return modal;
    }
    window.showResultModal = showResultModal;
    window.renderTestImagesHtml = renderTestImagesHtml;

    // 关闭结果弹窗
    window.closeResultModal = function(button) {
        var modal = button.closest('.modal');
        document.body.removeChild(modal);
    };

    // 加载使用记录
    function loadUsageList(accountId, page) {
        page = page || 1;
        document.getElementById('usageLoading').style.display = 'block';
        var params = {
            page: page,
            limit: 20,
            account_id: accountId
        };
        var ulReq = providerAccountCall('getUsageList', params);
        ulReq.then(function(res) {
            var data = res || {};
                document.getElementById('usageLoading').style.display = 'none';
                var tbody = document.getElementById('usageTbody');
                if (!data.success || !data.data || data.data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" class="w-text" data-align="center">暂无数据</td></tr>';
                    document.getElementById('usagePagination').innerHTML = '';
                    return;
                }
                tbody.innerHTML = data.data.map(function(r) {
                    return '<tr>' +
                        '<td>' + escapeHtml(r.created_at_formatted || '-') + '</td>' +
                        '<td style="max-width:240px;overflow:hidden;text-overflow:ellipsis;">' + escapeHtml(r.request_id || '-') + '</td>' +
                        '<td>' + escapeHtml(r.request_type || '-') + '</td>' +
                        '<td>' + escapeHtml(r.prompt_tokens || 0) + '</td>' +
                        '<td>' + escapeHtml(r.completion_tokens || 0) + '</td>' +
                        '<td>' + escapeHtml(r.total_tokens || 0) + '</td>' +
                        '<td>' + escapeHtml(r.request_time_formatted || '-') + '</td>' +
                        '<td>' + escapeHtml(r.total_cost_formatted || '-') + '</td>' +
                        '<td>' + escapeHtml(r.status || '-') + '</td>' +
                    '</tr>';
                }).join('');
                renderUsagePagination(data.total, data.page, 20);
            })
            .catch(function(err) {
                document.getElementById('usageLoading').style.display = 'none';
                console.error(err);
                document.getElementById('usageTbody').innerHTML = '<tr><td colspan="9" class="w-text" data-align="center" data-tone="danger">加载失败</td></tr>';
            });
    }
    window.loadUsageList = loadUsageList;

    function renderUsagePagination(total, page, limit) {
        var totalPages = Math.ceil(total / limit);
        var el = document.getElementById('usagePagination');
        if (totalPages <= 1) { el.innerHTML = ''; return; }
        var accountId = document.getElementById('usageAccountId').value;
        var html = '<nav><ul class="w-pagination" data-justify="center">';
        html += '<li class="w-pagination__item ' + (page === 1 ? 'disabled' : '') + '"><a class="w-pagination__link" href="#" data-provider-action="usage-page" data-account-id="' + escapeHtml(accountId) + '" data-page="' + (page-1) + '">上一页</a></li>';
        for (var i=1;i<=totalPages;i++) {
            if (i === 1 || i === totalPages || (i >= page-2 && i <= page+2)) {
                html += '<li class="w-pagination__item ' + (i===page?'active':'') + '"><a class="w-pagination__link" href="#" data-provider-action="usage-page" data-account-id="' + escapeHtml(accountId) + '" data-page="' + i + '">' + i + '</a></li>';
            } else if (i === page-3 || i === page+3) {
                html += '<li class="w-pagination__item" aria-disabled="true"><span class="w-pagination__link">...</span></li>';
            }
        }
        html += '<li class="w-pagination__item ' + (page === totalPages ? 'disabled' : '') + '"><a class="w-pagination__link" href="#" data-provider-action="usage-page" data-account-id="' + escapeHtml(accountId) + '" data-page="' + (page+1) + '">下一页</a></li>';
        html += '</ul></nav>';
        el.innerHTML = html;
    }

    // 切换激活状态
    window.toggleActive = function(id, trigger) {
        if (!id) {
            if (trigger) trigger.checked = !trigger.checked;
            return;
        }
        if (trigger) trigger.disabled = true;
        var taReq = providerAccountCall('toggleActive', { id: parseInt(id, 10) || 0 });
        taReq.then(function(res) {
            var data = res || {};
            if (data && data.success) {
                if (trigger && data.is_active !== undefined) {
                    trigger.checked = !!data.is_active;
                }
                if (typeof Weline.UI.toast !== 'undefined') {
                    Weline.UI.toast.success(data.message || '<?= __('状态更新成功') ?>');
                }
            } else {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('操作失败') ?>',
                    message: data.message,
                    confirmLabel: '<?= __('确定') ?>'
                });
                loadAccounts(currentPage);
            }
            if (trigger && data && data.success) {
                trigger.disabled = false;
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('操作失败') ?>',
                message: '<?= __('请重试') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
            loadAccounts(currentPage);
        });
    };

    // 删除账户
    window.deleteAccount = function(id) {
        Weline.UI.dialog.confirm('<?= __('确定要删除此账户吗？此操作不可恢复！') ?>').then(function(confirmed) {
            if (!confirmed) return;
            var delReq = providerAccountCall('deleteAccount', { id: parseInt(id, 10) || 0 });
            delReq.then(function(res) {
            var data = res || {};
            if (data && data.success) {
                Weline.UI.dialog.request({
                    tone: 'success',
                    title: '<?= __('成功') ?>',
                    message: data.message,
                    duration: 2000,
                    confirmable: false
                });
                loadAccounts(currentPage);
            } else {
                showResultModal('error', '<?= __('删除失败') ?>', '<?= __('删除失败') ?>: ' + (data.message || ''));
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            showResultModal('error', '<?= __('删除失败') ?>', '<?= __('删除失败') ?>: <?= __('网络错误') ?>');
        });
        });
    };

    // 查看使用记录
    window.viewUsage = function(id) {
        // 打开弹窗并加载第一页
        document.getElementById('usageAccountId').value = id;
        document.getElementById('usagePage').value = '1';
        Weline.UI.dialog.open('#usageModal');
        loadUsageList(id, 1);
    };
})();
</script>
