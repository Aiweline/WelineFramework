<script>
(function() {
    'use strict';

    var currentPage = 1;
    var currentSearch = '';
    var currentProvider = '';
    var currentAccounts = [];
    var providerAccountApiPromise = null;
    var providerAccountEndpoints = <?= json_encode($providerAccountEndpoints, $jsonFlags) ?>;

    function getProviderAccountApi() {
        if (providerAccountApiPromise) {
            return providerAccountApiPromise;
        }
        providerAccountApiPromise = waitForWelineApi().then(function(api) {
            var client = {};
            Object.keys(providerAccountEndpoints).forEach(function(operation) {
                client[operation] = function(params) {
                    return requestProviderAccount(api, operation, params || {});
                };
            });
            return client;
        });
        return providerAccountApiPromise;
    }

    function waitForWelineApi(attemptsLeft) {
        attemptsLeft = typeof attemptsLeft === 'number' ? attemptsLeft : 80;
        var api = window.Weline && window.Weline.Api;
        if (api && api.__fallback !== true && typeof api.request === 'function') {
            return Promise.resolve(api);
        }
        if (attemptsLeft <= 0) {
            return Promise.reject(new Error('Weline.Api.request is unavailable.'));
        }
        return new Promise(function(resolve, reject) {
            window.setTimeout(function() {
                waitForWelineApi(attemptsLeft - 1).then(resolve).catch(reject);
            }, 50);
        });
    }

    function buildProviderAccountPayload(operation, params) {
        var payload = Object.assign({}, params || {});
        if (operation === 'saveAccount' || operation === 'testConnection') {
            payload = Object.assign({}, payload.payload || payload);
        }
        return payload;
    }

    function buildQueryString(params) {
        var query = new URLSearchParams();
        Object.keys(params || {}).forEach(function(key) {
            var value = params[key];
            if (value === undefined || value === null) {
                return;
            }
            if (Array.isArray(value)) {
                value.forEach(function(item) {
                    query.append(key + '[]', item === undefined || item === null ? '' : String(item));
                });
                return;
            }
            query.append(key, String(value));
        });
        return query.toString();
    }

    function appendQueryString(url, params) {
        var query = buildQueryString(params);
        if (!query) {
            return url;
        }
        return url + (url.indexOf('?') === -1 ? '?' : '&') + query;
    }

    function normalizeProviderAccountResponse(response) {
        var data = response;
        var hasTransportEnvelope = data
            && typeof data === 'object'
            && !Array.isArray(data)
            && Object.prototype.hasOwnProperty.call(data, 'data')
            && (Object.prototype.hasOwnProperty.call(data, 'status')
                || Object.prototype.hasOwnProperty.call(data, 'ok')
                || Object.prototype.hasOwnProperty.call(data, 'headers'));
        if (hasTransportEnvelope) {
            data = data.data;
        }
        if (typeof data === 'string') {
            try {
                data = JSON.parse(data);
            } catch (e) {
                data = { success: false, message: data };
            }
        }
        /* Unwrap nested business envelope (worker may wrap controller JSON). */
        var guard = 0;
        while (
            guard++ < 3
            && data
            && typeof data === 'object'
            && !Array.isArray(data)
            && data.success === true
            && data.data
            && typeof data.data === 'object'
            && !Array.isArray(data.data)
            && Object.prototype.hasOwnProperty.call(data.data, 'success')
        ) {
            data = data.data;
        }
        return data || {};
    }

    function requestProviderAccount(api, operation, params) {
        var endpoint = providerAccountEndpoints[operation];
        if (!endpoint || !endpoint.url) {
            return Promise.reject(new Error('AI provider account operation is unavailable: ' + operation));
        }

        var payload = buildProviderAccountPayload(operation, params || {});
        var method = String(endpoint.method || 'GET').toUpperCase();
        var url = endpoint.url;
        var options = { method: method };

        if (method === 'GET') {
            url = appendQueryString(url, payload);
        } else if (operation === 'toggleActive' || operation === 'deleteAccount') {
            options.body = new URLSearchParams(payload);
        } else {
            options.body = payload;
        }

        options.silent = true;
        return api.request(url, options).then(normalizeProviderAccountResponse).catch(function(error) {
            var responseData = error && error.response
                ? normalizeProviderAccountResponse(error.response)
                : null;
            if (responseData && responseData.success === false) {
                return responseData;
            }
            throw error;
        });
    }

    function providerAccountCall(operation, params) {
        return getProviderAccountApi().then(function(api) {
            if (!api || typeof api[operation] !== 'function') {
                throw new Error('AI provider account operation is unavailable: ' + operation);
            }
            return api[operation](params || {}, { keepBusinessResult: true });
        });
    }

    // 页面加载完成后初始化（兼容 DOM 已就绪）
    function __welineProviderBoot() {
        loadAccounts();

        // 代理设置切换
        document.getElementById('proxy_enabled').addEventListener('change', function() {
            document.getElementById('proxySettings').style.display = this.checked ? 'block' : 'none';
        });

        // 供应商选择时自动填充基础URL
        document.getElementById('provider_code').addEventListener('change', function() {
            onProviderChange();
        });

        document.getElementById('providerFilter').addEventListener('change', function() {
            filterByProvider();
        });

        document.getElementById('is_active').addEventListener('change', function() {
            onActivateChange();
        });

        document.addEventListener('click', function(event) {
            var trigger = event.target.closest('[data-provider-action]');
            if (!trigger) {
                return;
            }
            var action = trigger.getAttribute('data-provider-action');
            var accountId = parseInt(trigger.getAttribute('data-account-id') || '0', 10) || 0;
            if (action !== 'page' && action !== 'usage-page' && action !== 'toggle-active') {
                event.preventDefault();
            }
            if (action === 'refresh') {
                refreshList();
            } else if (action === 'search') {
                searchAccounts();
            } else if (action === 'save') {
                saveAccount();
            } else if (action === 'test' && accountId > 0) {
                testConnection(accountId, trigger);
            } else if (action === 'edit' && accountId > 0) {
                editAccount(accountId);
            } else if (action === 'usage' && accountId > 0) {
                viewUsage(accountId);
            } else if (action === 'delete' && accountId > 0) {
                deleteAccount(accountId);
            } else if (action === 'page') {
                event.preventDefault();
                loadAccounts(parseInt(trigger.getAttribute('data-page') || '1', 10) || 1);
            } else if (action === 'usage-page') {
                event.preventDefault();
                loadUsageList(
                    parseInt(trigger.getAttribute('data-account-id') || '0', 10) || 0,
                    parseInt(trigger.getAttribute('data-page') || '1', 10) || 1
                );
            } else if (action === 'close-result') {
                closeResultModal(trigger);
            }
        });

        document.addEventListener('change', function(event) {
            var trigger = event.target;
            if (trigger && trigger.getAttribute('data-provider-action') === 'toggle-active') {
                toggleActive(parseInt(trigger.getAttribute('data-account-id') || '0', 10) || 0, trigger);
            }
        });

        // 回车搜索
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                searchAccounts();
            }
        });
    }
    if (document.readyState === 'loading') {
