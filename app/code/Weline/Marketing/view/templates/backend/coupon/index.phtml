<?php
/**
 * 优惠券管理 - 内容模板
 * @var \Weline\Framework\View\Template $this
 * @var array $coupons
 * @var \Weline\Framework\Pagination\Pagination $pagination
 */
$escapeHtml = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
?>
<link rel="stylesheet" href="@static(Weline_Marketing::css/coupon-index.css)">
<div class="w-grid marketing-coupon-page">
    <template>Weline_Component::message.phtml</template>
</div>

<div class="w-grid marketing-coupon-page">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading marketing-coupon-header w-cluster" data-align="center" data-justify="between">
            <h4 style="--w-mb-sm:0;">
                <lang>优惠券管理</lang>
            </h4>
            <div class="w-cluster">
                <ol class="w-breadcrumb" style="--w-mt:0;--w-me:0;--w-mb:0;--w-ms:0;">
                    <li class="w-breadcrumb__item"><span><lang>后台</lang></span></li>
                    <li class="w-breadcrumb__item"><span><lang>营销</lang></span></li>
                    <li class="w-breadcrumb__item" data-state="active"><lang>优惠券</lang></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="w-grid marketing-coupon-page" data-testid="marketing-coupon-management">
    <div style="--w-span:12;">
        <div class="marketing-coupon-card">
            <div class="marketing-coupon-card-header">
                <h5 class="marketing-coupon-card-title"><lang>优惠券列表</lang></h5>
                <a href="<?= $this->getBackendUrl('marketing/backend/coupon/getAdd') ?>" class="marketing-coupon-add-btn" data-testid="marketing-coupon-create">
                    <w:icon name="plus" size="sm"></w:icon><lang>添加优惠券</lang>
                </a>
            </div>
            <div class="marketing-coupon-card-body">
                <div class="marketing-coupon-table-wrap">
                    <table class="marketing-coupon-table">
                        <thead>
                            <tr>
                                <th><?= __('ID') ?></th>
                                <th><?= __('优惠券代码') ?></th>
                                <th><?= __('类型') ?></th>
                                <th><?= __('折扣值') ?></th>
                                <th><?= __('状态') ?></th>
                                <th><?= __('使用次数') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (empty($coupons)): ?>
                            <tr>
                                <td colspan="7">
                                    <div class="marketing-coupon-empty">
                                        <w:icon name="circle" size="sm"></w:icon>
                                        <span class="marketing-coupon-empty-text"><lang>暂无数据</lang></span>
                                    </div>
                                </td>
                            </tr>
                            <?php else: ?>
                            <?php foreach ($coupons as $coupon): ?>
                            <?php
                            $status = $coupon['status'] ?? '';
                            $statusClass = 'inactive';
                            if (in_array(strtolower((string)$status), ['1', 'active', '启用', 'enabled'], true)) {
                                $statusClass = 'active';
                            } elseif (in_array(strtolower((string)$status), ['expired', '已过期', '失效'], true)) {
                                $statusClass = 'expired';
                            }
                            ?>
                            <tr>
                                <td><?= $coupon['id'] ?></td>
                                <td><code class="marketing-coupon-code"><?= $escapeHtml($coupon['code']) ?></code></td>
                                <td><?= $escapeHtml($coupon['type'] ?? '') ?></td>
                                <td><?= $escapeHtml((string)($coupon['discount_value'] ?? '')) ?></td>
                                <td>
                                    <span class="marketing-coupon-badge marketing-coupon-badge--<?= $statusClass ?>">
                                        <?= $escapeHtml((string)$status) ?>
                                    </span>
                                </td>
                                <td><?= (int)($coupon['usage_count'] ?? 0) ?>/<?= ($coupon['usage_limit'] ?? 0) ? (int)$coupon['usage_limit'] : '∞' ?></td>
                                <td>
                                    <a href="<?= $this->getUrl('marketing/backend/coupon/getEdit', ['id' => $coupon['id']]) ?>"
                                       class="marketing-coupon-action-btn" title="<?= __('编辑') ?>">
                                        <w:icon name="edit" size="sm"></w:icon>
                                    </a>
                                </td>
                            </tr>
                            <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
                <?= $this->getChildHtml('pagination') ?>
            </div>
        </div>
    </div>
</div>
