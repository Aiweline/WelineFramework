                            <input id="marketing-coupon-code" data-testid="marketing-coupon-code" class="w-input" type="text" name="code" required maxlength="100" value="<?= $escapeHtml($value('code')) ?>">
                        </div>
                    </div>
                    <div class="w-grid">
                        <div style="--w-span-md:4;--w-mb:var(--weline-space-4);">
