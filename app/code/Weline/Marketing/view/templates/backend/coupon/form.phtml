<?php
/** @var \Weline\Framework\View\Template $this */
/** @var array $rules */
/** @var \Weline\Marketing\Model\Coupon\Coupon|null $coupon */
$rules = $rules ?? [];
$coupon = $coupon ?? null;
$isEdit = $coupon !== null && (int)$coupon->getId() > 0;
$escapeHtml = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$value = static function (string $field, mixed $default = '') use ($coupon): string {
    if ($coupon === null) {
        return (string)$default;
    }

    return (string)($coupon->getData($field) ?? $default);
};
$selected = static function (string $field, string $option, string $default = '') use ($value): string {
    return $value($field, $default) === $option ? ' selected' : '';
};
?>
