                            <select id="marketing-coupon-type" data-testid="marketing-coupon-type" class="w-select" name="type" required>
                                <option value="percentage"<?= $selected('type', 'percentage', 'percentage') ?>><?= __('百分比折扣') ?></option>
                                <option value="fixed_amount"<?= $selected('type', 'fixed_amount') ?>><?= __('固定金额') ?></option>
                                <option value="free_shipping"<?= $selected('type', 'free_shipping') ?>><?= __('免运费') ?></option>
