                            <select id="marketing-coupon-status" class="w-select" name="status">
                                <option value="active"<?= $selected('status', 'active', 'active') ?>><?= __('启用') ?></option>
                                <option value="inactive"<?= $selected('status', 'inactive') ?>><?= __('禁用') ?></option>
                            </select>
                        </div>
                    </div>
                    <div class="w-grid">
                        <div style="--w-span-md:4;--w-mb:var(--weline-space-4);">
