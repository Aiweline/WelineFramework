<?php
$segments = is_array($segments ?? null) ? $segments : [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$kindLabels = [
    'new_customer' => __('新客'),
    'returning' => __('老客'),
    'idle_days' => __('N 天未购'),
];
?>
<div class="w-grid" data-testid="marketing-segment-management">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <div>
        <h4 class="w-backend-page__title" style="--w-mb:0;"><?= __('营销分群') ?></h4>
        <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);--w-mb:0;">
          <?= __('薄分群：新客 / 老客 / N 天未购。活动可挂 segment_id。') ?>
        </p>
      </div>
      <a class="w-button" data-tone="primary" data-size="sm" href="<?= $escape($this->getUrl('*/backend/segment/add')) ?>" data-testid="marketing-segment-create">
        <?= __('新建分群') ?>
      </a>
    </div>
    <?php if ($load_error !== ''): ?>
      <div class="w-alert" data-tone="danger"><?= $escape($load_error) ?></div>
    <?php endif; ?>
    <div class="w-card"><div class="w-card__body">
      <table class="w-table" data-testid="marketing-segment-table">
        <thead>
        <tr>
          <th><?= __('ID') ?></th>
          <th><?= __('编码') ?></th>
          <th><?= __('名称') ?></th>
          <th><?= __('种类') ?></th>
          <th><?= __('状态') ?></th>
          <th><?= __('操作') ?></th>
        </tr>
        </thead>
        <tbody>
        <?php if ($segments === []): ?>
          <tr><td colspan="6" class="w-text" data-align="center" data-tone="muted"><?= __('还没有分群') ?></td></tr>
        <?php else: foreach ($segments as $row):
          $id = (int)(is_object($row) ? $row->getId() : ($row['id'] ?? 0));
          $code = (string)(is_object($row) ? $row->getData('code') : ($row['code'] ?? ''));
          $name = (string)(is_object($row) ? $row->getData('name') : ($row['name'] ?? ''));
          $kind = (string)(is_object($row) ? $row->getData('kind') : ($row['kind'] ?? ''));
          $status = (string)(is_object($row) ? $row->getData('status') : ($row['status'] ?? ''));
        ?>
          <tr>
            <td><?= $id ?></td>
            <td><?= $escape($code) ?></td>
            <td><?= $escape($name) ?></td>
            <td><?= $escape($kindLabels[$kind] ?? $kind) ?></td>
            <td><?= $escape($status === 'enabled' ? __('已启用') : __('已停用')) ?></td>
            <td><a class="w-button" data-tone="neutral" data-size="sm" href="<?= $escape($this->getUrl('*/backend/segment/edit', ['id' => $id])) ?>"><?= __('编辑') ?></a></td>
          </tr>
        <?php endforeach; endif; ?>
        </tbody>
      </table>
    </div></div>
  </div>
</div>
