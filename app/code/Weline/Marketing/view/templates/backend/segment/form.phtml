<?php
$segment = $segment ?? null;
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$id = $segment ? (int)$segment->getId() : 0;
$code = $segment ? (string)$segment->getData('code') : '';
$name = $segment ? (string)$segment->getData('name') : '';
$kind = $segment ? (string)$segment->getData('kind') : 'new_customer';
$status = $segment ? (string)$segment->getData('status') : 'enabled';
$configRaw = $segment ? (string)$segment->getData('config_json') : '';
$idleDays = 30;
if ($configRaw !== '') {
    $decoded = json_decode($configRaw, true);
    if (is_array($decoded)) {
        $idleDays = max(1, (int)($decoded['idle_days'] ?? 30));
    }
}
?>
<div class="w-grid" data-testid="marketing-segment-form">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <h4 class="w-backend-page__title" style="--w-mb:0;"><?= $id > 0 ? __('编辑分群') : __('新建分群') ?></h4>
      <a class="w-button" data-tone="neutral" data-size="sm" href="<?= $escape($this->getUrl('*/backend/segment/index')) ?>"><?= __('返回列表') ?></a>
    </div>
    <div class="w-card"><div class="w-card__body">
      <form method="post" action="<?= $escape($this->getUrl('*/backend/segment/save')) ?>" class="w-form">
        <input type="hidden" name="id" value="<?= $id ?>">
        <div class="w-form-group">
          <label class="w-label"><?= __('编码') ?></label>
          <input class="w-input" type="text" name="code" required value="<?= $escape($code) ?>" data-testid="marketing-segment-code">
        </div>
        <div class="w-form-group">
          <label class="w-label"><?= __('名称') ?></label>
          <input class="w-input" type="text" name="name" required value="<?= $escape($name) ?>">
        </div>
        <div class="w-form-group">
          <label class="w-label"><?= __('种类') ?></label>
          <select class="w-select" name="kind" data-testid="marketing-segment-kind">
            <option value="new_customer"<?= $kind === 'new_customer' ? ' selected' : '' ?>><?= __('新客') ?></option>
            <option value="returning"<?= $kind === 'returning' ? ' selected' : '' ?>><?= __('老客') ?></option>
            <option value="idle_days"<?= $kind === 'idle_days' ? ' selected' : '' ?>><?= __('N 天未购') ?></option>
          </select>
        </div>
        <div class="w-form-group">
          <label class="w-label"><?= __('未购天数（仅 idle_days）') ?></label>
          <input class="w-input" type="number" min="1" name="idle_days" value="<?= $idleDays ?>">
        </div>
        <div class="w-form-group">
          <label class="w-label"><?= __('状态') ?></label>
          <select class="w-select" name="status">
            <option value="enabled"<?= $status === 'enabled' ? ' selected' : '' ?>><?= __('已启用') ?></option>
            <option value="disabled"<?= $status === 'disabled' ? ' selected' : '' ?>><?= __('已停用') ?></option>
          </select>
        </div>
        <button class="w-button" data-tone="primary" type="submit" data-testid="marketing-segment-save"><?= __('保存') ?></button>
      </form>
    </div></div>
  </div>
</div>
