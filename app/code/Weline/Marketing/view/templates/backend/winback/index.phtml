<?php
$campaigns = is_array($campaigns ?? null) ? $campaigns : [];
$load_error = $load_error ?? '';
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
?>
<div class="w-grid" data-testid="marketing-winback-management">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <div>
        <h4 class="w-backend-page__title" style="--w-mb:0;"><?= __('挽回活动') ?></h4>
        <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);--w-mb:0;">
          <?= __('配置「下单后多久未付算遗弃」并定时催付。结账/订单只提供未付事实，时限由本页决定。') ?>
        </p>
      </div>
      <a class="w-button" data-tone="primary" data-size="sm" href="<?= $escape($this->getUrl('*/backend/winback/add')) ?>" data-testid="marketing-winback-create">
        <?= __('新建挽回活动') ?>
      </a>
    </div>
    <?php if ($load_error !== ''): ?>
      <div class="w-alert" data-tone="danger"><?= $escape($load_error) ?></div>
    <?php endif; ?>
    <div class="w-card"><div class="w-card__body">
      <div class="w-table-wrap">
        <table class="w-table" data-testid="marketing-winback-table">
          <thead>
          <tr>
            <th><?= __('ID') ?></th>
            <th><?= __('名称') ?></th>
            <th><?= __('状态') ?></th>
            <th><?= __('遗弃时限(小时)') ?></th>
            <th><?= __('最大步数') ?></th>
            <th><?= __('网站') ?></th>
            <th><?= __('操作') ?></th>
          </tr>
          </thead>
          <tbody>
          <?php if ($campaigns === []): ?>
            <tr><td colspan="7" class="w-text" data-align="center" data-tone="muted"><?= __('还没有挽回活动') ?></td></tr>
          <?php else: foreach ($campaigns as $row):
            $id = (int)(is_object($row) ? $row->getId() : ($row['id'] ?? 0));
            $name = (string)(is_object($row) ? $row->getData('name') : ($row['name'] ?? ''));
            $status = (string)(is_object($row) ? $row->getData('status') : ($row['status'] ?? ''));
            $abandon = (int)(is_object($row) ? $row->getData('abandon_after_hours') : ($row['abandon_after_hours'] ?? 0));
            $maxSteps = (int)(is_object($row) ? $row->getData('max_steps') : ($row['max_steps'] ?? 1));
            $websiteId = (int)(is_object($row) ? $row->getData('website_id') : ($row['website_id'] ?? 0));
          ?>
            <tr>
              <td><?= $id ?></td>
              <td><?= $escape($name) ?></td>
              <td><span class="w-badge" data-tone="<?= $status === 'enabled' ? 'success' : 'neutral' ?>"><?= $escape($status === 'enabled' ? __('已启用') : __('已停用')) ?></span></td>
              <td><?= $abandon ?></td>
              <td><?= $maxSteps ?></td>
              <td><?= $websiteId > 0 ? $websiteId : __('全部') ?></td>
              <td>
                <a class="w-button" data-tone="neutral" data-size="sm" href="<?= $escape($this->getUrl('*/backend/winback/edit', ['id' => $id])) ?>"><?= __('编辑') ?></a>
              </td>
            </tr>
          <?php endforeach; endif; ?>
          </tbody>
        </table>
      </div>
    </div></div>
  </div>
</div>
