<?php
$escapeHtml = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
/**
 * 营销规则管理 - 内容模板
 * @var \Weline\Framework\View\Template $this
 * @var array $rules
 * @var \Weline\Framework\Pagination\Pagination $pagination
 */
?>
<div class="w-grid" data-testid="marketing-rule-management">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading">
            <h4 class="w-backend-page__title"><lang>营销规则</lang></h4>
            <p class="w-backend-page__subtitle"><lang>万能优惠规则列表与维护入口</lang></p>
        </div>

        <template>Weline_Component::message.phtml</template>

        <div class="w-card">
            <div class="w-card__header w-cluster" data-align="center" data-justify="between">
                <h5 class="w-card__title" style="--w-mb:0;"><lang>规则列表</lang></h5>
                <a
                    href="@backend-url{'marketing/backend/rule/add'}"
                    class="w-button"
                    data-tone="primary"
                    data-testid="marketing-rule-create"
                >
                    <w:icon name="plus" size="sm"></w:icon><lang>添加规则</lang>
                </a>
            </div>
            <div class="w-card__body">
                <table class="w-table">
                    <thead>
                        <tr>
                            <th><?= __('ID') ?></th>
                            <th><?= __('规则名称') ?></th>
                            <th><?= __('类型') ?></th>
                            <th><?= __('状态') ?></th>
                            <th><?= __('优先级') ?></th>
                            <th><?= __('使用次数') ?></th>
                            <th><?= __('操作') ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (empty($rules)): ?>
                            <tr>
                                <td colspan="7">
                                    <div class="w-empty">
                                        <w:icon name="box" size="lg"></w:icon>
                                        <p class="w-text" data-tone="muted"><lang>暂无数据</lang></p>
                                    </div>
                                </td>
                            </tr>
                        <?php else: ?>
                            <?php foreach ($rules as $rule): ?>
                                <?php
                                $this->assign('rule', $rule);
                                $isActive = ($rule['status'] ?? '') == '1' || ($rule['status'] ?? '') == 'active';
                                $isExternal = !empty($rule['external_managed']);
                                $externalHint = (string)($rule['external_manage_hint'] ?? '');
                                $externalLabel = (string)($rule['external_module_label'] ?? '');
                                ?>
                                <tr data-external-managed="<?= $isExternal ? '1' : '0' ?>">
                                    <td><?= $rule['id'] ?></td>
                                    <td>
                                        <?php if (isset($rule['id']) && $rule['id']): ?>
                                            <local
                                                model="Weline\Marketing\Model\Rule\LocalDescription"
                                                field="name"
                                                id="rule.id"
                                                name="rule-name"
                                            >{{rule.local_name|rule.name}}</local>
                                        <?php else: ?>
                                            <?= $escapeHtml($rule['name'] ?? '') ?>
                                        <?php endif; ?>
                                        <?php if ($isExternal): ?>
                                            <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-1);">
                                                <span class="w-badge" data-tone="warning" data-testid="marketing-rule-external-badge"><lang>系统同步</lang></span>
                                                <?php if ($externalLabel !== ''): ?>
                                                    <span class="w-text" data-tone="muted" data-size="sm"><?= $escapeHtml($externalLabel) ?></span>
                                                <?php endif; ?>
                                            </div>
                                            <?php if ($externalHint !== ''): ?>
                                                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mt:var(--weline-space-1);" data-testid="marketing-rule-external-hint"><?= $escapeHtml($externalHint) ?></p>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </td>
                                    <td><?= $escapeHtml($rule['rule_type'] ?? '') ?></td>
                                    <td>
                                        <?php if ($isActive): ?>
                                            <span class="w-badge" data-tone="success"><lang>启用</lang></span>
                                        <?php else: ?>
                                            <span class="w-badge" data-tone="neutral"><lang>禁用</lang></span>
                                        <?php endif; ?>
                                    </td>
                                    <td><?= $rule['priority'] ?? 0 ?></td>
                                    <td><?= $rule['usage_count'] ?? 0 ?></td>
                                    <td>
                                        <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                                            <a
                                                href="@backend-url{'marketing/backend/rule/edit'|['id' => $rule['id']]}"
                                                class="w-button"
                                                data-tone="neutral"
                                                data-size="sm"
                                                title="<?= __('编辑') ?>"
                                            >
                                                <w:icon name="edit" size="sm"></w:icon>
                                            </a>
                                            <?php if ($isExternal): ?>
                                                <button
                                                    type="button"
                                                    class="w-button"
                                                    data-tone="neutral"
                                                    data-size="sm"
                                                    disabled
                                                    title="<?= $escapeHtml($externalHint !== '' ? $externalHint : (string)__('系统同步折扣不可删除，请到来源模块管理活动')) ?>"
                                                    data-testid="marketing-rule-delete-blocked"
                                                >
                                                    <w:icon name="trash" size="sm"></w:icon>
                                                </button>
                                            <?php else: ?>
                                                <form
                                                    method="post"
                                                    action="@backend-url{'marketing/backend/rule/delete'}"
                                                    style="display:inline;"
                                                    data-confirm-message="<?= $escapeHtml((string)__('确定删除该营销规则吗？')) ?>"
                                                    data-confirm-type="danger"
                                                >
                                                    <input type="hidden" name="id" value="<?= (int)$rule['id'] ?>">
                                                    <button
                                                        type="submit"
                                                        class="w-button"
                                                        data-tone="danger"
                                                        data-size="sm"
                                                        title="<?= __('删除') ?>"
                                                        data-testid="marketing-rule-delete"
                                                    >
                                                        <w:icon name="trash" size="sm"></w:icon>
                                                    </button>
                                                </form>
                                            <?php endif; ?>
                                        </div>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </tbody>
                </table>
                <?= $this->getChildHtml('pagination') ?>
            </div>
        </div>
    </div>
</div>
