                <h5 class="marketing-rule-card-title"><lang>规则列表</lang></h5>
                <a href="<?= $this->getBackendUrl('marketing/backend/rule/getAdd') ?>" class="marketing-rule-add-btn" data-testid="marketing-rule-create">
                    <w:icon name="plus" size="sm"></w:icon><lang>添加规则</lang>
                </a>
            </div>
