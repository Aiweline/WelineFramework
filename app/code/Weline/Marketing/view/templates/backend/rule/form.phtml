                    <div style="--w-mb:var(--weline-space-4);">
                        <label class="w-field__label" for="marketing-rule-name"><?= __('规则名称') ?></label>
                        <input id="marketing-rule-name" data-testid="marketing-rule-name" class="w-input" type="text" name="name" required maxlength="255" value="<?= $escape($ruleData['name'] ?? '') ?>" <?= $externalManaged ? 'readonly' : '' ?>>
                    </div>
                    <div style="--w-mb:var(--weline-space-4);">
