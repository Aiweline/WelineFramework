$rule = $rule ?? null;
$ruleData = is_object($rule) && method_exists($rule, 'getData') ? $rule->getData() : (is_array($rule) ? $rule : []);
$isEdit = !empty($ruleData['id']);
$externalManaged = !empty($external_managed);
