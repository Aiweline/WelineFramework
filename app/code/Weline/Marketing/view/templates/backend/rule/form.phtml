                            <select id="marketing-rule-type" data-testid="marketing-rule-type" class="w-select" name="rule_type" required <?= $externalManaged ? 'disabled' : '' ?>>
                                <?php
                                $type = (string)($ruleData['rule_type'] ?? 'coupon');
                                foreach (['coupon' => __('优惠券'), 'campaign' => __('促销活动'), 'automatic' => __('自动规则')] as $value => $label):
                                ?>
                                    <option value="<?= $escape($value) ?>" <?= $type === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
                                <?php endforeach; ?>
                            </select>
                            <?php if ($externalManaged): ?>
                                <input type="hidden" name="rule_type" value="<?= $escape($type) ?>">
                            <?php endif; ?>
                        </div>
                        <div style="--w-span-md:4;--w-mb:var(--weline-space-4);">
                            <label class="w-field__label" for="marketing-rule-status"><?= __('状态') ?></label>
                            <select id="marketing-rule-status" data-testid="marketing-rule-status" class="w-select" name="status" required <?= $externalManaged ? 'disabled' : '' ?>>
