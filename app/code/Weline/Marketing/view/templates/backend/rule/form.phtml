                                $status = (string)($ruleData['status'] ?? 'inactive');
                                foreach (['inactive' => __('禁用'), 'active' => __('启用'), 'expired' => __('已过期')] as $value => $label):
                                ?>
                                    <option value="<?= $escape($value) ?>" <?= $status === $value ? 'selected' : '' ?>><?= $escape($label) ?></option>
                                <?php endforeach; ?>
                            </select>
                            <?php if ($externalManaged): ?>
                                <input type="hidden" name="status" value="<?= $escape($status) ?>">
                            <?php endif; ?>
                        </div>
                        <div style="--w-span-md:4;--w-mb:var(--weline-space-4);">
                            <label class="w-field__label" for="marketing-rule-priority"><?= __('优先级') ?></label>
                            <input id="marketing-rule-priority" class="w-input" type="number" name="priority" min="0" value="<?= (int)($ruleData['priority'] ?? 0) ?>" <?= $externalManaged ? 'readonly' : '' ?>>
