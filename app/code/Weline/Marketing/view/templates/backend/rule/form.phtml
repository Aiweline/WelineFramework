        </div>
        <template>Weline_Component::message.phtml</template>
        <?php if ($externalManaged && $externalHint !== ''): ?>
            <div class="w-card" style="--w-mb:var(--weline-space-4);" data-testid="marketing-rule-external-edit-hint">
                <div class="w-card__body">
                    <span class="w-badge" data-tone="warning"><lang>系统同步</lang></span>
                    <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);"><?= $escape($externalHint) ?></p>
                </div>
            </div>
        <?php endif; ?>
        <div class="w-card">
            <div class="w-card__body">
