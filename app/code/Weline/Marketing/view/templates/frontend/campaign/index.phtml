<?php
/** @var \Weline\Framework\View\Template $this */

$heading = (string)($this->getData('campaign_page_heading') ?? __('活动'));
$subtitle = (string)($this->getData('campaign_page_subtitle') ?? '');
$items = (array)($this->getData('campaign_items') ?? []);
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<link rel="stylesheet"
      href="@static(Weline_Marketing::css/campaign-hub.css)?v=20260903-content-width1"
      data-no-extract="true">

<main class="w-campaign-hub" data-testid="marketing-campaign-hub" weline-code="marketing.campaign.hub">
    <header class="w-campaign-hub__header">
        <h1 class="w-campaign-hub__title"><?= $esc($heading) ?></h1>
        <?php if ($subtitle !== ''): ?>
            <p class="w-campaign-hub__subtitle"><?= $esc($subtitle) ?></p>
        <?php endif; ?>
    </header>

    <?php if ($items === []): ?>
        <p class="w-campaign-hub__empty" data-testid="marketing-campaign-empty">
            <lang>当前暂无进行中的活动，请稍后再来看看。</lang>
        </p>
    <?php else: ?>
        <div class="w-campaign-hub__grid" data-testid="marketing-campaign-grid">
            <?php foreach ($items as $row): ?>
                <?php
                if (!is_array($row)) {
                    continue;
                }
                $name = trim((string)($row['name'] ?? ''));
                if ($name === '') {
                    continue;
                }
                $description = trim((string)($row['description'] ?? ''));
                $start = trim((string)($row['start_date'] ?? ''));
                $end = trim((string)($row['end_date'] ?? ''));
                ?>
                <article class="w-campaign-hub__card" data-testid="marketing-campaign-card">
                    <h2 class="w-campaign-hub__card-title"><?= $esc($name) ?></h2>
                    <?php if ($description !== ''): ?>
                        <p class="w-campaign-hub__card-desc"><?= $esc($description) ?></p>
                    <?php endif; ?>
                    <?php if ($start !== '' || $end !== ''): ?>
                        <p class="w-campaign-hub__card-meta">
                            <lang args="[$start, $end]">活动时间：%{1} — %{2}</lang>
                        </p>
                    <?php endif; ?>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</main>
