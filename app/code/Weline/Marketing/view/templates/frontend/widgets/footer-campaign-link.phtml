<?php
/**
 * 页脚「支付与账户」扩展：营销活动入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-campaign-link}
 * @widget.name {页脚活动链接}
 * @widget.description {页脚支付与账户扩展槽：活动入口（跳转 Promotion /promotion/deals）；默认注入 footer-payment-account-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-payment-account-links}
 * @widget.supports {["footer-campaign-link","layout-footer-payment-account-links"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer-payment-account-links", "area":"footer", "sort_order":10, "required":true, "reason":"页脚支付与账户默认展示活动入口", "config":{"label":"活动"} }]}
 *
 * @param label {default="活动",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-campaign-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '活动';
$label = WidgetI18n::label($labelSource, '活动');
?>
<a class="footer-payment-account-link footer-campaign-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-campaign-link"
   href="@url{'promotion/deals'}"><?= $esc($label) ?></a>
