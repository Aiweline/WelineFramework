<?php
/**
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {checkout-coupon}
 * @widget.name {优惠券}
 * @widget.description {万能优惠规则：结账/购物车/迷你车共用优惠券输入与应用摘要。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["summary","footer"]}
 * @widget.page_layouts {["checkout","cart","mini-cart"]}
 * @widget.slot {checkout-summary-discount}
 * @widget.cache {3600}
 * @widget.supports {["checkout-summary-discount","cart-summary-discount","layout-mini-cart-footer-extras","mini-cart-footer-extras","checkout-coupon","marketing"]}
 * @widget.default_injections {[{"layout_type":"checkout","layout_option":"default","slot":"checkout-summary-discount","area":"content","sort_order":10,"required":true,"reason":"结账摘要默认展示优惠券部件","config":{"title":"优惠券"}},{"layout_type":"cart","layout_option":"default","slot":"cart-summary-discount","area":"content","sort_order":10,"required":true,"reason":"购物车摘要默认展示优惠券部件","config":{"title":"优惠券"}},{"layout_type":"mini-cart","layout_option":"default","slot":"footer-extras","area":"footer","sort_order":10,"required":true,"reason":"迷你购物车默认提供优惠券输入","config":{"title":"优惠券","compact":true}}]}
 * @widget.source {Weline_Marketing::css/widgets/checkout-coupon.css,Weline_Marketing::css/widgets/mini-cart-coupon.css}
 *
 * @param title {default="优惠券",type="string",label="标题"}
 * @param compact {default=false,type="bool",label="紧凑样式（迷你车）"}
 */
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$rawTitle = trim((string)($this->getData('title') ?? ''));
$title = $rawTitle !== '' ? (string)__($rawTitle) : (string)__('优惠券');
$compact = (bool)($this->getData('compact') ?? false);
$inputId = $compact ? 'marketing-checkout-coupon-code-mini' : 'marketing-checkout-coupon-code';
$controlsClass = $compact ? 'w-marketing-checkout-coupon__row' : 'w-marketing-checkout-coupon__controls';
$applyLabel = $compact
    ? (string)\Weline\Theme\Helper\WidgetI18n::label('应用')
    : (string)\Weline\Theme\Helper\WidgetI18n::label('应用优惠券');
?>
<div class="w-marketing-checkout-coupon<?= $compact ? ' w-marketing-checkout-coupon--mini-cart' : '' ?>"
     data-testid="checkout-coupon"
     data-widget-code="checkout-coupon"
     data-marketing-checkout-coupon
     data-weline-load="checkoutCoupon"
     data-mini-cart-tab-label="<?= $esc($title) ?>"
     data-i18n-enter-code="<?= $esc((string)__('请输入优惠券代码')) ?>"
     data-i18n-already-applied="<?= $esc((string)__('该优惠券已应用')) ?>"
     data-i18n-unavailable="<?= $esc((string)__('优惠券不可用')) ?>"
     data-i18n-invalid-limit="<?= $esc((string)__('优惠券无效、不可用或已达使用上限')) ?>"
     data-i18n-service-unavailable="<?= $esc((string)__('营销服务暂时不可用')) ?>"
     data-i18n-removed="<?= $esc((string)__('已移除优惠券')) ?>">
    <?php if ($compact): ?>
    <span class="w-marketing-checkout-coupon__tab-label" data-mini-cart-tab-label-source hidden><?= $esc($title) ?></span>
    <?php else: ?>
    <label class="w-marketing-checkout-coupon__label" for="<?= $esc($inputId) ?>" data-mini-cart-tab-label-source>
        <lang>优惠券代码</lang>
    </label>
    <?php endif; ?>
    <div class="w-marketing-checkout-coupon__tags" data-marketing-coupon-tags hidden></div>
    <div class="w-marketing-checkout-coupon__entry" data-marketing-coupon-entry>
        <div class="<?= $esc($controlsClass) ?>">
            <div class="w-marketing-checkout-coupon__field">
                <input
                    id="<?= $esc($inputId) ?>"
                    class="w-marketing-checkout-coupon__input"
                    type="text"
                    name="coupon_code"
                    autocomplete="off"
                    data-marketing-coupon-input
                    data-testid="checkout-coupon-input"
                    placeholder="<?= $esc((string)__('输入优惠券代码')) ?>"
                />
            </div>
            <button type="button"
                    class="w-marketing-checkout-coupon__apply"
                    data-marketing-coupon-apply
                    data-testid="checkout-coupon-apply"
                    data-i18n-loading="<?= $esc((string)\Weline\Theme\Helper\WidgetI18n::label('应用中...')) ?>">
                <?= $esc($applyLabel) ?>
            </button>
        </div>
    </div>
    <p class="w-marketing-checkout-coupon__message" data-marketing-coupon-message aria-live="polite"></p>
</div>
<?php // checkoutCoupon：由部件根 data-weline-load 声明，禁止 @static 直引 ?>
