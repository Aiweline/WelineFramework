<?php
/**
 * @widget.source {Weline_Marketing::css/widgets/widget-cart-progress.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js} @var array $config */
$config = \is_array($config ?? null) ? $config : [];
$threshold = (float)($config['threshold'] ?? 99);
$currency = (string)($config['currency'] ?? '');
$title = (string)($config['title'] ?? (string)__('满额进度'));
$welcomeLabel = (string)($config['welcome_label'] ?? (string)__('新客礼'));
$welcomeUrl = (string)($config['welcome_url'] ?? '/account/register');
$showWelcome = \array_key_exists('show_welcome', $config) ? !empty($config['show_welcome']) : true;
$subtotal = (float)($config['current'] ?? $config['subtotal'] ?? 0);

/** @var \Weline\Marketing\Service\MarketingCartProgressService $progressService */
$progressService = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Marketing\Service\MarketingCartProgressService::class);
$progress = $progressService->build($subtotal, $threshold, $currency);
$escape = static fn(mixed $v): string => \htmlspecialchars((string)$v, \ENT_QUOTES, 'UTF-8');
?>
<?php if (!empty($progress['enabled'])): ?>
<div class="mkt-cart-progress" data-testid="marketing-cart-progress" data-widget-style-class="6c838c868dae2079">
  <div class="mkt-cart-progress__head" data-widget-style-class="bbf02c34c6cafb5b">
    <strong data-widget-style-class="b452c8b8256eb282"><?= $escape($title) ?></strong>
    <?php if ($showWelcome): ?>
      <a href="<?= $escape($welcomeUrl) ?>" data-testid="marketing-welcome-gift-link" data-widget-style-class="30a97782fdaaa83d"><?= $escape($welcomeLabel) ?></a>
    <?php endif; ?>
  </div>
  <div class="mkt-cart-progress__track" role="progressbar"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="<?= $escape((string)$progress['percent']) ?>"
       data-widget-style-class="6a9bae0e9436c01b">
    <div class="mkt-cart-progress__bar" data-widget-style="height:100%;width:<?= $escape((string)$progress['percent']) ?>%;background:#16333f;transition:width .25s ease;"></div>
  </div>
  <p class="mkt-cart-progress__msg" data-widget-style-class="ab9cc31e817f818d"><?= $escape((string)$progress['message']) ?></p>
</div>
<?php endif; ?>
