    </div>
    <?php endif; ?>
    <div class="w-marketing-checkout-coupon__body">
        <?php if (!$compact): ?>
        <label class="w-marketing-checkout-coupon__label" for="marketing-mini-cart-coupon-code">
            <lang>优惠券代码</lang>
        </label>
        <?php endif; ?>
        <div class="w-marketing-checkout-coupon__tags" data-marketing-coupon-tags hidden></div>
