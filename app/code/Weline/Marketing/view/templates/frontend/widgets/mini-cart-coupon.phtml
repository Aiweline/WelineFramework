<?php
/**
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {mini-cart-coupon}
 * @widget.name {迷你购物车优惠券}
 * @widget.description {迷你购物车底部优惠券输入，会话绑定后在结账报价时生效。}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["mini-cart"]}
