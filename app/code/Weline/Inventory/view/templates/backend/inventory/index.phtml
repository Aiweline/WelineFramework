        <script>
        (function () {
            var panel = document.querySelector('[data-testid="inventory-warehouse-inline-create"]');
            var parentId = document.querySelector('[data-inventory-parent-id]');
            var nodeKind = document.querySelector('[data-inventory-node-kind]');
            var countryCode = document.querySelector('[data-inventory-country-code]');
            var regionCode = document.querySelector('[data-inventory-region-code]');
            var parentPrefix = document.querySelector('[data-inventory-parent-prefix]');
            var segment = document.querySelector('[data-inventory-code-segment]');
            var preview = document.querySelector('[data-inventory-code-preview]');
            var warehouseType = document.querySelector('[data-inventory-warehouse-type]');
            function normalize(value) {
                return String(value || '').toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
            }
            function refreshPreview() {
                if (!preview || !parentPrefix || !segment) return;
                var prefix = normalize(parentPrefix.value);
                var part = normalize(segment.value);
                preview.textContent = !part ? (prefix || '—') : (prefix ? (part.indexOf(prefix + '-') === 0 ? part : prefix + '-' + part) : part);
            }
            document.querySelectorAll('[data-inventory-add]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (!panel) return;
                    panel.hidden = false;
                    var kind = btn.getAttribute('data-inventory-add') === 'province' ? 'province' : 'warehouse';
                    if (parentId) parentId.value = btn.getAttribute('data-parent-id') || '0';
                    if (nodeKind) nodeKind.value = kind;
                    if (countryCode) countryCode.value = btn.getAttribute('data-country-code') || '';
                    if (regionCode) regionCode.value = btn.getAttribute('data-region-code') || '';
                    if (parentPrefix) parentPrefix.value = btn.getAttribute('data-parent-code') || '';
                    if (segment) {
                        segment.value = kind === 'province' ? '' : 'WH02';
                        segment.placeholder = kind === 'province' ? 'GD' : 'WH02';
                    }
                    if (warehouseType) {
                        warehouseType.value = kind === 'warehouse' ? 'physical' : 'logical';
                        warehouseType.disabled = kind !== 'warehouse';
                    }
                    refreshPreview();
                    if (segment) segment.focus();
                });
            });
            if (segment) segment.addEventListener('input', refreshPreview);
        })();
        </script>
