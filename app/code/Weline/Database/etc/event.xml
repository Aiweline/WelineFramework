<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <!--
      迁移在 SchemaDiff 之后、ModuleSetup 之前由 Upgrade 派发 upgrade_migrations 执行。
      upgrade_after 携带 migrations_already_run=true 时跳过，避免双跑。
    -->
    <event name="Weline_Framework_Setup::upgrade_migrations">
        <observer name="Weline_Database::setup_upgrade_migrations" instance="Weline\Database\Observer\SetupUpgradeObserver" disabled="false" shared="true" sort="0"/>
    </event>
    <event name="Weline_Framework_Setup::upgrade_after">
        <observer name="Weline_Database::setup_upgrade" instance="Weline\Database\Observer\SetupUpgradeObserver" disabled="false" shared="true" sort="0"/>
    </event>
</config>
