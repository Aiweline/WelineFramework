<div class="row" data-testid="inquiry-editor"><div class="col-12"><div class="page-title-box d-flex justify-content-between"><h4><?= __('可视化编辑询盘表单') ?></h4><a href="<?= $this->getBackendUrl('weline_inquiry/backend/inquiry/index') ?>"><?= __('返回列表') ?></a></div><div class="card"><div class="card-body"><div class="row g-3"><div class="col-md-4"><label><?= __('内部名称') ?><input class="form-control" data-iq="name"></label></div><div class="col-md-4"><label>Code<input class="form-control" data-iq="code" pattern="[a-z][a-z0-9-]+"></label></div><div class="col-md-4"><label><?= __('默认语言') ?><input class="form-control" data-iq="default_locale" value="en_US"></label></div></div><hr><div class="d-flex justify-content-between align-items-center"><h5><?= __('字段') ?></h5><button class="btn btn-outline-primary" type="button" data-iq-add><?= __('添加字段') ?></button></div><div data-iq-fields></div><hr><h5><?= __('翻译') ?> <small class="text-muted">(title / submit_label / 字段 label)</small></h5><textarea class="form-control" rows="10" data-iq-translations></textarea><div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="button" data-iq-save><?= __('保存草稿') ?></button><button class="btn btn-success" type="button" data-iq-publish><?= __('发布') ?></button></div><p class="mt-2" data-iq-message aria-live="polite"></p></div></div></div></div>
<script>(async function(){const state=<?= $stateJson ?>,root=document.querySelector('[data-testid="inquiry-editor"]'),fields=root.querySelector('[data-iq-fields]'),msg=root.querySelector('[data-iq-message]');let data={form_id:<?= (int)($form_id ?? 0) ?>,code:state.form?.code||'',name:state.form?.name||'',default_locale:state.form?.default_locale||'en_US',schema:state.schema||{fields:[]},settings:state.settings||{},translations:state.translations||{'en_US':{}}};for(const k of ['code','name','default_locale'])root.querySelector('[data-iq="'+k+'"]').value=data[k]||'';root.querySelector('[data-iq-translations]').value=JSON.stringify(data.translations,null,2);function draw(){fields.innerHTML='';data.schema.fields.forEach((f,i)=>{let r=document.createElement('div');r.className='border rounded p-2 mb-2';r.innerHTML='<div class="row g-2"><div class="col"><input class="form-control" placeholder="key" value="'+(f.key||'')+'"></div><div class="col"><select class="form-select"><option>text</option><option>textarea</option><option>email</option><option>tel</option><option>select</option><option>radio</option><option>checkbox</option><option>file</option></select></div><div class="col-auto"><label><input type="checkbox"> required</label></div><div class="col-auto"><button type="button" class="btn btn-sm btn-outline-danger">×</button></div></div>';let inputs=r.querySelectorAll('input'),select=r.querySelector('select');select.value=f.type||'text';inputs[0].oninput=e=>f.key=e.target.value;select.onchange=e=>f.type=e.target.value;inputs[1].checked=!!f.required;inputs[1].onchange=e=>f.required=e.target.checked;r.querySelector('button').onclick=()=>{data.schema.fields.splice(i,1);draw()};fields.appendChild(r)})}draw();root.querySelector('[data-iq-add]').onclick=()=>{data.schema.fields.push({key:'field_'+(data.schema.fields.length+1),type:'text',required:false,options:[]});draw()};async function save(publish){for(const k of ['code','name','default_locale'])data[k]=root.querySelector('[data-iq="'+k+'"]').value.trim();try{data.translations=JSON.parse(root.querySelector('[data-iq-translations]').value||'{}');let api=await Weline.load('api'),res=await api.resource('inquiry').adminSaveDraft(data);data.form_id=res.form.form_id;if(publish)res=await api.resource('inquiry').adminPublish({form_id:data.form_id});msg.textContent=publish?'<?= __('已发布') ?>':'<?= __('草稿已保存') ?>'}catch(e){msg.textContent=e.message||'<?= __('保存失败') ?>'}}root.querySelector('[data-iq-save]').onclick=()=>save(false);root.querySelector('[data-iq-publish]').onclick=()=>save(true)})();</script>
