<script>
(async function () {
    const state = <?= $stateJson ?>;
    const FIELD_TYPES = <?= $fieldTypesJson ?>;
    const TYPE_LABELS = {
        text: <?= json_encode(__('单行文本'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        textarea: <?= json_encode(__('多行文本'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        email: <?= json_encode(__('邮箱'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        tel: <?= json_encode(__('电话'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        number: <?= json_encode(__('数字'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        select: <?= json_encode(__('下拉选择'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        radio: <?= json_encode(__('单选'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        checkbox: <?= json_encode(__('多选'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        file: <?= json_encode(__('文件上传'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        country: <?= json_encode(__('国家/地区'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        hidden: <?= json_encode(__('隐藏字段'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
    };
    const I18N = {
        unnamed: <?= json_encode(__('未命名表单'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        type: <?= json_encode(__('类型'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        required: <?= json_encode(__('必填'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        removeField: <?= json_encode(__('删除字段'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        optionsHint: <?= json_encode(__('选项值（每行一个，提交用；显示名在下方文案区填写）'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        catalog: <?= json_encode(__('地址目录'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        catalogGlobal: <?= json_encode(__('全球国家'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        catalogInstalled: <?= json_encode(__('站点已安装地区'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        levels: <?= json_encode(__('级联层级'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        selection: <?= json_encode(__('选择方式'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        selectionSingle: <?= json_encode(__('单选'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        selectionMulti: <?= json_encode(__('多选'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        defaultBadge: <?= json_encode(__('默认'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        fieldLabel: <?= json_encode(__('显示标签'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        optionLabel: <?= json_encode(__('选项显示名'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        levelProvince: <?= json_encode(__('省/州标签'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        levelCity: <?= json_encode(__('城市标签'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        levelDistrict: <?= json_encode(__('区县标签'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        jsonBad: <?= json_encode(__('翻译 JSON 无法解析，请检查高级区语法'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        localeNeeded: <?= json_encode(__('请输入语言代码，如 en_US'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        aiWorking: <?= json_encode(__('正在 AI 填充…'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        aiFail: <?= json_encode(__('AI 填充失败'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        aiDone: <?= json_encode(__('AI 填充完成'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        published: <?= json_encode(__('已发布'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        drafted: <?= json_encode(__('草稿已保存'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        saveFail: <?= json_encode(__('保存失败'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
    };

    const root = document.querySelector('[data-testid="inquiry-editor"]');
    if (!root) return;

    const fieldsEl = root.querySelector('[data-iq-fields]');
    const countEl = root.querySelector('[data-iq-field-count]');
    const msg = root.querySelector('[data-iq-message]');
    const lede = root.querySelector('[data-iq-lede]');
    const tabsEl = root.querySelector('[data-iq-locale-tabs]');
    const i18nFieldsEl = root.querySelector('[data-iq-i18n-fields]');
    const translationsTa = root.querySelector('[data-iq-translations]');

    const data = {
        form_id: <?= $formId ?>,
        code: state.form?.code || '',
        name: state.form?.name || '',
        default_locale: state.form?.default_locale || 'en_US',
        schema: state.schema || { fields: [] },
        settings: state.settings || {},
        translations: state.translations || {},
    };
    if (!Array.isArray(data.schema.fields)) data.schema.fields = [];
    if (!data.translations || typeof data.translations !== 'object') data.translations = {};
    if (!data.translations[data.default_locale]) data.translations[data.default_locale] = {};

    let activeLocale = data.default_locale;
    let syncingJson = false;

    for (const k of ['code', 'name', 'default_locale']) {
        const input = root.querySelector('[data-iq="' + k + '"]');
        if (input) input.value = data[k] || '';
    }

    function esc(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function typeLabel(type) {
        return TYPE_LABELS[type] || type;
    }

    function typeOptions(selected) {
        const known = FIELD_TYPES.includes(selected) ? selected : (selected || 'text');
        const types = FIELD_TYPES.includes(known) ? FIELD_TYPES : FIELD_TYPES.concat([known]);
        return types.map((t) => '<option value="' + esc(t) + '"' + (t === known ? ' selected' : '') + '>' + esc(typeLabel(t)) + '</option>').join('');
    }

    function ensureValidation(field) {
        if (!field.validation || typeof field.validation !== 'object') field.validation = {};
        return field.validation;
    }

    function ensureLocaleBucket(locale) {
        if (!data.translations[locale] || typeof data.translations[locale] !== 'object') {
            data.translations[locale] = {};
        }
        if (!data.translations[locale].fields || typeof data.translations[locale].fields !== 'object') {
            data.translations[locale].fields = {};
        }
        return data.translations[locale];
    }

    function fieldCopy(locale, key) {
        const bucket = ensureLocaleBucket(locale);
        if (!bucket.fields[key] || typeof bucket.fields[key] !== 'object') bucket.fields[key] = {};
        return bucket.fields[key];
    }

    function localeList() {
        const def = (root.querySelector('[data-iq="default_locale"]')?.value || data.default_locale || 'en_US').trim() || 'en_US';
        data.default_locale = def;
        const rest = Object.keys(data.translations || {}).filter((locale) => locale && locale !== def);
        return [def].concat(rest);
    }

    function writeJson() {
        syncingJson = true;
        translationsTa.value = JSON.stringify(data.translations, null, 2);
        syncingJson = false;
    }

    function readJson() {
        try {
            const parsed = JSON.parse(translationsTa.value || '{}');
            if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('bad');
            data.translations = parsed;
            return true;
        } catch (e) {
            msg.textContent = I18N.jsonBad;
            msg.dataset.tone = 'danger';
            return false;
        }
    }

    function commitCopyForm() {
        const bucket = ensureLocaleBucket(activeLocale);
        root.querySelectorAll('[data-iq-copy]').forEach((el) => {
            const key = el.getAttribute('data-iq-copy');
            bucket[key] = String(el.value || '');
        });
        i18nFieldsEl.querySelectorAll('[data-iq-field-key]').forEach((row) => {
            const key = row.getAttribute('data-iq-field-key');
            const copy = fieldCopy(activeLocale, key);
            const label = row.querySelector('[data-iq-field-label]');
            if (label) copy.label = String(label.value || '');
            row.querySelectorAll('[data-iq-opt-value]').forEach((inp) => {
                const value = inp.getAttribute('data-iq-opt-value');
                if (!copy.options || typeof copy.options !== 'object') copy.options = {};
                copy.options[value] = String(inp.value || '');
            });
            row.querySelectorAll('[data-iq-level-key]').forEach((inp) => {
                const level = inp.getAttribute('data-iq-level-key');
                if (!copy.levels || typeof copy.levels !== 'object') copy.levels = {};
                copy.levels[level] = String(inp.value || '');
            });
        });
        writeJson();
    }

    function fillCopyForm() {
        const bucket = ensureLocaleBucket(activeLocale);
        root.querySelectorAll('[data-iq-copy]').forEach((el) => {
            const key = el.getAttribute('data-iq-copy');
            el.value = bucket[key] != null ? String(bucket[key]) : '';
        });

        i18nFieldsEl.innerHTML = '';
        data.schema.fields.forEach((f) => {
            const key = String(f.key || '').trim();
            if (!key) return;
            const copy = fieldCopy(activeLocale, key);
            const article = document.createElement('article');
            article.className = 'w-inquiry-editor__i18n-field';
            article.setAttribute('data-iq-field-key', key);

            let extras = '';
            if ((f.type === 'select' || f.type === 'radio' || f.type === 'checkbox') && Array.isArray(f.options) && f.options.length) {
                const opts = f.options.map((o) => (o && o.value != null ? String(o.value) : '')).filter(Boolean);
                extras += '<div class="w-inquiry-editor__i18n-options">';
                extras += '<span class="w-field__label">' + esc(I18N.optionLabel) + '</span>';
                opts.forEach((value) => {
                    const label = (copy.options && copy.options[value] != null) ? String(copy.options[value]) : '';
                    extras +=
                        '<label class="w-field"><span class="w-field__hint">' + esc(value) + '</span>' +
                        '<input class="w-input" data-iq-opt-value="' + esc(value) + '" value="' + esc(label) + '"></label>';
                });
                extras += '</div>';
            }
            if (f.type === 'country') {
                const levels = [
                    ['province', I18N.levelProvince],
                    ['city', I18N.levelCity],
                    ['district', I18N.levelDistrict],
                ];
                extras += '<div class="w-inquiry-editor__i18n-levels w-grid" style="--w-gap:var(--weline-space-3);">';
                levels.forEach(([level, label]) => {
                    const val = (copy.levels && copy.levels[level] != null) ? String(copy.levels[level]) : '';
                    extras +=
                        '<label class="w-field" style="--w-span-md:4;"><span class="w-field__label">' + esc(label) + '</span>' +
                        '<input class="w-input" data-iq-level-key="' + esc(level) + '" value="' + esc(val) + '"></label>';
                });
                extras += '</div>';
            }

            article.innerHTML =
                '<div class="w-inquiry-editor__i18n-field-head w-cluster" data-justify="between" data-align="center">' +
                '<strong class="w-inquiry-editor__i18n-key">' + esc(key) + '</strong>' +
                '<span class="w-text" data-tone="muted" data-size="sm">' + esc(typeLabel(f.type || 'text')) + '</span>' +
                '</div>' +
                '<label class="w-field"><span class="w-field__label">' + esc(I18N.fieldLabel) + '</span>' +
                '<input class="w-input" data-iq-field-label value="' + esc(copy.label != null ? copy.label : '') + '" placeholder="' + esc(key) + '"></label>' +
                extras;

            article.querySelectorAll('input').forEach((inp) => {
                inp.addEventListener('input', () => commitCopyForm());
            });
            i18nFieldsEl.appendChild(article);
        });
    }

    function drawLocaleTabs() {
        const locales = localeList();
        if (!locales.includes(activeLocale)) activeLocale = data.default_locale;
        tabsEl.innerHTML = '';
        locales.forEach((locale) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-inquiry-editor__locale-tab' + (locale === activeLocale ? ' is-active' : '');
            btn.setAttribute('role', 'tab');
            btn.setAttribute('aria-selected', locale === activeLocale ? 'true' : 'false');
            btn.dataset.locale = locale;
            btn.textContent = locale + (locale === data.default_locale ? ' · ' + I18N.defaultBadge : '');
            btn.onclick = () => {
                if (locale === activeLocale) return;
                commitCopyForm();
                activeLocale = locale;
                drawLocaleTabs();
                fillCopyForm();
            };
            tabsEl.appendChild(btn);
        });
    }

    function countryExtras(field) {
        const v = ensureValidation(field);
        const catalog = v.catalog || 'global';
        const levels = v.levels || 'country|province|city|district';
        const selection = v.selection || 'single';
        return (
            '<div class="w-inquiry-editor__extras" data-iq-country-extras>' +
            '<label class="w-field"><span class="w-field__label">' + esc(I18N.catalog) + '</span>' +
            '<select class="w-select" data-iq-country="catalog">' +
            '<option value="global"' + (catalog === 'global' ? ' selected' : '') + '>' + esc(I18N.catalogGlobal) + '</option>' +
            '<option value="installed"' + (catalog === 'installed' ? ' selected' : '') + '>' + esc(I18N.catalogInstalled) + '</option>' +
            '</select></label>' +
            '<label class="w-field"><span class="w-field__label">' + esc(I18N.levels) + '</span>' +
            '<input class="w-input" data-iq-country="levels" value="' + esc(levels) + '" placeholder="country|province|city|district" spellcheck="false">' +
            '<span class="w-field__hint">country|province|city|district</span></label>' +
            '<label class="w-field"><span class="w-field__label">' + esc(I18N.selection) + '</span>' +
            '<select class="w-select" data-iq-country="selection">' +
            '<option value="single"' + (selection === 'single' ? ' selected' : '') + '>' + esc(I18N.selectionSingle) + '</option>' +
            '<option value="multi"' + (selection === 'multi' ? ' selected' : '') + '>' + esc(I18N.selectionMulti) + '</option>' +
            '</select></label>' +
            '</div>'
        );
    }

    function choiceExtras(field) {
        const options = Array.isArray(field.options) ? field.options : [];
        const raw = options.map((o) => (o && o.value != null ? String(o.value) : '')).filter(Boolean).join('\n');
        return (
            '<div class="w-inquiry-editor__extras" data-iq-choice-extras>' +
            '<label class="w-field" style="--w-span:12;"><span class="w-field__label">' + esc(I18N.optionsHint) + '</span>' +
            '<textarea class="w-textarea" rows="3" data-iq-options spellcheck="false">' + esc(raw) + '</textarea></label>' +
            '</div>'
        );
    }

    function syncLede() {
        if (!lede) return;
        const code = (root.querySelector('[data-iq="code"]')?.value || '').trim();
        const name = (root.querySelector('[data-iq="name"]')?.value || '').trim();
        lede.textContent = (code || I18N.unnamed) + (name ? (' · ' + name) : '');
    }

    function draw() {
        fieldsEl.innerHTML = '';
        if (countEl) countEl.textContent = String(data.schema.fields.length);
        data.schema.fields.forEach((f, i) => {
            const type = f.type || 'text';
            const row = document.createElement('article');
            row.className = 'w-inquiry-editor__field' + (type === 'country' ? ' is-country' : '');
            row.dataset.iqFieldIndex = String(i);
            row.innerHTML =
                '<div class="w-inquiry-editor__field-main">' +
                '<span class="w-inquiry-editor__ord" aria-hidden="true">' + String(i + 1).padStart(2, '0') + '</span>' +
                '<label class="w-field w-inquiry-editor__cell w-inquiry-editor__cell--key"><span class="w-field__label visually-hidden">' + esc(<?= json_encode(__('字段键名'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>) + '</span>' +
                '<input class="w-input" data-iq-key placeholder="company" value="' + esc(f.key || '') + '" spellcheck="false"></label>' +
                '<label class="w-field w-inquiry-editor__cell w-inquiry-editor__cell--type"><span class="w-field__label visually-hidden">' + esc(I18N.type) + '</span>' +
                '<select class="w-select" data-iq-type data-testid="inquiry-editor-type">' + typeOptions(type) + '</select></label>' +
                '<label class="w-inquiry-editor__required w-inquiry-editor__cell w-inquiry-editor__cell--required"><input type="checkbox" data-iq-required' + (f.required ? ' checked' : '') + '> <span>' + esc(I18N.required) + '</span></label>' +
                '<button type="button" class="w-button w-inquiry-editor__cell w-inquiry-editor__cell--remove" data-tone="danger" data-variant="ghost" data-size="sm" data-iq-remove aria-label="' + esc(I18N.removeField) + '">×</button>' +
                '</div>' +
                (type === 'country' ? countryExtras(f) : '') +
                (type === 'select' || type === 'radio' || type === 'checkbox' ? choiceExtras(f) : '');

            row.querySelector('[data-iq-key]').oninput = (e) => { f.key = e.target.value; fillCopyForm(); writeJson(); };
            row.querySelector('[data-iq-type]').onchange = (e) => {
                f.type = e.target.value;
                if (f.type === 'country') ensureValidation(f);
                if ((f.type === 'select' || f.type === 'radio' || f.type === 'checkbox') && !Array.isArray(f.options)) f.options = [];
                draw();
                drawLocaleTabs();
                fillCopyForm();
            };
            row.querySelector('[data-iq-required]').onchange = (e) => { f.required = !!e.target.checked; };
            row.querySelector('[data-iq-remove]').onclick = () => { data.schema.fields.splice(i, 1); draw(); drawLocaleTabs(); fillCopyForm(); };

            const catalog = row.querySelector('[data-iq-country="catalog"]');
            const levels = row.querySelector('[data-iq-country="levels"]');
            const selection = row.querySelector('[data-iq-country="selection"]');
            if (catalog) catalog.onchange = (e) => { ensureValidation(f).catalog = e.target.value; };
            if (levels) levels.oninput = (e) => { ensureValidation(f).levels = e.target.value.trim(); };
            if (selection) selection.onchange = (e) => { ensureValidation(f).selection = e.target.value; };

            const optionsTa = row.querySelector('[data-iq-options]');
            if (optionsTa) {
                optionsTa.oninput = (e) => {
                    f.options = String(e.target.value || '')
                        .split(/\n+/)
                        .map((line) => line.trim())
                        .filter(Boolean)
                        .map((value) => ({ value }));
                    fillCopyForm();
                    writeJson();
                };
            }

            fieldsEl.appendChild(row);
        });
        fillCopyForm();
        writeJson();
    }

    function refreshI18nUi() {
        drawLocaleTabs();
        fillCopyForm();
        writeJson();
    }

    writeJson();
    draw();
    refreshI18nUi();
    syncLede();

    for (const k of ['code', 'name']) {
        root.querySelector('[data-iq="' + k + '"]')?.addEventListener('input', syncLede);
    }
    root.querySelector('[data-iq="default_locale"]')?.addEventListener('change', () => {
        data.default_locale = (root.querySelector('[data-iq="default_locale"]')?.value || '').trim() || 'en_US';
        ensureLocaleBucket(data.default_locale);
        if (!localeList().includes(activeLocale)) activeLocale = data.default_locale;
        refreshI18nUi();
    });

    root.querySelectorAll('[data-iq-copy]').forEach((el) => {
        el.addEventListener('input', () => commitCopyForm());
    });

    translationsTa.addEventListener('input', () => {
        if (syncingJson) return;
        if (!readJson()) return;
        if (!data.translations[activeLocale]) {
            const locales = localeList();
            activeLocale = locales[0] || data.default_locale;
        }
        refreshI18nUi();
    });

    root.querySelector('[data-iq-locale-add]').onclick = () => {
        const input = root.querySelector('[data-iq-locale-new]');
        const locale = String(input?.value || '').trim();
        if (!locale) {
            msg.textContent = I18N.localeNeeded;
            msg.dataset.tone = 'danger';
            return;
        }
        commitCopyForm();
        ensureLocaleBucket(locale);
        activeLocale = locale;
        if (input) input.value = '';
        refreshI18nUi();
        msg.textContent = '';
        msg.dataset.tone = '';
    };

    root.querySelector('[data-iq-add]').onclick = () => {
        data.schema.fields.push({ key: 'field_' + (data.schema.fields.length + 1), type: 'text', required: false, options: [] });
        draw();
        refreshI18nUi();
    };

    root.querySelector('[data-iq-ai-translate]').onclick = async () => {
        for (const k of ['code', 'name', 'default_locale']) {
            data[k] = (root.querySelector('[data-iq="' + k + '"]')?.value || '').trim();
        }
        commitCopyForm();
        if (!readJson()) return;
        const force = !!root.querySelector('[data-iq-ai-force]')?.checked;
        const btn = root.querySelector('[data-iq-ai-translate]');
        if (btn) btn.disabled = true;
        msg.textContent = I18N.aiWorking;
        msg.dataset.tone = '';
        try {
            const api = await Weline.load('api');
            const res = await api.resource('inquiry').adminAiTranslate({
                translations: data.translations,
                default_locale: data.default_locale,
                force: force,
            });
            if (!res || res.success === false) {
                throw new Error((res && res.message) || I18N.aiFail);
            }
            data.translations = res.translations || data.translations;
            refreshI18nUi();
            msg.textContent = res.message || I18N.aiDone;
            msg.dataset.tone = 'success';
        } catch (e) {
            msg.textContent = e.message || I18N.aiFail;
            msg.dataset.tone = 'danger';
        } finally {
            if (btn) btn.disabled = false;
        }
    };

    async function save(publish) {
        for (const k of ['code', 'name', 'default_locale']) {
            data[k] = (root.querySelector('[data-iq="' + k + '"]')?.value || '').trim();
        }
        commitCopyForm();
        if (!readJson()) return;
        try {
            const api = await Weline.load('api');
            let res = await api.resource('inquiry').adminSaveDraft(data);
            data.form_id = res.form.form_id;
            if (publish) {
                res = await api.resource('inquiry').adminPublish({ form_id: data.form_id });
            }
            msg.textContent = publish ? I18N.published : I18N.drafted;
            msg.dataset.tone = 'success';
            syncLede();
        } catch (e) {
            msg.textContent = e.message || I18N.saveFail;
            msg.dataset.tone = 'danger';
        }
    }

    root.querySelector('[data-iq-save]').onclick = () => save(false);
    root.querySelector('[data-iq-publish]').onclick = () => save(true);
})();
</script>
