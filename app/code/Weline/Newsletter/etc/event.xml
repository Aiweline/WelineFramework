<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <!-- T2：结账身份解析后（guest_email / customer_id 可识别）→ 台账 issued 券自动 apply -->
    <event name="Weline_Checkout::checkout::identity::resolve::after">
        <observer name="Weline_Newsletter::checkout_email_match_coupon_identity"
                  instance="Weline\Newsletter\Observer\CheckoutEmailMatchCouponObserver"
                  disabled="false"
                  shared="true"
                  sort="80"/>
    </event>

    <!-- T2：匿名结账邮箱校验后（checkout_data 含邮箱）再尝试一次 -->
    <event name="Weline_Checkout::checkout::guest::validate::after">
        <observer name="Weline_Newsletter::checkout_email_match_coupon_guest"
                  instance="Weline\Newsletter\Observer\CheckoutEmailMatchCouponObserver"
                  disabled="false"
                  shared="true"
                  sort="80"/>
    </event>
</config>
