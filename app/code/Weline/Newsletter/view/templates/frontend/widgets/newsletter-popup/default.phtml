}

@media (max-width: 480px) {
    .<?= $wc ?> .popup-stage {
        width: min(20rem, 94vw);
        max-width: min(20rem, 94vw);
    }

    .<?= $wc ?> .letter-shell__form {
        left: 12%;
        right: 12%;
        top: 9%;
        bottom: 28%;
        padding-inline: var(--weline-space-1);
    }

    .<?= $wc ?> .popup-title {
        font-size: var(--weline-font-size-md);
    }
}
</style>
