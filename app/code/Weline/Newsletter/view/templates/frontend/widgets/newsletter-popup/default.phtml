.<?= $wc ?>.editor-preview-mode,
.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    position: relative !important;
    display: block !important;
    background: transparent !important;
    height: auto;
}

.<?= $wc ?>.editor-preview-mode .popup-overlay,
.widget-preview-canvas .<?= $wc ?> .popup-overlay,
.<?= $wc ?>.is-preview .popup-overlay {
    display: none !important;
