<?php
/**
 * @widget.source {Weline_Newsletter::css/widgets/widget-newsletter-popup-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 订阅弹窗部件（Weline_Newsletter 拥有 · 古风宣纸信笺）
 * 半透明蒙版 + 实心宣纸信笺 WebP（非红包信封）；表单叠写于笺面。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {newsletter-popup}
 * @widget.name {订阅弹窗}
 * @widget.description {全站邮件订阅弹窗（古风信笺）；cookie_days 默认 14。}
 * @widget.type {newsletter}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 *
 * @param title {default="订阅获取优惠",type="string",label="标题"}
 * @param description {default="订阅我们的邮件，立即获得10%折扣码！",type="string",label="描述"}
 * @param image {default="",type="media_image",label="信笺图",description="可选自定义宣纸信笺（建议透明 WebP）；空则用模块默认古风信笺"}
 * @param button_text {default="立即订阅",type="string",label="按钮文字"}
 * @param trigger {default="deferred",type="select",label="触发方式",options={deferred:"组合延后",delay:"延迟显示",scroll:"滚动触发",exit:"退出意图"}}
 * @param delay_seconds {default=15,type="number",label="延迟秒数"}
 * @param scroll_percent {default=40,type="number",label="滚动百分比"}
 * @param min_open_seconds {default=3,type="number",label="最早弹出秒数"}
 * @param show_once {default=true,type="bool",label="仅显示一次"}
 * @param cookie_days {default=14,type="number",label="Cookie 天数"}
 */

use Weline\Framework\View\Data\DataInterface;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('newsletter-popup');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$srcTitle = '订阅获取优惠';
$srcDescription = '订阅我们的邮件，立即获得10%折扣码！';
$srcButton = '立即订阅';
$srcPlaceholder = '请输入您的邮箱';
$srcClose = '关闭';
$srcTopicPref = '主题偏好';
$srcPromo = '优惠活动';
$srcNew = '新品上新';
$srcPrivacy = '可随时退订';
$srcCoupon = '您的优惠码';
$srcEmailRequired = '请输入有效的邮箱地址。';
$srcFailed = '订阅失败。';

WidgetI18n::prefetchLabels([
    $srcTitle,
    $srcDescription,
    $srcButton,
    $srcPlaceholder,
    $srcClose,
    $srcTopicPref,
    $srcPromo,
    $srcNew,
    $srcPrivacy,
    $srcCoupon,
    $srcEmailRequired,
    $srcFailed,
]);

$title = WidgetI18n::label((string)($this->getData('title') ?? ''), $srcTitle);
$description = WidgetI18n::label((string)($this->getData('description') ?? ''), $srcDescription);
$image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('image') ?? '');
$buttonText = WidgetI18n::label((string)($this->getData('button_text') ?? ''), $srcButton);
$emailPlaceholder = WidgetI18n::label($srcPlaceholder);
$closeLabel = WidgetI18n::label($srcClose);
$topicPrefLabel = WidgetI18n::label($srcTopicPref);
$promoLabel = WidgetI18n::label($srcPromo);
$newLabel = WidgetI18n::label($srcNew);
$privacyLabel = WidgetI18n::label($srcPrivacy);
$couponLabel = WidgetI18n::label($srcCoupon);
$msgEmailRequired = WidgetI18n::label($srcEmailRequired);
$msgFailed = WidgetI18n::label($srcFailed);
$trigger = (string)($this->getData('trigger') ?? 'deferred');
$delaySeconds = (int)($this->getData('delay_seconds') ?? 15);
$scrollPercent = (int)($this->getData('scroll_percent') ?? 40);
$minOpenSeconds = (int)($this->getData('min_open_seconds') ?? 3);
$showOnce = (bool)($this->getData('show_once') ?? true);
$cookieDays = (int)($this->getData('cookie_days') ?? 14);
if ($cookieDays < 1) {
    $cookieDays = 14;
}
if ($delaySeconds < 1) {
    $delaySeconds = 15;
}
if ($scrollPercent < 1) {
    $scrollPercent = 40;
}
if ($minOpenSeconds < 0) {
    $minOpenSeconds = 3;
}
/* WO-HP-P2-06：短 delay 单触发升级为组合延后，禁止首访首屏立即弹 */
if ($trigger === 'delay' && $delaySeconds < 15) {
    $trigger = 'deferred';
    $delaySeconds = 15;
    if ($scrollPercent < 40) {
        $scrollPercent = 40;
    }
}
if ($trigger === '' || $trigger === 'auto') {
    $trigger = 'deferred';
}

$shellUrl = $image !== ''
    ? $image
    : (string)$this->fetchTagSource(
        DataInterface::dir_type_STATICS,
        'Weline_Newsletter::images/newsletter-xinjian-gufeng.webp'
    );
$headline = $description !== '' ? $description : $title;

$isEditorPreview = $this->getData('_editor_preview')
    || ((string)\w_env_get('widget_preview', '') === '1')
    || strpos(\w_env_request_uri(), 'widget-preview') !== false;
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false) || $isEditorPreview;

$rootClass = $wc
    . ($isPreviewMode ? ' is-preview' : '')
    . ($isEditorPreview ? ' editor-preview-mode' : '')
    . ($isPreviewMode ? ' is-open' : '');
$rootStyle = $isEditorPreview ? '' : 'display: none;';
?>

<section class="<?= $esc($rootClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="newsletter-popup"
         data-newsletter-root="1"
         data-newsletter-kind="popup"
         data-source-surface="popup"
         data-testid="newsletter-popup"
         data-trigger="<?= $esc((string)$trigger) ?>"
         data-delay="<?= $esc((string)($delaySeconds * 1000)) ?>"
         data-scroll="<?= $esc((string)$scrollPercent) ?>"
         data-min-open="<?= $esc((string)($minOpenSeconds * 1000)) ?>"
         data-show-once="<?= $showOnce ? 'true' : 'false' ?>"
         data-cookie-days="<?= $esc((string)$cookieDays) ?>"
         data-weline-load="newsletterSubscribe"
         data-widget-style="<?= $esc($rootStyle) ?>">

    <div class="popup-overlay"></div>

    <div class="popup-stage" data-testid="newsletter-popup-letter">
        <button class="popup-close" type="button" aria-label="<?= $esc($closeLabel) ?>">
            <svg class="popup-close-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7a1 1 0 0 0-1.41 1.41L10.59 12l-4.89 4.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/>
            </svg>
        </button>

        <div class="letter-shell" data-testid="newsletter-letter-sheet">
            <img class="letter-shell__art"
                 src="<?= $esc($shellUrl) ?>"
                 alt=""
                 width="720"
                 height="960"
                 decoding="async">

            <div class="letter-shell__form">
                <?php if ($headline): ?>
                    <h2 class="popup-title"><?= $esc($headline) ?></h2>
                <?php endif; ?>

                <w:form class="popup-form"
                        action="@url{'newsletter/subscribe'}"
                        method="post"
                        data-testid="newsletter-popup-form"
                        data-newsletter-form="1"
                        data-source-surface="popup"
                        data-msg-email-required="<?= $esc($msgEmailRequired) ?>"
                        data-msg-subscribe-failed="<?= $esc($msgFailed) ?>">
                    <input type="hidden" name="source_surface" value="popup">
                    <input type="email"
                           name="email"
                           class="w-input popup-input"
                           placeholder="<?= $esc($emailPlaceholder) ?>"
                           autocomplete="email"
                           required>
                    <div class="newsletter-topics" role="group" aria-label="<?= $esc($topicPrefLabel) ?>">
                        <label class="newsletter-topic">
                            <input type="hidden" name="topic_promo" value="0">
                            <input type="checkbox" name="topic_promo" value="1" checked>
                            <span><?= $esc($promoLabel) ?></span>
                        </label>
                        <label class="newsletter-topic">
                            <input type="hidden" name="topic_new_arrivals" value="0">
                            <input type="checkbox" name="topic_new_arrivals" value="1" checked>
                            <span><?= $esc($newLabel) ?></span>
                        </label>
                    </div>
                    <div class="popup-cta">
                        <button type="submit" class="w-button popup-submit" data-variant="primary"><?= $esc($buttonText) ?></button>
                    </div>
                </w:form>

                <p class="popup-note"><?= $esc($privacyLabel) ?></p>

                <div class="newsletter-success"
                     data-testid="newsletter-subscribe-success"
                     hidden>
                    <p data-newsletter-success-message></p>
                    <p class="newsletter-coupon-wrap">
                        <span class="newsletter-coupon-label"><?= $esc($couponLabel) ?>:</span>
                        <strong data-newsletter-coupon hidden></strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
