    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-xs, 0.2rem);
    box-shadow: var(--weline-theme-shadow-sm);
}

.<?= $wc ?> .letter-shell__art {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
    background: transparent;
}

/* 表单叠在信笺书写区；纸面不透明底保证字可读（图外透明、纸内实心） */
.<?= $wc ?> .letter-shell__form {
    position: absolute;
    left: 16%;
    right: 16%;
    top: 9%;
    bottom: 32%;
    z-index: 2;
    box-sizing: border-box;
    padding: var(--weline-space-4) var(--weline-space-3) var(--weline-space-3);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--weline-space-3);
    overflow: auto;
    line-height: normal;
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-xs, 0.2rem);
    opacity: 0;
    transform: translateY(12%);
    transition:
        opacity 0.5s ease 0.18s,
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
}

.<?= $wc ?>.is-open .letter-shell__form {
    opacity: 1;
    transform: translateY(0);
}

.<?= $wc ?> .popup-title {
    font-size: var(--weline-font-size-lg);
    font-weight: 700;
    margin: 0;
    color: var(--weline-theme-text);
    letter-spacing: 0.04em;
    line-height: 1.45;
}

.<?= $wc ?> .popup-form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--weline-space-3);
}

