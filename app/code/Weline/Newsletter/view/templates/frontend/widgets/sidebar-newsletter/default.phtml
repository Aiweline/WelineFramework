<?php
/**
 * @widget.source {Weline_Newsletter::css/widgets/widget-sidebar-newsletter-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 邮件订阅（侧栏）部件 — 自 Theme 迁入，避免残留双注册
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {sidebar-newsletter}
 * @widget.name {侧栏订阅}
 * @widget.description {侧边栏邮件订阅表单}
 * @widget.type {newsletter}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="订阅我们",type="string",label="标题"}
 * @param description {default="订阅获取最新优惠信息",type="string",label="描述"}
 * @param button_text {default="订阅",type="string",label="按钮文字"}
 * @param placeholder {default="请输入邮箱地址",type="string",label="占位符"}
 * @param bg_color {default="var(--weline-theme-primary)",type="color",label="背景色"}
 * @param text_color {default="var(--weline-theme-on-primary)",type="color",label="文字色"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-newsletter');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('订阅我们');
$description = $this->getData('description') ?? __('订阅获取最新优惠信息');
$buttonText = $this->getData('button_text') ?? __('订阅');
$placeholder = $this->getData('placeholder') ?? __('请输入邮箱地址');
$bgColor = ThemeUiColor::sanitize($this->getData('bg_color') ?? '', 'var(--weline-theme-primary)');
$textColor = ThemeUiColor::sanitize($this->getData('text_color') ?? '', 'var(--weline-theme-on-primary)');
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="sidebar-newsletter"
         data-newsletter-root="1"
         data-newsletter-kind="sidebar"
         data-source-surface="footer"
         data-testid="newsletter-sidebar"
         data-weline-load="newsletterSubscribe"
         data-widget-style="--wc-newsletter-bg: <?= $esc($bgColor) ?>;--wc-newsletter-text: <?= $esc($textColor) ?>;">
    <div class="newsletter-icon">
        <w:icon name="mail" size="sm"></w:icon>
    </div>
    <?php if ($title !== ''): ?>
        <h3 class="widget-title"><?= $esc((string)$title) ?></h3>
    <?php endif; ?>
    <?php if ($description !== ''): ?>
        <p class="widget-description"><?= $esc((string)$description) ?></p>
    <?php endif; ?>
    <w:form class="newsletter-form"
            action="@url{'newsletter/subscribe'}"
            method="post"
            data-testid="newsletter-sidebar-form"
            data-newsletter-form="1"
            data-source-surface="footer">
        <input type="hidden" name="source_surface" value="footer">
        <input type="email" name="email" class="newsletter-input" placeholder="<?= $esc((string)$placeholder) ?>" autocomplete="email" required>
        <div class="newsletter-topics" role="group" aria-label="<?= $esc(__('主题偏好')) ?>">
            <label class="newsletter-topic">
                <input type="hidden" name="topic_promo" value="0">
                <input type="checkbox" name="topic_promo" value="1" checked>
                <span><?= $esc(__('优惠活动')) ?></span>
            </label>
            <label class="newsletter-topic">
                <input type="hidden" name="topic_new_arrivals" value="0">
                <input type="checkbox" name="topic_new_arrivals" value="1" checked>
                <span><?= $esc(__('新品上新')) ?></span>
            </label>
        </div>
        <button type="submit" class="newsletter-submit"><?= $esc((string)$buttonText) ?></button>
    </w:form>
    <p class="newsletter-privacy"><?= $esc(__('可随时退订')) ?></p>
    <div class="newsletter-success" data-testid="newsletter-subscribe-success" hidden>
        <p data-newsletter-success-message></p>
        <strong data-newsletter-coupon hidden></strong>
    </div>
</section>

