    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?> .newsletter-topic {
    display: inline-flex;
    align-items: center;
    gap: var(--weline-space-1);
    cursor: pointer;
}

.<?= $wc ?> .newsletter-submit {
    padding: var(--weline-space-3);
    border: none;
    border-radius: var(--weline-radius-md);
    background: color-mix(in srgb, var(--wc-newsletter-text) 18%, transparent);
    color: var(--wc-newsletter-text);
    font-weight: 600;
    cursor: pointer;
}

.<?= $wc ?> .newsletter-privacy {
    margin: var(--weline-space-3) 0 0;
    font-size: var(--weline-font-size-xs);
    opacity: 0.8;
}

.<?= $wc ?> .newsletter-success {
    margin-top: var(--weline-space-3);
    font-size: var(--weline-font-size-sm);
}
</style>
