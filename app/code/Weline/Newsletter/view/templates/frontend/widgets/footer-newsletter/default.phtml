<?php
/**
 * @widget.source {Weline_Newsletter::css/widgets/widget-footer-newsletter-default.css,Weline_Newsletter::css/widgets/widget-newsletter-popup-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 页脚邮件订阅部件（Weline_Newsletter 拥有）
 * Variant A：全宽条带 + 版心两列（文案 | 表单），高对比主题色，禁止依赖父级 primary 底。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-newsletter}
 * @widget.name {页脚订阅}
 * @widget.description {邮件订阅表单；经 required default_injections 注入 footer-above；enable_popup 默认同渲弹窗。}
 * @widget.type {newsletter}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-above}
 * @widget.exclusive {false}
 * @widget.supports {["footer-newsletter","layout-footer-above","layout-footer-newsletter","layout-global-footer-newsletter"]}
 *
 * @param title {default="订阅我们的邮件",type="string",label="标题"}
 * @param description {default="获取最新的优惠信息和新品资讯",type="string",label="描述"}
 * @param placeholder {default="请输入您的邮箱地址",type="string",label="占位符"}
 * @param button_text {default="订阅",type="string",label="按钮文字"}
 * @param layout {default="horizontal",type="select",label="布局",options={horizontal:"横向",vertical:"纵向"}}
 * @param enable_popup {default=true,type="bool",label="开启订阅弹窗",description="与本页脚条同启；关闭则不渲染 newsletter-popup"}
 * @param popup_trigger {default="deferred",type="select",label="弹窗触发",options={deferred:"组合延后",delay:"延迟",scroll:"滚动",exit:"退出意向"}}
 * @param popup_delay_seconds {default=15,type="number",label="弹窗延迟秒数"}
 * @param popup_scroll_percent {default=40,type="number",label="弹窗滚动百分比"}
 * @param popup_min_open_seconds {default=3,type="number",label="弹窗最早弹出秒数"}
 * @param popup_cookie_days {default=14,type="number",label="弹窗 Cookie 天数"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-newsletter');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);

$srcTitle = '订阅我们的邮件';
$srcDescription = '获取最新的优惠信息和新品资讯';
$srcPlaceholder = '请输入您的邮箱地址';
$srcButton = '订阅';
$srcTopicPref = '主题偏好';
$srcPromo = '优惠活动';
$srcNew = '新品上新';
$srcPrivacy = '可随时退订';
$srcCoupon = '您的优惠码';
$srcEmailRequired = '请输入有效的邮箱地址。';
$srcFailed = '订阅失败。';

WidgetI18n::prefetchLabels([
    $srcTitle,
    $srcDescription,
    $srcPlaceholder,
    $srcButton,
    $srcTopicPref,
    $srcPromo,
    $srcNew,
    $srcPrivacy,
    $srcCoupon,
    $srcEmailRequired,
    $srcFailed,
]);

$title = WidgetI18n::label((string)($this->getData('title') ?? ''), $srcTitle);
$description = WidgetI18n::label((string)($this->getData('description') ?? ''), $srcDescription);
$placeholder = WidgetI18n::label((string)($this->getData('placeholder') ?? ''), $srcPlaceholder);
$buttonText = WidgetI18n::label((string)($this->getData('button_text') ?? ''), $srcButton);
$topicPrefLabel = WidgetI18n::label($srcTopicPref);
$promoLabel = WidgetI18n::label($srcPromo);
$newLabel = WidgetI18n::label($srcNew);
$privacyLabel = WidgetI18n::label($srcPrivacy);
$couponLabel = WidgetI18n::label($srcCoupon);
$msgEmailRequired = WidgetI18n::label($srcEmailRequired);
$msgFailed = WidgetI18n::label($srcFailed);
$layout = $this->getData('layout') ?? 'horizontal';
$enablePopup = filter_var($this->getData('enable_popup') ?? true, FILTER_VALIDATE_BOOLEAN);
?>

<section class="<?= $esc($wc) ?> layout-<?= $esc((string)$layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="footer-newsletter"
         data-newsletter-root="1"
         data-newsletter-kind="footer"
         data-source-surface="footer"
         data-testid="newsletter-footer"
         data-enable-popup="<?= $enablePopup ? 'true' : 'false' ?>"
         data-weline-load="newsletterSubscribe">
    <div class="newsletter-band">
        <div class="newsletter-content">
            <?php if ($title): ?>
                <h3 class="newsletter-title"><?= $esc($title) ?></h3>
            <?php endif; ?>

            <?php if ($description): ?>
                <p class="newsletter-description"><?= $esc($description) ?></p>
            <?php endif; ?>
        </div>

        <w:form class="newsletter-form"
                action="@url{'newsletter/subscribe'}"
                method="post"
                data-testid="newsletter-footer-form"
                data-newsletter-form="1"
                data-source-surface="footer"
                data-msg-email-required="<?= $esc($msgEmailRequired) ?>"
                data-msg-subscribe-failed="<?= $esc($msgFailed) ?>">
            <input type="hidden" name="source_surface" value="footer">
            <div class="newsletter-controls">
                <input type="email"
                       name="email"
                       class="w-input newsletter-input"
                       placeholder="<?= $esc($placeholder) ?>"
                       autocomplete="email"
                       required>
                <button type="submit" class="w-button newsletter-button" data-variant="primary">
                    <?= $esc($buttonText) ?>
                </button>
            </div>
            <div class="newsletter-meta">
                <div class="newsletter-topics" role="group" aria-label="<?= $esc($topicPrefLabel) ?>">
                    <label class="newsletter-topic">
                        <input type="hidden" name="topic_promo" value="0">
                        <input type="checkbox" name="topic_promo" value="1" checked>
                        <span><?= $esc($promoLabel) ?></span>
                    </label>
                    <label class="newsletter-topic">
                        <input type="hidden" name="topic_new_arrivals" value="0">
                        <input type="checkbox" name="topic_new_arrivals" value="1" checked>
                        <span><?= $esc($newLabel) ?></span>
                    </label>
                </div>
                <p class="newsletter-privacy"><?= $esc($privacyLabel) ?></p>
            </div>
        </w:form>

        <div class="newsletter-success"
             data-testid="newsletter-subscribe-success"
             hidden>
            <p data-newsletter-success-message></p>
            <p class="newsletter-coupon-wrap">
                <span class="newsletter-coupon-label"><?= $esc($couponLabel) ?>:</span>
                <strong data-newsletter-coupon hidden></strong>
            </p>
        </div>
    </div>
</section>
<?php if ($enablePopup): ?>
<?= $this->fetch('Weline_Newsletter::templates/frontend/widgets/newsletter-popup/default.phtml', [
    'preview_mode' => $isPreviewMode,
    'trigger' => (string)($this->getData('popup_trigger') ?? 'deferred'),
    'delay_seconds' => (int)($this->getData('popup_delay_seconds') ?? 15),
    'scroll_percent' => (int)($this->getData('popup_scroll_percent') ?? 40),
    'min_open_seconds' => (int)($this->getData('popup_min_open_seconds') ?? 3),
    'cookie_days' => (int)($this->getData('popup_cookie_days') ?? 14),
    'show_once' => true,
]) ?>
<?php endif; ?>
