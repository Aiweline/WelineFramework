<?php
/**
 * @widget.source {Weline_Newsletter::css/widgets/widget-footer-newsletter-default.css}
 * 页脚邮件订阅部件（Weline_Newsletter 拥有）
 * Variant A：全宽条带 + 版心两列（文案 | 表单），高对比主题色，禁止依赖父级 primary 底。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-newsletter}
 * @widget.name {页脚订阅}
 * @widget.description {邮件订阅表单；经 required default_injections 注入 footer-above 槽。}
 * @widget.type {newsletter}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-above}
 * @widget.exclusive {false}
 * @widget.supports {["footer-newsletter","layout-footer-above","layout-footer-newsletter","layout-global-footer-newsletter"]}
 *
 * @param title {default="订阅我们的邮件",type="string",label="标题"}
 * @param description {default="获取最新的优惠信息和新品资讯",type="string",label="描述"}
 * @param placeholder {default="请输入您的邮箱地址",type="string",label="占位符"}
 * @param button_text {default="订阅",type="string",label="按钮文字"}
 * @param layout {default="horizontal",type="select",label="布局",options={horizontal:"横向",vertical:"纵向"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-newsletter');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = __((string)($this->getData('title') ?: '订阅我们的邮件'));
$description = __((string)($this->getData('description') ?: '获取最新的优惠信息和新品资讯'));
$placeholder = __((string)($this->getData('placeholder') ?: '请输入您的邮箱地址'));
$buttonText = __((string)($this->getData('button_text') ?: '订阅'));
$layout = $this->getData('layout') ?? 'horizontal';
?>

<section class="<?= $esc($wc) ?> layout-<?= $esc((string)$layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="footer-newsletter"
         data-newsletter-root="1"
         data-newsletter-kind="footer"
         data-source-surface="footer"
         data-testid="newsletter-footer"
         data-weline-load="newsletterSubscribe">
    <div class="newsletter-band">
        <div class="newsletter-content">
            <?php if ($title): ?>
                <h3 class="newsletter-title"><?= $esc($title) ?></h3>
            <?php endif; ?>

            <?php if ($description): ?>
                <p class="newsletter-description"><?= $esc($description) ?></p>
            <?php endif; ?>
        </div>

        <w:form class="newsletter-form"
                action="@url{'newsletter/subscribe'}"
                method="post"
                data-testid="newsletter-footer-form"
                data-newsletter-form="1"
                data-source-surface="footer">
            <input type="hidden" name="source_surface" value="footer">
            <div class="newsletter-controls">
                <input type="email"
                       name="email"
                       class="w-input newsletter-input"
                       placeholder="<?= $esc($placeholder) ?>"
                       autocomplete="email"
                       required>
                <button type="submit" class="w-button newsletter-button" data-variant="primary">
                    <?= $esc($buttonText) ?>
                </button>
            </div>
            <div class="newsletter-meta">
                <div class="newsletter-topics" role="group" aria-label="<?= $esc(__('主题偏好')) ?>">
                    <label class="newsletter-topic">
                        <input type="hidden" name="topic_promo" value="0">
                        <input type="checkbox" name="topic_promo" value="1" checked>
                        <span><?= $esc(__('优惠活动')) ?></span>
                    </label>
                    <label class="newsletter-topic">
                        <input type="hidden" name="topic_new_arrivals" value="0">
                        <input type="checkbox" name="topic_new_arrivals" value="1" checked>
                        <span><?= $esc(__('新品上新')) ?></span>
                    </label>
                </div>
                <p class="newsletter-privacy"><?= $esc(__('可随时退订')) ?></p>
            </div>
        </w:form>

        <div class="newsletter-success"
             data-testid="newsletter-subscribe-success"
             hidden>
            <p data-newsletter-success-message></p>
            <p class="newsletter-coupon-wrap">
                <span class="newsletter-coupon-label"><?= $esc(__('您的优惠码')) ?>:</span>
                <strong data-newsletter-coupon hidden></strong>
            </p>
        </div>
    </div>
</section>

