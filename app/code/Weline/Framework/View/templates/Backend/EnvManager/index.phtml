<script>
(function(g){
  if(g.__bqAdmin_framework_admin) return;
  g.__bqAdmin_framework_admin=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['framework_admin']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('framework_admin').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
const envManagerUrls = <?= json_encode([
    'retryInstall' => $this->getBackendUrl('weline_framework/backend/env-manager/retry-install'),
    'resetAll' => $this->getBackendUrl('weline_framework/backend/env-manager/reset-all'),
], $jsonForScriptFlags) ?>;
const envManagerMessages = <?= json_encode([
    'installing' => (string)__('安装中...'),
    'retryInstall' => (string)__('尝试安装'),
    'requestFailed' => (string)__('请求失败'),
    'resetConfirm' => (string)__('确定要重置所有安装记录吗？下次 env:install 将重新尝试所有推荐项。'),
    'confirmUnavailable' => (string)__('确认组件不可用，请刷新页面后重试'),
    'operationFailed' => (string)__('操作失败'),
], $jsonForScriptFlags) ?>;

function envManagerToast(type, message) {
    const text = String(message || envManagerMessages.operationFailed);
    if (window.Weline.UI.toast && typeof window.Weline.UI.toast[type] === 'function') {
        window.Weline.UI.toast[type](text);
        return;
    }

    const logger = type === 'error' ? 'error' : 'log';
    if (window.console && typeof window.console[logger] === 'function') {
        window.console[logger](text);
    }
}

function envManagerConfirm(message) {
    return Weline.UI.dialog.confirm(message);

    envManagerToast('error', envManagerMessages.confirmUnavailable);
    return Promise.resolve(false);
}

function setEnvButtonLabel(btn, iconClass, label) {
    btn.textContent = '';
    const icon = document.createElement('i');
    icon.className = iconClass;
    btn.appendChild(icon);
    btn.appendChild(document.createTextNode(' ' + label));
}

function retryInstall(type, name, btn) {
    btn.disabled = true;
    setEnvButtonLabel(btn, 'circle', envManagerMessages.installing);

    var retryOpts = { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest'}, body: 'type=' + encodeURIComponent(type) + '&name=' + encodeURIComponent(name) };
    bqAdmin['framework_admin'](envManagerUrls.retryInstall, retryOpts)
    .then(function(res) {
        var data = (res && res.data) !== undefined ? res.data : res;
        if (data.code === 200) {
            envManagerToast('success', data.msg);
        } else {
            envManagerToast('warning', data.msg);
        }
        setTimeout(() => location.reload(), 1500);
    })
    .catch(err => {
        envManagerToast('error', envManagerMessages.requestFailed + ': ' + err.message);
        btn.disabled = false;
        setEnvButtonLabel(btn, 'download', envManagerMessages.retryInstall);
    });
}

function resetAllStatuses() {
    envManagerConfirm(envManagerMessages.resetConfirm).then(function(confirmed) {
        if (!confirmed) {
            return;
        }

        var resetOpts = { method: 'POST', headers: {'X-Requested-With': 'XMLHttpRequest'} };
        bqAdmin['framework_admin'](envManagerUrls.resetAll, resetOpts)
        .then(function(res) {
            var data = (res && res.data) !== undefined ? res.data : res;
            envManagerToast('success', data.msg);
            setTimeout(() => location.reload(), 1000);
        })
        .catch(function(err) {
            envManagerToast('error', envManagerMessages.requestFailed + ': ' + err.message);
        });
    });
}

function toggleGuide(id) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('active');
}

function showGuideTab(btn, contentId) {
    const parent = btn.closest('td');
    parent.querySelectorAll('.guide-tab').forEach(t => t.classList.remove('active'));
    parent.querySelectorAll('.guide-content').forEach(c => c.style.display = 'none');
    btn.classList.add('active');
    const content = document.getElementById(contentId);
    if (content) content.style.display = '';
}

document.addEventListener('click', function(event) {
    const target = event.target;
    if (!(target instanceof Element)) {
        return;
    }

    const resetBtn = target.closest('[data-env-reset-all]');
    if (resetBtn) {
        event.preventDefault();
        resetAllStatuses();
        return;
    }

    const retryBtn = target.closest('[data-env-retry-install]');
    if (retryBtn) {
        event.preventDefault();
        retryInstall(retryBtn.dataset.envRetryType || '', retryBtn.dataset.envRetryName || '', retryBtn);
        return;
    }

    const guideToggle = target.closest('[data-env-guide-toggle]');
    if (guideToggle) {
        event.preventDefault();
        toggleGuide(guideToggle.dataset.envGuideTarget || '');
        return;
    }

    const guideTab = target.closest('[data-env-guide-tab]');
    if (guideTab) {
        event.preventDefault();
        showGuideTab(guideTab, guideTab.dataset.envGuideContent || '');
    }
});
</script>
