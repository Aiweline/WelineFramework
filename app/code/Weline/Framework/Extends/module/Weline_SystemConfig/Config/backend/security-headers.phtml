<w:config:group code="framework_security_headers" label="安全响应头" description="CSP/CORS Scope 覆盖只可收紧；Extends 应用默认强制放行且不可覆盖；保存前须 registerSecurityPolicyLkg。" sort="10">
    <w:config:hint type="warning" description="应用默认 CSP（Extends：extends/module/Weline_Framework/Security/Csp）强制放行，配置保存不可删除这些 source（security_policy_app_defaults_immutable）。配置中心会列出当前已收集的应用默认。" />
    <w:config:field
        key="security.headers.csp"
        label="Content-Security-Policy"
        description="留空继承 Env 安全默认；非空必须是 Global 基线子集，且必须保留 Extends 应用默认 source。后台需含 script-src/style-src 的 unsafe-inline。"
        type="textarea"
        value-type="string"
        default="connect-src 'self'; default-src 'self'; font-src 'self' data: https:; frame-src 'self'; img-src 'self' blob: data: https:; media-src 'self' blob: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
        scope="global,website,store,channel"
        validation="max:8000" />
    <w:config:field
        key="security.headers.csp_report_only"
        label="CSP Report-Only"
        description="默认留空（推荐）。仅观察期填写且应与强制 CSP 不同；与强制 CSP 相同时运行时会省略，避免响应头体积翻倍。"
        type="textarea"
        value-type="string"
        default=""
        scope="global,website,store,channel"
        validation="max:8000" />
    <w:config:field
        key="security.headers.csp_delivery"
        label="CSP 交付方式"
        description="meta=写入 HTML meta（默认，响应头不再带大 CSP）；header=传统 Content-Security-Policy 响应头。浏览器不支持从 URL 自动拉取并应用 CSP。"
        type="select"
        value-type="string"
        default="meta"
        options="meta:HTML meta,header:HTTP Header"
        scope="global"
        validation="in:meta,header" />
    <w:config:field
        key="security.headers.cors_origins"
        label="CORS Origin 白名单"
        description="空格分隔；留空=禁止跨域回显（安全默认）。Scope 只能缩小 Env Global 白名单。"
        type="textarea"
        value-type="string"
        default=""
        scope="global,website,store,channel"
        validation="max:4000" />
</w:config:group>
