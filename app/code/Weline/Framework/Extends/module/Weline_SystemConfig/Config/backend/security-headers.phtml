/**
 * @meta.title {default="安全响应头",description="按 Scope 收紧 CSP 与 CORS；激活前必须登记同 Scope 的 verified LKG。"}
 * @meta.description {default="Scope 配置只能比 Env Global 基线更严格。Extends 贡献的应用默认 CSP 强制放行且不可覆盖。"}
