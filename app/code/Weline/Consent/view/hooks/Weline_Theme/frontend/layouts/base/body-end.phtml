<?php
/**
 * Consent banner (TASK-P1D-004-CONSENT).
 *
 * Hook: Weline_Theme::frontend::layouts::base::body-end
 * @hook-priority 100
 * @hook-sort-order 60
 * @hook-solo false
 */
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<link rel="stylesheet"
      href="@static(Weline_Consent::css/consent-banner.css)&v=20260831-component-scope1"
      data-no-extract="true"
      data-weline-consent-banner="1">
<div id="weline-consent-banner"
     class="w-consent-banner"
     role="dialog"
     aria-live="polite"
     aria-label="<?= $esc((string)__('Cookie 同意')) ?>"
     hidden>
    <div class="w-consent-banner__inner">
        <p class="w-consent-banner__text">
            <?= $esc((string)__('我们使用 Cookie 以改善体验。您可以同意或稍后管理偏好。')) ?>
            <a class="w-consent-banner__link" href="@url{'cookie'}"><?= $esc((string)__('Cookie 政策')) ?></a>
        </p>
        <div class="w-consent-banner__actions">
            <button type="button"
                    class="w-consent-banner__btn w-consent-banner__btn--primary"
                    data-consent-accept><?= $esc((string)__('同意')) ?></button>
            <button type="button"
                    class="w-consent-banner__btn w-consent-banner__btn--secondary"
                    data-consent-dismiss><?= $esc((string)__('稍后')) ?></button>
        </div>
    </div>
</div>
<script>
(function () {
  var root = document.getElementById('weline-consent-banner');
  if (!root) return;
  function hide() { root.hidden = true; }
  function show() { root.hidden = false; }
  function runWithApi(run, done) {
    var failed = function () {
      root.setAttribute('data-consent-error', '1');
      show();
    };
    var resolveApi = function () {
      if (window.Weline && typeof Weline.load === 'function') {
        return Weline.load('api');
      }
      if (window.Weline && Weline.Api && Weline.Api.__fallback !== true && typeof Weline.Api.resource === 'function') {
        return Promise.resolve(Weline.Api);
      }
      return Promise.reject(new Error('Weline.Api unavailable'));
    };
    resolveApi().then(function (api) {
      // Stub Weline.Api.resource 是 async；真实 ApiModule.resource 是 sync。统一 await。
      return Promise.resolve(api.resource('consent')).then(run);
    }).then(done).catch(failed);
  }
  root.querySelector('[data-consent-dismiss]')?.addEventListener('click', hide);
  root.querySelector('[data-consent-accept]')?.addEventListener('click', function () {
    runWithApi(function (consent) {
      return consent.accept({
        categories: ['analytics', 'marketing']
      });
    }, function (result) {
      if (result && result.success === true && result.show_banner === false) {
        hide();
        return;
      }
      show();
    });
  });
  runWithApi(function (consent) {
    return consent.status({});
  }, function (result) {
    if (result && result.recording_enabled !== false && result.show_banner === true) {
      show();
      return;
    }
    hide();
  });
})();
</script>
