                        <tr>
                            <th><?= __('扩展目录') ?></th>
                            <td>
                                <code class="user-select-all">${escapeHtml(php_info.ext_dir)}</code>
                                <button class="w-button ms-2" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(php_info.ext_dir || ''))}" data-tone="neutral" data-variant="outline" data-size="sm">
