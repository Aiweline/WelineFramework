                                    <w:icon name="circle" size="sm"></w:icon>
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th><?= __('php.ini 配置文件') ?></th>
                            <td>
                                <code class="user-select-all">${escapeHtml(php_info.ini_path)}</code>
                                <button class="w-button ms-2" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(php_info.ini_path || ''))}" data-tone="neutral" data-variant="outline" data-size="sm">
