                            <i class="bi ${iconClass} me-2"></i>
                            ${escapeHtml(opt.name)}
                        </h5>
                        <span class="w-badge w-text" data-w-background="muted" data-tone="muted">${escapeHtml(opt.impact)}</span>
                    </div>
                </div>
                <div class="w-card__body">
                    <p class="lead">${escapeHtml(opt.description)}</p>
                    
                    <div class="w-grid" style="--w-mb:var(--weline-space-4);">
