                                ${escapeHtml(opt.performance?.with || '')}
                            </div>
                        </div>
                    </div>
                    
                    ${!isInstalled && opt.install?.steps ? renderInstallSteps(opt.install.steps, php_info) : ''}
                    ${isInstalled ? '<div class="w-alert" data-tone="success"><w:icon name="check" size="sm"></w:icon><?= __('此优化项已配置完成！') ?></div>' : ''}
                </div>
            </div>
        `;
    }
    
    // 重启服务器
    html += `
        <div class="w-card border-primary" id="restart" style="--w-mb:var(--weline-space-6);">
            <div class="w-card__header w-text" data-w-background="primary" data-tone="inverse">
                <h5 style="--w-mb:0;"><w:icon name="circle" size="sm"></w:icon><?= __('完成后重启服务器') ?></h5>
