    container.innerHTML = html;
}

function renderInstallSteps(steps, phpInfo) {
    let html = `<h6 style="--w-mt:var(--weline-space-6);--w-mb:var(--weline-space-4);"><w:icon name="list" size="sm"></w:icon><?= __('安装步骤') ?></h6><div class="installation-steps">`;
    
    for (const step of steps) {
        html += `<div class="step-card" data-w-border="border" data-w-radius="md" style="--w-mb:var(--weline-space-4);--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);">`;
        html += `<h6 class="w-text" data-tone="primary">${escapeHtml(step.title || '')}</h6>`;
        
        if (step.description) {
            html += `<p style="--w-mb:var(--weline-space-2);">${escapeHtml(step.description)}</p>`;
        }
        
        if (step.path) {
            html += `
                <div style="--w-mb:var(--weline-space-2);">
                    <strong><?= __('文件位置：') ?></strong>
                    <code class="user-select-all">${escapeHtml(step.path)}</code>
                    <button class="w-button" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(step.path || ''))}" data-tone="neutral" data-variant="outline" data-size="sm">
                        <w:icon name="circle" size="sm"></w:icon>
                    </button>
                </div>
            `;
        }
        
        if (step.content) {
            html += `
                <div style="--w-mb:var(--weline-space-2);">
                    <strong><?= __('添加内容：') ?></strong>
                    <pre class="w-text user-select-all" data-w-background="muted" data-w-radius="md" data-tone="muted" style="--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">${escapeHtml(step.content)}</pre>
                    <button class="w-button" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(step.content || ''))}" data-tone="primary" data-variant="outline" data-size="sm">
                        <w:icon name="circle" size="sm"></w:icon> <?= __('复制') ?>
                    </button>
                </div>
            `;
        }
        
        if (step.command) {
            html += `
                <div style="--w-mb:var(--weline-space-2);">
                    <strong><?= __('执行命令：') ?></strong>
                    <pre class="w-text user-select-all" data-w-background="muted" data-w-radius="md" data-tone="muted" style="--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">${escapeHtml(step.command)}</pre>
                    <button class="w-button" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(step.command || ''))}" data-tone="primary" data-variant="outline" data-size="sm">
                        <w:icon name="circle" size="sm"></w:icon> <?= __('复制') ?>
                    </button>
                </div>
            `;
        }
        
        if (step.commands) {
            html += `<div style="--w-mb:var(--weline-space-2);"><strong><?= __('选择您的系统：') ?></strong><div style="--w-mt:var(--weline-space-2);">`;
            for (const [os, cmd] of Object.entries(step.commands)) {
                html += `
                    <div style="--w-mb:var(--weline-space-2);">
                        <span class="w-badge me-2" data-w-background="info">${escapeHtml(os)}</span>
                        <code class="user-select-all">${escapeHtml(cmd)}</code>
                        <button class="w-button ms-2" data-guide-action="copy" data-copy-text="${encodeURIComponent(String(cmd || ''))}" data-tone="neutral" data-variant="outline" data-size="sm">
                            <w:icon name="circle" size="sm"></w:icon>
                        </button>
                    </div>
                `;
            }
            html += `</div></div>`;
        }
        
        if (step.url) {
            html += `
                <div style="--w-mb:var(--weline-space-2);">
                    <a href="${escapeHtml(step.url)}" target="_blank" class="w-button" data-tone="primary" data-size="sm">
                        <w:icon name="arrow-up" size="sm"></w:icon> <?= __('打开下载页面') ?>
                    </a>
                </div>
            `;
        }
        
        if (step.note) {
            html += `
                <div class="w-alert" data-tone="info" style="--w-mb:0;--w-mt:var(--weline-space-2);">
                    <w:icon name="info" size="sm"></w:icon>
                    ${escapeHtml(step.note)}
                </div>
            `;
        }
        
        html += `</div>`;
    }
    
    html += `</div>`;
    return html;
}

function escapeHtml(text) {
    if (text === null || text === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(text);
    return div.innerHTML;
}

function escapeJs(text) {
    if (text === null || text === undefined) return '';
    return String(text).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n');
}

function decodeCopyText(text) {
    try {
        return decodeURIComponent(text);
    } catch (error) {
        return text;
    }
}

function copyText(text) {
    navigator.clipboard.writeText(text).then(() => {
        Weline.UI.toast.success('<?= __('已复制到剪贴板') ?>');
    }).catch(() => {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        Weline.UI.toast.success('<?= __('已复制到剪贴板') ?>');
    });
}
</script>
