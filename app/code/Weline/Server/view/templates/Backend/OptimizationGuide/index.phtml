<script>
(function(g){
  if(g.__bqAdmin_server) return;
  g.__bqAdmin_server=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['server']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('server').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
const API_URL = '<?= $apiUrl ?>';

// 页面加载时获取数据
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('optimization-guide-container');
    if (container) {
        container.addEventListener('click', handleGuideClick);
    }
    loadGuideData();
});

function handleGuideClick(event) {
    const trigger = event.target.closest('[data-guide-action]');
    const container = document.getElementById('optimization-guide-container');
    if (!trigger || !container || !container.contains(trigger)) {
        return;
    }

    const action = trigger.dataset.guideAction;
    if (action === 'load') {
        loadGuideData();
        return;
    }
    if (action === 'copy') {
        copyText(decodeCopyText(trigger.dataset.copyText || ''));
    }
}

async function loadGuideData() {
    showLoading();
    
    try {
        const response = await bqAdmin['server'](API_URL, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin' // 携带 Cookie 进行后台认证
        });
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const data = await response.json();
        
        if (!data.success) {
            throw new Error(data.error || '<?= __('未知错误') ?>');
        }
        
        renderContent(data);
        showContent();
        
    } catch (error) {
        console.error('Failed to load optimization guide:', error);
        showError(error.message);
    }
}

function showLoading() {
    document.getElementById('loading-state').classList.remove('d-none');
    document.getElementById('error-state').classList.add('d-none');
    document.getElementById('content-container').classList.add('d-none');
}

function showError(message) {
    document.getElementById('loading-state').classList.add('d-none');
    document.getElementById('error-state').classList.remove('d-none');
    document.getElementById('content-container').classList.add('d-none');
    document.getElementById('error-message').textContent = message;
}

function showContent() {
    document.getElementById('loading-state').classList.add('d-none');
    document.getElementById('error-state').classList.add('d-none');
    document.getElementById('content-container').classList.remove('d-none');
}

function renderContent(data) {
    const container = document.getElementById('content-container');
    const { php_info, summary, is_windows } = data;
    
    let html = `
        <!-- 标题 -->
        <div class="guide-header" style="--w-mb:var(--weline-space-6);">
            <h2><w:icon name="circle" size="sm"></w:icon> <?= __('Weline Server 性能优化指南') ?></h2>
            <p class="w-text" data-tone="muted"><?= __('基于您当前的 PHP 环境自动生成的优化建议') ?></p>
            <p class="w-text guide-meta" data-size="sm">
                <span class="guide-badge guide-badge-time"><?= __('生成时间') ?>: ${new Date().toLocaleString()}</span>
                <span class="guide-badge guide-badge-platform"><?= __('操作系统') ?>: ${escapeHtml(php_info.os)} (${escapeHtml(php_info.arch)})</span>
                <span class="guide-badge guide-badge-local"><?= __('本地访问') ?> ✓</span>
            </p>
        </div>
        
        <!-- 环境信息 -->
        <div class="w-card" id="environment" style="--w-mb:var(--weline-space-6);">
            <div class="w-card__header w-text" data-w-background="primary" data-tone="inverse">
                <h5 style="--w-mb:0;"><w:icon name="settings" size="sm"></w:icon><?= __('您的 PHP 环境') ?></h5>
            </div>
            <div class="w-card__body">
                <div class="w-table-wrap">
                    <table class="w-table">
                        <tr>
                            <th width="30%"><?= __('PHP 版本') ?></th>
                            <td><code>${escapeHtml(php_info.version)}</code></td>
                        </tr>
                        <tr>
                            <th><?= __('PHP 可执行文件') ?></th>
