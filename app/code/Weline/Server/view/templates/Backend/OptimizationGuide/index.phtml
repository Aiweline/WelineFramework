                    <w:icon name="circle" size="sm"></w:icon> <?= __('复制命令') ?>
                </button>
                
                <hr>
                
                <h6><?= __('验证优化结果') ?></h6>
                <p><?= __('重启后可以运行压力测试查看性能提升：') ?></p>
