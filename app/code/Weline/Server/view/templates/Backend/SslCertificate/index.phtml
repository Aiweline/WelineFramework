iv> </div> </div> <div style="--w-span-md:3;"> <div class="w-card" data-w-border="none" data-w-shadow="sm"> <div class="w-card__body"> <div class="w-cluster" data-align="center"> <div class="" data-shrink="false" data-w-background="warning" data-w-radius="md" style="--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);"> <w:icon name="warning" size="sm"></w:icon> </div> <div class="" data-grow="true"> <h3 style="--w-mb:0;"><?= $stats['expiring_soon'] ?? 0 ?></h3> <small class="w-text" data-tone="muted"><?= __('即将过期') ?></small> </div> </div> </div> </div> </div> <div style="--w-span-md:3;"> <div class="w-card" data-w-border="none" data-w-shadow="sm"> <div class="w-card__body"> <div class="w-cluster" data-align="center"> <div class="" data-shrink="false" data-w-background="danger" data-w-radius="md" style="--w-pt:var(--weline-space-4);--w-pe:var(--weline-space-4);--w-pb:var(--weline-space-4);--w-ps:var(--weline-space-4);"> <w:icon name="circle" size="sm"></w:icon> </div> <div class="" data-grow="true"> <h3 style="--w-mb:0;"><?= $stats['expired'] ?? 0 ?></h3> <small class="w-text" data-tone="muted"><?= __('已过期') ?></small> </div> </div> </div> </div> </div> </div> <!-- 批量操作工具栏 --> <div id="sslCertBatchBar" class="ssl-cert-batch-bar" style="display:none;"> <div class="w-cluster" data-align="center" data-wrap="true" style="--w-gap:var(--weline-space-4);"> <span class="ssl-cert-batch-count"> <?= __('已选择') ?> <strong id="sslCertSelectedCount">0</strong> <?= __('项') ?> </span> <button type="button" class="w-button" data-ssl-action="batch-renew" data-tone="primary" data-variant="outline" data-size="sm"> <w:icon name="circle" size="sm"></w:icon><?= __('批量续签') ?> </button> <button type="button" class="w-button" data-ssl-action="batch-delete" data-tone="danger" data-variant="outline" data-size="sm"> <w:icon name="trash" size="sm"></w:icon><?= __('批量删除') ?> </button> <button type="button" class="w-button" data-ssl-action="clear-selection" data-tone="neutral" data-variant="outline" data-size="sm"> <w:icon name="circle" size="sm"></w:icon><?= __('取消选择') ?> </button> </div> </div> <!-- 证书列表 --> <div class="w-card" data-w-border="none" data-w-shadow="sm"> <div class="w-card__header"> <h5 style="--w-mb:0;"><?= __('证书列表') ?></h5> </div> <div class="w-card__body" style="--w-pt:0;--w-pe:0;--w-pb:0;--w-ps:0;"> <?php if (empty($certificates)): ?> <div class="w-text" data-align="center" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);"> <w:icon name="box" size="sm"></w:icon> <p class="w-text" data-tone="muted" style="--w-mt:var(--weline-space-2);"><?= __('暂无证书记录') ?></p> <p class="w-text" data-tone="muted" data-size="sm"><?= __('点击"申请证书"开始为您的域名申请 SSL 证书') ?></p> </div> <?php else: ?> <div class="w-table-wrap"> <table class="w-table" id="sslCertTable" style="--w-mb:0;"> <thead> <tr> <th style="width:40px;"> <input type="checkbox" id="sslCertSelectAll" data-ssl-change="toggle-all"> </th> <th><?= __('域名') ?></th> <th><?= __('状态') ?></th> <th><?= __('HTTPS') ?></th> <th><?= __('强制HTTPS') ?></th> <th><?= __('根域→www') ?></th> <th><?= __('到期时间') ?></th> <th><?= __('颁发机构') ?></th> <th><?= __('服务商') ?></th> <th class="w-text" data-align="end"><?= __('操作') ?></th> </tr> </thead> <tbody> <?php foreach ($certificates as $cert): ?> <?php $domain = $cert[\Weline\Server\Model\SslCertificate::schema_fields_DOMAIN]; $status = $cert[\Weline\Server\Model\SslCertificate::schema_fields_STATUS]; $httpsEnabled = $cert[\Weline\Server\Model\SslCertificate::schema_fields_HTTPS_ENABLED]; $expiresAt = $cert[\Weline\Server\Model\SslCertificate::schema_fields_EXPIRES_AT]; $issuer = $cert[\Weline\Server\Model\SslCertificate::schema_fields_ISSUER]; $provider = $cert[\Weline\Server\Model\SslCertificate::schema_fields_PROVIDER] ?? ''; $autoRenew = $cert[\Weline\Server\Model\SslCertificate::schema_fields_AUTO_RENEW]; $certId = (int) ($cert[\Weline\Server\Model\SslCertificate::schema_fields_ID] ?? 0); $forceHttps = (int) ($cert[\Weline\Server\Model\SslCertificate::schema_fields_FORCE_HTTPS] ?? 1); $forceRootToWww = (int) ($cert[\Weline\Server\Model\SslCertificate::schema_fields_FORCE_ROOT_TO_WWW] ?? 0); $expiryStatus = $cert['_expiry_status'] ?? 'unknown'; $daysLeft = $cert['_days_left'] ?? null; $isProtectedDomain = \in_array(\strtolower($domain), ['localhost', '127.0.0.1', '::1', '0.0.0.0'], true); $domainAttr = htmlspecialchars($domain, ENT_QUOTES, 'UTF-8'); $statusBadge = match ($status) { 'active' => 'bg-success', 'expired' => 'bg-danger', 'pending' => 'bg-warning', 'error' => 'bg-danger', default => '', }; $statusText = match ($status) { 'active' => __('有效'), 'expired' => __('已过期'), 'pending' => __('待申请'), 'error' => __('错误'), default => $status, }; ?> <tr> <td> <input class="ssl-cert-row-check" type="checkbox" data-domain="<?= $domainAttr ?>" data-protected="<?= $isProtectedDomain ? '1' : '0' ?>" data-ssl-change="update-selection"> </td> <td> <strong><?= htmlspecialchars($domain) ?></strong> <?php if ($isProtectedDomain): ?> <span class="w-badge" style="font-size:0.65em;" data-w-background="muted"><?= __('本地') ?></span> <?php endif; ?> </td> <td> <span class="w-badge <?= $statusBadge ?>"><?= $statusText ?></span> </td> <td> <div class="w-switch"> <input type="checkbox" id="https_<?= md5($domain) ?>" <?= $httpsEnabled ? 'checked' : '' ?> <?= $status !== 'active' ? 'disabled' : '' ?> data-ssl-change="toggle-https" data-domain="<?= $domainAttr ?>"> </div> </td> <td> <div class="w-switch"> <input type="checkbox" id="force_https_<?= $certId ?>" <?= $forceHttps ? 'checked' : '' ?> <?= $status !== 'active' ? 'disabled' : '' ?> data-ssl-change="update-policy" data-cert-id="<?= $certId ?>" data-field="force_https"> </div> </td> <td> <div class="w-switch"> <input type="checkbox" id="force_www_<?= $certId ?>" <?= $forceRootToWww ? 'checked' : '' ?> <?= $status !== 'active' ? 'disabled' : '' ?> data-ssl-change="update-policy" data-cert-id="<?= $certId ?>" data-field="force_root_to_www"> </div> </td> <td> <?php if ($expiresAt): ?> <span class="<?= $expiryStatus === 'expired' ? 'text-danger' : ($expiryStatus === 'warning' ? 'w-text' : '') ?>"> <?= $expiresAt ?> </span> <?php if ($daysLeft !== null): ?> <br> <small class="w-text" data-tone="muted"> <?= $daysLeft > 0 ? __('剩余 %{1} 天', [$daysLeft]) : __('已过期') ?> </small> <?php endif; ?> <?php else: ?> <span class="w-text" data-tone="muted">-</span> <?php endif; ?> </td> <td><?= htmlspecialchars($issuer ?: '-') ?></td> <td> <?php $providerLabel = match ($provider) { 'letsencrypt' => "Let's Encrypt", 'litessl' => 'LiteSSL', 'self_signed' => __('自签证书'), default => $provider ?: '-', }; ?> <?= htmlspecialchars($providerLabel) ?> </td> <td class="w-text" data-align="end"> <div class="w-button-group"> <?php if ($status === 'pending' || $status === 'error'): ?> <button type="button" class="w-button" data-ssl-action="request-certificate" data-domain="<?= $domainAttr ?>" data-tone="primary" data-variant="outline"> <w:icon name="download" size="sm"></w:icon> <?= __('申请') ?> </button> <?php else: ?> <button type="button" class="w-button" data-ssl-action="renew-certificate" data-domain="<?= $domainAttr ?>" data-tone="primary" data-variant="outline"> <w:icon name="circle" size="sm"></w:icon> <?= __('续签') ?> </button> <?php endif; ?> <button type="button" class="w-button w-button<?= $isProtectedDomain ? ' disabled' : '' ?>" title="<?= $isProtectedDomain ? __('本地域名证书不允许删除') : __('删除') ?>" <?= $isProtectedDomain ? 'disabled' : '' ?> <?php if (!$isProtectedDomain): ?> data-ssl-action="delete-certificate" data-domain="<?= $domainAttr ?>" <?php endif; ?>> <w:icon name="trash" size="sm"></w:icon><?= __('删除') ?> </button> </div> </td> </tr> <?php endforeach; ?> </tbody> </table> </div> <?php endif; ?> </div> </div> <!-- 帮助说明 --> <div class="w-card" data-w-border="none" data-w-shadow="sm" style="--w-mt:var(--weline-space-6);"> <div class="w-card__header"> <h5 style="--w-mb:0;"><w:icon name="info" size="sm">