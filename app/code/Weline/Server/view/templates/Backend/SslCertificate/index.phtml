(function() { 'use strict'; var baseUrl = '<?= $this->getBackendUrl('*/backend/ssl-certificate/') ?>'; document.addEventListener('click', function(event) { var trigger = event.target.closest('[data-ssl-action]'); if (!trigger) return; var action = trigger.getAttribute('data-ssl-action'); if (action === 'sync-domains') { window.syncDomains(); return; } if (action === 'batch-renew') { SslCertBatch.batchRenew(); return; } if (action === 'batch-delete') { SslCertBatch.batchDelete(); return; } if (action === 'clear-selection') { SslCertBatch.clearSelection(); return; } if (action === 'request-certificate') { window.requestCertificate(trigger.getAttribute('data-domain') || ''); return; } if (action === 'renew-certificate') { window.renewCertificate(trigger.getAttribute('data-domain') || ''); return; } if (action === 'delete-certificate') { window.deleteCertificate(trigger.getAttribute('data-domain') || ''); return; } if (action === 'submit-request') { window.submitRequest(); } }); document.addEventListener('change', function(event) { var target = event.target; var action = target.getAttribute('data-ssl-change'); if (!action) return; if (action === 'toggle-all') { SslCertBatch.toggleAll(target.checked); return; } if (action === 'update-selection') { SslCertBatch.updateSelection(); return; } if (action === 'toggle-https') { window.toggleHttps(target.getAttribute('data-domain') || '', target.checked); return; } if (action === 'update-policy') { window.updateCertPolicy(Number(target.getAttribute('data-cert-id') || 0), target.getAttribute('data-field') || '', target.checked); } }); function getSelectedProvider() { var select = document.querySelector('#requestForm select[name="provider"]'); return select ? select.value : 'letsencrypt'; } function hideRequestModal() { var modalEl = document.getElementById('requestModal'); if (!modalEl) return; Weline.UI.dialog.close(modalEl, 'action'); } window.toggleHttps = async function(domain, enabled) { try { var response = await Weline.adminRequest('server', baseUrl + 'toggle-https', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'domain=' + encodeURIComponent(domain) + '&enabled=' + (enabled ? 1 : 0) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); if (enabled) { Weline.UI.toast.warning('<?= __('请重启服务器使配置生效') ?>'); } } else { Weline.UI.toast.error(result.message); var el = document.getElementById('https_' + btoa(domain).replace(/[^a-zA-Z0-9]/g, '')); if (el) el.checked = !enabled; } } catch (e) { Weline.UI.toast.error(e.message); } }; window.updateCertPolicy = async function(certId, field, enabled) { try { var response = await Weline.adminRequest('server', baseUrl + 'update-policy', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'cert_id=' + certId + '&field=' + encodeURIComponent(field) + '&value=' + (enabled ? 1 : 0) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); Weline.UI.toast.warning('<?= __('请重启或热重载服务器使策略生效') ?>'); } else { Weline.UI.toast.error(result.message); var el = document.getElementById(field === 'force_https' ? 'force_https_' + certId : 'force_www_' + certId); if (el) el.checked = !enabled; } } catch (e) { Weline.UI.toast.error(e.message); } }; window.requestCertificate = async function(domain) { Weline.UI.dialog.confirm('<?= __('确定要为此域名申请证书吗？') ?>').then(function(confirmed) { if (!confirmed) return; Weline.UI.dialog.request({ title: '<?= __('请输入联系邮箱') ?>', cancelable: true, field: {type: 'email', value: 'admin@' + domain, required: true} }).then(async function(promptResult) { if (!promptResult.confirmed) return; var email = promptResult.value; if (!email) return; var provider = getSelectedProvider(); Weline.UI.toast.info('<?= __('正在申请证书，请稍候...') ?>'); try { var response = await Weline.adminRequest('server', baseUrl + 'request', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'domain=' + encodeURIComponent(domain) + '&email=' + encodeURIComponent(email) + '&provider=' + encodeURIComponent(provider) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }); }); }; window.renewCertificate = async function(domain) { Weline.UI.dialog.confirm('<?= __('确定要续签此证书吗？') ?>').then(async function(confirmed) { if (!confirmed) return; Weline.UI.toast.info('<?= __('正在续签证书，请稍候...') ?>'); try { var response = await Weline.adminRequest('server', baseUrl + 'renew', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'domain=' + encodeURIComponent(domain) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }); }; window.deleteCertificate = async function(domain) { Weline.UI.dialog.confirm('<?= __('确定要删除此证书吗？此操作不可恢复！') ?>').then(async function(confirmed) { if (!confirmed) return; try { var response = await Weline.adminRequest('server', baseUrl + 'delete', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'domain=' + encodeURIComponent(domain) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }); }; window.syncDomains = function() { Weline.UI.dialog.request({ title: '<?= __('请输入联系邮箱（用于申请证书）') ?>', cancelable: true, field: {type: 'email', value: 'admin@localhost', required: true} }).then(async function(promptResult) { if (!promptResult.confirmed) return; var email = promptResult.value; if (!email) return; try { var response = await Weline.adminRequest('server', baseUrl + 'sync', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'email=' + encodeURIComponent(email) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }); }; window.submitRequest = async function() { var form = document.getElementById('requestForm'); var formData = new FormData(form); Weline.UI.toast.info('<?= __('正在申请证书，请稍候...') ?>'); try { var response = await Weline.adminRequest('server', baseUrl + 'request', { method: 'POST', body: new URLSearchParams(formData) }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); hideRequestModal(); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }; // --- 批量操作 --- var batchBar = document.getElementById('sslCertBatchBar'); var countEl = document.getElementById('sslCertSelectedCount'); var selectAllEl = document.getElementById('sslCertSelectAll'); function getCheckedDomains(opts) { var checkboxes = document.querySelectorAll('.ssl-cert-row-check:checked'); var domains = []; checkboxes.forEach(function(cb) { if (opts && opts.skipProtected && cb.getAttribute('data-protected') === '1') { return; } domains.push(cb.getAttribute('data-domain')); }); return domains; } function getAllCheckedDomains() { var checkboxes = document.querySelectorAll('.ssl-cert-row-check:checked'); var domains = []; checkboxes.forEach(function(cb) { domains.push(cb.getAttribute('data-domain')); }); return domains; } function updateBatchBar() { var all = getAllCheckedDomains(); var count = all.length; if (countEl) { countEl.textContent = count; } if (batchBar) { batchBar.style.display = count > 0 ? '' : 'none'; } var allBoxes = document.querySelectorAll('.ssl-cert-row-check'); if (selectAllEl) { selectAllEl.checked = allBoxes.length > 0 && count === allBoxes.length; selectAllEl.indeterminate = count > 0 && count < allBoxes.length; } } var SslCertBatch = {}; SslCertBatch.toggleAll = function(checked) { document.querySelectorAll('.ssl-cert-row-check').forEach(function(cb) { cb.checked = checked; }); updateBatchBar(); }; SslCertBatch.updateSelection = function() { updateBatchBar(); }; SslCertBatch.clearSelection = function() { document.querySelectorAll('.ssl-cert-row-check').forEach(function(cb) { cb.checked = false; }); if (selectAllEl) { selectAllEl.checked = false; selectAllEl.indeterminate = false; } updateBatchBar(); }; SslCertBatch.batchDelete = function() { var domains = getCheckedDomains({skipProtected: true}); var allSelected = getAllCheckedDomains(); var protectedCount = allSelected.length - domains.length; if (domains.length === 0) { if (protectedCount > 0) { Weline.UI.toast.warning('<?= __('所选证书均为本地域名证书，不允许删除') ?>'); } else { Weline.UI.toast.warning('<?= __('请先选择要删除的证书') ?>'); } return; } var msg = '<?= __('确定要删除选中的 ') ?>' + domains.length + ' <?= __(' 个证书吗？此操作不可恢复！') ?>'; if (protectedCount > 0) { msg += '\n<?= __('（本地域名证书将被自动跳过）') ?>'; } Weline.UI.dialog.confirm(msg).then(async function(confirmed) { if (!confirmed) return; Weline.UI.toast.info('<?= __('正在批量删除，请稍候...') ?>'); try { var body = new URLSearchParams(); domains.forEach(function(d) { body.append('domains[]', d); }); var response = await Weline.adminRequest('server', baseUrl + 'batch-delete', { method: 'POST', body: body }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); setTimeout(function() { location.reload(); }, 1500); } else { Weline.UI.toast.error(result.message); } } catch (e) { Weline.UI.toast.error(e.message); } }); }; SslCertBatch.batchRenew = function() { var domains = getAllCheckedDomains(); if (domains.length === 0) { Weline.UI.toast.warning('<?= __('请先选择要续签的证书') ?>'); return; } Weline.UI.dialog.confirm('<?= __('确定要批量续签选中的 ') ?>' + domains.length + ' <?= __(' 个证书吗？') ?>').then(async function(confirmed) { if (!confirmed) return; Weline.UI.toast.info('<?= __('正在批量续签，请稍候...') ?>'); try { var body = new URLSearchParams(); domains.forEach(function(d) { body.append('domains[]', d); }); var response = await Weline.adminRequest('server', baseUrl + 'batch-renew', { method: 'POST', body: body }); var result = await response.json(); if (result.success) { Weline.UI.toast.success(result.message); } else { Weline.UI.toast.warning(result.message); } if (result.errors && result.errors.length > 0) { result.errors.forEach(function(err) { Weline.UI.toast.error(err); }); } setTimeout(function() { location.reload(); }, 2000); } catch (e) { Weline.UI.toast.error(e.message); } }); }; window.SslCertBatch = SslCertBatch;
})();
