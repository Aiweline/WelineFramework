                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- PHP 环境信息 -->
        <div class="w-card" style="--w-mb:var(--weline-space-6);">
            <div class="w-card__header">
                <h5 style="--w-mb:0;">
                    <w:icon name="info" size="sm"></w:icon>
