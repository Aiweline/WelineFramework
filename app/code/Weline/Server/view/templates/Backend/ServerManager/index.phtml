async function gcSessionStore() {
    const promptResult = await Weline.UI.dialog.request({
        title: '<?= __('Session 垃圾回收') ?>',
        message: '<?= __('请输入最大存活秒数（默认 3600）') ?>',
        cancelable: true,
        field: {type: 'number', placeholder: '3600', value: '3600', required: true}
    });
    if (!promptResult.confirmed) return;
    const input = promptResult.value;
    const maxLifetime = Number(input || 3600);
    try {
        const data = await bqAdmin[\'server\'](SESSION_GC_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'max_lifetime=' + encodeURIComponent(maxLifetime),
            credentials: 'same-origin'
        });
        if (data.success) {
            Weline.UI.toast.success(data.message || '<?= __('Session GC 执行成功') ?>');
            loadSessionList();
            loadServerData();
        } else {
            Weline.UI.toast.warning(data.message || '<?= __('Session GC 执行失败') ?>');
        }
    } catch (error) {
        Weline.UI.toast.error('<?= __('Session GC 执行失败') ?>: ' + error.message);
    }
}

