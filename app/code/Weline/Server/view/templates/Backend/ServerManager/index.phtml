function escapeHtml(text) {
    if (text === null || text === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(text);
    return div.innerHTML;
}

function formatBytes(bytes) {
    const value = Number(bytes || 0);
    if (value >= 1073741824) return (value / 1073741824).toFixed(2) + ' GB';
    if (value >= 1048576) return (value / 1048576).toFixed(2) + ' MB';
    if (value >= 1024) return (value / 1024).toFixed(2) + ' KB';
    return value + ' B';
}

function scrollToSharedState() {
    const title = document.querySelector('#content-container .card .bi-database-gear');
    if (!title) {
        return;
    }
    const card = title.closest('.card');
    if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

async function loadSessionList() {
    const body = document.getElementById('session-list-body');
    if (!body) return;
    body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('加载中...') ?></td></tr>`;
    try {
        const data = await bqAdmin[\'server\'](SESSION_LIST_API_URL + '?limit=50', {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        });
        if (!data.success) {
            throw new Error(data.message || '<?= __('加载失败') ?>');
        }
        const rows = Array.isArray(data.data) ? data.data : [];
        if (!rows.length) {
            body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('暂无 Session 数据') ?></td></tr>`;
            return;
        }
        body.innerHTML = rows.map(row => {
            const sessionId = String(row.session_id || '');
            const previewHtml = renderSessionPreview(row.preview);
            return `
                <tr>
                    <td><code class="w-text" style="max-width: 140px;" title="${escapeHtml(sessionId)}" data-w-text-wrap="break" data-size="sm">${escapeHtml(sessionId.length > 16 ? sessionId.substring(0, 16) + '…' : sessionId)}</code></td>
                    <td><span class="w-badge" data-w-background="muted">${Number(row.data_count || 0)}</span></td>
                    <td class="weline-session-preview-cell">${previewHtml}</td>
                    <td>
                        <button class="w-button me-1" data-server-manager-action="show-session-detail" data-session-id="${encodeURIComponent(sessionId)}" title="<?= __('查看全部字段') ?>" data-tone="primary" data-variant="outline" data-size="sm">
                            <w:icon name="list" size="sm"></w:icon> <?= __('查看详情') ?>
                        </button>
                        <button class="w-button" data-server-manager-action="destroy-session" data-session-id="${encodeURIComponent(sessionId)}" data-tone="danger" data-variant="outline" data-size="sm">
                            <w:icon name="trash" size="sm"></w:icon> <?= __('销毁') ?>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    } catch (error) {
        body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="danger">${escapeHtml(error.message || '<?= __('加载失败') ?>')}</td></tr>`;
    }
}

async function showSessionDetail(encodedSessionId) {
    const sessionId = decodeURIComponent(encodedSessionId);
    const offcanvasEl = document.getElementById('sessionDetailOffcanvas');
    const loadingEl = document.getElementById('session-detail-loading');
    const contentEl = document.getElementById('session-detail-content');
    const emptyEl = document.getElementById('session-detail-empty');
    const idEl = document.getElementById('session-detail-id');
    const bodyEl = document.getElementById('session-detail-body');
    if (!offcanvasEl || !bodyEl) return;
    if (typeof bootstrap === 'undefined' || !bootstrap.Offcanvas) return;

    let bsOffcanvas;
    if (typeof bootstrap.Offcanvas.getOrCreateInstance === 'function') {
        bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
    } else {
        bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl) || new bootstrap.Offcanvas(offcanvasEl);
    }
    bsOffcanvas.show();
    loadingEl.classList.remove('d-none');
    contentEl.classList.add('d-none');
    emptyEl.classList.add('d-none');
    idEl.textContent = sessionId;

    try {
        const data = await bqAdmin[\'server\'](SESSION_DETAIL_API_URL + '?session_id=' + encodeURIComponent(sessionId), {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        });
        loadingEl.classList.add('d-none');
        if (!data.success || !Array.isArray(data.data) || !data.data.length) {
            emptyEl.classList.remove('d-none');
            return;
        }
        bodyEl.innerHTML = data.data.map(row => {
            const key = escapeHtml(String(row.key || ''));
            const type = escapeHtml(String(row.type || ''));
            const valueHtml = renderSessionDetailValue(row);
            return `<tr><td><code class="w-text" data-size="sm">${key}</code></td><td><span class="w-badge" data-w-background="muted">${type}</span></td><td class="w-text" data-size="sm">${valueHtml}</td></tr>`;
        }).join('');
        contentEl.classList.remove('d-none');
    } catch (error) {
        loadingEl.classList.add('d-none');
        emptyEl.textContent = '<?= __('加载失败：') ?>' + escapeHtml(error.message);
        emptyEl.classList.remove('d-none');
    }
}

function renderSessionDetailValue(row) {
    const detail = row && row.preview_detail && typeof row.preview_detail === 'object' ? row.preview_detail : null;
    const fallback = escapeHtml(row && row.preview ? String(row.preview) : '-');
    if (!detail) return `<span class="w-text" data-tone="muted">${fallback}</span>`;
    const kind = String(detail.kind || '');
    const display = escapeHtml(detail.display || row.preview || '');
    const size = Number(detail.size || 0);
    const json = typeof detail.json === 'string' ? detail.json.trim() : '';
    if ((kind === 'array' || kind === 'object') && json) {
        return `<details style="--w-mt:var(--weline-space-1);"><summary><span class="w-badge" data-w-background="info">${display}</span><span class="w-text ms-1" data-tone="muted">(${Number.isFinite(size) ? size : 0} <?= __('项') ?>)</span></summary><pre class="w-text bg-body-tertiary" style="white-space:pre-wrap; word-break:break-word;" data-w-border="border" data-w-radius="md" data-size="sm">${escapeHtml(json)}</pre></details>`;
    }
    if (kind === 'null') return '<span class="w-badge" data-w-background="muted">null</span>';
    return `<span data-w-text-wrap="break">${display}</span>`;
}

async function destroySession(encodedSessionId) {
    const sessionId = decodeURIComponent(encodedSessionId);
    const confirmed = await Weline.UI.dialog.confirm('<?= __('确认销毁该 Session 吗？此操作会让对应用户立即失效。') ?>', {
        title: '<?= __('销毁 Session') ?>',
        tone: 'warning',
        confirmLabel: '<?= __('确认销毁') ?>',
        cancelLabel: '<?= __('取消') ?>'
    });
    if (!confirmed) return;
    try {
        const data = await bqAdmin[\'server\'](SESSION_DESTROY_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'session_id=' + encodeURIComponent(sessionId),
            credentials: 'same-origin'
        });
        if (data.success) {
            Weline.UI.toast.success(data.message || '<?= __('Session 已销毁') ?>');
            loadSessionList();
            loadServerData();
        } else {
            Weline.UI.toast.warning(data.message || '<?= __('操作失败') ?>');
        }
    } catch (error) {
        Weline.UI.toast.error('<?= __('销毁失败') ?>: ' + error.message);
    }
}

async function persistSessionStore() {
    try {
