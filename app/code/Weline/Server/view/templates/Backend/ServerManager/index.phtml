async function toggleMaintenance(instance, enabled) {
    const apiUrl = enabled ? MAINTENANCE_ENABLE_API_URL : MAINTENANCE_DISABLE_API_URL;
    const actionText = enabled ? '<?= __('启用维护模式') ?>' : '<?= __('禁用维护模式') ?>';
    const confirmed = await Weline.UI.dialog.confirm('<?= __('确认执行该操作吗？此操作会影响流量接入状态。') ?>', {
        title: actionText,
        tone: enabled ? 'warning' : 'info',
        confirmLabel: '<?= __('确认') ?>',
        cancelLabel: '<?= __('取消') ?>'
    });
    if (!confirmed) {
        return;
    }

    Weline.UI.toast.info(actionText + '...');
    try {
        const data = await bqAdmin[\'server\'](apiUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'instance=' + encodeURIComponent(instance),
            credentials: 'same-origin'
        });
        if (data.success) {
            Weline.UI.toast.success(data.message || actionText + '<?= __('成功') ?>');
        } else {
            Weline.UI.toast.warning(data.message || actionText + '<?= __('失败') ?>');
        }
        setTimeout(loadServerData, 1000);
    } catch (error) {
        Weline.UI.toast.error(actionText + '<?= __('失败：请检查网络连接后重试。') ?> ' + error.message);
    }
}

function startNewServer() {
    Weline.UI.dialog.request({
        title: '<?= __('启动新实例') ?>',
        message: '<?= __('请输入 Worker 数量（留空将使用默认值）') ?>',
        cancelable: true,
        field: {type: 'number', placeholder: '<?= __('例如：4') ?>', value: ''}
    }).then(result => {
        if (!result.confirmed) {
            return;
        }
        const workers = result.value;
        Weline.UI.toast.info('<?= __('正在启动新实例...') ?>');

        const body = 'instance=default' + (workers ? '&workers=' + encodeURIComponent(workers) : '');

        bqAdmin['server'](START_API_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body,
            credentials: 'same-origin'
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Weline.UI.toast.success(data.message || '<?= __('启动成功') ?>');
                } else {
                    Weline.UI.toast.warning(data.message || '<?= __('启动命令已发送，请稍后刷新状态。') ?>');
                }
                setTimeout(loadServerData, 1000);
            })
            .catch(error => {
                Weline.UI.toast.error('<?= __('启动失败：请检查网络连接后重试。') ?> ' + error.message);
            });
    });
}
