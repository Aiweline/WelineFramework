<script>
(function(g){
  if(g.__bqAdmin_server) return;
  g.__bqAdmin_server=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['server']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('server').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
const STATUS_API_URL = '<?= $statusApiUrl ?>';
const START_API_URL = '<?= $startApiUrl ?>';
const STOP_API_URL = '<?= $stopApiUrl ?>';
const RESTART_API_URL = '<?= $restartApiUrl ?>';
const RELOAD_API_URL = '<?= $reloadApiUrl ?>';
const MAINTENANCE_ENABLE_API_URL = '<?= $maintenanceEnableApiUrl ?>';
const MAINTENANCE_DISABLE_API_URL = '<?= $maintenanceDisableApiUrl ?>';
const SESSION_LIST_API_URL = '<?= $sessionListApiUrl ?>';
const SESSION_DETAIL_API_URL = '<?= $sessionDetailApiUrl ?>';
const SESSION_DESTROY_API_URL = '<?= $sessionDestroyApiUrl ?>';
const SESSION_PERSIST_API_URL = '<?= $sessionPersistApiUrl ?>';
const SESSION_GC_API_URL = '<?= $sessionGcApiUrl ?>';
const MEMORY_NAMESPACES_API_URL = '<?= $memoryNamespacesApiUrl ?>';
const MEMORY_NAMESPACE_DETAIL_API_URL = '<?= $memoryNamespaceDetailApiUrl ?>';
const MEMORY_NAMESPACE_CLEAR_API_URL = '<?= $memoryNamespaceClearApiUrl ?>';
const MEMORY_KEY_DELETE_API_URL = '<?= $memoryKeyDeleteApiUrl ?>';
const MEMORY_PERSIST_API_URL = '<?= $memoryPersistApiUrl ?>';
const MEMORY_GC_API_URL = '<?= $memoryGcApiUrl ?>';
const DEFAULT_TAB = '<?= $defaultTab ?>';
const GUIDE_URL = '<?= $guideUrl ?>';

let refreshInterval = null;

document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('server-manager-container');
    if (container) {
        container.addEventListener('click', handleServerManagerClick);
    }
    loadServerData();
    // 每 30 秒自动刷新
    refreshInterval = setInterval(loadServerData, 30000);
});

function handleServerManagerClick(event) {
    const trigger = event.target.closest('[data-server-manager-action]');
    const container = document.getElementById('server-manager-container');
    if (!trigger || !container || !container.contains(trigger)) {
        return;
    }

    const action = trigger.dataset.serverManagerAction;
    if (action === 'load-server-data') {
        loadServerData();
        return;
    }
    if (action === 'start-new-server') {
        startNewServer();
        return;
    }
    if (action === 'start-server') {
        startServer(trigger.dataset.instance || '');
        return;
    }
    if (action === 'restart-server') {
        restartServer(trigger.dataset.instance || '');
        return;
    }
    if (action === 'reload-server') {
        reloadServer(trigger.dataset.instance || '');
        return;
    }
    if (action === 'stop-server') {
        stopServer(trigger.dataset.instance || '');
        return;
    }
    if (action === 'toggle-maintenance') {
        toggleMaintenance(trigger.dataset.instance || '', trigger.dataset.enabled === '1');
        return;
    }
    if (action === 'load-session-list') {
        loadSessionList();
        return;
    }
    if (action === 'persist-session-store') {
        persistSessionStore();
        return;
    }
    if (action === 'gc-session-store') {
        gcSessionStore();
        return;
    }
    if (action === 'show-session-detail') {
        showSessionDetail(trigger.dataset.sessionId || '');
        return;
    }
    if (action === 'destroy-session') {
        destroySession(trigger.dataset.sessionId || '');
        return;
    }
    if (action === 'load-memory-namespaces') {
        loadMemoryNamespaces();
        return;
    }
    if (action === 'persist-memory-store') {
        persistMemoryStore();
        return;
    }
    if (action === 'gc-memory-store') {
        gcMemoryStore();
        return;
    }
    if (action === 'load-memory-namespace-detail') {
        loadMemoryNamespaceDetail(trigger.dataset.namespace || '');
        return;
    }
    if (action === 'clear-memory-namespace') {
        clearMemoryNamespace(trigger.dataset.namespace || '');
        return;
    }
    if (action === 'delete-memory-key') {
        deleteMemoryKey(trigger.dataset.namespace || '', trigger.dataset.key || '');
    }
}

async function loadServerData() {
    try {
        const response = await bqAdmin['server'](STATUS_API_URL, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
        });
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        
        const data = await response.json();
        
        if (!data.success) {
            throw new Error(data.error || '<?= __('未知错误') ?>');
        }
        
        renderContent(data);
        showContent();
        loadSessionList();
        loadMemoryNamespaces();
        if (DEFAULT_TAB === 'session') {
            scrollToSharedState();
        }
        if (DEFAULT_TAB === 'memory') {
            scrollToSharedState();
        }
        
    } catch (error) {
        console.error('Failed to load server data:', error);
        showError(error.message);
    }
}

function showLoading() {
    document.getElementById('loading-state').classList.remove('d-none');
    document.getElementById('error-state').classList.add('d-none');
    document.getElementById('content-container').classList.add('d-none');
}

function showError(message) {
    document.getElementById('loading-state').classList.add('d-none');
    document.getElementById('error-state').classList.remove('d-none');
    document.getElementById('content-container').classList.add('d-none');
    document.getElementById('error-message').textContent = message;
}

function showContent() {
    document.getElementById('loading-state').classList.add('d-none');
    document.getElementById('error-state').classList.add('d-none');
    document.getElementById('content-container').classList.remove('d-none');
}

