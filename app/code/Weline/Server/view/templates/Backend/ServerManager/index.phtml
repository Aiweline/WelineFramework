                        <w:icon name="clock" size="sm"></w:icon> <?= __('刷新') ?>
                    </button>
                    <a href="${GUIDE_URL}" class="w-button ms-2" data-tone="info" data-variant="outline" data-size="sm">
                        <w:icon name="circle" size="sm"></w:icon> <?= __('优化指南') ?>
