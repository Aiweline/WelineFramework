async function loadMemoryNamespaceDetail(encodedNamespace) {
    const namespace = decodeURIComponent(encodedNamespace);
    const body = document.getElementById('memory-key-body');
    if (!body) return;
    body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('加载中...') ?></td></tr>`;
    try {
        const data = await bqAdmin[\'server\'](MEMORY_NAMESPACE_DETAIL_API_URL + '?namespace=' + encodeURIComponent(namespace) + '&limit=100', {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        });
        if (!data.success) {
            throw new Error(data.message || '<?= __('加载失败') ?>');
        }
        const rows = Array.isArray(data.data) ? data.data : [];
        if (!rows.length) {
            body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('该命名空间暂无键') ?></td></tr>`;
            return;
        }
        body.innerHTML = rows.map(row => {
            const key = String(row.key || '');
            return `
                <tr>
                    <td><code class="w-text" data-size="sm">${escapeHtml(key)}</code></td>
                    <td>${escapeHtml(row.type || '')}</td>
                    <td class="w-text" data-size="sm">${renderMemoryPreview(row)}</td>
                    <td>
                        <button class="w-button" data-server-manager-action="delete-memory-key" data-namespace="${encodeURIComponent(namespace)}" data-key="${encodeURIComponent(key)}" data-tone="danger" data-variant="outline" data-size="sm">
                            <w:icon name="trash" size="sm"></w:icon> <?= __('删除键') ?>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    } catch (error) {
        body.innerHTML = `<tr><td colspan="4" class="w-text" data-align="center" data-tone="danger">${escapeHtml(error.message || '<?= __('加载失败') ?>')}</td></tr>`;
    }
}

function renderSessionPreview(preview) {
    if (!preview || typeof preview !== 'object') {
        return '<span class="w-text" data-tone="muted" data-size="sm">-</span>';
    }
    const entries = Object.entries(preview);
    if (!entries.length) {
        return '<span class="w-text" data-tone="muted" data-size="sm">-</span>';
    }
    const authKeys = ['WF_BACKEND_USER', 'WF_FRONTEND_USER', 'WF_BACKEND_USER_ID', 'WF_FRONTEND_USER_ID'];
    const items = entries.map(([k, v]) => {
        const isSensitive = v === '***';
        const isAuth = authKeys.includes(k);
        const val = escapeHtml(String(v));
        const keyCls = isAuth ? 'bg-primary text-white' : 'bg-secondary';
        const valCls = isSensitive ? 'text-muted' : 'text-dark';
        const valIcon = isSensitive ? '<i class="bi bi-shield-lock-fill w-text me-1" title="<?= __('敏感') ?>" data-size="sm"></i>' : '';
        return `<span class="me-2 w-cluster" data-align="center" style="--w-gap:var(--weline-space-1);--w-mb:var(--weline-space-1);">
            <span class="w-badge ${keyCls}">${escapeHtml(k)}</span>
            <span class="w-text ${valCls}" data-size="sm">${valIcon}${val.length > 40 ? val.substring(0, 40) + '…' : val}</span>
        </span>`;
    });
    const shortHtml = items.join('');
    const fullHtml = entries.map(([k, v]) => `<div style="--w-mb:var(--weline-space-1);"><span class="w-badge bg-body-secondary me-1">${escapeHtml(k)}</span><span class="w-text" data-size="sm">${escapeHtml(String(v))}</span></div>`).join('');
    return `
        <details class="weline-session-preview">
            <summary class="w-text cursor-pointer list-unstyled" data-size="sm" style="--w-mb:0;">${shortHtml}</summary>
            <div class="bg-body-tertiary w-text" style="max-width: 420px; max-height: 200px; overflow-y: auto;" data-w-radius="md" data-w-border="border" data-size="sm">${fullHtml}</div>
        </details>
    `;
}

function renderMemoryPreview(row) {
    const detail = row && row.preview_detail && typeof row.preview_detail === 'object' ? row.preview_detail : null;
    const fallback = escapeHtml(row && row.preview ? row.preview : '');
    if (!detail) {
        return `<span class="w-text" data-tone="muted">${fallback}</span>`;
    }

    const kind = String(detail.kind || '');
    const display = escapeHtml(detail.display || row.preview || '');
    const size = Number(detail.size || 0);
    const json = typeof detail.json === 'string' ? detail.json.trim() : '';
    if ((kind === 'array' || kind === 'object') && json) {
        return `
            <details style="--w-mt:var(--weline-space-1);">
                <summary>
                    <span class="w-badge w-text border-info-subtle" data-w-background="info" data-w-border="border" data-tone="info">${display}</span>
                    <span class="w-text ms-1" data-tone="muted">(<?= __('元素') ?>: ${Number.isFinite(size) ? size : 0})</span>
                </summary>
                <pre class="w-text bg-body-tertiary" style="max-width:560px; white-space:pre-wrap; word-break:break-word;" data-w-border="border" data-w-radius="md" data-size="sm">${escapeHtml(json)}</pre>
            </details>
        `;
    }
    if (kind === 'null') {
        return `<span class="w-badge w-text border-secondary-subtle" data-w-background="muted" data-w-border="border" data-tone="muted">null</span>`;
    }
    return `<span class="w-text" data-tone="muted">${display}</span>`;
}

