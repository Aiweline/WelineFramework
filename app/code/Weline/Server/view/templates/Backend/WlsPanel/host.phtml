<script>
(function () {
    'use strict';
    var STORAGE_KEY = 'wls.panel.host.mode';
    var page = document.querySelector('[data-testid="wls-panel-host-page"]');
    var shell = document.querySelector('[data-wls-panel-host-shell]');
    if (!page || !shell) {
        return;
    }
    var expandBtns = page.querySelectorAll('[data-wls-panel-host-expand]');
    var collapseBtns = page.querySelectorAll('[data-wls-panel-host-collapse]');

    function currentMode() {
        return shell.getAttribute('data-mode') === 'float' ? 'float' : 'docked';
    }

    function setMode(mode) {
        var next = mode === 'float' ? 'float' : 'docked';
        shell.setAttribute('data-mode', next);
        try {
            window.localStorage.setItem(STORAGE_KEY, next);
        } catch (e) {}
        expandBtns.forEach(function (btn) {
            btn.hidden = next === 'float';
        });
        collapseBtns.forEach(function (btn) {
            if (btn.getAttribute('data-testid') === 'wls-panel-host-collapse-float') {
                btn.hidden = false;
                return;
            }
            btn.hidden = next !== 'float';
        });
    }

    expandBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            setMode('float');
        });
    });
    collapseBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            setMode('docked');
        });
    });
    document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && currentMode() === 'float') {
            setMode('docked');
        }
    });

    // 点开宿主页默认全屏浮层；缩回仅影响当前会话，下次进入仍全屏。
    setMode('float');
})();
</script>
