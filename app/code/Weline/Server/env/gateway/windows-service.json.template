{
  "service": "weline-wls-gateway-v2",
  "display_name": "Weline WLS 2.0 Host Gateway",
  "account": "LocalSystem",
  "start": "automatic",
  "failure_restart_seconds": [5, 5, 5],
  "repeat_last_failure_action": true,
  "guardian": "{{GUARDIAN}}",
  "arguments": [
    "--service",
    "--home={{HOME}}",
    "--run={{RUN_DIR}}"
  ]
}
