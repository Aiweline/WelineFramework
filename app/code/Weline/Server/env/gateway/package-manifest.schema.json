{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://welineframework.com/schema/wls-gateway-package-v2.json",
  "title": "WLS 2.0 Host Gateway Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "platform",
    "arch",
    "protocol_min",
    "protocol_max",
    "security_profile",
    "implementation_level",
    "package_profile",
    "release_ready",
    "signing_key_id",
    "listen_profiles",
    "capabilities",
    "components"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "platform": {"enum": ["Darwin", "Linux", "Windows"]},
    "arch": {"enum": ["arm64", "x86_64"]},
    "protocol_min": {"type": "integer", "minimum": 2},
    "protocol_max": {"type": "integer", "minimum": 2},
    "security_profile": {"const": "native-broker-v1"},
    "implementation_level": {"const": "wls-2.0"},
    "package_profile": {"enum": ["production", "test"]},
    "release_ready": {"type": "boolean"},
    "signing_key_id": {"type": "string"},
    "listen_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["default", "ipv4-only"]}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "components": {
      "type": "object",
      "minProperties": 8,
      "required": [
        "app/controller.php",
        "LICENSES.txt",
        "provenance.json",
        "sbom.cdx.json"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size", "mode"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "mode": {"type": "integer", "minimum": 256, "maximum": 493}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"release_ready": {"const": true}},
        "required": ["release_ready"]
      },
      "then": {
        "properties": {
          "package_profile": {"const": "production"},
          "signing_key_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
