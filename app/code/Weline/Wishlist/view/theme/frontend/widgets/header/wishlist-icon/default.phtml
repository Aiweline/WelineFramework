<?php
/**
 * @widget.layout_source {Weline_Wishlist::css/widgets/widget-header-wishlist-icon-default.css}
 * Header 收藏夹图标部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {wishlist-icon}
 * @widget.name {Header 收藏夹}
 * @widget.description {收藏夹图标，展示收藏数量并跳转至心愿单列表页}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions","wishlist-icon"]}
 *
 * @param show_count {default=true,type="bool",label="显示数量"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('wishlist-icon');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$showCount = (bool)($this->getData('show_count') ?? true);
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);

// Always SSR an empty badge. Session wishlist count is applied client-side by
// wishlistHeader (wishlist.count) so FPC / guest chrome never paints shopper-specific totals.
$wishlistCount = $isPreviewMode ? 2 : 0;

?>

<section class="header-wishlist header-action-item <?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?><?= $wishlistCount <= 0 ? ' is-empty' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="api,wishlistHeader"
         data-w-wishlist-icon="1"
         data-header-wishlist-ssr="guest-v1"
         data-wishlist-total="<?= $wishlistCount ?>">
    <a href="@url{'customer/account/index'}#wishlist" class="wishlist-link" title="<?= $esc(WidgetI18n::label('我的收藏')) ?>">
        <span class="wishlist-icon-wrapper">
            <span class="header-wishlist-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true">
                    <path d="M12 20.5s-7.2-4.6-9.2-8.8C1.2 8.4 3.4 5 6.8 5c1.8 0 3.4.9 4.3 2.3C12 5.9 13.6 5 15.4 5 18.8 5 21 8.4 21.2 11.7 19.2 15.9 12 20.5 12 20.5z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round"/>
                </svg>
            </span>
            <?php if ($showCount): ?>
                <span class="wishlist-count" data-wishlist-count <?= $wishlistCount > 0 ? '' : 'hidden' ?>>
                    <?= $wishlistCount > 99 ? '99+' : $wishlistCount ?>
                </span>
            <?php endif; ?>
        </span>
        <span class="wishlist-info">
            <span class="wishlist-label"><?= $esc(WidgetI18n::label('收藏')) ?></span>
        </span>
    </a>
</section>

