    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1_5, .375rem);
    color: inherit;
    text-decoration: none;
    padding: var(--spacing-sm, 0.5rem);
    border: var(--border-width-thin, 1px) solid transparent;
    border-radius: var(--border-radius-sm, 0.25rem);
}
.<?= $wc ?> .wishlist-link:hover {
    border-color: currentColor;
    background: var(--color-on-dark-soft, rgba(255, 255, 255, 0.08));
}
.<?= $wc ?> .wishlist-icon-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--weline-chrome-action-icon-size, 1.25rem);
    block-size: var(--weline-chrome-action-icon-size, 1.25rem);
    flex-shrink: 0;
}
.<?= $wc ?> .header-wishlist-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
