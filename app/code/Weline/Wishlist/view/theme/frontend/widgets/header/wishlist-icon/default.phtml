    padding: 0 0.2rem;
    border-radius: 999px;
    background: var(--weline-theme-danger, var(--color-danger));
    color: var(--color-on-danger, #fff);
    font-size: var(--font-size-xs, 0.75rem);
    line-height: var(--spacing-4_5, 1.125rem);
    text-align: center;
    font-weight: 700;
}
.<?= $wc ?> .wishlist-count[hidden] { display: none !important; }
