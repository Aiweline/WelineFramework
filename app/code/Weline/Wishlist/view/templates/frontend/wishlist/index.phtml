</style>

<script>
(function () {
    function toast(message, tone) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast && typeof window.Weline.UI.toast.show === 'function') {
            window.Weline.UI.toast.show(message, { tone: tone || 'info' });
        }
    }

    document.addEventListener('click', function (event) {
        var removeButton = event.target && event.target.closest ? event.target.closest('[data-wishlist-remove]') : null;
        if (removeButton) {
            event.preventDefault();
            var removeId = Number(removeButton.getAttribute('data-product-id') || 0);
            if (removeId <= 0 || !window.Weline || !window.Weline.Api) {
                return;
            }
            window.Weline.Api.resource('wishlist').then(function (api) {
                return api.remove({ product_id: removeId });
            }).then(function () {
                window.location.reload();
            }).catch(function () {
                toast(<?= json_encode((string)__('加入收藏失败，请稍后重试'), JSON_UNESCAPED_UNICODE) ?>, 'error');
            });
            return;
        }

        var cartButton = event.target && event.target.closest ? event.target.closest('[data-wishlist-add-cart]') : null;
        if (!cartButton) {
            return;
        }
        event.preventDefault();
        var productId = Number(cartButton.getAttribute('data-product-id') || 0);
        if (productId <= 0 || !window.Weline || !window.Weline.Api) {
            return;
        }
        window.Weline.Api.resource('cart').then(function (api) {
            return api.add({ product_id: productId, qty: 1 }, { silent: true });
        }).then(function () {
            toast(<?= json_encode((string)__('已加入购物车'), JSON_UNESCAPED_UNICODE) ?>, 'success');
        }).catch(function () {});
    });
})();
</script>
