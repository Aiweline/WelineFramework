<?php
/** @var list<array<string,mixed>> $wishlist_items */
/** @var int $wishlist_count */
$items = is_array($wishlist_items ?? null) ? $wishlist_items : [];
$count = (int)($wishlist_count ?? count($items));
$esc = static fn (mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<section class="storefront-wishlist" data-testid="storefront-wishlist-page" weline-code="wishlist.page.section_1">
    <header class="storefront-wishlist__header">
        <h1 class="storefront-wishlist__title"><?= __('我的收藏') ?></h1>
        <p class="storefront-wishlist__meta"><?= $esc((string)__('共 %{1} 件商品', [$count])) ?></p>
    </header>

    <?php if ($items === []): ?>
        <div class="storefront-wishlist__empty">
            <p><?= __('收藏夹暂无商品') ?></p>
            <a class="storefront-wishlist__cta" href="/"><?= __('去逛逛') ?></a>
        </div>
    <?php else: ?>
        <div class="storefront-wishlist__grid">
            <?php foreach ($items as $item): ?>
                <?php
                $productId = (int)($item['product_id'] ?? 0);
                $url = (string)($item['url'] ?? '#');
                $name = (string)($item['name'] ?? '');
                $image = (string)($item['image'] ?? '');
                $price = (string)($item['formatted_price'] ?? '');
                $rating = (float)($item['rating'] ?? 0);
                $reviewCount = (int)($item['review_count'] ?? 0);
                ?>
                <article class="storefront-wishlist__card" data-product-id="<?= $productId ?>">
                    <a class="storefront-wishlist__media" href="<?= $esc($url) ?>">
                        <?php if ($image !== ''): ?>
                            <img src="<?= $esc($image) ?>" alt="<?= $esc($name) ?>" class="storefront-wishlist__image" loading="lazy">
                        <?php else: ?>
                            <span class="storefront-wishlist__image-placeholder" aria-hidden="true"></span>
                        <?php endif; ?>
                    </a>
                    <div class="storefront-wishlist__body">
                        <h2 class="storefront-wishlist__name">
                            <a href="<?= $esc($url) ?>"><?= $esc($name) ?></a>
                        </h2>
                        <p class="storefront-wishlist__rating"><?= $esc(number_format($rating, 1)) ?> (<?= $reviewCount ?>)</p>
                        <p class="storefront-wishlist__price"><?= $esc($price) ?></p>
                        <div class="storefront-wishlist__actions">
                            <button type="button"
                                    class="storefront-wishlist__add-cart"
                                    data-wishlist-add-cart
                                    data-product-id="<?= $productId ?>">
                                <?= __('加入购物车') ?>
                            </button>
                            <button type="button"
                                    class="storefront-wishlist__remove"
                                    data-wishlist-remove
                                    data-product-id="<?= $productId ?>">
                                <?= __('移除') ?>
                            </button>
                        </div>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>

