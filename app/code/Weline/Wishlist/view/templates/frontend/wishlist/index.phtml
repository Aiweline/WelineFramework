<?php
/**
 * Account-center wishlist list.
 *
 * Render via Template::fetch (not raw include) so Taglib/css/lang compile.
 * CSS also emitted as an explicit link for AJAX sidebar stylesheet hoisting.
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\View\Data\DataInterface;
use Weline\Wishlist\Service\WishlistPagePresenter;

$view = ObjectManager::getInstance(WishlistPagePresenter::class)->resolve($this);
$items = $view['items'];
$count = (int)$view['count'];
$esc = static fn (mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$metaText = (string)__('共 %{1} 件商品', [$count]);
$wishlistAccountCss = (string)$this->fetchTagSource(
    DataInterface::dir_type_STATICS,
    'Weline_Wishlist::css/wishlist-account.css'
);
?>
<link rel="stylesheet" type="text/css" href="<?= $esc($wishlistAccountCss) ?>">
<div class="account-card storefront-wishlist"
     data-testid="storefront-wishlist-page"
     data-weline-load="wishlist,api"
     data-i18n-remove-failed="<?= $esc((string)__('移除失败，请稍后重试')) ?>"
     data-i18n-added-cart="<?= $esc((string)__('已加入购物车')) ?>"
     weline-code="wishlist.page.section_1">
    <header class="account-card__header storefront-wishlist__header">
        <div class="storefront-wishlist__header-row">
            <div>
                <h2 class="account-card__title storefront-wishlist__title"><lang>我的收藏</lang></h2>
                <p class="storefront-wishlist__meta"><?= $esc($metaText) ?></p>
            </div>
            <span class="storefront-wishlist__count"><?= $esc((string)$count) ?></span>
        </div>
    </header>

    <div class="account-card__body">
        <?php if ($items === []): ?>
            <div class="storefront-wishlist__empty">
                <p><lang>收藏夹暂无商品</lang></p>
                <a class="storefront-wishlist__cta" href="@url{'/'}"><lang>去逛逛</lang></a>
            </div>
        <?php else: ?>
            <div class="storefront-wishlist__grid">
                <?php foreach ($items as $item): ?>
                    <?php
                    $productId = (int)($item['product_id'] ?? 0);
                    $url = (string)($item['url'] ?? '#');
                    $name = (string)($item['name'] ?? '');
                    $image = (string)($item['image'] ?? '');
                    $price = (string)($item['formatted_price'] ?? '');
                    $rating = (float)($item['rating'] ?? 0);
                    $reviewCount = (int)($item['review_count'] ?? 0);
                    ?>
                    <article class="product-card storefront-wishlist__card" data-product-id="<?= $productId ?>">
                        <div class="product-image-wrapper storefront-wishlist__media">
                            <a class="product-image-link" href="<?= $esc($url) ?>">
                                <?php if ($image !== ''): ?>
                                    <img src="<?= $esc($image) ?>" alt="<?= $esc($name) ?>" class="product-image storefront-wishlist__image" loading="lazy">
                                <?php else: ?>
                                    <span class="storefront-wishlist__image-placeholder" aria-hidden="true"></span>
                                <?php endif; ?>
                            </a>
                            <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/shopper-actions.phtml', [
                                'product_id' => $productId,
                                'show_wishlist' => true,
                                'show_compare' => true,
                                'show_quickview' => true,
                                'wishlist_pixel' => true,
                            ]) ?>
                        </div>
                        <div class="product-info storefront-wishlist__body">
                            <h3 class="product-name storefront-wishlist__name">
                                <a href="<?= $esc($url) ?>"><?= $esc($name) ?></a>
                            </h3>
                            <p class="storefront-wishlist__rating"><?= $esc(number_format($rating, 1)) ?> (<?= $reviewCount ?>)</p>
                            <p class="storefront-wishlist__price"><?= $esc($price) ?></p>
                            <div class="storefront-wishlist__actions">
                                <button type="button"
                                        class="storefront-wishlist__add-cart"
                                        data-wishlist-add-cart
                                        data-product-id="<?= $productId ?>">
                                    <lang>加入购物车</lang>
                                </button>
                                <button type="button"
                                        class="storefront-wishlist__remove"
                                        data-wishlist-remove
                                        data-product-id="<?= $productId ?>">
                                    <lang>移除</lang>
                                </button>
                            </div>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>
</div>
