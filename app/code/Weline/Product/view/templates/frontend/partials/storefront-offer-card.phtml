<?php

use Weline\Product\Service\ProductCardRenderer;

/**
 * Single storefront offer card (catalog / search shared markup).
 *
 * @var array<string,mixed> $offer
 */
$offer = $this->getData('offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$product = ProductCardRenderer::fromStorefrontOffer($offer);
if ((int)($product['id'] ?? 0) <= 0) {
    return;
}
?>
<?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
