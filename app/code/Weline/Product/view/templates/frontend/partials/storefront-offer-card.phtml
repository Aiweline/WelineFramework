<?php

use Weline\Product\Service\ProductCardRenderer;

/**
 * Single storefront offer card (catalog / search shared markup).
 *
 * Prefer ProductCardRenderer::render over Taglib so callers that still
 * fetch this partial per hit skip Taglib parse overhead.
 *
 * @var array<string,mixed> $offer
 */
$offer = $this->getData('offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$product = ProductCardRenderer::fromStorefrontOffer($offer);
if ((int)($product['id'] ?? 0) <= 0) {
    return;
}
?>
<?= ProductCardRenderer::render($product, [
    'density' => 'standard',
    'show_price' => true,
    'show_rating' => true,
    'show_add_to_cart' => true,
    'show_wishlist' => true,
    'show_compare' => true,
    'show_quickview' => true,
    'show_labels' => true,
    'show_sku' => true,
    'class' => 'wpc-listing-card',
    'wishlist_pixel' => true,
]) ?>
