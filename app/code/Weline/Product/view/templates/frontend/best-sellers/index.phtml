<?php

use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\ProductCardUrl;
use Weline\Theme\Helper\ProductLabelStyle;

/**
 * Storefront best-sellers ranking page body (grid only; hero is best-sellers-hero widget).
 *
 * @var list<array<string,mixed>> $storefront_best_sellers
 */
$items = $this->getData('storefront_best_sellers') ?? [];
$items = is_array($items) ? $items : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$showPrice = true;
$showRating = true;
$showAddToCart = true;
$showWishlist = true;
$showCompare = true;
$showQuickview = true;
?>
<section class="best-sellers-page"
         data-testid="storefront-best-sellers"
         weline-code="product.frontend.best_sellers.section_1">
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>

    <?php if ($items === []): ?>
        <div class="best-sellers-page__empty" data-testid="storefront-best-sellers-empty">
            <lang>当前网站暂无已发布的热销商品。</lang>
        </div>
    <?php else: ?>
        <?php
        $batchProducts = [];
        $metaById = [];
        foreach ($items as $index => $item) {
            if (!is_array($item)) {
                continue;
            }
            $product = $item;
            $productId = max(0, (int)($product['product_id'] ?? $product['id'] ?? 0));
            if ($productId <= 0) {
                continue;
            }
            $rank = max(1, (int)($product['rank'] ?? ($index + 1)));
            $sales = max(0, (int)($product['sales_count'] ?? 0));
            $product['id'] = $productId;
            $product['product_id'] = $productId;
            $product['rank'] = $rank;
            $productLink = ProductCardUrl::splitForTaglib((string)($product['url'] ?? ''));
            $product['url'] = $productLink['url'];
            $product['url_path'] = $productLink['url_path'];
            $labelFlags = ProductLabelStyle::resolveFlags($product, (int)$index);
            $product['is_demo'] = !empty($labelFlags['is_demo']);
            $product['is_new'] = !empty($labelFlags['is_new']);
            $product['is_sale'] = !empty($labelFlags['is_sale']) || !empty($product['has_deal']);
            $product['card_index'] = (int)$index;
            $batchProducts[] = $product;
            $metaById[$productId] = [
                'rank' => $rank,
                'sales' => $sales,
                'rank_class' => $rank <= 3
                    ? 'best-sellers-page__item--top best-sellers-page__item--' . $rank
                    : 'best-sellers-page__item--rest',
            ];
        }
        $cardHtmlById = ProductCardRenderer::projectHtmlByProductId($batchProducts, [
            'density' => 'standard',
            'show_price' => $showPrice,
            'show_rating' => $showRating,
            'show_add_to_cart' => $showAddToCart,
            'show_wishlist' => $showWishlist,
            'show_compare' => $showCompare,
            'show_quickview' => $showQuickview,
            'show_labels' => true,
            'show_sku' => true,
            'class' => 'wpc-listing-card',
            'wishlist_pixel' => true,
        ]);
        ?>
        <div class="best-sellers-page__grid weline-product-card-shelf"
             data-testid="storefront-best-sellers-grid"
             role="list"
             aria-label="@lang('热销商品')">
            <?php foreach ($batchProducts as $product): ?>
                <?php
                $productId = (int)($product['id'] ?? 0);
                $cardHtml = (string)($cardHtmlById[$productId] ?? '');
                $meta = $metaById[$productId] ?? null;
                if ($cardHtml === '' || !is_array($meta)) {
                    continue;
                }
                $rank = (int)$meta['rank'];
                $sales = (int)$meta['sales'];
                ?>
                <div class="best-sellers-page__item <?= $escape((string)$meta['rank_class']) ?>"
                     role="listitem"
                     data-testid="storefront-best-sellers-card"
                     data-rank="<?= $rank ?>"
                     data-product-id="<?= $productId ?>">
                    <span class="best-sellers-page__rank"
                          aria-label="<?= $escape(__('排名') . ' ' . $rank) ?>">#<?= $rank ?></span>
                    <?= $cardHtml ?>
                    <?php if ($sales > 0): ?>
                        <p class="best-sellers-page__sales"><lang args="[$sales]">已售 %{1}</lang></p>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>

<style>
.best-sellers-page {
    display: grid;
    gap: var(--weline-space-7);
    color: var(--weline-theme-text, var(--color-text-primary));
}
.best-sellers-page__empty {
    padding: var(--weline-space-8);
    text-align: center;
    color: var(--weline-theme-text-muted, var(--color-text-secondary));
    border: var(--weline-theme-border-width) dashed var(--weline-theme-border, var(--color-border-default));
    border-radius: var(--weline-radius-md);
}
.best-sellers-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--weline-space-5);
    align-items: stretch;
}
.best-sellers-page__item {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--weline-space-2);
}
.best-sellers-page__item > .weline-product-card {
    height: 100%;
    min-width: 0;
}
.best-sellers-page__rank {
    position: absolute;
    top: var(--weline-space-3);
    left: var(--weline-space-3);
    z-index: 3;
    min-width: 2.25rem;
    padding: var(--spacing-0_2) var(--spacing-0_45);
    border-radius: var(--radius-full);
    background: var(--color-bg-dark);
    color: var(--color-text-light);
    font-weight: var(--weline-font-weight-bold, 700);
    font-size: var(--weline-font-size-sm);
    text-align: center;
    pointer-events: none;
    box-shadow: var(--weline-shadow-md);
}
.best-sellers-page__item--1 .best-sellers-page__rank {
    background: var(--color-danger);
}
.best-sellers-page__item--2 .best-sellers-page__rank {
    background: var(--weline-theme-text-muted);
}
.best-sellers-page__item--3 .best-sellers-page__rank {
    background: var(--color-warning);
}
.best-sellers-page__sales {
    margin: 0;
    color: var(--weline-theme-text-muted, var(--color-text-secondary));
    font-size: var(--weline-font-size-sm);
}
@media (max-width: 68rem) {
    .best-sellers-page__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}
@media (max-width: 48rem) {
    .best-sellers-page__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--weline-space-4);
    }
}
@media (max-width: 32rem) {
    .best-sellers-page__grid {
        grid-template-columns: minmax(0, 1fr);
    }
}
:dir(rtl) .best-sellers-page__rank {
    left: auto;
    right: var(--weline-space-3);
}
</style>
