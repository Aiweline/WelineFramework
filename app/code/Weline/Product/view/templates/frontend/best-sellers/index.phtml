<?php

use Weline\Theme\Helper\ProductCardAddToCartParams;
use Weline\Theme\Helper\ProductCardUrl;
use Weline\Theme\Helper\StorefrontImagePlaceholder;

/**
 * Storefront best-sellers ranking page body.
 *
 * @var list<array<string,mixed>> $storefront_best_sellers
 */
$items = $this->getData('storefront_best_sellers') ?? [];
$items = is_array($items) ? $items : [];
$count = max(0, (int)($this->getData('storefront_best_sellers_count') ?? count($items)));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$top = array_slice($items, 0, 3);
$rest = array_slice($items, 3);
?>
<section class="best-sellers-page"
         data-testid="storefront-best-sellers"
         weline-code="product.frontend.best_sellers.section_1">
    <header class="best-sellers-page__hero">
        <p class="best-sellers-page__eyebrow"><lang>本站人气排行</lang></p>
        <h1 class="best-sellers-page__title"><lang>热销榜</lang></h1>
        <p class="best-sellers-page__lede">
            <lang>按店面热度排序的热销商品，帮你快速找到大家都在买的好物。</lang>
        </p>
        <p class="best-sellers-page__count" data-testid="storefront-best-sellers-count">
            <?php if ($count > 0): ?>
                <?= __('共 %{1} 件热销商品', [$count]) ?>
            <?php else: ?>
                <lang>暂无热销商品</lang>
            <?php endif; ?>
        </p>
    </header>

    <?php if ($items === []): ?>
        <div class="best-sellers-page__empty" data-testid="storefront-best-sellers-empty">
            <lang>当前网站暂无已发布的热销商品。</lang>
        </div>
    <?php else: ?>
        <?php if ($top !== []): ?>
            <ol class="best-sellers-page__podium" data-testid="storefront-best-sellers-podium">
                <?php foreach ($top as $item): ?>
                    <?php
                    if (!is_array($item)) {
                        continue;
                    }
                    $rank = max(1, (int)($item['rank'] ?? 1));
                    $productId = max(0, (int)($item['product_id'] ?? $item['id'] ?? 0));
                    $name = trim((string)($item['name'] ?? ''));
                    $sales = max(0, (int)($item['sales_count'] ?? 0));
                    $price = (float)($item['price'] ?? 0);
                    $productLink = ProductCardUrl::splitForTaglib((string)($item['url'] ?? ''));
                    $route = $productLink['url'] !== ''
                        ? $productLink['url']
                        : ($productLink['url_path'] !== '' ? $this->getUrl($productLink['url_path']) : '');
                    $imageResolved = StorefrontImagePlaceholder::resolve((string)($item['image'] ?? ''), $productId);
                    ?>
                    <li class="best-sellers-page__podium-item best-sellers-page__podium-item--<?= $rank ?>"
                        data-testid="storefront-best-sellers-card"
                        data-rank="<?= $rank ?>"
                        data-product-id="<?= $productId ?>">
                        <span class="best-sellers-page__rank" aria-label="<?= $escape(__('排名') . ' ' . $rank) ?>">#<?= $rank ?></span>
                        <?php if ($route !== ''): ?>
                            <a class="best-sellers-page__media" href="<?= $escape($route) ?>" aria-label="<?= $escape($name) ?>">
                                <img src="<?= $escape($imageResolved['src']) ?>"
                                     alt=""
                                     data-storefront-img="1"
                                     data-fallback="<?= $escape($imageResolved['fallback']) ?>"
                                     loading="lazy"
                                     decoding="async">
                            </a>
                        <?php else: ?>
                            <div class="best-sellers-page__media" aria-hidden="true">
                                <img src="<?= $escape($imageResolved['src']) ?>"
                                     alt=""
                                     data-storefront-img="1"
                                     data-fallback="<?= $escape($imageResolved['fallback']) ?>"
                                     loading="lazy"
                                     decoding="async">
                            </div>
                        <?php endif; ?>
                        <div class="best-sellers-page__body">
                            <h2 class="best-sellers-page__name">
                                <?php if ($route !== ''): ?>
                                    <a href="<?= $escape($route) ?>"><?= $escape($name) ?></a>
                                <?php else: ?>
                                    <?= $escape($name) ?>
                                <?php endif; ?>
                            </h2>
                            <p class="best-sellers-page__sales"><?= __('已售 %{1}', [$sales]) ?></p>
                            <p class="best-sellers-page__price">CNY <?= number_format($price, 2) ?></p>
                            <?= $this->fetch(
                                'Weline_Theme::theme/frontend/partials/product/add-to-cart.phtml',
                                ProductCardAddToCartParams::fetchDictionary($item, ['variant' => 'storefront'])
                            ) ?>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ol>
        <?php endif; ?>

        <?php if ($rest !== []): ?>
            <ol class="best-sellers-page__list" data-testid="storefront-best-sellers-list" start="4">
                <?php foreach ($rest as $item): ?>
                    <?php
                    if (!is_array($item)) {
                        continue;
                    }
                    $rank = max(1, (int)($item['rank'] ?? 1));
                    $productId = max(0, (int)($item['product_id'] ?? $item['id'] ?? 0));
                    $name = trim((string)($item['name'] ?? ''));
                    $sales = max(0, (int)($item['sales_count'] ?? 0));
                    $price = (float)($item['price'] ?? 0);
                    $productLink = ProductCardUrl::splitForTaglib((string)($item['url'] ?? ''));
                    $route = $productLink['url'] !== ''
                        ? $productLink['url']
                        : ($productLink['url_path'] !== '' ? $this->getUrl($productLink['url_path']) : '');
                    $imageResolved = StorefrontImagePlaceholder::resolve((string)($item['image'] ?? ''), $productId);
                    ?>
                    <li class="best-sellers-page__row"
                        data-testid="storefront-best-sellers-card"
                        data-rank="<?= $rank ?>"
                        data-product-id="<?= $productId ?>">
                        <span class="best-sellers-page__rank best-sellers-page__rank--row">#<?= $rank ?></span>
                        <?php if ($route !== ''): ?>
                            <a class="best-sellers-page__thumb" href="<?= $escape($route) ?>" aria-label="<?= $escape($name) ?>">
                                <img src="<?= $escape($imageResolved['src']) ?>"
                                     alt=""
                                     data-storefront-img="1"
                                     data-fallback="<?= $escape($imageResolved['fallback']) ?>"
                                     loading="lazy"
                                     decoding="async">
                            </a>
                        <?php else: ?>
                            <div class="best-sellers-page__thumb" aria-hidden="true">
                                <img src="<?= $escape($imageResolved['src']) ?>"
                                     alt=""
                                     data-storefront-img="1"
                                     data-fallback="<?= $escape($imageResolved['fallback']) ?>"
                                     loading="lazy"
                                     decoding="async">
                            </div>
                        <?php endif; ?>
                        <div class="best-sellers-page__row-body">
                            <h2 class="best-sellers-page__name">
                                <?php if ($route !== ''): ?>
                                    <a href="<?= $escape($route) ?>"><?= $escape($name) ?></a>
                                <?php else: ?>
                                    <?= $escape($name) ?>
                                <?php endif; ?>
                            </h2>
                            <p class="best-sellers-page__meta">
                                <span><?= __('已售 %{1}', [$sales]) ?></span>
                                <span class="best-sellers-page__price">CNY <?= number_format($price, 2) ?></span>
                            </p>
                        </div>
                        <div class="best-sellers-page__row-actions">
                            <?= $this->fetch(
                                'Weline_Theme::theme/frontend/partials/product/add-to-cart.phtml',
                                ProductCardAddToCartParams::fetchDictionary($item, ['variant' => 'storefront'])
                            ) ?>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ol>
        <?php endif; ?>
    <?php endif; ?>
</section>

