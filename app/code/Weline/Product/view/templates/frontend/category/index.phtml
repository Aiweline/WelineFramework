    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 6px;
    border: 1px solid #d5d9d9;
    border-radius: 999px;
    background: #fff;
    color: #0f1111;
    text-decoration: none;
    font-size: 13px;
}
.amz-plp__child:hover { border-color: #c45500; color: #c45500; }
