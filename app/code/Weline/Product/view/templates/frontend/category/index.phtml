    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    flex: 0 0 auto;
}
.amz-plp__summary {
    margin: 0 0 var(--spacing-2);
    color: var(--color-text-gray);
    font-size: var(--font-size-sm);
    line-height: 1.45;
}
.amz-plp__description {
    margin: 0;
    color: var(--weline-theme-color-text);
    font-size: var(--font-size-13);
    line-height: 1.55;
}
.amz-plp__children {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2_5);
    margin: 0 0 var(--spacing-3_5);
}
.amz-plp__child {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-1_5) var(--spacing-2_5) var(--spacing-1_5) var(--spacing-1_5);
    border: var(--border-width-thin) solid var(--color-border-faint);
    border-radius: var(--radius-full);
    background: var(--color-bg-primary);
    color: var(--weline-theme-color-text);
    text-decoration: none;
    font-size: var(--font-size-13);
}
.amz-plp__child:hover { border-color: var(--color-danger); color: var(--color-link); }
.amz-plp__child img {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    object-fit: cover;
}
.amz-plp__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-1_5);
    margin: 0 0 var(--spacing-2_5);
    font-size: var(--font-size-xs);
    color: var(--color-text-gray);
}
.amz-plp__crumb a {
    color: var(--color-link);
    text-decoration: none;
}
.amz-plp__crumb a:hover { color: var(--color-link); text-decoration: underline; }
.amz-plp__crumb-sep { opacity: .55; }
.amz-plp__results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-2_5) var(--spacing-4);
    margin: 0 0 var(--spacing-3_5);
    padding: var(--spacing-2) 0 var(--spacing-2_5);
    border: 0;
    border-bottom: var(--border-width-thin) solid var(--color-border-muted);
    border-radius: 0;
    background: transparent;
}
.amz-plp__results-text {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--font-size-sm);
    font-weight: 400;
    line-height: 1.4;
}
.amz-plp__results-query { font-weight: 700; }
.amz-plp__results-hint {
    margin-left: var(--spacing-1_5);
    color: var(--color-text-gray);
    font-weight: 400;
}
.amz-plp__sort {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1_5);
    margin: 0 0 0 auto;
    font-size: var(--font-size-13);
    color: var(--color-text-gray);
    white-space: nowrap;
    flex: 0 0 auto;
}
.amz-plp__sort-select {
    min-height: var(--control-height-sm);
    padding: var(--spacing-1) var(--spacing-7) var(--spacing-1) var(--spacing-2_5);
    border: var(--border-width-thin) solid var(--color-border-faint);
    border-radius: var(--radius-lg);
    background: var(--color-bg-muted);
    color: inherit;
    font: inherit;
    box-shadow: var(--weline-shadow-md);
}
.amz-plp__notice { min-height: 0; margin: 0 0 var(--spacing-2_5); color: var(--color-text-secondary); font-size: var(--font-size-13); }
.amz-plp__notice.is-error { color: var(--color-link); }
.amz-plp__grid > .weline-product-card {
    min-width: 0;
    height: 100%;
}
.amz-plp__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-3);
    align-items: stretch;
}
/* 购买操作布局已由 .weline-product-card .wpc-cta 拥有；PLP 仅保证格子拉伸 */
.amz-plp__pager {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weline-space-2);
    margin: var(--weline-space-5) 0 0;
    align-items: center;
    justify-content: center;
}
.amz-plp__pager-item {
    min-width: 34px;
    min-height: var(--control-height-sm);
    padding: 0 var(--spacing-2_5);
    border: var(--border-width-thin) solid var(--color-border-faint);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    color: var(--weline-theme-color-text);
    font: inherit;
    font-size: var(--font-size-13);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.amz-plp__pager-item.is-current {
    border-color: var(--color-border-default);
    background: var(--color-bg-dark-secondary);
    color: var(--color-text-light);
}
.amz-plp__pager-item.is-ellipsis {
    border: 0;
    background: transparent;
    min-width: auto;
    padding: 0 var(--spacing-1);
    color: var(--color-text-gray);
    font-weight: 500;
    cursor: default;
}
.amz-plp__pager-item.is-nav {
    padding: 0 var(--spacing-3);
}
.amz-plp__pager-item.is-disabled {
    opacity: .45;
    cursor: not-allowed;
}
.amz-plp__empty {
    padding: var(--spacing-7) var(--spacing-4);
    border: var(--border-width-thin) dashed var(--color-border-faint);
    border-radius: var(--radius-lg);
    color: var(--color-text-gray);
    text-align: center;
    background: var(--color-bg-primary);
}
.storefront-listing-loading {
    margin: 0 0 var(--spacing-2_5);
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-lg);
    background: var(--color-bg-muted);
    color: var(--color-text-gray);
    font-size: var(--font-size-13);
    font-weight: 600;
    line-height: 1.35;
}.storefront-listing-loading[hidden]{ display: none; }
.amz-plp.is-listing-loading [data-listing-stage] {
    opacity: .45;
    pointer-events: none;
    transition: opacity .15s ease;
}
.amz-plp.is-listing-loading [data-listing-sort] {
    pointer-events: none;
    opacity: .7;
}
@media (max-width: 1200px) {
    .amz-plp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 900px) {
    .amz-plp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 520px) {
    .amz-plp__results-bar { align-items: stretch; }
    .amz-plp__sort { width: 100%; justify-content: space-between; }
    .amz-plp__sort-select { flex: 1; }
}
</style>
