    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(15, 17, 17, .12);
}
.amz-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
