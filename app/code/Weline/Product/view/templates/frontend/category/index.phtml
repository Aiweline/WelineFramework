<?php

use Weline\Theme\Helper\StorefrontImagePlaceholder;
/**
 * Amazon-style category results: breadcrumb, results bar, compact product grid.
 *
 * @var array<string,mixed> $storefront_category
 * @var list<array<string,mixed>> $storefront_category_children
 * @var list<array<string,mixed>> $storefront_offers
 * @var list<array{label:string,url:string}> $storefront_category_breadcrumbs
 */

$category = $this->getData('storefront_category') ?? [];
$category = is_array($category) ? $category : [];
$offers = $this->getData('storefront_offers') ?? [];
$offers = is_array($offers) ? $offers : [];
$breadcrumbs = $this->getData('storefront_category_breadcrumbs') ?? [];
$breadcrumbs = is_array($breadcrumbs) ? $breadcrumbs : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$categoryName = trim((string)($category['name'] ?? __('分类')));
$activePrice = trim((string)($this->getData('storefront_listing_price') ?? ''));
$totalCount = max(0, (int)($this->getData('storefront_listing_total') ?? count($offers)));
$visibleCount = max(0, (int)($this->getData('storefront_listing_count') ?? count($offers)));
$sortOptions = $this->getData('storefront_listing_sort_options') ?? [];
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$from = $visibleCount > 0 ? 1 : 0;
$to = $visibleCount;
?>
<section class="amz-plp"
         data-testid="storefront-category-catalog"
         weline-code="product.frontend.category.section_1">

    <?php if ($breadcrumbs !== []): ?>
        <nav class="amz-plp__crumb" aria-label="<?= $escape(__('面包屑')) ?>">
            <a href="<?= $escape((string)$this->getUrl('')) ?>"><?= __('首页') ?></a>
            <?php foreach ($breadcrumbs as $i => $crumb): ?>
                <?php
                if (!is_array($crumb)) {
                    continue;
                }
                $label = trim((string)($crumb['label'] ?? ''));
                $url = trim((string)($crumb['url'] ?? ''));
                $isLast = $i === array_key_last($breadcrumbs);
                ?>
                <span class="amz-plp__crumb-sep" aria-hidden="true">›</span>
                <?php if ($isLast || $url === ''): ?>
                    <span aria-current="page"><?= $escape($label) ?></span>
                <?php else: ?>
                    <a href="<?= $escape($url) ?>"><?= $escape($label) ?></a>
                <?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <div class="amz-plp__results-bar" data-testid="storefront-category-toolbar">
        <h1 class="amz-plp__results-text">
            <?php if ($visibleCount > 0): ?>
                <?= __('第 %{1}–%{2} 件，共 %{3} 件结果', [$from, $to, $visibleCount]) ?>
            <?php else: ?>
                <?= __('0 件结果') ?>
            <?php endif; ?>
            <span class="amz-plp__results-query">
                <?= __('“%{1}”', [$categoryName]) ?>
            </span>
            <?php if ($activePrice !== '' && $visibleCount !== $totalCount): ?>
                <span class="amz-plp__results-hint"><?= __('（筛选自 %{1} 件）', [$totalCount]) ?></span>
            <?php endif; ?>
        </h1>
        <?php if ($sortOptions !== []): ?>
            <label class="amz-plp__sort">
                <span><?= __('排序') ?>:</span>
                <select class="amz-plp__sort-select"
                        data-testid="storefront-category-sort"
                        onchange="if (this.value) { window.location.href = this.value; }">
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $href = trim((string)($option['url'] ?? ''));
                        if ($href === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($href) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?= $escape($option['label'] ?? '') ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="amz-plp__notice" data-testid="category-message" aria-live="polite"></div>

    <?php if ($offers === []): ?>
        <div class="amz-plp__empty" data-testid="storefront-category-empty">
            <?php if ($activePrice !== ''): ?>
                <?= __('当前筛选条件下暂无商品，请调整筛选。') ?>
            <?php else: ?>
                <?= __('该分类下暂无已发布商品。') ?>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="amz-plp__grid" data-testid="storefront-category-grid">
            <?php foreach ($offers as $offer): ?>
                <?php
                $minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
                $sellable = !empty($offer['sellable']);
                $quoteOnly = !empty($offer['quote_only']);
                $uuid = trim((string)($offer['global_offer_uuid'] ?? ''));
                $productId = max(0, (int)($offer['product_id'] ?? 0));
                $productName = trim((string)($offer['name'] ?? ''));
                $productSlug = trim((string)($offer['slug'] ?? ''));
                $productUrl = '';
                if ($productSlug !== '') {
                    $productUrl = (string)$this->getUrl('product/' . $productSlug);
                } elseif ($productId > 0) {
                    $productUrl = (string)$this->getUrl('product/' . $productId);
                }
                $imageResolved = StorefrontImagePlaceholder::resolve((string)($offer['image'] ?? ''), $productId);
                $image = $imageResolved['src'];
                $imageFallback = $imageResolved['fallback'];
                ?>
                <article class="amz-card product-card<?= $productUrl !== '' ? ' is-clickable' : '' ?>"
                         data-testid="storefront-category-product-card"
                         data-product-id="<?= $productId ?>"
                         data-global-offer-uuid="<?= $escape($uuid) ?>">
                    <?php if ($productUrl !== ''): ?>
                        <a class="amz-card__hit"
                           href="<?= $escape($productUrl) ?>"
                           aria-label="<?= $escape($productName) ?>"
                           data-testid="storefront-category-product-card-link"></a>
                    <?php endif; ?>
                    <div class="amz-card__media-wrap">
                        <div class="amz-card__media"<?= $productUrl === '' ? ' aria-hidden="true"' : '' ?>>
                            <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/shopper-actions.phtml', [
                                'product_id' => $productId,
                                'show_wishlist' => true,
                                'show_compare' => true,
                                'show_quickview' => true,
                            ]) ?>
                            <img src="<?= $escape($image) ?>"
                                 alt=""
                                 data-storefront-img="1"
                                 data-fallback="<?= $escape($imageFallback) ?>"
                                 loading="lazy"
                                 decoding="async">
                        </div>
                    </div>
                    <div class="amz-card__body">
                        <h2 class="amz-card__title"><?= $escape($productName) ?></h2>
                        <p class="amz-card__price">
                            <?php if ($quoteOnly): ?>
                                <?= __('联系询价') ?>
                            <?php else: ?>
                                <span class="amz-card__currency"><?= $escape($offer['currency'] ?? 'CNY') ?></span>
                                <span class="amz-card__amount"><?= number_format($minor / 100, 2) ?></span>
                            <?php endif; ?>
                        </p>
                        <button type="button"
                                class="amz-card__add"
                                data-action="add-v2"
                                data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                                data-product-id="<?= $productId ?>"
                                data-global-offer-uuid="<?= $escape($uuid) ?>"
                                <?= $sellable ? '' : 'disabled' ?>>
                            <?= $quoteOnly ? __('仅询价') : ($sellable ? __('加入购物车') : __('暂不可售')) ?>
                        </button>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>

