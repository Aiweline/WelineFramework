}
.amz-card.is-clickable:hover .amz-card__title { color: #c45500; }
.amz-card__sku {
    margin: 0;
    color: #565959;
    font-size: 11px;
}
.amz-card__price {
    margin: 2px 0 0;
    color: #0f1111;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
}
.amz-card__currency {
    margin-right: 3px;
    font-size: 11px;
    font-weight: 600;
    vertical-align: super;
}
.amz-plp .product-card-purchase-actions {
    display: grid;
    gap: 6px;
    width: 100%;
    margin-top: 6px;
}
.amz-plp .product-card-purchase-actions > .weline-cart-product-card-add-to-cart,
.amz-plp .product-card-purchase-actions > .weline-checkout-product-card-buy-now {
    width: 100%;
}
.amz-plp .product-card-purchase-actions button {
    display: flex;
    width: 100%;
    min-height: 30px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: 999px;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    box-sizing: border-box;
    box-shadow: 0 2px 5px rgba(213, 217, 217, 0.45);
}
.amz-plp .amz-card__add {
    border: 1px solid #fcd200;
    background: linear-gradient(180deg, #ffe08a 0%, #ffd814 100%);
    color: #0f1111;
}
.amz-plp .amz-card__add:hover:not(:disabled) {
    background: linear-gradient(180deg, #f7ca00 0%, #f0b800 100%);
    border-color: #e7b92e;
}
.amz-plp .amz-card__buy-now {
    border: 1px solid #ff8f00;
    background: linear-gradient(180deg, #ffb84d 0%, #ffa41c 100%);
    color: #0f1111;
}
.amz-plp .amz-card__buy-now:hover:not(:disabled) {
    background: linear-gradient(180deg, #ff9f1a 0%, #fa8900 100%);
    border-color: #e77600;
}
.amz-plp .amz-card__add:disabled,
.amz-plp .amz-card__buy-now:disabled {
    border-color: #d5d9d9;
    background: #f0f2f2;
    color: #565959;
    cursor: not-allowed;
    box-shadow: none;
}
.amz-plp__empty {
    padding: 28px 16px;
    border: 1px dashed #d5d9d9;
    border-radius: 8px;
    color: #565959;
    text-align: center;
    background: #fff;
}
@media (max-width: 1200px) {
    .amz-plp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
