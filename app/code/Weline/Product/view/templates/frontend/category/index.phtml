<?php

use Weline\Product\Service\ProductCardRenderer;
/**
 * Amazon-style category results: breadcrumb, results bar, compact product grid.
 *
 * @var array<string,mixed> $storefront_category
 * @var list<array<string,mixed>> $storefront_category_children
 * @var list<array<string,mixed>> $storefront_offers
 * @var list<array{label:string,url:string}> $storefront_category_breadcrumbs
 */

$category = $this->getData('storefront_category') ?? [];
$category = is_array($category) ? $category : [];
$offers = $this->getData('storefront_offers') ?? [];
$offers = is_array($offers) ? $offers : [];
$breadcrumbs = $this->getData('storefront_category_breadcrumbs') ?? [];
$breadcrumbs = is_array($breadcrumbs) ? $breadcrumbs : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$categoryName = trim((string)($category['name'] ?? __('分类')));
$categoryBanner = trim((string)($category['banner'] ?? ''));
$categorySummary = trim((string)($category['summary'] ?? ''));
$categoryDescription = trim((string)($category['description'] ?? ''));
$categoryImage = trim((string)($category['image'] ?? ''));
$activePrice = trim((string)($this->getData('storefront_listing_price') ?? ''));
$totalCount = max(0, (int)($this->getData('storefront_listing_total') ?? count($offers)));
$visibleCount = max(0, (int)($this->getData('storefront_listing_count') ?? count($offers)));
$page = max(1, (int)($this->getData('storefront_listing_page') ?? 1));
$pageSize = max(1, (int)($this->getData('storefront_listing_page_size') ?? 24));
$totalPages = max(1, (int)($this->getData('storefront_listing_total_pages') ?? 1));
$pageOptions = $this->getData('storefront_listing_page_options') ?? [];
$pageOptions = is_array($pageOptions) ? $pageOptions : [];
$sortOptions = $this->getData('storefront_listing_sort_options') ?? [];
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$children = $this->getData('storefront_category_children') ?? [];
$children = is_array($children) ? $children : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$from = $visibleCount > 0 ? (($page - 1) * $pageSize) + 1 : 0;
$to = $visibleCount > 0 ? min($page * $pageSize, $visibleCount) : 0;
?>
<section class="amz-plp"
         data-testid="storefront-category-catalog"
         weline-code="product.frontend.category.section_1">

    <?php if ($breadcrumbs !== []): ?>
        <nav class="amz-plp__crumb" aria-label="<?= $escape(__('面包屑')) ?>">
            <a href="@url{'/'}"><?= __('首页') ?></a>
            <?php foreach ($breadcrumbs as $i => $crumb): ?>
                <?php
                if (!is_array($crumb)) {
                    continue;
                }
                $label = trim((string)($crumb['label'] ?? ''));
                $url = trim((string)($crumb['url'] ?? ''));
                $isLast = $i === array_key_last($breadcrumbs);
                ?>
                <span class="amz-plp__crumb-sep" aria-hidden="true">›</span>
                <?php if ($isLast || $url === ''): ?>
                    <span aria-current="page"><?= $escape($label) ?></span>
                <?php else: ?>
                    <a href="<?= $escape($url) ?>"><?= $escape($label) ?></a>
                <?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php if ($categoryBanner !== ''): ?>
        <div class="amz-plp__banner" data-testid="storefront-category-banner">
            <img src="<?= $escape($categoryBanner) ?>"
                 alt="<?= $escape($categoryName) ?>"
                 width="1500"
                 height="300"
                 loading="eager"
                 decoding="async">
        </div>
    <?php endif; ?>

    <?php if ($categoryImage !== '' || $categorySummary !== '' || $categoryDescription !== ''): ?>
        <header class="amz-plp__intro" data-testid="storefront-category-intro">
            <h1 class="amz-plp__heading">
                <?php if ($categoryImage !== ''): ?>
                    <img class="amz-plp__heading-icon"
                         src="<?= $escape($categoryImage) ?>"
                         alt=""
                         width="40"
                         height="40"
                         loading="lazy">
                <?php endif; ?>
                <span><?= $escape($categoryName) ?></span>
            </h1>
            <?php if ($categorySummary !== ''): ?>
                <p class="amz-plp__summary" dir="auto"><?= $escape($categorySummary) ?></p>
            <?php endif; ?>
            <?php if ($categoryDescription !== ''): ?>
                <div class="amz-plp__description" dir="auto"><?= nl2br($escape($categoryDescription)) ?></div>
            <?php endif; ?>
        </header>
    <?php endif; ?>

    <?php if ($children !== []): ?>
        <div class="amz-plp__children" data-testid="storefront-category-children">
            <?php foreach ($children as $child): ?>
                <?php
                if (!is_array($child)) {
                    continue;
                }
                $childName = trim((string)($child['name'] ?? ''));
                $childUrl = trim((string)($child['url'] ?? ''));
                $childImage = trim((string)($child['image'] ?? ''));
                if ($childName === '' || $childUrl === '') {
                    continue;
                }
                ?>
                <a class="amz-plp__child" href="<?= $escape($childUrl) ?>">
                    <?php if ($childImage !== ''): ?>
                        <img src="<?= $escape($childImage) ?>" alt="" width="48" height="48" loading="lazy">
                    <?php endif; ?>
                    <span><?= $escape($childName) ?></span>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <div class="amz-plp__results-bar" data-testid="storefront-category-toolbar">
        <h2 class="amz-plp__results-text">
            <?php if ($visibleCount > 0): ?>
                <?= __('第 %{1}–%{2} 件，共 %{3} 件结果', [$from, $to, $visibleCount]) ?>
            <?php else: ?>
                <?= __('0 件结果') ?>
            <?php endif; ?>
            <span class="amz-plp__results-query">
                <?= __('“%{1}”', [$categoryName]) ?>
            </span>
            <?php if ($activePrice !== '' && $visibleCount !== $totalCount): ?>
                <span class="amz-plp__results-hint"><?= __('（筛选自 %{1} 件）', [$totalCount]) ?></span>
            <?php endif; ?>
        </h2>
        <?php if ($sortOptions !== []): ?>
            <label class="amz-plp__sort">
                <span><?= __('排序') ?>:</span>
                <select class="amz-plp__sort-select"
                        data-testid="storefront-category-sort"
                        onchange="if (this.value) { window.location.href = this.value; }">
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $href = trim((string)($option['url'] ?? ''));
                        if ($href === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($href) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?= $escape($option['label'] ?? '') ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="amz-plp__notice" data-testid="category-message" aria-live="polite"></div>

    <?php if ($offers === []): ?>
        <div class="amz-plp__empty" data-testid="storefront-category-empty">
            <?php if ($activePrice !== ''): ?>
                <?= __('当前筛选条件下暂无商品，请调整筛选。') ?>
            <?php else: ?>
                <?= __('该分类下暂无已发布商品。') ?>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="amz-plp__grid weline-product-card-shelf" data-testid="storefront-category-grid">
            <?= ProductCardRenderer::projectFromOffers($offers, [
                'show_price' => true,
                'show_rating' => true,
                'show_add_to_cart' => true,
                'show_wishlist' => true,
                'show_compare' => true,
                'show_quickview' => true,
                'show_labels' => true,
                'show_sku' => true,
                'density' => 'standard',
                'class' => 'wpc-listing-card',
                'wishlist_pixel' => true,
            ]) ?>
        </div>
        <?php if ($totalPages > 1 && $pageOptions !== []): ?>
            <nav class="amz-plp__pager"
                 data-testid="storefront-category-pager"
                 aria-label="<?= $escape(__('分页')) ?>">
                <?php foreach ($pageOptions as $option): ?>
                    <?php
                    if (!is_array($option)) {
                        continue;
                    }
                    $type = (string)($option['type'] ?? 'page');
                    $href = trim((string)($option['url'] ?? ''));
                    $label = (string)($option['label'] ?? $option['page'] ?? '');
                    if ($label === '') {
                        continue;
                    }
                    if ($type === 'ellipsis') {
                        ?>
                        <span class="amz-plp__pager-item is-ellipsis" aria-hidden="true"><?= $escape($label) ?></span>
                        <?php
                        continue;
                    }
                    if ($type === 'prev' || $type === 'next') {
                        $disabled = !empty($option['disabled']);
                        if ($disabled || $href === '') {
                            ?>
                            <span class="amz-plp__pager-item is-nav is-disabled" aria-disabled="true"><?= $escape($label) ?></span>
                            <?php
                        } else {
                            ?>
                            <a class="amz-plp__pager-item is-nav" href="<?= $escape($href) ?>"><?= $escape($label) ?></a>
                            <?php
                        }
                        continue;
                    }
                    if ($href === '') {
                        continue;
                    }
                    ?>
                    <?php if (!empty($option['selected'])): ?>
                        <span class="amz-plp__pager-item is-current" aria-current="page"><?= $escape($label) ?></span>
                    <?php else: ?>
                        <a class="amz-plp__pager-item" href="<?= $escape($href) ?>"><?= $escape($label) ?></a>
                    <?php endif; ?>
                <?php endforeach; ?>
            </nav>
        <?php endif; ?>
    <?php endif; ?>
</section>

<style>
