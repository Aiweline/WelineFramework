}
/* 购买操作布局已由 .weline-product-card .wpc-cta 拥有；PLP 仅保证格子拉伸 */
.amz-plp__pager {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weline-space-2, 0.5rem);
    margin: var(--weline-space-5, 1.125rem) 0 0;
    align-items: center;
    justify-content: center;
}
.amz-plp__pager-item {
    min-width: 34px;
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid #d5d9d9;
    border-radius: 8px;
    background: #fff;
    color: #0f1111;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.amz-plp__pager-item.is-current {
    border-color: #0f1111;
