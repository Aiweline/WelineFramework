    transition: opacity .2s ease;
}
.amz-card:hover .product-actions,
.amz-card:focus-within .product-actions {
    opacity: 1;
}
.amz-card__media .action-btn {
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .96);
