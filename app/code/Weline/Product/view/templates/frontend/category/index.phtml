.amz-card.is-clickable:hover { border-color: #bbb; box-shadow: 0 2px 8px rgba(15, 17, 17, .08); }
.amz-card__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
    color: inherit;
    text-decoration: none;
}
.amz-card__media-wrap { background: #fff; overflow: hidden; }
