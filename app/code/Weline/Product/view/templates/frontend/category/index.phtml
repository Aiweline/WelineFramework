<?php

use Weline\Product\Helper\StorefrontPageAssignBag;
use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\WidgetI18n;
/**
 * Amazon-style category results: breadcrumb, results bar, compact product grid.
 *
 * @var array<string,mixed> $storefront_category
 * @var list<array<string,mixed>> $storefront_category_children
 * @var list<array<string,mixed>> $storefront_offers
 * @var list<array{label:string,url:string}> $storefront_category_breadcrumbs
 */

$category = StorefrontPageAssignBag::coalesce($this->getData('storefront_category'), 'storefront_category', []);
$category = is_array($category) ? $category : [];
$offers = StorefrontPageAssignBag::coalesce($this->getData('storefront_offers'), 'storefront_offers', []);
$offers = is_array($offers) ? $offers : [];
$breadcrumbs = StorefrontPageAssignBag::coalesce($this->getData('storefront_category_breadcrumbs'), 'storefront_category_breadcrumbs', []);
$breadcrumbs = is_array($breadcrumbs) ? $breadcrumbs : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$categoryName = trim((string)($category['name'] ?? __('分类')));
$categoryBanner = trim((string)($category['banner'] ?? ''));
$categorySummary = trim((string)($category['summary'] ?? ''));
$categoryDescription = trim((string)($category['description'] ?? ''));
$categoryImage = trim((string)($category['image'] ?? ''));
$activePrice = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_price'), 'storefront_listing_price', ''));
$totalCount = max(0, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_total'), 'storefront_listing_total', count($offers)));
$visibleCount = max(0, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_count'), 'storefront_listing_count', count($offers)));
$page = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page'), 'storefront_listing_page', 1));
$pageSize = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page_size'), 'storefront_listing_page_size', 24));
$totalPages = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_total_pages'), 'storefront_listing_total_pages', 1));
$pageOptions = StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page_options'), 'storefront_listing_page_options', []);
$pageOptions = is_array($pageOptions) ? $pageOptions : [];
$sortOptions = StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_sort_options'), 'storefront_listing_sort_options', []);
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$children = StorefrontPageAssignBag::coalesce($this->getData('storefront_category_children'), 'storefront_category_children', []);
$children = is_array($children) ? $children : [];
$listingPath = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_path'), 'storefront_listing_path', ''));
$categoryRoutePath = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_category_path'), 'storefront_category_path', ''));
if ($listingPath === '' && $categoryRoutePath !== '') {
    $listingPath = '/category/' . $categoryRoutePath;
}
if ($listingPath === '') {
    $listingPath = '/categories';
}
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$from = $visibleCount > 0 ? (($page - 1) * $pageSize) + 1 : 0;
$to = $visibleCount > 0 ? min($page * $pageSize, $visibleCount) : 0;
$ssrFiltered = (bool)StorefrontPageAssignBag::coalesce(
    $this->getData('storefront_listing_ssr_filtered'),
    'storefront_listing_ssr_filtered',
    false,
);
?>
<section class="amz-plp"
         data-testid="storefront-category-catalog"
         data-storefront-listing="1"
         data-listing-surface="category"
         data-listing-path="<?= $escape($listingPath) ?>"
         data-category-path="<?= $escape($categoryRoutePath) ?>"
         data-listing-ssr-filtered="<?= $ssrFiltered ? '1' : '0' ?>"
         data-weline-load="storefrontListing"
         data-weline-load-when="idle"
         data-listing-loading-label="<lang>加载中…</lang>"
         weline-code="product.frontend.category.section_1">

    <?php if ($breadcrumbs !== []): ?>
        <nav class="amz-plp__crumb" aria-label="@lang('面包屑')">
            <a href="@url{'/'}"><lang>首页</lang></a>
            <?php foreach ($breadcrumbs as $i => $crumb): ?>
                <?php
                if (!is_array($crumb)) {
                    continue;
                }
                $label = trim((string)($crumb['label'] ?? ''));
                $url = trim((string)($crumb['url'] ?? ''));
                $isLast = $i === array_key_last($breadcrumbs);
                ?>
                <span class="amz-plp__crumb-sep" aria-hidden="true">›</span>
                <?php if ($isLast || $url === ''): ?>
                    <span aria-current="page"><?= $escape($label) ?></span>
                <?php else: ?>
                    <a href="<?= $escape($url) ?>"><?= $escape($label) ?></a>
                <?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php if ($categoryBanner !== ''): ?>
        <div class="amz-plp__banner w-frame" data-ratio="21/9" data-fit="cover" data-testid="storefront-category-banner">
            <img src="<?= $escape($categoryBanner) ?>"
                 alt="<?= $escape($categoryName) ?>"
                 width="1500"
                 height="300"
                 loading="eager"
                 decoding="async">
        </div>
    <?php endif; ?>

    <?php if ($categoryImage !== '' || $categorySummary !== '' || $categoryDescription !== ''): ?>
        <header class="amz-plp__intro" data-testid="storefront-category-intro">
            <h1 class="amz-plp__heading">
                <?php if ($categoryImage !== ''): ?>
                    <img class="amz-plp__heading-icon"
                         src="<?= $escape($categoryImage) ?>"
                         alt=""
                         width="40"
                         height="40"
                         loading="lazy">
                <?php endif; ?>
                <span><?= $escape($categoryName) ?></span>
            </h1>
            <?php if ($categorySummary !== ''): ?>
                <p class="amz-plp__summary" dir="auto"><?= $escape($categorySummary) ?></p>
            <?php endif; ?>
            <?php if ($categoryDescription !== ''): ?>
                <div class="amz-plp__description" dir="auto"><?= nl2br($escape($categoryDescription)) ?></div>
            <?php endif; ?>
        </header>
    <?php endif; ?>

    <?php if ($children !== []): ?>
        <div class="amz-plp__children" data-testid="storefront-category-children">
            <?php foreach ($children as $child): ?>
                <?php
                if (!is_array($child)) {
                    continue;
                }
                $childName = trim((string)($child['name'] ?? ''));
                $childUrl = trim((string)($child['url'] ?? ''));
                $childImage = trim((string)($child['image'] ?? ''));
                if ($childName === '' || $childUrl === '') {
                    continue;
                }
                ?>
                <a class="amz-plp__child" href="<?= $escape($childUrl) ?>">
                    <?php if ($childImage !== ''): ?>
                        <img src="<?= $escape($childImage) ?>" alt="" width="48" height="48" loading="lazy" data-layout-exempt="1">
                    <?php endif; ?>
                    <span><?= $escape($childName) ?></span>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <div class="amz-plp__results-bar" data-testid="storefront-category-toolbar">
        <h2 class="amz-plp__results-text" data-listing-count>
            <?php if ($visibleCount > 0): ?>
                <lang args="[$from, $to, $visibleCount]">第 %{1}–%{2} 件，共 %{3} 件结果</lang>
            <?php else: ?>
                <lang>0 件结果</lang>
            <?php endif; ?>
            <span class="amz-plp__results-query">
                <?= $escape($categoryName) ?>
            </span>
            <span class="amz-plp__results-hint" data-listing-count-hint hidden></span>
        </h2>
        <?php if ($sortOptions !== []): ?>
            <label class="amz-plp__sort">
                <span><lang>排序</lang>:</span>
                <select class="amz-plp__sort-select"
                        data-testid="storefront-category-sort"
                        data-listing-sort>
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $code = trim((string)($option['code'] ?? ''));
                        if ($code === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($code) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?php
                            // Literal __() so Taglib can prefetch heavy locale packs;
                            // dynamic __($var) is not collected and falls back to Chinese.
                            $sortLabel = match ($code) {
                                'default' => (string)__('默认排序'),
                                'price_asc' => (string)__('价格从低到高'),
                                'price_desc' => (string)__('价格从高到低'),
                                'name_asc' => (string)__('名称 A-Z'),
                                default => (string)__((string)($option['label'] ?? '')),
                            };
                            ?>
                            <?= $escape($sortLabel) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="amz-plp__notice" data-testid="category-message" aria-live="polite"></div>

    <div data-listing-stage>
    <?php if ($offers === []): ?>
        <div class="amz-plp__empty" data-testid="storefront-category-empty" data-listing-empty>
            <lang>该分类下暂无已发布商品。</lang>
        </div>
    <?php else: ?>
        <div class="amz-plp__grid weline-product-card-shelf" data-testid="storefront-category-grid" data-listing-grid>
            <?= ProductCardRenderer::projectFromOffers($offers, [
                'show_price' => true,
                'show_add_to_cart' => true,
                'show_wishlist' => true,
                'show_compare' => true,
                'show_quickview' => true,
                'show_labels' => true,
                'show_sku' => true,
                'density' => 'standard',
                'class' => 'wpc-listing-card',
                'wishlist_pixel' => true,
            ]) ?>
        </div>
        <nav class="amz-plp__pager"
             data-testid="storefront-category-pager"
             data-listing-pager
             aria-label="<?= $escape(WidgetI18n::label('分页')) ?>"
             <?= ($totalPages > 1 && $pageOptions !== []) ? '' : 'hidden' ?>>
            <?php foreach ($pageOptions as $option): ?>
                <?php
                if (!is_array($option)) {
                    continue;
                }
                $type = (string)($option['type'] ?? 'page');
                $pageNum = max(1, (int)($option['page'] ?? 1));
                $label = (string)($option['label'] ?? $option['page'] ?? '');
                if ($type === 'prev') {
                    $label = WidgetI18n::label('上一页');
                } elseif ($type === 'next') {
                    $label = WidgetI18n::label('下一页');
                }
                if ($label === '') {
                    continue;
                }
                if ($type === 'ellipsis') {
                    ?>
                    <span class="amz-plp__pager-item is-ellipsis" aria-hidden="true"><?= $escape($label) ?></span>
                    <?php
                    continue;
                }
                if ($type === 'prev' || $type === 'next') {
                    $disabled = !empty($option['disabled']);
                    if ($disabled) {
                        ?>
                        <span class="amz-plp__pager-item is-nav is-disabled" aria-disabled="true"><?= $escape($label) ?></span>
                        <?php
                    } else {
                        ?>
                        <button type="button"
                                class="amz-plp__pager-item is-nav"
                                data-listing-page="<?= $pageNum ?>"><?= $escape($label) ?></button>
                        <?php
                    }
                    continue;
                }
                ?>
                <?php if (!empty($option['selected'])): ?>
                    <span class="amz-plp__pager-item is-current" aria-current="page"><?= $escape($label) ?></span>
                <?php else: ?>
                    <button type="button"
                            class="amz-plp__pager-item"
                            data-listing-page="<?= $pageNum ?>"><?= $escape($label) ?></button>
                <?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>
    </div>
</section>

<style>
.amz-plp { width: 100%; min-width: 0; color: var(--weline-theme-color-text); }
.amz-plp__banner {
    margin: 0 0 var(--spacing-3_5);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-muted);
    max-height: 280px;
}
