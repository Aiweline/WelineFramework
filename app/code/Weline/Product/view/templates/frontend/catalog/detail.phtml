<?php
/** @var array<string,mixed> $storefront_offer */
$offer = $this->getData('storefront_offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);
$minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
$productId = max(0, (int)($offer['product_id'] ?? 0));
$stock = max(0, (int)($offer['stock'] ?? 0));
$sellable = !empty($offer['sellable']);
$quoteOnly = !empty($offer['quote_only']);
$offerUuid = trim((string)($offer['global_offer_uuid'] ?? ''));
$name = trim((string)($offer['name'] ?? ''));
$image = trim((string)($offer['image'] ?? ''));
$images = array_values(array_filter(
    array_map(static fn(mixed $value): string => trim((string)$value), (array)($offer['images'] ?? [])),
    static fn(string $value): bool => $value !== '',
));
if ($image !== '' && !in_array($image, $images, true)) {
    array_unshift($images, $image);
}
$image = $images[0] ?? $image;
$shortDescription = trim((string)($offer['short_description'] ?? ''));
$description = trim((string)($offer['description'] ?? ''));
$specifications = array_values(array_filter(
    (array)($offer['specifications'] ?? []),
    static fn(mixed $specification): bool => is_array($specification)
        && trim((string)($specification['code'] ?? '')) !== ''
        && trim((string)($specification['value'] ?? '')) !== '',
));
$specificationLabels = [
    'product_type' => __('车型类别'),
    'brand' => __('品牌'),
    'series' => __('系列'),
    'engine' => __('发动机'),
    'displacement' => __('排量'),
    'max_power' => __('最大功率'),
    'max_torque' => __('最大扭矩'),
    'dimensions' => __('整车尺寸'),
    'seat_height' => __('座高'),
    'ground_clearance' => __('离地间隙'),
    'fuel_tank' => __('油箱容量'),
    'curb_weight' => __('整备质量'),
    'tyres' => __('轮胎'),
];
$specificationLabel = static function (string $code) use ($specificationLabels): string {
    return (string)($specificationLabels[$code] ?? ucwords(str_replace('_', ' ', $code)));
};
?>
<section class="product-native-detail"
         data-testid="storefront-product-detail"
         weline-code="product.frontend.detail.section_1">
    <a class="product-native-detail__back" href="<?= $escape($this->getUrl('products')) ?>">
        <span aria-hidden="true">←</span> <?= __('返回商品目录') ?>
    </a>

    <div class="product-native-detail__grid">
        <div class="product-native-detail__media">
            <?php if ($image !== ''): ?>
                <img class="product-native-detail__primary-image"
                     src="<?= $escape($image) ?>"
                     alt="<?= $escape($name) ?>">
            <?php else: ?>
                <span aria-hidden="true">FCDC</span>
            <?php endif; ?>
            <?php if (count($images) > 1): ?>
                <div class="product-native-detail__thumbnails" aria-label="<?= $escape(__('商品图片')) ?>">
                    <?php foreach ($images as $index => $galleryImage): ?>
                        <button type="button"
                                class="product-native-detail__thumbnail<?= $index === 0 ? ' is-active' : '' ?>"
                                data-gallery-src="<?= $escape($galleryImage) ?>"
                                aria-label="<?= $escape(__('查看商品图片 %{1}', [$index + 1])) ?>">
                            <img src="<?= $escape($galleryImage) ?>" alt="">
                        </button>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>

        <div class="product-native-detail__body">
            <p class="product-native-detail__eyebrow"><?= __('当前网站已发布车型') ?></p>
            <h1><?= $escape($name) ?></h1>
            <p class="product-native-detail__sku">SKU: <?= $escape($offer['sku'] ?? '') ?></p>
            <?php if ($shortDescription !== ''): ?>
                <p class="product-native-detail__summary"><?= $escape($shortDescription) ?></p>
            <?php endif; ?>
            <p class="product-native-detail__price">
                <?php if ($quoteOnly): ?>
                    <?= __('联系询价') ?>
                <?php else: ?>
                    <?= $escape($offer['currency'] ?? 'CNY') ?> <?= number_format($minor / 100, 2) ?>
                <?php endif; ?>
            </p>

            <dl class="product-native-detail__facts">
                <div>
                    <dt><?= __('库存') ?></dt>
                    <strong><?= $quoteOnly ? __('按项目确认') : $stock ?></strong>
                </div>
                <div>
                    <dt><?= __('销售状态') ?></dt>
                    <strong><?= $quoteOnly ? __('需询价') : ($sellable ? __('可购买') : __('暂不可售')) ?></strong>
                </div>
            </dl>

            <?php if (!$quoteOnly && !$sellable && trim((string)($offer['message'] ?? '')) !== ''): ?>
                <p class="product-native-detail__unavailable"><?= $escape($offer['message']) ?></p>
            <?php endif; ?>

            <div class="product-native-detail__actions">
                <button type="button"
                        class="product-native-detail__add"
                        data-action="add-v2"
                        data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                        data-product-id="<?= $productId ?>"
                        data-global-offer-uuid="<?= $escape($offerUuid) ?>"
                        <?= $sellable && $offerUuid !== '' ? '' : 'disabled' ?>>
                    <?= $quoteOnly ? __('仅询价') : ($sellable ? __('加入购物车') : __('暂不可售')) ?>
                </button>
                <a class="product-native-detail__cart"
                   href="<?= $escape($this->getUrl('cart')) ?>"
                   data-testid="view-cart"
                   hidden><?= __('查看购物车') ?></a>
            </div>
            <p class="product-native-detail__message" data-testid="detail-message" aria-live="polite"></p>
        </div>
    </div>

    <?php if ($description !== '' || $specifications !== []): ?>
        <div class="product-native-detail__content-grid">
            <?php if ($description !== ''): ?>
                <section class="product-native-detail__description"
                         data-testid="product-description"
                         weline-code="product.frontend.detail.description">
                    <p class="product-native-detail__section-kicker"><?= __('车型资料') ?></p>
                    <h2><?= __('商品详情') ?></h2>
                    <p><?= nl2br($escape($description), false) ?></p>
                </section>
            <?php endif; ?>

            <?php if ($specifications !== []): ?>
                <section class="product-native-detail__specifications"
                         data-testid="product-specifications"
                         weline-code="product.frontend.detail.specifications">
                    <p class="product-native-detail__section-kicker"><?= __('技术数据') ?></p>
                    <h2><?= __('规格参数') ?></h2>
                    <dl>
                        <?php foreach ($specifications as $specification): ?>
                            <?php
                            $code = strtolower(trim((string)$specification['code']));
                            $value = trim((string)$specification['value']);
                            if ($code === 'product_type' && preg_match('/^[a-z0-9_]+$/D', $value)) {
                                $value = ucwords(str_replace('_', ' ', $value));
                            }
                            ?>
                            <div>
                                <dt><?= $escape($specificationLabel($code)) ?></dt>
                                <div class="product-native-detail__specification-value"><?= $escape($value) ?></div>
                            </div>
                        <?php endforeach; ?>
                    </dl>
                </section>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <w:hook name="Weline_Review::frontend::layouts::product-reviews::content"/>
</section>

<style>
