        .product-native-detail__specifications dl div { grid-template-columns:1fr; gap:6px; }
    }
</style>

<script>
(function () {
    'use strict';
    const root = document.querySelector('[data-testid="storefront-product-detail"]');
    if (!root) return;
    const button = root.querySelector('[data-action="add-v2"]');
    const message = root.querySelector('[data-testid="detail-message"]');
    const cartLink = root.querySelector('[data-testid="view-cart"]');
    const primaryImage = root.querySelector('.product-native-detail__primary-image');
    root.querySelectorAll('[data-gallery-src]').forEach(function (thumbnail) {
        thumbnail.addEventListener('click', function () {
            if (!primaryImage) return;
            primaryImage.src = thumbnail.dataset.gallerySrc || primaryImage.src;
            root.querySelectorAll('[data-gallery-src]').forEach(function (item) {
                item.classList.toggle('is-active', item === thumbnail);
            });
        });
    });
    const guestTokenStorageKey = 'weline.cart.guest_token';
    let cartApi = null;
    let guestToken = '';
    try {
        guestToken = String(window.sessionStorage.getItem(guestTokenStorageKey) || '').trim();
    } catch (error) {
        // Storage can be unavailable in privacy-restricted browser contexts.
    }

    async function api() {
        if (cartApi) return cartApi;
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error('Weline.Api unavailable');
        }
        cartApi = await window.Weline.Api.resource('cart');
        return cartApi;
    }

    async function ensureGuestToken() {
        if (guestToken) return guestToken;
        const result = await (await api()).issueGuestToken({});
        const payload = result && result.data && typeof result.data === 'object' ? result.data : result;
        guestToken = String((payload && payload.guest_token) || (result && result.guest_token) || '').trim();
        if (!guestToken) throw new Error('<?= $escape(__('无法创建游客购物车会话')) ?>');
        try {
            window.sessionStorage.setItem(guestTokenStorageKey, guestToken);
        } catch (error) {
            // The active mutation can still use this request-owned token.
        }
        return guestToken;
    }

    if (!button) return;
    button.addEventListener('click', async function () {
        if (button.disabled) return;
        button.disabled = true;
        message.classList.remove('is-error');
        message.textContent = '<?= $escape(__('正在加入购物车...')) ?>';
        try {
            const result = await (await api()).addV2({
                provider_code: button.dataset.providerCode || 'product',
                global_offer_uuid: button.dataset.globalOfferUuid || '',
                legacy_product_id: Number(button.dataset.productId || 0),
                guest_token: await ensureGuestToken(),
                qty: 1
            });
            if (!result || result.success === false) {
                throw new Error(result && result.message ? result.message : '<?= $escape(__('加入购物车失败')) ?>');
            }
            message.textContent = '<?= $escape(__('商品已加入购物车。')) ?>';
            button.textContent = '<?= $escape(__('已加入')) ?>';
            cartLink.hidden = false;
        } catch (error) {
            message.classList.add('is-error');
            message.textContent = error && error.message ? error.message : '<?= $escape(__('加入购物车失败')) ?>';
            button.disabled = false;
        }
    });
})();
</script>
