        background:#ffd814;
        color:#0f1111;
        font:inherit;
        font-size:12px;
        font-weight:600;
        cursor:pointer;
    }
    .product-storefront__add:hover { background:#f7ca00; }
    .product-storefront__add:disabled {
        border-color:#d5d9d9;
        background:#f0f2f2;
