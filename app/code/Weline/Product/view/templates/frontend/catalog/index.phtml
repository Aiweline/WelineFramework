    }
    .product-storefront__cart[hidden] { display:none; }
    .product-storefront__pager {
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        margin:18px 0 0;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item {
        min-width:34px;
        min-height:34px;
        padding:0 10px;
        border:1px solid #d5d9d9;
        border-radius:8px;
        background:#fff;
        color:#0f1111;
        font:inherit;
        font-size:13px;
        font-weight:600;
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item.is-current {
        border-color:#0f1111;
        background:#0f1111;
        color:#fff;
    }
    .product-storefront__empty {
        padding:28px 16px;
        border:1px dashed #d5d9d9;
