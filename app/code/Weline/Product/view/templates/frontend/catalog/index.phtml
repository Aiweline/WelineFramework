<?php
/**
 * Durable Product catalog cards. Cart mutation is performed by the browser
 * through Weline.Api and the Cart V2 OfferIdentity boundary.
 *
 * @var list<array<string,mixed>> $storefront_offers
 */
$offers = $this->getData('storefront_offers') ?? [];
$offers = is_array($offers) ? $offers : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<section class="product-storefront"
         data-testid="storefront-product-catalog"
         weline-code="product.frontend.catalog.section_1">
    <header class="product-storefront__header">
        <p class="product-storefront__eyebrow"><?= __('真实商品目录') ?></p>
        <h1><?= __('商品') ?></h1>
        <p><?= __('页面价格、库存与购物车均来自当前网站的持久化商品 Offer。') ?></p>
    </header>

    <div class="product-storefront__notice" data-testid="catalog-message" aria-live="polite"></div>

    <?php if ($offers === []): ?>
        <div class="product-storefront__empty" data-testid="storefront-product-empty">
            <?= __('当前网站暂无已发布商品。') ?>
        </div>
    <?php else: ?>
        <div class="product-storefront__grid">
            <?php foreach ($offers as $offer): ?>
                <?php
                $minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
                $sellable = !empty($offer['sellable']);
                $uuid = trim((string)($offer['global_offer_uuid'] ?? ''));
                ?>
                <article class="product-storefront__card"
                         data-testid="storefront-product-card"
                         data-global-offer-uuid="<?= $escape($uuid) ?>">
                    <div class="product-storefront__media" aria-hidden="true">
                        <?php if (trim((string)($offer['image'] ?? '')) !== ''): ?>
                            <img src="<?= $escape($offer['image']) ?>" alt="">
                        <?php else: ?>
                            <span>W</span>
                        <?php endif; ?>
                    </div>
                    <div class="product-storefront__body">
                        <h2><?= $escape($offer['name'] ?? '') ?></h2>
                        <p class="product-storefront__sku">SKU: <?= $escape($offer['sku'] ?? '') ?></p>
                        <p class="product-storefront__price">
                            <?= $escape($offer['currency'] ?? 'CNY') ?> <?= number_format($minor / 100, 2) ?>
                        </p>
                        <button type="button"
                                class="product-storefront__add"
                                data-action="add-v2"
                                data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                                data-product-id="<?= (int)($offer['product_id'] ?? 0) ?>"
                                data-global-offer-uuid="<?= $escape($uuid) ?>"
                                <?= $sellable ? '' : 'disabled' ?>>
                            <?= $sellable ? __('加入购物车') : __('暂不可售') ?>
                        </button>
                        <?php if (!$sellable && trim((string)($offer['message'] ?? '')) !== ''): ?>
                            <small><?= $escape($offer['message']) ?></small>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <a class="product-storefront__cart" href="/cart" data-testid="view-cart" hidden>
        <?= __('查看购物车') ?>
    </a>
</section>

<style>
    .product-storefront { width:min(1180px,calc(100% - 32px)); margin:0 auto; padding:44px 0 64px; }
    .product-storefront__header h1,.product-storefront__header p { margin:0; }
    .product-storefront__header h1 { margin-top:4px; font-size:34px; }
    .product-storefront__header > p:last-child { margin-top:9px; color:#64748b; }
    .product-storefront__eyebrow { color:#2563eb; font-size:13px; font-weight:800; }
    .product-storefront__notice { min-height:24px; margin:16px 0; color:#166534; }
    .product-storefront__notice.is-error { color:#991b1b; }
    .product-storefront__grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
    .product-storefront__card { overflow:hidden; border:1px solid #e5e7eb; border-radius:12px; background:#fff; }
    .product-storefront__media { display:grid; min-height:150px; place-items:center; background:#f8fafc; color:#94a3b8; font-size:44px; font-weight:900; }
    .product-storefront__media img { width:100%; height:180px; object-fit:cover; }
    .product-storefront__body { display:grid; gap:9px; padding:18px; }
    .product-storefront__body h2,.product-storefront__body p { margin:0; }
    .product-storefront__sku { color:#64748b; font-size:13px; }
    .product-storefront__price { font-size:19px; font-weight:800; }
    .product-storefront__add,.product-storefront__cart { min-height:42px; border:0; border-radius:8px; background:#2563eb; color:#fff; font:inherit; font-weight:800; cursor:pointer; }
    .product-storefront__add:disabled { background:#94a3b8; cursor:not-allowed; }
    .product-storefront__cart { display:inline-flex; align-items:center; justify-content:center; margin-top:20px; padding:0 18px; text-decoration:none; }
    .product-storefront__cart[hidden] { display:none; }
    .product-storefront__empty { padding:32px; border:1px dashed #cbd5e1; border-radius:10px; color:#64748b; text-align:center; }
</style>

<script>
(function () {
    'use strict';
    const root = document.querySelector('[data-testid="storefront-product-catalog"]');
    if (!root) return;
    const message = root.querySelector('[data-testid="catalog-message"]');
    const cartLink = root.querySelector('[data-testid="view-cart"]');
    let cartApi = null;
    let guestToken = <?= json_encode($cartGuestToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    async function api() {
        if (cartApi) return cartApi;
        if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
            throw new Error('Weline.Api unavailable');
        }
        cartApi = await window.Weline.Api.resource('cart');
        return cartApi;
    }

    async function ensureGuestToken() {
        if (guestToken) return guestToken;
        const result = await (await api()).issueGuestToken({});
        const payload = result && result.data && typeof result.data === 'object' ? result.data : result;
        guestToken = String((payload && payload.guest_token) || (result && result.guest_token) || '');
        if (!guestToken) throw new Error('<?= $escape(__('无法创建游客购物车会话')) ?>');
        return guestToken;
    }

    root.addEventListener('click', async function (event) {
        const button = event.target.closest('[data-action="add-v2"]');
        if (!button || button.disabled) return;
        button.disabled = true;
        message.classList.remove('is-error');
        message.textContent = '<?= $escape(__('正在加入购物车...')) ?>';
        try {
            const result = await (await api()).addV2({
                provider_code: button.dataset.providerCode || 'product',
                global_offer_uuid: button.dataset.globalOfferUuid || '',
                legacy_product_id: Number(button.dataset.productId || 0),
                guest_token: await ensureGuestToken(),
                qty: 1
            });
            if (!result || result.success === false) {
                throw new Error(result && result.message ? result.message : '<?= $escape(__('加入购物车失败')) ?>');
            }
            message.textContent = '<?= $escape(__('商品已加入购物车。')) ?>';
            cartLink.hidden = false;
            button.textContent = '<?= $escape(__('已加入')) ?>';
        } catch (error) {
            message.classList.add('is-error');
            message.textContent = error && error.message ? error.message : '<?= $escape(__('加入购物车失败')) ?>';
            button.disabled = false;
        }
    });
})();
</script>
