<?php

use Weline\Product\Service\ProductCardRenderer;
/**
 * Durable Product catalog cards. Cart mutation is performed by the browser
 * through Weline.Api and the Cart OfferIdentity boundary.
 *
 * @var list<array<string,mixed>> $storefront_offers
 */
$offers = $this->getData('storefront_offers') ?? [];
$offers = is_array($offers) ? $offers : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$activePrice = trim((string)($this->getData('storefront_listing_price') ?? ''));
$totalCount = max(0, (int)($this->getData('storefront_listing_total') ?? count($offers)));
$visibleCount = max(0, (int)($this->getData('storefront_listing_count') ?? count($offers)));
$page = max(1, (int)($this->getData('storefront_listing_page') ?? 1));
$pageSize = max(1, (int)($this->getData('storefront_listing_page_size') ?? 24));
$totalPages = max(1, (int)($this->getData('storefront_listing_total_pages') ?? 1));
$pageOptions = $this->getData('storefront_listing_page_options') ?? [];
$pageOptions = is_array($pageOptions) ? $pageOptions : [];
$sortOptions = $this->getData('storefront_listing_sort_options') ?? [];
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$heading = trim((string)($this->getData('storefront_heading') ?? __('全部商品')));
$lede = trim((string)($this->getData('storefront_lede') ?? __('浏览当前网站已发布的商品，可按分类与价格筛选。')));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$from = $visibleCount > 0 ? (($page - 1) * $pageSize) + 1 : 0;
$to = $visibleCount > 0 ? min($page * $pageSize, $visibleCount) : 0;
?>
<section class="product-storefront"
         data-testid="storefront-product-catalog"
         weline-code="product.frontend.catalog.section_1">
    <header class="product-storefront__header">
        <h1><?= $escape($heading) ?></h1>
        <p class="product-storefront__lede"><?= $escape($lede) ?></p>
    </header>

    <div class="product-storefront__toolbar" data-testid="storefront-products-toolbar">
        <p class="product-storefront__count">
            <?php if ($visibleCount > 0): ?>
                <?= __('第 %{1}–%{2} 件，共 %{3} 件商品', [$from, $to, $visibleCount]) ?>
            <?php else: ?>
                <?= __('0 件商品') ?>
            <?php endif; ?>
            <?php if ($activePrice !== '' && $visibleCount !== $totalCount): ?>
                <span class="product-storefront__count-hint"><?= __('（筛选自 %{1} 件）', [$totalCount]) ?></span>
            <?php endif; ?>
        </p>
        <?php if ($sortOptions !== []): ?>
            <label class="product-storefront__sort">
                <span><?= __('排序') ?>:</span>
                <select class="product-storefront__sort-select"
                        data-testid="storefront-products-sort"
                        onchange="if (this.value) { window.location.href = this.value; }">
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $href = trim((string)($option['url'] ?? ''));
                        if ($href === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($href) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?= $escape($option['label'] ?? '') ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="product-storefront__notice" data-testid="catalog-message" aria-live="polite"></div>

    <?php if ($offers === []): ?>
        <div class="product-storefront__empty" data-testid="storefront-product-empty">
            <?php if ($activePrice !== ''): ?>
                <?= __('当前筛选条件下暂无商品，请调整筛选。') ?>
            <?php else: ?>
                <?= __('当前网站暂无已发布商品。') ?>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="product-storefront__grid weline-product-card-shelf">
            <?= ProductCardRenderer::projectFromOffers($offers, [
                'show_price' => true,
                'show_rating' => false,
                'show_add_to_cart' => true,
                'show_wishlist' => true,
                'show_compare' => true,
                'show_quickview' => true,
                'show_labels' => true,
                'show_sku' => true,
                'density' => 'standard',
                'class' => 'wpc-listing-card',
                'wishlist_pixel' => true,
            ]) ?>
        </div>
        <?php if ($totalPages > 1 && $pageOptions !== []): ?>
            <nav class="product-storefront__pager"
                 data-testid="storefront-products-pager"
                 aria-label="<?= $escape(__('分页')) ?>">
                <?php foreach ($pageOptions as $option): ?>
                    <?php
                    if (!is_array($option)) {
                        continue;
                    }
                    $type = (string)($option['type'] ?? 'page');
                    $href = trim((string)($option['url'] ?? ''));
                    $label = (string)($option['label'] ?? $option['page'] ?? '');
                    if ($label === '') {
                        continue;
                    }
                    if ($type === 'ellipsis') {
                        ?>
                        <span class="product-storefront__pager-item is-ellipsis" aria-hidden="true"><?= $escape($label) ?></span>
                        <?php
                        continue;
                    }
                    if ($type === 'prev' || $type === 'next') {
                        $disabled = !empty($option['disabled']);
                        if ($disabled || $href === '') {
                            ?>
                            <span class="product-storefront__pager-item is-nav is-disabled" aria-disabled="true"><?= $escape($label) ?></span>
                            <?php
                        } else {
                            ?>
                            <a class="product-storefront__pager-item is-nav" href="<?= $escape($href) ?>"><?= $escape($label) ?></a>
                            <?php
                        }
                        continue;
                    }
                    if ($href === '') {
                        continue;
                    }
                    ?>
                    <?php if (!empty($option['selected'])): ?>
                        <span class="product-storefront__pager-item is-current" aria-current="page"><?= $escape($label) ?></span>
                    <?php else: ?>
                        <a class="product-storefront__pager-item" href="<?= $escape($href) ?>"><?= $escape($label) ?></a>
                    <?php endif; ?>
                <?php endforeach; ?>
            </nav>
        <?php endif; ?>
    <?php endif; ?>

    <a class="product-storefront__cart" href="@url{'cart'}" data-testid="view-cart" hidden>
        <?= __('查看购物车') ?>
    </a>
</section>

<style>
    .product-storefront { width:100%; min-width:0; margin:0; padding:0 0 48px; color:#0f1111; }
    .product-storefront__header { margin:0 0 8px; }
    .product-storefront__header h1 { margin:0; font-size:22px; font-weight:700; line-height:1.25; }
    .product-storefront__lede { margin:6px 0 0; color:#565959; font-size:13px; line-height:1.4; }
    .product-storefront__toolbar {
        display:flex;
        flex-wrap:wrap;
        align-items:center;
        justify-content:space-between;
        gap:10px 16px;
        margin:0 0 14px;
        padding:8px 0 10px;
        border-bottom:1px solid #e3e6e6;
    }
    .product-storefront__count { margin:0; font-size:14px; color:#0f1111; }
    .product-storefront__count-hint { margin-left:6px; color:#565959; }
    .product-storefront__sort {
        display:inline-flex;
        align-items:center;
        gap:6px;
        margin:0 0 0 auto;
        font-size:13px;
        color:#565959;
        white-space:nowrap;
    }
    .product-storefront__sort-select {
        min-height:32px;
        padding:4px 28px 4px 10px;
        border:1px solid #d5d9d9;
        border-radius:8px;
        background:#f0f2f2;
        color:inherit;
        font:inherit;
        box-shadow:0 2px 5px rgba(15,17,17,.05);
    }
    .product-storefront__notice { min-height:0; margin:0 0 10px; color:#067d62; font-size:13px; }
    .product-storefront__notice.is-error { color:#b12704; }
    .product-storefront__grid {
        display:grid;
        grid-template-columns:repeat(4, minmax(0, 1fr));
        gap:12px;
        align-items:stretch;
    }
    .product-storefront__grid > .weline-product-card {
        min-width:0;
        height:100%;
    }
    .product-storefront__pager {
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        margin:18px 0 0;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item {
        min-width:34px;
        min-height:34px;
        padding:0 10px;
        border:1px solid #d5d9d9;
        border-radius:8px;
        background:#fff;
        color:#0f1111;
        font:inherit;
        font-size:13px;
        font-weight:600;
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item.is-current {
        border-color:#0f1111;
        background:#0f1111;
        color:#fff;
    }
    .product-storefront__pager-item.is-ellipsis {
        border:0;
        background:transparent;
        min-width:auto;
        padding:0 4px;
        color:#565959;
        font-weight:500;
        cursor:default;
    }
    .product-storefront__pager-item.is-nav {
        padding:0 12px;
    }
    .product-storefront__pager-item.is-disabled {
        opacity:.45;
        cursor:not-allowed;
    }
    .product-storefront__empty {
        padding:28px 16px;
        border:1px dashed #d5d9d9;
        border-radius:8px;
        color:#565959;
        text-align:center;
        background:#fff;
    }
    @media (max-width:1200px) {
        .product-storefront__grid { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width:900px) {
        .product-storefront__grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width:768px) {
        .product-storefront__toolbar { align-items:stretch; }
        .product-storefront__sort { width:100%; justify-content:space-between; }
        .product-storefront__sort-select { flex:1; }
    }
    @media (max-width:520px) {
        .product-storefront__grid { grid-template-columns:1fr; }
    }
</style>
