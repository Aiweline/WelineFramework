<?php

use Weline\Theme\Helper\StorefrontImagePlaceholder;
/**
 * Durable Product catalog cards. Cart mutation is performed by the browser
 * through Weline.Api and the Cart V2 OfferIdentity boundary.
 *
 * @var list<array<string,mixed>> $storefront_offers
 */
$offers = $this->getData('storefront_offers') ?? [];
$offers = is_array($offers) ? $offers : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$activePrice = trim((string)($this->getData('storefront_listing_price') ?? ''));
$totalCount = max(0, (int)($this->getData('storefront_listing_total') ?? count($offers)));
$visibleCount = max(0, (int)($this->getData('storefront_listing_count') ?? count($offers)));
$sortOptions = $this->getData('storefront_listing_sort_options') ?? [];
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<section class="product-storefront"
         data-testid="storefront-product-catalog"
         weline-code="product.frontend.catalog.section_1">
    <header class="product-storefront__header">
        <h1><?= __('全部商品') ?></h1>
        <p class="product-storefront__lede"><?= __('浏览当前网站已发布的商品，可按分类与价格筛选。') ?></p>
    </header>

    <div class="product-storefront__toolbar" data-testid="storefront-products-toolbar">
        <p class="product-storefront__count">
            <?php if ($visibleCount > 0): ?>
                <?= __('共 %{1} 件商品', [$visibleCount]) ?>
            <?php else: ?>
                <?= __('0 件商品') ?>
            <?php endif; ?>
            <?php if ($activePrice !== '' && $visibleCount !== $totalCount): ?>
                <span class="product-storefront__count-hint"><?= __('（筛选自 %{1} 件）', [$totalCount]) ?></span>
            <?php endif; ?>
        </p>
        <?php if ($sortOptions !== []): ?>
            <label class="product-storefront__sort">
                <span><?= __('排序') ?>:</span>
                <select class="product-storefront__sort-select"
                        data-testid="storefront-products-sort"
                        onchange="if (this.value) { window.location.href = this.value; }">
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $href = trim((string)($option['url'] ?? ''));
                        if ($href === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($href) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?= $escape($option['label'] ?? '') ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="product-storefront__notice" data-testid="catalog-message" aria-live="polite"></div>

    <?php if ($offers === []): ?>
        <div class="product-storefront__empty" data-testid="storefront-product-empty">
            <?php if ($activePrice !== ''): ?>
                <?= __('当前筛选条件下暂无商品，请调整筛选。') ?>
            <?php else: ?>
                <?= __('当前网站暂无已发布商品。') ?>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="product-storefront__grid">
            <?php foreach ($offers as $offer): ?>
                <?php
                $minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
                $sellable = !empty($offer['sellable']);
                $quoteOnly = !empty($offer['quote_only']);
                $uuid = trim((string)($offer['global_offer_uuid'] ?? ''));
                $productId = max(0, (int)($offer['product_id'] ?? 0));
                $productName = trim((string)($offer['name'] ?? ''));
                $productSlug = trim((string)($offer['slug'] ?? ''));
                $productUrl = '';
                if ($productSlug !== '') {
                    $productUrl = (string)$this->getUrl('product/' . $productSlug);
                } elseif ($productId > 0) {
                    $productUrl = (string)$this->getUrl('product/' . $productId);
                }
                ?>
                <article class="product-storefront__card product-card<?= $productUrl !== '' ? ' is-clickable' : '' ?>"
                         data-testid="storefront-product-card"
                         data-product-id="<?= $productId ?>"
                         data-global-offer-uuid="<?= $escape($uuid) ?>">
                    <?php if ($productUrl !== ''): ?>
                        <a class="product-storefront__card-hit"
                           href="<?= $escape($productUrl) ?>"
                           aria-label="<?= $escape($productName) ?>"
                           data-testid="storefront-product-card-link"></a>
                    <?php endif; ?>
                    <?php
                    $imageResolved = StorefrontImagePlaceholder::resolve((string)($offer['image'] ?? ''), $productId);
                    ?>
                    <div class="product-storefront__media"<?= $productUrl === '' ? ' aria-hidden="true"' : '' ?>>
                        <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/shopper-actions.phtml', [
                            'product_id' => $productId,
                            'show_wishlist' => true,
                            'show_compare' => true,
                            'show_quickview' => true,
                        ]) ?>
                        <img src="<?= $escape($imageResolved['src']) ?>"
                             alt=""
                             data-storefront-img="1"
                             data-fallback="<?= $escape($imageResolved['fallback']) ?>"
                             loading="lazy"
                             decoding="async">
                    </div>
                    <div class="product-storefront__body">
                        <h2><?= $escape($productName) ?></h2>
                        <p class="product-storefront__sku">SKU: <?= $escape($offer['sku'] ?? '') ?></p>
                        <p class="product-storefront__price">
                            <?php if ($quoteOnly): ?>
                                <?= __('联系询价') ?>
                            <?php else: ?>
                                <?= $escape($offer['currency'] ?? 'CNY') ?> <?= number_format($minor / 100, 2) ?>
                            <?php endif; ?>
                        </p>
                        <button type="button"
                                class="product-storefront__add"
                                data-action="add-v2"
                                data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                                data-product-id="<?= $productId ?>"
                                data-global-offer-uuid="<?= $escape($uuid) ?>"
                                <?= $sellable ? '' : 'disabled' ?>>
                            <?= $quoteOnly ? __('仅询价') : ($sellable ? __('加入购物车') : __('暂不可售')) ?>
                        </button>
                        <?php if (!$quoteOnly && !$sellable && trim((string)($offer['message'] ?? '')) !== ''): ?>
                            <small><?= $escape($offer['message']) ?></small>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <a class="product-storefront__cart" href="<?= $escape($this->getUrl('cart')) ?>" data-testid="view-cart" hidden>
        <?= __('查看购物车') ?>
    </a>
</section>

