        max-height:160px;
        overflow:hidden;
        background:#fff;
        color:#bbb;
        font-size:36px;
        font-weight:800;
    }
    .product-storefront__media span {
        position:absolute;
        inset:0;
        display:grid;
        place-items:center;
    }
    .product-storefront__media img {
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
    }
