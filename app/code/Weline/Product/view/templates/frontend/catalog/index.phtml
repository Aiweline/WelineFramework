<?php

use Weline\Product\Helper\StorefrontPageAssignBag;
use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\WidgetI18n;
/**
 * Durable Product catalog cards. Cart mutation is performed by the browser
 * through Weline.Api and the Cart OfferIdentity boundary.
 *
 * @var list<array<string,mixed>> $storefront_offers
 */
$offers = StorefrontPageAssignBag::coalesce($this->getData('storefront_offers'), 'storefront_offers', []);
$offers = is_array($offers) ? $offers : [];
$cartGuestToken = trim((string)($this->getData('cart_guest_token') ?? ''));
$activePrice = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_price'), 'storefront_listing_price', ''));
$totalCount = max(0, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_total'), 'storefront_listing_total', count($offers)));
$visibleCount = max(0, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_count'), 'storefront_listing_count', count($offers)));
$page = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page'), 'storefront_listing_page', 1));
$pageSize = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page_size'), 'storefront_listing_page_size', 24));
$totalPages = max(1, (int)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_total_pages'), 'storefront_listing_total_pages', 1));
$pageOptions = StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_page_options'), 'storefront_listing_page_options', []);
$pageOptions = is_array($pageOptions) ? $pageOptions : [];
$sortOptions = StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_sort_options'), 'storefront_listing_sort_options', []);
$sortOptions = is_array($sortOptions) ? $sortOptions : [];
$heading = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_heading'), 'storefront_heading', __('全部商品')));
$lede = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_lede'), 'storefront_lede', __('浏览当前网站已发布的商品，可按分类与价格筛选。')));
$listingPath = trim((string)StorefrontPageAssignBag::coalesce($this->getData('storefront_listing_path'), 'storefront_listing_path', '/products'));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$from = $visibleCount > 0 ? (($page - 1) * $pageSize) + 1 : 0;
$to = $visibleCount > 0 ? min($page * $pageSize, $visibleCount) : 0;
$ssrFiltered = (bool)StorefrontPageAssignBag::coalesce(
    $this->getData('storefront_listing_ssr_filtered'),
    'storefront_listing_ssr_filtered',
    false,
);
?>
<section class="product-storefront"
         data-testid="storefront-product-catalog"
         data-storefront-listing="1"
         data-listing-surface="products"
         data-listing-path="<?= $escape($listingPath) ?>"
         data-listing-ssr-filtered="<?= $ssrFiltered ? '1' : '0' ?>"
         data-weline-load="storefrontListing"
         data-weline-load-when="idle"
         data-listing-loading-label="<lang>加载中…</lang>"
         weline-code="product.frontend.catalog.section_1">
    <header class="product-storefront__header">
        <h1><?= $escape($heading) ?></h1>
        <p class="product-storefront__lede"><?= $escape($lede) ?></p>
    </header>

    <div class="product-storefront__toolbar" data-testid="storefront-products-toolbar">
        <p class="product-storefront__count" data-listing-count>
            <?php if ($visibleCount > 0): ?>
                <lang args="[$from, $to, $visibleCount]">第 %{1}–%{2} 件，共 %{3} 件商品</lang>
            <?php else: ?>
                <lang>0 件商品</lang>
            <?php endif; ?>
            <span class="product-storefront__count-hint" data-listing-count-hint hidden></span>
        </p>
        <?php if ($sortOptions !== []): ?>
            <label class="product-storefront__sort">
                <span><lang>排序</lang>:</span>
                <select class="product-storefront__sort-select"
                        data-testid="storefront-products-sort"
                        data-listing-sort>
                    <?php foreach ($sortOptions as $option): ?>
                        <?php
                        if (!is_array($option)) {
                            continue;
                        }
                        $code = trim((string)($option['code'] ?? ''));
                        if ($code === '') {
                            continue;
                        }
                        ?>
                        <option value="<?= $escape($code) ?>"<?= !empty($option['selected']) ? ' selected' : '' ?>>
                            <?php
                            // Literal __() so Taglib can prefetch heavy locale packs;
                            // dynamic __($var) is not collected and falls back to Chinese.
                            $sortLabel = match ($code) {
                                'default' => (string)__('默认排序'),
                                'price_asc' => (string)__('价格从低到高'),
                                'price_desc' => (string)__('价格从高到低'),
                                'name_asc' => (string)__('名称 A-Z'),
                                default => (string)__((string)($option['label'] ?? '')),
                            };
                            ?>
                            <?= $escape($sortLabel) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </label>
        <?php endif; ?>
    </div>

    <div class="product-storefront__notice" data-testid="catalog-message" aria-live="polite"></div>

    <div data-listing-stage>
    <?php if ($offers === []): ?>
        <div class="product-storefront__empty" data-testid="storefront-product-empty" data-listing-empty>
            <lang>当前网站暂无已发布商品。</lang>
        </div>
    <?php else: ?>
        <div class="product-storefront__grid weline-product-card-shelf" data-listing-grid>
            <?= ProductCardRenderer::projectFromOffers($offers, [
                'show_price' => true,
                'show_add_to_cart' => true,
                'show_wishlist' => true,
                'show_compare' => true,
                'show_quickview' => true,
                'show_labels' => true,
                'show_sku' => true,
                'density' => 'standard',
                'class' => 'wpc-listing-card',
                'wishlist_pixel' => true,
            ]) ?>
        </div>
        <nav class="product-storefront__pager"
             data-testid="storefront-products-pager"
             data-listing-pager
             aria-label="<?= $escape(WidgetI18n::label('分页')) ?>"
             <?= ($totalPages > 1 && $pageOptions !== []) ? '' : 'hidden' ?>>
            <?php foreach ($pageOptions as $option): ?>
                <?php
                if (!is_array($option)) {
                    continue;
                }
                $type = (string)($option['type'] ?? 'page');
                $pageNum = max(1, (int)($option['page'] ?? 1));
                $label = (string)($option['label'] ?? $option['page'] ?? '');
                if ($type === 'prev') {
                    $label = WidgetI18n::label('上一页');
                } elseif ($type === 'next') {
                    $label = WidgetI18n::label('下一页');
                }
                if ($label === '') {
                    continue;
                }
                if ($type === 'ellipsis') {
                    ?>
                    <span class="product-storefront__pager-item is-ellipsis" aria-hidden="true"><?= $escape($label) ?></span>
                    <?php
                    continue;
                }
                if ($type === 'prev' || $type === 'next') {
                    $disabled = !empty($option['disabled']);
                    if ($disabled) {
                        ?>
                        <span class="product-storefront__pager-item is-nav is-disabled" aria-disabled="true"><?= $escape($label) ?></span>
                        <?php
                    } else {
                        ?>
                        <button type="button"
                                class="product-storefront__pager-item is-nav"
                                data-listing-page="<?= $pageNum ?>"><?= $escape($label) ?></button>
                        <?php
                    }
                    continue;
                }
                ?>
                <?php if (!empty($option['selected'])): ?>
                    <span class="product-storefront__pager-item is-current" aria-current="page"><?= $escape($label) ?></span>
                <?php else: ?>
                    <button type="button"
                            class="product-storefront__pager-item"
                            data-listing-page="<?= $pageNum ?>"><?= $escape($label) ?></button>
                <?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>
    </div>

    <a class="product-storefront__cart" href="@url{'cart'}" data-testid="view-cart" hidden>
        <lang>查看购物车</lang>
    </a>
</section>

<style>
    .product-storefront { width:100%; min-width:0; margin:0; padding:0 0 var(--spacing-2xl); color:var(--weline-theme-color-text); }
    .product-storefront__header { margin:0 0 var(--spacing-2); }
    .product-storefront__header h1 { margin:0; font-size:var(--font-size-2_5xl); font-weight:700; line-height:1.25; }
    .product-storefront__lede { margin:var(--spacing-1_5) 0 0; color:var(--color-text-gray); font-size:var(--font-size-13); line-height:1.4; }
    .product-storefront__toolbar {
        display:flex;
        flex-wrap:wrap;
        align-items:center;
        justify-content:space-between;
        gap:var(--spacing-2_5) var(--spacing-4);
        margin:0 0 var(--spacing-3_5);
        padding:var(--spacing-2) 0 var(--spacing-2_5);
        border-bottom:var(--border-width-thin) solid var(--color-border-muted);
    }
    .product-storefront__count { margin:0; font-size:var(--font-size-sm); color:var(--weline-theme-color-text); }
    .product-storefront__count-hint { margin-left:var(--spacing-1_5); color:var(--color-text-gray); }
    .product-storefront__sort {
        display:inline-flex;
        align-items:center;
        gap:var(--spacing-1_5);
        margin:0 0 0 auto;
        font-size:var(--font-size-13);
        color:var(--color-text-gray);
        white-space:nowrap;
    }
    .product-storefront__sort-select {
        min-height:var(--control-height-sm);
        padding:var(--spacing-1) var(--spacing-7) var(--spacing-1) var(--spacing-2_5);
        border:var(--border-width-thin) solid var(--color-border-faint);
        border-radius:var(--radius-lg);
        background:var(--color-bg-muted);
        color:inherit;
        font:inherit;
        box-shadow: var(--weline-shadow-md);
    }
    .product-storefront__notice { min-height:0; margin:0 0 var(--spacing-2_5); color:var(--color-text-secondary); font-size:var(--font-size-13); }
    .product-storefront__notice.is-error { color:var(--color-link); }
    .product-storefront__grid {
        display:grid;
        grid-template-columns:repeat(4, minmax(0, 1fr));
        gap:var(--spacing-3);
        align-items:stretch;
    }
    .product-storefront__grid > .weline-product-card {
        min-width:0;
        height:100%;
    }
    .product-storefront__pager {
        display:flex;
        flex-wrap:wrap;
        gap:var(--spacing-2);
        margin:var(--spacing-4_5) 0 0;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item {
        min-width:34px;
        min-height:var(--control-height-sm);
        padding:0 var(--spacing-2_5);
        border:var(--border-width-thin) solid var(--color-border-faint);
        border-radius:var(--radius-lg);
        background:var(--color-bg-primary);
        color:var(--weline-theme-color-text);
        font:inherit;
        font-size:var(--font-size-13);
        font-weight:600;
        text-decoration:none;
        cursor:pointer;
        display:inline-flex;
        align-items:center;
        justify-content:center;
    }
    .product-storefront__pager-item.is-current {
        border-color:var(--color-border-default);
        background:var(--color-bg-dark-secondary);
        color:var(--color-text-light);
    }
    .product-storefront__pager-item.is-ellipsis {
        border:0;
        background:transparent;
        min-width:auto;
        padding:0 var(--spacing-1);
        color:var(--color-text-gray);
        font-weight:500;
        cursor:default;
    }
    .product-storefront__pager-item.is-nav {
        padding:0 var(--spacing-3);
    }
    .product-storefront__pager-item.is-disabled {
        opacity:.45;
        cursor:not-allowed;
    }
    .product-storefront__empty {
        padding:var(--spacing-7) var(--spacing-4);
        border:var(--border-width-thin) dashed var(--color-border-faint);
        border-radius:var(--radius-lg);
        color:var(--color-text-gray);
        text-align:center;
        background:var(--color-bg-primary);
    }
    .storefront-listing-loading {
        margin:0 0 var(--spacing-2_5);
        padding:var(--spacing-2) var(--spacing-3);
        border-radius:var(--radius-lg);
        background:var(--color-bg-muted);
        color:var(--color-text-gray);
        font-size:var(--font-size-13);
        font-weight:600;
        line-height:1.35;
    }.storefront-listing-loading[hidden]{ display: none; }
    .product-storefront.is-listing-loading [data-listing-stage] {
        opacity:.45;
        pointer-events:none;
        transition:opacity .15s ease;
    }
    .product-storefront.is-listing-loading [data-listing-sort] {
        pointer-events:none;
        opacity:.7;
    }
    @media (max-width:1200px) {
        .product-storefront__grid { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width:900px) {
        .product-storefront__grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width:768px) {
        .product-storefront__toolbar { align-items:stretch; }
        .product-storefront__sort { width:100%; justify-content:space-between; }
        .product-storefront__sort-select { flex:1; }
    }
    @media (max-width:520px) {
        .product-storefront__grid { grid-template-columns:1fr; }
    }
</style>
