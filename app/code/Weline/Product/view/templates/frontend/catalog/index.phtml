        position:relative;
        display:flex;
        flex-direction:column;
        min-width:0;
        overflow:hidden;
        border:1px solid #d5d9d9;
        border-radius:8px;
        background:#fff;
    }
    .product-storefront__card.is-clickable { cursor:pointer; }
    .product-storefront__card.is-clickable:hover { border-color:#bbb; }
