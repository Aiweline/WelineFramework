        display:-webkit-box;
        -webkit-line-clamp:2;
        -webkit-box-orient:vertical;
        overflow:hidden;
        min-height:2.5em;
    }
    .product-storefront__sku { margin:0; color:#565959; font-size:11px; }
    .product-storefront__price { margin:2px 0 0; font-size:16px; font-weight:700; line-height:1.2; }
    .product-storefront__add,.product-storefront__cart {
        position:relative;
        z-index:2;
