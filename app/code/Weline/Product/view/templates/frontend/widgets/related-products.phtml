<?php
/**
 * Product-owned related products for the PDP related slot.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {related-products}
 * @widget.name {相关产品}
 * @widget.description {展示与当前产品相关的其他产品（真实目录报价）}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.supports {["layout-product-related-products","related-products"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-related-products", "area":"content", "sort_order":0, "required":true, "reason":"商品详情默认相关产品槽", "config":{"title":"相关产品","limit":4,"columns":"4","layout":"carousel"} }]}
 *
 * @param title {default="相关产品",type="string",label="标题"}
 * @param limit {default=4,type="number",label="显示数量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列"}}
 * @param layout {default="carousel",type="select",label="布局方式",options={grid:"网格",carousel:"轮播"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 */

use Weline\Framework\Http\Url;
use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\ProductCardRenderer;
use Weline\Product\Service\StorefrontProductWidgetCatalog;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('related-products');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '相关产品';
if (preg_match('/^Weline_[A-Za-z0-9_]+$/', $titleSource)) {
    $titleSource = '相关产品';
}
$widgetTitle = WidgetI18n::label($titleSource, '相关产品');
$limit = max(1, min(24, (int)($this->getData('limit') ?? 4)));
$columns = (string)($this->getData('columns') ?? '4');
$layout = (string)($this->getData('layout') ?? 'carousel');
if (!in_array($columns, ['2', '3', '4', '5'], true)) {
    $columns = '4';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'carousel';
}

$excludeProductId = (int)($this->getData('product_id') ?? 0);
$offer = $this->getData('storefront_offer');
if ($excludeProductId <= 0 && is_array($offer)) {
    $excludeProductId = (int)($offer['product_id'] ?? 0);
}
$currentProduct = $this->getData('product');
if ($excludeProductId <= 0 && is_array($currentProduct)) {
    $excludeProductId = (int)($currentProduct['product_id'] ?? $currentProduct['entity_id'] ?? 0);
} elseif ($excludeProductId <= 0 && is_object($currentProduct)) {
    if (method_exists($currentProduct, 'getId')) {
        $excludeProductId = (int)$currentProduct->getId();
    }
}
if ($excludeProductId <= 0) {
    try {
        $resolvedOffer = \Weline\Product\Helper\StorefrontOfferResolver::resolve($this);
        $excludeProductId = max(0, (int)($resolvedOffer['product_id'] ?? 0));
    } catch (\Throwable) {
        $excludeProductId = 0;
    }
}

$products = [];
try {
    // Theme-editor product layout preview often has no PDP identity
    // (no theme_public_route / storefront_offer). Hitting the real catalog
    // cold-builds every published offer and can stall the iframe for minutes.
    // Match bestsellers: demo cards only for preview shells without a product.
    $editorPreview = $isPreviewMode || (bool)($this->getData('editor_mode') ?? false);
    if ($editorPreview && $excludeProductId <= 0) {
        $products = \Weline\Theme\Helper\ThemeDemoCatalog::products($limit, 21);
    } else {
        $products = ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)
            ->relatedCards($excludeProductId, $limit);
    }
} catch (\Throwable) {
    $products = [];
}

if ($products === [] && ($isPreviewMode || (bool)($this->getData('editor_mode') ?? false))) {
    $products = \Weline\Theme\Helper\ThemeDemoCatalog::products($limit, 21);
}

foreach ($products as &$product) {
    $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
    $product['id'] = $productId;
    $route = trim((string)($product['url'] ?? ''));
    if (str_starts_with($route, 'http://') || str_starts_with($route, 'https://') || str_starts_with($route, '//')) {
        $product['url'] = $route;
    } else {
        $path = '/' . ltrim($route, '/');
        $prefix = rtrim(Url::getPrefix(), '/');
        $hasCurrentPrefix = $prefix !== ''
            && ($path === $prefix || str_starts_with($path, $prefix . '/'));
        $product['url'] = $hasCurrentPrefix
            ? $path
            : ($prefix !== '' ? $prefix : '') . $path;
    }
}
unset($product);

$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);

if ($products === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty
    // HTML as a warning toast. Keep visually hidden so storefront still "hides".
    ?>
<section class="<?= $esc($wc) ?> weline-product-related<?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="related-products-empty"
         hidden
         aria-hidden="true"></section>
    <?php
    return;
}
?>


<section class="<?= $esc($wc) ?> weline-product-related<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-testid="storefront-related-products"
         data-weline-load="relatedProducts"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-layout="<?= $esc($layout) ?>"
         data-columns="<?= $esc($columns) ?>">
    <link rel="stylesheet"
          href="@static(Weline_Product::css/widgets/related-products.css)?v=20260906-product-card1"
          data-no-extract="true">
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
    <header class="wpr-header">
        <h2 class="wpr-title"><?= $esc($widgetTitle) ?></h2>
        <p class="wpr-subtitle"><?= $esc((string)__('Customers also viewed')) ?></p>
    </header>

    <div class="wpr-stage" data-wpr-stage>
        <?php if ($layout === 'carousel'): ?>
            <button class="wpr-nav wpr-nav--prev" type="button" data-wpr-prev aria-label="<?= $esc((string)__('上一组')) ?>">
                <span aria-hidden="true">‹</span>
            </button>
        <?php endif; ?>

        <div class="wpr-viewport" data-wpr-viewport>
            <div class="wpr-track columns-<?= $esc($columns) ?> layout-<?= $esc($layout) ?>" data-wpr-track>
                <?php foreach ($products as $product): ?>
                    <w:product:card product="product" show-price="true" show-rating="true" show-add-to-cart="true" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" density="standard" class="wpr-card" wishlist-pixel="true" />
                <?php endforeach; ?>
            </div>
        </div>

        <?php if ($layout === 'carousel'): ?>
            <button class="wpr-nav wpr-nav--next" type="button" data-wpr-next aria-label="<?= $esc((string)__('下一组')) ?>">
                <span aria-hidden="true">›</span>
            </button>
        <?php endif; ?>
    </div>
</section>

<?php // relatedProducts：由部件根 data-weline-load 声明，禁止 @static 直引 ?>
