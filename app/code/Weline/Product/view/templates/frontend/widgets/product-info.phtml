 * @param show_brand {default=true,type="bool",label="显示品牌"}
 * @param show_supplier {default=true,type="bool",label="显示供应商"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Helper\StorefrontOfferResolver;
use Weline\Product\Helper\StorefrontVariantContextResolver;
use Weline\Product\Api\Data\StorefrontPriceContext;
use Weline\Product\Api\StorefrontOfferPriceAssemblerInterface;
use Weline\Product\Service\ProductQuoteRequestCaptchaGuard;
use Weline\Product\Service\ProductStorefrontBreadcrumbBuilder;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-info');
$showBrand = filter_var($this->getData('show_brand') ?? true, FILTER_VALIDATE_BOOLEAN);
$showSupplier = filter_var($this->getData('show_supplier') ?? true, FILTER_VALIDATE_BOOLEAN);
$quickAdd = filter_var($this->getData('quick_add') ?? false, FILTER_VALIDATE_BOOLEAN);
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false)
    || (string)($this->getData('editor_mode') ?? '') === '1';
$hasPublicRoute = false;
try {
    $request = $this->getRequest();
    if ((string)$request->getParam('editor_mode', '') === '1'
        || (string)$request->getParam('preview_mode', '') === 'live'
        || (string)$request->getParam('interaction_mode', '') === 'edit'
    ) {
        $isPreviewMode = true;
    }
    $requestPath = \strtolower(\trim(\str_replace('\\', '/', (string)($request->getUrlPath() ?: $request->getUri() ?: '')), '/'));
    if (\str_contains($requestPath, '?')) {
        $requestPath = \explode('?', $requestPath, 2)[0];
    }
    $hasPublicRoute = (bool)\preg_match('#^product/([a-z0-9][a-z0-9-]*)#', $requestPath)
        || (int)$request->getParam('id', 0) > 0
        || \trim((string)$request->getParam('slug', '')) !== '';
} catch (\Throwable) {
    // Template may not expose Request in all render paths.
}
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);

$offer = $this->getData('storefront_offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$storefrontOffers = $this->getData('storefront_offers') ?? [];
$storefrontOffers = is_array($storefrontOffers)
    ? array_values(array_filter($storefrontOffers, 'is_array'))
    : [];
$selectedOfferUuid = trim((string)($this->getData('selected_offer_uuid') ?? ''));

// Prefer catalog resolve (path/query/assigns) before editor mock.
if ($offer === []) {
    $offer = StorefrontOfferResolver::resolve($this);
    $offer = is_array($offer) ? $offer : [];
}

if ($offer === [] && $isPreviewMode) {
    $offer = [
        'product_id' => 0,
        'provider_code' => 'product',
        'global_offer_uuid' => '',
        'name' => 'R43 Storefront Product',
        'sku' => 'R43-STORE-PREVIEW',
        'image' => '',
        'images' => [],
        'currency' => 'USD',
        'unit_price_minor' => 0,
        'stock' => 0,
        'sellable' => false,
        'quote_only' => false,
        'message' => '',
        'short_description' => '',
        'description' => '',
        'specifications' => [],
        'attribute_set_label' => 'Published Products',
        'brand' => 'R43 Brand',
        'supplier_name' => 'R43 Supplier',
    ];
}

if ($offer === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty HTML as a warning,
    // and the product-main slot would collapse with no diagnostic surface.
    ?>
<section class="<?= $escape($scope->cssClass) ?> product-native-detail product-native-detail--unavailable"
         data-testid="storefront-product-detail-unavailable"
         data-widget-module="Weline_Product"
         data-widget-code="product-info"
         data-uid="<?= $escape($scope->uid) ?>"
         weline-code="<?= $escape($scope->code) ?>">
    <p class="product-native-detail__unavailable-message"><?= __('商品信息暂不可用') ?></p>
</section>
    <?php
    return;
}

/** @var StorefrontVariantContextResolver $variantContext */
$variantContext = ObjectManager::getInstance(StorefrontVariantContextResolver::class);
if ($isPreviewMode && !$hasPublicRoute) {
    // Layout editor canvas: keep the single demo offer — no variant catalog work.
    $storefrontOffers = $storefrontOffers === [] ? [$offer] : $storefrontOffers;
    $variantCatalog = [];
} else {
if ($storefrontOffers === []) {
    $storefrontOffers = $variantContext->resolveOffers($this);
}
$variantCatalog = $this->getData('variant_catalog') ?? [];
$variantCatalog = is_array($variantCatalog) ? $variantCatalog : [];
if (count($storefrontOffers) > 1
    && (!is_array($variantCatalog['offers'] ?? null) || $variantCatalog['offers'] === [])
) {
    $variantCatalog = $variantContext->buildCatalog($this, $storefrontOffers, null);
    $selectedOffer = $variantCatalog['selected_offer'] ?? null;
    if (is_array($selectedOffer) && $selectedOffer !== []) {
        $offer = $selectedOffer;
        $selectedOfferUuid = trim((string)($offer['global_offer_uuid'] ?? $selectedOfferUuid));
    }
}
unset($variantCatalog['selected_offer']);
}
$minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
$catalogPriceMinor = max(0, (int)($offer['catalog_price_minor'] ?? $minor));
$productId = max(0, (int)($offer['product_id'] ?? 0));
$dealDiscountType = '';
$dealDiscountValue = 0.0;
$hasUnifiedPrice = array_key_exists('has_deal', $offer)
    && array_key_exists('compare_at_minor', $offer);
$hasActiveDeal = $hasUnifiedPrice && !empty($offer['has_deal']);
$originalPriceMinor = $hasUnifiedPrice
    ? max(0, (int)$offer['compare_at_minor'])
    : $catalogPriceMinor;
$campaignLabel = $hasUnifiedPrice ? trim((string)($offer['campaign_label'] ?? '')) : '';
$campaignUrl = $hasUnifiedPrice ? trim((string)($offer['campaign_url'] ?? '')) : '';
$eligibleCampaigns = [];
if ($hasUnifiedPrice && is_array($offer['eligible_campaigns'] ?? null)) {
    foreach ($offer['eligible_campaigns'] as $campaignRow) {
        if (!is_array($campaignRow)) {
            continue;
        }
        $campaignThemeId = (int)($campaignRow['theme_id'] ?? 0);
        $campaignRowLabel = trim((string)($campaignRow['label'] ?? ''));
        if ($campaignThemeId <= 0 || $campaignRowLabel === '') {
            continue;
        }
        $eligibleCampaigns[] = [
            'theme_id' => $campaignThemeId,
            'label' => $campaignRowLabel,
            'url' => trim((string)($campaignRow['url'] ?? '')),
            'deal_discount_type' => (string)($campaignRow['deal_discount_type'] ?? ''),
            'deal_discount_value' => (float)($campaignRow['deal_discount_value'] ?? 0),
            'page_slug' => (string)($campaignRow['page_slug'] ?? ''),
        ];
    }
}
$dealDiscountType = $hasUnifiedPrice ? trim((string)($offer['deal_discount_type'] ?? '')) : '';
$dealDiscountValue = $hasUnifiedPrice ? (float)($offer['deal_discount_value'] ?? 0) : 0.0;
$selectedCampaignThemeId = 0;
if (!$hasUnifiedPrice && $productId > 0 && $catalogPriceMinor > 0) {
    try {
        $priceAssembler = null;
        if (interface_exists(StorefrontOfferPriceAssemblerInterface::class)) {
            try {
                $priceAssembler = ObjectManager::getInstance(StorefrontOfferPriceAssemblerInterface::class);
            } catch (\Throwable) {
                $priceAssembler = null;
            }
        }
        if (!$priceAssembler instanceof StorefrontOfferPriceAssemblerInterface
            && class_exists(\Weline\Product\Service\Storefront\StorefrontOfferPriceAssembler::class)
        ) {
            $priceAssembler = ObjectManager::getInstance(
                \Weline\Product\Service\Storefront\StorefrontOfferPriceAssembler::class,
            );
        }
        if ($priceAssembler instanceof StorefrontOfferPriceAssemblerInterface) {
            $priceView = $priceAssembler->assemble(StorefrontPriceContext::fromCatalogMinor(
                $productId,
                $catalogPriceMinor,
                (string)($offer['currency'] ?? 'CNY'),
            ));
            if ($priceView->hasDeal) {
                $hasActiveDeal = true;
                $minor = $priceView->finalPriceMinor;
                $originalPriceMinor = $priceView->compareAtMinor;
                $campaignLabel = $priceView->campaignLabel();
                $campaignUrl = $priceView->campaignUrl();
                $eligibleCampaigns = $priceView->eligibleCampaigns;
                $primary = $priceView->appliedAdjustments[0] ?? null;
                if ($primary !== null) {
                    $dealDiscountType = $primary->type;
                    $dealDiscountValue = $primary->value;
                    $selectedCampaignThemeId = (int)$primary->sourceId;
                }
            }
        }
    } catch (\Throwable) {
        // Product remains usable when price providers are unavailable.
    }
}
if ($selectedCampaignThemeId <= 0 && $eligibleCampaigns !== []) {
    $selectedCampaignThemeId = (int)($eligibleCampaigns[0]['theme_id'] ?? 0);
}
$canPickCampaign = count($eligibleCampaigns) > 1;
$stock = max(0, (int)($offer['stock'] ?? 0));
$sellable = !empty($offer['sellable']);
$quoteOnly = !empty($offer['quote_only']);
$currencyUnavailable = !empty($offer['currency_unavailable']);
$offerUuid = trim((string)($offer['global_offer_uuid'] ?? ''));
$shippingProfileCode = trim((string)($offer['shipping_profile_code']
    ?? ($offer['fulfillment_metadata']['shipping_profile_code'] ?? '')));
$requiresShipping = array_key_exists('requires_shipping', $offer)
    ? (bool)$offer['requires_shipping']
    : true;
$shippingHint = null;
try {
    $shipReg = ObjectManager::getInstance(
        \Weline\Product\Service\Storefront\StorefrontShippingProfileCatalogProviderRegistry::class,
    );
    $shipProvider = $shipReg->primary();
    if ($shipProvider !== null) {
        $shippingHint = $shipProvider->previewHint($shippingProfileCode, $requiresShipping);
    }
} catch (\Throwable) {
    $shippingHint = null;
}
if (!is_array($shippingHint)) {
    $shippingHint = null;
}
$name = trim((string)($offer['name'] ?? ''));
$image = trim((string)($offer['image'] ?? ''));
$images = array_values(array_filter(
    array_map(static fn(mixed $value): string => trim((string)$value), (array)($offer['images'] ?? [])),
    static fn(string $value): bool => $value !== '',
));
if ($image !== '' && !in_array($image, $images, true)) {
    array_unshift($images, $image);
}
$image = $images[0] ?? $image;
$primaryResolved = StorefrontImagePlaceholder::resolve($image, $productId);
$image = $primaryResolved['src'];
$imageFallback = $primaryResolved['fallback'];
if ($images === []) {
    $images = [$image];
} else {
    $images = array_values(array_map(
        static function (string $galleryImage, int $index) use ($productId): string {
            return StorefrontImagePlaceholder::resolve($galleryImage, $productId + $index)['src'];
        },
        $images,
        array_keys($images),
    ));
    if ($images[0] !== $image) {
        array_unshift($images, $image);
        $images = array_values(array_unique($images));
    }
}
$videos = array_values(array_filter(
    (array)($offer['videos'] ?? []),
    static fn(mixed $video): bool => is_array($video)
        && trim((string)($video['embed_url'] ?? $video['src'] ?? '')) !== '',
));
$galleryItems = [];
foreach ($images as $index => $galleryImage) {
    $galleryItems[] = [
        'type' => 'image',
        'src' => $galleryImage,
        'poster' => $galleryImage,
        'provider' => '',
        'mime_type' => '',
    ];
}
foreach ($videos as $video) {
    $embedUrl = trim((string)($video['embed_url'] ?? $video['src'] ?? ''));
    if ($embedUrl === '') {
        continue;
    }
    $galleryItems[] = [
        'type' => 'video',
        'src' => $embedUrl,
        'poster' => trim((string)($video['poster'] ?? '')),
        'provider' => strtolower(trim((string)($video['provider'] ?? 'file'))),
        'mime_type' => trim((string)($video['mime_type'] ?? '')),
    ];
}
if ($galleryItems === [] && $image !== '') {
    $galleryItems[] = [
        'type' => 'image',
        'src' => $image,
        'poster' => $image,
        'provider' => '',
        'mime_type' => '',
    ];
}
$shortDescription = trim((string)($offer['short_description'] ?? ''));
$description = trim((string)($offer['description'] ?? ''));
$descriptionHtml = trim((string)($offer['description_html'] ?? ''));
if ($descriptionHtml !== '' && $name !== '') {
    $descriptionHtml = \Weline\Product\Service\StorefrontProductMediaUrlResolver::ensureDescriptionImageAlts(
        $descriptionHtml,
        $name,
    );
    $descriptionHtml = \Weline\Product\Service\StorefrontProductMediaUrlResolver::normalizeDescriptionLayout(
        $descriptionHtml,
    );
}
$specifications = array_values(array_filter(
    (array)($offer['specifications'] ?? []),
    static fn(mixed $specification): bool => is_array($specification)
        && trim((string)($specification['code'] ?? '')) !== ''
        && trim((string)($specification['value'] ?? '')) !== '',
));
$specificationLabels = [
    'product_type' => __('商品类型'),
    'attribute_set' => __('属性集'),
    'attribute_set_label' => __('属性集'),
    'brand' => __('品牌'),
    'model' => __('型号'),
    'color' => __('颜色'),
    'size' => __('尺码'),
    'style_type' => __('类型'),
    'storage' => __('存储容量'),
    'chipset' => __('处理器'),
    'battery' => __('电池容量'),
    'charging' => __('充电规格'),
    'network' => __('网络制式'),
    'coverage_area' => __('适用面积'),
    'filter_type' => __('滤芯类型'),
    'power' => __('功率'),
    'noise_level' => __('噪音'),
    'smart_control' => __('智能控制'),
    'connectivity' => __('连接方式'),
    'ports' => __('接口数量'),
    'power_delivery' => __('PD 供电'),
    'compatibility' => __('兼容设备'),
    'dpi' => __('DPI'),
    'runtime' => __('续航时间'),
    'suction' => __('吸力'),
    'weight_kg' => __('重量'),
    'volume' => __('容量'),
    'scent' => __('香型'),
    'material' => __('材质'),
    'dimensions' => __('尺寸'),
    'formaldehyde_cadr' => __('甲醛 CADR'),
    'unlock_methods' => __('开锁方式'),
    'accessories' => __('配件'),
    'suitable_for' => __('适用面料'),
    'shelf_life' => __('保质期'),
    'care_instructions' => __('保养说明'),
    'warranty_months' => __('质保(月)'),
    'series' => __('系列'),
    'engine' => __('发动机'),
    'displacement' => __('排量'),
    'max_power' => __('最大功率'),
    'max_torque' => __('最大扭矩'),
    'seat_height' => __('座高'),
    'ground_clearance' => __('离地间隙'),
    'fuel_tank' => __('油箱容量'),
    'curb_weight' => __('整备质量'),
    'tyres' => __('轮胎'),
];
$attributeSetLabel = trim((string)($offer['attribute_set_label'] ?? ''));
$variantAxes = array_values(array_filter(
    (array)($offer['variant_axes'] ?? []),
    static fn(mixed $axis): bool => is_array($axis)
        && trim((string)($axis['code'] ?? '')) !== '',
));
$hasInteractiveVariants = count($storefrontOffers) > 1
    && is_array($variantCatalog['axes'] ?? null)
    && $variantCatalog['axes'] !== [];
$interactiveVariantAxes = $hasInteractiveVariants
    ? array_values((array)$variantCatalog['axes'])
    : $variantAxes;
$specificationLabel = static function (string $code, string $rawLabel = '') use ($specificationLabels): string {
    $rawLabel = trim($rawLabel);
    // Prefer EAV LocalDescription, then known map, then code — always resolve via
    // WidgetI18n so Chinese source labels still localize for non-zh storefronts.
    // Avoid bare __() on already-English locals (legacy CSV reverse maps).
    if ($rawLabel !== '') {
        return WidgetI18n::label($rawLabel);
    }
    if (array_key_exists($code, $specificationLabels)) {
        return WidgetI18n::label((string)$specificationLabels[$code]);
    }

    return WidgetI18n::label(ucwords(str_replace('_', ' ', $code)));
};
$brandName = trim((string)($offer['brand'] ?? ''));
if ($brandName === '') {
    foreach ($specifications as $specification) {
        if (strtolower(trim((string)($specification['code'] ?? ''))) === 'brand') {
            $brandName = trim((string)($specification['value'] ?? ''));
            break;
        }
    }
}
$supplierName = trim((string)($offer['supplier_name'] ?? ''));
$summaryBullets = [];
if ($shortDescription !== '') {
    $parts = preg_split('/[。；;\n]\s*/u', $shortDescription, -1, PREG_SPLIT_NO_EMPTY);
    $summaryBullets = array_values(array_filter(array_map(static fn(string $value): string => trim($value), $parts ?: [])));
    if ($summaryBullets === []) {
        $summaryBullets = [$shortDescription];
    }
}
$currencyCode = strtoupper(trim((string)($offer['currency'] ?? 'CNY')));
$currencySymbol = \Weline\Currency\Helper\CurrencySymbol::forCode($currencyCode);
$currencySymbolClientMap = \Weline\Currency\Helper\CurrencySymbol::clientMap();
$priceWhole = (int) floor($minor / 100);
$priceFraction = sprintf('%02d', $minor % 100);
$stockLabel = $quoteOnly
    ? __('按项目确认库存')
    : ($stock > 0
        ? ($stock <= 10 ? __('仅剩 %{1} 件', [$stock]) : __('有货'))
        : __('暂时缺货'));
$stockTone = ($currencyUnavailable && $stock > 0) || (!$quoteOnly && $stock > 0 && $sellable)
    ? 'in-stock'
    : 'out-stock';
$requiresShipping = !isset($offer['requires_shipping']) || !empty($offer['requires_shipping']);
$showPrimeBadge = $sellable && $requiresShipping && !$quoteOnly;
$maxQty = $quoteOnly ? 1 : max(1, min(30, $stock > 0 ? $stock : 30));
$tobMoq = 5;
$tobStep = 5;
try {
    if (class_exists(\Weline\B2B\Service\SellingModePolicy::class)) {
        $tobPolicy = ObjectManager::getInstance(\Weline\B2B\Service\SellingModePolicy::class);
        $tobMoq = max(1, (int)$tobPolicy->defaultMoq());
        $tobStep = max(1, (int)$tobPolicy->defaultQtyStep());
    }
} catch (\Throwable) {
}
$reviewRating = 0.0;
$reviewCount = 0;
if ($offerUuid !== '' && class_exists(\Weline\Review\Service\ReviewService::class)) {
    try {
        $reviewFacts = ObjectManager::getInstance(\Weline\Review\Service\ReviewService::class)
            ->seoFacts('product', $offerUuid, 1);
        $reviewRating = max(0.0, (float)($reviewFacts['average_rating'] ?? 0));
        $reviewCount = max(0, (int)($reviewFacts['review_count'] ?? 0));
    } catch (\Throwable) {
        $reviewRating = 0.0;
        $reviewCount = 0;
    }
}
$qtyFieldId = 'product-qty-' . max(0, $productId);
$quoteCaptchaHtml = '';
try {
    $quoteCaptchaHtml = (string)ObjectManager::getInstance(ProductQuoteRequestCaptchaGuard::class)->renderChallenge();
} catch (\Throwable) {
    $quoteCaptchaHtml = '';
}
$productBreadcrumbs = $this->getData('storefront_product_breadcrumbs') ?? [];
$productBreadcrumbs = is_array($productBreadcrumbs) ? $productBreadcrumbs : [];
if ($productBreadcrumbs === []) {
    $rememberedCrumbs = ProductStorefrontBreadcrumbBuilder::remembered();
    if (is_array($rememberedCrumbs) && ($rememberedCrumbs['primary'] ?? []) !== []) {
        $productBreadcrumbs = $rememberedCrumbs['primary'];
    }
}
?>
<section class="product-native-detail product-native-detail--amazon<?= $isPreviewMode ? ' is-preview' : '' ?><?= $quickAdd ? ' product-native-detail--quick-add' : '' ?>"
         data-product-id="<?= (int)$productId ?>"
         data-testid="storefront-product-detail"
         data-deal-type="<?= $escape($dealDiscountType) ?>"
         data-deal-value="<?= $escape((string)$dealDiscountValue) ?>"
         data-promotion-theme-id="<?= (int)$selectedCampaignThemeId ?>"
         data-catalog-price-minor="<?= (int)$catalogPriceMinor ?>"
         data-offer-price-minor="<?= (int)$minor ?>"
         data-price="<?= $escape(number_format($minor / 100, 2, '.', '')) ?>"
         data-pixel-value="<?= $escape(number_format($minor / 100, 2, '.', '')) ?>"
         data-pixel-currency="<?= $escape($currencyCode) ?>"
         data-currency="<?= $escape($currencyCode) ?>"
         data-quick-add="<?= $quickAdd ? '1' : '0' ?>"
         data-widget-module="Weline_Product"
         data-widget-code="product-info"
         data-uid="<?= $escape($scope->uid) ?>"
         weline-code="<?= $escape($scope->code) ?>">
    <span class="weline-pixel::view_item"
          data-pixel-event="view_item"
          data-testid="pixel-view-item-marker"
          hidden
          aria-hidden="true"></span>
    <?php if (!$quickAdd && $productBreadcrumbs !== []): ?>
    <nav class="product-native-detail__crumb" aria-label="<?= $escape(__('面包屑')) ?>" data-testid="product-breadcrumb">
        <?php foreach ($productBreadcrumbs as $i => $crumb): ?>
            <?php
            if (!is_array($crumb)) {
                continue;
            }
            $crumbLabel = trim((string)($crumb['name'] ?? $crumb['label'] ?? $crumb['text'] ?? ''));
            $crumbUrl = trim((string)($crumb['url'] ?? ''));
            $isLast = $i === array_key_last($productBreadcrumbs);
            if ($crumbLabel === '') {
                continue;
            }
            if ($i > 0): ?>
                <span class="product-native-detail__crumb-sep" aria-hidden="true">›</span>
            <?php endif; ?>
            <?php if ($isLast || $crumbUrl === ''): ?>
                <span aria-current="page"><?= $escape($crumbLabel) ?></span>
            <?php else: ?>
                <a href="<?= $escape($crumbUrl) ?>"><?= $escape($crumbLabel) ?></a>
            <?php endif; ?>
        <?php endforeach; ?>
    </nav>
    <?php elseif (!$quickAdd): ?>
    <a class="product-native-detail__back" href="@url{'products'}">
        <span aria-hidden="true">←</span> <?= __('返回商品目录') ?>
    </a>
    <?php endif; ?>

    <div class="product-native-detail__hero-grid">
        <div class="product-native-detail__media-column">
        <div class="product-native-detail__gallery" aria-label="<?= $escape(__('商品图片')) ?>" data-testid="product-gallery">
            <?php if (count($galleryItems) > 1): ?>
                <div class="product-native-detail__thumbs" role="tablist" aria-label="<?= $escape(__('选择图片或视频')) ?>">
