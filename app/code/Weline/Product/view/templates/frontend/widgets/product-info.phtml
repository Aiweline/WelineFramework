<?php

use Weline\Theme\Helper\StorefrontImagePlaceholder;
/**
 * Product-owned main information block for the PDP product-main slot.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-info}
 * @widget.name {产品主要信息}
 * @widget.description {商品详情主信息：图库、标题、SKU、价格、购买操作槽与规格详情}
 * @widget.is_container {true}
 * @widget.slots {"product-purchase-actions":{"name":"购买操作","accepts":["product","cart","checkout"],"slot_type":"layout-product-purchase-actions","max":5}}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.supports {["layout-product-main","product-info","product-gallery","product-detail"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-main", "area":"content", "sort_order":0, "required":true, "reason":"商品详情默认在产品主内容槽展示产品主要信息", "config":{"show_brand":true,"show_supplier":true} }]}
 *
 * @param show_brand {default=true,type="bool",label="显示品牌"}
 * @param show_supplier {default=true,type="bool",label="显示供应商"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Helper\StorefrontOfferResolver;
use Weline\Product\Helper\StorefrontVariantContextResolver;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-info');
$showBrand = filter_var($this->getData('show_brand') ?? true, FILTER_VALIDATE_BOOLEAN);
$showSupplier = filter_var($this->getData('show_supplier') ?? true, FILTER_VALIDATE_BOOLEAN);
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false)
    || (string)($this->getData('editor_mode') ?? '') === '1';
try {
    $request = $this->getRequest();
    if ((string)$request->getParam('editor_mode', '') === '1'
        || (string)$request->getParam('preview_mode', '') === 'live'
        || (string)$request->getParam('interaction_mode', '') === 'edit'
    ) {
        $isPreviewMode = true;
    }
} catch (\Throwable) {
    // Template may not expose Request in all render paths.
}
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);

$offer = $this->getData('storefront_offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$storefrontOffers = $this->getData('storefront_offers') ?? [];
$storefrontOffers = is_array($storefrontOffers)
    ? array_values(array_filter($storefrontOffers, 'is_array'))
    : [];
$selectedOfferUuid = trim((string)($this->getData('selected_offer_uuid') ?? ''));

if ($offer === []) {
    $offer = StorefrontOfferResolver::resolve($this);
}

if ($offer === [] && $isPreviewMode) {
    $offer = [
        'product_id' => 0,
        'provider_code' => 'product',
        'global_offer_uuid' => '',
        'name' => 'R43 Storefront Product',
        'sku' => 'R43-STORE-PREVIEW',
        'image' => '',
        'images' => [],
        'currency' => 'USD',
        'unit_price_minor' => 0,
        'stock' => 0,
        'sellable' => false,
        'quote_only' => false,
        'message' => '',
        'short_description' => '',
        'description' => '',
        'specifications' => [],
        'attribute_set_label' => 'Published Products',
        'brand' => 'R43 Brand',
        'supplier_name' => 'R43 Supplier',
    ];
}

if ($offer === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty HTML as a warning,
    // and the product-main slot would collapse with no diagnostic surface.
    ?>
<section class="<?= $escape($scope->cssClass) ?> product-native-detail product-native-detail--unavailable"
         data-testid="storefront-product-detail-unavailable"
         data-widget-module="Weline_Product"
         data-widget-code="product-info"
         data-uid="<?= $escape($scope->uid) ?>"
         weline-code="<?= $escape($scope->code) ?>">
    <p class="product-native-detail__unavailable-message"><?= __('商品信息暂不可用') ?></p>
</section>
    <?php
    return;
}

/** @var StorefrontVariantContextResolver $variantContext */
$variantContext = ObjectManager::getInstance(StorefrontVariantContextResolver::class);
if ($storefrontOffers === []) {
    $storefrontOffers = $variantContext->resolveOffers($this);
}
$variantCatalog = $this->getData('variant_catalog') ?? [];
$variantCatalog = is_array($variantCatalog) ? $variantCatalog : [];
if (count($storefrontOffers) > 1) {
    $variantCatalog = $variantContext->buildCatalog($this, $storefrontOffers, null);
    $selectedOffer = $variantCatalog['selected_offer'] ?? null;
    if (is_array($selectedOffer) && $selectedOffer !== []) {
        $offer = $selectedOffer;
        $selectedOfferUuid = trim((string)($offer['global_offer_uuid'] ?? $selectedOfferUuid));
    }
}

$minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
$productId = max(0, (int)($offer['product_id'] ?? 0));
$stock = max(0, (int)($offer['stock'] ?? 0));
$sellable = !empty($offer['sellable']);
$quoteOnly = !empty($offer['quote_only']);
$offerUuid = trim((string)($offer['global_offer_uuid'] ?? ''));
$name = trim((string)($offer['name'] ?? ''));
$image = trim((string)($offer['image'] ?? ''));
$images = array_values(array_filter(
    array_map(static fn(mixed $value): string => trim((string)$value), (array)($offer['images'] ?? [])),
    static fn(string $value): bool => $value !== '',
));
if ($image !== '' && !in_array($image, $images, true)) {
    array_unshift($images, $image);
}
$image = $images[0] ?? $image;
$primaryResolved = StorefrontImagePlaceholder::resolve($image, $productId);
$image = $primaryResolved['src'];
$imageFallback = $primaryResolved['fallback'];
if ($images === []) {
    $images = [$image];
} else {
    $images = array_values(array_map(
        static function (string $galleryImage, int $index) use ($productId): string {
            return StorefrontImagePlaceholder::resolve($galleryImage, $productId + $index)['src'];
        },
        $images,
        array_keys($images),
    ));
    if ($images[0] !== $image) {
        array_unshift($images, $image);
        $images = array_values(array_unique($images));
    }
}
$shortDescription = trim((string)($offer['short_description'] ?? ''));
$description = trim((string)($offer['description'] ?? ''));
$descriptionHtml = trim((string)($offer['description_html'] ?? ''));
$specifications = array_values(array_filter(
    (array)($offer['specifications'] ?? []),
    static fn(mixed $specification): bool => is_array($specification)
        && trim((string)($specification['code'] ?? '')) !== ''
        && trim((string)($specification['value'] ?? '')) !== '',
));
$specificationLabels = [
    'product_type' => __('商品类型'),
    'attribute_set' => __('属性集'),
    'attribute_set_label' => __('属性集'),
    'brand' => __('品牌'),
    'model' => __('型号'),
    'color' => __('颜色'),
    'size' => __('尺码'),
    'style_type' => __('类型'),
    'storage' => __('存储容量'),
    'chipset' => __('处理器'),
    'battery' => __('电池容量'),
    'charging' => __('充电规格'),
    'network' => __('网络制式'),
    'coverage_area' => __('适用面积'),
    'filter_type' => __('滤芯类型'),
    'power' => __('功率'),
    'noise_level' => __('噪音'),
    'smart_control' => __('智能控制'),
    'connectivity' => __('连接方式'),
    'ports' => __('接口数量'),
    'power_delivery' => __('PD 供电'),
    'compatibility' => __('兼容设备'),
    'dpi' => __('DPI'),
    'runtime' => __('续航时间'),
    'suction' => __('吸力'),
    'weight_kg' => __('重量'),
    'volume' => __('容量'),
    'scent' => __('香型'),
    'material' => __('材质'),
    'dimensions' => __('尺寸'),
    'formaldehyde_cadr' => __('甲醛 CADR'),
    'unlock_methods' => __('开锁方式'),
    'accessories' => __('配件'),
    'suitable_for' => __('适用面料'),
    'shelf_life' => __('保质期'),
    'care_instructions' => __('保养说明'),
    'warranty_months' => __('质保(月)'),
    'series' => __('系列'),
    'engine' => __('发动机'),
    'displacement' => __('排量'),
    'max_power' => __('最大功率'),
    'max_torque' => __('最大扭矩'),
    'seat_height' => __('座高'),
    'ground_clearance' => __('离地间隙'),
    'fuel_tank' => __('油箱容量'),
    'curb_weight' => __('整备质量'),
    'tyres' => __('轮胎'),
];
$attributeSetLabel = trim((string)($offer['attribute_set_label'] ?? ''));
$variantAxes = array_values(array_filter(
    (array)($offer['variant_axes'] ?? []),
    static fn(mixed $axis): bool => is_array($axis)
        && trim((string)($axis['code'] ?? '')) !== '',
));
$hasInteractiveVariants = count($storefrontOffers) > 1
    && is_array($variantCatalog['axes'] ?? null)
    && $variantCatalog['axes'] !== [];
$interactiveVariantAxes = $hasInteractiveVariants
    ? array_values((array)$variantCatalog['axes'])
    : $variantAxes;
$specificationLabel = static function (string $code) use ($specificationLabels): string {
    return (string)($specificationLabels[$code] ?? ucwords(str_replace('_', ' ', $code)));
};
$brandName = trim((string)($offer['brand'] ?? ''));
if ($brandName === '') {
    foreach ($specifications as $specification) {
        if (strtolower(trim((string)($specification['code'] ?? ''))) === 'brand') {
            $brandName = trim((string)($specification['value'] ?? ''));
            break;
        }
    }
}
$supplierName = trim((string)($offer['supplier_name'] ?? ''));
$summaryBullets = [];
if ($shortDescription !== '') {
    $parts = preg_split('/[。；;\n]\s*/u', $shortDescription, -1, PREG_SPLIT_NO_EMPTY);
    $summaryBullets = array_values(array_filter(array_map(static fn(string $value): string => trim($value), $parts ?: [])));
    if ($summaryBullets === []) {
        $summaryBullets = [$shortDescription];
    }
}
$currencyCode = strtoupper(trim((string)($offer['currency'] ?? 'CNY')));
$currencySymbol = match ($currencyCode) {
    'CNY', 'RMB' => '¥',
    'USD' => '$',
    'EUR' => '€',
    'GBP' => '£',
    'JPY' => '¥',
    default => $currencyCode . ' ',
};
$priceWhole = (int) floor($minor / 100);
$priceFraction = sprintf('%02d', $minor % 100);
$stockLabel = $quoteOnly
    ? __('按项目确认库存')
    : ($stock > 0
        ? ($stock <= 10 ? __('仅剩 %{1} 件', [$stock]) : __('有货'))
        : __('暂时缺货'));
$stockTone = !$quoteOnly && $stock > 0 && $sellable ? 'in-stock' : 'out-stock';
$requiresShipping = !isset($offer['requires_shipping']) || !empty($offer['requires_shipping']);
$showPrimeBadge = $sellable && $requiresShipping && !$quoteOnly;
$maxQty = $quoteOnly ? 1 : max(1, min(10, $stock > 0 ? $stock : 10));
$reviewRating = 0.0;
$reviewCount = 0;
if ($offerUuid !== '' && class_exists(\Weline\Review\Service\ReviewService::class)) {
    try {
        $reviewFacts = ObjectManager::getInstance(\Weline\Review\Service\ReviewService::class)
            ->seoFacts('product', $offerUuid, 1);
        $reviewRating = max(0.0, (float)($reviewFacts['average_rating'] ?? 0));
        $reviewCount = max(0, (int)($reviewFacts['review_count'] ?? 0));
    } catch (\Throwable) {
        $reviewRating = 0.0;
        $reviewCount = 0;
    }
}
$qtyFieldId = 'product-qty-' . max(0, $productId);
?>
<section class="product-native-detail product-native-detail--amazon<?= $isPreviewMode ? ' is-preview' : '' ?>"
         data-testid="storefront-product-detail"
         data-widget-module="Weline_Product"
         data-widget-code="product-info"
         data-uid="<?= $escape($scope->uid) ?>"
         weline-code="<?= $escape($scope->code) ?>">
    <a class="product-native-detail__back" href="@url{'products'}">
        <span aria-hidden="true">←</span> <?= __('返回商品目录') ?>
    </a>

    <div class="product-native-detail__hero-grid">
        <div class="product-native-detail__gallery" aria-label="<?= $escape(__('商品图片')) ?>">
            <?php if (count($images) > 1): ?>
                <div class="product-native-detail__thumbs" role="tablist" aria-label="<?= $escape(__('选择图片')) ?>">
                    <?php foreach ($images as $index => $galleryImage): ?>
                        <button type="button"
                                role="tab"
                                class="product-native-detail__thumb<?= $index === 0 ? ' is-active' : '' ?>"
                                data-gallery-src="<?= $escape($galleryImage) ?>"
                                aria-selected="<?= $index === 0 ? 'true' : 'false' ?>"
                                aria-label="<?= $escape(__('查看商品图片 %{1}', [$index + 1])) ?>">
                            <img src="<?= $escape($galleryImage) ?>"
                                 alt=""
                                 data-storefront-img="1"
                                 data-fallback="<?= $escape(StorefrontImagePlaceholder::url($productId + $index)) ?>">
                        </button>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
            <div class="product-native-detail__stage-wrap" data-image-zoom="1">
                <div class="product-native-detail__stage">
                    <img class="product-native-detail__primary-image"
                         src="<?= $escape($image) ?>"
                         alt="<?= $escape($name) ?>"
                         data-storefront-img="1"
                         data-fallback="<?= $escape($imageFallback) ?>">
                    <div class="product-native-detail__zoom-lens" hidden aria-hidden="true"></div>
                </div>
                <div class="product-native-detail__zoom-result"
                     hidden
                     aria-hidden="true"
                     role="presentation"
                     data-testid="product-image-zoom-result"></div>
            </div>
        </div>

        <div class="product-native-detail__buy-column">
            <div class="product-native-detail__summary-panel">
                <?php if ($showBrand && $brandName !== ''): ?>
                    <p class="product-native-detail__brand" data-testid="product-brand">
                        <?= __('品牌') ?>:
                        <span><?= $escape($brandName) ?></span>
                    </p>
                <?php elseif ($showBrand && $attributeSetLabel !== ''): ?>
                    <p class="product-native-detail__brand" data-testid="product-brand-fallback">
                        <?= $escape($attributeSetLabel) ?>
                    </p>
                <?php endif; ?>

                <h1 class="product-native-detail__title"><?= $escape($name) ?></h1>

                <div class="product-native-detail__meta-row">
                    <?php if ($reviewCount > 0 && $reviewRating > 0): ?>
                        <a class="product-native-detail__rating-link" href="#product-reviews">
                            <span class="product-native-detail__stars"
                                  style="--rating: <?= $escape((string)$reviewRating) ?>"
                                  aria-label="<?= $escape(__('平均 %{1} 星', [number_format($reviewRating, 1)])) ?>">
                                <span class="product-native-detail__stars-track" aria-hidden="true">
                                    <?php for ($starIndex = 0; $starIndex < 5; $starIndex++): ?>
                                        <svg class="product-native-detail__star" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M10 1l2.39 5.64L18 7.27l-4.12 3.72L15 17 10 13.77 5 17l1.12-6L2 7.27l5.61-.63L10 1z"/>
                                        </svg>
                                    <?php endfor; ?>
                                </span>
                                <span class="product-native-detail__stars-fill" aria-hidden="true">
                                    <?php for ($starIndex = 0; $starIndex < 5; $starIndex++): ?>
                                        <svg class="product-native-detail__star" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M10 1l2.39 5.64L18 7.27l-4.12 3.72L15 17 10 13.77 5 17l1.12-6L2 7.27l5.61-.63L10 1z"/>
                                        </svg>
                                    <?php endfor; ?>
                                </span>
                            </span>
                            <span class="product-native-detail__rating-value"><?= $escape(number_format($reviewRating, 1)) ?></span>
                            <span class="product-native-detail__rating-count">
                                <?= $escape(__('%{1} 条评价', [$reviewCount])) ?>
                            </span>
                        </a>
                    <?php else: ?>
                        <a class="product-native-detail__reviews-link" href="#product-reviews">
                            <?= __('查看买家评价') ?>
                        </a>
                    <?php endif; ?>
                    <span class="product-native-detail__meta-divider" aria-hidden="true">|</span>
                    <span class="product-native-detail__sku" data-testid="product-sku" data-product-sku="1">SKU: <?= $escape($offer['sku'] ?? '') ?></span>
                </div>

                <hr class="product-native-detail__divider">

                <?php if (!$quoteOnly): ?>
                    <div class="product-native-detail__price-block">
                        <span class="product-native-detail__price-label"><?= __('价格') ?>:</span>
                        <span class="product-native-detail__price">
                            <span class="product-native-detail__price-symbol"><?= $escape($currencySymbol) ?></span>
                            <span class="product-native-detail__price-whole"><?= $priceWhole ?></span>
                            <span class="product-native-detail__price-fraction">.<?= $priceFraction ?></span>
                        </span>
                    </div>
                <?php else: ?>
                    <p class="product-native-detail__quote-price"><?= __('联系询价') ?></p>
                <?php endif; ?>

                <?php if ($summaryBullets !== []): ?>
                    <ul class="product-native-detail__bullets">
                        <?php foreach ($summaryBullets as $bullet): ?>
                            <li><?= $escape($bullet) ?></li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>

                <?php if ($interactiveVariantAxes !== []): ?>
                    <div class="product-native-detail__variant-axes"
                         data-testid="product-variant-axes"
                         <?= $hasInteractiveVariants ? 'data-variant-interactive="1"' : '' ?>
                         <?php if ($hasInteractiveVariants): ?>data-variant-live-url="@url{'weline_product/frontend/api/variant-availability'}"<?php endif; ?>>
                        <?php foreach ($interactiveVariantAxes as $axis): ?>
                            <?php
                            $axisCode = strtolower(trim((string)($axis['code'] ?? '')));
                            $rawAxisLabel = trim((string)($axis['label'] ?? ''));
                            // 已知规格码优先走 specificationLabels（内含 __()）；否则对 EAV/种子原文 __()。
                            // 避免 interactive catalog 回退 label=code（如 color）时英文仍显示小写 code。
                            if (array_key_exists($axisCode, $specificationLabels)) {
                                $axisLabel = $specificationLabel($axisCode);
                            } elseif ($rawAxisLabel !== '') {
                                $axisLabel = (string)__($rawAxisLabel);
                            } else {
                                $axisLabel = $specificationLabel($axisCode);
                            }
                            $selectedValue = trim((string)(
                                $hasInteractiveVariants
                                    ? ($variantCatalog['selected'][$axisCode] ?? ($axis['value'] ?? ''))
                                    : ($axis['value'] ?? '')
                            ));
                            $options = array_values(array_filter(
                                (array)($axis['options'] ?? []),
                                static fn(mixed $option): bool => is_array($option)
                                    && trim((string)($option['value'] ?? '')) !== '',
                            ));
                            ?>
                            <div class="product-native-detail__variant-axis" data-variant-axis="<?= $escape($axisCode) ?>">
                                <span class="product-native-detail__variant-axis-label"><?= $escape($axisLabel) ?>:</span>
                                <?php if ($options !== []): ?>
                                    <div class="product-native-detail__variant-axis-options" role="list">
                                        <?php foreach ($options as $option): ?>
                                            <?php
                                            $optionValue = trim((string)($option['value'] ?? ''));
                                            $optionLabel = trim((string)($option['label'] ?? $optionValue));
                                            $swatchImage = trim((string)($option['swatch_image'] ?? ''));
                                            $swatchColor = trim((string)($option['swatch_color'] ?? $option['swatch'] ?? ''));
                                            $isSwatch = $swatchImage !== '' || $swatchColor !== '';
                                            $isSelected = $optionValue !== '' && $optionValue === $selectedValue;
                                            $optionClasses = 'product-native-detail__variant-option'
                                                . ($isSelected ? ' is-selected' : '')
                                                . ($isSwatch ? ' product-native-detail__variant-option--swatch' : '')
                                                . ($swatchImage !== '' ? ' product-native-detail__variant-option--swatch-image' : '')
                                                . ($swatchColor !== '' && $swatchImage === '' ? ' product-native-detail__variant-option--swatch-color' : '');
                                            ?>
                                            <?php if ($hasInteractiveVariants): ?>
                                                <button type="button"
                                                        class="<?= $escape($optionClasses) ?>"
                                                        data-variant-option="1"
                                                        data-variant-axis="<?= $escape($axisCode) ?>"
                                                        data-variant-value="<?= $escape($optionValue) ?>"
                                                        data-variant-label="<?= $escape($optionLabel) ?>"
                                                        title="<?= $escape($optionLabel) ?>"
                                                        aria-label="<?= $escape($optionLabel) ?>"
                                                        aria-current="<?= $isSelected ? 'true' : 'false' ?>">
                                                    <?php if ($swatchImage !== ''): ?>
                                                        <img class="product-native-detail__variant-swatch-image"
                                                             src="<?= $escape($swatchImage) ?>"
                                                             alt="<?= $escape($optionLabel) ?>"
                                                             loading="lazy">
                                                        <span class="product-native-detail__variant-swatch-label"><?= $escape($optionLabel) ?></span>
                                                    <?php elseif ($swatchColor !== ''): ?>
                                                        <span class="product-native-detail__variant-swatch-color"
                                                              style="--variant-swatch: <?= $escape($swatchColor) ?>"
                                                              aria-hidden="true"></span>
                                                        <span class="product-native-detail__variant-swatch-label"><?= $escape($optionLabel) ?></span>
                                                    <?php else: ?>
                                                        <?= $escape($optionLabel) ?>
                                                    <?php endif; ?>
                                                </button>
                                            <?php else: ?>
                                                <span class="product-native-detail__variant-option<?= $isSelected ? ' is-selected' : '' ?>"
                                                      role="listitem"
                                                      aria-current="<?= $isSelected ? 'true' : 'false' ?>">
                                                    <?= $escape($optionLabel) ?>
                                                </span>
                                            <?php endif; ?>
                                        <?php endforeach; ?>
                                    </div>
                                <?php elseif ($selectedValue !== ''): ?>
                                    <span class="product-native-detail__variant-axis-value"><?= $escape($selectedValue) ?></span>
                                <?php endif; ?>
                            </div>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>

                <?php if (count($storefrontOffers) > 1 && !$hasInteractiveVariants): ?>
                    <?php
                    $selectorProductId = max(0, (int)($offer['product_id'] ?? 0));
                    $selectorId = 'product-offer-selector-' . $selectorProductId;
                    $selectorSlug = strtolower(trim((string)($offer['slug'] ?? '')));
                    $selectorRoute = $selectorSlug !== ''
                        ? 'product/' . $selectorSlug
                        : 'product/' . $selectorProductId;
                    ?>
                    <form class="product-native-detail__variant-form"
                          method="get"
                          action="@url{$selectorRoute}"
                          data-testid="product-offer-selector">
                        <label class="product-native-detail__variant-label" for="<?= $escape($selectorId) ?>">
                            <?= $escape(__('规格')) ?>:
                        </label>
                        <select class="product-native-detail__variant-select"
                                id="<?= $escape($selectorId) ?>"
                                name="offer"
                                required
                                aria-required="true">
                            <option value=""><?= $escape(__('请选择规格')) ?></option>
                            <?php foreach ($storefrontOffers as $variant): ?>
                                <?php
                                $variantUuid = trim((string)($variant['global_offer_uuid'] ?? ''));
                                $variantSku = trim((string)($variant['sku'] ?? ''));
                                $variantLabel = trim((string)($variant['combination_key'] ?? ''));
                                if ($variantLabel !== '') {
                                    $variantLabel = str_replace(['=', '|', ';'], [': ', ' / ', ' / '], $variantLabel);
                                } else {
                                    $variantLabel = $variantSku;
                                }
                                if ($variantSku !== '' && $variantLabel !== $variantSku) {
