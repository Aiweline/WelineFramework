<?php

use Weline\Theme\Helper\StorefrontImagePlaceholder;
/**
 * Product-owned main information block for the PDP product-main slot.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-info}
 * @widget.name {产品主要信息}
 * @widget.description {商品详情主信息：图库、标题、SKU、价格、加购与规格详情}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product"]}
 * @widget.supports {["layout-product-main","product-info","product-gallery","product-detail"]}
 * @widget.default_injections {[{ "layout_type":"product", "layout_option":"default", "slot":"product-main", "area":"content", "sort_order":0, "required":true, "reason":"商品详情默认在产品主内容槽展示产品主要信息", "config":{} }]}
 */

use Weline\Framework\Env\WelineEnv;
use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\StorefrontCatalogViewService;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-info');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false);
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8'
);

$offer = $this->getData('storefront_offer') ?? [];
$offer = is_array($offer) ? $offer : [];
$storefrontOffers = $this->getData('storefront_offers') ?? [];
$storefrontOffers = is_array($storefrontOffers)
    ? array_values(array_filter($storefrontOffers, 'is_array'))
    : [];
$selectedOfferUuid = trim((string)($this->getData('selected_offer_uuid') ?? ''));

if ($offer === []) {
    $publicRoute = '';
    try {
        $request = ObjectManager::getInstance(\Weline\Framework\Http\Request::class);
        $publicRoute = trim(str_replace('\\', '/', (string)$request->getParam('theme_public_route', '')), '/');
    } catch (\Throwable) {
        $publicRoute = '';
    }
    if ($publicRoute === '' && isset($_GET['theme_public_route'])) {
        $publicRoute = trim(str_replace('\\', '/', (string)$_GET['theme_public_route']), '/');
    }

    $handle = '';
    if (preg_match('#(?:^|/)product/([a-z0-9][a-z0-9-]*)(?:/|$)#i', strtolower($publicRoute), $routeMatch) === 1) {
        $handle = strtolower((string)$routeMatch[1]);
    }

    if ($handle === '') {
        $requestUri = (string)(WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
        $requestPath = (string)(parse_url($requestUri, PHP_URL_PATH) ?: '');
        $pathParts = array_values(array_filter(
            explode('/', trim($requestPath, '/')),
            static fn(string $part): bool => $part !== '',
        ));
        $productPartIndex = array_search('product', $pathParts, true);
        if ($productPartIndex !== false && isset($pathParts[$productPartIndex + 1])) {
            $handle = strtolower(rawurldecode((string)$pathParts[$productPartIndex + 1]));
        }
    }

    if ($handle !== '') {
        try {
            $catalog = ObjectManager::getInstance(StorefrontCatalogViewService::class);
            if (ctype_digit($handle)) {
                $resolved = $catalog->publishedOffer((int)$handle);
            } else {
                $resolved = $catalog->publishedOfferBySlug($handle);
            }
            if (is_array($resolved) && $resolved !== []) {
                $offer = $resolved;
            }
        } catch (\Throwable) {
            $offer = [];
        }
    }
}

if ($offer === [] && $isPreviewMode) {
    $offer = [
        'product_id' => 0,
        'provider_code' => 'product',
        'global_offer_uuid' => '',
        'name' => 'R43 Storefront Product',
        'sku' => 'R43-STORE-PREVIEW',
        'image' => '',
        'images' => [],
        'currency' => 'USD',
        'unit_price_minor' => 0,
        'stock' => 0,
        'sellable' => false,
        'quote_only' => false,
        'message' => '',
        'short_description' => '',
        'description' => '',
        'specifications' => [],
        'attribute_set_label' => 'Published Products',
    ];
}

if ($offer === []) {
    return;
}

$minor = max(0, (int)($offer['unit_price_minor'] ?? 0));
$productId = max(0, (int)($offer['product_id'] ?? 0));
$stock = max(0, (int)($offer['stock'] ?? 0));
$sellable = !empty($offer['sellable']);
$quoteOnly = !empty($offer['quote_only']);
$offerUuid = trim((string)($offer['global_offer_uuid'] ?? ''));
$name = trim((string)($offer['name'] ?? ''));
$image = trim((string)($offer['image'] ?? ''));
$images = array_values(array_filter(
    array_map(static fn(mixed $value): string => trim((string)$value), (array)($offer['images'] ?? [])),
    static fn(string $value): bool => $value !== '',
));
if ($image !== '' && !in_array($image, $images, true)) {
    array_unshift($images, $image);
}
$image = $images[0] ?? $image;
$primaryResolved = StorefrontImagePlaceholder::resolve($image, $productId);
$image = $primaryResolved['src'];
$imageFallback = $primaryResolved['fallback'];
if ($images === []) {
    $images = [$image];
} else {
    $images = array_values(array_map(
        static function (string $galleryImage, int $index) use ($productId): string {
            return StorefrontImagePlaceholder::resolve($galleryImage, $productId + $index)['src'];
        },
        $images,
        array_keys($images),
    ));
    if ($images[0] !== $image) {
        array_unshift($images, $image);
        $images = array_values(array_unique($images));
    }
}
$shortDescription = trim((string)($offer['short_description'] ?? ''));
$description = trim((string)($offer['description'] ?? ''));
$specifications = array_values(array_filter(
    (array)($offer['specifications'] ?? []),
    static fn(mixed $specification): bool => is_array($specification)
        && trim((string)($specification['code'] ?? '')) !== ''
        && trim((string)($specification['value'] ?? '')) !== '',
));
$specificationLabels = [
    'product_type' => __('商品类型'),
    'attribute_set' => __('属性集'),
    'attribute_set_label' => __('属性集'),
    'brand' => __('品牌'),
    'model' => __('型号'),
    'color' => __('颜色'),
    'size' => __('尺码'),
    'style_type' => __('类型'),
    'storage' => __('存储容量'),
    'chipset' => __('处理器'),
    'battery' => __('电池容量'),
    'charging' => __('充电规格'),
    'network' => __('网络制式'),
    'coverage_area' => __('适用面积'),
    'filter_type' => __('滤芯类型'),
    'power' => __('功率'),
    'noise_level' => __('噪音'),
    'smart_control' => __('智能控制'),
    'connectivity' => __('连接方式'),
    'ports' => __('接口数量'),
    'power_delivery' => __('PD 供电'),
    'compatibility' => __('兼容设备'),
    'dpi' => __('DPI'),
    'runtime' => __('续航时间'),
    'suction' => __('吸力'),
    'weight_kg' => __('重量'),
    'volume' => __('容量'),
    'scent' => __('香型'),
    'material' => __('材质'),
    'dimensions' => __('尺寸'),
    'formaldehyde_cadr' => __('甲醛 CADR'),
    'unlock_methods' => __('开锁方式'),
    'accessories' => __('配件'),
    'suitable_for' => __('适用面料'),
    'shelf_life' => __('保质期'),
    'care_instructions' => __('保养说明'),
    'warranty_months' => __('质保(月)'),
    'series' => __('系列'),
    'engine' => __('发动机'),
    'displacement' => __('排量'),
    'max_power' => __('最大功率'),
    'max_torque' => __('最大扭矩'),
    'seat_height' => __('座高'),
    'ground_clearance' => __('离地间隙'),
    'fuel_tank' => __('油箱容量'),
    'curb_weight' => __('整备质量'),
    'tyres' => __('轮胎'),
];
$attributeSetLabel = trim((string)($offer['attribute_set_label'] ?? ''));
$specificationLabel = static function (string $code) use ($specificationLabels): string {
    return (string)($specificationLabels[$code] ?? ucwords(str_replace('_', ' ', $code)));
};
?>
<section class="product-native-detail<?= $isPreviewMode ? ' is-preview' : '' ?>"
         data-testid="storefront-product-detail"
         data-widget-module="Weline_Product"
         data-widget-code="product-info"
         data-uid="<?= $escape($scope->uid) ?>"
         weline-code="<?= $escape($scope->code) ?>">
    <a class="product-native-detail__back" href="<?= $escape($this->getUrl('products')) ?>">
        <span aria-hidden="true">←</span> <?= __('返回商品目录') ?>
    </a>

    <div class="product-native-detail__grid">
        <div class="product-native-detail__media">
            <img class="product-native-detail__primary-image"
                 src="<?= $escape($image) ?>"
                 alt="<?= $escape($name) ?>"
                 data-storefront-img="1"
                 data-fallback="<?= $escape($imageFallback) ?>">
            <?php if (count($images) > 1): ?>
                <div class="product-native-detail__thumbnails" aria-label="<?= $escape(__('商品图片')) ?>">
                    <?php foreach ($images as $index => $galleryImage): ?>
                        <button type="button"
                                class="product-native-detail__thumbnail<?= $index === 0 ? ' is-active' : '' ?>"
                                data-gallery-src="<?= $escape($galleryImage) ?>"
                                aria-label="<?= $escape(__('查看商品图片 %{1}', [$index + 1])) ?>">
                            <img src="<?= $escape($galleryImage) ?>"
                                 alt=""
                                 data-storefront-img="1"
                                 data-fallback="<?= $escape(StorefrontImagePlaceholder::url($productId + $index)) ?>">
                        </button>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>

        <div class="product-native-detail__body">
            <p class="product-native-detail__eyebrow">
                <?= $attributeSetLabel !== '' ? $escape($attributeSetLabel) : __('已发布商品') ?>
            </p>
            <h1><?= $escape($name) ?></h1>
            <p class="product-native-detail__sku">SKU: <?= $escape($offer['sku'] ?? '') ?></p>
            <?php if ($shortDescription !== ''): ?>
                <p class="product-native-detail__summary"><?= $escape($shortDescription) ?></p>
            <?php endif; ?>
            <p class="product-native-detail__price">
                <?php if ($quoteOnly): ?>
                    <?= __('联系询价') ?>
                <?php else: ?>
                    <?= $escape($offer['currency'] ?? 'CNY') ?> <?= number_format($minor / 100, 2) ?>
                <?php endif; ?>
            </p>

            <?php if (count($storefrontOffers) > 1): ?>
                <?php
                $selectorProductId = max(0, (int)($offer['product_id'] ?? 0));
                $selectorId = 'product-offer-selector-' . $selectorProductId;
                $selectorSlug = strtolower(trim((string)($offer['slug'] ?? '')));
                $selectorRoute = $selectorSlug !== ''
                    ? 'product/' . $selectorSlug
                    : 'product/' . $selectorProductId;
                ?>
                <form class="form-group mb-3"
                      method="get"
                      action="<?= $escape($this->getUrl($selectorRoute)) ?>"
                      data-testid="product-offer-selector">
                    <label class="form-label" for="<?= $escape($selectorId) ?>">
                        <?= $escape(__('选择规格')) ?>
                    </label>
                    <select class="form-control"
                            id="<?= $escape($selectorId) ?>"
                            name="offer"
                            required
                            aria-required="true">
                        <option value=""><?= $escape(__('请选择规格')) ?></option>
                        <?php foreach ($storefrontOffers as $variant): ?>
                            <?php
                            $variantUuid = trim((string)($variant['global_offer_uuid'] ?? ''));
                            $variantSku = trim((string)($variant['sku'] ?? ''));
                            $variantLabel = trim((string)($variant['combination_key'] ?? ''));
                            if ($variantLabel !== '') {
                                $variantLabel = str_replace(['=', '|', ';'], [': ', ' / ', ' / '], $variantLabel);
                            } else {
                                $variantLabel = $variantSku;
                            }
                            if ($variantSku !== '' && $variantLabel !== $variantSku) {
                                $variantLabel .= ' · ' . $variantSku;
                            }
                            if (!(bool)($variant['sellable'] ?? false)) {
                                $variantLabel .= ' · ' . (string)__('暂不可购买');
                            }
                            ?>
                            <option value="<?= $escape($variantUuid) ?>"
                                <?= $variantUuid !== '' && $variantUuid === $selectedOfferUuid ? 'selected' : '' ?>>
                                <?= $escape($variantLabel) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                    <button class="btn btn-outline-primary mt-2" type="submit">
                        <?= $escape(__('查看此规格')) ?>
                    </button>
                </form>
            <?php endif; ?>

            <dl class="product-native-detail__facts">
                <div>
                    <dt><?= __('库存') ?></dt>
                    <strong><?= $quoteOnly ? __('按项目确认') : $stock ?></strong>
                </div>
                <div>
                    <dt><?= __('销售状态') ?></dt>
                    <strong><?= $quoteOnly ? __('需询价') : ($sellable ? __('可购买') : __('暂不可售')) ?></strong>
                </div>
            </dl>

            <?php if (!$quoteOnly && !$sellable && trim((string)($offer['message'] ?? '')) !== ''): ?>
                <p class="product-native-detail__unavailable"><?= $escape($offer['message']) ?></p>
            <?php endif; ?>

            <div class="product-native-detail__actions">
                <button type="button"
                        class="product-native-detail__add"
                        data-action="add-v2"
                        data-provider-code="<?= $escape($offer['provider_code'] ?? 'product') ?>"
                        data-product-id="<?= $productId ?>"
                        data-global-offer-uuid="<?= $escape($offerUuid) ?>"
                        <?= $sellable && $offerUuid !== '' ? '' : 'disabled' ?>>
                    <?= $quoteOnly ? __('仅询价') : ($sellable ? __('加入购物车') : __('暂不可售')) ?>
                </button>
                <a class="product-native-detail__cart"
                   href="<?= $escape($this->getUrl('cart')) ?>"
                   data-testid="view-cart"
                   hidden><?= __('查看购物车') ?></a>
            </div>
            <p class="product-native-detail__message" data-testid="detail-message" aria-live="polite"></p>
        </div>
    </div>

    <?php if ($description !== '' || $specifications !== []): ?>
        <div class="product-native-detail__content-grid">
            <?php if ($description !== ''): ?>
                <section class="product-native-detail__description"
                         data-testid="product-description"
                         weline-code="product.frontend.detail.description">
                    <p class="product-native-detail__section-kicker"><?= __('商品资料') ?></p>
                    <h2><?= __('商品详情') ?></h2>
                    <p><?= nl2br($escape($description), false) ?></p>
                </section>
            <?php endif; ?>

            <?php if ($specifications !== []): ?>
                <section class="product-native-detail__specifications"
                         data-testid="product-specifications"
                         weline-code="product.frontend.detail.specifications">
                    <p class="product-native-detail__section-kicker"><?= __('技术数据') ?></p>
                    <h2><?= __('规格参数') ?></h2>
                    <dl>
                        <?php foreach ($specifications as $specification): ?>
                            <?php
                            $code = strtolower(trim((string)$specification['code']));
                            $value = trim((string)$specification['value']);
                            if ($code === 'product_type' && preg_match('/^[a-z0-9_]+$/D', $value)) {
                                $value = ucwords(str_replace('_', ' ', $value));
                            }
                            ?>
                            <div>
                                <dt><?= $escape($specificationLabel($code)) ?></dt>
                                <div class="product-native-detail__specification-value"><?= $escape($value) ?></div>
                            </div>
                        <?php endforeach; ?>
                    </dl>
                </section>
            <?php endif; ?>
        </div>
    <?php endif; ?>

</section>

