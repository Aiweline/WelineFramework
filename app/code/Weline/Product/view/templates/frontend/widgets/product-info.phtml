 * @widget.is_container {true}
 * @widget.slots {"product-purchase-actions":{"name":"购买操作","accepts":["product","cart","checkout"],"slot_type":"layout-product-purchase-actions","max":6},"product-express-payment":{"name":"快捷支付","accepts":["payment","express-checkout","express-payment","product-express-payment"],"slot_type":"layout-product-express-payment","max":3},"product-selling-mode":{"name":"售卖模式","accepts":["product","b2b","selling-mode"],"slot_type":"layout-product-selling-mode","max":3}}
 * @widget.type {product}
