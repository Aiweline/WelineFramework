<?php
/**
 * Best-sellers page hero strip (configurable copy + background image).
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {best-sellers-hero}
 * @widget.name {热销榜页头}
 * @widget.description {热销榜页深色页头：眉题、标题、导语、件数与背景图均可配置}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["best_sellers"]}
 * @widget.compatible {true}
 * @widget.supports {["layout-best-sellers-hero","layout-best-sellers-main","layout-best-sellers-content","banner","content"]}
 *
 * @param eyebrow {default="本站人气排行",type="string",label="眉题"}
 * @param title {default="热销榜",type="string",label="标题"}
 * @param lede {default="按店面热度排序的热销商品，帮你快速找到大家都在买的好物。",type="textarea",label="导语"}
 * @param count_template {default="共 %{1} 件热销商品",type="string",label="件数文案",description="用 %{1} 表示实际件数"}
 * @param show_count {default=true,type="bool",label="显示件数"}
 * @param background_image {default="",type="media_image",label="背景图片",description="推荐 1920×400",media_options={default_directory:"banner",aspect_ratio:"1920/400",recommend_width:"1920",recommend_height:"400",aspect_ratio_tolerance:"0.15"}}
 */

use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\StorefrontProductWidgetCatalog;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\SiteBlockConfig;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('best-sellers-hero');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);

$eyebrowSource = trim((string)($this->getData('eyebrow') ?? '')) ?: '本站人气排行';
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '热销榜';
$ledeSource = trim((string)($this->getData('lede') ?? ''))
    ?: '按店面热度排序的热销商品，帮你快速找到大家都在买的好物。';
$countTemplateSource = trim((string)($this->getData('count_template') ?? '')) ?: '共 %{1} 件热销商品';
$showCount = SiteBlockConfig::boolean($this->getData('show_count'), true);

$eyebrow = WidgetI18n::label($eyebrowSource, '本站人气排行');
$title = WidgetI18n::label($titleSource, '热销榜');
$lede = WidgetI18n::label(
    $ledeSource,
    '按店面热度排序的热销商品，帮你快速找到大家都在买的好物。'
);
$countTemplate = WidgetI18n::label($countTemplateSource, '共 %{1} 件热销商品');

$backgroundImage = LegacyMediaUrl::sanitize(
    $this->getData('background_image') ?? '',
    true,
);
$backgroundImageFileHtml = SiteBlockConfig::mediaHtml(
    $this->getData('background_image_file_html') ?? '',
    $titleSource
);
$hasBackground = $backgroundImageFileHtml !== '' || $backgroundImage !== '';

$count = max(0, (int)($this->getData('storefront_best_sellers_count') ?? $this->getData('count') ?? 0));
if ($count <= 0) {
    try {
        /** @var Request $request */
        $request = ObjectManager::getInstance(Request::class);
        $count = max(0, (int)$request->getData('storefront_best_sellers_count'));
    } catch (\Throwable) {
        $count = 0;
    }
}
if ($count <= 0 && class_exists(StorefrontProductWidgetCatalog::class) && !$isPreviewMode) {
    try {
        $count = count(ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)->bestSellerCards(24));
    } catch (\Throwable) {
        $count = 0;
    }
}
if ($count <= 0 && $isPreviewMode) {
    $count = 24;
}

$countLine = '';
if ($showCount) {
    if ($count > 0) {
        $countLine = str_contains($countTemplate, '%{1}')
            ? str_replace('%{1}', (string)$count, $countTemplate)
            : $countTemplate;
    } else {
        $countLine = (string)__('暂无热销商品');
    }
}

$rootStyle = '';
if ($backgroundImageFileHtml === '' && $backgroundImage !== '') {
    $rootStyle = 'background-image:url("' . $esc($backgroundImage) . '");';
}
?>
<header class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?><?= $hasBackground ? ' has-bg' : '' ?>"
        weline-code="<?= $esc($scope->code) ?>"
        data-uid="<?= $esc($scope->uid) ?>"
        data-js-ns="<?= $esc($scope->jsNs) ?>"
        data-testid="storefront-best-sellers-hero"
        <?= $rootStyle !== '' ? ' style="' . $esc($rootStyle) . '"' : '' ?>>
    <?php if ($backgroundImageFileHtml !== ''): ?>
        <div class="bsh-bg" aria-hidden="true"><?= $backgroundImageFileHtml ?></div>
    <?php endif; ?>
    <?php if ($hasBackground): ?>
        <div class="bsh-overlay" aria-hidden="true"></div>
    <?php endif; ?>
    <div class="bsh-copy">
        <p class="bsh-eyebrow"><?= $esc($eyebrow) ?></p>
        <h1 class="bsh-title"><?= $esc($title) ?></h1>
        <?php if ($lede !== ''): ?>
            <p class="bsh-lede"><?= $esc($lede) ?></p>
        <?php endif; ?>
        <?php if ($countLine !== ''): ?>
            <p class="bsh-count" data-testid="storefront-best-sellers-count"><?= $esc($countLine) ?></p>
        <?php endif; ?>
    </div>
</header>

<style>
.<?= $wc ?> {
    position: relative;
    overflow: hidden;
    margin: 0 0 var(--weline-space-7, 1.75rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--weline-radius-lg, 12px);
    background:
        radial-gradient(ellipse at top right, color-mix(in srgb, var(--weline-theme-warning, #f59e0b) 22%, transparent), transparent 48%),
        linear-gradient(135deg, var(--color-bg-dark-secondary, #131921) 0%, var(--color-bg-dark, #232f3e) 100%);
    background-size: cover;
    background-position: center;
    color: #ffffff;
    box-sizing: border-box;
}
.<?= $wc ?> .bsh-bg,
.<?= $wc ?> .bsh-bg figure,
.<?= $wc ?> .bsh-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}
.<?= $wc ?> .bsh-bg img {
    object-fit: cover;
    object-position: center;
}
.<?= $wc ?> .bsh-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg-dark-secondary, #131921) 78%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-dark, #232f3e) 42%, transparent) 55%,
        transparent 100%
    );
    pointer-events: none;
}
.<?= $wc ?> .bsh-copy {
    position: relative;
    z-index: 1;
    max-width: min(36rem, 100%);
}
.<?= $wc ?> .bsh-eyebrow {
    margin: 0 0 0.35rem;
    font-size: var(--weline-font-size-sm, 0.8rem);
    font-weight: var(--weline-font-weight-bold, 700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--weline-theme-warning, #ffd814);
}
.<?= $wc ?> .bsh-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    line-height: 1.15;
    font-weight: var(--weline-font-weight-bold, 700);
    color: #ffffff;
}
.<?= $wc ?> .bsh-lede,
.<?= $wc ?> .bsh-count {
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.88);
}
</style>
