<?php
/**
 * 织艺谱系（Textile Heritage）— Product 拥有，默认注入首页品牌槽。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {textile-heritage}
 * @widget.name {织艺谱系}
 * @widget.description {汉服织艺谱系目录：云锦/宋锦/蜀锦/苏绣/妆花/花罗，支持配图与搜索链接}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-brands","layout-cms-content","layout-default-content","brand-list","brands"]}
 *
 * @param title {default="织艺谱系 · Textile Heritage",type="string",label="标题"}
 * @param brands {default=[],type="brand_logo_items",label="谱系项",description="每项包含名称、说明、图片与链接；默认由 Product 部件数据提供"}
 * @param columns {default="6",type="select",label="每行列数",options={4:"4列",5:"5列",6:"6列",8:"8列"}}
 * @param layout {default="grid",type="select",label="布局",options={grid:"网格",carousel:"轮播"}}
 * @param grayscale {default=false,type="bool",label="灰度效果"}
 */

use Weline\Product\Service\TextileHeritageCatalog;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('textile-heritage');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = trim((string)($this->getData('title') ?? TextileHeritageCatalog::TITLE));
$brands = $this->getData('brands') ?? [];
if (is_string($brands)) {
    $decoded = json_decode($brands, true);
    $brands = is_array($decoded) ? $decoded : [];
}
if (!is_array($brands)) {
    $brands = [];
}
$columns = (string)($this->getData('columns') ?? '6');
$layout = (string)($this->getData('layout') ?? 'grid');
$grayscale = (bool)($this->getData('grayscale') ?? false);
$hoverColor = (bool)($this->getData('hover_color') ?? true);

$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    $translated = trim(WidgetI18n::label($source));
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};

if (in_array($title, ['', TextileHeritageCatalog::TITLE], true)
    || $title === (string)__('织艺谱系 · Textile Heritage')
) {
    $title = $translateDefaultCopy(TextileHeritageCatalog::TITLE, 'Textile Heritage');
}

if (!in_array($columns, ['4', '5', '6', '8'], true)) {
    $columns = '6';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'grid';
}

if ($brands === []) {
    foreach (TextileHeritageCatalog::items() as $item) {
        $brands[] = [
            'name' => $item['name'],
            'caption' => $translateDefaultCopy($item['caption'], $item['caption_en']),
            'image' => $item['image'],
            'link' => $item['link'],
        ];
    }
} else {
    foreach ($brands as &$brand) {
        if (!is_array($brand)) {
            continue;
        }
        $name = trim((string)($brand['name'] ?? ''));
        $caption = trim((string)($brand['caption'] ?? ''));
        if ($caption === '' && $name !== '') {
            foreach (TextileHeritageCatalog::items() as $item) {
                if ($item['name'] === $name) {
                    $brand['caption'] = $translateDefaultCopy($item['caption'], $item['caption_en']);
                    break;
                }
            }
        } elseif ($caption !== '') {
            foreach (TextileHeritageCatalog::items() as $item) {
                if ($item['caption'] === $caption || $item['name'] === $caption) {
                    $brand['caption'] = $translateDefaultCopy($item['caption'], $item['caption_en']);
                    break;
                }
            }
        }
    }
    unset($brand);
}
?>

<link rel="stylesheet"
      href="@static(Weline_Product::css/widgets/textile-heritage.css)?v=20260903-th1">

<section class="<?= $esc($wc) ?> weline-textile-heritage<?= $grayscale ? ' is-grayscale' : '' ?><?= $hoverColor ? ' has-hover-color' : '' ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-columns="<?= $esc($columns) ?>"
         data-testid="textile-heritage">

    <?php if ($title !== ''): ?>
        <div class="brands-header">
            <h2 class="brands-title"><?= $esc($title) ?></h2>
        </div>
    <?php endif; ?>

    <div class="brands-container">
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-prev" type="button" aria-label="<?= __('上一组') ?>">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>

        <div class="brands-wrapper">
            <div class="brands-grid columns-<?= $esc($columns) ?>">
                <?php foreach ($brands as $brand): ?>
                    <?php
                    if (!is_array($brand)) {
                        continue;
                    }
                    $brandLink = LegacyMediaUrl::sanitize($brand['link'] ?? '');
                    $brandImage = LegacyMediaUrl::sanitize($brand['image'] ?? '');
                    $brandImageHtml = trim((string)($brand['image_file_html'] ?? ''));
                    $brandName = trim((string)($brand['name'] ?? ''));
                    $brandCaption = trim((string)($brand['caption'] ?? ''));
                    ?>
                    <?php if ($brandLink !== ''): ?>
                        <a href="<?= $esc($brandLink) ?>"
                           class="brand-item"
                           title="<?= $esc($brandName) ?>">
                    <?php else: ?>
                        <div class="brand-item">
                    <?php endif; ?>
                        <?php if ($brandImageHtml !== ''): ?>
                            <div class="brand-logo-media"><?= $brandImageHtml ?></div>
                        <?php elseif ($brandImage !== ''): ?>
                            <img src="<?= $esc($brandImage) ?>"
                                 alt="<?= $esc($brandName) ?>"
                                 class="brand-logo"
                                 loading="lazy">
                        <?php endif; ?>
                        <?php if ($brandName !== ''): ?>
                            <span class="brand-copy">
                                <span class="brand-name"><?= $esc($brandName) ?></span>
                                <?php if ($brandCaption !== '' && $brandCaption !== $brandName): ?>
                                    <span class="brand-caption"><?= $esc($brandCaption) ?></span>
                                <?php elseif ($brandCaption !== '' && $brandImage === '' && $brandImageHtml === ''): ?>
                                    <span class="brand-caption"><?= $esc($brandCaption) ?></span>
                                <?php endif; ?>
                            </span>
                        <?php endif; ?>
                    <?= $brandLink !== '' ? '</a>' : '</div>' ?>
                <?php endforeach; ?>
            </div>
        </div>

        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-next" type="button" aria-label="<?= __('下一组') ?>">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
    </div>
</section>

<?php if ($layout === 'carousel'): ?>
<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var grid = root.querySelector('.brands-grid');
    var prevBtn = root.querySelector('.carousel-prev');
    var nextBtn = root.querySelector('.carousel-next');
    if (!grid || !prevBtn || !nextBtn) return;

    var offset = 0;
    var step = 0;

    function recalc() {
        var item = grid.querySelector('.brand-item');
        if (!item) return;
        step = item.offsetWidth + 20;
    }

    function slide(direction) {
        recalc();
        if (!step) return;
        var maxOffset = Math.max(0, grid.scrollWidth - grid.parentElement.offsetWidth);
        offset = Math.max(0, Math.min(maxOffset, offset + direction * step));
        grid.style.transform = 'translateX(-' + offset + 'px)';
    }

    prevBtn.addEventListener('click', function () { slide(-1); });
    nextBtn.addEventListener('click', function () { slide(1); });
    window.addEventListener('resize', recalc);
    recalc();
})();
</script>
<?php endif; ?>
