<?php
/**
 * International storefront new-arrivals collection.
 *
 * @var \Weline\Framework\View\Template $this
 */

$items = $this->getData('storefront_new_arrivals');
$items = is_array($items) ? array_values($items) : [];
$count = (int)($this->getData('storefront_new_arrivals_count') ?? count($items));
$pageTitle = trim((string)($this->getData('page_title') ?? ''));
$pageTitle = $pageTitle !== '' ? $pageTitle : (string)__('新品上架');
$rssUrl = trim((string)($this->getData('storefront_new_arrivals_rss_url') ?? '/new-arrivals/rss.xml'));
$rssHref = preg_match('#^https?://#i', $rssUrl) === 1
    ? $rssUrl
    : (string)$this->getUrl(ltrim($rssUrl, '/'));

$escape = static fn(mixed $value): string => htmlspecialchars(
    (string)$value,
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$pick = static function (array $item, array $keys, mixed $fallback = ''): mixed {
    foreach ($keys as $key) {
        if (array_key_exists($key, $item) && $item[$key] !== null && $item[$key] !== '') {
            return $item[$key];
        }
    }

    return $fallback;
};
?>
<section class="new-arrivals-page"
         data-testid="storefront-new-arrivals"
         weline-code="product.frontend.new_arrivals.section_1">
    <header class="new-arrivals-page__hero">
        <p class="new-arrivals-page__eyebrow"><?= $escape(__('新作入藏')) ?></p>
        <div class="new-arrivals-page__title-row">
            <h1 class="new-arrivals-page__title"><?= $escape($pageTitle) ?></h1>
            <?php if ($rssHref !== ''): ?>
                <a class="new-arrivals-page__rss w-button"
                   data-tone="neutral"
                   data-variant="outline"
                   data-size="sm"
                   href="<?= $escape($rssHref) ?>"
                   type="application/rss+xml"
                   rel="alternate"
                   data-testid="new-arrivals-rss-subscribe">
                    <?= $escape(__('订阅 RSS')) ?>
                </a>
            <?php endif; ?>
        </div>
        <p class="new-arrivals-page__lede">
            <?php $lede = trim((string)($this->getData('storefront_new_arrivals_lede') ?? '')); ?>
            <?= $escape($lede !== '' ? $lede : __('甄选近期上架的汉服、马面裙与传统配饰，循时序发现新的东方衣冠。')) ?>
        </p>
        <p class="new-arrivals-page__count" data-testid="storefront-new-arrivals-count">
            <?= $escape(__('共 %{1} 件新品', [$count])) ?>
        </p>
    </header>

    <?php if ($items !== []): ?>
        <div class="new-arrivals-page__grid" role="list" aria-label="<?= $escape($pageTitle) ?>">
            <?php foreach ($items as $index => $item): ?>
                <?php
                if (!is_array($item)) {
                    continue;
                }
                $productId = (int)$pick($item, ['product_id', 'id'], 0);
                $name = trim((string)$pick($item, ['name', 'title'], __('汉服商品')));
                $url = trim((string)$pick($item, ['url', 'product_url', 'detail_url', 'link'], '/products'));
                $image = trim((string)$pick($item, ['image_url', 'image', 'thumbnail_url', 'thumbnail'], ''));
                $priceRaw = trim((string)$pick($item, ['formatted_price', 'price_label', 'price'], ''));
                if ($priceRaw !== '' && !preg_match('/\d+\.\d{2}/', $priceRaw)) {
                    // 与列表卡同源格式：符号 + 两位小数（mapOffer 给的是 float 分值换算数）
                    $amount = (float)preg_replace('/[^\d.]/', '', $priceRaw);
                    $currencyCode = trim((string)$pick($item, ['currency'], ''));
                    $priceRaw = $amount > 0
                        ? \Weline\Currency\Helper\CurrencySymbol::formatAmount($amount, $currencyCode !== '' ? $currencyCode : null)
                        : '';
                }
                $price = $priceRaw;
                $sku = trim((string)$pick($item, ['sku', 'offer_sku'], ''));
                ?>
                <article class="new-arrivals-page__card"
                         role="listitem"
                         data-testid="storefront-new-arrivals-card"
                         data-arrival-index="<?= $index + 1 ?>"
                         <?php if ($productId > 0): ?>data-product-id="<?= $productId ?>"<?php endif; ?>>
                    <?php if ($image !== ''): ?>
                        <a class="new-arrivals-page__media" href="<?= $escape($url) ?>" aria-label="<?= $escape($name) ?>">
                            <img src="<?= $escape($image) ?>"
                                 alt="<?= $escape($name) ?>"
                                 loading="<?= $index < 4 ? 'eager' : 'lazy' ?>"
                                 decoding="async">
                        </a>
                    <?php endif; ?>
                    <div class="new-arrivals-page__body">
                        <div class="new-arrivals-page__meta">
                            <span class="new-arrivals-page__badge"><?= $escape(__('新品')) ?></span>
                            <?php if ($sku !== ''): ?>
                                <span class="new-arrivals-page__sku"><?= $escape($sku) ?></span>
                            <?php endif; ?>
                        </div>
                        <h2 class="new-arrivals-page__name">
                            <a href="<?= $escape($url) ?>"><?= $escape($name) ?></a>
                        </h2>
                        <?php if ($price !== ''): ?>
                            <p class="new-arrivals-page__price"><?= $escape($price) ?></p>
                        <?php endif; ?>
                        <a class="new-arrivals-page__action" href="<?= $escape($url) ?>">
                            <?= $escape(__('查看商品')) ?>
                        </a>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <div class="new-arrivals-page__empty" data-testid="storefront-new-arrivals-empty">
            <h2><?= $escape(__('新品正在整理')) ?></h2>
            <a class="new-arrivals-page__action" href="/products"><?= $escape(__('浏览全部商品')) ?></a>
        </div>
    <?php endif; ?>
</section>

