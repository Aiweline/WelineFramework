 * @var string $product_admin_state_json
 * @var list<array{category_id:int,name:string,path:string,depth:int}> $category_bulk_options
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null
        ? (string)$value
        : (json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: ''),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$productTypes = is_array($creation_context['product_types'] ?? null)
    ? $creation_context['product_types']
    : [];
$stores = is_array($creation_context['stores'] ?? null) ? $creation_context['stores'] : [];
$attributeCatalog = is_array($creation_context['attribute_catalog'] ?? null)
    ? $creation_context['attribute_catalog']
    : [];
$catalogSets = array_is_list($attributeCatalog)
    ? $attributeCatalog
    : ($attributeCatalog['sets'] ?? $attributeCatalog['attribute_sets'] ?? []);
$catalogSets = is_array($catalogSets) ? $catalogSets : [];
$createCategories = is_array($creation_context['categories'] ?? null)
    ? $creation_context['categories']
    : [];
$productCreateCategoryOptions = [];
foreach ($createCategories as $category) {
    if (!is_array($category)) {
        continue;
    }
    $categoryId = (int)($category['category_id'] ?? $category['id'] ?? 0);
    if ($categoryId <= 0) {
        continue;
    }
    $productCreateCategoryOptions[] = [
        'value' => (string)$categoryId,
        'label' => (string)($category['name'] ?? ('#' . $categoryId)),
        'meta' => (string)($category['path'] ?? ''),
        'parent_id' => (string)max(0, (int)($category['parent_id'] ?? $category['pid'] ?? 0)),
    ];
}
$productCreateCategoryOptionsJson = json_encode(
    $productCreateCategoryOptions,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '[]';
$productCreateCategoryValue = '';
$productCreateCategoryEmpty = (string)__('未选择分类');
$productCreateCategoryPlaceholder = (string)__('搜索分类名称或路径');
$productCreateCategoryWebsiteId = (int)$website_id;
$createBrands = is_array($creation_context['brands'] ?? null)
    ? $creation_context['brands']
    : [];
$createSuppliers = is_array($creation_context['suppliers'] ?? null)
    ? $creation_context['suppliers']
    : [];
$productCreateBrandOptions = [];
foreach ($createBrands as $brandOption) {
    if (!is_array($brandOption)) {
        continue;
    }
    $brandId = (int)($brandOption['brand_id'] ?? 0);
    if ($brandId <= 0) {
        continue;
    }
    $productCreateBrandOptions[] = [
        'value' => (string)$brandId,
        'label' => (string)($brandOption['name'] ?? ('#' . $brandId)),
        'meta' => (string)($brandOption['code'] ?? ''),
        'image' => (string)($brandOption['logo_url'] ?? ''),
    ];
}
$productCreateBrandOptionsJson = json_encode(
    $productCreateBrandOptions,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '[]';
$productCreateSupplierOptions = [];
$productCreateSupplierBrandMap = [];
foreach ($createSuppliers as $supplierOption) {
    if (!is_array($supplierOption)) {
        continue;
    }
    $supplierId = (int)($supplierOption['supplier_id'] ?? 0);
    if ($supplierId <= 0) {
        continue;
    }
    $linkedBrandIds = [];
    foreach ((array)($supplierOption['brand_ids'] ?? []) as $linkedBrandId) {
        $linkedBrandId = (int)$linkedBrandId;
        if ($linkedBrandId > 0) {
            $linkedBrandIds[] = (string)$linkedBrandId;
        }
    }
    $productCreateSupplierBrandMap[(string)$supplierId] = $linkedBrandIds;
    $productCreateSupplierOptions[] = [
        'value' => (string)$supplierId,
        'label' => (string)($supplierOption['name'] ?? ('#' . $supplierId)),
        'meta' => (string)($supplierOption['code'] ?? ''),
        'image' => (string)($supplierOption['image_url'] ?? ''),
        'default_currency' => (string)($supplierOption['default_currency'] ?? ''),
        'store_url' => (string)($supplierOption['store_url'] ?? ''),
        'brand_ids' => $linkedBrandIds,
    ];
}
$productCreateSupplierOptionsJson = json_encode(
    $productCreateSupplierOptions,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '[]';
$productCreateSupplierBrandMapJson = json_encode(
    $productCreateSupplierBrandMap,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '{}';
$productCreateBrandValue = '';
$productCreateSupplierValue = '';
$productCreateBrandEmpty = (string)__('未指定品牌');
$productCreateSupplierEmpty = (string)__('未指定供应商');
$productCreateBrandPlaceholder = (string)__('搜索品牌名称或编码');
$productCreateSupplierPlaceholder = (string)__('搜索供应商名称或编码');
if ($productTypes !== []) {
    usort(
        $productTypes,
        static function (array $left, array $right): int {
            $rank = static function (array $row): int {
                return (string)($row['code'] ?? '') === 'configurable' ? 0 : 1;
            };
            $leftRank = $rank($left);
            $rightRank = $rank($right);
            if ($leftRank !== $rightRank) {
                return $leftRank <=> $rightRank;
            }

            return (string)($left['code'] ?? '') <=> (string)($right['code'] ?? '');
        },
    );
}
$defaultAttributeSetId = '';
$defaultAttributeSetCode = '';
$defaultAttributeSetLabel = '';
if ($catalogSets !== []) {
    $firstSet = reset($catalogSets);
    if (is_array($firstSet)) {
        $defaultAttributeSetId = (string)(
            $firstSet['attribute_set_id'] ?? $firstSet['set_id'] ?? $firstSet['id'] ?? ''
        );
        $defaultAttributeSetCode = (string)($firstSet['code'] ?? '');
        $defaultAttributeSetLabel = (string)(
            $firstSet['label'] ?? $firstSet['name'] ?? $defaultAttributeSetCode
        );
    }
}
$catalogTableRows = [];
$editLabel = (string)__('编辑');
$editWebsiteId = (int)$website_id;
if ($section === 'products') {
    foreach ($rows as $row) {
        if (!is_array($row)) {
            continue;
        }
        $prices = is_array($row['prices'] ?? null) ? $row['prices'] : [];
        $price = $prices[0] ?? null;
        $skus = is_array($row['skus'] ?? null) ? $row['skus'] : [];
        $mainMedia = is_array($row['main_media'] ?? null) ? $row['main_media'] : [];
        $priceDisplay = (is_array($price) && !($price['cleared'] ?? false))
            ? trim((string)($price['currency'] ?? '') . ' '
                . number_format(((int)($price['amount_minor'] ?? 0)) / 100, 2))
            : (string)__('未配置');
        $catalogTableRows[] = [
            'website_id' => (int)$website_id,
            'product_id' => (int)($row['product_id'] ?? 0),
            'product_id_label' => '#' . (int)($row['product_id'] ?? 0),
            'global_product_uuid' => (string)($row['global_product_uuid'] ?? ''),
            'main_image' => trim((string)($mainMedia['display_url'] ?? '')),
            'name' => (string)($row['name'] ?? __('未命名草稿')),
            'product_code' => (string)($row['product_code'] ?? ''),
            'owner_website_id' => (int)($row['owner_website_id'] ?? 0),
            'product_type' => (string)($row['product_type'] ?? ''),
            'status' => (string)($row['status'] ?? ''),
            'sku' => (string)($skus[0] ?? '-'),
            'offer_count' => (int)($row['offer_count'] ?? 0),
            'price_display' => $priceDisplay,
            'store_count' => count($row['selected_store_ids'] ?? []),
            'updated_at' => (string)($row['updated_at'] ?? '-'),
            'identity_version' => (int)($row['identity_version'] ?? 0),
            'local_version' => (int)($row['local_version'] ?? 0),
        ];
    }
    $editLabel = (string)__('编辑');
    $editWebsiteId = (int)$website_id;
}
