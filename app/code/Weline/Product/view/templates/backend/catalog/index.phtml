/**
 * @var \Weline\Framework\View\Template $this
 * @var string $title
 * @var string $section
 * @var int $website_id
 * @var list<array<string,mixed>> $rows
 * @var list<string> $columns
 * @var string $error
 * @var array<string,mixed> $filters
