<script>
(function () {
    'use strict';

    var tableEl = document.getElementById('w-datatable-product-supplier-list')
        || document.querySelector('#product-supplier-table-container [data-w-component="data-table"]');
    if (!tableEl) {
        return;
    }

    tableEl.addEventListener('weline:datatable:row-action', function (event) {
        var detail = event.detail || {};
        if (String(detail.action || '') !== 'disable') {
            return;
        }
        var row = detail.row || {};
        if (row.can_disable !== true && String(row.status || '') !== 'active') {
            return;
        }
        var supplierId = String(row.supplier_id || '');
        if (supplierId === '' || supplierId === '0') {
            return;
        }
        var form = document.getElementById('product-supplier-disable-form');
        var idInput = form ? form.querySelector('[data-product-supplier-disable-id], [name="supplier_id"]') : null;
        if (!form || !idInput) {
            return;
        }
        idInput.value = supplierId;
        if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
        } else {
            form.submit();
        }
    });
})();
</script>
