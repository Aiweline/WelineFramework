/**
 * @var \Weline\Framework\View\Template $this
 * @var string $title
 * @var int $website_id
 * @var string $error
 * @var list<array<string,mixed>> $rows
 * @var array<string,mixed> $editing
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : '',
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$editingId = max(0, (int)($editing['supplier_id'] ?? 0));
$isEdit = $editingId > 0;
$rows = is_array($rows ?? null) ? $rows : [];
$brandOptions = is_array($brand_options ?? null) ? $brand_options : [];
$selectedBrandIds = [];
foreach ((array)($editing['brand_ids'] ?? []) as $bid) {
    $bid = (int)$bid;
    if ($bid > 0) {
        $selectedBrandIds[$bid] = true;
    }
}
$supplierBrandSelectOptions = [];
foreach ($brandOptions as $option) {
    if (!is_array($option)) {
        continue;
    }
    $bid = (int)($option['brand_id'] ?? 0);
    if ($bid <= 0) {
        continue;
    }
    $supplierBrandSelectOptions[] = [
        'value' => (string)$bid,
        'label' => (string)($option['name'] ?? ('#' . $bid)),
        'meta' => (string)($option['code'] ?? ''),
        'image' => (string)($option['logo_url'] ?? ''),
    ];
}
$supplierBrandSelectOptionsJson = json_encode(
    $supplierBrandSelectOptions,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '[]';
$supplierBrandSelectValue = implode(',', array_map('strval', array_keys($selectedBrandIds)));
$supplierBrandSelectEmpty = (string)__('未关联品牌');
$supplierBrandSelectPlaceholder = (string)__('搜索品牌名称或编码');
$imageUrl = trim((string)($editing['image_url'] ?? ''));
$imageAssetId = trim((string)($editing['image_asset_id'] ?? ''));
$supplierTableRows = [];
$editLabel = (string)__('编辑');
$disableLabel = (string)__('停用');
$openStoreLabel = (string)__('打开店铺');
$supplierWebsiteId = (int)$website_id;
$displayableImageUrl = static function (string $url): string {
    $url = trim($url);
    if ($url === '') {
        return '';
    }
    if (preg_match('#^(https?:|blob:|data:)#i', $url) === 1) {
        return $url;
    }
    if (str_contains($url, '..') || str_contains($url, '\\') || str_contains($url, '://')) {
        return '';
    }
    if (class_exists(\Weline\FileManager\Api\Image::class)) {
        $resolved = \Weline\FileManager\Api\Image::pathToMediaUrl($url, 64, 64);

        return is_string($resolved) && $resolved !== '' ? $resolved : $url;
    }

    return str_starts_with($url, '/') ? $url : '';
};
foreach ($rows as $row) {
    if (!is_array($row)) {
        continue;
    }
    $supplierId = (int)($row['supplier_id'] ?? 0);
    $status = (string)($row['status'] ?? 'active');
    $storeUrl = trim((string)($row['store_url'] ?? ''));
    $contactName = trim((string)($row['contact_name'] ?? ''));
    $name = (string)($row['name'] ?? '');
    $linkedBrands = is_array($row['brands'] ?? null) ? $row['brands'] : [];
    $brandNames = [];
    foreach ($linkedBrands as $linked) {
        if (!is_array($linked)) {
            continue;
        }
        $brandName = trim((string)($linked['name'] ?? ''));
        if ($brandName !== '') {
            $brandNames[] = $brandName;
        }
    }
    $supplierTableRows[] = [
        'website_id' => $supplierWebsiteId,
        'supplier_id' => $supplierId,
        'supplier_id_label' => '#' . $supplierId,
        'image_url' => $displayableImageUrl((string)($row['image_url'] ?? '')),
        'name' => $contactName !== '' ? ($name . ' · ' . $contactName) : $name,
        'code' => (string)($row['code'] ?? ''),
        'brands_label' => $brandNames === [] ? '—' : implode('、', $brandNames),
        'store_url' => $storeUrl,
        'store_label' => $storeUrl !== '' ? $openStoreLabel : '—',
        'status' => $status,
        'status_label' => $status === 'active' ? (string)__('启用') : (string)__('停用'),
        'position' => (int)($row['position'] ?? 0),
        'can_disable' => $status === 'active',
        'has_store' => $storeUrl !== '',
    ];
}
$websiteOptionsForScope = json_decode((string)($websiteOptionsJson ?? '[]'), true);
if (!is_array($websiteOptionsForScope)) {
    $websiteOptionsForScope = [];
}
$supplierMediaIdentityScope = 'default.default.default';
foreach ($websiteOptionsForScope as $websiteOpt) {
    if (!is_array($websiteOpt)) {
        continue;
    }
    if ((int)($websiteOpt['website_id'] ?? -1) !== (int)$website_id) {
        continue;
    }
    $websiteCode = trim((string)($websiteOpt['code'] ?? ''));
    if ($websiteCode !== '' && !str_contains($websiteCode, '.') && !str_contains($websiteCode, ':')) {
        $supplierMediaIdentityScope = strtolower($websiteCode) . '.default.default';
    }
    break;
}
$supplierMediaIdentityCode = trim((string)($editing['code'] ?? ''));
if ($supplierMediaIdentityCode === '' || str_contains($supplierMediaIdentityCode, ':')) {
    $supplierMediaIdentityCode = $editingId > 0 ? ('supplier-' . $editingId) : 'draft';
}
