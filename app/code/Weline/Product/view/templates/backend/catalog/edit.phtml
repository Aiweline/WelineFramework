<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var int $website_id
 * @var string $global_product_uuid
 * @var array<string,mixed> $snapshot
 * @var string $product_admin_state_json
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null
        ? (string)$value
        : (json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: ''),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$identity = is_array($snapshot['identity'] ?? null) ? $snapshot['identity'] : [];
$product = is_array($snapshot['product'] ?? null) ? $snapshot['product'] : [];
$offers = is_array($snapshot['offers'] ?? null) ? $snapshot['offers'] : [];
$attributes = is_array($snapshot['attributes'] ?? null) ? $snapshot['attributes'] : [];
$attributeCatalog = is_array($snapshot['attribute_catalog'] ?? null) ? $snapshot['attribute_catalog'] : [];
$catalogSets = array_is_list($attributeCatalog)
    ? $attributeCatalog
    : ($attributeCatalog['sets'] ?? $attributeCatalog['attribute_sets'] ?? []);
$catalogSets = is_array($catalogSets) ? $catalogSets : [];
$productEntityId = (int)($product['id'] ?? $product['product_id'] ?? 0);
$attributeRowsByCode = [];
foreach ($attributes as $attributeRow) {
    if (!is_array($attributeRow)
        || (string)($attributeRow['entity_type'] ?? 'product') !== 'product'
        || (int)($attributeRow['store_id'] ?? 0) !== 0
        || (string)($attributeRow['locale'] ?? '') !== ''
    ) {
        continue;
    }
    $attributeCode = (string)($attributeRow['attribute_code'] ?? '');
    if ($attributeCode !== '' && !isset($attributeRowsByCode[$attributeCode])) {
        $attributeRowsByCode[$attributeCode] = $attributeRow;
    }
}
$prices = is_array($snapshot['prices'] ?? null) ? $snapshot['prices'] : [];
$stores = is_array($snapshot['stores'] ?? null) ? $snapshot['stores'] : [];
$categories = is_array($snapshot['categories'] ?? null) ? $snapshot['categories'] : [];
$categoryAssignments = is_array($snapshot['category_assignments'] ?? null)
    ? $snapshot['category_assignments']
    : [];
$storeCategoryOverrides = is_array($snapshot['store_category_overrides'] ?? null)
    ? $snapshot['store_category_overrides']
    : [];
$media = is_array($snapshot['media_assignments'] ?? null)
    ? $snapshot['media_assignments']
    : (is_array($snapshot['media'] ?? null) ? $snapshot['media'] : []);
$storeMediaOverrides = is_array($snapshot['store_media_overrides'] ?? null)
    ? $snapshot['store_media_overrides']
    : [];
$assignedCategoryIds = [];
$categoryPositions = [];
foreach ($categoryAssignments as $assignment) {
    $categoryId = (int)($assignment['category_id'] ?? 0);
    if ($categoryId > 0 && !empty($assignment['selected'])) {
        $assignedCategoryIds[$categoryId] = true;
        $categoryPositions[$categoryId] = (int)($assignment['position'] ?? 0);
    }
}
$categoryOverridesByStore = [];
foreach ($storeCategoryOverrides as $override) {
    $storeId = (int)($override['store_id'] ?? 0);
    $categoryId = (int)($override['category_id'] ?? 0);
    if ($storeId > 0 && $categoryId > 0) {
        $categoryOverridesByStore[$storeId][$categoryId] = $override;
    }
}
$mediaOverridesByStore = [];
foreach ($storeMediaOverrides as $override) {
    $storeId = (int)($override['store_id'] ?? 0);
    $assetId = (string)($override['asset_id'] ?? '');
    if ($storeId > 0 && $assetId !== '') {
        $mediaOverridesByStore[$storeId][$assetId] = $override;
    }
}
$provider = is_array($snapshot['provider'] ?? null) ? $snapshot['provider'] : [];
$providerFields = is_array($snapshot['provider_fields'] ?? null)
    ? array_values(array_filter($snapshot['provider_fields'], 'is_array'))
    : [];
$providerUnknownFields = is_array($snapshot['provider_unknown_fields'] ?? null)
    ? $snapshot['provider_unknown_fields']
    : [];
$inventory = is_array($snapshot['inventory'] ?? null) ? $snapshot['inventory'] : [];
$inventoryRows = is_array($inventory['rows'] ?? null) ? $inventory['rows'] : [];
$inventoryErrors = is_array($inventory['errors'] ?? null) ? $inventory['errors'] : [];
$inventoryEditable = !empty($inventory['editable']);
$diagnostics = is_array($snapshot['diagnostics'] ?? null) ? $snapshot['diagnostics'] : [];
$diagnosticGroups = is_array($diagnostics['groups'] ?? null) ? $diagnostics['groups'] : [];
$auditEvents = is_array($snapshot['audit'] ?? null) ? $snapshot['audit'] : [];
$auditActionLabels = [
    'product.identity.created' => __('创建商品身份'),
    'offer.identity.created' => __('创建销售规格身份'),
    'offer.sku.renamed' => __('重命名 SKU'),
    'offer.identity.status_changed' => __('变更销售规格状态'),
    'product.lifecycle.published' => __('发布商品'),
    'product.lifecycle.disabled' => __('下架商品'),
    'product.lifecycle.archived' => __('归档商品'),
    'product.type.changed' => __('转换商品类型'),
    'product.share.granted' => __('授权 Website 复制'),
    'product.share.revoked' => __('撤销 Website 复制授权'),
    'product.ownership.transfer_requested' => __('发起归属转让'),
    'product.ownership.transferred' => __('确认归属转让'),
];
$permissions = is_array($snapshot['permissions'] ?? null) ? $snapshot['permissions'] : [];
$productStatus = (string)($product['status'] ?? 'draft');
$canEditBusiness = !empty($permissions['edit_business']) && $productStatus !== 'archived';
$canPublish = in_array($productStatus, ['draft', 'disabled'], true);
$canDisable = $productStatus === 'published';
$canArchive = in_array($productStatus, ['draft', 'disabled'], true);
$websiteOptions = is_array($website_options ?? null)
    ? array_values(array_filter($website_options, 'is_array'))
    : [];
$governanceWebsiteOptions = array_values(array_filter(
    $websiteOptions,
    static fn(array $option): bool => (int)($option['website_id'] ?? -1) !== (int)$website_id,
));
$canGovernance = $canEditBusiness;
$offerMatrix = is_array($snapshot['offer_matrix'] ?? null) ? $snapshot['offer_matrix'] : [];
$variantAxes = is_array($offerMatrix['axes'] ?? null) ? $offerMatrix['axes'] : [];
$variantRows = is_array($offerMatrix['rows'] ?? null) ? $offerMatrix['rows'] : [];
$isConfigurable = (string)($identity['product_type'] ?? '') === 'configurable';
$canEditStructure = !empty($permissions['edit_structure'])
    && !empty($offerMatrix['can_edit_structure']);
$name = '';
$typeConfiguration = [];
foreach ($attributes as $row) {
    if ((string)($row['entity_type'] ?? '') !== 'product'
        || (int)($row['store_id'] ?? 0) !== 0
        || !empty($row['cleared'])
    ) {
        continue;
    }
    if ((string)($row['attribute_code'] ?? '') === 'name' && $name === '') {
        $name = (string)($row['value'] ?? '');
    }
    if ((string)($row['attribute_code'] ?? '') === 'type_configuration'
        && is_array($row['value'] ?? null)
    ) {
        $typeConfiguration = $row['value'];
    }
}
$priceByOffer = [];
foreach ($prices as $priceRow) {
    if ((int)($priceRow['store_id'] ?? 0) !== 0) {
        continue;
    }
    $priceByOffer[(string)($priceRow['global_offer_uuid'] ?? '')] = $priceRow;
}
$attributesJson = json_encode(
    array_values(array_filter(
        $attributes,
        static fn(array $row): bool => (string)($row['attribute_code'] ?? '') !== 'name'
            && (string)($row['attribute_code'] ?? '') !== 'type_configuration',
    )),
    JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES,
) ?: '[]';
$providerUnknownFieldsJson = json_encode(
    $providerUnknownFields,
    JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES,
) ?: '{}';
?>
<link rel="stylesheet" href="@static(Weline_Product::css/backend/product-admin.css)?v=20260825-v7">
