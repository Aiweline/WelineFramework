                </article>
                <article class="w-card">
                    <div class="w-card__header"><h2><lang>可见 Store</lang></h2></div>
                    <div class="w-card__body"><strong class="w-product-kpi"><?= count(array_filter($stores, static fn(array $store): bool => !empty($store['product_selected']))) ?></strong></div>
                </article>
                <article class="w-card">
                    <div class="w-card__header"><h2><lang>媒体</lang></h2></div>
