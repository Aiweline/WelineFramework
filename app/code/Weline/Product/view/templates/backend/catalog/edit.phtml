                    <label class="w-field__label" for="product-edit-name"><lang>商品名称</lang></label>
                    <input class="w-input" id="product-edit-name" name="name" maxlength="255" value="<?= $escape($name) ?>" required>
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="product-edit-locale"><lang>语言</lang></label>
                    <input class="w-input" id="product-edit-locale" name="locale" maxlength="32" placeholder="zh_Hans_CN">
                </div>
                <div class="w-field">
                    <label class="w-field__label" for="product-edit-currency"><lang>币种</lang></label>
                    <input class="w-input" id="product-edit-currency" name="currency" value="CNY" maxlength="8" required>
                </div>
            </div></div>
        </div>

        <div class="w-product-editor__panel" data-product-panel="attributes" hidden>
            <div class="w-card"><div class="w-card__header">
                <div><h2><lang>商品属性值</lang></h2><p><lang>EAV 管理属性定义；这里填写本商品的实际值和继承方式。</lang></p></div>
            </div><div class="w-card__body">
                <div class="w-product-eav" id="product-eav-editor" data-testid="product-eav-editor" data-product-id="<?= $escape($productEntityId) ?>">
                    <?php if ($catalogSets !== []): ?>
                        <?php
                        $firstSet = reset($catalogSets);
                        $selectedSetId = is_array($firstSet)
                            ? (string)($firstSet['attribute_set_id'] ?? $firstSet['set_id'] ?? $firstSet['id'] ?? $firstSet['code'] ?? '0')
                            : '0';
                        ?>
                        <div class="w-product-eav__toolbar">
                            <div class="w-field">
                                <label class="w-field__label" for="product-attribute-set"><lang>属性集</lang></label>
                                <select class="w-select" id="product-attribute-set" data-eav-set-selector>
                                    <?php foreach ($catalogSets as $setIndex => $attributeSet): ?>
                                        <?php
                                        if (!is_array($attributeSet)) {
                                            continue;
                                        }
                                        $setId = (string)($attributeSet['attribute_set_id'] ?? $attributeSet['set_id'] ?? $attributeSet['id'] ?? $attributeSet['code'] ?? $setIndex);
                                        $setLabel = (string)($attributeSet['label'] ?? $attributeSet['name'] ?? $attributeSet['code'] ?? $setId);
                                        ?>
                                        <option value="<?= $escape($setId) ?>"<?= $setId === $selectedSetId ? ' selected' : '' ?>><?= $escape($setLabel) ?></option>
                                    <?php endforeach; ?>
                                </select>
                            </div>
                            <p class="w-field__help"><lang>切换属性集只改变当前可视化区域；其他属性行会继续保留在高级数据中。</lang></p>
                        </div>

                        <?php foreach ($catalogSets as $setIndex => $attributeSet): ?>
                            <?php
                            if (!is_array($attributeSet)) {
                                continue;
                            }
                            $setId = (string)($attributeSet['attribute_set_id'] ?? $attributeSet['set_id'] ?? $attributeSet['id'] ?? $attributeSet['code'] ?? $setIndex);
                            $groups = is_array($attributeSet['groups'] ?? null) ? $attributeSet['groups'] : [];
                            ?>
                            <div class="w-product-eav__set" data-eav-set-panel="<?= $escape($setId) ?>"<?= $setId === $selectedSetId ? '' : ' hidden' ?>>
                                <?php foreach ($groups as $groupIndex => $group): ?>
                                    <?php
                                    if (!is_array($group)) {
                                        continue;
                                    }
                                    $groupId = (string)($group['attribute_group_id'] ?? $group['group_id'] ?? $group['id'] ?? $group['code'] ?? $groupIndex);
                                    $groupLabel = (string)($group['label'] ?? $group['name'] ?? $group['code'] ?? $groupId);
                                    $groupAttributes = is_array($group['attributes'] ?? null) ? $group['attributes'] : [];
                                    ?>
                                    <fieldset class="w-product-eav__group">
                                        <legend><?= $escape($groupLabel) ?></legend>
                                        <div class="w-product-eav__grid">
                                            <?php foreach ($groupAttributes as $attributeIndex => $attribute): ?>
                                                <?php
                                                if (!is_array($attribute)) {
                                                    continue;
                                                }
                                                $code = (string)($attribute['attribute_code'] ?? $attribute['code'] ?? '');
                                                if ($code === '') {
                                                    continue;
                                                }
                                                $label = (string)($attribute['label'] ?? $attribute['name'] ?? $code);
                                                $valueType = strtolower((string)($attribute['value_type'] ?? $attribute['input_type'] ?? $attribute['frontend_input'] ?? 'string'));
                                                $controlType = match ($valueType) {
                                                    'number', 'integer', 'int', 'decimal', 'float' => 'number',
                                                    'boolean', 'bool', 'toggle' => 'boolean',
                                                    'date', 'datetime' => 'date',
                                                    'select', 'dropdown' => 'select',
                                                    'multiselect', 'multi_select', 'multiple' => 'multiselect',
                                                    'json' => 'json',
                                                    default => 'string',
                                                };
                                                $existingRow = is_array($attributeRowsByCode[$code] ?? null) ? $attributeRowsByCode[$code] : null;
                                                $fieldValue = $existingRow['value'] ?? null;
                                                $scopeState = (string)($existingRow['scope_state'] ?? (!empty($existingRow['cleared']) ? 'cleared' : 'explicit'));
                                                if (!in_array($scopeState, ['explicit', 'cleared', 'inherit'], true)) {
                                                    $scopeState = 'explicit';
                                                }
                                                $fieldId = 'product-eav-' . preg_replace('/[^a-zA-Z0-9_-]+/', '-', $setId . '-' . $groupId . '-' . $code . '-' . $attributeIndex);
                                                $options = is_array($attribute['options'] ?? null) ? $attribute['options'] : [];
                                                $selectedValues = is_array($fieldValue) ? array_map('strval', $fieldValue) : [(string)$fieldValue];
                                                $inputDisabled = $scopeState !== 'explicit';
                                                $required = !empty($attribute['required']) || !empty($attribute['is_required']);
                                                ?>
                                                <div class="w-product-eav__field"
                                                     data-eav-field
                                                     data-attribute-code="<?= $escape($code) ?>"
                                                     data-value-type="<?= $escape($controlType) ?>"
                                                     data-entity-type="<?= $escape($existingRow['entity_type'] ?? 'product') ?>"
                                                     data-entity-id="<?= $escape($existingRow['entity_id'] ?? $productEntityId) ?>"
                                                     data-store-id="<?= $escape($existingRow['store_id'] ?? 0) ?>"
                                                     data-locale="<?= $escape($existingRow['locale'] ?? '') ?>"
                                                     data-existing-row="<?= $existingRow === null ? '0' : '1' ?>"
                                                     data-required="<?= $required ? '1' : '0' ?>">
                                                    <div class="w-product-eav__field-heading">
                                                        <label class="w-field__label" for="<?= $escape($fieldId) ?>"><?= $escape($label) ?><?= $required ? ' *' : '' ?></label>
                                                        <code><?= $escape($code) ?></code>
                                                    </div>
                                                    <select class="w-select w-product-eav__state" data-eav-state aria-label="<?= $escape($label) ?> 取值方式">
                                                        <option value="explicit"<?= $scopeState === 'explicit' ? ' selected' : '' ?>><lang>本站填写</lang></option>
                                                        <option value="cleared"<?= $scopeState === 'cleared' ? ' selected' : '' ?>><lang>明确清空</lang></option>
                                                        <option value="inherit"<?= $scopeState === 'inherit' ? ' selected' : '' ?>><lang>继承默认</lang></option>
                                                    </select>
                                                    <?php if ($controlType === 'boolean'): ?>
                                                        <label class="w-product-eav__checkbox" for="<?= $escape($fieldId) ?>">
                                                            <input id="<?= $escape($fieldId) ?>" type="checkbox" data-eav-input<?= filter_var($fieldValue, FILTER_VALIDATE_BOOL) ? ' checked' : '' ?><?= $inputDisabled ? ' disabled' : '' ?>>
                                                            <span><lang>启用</lang></span>
                                                        </label>
                                                    <?php elseif ($controlType === 'select' || $controlType === 'multiselect'): ?>
                                                        <select class="w-select" id="<?= $escape($fieldId) ?>" data-eav-input<?= $controlType === 'multiselect' ? ' multiple size="5"' : '' ?><?= $inputDisabled ? ' disabled' : '' ?>>
                                                            <?php if ($controlType === 'select'): ?><option value=""><lang>请选择</lang></option><?php endif; ?>
                                                            <?php foreach ($options as $optionIndex => $option): ?>
                                                                <?php
                                                                $option = is_array($option) ? $option : ['value' => $option, 'label' => $option];
                                                                $optionValue = (string)($option['value'] ?? $option['option_id'] ?? $option['code'] ?? $optionIndex);
                                                                $optionLabel = (string)($option['label'] ?? $option['name'] ?? $option['code'] ?? $optionValue);
                                                                ?>
                                                                <option value="<?= $escape($optionValue) ?>"<?= in_array($optionValue, $selectedValues, true) ? ' selected' : '' ?>><?= $escape($optionLabel) ?></option>
                                                            <?php endforeach; ?>
                                                        </select>
                                                    <?php elseif ($controlType === 'json'): ?>
                                                        <textarea class="w-textarea w-code-input" id="<?= $escape($fieldId) ?>" rows="5" data-eav-input<?= $inputDisabled ? ' disabled' : '' ?>><?= $escape(is_array($fieldValue) ? (json_encode($fieldValue, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}') : $fieldValue) ?></textarea>
                                                    <?php else: ?>
                                                        <input class="w-input"
                                                               id="<?= $escape($fieldId) ?>"
                                                               type="<?= $controlType === 'number' ? 'number' : ($controlType === 'date' ? 'date' : 'text') ?>"
                                                               value="<?= $escape($fieldValue) ?>"
                                                               data-eav-input
                                                               <?= $controlType === 'number' ? 'step="any"' : '' ?>
                                                               <?= $inputDisabled ? 'disabled' : '' ?>>
                                                    <?php endif; ?>
                                                    <p class="w-field__help" data-eav-state-help><lang>本站填写会保存当前值；清空和继承不会把零值误判为缺失。</lang></p>
                                                </div>
                                            <?php endforeach; ?>
                                        </div>
                                    </fieldset>
                                <?php endforeach; ?>
                            </div>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <div class="w-alert" data-tone="warning"><lang>当前没有可用属性集。请先在 EAV 属性管理中启用属性定义，或使用下方高级数据维护迁移值。</lang></div>
                    <?php endif; ?>

                    <details class="w-product-eav__advanced" data-testid="product-eav-advanced">
                        <summary><lang>高级：完整属性行 JSON</lang></summary>
                        <div class="w-product-eav__advanced-body">
