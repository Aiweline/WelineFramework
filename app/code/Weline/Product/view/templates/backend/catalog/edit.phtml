<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var int $website_id
 * @var int $product_id
 * @var string $product_sku
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$defaultLabel = __('商品编辑');
$websiteText = (string)$website_id;
$currentSku = (string)$product_sku;
?>
<div class="container-fluid" data-testid="product-edit-workbench">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-1"><?= $escape($defaultLabel) ?></h4>
            <div class="text-muted"><lang>网站 ID：</lang><?= $escape($websiteText) ?> · <lang>商品 ID：</lang><?= $escape($product_id) ?></div>
        </div>
        <a href="@backend-url('*/backend/catalog/products')?website_id=<?= $escape($website_id) ?>" class="btn btn-outline-secondary">
            <i class="mdi mdi-arrow-left"></i> <lang>返回商品列表</lang>
        </a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <w:form method="post" action="@backend-url('*/backend/catalog/save-product')" class="row g-3" data-testid="product-edit-form" csrf="auto">
                <input type="hidden" name="website_id" value="<?= $escape($website_id) ?>">
                <input type="hidden" name="product_id" value="<?= $escape($product_id) ?>">

                <div class="col-md-6">
                    <label class="form-label"><lang>当前 SKU</lang></label>
                    <input class="form-control" value="<?= $escape($currentSku) ?>" disabled>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><lang>新 SKU</lang></label>
                    <input class="form-control" name="sku" value="<?= $escape($currentSku) ?>" required maxlength="128">
                </div>
                <div class="col-md-12 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary"><i class="mdi mdi-content-save-outline"></i> <lang>保存商品</lang></button>
                </div>
            </w:form>
        </div>
    </div>
</div>
