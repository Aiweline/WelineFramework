<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var int $website_id
 * @var int $product_id
 * @var string $product_sku
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : json_encode($value, JSON_UNESCAPED_UNICODE),
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$defaultLabel = __('商品编辑');
$websiteText = (string)$website_id;
$currentSku = (string)$product_sku;
?>
<div class="w-container" data-testid="product-edit-workbench">
    <div class="w-cluster" data-align="center" data-justify="between" style="--w-mb:var(--weline-space-4);">
        <div>
            <h4 style="--w-mb:var(--weline-space-1);"><?= $escape($defaultLabel) ?></h4>
            <div class="w-text" data-tone="muted"><lang>网站 ID：</lang><?= $escape($websiteText) ?> · <lang>商品 ID：</lang><?= $escape($product_id) ?></div>
        </div>
        <a href="@backend-url('*/backend/catalog/products')?website_id=<?= $escape($website_id) ?>" class="w-button" data-tone="neutral" data-variant="outline">
            <w:icon name="arrow-left" size="sm"></w:icon> <lang>返回商品列表</lang>
        </a>
    </div>

    <div class="w-card" style="--w-mb:var(--weline-space-4);">
        <div class="w-card__body">
            <w:form method="post" action="@backend-url('*/backend/catalog/save-product')" class="w-grid" data-testid="product-edit-form" csrf="auto" style="--w-gap:var(--weline-space-4);">
                <input type="hidden" name="website_id" value="<?= $escape($website_id) ?>">
                <input type="hidden" name="product_id" value="<?= $escape($product_id) ?>">

                <div style="--w-span-md:6;">
                    <label class="w-field__label"><lang>当前 SKU</lang></label>
                    <input class="w-input" value="<?= $escape($currentSku) ?>" disabled>
                </div>
                <div style="--w-span-md:6;">
                    <label class="w-field__label"><lang>新 SKU</lang></label>
                    <input class="w-input" name="sku" value="<?= $escape($currentSku) ?>" required maxlength="128">
                </div>
                <div class="w-cluster" data-justify="end" style="--w-span-md:12;--w-gap:var(--weline-space-2);">
                    <button type="submit" class="w-button" data-tone="primary"><w:icon name="save" size="sm"></w:icon> <lang>保存商品</lang></button>
                </div>
            </w:form>
        </div>
    </div>
</div>
