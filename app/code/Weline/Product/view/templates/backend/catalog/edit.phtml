                            <span class="w-field__label"><lang>显示名称</lang></span>
                            <input class="w-input" type="text" data-product-variant-option-label maxlength="128" required>
                        </label>
                        <label class="w-field">
                            <span class="w-field__label"><lang>规格值代码</lang></span>
                            <input class="w-input" type="text" data-product-variant-option-value maxlength="128" required>
                            <span class="w-field__help"><lang>用于组合键；默认同显示名称，可按需改成稳定代码。</lang></span>
                        </label>
                        <div class="w-field" data-product-variant-option-color-field hidden>
                            <span class="w-field__label"><lang>颜色</lang></span>
                            <div class="w-product-variant-option-dialog__color">
                                <input type="color" data-product-variant-option-swatch-color value="#cccccc" aria-label="@lang(颜色)">
                                <input class="w-input" type="text" data-product-variant-option-swatch-color-text
                                       maxlength="32" placeholder="#RRGGBB" aria-label="@lang(颜色色值)">
                            </div>
                        </div>
                        <div class="w-field" data-product-variant-option-image-field hidden>
                            <span class="w-field__label"><lang>规格图</lang></span>
                            <div class="w-product-variant-option-dialog__image">
                                <img class="w-product-variant-option-dialog__preview"
                                     data-product-variant-option-swatch-image-preview
                                     alt=""
                                     hidden>
                                <input type="hidden" data-product-variant-option-swatch-image value="">
                                <div class="w-cluster" data-gap="sm">
                                    <button class="w-button" type="button" data-variant="outline" data-product-variant-option-image-open>
                                        <lang>选择图片</lang>
                                    </button>
                                    <button class="w-button" type="button" data-variant="ghost" data-tone="danger"
                                            data-product-variant-option-image-clear hidden>
                                        <lang>清除</lang>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <footer class="w-product-variant-option-dialog__footer w-cluster" data-justify="end" data-gap="sm">
                        <button class="w-button" type="button" data-product-variant-option-cancel><lang>取消</lang></button>
                        <button class="w-button" type="button" data-tone="primary" data-product-variant-option-confirm>
                            <lang>添加规格值</lang>
                        </button>
                    </footer>
                </div>
            </dialog>

            <dialog class="w-product-media-picker"
                    data-w-component="dialog"
                    data-product-variant-option-image-dialog
                    aria-labelledby="product-variant-option-image-title">
                <div class="w-product-media-picker__surface">
                    <header>
                        <div>
                            <h2 id="product-variant-option-image-title"><lang>选择规格图</lang></h2>
                            <p><lang>为当前规格值选择色板/图板预览图。</lang></p>
                        </div>
                        <button class="w-button" type="button" data-product-variant-option-image-close aria-label="@lang(关闭)">
                            <lang>关闭</lang>
                        </button>
                    </header>
                    <iframe title="@lang(媒体库)"
                            src="about:blank"
                            data-product-variant-option-image-frame
                            data-src="@backend-url('media/backend/manager/iframe')?target=product-variant-option-image&multi=0&usage=1&ext=jpg,png,gif,webp"></iframe>
                </div>
            </dialog>
    </form>
</div>
