<script>
(function () {
    'use strict';

    var tableEl = document.getElementById('w-datatable-product-brand-list')
        || document.querySelector('#product-brand-table-container [data-w-component="data-table"]');
    if (!tableEl) {
        return;
    }

    tableEl.addEventListener('weline:datatable:row-action', function (event) {
        var detail = event.detail || {};
        if (String(detail.action || '') !== 'disable') {
            return;
        }
        var row = detail.row || {};
        if (row.can_disable !== true && String(row.status || '') !== 'active') {
            return;
        }
        var brandId = String(row.brand_id || '');
        if (brandId === '' || brandId === '0') {
            return;
        }
        var form = document.getElementById('product-brand-disable-form');
        var idInput = form ? form.querySelector('[data-product-brand-disable-id], [name="brand_id"]') : null;
        if (!form || !idInput) {
            return;
        }
        idInput.value = brandId;
        if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
        } else {
            form.submit();
        }
    });
})();
</script>
