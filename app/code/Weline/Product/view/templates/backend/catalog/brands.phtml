/**
 * @var \Weline\Framework\View\Template $this
 * @var string $title
 * @var int $website_id
 * @var string $error
 * @var list<array<string,mixed>> $rows
 * @var array<string,mixed> $editing
 */
$escape = static fn(mixed $value): string => htmlspecialchars(
    is_scalar($value) || $value === null ? (string)$value : '',
    ENT_QUOTES | ENT_SUBSTITUTE,
    'UTF-8',
);
$editingId = max(0, (int)($editing['brand_id'] ?? 0));
$isEdit = $editingId > 0;
$rows = is_array($rows ?? null) ? $rows : [];
$supplierOptions = is_array($supplier_options ?? null) ? $supplier_options : [];
$selectedSupplierIds = [];
foreach ((array)($editing['supplier_ids'] ?? []) as $sid) {
    $sid = (int)$sid;
    if ($sid > 0) {
        $selectedSupplierIds[$sid] = true;
    }
}
$brandSupplierSelectOptions = [];
foreach ($supplierOptions as $option) {
    if (!is_array($option)) {
        continue;
    }
    $sid = (int)($option['supplier_id'] ?? 0);
    if ($sid <= 0) {
        continue;
    }
    $brandSupplierSelectOptions[] = [
        'value' => (string)$sid,
        'label' => (string)($option['name'] ?? ('#' . $sid)),
        'meta' => (string)($option['code'] ?? ''),
        'image' => (string)($option['image_url'] ?? ''),
    ];
}
$brandSupplierSelectOptionsJson = json_encode(
    $brandSupplierSelectOptions,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
) ?: '[]';
$brandSupplierSelectValue = implode(',', array_map('strval', array_keys($selectedSupplierIds)));
$brandSupplierSelectEmpty = (string)__('未关联供应商');
$brandSupplierSelectPlaceholder = (string)__('搜索供应商名称或编码');
$logoUrl = trim((string)($editing['logo_url'] ?? ''));
$logoAssetId = trim((string)($editing['logo_asset_id'] ?? ''));
$brandTableRows = [];
$editLabel = (string)__('编辑');
$disableLabel = (string)__('停用');
$brandWebsiteId = (int)$website_id;
$displayableImageUrl = static function (string $url): string {
    $url = trim($url);
    if ($url === '') {
        return '';
    }
    if (preg_match('#^(https?:|blob:|data:)#i', $url) === 1) {
        return $url;
    }
    if (str_contains($url, '..') || str_contains($url, '\\') || str_contains($url, '://')) {
        return '';
    }
    if (class_exists(\Weline\FileManager\Api\Image::class)) {
        $resolved = \Weline\FileManager\Api\Image::pathToMediaUrl($url, 64, 64);

        return is_string($resolved) && $resolved !== '' ? $resolved : $url;
    }

    return str_starts_with($url, '/') ? $url : '';
};
$logoDisplayUrl = $displayableImageUrl($logoUrl);
foreach ($rows as $row) {
    if (!is_array($row)) {
        continue;
    }
    $brandId = (int)($row['brand_id'] ?? 0);
    $status = (string)($row['status'] ?? 'active');
    $linkedSuppliers = is_array($row['suppliers'] ?? null) ? $row['suppliers'] : [];
    $supplierNames = [];
    foreach ($linkedSuppliers as $linked) {
        if (!is_array($linked)) {
            continue;
        }
        $name = trim((string)($linked['name'] ?? ''));
        if ($name !== '') {
            $supplierNames[] = $name;
        }
    }
    $brandTableRows[] = [
        'website_id' => $brandWebsiteId,
        'brand_id' => $brandId,
        'brand_id_label' => '#' . $brandId,
        'logo_url' => $displayableImageUrl((string)($row['logo_url'] ?? '')),
        'name' => (string)($row['name'] ?? ''),
        'code' => (string)($row['code'] ?? ''),
        'suppliers_label' => $supplierNames === [] ? '—' : implode('、', $supplierNames),
        'status' => $status,
        'status_label' => $status === 'active' ? (string)__('启用') : (string)__('停用'),
        'position' => (int)($row['position'] ?? 0),
        'can_disable' => $status === 'active',
    ];
}
