    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #e5e7eb;
}
.amz-filter__heading {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
}
.amz-filter__dept,
.amz-filter__price {
    list-style: none;
    margin: 0;
    padding: 0;
}
.amz-filter__dept-root,
.amz-filter__dept-node {
    display: block;
    padding: 4px 0;
    color: #2162a1;
    text-decoration: none;
}
.amz-filter__dept-root { font-weight: 600; }
.amz-filter__dept-node.is-active-path { font-weight: 600; }
.amz-filter__dept-root:hover,
.amz-filter__dept-node:hover { color: #c45500; text-decoration: underline; }
.amz-filter__dept-current {
    display: block;
    padding: 4px 0;
    font-weight: 700;
    color: #0f1111;
}
.amz-filter__price-item {
    display: inline-grid;
    grid-template-columns: 1rem auto auto;
    align-items: center;
    justify-content: start;
    gap: 8px;
    max-width: 100%;
    padding: 5px 0;
    color: #0f1111;
    text-decoration: none;
}
.amz-filter__price-item:hover { color: #c45500; }
.amz-filter__radio {
    width: 14px;
    height: 14px;
    border: 1.5px solid #879596;
    border-radius: 50%;
    box-sizing: border-box;
}
.amz-filter__price-item.is-active .amz-filter__radio {
    border-color: #e47911;
    box-shadow: inset 0 0 0 3px #e47911;
}
.amz-filter__price-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
