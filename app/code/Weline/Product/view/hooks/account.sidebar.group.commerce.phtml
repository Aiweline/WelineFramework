<?php
/**
 * Account sidebar: My Quotes entry (commerce group).
 *
 * Hook: account.sidebar.group.commerce
 *
 * @hook-priority 162
 * @hook-sort-order 12
 * @hook-solo false
 *
 * Badge shell is empty; Weline_Frontend paints via account.menuSignals.
 */
use Weline\Framework\Runtime\RequestContext;
use Weline\Product\Model\ProductQuoteRequest;

$renderKey = 'weline_product.account_sidebar.quotes.rendered';
if (RequestContext::get($renderKey, false)) {
    return;
}
RequestContext::set($renderKey, true);

$section = ProductQuoteRequest::ACCOUNT_SECTION;
$signal = ProductQuoteRequest::MENU_SIGNAL_CODE;
?>
<a class="account-hook-nav-link motor-account-sidebar__link"
   href="@url{'customer/account/index'}#<?= htmlspecialchars($section, ENT_QUOTES, 'UTF-8') ?>"
   data-section="<?= htmlspecialchars($section, ENT_QUOTES, 'UTF-8') ?>"
   data-account-nav-link="true"
   data-account-nav-parent="commerce"
   data-account-menu-signal="<?= htmlspecialchars($signal, ENT_QUOTES, 'UTF-8') ?>">
    <span class="account-hook-nav-link__label motor-account-sidebar__link-label">
        <w:icon name="mail" size="sm"></w:icon>
        <span class="account-hook-nav-link__text motor-account-sidebar__link-text">
            <strong>
                <lang>我的询价</lang>
                <span class="account-menu-signal-badge" data-account-menu-signal-badge="1" hidden aria-hidden="true"></span>
            </strong>
            <span><lang>查看询价进度与回复</lang></span>
        </span>
    </span>
</a>
