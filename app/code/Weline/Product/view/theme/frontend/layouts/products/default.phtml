                                    $offers = $this->getData('storefront_offers');
                                    if (!\is_array($offers) || $offers === []) {
                                        try {
                                            /** @var \Weline\Product\Service\StorefrontCatalogViewService $catalogView */
                                            $catalogView = \Weline\Framework\Manager\ObjectManager::getInstance(
                                                \Weline\Product\Service\StorefrontCatalogViewService::class
                                            );
                                            $candidates = $catalogView->publishedListingCandidates(48);
                                            $offers = $catalogView->hydrateListingMedia($candidates);
                                            $this->assign('storefront_offers', $offers);
                                            $this->assign('storefront_offers_unfiltered', $candidates);
                                            if ($this->getData('storefront_heading') === null || $this->getData('storefront_heading') === '') {
                                                $this->assign('storefront_heading', (string)__('全部商品'));
                                            }
                                            if ($this->getData('storefront_lede') === null || $this->getData('storefront_lede') === '') {
                                                $this->assign(
                                                    'storefront_lede',
                                                    (string)__('浏览当前网站已发布的商品，可按分类与价格筛选。')
                                                );
                                            }
                                            $this->assign('storefront_listing_total', \count($candidates));
                                            $this->assign('storefront_listing_count', \count($offers));
                                            $this->assign('storefront_listing_page', 1);
                                            $this->assign('storefront_listing_page_size', \max(1, \count($offers)));
                                            $this->assign('storefront_listing_total_pages', 1);
                                            $this->assign('storefront_listing_page_options', []);
                                            $this->assign('storefront_listing_sort_options', []);
                                        } catch (\Throwable) {
                                            $offers = [];
                                        }
                                    }
                                    if (\is_array($offers) && $offers !== []) {
                                        echo $this->fetch('Weline_Product::templates/frontend/catalog/index.phtml');
