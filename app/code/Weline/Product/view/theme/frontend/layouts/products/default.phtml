    /* ---- 页面主体（本页未必加载完整 spacing token；间距给 rem/字面兜底） ---- */
    .products-layout__main {
        width: 100%;
        padding: var(--spacing-3, 0.75rem) 0 var(--spacing-5, 1.25rem);
    }

    .products-layout__container {
        width: min(100%, var(--weline-layout-content-max-width));
        max-width: 100%;
        margin: 0 auto;
        padding: 0 var(--weline-layout-content-padding-inline);
        box-sizing: border-box;
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: var(--spacing-4, 1rem);
        align-items: start;
    }

    .products-layout__container--search {
        display: block;
    }

    .products-layout__search-content {
        width: 100%;
    }

    /* ---- 筛选侧边栏（Amazon 密度：轻边框、少阴影） ---- */
    .products-layout__sidebar {
        background-color: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        position: sticky;
        top: calc(var(--header-height, 64px) + var(--spacing-3, 0.75rem));
        max-height: calc(100vh - var(--header-height, 64px) - var(--spacing-6, 1.5rem));
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .products-layout__sidebar-header {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: var(--spacing-4, 1rem) var(--spacing-5, 1.25rem);
        border-bottom: 1px solid var(--color-border-light, #e7e7e7);
        background-color: var(--color-bg-primary, #fff);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .products-layout__sidebar-title {
        font-size: var(--font-size-lg, 1.125rem);
        font-weight: 600;
        margin: 0;
        color: var(--color-text-primary, #0f1111);
    }

    .products-layout__sidebar-close {
        width: var(--size-control-sm, 35px);
        height: var(--size-control-sm, 35px);
        padding: 0;
        background: none;
        border: none;
        border-radius: var(--radius-md, 0.5rem);
        cursor: pointer;
        color: var(--color-text-secondary, #565959);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .products-layout__sidebar-close:hover {
        background-color: var(--color-bg-secondary, #f0f2f2);
        color: var(--color-text-primary, #0f1111);
    }

    .products-layout__sidebar-content {
        padding: var(--spacing-2, 0.5rem) 0 var(--spacing-4, 1rem);
    }

    /* ---- 主内容区域 ---- */
    .products-layout__content {
        min-width: 0;
    }

    /* ---- 筛选切换按钮（移动端） ---- */
    .products-layout__filter-toggle {
        display: none;
        align-items: center;
        gap: var(--spacing-2, 0.5rem);
        padding: var(--spacing-2, 0.5rem) var(--spacing-4, 1rem);
        background-color: var(--color-bg-primary, #fff);
        border: 1px solid var(--color-border-light, #d5d9d9);
        border-radius: 999px;
        cursor: pointer;
        color: var(--color-text-primary, #0f1111);
        font-size: var(--font-size-sm, 0.875rem);
        font-weight: 500;
        box-shadow: 0 1px 2px rgba(15, 17, 17, 0.08);
        transition: all 0.2s ease;
        margin-bottom: var(--spacing-4, 1rem);
    }

    .products-layout__filter-toggle:hover {
        background-color: var(--color-bg-secondary, #f0f2f2);
    }

    .products-layout__filter-toggle[aria-expanded="true"] {
        background-color: var(--color-accent, #232f3e);
        border-color: var(--color-accent, #232f3e);
        color: #fff;
    }

    .products-layout__filter-icon {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
    }

    /* ---- 工具栏 ---- */
    .products-layout__toolbar {
        margin-bottom: var(--spacing-4, 1rem);
        padding: 0;
        background-color: transparent;
        border-radius: 0;
        border: 0;
    }

    /* ---- 产品网格 ---- */
    .products-layout__grid {
        margin-bottom: var(--spacing-6, 1.5rem);
    }

    /* ---- 分页 ---- */
    .products-layout__pagination {
        display: flex;
        justify-content: center;
        padding: var(--spacing-4, 1rem) 0;
    }

    .products-layout__pagination:has(.products-layout__placeholder) {
        display: none;
    }

    /* ---- 推荐产品区域（Amazon：仅占主内容列，不与 sticky 侧栏重叠） ---- */
    .products-layout__recommendations {
        grid-column: 2 / -1;
        width: 100%;
        min-width: 0;
        margin-top: var(--spacing-6, 1.5rem);
        padding: var(--spacing-5, 1.25rem) 0 0;
        background: transparent;
        border-top: 1px solid var(--color-border-light, #e7e7e7);
        box-sizing: border-box;
    }

    .products-layout__container:not(:has(.products-layout__sidebar)) .products-layout__recommendations {
        grid-column: 1 / -1;
    }

    .products-layout__recommendations > :where(.weline-template-widget, .widget-wrapper, section[weline-code]) {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .products-layout__recommendations .weline-product-recommended {
        margin: 0;
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
    }

    .products-layout__recommendations .weline-product-recommended .wpc-viewport {
        border: none;
        border-radius: 0;
        background: transparent;
    }

    .products-layout__recommendations .weline-product-recommended .wpc-header,
    .products-layout__recommendations .weline-product-recommended[data-layout="grid"] .wpc-header {
        padding-inline: 0;
        margin-bottom: 0.75rem;
    }

    .products-layout__recommendations .weline-product-recommended .wpc-track {
        padding: 0;
        gap: var(--spacing-4, 1rem);
    }

    .products-layout__recommendations .weline-product-recommended[data-layout="grid"] .wpc-card {
        border-color: #e7e7e7;
        box-shadow: none;
    }

    .products-layout__recommendations .weline-product-recommended[data-layout="grid"] .wpc-card:hover {
        border-color: #c8cccc;
        box-shadow: 0 1px 4px rgba(15, 17, 17, 0.06);
        transform: none;
    }

    /* ---- 遮罩层 ---- */
    .products-layout__overlay {
        position: fixed;
        inset: 0;
        background-color: color-mix(in srgb, #0f1111 50%, transparent);
        z-index: var(--z-index-overlay, 998);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .products-layout__overlay.is-visible {
        opacity: 1;
        visibility: visible;
    }

    /* ---- 占位符 ---- */
    .products-layout__placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-4, 1rem);
        padding: var(--spacing-8, 2rem) var(--spacing-4, 1rem);
        text-align: center;
        color: var(--color-text-tertiary, #879596);
    }

    .products-layout__placeholder-icon {
        color: var(--color-text-disabled, #bbb);
    }

    .products-layout__placeholder-text {
        font-size: var(--font-size-sm, 0.875rem);
    }

    /* ---- 编辑模式样式由 editor-mode.css 统一管理 ---- */

    /* ---- 响应式设计 ---- */
    @media (max-width: 992px) {
        .products-layout__container {
            grid-template-columns: 1fr;
            padding: 0 var(--spacing-4, 1rem);
        }

        .products-layout__recommendations {
            grid-column: 1 / -1;
            margin-top: var(--spacing-5, 1.25rem);
            padding-top: var(--spacing-4, 1rem);
        }

        .products-layout__filter-toggle {
            display: inline-flex;
        }

        .products-layout__sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: min(85%, 360px);
            height: 100vh;
            max-height: 100vh;
            border-radius: 0;
            border: none;
            border-right: 1px solid var(--color-border-light, #e7e7e7);
            background-color: #fff;
            z-index: var(--z-index-drawer, 1045);
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
            padding: 0;
        }

        .products-layout__sidebar.is-open {
            transform: translateX(0);
        }

        .products-layout__sidebar-header {
            display: flex;
        }

        .products-layout__sidebar-content {
            flex: 1;
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: var(--spacing-4, 1rem) var(--spacing-5, 1.25rem);
        }

        .products-layout__overlay {
            display: block;
        }
    }

    @media (max-width: 768px) {
        .products-layout__main {
            padding: var(--spacing-3, 0.75rem) 0;
        }

        .products-layout__container {
            padding: 0 var(--spacing-3, 0.75rem);
        }

        .products-layout__toolbar {
            padding: 0;
        }

        .products-layout__recommendations {
            margin-top: var(--spacing-4, 1rem);
            padding-top: var(--spacing-3, 0.75rem);
        }
    }
    </style>

    <!-- 编辑模式脚本由 ThemeEditor 控制器注入 -->
    <w:hook>seo::footer</w:hook>
</body>
</html>
