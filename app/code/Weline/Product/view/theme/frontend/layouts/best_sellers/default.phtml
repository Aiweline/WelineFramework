<?php
/**
 * 布局：热销榜页
 *
 * Product 模块贡献的店面热销榜布局，含 header/面包屑/主内容槽/footer。
 *
 * @meta.name {default="热销榜布局",name="热销榜布局",description="店面热销商品排行榜页面布局"}
 * @meta.description {default="热销榜页面布局，含页头、面包屑、排名主内容与页脚",name="描述",description="热销榜页面布局"}
 * @meta.category {default="catalog",name="商品",description="布局所属分类"}
 * @param.title {default="热销榜",name="页面标题",description="页面标题"}
 * @param.content {default="",name="主要内容（HTML字符串）",description="控制器渲染的热销榜内容"}
 * @param.showHeader {default=true,name="是否显示header",description="是否显示站点头部"}
 * @param.showFooter {default=true,name="是否显示footer",description="是否显示站点底部"}
 * @param.showBreadcrumb {default=true,name="是否显示面包屑",description="是否显示面包屑导航"}
 * @param.class {default="",name="额外CSS类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body class="best-sellers-layout">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>

    <div class="weline-page-wrapper best-sellers-layout__page">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <if condition="meta.showBreadcrumb">
            <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
            <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>
        </if>

        <div class="weline-main-content">
            <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>

            <w:slot id="content"
                    name="内容区"
                    accept="layout-best-sellers-content,layout-default-content,content,product-list,product-grid,bestsellers,product-carousel,banner"
                    reject="header,footer"
                    multiple="true"
                    position="content"
                    class="best-sellers-layout__content-root-slot">
                <main class="best-sellers-layout__main <?= htmlspecialchars((string)($meta['class'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                      id="main-content"
                      data-layout="best_sellers"
                      data-testid="storefront-best-sellers-layout">
                    <w:slot id="best-sellers-hero"
                            name="热销榜页头"
                            accept="layout-best-sellers-hero,best-sellers-hero,banner,content"
                            exclusive="true"
                            multiple="false"
                            position="content"
                            class="best-sellers-layout__hero-slot">
                        <?php /* Product 自有部件默认观感（同 homepage-hero）：exclusive 避免模板壳与无 template_ref 的布局行叠成双页头 */ ?>
                        <w:widget type="banner" name="best-sellers-hero" />
                    </w:slot>
                    <w:slot id="best-sellers-main"
                            name="热销榜主区"
                            accept="layout-best-sellers-main,bestsellers,product-grid,product-list,content"
                            multiple="true"
                            position="content">
                        <if condition="meta.content">
                            {{meta.content}}
                        <elseif condition="content"/>
                            {{content}}
                        <elseif condition="meta.contentTemplate"/>
                            <?php echo $this->fetch($this->getData("meta.contentTemplate")); ?>
                        <elseif condition="contentTemplate"/>
                            <?php echo $this->fetch($this->getData("contentTemplate")); ?>
                        <else/>
                            <div class="best-sellers-layout__placeholder" data-placeholder="best-sellers-main">
                                <lang>热销榜内容由控制器渲染</lang>
                            </div>
                        </if>
                    </w:slot>
                </main>
            </w:slot>

            <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
        </div>


        <w:slot id="best-sellers-bottom"
                name="畅销榜底部扩展"
                accept="layout-best-sellers-bottom,banner,promo-banner,content,container,product,category,carousel,trust-badges"
                reject="header,footer,navigation"
                multiple="true"
                append="true"
                position="content"
                class="best-sellers-bottom-slot">
        </w:slot>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default"/>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-after</w:hook>
        </if>
    </div>

    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>

<style>
.best-sellers-layout {
    margin: 0;
    min-height: 100vh;
    color: var(--color-text-primary, #0f1111);
    background: var(--color-bg-canvas, #ffffff);
}
.best-sellers-layout__main {
    box-sizing: border-box;
    width: min(100%, var(--weline-layout-content-max-width));
    max-width: 100%;
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2rem) var(--weline-layout-content-padding-inline) clamp(2.5rem, 5vw, 3.5rem);
}
.best-sellers-layout__placeholder {
    padding: 2rem;
    text-align: center;
    color: var(--color-text-secondary, #565959);
    border: 1px dashed var(--color-border-default, #ddd);
    border-radius: 8px;
}
</style>
    <w:hook>seo::footer</w:hook>
</body>
</html>
