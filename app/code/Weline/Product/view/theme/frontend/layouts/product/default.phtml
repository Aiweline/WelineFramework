 * 布局：商品详情页
 *
 * 电商商品详情页布局，包含产品图片画廊、产品信息、详情标签、相关产品推荐等区域
 * 支持右侧固定边栏、标签页切换、相关产品轮播等功能
 *
 * @meta.name {default="商品详情页布局",name="商品详情页布局",description="电商商品详情页布局，包含产品图片、信息、详情标签和推荐区域"}
 * @meta.description {default="商品详情页布局，包含产品图片画廊、产品信息、规格标签、详情标签页、相关产品推荐，支持右侧固定边栏和响应式设计",name="商品详情页布局",description="商品详情页布局，包含产品图片画廊、产品信息、规格标签、详情标签页、相关产品推荐，支持右侧固定边栏和响应式设计"}
 * @meta.category {default="catalog",name="商品详情",description="布局所属分类"}
 * @param title {default="商品详情",name="页面标题",description="页面标题，用于设置页面标题"}
 * @param content {default="",name="主要内容（HTML字符串）",description="主要内容（HTML字符串），用于设置页面内容"}
 * @param showHeader {default=true,name="是否显示header",description="是否显示header，用于控制header的显示"}
 * @param showFooter {default=true,name="是否显示footer",description="是否显示footer，用于控制footer的显示"}
 * @param showBreadcrumb {default=true,name="是否显示面包屑",description="是否显示面包屑导航"}
 * @param showSidebar {default=false,name="是否显示侧边栏",description="是否显示右侧边栏（相关产品推荐等）"}
 * @param showRelatedProducts {default=false,name="是否显示相关产品",description="是否显示相关产品推荐区域（相关/热销/搭配）；猜你喜欢与最近浏览为常显槽，不受此开关控制；默认关闭"}
 * @param showReviews {default=true,name="是否显示评论容器",description="是否显示商品评论容器槽（由评论模块 default_injections 注入，布局不直接加载部件）"}
 * @param showFaq {default=true,name="是否显示 FAQ 容器",description="是否显示商品 FAQ 容器槽（由 Faq 模块 default_injections 注入，布局不直接加载部件）"}
 * @param showTabs {default=false,name="是否显示详情标签",description="是否显示产品详情标签区域"}
 * @param class {default="",name="额外CSS类",description="额外CSS类，用于设置页面额外CSS类"}
 * @param layout.leftsider {default=0,option={0:不显示,1:显示},name="显示左侧栏",description="是否显示左侧栏，用于控制布局结构"}
 * @param layout.rightsider {default=0,option={0:不显示,1:显示},name="显示右侧栏",description="是否显示右侧栏，用于控制布局结构"}
 *
 * 参数配置由 ControllerFetchFileBefore Observer 自动加载到 meta 数组中
 * 模板中使用 meta.参数 输出内容，使用 meta.参数 在条件判断中
 * 页面标题由 Observer 自动设置（如果控制器未设置，则使用 meta.title 的默认值）
 *
 * 产品主信息由同模块布局内嵌 `<w:widget type="product" name="product-info" />`（placement=layout）；
 * 禁止再声明 required default_injections，否则会与模板壳叠成双主信息。
 */
$meta = $this->getData('meta') ?? [];
$colors = $this->getData('colors') ?? [];

// 新增参数
$coerceBool = static function (mixed $value, bool $default): bool {
    if ($value === null) {
        return $default;
    }
    if (is_bool($value)) {
        return $value;
    }
    if (is_int($value) || is_float($value)) {
        return ((int)$value) !== 0;
    }
    $normalized = strtolower(trim((string)$value));
    if ($normalized === '' || $normalized === 'default') {
        return $default;
    }
    if (in_array($normalized, ['1', 'true', 'yes', 'on'], true)) {
        return true;
    }
    if (in_array($normalized, ['0', 'false', 'no', 'off'], true)) {
        return false;
    }
    return $default;
};
$showSidebar = $coerceBool($meta['showSidebar'] ?? $this->getData('showSidebar'), false);
$showRelatedProducts = $coerceBool($meta['showRelatedProducts'] ?? $this->getData('showRelatedProducts'), false);
$showReviews = $coerceBool($meta['showReviews'] ?? $this->getData('showReviews'), true);
$showFaq = $coerceBool($meta['showFaq'] ?? $this->getData('showFaq'), true);
// Product main info + description/specs live in the product-info widget; tabs stay off by default.
$showTabs = $coerceBool($meta['showTabs'] ?? $this->getData('showTabs'), false);

$meta['showSidebar'] = $showSidebar;
$meta['showRelatedProducts'] = $showRelatedProducts;
$meta['showReviews'] = $showReviews;
$meta['showFaq'] = $showFaq;
$meta['showTabs'] = $showTabs;
$this->assign('meta', $meta);
?>
