    .product-detail-layout__personalization-stack > .product-detail-layout__related-slot,
    .product-detail-layout__personalization .product-detail-layout__related-slot {
        width: 100%;
        min-width: 0;
        margin-block: var(--spacing-4, 1rem) 0;
    }

    .product-detail-layout__personalization .product-detail-layout__related-slot > .widget-wrapper {
        width: 100%;
        min-width: 0;
        display: block;
    }

    .product-detail-layout__related-slot {
        width: 100%;
        min-width: 0;
    }

    .product-detail-layout__related-slot > .widget-wrapper {
        width: 100%;
        min-width: 0;
    }

    .product-detail-layout__related-slot > .widget-wrapper > .widget-products {
        max-width: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .product-detail-layout__related .widget-products,
    .product-detail-layout__related .widget-wrapper > .widget-products,
    .product-detail-layout__main ~ .widget-products,
    .weline-main-content > .widget-products {
        width: min(100%, var(--weline-layout-content-max-width));
        max-width: 100%;
        margin: 0 auto;
        padding: var(--spacing-6) var(--weline-layout-content-padding-inline);
        box-sizing: border-box;
    }

    .product-detail-layout__related .widget-products .products-grid,
    .product-detail-layout__main ~ .widget-products .products-grid,
    .weline-main-content > .widget-products .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(var(--size-panel-220), 1fr));
        gap: var(--spacing-4);
        width: 100%;
    }

    .product-detail-layout__related .widget-products .product-card,
    .product-detail-layout__main ~ .widget-products .product-card,
    .weline-main-content > .widget-products .product-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        overflow: hidden;
        border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border-color-subtle);
        border-radius: var(--radius-lg);
        background: var(--weline-layout-surface-primary);
        box-shadow: var(--weline-theme-shadow-sm);
    }

    /*
     * Some product-detail render paths currently nest the global footer
     * under the detail container in the final DOM. When that happens,
     * force the footer to break out of the centered container and span
     * the viewport width so the visible layout stays correct.
     */
    .product-detail-layout__container > .weline-footer,
    .product-detail-layout__container > footer.font-display {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }

    /* ---- 占位符 ---- */
    .product-detail-layout__placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-4);
        padding: var(--spacing-8) var(--spacing-4);
        text-align: center;
        color: var(--color-text-tertiary);
    }

    .product-detail-layout__placeholder--product-info {
        align-items: stretch;
        gap: var(--spacing-4);
        min-height: 420px;
        padding: var(--spacing-4);
        text-align: left;
        color: inherit;
        background: #fff;
    }

    .product-detail-layout__preview-mock {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(220px, .85fr);
        border: 1px solid #d1d5db;
        background: #fff;
        overflow: hidden;
    }

    .product-detail-layout__preview-media {
        display: grid;
        min-height: 320px;
        place-items: center;
        background: #f3f4f6;
        color: #9ca3af;
        font-size: 48px;
        font-weight: 900;
        letter-spacing: .04em;
    }

    .product-detail-layout__preview-body {
        display: grid;
        align-content: center;
        gap: 16px;
        padding: 40px 36px;
    }

    .product-detail-layout__preview-eyebrow {
        margin: 0;
        color: #b91c1c;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .product-detail-layout__preview-title {
        display: grid;
        gap: 2px;
        color: #111827;
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 900;
        line-height: 1.05;
    }

    .product-detail-layout__preview-sku {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .product-detail-layout__placeholder-icon {
        color: var(--color-text-disabled);
    }

    .product-detail-layout__placeholder-text {
        font-size: var(--font-size-sm);
        text-align: center;
    }

    @media (max-width: 840px) {
        .product-detail-layout__preview-mock {
            grid-template-columns: 1fr;
        }

        .product-detail-layout__preview-media {
            min-height: 220px;
            font-size: 36px;
        }

        .product-detail-layout__preview-body {
            padding: 28px 20px;
        }
    }

    /* ---- 编辑模式样式由 editor-mode.css 统一管理 ---- */

    /* ---- 响应式设计 ---- */
    @media (max-width: 992px) {
        .product-detail-layout__wrapper {
            flex-direction: column;
        }

        .product-detail-layout__sidebar {
            width: 100%;
            position: static;
            max-height: none;
        }
    }

    @media (max-width: 768px) {
        .product-detail-layout__main {
            padding-block: var(--spacing-1, var(--weline-space-1, 0.25rem)) 0;
        }

        .product-detail-layout__container {
            padding: 0 var(--weline-layout-content-padding-inline);
        }

        .product-detail-layout__wrapper {
            gap: var(--spacing-4);
        }

        .product-detail-layout__tabs,
        .product-detail-layout__reviews,
        .product-detail-layout__faq,
        .product-detail-layout__related,
        .product-detail-layout__personalization {
            padding: var(--spacing-5) 0;
        }

        .product-detail-layout__tabs-container,
        .product-detail-layout__related-container,
        .product-detail-layout__personalization-container {
            padding: 0 var(--weline-layout-content-padding-inline);
        }
    }
    </style>

    <!-- 编辑模式脚本由 ThemeEditor 控制器注入 -->
    <w:hook>seo::footer</w:hook>
</body>
</html>
