<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Theme::layout_resolve">
        <observer name="Weline_Product::layout_resolve"
                  instance="Weline\Product\Observer\LayoutResolveObserver"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>
    <event name="Weline_DeveloperWorkspace::api_doc_collect_after">
        <observer name="Weline_Product::api_doc_demo"
                  instance="Weline\Product\Observer\ApiDocDemoObserver"
                  disabled="false"
                  shared="true"
                  sort="20"/>
    </event>
    <event name="Weline_Theme::all_menu_category_candidates">
        <observer name="Weline_Product::all_menu_category_candidates"
                  instance="Weline\Product\Observer\AllMenuCategoryCandidates"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Order::order_paid">
        <observer name="Weline_Product::grant_download_entitlements"
                  instance="Weline\Product\Observer\GrantDownloadEntitlementsOnOrderPaid"
                  disabled="false"
                  shared="true"
                  sort="30"
                  delivery="sync"
                  failure="critical"/>
    </event>
    <event name="Weline_Product::storefront_catalog_changed">
        <observer name="Weline_Product::storefront_catalog_cache_invalidator"
                  instance="Weline\Product\Observer\StorefrontCatalogCacheInvalidator"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Inventory::stock_projection_changed">
        <observer name="Weline_Product::inventory_stock_projection_changed"
                  instance="Weline\Product\Observer\InventoryStockProjectionChangedObserver"
                  disabled="false"
                  shared="true"
                  sort="10"/>
    </event>
    <event name="Weline_Mail::mail_message_sent">
        <observer name="Weline_Product::quote_request_mail_message_sent"
                  instance="Weline\Product\Observer\QuoteRequestMailMessageSentObserver"
                  disabled="false"
                  shared="true"
                  sort="10"
                  delivery="sync"/>
    </event>
    <event name="Weline_Framework::resource_changed"
           delivery="sync"
           failure="best_effort">
        <observer name="Weline_Product::geo_feed_projection"
                  instance="Weline\Product\Observer\GeoFeedProjectionObserver"
                  disabled="true"
                  shared="true"
                  sort="45"/>
    </event>
</config>
