
<?php
/**@var \Weline\Framework\View\Template $this */

$widgets = $this->getData('widgets') ?? [];
$allWidgets = $this->getData('allWidgets') ?? [];
$modules = $this->getData('modules') ?? [];
$allowedTypes = $this->getData('allowedTypes') ?? [];
$moduleFilter = $this->getData('moduleFilter') ?? '';
$typeFilter = $this->getData('typeFilter') ?? '';
$search = $this->getData('search') ?? '';
$totalWidgetCount = 0;
foreach ($allWidgets as $typeWidgets) {
    if (is_array($typeWidgets)) {
        $totalWidgetCount += count($typeWidgets);
    }
}
$filteredWidgetCount = 0;
foreach ($widgets as $typeWidgets) {
    if (is_array($typeWidgets)) {
        $filteredWidgetCount += count($typeWidgets);
    }
}
$totalTypeCount = count($allWidgets);
$totalModuleCount = count($modules);
$shortText = static function (mixed $value, int $length = 80): string {
    $text = trim((string)$value);
    if ($text === '') {
        return '';
    }
    if (function_exists('mb_strlen') && function_exists('mb_substr')) {
        return mb_strlen($text, 'UTF-8') > $length ? mb_substr($text, 0, $length, 'UTF-8') . '…' : $text;
    }
    return strlen($text) > $length ? substr($text, 0, $length) . '…' : $text;
};
$isAiWidget = static function (array $widget): bool {
    if (!empty($widget['is_ai_generated'])) {
        return true;
    }
    $meta = $widget['meta'] ?? null;
    return is_array($meta) && !empty($meta['is_ai_generated']);
};
