<js:part>
(function () {
    'use strict';

    var WIDGET_DETAIL_URL = "@backend-url{'widget/backend/widget/detail'}";
    var WIDGET_PREVIEW_URL = "@backend-url{'widget/backend/preview/widget'}";

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function defaultsFromParamsSchema(params) {
        var config = {};
        if (!params || typeof params !== 'object') return config;
        Object.keys(params).forEach(function (key) {
            var def = params[key];
            if (!def || typeof def !== 'object') return;
            if (Object.prototype.hasOwnProperty.call(def, 'default')) {
                config[key] = def['default'];
            }
        });
        return config;
    }

    function renderPreviewFrame(stageEl, html) {
        var frame = document.createElement('iframe');
        frame.setAttribute('sandbox', '');
        frame.setAttribute('referrerpolicy', 'no-referrer');
        frame.setAttribute('title', '<?= __('视觉预览') ?>');
        frame.setAttribute('data-testid', 'widget-admin-preview-frame');
        frame.srcdoc = '<!DOCTYPE html><html><head><meta charset="UTF-8">'
            + '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src http: https: data:; media-src http: https: data:; font-src http: https: data:; style-src \'unsafe-inline\'; form-action \'none\'; base-uri \'none\'; script-src \'none\'; object-src \'none\'">'
            + ''
            + '</head><body>' + html + '</body></html>';
        stageEl.replaceChildren(frame);
    }

    function loadWidgetPreview(stageEl, type, name, widget) {
        if (!stageEl) return;
        stageEl.innerHTML = '<div class="w-text" data-tone="muted"><?= __('加载预览…') ?></div>';

        var config = defaultsFromParamsSchema(widget.params || {});
        var area = (widget.area || 'frontend') || 'frontend';
        var paramsJson = '{}';
        try {
            paramsJson = JSON.stringify(config);
        } catch (e) {
            paramsJson = '{}';
        }

        var url = WIDGET_PREVIEW_URL
            + '?type=' + encodeURIComponent(type)
            + '&name=' + encodeURIComponent(name)
            + '&area=' + encodeURIComponent(area)
            + '&params=' + encodeURIComponent(paramsJson);

        backendJsonGet(url)
            .then(function (result) {
                if (result && result.success && result.preview_safe === true && typeof result.html === 'string') {
                    renderPreviewFrame(stageEl, result.html);
                    return;
                }
                stageEl.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;">'
                    + escapeHtml((result && result.message) ? result.message : '<?= __('预览失败') ?>')
                    + '</div>';
            })
            .catch(function () {
                stageEl.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;"><?= __('预览失败') ?></div>';
            });
    }

    function ensureModal() {
        var modalEl = document.getElementById('widgetDetailModal');
        if (modalEl) {
            // Migrate leftover Bootstrap shell from older builds (dialog.open no-ops on it).
            if (!modalEl.classList.contains('w-dialog')
                || modalEl.getAttribute('data-w-component') !== 'dialog'
            ) {
                modalEl.remove();
                modalEl = null;
            } else {
                return modalEl;
            }
        }

        modalEl = document.createElement('div');
        modalEl.className = 'w-dialog';
        modalEl.id = 'widgetDetailModal';
        modalEl.tabIndex = -1;
        modalEl.setAttribute('aria-hidden', 'true');
        modalEl.setAttribute('data-w-component', 'dialog');
        modalEl.setAttribute('data-state', 'closed');
        modalEl.setAttribute('data-testid', 'widget-admin-detail-dialog');
        modalEl.hidden = true;
        modalEl.innerHTML = '' +
            '<div class="w-dialog__frame" data-size="lg">' +
            '  <div class="w-dialog__surface">' +
            '    <div class="w-dialog__header">' +
            '      <h5 class="w-dialog__title" id="widgetDetailModalLabel"><?= __('部件预览') ?></h5>' +
            '      <button type="button" class="w-button" aria-label="<?= __('关闭') ?>" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm"></button>' +
            '    </div>' +
            '    <div class="w-dialog__body" id="widgetDetailModalBody">' +
            '      <div class="w-text" data-tone="muted"><?= __('加载中...') ?></div>' +
            '    </div>' +
            '    <div class="w-dialog__footer">' +
            '      <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><?= __('关闭') ?></button>' +
            '    </div>' +
            '  </div>' +
            '</div>';

        document.body.appendChild(modalEl);
        return modalEl;
    }

    function openWidgetDetailDialog(modalEl) {
        if (!modalEl || !window.Weline || !Weline.UI || !Weline.UI.dialog
            || typeof Weline.UI.dialog.open !== 'function'
        ) {
            return false;
        }
        return !!Weline.UI.dialog.open(modalEl);
    }

    /** Backend Controller JSON (not BinQuery). adminRequest('widget') hits Query and is denied. */
    function backendJsonGet(url) {
        return fetch(url, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).then(function (resp) {
            if (!resp.ok) {
                throw new Error('HTTP ' + resp.status);
            }
            return resp.json();
        });
    }

    window.viewWidgetDetail = function (type, name) {
        if (!type || !name) return;

        var modalEl = ensureModal();
        var bodyEl = modalEl.querySelector('#widgetDetailModalBody');
        var labelEl = modalEl.querySelector('#widgetDetailModalLabel');
        if (bodyEl) bodyEl.innerHTML = '<div class="w-text" data-tone="muted"><?= __('加载中...') ?></div>';
        if (labelEl) labelEl.textContent = '<?= __('部件预览') ?>';
        openWidgetDetailDialog(modalEl);

        var url = WIDGET_DETAIL_URL + '?type=' + encodeURIComponent(type) + '&name=' + encodeURIComponent(name);
        backendJsonGet(url)
            .then(function (data) {
                if (!data || !data.success) {
                    if (bodyEl) bodyEl.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;">' + escapeHtml((data && data.message) ? data.message : '<?= __('操作失败') ?>') + '</div>';
                    openWidgetDetailDialog(modalEl);
                    return;
                }

                var widget = data.widget || {};
                if (labelEl) labelEl.textContent = widget.name ? String(widget.name) : (name || '');

                var params = widget.params || {};
                var description = widget.description || '';
                var module = widget.module || '';
                var version = widget.version || '';
                var code = widget.code || name || '';
                var widgetType = widget.type || type || '';
                var path = widget.path || widget.template || '';

                var paramsText = '';
                try {
                    paramsText = JSON.stringify(params, null, 2);
                } catch (e) {
                    paramsText = String(params);
                }

                if (bodyEl) {
                    bodyEl.innerHTML =
                        '<div class="w-grid" style="--w-gap:var(--weline-space-4);">' +
                        '  <div style="--w-span:12;">' +
                        '    <div class="w-card" data-w-border="none" data-w-background="muted">' +
                        '      <div class="w-card__body">' +
                        '        <div class="w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-2);">' +
                        '          <span class="w-badge" data-w-background="info" data-tone="info"><?= __('类型') ?>: ' + escapeHtml(widgetType) + '</span>' +
                        '          <span class="w-badge" data-w-background="muted" data-tone="muted"><?= __('Code') ?>: ' + escapeHtml(code) + '</span>' +
                        '          <span class="w-badge" data-w-background="muted" data-tone="muted"><?= __('模块') ?>: ' + escapeHtml(module) + '</span>' +
                        '          <span class="w-badge" data-w-background="primary" data-tone="inverse"><?= __('版本') ?>: ' + escapeHtml(version || '') + '</span>' +
                        '        </div>' +
                        (path ? '        <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-2);"><?= __('路径') ?>: <code>' + escapeHtml(path) + '</code></div>' : '') +
                        '        <div class="w-text" data-tone="muted" style="--w-mb:0;">' + escapeHtml(description) + '</div>' +
                        '      </div>' +
                        '    </div>' +
                        '  </div>' +
                        '  <div style="--w-span:12;">' +
                        '    <p class="widget-admin-preview-title"><?= __('视觉预览') ?></p>' +
                        '    <div class="widget-admin-preview-stage" id="widgetAdminPreviewStage" data-testid="widget-admin-preview">' +
                        '      <div class="w-text" data-tone="muted"><?= __('加载预览…') ?></div>' +
                        '    </div>' +
                        '  </div>' +
                        '  <div style="--w-span:12;">' +
                        '    <details>' +
                        '      <summary class="w-text" data-tone="muted" style="cursor:pointer;"><?= __('参数配置') ?></summary>' +
                        '      <pre style="white-space: pre-wrap;margin-block-start:var(--weline-space-2);" data-w-background="muted" data-w-radius="md">' + escapeHtml(paramsText) + '</pre>' +
                        '    </details>' +
                        '  </div>' +
                        '</div>';
                }

                openWidgetDetailDialog(modalEl);

                var stageEl = modalEl.querySelector('#widgetAdminPreviewStage');
                loadWidgetPreview(stageEl, type, name, widget);
            })
            .catch(function () {
                // Detail failed (e.g. transient 503): still open preview stage; Preview API loads defaults.
                if (bodyEl) {
                    bodyEl.innerHTML =
                        '<div class="w-grid" style="--w-gap:var(--weline-space-4);">' +
                        '  <div style="--w-span:12;">' +
                        '    <div class="w-alert" data-tone="warning" style="--w-mb:0;"><?= __('元数据加载失败，仍尝试视觉预览') ?></div>' +
                        '  </div>' +
                        '  <div style="--w-span:12;">' +
                        '    <p class="widget-admin-preview-title"><?= __('视觉预览') ?></p>' +
                        '    <div class="widget-admin-preview-stage" id="widgetAdminPreviewStage" data-testid="widget-admin-preview">' +
                        '      <div class="w-text" data-tone="muted"><?= __('加载预览…') ?></div>' +
                        '    </div>' +
                        '  </div>' +
                        '</div>';
                }
                openWidgetDetailDialog(modalEl);
                loadWidgetPreview(modalEl.querySelector('#widgetAdminPreviewStage'), type, name, { params: {}, area: 'frontend' });
            });
    };

    if (!window.__widgetDetailActionsBound) {
        window.__widgetDetailActionsBound = true;
        document.addEventListener('click', function (event) {
            var trigger = event.target.closest('[data-widget-detail-trigger]');
            if (!trigger) return;

            event.preventDefault();
            window.viewWidgetDetail(
                trigger.getAttribute('data-widget-type') || '',
                trigger.getAttribute('data-widget-name') || ''
            );
        });
    }
})();
</js:part>

