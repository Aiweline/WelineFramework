<?php
/**
 * @widget.source {Weline_Widget::css/widgets/widget-header-default.css}
 * @widget.layout_source {Weline_Widget::css/widgets/widget-header-default.css} @var \Weline\Framework\View\Template $this */

use Weline\Theme\Helper\LegacyMediaUrl;

$title = $this->getData('title') ?? '网站标题';
$logo = LegacyMediaUrl::sanitize($this->getData('logo') ?? '');
$logoFileHtml = (string)($this->getData('logo_file_html') ?? '');
$showSearch = $this->getData('show_search') ?? true;
$navItems = $this->getData('nav_items') ?? [];
?>
<header class="widget-header widget-header-default">
    <div class="w-container">
        <div class="w-grid" data-align="center" data-widget-style-class="e07ee34edb085290">
            <div>
                <?php if ($logoFileHtml !== ''): ?>
                    <span class="logo logo--asset"><?= $logoFileHtml ?></span>
                <?php elseif ($logo !== ''): ?>
                    <img src="<?= htmlspecialchars($logo) ?>" alt="<?= htmlspecialchars($title) ?>" class="logo" data-widget-style-class="eb5de580cd4bcc92">
                <?php else: ?>
                    <h4 data-widget-style-class="afae7267af8c5154"><?= htmlspecialchars($title) ?></h4>
                <?php endif; ?>
            </div>
            <div>
                <?php if (!empty($navItems)): ?>
                <nav class="main-nav">
                    <ul class="w-nav">
                        <?php foreach ($navItems as $item): ?>
                        <li>
                            <a href="<?= htmlspecialchars($item['url'] ?? '#') ?>">
                                <?= htmlspecialchars($item['label'] ?? '') ?>
                            </a>
                        </li>
                        <?php endforeach; ?>
                    </ul>
                </nav>
                <?php endif; ?>
            </div>
            <?php if ($showSearch): ?>
            <div>
                <w:form class="search-form w-cluster">
                    <input type="search" class="w-input" placeholder="搜索...">
                    <button type="submit" class="w-button" data-tone="primary">
                        <w:icon name="search" size="sm"></w:icon>
                    </button>
                </w:form>
            </div>
            <?php endif; ?>
        </div>
    </div>
</header>
