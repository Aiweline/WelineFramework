$namespaceOptions = [];
$typeOptions = [];
foreach ($metas as $metaRow) {
    if (!empty($metaRow[MetaModel::fields_NAMESPACE] ?? null)) {
        $namespaceOptions[$metaRow[MetaModel::fields_NAMESPACE]] = true;
    }
    if (!empty($metaRow[MetaModel::fields_META_TYPE] ?? null)) {
        $typeOptions[$metaRow[MetaModel::fields_META_TYPE]] = true;
    }
}

if ($namespaceFilter && !isset($namespaceOptions[$namespaceFilter])) {
    $namespaceOptions[$namespaceFilter] = true;
}
if ($typeFilter && !isset($typeOptions[$typeFilter])) {
    $typeOptions[$typeFilter] = true;
}
