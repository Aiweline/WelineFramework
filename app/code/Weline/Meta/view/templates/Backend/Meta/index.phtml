                <pre class="meta-json-preview" id="meta-json-content" style="--w-pt:var(--weline-space-6);--w-pe:var(--weline-space-6);--w-pb:var(--weline-space-6);--w-ps:var(--weline-space-6);">{}</pre>
            </div>
            <div class="w-dialog__footer">
                <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><?= __('关闭') ?></button>
                <button type="button" class="w-button" id="copyMetaJson" data-tone="primary">
                    <w:icon name="file" size="sm"></w:icon><?= __('复制 JSON') ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    
    var modalEl = document.getElementById('metaDetailModal');
    var modalBody = document.getElementById('meta-json-content');
    var copyBtn = document.getElementById('copyMetaJson');
    var currentJson = '{}';
    var metaModal;

    document.querySelectorAll('[data-meta-refresh]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            window.location.reload();
        });
    });

    var ensureModal = function() {
        if (!metaModal) {
            metaModal = new bootstrap.Modal(modalEl);
        }
        return metaModal;
    };

    document.querySelectorAll('.js-meta-json').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var raw = btn.getAttribute('data-meta-json') || '{}';
            var title = btn.getAttribute('data-meta-title') || 'Meta';
            try {
                var parsed = JSON.parse(raw);
                currentJson = JSON.stringify(parsed, null, 2);
            } catch (e) {
                currentJson = raw;
            }
            document.getElementById('metaDetailModalLabel').textContent = title;
            modalBody.textContent = currentJson;
            ensureModal().show();
        });
    });

    copyBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(currentJson).then(function() {
            copyBtn.innerHTML = '<w:icon name="check" size="sm"></w:icon><?= __('已复制') ?>';
            setTimeout(function() {
                copyBtn.innerHTML = '<w:icon name="file" size="sm"></w:icon><?= __('复制 JSON') ?>';
            }, 1500);
        });
    });

    document.querySelectorAll('.js-copy-key').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var key = btn.getAttribute('data-clipboard-text');
            if (!key) {
                return;
            }
            navigator.clipboard.writeText(key).then(function() {
                btn.innerHTML = '<small class="w-text" data-tone="success"><w:icon name="check" size="sm"></w:icon><?= __('已复制') ?></small>';
                setTimeout(function() {
                    btn.innerHTML = '<small><w:icon name="file" size="sm"></w:icon><?= __('复制Key') ?></small>';
                }, 1500);
            });
        });
    });
})();
</script>
