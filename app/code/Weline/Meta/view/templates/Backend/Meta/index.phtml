<div class="w-dialog" id="metaDetailModal" tabindex="-1" aria-labelledby="metaDetailModalLabel" aria-hidden="true" data-w-component="dialog" data-state="closed" hidden>
    <div class="w-dialog__frame modal-dialog-scrollable" data-size="lg">
