use Weline\Meta\Model\Meta as MetaModel;

/** @var \Weline\Meta\Model\Meta|array|null $metaRecord */
$metaRecord = $this->getData('meta_record');
$metaValue = static function (string $key, mixed $default = null) use ($metaRecord): mixed {
    if ($metaRecord instanceof MetaModel) {
        $value = $metaRecord->getData($key);
        return $value ?? $default;
    }
    if (is_array($metaRecord)) {
        return $metaRecord[$key] ?? $default;
    }
    return $default;
};
$metaId = $metaValue(MetaModel::schema_fields_ID);
$metaDataRaw = (string)$metaValue(MetaModel::schema_fields_META_DATA, '');
$metaSettingRaw = (string)$metaValue(MetaModel::schema_fields_SETTING, '');
$metaDataArr = json_decode($metaDataRaw, true) ?: [];
$metaInfo = is_array($metaDataArr['info'] ?? null) ? $metaDataArr['info'] : [];
$translationKeyPreview = ($metaRecord instanceof MetaModel && $metaRecord->getId())
    ? $metaRecord->generateTranslationKey()
    : '@meta::{namespace}.{type}.{identify}.info.name';
$pageTitle = $metaId ? (__('编辑元数据') . ' #' . $metaId) : __('新增元数据');
$savePath = 'meta/backend/meta/save';
$backPath = 'meta/backend/meta';
$defaultMetaJson = json_encode([
    'namespace' => $metaValue(MetaModel::schema_fields_NAMESPACE),
    'type' => $metaValue(MetaModel::schema_fields_META_TYPE),
    'identify' => $metaValue(MetaModel::schema_fields_META_IDENTIFY),
    'info' => $metaInfo ?: [
        'name' => '',
        'description' => '',
    ],
], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
