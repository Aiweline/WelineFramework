    html2canvasUrl: <?= json_encode(
        $html2canvasHref === ''
            ? ''
            : ($html2canvasHref . (str_contains($html2canvasHref, '?') ? '&' : '?') . 'v=' . rawurlencode($html2canvasVersion)),
        JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ) ?>,
    modernScreenshotUrl: <?= json_encode(
        $modernScreenshotHref === ''
            ? ''
            : ($modernScreenshotHref . (str_contains($modernScreenshotHref, '?') ? '&' : '?') . 'v=' . rawurlencode($modernScreenshotVersion)),
        JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ) ?>,
    customerId: <?= $customerId ? (int)$customerId : 'null' ?>,
    isLoggedIn: <?= $isLoggedIn ? 'true' : 'false' ?>,
    showGuestBindPrompt: <?= $showGuestBindPrompt ? 'true' : 'false' ?>,
    defaultCustomerLocale: <?= json_encode($defaultCustomerLocale, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
