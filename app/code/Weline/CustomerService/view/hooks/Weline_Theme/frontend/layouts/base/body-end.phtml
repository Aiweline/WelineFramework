$requestPathRaw = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$requestPathParsed = parse_url($requestPathRaw, PHP_URL_PATH);
$requestPath = strtolower((string)(is_string($requestPathParsed) && $requestPathParsed !== '' ? $requestPathParsed : $requestPathRaw));
$isAccountRoute = $requestPath === '/customer/account'
    || $requestPath === 'customer/account'
    || str_contains($requestPath, '/customer/account/');
// Account routes skip the float on publish AND preview (same business rule).
// FORBIDDEN: preview-only / visual_editor / workspace-preview early-return
// (preview_storefront_delivery_parity — preview must run the same Hook path).
if ($isAccountRoute) {
    return;
}

/** @var CustomerServiceSettings $customerServiceSettings */
$customerServiceSettings = ObjectManager::getInstance(CustomerServiceSettings::class);
if (!$customerServiceSettings->isServiceEnabled()) {
    return;
}

$session = SessionFactory::getInstance()->createFrontendSession();
$isLoggedIn = $session->isLoggedIn();
$customerId = $isLoggedIn ? $session->getUserId() : null;

$showGuestBindPrompt = !$isLoggedIn;

/** @var BindCaptchaGuard $bindCaptchaGuard */
$bindCaptchaGuard = ObjectManager::getInstance(BindCaptchaGuard::class);
// 一次性人机验证禁止 SSR 进页面/FPC；弹窗打开时再拉 captcha-challenge。
$bindCaptchaEnabled = $bindCaptchaGuard->isEnabled();
$bindCaptchaHtml = '';

/** @var WidgetTranslationService $widgetTranslationService */
$widgetTranslationService = ObjectManager::getInstance(WidgetTranslationService::class);
$supportedLocales = $widgetTranslationService->getSupportedLocales();
$defaultCustomerLocale = $customerServiceSettings->defaultCustomerLocale();
$requestUriForLocale = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$storefrontLocale = WidgetI18n::localeFromRequestUri($requestUriForLocale)
    ?? WidgetI18n::localeFromRequestUri((string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? '')));
$currentLocale = $storefrontLocale
    ?: (State::getLangLocal() ?: $defaultCustomerLocale);
// Static 404/maintenance snapshots are already SSR'd per locale — do not embed
// multi-locale client dictionaries (would bloat pub/errors and is unused).
$omitClientDictionaries = \Weline\Framework\Runtime\RequestContext::get(
    \Weline\Framework\Http\StaticErrorPagePublisher::CTX_PUBLISHING,
    false
) === true;
if ($omitClientDictionaries) {
    // Prefer {} over [] so clients treat it as a locale map, not a list.
    $widgetTranslations = new \stdClass();
} else {
    $widgetLocaleCodes = array_column($supportedLocales, 'code');
    $widgetLocaleCodes[] = $currentLocale;
    $widgetLocaleCodes[] = $defaultCustomerLocale;
    $widgetLocaleCodes[] = 'zh_Hans_CN';
    if ($storefrontLocale !== null) {
        $widgetLocaleCodes[] = $storefrontLocale;
    }
    $widgetTranslations = $widgetTranslationService->getWidgetTranslationsForLocales(
        array_values(array_unique($widgetLocaleCodes))
    );
}
$cs = static fn (string $source): string => WidgetI18n::label($source);

