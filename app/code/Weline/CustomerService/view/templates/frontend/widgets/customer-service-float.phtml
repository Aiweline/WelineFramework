use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\WidgetI18n;

$requestPathRaw = (string)($this->request->getPathInfo() ?: \w_env_request_uri());
$requestPathParsed = parse_url($requestPathRaw, PHP_URL_PATH);
$requestPath = strtolower((string)(is_string($requestPathParsed) && $requestPathParsed !== '' ? $requestPathParsed : $requestPathRaw));
$isAccountRoute = $requestPath === '/customer/account'
    || $requestPath === 'customer/account'
    || str_contains($requestPath, '/customer/account/');
// Account routes skip the float on publish AND preview (same business rule).
// FORBIDDEN: preview-only / visual_editor / workspace-preview early-return
// (preview_storefront_delivery_parity — preview must run the same widget path).
if ($isAccountRoute) {
    return;
}

/** @var CustomerServiceSettings $customerServiceSettings */
$customerServiceSettings = ObjectManager::getInstance(CustomerServiceSettings::class);
if (!$customerServiceSettings->isServiceEnabled()) {
    return;
}

// Guest-safe SSR: login state is applied client-side on chat open / Account hydrate.
$isLoggedIn = false;
$customerId = null;
$showGuestBindPrompt = true;

/** @var BindCaptchaGuard $bindCaptchaGuard */
$bindCaptchaGuard = ObjectManager::getInstance(BindCaptchaGuard::class);
// 一次性人机验证禁止 SSR 进页面/FPC；弹窗打开时再拉 captcha-challenge。
$bindCaptchaEnabled = $bindCaptchaGuard->isEnabled();
$bindCaptchaHtml = '';

/** @var WidgetTranslationService $widgetTranslationService */
$widgetTranslationService = ObjectManager::getInstance(WidgetTranslationService::class);
$supportedLocales = $widgetTranslationService->getSupportedLocales();
$defaultCustomerLocale = $customerServiceSettings->defaultCustomerLocale();
// Locale authority is RequestContext (via State / WidgetI18n::storefrontLocale). Do not re-parse URI.
$currentLocale = WidgetI18n::storefrontLocale() ?: (\Weline\Framework\Env\WelineEnv::getLangLocal() ?: $defaultCustomerLocale);
// P10: keep body-end config slim — dictionaries load on first chat open via Query.
// Prefer {} over [] so clients treat it as a locale map, not a list.
$widgetTranslations = new \stdClass();
// Batch-prefetch SSR chrome copy before per-string label() — collapses
// Dictionary::getEntry N+1 on non-default locales (cold-chaos: ~29q on ar_SA).
WidgetI18n::prefetchLabels([
    '客服服务',
    '检测中...',
    '修改邮箱身份',
    '设置',
    '收起',
    '我的语言',
    '显示模式',
    '仅显示译文',
    '原文+译文',
    '仅显示原文',
    '欢迎使用客服服务！',
    '请输入您的问题，我们的客服将尽快为您解答。',
    '验证邮箱',
    '聊天工具',
    '表情',
    '图片',
    '文件',
    '截图',
    '输入消息...',
    '接收客服回复与优惠通知',
    '留下邮箱后，客服可将本次咨询的回复、报价进展和可用优惠发送到您的邮箱。',
    '仅用于本次客服咨询相关通知，不是简报订阅。',
    '接收通知的邮箱',
    '请输入用于接收客服通知的邮箱',
    '稍后再说',
    '发送验证邮件',
]);
$cs = static fn (string $source): string => WidgetI18n::label($source);

$customerServiceModule = Env::getInstance()->getModuleList()['Weline_CustomerService'] ?? [];
$customerServiceStaticDir = rtrim((string)($customerServiceModule['base_path'] ?? ''), DIRECTORY_SEPARATOR)
    . DIRECTORY_SEPARATOR . 'view' . DIRECTORY_SEPARATOR . 'statics';
// CSS via @widget.source only — forbid bare <link> dual-emit.
$customerServiceJsVersion = (string) ((int) (@filemtime($customerServiceStaticDir . DIRECTORY_SEPARATOR . 'js' . DIRECTORY_SEPARATOR . 'customer-service.js') ?: time()));
$html2canvasPath = $customerServiceStaticDir . DIRECTORY_SEPARATOR . 'js' . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'html2canvas.min.js';
$html2canvasVersion = (string) ((int) (@filemtime($html2canvasPath) ?: time()));
$modernScreenshotPath = $customerServiceStaticDir . DIRECTORY_SEPARATOR . 'js' . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'modern-screenshot.js';
$modernScreenshotVersion = (string) ((int) (@filemtime($modernScreenshotPath) ?: time()));
$html2canvasHref = (string)$this->fetchTagSource('statics', 'Weline_CustomerService::js/vendor/html2canvas.min.js');
$modernScreenshotHref = (string)$this->fetchTagSource('statics', 'Weline_CustomerService::js/vendor/modern-screenshot.js');
// Fallback <script src> must use the same public URL semantics as @static (prod → /static/...).
$customerServiceJsHref = (string)$this->fetchTagSource('statics', 'Weline_CustomerService::js/customer-service.js');
$customerServiceJsHref = preg_replace('/[?&]v=[^&]*/', '', $customerServiceJsHref) ?: $customerServiceJsHref;
$customerServiceJsHref = rtrim($customerServiceJsHref, '?&');
?>
