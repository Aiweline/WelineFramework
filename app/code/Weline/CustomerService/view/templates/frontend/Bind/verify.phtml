            --cs-verify-bg: var(--weline-theme-surface-muted);
            --cs-verify-card: var(--weline-theme-surface);
            --cs-verify-text: var(--weline-theme-text);
            --cs-verify-muted: var(--weline-theme-text-muted);
            --cs-verify-primary: var(--weline-theme-primary);
            --cs-verify-ok: var(--weline-theme-success);
            --cs-verify-bad: var(--weline-theme-danger);
            --cs-verify-border: var(--weline-theme-border);
            --cs-verify-radius: var(--weline-radius-lg);
            --cs-verify-space: var(--weline-space-4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: "Source Han Sans SC", "Noto Sans SC", "PingFang SC", sans-serif;
            background:
                radial-gradient(circle at top left, color-mix(in srgb, var(--cs-verify-primary) 12%, transparent), transparent 42%),
                var(--cs-verify-bg);
            min-height: 100vh;
