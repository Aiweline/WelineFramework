<body>
    <div class="verify-container">
        <?php if ($success): ?>
            <div class="verify-icon success" aria-hidden="true">✓</div>
            <h1 class="verify-title"><lang>邮箱已绑定</lang></h1>
            <p class="verify-message" id="cs-verify-status">
                <lang>正在同步到客服聊天窗口…</lang>
            </p>
            <?php if ($email !== ''): ?>
                <div class="verify-email">
                    <lang>已绑定邮箱</lang>: <strong><?= htmlspecialchars($email, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></strong>
                </div>
            <?php endif; ?>
            <div class="verify-actions">
                <a href="<?= htmlspecialchars($homeUrl, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" class="btn btn-primary" data-cs-verify-home>
                    <lang>回到商城继续聊天</lang>
                </a>
                <button type="button" class="btn btn-secondary" id="cs-verify-close" hidden>
                    <lang>关闭此页</lang>
                </button>
            </div>
            <p class="help-text" id="cs-verify-help">
                <lang>原页面客服窗口将自动显示已绑定邮箱；若未自动关闭，请关闭本页返回继续聊天。</lang>
            </p>
        <?php else: ?>
            <div class="verify-icon error" aria-hidden="true">✗</div>
            <h1 class="verify-title"><lang>验证失败</lang></h1>
            <p class="verify-message"><?= htmlspecialchars($message, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></p>
            <div class="verify-actions">
                <a href="<?= htmlspecialchars($homeUrl, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" class="btn btn-primary"><lang>返回首页</lang></a>
                <button class="btn btn-secondary" type="button" data-cs-bind-back><lang>返回上一页</lang></button>
            </div>
            <p class="help-text">
                <lang>如有问题，请</lang> <a href="<?= htmlspecialchars($homeUrl, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" data-cs-bind-open-chat><lang>联系客服</lang></a>
            </p>
        <?php endif; ?>
    </div>

    <script>
    (function () {
        var SUCCESS = <?= $success ? 'true' : 'false' ?>;
        var PAYLOAD = <?= json_encode($boundPayload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
        var STORAGE_KEY = 'cs_email_bound_v1';
        var CHANNEL = 'weline-cs-email-bound';
        var HOME = <?= json_encode($homeUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;

        function publishBound() {
            if (!SUCCESS || !PAYLOAD || !PAYLOAD.email) {
                return;
            }
            PAYLOAD.ts = Date.now();
            try {
                if (typeof BroadcastChannel !== 'undefined') {
                    var channel = new BroadcastChannel(CHANNEL);
                    channel.postMessage(PAYLOAD);
                    channel.close();
                }
            } catch (_e) {}
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(PAYLOAD));
                // Retrigger storage listeners in other tabs even if value identical.
                localStorage.removeItem(STORAGE_KEY);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(PAYLOAD));
            } catch (_e2) {}
        }

        function tryClose() {
            var status = document.getElementById('cs-verify-status');
            var closeBtn = document.getElementById('cs-verify-close');
            try {
                window.close();
            } catch (_e) {}
            setTimeout(function () {
                if (!window.closed) {
                    if (status) {
                        status.textContent = <?= json_encode((string)__('已同步。可关闭此页，返回原页面继续聊天。'), JSON_UNESCAPED_UNICODE) ?>;
                    }
                    if (closeBtn) {
                        closeBtn.hidden = false;
                        closeBtn.addEventListener('click', function () {
                            try { window.close(); } catch (_e3) {}
                            window.location.href = HOME;
                        });
                    }
                }
            }, 450);
        }

        if (SUCCESS) {
            publishBound();
            tryClose();
        }

        document.addEventListener('click', function (event) {
            var backTrigger = event.target.closest('[data-cs-bind-back]');
            if (backTrigger) {
                event.preventDefault();
                history.back();
                return;
            }
            var chatTrigger = event.target.closest('[data-cs-bind-open-chat]');
            if (chatTrigger) {
                event.preventDefault();
                window.location.href = HOME;
            }
        });
    })();
    </script>
</body>
</html>
