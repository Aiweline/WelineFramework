<?php
/**
 * 邮箱绑定验证结果页面
 */
$success = (bool)($this->getData('success') ?? false);
$message = (string)($this->getData('message') ?? '');
$email = (string)($this->getData('email') ?? '');
$sessionToken = (string)($this->getData('session_token') ?? '');
$homeUrl = (string)($this->getData('home_url') ?? '/');
if ($homeUrl === '') {
    $homeUrl = '/';
}
$boundPayload = [
    'type' => 'email_bound',
    'email' => $email,
    'session_token' => $sessionToken,
    'ts' => time() * 1000,
];
?>
<!DOCTYPE html>
<html lang="<?= $this->getLocale() ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><lang>邮箱绑定验证</lang></title>
    <style>
