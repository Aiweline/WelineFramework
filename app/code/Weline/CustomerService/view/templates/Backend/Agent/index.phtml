<script>
function csAdmin(url, options){
  options=options||{};
  var body=options.body;
  var headers=Object.assign({}, options.headers||{});
  if(body && typeof FormData!=='undefined' && body instanceof FormData){
    var p=new URLSearchParams(); body.forEach(function(v,k){p.append(k,String(v));}); body=p.toString();
  } else if(body && typeof URLSearchParams!=='undefined' && body instanceof URLSearchParams){
    body=body.toString();
  } else if(body && typeof body!=='string'){ try{body=JSON.stringify(body);}catch(e){body='';} }
  if(typeof body==='string' && body.indexOf('=')!==-1 && !headers['Content-Type'] && !headers['content-type']){
    headers['Content-Type']='application/x-www-form-urlencoded;charset=UTF-8';
  }
  var run=function(api){ return api.resource('customerService').adminRequest({url:url, method:options.method||'GET', headers:headers, body:body||''}); };
  var toResp=function(data){
    var biz=window.WelineApiBusiness||(window.Weline&&window.Weline.ApiBusiness);
    if(biz&&typeof biz.wrapAdminBridgeResult==='function'){
      return biz.wrapAdminBridgeResult(data);
    }
    var payload=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
    var ok=!(payload&&payload.success===false);
    return {
      ok:ok,
      status:ok?200:400,
      json:function(){return Promise.resolve(payload);},
      text:function(){return Promise.resolve(typeof payload==='string'?payload:JSON.stringify(payload==null?{}:payload));}
    };
  };
  var p=(window.Weline&&window.Weline.load)?window.Weline.load('api').then(run):Promise.resolve(run(window.Weline.Api));
  return p.then(toResp);
}
function csFormatError(error, fallback){
  var msg='';
  if(window.Weline&&Weline.ApiBusiness&&typeof Weline.ApiBusiness.formatApiError==='function'){
    msg=String(Weline.ApiBusiness.formatApiError(error, fallback||'')||'');
  } else if(error&&error.message){
    msg=String(error.message);
  }
  msg=String(msg||fallback||'').trim();
  if(/Frontend worker operation is not allowed/i.test(msg)){
    return '<?= __('后台接口未授权或会话失效，请刷新页面后重试') ?>';
  }
  if(/NoRouterException/i.test(msg) || /Response terminate with status 404/i.test(msg)){
    return '<?= __('后台保存路由不可用，请刷新页面后重试；若仍失败请联系管理员检查客服模块路由') ?>';
  }
  if(/Failed to fetch/i.test(msg) || /worker session/i.test(msg) || /Shared worker session/i.test(msg)){
    return '<?= __('网络或工作会话暂不可用，请刷新页面后重试') ?>';
  }
  return msg || fallback || '<?= __('请求失败') ?>';
}
</script>
<script>
const AgentManager = {
  saveUrl: "@backend-url{'customerservice/backend/agent/save'}",
  deleteUrl: "@backend-url{'customerservice/backend/agent/remove'}",
  transferUrl: "@backend-url{'customerservice/backend/agent/transfer-sessions'}",
  statisticsUrl: "@backend-url{'customerservice/backend/agent/agent-statistics'}",
  agents: <?= json_encode($agents, $jsonForScriptFlags) ?>
};
const CustomerServiceDefaultLocale = <?= json_encode($customerServiceDefaultLocale, $jsonForScriptFlags) ?>;

function getAgentLanguageSelector(id) {
  const root = document.getElementById(id + '_wrapper');
  return root && window.Weline && window.Weline.UI ? window.Weline.UI.get(root, 'language-select') : null;
}

function syncAgentLanguageSelection(locale, supportedLocales) {
  const primarySelector = getAgentLanguageSelector('customer_service_primary_locale_selector');
  const supportedSelector = getAgentLanguageSelector('customer_service_supported_locales_selector');
  const primaryLocale = String(locale || CustomerServiceDefaultLocale || '').trim();
  let nextSupportedLocales = Array.isArray(supportedLocales) ? supportedLocales.slice() : [];
  nextSupportedLocales = nextSupportedLocales
    .map(value => String(value || '').trim())
    .filter((value, index, list) => value && list.indexOf(value) === index);
  if (primaryLocale && nextSupportedLocales.indexOf(primaryLocale) === -1) {
    nextSupportedLocales.unshift(primaryLocale);
  }
  if (primarySelector) {
    primarySelector.setValue(primaryLocale);
  }
  if (supportedSelector) {
    supportedSelector.setReadonlyValues(primaryLocale ? [primaryLocale] : []);
    supportedSelector.setValues(nextSupportedLocales);
  }
}

document.addEventListener('weline:ui:language-select:change', event => {
  if (event.target && event.target.id === 'customer_service_primary_locale_selector_wrapper') {
    const primary = getAgentLanguageSelector('customer_service_primary_locale_selector');
    const supported = getAgentLanguageSelector('customer_service_supported_locales_selector');
    if (primary && supported) {
      syncAgentLanguageSelection(primary.getValue(), supported.getValues());
    }
  }
});

function fillAgentFieldsFromSelectedUser() {
  const select = document.getElementById('user_id');
  if (!select) {
    return;
  }
  const option = select.options[select.selectedIndex];
  if (!option || !String(option.value || '').trim()) {
    return;
  }
  const name = String(option.getAttribute('data-name') || '').trim();
  const email = String(option.getAttribute('data-email') || '').trim();
  const nameInput = document.getElementById('name');
  const emailInput = document.getElementById('email');
  if (nameInput && name) {
    nameInput.value = name;
  }
  if (emailInput && email) {
    emailInput.value = email;
  }
}

const agentUserSelect = document.getElementById('user_id');
if (agentUserSelect) {
  agentUserSelect.addEventListener('change', fillAgentFieldsFromSelectedUser);
}

function normalizeAgentId(value) {
  const parsed = parseInt(value, 10);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
}

function openAgentDialog(modal) {
  if (!modal) {
    return;
  }
  modal.style.removeProperty('display');
  if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.open === 'function') {
    Weline.UI.dialog.open(modal);
    return;
  }
  modal.hidden = false;
  modal.setAttribute('aria-hidden', 'false');
  modal.setAttribute('data-state', 'open');
}

function closeAgentDialog(modal) {
  if (!modal) {
    return;
  }
  if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.close === 'function') {
    Weline.UI.dialog.close(modal);
  }
  modal.hidden = true;
  modal.setAttribute('aria-hidden', 'true');
  modal.setAttribute('data-state', 'closed');
  modal.style.removeProperty('display');
}

function findAgentRecord(agentId) {
  agentId = normalizeAgentId(agentId);
  if (agentId <= 0) {
    return null;
  }
  const list = Array.isArray(AgentManager.agents) ? AgentManager.agents : [];
  let agent = list.find(a => normalizeAgentId(a && a.agent_id) === agentId) || null;
  if (agent && normalizeAgentId(agent.agent_id) === agentId && (agent.name || agent.email || agent.user_id)) {
    return agent;
  }
  const btn = document.querySelector('[data-agent-action="edit"][data-agent-id="' + agentId + '"]');
  const tr = btn ? btn.closest('tr[data-agent]') : null;
  if (tr) {
    try {
      const raw = JSON.parse(tr.getAttribute('data-agent') || '{}');
      if (raw && normalizeAgentId(raw.agent_id) === agentId) {
        return raw;
      }
    } catch (e) {}
  }
  return agent && normalizeAgentId(agent.agent_id) === agentId ? agent : null;
}

function showAgentModal(agentId = 0) {
  agentId = normalizeAgentId(agentId);
  const modal = document.getElementById('agent-modal');
  const form = document.getElementById('agent-form');
  const title = document.getElementById('modal-title');
  form.reset();
  document.getElementById('agent_id').value = 0;
  document.getElementById('is_active').checked = true;
  syncAgentLanguageSelection(CustomerServiceDefaultLocale, CustomerServiceDefaultLocale ? [CustomerServiceDefaultLocale] : []);
  if (agentId > 0) {
    title.textContent = '<?= __('编辑客服') ?>';
    const agent = findAgentRecord(agentId);
    if (agent) {
      document.getElementById('agent_id').value = agent.agent_id;
      document.getElementById('user_id').value = String(agent.user_id || '');
      document.getElementById('name').value = agent.name || '';
      document.getElementById('email').value = agent.email || '';
      document.getElementById('max_sessions').value = agent.max_sessions || 10;
      document.getElementById('is_active').checked = agent.is_active == 1 || agent.is_active === true;
      let supportedLocales = agent.supported_locales || [];
      if (typeof supportedLocales === 'string') {
        try { supportedLocales = JSON.parse(supportedLocales); } catch (e) { supportedLocales = [agent.locale]; }
      }
      if (!Array.isArray(supportedLocales) || supportedLocales.length === 0) {
        supportedLocales = agent.locale ? [agent.locale] : [];
      }
      syncAgentLanguageSelection(agent.locale, supportedLocales);
    } else {
      csToastError('<?= __('未找到客服数据，请刷新页面后重试') ?>');
    }
  } else {
    title.textContent = '<?= __('添加客服') ?>';
    syncAgentLanguageSelection(CustomerServiceDefaultLocale, CustomerServiceDefaultLocale ? [CustomerServiceDefaultLocale] : []);
  }
  openAgentDialog(modal);
}

function closeAgentModal() {
  closeAgentDialog(document.getElementById('agent-modal'));
}

function csToast(type, message, options) {
  var text = String(message || '').trim();
  if (!text) return;
  var tone = String(type || 'info');
  var opts = options && typeof options === 'object' ? options : {};
  if (typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast) {
    if (typeof Weline.UI.toast[tone] === 'function') {
      Weline.UI.toast[tone](text, opts);
      return;
    }
    if (typeof Weline.UI.toast.show === 'function') {
      Weline.UI.toast.show(text, Object.assign({ tone: tone === 'error' ? 'danger' : tone }, opts));
      return;
    }
  }
  let el = document.getElementById('cs-agent-toast-fallback');
  if (!el) {
    el = document.createElement('div');
    el.id = 'cs-agent-toast-fallback';
    el.setAttribute('role', 'status');
    el.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:100000;padding:0.75rem 1rem;border-radius:0.5rem;background:var(--weline-theme-surface,#fff);color:var(--weline-theme-text,#111);border:1px solid var(--weline-theme-border,#ddd);box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:24rem;';
    document.body.appendChild(el);
  }
  el.textContent = text;
  el.dataset.tone = tone;
  el.style.opacity = '1';
  if (el._timer) clearTimeout(el._timer);
  el._timer = setTimeout(function () { el.style.opacity = '0'; }, Number(opts.duration) > 0 ? Number(opts.duration) : 5000);
}

function csToastError(message, options) {
  csToast('error', message, options);
}

function csToastSuccess(message, options) {
  csToast('success', message, options);
}

function csToastInfo(message, options) {
  csToast('info', message, options);
}

/** 刷新前写入提示，避免 reload 冲掉 toast */
function csFlashThenReload(type, message) {
  var text = String(message || '').trim();
  var tone = String(type || 'info');
  try {
    if (text && window.sessionStorage) {
      sessionStorage.setItem('cs_agent_flash_toast', JSON.stringify({
        type: tone,
        message: text,
        at: Date.now()
      }));
    }
  } catch (e) {}
  location.reload();
}

function csConsumeFlashToast() {
  var raw = '';
  try {
    raw = window.sessionStorage ? String(sessionStorage.getItem('cs_agent_flash_toast') || '') : '';
    if (raw) sessionStorage.removeItem('cs_agent_flash_toast');
  } catch (e) {
    raw = '';
  }
  if (!raw) return;
  var payload = null;
  try { payload = JSON.parse(raw); } catch (e) { payload = null; }
  if (!payload || !payload.message) return;
  if (payload.at && (Date.now() - Number(payload.at)) > 60000) return;
  var attempts = 0;
  var tryShow = function () {
    attempts += 1;
    var ready = typeof Weline !== 'undefined' && Weline.UI && Weline.UI.toast;
    if (ready || attempts >= 50) {
      csToast(payload.type || 'info', payload.message, { duration: 6500 });
      return;
    }
    setTimeout(tryShow, 60);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(tryShow, 0); });
  } else {
    setTimeout(tryShow, 0);
  }
}
csConsumeFlashToast();

/** bfcache / 异常态：关闭态非 native dialog 若丢 hidden 会白屏盖主区 */
function csForceCloseAgentDialogs(reason) {
  ['agent-modal', 'agent-session-handoff-modal'].forEach(function (id) {
    const dialog = document.getElementById(id);
    if (!dialog) return;
    if (dialog.getAttribute('data-state') === 'open' && reason === 'user') return;
    // 勿依赖此时 Weline.UI 是否就绪；禁止写 inline display:none（会堵死后续 open）
    dialog.hidden = true;
    dialog.setAttribute('aria-hidden', 'true');
    dialog.setAttribute('data-state', 'closed');
    dialog.style.removeProperty('display');
    if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.close === 'function') {
      try { Weline.UI.dialog.close(dialog); } catch (e) {}
    }
  });
}
window.addEventListener('pageshow', function (event) {
  if (event.persisted) csForceCloseAgentDialogs('bfcache');
});
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function () { csForceCloseAgentDialogs('boot'); });
} else {
  csForceCloseAgentDialogs('boot');
}

function csShowConfirmDialog(message, options) {
  options = options || {};
  return Weline.UI.dialog.confirm(message, {
    title: options.title || '<?= __('提示') ?>',
    confirmLabel: options.confirmText || '<?= __('确认') ?>',
    cancelLabel: options.cancelText || '<?= __('取消') ?>',
    tone: options.type || 'warning',
    dangerous: options.type === 'danger'
  });
}

function editAgent(agentId) {
  agentId = normalizeAgentId(agentId);
  if (agentId > 0) {
    showAgentModal(agentId);
  }
}

function saveAgent() {
  const form = document.getElementById('agent-form');
  const formData = new FormData(form);
  formData.set('is_active', document.getElementById('is_active').checked ? '1' : '0');
  csAdmin(AgentManager.saveUrl, { method: 'POST', body: formData })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        closeAgentModal();
        location.reload();
      } else {
        csToastError(data.message || '<?= __('保存失败') ?>');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      csToastError(csFormatError(error, '<?= __('保存失败') ?>'));
    });
}

function openHandoffDialog() {
  const dialog = document.getElementById('agent-session-handoff-modal');
  if (!dialog) return;
  dialog.style.removeProperty('display');
  // 必须走 UI.dialog.open：先 hidden=false 会让 :not(dialog) 全屏白遮罩盖住主区
  if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.open === 'function') {
    Weline.UI.dialog.open(dialog);
    return;
  }
  dialog.hidden = false;
  dialog.setAttribute('aria-hidden', 'false');
  dialog.setAttribute('data-state', 'open');
}

function closeHandoffDialog() {
  const dialog = document.getElementById('agent-session-handoff-modal');
  if (!dialog) return;
  if (window.Weline && Weline.UI && Weline.UI.dialog && typeof Weline.UI.dialog.close === 'function') {
    Weline.UI.dialog.close(dialog);
  }
  dialog.hidden = true;
  dialog.setAttribute('aria-hidden', 'true');
  dialog.setAttribute('data-state', 'closed');
  dialog.style.removeProperty('display');
}

function populateHandoffTargets(fromAgentId) {
  const select = document.getElementById('handoff-to-agent-id');
  if (!select) return;
  const list = Array.isArray(AgentManager.agents) ? AgentManager.agents : [];
  const options = ['<option value=\"\">' + '<?= __('请选择客服') ?>' + '</option>'];
  list.forEach(function (row) {
    const id = normalizeAgentId(row && row.agent_id);
    if (id <= 0 || id === fromAgentId) return;
    if (!(row.is_active === 1 || row.is_active === true || row.is_active === '1')) return;
    const name = String(row.name || ('#' + id));
    const openCount = parseInt(row.open_session_count, 10) || 0;
    options.push('<option value=\"' + id + '\">' + name.replace(/</g, '&lt;') + ' (ID ' + id + (openCount ? ', <?= __('当前会话') ?> ' + openCount : '') + ')</option>');
  });
  select.innerHTML = options.join('');
}

function showSessionHandoffModal(agentId, mode) {
  agentId = normalizeAgentId(agentId);
  if (agentId <= 0) return;
  const agent = findAgentRecord(agentId);
  const openCount = agent ? (parseInt(agent.open_session_count, 10) || 0) : 0;
  const isDelete = mode === 'delete';
  document.getElementById('handoff-from-agent-id').value = String(agentId);
  document.getElementById('handoff-mode').value = isDelete ? 'delete' : 'transfer';
  document.getElementById('agent-handoff-title').textContent = isDelete ? '<?= __('删除客服') ?>' : '<?= __('转让会话') ?>';
  document.getElementById('handoff-confirm-btn').textContent = isDelete ? '<?= __('确认删除') ?>' : '<?= __('确认转让') ?>';
  const fromLabel = document.getElementById('handoff-from-agent-label');
  const agentName = String((agent && agent.name) || '').trim() || ('#' + agentId);
  const userName = String((agent && agent.user_name) || '').trim();
  if (fromLabel) {
    fromLabel.value = userName && userName !== '-' && userName.toLowerCase() !== agentName.toLowerCase()
      ? (agentName + ' · <?= __('用户') ?> ' + userName + ' (ID ' + agentId + ')')
      : (agentName + ' (ID ' + agentId + ')');
  }
  const releaseField = document.getElementById('handoff-release-field');
  const releaseCheck = document.getElementById('handoff-release-sessions');
  if (releaseField) releaseField.hidden = !isDelete;
  if (releaseCheck) releaseCheck.checked = false;
  const summary = document.getElementById('handoff-summary');
  if (summary) {
    if (isDelete) {
      summary.textContent = openCount > 0
        ? ('<?= __('即将删除客服「__AGENT__」，其名下有 __COUNT__ 个未关闭会话，请选择接收客服或释放回等待池。') ?>'.replaceAll('__AGENT__', agentName).replaceAll('__COUNT__', String(openCount)))
        : ('<?= __('确定删除客服「__AGENT__」？') ?>'.replaceAll('__AGENT__', agentName));
    } else {
      summary.textContent = openCount > 0
        ? ('<?= __('将从客服「__AGENT__」转出 __COUNT__ 个未关闭会话，请选择接收客服。') ?>'.replaceAll('__AGENT__', agentName).replaceAll('__COUNT__', String(openCount)))
        : ('<?= __('客服「__AGENT__」当前没有未关闭会话。') ?>'.replaceAll('__AGENT__', agentName));
    }
  }
  populateHandoffTargets(agentId);
  openHandoffDialog();
}

function deleteAgent(agentId) {
  agentId = normalizeAgentId(agentId);
  if (agentId <= 0) return;
  const agent = findAgentRecord(agentId);
  const openCount = agent ? (parseInt(agent.open_session_count, 10) || 0) : 0;
  if (openCount > 0) {
    showSessionHandoffModal(agentId, 'delete');
    return;
  }
  csShowConfirmDialog(
    '<?= __('确定要删除此客服吗？') ?>',
    { title: '<?= __('删除确认') ?>', confirmText: '<?= __('确认') ?>', cancelText: '<?= __('取消') ?>', type: 'danger' }
  ).then(function (confirmed) {
    if (!confirmed) return;
    submitDeleteAgent(agentId, 0, false);
  });
}

function transferAgentSessions(agentId) {
  agentId = normalizeAgentId(agentId);
  if (agentId <= 0) return;
  const agent = findAgentRecord(agentId);
  const openCount = agent ? (parseInt(agent.open_session_count, 10) || 0) : 0;
  if (openCount <= 0) {
    csToastInfo('<?= __('没有可转让的未关闭会话') ?>');
    return;
  }
  showSessionHandoffModal(agentId, 'transfer');
}

function submitDeleteAgent(agentId, transferToAgentId, releaseSessions) {
  const body = new URLSearchParams({ agent_id: String(agentId) });
  if (transferToAgentId > 0) body.set('transfer_to_agent_id', String(transferToAgentId));
  if (releaseSessions) body.set('release_sessions', '1');
  csAdmin(AgentManager.deleteUrl, { method: 'POST', body: body })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        closeHandoffDialog();
        location.reload();
      } else {
        csToastError(data.message || '<?= __('删除失败') ?>');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      csToastError(csFormatError(error, '<?= __('删除失败') ?>'));
    });
}

function applyAgentOpenSessionDelta(agentId, delta) {
  agentId = normalizeAgentId(agentId);
  delta = parseInt(delta, 10) || 0;
  if (agentId <= 0 || !delta) return;
  const list = Array.isArray(AgentManager.agents) ? AgentManager.agents : [];
  list.forEach(function (row) {
    if (normalizeAgentId(row && row.agent_id) !== agentId) return;
    const next = Math.max(0, (parseInt(row.open_session_count, 10) || 0) + delta);
    row.open_session_count = next;
  });
  const btn = document.querySelector('[data-agent-action="edit"][data-agent-id="' + agentId + '"]');
  const tr = btn ? btn.closest('tr[data-agent]') : null;
  if (!tr) return;
  try {
    const raw = JSON.parse(tr.getAttribute('data-agent') || '{}');
    if (raw && normalizeAgentId(raw.agent_id) === agentId) {
      raw.open_session_count = Math.max(0, (parseInt(raw.open_session_count, 10) || 0) + delta);
      tr.setAttribute('data-agent', JSON.stringify(raw));
    }
  } catch (e) {}
}

function setHandoffBusy(busy) {
  const btn = document.getElementById('handoff-confirm-btn');
  const select = document.getElementById('handoff-to-agent-id');
  if (btn) {
    btn.disabled = !!busy;
    if (busy) {
      btn.dataset.prevLabel = btn.textContent || '';
      btn.textContent = '<?= __('处理中…') ?>';
    } else if (btn.dataset.prevLabel) {
      btn.textContent = btn.dataset.prevLabel;
      delete btn.dataset.prevLabel;
    }
  }
  if (select) select.disabled = !!busy;
}

function submitTransferSessions(fromAgentId, toAgentId) {
  const body = new URLSearchParams({
    agent_id: String(fromAgentId),
    transfer_to_agent_id: String(toAgentId)
  });
  setHandoffBusy(true);
  csAdmin(AgentManager.transferUrl, { method: 'POST', body: body })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const transferred = data && data.data ? (parseInt(data.data.transferred, 10) || 0) : 0;
        if (transferred > 0) {
          applyAgentOpenSessionDelta(fromAgentId, -transferred);
          applyAgentOpenSessionDelta(toAgentId, transferred);
          csToastSuccess(data.message || '<?= __('转让成功') ?>', { duration: 6500 });
        } else {
          csToastInfo(data.message || '<?= __('没有可转让的未关闭会话') ?>', { duration: 6500 });
        }
        closeHandoffDialog();
      } else {
        csToastError(data.message || '<?= __('转让失败') ?>');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      csToastError(csFormatError(error, '<?= __('转让失败') ?>'));
    })
    .finally(function () {
      setHandoffBusy(false);
    });
}

function confirmHandoff() {
  const fromAgentId = normalizeAgentId(document.getElementById('handoff-from-agent-id')?.value);
  const mode = String(document.getElementById('handoff-mode')?.value || 'transfer');
  const toAgentId = normalizeAgentId(document.getElementById('handoff-to-agent-id')?.value);
  const releaseSessions = !!(document.getElementById('handoff-release-sessions')?.checked);
  if (fromAgentId <= 0) return;
  if (mode === 'delete') {
    if (!releaseSessions && toAgentId <= 0) {
      const agent = findAgentRecord(fromAgentId);
      const openCount = agent ? (parseInt(agent.open_session_count, 10) || 0) : 0;
      if (openCount > 0) {
        csToastError('<?= __('请选择目标客服，或勾选释放回等待池') ?>');
        return;
      }
    }
    submitDeleteAgent(fromAgentId, releaseSessions ? 0 : toAgentId, releaseSessions);
    return;
  }
  if (toAgentId <= 0) {
    csToastError('<?= __('请选择目标客服') ?>');
    return;
  }
  submitTransferSessions(fromAgentId, toAgentId);
}

function viewStatistics(agentId) {
  agentId = normalizeAgentId(agentId);
  if (agentId <= 0) {
    return;
  }
  const url = AgentManager.statisticsUrl + '?agent_id=' + encodeURIComponent(String(agentId)) + '&period=all';
  csAdmin(url)
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        showStatisticsModal(data.data);
      } else {
        csToastError(csFormatError({ message: data.message }, '<?= __('获取统计数据失败') ?>'));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      csToastError(csFormatError(error, '<?= __('获取统计数据失败') ?>'));
    });
}

function showStatisticsModal(statistics) {
  const modal = document.createElement('div');
  modal.className = 'cs-agent-stats-modal statistics-modal';
  modal.innerHTML = `
    <div class="w-dialog__surface">
      <div class="w-dialog__header">
        <h3><?= __('客服统计详情') ?></h3>
        <button type="button" class="close-btn" data-statistics-action="close" aria-label="<?= $escape(__('关闭')) ?>">&times;</button>
      </div>
      <div class="w-dialog__body">
        <div class="stat-detail-section">
          <h4><?= __('会话统计') ?></h4>
          <p><?= __('总会话数') ?>: ${statistics.sessions.total}</p>
          <p><?= __('已关闭') ?>: ${statistics.sessions.closed}</p>
          <p><?= __('进行中') ?>: ${statistics.sessions.active}</p>
        </div>
        <div class="stat-detail-section">
          <h4><?= __('消息统计') ?></h4>
          <p><?= __('总消息数') ?>: ${statistics.messages.total}</p>
        </div>
        <div class="stat-detail-section">
          <h4><?= __('响应时间') ?></h4>
          <p><?= __('平均') ?>: ${formatResponseTime(statistics.response_time.average)}</p>
          <p><?= __('最快') ?>: ${formatResponseTime(statistics.response_time.min)}</p>
          <p><?= __('最慢') ?>: ${formatResponseTime(statistics.response_time.max)}</p>
        </div>
        <div class="stat-detail-section">
          <h4><?= __('会话时长') ?></h4>
          <p><?= __('平均') ?>: ${statistics.session_duration.average} <?= __('分钟') ?></p>
          <p><?= __('最短') ?>: ${statistics.session_duration.min} <?= __('分钟') ?></p>
          <p><?= __('最长') ?>: ${statistics.session_duration.max} <?= __('分钟') ?></p>
        </div>
      </div>
    </div>`;
  document.body.appendChild(modal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.remove();
    }
  });
}

function formatResponseTime(seconds) {
  if (!seconds || seconds === 0) return '-';
  if (seconds < 60) {
    return seconds.toFixed(1) + '<?= __('秒') ?>';
  }
  return (seconds / 60).toFixed(1) + '<?= __('分钟') ?>';
}

document.addEventListener('click', function(event) {
  const statisticsAction = event.target.closest('[data-statistics-action]');
  if (statisticsAction && statisticsAction.getAttribute('data-statistics-action') === 'close') {
    event.preventDefault();
    const modal = statisticsAction.closest('.statistics-modal, .cs-agent-stats-modal');
    if (modal) {
      modal.remove();
    }
    return;
  }
  const trigger = event.target.closest('[data-agent-action]');
  if (!trigger) {
    return;
  }
  event.preventDefault();
  const action = String(trigger.getAttribute('data-agent-action') || '').trim();
  const agentId = normalizeAgentId(trigger.getAttribute('data-agent-id'));
  if (action === 'create') {
    showAgentModal();
  } else if (action === 'statistics') {
    viewStatistics(agentId);
  } else if (action === 'edit') {
    editAgent(agentId);
  } else if (action === 'transfer') {
    transferAgentSessions(agentId);
  } else if (action === 'delete') {
    deleteAgent(agentId);
  } else if (action === 'close-modal') {
    closeAgentModal();
  } else if (action === 'close-handoff') {
    closeHandoffDialog();
  } else if (action === 'confirm-handoff') {
    confirmHandoff();
  } else if (action === 'save') {
    saveAgent();
  }
});
</script>
