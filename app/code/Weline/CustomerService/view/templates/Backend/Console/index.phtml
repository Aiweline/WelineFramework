<?php
/**
 * 客服聊天工作台
 */
$agent = $this->getData('agent') ?? [];
$sessions = $this->getData('sessions') ?? [];
$waitingSessions = $this->getData('waitingSessions') ?? [];
$transferredSessions = $this->getData('transferredSessions') ?? [];
$statistics = $this->getData('statistics') ?? [];
$consolePath = 'customerservice/backend/console';
$mySessionCount = is_array($sessions) ? count($sessions) : 0;
$waitingSessionCount = is_array($waitingSessions) ? count($waitingSessions) : 0;
$transferredSessionCount = is_array($transferredSessions) ? count($transferredSessions) : 0;
// 互斥手风琴：首屏仅展开一组（优先我的 → 转让 → 等待）
$openSessionGroup = 'mine';
if ($mySessionCount <= 0 && $transferredSessionCount > 0) {
    $openSessionGroup = 'transferred';
} elseif ($mySessionCount <= 0 && $transferredSessionCount <= 0 && $waitingSessionCount > 0) {
    $openSessionGroup = 'waiting';
}
$mineGroupOpen = $openSessionGroup === 'mine';
$transferredGroupOpen = $openSessionGroup === 'transferred';
$waitingGroupOpen = $openSessionGroup === 'waiting';
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;
$jsonForHtmlAttr = static function ($value) use ($jsonForScriptFlags): string {
    return htmlspecialchars(json_encode($value, $jsonForScriptFlags), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
};
$agentName = htmlspecialchars((string)($agent['name'] ?? __('客服')), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$agentLocale = htmlspecialchars((string)($agent['locale'] ?? 'zh_Hans_CN'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$sessionListTitle = static function (array $session): string {
    $name = trim((string)($session['list_title'] ?? ''));
    if ($name !== '') {
        return $name;
    }
    $kind = (string)($session['customer_kind'] ?? '');
    $displayName = trim((string)($session['customer_display_name'] ?? ''));
    if ($kind === 'customer' && $displayName !== '') {
        return $displayName;
    }

    return '#' . (int)($session['session_id'] ?? $session['id'] ?? 0);
};
