<?php
/**
 * 页脚「帮助中心」扩展：联系客服（打开悬浮聊天按钮）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-contact-service-link}
 * @widget.name {页脚联系客服链接}
 * @widget.description {页脚帮助中心扩展槽：联系客服入口；点击打开悬浮客服聊天；默认注入 footer-help-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-help-links}
 * @widget.supports {["footer-contact-service-link","layout-footer-help-links"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer-help-links", "area":"footer", "sort_order":50, "required":true, "reason":"页脚帮助中心默认展示联系客服（打开悬浮聊天）", "config":{"label":"联系客服"} }]}
 *
 * @param label {default="联系客服",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-contact-service-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '联系客服';
$label = WidgetI18n::label($labelSource, '联系客服');
$jsNs = $scope->jsNs;
?>
<a class="footer-help-link footer-contact-service-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($jsNs) ?>"
   data-testid="footer-contact-service-link"
   data-cs-footer-open-chat
   href="#contact-service"
   role="button"><?= $esc($label) ?></a>
<script>
(function () {
    'use strict';
    var ns = <?= json_encode($jsNs, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    if (window[ns] && window[ns].bound) {
        return;
    }
    window[ns] = window[ns] || {};
    window[ns].bound = true;

    function openCustomerServiceChat(event) {
        var trigger = event.target && event.target.closest
            ? event.target.closest('[data-cs-footer-open-chat]')
            : null;
        if (!trigger) {
            return;
        }
        event.preventDefault();
        var widget = document.getElementById('customer-service-widget');
        if (widget && widget.classList.contains('is-open')) {
            return;
        }
        if (typeof window.__WelineLoadCustomerServiceWidget === 'function') {
            window.__WelineLoadCustomerServiceWidget(true);
            return;
        }
        if (typeof CustomerServiceWidget !== 'undefined'
            && typeof CustomerServiceWidget.toggleChat === 'function') {
            CustomerServiceWidget.toggleChat();
        }
    }

    document.addEventListener('click', openCustomerServiceChat);
})();
</script>
