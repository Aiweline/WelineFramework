<?php
/**
 * 页头右侧导航扩展：客户服务入口（打开悬浮客服聊天；默认注入 header-nav-extensions）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {header-contact-service-link}
 * @widget.name {页头客户服务链接}
 * @widget.description {页头右侧导航扩展槽：客户服务入口；点击打开悬浮客服聊天；默认注入 header-nav-extensions。}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {header-nav-extensions}
 * @widget.supports {["header-contact-service-link","header-nav-link","layout-header-nav-extensions"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"header-nav-extensions", "area":"header", "sort_order":20, "required":true, "reason":"页头右侧扩展槽默认展示客户服务（客服模块打开悬浮聊天）", "config":{"label":"客户服务"} }]}
 *
 * @param label {default="客户服务",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('header-contact-service-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '客户服务';
$label = WidgetI18n::label($labelSource, '客户服务');
$jsNs = $scope->jsNs;
?>
<a class="header-nav-extension-link header-contact-service-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($jsNs) ?>"
   data-testid="header-contact-service-link"
   data-cs-header-open-chat
   href="#customer-service"
   role="button"><?= $esc($label) ?></a>
<script>
(function () {
    'use strict';
    var ns = <?= json_encode($jsNs, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    if (window[ns] && window[ns].headerChatBound) {
        return;
    }
    window[ns] = window[ns] || {};
    window[ns].headerChatBound = true;

    function openCustomerServiceChat(event) {
        var trigger = event.target && event.target.closest
            ? event.target.closest('[data-cs-header-open-chat]')
            : null;
        if (!trigger) {
            return;
        }
        event.preventDefault();
        var widget = document.getElementById('customer-service-widget');
        if (widget && widget.classList.contains('is-open')) {
            return;
        }
        if (typeof window.__WelineLoadCustomerServiceWidget === 'function') {
            window.__WelineLoadCustomerServiceWidget(true);
            return;
        }
        if (typeof CustomerServiceWidget !== 'undefined'
            && typeof CustomerServiceWidget.toggleChat === 'function') {
            CustomerServiceWidget.toggleChat();
        }
    }

    document.addEventListener('click', openCustomerServiceChat);
})();
</script>
