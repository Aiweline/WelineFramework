$success = (bool)($this->getData('success') ?? false);
$message = (string)($this->getData('message') ?? '');
$email = (string)($this->getData('email') ?? '');
$sessionToken = (string)($this->getData('session_token') ?? '');
$homeUrl = (string)($this->getData('home_url') ?? '/');
if ($homeUrl === '') {
    $homeUrl = '/';
}
$boundPayload = [
    'type' => 'email_bound',
    'email' => $email,
    'session_token' => $sessionToken,
    'ts' => time() * 1000,
];
