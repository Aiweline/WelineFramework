                <?= __('如有问题，请') ?> <a href="<?= htmlspecialchars($homeUrl, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" data-cs-bind-open-chat><?= __('联系客服') ?></a>
            </p>
        <?php endif; ?>
    </div>

    <script>
    (function () {
        var SUCCESS = <?= $success ? 'true' : 'false' ?>;
        var PAYLOAD = <?= json_encode($boundPayload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
        var STORAGE_KEY = 'cs_email_bound_v1';
        var CHANNEL = 'weline-cs-email-bound';
        var HOME = <?= json_encode($homeUrl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;

        function publishBound() {
            if (!SUCCESS || !PAYLOAD || !PAYLOAD.email) {
                return;
            }
            PAYLOAD.ts = Date.now();
            try {
                if (typeof BroadcastChannel !== 'undefined') {
                    var channel = new BroadcastChannel(CHANNEL);
                    channel.postMessage(PAYLOAD);
                    channel.close();
                }
            } catch (_e) {}
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(PAYLOAD));
                // Retrigger storage listeners in other tabs even if value identical.
                localStorage.removeItem(STORAGE_KEY);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(PAYLOAD));
            } catch (_e2) {}
        }

        function tryClose() {
            var status = document.getElementById('cs-verify-status');
            var closeBtn = document.getElementById('cs-verify-close');
            try {
                window.close();
            } catch (_e) {}
            setTimeout(function () {
                if (!window.closed) {
                    if (status) {
                        status.textContent = <?= json_encode((string)__('已同步。可关闭此页，返回原页面继续聊天。'), JSON_UNESCAPED_UNICODE) ?>;
                    }
                    if (closeBtn) {
                        closeBtn.hidden = false;
                        closeBtn.addEventListener('click', function () {
                            try { window.close(); } catch (_e3) {}
                            window.location.href = HOME;
                        });
                    }
                }
            }, 450);
        }

        if (SUCCESS) {
            publishBound();
            tryClose();
        }

        document.addEventListener('click', function (event) {
            var backTrigger = event.target.closest('[data-cs-bind-back]');
            if (backTrigger) {
                event.preventDefault();
                history.back();
                return;
            }
            var chatTrigger = event.target.closest('[data-cs-bind-open-chat]');
            if (chatTrigger) {
                event.preventDefault();
                window.location.href = HOME;
            }
        });
    })();
    </script>
</body>
</html>
