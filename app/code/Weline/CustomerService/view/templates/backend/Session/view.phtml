                        <td><?= htmlspecialchars($session['customer_locale'] ?? '-') ?></td>
                    </tr>
                    <tr>
                        <th><?= __('客服语言') ?></th>
                        <td><?= htmlspecialchars($session['agent_locale'] ?? '-') ?></td>
                    </tr>
                    <tr>
                        <th><?= __('状态') ?></th>
                        <td>
                            <?php
                            $statusText = [
                                'waiting' => __('等待中'),
                                'active' => __('进行中'),
                                'closed' => __('已关闭')
                            ];
                            $statusBackground = [
                                'waiting' => 'warning',
                                'active' => 'success',
                                'closed' => 'muted'
                            ];
                            $status = $session['status'] ?? 'waiting';
                            ?>
                            <span class="w-badge" data-w-background="<?= $statusBackground[$status] ?? 'muted' ?>">
                                <?= $statusText[$status] ?? $status ?>
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th><?= __('创建时间') ?></th>
                        <td><?= $session['created_at'] ?? '-' ?></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="w-card">
        <div class="w-card__body">
            <h2 class="w-card__title"><?= __('聊天记录') ?></h2>
            <div class="cs-chat__messages">
                <?php if (empty($messages)): ?>
                    <p class="w-text" data-align="center" data-tone="muted"><?= __('暂无消息') ?></p>
                <?php else: ?>
                    <?php foreach ($messages as $message): ?>
                        <div class="cs-chat__message cs-chat__message--<?= htmlspecialchars((string)($message['sender_type'] ?? ''), ENT_QUOTES) ?>">
                            <div class="cs-chat__meta">
                                <strong><?= $message['sender_type'] === 'customer' ? __('客户') : __('客服') ?></strong>
                                <span><?= $message['created_at'] ?></span>
                            </div>
                            <div class="cs-chat__content">
                                <p><?= htmlspecialchars($message['content']) ?></p>
                                <?php if (!empty($message['translated_content']) && $message['translated_content'] !== $message['content']): ?>
                                    <p class="cs-chat__translated">
                                        <em><?= __('翻译：') ?><?= htmlspecialchars($message['translated_content']) ?></em>
                                    </p>
                                <?php endif; ?>
                            </div>
                        </div>
                    <?php endforeach; ?>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
