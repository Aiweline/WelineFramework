    </div>

    <div class="w-card">
        <div class="w-card__body">
            <h2 class="w-card__title"><?= __('会话信息') ?></h2>
            <div class="w-table-wrap">
                <table class="w-table">
                    <tr>
                        <th><?= __('会话ID') ?></th>
                        <td><?= $session['session_id'] ?? '-' ?></td>
                    </tr>
                    <tr>
                        <th><?= __('客户ID') ?></th>
