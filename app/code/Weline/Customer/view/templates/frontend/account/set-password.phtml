<?php
/**
 * Guest checkout convert — set password after silent session create.
 *
 * @var \Weline\Framework\View\Template $this
 */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$email = (string)($this->getData('email') ?? '');
?>
<section class="account-auth-card" data-testid="customer-set-password" weline-code="customer.account.set_password">
    <h1><lang>设置密码</lang></h1>
    <p><lang>已为您创建账户，请设置密码后继续管理订单。</lang></p>
    <?php if ($email !== ''): ?>
    <p class="account-auth-card__meta"><lang>账户邮箱</lang>：<strong><?= $escape($email) ?></strong></p>
    <?php endif; ?>
    <form method="post" action="@url{'customer/account/set-password'}" class="account-auth-form w-form">
        <div class="w-field">
            <label class="w-field__label" for="set-password-new"><lang>新密码</lang></label>
            <input class="w-input" type="password" id="set-password-new" name="password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="w-field">
            <label class="w-field__label" for="set-password-confirm"><lang>确认密码</lang></label>
            <input class="w-input" type="password" id="set-password-confirm" name="confirm_password" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit" class="w-button" data-tone="primary"><lang>保存密码</lang></button>
    </form>
</section>
