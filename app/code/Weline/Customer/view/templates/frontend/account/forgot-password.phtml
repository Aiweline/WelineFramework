<?php
$isResetMode = (bool)($this->getData('is_reset_mode') ?? false);
$resetToken = (string)($this->getData('reset_token') ?? '');
$forgotPasswordUrl = (string)($this->getData('forgot_password_url') ?? '/customer/account/forgot-password');
$resetPasswordUrl = (string)($this->getData('reset_password_url') ?? '/customer/account/forgot-password/reset-password');
$loginUrl = (string)($this->getData('login_url') ?? '/customer/account/login');
$safe = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="w-card w-auth-recovery" data-w-component="account-recovery"
         weline-code="customer.account.password_recovery"
         data-login-url="<?= $safe($loginUrl) ?>"
         data-password-length-message="<?= $safe(__('密码长度至少为8位')) ?>"
         data-password-match-message="<?= $safe(__('两次输入的密码不一致')) ?>"
         data-failure-message="<?= $safe(__('操作失败，请稍后重试')) ?>"
         data-request-failure-message="<?= $safe(__('请求失败，请稍后重试')) ?>"
         data-success-message="<?= $safe(__('操作成功！')) ?>">
    <header class="w-auth-recovery__header">
        <span class="w-auth-recovery__icon" aria-hidden="true"><w:icon name="key" size="xl"></w:icon></span>
        <h1 class="w-auth-recovery__title"><?= $safe($isResetMode ? __('重置密码') : __('忘记密码')) ?></h1>
        <p class="w-auth-recovery__subtitle">
            <?= $safe($isResetMode ? __('输入您的新密码以完成账户访问重置') : __('输入您的账户邮箱，我们将发送重置链接')) ?>
        </p>
    </header>

    <div class="w-auth-recovery__messages" aria-live="polite">
        <template>Weline_Component::message.phtml</template>
        <div class="w-alert" data-w-recovery-feedback role="alert" hidden></div>
    </div>

    <?php if ($isResetMode): ?>
        <w:form action="@var($resetPasswordUrl)" method="post" class="w-form w-auth-recovery__form" csrf="off" data-w-recovery-form>
            <?= $this->getFormKey($resetPasswordUrl) ?>
            <input type="hidden" name="token" value="<?= $safe($resetToken) ?>">

            <div class="w-field">
                <label class="w-field__label" for="password"><w:icon name="lock" size="sm"></w:icon><lang>新密码</lang></label>
                <div class="w-auth-recovery__password">
                    <input class="w-input" type="password" id="password" name="password" required minlength="8"
                           autocomplete="new-password" placeholder="<?= $safe(__('至少8位，包含字母和数字')) ?>">
                    <button type="button" class="w-button" data-w-password-toggle data-w-password-target="password"
                            data-label-show="<?= $safe(__('显示密码')) ?>" data-label-hide="<?= $safe(__('隐藏密码')) ?>"
                            data-tone="quiet" data-size="sm" aria-label="<?= $safe(__('显示密码')) ?>" aria-pressed="false">
                        <w:icon name="eye" size="sm" data-w-password-show></w:icon>
                        <w:icon name="eye-off" size="sm" data-w-password-hide hidden></w:icon>
                    </button>
                </div>
            </div>

            <div class="w-field">
                <label class="w-field__label" for="password_confirm"><w:icon name="check" size="sm"></w:icon><lang>确认密码</lang></label>
                <div class="w-auth-recovery__password">
                    <input class="w-input" type="password" id="password_confirm" name="password_confirm" required
                           autocomplete="new-password" placeholder="<?= $safe(__('请再次输入密码')) ?>">
                    <button type="button" class="w-button" data-w-password-toggle data-w-password-target="password_confirm"
                            data-label-show="<?= $safe(__('显示密码')) ?>" data-label-hide="<?= $safe(__('隐藏密码')) ?>"
                            data-tone="quiet" data-size="sm" aria-label="<?= $safe(__('显示密码')) ?>" aria-pressed="false">
                        <w:icon name="eye" size="sm" data-w-password-show></w:icon>
                        <w:icon name="eye-off" size="sm" data-w-password-hide hidden></w:icon>
                    </button>
                </div>
            </div>

            <button type="submit" class="w-button w-auth-recovery__submit" data-w-recovery-submit data-tone="primary">
                <span class="w-spinner" data-w-recovery-spinner hidden aria-hidden="true"></span>
                <w:icon name="key" size="sm"></w:icon><span><lang>重置密码</lang></span>
            </button>
        </w:form>
    <?php else: ?>
        <w:form action="@var($forgotPasswordUrl)" method="post" class="w-form w-auth-recovery__form" csrf="off" data-w-recovery-form>
            <?= $this->getFormKey($forgotPasswordUrl) ?>
            <input type="hidden" name="reset_url" value="<?= $safe($forgotPasswordUrl) ?>">

            <div class="w-alert" data-tone="info">
                <w:icon name="info" size="sm"></w:icon>
                <span><lang>请输入您注册时使用的邮箱地址，我们将向您发送密码重置链接。</lang></span>
            </div>
            <div class="w-field">
                <label class="w-field__label" for="email"><w:icon name="mail" size="sm"></w:icon><lang>电子邮箱</lang></label>
                <input class="w-input" type="email" id="email" name="email" required autocomplete="email"
                       placeholder="<?= $safe(__('请输入邮箱地址')) ?>">
            </div>
            <button type="submit" class="w-button w-auth-recovery__submit" data-w-recovery-submit data-tone="primary">
                <span class="w-spinner" data-w-recovery-spinner hidden aria-hidden="true"></span>
                <w:icon name="mail" size="sm"></w:icon><span><lang>发送重置链接</lang></span>
            </button>
        </w:form>
    <?php endif; ?>

    <footer class="w-auth-recovery__footer">
        <a href="<?= $safe($loginUrl) ?>" class="w-button" data-tone="quiet" data-size="sm">
            <w:icon name="login" size="sm"></w:icon><lang>返回登录</lang>
        </a>
    </footer>
</section>
