<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;

$challengeToken = trim((string)($this->getData('challenge_token') ?? ''));
if ($challengeToken === '') {
    try {
        $challengeToken = trim((string)(
            ObjectManager::getInstance(Request::class)->getParam('challenge_token') ?? ''
        ));
    } catch (\Throwable) {
        $challengeToken = '';
    }
}

$heading = trim((string)($this->getData('challenge_widget_title') ?? ''));
$subheading = trim((string)($this->getData('challenge_widget_subtitle') ?? ''));
$safe = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<section class="w-card w-auth-login w-auth-login--amazon w-auth-login--challenge"
         data-w-component="account-challenge"
         data-weline-load="api,account"
         data-challenge-token="<?= $safe($challengeToken) ?>"
         weline-code="customer.account.challenge"
         data-code-required-message="<?= $safe(__('请输入6位身份验证器验证码或8位备用恢复码。')) ?>"
         data-token-required-message="<?= $safe(__('登录验证令牌缺失，请返回登录后重试。')) ?>"
         data-verify-failure-message="<?= $safe(__('验证失败，请重新输入验证码')) ?>"
         data-request-failure-message="<?= $safe(__('验证请求失败，请稍后重试')) ?>">
    <header class="w-auth-login__header">
        <h1 class="w-auth-login__title">
            <?php if ($heading !== ''): ?>
                <?= $safe(__($heading)) ?>
            <?php else: ?>
                <lang>两步验证</lang>
            <?php endif; ?>
        </h1>
        <p class="w-auth-login__subtitle">
            <?php if ($subheading !== ''): ?>
                <?= $safe(__($subheading)) ?>
            <?php else: ?>
                <lang>请输入身份验证器应用生成的验证码或备用恢复码</lang>
            <?php endif; ?>
        </p>
    </header>

    <div class="w-auth-login__messages" aria-live="polite" data-w-challenge-messages>
        <template>Weline_Component::message.phtml</template>
        <div class="w-alert" data-w-challenge-feedback role="alert" hidden></div>
    </div>

    <w:form id="challengeForm" action="@url{'customer/account/challenge'}" method="post"
            class="w-form w-auth-login__form" csrf="off"
            data-w-challenge-form novalidate>
        <?= $this->getFormKey('customer/account/challenge') ?>
        <input type="hidden" name="challenge_token" value="<?= $safe($challengeToken) ?>" data-w-challenge-token>

        <div class="w-field">
            <p class="w-auth-login__hint">
                <w:icon name="device-mobile" size="md"></w:icon>
                <span><lang>打开身份验证器应用，获取最新的6位数字验证码；也可以输入8位备用恢复码。</lang></span>
            </p>
        </div>

        <div class="w-field">
            <label class="w-field__label" for="code">
                <w:icon name="key" size="md"></w:icon><lang>验证码</lang>
            </label>
            <input class="w-input w-auth-login__otp" type="text" id="code" name="code"
                   required autocomplete="one-time-code" inputmode="numeric"
                   placeholder="<?= $safe(__('123456 或 1234-5678')) ?>"
                   maxlength="9" aria-describedby="codeHelp"
                   data-w-challenge-code autofocus>
            <p class="w-field__help" id="codeHelp"><lang>备用恢复码每个只能使用一次。</lang></p>
        </div>

        <button type="submit" id="verifyBtn" class="w-button w-auth-login__submit"
                data-w-challenge-submit data-tone="primary">
            <span data-w-challenge-idle-label>
                <w:icon name="shield" size="md"></w:icon><span><lang>验证并继续</lang></span>
            </span>
            <span data-w-challenge-busy-label hidden>
                <span><lang>验证中...</lang></span>
            </span>
        </button>
    </w:form>

    <footer class="w-auth-login__footer">
        <a href="@url{'customer/account/login'}" class="w-button" data-tone="quiet" data-size="sm">
            <w:icon name="arrow-left" size="md"></w:icon><lang>返回登录</lang>
        </a>
    </footer>
</section>
