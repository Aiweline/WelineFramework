<?php
/** @var \Weline\Framework\View\Template $this */
$token = (string) ($this->getData('pending_token') ?? '');
$profile = (array) ($this->getData('pending_profile') ?? []);
$suggestedEmail = (string) ($this->getData('suggested_email') ?? '');
$bindHint = trim((string) ($this->getData('bind_hint') ?? ''));
$bindError = trim((string) ($this->getData('bind_error') ?? ''));
$safe = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$provider = ucfirst((string) ($profile['provider'] ?? ''));
$displayName = trim((string) ($profile['display_name'] ?? ''));
$emailHint = trim((string) ($profile['email'] ?? ''));
if (str_ends_with(strtolower($emailHint), '@social-login.local')) {
    $emailHint = '';
}
if ($suggestedEmail !== '' && str_ends_with(strtolower($suggestedEmail), '@social-login.local')) {
    $suggestedEmail = '';
}
?>
<style>
.social-choose { width: min(28rem, calc(100% - 2rem)); margin: 2rem auto; display: grid; gap: 1rem; }
.social-choose__card { border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; padding: 1.25rem; display: grid; gap: 0.75rem; }
.social-choose__title { margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a; }
.social-choose__desc { margin: 0; color: #64748b; font-size: 0.875rem; }
.social-choose__meta { margin: 0; color: #334155; font-size: 0.875rem; }
.social-choose__field { gap: 0; }
.social-choose__field.w-field { display: grid; }
.social-choose__field .w-input {
    min-height: 2.5rem;
}
.social-choose__actions { display: grid; gap: 0.75rem; }
.social-choose__btn {
    min-height: 2.5rem; border-radius: 999px; border: 1px solid #cbd5e1; background: #fff;
    font-weight: 700; cursor: pointer;
}
.social-choose__btn--primary { border-color: #0f172a; background: #0f172a; color: #fff; }
.social-choose__divider {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: center;
    color: #94a3b8; font-size: 0.75rem;
}
.social-choose__divider::before, .social-choose__divider::after {
    content: ""; height: 1px; background: #e2e8f0;
}
.social-choose__alert {
    margin: 0; padding: 0.75rem 0.9rem; border-radius: 8px; border: 1px solid #fecaca;
    background: #fef2f2; color: #991b1b; font-size: 0.875rem;
}
.social-choose__hint {
    margin: 0; padding: 0.75rem 0.9rem; border-radius: 8px; border: 1px solid #e2e8f0;
    background: #f8fafc; color: #475569; font-size: 0.8125rem;
}
</style>

<section class="social-choose" weline-code="customer.account.social_login_choose">
    <header class="social-choose__card">
        <h1 class="social-choose__title"><lang>完成社媒登录</lang></h1>
        <p class="social-choose__desc">
            <?= $safe((string) __('首次使用 %{1} 登录：可绑定已有账户，或新建账户并自动登录。', [$provider !== '' ? $provider : (string) __('社媒')])) ?>
        </p>
        <?php if ($displayName !== '' || $emailHint !== ''): ?>
            <p class="social-choose__meta">
                <?= $safe(trim($displayName . ($emailHint !== '' ? ' · ' . $emailHint : ''))) ?>
            </p>
        <?php endif; ?>
        <?php if ($bindError !== ''): ?>
            <p class="social-choose__alert" role="alert"><?= $safe($bindError) ?></p>
        <?php endif; ?>
    </header>

    <form class="social-choose__card" method="post" action="@url{'customer/account/social-login/bind-existing'}">
        <h2 class="social-choose__title" style="font-size:1rem"><lang>绑定已有账户</lang></h2>
        <p class="social-choose__desc"><lang>登录已有账户后，将自动关联本次社媒授权。</lang></p>
        <?php if ($bindHint !== ''): ?>
            <p class="social-choose__hint"><?= $safe($bindHint) ?></p>
        <?php endif; ?>
        <input type="hidden" name="token" value="<?= $safe($token) ?>">
        <div class="w-field social-choose__field">
            <label class="w-field__label" for="social-choose-username"><lang>本站用户名或邮箱</lang></label>
            <input class="w-input" id="social-choose-username" name="username" type="text" required autocomplete="username"
                   placeholder="<?= $safe((string) __('例如本站已注册邮箱')) ?>"
                   value="<?= $safe($suggestedEmail) ?>">
        </div>
        <div class="w-field social-choose__field">
            <label class="w-field__label" for="social-choose-password"><lang>本站密码</lang></label>
            <input class="w-input" id="social-choose-password" name="password" type="password" required autocomplete="current-password"
                   placeholder="<?= $safe((string) __('不是 Google 密码')) ?>">
        </div>
        <div class="social-choose__actions">
            <button type="submit" class="social-choose__btn social-choose__btn--primary"><lang>绑定并登录</lang></button>
        </div>
    </form>

    <div class="social-choose__divider"><span><lang>或</lang></span></div>

    <form class="social-choose__card" method="post" action="@url{'customer/account/social-login/create-new'}">
        <h2 class="social-choose__title" style="font-size:1rem"><lang>新建账户</lang></h2>
        <p class="social-choose__desc"><lang>使用本次社媒身份创建新账户并立即登录。</lang></p>
        <input type="hidden" name="token" value="<?= $safe($token) ?>">
        <div class="social-choose__actions">
            <button type="submit" class="social-choose__btn"><lang>新建并登录</lang></button>
        </div>
    </form>
</section>
