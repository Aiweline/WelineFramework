<?php
/**
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Customer\Service\CustomerAuthReturnUrlService;
use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Session\SessionFactory;

$this->setData('title', __('用户登录'));

$safe = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$redirectUrl = trim((string) ($this->getData('redirect_url') ?? ''));
if ($redirectUrl === '') {
    $redirectUrl = trim((string) (\w_env_get('redirect_url', '') ?: \w_env_get('redirect', '') ?: \w_env_get('return_url', '')));
}
try {
    $authReturn = ObjectManager::getInstance(CustomerAuthReturnUrlService::class);
    $request = ObjectManager::getInstance(Request::class);
    $explicit = $redirectUrl !== '' ? $redirectUrl : trim((string) (
        $request->getParam('redirect_url')
        ?? $request->getParam('redirect')
        ?? $request->getParam('return_url')
        ?? ''
    ));
    $referer = (string) ($request->getParam('referer') ?: $request->getReferer() ?: '');
    try {
        $session = ObjectManager::getInstance(SessionFactory::class)->createFrontendSession();
        $redirectUrl = $authReturn->capture($session, $explicit, $referer);
    } catch (\Throwable) {
        $redirectUrl = $authReturn->normalizeTarget($explicit);
        if ($redirectUrl === '') {
            $redirectUrl = $authReturn->normalizeTarget($referer);
        }
    }
} catch (\Throwable) {
    // keep $redirectUrl as-is
}
if ($redirectUrl === '' && isset($explicit) && is_string($explicit)) {
    // last resort already attempted above
}
$heading = trim((string)($this->getData('login_widget_title') ?? ''));
$subheading = trim((string)($this->getData('login_widget_subtitle') ?? ''));
// Do not pass params via w:widget attribute (short-echo PHP inside attrs breaks Taglib).
?>
