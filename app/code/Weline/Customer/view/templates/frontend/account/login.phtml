<?php
/** @var \Weline\Framework\View\Template $this */
$this->setData('title', __('用户登录'));
$redirectUrl = (string) ($this->getData('redirect_url') ?? (\w_env_get('redirect_url', '') ?: \w_env_get('redirect', '')));
$registerUrl = (string) ($this->getData('register_url') ?? '/customer/account/register');
$forgotPasswordUrl = (string) ($this->getData('forgot_password_url') ?? '/customer/account/forgot-password');
$loginSubmitUrl = (string) ($this->getData('login_submit_url') ?? '/customer/account/login');
$safe = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<section class="w-card w-auth-login" data-w-component="account-login"
         weline-code="customer.account.login"
         data-username-required-message="<?= $safe(__('请输入用户名或邮箱')) ?>"
         data-password-required-message="<?= $safe(__('请输入密码')) ?>"
         data-login-failure-message="<?= $safe(__('登录失败，请检查用户名和密码')) ?>"
         data-request-failure-message="<?= $safe(__('登录请求失败，请稍后重试')) ?>">
    <header class="w-auth-login__header">
        <span class="w-auth-login__icon" aria-hidden="true"><w:icon name="user" size="xl"></w:icon></span>
        <h1 class="w-auth-login__title"><lang>欢迎回来</lang></h1>
        <p class="w-auth-login__subtitle"><lang>请登录您的账户以继续</lang></p>
    </header>

    <div class="w-auth-login__messages" aria-live="polite">
        <template>Weline_Component::message.phtml</template>
        <div class="w-alert" data-w-login-feedback role="alert" hidden></div>
    </div>

    <w:form id="loginForm" action="@var($loginSubmitUrl)" method="post"
            class="w-form w-auth-login__form" csrf="off" captcha="required" intent="customer.login"
            data-w-login-form>
        <?= $this->getFormKey($loginSubmitUrl) ?>
        <input type="hidden" name="redirect_url" value="<?= $safe($redirectUrl) ?>">

        <div class="w-field">
            <label class="w-field__label" for="username">
                <w:icon name="user" size="sm"></w:icon><lang>用户名或邮箱</lang>
            </label>
            <input class="w-input" type="text" id="username" name="username"
                   placeholder="<?= $safe(__('请输入用户名或邮箱')) ?>"
                   required autocomplete="username" autofocus>
        </div>

        <div class="w-field">
            <label class="w-field__label" for="password">
                <w:icon name="lock" size="sm"></w:icon><lang>密码</lang>
            </label>
            <div class="w-auth-login__password">
                <input class="w-input" type="password" id="password" name="password"
                       placeholder="<?= $safe(__('请输入密码')) ?>"
                       required autocomplete="current-password">
                <button type="button" class="w-button" data-w-password-toggle data-w-password-target="password"
                        data-label-show="<?= $safe(__('显示密码')) ?>" data-label-hide="<?= $safe(__('隐藏密码')) ?>"
                        data-tone="quiet" data-size="sm" aria-label="<?= $safe(__('显示密码')) ?>" aria-pressed="false">
                    <w:icon name="eye" size="sm" data-w-password-show></w:icon>
                    <w:icon name="eye-off" size="sm" data-w-password-hide hidden></w:icon>
                </button>
            </div>
        </div>

        <div class="w-auth-login__remember">
            <label class="w-auth-login__remember-label" for="remember_duration">
                <w:icon name="clock" size="sm"></w:icon><lang>记住登录状态</lang>
            </label>
            <select class="w-select" id="remember_duration" name="remember_duration">
                <option value="0"><lang>本次会话（关闭浏览器后失效）</lang></option>
                <option value="21600"><lang>6小时</lang></option>
                <option value="86400"><lang>1天</lang></option>
                <option value="604800" selected><lang>1周</lang></option>
                <option value="2592000"><lang>1个月</lang></option>
            </select>
        </div>

        <div class="w-auth-login__forgot">
            <a href="<?= $safe($forgotPasswordUrl) ?>" class="w-button" data-tone="quiet" data-size="sm">
                <w:icon name="key" size="sm"></w:icon><lang>忘记密码？</lang>
            </a>
        </div>

        <div data-weline-form-captcha-slot></div>

        <button type="submit" id="loginBtn" class="w-button w-auth-login__submit" data-w-login-submit data-tone="primary">
            <span class="w-spinner" data-w-login-spinner hidden aria-hidden="true"></span>
            <span data-w-login-idle-label>
                <w:icon name="login" size="sm"></w:icon><span><lang>登录</lang></span>
            </span>
            <span data-w-login-busy-label hidden>
                <span class="w-spinner" aria-hidden="true"></span><span><lang>登录中...</lang></span>
            </span>
        </button>
    </w:form>

    <div class="w-auth-login__social">
        <p class="w-auth-login__social-title"><lang>或使用以下方式登录</lang></p>
        <w:hook name="Weline_Customer::frontend::account::login::providers"/>
    </div>

    <footer class="w-auth-login__footer">
        <span class="w-text" data-tone="muted"><lang>还没有账户？</lang></span>
        <a href="<?= $safe($registerUrl) ?>" class="w-button" data-tone="quiet" data-size="sm">
            <lang>立即注册</lang>
        </a>
    </footer>
</section>
