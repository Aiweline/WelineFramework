<script>
(function () {
    'use strict';
    // Immediate nav/loading only. Never hide already-loaded lazy sections:
    // data-weline-load may finish account-index.js before this bottom script runs.
    if (window.__welineAccountIndexInitialized) {
        return;
    }

    var raw = String(window.location.hash || '').replace(/^#/, '');
    var section = raw ? raw.split('?')[0] : '';
    if (!section || section === 'profile') {
        return;
    }
    try {
        document.documentElement.setAttribute('data-account-pending-section', section);
    } catch (e) {}

    function hideBuiltinSections() {
        ['profile', 'security', 'login-info'].forEach(function (name) {
            var el = document.querySelector('[data-account-section="' + name + '"]');
            if (!el) {
                return;
            }
            el.hidden = true;
            el.classList.add('d-none');
        });
    }

    function activateNav(target) {
        Array.prototype.forEach.call(document.querySelectorAll('[data-account-nav-link][data-section]'), function (nav) {
            var isActive = nav.getAttribute('data-section') === target;
            var parent = '';
            Array.prototype.some.call(document.querySelectorAll('[data-account-nav-link][data-section="' + target + '"]'), function (hit) {
                parent = hit.getAttribute('data-account-nav-parent') || '';
                return true;
            });
            var isParent = parent && nav.getAttribute('data-section') === parent;
            nav.classList.remove('is-active');
            nav.classList.remove('account-sidebar__nav-link--active');
            if (!isActive && !isParent) {
                return;
            }
            if (nav.classList.contains('account-sidebar__nav-link')) {
                nav.classList.add('account-sidebar__nav-link--active');
            } else {
                nav.classList.add('is-active');
            }
        });
    }

    function ensureLoading(target) {
        var mount = document.querySelector('[data-account-sidebar-content-mount]');
        if (!mount) {
            return;
        }
        var existing = document.querySelector('[data-account-section="' + target + '"]');
        if (existing) {
            // Real content already injected by a faster module load — reveal it.
            if (existing.getAttribute('data-account-section-loading') !== 'true') {
                existing.hidden = false;
                existing.classList.remove('d-none');
                try { document.documentElement.removeAttribute('data-account-pending-section'); } catch (e) {}
            }
            return;
        }
        var safe = String(target).replace(/[^a-zA-Z0-9_-]/g, '');
        if (!safe) {
            return;
        }
        var label = 'Loading...';
        try {
            var cfg = document.getElementById('weline-account-index-config');
            if (cfg) {
                var parsed = JSON.parse(cfg.textContent || '{}');
                if (parsed && parsed.i18n && parsed.i18n.sectionLoading) {
                    label = String(parsed.i18n.sectionLoading);
                }
            }
        } catch (e) {}
        mount.insertAdjacentHTML(
            'beforeend',
            '<section class="account-index__section account-index__section--loading" id="' + safe + '-section" data-account-section="' + safe + '" data-account-section-loading="true" aria-busy="true" weline-code="customer.account.index.section_loading">'
                + '<div class="account-card account-index__section-loading" role="status" aria-live="polite">'
                + '<span class="account-index__section-loading-spinner" aria-hidden="true"></span>'
                + '<p class="account-index__section-loading-text"></p>'
                + '</div></section>'
        );
        var textNode = mount.querySelector('[data-account-section="' + safe + '"] .account-index__section-loading-text');
        if (textNode) {
            textNode.textContent = label;
        }
    }

    hideBuiltinSections();
    activateNav(section);
    ensureLoading(section);
})();
</script>
<script>
(function () {
    // Fallback if data-weline-load has not started customerAccount yet.
    if (window.__welineAccountIndexInitialized) {
        return;
    }
    if (window.Weline && typeof window.Weline.load === 'function') {
        window.Weline.load('customerAccount').catch(function (err) { console.error(err); });
    }
})();
</script>


