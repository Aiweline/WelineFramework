    <footer class="w-auth-login__footer">
        <p class="w-auth-login__divider" role="presentation"><span><lang>已有账户？</lang></span></p>
        <?php if ($redirectUrl !== ''): ?>
            <a href="@url{'customer/account/login'|['redirect_url' => $redirectUrl]}" class="w-button w-auth-login__register" data-tone="neutral" data-size="md">
                <lang>立即登录</lang>
            </a>
        <?php else: ?>
            <a href="@url{'customer/account/login'}" class="w-button w-auth-login__register" data-tone="neutral" data-size="md">
