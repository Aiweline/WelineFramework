                <span>
                    <lang>我已阅读并同意</lang>
                    <a href="@url{'terms'}" class="w-auth-login__terms-link"><lang>服务条款</lang></a>
                    <lang>和</lang>
                    <a href="@url{'privacy'}" class="w-auth-login__terms-link"><lang>隐私政策</lang></a>
                </span>
