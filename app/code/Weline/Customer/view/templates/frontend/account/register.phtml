    </footer>
</section>
<span hidden data-widget-script="customer-account-register-0" data-v0="<?= htmlspecialchars((string)(json_encode((string)__('两次输入的密码不一致'), $jsonFlags)), ENT_QUOTES, 'UTF-8') ?>" data-v1="<?= htmlspecialchars((string)(json_encode((string)__('密码长度至少为8位'), $jsonFlags)), ENT_QUOTES, 'UTF-8') ?>" data-v2="<?= htmlspecialchars((string)(json_encode($failMsg, $jsonFlags)), ENT_QUOTES, 'UTF-8') ?>" data-v3="<?= htmlspecialchars((string)(json_encode($reqFailMsg, $jsonFlags)), ENT_QUOTES, 'UTF-8') ?>"></span>

