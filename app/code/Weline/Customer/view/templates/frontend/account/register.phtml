<?php
/**
 * @widget.source {Weline_Customer::css/widgets/widget-account-register.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Customer::js/widgets/widget-account-register-0.js} @var \Weline\Framework\View\Template $this */
$redirectUrl = (string) ($this->getData('redirect_url') ?? '');
$heading = trim((string)($this->getData('register_widget_title') ?? ''));
$subheading = trim((string)($this->getData('register_widget_subtitle') ?? ''));
$safe = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$referralCode = trim((string) ($this->getData('referral_code') ?? ($_GET['ref'] ?? '')));
$failMsg = (string)__('注册失败，请稍后重试');
$reqFailMsg = (string)__('注册请求失败，请稍后重试');
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
// Prefer fetching the gated Mail widget over calling Mail services from Customer.
// Empty output => enterprise mail unavailable => single-form register (no tabs).
$mailRegisterPanelHtml = '';
if (\Weline\Framework\Registry\Service\RegistryModulePresence::isActivePresent('Weline_Mail')) {
    try {
        $mailRegisterPanelHtml = (string)$this->setData('mail_register_variant', 'panel')
            ->fetch('Weline_Mail::templates/frontend/widgets/account-mail-register.phtml');
    } catch (\Throwable $mailRegisterFetchError) {
        $mailRegisterPanelHtml = '<!-- mail-register-fetch-error:'
            . htmlspecialchars($mailRegisterFetchError->getMessage(), ENT_QUOTES, 'UTF-8')
            . ' -->';
    }
}
$showRegisterTabs = trim(preg_replace('/<!--.*?-->/s', '', $mailRegisterPanelHtml) ?? '') !== '';
?>
<section class="w-card w-auth-login w-auth-login--amazon w-auth-login--register" data-w-component="account-register"
         data-weline-load="api,account"
         weline-code="customer.account.register">
    <header class="w-auth-login__header">
        <h1 class="w-auth-login__title">
            <?php if ($heading !== ''): ?>
                <?= $safe(__($heading)) ?>
            <?php else: ?>
                <lang>创建账户</lang>
            <?php endif; ?>
        </h1>
        <p class="w-auth-login__subtitle">
            <?php if ($subheading !== ''): ?>
                <?= $safe(__($subheading)) ?>
            <?php else: ?>
                <lang>使用邮箱注册您的账户</lang>
            <?php endif; ?>
        </p>
    </header>

    <div class="w-auth-login__messages auth-form__flash wf-system-messages" aria-live="polite">
        <template>Weline_Component::message.phtml</template>
        <div id="registerClientError" class="w-alert wflash wflash--danger auth-form__error" role="alert" hidden></div>
    </div>

    <?php if ($showRegisterTabs): ?>
    <div class="w-auth-login__register-modes" data-w-component="tabs">
        <nav class="w-tabs__list" data-variant="soft" role="tablist" aria-label="<?= $safe(__('注册方式')) ?>">
            <button class="w-tabs__tab" id="customer-register-tab" type="button" role="tab"
                    aria-controls="customer-register-panel" aria-selected="true">
                <w:icon name="user" size="sm"></w:icon><span><lang>账户注册</lang></span>
            </button>
            <button class="w-tabs__tab" id="mail-register-tab" type="button" role="tab"
                    aria-controls="mail-register-panel" aria-selected="false" tabindex="-1">
                <w:icon name="mail" size="sm"></w:icon><span><lang>企业邮箱（可选）</lang></span>
            </button>
        </nav>
        <div class="w-tabs__panel" id="customer-register-panel" role="tabpanel" aria-labelledby="customer-register-tab">
    <?php endif; ?>

    <w:form action="@url{'customer/account/register'}" method="post"
            class="w-form w-auth-login__form" data-customer-register-form csrf="off"
            captcha="off" intent="customer.register"
            data-account-home-url="@url{'customer/account'}">
        <?= $this->getFormKey('customer/account/register') ?>
        <input type="hidden" name="redirect_url" value="<?= $safe($redirectUrl) ?>">
        <?php if ($referralCode !== ''): ?>
            <input type="hidden" name="ref" value="<?= $safe($referralCode) ?>">
        <?php endif; ?>

        <div class="w-auth-login__row">
            <div class="w-field">
                <label class="w-field__label" for="firstname">
                    <w:icon name="user" size="md"></w:icon><lang>名</lang>
                </label>
                <input class="w-input" type="text" id="firstname" name="firstname"
                       required autocomplete="given-name"
                       placeholder="<?= $safe(__('请输入名')) ?>">
            </div>
            <div class="w-field">
                <label class="w-field__label" for="lastname">
                    <w:icon name="user" size="md"></w:icon><lang>姓</lang>
                </label>
                <input class="w-input" type="text" id="lastname" name="lastname"
                       required autocomplete="family-name"
                       placeholder="<?= $safe(__('请输入姓')) ?>">
            </div>
        </div>

        <div class="w-field">
            <label class="w-field__label" for="email">
                <w:icon name="mail" size="md"></w:icon><lang>电子邮箱</lang>
            </label>
            <input class="w-input" type="email" id="email" name="email"
                   required autocomplete="email"
                   placeholder="<?= $safe(__('请输入邮箱地址')) ?>">
        </div>

        <div class="w-field">
            <label class="w-field__label" for="password">
                <w:icon name="lock" size="md"></w:icon><lang>密码</lang>
            </label>
            <div class="w-auth-login__password">
                <input class="w-input" type="password" id="password" name="password"
                       required minlength="8" autocomplete="new-password"
                       placeholder="<?= $safe(__('至少8位，包含字母和数字')) ?>">
                <button type="button" class="w-button" data-w-password-toggle data-w-password-target="password"
                        data-label-show="<?= $safe(__('显示密码')) ?>" data-label-hide="<?= $safe(__('隐藏密码')) ?>"
