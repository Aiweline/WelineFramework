    <?php if ($showRegisterTabs): ?>
        </div>
        <div class="w-tabs__panel" id="mail-register-panel" role="tabpanel" aria-labelledby="mail-register-tab" hidden>
            <?= $mailRegisterPanelHtml ?>
        </div>
    </div>
    <?php endif; ?>

    <w:slot id="account-register-extras"
            name="account-register-extras"
            accept="account-register-extras,layout-account-register-extras,mail-register"
