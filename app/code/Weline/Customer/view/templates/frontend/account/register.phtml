        <div class="w-field">
            <label class="w-field__label" for="confirm_password">
                <w:icon name="lock" size="md"></w:icon><lang>确认密码</lang>
            </label>
            <div class="w-auth-login__password">
                <input class="w-input" type="password" id="confirm_password" name="confirm_password"
                       required autocomplete="new-password"
                       placeholder="<?= $safe(__('请再次输入密码')) ?>">
                <button type="button" class="w-button" data-w-password-toggle data-w-password-target="confirm_password"
                        data-label-show="<?= $safe(__('显示密码')) ?>" data-label-hide="<?= $safe(__('隐藏密码')) ?>"
                        data-tone="quiet" data-size="sm" aria-label="<?= $safe(__('显示密码')) ?>" aria-pressed="false">
                    <span data-w-password-show>
                        <w:icon name="eye" size="md"></w:icon>
                    </span>
                    <span data-w-password-hide hidden>
                        <w:icon name="eye-off" size="md"></w:icon>
                    </span>
                </button>
            </div>
        </div>

        <div class="w-auth-login__terms">
            <label class="w-auth-login__terms-label" for="agree_terms">
