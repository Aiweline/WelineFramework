<?php
/**
 * 页脚「支付与账户」扩展：社媒登录指南入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-social-login-link}
 * @widget.name {页脚社媒登录链接}
 * @widget.description {页脚支付与账户扩展槽：社媒登录指南入口；默认注入 footer-payment-account-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-payment-account-links}
 * @widget.supports {["footer-social-login-link","layout-footer-payment-account-links"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer-payment-account-links", "area":"footer", "sort_order":5, "required":true, "reason":"页脚支付与账户默认展示社媒登录指南", "config":{"label":"社媒登录"} }]}
 *
 * @param label {default="社媒登录",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-social-login-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '社媒登录';
$label = WidgetI18n::label($labelSource, '社媒登录');
?>
<a class="footer-payment-account-link footer-social-login-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-social-login-link"
   href="@url{'guide/social-login'}"><?= $esc($label) ?></a>
