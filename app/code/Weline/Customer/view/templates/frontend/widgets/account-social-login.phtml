<?php
/**
 * @widget.source {Weline_Customer::css/widgets/widget-account-social-login.css,Weline_Customer::js/account-social-quick.js}
 * 顾客社媒登录入口（应用部件）：默认注入登录表单社媒 slot。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {account-social-login}
 * @widget.name {社媒登录}
 * @widget.description {社媒登录 Logo（extends SocialLoginProvider）；须后台配置凭据并激活后才渲染，部件 enable_* 可再单独关闭}
 * @widget.type {form}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["account"]}
 * @widget.supports {["account-login-social-providers","layout-account-login-social-providers","social-login"]}
 *
 * @param enable_google {default=true,type="bool",label="启用 Google"}
 * @param enable_facebook {default=true,type="bool",label="启用 Facebook"}
 * @param enable_instagram {default=true,type="bool",label="启用 Instagram"}
 */

use Weline\Customer\Service\SocialLogin\SocialLoginPresentationService;
use Weline\Customer\Service\CustomerAuthReturnUrlService;
use Weline\Customer\Api\Auth\CustomerAccountFacadeInterface;
use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Session\SessionFactory;

$safe = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$returnUrl = trim((string) ($this->getData('redirect_url') ?? ''));
if ($returnUrl === '') {
    try {
        $request = ObjectManager::getInstance(Request::class);
        $returnUrl = trim((string) ($request->getParam('redirect_url')
            ?? $request->getParam('redirect')
            ?? $request->getParam('return_url')
            ?? ''));
    } catch (\Throwable) {
        $returnUrl = '';
    }
}
if ($returnUrl === '') {
    $returnUrl = trim((string) (\w_env_get('redirect_url', '') ?: \w_env_get('redirect', '')));
}
if ($returnUrl === '') {
    try {
        $authReturn = ObjectManager::getInstance(CustomerAuthReturnUrlService::class);
        $session = ObjectManager::getInstance(SessionFactory::class)->createFrontendSession();
        $returnUrl = $authReturn->resolve($session);
    } catch (\Throwable) {
        $returnUrl = '';
    }
}
$config = [
    'enable_google' => $this->getData('enable_google') ?? true,
    'enable_facebook' => $this->getData('enable_facebook') ?? true,
    'enable_instagram' => $this->getData('enable_instagram') ?? true,
];

/** @var SocialLoginPresentationService $presentation */
$presentation = ObjectManager::getInstance(SocialLoginPresentationService::class);
$buttons = $presentation->enabledButtons($config, $returnUrl);
$count = count($buttons);
$loggedIn = ObjectManager::getInstance(CustomerAccountFacadeInterface::class)->current() !== null;
$quick = $presentation->quickPromptBootstrap($config, $returnUrl, $loggedIn);
$quickJsonRaw = (string) json_encode(
    $quick,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
);
$hasQuick = !$loggedIn && (($quick['google'] ?? null) !== null || ($quick['facebook'] ?? null) !== null);
?>
<?php if ($count > 0): ?>
<?php endif; ?>
<div class="account-social-login<?= $count === 0 ? ' account-social-login--empty' : '' ?>"
     data-w-component="account-social-login"
     data-widget-code="account-social-login"
     data-testid="account-social-login"
     data-social-login-count="<?= $safe((string) $count) ?>"
     data-social-logged-in="<?= $loggedIn ? '1' : '0' ?>"
     <?php if ($hasQuick): ?>data-social-quick="1"<?php endif; ?>
     weline-code="customer.account.social_login"
     <?php if ($count === 0): ?>hidden<?php endif; ?>>
    <?php if ($hasQuick && $quickJsonRaw !== ''): ?>
    <script type="application/json" data-social-quick-config><?= $quickJsonRaw ?></script>
    <?php endif; ?>
    <?php if ($count > 0): ?>
    <div class="account-social-login__list account-social-login__list--logos" role="list">
        <?php foreach ($buttons as $button): ?>
            <?php
            $label = (string) __('使用 %{1} 登录', [$button['label']]);
            $code = (string) $button['code'];
            ?>
            <div class="account-social-login__item" role="listitem">
                <a class="account-social-login__btn account-social-login__btn--logo <?= $safe($button['brand_class']) ?>"
                   href="<?= $safe($button['href']) ?>"
                   data-social-provider="<?= $safe($code) ?>"
                   aria-label="<?= $safe($label) ?>"
                   title="<?= $safe($label) ?>">
                    <span class="account-social-login__logo"><?= (string) ($button['icon_svg'] ?? '') ?></span>
                </a>
            </div>
        <?php endforeach; ?>
    </div>
    <p class="account-social-login__help" data-widget-style-class="49436a73677e961a">
        <a href="@url{'guide/social-login'}" data-widget-style-class="6d13de47b4eb6050"><lang>社媒登录指南与政策</lang></a>
    </p>

    <?php endif; ?>
</div>
