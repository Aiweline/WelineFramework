<?php
/**
 * 页脚「帮助中心」扩展：我的账户入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-my-account-link}
 * @widget.name {页脚我的账户链接}
 * @widget.description {页脚帮助中心扩展槽：顾客账户入口；默认注入 footer-help-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-help-links}
 * @widget.supports {["footer-my-account-link","layout-footer-help-links"]}
 * @widget.default_injections {[{ "layout_type":"*", "slot":"footer-help-links", "area":"footer", "sort_order":0, "required":true, "reason":"页脚帮助中心默认展示我的账户", "config":{"label":"我的账户"} }]}
 *
 * @param label {default="我的账户",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-my-account-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '我的账户';
$label = WidgetI18n::label($labelSource, '我的账户');
?>
<a class="footer-help-link footer-my-account-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-my-account-link"
   href="@url{'customer/account/index'}"><?= $esc($label) ?></a>
