<?php
/** @var \Weline\Framework\View\Template $this */

$entries = (array) ($this->getData('social_login_guide_entries') ?? []);
$subtitle = (string) ($this->getData('social_login_guide_page_subtitle') ?? '');
$escape = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>

<?php echo $this->fetch('Weline_Customer::templates/frontend/guide/social-login/partials/shell-open.phtml'); ?>
<?php echo $this->fetch('Weline_Customer::templates/frontend/guide/social-login/partials/sidebar.phtml'); ?>

<section class="amazon-payment-guide-layout__main amazon-payment-guide-listing" data-testid="social-login-guide-hub" weline-code="customer.social_login.guide.hub">
    <header class="amazon-payment-guide-listing__header">
        <h1 class="amazon-payment-guide-listing__title"><lang>社媒登录指南</lang></h1>
        <?php if ($subtitle !== ''): ?>
            <p class="amazon-payment-guide-listing__subtitle"><?= $escape($subtitle) ?></p>
        <?php else: ?>
            <p class="amazon-payment-guide-listing__subtitle"><lang>查看各社媒登录提供方的使用指南与登录政策。</lang></p>
        <?php endif; ?>
        <p class="amazon-payment-guide-listing__meta">
            <lang args="[(string) count($entries)]">共 %{1} 个提供方</lang>
        </p>
    </header>

    <?php if ($entries === []): ?>
        <div class="amazon-payment-guide-card">
            <p class="amazon-payment-guide-card__summary"><lang>当前暂无已接入的社媒登录指南。</lang></p>
        </div>
    <?php else: ?>
        <div class="amazon-payment-guide-listing__grid" data-testid="social-login-guide-grid">
            <?php foreach ($entries as $entry): ?>
                <?php
                if (!is_array($entry)) {
                    continue;
                }
                $title = (string) ($entry['title'] ?? '');
                $summary = (string) ($entry['summary'] ?? '');
                $guideRoute = (string) ($entry['guide_route'] ?? '');
                $policyRoute = (string) ($entry['policy_route'] ?? '');
                ?>
                <article class="amazon-payment-guide-card" data-testid="social-login-guide-card">
                    <h2 class="amazon-payment-guide-card__title"><?= $escape($title) ?></h2>
                    <p class="amazon-payment-guide-card__summary"><?= $escape($summary) ?></p>
                    <div class="amazon-payment-guide-card__actions">
                        <a class="amazon-payment-guide-card__link" href="@url{$guideRoute}"><lang>查看登录指南</lang></a>
                        <a class="amazon-payment-guide-card__link amazon-payment-guide-card__link--muted" href="@url{$policyRoute}"><lang>查看登录政策</lang></a>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</section>
<?php echo $this->fetch('Weline_Customer::templates/frontend/guide/social-login/partials/shell-close.phtml'); ?>
