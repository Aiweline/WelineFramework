<js:part>
(function() {
    'use strict';

    var CUSTOMERS = <?= json_encode($customersPayload, $jsonForScriptFlags) ?>;
    var CUSTOMER_TEXT = <?= json_encode($customerText, $jsonForScriptFlags) ?>;
    var CUSTOMER_SAVE_URL = <?= json_encode($this->getBackendUrl('customer/backend/customer/save'), $jsonForScriptFlags) ?>;
    var CUSTOMER_DETAIL_URL = <?= json_encode($this->getBackendUrl('customer/backend/customer/detail'), $jsonForScriptFlags) ?>;
    var CUSTOMER_DELETE_URL = <?= json_encode($this->getBackendUrl('customer/backend/customer/delete'), $jsonForScriptFlags) ?>;
    var CUSTOMER_RESET_TOKEN_URL = <?= json_encode($this->getBackendUrl('customer/backend/customer/resetToken'), $jsonForScriptFlags) ?>;
    var CUSTOMER_RESET_PASSWORD_URL = <?= json_encode($this->getBackendUrl('customer/backend/customer/resetPassword'), $jsonForScriptFlags) ?>;

    var customerModalInstance = null;
    var passwordModalInstance = null;
    var MESSAGE_TYPE_MAP = {
        success: 'success',
        error: 'danger',
        warning: 'warning',
        info: 'info'
    };

    function notify(type, message) {
        var text = String(message || CUSTOMER_TEXT.operationFailed);
        if (window.Weline && Weline.UI && Weline.UI.toast) {
            Weline.UI.toast.show(text, { tone: MESSAGE_TYPE_MAP[type] || 'info' });
            return;
        }
        console.warn(text);
    }

    function confirmAction(message) {
        return Weline.UI.dialog.confirm(message);
        notify('error', CUSTOMER_TEXT.operationFailed);
        return Promise.resolve(false);
    }

    function normalizeCustomerId(value) {
        return String(value == null ? '' : value).trim();
    }

    function openCreateModal() {
        document.getElementById('customerForm').reset();
        document.getElementById('customer_id').value = '0';
        delete document.getElementById('customer_password_required').dataset.tone;
        document.getElementById('customer_is_sandbox').checked = false;
        document.getElementById('customerModalTitle').textContent = CUSTOMER_TEXT.addCustomer;
        customerModalInstance.show();
    }

    function openEditModal(userId) {
        userId = normalizeCustomerId(userId);
        if (!userId) {
            return;
        }
        Weline.adminRequest('customer_admin', CUSTOMER_DETAIL_URL + '?user_id=' + encodeURIComponent(userId))
            .then(function(response){ return response; })
            .then(function(data) {
                if (!data.success) {
                    notify('error', data.message || CUSTOMER_TEXT.operationFailed);
                    return;
                }
                var user = data.data.user;
                document.getElementById('customer_id').value = user.user_id;
                document.getElementById('customer_username').value = user.username;
                document.getElementById('customer_avatar').value = user.avatar || '';
                document.getElementById('customer_password').value = '';
                document.getElementById('customer_reset_attempts').checked = false;
                document.getElementById('customer_is_sandbox').checked = !!user.is_sandbox;
                document.getElementById('customer_password_required').dataset.tone = 'muted';
                document.getElementById('customerModalTitle').textContent = CUSTOMER_TEXT.editCustomer;
                customerModalInstance.show();
            })
            .catch(function() {
                notify('error', CUSTOMER_TEXT.operationFailed);
            });
    }

    function submitCustomerForm(event) {
        event.preventDefault();
        var form = event.target;
        var formData = new FormData(form);
        Weline.adminRequest('customer_admin', CUSTOMER_SAVE_URL, {
            method: 'POST',
            body: formData
        })
            .then(function(response){ return response; })
            .then(function(data) {
                if (data.success) {
                    notify('success', data.message || CUSTOMER_TEXT.operationSuccess);
                    customerModalInstance.hide();
                    setTimeout(function() { location.reload(); }, 800);
                } else {
                    notify('error', data.message || CUSTOMER_TEXT.operationFailed);
                }
            })
            .catch(function() {
                notify('error', CUSTOMER_TEXT.operationFailed);
            });
    }

    function openPasswordModal(userId) {
        userId = normalizeCustomerId(userId);
        if (!userId) {
            return;
        }
        document.getElementById('passwordForm').reset();
        document.getElementById('password_user_id').value = userId;
        document.getElementById('passwordResult').hidden = true;
        document.getElementById('passwordGenerated').textContent = '';
        passwordModalInstance.show();
    }

    function submitPasswordForm(event) {
        event.preventDefault();
        var formData = new FormData(event.target);
        Weline.adminRequest('customer_admin', CUSTOMER_RESET_PASSWORD_URL, {
            method: 'POST',
            body: formData
        })
            .then(function(response){ return response; })
            .then(function(data) {
                if (data.success) {
                    notify('success', data.message || CUSTOMER_TEXT.operationSuccess);
                    if (data.data && data.data.new_password) {
                        document.getElementById('passwordGenerated').textContent = data.data.new_password;
                        document.getElementById('passwordResult').hidden = false;
                    }
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    notify('error', data.message || CUSTOMER_TEXT.operationFailed);
                }
            })
            .catch(function() {
                notify('error', CUSTOMER_TEXT.operationFailed);
            });
    }

    function resetTokens(userId) {
        userId = normalizeCustomerId(userId);
        if (!userId) {
            return;
        }
        confirmAction(CUSTOMER_TEXT.resetTokensConfirm).then(function(confirmed) {
            if (!confirmed) {
                return;
            }
            var formData = new FormData();
            formData.append('user_id', userId);
            Weline.adminRequest('customer_admin', CUSTOMER_RESET_TOKEN_URL, {
                method: 'POST',
                body: formData
            })
                .then(function(response){ return response; })
                .then(function(data) {
                    if (data.success) {
                        notify('success', data.message || CUSTOMER_TEXT.operationSuccess);
                        setTimeout(function() { location.reload(); }, 800);
                    } else {
                        notify('error', data.message || CUSTOMER_TEXT.operationFailed);
                    }
                })
                .catch(function() {
                    notify('error', CUSTOMER_TEXT.operationFailed);
                });
        });
    }

    function deleteCustomer(userId) {
        userId = normalizeCustomerId(userId);
        if (!userId) {
            return;
        }
        confirmAction(CUSTOMER_TEXT.deleteCustomerConfirm).then(function(confirmed) {
            if (!confirmed) {
                return;
            }
            var formData = new FormData();
            formData.append('user_id', userId);
            Weline.adminRequest('customer_admin', CUSTOMER_DELETE_URL, {
                method: 'POST',
                body: formData
            })
                .then(function(response){ return response; })
                .then(function(data) {
                    if (data.success) {
                        notify('success', data.message || CUSTOMER_TEXT.operationSuccess);
                        setTimeout(function() { location.reload(); }, 800);
                    } else {
                        notify('error', data.message || CUSTOMER_TEXT.operationFailed);
                    }
                })
                .catch(function() {
                    notify('error', CUSTOMER_TEXT.operationFailed);
                });
        });
    }

    function init() {
        customerModalInstance = {
            show: function() { Weline.UI.dialog.open('#customerModal'); },
            hide: function() { Weline.UI.dialog.close('#customerModal'); }
        };
        passwordModalInstance = {
            show: function() { Weline.UI.dialog.open('#passwordModal'); },
            hide: function() { Weline.UI.dialog.close('#passwordModal'); }
        };

        var customerForm = document.getElementById('customerForm');
        if (customerForm) {
            customerForm.addEventListener('submit', submitCustomerForm);
        }

        var passwordForm = document.getElementById('passwordForm');
        if (passwordForm) {
            passwordForm.addEventListener('submit', submitPasswordForm);
        }

        document.addEventListener('click', function(event) {
            var trigger = event.target.closest('[data-customer-action]');
            if (!trigger) {
                return;
            }

            event.preventDefault();
            var action = String(trigger.getAttribute('data-customer-action') || '').trim();
            var userId = normalizeCustomerId(trigger.getAttribute('data-customer-id'));

            if (action === 'create') {
                openCreateModal();
            } else if (action === 'edit') {
                openEditModal(userId);
            } else if (action === 'password') {
                openPasswordModal(userId);
            } else if (action === 'reset-tokens') {
                resetTokens(userId);
            } else if (action === 'delete') {
                deleteCustomer(userId);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    window.WelineCustomerManager = {
        openCreateModal: openCreateModal,
        openEditModal: openEditModal,
        openPasswordModal: openPasswordModal,
        resetTokens: resetTokens,
        deleteCustomer: deleteCustomer
    };
})();
</js:part>
