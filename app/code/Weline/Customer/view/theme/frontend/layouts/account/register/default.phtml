            width: 100%;
            min-height: min(62vh, 36rem);
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
            align-items: start;
            column-gap: clamp(1rem, 3vw, 2.5rem);
            padding: clamp(1rem, 3vh, 2rem) clamp(1rem, 4vw, 3rem) clamp(1.5rem, 4vh, 2.5rem);
