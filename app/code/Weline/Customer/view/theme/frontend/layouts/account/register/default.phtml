<!--
布局：account/register/default - 与公开路由 customer/account/register 对齐
layoutType=account/register，option=default → layouts/account/register/default.phtml
完整认证壳（含 <w:slot>），禁止再 fetch(auth) 以免编辑器/注入丢 slot。

字段
@meta.name {default="账号注册布局",name="账号注册布局",description="顾客注册页布局（path=customer/account/register）"}
@meta.description {default="与路由对齐：account/register/default",name="描述",description="顾客注册页布局（path=customer/account/register）"}
@param.title {default="注册",name="页面标题",description="页面标题"}
@param.content {default="",name="主要内容",description="表单等内容"}
@param.class {default="",name="额外CSS类",description="根节点额外 class"}
@param.showHeader {default=true,name="是否显示header",description="默认渲染主题顶栏"}
@param.showFooter {default=true,name="是否显示footer",description="默认渲染主题底栏"}
@param.showSearch {default=true,name="顶栏搜索",description="顶栏是否展示搜索"}
@param.showUserMenu {default=true,name="用户菜单",description="顶栏是否展示用户菜单"}
-->
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}">
<head>
    <?php
    $meta = $this->getData('meta') ?? [];
    if (!is_array($meta)) {
        $meta = [];
    }
    $meta['layoutType'] = 'account/register';
    $meta['layoutOption'] = 'default';
    $meta['__force_register_stage'] = true;
    $this->setData('layoutType', 'account/register');
    $this->setData('layoutOption', 'default');
    if (!array_key_exists('showHeader', $meta)) {
        $meta['showHeader'] = true;
    }
    if (!array_key_exists('showFooter', $meta)) {
        // Legacy bare-auth: if header was explicitly off and footer unset, keep chrome off.
        $meta['showFooter'] = (($meta['showHeader'] ?? true) !== false);
    }
    $this->assign('meta', $meta);
    $showHeader = ($meta['showHeader'] ?? true) !== false;
    $showFooter = ($meta['showFooter'] ?? true) !== false;
    $pageTitle = trim((string)($this->getData('title') ?: ($meta['title'] ?? __('注册'))));
    $this->setData('__weline_frontend_final_title', $pageTitle);
    $pageDescription = trim((string)($this->getData('description') ?: ($meta['description'] ?? '')));
    $this->setData('seo', array_filter([
        'page_type' => 'account',
        'title' => $pageTitle !== '' ? $pageTitle : (string)__('注册'),
        'description' => $pageDescription,
        'robots' => 'noindex,follow',
    ], static fn ($value): bool => $value !== null && $value !== ''));
    $contentTemplate = (string)($this->getData('meta.contentTemplate') ?: $this->getData('contentTemplate') ?: $meta['contentTemplate'] ?? '');
    $normalizedContentTemplate = str_replace('\\', '/', $contentTemplate);
    $layoutTypePath = strtolower(trim(str_replace('\\', '/', (string)($meta['layoutType'] ?? $this->getData('layoutType') ?? ''))));
    $layoutOption = strtolower(trim((string)($meta['layoutOption'] ?? $this->getData('layoutOption') ?? '')));
    $isLoginAuthPage = $layoutTypePath === 'account/login'
        || $layoutOption === 'login'
        || !empty($meta['__force_login_stage'])
        || str_contains($normalizedContentTemplate, '/account/login.phtml')
        || str_contains($normalizedContentTemplate, '/account/login-shell.phtml')
        || str_contains($normalizedContentTemplate, '/customer/login.phtml');
    $isRegisterAuthPage = $layoutTypePath === 'account/register'
        || $layoutOption === 'register'
        || !empty($meta['__force_register_stage'])
        || str_contains($normalizedContentTemplate, '/account/register.phtml')
        || str_contains($normalizedContentTemplate, '/customer/register.phtml');
    $isAuthStagePage = $isLoginAuthPage || $isRegisterAuthPage;
    $isDev = defined('DEV') && DEV;
    $apiWorkerUrl = $isDev
        ? '/Weline/Frontend/view/statics/js/weline-api-worker.js'
        : '/static/Weline/Frontend/js/weline-api-worker.js';
    $frontendQueryBinUrl = \Weline\Framework\App\Env::getFrontendQueryBinPath();
    $jsonForScriptFlags = JSON_UNESCAPED_UNICODE
        | JSON_UNESCAPED_SLASHES
        | JSON_HEX_TAG
        | JSON_HEX_AMP
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_INVALID_UTF8_SUBSTITUTE;
    ?>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script data-no-extract="true" data-auth-runtime-config>
        (function() {
            window.WelineApiConfig = window.WelineApiConfig || {};
            window.WelineApiConfig.workerUrl = window.WelineApiConfig.workerUrl || <?= json_encode($apiWorkerUrl, $jsonForScriptFlags) ?>;
            window.WelineApiConfig.endpoint = window.WelineApiConfig.endpoint || window.WelineApiConfig.queryBinUrl || <?= json_encode($frontendQueryBinUrl, $jsonForScriptFlags) ?>;
            window.WelineApiConfig.queryBinUrl = window.WelineApiConfig.queryBinUrl || <?= json_encode($frontendQueryBinUrl, $jsonForScriptFlags) ?>;
            window.WelineApiConfig.baseUrl = window.WelineApiConfig.baseUrl || window.location.origin;
        })();
    </script>
    <?php // weline.js 必须在 runtime 配置 + runtime.js 之后（由 Partials head 注入），不可提前加载，否则 modulesBaseUrl 落默认 /static/Weline_Frontend/... 404 ?>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
