            background: var(--account-login-promo-bg, var(--color-bg-dark));
        }
        .account-login-widget__backdrop {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-color: var(--account-login-promo-bg, var(--color-bg-dark));
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }
        .account-login-widget--wash .account-login-widget__backdrop {
            background-image:
                linear-gradient(105deg, var(--account-login-promo-bg, var(--color-bg-dark)) 0%, color-mix(in srgb, var(--account-login-promo-bg, var(--color-bg-dark)) 62%, transparent) 28%, transparent 58%),
                radial-gradient(ellipse 58% 48% at 86% 88%, color-mix(in srgb, var(--account-login-accent, var(--color-primary)) 22%, transparent) 0%, transparent 70%),
                url('/Weline/Theme/view/theme/frontend/assets/images/ink/ox-cloth-caravan.webp?v=20260921-ox1');
            background-size: cover, cover, cover;
            background-position: center, center, 62% center;
            background-blend-mode: normal, normal, luminosity;
        }
        .account-login-widget__overlay {
            position: absolute;
            inset: 0;
            background: rgba(15, 17, 17, var(--account-login-overlay, 0.35));
            opacity: 0;
        }
        .account-login-widget--has-image .account-login-widget__overlay { opacity: 1; }
        .account-login-widget__rail {
            position: relative;
            z-index: 1;
            grid-column: 1;
            max-width: 40rem;
            width: 100%;
            padding: 0.35rem 0 0;
            color: #fff;
            display: grid;
            gap: 0.55rem;
            align-content: start;
        }
        .account-login-widget__eyebrow {
            margin: 0;
