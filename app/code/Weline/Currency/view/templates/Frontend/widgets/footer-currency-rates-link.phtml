<?php
/**
 * 页脚「支付与账户」扩展：货币与汇率入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-currency-rates-link}
 * @widget.name {页脚货币与汇率链接}
 * @widget.description {页脚支付与账户扩展槽：货币与汇率政策入口；默认注入 footer-payment-account-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-payment-account-links}
 * @widget.supports {["footer-currency-rates-link","layout-footer-payment-account-links"]}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer-payment-account-links", "area":"footer", "sort_order":20, "required":true, "reason":"页脚支付与账户默认展示货币与汇率", "config":{"label":"货币与汇率"} }]}
 *
 * @param label {default="货币与汇率",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-currency-rates-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '货币与汇率';
$label = WidgetI18n::label($labelSource, '货币与汇率');
?>
<a class="footer-payment-account-link footer-currency-rates-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-currency-rates-link"
   href="@url{'currency'}"><?= $esc($label) ?></a>
