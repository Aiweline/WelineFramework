                    </div>
                </div>
                
                <div style="--w-mb:var(--weline-space-2);">
                    <small class="w-text" data-tone="muted">
                        <lang>当前步骤：</lang><span id='update_current_currency' class="w-text" data-weight="strong">-</span>
                    </small>
