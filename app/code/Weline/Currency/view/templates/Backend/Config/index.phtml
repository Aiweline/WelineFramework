<script>
(function() {
    'use strict';
    
    var WelineCurrencyConfig = {
        changeModalInstance: null,
        progressModalInstance: null,

        resolveForm: function() {
            return document.querySelector('[data-testid="currency-config-form"]')
                || document.querySelector('form.w-form')
                || document.querySelector('form.needs-validation');
        },
        
        init: function() {
            var self = this;
            var changeModal = document.getElementById('baseCurrencyChangeModal');
            var progressModal = document.getElementById('currencyUpdateProgressModal');
            
            this.changeModalInstance = changeModal;
            this.progressModalInstance = progressModal;
            
            self.updateRateModeSections();
            document.querySelectorAll('input[name="rate_mode"]').forEach(function(input) {
                input.addEventListener('change', function() {
                    self.updateRateModeSections();
                });
            });

            var form = self.resolveForm();
            var baseCurrencySelect = document.getElementById('base_currency');
            
            if (form) {
                form.addEventListener('submit', function(e) {
                    var originalValue = baseCurrencySelect.getAttribute('data-original-value');
                    var newValue = baseCurrencySelect.value;
                    
                    if (newValue !== originalValue) {
                        e.preventDefault();
                        e.stopPropagation();
                        self.openBaseCurrencyPreview(originalValue, newValue, form);
                    }
                });
            }

            var confirmModalBtn = document.getElementById('confirmBaseCurrencyChangeBtn');
            if (confirmModalBtn) {
                confirmModalBtn.addEventListener('click', function() {
                    if (confirmModalBtn.disabled) {
                        return;
                    }
                    var activeForm = self.resolveForm();
                    var originalValue = baseCurrencySelect.getAttribute('data-original-value');
                    var newValue = baseCurrencySelect.value;
                    
                    if (self.changeModalInstance) {
                        Weline.UI.dialog.close(self.changeModalInstance, 'confirmed');
                    }
                    
                    self.applyBaseCurrencyWithSse(originalValue, newValue, activeForm);
                });
            }

            var confirmBtn = document.getElementById('confirm_base_currency_change');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var activeForm = self.resolveForm();
                    var originalValue = baseCurrencySelect.getAttribute('data-original-value');
                    var newValue = baseCurrencySelect.value;
                    if (newValue === originalValue) {
                        Weline.UI.toast.info('<?= __('基准货币未变化') ?>');
                        return;
                    }
                    self.openBaseCurrencyPreview(originalValue, newValue, activeForm);
                });
            }
            
            var cronFrequency = document.getElementById('cron_frequency');
            if (cronFrequency) {
                cronFrequency.addEventListener('change', function() {
                    var frequency = this.value;
                    
                    document.getElementById('time_selector').style.display = 
                        (frequency === 'daily' || frequency === 'weekly' || frequency === 'monthly') ? 'block' : 'none';
                    document.getElementById('weekday_selector').style.display = 
                        (frequency === 'weekly') ? 'block' : 'none';
                    document.getElementById('day_selector').style.display = 
                        (frequency === 'monthly') ? 'block' : 'none';
                    document.getElementById('custom_selector').style.display = 
                        (frequency === 'custom') ? 'block' : 'none';
                    
                    self.updateCronExpression();
                });
            }

            ['cron_hour', 'cron_minute', 'cron_weekday', 'cron_day', 'cron_custom'].forEach(function(id) {
                var control = document.getElementById(id);
                if (control) {
                    control.addEventListener('change', function() {
                        self.updateCronExpression();
                    });
                }
            });

            if (baseCurrencySelect) {
                baseCurrencySelect.addEventListener('change', function() {
                    self.checkBaseCurrencyChange(this);
                });
            }

            document.addEventListener('click', function(event) {
                var trigger = event.target.closest('[data-currency-config-action]');
                if (!trigger) {
                    return;
                }

                event.preventDefault();
                var action = trigger.getAttribute('data-currency-config-action');
                if (action === 'test-api') {
                    self.testApi({ target: trigger });
                    return;
                }
                if (action === 'preview-base-change') {
                    var activeForm = self.resolveForm();
                    var originalValue = baseCurrencySelect.getAttribute('data-original-value');
                    var newValue = baseCurrencySelect.value;
                    if (newValue === originalValue) {
                        Weline.UI.toast.info('<?= __('基准货币未变化') ?>');
                        return;
                    }
                    self.openBaseCurrencyPreview(originalValue, newValue, activeForm);
                    return;
                }
                if (action === 'reset-base' || action === 'cancel-base-preview') {
                    self.resetBaseCurrency();
                    return;
                }
                if (action === 'manual-import') {
                    self.manualImport({ target: trigger });
                }
            });
            
            var cronInput = document.getElementById('import_cron_time');
            if (cronInput) {
                this.parseCronExpression(cronInput.value);
            }
        },
        
        updateRateModeSections: function() {
            var selectedMode = document.querySelector('input[name="rate_mode"]:checked');
            var mode = selectedMode ? selectedMode.value : 'manual';

            document.querySelectorAll('[data-rate-mode-section]').forEach(function(section) {
                var sectionMode = section.getAttribute('data-rate-mode-section');
                section.style.display = sectionMode === mode ? '' : 'none';
            });
        },

        parseCronExpression: function(cronExpr) {
            if (!cronExpr) cronExpr = '0 2 * * *';
            
            var parts = cronExpr.trim().split(/\s+/);
            if (parts.length !== 5) {
                document.getElementById('cron_frequency').value = 'custom';
                document.getElementById('cron_custom').value = cronExpr;
                document.getElementById('custom_selector').style.display = 'block';
                document.getElementById('time_selector').style.display = 'none';
                this.updateCronExpression();
                return;
            }
            
            var minute = parts[0], hour = parts[1], day = parts[2], month = parts[3], weekday = parts[4];
            
            if (minute !== '*' && hour === '*' && day === '*' && month === '*' && weekday === '*') {
                document.getElementById('cron_frequency').value = 'hourly';
                document.getElementById('cron_minute').value = minute;
                document.getElementById('time_selector').style.display = 'none';
            } else if (day === '*' && month === '*' && weekday === '*') {
                document.getElementById('cron_frequency').value = 'daily';
                document.getElementById('cron_hour').value = hour;
                document.getElementById('cron_minute').value = minute;
                document.getElementById('time_selector').style.display = 'block';
            } else if (day === '*' && month === '*' && weekday !== '*') {
                document.getElementById('cron_frequency').value = 'weekly';
                document.getElementById('cron_hour').value = hour;
                document.getElementById('cron_minute').value = minute;
                document.getElementById('cron_weekday').value = weekday;
                document.getElementById('time_selector').style.display = 'block';
                document.getElementById('weekday_selector').style.display = 'block';
            } else if (day !== '*' && month === '*' && weekday === '*') {
                document.getElementById('cron_frequency').value = 'monthly';
                document.getElementById('cron_hour').value = hour;
                document.getElementById('cron_minute').value = minute;
                document.getElementById('cron_day').value = day;
                document.getElementById('time_selector').style.display = 'block';
                document.getElementById('day_selector').style.display = 'block';
            } else {
                document.getElementById('cron_frequency').value = 'custom';
                document.getElementById('cron_custom').value = cronExpr;
                document.getElementById('time_selector').style.display = 'none';
                document.getElementById('custom_selector').style.display = 'block';
            }
            
            this.updateCronExpression();
        },
        
        updateCronExpression: function() {
            var frequency = document.getElementById('cron_frequency').value;
            var cronExpr = '', preview = '';
            var weekdays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
            
            switch (frequency) {
                case 'hourly':
                    var minute = document.getElementById('cron_minute').value;
                    cronExpr = minute + ' * * * *';
                    preview = '每小时的第 ' + minute + ' 分钟执行';
                    break;
                case 'daily':
                    var hour = document.getElementById('cron_hour').value;
                    var min = document.getElementById('cron_minute').value;
                    cronExpr = min + ' ' + hour + ' * * *';
                    preview = '每天 ' + String(hour).padStart(2, '0') + ':' + String(min).padStart(2, '0') + ' 执行';
                    break;
                case 'weekly':
                    var wHour = document.getElementById('cron_hour').value;
                    var wMin = document.getElementById('cron_minute').value;
                    var weekday = document.getElementById('cron_weekday').value;
                    cronExpr = wMin + ' ' + wHour + ' * * ' + weekday;
                    preview = '每周 ' + weekdays[weekday] + ' ' + String(wHour).padStart(2, '0') + ':' + String(wMin).padStart(2, '0') + ' 执行';
                    break;
                case 'monthly':
                    var mHour = document.getElementById('cron_hour').value;
                    var mMin = document.getElementById('cron_minute').value;
                    var day = document.getElementById('cron_day').value;
                    cronExpr = mMin + ' ' + mHour + ' ' + day + ' * *';
                    preview = '每月第 ' + day + ' 天 ' + String(mHour).padStart(2, '0') + ':' + String(mMin).padStart(2, '0') + ' 执行';
                    break;
                case 'custom':
                    cronExpr = document.getElementById('cron_custom').value || '0 2 * * *';
                    preview = '自定义：' + cronExpr;
                    break;
            }
            
            document.getElementById('import_cron_time').value = cronExpr;
            document.getElementById('cron_expression_display').textContent = cronExpr;
            document.getElementById('cron_preview').textContent = preview;
        },
        
        checkBaseCurrencyChange: function(selectElement) {
            var originalValue = selectElement.getAttribute('data-original-value');
            var newValue = selectElement.value;
            var warningDiv = document.getElementById('base_currency_warning');
            var form = this.resolveForm();
            
            if (newValue !== originalValue) {
                warningDiv.style.display = 'block';
                if (form) delete form.dataset.baseCurrencyConfirmed;
                warningDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                warningDiv.style.display = 'none';
                if (form) delete form.dataset.baseCurrencyConfirmed;
            }
        },
        
        resetBaseCurrency: function() {
            var baseCurrencySelect = document.getElementById('base_currency');
            var originalValue = baseCurrencySelect.getAttribute('data-original-value');
            baseCurrencySelect.value = originalValue;
            document.getElementById('base_currency_warning').style.display = 'none';
            
            var form = this.resolveForm();
            if (form) delete form.dataset.baseCurrencyConfirmed;

            var confirmBtn = document.getElementById('confirmBaseCurrencyChangeBtn');
            if (confirmBtn) {
                confirmBtn.disabled = true;
            }
        },

        openBaseCurrencyPreview: function(oldBaseCurrency, newBaseCurrency, form) {
            var self = this;
            form = form || this.resolveForm();
            var confirmBtn = document.getElementById('confirmBaseCurrencyChangeBtn');
            var loadingEl = document.getElementById('modal_rate_preview_loading');
            var errorEl = document.getElementById('modal_rate_preview_error');
            var bodyEl = document.getElementById('modal_rate_preview_body');
            var summaryEl = document.getElementById('modal_rate_preview_summary');
            var formulaEl = document.getElementById('modal_rate_formula');
            var previewUrl = '@backend-url{'currency/backend/config/preview-base-currency-change'}';

            document.getElementById('modal_old_base_currency').textContent = oldBaseCurrency;
            document.getElementById('modal_new_base_currency').textContent = newBaseCurrency;
            if (formulaEl) {
                formulaEl.textContent = '';
            }
            if (bodyEl) {
                bodyEl.innerHTML = '';
            }
            if (summaryEl) {
                summaryEl.textContent = '';
            }
            if (errorEl) {
                errorEl.style.display = 'none';
                errorEl.textContent = '';
            }
            if (loadingEl) {
                loadingEl.style.display = '';
            }
            if (confirmBtn) {
                confirmBtn.disabled = true;
            }

            if (this.changeModalInstance) {
                Weline.UI.dialog.open(this.changeModalInstance);
            } else {
                Weline.UI.toast.error('<?= __('无法打开确认弹窗') ?>');
            }

            var xhr = new XMLHttpRequest();
            xhr.open('POST', previewUrl, true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.setRequestHeader('Accept', 'application/json');
            xhr.withCredentials = true;
            xhr.onload = function() {
                if (loadingEl) {
                    loadingEl.style.display = 'none';
                }
                var data = null;
                try {
                    data = JSON.parse(xhr.responseText || '{}');
                } catch (e) {
                    data = null;
                }
                if (xhr.status < 200 || xhr.status >= 300 || !data || !data.success || !data.data) {
                    if (errorEl) {
                        errorEl.style.display = '';
                        var fallback = '<?= __('预览失败') ?>' + (xhr.status ? (' (HTTP ' + xhr.status + ')') : '');
                        if (!data || !data.message) {
                            var raw = String(xhr.responseText || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                            if (raw && raw.length < 180) {
                                fallback += ': ' + raw;
                            }
                        }
                        errorEl.textContent = (data && data.message) ? data.message : fallback;
                    }
                    return;
                }

                var preview = data.data;
                if (formulaEl) {
                    formulaEl.textContent = preview.formula || '';
                }
                if (Array.isArray(preview.errors) && preview.errors.length) {
                    if (errorEl) {
                        errorEl.style.display = '';
                        errorEl.textContent = preview.errors.map(function(item) {
                            return (item.currency || '') + ': ' + (item.error || '');
                        }).join('；');
                    }
                }

                if (bodyEl) {
                    bodyEl.innerHTML = '';
                    (preview.changes || []).forEach(function(row) {
                        var tr = document.createElement('tr');
                        var statusText = row.is_new_base
                            ? '<?= __('新基准（rate=1）') ?>'
                            : (row.changed ? '<?= __('将纠正') ?>' : '<?= __('不变') ?>');

                        tr.innerHTML =
                            '<td><strong>' + self.escapeHtml(row.code) + '</strong><br><span class="w-text" data-size="sm" data-tone="muted">' + self.escapeHtml(row.name || '') + '</span></td>' +
                            '<td>' + self.escapeHtml(row.old_meaning || '') + '</td>' +
                            '<td><code>' + self.escapeHtml(String(row.old_rate)) + '</code></td>' +
                            '<td>' + self.escapeHtml(row.new_meaning || '') + '</td>' +
                            '<td><code>' + self.escapeHtml(String(row.new_rate)) + '</code></td>' +
                            '<td>' + statusText + '</td>';
                        bodyEl.appendChild(tr);
                    });
                }

                if (summaryEl) {
                    // 勿在 PHP 侧裸调 __('%{1}')，否则占位符会被译空；用字面模板再在前端替换。
                    var summaryTpl = <?= json_encode('共 %{1} 个货币，其中 %{2} 个将纠正写入。确认前不会修改数据库。', JSON_UNESCAPED_UNICODE) ?>;
                    summaryEl.textContent = summaryTpl
                        .replace('%{1}', String(preview.total_count || (preview.changes || []).length || 0))
                        .replace('%{2}', String(preview.changed_count || 0));
                }

                if (confirmBtn) {
                    confirmBtn.disabled = (preview.changes || []).length === 0;
                }
            };
            xhr.onerror = function() {
                if (loadingEl) {
                    loadingEl.style.display = 'none';
                }
                if (errorEl) {
                    errorEl.style.display = '';
                    errorEl.textContent = '<?= __('预览请求失败') ?>';
                }
            };
            xhr.send(new URLSearchParams({
                old_base_currency: oldBaseCurrency,
                new_base_currency: newBaseCurrency
            }).toString());
        },

        escapeHtml: function(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        },

        appendSseLog: function(message) {
            var logEl = document.getElementById('update_sse_log');
            if (!logEl) {
                return;
            }
            var line = document.createElement('div');
            line.textContent = '[' + new Date().toLocaleTimeString() + '] ' + String(message || '');
            logEl.appendChild(line);
            logEl.scrollTop = logEl.scrollHeight;
        },

        setProgressPercent: function(percent) {
            percent = Math.max(0, Math.min(100, Number(percent) || 0));
            var bar = document.getElementById('update_progress_bar');
            var text = document.getElementById('update_progress_text');
            if (bar) {
                bar.style.width = percent + '%';
                bar.setAttribute('aria-valuenow', String(percent));
            }
            if (text) {
                text.textContent = Math.round(percent) + '%';
            }
        },

        applyBaseCurrencyWithSse: function(oldBaseCurrency, newBaseCurrency, form) {
            var self = this;
            form = form || this.resolveForm();
            var baseCurrencySelect = document.getElementById('base_currency');
            var streamUrl = '@backend-url{'currency/backend/config/apply-base-currency-change-stream'}';

            if (this.progressModalInstance) {
                Weline.UI.dialog.open(this.progressModalInstance);
            }
            this.resetProgress();
            this.appendSseLog('<?= __('连接 SSE，准备写入…') ?>');

            var body = new URLSearchParams();
            if (form) {
                new FormData(form).forEach(function(value, key) {
                    body.append(key, value);
                });
            }
            body.set('old_base_currency', oldBaseCurrency);
            body.set('new_base_currency', newBaseCurrency);
            body.set('base_currency', newBaseCurrency);
            body.set('confirm_base_currency_apply', '1');

            fetch(streamUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'text/event-stream',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'include',
                body: body.toString()
            }).then(function(response) {
                var contentType = String(response.headers.get('content-type') || '').toLowerCase();
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                if (contentType.indexOf('text/event-stream') === -1) {
                    return response.json().then(function(data) {
                        throw new Error((data && data.message) ? data.message : '<?= __('未返回 SSE 流') ?>');
                    });
                }
                return self.consumeSse(response, function(eventName, data) {
                    var message = (data && data.message) ? String(data.message) : eventName;
                    var progress = data && data.progress != null ? Number(data.progress) : null;
                    if (isFinite(progress)) {
                        self.setProgressPercent(progress);
                    }
                    if (data && data.currency) {
                        document.getElementById('update_current_currency').textContent = data.currency;
                    } else if (data && data.step) {
                        document.getElementById('update_current_currency').textContent = data.step;
                    }
                    if (data && data.total != null) {
                        document.getElementById('update_total_count').textContent = String(data.total);
                    }
                    if (data && data.current != null) {
                        document.getElementById('update_success_count').textContent = String(data.current);
                    }
                    if (eventName === 'done') {
                        document.getElementById('update_total_count').textContent = String(data.total_count || 0);
                        document.getElementById('update_success_count').textContent = String(data.success_count || 0);
                        document.getElementById('update_fail_count').textContent = String(data.fail_count || 0);
                        self.setProgressPercent(100);
                        document.getElementById('update_progress_bar').classList.remove('progress-bar-animated');
                        document.getElementById('update_progress_footer').style.display = 'block';
                        if (baseCurrencySelect) {
                            baseCurrencySelect.setAttribute('data-original-value', newBaseCurrency);
                        }
                        document.getElementById('base_currency_warning').style.display = 'none';
                        Weline.UI.toast.success(message);
                    }
                    if (eventName === 'error') {
                        document.getElementById('update_errors').style.display = 'block';
                        var list = document.getElementById('update_errors_list');
                        list.innerHTML = '';
                        var li = document.createElement('li');
                        li.textContent = message;
                        list.appendChild(li);
                        document.getElementById('update_progress_footer').style.display = 'block';
                        Weline.UI.toast.error(message);
                        self.resetBaseCurrency();
                    }
                    self.appendSseLog(message);
                });
            }).catch(function(error) {
                self.appendSseLog(error && error.message ? error.message : '<?= __('SSE 失败') ?>');
                document.getElementById('update_errors').style.display = 'block';
                document.getElementById('update_progress_footer').style.display = 'block';
                Weline.UI.toast.error(error && error.message ? error.message : '<?= __('SSE 失败') ?>');
                self.resetBaseCurrency();
            });
        },

        consumeSse: function(response, onEvent) {
            var reader = response.body.getReader();
            var decoder = new TextDecoder('utf-8');
            var buffer = '';
            var eventName = 'message';
            var dataLines = [];

            function flushEvent() {
                if (!dataLines.length) {
                    eventName = 'message';
                    return;
                }
                var raw = dataLines.join('\n');
                dataLines = [];
                var payload = raw;
                try {
                    payload = JSON.parse(raw);
                } catch (e) {}
                onEvent(eventName || 'message', payload);
                eventName = 'message';
            }

            function pump() {
                return reader.read().then(function(result) {
                    if (result.done) {
                        buffer += decoder.decode();
                        if (buffer.trim()) {
                            buffer.split(/\r?\n/).forEach(function(line) {
                                if (line.indexOf('event:') === 0) {
                                    eventName = line.slice(6).trim();
                                } else if (line.indexOf('data:') === 0) {
                                    dataLines.push(line.slice(5).trim());
                                } else if (line === '') {
                                    flushEvent();
                                }
                            });
                            flushEvent();
                        }
                        return;
                    }
                    buffer += decoder.decode(result.value, { stream: true });
                    var parts = buffer.split(/\r?\n/);
                    buffer = parts.pop();
                    parts.forEach(function(line) {
                        if (line.indexOf('event:') === 0) {
                            eventName = line.slice(6).trim();
                        } else if (line.indexOf('data:') === 0) {
                            dataLines.push(line.slice(5).trim());
                        } else if (line === '') {
                            flushEvent();
                        }
                    });
                    return pump();
                });
            }

            return pump();
        },
        
        updateCurrencyRates: function(oldBaseCurrency, newBaseCurrency, form) {
            var self = this;
            var baseCurrencySelect = document.getElementById('base_currency');
            var updateUrl = '@backend-url{'currency/backend/config/post-update-rates'}';
            
            Weline.adminRequest('currency', updateUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    old_base_currency: oldBaseCurrency,
                    new_base_currency: newBaseCurrency,
                    current: 0
                })
            })
            .then(function(response){ return response; })
            .then(function(data) {
                if (data.success) {
                    self.updateProgress(data.total_count, data.success_count, data.fail_count, data.errors);
                    
                    document.getElementById('update_progress_bar').classList.remove('progress-bar-animated');
                    document.getElementById('update_progress_bar').style.width = '100%';
                    document.getElementById('update_progress_text').textContent = '100%';
                    document.getElementById('update_progress_footer').style.display = 'block';
                    
                    baseCurrencySelect.setAttribute('data-original-value', newBaseCurrency);
                    form.dataset.baseCurrencyConfirmed = '';
                    
                    Weline.UI.toast.success(data.message || '<?= __('货币汇率更新完成') ?>');
                } else {
                    if (self.progressModalInstance) {
                        Weline.UI.dialog.close(self.progressModalInstance, 'error');
                    }
                    Weline.UI.toast.error(data.message || '<?= __('货币汇率更新失败') ?>');
                    form.dataset.baseCurrencyConfirmed = '';
                }
            })
            .catch(function(error) {
                if (self.progressModalInstance) {
                    Weline.UI.dialog.close(self.progressModalInstance, 'error');
                }
                Weline.UI.toast.error('<?= __('更新失败') ?>');
                form.dataset.baseCurrencyConfirmed = '';
            });
        },
        
        resetProgress: function() {
            document.getElementById('update_progress_bar').style.width = '0%';
            document.getElementById('update_progress_text').textContent = '0%';
            document.getElementById('update_progress_bar').classList.add('progress-bar-animated');
            document.getElementById('update_current_currency').textContent = '-';
            document.getElementById('update_total_count').textContent = '0';
            document.getElementById('update_success_count').textContent = '0';
            document.getElementById('update_fail_count').textContent = '0';
            document.getElementById('update_errors').style.display = 'none';
            document.getElementById('update_errors_list').innerHTML = '';
            document.getElementById('update_progress_footer').style.display = 'none';
            var logEl = document.getElementById('update_sse_log');
            if (logEl) {
                logEl.innerHTML = '';
            }
        },
        
        updateProgress: function(total, success, fail, errors) {
            var percentage = total > 0 ? Math.round((success + fail) / total * 100) : 0;
            
            document.getElementById('update_progress_bar').style.width = percentage + '%';
            document.getElementById('update_progress_text').textContent = percentage + '%';
            document.getElementById('update_total_count').textContent = total;
            document.getElementById('update_success_count').textContent = success;
            document.getElementById('update_fail_count').textContent = fail;
            
            if (errors && errors.length > 0) {
                var errorsList = document.getElementById('update_errors_list');
                errorsList.innerHTML = '';
                errors.forEach(function(error) {
                    var li = document.createElement('li');
                    li.textContent = error.currency + ': ' + error.error;
                    errorsList.appendChild(li);
                });
                document.getElementById('update_errors').style.display = 'block';
            }
        },
        
        testApi: function(event) {
            var apiKey = document.getElementById('import_api_key').value;
            var btn = event.target;
            var originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<?= __('测试中...') ?>';
            
            var testApiUrl = '@backend-url{'currency/backend/config/testApi'}';
            var testApiOpts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'api_key=' + encodeURIComponent(apiKey) };
            Weline.adminRequest('currency', testApiUrl, testApiOpts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message || '<?= __('API连接测试成功') ?>');
                } else {
                    Weline.UI.toast.error(data.message || '<?= __('API连接测试失败') ?>');
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('请求失败') ?>');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = originalText;
            });
        },
        
        manualImport: function(event) {
            var btn = event.target;
            var originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<?= __('导入中...') ?>';
            
            var importUrl = '@backend-url{'currency/backend/config/import'}';
            var importOpts = { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' } };
            Weline.adminRequest('currency', importUrl, importOpts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message || '<?= __('导入成功') ?>');
                    setTimeout(function() { location.reload(); }, 2000);
                } else {
                    Weline.UI.toast.error(data.message || '<?= __('导入失败') ?>');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('请求失败') ?>');
                btn.disabled = false;
                btn.innerHTML = originalText;
            });
        }
    };
    
    window.WelineCurrencyConfig = WelineCurrencyConfig;
    
    document.addEventListener('DOMContentLoaded', function() {
        WelineCurrencyConfig.init();
    });
})();
</script>
