                <div id='update_sse_log' data-w-border="border" data-w-radius="md" style="max-height:14rem;overflow:auto;--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-3);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-3);--w-mb:var(--weline-space-4);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:var(--weline-font-size-sm);"></div>
                
                <div class="w-grid w-text" data-align="center" style="--w-mt:var(--weline-space-4);">
                    <div style="--w-span:4;">
                        <div data-w-border="border" data-w-radius="md" style="--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">
                            <div class="h5" id='update_total_count' style="--w-mb:0;">0</div>
                            <small class="w-text" data-tone="muted"><lang>总计</lang></small>
                        </div>
                    </div>
                    <div style="--w-span:4;">
                        <?php /* 浅底+inverse 白字叠浅绿/浅红对比度崩；与总计同结构，语义色只上数字与标签 */ ?>
                        <div data-w-border="border" data-w-radius="md" style="--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">
                            <div class="h5 w-text" id='update_success_count' data-tone="success" style="--w-mb:0;">0</div>
