<?php
/**
 * Skill listing — humanized Weline UI 2.0.
 * @var \Weline\Framework\View\Template $this
 */
$skills = is_array($skills ?? null) ? $skills : [];
$categories = is_array($categories ?? null) ? $categories : [];
$currentCategory = trim((string)($current_category ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$get = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) {
        return $item[$key] ?? $default;
    }
    if (is_object($item)) {
        if (method_exists($item, 'getData')) {
            return $item->getData($key) ?? $default;
        }
        if (isset($item->{$key})) {
            return $item->{$key};
        }
    }
    return $default;
};

$activeCount = 0;
$dangerCount = 0;
foreach ($skills as $skill) {
    if ((int)$get($skill, 'is_active', 0) === 1) {
        $activeCount++;
    }
    if ((int)$get($skill, 'is_dangerous', 0) === 1) {
        $dangerCount++;
    }
}
