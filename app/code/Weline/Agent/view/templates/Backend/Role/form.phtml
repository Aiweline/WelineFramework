<script>
(function () {
    'use strict';

    var roleTemplates = <?= json_encode($roleTemplates, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var guideProfiles = <?= json_encode($guideProfiles, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
    var form = document.getElementById('agentRoleForm');
    var listingUrl = form ? (form.getAttribute('data-listing-url') || '') : '';
    var generateBtn = document.getElementById('generateSuggestionBtn');
    var applyTemplateBaselineBtn = document.getElementById('applyTemplateBaselineBtn');
    var toggleAdvancedBtn = document.getElementById('toggleAdvancedBtn');
    var advancedFields = document.getElementById('advancedFields');
    var warningBox = document.getElementById('suggestionWarnings');
    var sourceBadge = document.getElementById('suggestionSource');
    var agentProfileSelect = document.getElementById('agent_profile');
    var botProfileHint = document.getElementById('botProfileHint');
    var admin = window.WelineAgentAdmin || null;

    function toast(type, message) {
        if (admin && typeof admin.toast === 'function') {
            admin.toast(type, message);
            return;
        }
        console.log('[role-form][' + type + ']', message);
    }

    function setWarnings(messages) {
        if (!Array.isArray(messages) || messages.length === 0) {
            warningBox.hidden = true;
            warningBox.innerHTML = '';
            return;
        }
        warningBox.hidden = false;
        warningBox.innerHTML = messages.map(function (item) {
            return '<div>' + String(item) + '</div>';
        }).join('');
    }

    function setSuggestionSource(source, templateName) {
        if (!source) {
            sourceBadge.hidden = true;
            sourceBadge.innerText = '';
            return;
        }
        sourceBadge.hidden = false;
        if (source === 'ai') {
            sourceBadge.setAttribute('data-tone', 'success');
            sourceBadge.innerText = <?= json_encode((string)__('来源：AI 建议'), JSON_UNESCAPED_UNICODE) ?> + (templateName ? (' / ' + templateName) : '');
            return;
        }
        sourceBadge.setAttribute('data-tone', 'info');
        sourceBadge.innerText = <?= json_encode((string)__('来源：模板基线'), JSON_UNESCAPED_UNICODE) ?> + (templateName ? (' / ' + templateName) : '');
    }

    function slugify(value) {
        return String(value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
    }

    function collectGuidePayload() {
        var modelId = parseInt((document.getElementById('model_id') || {}).value || '0', 10);
        if (!Number.isFinite(modelId)) modelId = 0;
        return {
            template_code: (document.getElementById('template_code') || {}).value || 'general_assistant',
            brief: (document.getElementById('guide_brief') || {}).value || '',
            project_count: parseInt((document.getElementById('project_count') || {}).value || '1', 10) || 1,
            target_outcome: (document.getElementById('target_outcome') || {}).value || '',
            workflow_style: (document.getElementById('workflow_style') || {}).value || 'balanced',
            risk_level: (document.getElementById('risk_level') || {}).value || 'safe',
            agent_profile: (document.getElementById('agent_profile') || {}).value || 'multi_project',
            role_name: (document.getElementById('name') || {}).value || '',
            role_code: (document.getElementById('code') || {}).value || '',
            model_id: modelId,
            icon: (document.getElementById('icon') || {}).value || 'mdi-robot'
        };
    }

    function collectSavePayload() {
        var skills = [];
        if (form) {
            form.querySelectorAll('.role-skill-checkbox:checked').forEach(function (el) { skills.push(el.value); });
        }
        var idInput = form ? form.querySelector('input[name="id"]') : null;
        return {
            id: idInput ? parseInt(idInput.value || '0', 10) || 0 : 0,
            code: (document.getElementById('code') || {}).value || '',
            name: (document.getElementById('name') || {}).value || '',
            system_prompt: (document.getElementById('system_prompt') || {}).value || '',
            model_id: parseInt((document.getElementById('model_id') || {}).value || '0', 10) || 0,
            scenario_adapter_code: (document.getElementById('scenario_adapter_code') || {}).value || '',
            status: (document.getElementById('status') || {}).value || 'enabled',
            description: (document.getElementById('description') || {}).value || '',
            icon: (document.getElementById('icon') || {}).value || 'mdi-robot',
            permissions_text: (document.getElementById('permissions_text') || {}).value || '',
            skills: skills,
            model_config_text: (document.getElementById('model_config_text') || {}).value || ''
        };
    }

    function findTemplateByCode(templateCode) {
        if (!Array.isArray(roleTemplates)) return null;
        for (var i = 0; i < roleTemplates.length; i += 1) {
            if (String((roleTemplates[i] || {}).code || '') === String(templateCode || '')) return roleTemplates[i];
        }
        return null;
    }

    function applyDraft(draft) {
        if (!draft || typeof draft !== 'object') return;
        var map = {
            code: 'code', name: 'name', description: 'description', system_prompt: 'system_prompt',
            status: 'status', icon: 'icon', model_id: 'model_id', scenario_adapter_code: 'scenario_adapter_code'
        };
        Object.keys(map).forEach(function (key) {
            var el = document.getElementById(map[key]);
            if (!el || typeof draft[key] === 'undefined' || draft[key] === null || draft[key] === '') return;
            el.value = key === 'code' ? slugify(draft[key]) : String(draft[key]);
        });
        var permissionsInput = document.getElementById('permissions_text');
        var modelConfigInput = document.getElementById('model_config_text');
        if (permissionsInput && Array.isArray(draft.permissions)) permissionsInput.value = draft.permissions.join('\n');
        if (modelConfigInput && draft.model_config && typeof draft.model_config === 'object') {
            modelConfigInput.value = JSON.stringify(draft.model_config, null, 2);
        }
        if (Array.isArray(draft.skills) && form) {
            form.querySelectorAll('.role-skill-checkbox').forEach(function (checkbox) {
                checkbox.checked = draft.skills.indexOf(checkbox.value) >= 0;
            });
        }
    }

    function applyTemplateBaseline() {
        var template = findTemplateByCode((document.getElementById('template_code') || {}).value || '');
        if (!template) {
            toast('error', <?= json_encode((string)__('未找到模板'), JSON_UNESCAPED_UNICODE) ?>);
            return;
        }
        var draft = Object.assign({}, template);
        var codeInput = document.getElementById('code');
        var nameInput = document.getElementById('name');
        if (codeInput && String(codeInput.value || '').trim() !== '') draft.code = codeInput.value;
        if (nameInput && String(nameInput.value || '').trim() !== '') draft.name = nameInput.value;
        applyDraft(draft);
        setSuggestionSource('template', String(template.name || template.code || ''));
        setWarnings([]);
        toast('success', <?= json_encode((string)__('已应用模板基线'), JSON_UNESCAPED_UNICODE) ?>);
        if (advancedFields) advancedFields.style.display = '';
    }

    function updateAgentProfileHint() {
        if (!botProfileHint || !agentProfileSelect || !Array.isArray(guideProfiles)) return;
        var selected = String(agentProfileSelect.value || '');
        var matched = null;
        for (var i = 0; i < guideProfiles.length; i += 1) {
            if (String((guideProfiles[i] || {}).code || '') === selected) { matched = guideProfiles[i]; break; }
        }
        botProfileHint.innerText = matched && matched.description
            ? String(matched.description)
            : <?= json_encode((string)__('选择配置以获取项目规模默认值。'), JSON_UNESCAPED_UNICODE) ?>;
    }

    function requestSuggestion() {
        if (!admin || typeof admin.call !== 'function') {
            toast('error', <?= json_encode((string)__('Weline.Api 不可用，无法生成建议'), JSON_UNESCAPED_UNICODE) ?>);
            return;
        }
        generateBtn.disabled = true;
        generateBtn.textContent = <?= json_encode((string)__('正在生成…'), JSON_UNESCAPED_UNICODE) ?>;
        setWarnings([]);
        admin.call('suggestRole', collectGuidePayload()).then(function (raw) {
            var data = admin.unwrap ? admin.unwrap(raw) : raw;
            if (!data || !data.success) throw new Error((data && data.msg) || <?= json_encode((string)__('建议生成失败'), JSON_UNESCAPED_UNICODE) ?>);
            var result = data.data || {};
            applyDraft(result.draft || {});
            setWarnings(result.warnings || []);
            setSuggestionSource(result.source || '', ((result.template || {}).name || ''));
            if (advancedFields) advancedFields.style.display = '';
            toast('success', data.msg || <?= json_encode((string)__('建议已生成'), JSON_UNESCAPED_UNICODE) ?>);
        }).catch(function (error) {
            setSuggestionSource('', '');
            toast('error', error && error.message ? error.message : <?= json_encode((string)__('建议生成失败'), JSON_UNESCAPED_UNICODE) ?>);
        }).finally(function () {
            generateBtn.disabled = false;
            generateBtn.textContent = <?= json_encode((string)__('生成 AI 建议'), JSON_UNESCAPED_UNICODE) ?>;
        });
    }

    function saveRole(event) {
        if (event) event.preventDefault();
        if (!admin || typeof admin.call !== 'function') {
            toast('error', <?= json_encode((string)__('Weline.Api 不可用，无法保存'), JSON_UNESCAPED_UNICODE) ?>);
            return false;
        }
        var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
        if (submitBtn) submitBtn.disabled = true;
        admin.call('saveRole', collectSavePayload()).then(function (raw) {
            var data = admin.unwrap ? admin.unwrap(raw) : raw;
            if (!data || !data.success) throw new Error((data && data.msg) || <?= json_encode((string)__('保存失败'), JSON_UNESCAPED_UNICODE) ?>);
            toast('success', data.msg || <?= json_encode((string)__('保存成功'), JSON_UNESCAPED_UNICODE) ?>);
            if (listingUrl) window.location.href = listingUrl;
        }).catch(function (error) {
            toast('error', error && error.message ? error.message : <?= json_encode((string)__('保存失败'), JSON_UNESCAPED_UNICODE) ?>);
            if (submitBtn) submitBtn.disabled = false;
        });
        return false;
    }

    if (form) form.addEventListener('submit', saveRole);
    if (generateBtn) generateBtn.addEventListener('click', requestSuggestion);
    if (applyTemplateBaselineBtn) applyTemplateBaselineBtn.addEventListener('click', applyTemplateBaseline);
    if (agentProfileSelect) {
        agentProfileSelect.addEventListener('change', updateAgentProfileHint);
        updateAgentProfileHint();
    }
    if (toggleAdvancedBtn && advancedFields) {
        toggleAdvancedBtn.addEventListener('click', function () {
            if (advancedFields.style.display === 'none') {
                advancedFields.style.display = '';
                toggleAdvancedBtn.textContent = <?= json_encode((string)__('隐藏高级设置'), JSON_UNESCAPED_UNICODE) ?>;
                return;
            }
            advancedFields.style.display = 'none';
            toggleAdvancedBtn.textContent = <?= json_encode((string)__('显示高级设置'), JSON_UNESCAPED_UNICODE) ?>;
        });
    }
})();
</script>
