<?php
/**
 * Role listing — UI prototype host (?variant=A|B|C).
 * Question: What should Agent role onboarding look like?
 * A 紧凑列表 | B 工作台磁贴(default) | C 分栏步骤
 *
 * @var \Weline\Framework\View\Template $this
 */
$roles = is_array($roles ?? null) ? $roles : [];
$roleTemplates = is_array($role_templates ?? null) ? $role_templates : [];
$guideConfig = is_array($guide_config ?? null) ? $guide_config : [];
$guideProfiles = is_array($guide_profiles ?? null) ? $guide_profiles : [];
$initialGuide = is_array($initial_guide ?? null) ? $initial_guide : [];

$guideEnabled = (bool)($guide_enabled ?? ($guideConfig['enabled'] ?? true));
$defaultTemplateCode = (string)($initialGuide['template_code'] ?? ($guideConfig['default_template'] ?? 'general_assistant'));
$defaultAgentProfile = (string)($initialGuide['agent_profile'] ?? ($guideConfig['default_profile'] ?? 'multi_project'));
$defaultProjectCount = max(1, (int)($initialGuide['project_count'] ?? 1));
$maxProjectCount = max(1, (int)($max_project_count ?? ($guideConfig['max_project_count'] ?? 200)));

$addRolePath = '*/backend/role/add';
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$buildAddParams = static function (array $params): array {
    $filtered = [];
    foreach ($params as $key => $value) {
        $str = trim((string)$value);
        if ($str !== '') {
            $filtered[$key] = $str;
        }
    }
    return $filtered;
};

$profileProjectDefaults = [
    'single_project' => 1,
    'multi_project' => min(12, $maxProjectCount),
    'enterprise' => min(30, $maxProjectCount),
];

$profileIcons = [
    'single_project' => 'folder',
    'multi_project' => 'list',
    'enterprise' => 'settings',
];

$templateIcons = [
    'general_assistant' => 'robot',
    'coding_agent' => 'code',
    'it_ops' => 'server',
    'seo' => 'search',
];

$variant = strtoupper(trim((string)($_GET['variant'] ?? 'B')));
if (!in_array($variant, ['A', 'B', 'C'], true)) {
    $variant = 'B';
}

$enabledCount = 0;
foreach ($roles as $role) {
    if ((string)($role['status'] ?? '') === 'enabled') {
        $enabledCount++;
    }
}
$totalRoles = count($roles);
$templateCount = count($roleTemplates);
?>
