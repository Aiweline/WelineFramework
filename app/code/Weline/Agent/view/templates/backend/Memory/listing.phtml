<?php
/**
 * Memory listing — humanized Weline UI 2.0.
 * @var \Weline\Framework\View\Template $this
 */
$memoryNodes = is_array($memory_nodes ?? null) ? $memory_nodes : [];
$memoryEdges = is_array($memory_edges ?? null) ? $memory_edges : [];
$nodeTypes = is_array($node_types ?? null) ? $node_types : [];
$nodeStatuses = is_array($node_statuses ?? null) ? $node_statuses : [];
$currentType = trim((string)($current_type ?? ''));
$currentStatus = trim((string)($current_status ?? ''));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$get = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) {
        return $item[$key] ?? $default;
    }
    if (is_object($item)) {
        if (method_exists($item, 'getData')) {
            return $item->getData($key) ?? $default;
        }
        if (isset($item->{$key})) {
            return $item->{$key};
        }
    }
    return $default;
};
?>
