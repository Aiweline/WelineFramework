<?php
/**
 * Session detail — humanized Weline UI 2.0.
 *
 * @var \Weline\Framework\View\Template $this
 */
$session = $session ?? null;
$messages = is_array($messages ?? null) ? $messages : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$get = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) {
        return $item[$key] ?? $default;
    }
    if (is_object($item)) {
        if (method_exists($item, 'getData')) {
            $value = $item->getData($key);
            return $value ?? $default;
        }
        if (isset($item->{$key})) {
            return $item->{$key};
        }
    }
    return $default;
};

$sessionId = (int)$get($session, 'session_id', 0);
$title = (string)$get($session, 'title', '');
$roleId = (int)$get($session, 'role_id', 0);
$channel = (string)$get($session, 'channel', '');
$contextId = (string)$get($session, 'context_id', '');
$status = (string)$get($session, 'status', '');
$messageCount = (int)$get($session, 'message_count', 0);
$updatedAt = (string)$get($session, 'updated_at', '');

$roleLabel = static function (string $role) use ($escape): string {
    return match ($role) {
        'user' => $escape(__('用户')),
        'assistant' => $escape(__('智能体')),
        'system' => $escape(__('系统')),
        'tool' => $escape(__('工具')),
        default => $escape($role !== '' ? $role : __('未知')),
    };
};

$roleTone = static function (string $role): string {
    return match ($role) {
        'user' => 'info',
        'assistant' => 'success',
        'system' => 'warning',
        default => '',
    };
};
?>
