$roles = is_array($roles ?? null) ? $roles : [];
$recentSessions = is_array($recent_sessions ?? null) ? $recent_sessions : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$get = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) {
        return $item[$key] ?? $default;
    }
    if (is_object($item)) {
        if (method_exists($item, 'getData')) {
            return $item->getData($key) ?? $default;
        }
        if (isset($item->{$key})) {
            return $item->{$key};
        }
    }
    return $default;
};

$defaultRoleCode = '';
foreach ($roles as $role) {
    if ((int)$get($role, 'is_default', 0) === 1) {
        $defaultRoleCode = (string)$get($role, 'code', '');
        break;
    }
}
if ($defaultRoleCode === '' && !empty($roles)) {
    $defaultRoleCode = (string)$get($roles[0], 'code', '');
}
