 * @var array $models
 * @var array $projects
 * @var bool $is_logged_in
 */
$roles = $roles ?? [];
$models = $models ?? [];
$projects = $projects ?? [];
$isLoggedIn = $is_logged_in ?? false;

$roleItems = [];
foreach ($roles as $r) {
    $roleItems[] = [
        'id' => (int)($r['role_id'] ?? 0),
        'role_id' => (int)($r['role_id'] ?? 0),
        'role_code' => (string)($r['code'] ?? ''),
        'code' => (string)($r['code'] ?? ''),
        'name' => (string)($r['name'] ?? ''),
        'is_default' => (int)($r['is_default'] ?? 0),
    ];
}
$modelItems = [];
foreach ($models as $m) {
    $modelItems[] = [
        'code' => (string)($m['model_code'] ?? ''),
        'name' => (string)($m['model_name'] ?? $m['name'] ?? $m['model_code'] ?? ''),
        'is_default' => (int)($m['is_default'] ?? 0),
    ];
}
$projectItems = [[
    'id' => 0,
    'name' => '个人会话（无项目）',
]];
foreach ($projects as $p) {
    $projectItems[] = [
        'id' => (int)($p['project_id'] ?? 0),
        'name' => (string)($p['name'] ?? ''),
    ];
}

$welineBootHtml = '';
try {
    // 声明式加载引导（boot stub + runtime config + weline.js defer），
    // 使 data-weline-load / Weline.load('api') 在自包含页同样可用。
    $welineBootHtml = (string)\Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Frontend\Block\Header\Base::class
    )->render();
} catch (\Throwable) {
    $welineBootHtml = '';
}

$htmlLang = 'zh-Hans';
