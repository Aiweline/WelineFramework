<?php
/** @var \Weline\Framework\View\Template $this */
use Weline\Framework\Manager\ObjectManager;
use Weline\Mail\Model\MailAccount;
use Weline\Mail\Model\MailDomain;
use Weline\Mail\Model\MailMessage;
use Weline\Mail\Service\MailCustomerAccountService;
use Weline\Mail\Service\StalwartEngineAdapter;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$accountService = ObjectManager::getInstance(MailCustomerAccountService::class);
$customerId = $accountService->resolveFrontendCustomerId($user ?? $this->getData('user'));
$accounts = $accountService->getActiveAccountsForCustomer($customerId);
$managedAccounts = $accountService->getAccountsForCustomer($customerId);
$selectedAccountId = max(0, (int)($this->request->getGet('mail_account', 0) ?? 0));
$selectedAccount = null;
foreach ($accounts as $candidate) {
    if ((int)$candidate->getId() === $selectedAccountId) {
        $selectedAccount = $candidate;
        break;
    }
}
if (!$selectedAccount && $accounts !== []) {
    $selectedAccount = $accounts[0];
    $selectedAccountId = (int)$selectedAccount->getId();
}
$folder = strtolower(trim((string)($this->request->getGet('mail_folder', 'inbox') ?? 'inbox')));
if (!in_array($folder, ['inbox', 'sent'], true)) {
    $folder = 'inbox';
}
$messageId = trim((string)($this->request->getGet('mail_message', '') ?? ''));
$composeTo = trim((string)($this->request->getGet('mail_to', '') ?? ''));
$composeSubject = trim((string)($this->request->getGet('mail_subject', '') ?? ''));
$composeBody = (string)($this->request->getGet('mail_body', '') ?? '');
$composeOpen = $composeTo !== '' || $composeSubject !== '' || $composeBody !== ''
    || (string)($this->request->getGet('mail_compose', '') ?? '') === '1';
$messages = [];
$selectedMessage = null;
$mailError = null;
$selectedMailbox = $selectedAccount
    ? strtolower((string)$selectedAccount->getData(MailAccount::schema_fields_EMAIL))
    : '';
if ($selectedAccount) {
    $domain = ObjectManager::getInstance(MailDomain::class)
        ->clear()
        ->load((int)$selectedAccount->getData(MailAccount::schema_fields_DOMAIN_ID));
    $isFake = $domain->getId() && $accountService->isFakeDomain($domain);
    try {
        if ($isFake) {
            $items = ObjectManager::getInstance(MailMessage::class)->clear()
                ->where(MailMessage::schema_fields_ACCOUNT_ID, $selectedAccountId)
                ->where(MailMessage::schema_fields_FOLDER, $folder)
                ->order(MailMessage::schema_fields_ID, 'DESC')
                ->limit(50)
                ->select()
                ->fetch()
                ->getItems();
            foreach ($items as $item) {
                $body = (string)$item->getData(MailMessage::schema_fields_BODY);
                $normalized = [
                    'id' => (string)$item->getId(),
                    'from' => (string)$item->getData(MailMessage::schema_fields_FROM_EMAIL),
                    'to' => (string)$item->getData(MailMessage::schema_fields_TO_EMAIL),
                    'subject' => (string)$item->getData(MailMessage::schema_fields_SUBJECT),
                    'received_at' => (string)$item->getData(MailMessage::schema_fields_CREATED_AT),
                    'preview' => strlen($body) > 110 ? substr($body, 0, 107) . '...' : $body,
                    'body' => $body,
                    'unread' => !(bool)$item->getData(MailMessage::schema_fields_IS_READ),
                    'has_attachment' => false,
                ];
                $messages[] = $normalized;
                if ($messageId !== '' && $messageId === $normalized['id']) {
                    $selectedMessage = $normalized;
                }
            }
        } else {
            $engine = ObjectManager::getInstance(StalwartEngineAdapter::class);
            $messages = $engine->listMailboxMessages($selectedMailbox, $folder, 50);
            if ($messageId !== '') {
                $selectedMessage = $engine->getMailboxMessage($selectedMailbox, $messageId);
            }
        }
    } catch (\Throwable $throwable) {
        $mailError = $throwable->getMessage();
    }
}
$accountUrl = '/customer/account/index';
$statusLabels = [
    'pending' => __('待同步'),
    'active' => __('已启用'),
    'suspended' => __('已暂停'),
];
$replyUrl = '';
if (is_array($selectedMessage)) {
    $replyTarget = $folder === 'sent'
        ? (string)($selectedMessage['to'] ?? '')
        : (string)($selectedMessage['from'] ?? '');
    $replySubject = trim((string)($selectedMessage['subject'] ?? ''));
    if ($replySubject !== '' && !preg_match('/^re:\s*/i', $replySubject)) {
        $replySubject = 'Re: ' . $replySubject;
    }
    $quotedBody = "\n\n---\n"
        . __('发件人') . ': ' . (string)($selectedMessage['from'] ?? '') . "\n"
        . __('收件人') . ': ' . (string)($selectedMessage['to'] ?? '') . "\n"
        . __('主题') . ': ' . (string)($selectedMessage['subject'] ?? '') . "\n\n"
        . (string)($selectedMessage['body'] ?? '');
    $replyUrl = $accountUrl . '?' . http_build_query([
        'mail_account' => $selectedAccountId,
        'mail_folder' => $folder,
        'mail_message' => (string)($selectedMessage['id'] ?? ''),
        'mail_compose' => 1,
        'mail_to' => $replyTarget,
        'mail_subject' => $replySubject,
        'mail_body' => $quotedBody,
    ]) . '#mail';
}

?>
