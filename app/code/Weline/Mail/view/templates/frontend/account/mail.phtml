$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
/** @var MailCustomerAccountService $mailService */
$mailService = ObjectManager::getInstance(MailCustomerAccountService::class);
$customerId = $mailService->resolveFrontendCustomerId($user ?? $this->getData('user'));
$activeAccounts = $mailService->getActiveAccountsForCustomer($customerId);
if ($activeAccounts === []) {
    return;
}

$selectedMailbox = strtolower(trim((string)($this->request->getGet('mail_account', '') ?? ($_GET['mail_account'] ?? ''))));
$allowedMailbox = false;
foreach ($activeAccounts as $activeAccount) {
    if (strtolower((string)$activeAccount->getData('email')) === $selectedMailbox) {
        $allowedMailbox = true;
        break;
    }
}
if (!$allowedMailbox) {
    $selectedMailbox = strtolower((string)$activeAccounts[0]->getData('email'));
}

$inboxMessages = [];
$selectedMessage = null;
$inboxError = null;
/** @var StalwartEngineAdapter $mailEngine */
$mailEngine = ObjectManager::getInstance(StalwartEngineAdapter::class);
try {
    $inboxMessages = $mailEngine->listInboxMessages($selectedMailbox, 50);
    $messageId = trim((string)($this->request->getGet('mail_message', '') ?? ($_GET['mail_message'] ?? '')));
    if ($messageId !== '') {
        $selectedMessage = $mailEngine->getInboxMessage($selectedMailbox, $messageId);
    }
} catch (\Throwable $throwable) {
    $inboxError = $throwable->getMessage();
}

$accountPath = parse_url($this->getFrontendUrl('customer/account/index'), PHP_URL_PATH);
if (!is_string($accountPath) || $accountPath === '') {
    $accountPath = '/customer/account/index';
}
$accountPath = rtrim($accountPath, '/');
