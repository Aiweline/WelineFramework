            <script>
            (function () {
                var form = document.getElementById('mail-smtp-add-form');
                var dialog = document.getElementById('mail-smtp-add-dialog');
                if (!form || !dialog) return;
                var statusEl = form.querySelector('[data-smtp-add-status]');
                var unavailableMsg = <?= json_encode((string)__('Mail API 不可用'), JSON_UNESCAPED_UNICODE) ?>;
                var relayOpt = form.querySelector('[data-smtp-relay-option]');
                function toast(kind, message) {
                    var ui = window.Weline && window.Weline.UI;
                    var api = ui && ui.toast;
                    var text = String(message || '').trim();
                    if (!text) return;
                    if (api && typeof api[kind] === 'function') { api[kind](text); return; }
                    if (api && typeof api.show === 'function') {
                        api.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
                    }
                }
                function setStatus(tone, text) {
                    if (!statusEl) return;
                    statusEl.setAttribute('data-tone', tone || 'muted');
                    statusEl.textContent = text || '';
                }
                function openDialog() {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.open === 'function') { ui.open(dialog); return; }
                    dialog.hidden = false; dialog.setAttribute('data-state', 'open'); dialog.setAttribute('aria-hidden', 'false');
                }
                function closeDialog() {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.close === 'function') { ui.close(dialog); return; }
                    dialog.hidden = true; dialog.setAttribute('data-state', 'closed'); dialog.setAttribute('aria-hidden', 'true');
                }
                function mailApi() {
                    if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
                        return Promise.reject(new Error(unavailableMsg));
                    }
                    if (typeof window.Weline.load === 'function') {
                        return window.Weline.load('api').then(function () { return window.Weline.Api.resource('mail'); });
                    }
                    return Promise.resolve(window.Weline.Api.resource('mail'));
                }
                document.querySelectorAll('[data-smtp-add-open]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var sid = btn.getAttribute('data-smtp-service-id') || '0';
                        var relay = btn.getAttribute('data-smtp-relay') === '1';
                        var sidField = form.querySelector('[data-smtp-add-field="smtp_service_id"]');
                        var lp = form.querySelector('[data-smtp-add-field="local_part"]');
                        var role = form.querySelector('[data-smtp-add-field="account_role"]');
                        if (sidField) sidField.value = sid;
                        if (lp) lp.value = '';
                        if (role) role.value = 'submit';
                        if (relayOpt) {
                            relayOpt.hidden = !relay;
                            if (!relay && role && role.value === 'relay') {
                                role.value = 'submit';
                            }
                        }
                        setStatus('muted', '');
                        openDialog();
                    });
                });
                form.addEventListener('submit', function (ev) {
                    ev.preventDefault();
                    var payload = {
                        smtp_service_id: parseInt((form.querySelector('[data-smtp-add-field="smtp_service_id"]') || {}).value || '0', 10) || 0,
                        local_part: String((form.querySelector('[data-smtp-add-field="local_part"]') || {}).value || '').trim(),
                        account_role: String((form.querySelector('[data-smtp-add-field="account_role"]') || {}).value || 'submit')
                    };
                    setStatus('muted', <?= json_encode((string)__('创建中…'), JSON_UNESCAPED_UNICODE) ?>);
                    mailApi().then(function (api) { return api.createSmtpServiceAccount(payload); })
                        .then(function (res) {
                            var ok = !!(res && res.success);
                            var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
                            setStatus(ok ? 'success' : 'danger', msg);
                            toast(ok ? 'success' : 'error', msg);
                            if (ok) { closeDialog(); window.location.reload(); }
                        }).catch(function (err) {
                            var msg = (err && err.message) ? String(err.message) : unavailableMsg;
                            setStatus('danger', msg); toast('error', msg);
                        });
                });
            })();
            </script>


