            </article>
            <script>
            (function () {
                var workspace = document.querySelector('[data-testid="mail-enterprise-workspace"]');
                var reader = document.getElementById('mail-enterprise-reader');
                if (!workspace || !reader) return;
                var accountId = workspace.getAttribute('data-mail-account-id') || '';
                var folder = workspace.getAttribute('data-mail-folder') || 'inbox';
                var endpoint = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend/index/mailbox-message'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var batchEndpoint = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend/index/mailbox-batch'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var searchEndpoint = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend/index/mailbox-search'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var prefillEndpoint = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend/index/mailbox-compose-prefill'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var attachEndpoint = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend/index/mailbox-attachment'), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var composeUrl = <?= json_encode((string)$this->getBackendUrl('weline_mail/backend', ['view' => 'mailbox', 'account' => $selectedAccountId, 'folder' => $folder, 'compose' => '1']), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
                var loadingText = <?= json_encode((string)__('加载中…'), JSON_UNESCAPED_UNICODE) ?>;
                var failText = <?= json_encode((string)__('正文加载失败'), JSON_UNESCAPED_UNICODE) ?>;
                var fromLabel = <?= json_encode((string)__('发件人'), JSON_UNESCAPED_UNICODE) ?>;
                var toLabel = <?= json_encode((string)__('收件人'), JSON_UNESCAPED_UNICODE) ?>;
                var replyLabel = <?= json_encode((string)__('回复'), JSON_UNESCAPED_UNICODE) ?>;
                var replyAllLabel = <?= json_encode((string)__('回复全部'), JSON_UNESCAPED_UNICODE) ?>;
                var forwardLabel = <?= json_encode((string)__('转发'), JSON_UNESCAPED_UNICODE) ?>;
                var deleteLabel = <?= json_encode((string)__('删除'), JSON_UNESCAPED_UNICODE) ?>;
                var restoreLabel = <?= json_encode((string)__('恢复'), JSON_UNESCAPED_UNICODE) ?>;
                var destroyLabel = <?= json_encode((string)__('永久删除'), JSON_UNESCAPED_UNICODE) ?>;
                var unseenLabel = <?= json_encode((string)__('标未读'), JSON_UNESCAPED_UNICODE) ?>;
                var attachLabel = <?= json_encode((string)__('附件'), JSON_UNESCAPED_UNICODE) ?>;
                var bodyPreviewTitle = <?= json_encode((string)__('邮件正文预览'), JSON_UNESCAPED_UNICODE) ?>;
                var currentMessageId = <?= json_encode(is_array($selectedMessage) ? (string)($selectedMessage['id'] ?? '') : '', JSON_UNESCAPED_UNICODE) ?>;
                var activeAbort = null;
                var loadSeq = 0;
                function esc(s) {
                    return String(s == null ? '' : s)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }
                function renderReaderBody(data) {
                    var htmlBody = String(data && data.html_body != null ? data.html_body : '');
                    var isHtml = !!(data && data.body_is_html) && htmlBody !== '';
                    if (isHtml) {
                        return '<div class="mail-enterprise__reader-body mail-enterprise__reader-body--html" data-mail-reader-body data-mail-body-format="html">' +
                            '<iframe class="mail-enterprise__reader-html" title="' + esc(bodyPreviewTitle) + '" sandbox="" referrerpolicy="no-referrer" srcdoc="' + esc(htmlBody) + '" data-testid="mail-enterprise-reader-html"></iframe>' +
                            '</div>';
                    }
                    return '<div class="mail-enterprise__reader-body" data-mail-reader-body data-mail-body-format="text">' + esc(data && data.body ? data.body : '') + '</div>';
                }
                function toast(msg, tone) {
                    if (window.Weline && window.Weline.UI && window.Weline.UI.toast) {
                        window.Weline.UI.toast(msg, { tone: tone || 'neutral' });
                        return;
                    }
                    alert(msg);
                }
                function nativeFetch(url, opts) {
                    opts = opts || {};
                    opts.credentials = 'same-origin';
                    opts.headers = Object.assign({
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }, opts.headers || {});
                    opts.__welineNativeFetch = true;
                    return fetch(url, opts);
                }
                function selectedIds() {
                    return Array.prototype.slice.call(workspace.querySelectorAll('[data-mail-check]:checked'))
                        .map(function (el) { return el.value; })
                        .filter(Boolean);
                }
                function renderAttachments(list) {
                    if (!list || !list.length) return '';
                    var html = '<div class="w-stack" style="--w-gap:var(--weline-space-1);--w-mt:var(--weline-space-3);" data-mail-reader-attachments><p class="w-text" data-size="sm">' + esc(attachLabel) + '</p>';
                    list.forEach(function (att) {
                        var href = attachEndpoint + (attachEndpoint.indexOf('?') >= 0 ? '&' : '?') +
                            'account=' + encodeURIComponent(accountId) +
                            '&blob=' + encodeURIComponent(att.blob_id || '') +
                            '&name=' + encodeURIComponent(att.name || 'attachment');
                        html += '<a class="w-text" data-size="sm" href="' + esc(href) + '">' + esc(att.name || 'attachment') +
                            (att.size ? ' (' + Math.round(att.size / 1024) + ' KB)' : '') + '</a>';
                    });
                    return html + '</div>';
                }
                function readerActionsHtml() {
                    var btns = '';
                    btns += '<button type="button" class="w-button" data-size="sm" data-mail-reply="reply">' + esc(replyLabel) + '</button>';
                    btns += '<button type="button" class="w-button" data-variant="outline" data-size="sm" data-mail-reply="reply_all">' + esc(replyAllLabel) + '</button>';
                    btns += '<button type="button" class="w-button" data-variant="outline" data-size="sm" data-mail-reply="forward">' + esc(forwardLabel) + '</button>';
                    if (folder === 'trash') {
                        btns += '<button type="button" class="w-button" data-variant="outline" data-size="sm" data-mail-one="restore">' + esc(restoreLabel) + '</button>';
                        btns += '<button type="button" class="w-button" data-tone="danger" data-size="sm" data-mail-one="destroy">' + esc(destroyLabel) + '</button>';
                    } else {
                        btns += '<button type="button" class="w-button" data-tone="danger" data-size="sm" data-mail-one="delete">' + esc(deleteLabel) + '</button>';
                        btns += '<button type="button" class="w-button" data-variant="outline" data-size="sm" data-mail-one="unseen">' + esc(unseenLabel) + '</button>';
                    }
                    return '<div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);--w-mt:var(--weline-space-2);" data-mail-reader-actions data-testid="mail-enterprise-reader-actions">' + btns + '</div>';
                }
                function renderMessage(data) {
                    currentMessageId = data.id || '';
                    reader.innerHTML =
                        '<header class="w-card__header">' +
                        '<h2 class="w-card__title" data-mail-reader-subject>' + esc(data.subject || '') + '</h2>' +
                        '<div class="mail-enterprise__meta" style="--w-mt:var(--weline-space-2);">' +
                        '<span data-mail-reader-from>' + esc(fromLabel) + '：' + esc(data.from || '') + '</span>' +
                        '<span data-mail-reader-to>' + esc(toLabel) + '：' + esc(data.to || '') + '</span>' +
                        '</div>' + readerActionsHtml() + '</header>' +
                        renderReaderBody(data) +
                        renderAttachments(data.attachments || []);
                    bindReaderActions();
                }
                function runBatch(action, ids) {
                    if (!ids || !ids.length) {
                        toast(<?= json_encode((string)__('请先选择邮件'), JSON_UNESCAPED_UNICODE) ?>, 'warning');
                        return;
                    }
                    var body = new URLSearchParams();
                    body.set('account', accountId);
                    body.set('action', action);
                    body.set('folder', folder);
                    ids.forEach(function (id) { body.append('ids[]', id); });
                    nativeFetch(batchEndpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    }).then(function (r) { return r.json(); })
                      .then(function (json) {
                          if (!json || json.code !== 200) throw new Error((json && json.msg) || failText);
                          toast(json.msg || 'ok', 'success');
                          ids.forEach(function (id) {
                              var row = workspace.querySelector('[data-mail-row][data-message-id="' + id + '"]');
                              if (row && (action === 'delete' || action === 'destroy' || action === 'restore')) row.remove();
                          });
                          if (currentMessageId && ids.indexOf(currentMessageId) >= 0) {
                              reader.innerHTML = '<div class="w-empty"><p class="w-text" data-tone="muted" style="--w-m:0;">' + esc(<?= json_encode((string)__('选择一封邮件查看正文。'), JSON_UNESCAPED_UNICODE) ?>) + '</p></div>';
                              currentMessageId = '';
                          }
                      })
                      .catch(function (err) { toast(err.message || failText, 'danger'); });
                }
                function bindReaderActions() {
                    reader.querySelectorAll('[data-mail-one]').forEach(function (btn) {
                        btn.onclick = function () {
                            if (!currentMessageId) return;
                            runBatch(btn.getAttribute('data-mail-one'), [currentMessageId]);
                        };
                    });
                    reader.querySelectorAll('[data-mail-reply]').forEach(function (btn) {
                        btn.onclick = function () {
                            if (!currentMessageId) return;
                            var mode = btn.getAttribute('data-mail-reply') || 'reply';
                            var url = prefillEndpoint + (prefillEndpoint.indexOf('?') >= 0 ? '&' : '?') +
                                'account=' + encodeURIComponent(accountId) +
                                '&message=' + encodeURIComponent(currentMessageId) +
                                '&mode=' + encodeURIComponent(mode) + '&isAjax=1';
                            nativeFetch(url).then(function (r) { return r.json(); })
                                .then(function (json) {
                                    if (!json || json.code !== 200 || !json.data) throw new Error((json && json.msg) || failText);
                                    var d = json.data;
                                    var next = composeUrl +
                                        (composeUrl.indexOf('?') >= 0 ? '&' : '?') +
                                        'compose_to=' + encodeURIComponent(d.to || '') +
                                        '&compose_subject=' + encodeURIComponent(d.subject || '') +
                                        '&compose_body=' + encodeURIComponent(d.body || '') +
                                        '#mail-compose';
                                    window.location.href = next;
                                })
                                .catch(function (err) { toast(err.message || failText, 'danger'); });
                        };
                    });
                }
                document.querySelectorAll('[data-mail-async-row]').forEach(function (row) {
                    row.addEventListener('click', function (ev) {
                        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
                        ev.preventDefault();
                        var messageId = row.getAttribute('data-message-id') || '';
                        if (!messageId || !accountId) return;
                        document.querySelectorAll('[data-mail-row].is-active').forEach(function (el) {
                            el.classList.remove('is-active');
                        });
                        var wrap = row.closest('[data-mail-row]');
                        if (wrap) wrap.classList.add('is-active');
                        reader.innerHTML = '<div class="w-empty"><p class="w-text" data-tone="muted" style="--w-m:0;">' + esc(loadingText) + '</p></div>';
                        var url = endpoint +
                            (endpoint.indexOf('?') >= 0 ? '&' : '?') +
                            'account=' + encodeURIComponent(accountId) +
                            '&folder=' + encodeURIComponent(folder) +
                            '&message=' + encodeURIComponent(messageId) +
                            '&isAjax=1';
                        if (activeAbort) { try { activeAbort.abort(); } catch (e) {} }
                        var ac = (typeof AbortController !== 'undefined') ? new AbortController() : null;
                        activeAbort = ac;
                        var seq = ++loadSeq;
                        var fetchOpts = { signal: ac ? ac.signal : undefined };
                        nativeFetch(url, fetchOpts)
                            .then(function (r) { return r.json(); })
                            .then(function (json) {
                                if (seq !== loadSeq) return;
                                if (!json || json.code !== 200 || !json.data) throw new Error((json && json.msg) || failText);
                                renderMessage(json.data);
                                try {
                                    var next = row.getAttribute('href');
                                    if (next && window.history && window.history.replaceState) window.history.replaceState({}, '', next);
                                } catch (e) {}
                            })
                            .catch(function (err) {
                                if (seq !== loadSeq) return;
                                if (err && (err.name === 'AbortError' || err.code === 20)) return;
                                reader.innerHTML = '<div class="w-empty"><p class="w-text" data-tone="danger" style="--w-m:0;">' +
                                    esc(err && err.message ? err.message : failText) + '</p></div>';
                            });
                    });
                });
                var selectAll = workspace.querySelector('[data-mail-select-all]');
                if (selectAll) {
                    selectAll.addEventListener('change', function () {
                        workspace.querySelectorAll('[data-mail-check]').forEach(function (el) {
                            el.checked = selectAll.checked;
                        });
                    });
                }
                workspace.querySelectorAll('[data-mail-batch]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        runBatch(btn.getAttribute('data-mail-batch'), selectedIds());
                    });
                });
                var refreshBtn = workspace.querySelector('[data-mail-refresh]');
                if (refreshBtn) {
                    refreshBtn.addEventListener('click', function () { window.location.reload(); });
                }
                var searchInput = workspace.querySelector('[data-mail-search]');
                var searchTimer = null;
                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        clearTimeout(searchTimer);
                        searchTimer = setTimeout(function () {
                            var q = searchInput.value.trim();
                            var url = searchEndpoint + (searchEndpoint.indexOf('?') >= 0 ? '&' : '?') +
                                'account=' + encodeURIComponent(accountId) +
                                '&folder=' + encodeURIComponent(folder) +
                                '&q=' + encodeURIComponent(q) + '&isAjax=1';
                            nativeFetch(url).then(function (r) { return r.json(); })
                                .then(function (json) {
                                    if (!json || json.code !== 200) return;
                                    var ids = {};
                                    (json.data || []).forEach(function (m) { ids[String(m.id)] = true; });
                                    workspace.querySelectorAll('[data-mail-row]').forEach(function (row) {
                                        var id = row.getAttribute('data-message-id') || '';
                                        row.style.display = (!q || ids[id]) ? '' : 'none';
                                    });
                                });
                        }, 250);
                    });
                }
                bindReaderActions();
            })();
            </script>
