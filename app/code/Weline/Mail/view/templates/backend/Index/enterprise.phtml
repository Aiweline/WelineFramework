                var addBtn = root.querySelector('[data-route-add]');
                if (addBtn) addBtn.addEventListener('click', openCreate);

                form.addEventListener('submit', function (ev) {
                    ev.preventDefault();
                    var payload = {
                        rule_id: parseInt((field('rule_id') || {}).value || '0', 10) || 0,
                        match_domain: String((field('match_domain') || {}).value || '').trim(),
                        priority: parseInt((field('priority') || {}).value || '100', 10) || 100,
                        enabled: (field('enabled') && field('enabled').checked) ? 1 : 0,
