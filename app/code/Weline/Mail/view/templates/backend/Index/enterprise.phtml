                        relay_host: String((field('relay_host') || {}).value || '').trim(),
                        relay_port: parseInt((field('relay_port') || {}).value || '587', 10) || 587,
                        relay_username: String((field('relay_username') || {}).value || '').trim(),
                        relay_password: String((field('relay_password') || {}).value || ''),
                        relay_tls: String((field('relay_tls') || {}).value || 'starttls')
                    };
                    setStatus('muted', <?= json_encode((string)__('保存中…'), JSON_UNESCAPED_UNICODE) ?>);
                    mailApi().then(function (api) {
                        return api.saveOutboundRouteRule(payload);
                    }).then(function (res) {
                        var ok = !!(res && res.success);
                        var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
                        setStatus(ok ? 'success' : 'danger', msg);
                        toast(ok ? 'success' : 'error', msg);
                        if (ok) {
                            closeDialog();
                            window.location.reload();
                        }
                    }).catch(function (err) {
                        var msg = (err && err.message) ? String(err.message) : unavailableMsg;
                        setStatus('danger', msg);
                        toast('error', msg);
                    });
                });

                root.querySelectorAll('[data-route-edit]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        openEdit(btn.closest('[data-route-row]'));
