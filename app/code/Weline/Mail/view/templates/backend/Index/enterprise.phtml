                function toast(kind, message) {
                    var ui = window.Weline && window.Weline.UI;
                    var api = ui && ui.toast;
                    var text = String(message || '').trim();
                    if (!text) return;
                    if (api && typeof api[kind] === 'function') { api[kind](text); return; }
                    if (api && typeof api.show === 'function') {
                        api.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
                    }
                }
                function setStatus(tone, text) {
                    if (!statusEl) return;
                    statusEl.setAttribute('data-tone', tone || 'muted');
                    statusEl.textContent = text || '';
                }
                function openDialog() {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.open === 'function') {
                        ui.open(dialog);
                        return;
                    }
                    dialog.hidden = false;
                    dialog.setAttribute('data-state', 'open');
                    dialog.setAttribute('aria-hidden', 'false');
                }
                function closeDialog() {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.close === 'function') {
                        ui.close(dialog);
                        return;
                    }
                    dialog.hidden = true;
                    dialog.setAttribute('data-state', 'closed');
                    dialog.setAttribute('aria-hidden', 'true');
                }
                function confirmUi(message) {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.confirm === 'function') {
                        return Promise.resolve(ui.confirm(message)).then(function (ok) { return !!ok; });
                    }
                    return Promise.resolve(false);
                }
                function mailApi() {
                    if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
                        return Promise.reject(new Error(unavailableMsg));
                    }
                    if (typeof window.Weline.load === 'function') {
                        return window.Weline.load('api').then(function () {
                            return window.Weline.Api.resource('mail');
                        });
                    }
                    return Promise.resolve(window.Weline.Api.resource('mail'));
                }
                function field(name) {
                    return form.querySelector('[data-route-field="' + name + '"]');
                }
                function resetForm() {
                    var id = field('rule_id'); if (id) id.value = '';
                    var md = field('match_domain'); if (md) md.value = '';
                    var pr = field('priority'); if (pr) pr.value = '100';
                    var en = field('enabled'); if (en) en.checked = true;
                    var pk = field('outbound_smtp_pick'); if (pk) pk.value = '';
                    var rh = field('relay_host'); if (rh) rh.value = '';
                    var rp = field('relay_port'); if (rp) rp.value = '587';
                    var ru = field('relay_username'); if (ru) ru.value = '';
                    var rw = field('relay_password'); if (rw) rw.value = '';
                    var rt = field('relay_tls'); if (rt) rt.value = 'starttls';
                    if (titleEl) titleEl.textContent = titleCreate;
                    setStatus('muted', '');
                }
                function openCreate() {
                    resetForm();
                    openDialog();
                }
                function openEdit(row) {
                    if (!row) return;
                    var id = field('rule_id'); if (id) id.value = row.getAttribute('data-rule-id') || '';
                    var md = field('match_domain'); if (md) md.value = row.getAttribute('data-match-domain') || '';
                    var pr = field('priority'); if (pr) pr.value = row.getAttribute('data-priority') || '100';
                    var en = field('enabled'); if (en) en.checked = row.getAttribute('data-enabled') === '1';
                    var pk = field('outbound_smtp_pick'); if (pk) pk.value = '';
                    var rh = field('relay_host'); if (rh) rh.value = row.getAttribute('data-relay-host') || '';
                    var rp = field('relay_port'); if (rp) rp.value = row.getAttribute('data-relay-port') || '587';
