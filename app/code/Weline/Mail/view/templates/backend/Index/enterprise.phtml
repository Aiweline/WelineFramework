                        <script>
                        (function () {
                            var form = document.getElementById('mail-enterprise-compose-form');
                            if (!(form instanceof HTMLFormElement) || form.dataset.mailComposeBound === '1') return;
                            form.dataset.mailComposeBound = '1';

                            var loadingMsg = form.getAttribute('data-mail-compose-loading') || '';
                            var successFallback = form.getAttribute('data-mail-compose-success') || '';
                            var failFallback = form.getAttribute('data-mail-compose-fail') || '';
                            var unavailableMsg = form.getAttribute('data-mail-compose-unavailable') || '';
                            var sentUrl = form.getAttribute('data-mail-compose-sent-url') || '';
                            var sending = false;

                            function unwrapBusiness(value) {
                                var current = value;
                                for (var depth = 0; depth < 4; depth += 1) {
                                    if (!current || typeof current !== 'object') break;
                                    if (Object.prototype.hasOwnProperty.call(current, 'success')
                                        || Object.prototype.hasOwnProperty.call(current, 'message')
                                        || Object.prototype.hasOwnProperty.call(current, 'msg')) {
                                        break;
                                    }
                                    if (current.data && typeof current.data === 'object') {
                                        current = current.data;
                                        continue;
                                    }
                                    break;
                                }
                                return current || {};
                            }

                            function toast(kind, message) {
                                var ui = window.Weline && window.Weline.UI;
                                var api = ui && ui.toast;
                                var text = String(message || '').trim();
                                if (!text) return;
                                if (api && typeof api[kind] === 'function') {
                                    api[kind](text);
                                    return;
                                }
                                if (api && typeof api.show === 'function') {
                                    api.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
                                }
                            }

                            function mailApi() {
                                if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
                                    return Promise.reject(new Error(unavailableMsg || 'unavailable'));
                                }
                                if (typeof window.Weline.load === 'function') {
                                    return window.Weline.load('api').then(function () {
                                        return window.Weline.Api.resource('mail');
                                    });
                                }
                                return Promise.resolve(window.Weline.Api.resource('mail'));
                            }

                            function readField(name) {
                                var el = form.elements.namedItem(name);
                                if (!el) return '';
                                if (el instanceof RadioNodeList) {
                                    return String(el.value || '');
                                }
                                return String(el.value || '');
                            }

                            function resolveComposeAccountId() {
                                var fromForm = parseInt(readField('account_id'), 10) || 0;
                                if (fromForm > 0) {
                                    return fromForm;
                                }
                                var field = form.querySelector('[data-w-mail-account-field][name="account_id"]');
                                if (field instanceof HTMLInputElement) {
                                    var fromField = parseInt(field.value, 10) || 0;
                                    if (fromField > 0) {
                                        return fromField;
                                    }
                                }
                                var workspace = document.querySelector('[data-testid="mail-enterprise-workspace"]');
                                var fromWorkspace = parseInt(
                                    (workspace && workspace.getAttribute('data-mail-account-id')) || '0',
                                    10
                                ) || 0;
                                if (fromWorkspace > 0) {
                                    return fromWorkspace;
                                }
                                try {
                                    return parseInt(new URLSearchParams(window.location.search).get('account') || '0', 10) || 0;
                                } catch (e) {
                                    return 0;
                                }
                            }

                            form.addEventListener('submit', function (event) {
                                if (sending) {
                                    event.preventDefault();
                                    return;
                                }
                                if (typeof form.reportValidity === 'function' && !form.reportValidity()) {
                                    return;
                                }
                                event.preventDefault();
                                sending = true;
                                var submitBtn = form.querySelector('[data-testid="mail-enterprise-compose-send"]');
                                if (submitBtn instanceof HTMLButtonElement) {
                                    submitBtn.disabled = true;
                                }

                                var accountId = resolveComposeAccountId();
                                var payload = {
                                    account_id: accountId,
                                    to: String(readField('to_email') || '').trim(),
                                    subject: String(readField('subject') || '').trim(),
                                    body: String(readField('body') || ''),
                                    source: String(readField('source') || '').trim(),
                                    source_id: parseInt(readField('source_id'), 10) || 0
                                };

                                if (accountId <= 0) {
                                    toast('error', <?= json_encode((string)__('请选择发件账号'), JSON_UNESCAPED_UNICODE) ?>);
                                    sending = false;
                                    if (submitBtn instanceof HTMLButtonElement) {
                                        submitBtn.disabled = false;
                                    }
                                    return;
                                }

                                var run = function () {
                                    return mailApi().then(function (resource) {
                                        if (!resource || typeof resource.sendComposerMessage !== 'function') {
                                            throw new Error(unavailableMsg || 'unavailable');
                                        }
                                        return resource.sendComposerMessage(payload, {
                                            keepBusinessResult: true,
                                            silent: true
                                        });
                                    }).then(function (raw) {
                                        var result = unwrapBusiness(raw);
                                        var ok = result.success === true
                                            || result.success === 1
                                            || result.success === '1'
                                            || result.code === 200
                                            || result.code === '200';
                                        var message = String(result.message || result.msg || (ok ? successFallback : failFallback) || '').trim();
                                        if (ok) {
                                            toast('success', message || successFallback);
                                            if (sentUrl) {
                                                window.setTimeout(function () {
                                                    window.location.assign(sentUrl);
                                                }, 450);
                                            }
                                            return;
                                        }
                                        toast('error', message || failFallback);
                                    });
                                };

                                var loading = window.Weline && window.Weline.UI && window.Weline.UI.loading;
                                var task = (loading && typeof loading.with === 'function')
                                    ? loading.with(run, { message: loadingMsg })
                                    : run();

                                Promise.resolve(task).catch(function (error) {
                                    toast('error', (error && error.message) ? error.message : failFallback);
                                }).finally(function () {
                                    sending = false;
                                    if (submitBtn instanceof HTMLButtonElement) {
                                        submitBtn.disabled = false;
                                    }
                                });
                            });
                        })();
                        </script>
                    <?php endif; ?>
                </div>
            </section>
        <?php endif; ?>

