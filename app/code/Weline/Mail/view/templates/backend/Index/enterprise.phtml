$composeCanPickAccount = (bool)($compose_can_pick_account ?? false);
$composeCustomerSelectValue = (string)($compose_customer_select_value ?? '');
$composeCustomerSelectDisplay = (string)($compose_customer_select_display ?? '');
$mailComposeCustomerPlaceholder = (string)__('搜索客户姓名或邮箱');
$mailComposeCustomerEmptyLabel = (string)__('选择客户');
$navItems = [
    'mailbox' => __('邮箱'),
    'accounts' => __('用户与账号'),
    'domains' => __('域名与 DNS'),
];
$dnsLiveChecks = $dns_live_checks ?? [];
$detectedOriginIp = trim((string)($detected_origin_ip ?? ''));
$cloudflareTokenReady = (bool)($cloudflare_token_ready ?? false);
$oauthError = trim((string)$this->request->getGet('oauth_error', '')) === '1';
$oauthCfError = strtolower(trim((string)$this->request->getGet('oauth_cf_error', '')));
$oauthCfDesc = trim((string)$this->request->getGet('oauth_cf_desc', ''));
$oauthErrorTitle = (string)__('Cloudflare OAuth 未能完成');
$oauthErrorBody = (string)__('授权回跳失败。请核对 OAuth Client 权限与回调 URL 后重试。');
if ($oauthCfError === 'invalid_scope') {
    $oauthErrorTitle = (string)__('Cloudflare 拒绝了本次授权（scope 不匹配）');
    $oauthErrorBody = (string)__('权限要在 Cloudflare 控制台勾，不在本页填写。打开 OAuth clients → 编辑该 Client →「选择权限范围」，勾选 Zone Read、DNS Write、Cache Purge、Cache Settings Write 并保存，再点「连接或重新授权 Cloudflare」。');
} elseif ($oauthCfError === 'access_denied') {
    $oauthErrorTitle = (string)__('Cloudflare 授权已取消');
    $oauthErrorBody = (string)__('你在授权页拒绝了授权。若要继续，请再点「连接或重新授权 Cloudflare」。');
} elseif (in_array($oauthCfError, ['invalid_request', 'redirect_uri_mismatch'], true)
    || str_contains(strtolower($oauthCfDesc), 'redirect_uri')
) {
    $oauthErrorTitle = (string)__('Cloudflare 拒绝了本次授权（回调 URL 不匹配）');
    $oauthErrorBody = (string)__('请到 CDN → 账户 查看黄框回调 URL，原样粘进 Cloudflare OAuth Client 的 Redirect URLs 后再连。');
} elseif ($oauthCfError === 'invalid_client') {
    $oauthErrorTitle = (string)__('Cloudflare 拒绝了本次授权（invalid_client）');
    $oauthErrorBody = (string)__('Client ID / Secret 无效或填错。请到系统配置 → Cloudflare OAuth 核对。');
} elseif ($oauthCfDesc !== '') {
    $oauthErrorBody = $oauthCfDesc;
}
