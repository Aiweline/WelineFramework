                                                data-username="<?= $escape((string)($pick['username'] ?? '')) ?>"
                                                data-tls="<?= $escape((string)($pick['tls'] ?? 'starttls')) ?>"
                                            ><?= $escape((string)($pick['label'] ?? $pkey)) ?></option>
                                        <?php endforeach; ?>
