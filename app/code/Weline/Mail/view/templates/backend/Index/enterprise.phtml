            <script>
            (function () {
                var copiedLabel = <?= json_encode((string)__('已复制'), JSON_UNESCAPED_UNICODE) ?>;
                var copyFailLabel = <?= json_encode((string)__('复制失败'), JSON_UNESCAPED_UNICODE) ?>;
                function copySmtpText(text, btn) {
                    if (!text) return;
                    var done = function (ok) {
                        if (!btn) return;
                        var prev = btn.getAttribute('data-label-prev') || btn.textContent;
                        if (!btn.getAttribute('data-label-prev')) {
                            btn.setAttribute('data-label-prev', prev);
                        }
                        btn.textContent = ok ? copiedLabel : copyFailLabel;
                        setTimeout(function () {
                            btn.textContent = btn.getAttribute('data-label-prev') || prev;
                        }, 1200);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).then(function () { done(true); }).catch(function () { done(false); });
                        return;
                    }
                    try {
                        var ta = document.createElement('textarea');
                        ta.value = text;
                        ta.setAttribute('readonly', '');
                        ta.style.position = 'fixed';
                        ta.style.left = '-9999px';
                        document.body.appendChild(ta);
                        ta.select();
                        done(document.execCommand('copy'));
                        document.body.removeChild(ta);
                    } catch (e) {
                        done(false);
                    }
                }
                document.querySelectorAll('[data-mail-smtp-copy]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        copySmtpText(btn.getAttribute('data-mail-smtp-copy') || '', btn);
                    });
                });
                var toggle = document.getElementById('mail-smtp-new-toggle');
                var panel = document.getElementById('mail-smtp-create-panel');
                if (toggle && panel) {
                    toggle.addEventListener('click', function () {
                        var open = panel.hasAttribute('hidden');
                        if (open) {
                            panel.removeAttribute('hidden');
                            toggle.setAttribute('aria-expanded', 'true');
                            toggle.textContent = <?= json_encode((string)__('收起新建'), JSON_UNESCAPED_UNICODE) ?>;
                        } else {
                            panel.setAttribute('hidden', '');
                            toggle.setAttribute('aria-expanded', 'false');
                            toggle.textContent = <?= json_encode((string)__('新建'), JSON_UNESCAPED_UNICODE) ?>;
                        }
                    });
                }
                var mode = document.getElementById('mail-smtp-domain-mode');
                var typed = document.getElementById('mail-smtp-typed-field');
                var pool = document.getElementById('mail-smtp-pool-field');
                if (mode && typed && pool) {
                    function syncDomain() {
                        var usePool = mode.value === 'pool';
                        typed.hidden = usePool;
                        pool.hidden = !usePool;
                    }
                    mode.addEventListener('change', syncDomain);
                    syncDomain();
                }
                document.querySelectorAll('[data-smtp-card-actions]').forEach(function (actions) {
                    actions.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                    });
                });
                var search = document.getElementById('mail-smtp-service-search');
                var cards = document.querySelectorAll('[data-smtp-search]');
                var empty = document.getElementById('mail-smtp-search-empty');
                if (search && cards.length) {
                    search.addEventListener('input', function () {
                        var q = (search.value || '').toLowerCase().trim();
                        var shown = 0;
                        cards.forEach(function (card) {
                            var blob = card.getAttribute('data-smtp-search') || '';
                            var ok = q === '' || blob.indexOf(q) !== -1;
                            card.hidden = !ok;
                            if (ok) shown++;
                        });
                        if (empty) empty.hidden = shown > 0;
                    });
                }
                var savingLabel = <?= json_encode((string)__('保存中…'), JSON_UNESCAPED_UNICODE) ?>;
                var savedLabel = <?= json_encode((string)__('已保存'), JSON_UNESCAPED_UNICODE) ?>;
                var saveFailLabel = <?= json_encode((string)__('保存失败'), JSON_UNESCAPED_UNICODE) ?>;
                var deleteBusyLabel = <?= json_encode((string)__('删除中…'), JSON_UNESCAPED_UNICODE) ?>;
                var deleteFailLabel = <?= json_encode((string)__('删除失败'), JSON_UNESCAPED_UNICODE) ?>;
                var deleteSseMissingLabel = <?= json_encode((string)__('未返回 SSE 流'), JSON_UNESCAPED_UNICODE) ?>;
                var smtpReloadUrl = '@backend-url{$basePath|['view' => 'smtp']}';

                function mailSmtpToast(kind, text) {
                    try {
                        if (window.Weline && window.Weline.UI && window.Weline.UI.toast) {
                            if (kind === 'success' && typeof window.Weline.UI.toast.success === 'function') {
                                window.Weline.UI.toast.success(text);
                                return;
                            }
                            if (kind === 'error' && typeof window.Weline.UI.toast.error === 'function') {
                                window.Weline.UI.toast.error(text);
                                return;
                            }
                            if (typeof window.Weline.UI.toast.show === 'function') {
                                window.Weline.UI.toast.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
                            }
                        }
                    } catch (e) {}
                }

                function mailSmtpConsumeSse(response, onEvent) {
                    if (!response || !response.body || typeof response.body.getReader !== 'function') {
                        return Promise.reject(new Error(deleteSseMissingLabel));
                    }
                    var reader = response.body.getReader();
                    var decoder = new TextDecoder('utf-8');
                    var buffer = '';
                    var eventName = 'message';
                    var dataLines = [];

                    function flushEvent() {
                        if (!dataLines.length) {
                            eventName = 'message';
                            return;
                        }
                        var raw = dataLines.join('\n');
                        dataLines = [];
                        var payload = raw;
                        try {
                            payload = JSON.parse(raw);
                        } catch (e) {}
                        onEvent(eventName || 'message', payload);
                        eventName = 'message';
                    }

                    function pump() {
                        return reader.read().then(function (result) {
                            if (result.done) {
                                buffer += decoder.decode();
                                if (buffer.trim()) {
                                    buffer.split(/\r?\n/).forEach(function (line) {
                                        if (line.indexOf('event:') === 0) {
                                            eventName = line.slice(6).trim();
                                        } else if (line.indexOf('data:') === 0) {
                                            dataLines.push(line.slice(5).trim());
                                        } else if (line === '') {
                                            flushEvent();
                                        }
                                    });
                                    flushEvent();
                                }
                                return;
                            }
                            buffer += decoder.decode(result.value, { stream: true });
                            var parts = buffer.split(/\r?\n/);
                            buffer = parts.pop();
                            parts.forEach(function (line) {
                                if (line.indexOf('event:') === 0) {
                                    eventName = line.slice(6).trim();
                                } else if (line.indexOf('data:') === 0) {
                                    dataLines.push(line.slice(5).trim());
                                } else if (line === '') {
                                    flushEvent();
                                }
                            });
                            return pump();
                        });
                    }

                    return pump();
                }

                function mailSmtpBindDeleteSse(form) {
                    form.addEventListener('submit', function (ev) {
                        ev.preventDefault();
                        var url = form.getAttribute('action') || '';
                        if (!url) {
                            return;
                        }
                        var btn = form.querySelector('[type="submit"]');
                        var done = false;
                        var lastMessage = deleteBusyLabel;
                        if (btn) {
                            btn.disabled = true;
                            if (!btn.getAttribute('data-smtp-delete-label')) {
                                btn.setAttribute('data-smtp-delete-label', btn.textContent || '');
                            }
                            btn.textContent = deleteBusyLabel;
                        }
                        mailSmtpToast('success', deleteBusyLabel);
                        var body = new URLSearchParams();
                        new FormData(form).forEach(function (value, key) {
                            body.append(key, value);
                        });
                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'Accept': 'text/event-stream',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            credentials: 'include',
                            body: body.toString(),
                            __welineNativeFetch: true
                        }).then(function (response) {
                            var contentType = String(response.headers.get('content-type') || '').toLowerCase();
                            if (!response.ok) {
                                throw new Error('HTTP ' + response.status);
                            }
                            if (contentType.indexOf('text/event-stream') === -1) {
                                throw new Error(deleteSseMissingLabel);
                            }
                            return mailSmtpConsumeSse(response, function (eventName, data) {
                                var message = (data && data.message) ? String(data.message) : eventName;
                                lastMessage = message;
                                if (btn && eventName === 'progress') {
                                    btn.textContent = message.length > 28 ? message.slice(0, 28) + '…' : message;
                                }
                                if (eventName === 'done') {
                                    done = true;
                                    mailSmtpToast('success', message);
                                    var target = smtpReloadUrl || (window.location.pathname + '?view=smtp');
                                    window.setTimeout(function () {
                                        window.location.assign(target);
                                    }, 250);
                                }
                                if (eventName === 'error') {
                                    done = true;
                                    mailSmtpToast('error', message || deleteFailLabel);
                                    if (btn) {
                                        btn.disabled = false;
                                        btn.textContent = btn.getAttribute('data-smtp-delete-label') || <?= json_encode((string)__('删除'), JSON_UNESCAPED_UNICODE) ?>;
                                    }
                                }
                            });
                        }).then(function () {
                            if (!done) {
                                mailSmtpToast('error', lastMessage || deleteFailLabel);
                                if (btn) {
                                    btn.disabled = false;
                                    btn.textContent = btn.getAttribute('data-smtp-delete-label') || <?= json_encode((string)__('删除'), JSON_UNESCAPED_UNICODE) ?>;
                                }
                            }
                        }).catch(function (error) {
                            mailSmtpToast('error', (error && error.message) ? error.message : deleteFailLabel);
                            if (btn) {
                                btn.disabled = false;
                                btn.textContent = btn.getAttribute('data-smtp-delete-label') || <?= json_encode((string)__('删除'), JSON_UNESCAPED_UNICODE) ?>;
                            }
                        });
                    });
                }

                document.querySelectorAll('[data-smtp-delete-sse]').forEach(mailSmtpBindDeleteSse);

                document.querySelectorAll('.mail-smtp-external-edit-form').forEach(function (form) {
                    form.addEventListener('submit', function (ev) {
                        ev.preventDefault();
                        var sid = form.getAttribute('data-smtp-service-id') || '';
                        var statusEl = sid ? document.querySelector('[data-mail-smtp-edit-status="' + sid + '"]') : null;
                        var btn = form.querySelector('[type="submit"]');
                        var url = form.getAttribute('action') || '';
                        if (!url) return;
                        if (statusEl) {
                            statusEl.setAttribute('data-tone', 'muted');
                            statusEl.textContent = savingLabel;
                        }
                        if (btn) btn.disabled = true;
                        var fd = new FormData(form);
                        if (!fd.get('isAjax')) fd.set('isAjax', '1');
                        var ac = (typeof AbortController !== 'undefined') ? new AbortController() : null;
                        var opts = {
                            method: 'POST',
                            body: fd,
                            credentials: 'same-origin',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Accept': 'application/json'
                            },
                            __welineNativeFetch: true
                        };
                        if (ac) opts.signal = ac.signal;
                        fetch(url, opts)
                            .then(function (r) { return r.json(); })
                            .then(function (json) {
                                var ok = json && (json.code === 200 || json.code === '200');
                                var msg = (json && json.msg) ? String(json.msg) : (ok ? savedLabel : saveFailLabel);
                                if (statusEl) {
                                    statusEl.setAttribute('data-tone', ok ? 'success' : 'danger');
                                    statusEl.textContent = msg;
                                }
                                if (!ok) return;
                                var host = (form.querySelector('[name="smtp_hostname"]') || {}).value || '';
                                var port = (form.querySelector('[name="port"]') || {}).value || '';
                                var user = (form.querySelector('[name="username"]') || {}).value || '';
                                var tls = (form.querySelector('[name="tls_mode"]') || {}).value || '';
                                var title = (form.querySelector('[name="name"]') || {}).value || '';
                                var hostEl = document.querySelector('[data-mail-smtp-host-display="' + sid + '"]');
                                var portEl = document.querySelector('[data-mail-smtp-port-display="' + sid + '"]');
                                var userEl = document.querySelector('[data-mail-smtp-user-display="' + sid + '"]');
                                var tlsEl = document.querySelector('[data-mail-smtp-tls-display="' + sid + '"]');
                                var card = form.closest('[data-testid^="mail-smtp-service-"]');
                                if (hostEl) hostEl.textContent = host;
                                if (portEl) portEl.textContent = port;
                                if (userEl) userEl.textContent = user;
                                if (tlsEl) tlsEl.textContent = tls;
                                if (card && title) {
                                    var h = card.querySelector('.w-card__title');
                                    if (h) h.textContent = title;
                                }
                                var pass = form.querySelector('[name="password"]');
                                if (pass) pass.value = '';
                            })
                            .catch(function () {
                                if (statusEl) {
                                    statusEl.setAttribute('data-tone', 'danger');
                                    statusEl.textContent = saveFailLabel;
                                }
                            })
                            .finally(function () {
                                if (btn) btn.disabled = false;
                            });
                    });
                });
            })();
            </script>
