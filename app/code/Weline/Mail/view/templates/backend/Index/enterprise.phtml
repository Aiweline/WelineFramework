                                    </label>
                                    <label class="w-field">
                                        <span class="w-field__label"><?= __('端口') ?></span>
                                        <input class="w-input" type="number" name="outbound_relay_port" value="587" min="1" max="65535" data-outbound-port data-outbound-field="port">
                                    </label>
                                    <label class="w-field">
                                        <span class="w-field__label"><?= __('用户名') ?></span>
                                        <input class="w-input" type="text" name="outbound_relay_username" data-outbound-user data-outbound-field="user">
                                    </label>
                                    <label class="w-field">
                                        <span class="w-field__label"><?= __('密码（选目录后请留空；点保存时从 Smtp 目录自动带入）') ?></span>
                                        <input class="w-input" type="password" name="outbound_relay_password" value="" autocomplete="new-password" data-outbound-pass data-outbound-field="pass" placeholder="<?= $escape((string)__('选目录后留空即可')) ?>">
                                    </label>
                                    <label class="w-field">
                                        <span class="w-field__label"><?= __('TLS') ?></span>
                                        <select class="w-select" name="outbound_relay_tls" data-outbound-tls data-outbound-field="tls">
                                            <option value="starttls">STARTTLS</option>
                                            <option value="smtps">SMTPS</option>
                                            <option value="none"><?= __('无') ?></option>
                                        </select>
                                    </label>
                                </div>
                                <span class="w-text" data-size="sm" data-tone="muted" data-outbound-status style="--w-m:0;"></span>
                            </div>
                            <div class="w-dialog__footer" style="flex-shrink:0;">
                                <button class="w-button" data-w-action="dialog.close" data-tone="neutral" type="button"><?= __('取消') ?></button>
                                <button class="w-button" data-tone="primary" type="submit" data-testid="mail-account-outbound-submit"><?= __('保存外投') ?></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
            (function () {
                document.querySelectorAll('.mail-outbound-relay-form').forEach(function (form) {
                    var pick = form.querySelector('[data-outbound-pick]');
                    if (!pick) return;
                    pick.addEventListener('change', function () {
                        var opt = pick.options[pick.selectedIndex];
                        var enabled = form.querySelector('[data-outbound-enabled]');
                        var host = form.querySelector('[data-outbound-host]');
                        var port = form.querySelector('[data-outbound-port]');
                        var user = form.querySelector('[data-outbound-user]');
                        var tls = form.querySelector('[data-outbound-tls]');
                        var pass = form.querySelector('[data-outbound-pass]');
                        if (!opt || !opt.value) {
                            if (pass) {
                                pass.value = '';
                                pass.placeholder = <?= json_encode((string)__('留空不改'), JSON_UNESCAPED_UNICODE) ?>;
                            }
                            return;
                        }
                        if (enabled) enabled.checked = true;
                        if (host) host.value = opt.getAttribute('data-host') || '';
                        if (port) port.value = opt.getAttribute('data-port') || '587';
                        if (user) user.value = opt.getAttribute('data-username') || '';
                        if (tls) tls.value = opt.getAttribute('data-tls') || 'starttls';
                        if (pass) {
                            pass.value = '';
                            pass.placeholder = <?= json_encode((string)__('已选目录：保存时自动带入密码'), JSON_UNESCAPED_UNICODE) ?>;
                        }
                    });
                });

                var root = document.getElementById('mail-enterprise-accounts');
                var form = document.getElementById('mail-account-editor-form');
                var dialog = document.getElementById('mail-account-editor-dialog');
                var resetFormEl = document.getElementById('mail-account-reset-form');
                var resetDialog = document.getElementById('mail-account-reset-dialog');
                var outboundForm = document.getElementById('mail-account-outbound-form');
                var outboundDialog = document.getElementById('mail-account-outbound-dialog');
                if (!root) return;
                var statusEl = form ? form.querySelector('[data-account-create-status]') : null;
                var titleEl = dialog ? dialog.querySelector('[data-account-editor-title]') : null;
                var unavailableMsg = <?= json_encode((string)__('Mail API 不可用'), JSON_UNESCAPED_UNICODE) ?>;
                var titleCreate = <?= json_encode((string)__('开通企业邮箱账号'), JSON_UNESCAPED_UNICODE) ?>;
                var titleEdit = <?= json_encode((string)__('编辑企业邮箱账号'), JSON_UNESCAPED_UNICODE) ?>;
                var confirmDelete = <?= json_encode((string)__('确认删除该邮箱账号？此操作不可恢复。'), JSON_UNESCAPED_UNICODE) ?>;
                var confirmBatchDelete = <?= json_encode((string)__('确认删除选中的邮箱账号？此操作不可恢复。'), JSON_UNESCAPED_UNICODE) ?>;
                var pickNone = <?= json_encode((string)__('请先勾选账号'), JSON_UNESCAPED_UNICODE) ?>;

                function toast(kind, message) {
                    var ui = window.Weline && window.Weline.UI;
                    var api = ui && ui.toast;
                    var text = String(message || '').trim();
                    if (!text) return;
                    if (api && typeof api[kind] === 'function') { api[kind](text); return; }
                    if (api && typeof api.show === 'function') {
                        api.show(text, { tone: kind === 'success' ? 'success' : 'danger' });
                    }
                }
                function setStatus(tone, text) {
                    if (!statusEl) return;
                    statusEl.setAttribute('data-tone', tone || 'muted');
                    statusEl.textContent = text || '';
                }
                function openUiDialog(el) {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.open === 'function') { ui.open(el); return; }
                    el.hidden = false; el.setAttribute('data-state', 'open'); el.setAttribute('aria-hidden', 'false');
                }
                function closeUiDialog(el) {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.close === 'function') { ui.close(el); return; }
                    el.hidden = true; el.setAttribute('data-state', 'closed'); el.setAttribute('aria-hidden', 'true');
                }
                function confirmUi(message) {
                    var ui = window.Weline && window.Weline.UI && window.Weline.UI.dialog;
                    if (ui && typeof ui.confirm === 'function') {
                        return Promise.resolve(ui.confirm(message)).then(function (ok) { return !!ok; });
                    }
                    return Promise.resolve(window.confirm(String(message || '')));
                }
                function mailApi() {
                    if (!window.Weline || !window.Weline.Api || typeof window.Weline.Api.resource !== 'function') {
                        return Promise.reject(new Error(unavailableMsg));
                    }
                    if (typeof window.Weline.load === 'function') {
                        return window.Weline.load('api').then(function () {
                            return window.Weline.Api.resource('mail');
                        });
                    }
                    return Promise.resolve(window.Weline.Api.resource('mail'));
                }
                function field(name) {
                    return form ? form.querySelector('[data-account-field="' + name + '"]') : null;
                }
                function setMode(mode) {
                    var isEdit = mode === 'edit';
                    root.querySelectorAll('[data-account-create-only]').forEach(function (el) { el.hidden = isEdit; });
                    root.querySelectorAll('[data-account-edit-only]').forEach(function (el) { el.hidden = !isEdit; });
                    var emailEl = form ? form.querySelector('[data-account-edit-email]') : null;
                    if (emailEl) emailEl.hidden = !isEdit;
                    if (titleEl) titleEl.textContent = isEdit ? titleEdit : titleCreate;
                    var lp = field('local_part');
                    if (lp) lp.required = !isEdit;
                    var domain = field('domain_id');
                    if (domain) domain.required = !isEdit;
                }
                function resetCreateForm() {
                    var id = field('account_id'); if (id) id.value = '0';
                    var lp = field('local_part'); if (lp) lp.value = '';
                    var cid = field('customer_id'); if (cid) cid.value = '0';
                    var dn = field('display_name'); if (dn) dn.value = '';
                    var qm = field('quota_mb'); if (qm) qm.value = '1024';
                    var pw = field('password'); if (pw) pw.value = '';
                    var st = field('status'); if (st) st.value = 'active';
                    var emailEl = form ? form.querySelector('[data-account-edit-email]') : null;
                    if (emailEl) emailEl.textContent = '';
                    setMode('create');
                    setStatus('muted', '');
                }
                function selectedIds() {
                    var ids = [];
                    root.querySelectorAll('[data-account-check]:checked').forEach(function (el) {
                        var id = parseInt(el.value || '0', 10) || 0;
                        if (id > 0) ids.push(id);
                    });
                    return ids;
                }

                var checkAll = root.querySelector('[data-account-check-all]');
                if (checkAll) {
                    checkAll.addEventListener('change', function () {
                        root.querySelectorAll('[data-account-check]').forEach(function (el) {
                            el.checked = checkAll.checked;
                        });
                    });
                }

                if (form && dialog) {
                    var openBtn = root.querySelector('[data-account-create-open]');
                    if (openBtn) {
                        openBtn.addEventListener('click', function () {
                            resetCreateForm();
                            openUiDialog(dialog);
                        });
                    }
                    root.querySelectorAll('[data-account-edit]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var row = btn.closest('[data-account-row]');
                            if (!row) return;
                            setMode('edit');
                            var id = field('account_id'); if (id) id.value = row.getAttribute('data-account-id') || '0';
                            var cid = field('customer_id'); if (cid) cid.value = row.getAttribute('data-account-customer-id') || '0';
                            var dn = field('display_name'); if (dn) dn.value = row.getAttribute('data-account-display-name') || '';
                            var qm = field('quota_mb'); if (qm) qm.value = row.getAttribute('data-account-quota-mb') || '1024';
                            var st = field('status'); if (st) st.value = row.getAttribute('data-account-status') || 'active';
                            var emailEl = form.querySelector('[data-account-edit-email]');
                            if (emailEl) emailEl.textContent = row.getAttribute('data-account-email') || '';
                            setStatus('muted', '');
                            openUiDialog(dialog);
                        });
                    });
                    form.addEventListener('submit', function (ev) {
                        ev.preventDefault();
                        var accountId = parseInt((field('account_id') || {}).value || '0', 10) || 0;
                        var isEdit = accountId > 0;
                        setStatus('muted', <?= json_encode((string)__('保存中…'), JSON_UNESCAPED_UNICODE) ?>);
                        var req = mailApi().then(function (api) {
                            if (isEdit) {
                                return api.updateMailboxAccount({
                                    account_id: accountId,
                                    display_name: String((field('display_name') || {}).value || '').trim(),
                                    customer_id: parseInt((field('customer_id') || {}).value || '0', 10) || 0,
                                    quota_mb: parseInt((field('quota_mb') || {}).value || '1024', 10) || 1024,
                                    status: String((field('status') || {}).value || 'active')
                                });
                            }
                            return api.createMailboxAccount({
                                domain_id: parseInt((field('domain_id') || {}).value || '0', 10) || 0,
                                local_part: String((field('local_part') || {}).value || '').trim(),
                                customer_id: parseInt((field('customer_id') || {}).value || '0', 10) || 0,
                                display_name: String((field('display_name') || {}).value || '').trim(),
                                quota_mb: parseInt((field('quota_mb') || {}).value || '1024', 10) || 1024,
                                password: String((field('password') || {}).value || '')
                            });
                        });
                        req.then(function (res) {
                            var ok = !!(res && res.success);
                            var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
                            setStatus(ok ? 'success' : 'danger', msg);
                            toast(ok ? 'success' : 'error', msg);
                            if (ok) { closeUiDialog(dialog); window.location.reload(); }
                        }).catch(function (err) {
                            var msg = (err && err.message) ? String(err.message) : unavailableMsg;
                            setStatus('danger', msg);
                            toast('error', msg);
                        });
                    });
                }

                root.querySelectorAll('[data-account-toggle-status]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var row = btn.closest('[data-account-row]');
                        if (!row) return;
                        var id = parseInt(row.getAttribute('data-account-id') || '0', 10) || 0;
                        var next = String(btn.getAttribute('data-next-status') || '');
                        if (id <= 0 || !next) return;
                        mailApi().then(function (api) {
                            return api.setMailboxAccountStatus({ account_id: id, status: next });
                        }).then(function (res) {
                            var ok = !!(res && res.success);
                            toast(ok ? 'success' : 'error', (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail'));
                            if (ok) window.location.reload();
                        }).catch(function (err) {
                            toast('error', (err && err.message) ? String(err.message) : unavailableMsg);
                        });
                    });
                });

                root.querySelectorAll('[data-account-delete]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var row = btn.closest('[data-account-row]');
                        if (!row) return;
                        var id = parseInt(row.getAttribute('data-account-id') || '0', 10) || 0;
                        if (id <= 0) return;
                        confirmUi(confirmDelete).then(function (ok) {
                            if (!ok) return;
                            return mailApi().then(function (api) {
                                return api.deleteMailboxAccount({ account_id: id });
                            }).then(function (res) {
                                var success = !!(res && res.success);
                                toast(success ? 'success' : 'error', (res && res.message) ? String(res.message) : (success ? 'ok' : 'fail'));
                                if (success) window.location.reload();
                            });
                        }).catch(function (err) {
                            toast('error', (err && err.message) ? String(err.message) : unavailableMsg);
                        });
                    });
                });

                root.querySelectorAll('[data-account-batch]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var ids = selectedIds();
                        var status = String(btn.getAttribute('data-account-batch') || '');
                        if (ids.length === 0) { toast('error', pickNone); return; }
                        if (!status) return;
                        mailApi().then(function (api) {
                            return api.batchSetMailboxAccountStatus({ account_ids: ids, status: status });
                        }).then(function (res) {
                            var ok = !!(res && res.success);
                            toast(ok ? 'success' : 'error', (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail'));
                            if (ok || (res && (res.ok || 0) > 0)) window.location.reload();
                        }).catch(function (err) {
                            toast('error', (err && err.message) ? String(err.message) : unavailableMsg);
                        });
                    });
                });

                var batchDeleteBtn = root.querySelector('[data-account-batch-delete]');
                if (batchDeleteBtn) {
                    batchDeleteBtn.addEventListener('click', function () {
                        var ids = selectedIds();
                        if (ids.length === 0) { toast('error', pickNone); return; }
                        confirmUi(confirmBatchDelete).then(function (ok) {
                            if (!ok) return;
                            return mailApi().then(function (api) {
                                return api.batchDeleteMailboxAccounts({ account_ids: ids });
                            }).then(function (res) {
                                var success = !!(res && res.success);
                                toast(success ? 'success' : 'error', (res && res.message) ? String(res.message) : (success ? 'ok' : 'fail'));
                                if (success || (res && (res.ok || 0) > 0)) window.location.reload();
                            });
                        }).catch(function (err) {
                            toast('error', (err && err.message) ? String(err.message) : unavailableMsg);
                        });
                    });
                }

                if (resetFormEl && resetDialog) {
                    var resetStatus = resetFormEl.querySelector('[data-reset-status]');
                    function setResetStatus(tone, text) {
                        if (!resetStatus) return;
                        resetStatus.setAttribute('data-tone', tone || 'muted');
                        resetStatus.textContent = text || '';
                    }
                    root.querySelectorAll('[data-account-reset-open]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var row = btn.closest('[data-account-row]');
                            if (!row) return;
                            var idField = resetFormEl.querySelector('[data-reset-field="account_id"]');
                            var pw = resetFormEl.querySelector('[data-reset-field="password"]');
                            var emailEl = resetFormEl.querySelector('[data-reset-email]');
                            if (idField) idField.value = row.getAttribute('data-account-id') || '0';
                            if (pw) pw.value = '';
                            if (emailEl) emailEl.textContent = row.getAttribute('data-account-email') || '';
                            setResetStatus('muted', '');
                            openUiDialog(resetDialog);
                        });
                    });
                    resetFormEl.addEventListener('submit', function (ev) {
                        ev.preventDefault();
                        var payload = {
                            account_id: parseInt((resetFormEl.querySelector('[data-reset-field="account_id"]') || {}).value || '0', 10) || 0,
                            password: String((resetFormEl.querySelector('[data-reset-field="password"]') || {}).value || '')
                        };
                        setResetStatus('muted', <?= json_encode((string)__('更新中…'), JSON_UNESCAPED_UNICODE) ?>);
                        mailApi().then(function (api) { return api.resetMailboxPassword(payload); })
                            .then(function (res) {
                                var ok = !!(res && res.success);
                                var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
                                setResetStatus(ok ? 'success' : 'danger', msg);
                                toast(ok ? 'success' : 'error', msg);
                                if (ok) { closeUiDialog(resetDialog); window.location.reload(); }
                            }).catch(function (err) {
                                var msg = (err && err.message) ? String(err.message) : unavailableMsg;
                                setResetStatus('danger', msg); toast('error', msg);
                            });
                    });
                }

                if (outboundForm && outboundDialog) {
                    var outboundStatus = outboundForm.querySelector('[data-outbound-status]');
                    function setOutboundStatus(tone, text) {
                        if (!outboundStatus) return;
                        outboundStatus.setAttribute('data-tone', tone || 'muted');
                        outboundStatus.textContent = text || '';
                    }
                    root.querySelectorAll('[data-account-outbound-open]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var row = btn.closest('[data-account-row]');
                            if (!row) return;
                            var idField = outboundForm.querySelector('[data-outbound-field="account_id"]');
                            var enabled = outboundForm.querySelector('[data-outbound-enabled]');
                            var host = outboundForm.querySelector('[data-outbound-host]');
                            var port = outboundForm.querySelector('[data-outbound-port]');
                            var user = outboundForm.querySelector('[data-outbound-user]');
                            var tls = outboundForm.querySelector('[data-outbound-tls]');
                            var pass = outboundForm.querySelector('[data-outbound-pass]');
                            var pick = outboundForm.querySelector('[data-outbound-pick]');
                            var emailEl = outboundForm.querySelector('[data-outbound-email]');
                            if (idField) idField.value = row.getAttribute('data-account-id') || '0';
                            if (enabled) enabled.checked = row.getAttribute('data-ob-on') === '1';
                            if (host) host.value = row.getAttribute('data-ob-host') || '';
                            if (port) port.value = row.getAttribute('data-ob-port') || '587';
                            if (user) user.value = row.getAttribute('data-ob-user') || '';
                            if (tls) tls.value = row.getAttribute('data-ob-tls') || 'starttls';
                            if (pass) { pass.value = ''; pass.placeholder = <?= json_encode((string)__('选目录后留空即可'), JSON_UNESCAPED_UNICODE) ?>; }
                            if (pick) pick.value = '';
                            if (emailEl) emailEl.textContent = row.getAttribute('data-account-email') || '';
                            setOutboundStatus('muted', '');
                            openUiDialog(outboundDialog);
                        });
                    });
                    outboundForm.addEventListener('submit', function (ev) {
                        ev.preventDefault();
                        var enabled = outboundForm.querySelector('[data-outbound-enabled]');
                        var payload = {
                            account_id: parseInt((outboundForm.querySelector('[data-outbound-field="account_id"]') || {}).value || '0', 10) || 0,
                            outbound_relay_enabled: (enabled && enabled.checked) ? 1 : 0,
                            outbound_smtp_pick: String((outboundForm.querySelector('[data-outbound-pick]') || {}).value || ''),
                            outbound_relay_host: String((outboundForm.querySelector('[data-outbound-host]') || {}).value || '').trim(),
                            outbound_relay_port: parseInt((outboundForm.querySelector('[data-outbound-port]') || {}).value || '587', 10) || 587,
                            outbound_relay_username: String((outboundForm.querySelector('[data-outbound-user]') || {}).value || '').trim(),
                            outbound_relay_password: String((outboundForm.querySelector('[data-outbound-pass]') || {}).value || ''),
                            outbound_relay_tls: String((outboundForm.querySelector('[data-outbound-tls]') || {}).value || 'starttls')
                        };
                        setOutboundStatus('muted', <?= json_encode((string)__('保存中…'), JSON_UNESCAPED_UNICODE) ?>);
                        mailApi().then(function (api) { return api.setMailboxOutboundRelay(payload); })
                            .then(function (res) {
                                var ok = !!(res && res.success);
                                var msg = (res && res.message) ? String(res.message) : (ok ? 'ok' : 'fail');
                                setOutboundStatus(ok ? 'success' : 'danger', msg);
                                toast(ok ? 'success' : 'error', msg);
                                if (ok) { closeUiDialog(outboundDialog); window.location.reload(); }
                            }).catch(function (err) {
                                var msg = (err && err.message) ? String(err.message) : unavailableMsg;
                                setOutboundStatus('danger', msg); toast('error', msg);
                            });
                    });
                }
            })();
            </script>
        </section>

