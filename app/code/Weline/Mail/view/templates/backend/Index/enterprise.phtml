foreach ($mailboxAccounts as $__mailAccountOpt) {
    $__optId = (int)$__mailAccountOpt->getId();
    $__optEmail = strtolower(trim((string)$__mailAccountOpt->getData(MailAccount::schema_fields_EMAIL)));
    $__optName = trim((string)$__mailAccountOpt->getData(MailAccount::schema_fields_DISPLAY_NAME));
    $__optLabel = $__optName !== '' ? $__optEmail . ' · ' . $__optName : $__optEmail;
    $__optUnread = max(0, (int)($mailboxUnreadByAccount[$__optId] ?? 0));
    $mailboxAccountSelectOptions[] = [
        'value' => (string)$__optId,
        'label' => $__optLabel,
        'email' => $__optEmail,
        'meta' => $__optName,
        'display_name' => $__optName,
        'unread' => $__optUnread,
        'search' => strtolower($__optEmail . ' ' . $__optName . ' ' . $__optId),
    ];
    if ($__optId === $selectedAccountId) {
        $selectedMailboxDisplay = $__optLabel;
        $selectedMailboxUnread = $__optUnread;
    }
}
usort(
    $mailboxAccountSelectOptions,
    static function (array $left, array $right): int {
        $unreadCmp = ((int)($right['unread'] ?? 0)) <=> ((int)($left['unread'] ?? 0));
        if ($unreadCmp !== 0) {
            return $unreadCmp;
        }
        return strcmp((string)($left['email'] ?? ''), (string)($right['email'] ?? ''));
    }
);
