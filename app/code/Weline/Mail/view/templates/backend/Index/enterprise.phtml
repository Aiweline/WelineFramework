                                <script>
                                (function () {
                                    var field = document.getElementById('mail-compose-customer');
                                    var toEmail = document.getElementById('mail-compose-to-email');
                                    var wrapper = document.getElementById('mail-compose-customer_wrapper');
                                    if (!field || !toEmail) return;

                                    function applyEmail(email) {
                                        var next = String(email || '').trim().toLowerCase();
                                        if (next === '') return;
                                        toEmail.value = next;
                                        toEmail.dispatchEvent(new Event('input', { bubbles: true }));
                                    }

                                    function syncFromSelect() {
                                        var fromData = String(field.getAttribute('data-w-customer-email') || '').trim();
                                        if (fromData !== '') {
                                            applyEmail(fromData);
                                            return;
                                        }
                                        var mount = window.Weline && window.Weline.UI && typeof window.Weline.UI.get === 'function'
                                            ? window.Weline.UI.get(wrapper, 'customer-select')
                                            : null;
                                        if (mount && typeof mount.getEmail === 'function') {
                                            applyEmail(mount.getEmail());
                                            return;
                                        }
                                        var detail = mount && typeof mount.getDetail === 'function' ? mount.getDetail() : null;
                                        if (detail && detail.email) {
                                            applyEmail(detail.email);
                                        }
                                    }

                                    field.addEventListener('change', syncFromSelect);
                                    field.addEventListener('input', syncFromSelect);
                                    if (wrapper) {
                                        wrapper.addEventListener('weline:ui:change', syncFromSelect);
                                        wrapper.addEventListener('weline:ui:ready', syncFromSelect);
                                    }
                                })();
                                </script>
