<?php
/**
 * Weline_Mail module - account sidebar entry.
 *
 * Hook: account.sidebar
 *
 * @hook-priority 165
 * @hook-sort-order 11
 * @hook-solo false
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Mail\Service\MailCustomerAccountService;

/** @var MailCustomerAccountService $mailService */
$mailService = ObjectManager::getInstance(MailCustomerAccountService::class);
$customerId = $mailService->resolveFrontendCustomerId($user ?? $this->getData('user'));
if (!$mailService->hasActiveAccountForCustomer($customerId)) {
    return;
}

$accountIndexPath = parse_url($this->getFrontendUrl('customer/account/index'), PHP_URL_PATH);
if (!is_string($accountIndexPath) || $accountIndexPath === '') {
    $accountIndexPath = '/customer/account/index';
}
$accountIndexPath = rtrim($accountIndexPath, '/');
?>
<a class="account-hook-nav-link" href="<?= htmlspecialchars($accountIndexPath, ENT_QUOTES, 'UTF-8') ?>#mail" data-section="mail" data-account-nav-link="true">
    <span class="account-hook-nav-link__label">
        <w:icon name="mail" size="sm"></w:icon>
        <span class="account-hook-nav-link__text">
            <strong><?= __('我的邮箱') ?></strong>
            <span><?= __('查看企业邮箱收件箱') ?></span>
        </span>
    </span>
    <span class="account-hook-nav-link__arrow" aria-hidden="true">
        <w:icon name="circle" size="sm"></w:icon>
    </span>
</a>