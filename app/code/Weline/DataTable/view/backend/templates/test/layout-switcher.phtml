<?php if (!empty($layoutOptions) && is_array($layoutOptions)): ?>
    <section class="w-card w-datatable-demo__layout-switcher" data-testid="datatable-layout-switcher">
        <header class="w-card__header">
            <div class="w-stack">
            <h3 class="w-card__title"><?= htmlspecialchars((string) ($layoutSwitcherTitle ?? __('Backend Layouts')), ENT_QUOTES, 'UTF-8') ?></h3>
            <?php if (!empty($layoutSwitcherDescription)): ?>
                <p><?= htmlspecialchars((string) $layoutSwitcherDescription, ENT_QUOTES, 'UTF-8') ?></p>
            <?php endif; ?>
            </div>
        </header>
        <nav class="w-card__body w-cluster" aria-label="<?= htmlspecialchars((string) ($layoutSwitcherTitle ?? __('Backend Layouts')), ENT_QUOTES, 'UTF-8') ?>">
            <?php foreach ($layoutOptions as $option): ?>
                <?php $active = !empty($option['active']); ?>
                <a class="w-button"
                   data-tone="<?= $active ? 'primary' : 'neutral' ?>"
                   href="<?= htmlspecialchars((string) ($option['url'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                   title="<?= htmlspecialchars((string) ($option['description'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                   data-testid="datatable-layout-option-<?= htmlspecialchars((string) ($option['key'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                    <?= $active ? 'aria-current="page"' : '' ?>>
                    <?= htmlspecialchars((string) ($option['title'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
                </a>
            <?php endforeach; ?>
        </nav>
    </section>
<?php endif; ?>
