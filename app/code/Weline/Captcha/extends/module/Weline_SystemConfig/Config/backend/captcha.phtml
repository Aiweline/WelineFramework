        label="官方文档：Web 客户端接入"
        description="前端 SDK 与票据校验说明。"
        external-url="https://cloud.tencent.com/document/product/1110/36841"
        target="_blank"
        action-label="打开接入文档" />
    <w:config:field key="captcha/tencent/enabled" label="启用腾讯云验证码" type="switch" value-type="bool" default="1" scope="global,website" />
    <w:config:field key="captcha/tencent/app_id" label="CaptchaAppId" type="text" value-type="string" default="" scope="global,website" validation="max:64" />
    <w:config:field key="captcha/tencent/app_secret_key" label="AppSecretKey" description="服务端票据校验密钥，勿泄露。" type="password" value-type="string" default="" scope="global,website" sensitive="1" validation="max:128" />
</w:config:group>

<w:config:group code="captcha_google_guide" label="Google 使用指南（开发者）" description="本模块不提供 Google 一键授权。请在 Google Cloud 控制台创建 Enterprise Key 与 API Key，再把凭据填回下方字段。" sort="20">
    <w:config:adapter
        code="captcha.google.console"
        label="Google reCAPTCHA Enterprise 控制台"
        description="创建 / 管理 Website 类型的 reCAPTCHA Enterprise Key，复制 Site Key。"
        external-url="https://console.cloud.google.com/security/recaptcha"
        target="_blank"
        action-label="打开 reCAPTCHA 控制台" />
    <w:config:adapter
        code="captcha.google.credentials"
        label="Google Cloud API 凭据"
        description="创建 API Key（建议限制 reCAPTCHA Enterprise API），用于服务端校验。"
        external-url="https://console.cloud.google.com/apis/credentials"
        target="_blank"
        action-label="打开凭据页" />
    <w:config:adapter
        code="captcha.google.docs"
        label="官方文档：创建 reCAPTCHA 密钥"
        description="Google 官方步骤说明。"
        external-url="https://cloud.google.com/recaptcha/docs/create-key-website"
        target="_blank"
        action-label="打开官方文档" />
    <w:config:hint type="info" code="captcha.google.setup.guide">
【开发者配置步骤】
1. 打开上方「reCAPTCHA 控制台」，选择或创建 Google Cloud Project。
2. 创建 Website 类型的 Enterprise Key；Allowed domains 填站点域名。
3. 复制 Project ID、Site Key。
4. 打开「凭据页」创建 API Key，并限制到 reCAPTCHA Enterprise API；复制 API Key。
5. 回到本页「Google reCAPTCHA Enterprise」组：开启启用开关，填入 Project ID / Site Key / API Key，保存。
6. 路由未选中或凭据不完整时不会使用 Google；远端风控失败仍拒绝。脚本不可达且开启「允许客户端降级」时可改拉本地图码。
    </w:config:hint>
</w:config:group>

<w:config:group code="captcha_google_enterprise" label="Google reCAPTCHA Enterprise" description="海外默认。启用后需填写完整 Project ID、Site Key 与 API Key 才会被路由选中。" sort="30">
    <w:config:field key="captcha/google/enabled" label="启用 Google Enterprise" type="switch" value-type="bool" default="1" scope="global,website" />
    <w:config:field key="captcha/google/project_id" label="Google Cloud Project ID" type="text" value-type="string" default="" scope="global,website" validation="max:128" />
    <w:config:field key="captcha/google/site_key" label="Enterprise Site Key" type="text" value-type="string" default="" scope="global,website" sensitive="0" validation="max:255" />
    <w:config:field key="captcha/google/api_key" label="Enterprise API Key" description="服务端校验用；建议在 Google Cloud 凭据页限制到 reCAPTCHA Enterprise API。" type="password" value-type="string" default="" scope="global,website" sensitive="1" validation="max:512" />
</w:config:group>

<w:config:group code="captcha_google_runtime" label="Google 风控参数" description="域名白名单与分数阈值可按站点微调。" sort="40">
    <w:config:field key="captcha/google/allowed_domains" label="允许域名" description="逗号或换行分隔；留空时仅接受当前请求域名，支持 *.example.com。" type="textarea" value-type="string" default="" scope="global,website" validation="max:4000" />
    <w:config:field key="captcha/google/score_threshold" label="最低风险分数" type="number" value-type="float" default="0.5" scope="global,website" validation="min:0|max:1" />
    <w:config:field key="captcha/google/token_max_age" label="Token 最大年龄（秒）" type="number" value-type="int" default="120" scope="global,website" validation="min:30|max:600" />
</w:config:group>
