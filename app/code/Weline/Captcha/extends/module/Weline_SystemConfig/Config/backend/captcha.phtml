<w:config:group code="captcha_routing" label="供应商路由" description="按访客国家选择验证供应商。需 CDN/反代注入国家头（如 CF-IPCountry）；无头时走「未知国家默认」。" sort="5">
    <w:config:hint type="info" code="captcha.routing.guide">
【路由规则】
1. 「国家覆盖」命中 → 用该国指定供应商
2. 否则若国家在「国内国家」→ 国内默认供应商
3. 否则若未知国家 → 未知国家默认
4. 否则 → 海外默认
5. 候选未启用或凭据不完整 → 按「就绪降级链」找下一个已就绪项，最终必为本地图码
    </w:config:hint>
    <w:config:field
        key="captcha/routing/china_codes"
        label="国内国家"
        description="命中后走国内默认供应商。可多选。"
        type="address_countries"
        value-type="string"
        default="CN"
        options-source="i18n:countries"
        scope="global,website"
        validation="max:512" />
    <w:config:field
        key="captcha/routing/china_default"
        label="国内默认供应商"
        type="select"
        value-type="string"
        default="tencent_captcha"
        options="tencent_captcha:腾讯云验证码,google_enterprise:Google reCAPTCHA Enterprise,local_image:本地图形验证码"
        scope="global,website"
        validation="in_options" />
    <w:config:field
        key="captcha/routing/world_default"
        label="海外默认供应商"
        type="select"
        value-type="string"
        default="google_enterprise"
        options="tencent_captcha:腾讯云验证码,google_enterprise:Google reCAPTCHA Enterprise,local_image:本地图形验证码"
        scope="global,website"
        validation="in_options" />
    <w:config:field
        key="captcha/routing/unknown_default"
        label="未知国家默认供应商"
        description="无国家头或无法识别时使用。"
        type="select"
        value-type="string"
        default="google_enterprise"
        options="tencent_captcha:腾讯云验证码,google_enterprise:Google reCAPTCHA Enterprise,local_image:本地图形验证码"
        scope="global,website"
        validation="in_options" />
    <w:config:field
        key="captcha/routing/country_overrides"
        label="国家覆盖"
        description="为特殊国家单独指定供应商；优先于国内/海外默认。"
        type="country_provider_map"
        value-type="string"
        default=""
        options-source="i18n:countries"
        value-options="tencent_captcha:腾讯云验证码,google_enterprise:Google reCAPTCHA Enterprise,local_image:本地图形验证码"
        scope="global,website"
        validation="max:8000" />
    <w:config:field
        key="captcha/routing/fallback_chain"
        label="就绪降级链"
        description="候选未就绪时按此预设顺序尝试。"
        type="select"
        value-type="string"
        default="tencent_captcha+google_enterprise+local_image"
        options="tencent_captcha+google_enterprise+local_image:腾讯 → Google → 本地,google_enterprise+tencent_captcha+local_image:Google → 腾讯 → 本地,tencent_captcha+local_image:腾讯 → 本地,google_enterprise+local_image:Google → 本地,local_image:仅本地图码"
        scope="global,website"
        validation="in_options" />
    <w:config:field
        key="captcha/routing/allow_local_degrade"
        label="允许客户端降级本地图码"
        description="远端 SDK 加载/执行失败时可改拉本地图形挑战。"
        type="switch"
        value-type="bool"
        default="1"
        scope="global,website" />
    <w:config:field
        key="captcha/routing/geo_headers"
        label="可信国家头"
        description="按列表顺序读取第一个有效国家码。"
        type="multiselect"
        value-type="string"
        default="CF-IPCountry,CloudFront-Viewer-Country,X-Country-Code,X-Geo-Country"
        options="CF-IPCountry:Cloudflare CF-IPCountry,CloudFront-Viewer-Country:AWS CloudFront-Viewer-Country,X-Country-Code:X-Country-Code,X-Geo-Country:X-Geo-Country"
        scope="global,website"
        validation="max:512" />
</w:config:group>

<w:config:group code="captcha_tencent" label="腾讯云验证码" description="国内推荐。启用后需填写 CaptchaAppId 与 AppSecretKey 才会被路由选中。" sort="15">
    <w:config:adapter
        code="captcha.tencent.console"
        label="腾讯云验证码控制台"
        description="创建验证码应用，复制 CaptchaAppId 与 AppSecretKey。"
