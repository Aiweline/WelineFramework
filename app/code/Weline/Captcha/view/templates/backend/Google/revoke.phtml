<div class="container-fluid" id="captcha-google-revoke">
    <div class="card">
        <div class="card-body">
            <h1 class="h4"><lang>撤销 Google 授权</lang></h1>
            <p class="text-muted"><lang>此操作会撤销远端 Token，并删除本地 Access Token 与 Refresh Token；现有 Project 和 Site Key 不会被删除。</lang></p>
            <w:form id="captcha-google-revoke-form" method="post" action="" csrf="auto">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" class="btn btn-danger" data-submit><lang>确认撤销授权</lang></button>
                    <a class="btn btn-outline-secondary" href="<?= \htmlspecialchars((string)$this->getBackendUrl('weline_systemconfig/backend/config', ['module' => 'Weline_Captcha', 'area' => 'backend']), ENT_QUOTES, 'UTF-8') ?>"><lang>取消</lang></a>
                    <span role="status" aria-live="polite" data-feedback></span>
                </div>
            </w:form>
        </div>
    </div>
</div>
<script>
(function(){
    var root=document.getElementById('captcha-google-revoke');
    if(!root){return;}
    var form=document.getElementById('captcha-google-revoke-form');
    var submit=root.querySelector('[data-submit]');
    var feedback=root.querySelector('[data-feedback]');
    form.addEventListener('submit',function(event){
        event.preventDefault();
        submit.disabled=true;
        feedback.textContent='<?= \addslashes((string)__('正在撤销 Google 授权…')) ?>';
        Promise.resolve(window.Weline.Api.resource('captcha_google')).then(function(api){
            return api.revoke({});
        }).then(function(result){
            feedback.textContent=result.message||'<?= \addslashes((string)__('Google 授权已撤销')) ?>';
        }).catch(function(error){
            feedback.textContent=(error&&error.message)?error.message:String(error);
            submit.disabled=false;
        });
    });
})();
</script>
