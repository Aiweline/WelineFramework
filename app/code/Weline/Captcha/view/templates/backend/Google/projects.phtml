<?php
$scope = \trim((string)($config_scope ?? ''));
?>
<div class="w-container" id="captcha-google-projects" data-scope="<?= \htmlspecialchars($scope, ENT_QUOTES, 'UTF-8') ?>">
    <div class="w-cluster" data-wrap="true" data-align="center" data-justify="between" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
        <div>
            <h1 class="h4" style="--w-mb:var(--weline-space-1);"><lang>选择 Google Cloud Project</lang></h1>
            <p class="w-text" data-tone="muted" style="--w-mb:0;"><lang>选择后将为当前配置范围的网站域名创建并绑定 reCAPTCHA Enterprise Key。</lang></p>
        </div>
        <a class="w-button" href="<?= \htmlspecialchars((string)$this->getBackendUrl('weline_systemconfig/backend/config', ['module' => 'Weline_Captcha', 'area' => 'backend']), ENT_QUOTES, 'UTF-8') ?>" data-tone="neutral" data-variant="outline"><lang>返回人机验证配置</lang></a>
    </div>
    <div class="w-card">
        <div class="w-card__body">
            <w:form id="captcha-google-project-form" method="post" action="" csrf="auto" class="w-grid" style="--w-gap:var(--weline-space-4);">
                <div style="--w-span:12;">
                    <label class="w-field__label" for="captcha-google-project"><lang>Google Cloud Project</lang></label>
                    <select class="w-select" id="captcha-google-project" name="project_id" required disabled>
                        <option value=""><lang>正在加载可访问的 Project…</lang></option>
                    </select>
                </div>
                <div class="w-cluster" data-align="center" style="--w-span:12;--w-gap:var(--weline-space-2);">
                    <button type="submit" class="w-button" disabled data-submit data-tone="primary"><lang>创建并绑定 Enterprise Key</lang></button>
                    <span class="w-text" role="status" aria-live="polite" data-feedback data-tone="muted"></span>
                </div>
            </w:form>
        </div>
    </div>
</div>
<script>
(function(){
    var root=document.getElementById('captcha-google-projects');
    if(!root){return;}
    var form=document.getElementById('captcha-google-project-form');
    var select=root.querySelector('select[name=project_id]');
    var submit=root.querySelector('[data-submit]');
    var feedback=root.querySelector('[data-feedback]');
    function client(){return Promise.resolve(window.Weline.Api.resource('captcha_google'));}
    function esc(value){var node=document.createElement('span');node.textContent=String(value==null?'':value);return node.innerHTML;}
    client().then(function(api){return api.listProjects({});}).then(function(result){
        var projects=Array.isArray(result.projects)?result.projects:[];
        select.innerHTML='<option value=""><?= \addslashes((string)__('请选择 Project')) ?></option>'+projects.map(function(project){
            return '<option value="'+esc(project.project_id)+'">'+esc(project.display_name||project.project_id)+' ('+esc(project.project_id)+')</option>';
        }).join('');
        select.disabled=false;
        feedback.textContent=projects.length?'':'<?= \addslashes((string)__('当前账户没有可访问的 Project')) ?>';
    }).catch(function(error){feedback.textContent=(error&&error.message)?error.message:String(error);});
    select.addEventListener('change',function(){submit.disabled=!select.value;});
    form.addEventListener('submit',function(event){
        event.preventDefault();
        if(!select.value){return;}
        submit.disabled=true;
        feedback.textContent='<?= \addslashes((string)__('正在创建并绑定 Enterprise Key…')) ?>';
        client().then(function(api){return api.bindProject({project_id:select.value,scope:root.dataset.scope||''});}).then(function(result){
            feedback.textContent=result.message||'<?= \addslashes((string)__('Google Project 已绑定')) ?>';
        }).catch(function(error){
            feedback.textContent=(error&&error.message)?error.message:String(error);
            submit.disabled=false;
        });
    });
})();
</script>
