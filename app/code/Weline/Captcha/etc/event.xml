<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Framework_Setup::upgrade_after">
        <observer name="Weline_Captcha::migrate_legacy_config"
                  instance="Weline\Captcha\Observer\MigrateLegacyConfig"
                  disabled="false"
                  shared="true"
                  sort="120"/>
    </event>
    <event name="Weline_Framework::view::form::before_close">
        <observer name="Weline_Captcha::inject_framework_form_challenge"
                  instance="Weline\Captcha\Observer\InjectCaptchaIntoForm"
                  disabled="false"
                  shared="true"
                  sort="100"/>
    </event>
</config>
