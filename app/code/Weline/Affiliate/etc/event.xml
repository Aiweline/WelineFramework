<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Frontend_Account_Register::register_after">
        <observer name="weline_affiliate_customer_registered" instance="Weline\Affiliate\Observer\CustomerRegisteredObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Checkout::checkout::create_order::after">
        <observer name="weline_affiliate_checkout_order_created" instance="Weline\Affiliate\Observer\CheckoutOrderCreatedObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Order::order_created">
        <observer name="weline_affiliate_order_created" instance="Weline\Affiliate\Observer\CheckoutOrderCreatedObserver" disabled="false" shared="true" sort="110"/>
    </event>
    <event name="Weline_Order::order_paid">
        <observer name="weline_affiliate_order_paid" instance="Weline\Affiliate\Observer\OrderPaymentStatusChangedObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Order::order_refunded">
        <observer name="weline_affiliate_order_refunded" instance="Weline\Affiliate\Observer\OrderPaymentStatusChangedObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Order::order_status_changed">
        <observer name="weline_affiliate_order_status_changed" instance="Weline\Affiliate\Observer\OrderStatusChangedObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Order::order_cancelled">
        <observer name="weline_affiliate_order_cancelled" instance="Weline\Affiliate\Observer\OrderCancelledObserver" disabled="false" shared="true" sort="100"/>
    </event>
    <!-- Missing upstream modules: observers kept disabled until Weline events exist -->
    <event name="Weline_Social::share_after">
        <observer name="weline_affiliate_social_share_after" instance="Weline\Affiliate\Observer\SocialShareAfterObserver" disabled="true" shared="true" sort="100"/>
    </event>
    <event name="Weline_Product::product_viewed">
        <observer name="weline_affiliate_product_viewed" instance="Weline\Affiliate\Observer\ProductViewedObserver" disabled="true" shared="true" sort="100"/>
    </event>
    <event name="Weline_Wishlist::add_to_wishlist_after">
        <observer name="weline_affiliate_wishlist_add_after" instance="Weline\Affiliate\Observer\WishlistAddAfterObserver" disabled="true" shared="true" sort="100"/>
    </event>
    <event name="Weline_Review::review_created">
        <observer name="weline_affiliate_review_created" instance="Weline\Affiliate\Observer\ReviewCreatedObserver" disabled="true" shared="true" sort="100"/>
    </event>
    <event name="Weline_Cart::add_to_cart_after">
        <observer name="weline_affiliate_cart_add_after" instance="Weline\Affiliate\Observer\CartAddAfterObserver" disabled="true" shared="true" sort="100"/>
    </event>
</config>
