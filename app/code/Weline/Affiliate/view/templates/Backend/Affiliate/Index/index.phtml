<script data-no-extract="true">
function affiliateAdminReloadFormScope(level) {
    var root = document.querySelector('[data-testid="affiliate-admin-index"] form[method="post"]');
    if (!root) {
        return;
    }
    var params = new URLSearchParams(window.location.search);
    var websiteInput = root.querySelector('[name="website_id"]');
    var storeInput = root.querySelector('[name="store_code"]');
    var channelInput = root.querySelector('[name="channel_code"]');
    var websiteId = websiteInput ? String(websiteInput.value || '0').trim() : '0';
    var storeCode = storeInput ? String(storeInput.value || '').trim() : '';
    var channelCode = channelInput ? String(channelInput.value || '').trim() : '';
    if (level === 'website') {
        storeCode = '';
        channelCode = '';
    } else if (level === 'store') {
        channelCode = '';
    }
    params.set('form_website_id', websiteId);
    params.set('form_store_code', storeCode);
    params.set('form_channel_code', channelCode);
    params.delete('customer_id');
    params.delete('id');
    window.location.search = params.toString();
}

function affiliateAdminReloadFilterScope(level) {
    var form = document.getElementById('affiliate-filter-form');
    if (!form) {
        return;
    }
    var websiteInput = form.querySelector('[name="website_id"]');
    var storeInput = form.querySelector('[name="store_code"]');
    var channelInput = form.querySelector('[name="channel_code"]');
    var customerInput = form.querySelector('[name="customer_id"]');
    if (level === 'website') {
        if (storeInput) {
            storeInput.value = '';
        }
        if (channelInput) {
            channelInput.value = '';
        }
        if (customerInput) {
            customerInput.value = '';
        }
    } else if (level === 'store') {
        if (channelInput) {
            channelInput.value = '';
        }
        if (customerInput) {
            customerInput.value = '';
        }
    }
    if (form.requestSubmit) {
        form.requestSubmit();
    } else {
        form.submit();
    }
}
</script>
