$buildPageParams = static function (int $page, array $filters): array {
    $params = ['page' => $page];
    foreach (['customer_id', 'referral_code', 'status', 'website_id', 'store_code', 'channel_code'] as $key) {
        if (!empty($filters[$key])) {
            $params[$key] = $filters[$key];
        }
    }

    return $params;
};
