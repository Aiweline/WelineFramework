<?php
/**
 * 页脚「合作信息」扩展：我要推广入口。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-promote-link}
 * @widget.name {页脚我要推广链接}
 * @widget.description {页脚合作信息扩展槽：分销推广入口；默认注入 footer-partner-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-partner-links}
 * @widget.supports {["footer-promote-link","layout-footer-partner-links"]}
 * @widget.default_injections {[{ "layout_type":"*", "slot":"footer-partner-links", "area":"footer", "sort_order":10, "required":true, "reason":"页脚合作信息默认展示我要推广", "config":{"label":"我要推广"} }]}
 *
 * @param label {default="我要推广",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-promote-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '我要推广';
$label = WidgetI18n::label($labelSource, '我要推广');
?>
<a class="footer-partner-link footer-promote-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-promote-link"
   href="@url{'affiliate'}"><?= $esc($label) ?></a>
