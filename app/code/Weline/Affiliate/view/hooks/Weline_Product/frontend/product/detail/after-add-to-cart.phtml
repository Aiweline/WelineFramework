<?php
/**
 * Affiliate share entry for product detail pages.
 *
 * @hook-priority 180
 * @hook-sort-order 0
 * @hook-solo false
 */

use Weline\Affiliate\Service\AffiliateStorefrontPolicy;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;

$product = (array) ($this->getData('product') ?? []);
$offer = (array) ($this->getData('storefront_offer') ?? []);
// PDP Theme widgets unsetData('product'); listing quick-add often has request product_id.
// Prefer storefront_offer / request-scoped resolver so detail and modal stay in sync.
if ($offer === [] && class_exists(\Weline\Product\Helper\StorefrontOfferResolver::class)) {
    $offer = \Weline\Product\Helper\StorefrontOfferResolver::currentOffer();
}
if ($offer === [] && class_exists(\Weline\Product\Helper\StorefrontOfferResolver::class)) {
    try {
        $offer = \Weline\Product\Helper\StorefrontOfferResolver::resolve($this);
    } catch (\Throwable) {
        $offer = [];
    }
}
$productId = (int) (
    $product['product_id']
    ?? $offer['product_id']
    ?? $this->getData('product_id')
    ?? 0
);
if ($productId <= 0) {
    return;
}

$websiteId = max(0, (int)RequestContext::getWelineWebsiteId());
$storeId = max(0, (int)RequestContext::getWelineStoreId());
$shareEnabled = true;
try {
    /** @var AffiliateStorefrontPolicy $policy */
    $policy = ObjectManager::getInstance(AffiliateStorefrontPolicy::class);
    $shareEnabled = $policy->isProductShareEnabled($websiteId, $storeId);
} catch (\Throwable) {
    $shareEnabled = true;
}
if (!$shareEnabled) {
    return;
}

$rootId = 'affiliate-share-' . $productId . '-' . substr(sha1((string) $productId), 0, 8);
$loginUrl = '';
$applyUrl = '';
try {
    $loginUrl = (string) $this->getUrl('customer/account/login');
} catch (\Throwable) {
    $loginUrl = '/customer/account/login';
}
try {
    $applyUrl = (string) $this->getUrl('affiliate');
} catch (\Throwable) {
    $applyUrl = '/affiliate';
}
$freeShareUrl = '';
try {
    $slug = strtolower(trim((string) ($offer['slug'] ?? $product['url_key'] ?? $product['slug'] ?? '')));
    if ($slug !== '') {
        $freeShareUrl = (string) $this->getUrl('product/' . $slug);
    }
} catch (\Throwable) {
    $freeShareUrl = '';
}
if ($freeShareUrl === '') {
    try {
        $freeShareUrl = (string) $this->getUrl('product/' . $productId);
    } catch (\Throwable) {
        $freeShareUrl = '/product/' . $productId;
    }
}
// Prefer published product path; API purchase-panel URIs are not shareable targets.
$encodedFreeShareUrl = rawurlencode($freeShareUrl);
$platformSvg = [
    'facebook' => '<svg class="affiliate-share-platform__mark" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true"><path fill="#1877F2" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>',
    'x' => '<svg class="affiliate-share-platform__mark" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true"><path fill="#0F1419" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
    'linkedin' => '<svg class="affiliate-share-platform__mark" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true"><path fill="#0A66C2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    'whatsapp' => '<svg class="affiliate-share-platform__mark" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>',
];
$freePlatforms = [
    ['platform' => 'facebook', 'label' => 'Facebook', 'short' => 'FB', 'url' => 'https://www.facebook.com/sharer/sharer.php?u=' . $encodedFreeShareUrl],
    ['platform' => 'x', 'label' => 'X', 'short' => 'X', 'url' => 'https://twitter.com/intent/tweet?url=' . $encodedFreeShareUrl],
    ['platform' => 'linkedin', 'label' => 'LinkedIn', 'short' => 'in', 'url' => 'https://www.linkedin.com/sharing/share-offsite/?url=' . $encodedFreeShareUrl],
    ['platform' => 'whatsapp', 'label' => 'WhatsApp', 'short' => 'WA', 'url' => 'https://api.whatsapp.com/send?text=' . $encodedFreeShareUrl],
];

$shareI18n = [
    'loading' => (string) __('加载中'),
    'pleaseLogin' => (string) __('请先登录。'),
    'loginAction' => (string) __('去登录'),
    'promoTitle' => (string) __('分享好物，赚取佣金'),
    'promoBody' => (string) __('加入分销计划后可生成专属推广链接；登录后前往申请，审核通过即可开始分享。'),
    'applyCta' => (string) __('登录前往申请分销'),
    'unavailable' => (string) __('暂不可用'),
    'copied' => (string) __('已复制'),
    'shared' => (string) __('已分享'),
    'apiMissing' => (string) __('分销 API 未初始化'),
    'shareUnsupported' => (string) __('分销 API 不支持分享链接操作'),
    'loadFailed' => (string) __('分销数据加载失败'),
];
$shareI18nJson = (string) json_encode($shareI18n, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
?>
<div id="<?= htmlspecialchars($rootId, ENT_QUOTES, 'UTF-8') ?>"
     class="affiliate-share-panel"
     data-affiliate-share-root="1"
     data-product-id="<?= (int) $productId ?>"
     data-affiliate-channel="product_detail"
     data-login-url="<?= htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8') ?>"
     data-apply-url="<?= htmlspecialchars($applyUrl, ENT_QUOTES, 'UTF-8') ?>"
     data-free-share-url="<?= htmlspecialchars($freeShareUrl, ENT_QUOTES, 'UTF-8') ?>"
     data-affiliate-i18n="<?= htmlspecialchars($shareI18nJson, ENT_QUOTES, 'UTF-8') ?>"
     data-weline-load="api,account,affiliateProductShare"
     data-testid="affiliate-share-panel">
    <div class="affiliate-share-head">
        <span class="affiliate-share-title"><?= __('分销分享') ?></span>
        <span class="affiliate-share-status" data-affiliate-share-status aria-live="polite"></span>
    </div>

    <?php /* FPC 游客壳：佣金申请广告；社媒图标始终作为默认分享入口（信任+可点） */ ?>
    <div class="affiliate-share-guest"
         data-affiliate-share-guest
         data-testid="affiliate-share-guest">
        <p class="affiliate-share-promo-title"><?= htmlspecialchars($shareI18n['promoTitle'], ENT_QUOTES, 'UTF-8') ?></p>
        <p class="affiliate-share-promo-body"><?= htmlspecialchars($shareI18n['promoBody'], ENT_QUOTES, 'UTF-8') ?></p>
        <a class="w-button affiliate-share-apply-cta"
           data-variant="outline"
           data-tone="neutral"
           data-size="sm"
           data-affiliate-share-apply-cta
           data-testid="affiliate-share-apply-cta"
           href="<?= htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8') ?>">
            <?= htmlspecialchars($shareI18n['applyCta'], ENT_QUOTES, 'UTF-8') ?>
        </a>
    </div>

    <div class="affiliate-share-ready" data-affiliate-share-ready hidden>
        <div class="affiliate-share-body">
            <textarea class="affiliate-share-link"
                      rows="3"
                      readonly
                      spellcheck="false"
                      aria-label="<?= htmlspecialchars((string) __('分销分享链接'), ENT_QUOTES, 'UTF-8') ?>"
                      data-affiliate-share-link></textarea>
            <button type="button" class="affiliate-share-copy" data-affiliate-share-copy disabled><?= __('复制') ?></button>
            <button type="button" class="affiliate-share-native" data-affiliate-share-native disabled><?= __('分享') ?></button>
        </div>
    </div>

    <div class="affiliate-share-platforms"
         data-affiliate-share-platforms
         data-testid="affiliate-share-platforms"
         aria-label="<?= htmlspecialchars((string) __('分享到社交平台'), ENT_QUOTES, 'UTF-8') ?>">
        <?php foreach ($freePlatforms as $platform): ?>
            <?php $code = (string) $platform['platform']; ?>
            <a class="affiliate-share-platform affiliate-share-platform--<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>"
               href="<?= htmlspecialchars((string)$platform['url'], ENT_QUOTES, 'UTF-8') ?>"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="<?= htmlspecialchars((string)$platform['label'], ENT_QUOTES, 'UTF-8') ?>"
               title="<?= htmlspecialchars((string)$platform['label'], ENT_QUOTES, 'UTF-8') ?>"
               data-affiliate-default-platform="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                <span class="affiliate-share-platform__logo"><?= $platformSvg[$code] ?? '' ?></span>
                <span class="affiliate-share-platform__label"><?= htmlspecialchars((string)$platform['short'], ENT_QUOTES, 'UTF-8') ?></span>
