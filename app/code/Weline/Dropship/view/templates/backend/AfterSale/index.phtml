<?php
/**
 * 售后异常：对齐 Channel/Order 的 w-card 层次；空态给出下一步。
 * @var \Weline\Framework\View\Template $this
 */
$pf = (string)$this->getData('provider_filter');
$rows = (array)$this->getData('rows');
$ordersUrl = (string)$this->getData('orders_url');
$configUrl = (string)$this->getData('config_url');
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$filtered = $pf !== '';
?>
<div class="w-container" style="--w-pt:0;" data-dropship-admin="aftersale" data-testid="dropship-aftersale">
  <div class="w-card">
    <div class="w-card__header">
      <div class="w-stack" style="--w-gap:var(--weline-space-3);">
        <div class="w-stack" style="--w-gap:var(--weline-space-1);">
          <div class="w-text" data-weight="strong"><?= __('推单异常与补偿') ?></div>
          <p class="w-text" data-tone="muted" data-size="sm" style="margin:0;">
            <?= __('推单进入「无法履约」终态后会停止重试；开启自动退款时，补偿列显示退款与通知进度。') ?>
          </p>
        </div>
        <form method="get" class="w-cluster" data-align="end" data-wrap="true"
              data-testid="dropship-aftersale-filter"
              style="--w-gap:var(--weline-space-2);margin:0;">
          <div class="w-field" style="min-width:min(100%,14rem);flex:0 1 14rem;margin:0;">
            <label class="w-label" for="dropship-aftersale-provider"><?= __('平台代码') ?></label>
            <div class="w-field__control">
              <input class="w-input" id="dropship-aftersale-provider" name="provider" data-size="sm"
                     value="<?= $escape($pf) ?>"
                     placeholder="<?= $escape((string)__('如 cj')) ?>"
                     aria-label="<?= $escape((string)__('平台代码')) ?>">
            </div>
          </div>
          <button class="w-button" type="submit" data-tone="neutral" data-variant="outline" data-size="sm">
            <?= __('按平台筛') ?>
          </button>
          <?php if ($filtered): ?>
            <a class="w-button" href="<?= $escape((string)$this->getBackendUrl('dropship/backend/aftersale/index')) ?>"
               data-tone="neutral" data-variant="ghost" data-size="sm"
               data-testid="dropship-aftersale-clear-filter">
              <?= __('清除筛选') ?>
            </a>
          <?php endif; ?>
        </form>
      </div>
    </div>
    <div class="w-card__body">
      <?php if ($rows === []): ?>
        <div class="w-empty" style="min-height:14rem;" data-testid="dropship-aftersale-empty">
          <w:icon name="inbox" size="lg"></w:icon>
          <div class="w-text" data-weight="strong">
            <?= $filtered ? __('该平台暂无售后记录') : __('暂无售后记录') ?>
          </div>
          <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-4);max-inline-size:28rem;text-align:center;">
            <?= $filtered
              ? __('换一个平台代码试试，或清除筛选查看全部。推单失败、跳过或无法履约终态会出现在此。')
              : __('目前没有需要处理的推单失败。有异常时会出现在此；也可先核对履约订单或退款开关。') ?>
          </div>
          <div class="w-cluster" data-align="center" data-wrap="true" style="--w-gap:var(--weline-space-2);">
            <?php if ($filtered): ?>
              <a class="w-button" href="<?= $escape((string)$this->getBackendUrl('dropship/backend/aftersale/index')) ?>"
                 data-tone="primary" data-size="sm" data-testid="dropship-aftersale-empty-clear">
                <?= __('查看全部异常') ?>
              </a>
            <?php endif; ?>
            <?php if ($ordersUrl !== ''): ?>
              <a class="w-button" href="<?= $escape($ordersUrl) ?>"
                 data-tone="<?= $filtered ? 'neutral' : 'primary' ?>"
                 <?= $filtered ? 'data-variant="outline"' : '' ?>
                 data-size="sm"
                 data-testid="dropship-aftersale-goto-orders">
                <w:icon name="package" size="sm"></w:icon> <?= __('查看履约订单') ?>
              </a>
            <?php endif; ?>
            <?php if ($configUrl !== ''): ?>
              <a class="w-button" href="<?= $escape($configUrl) ?>"
                 data-tone="neutral" data-variant="outline" data-size="sm"
                 data-testid="dropship-aftersale-goto-config">
                <w:icon name="settings" size="sm"></w:icon> <?= __('货源配置') ?>
              </a>
            <?php endif; ?>
          </div>
        </div>
      <?php else: ?>
        <div class="w-table-wrap">
          <table class="w-table" data-w-vertical="middle" data-testid="dropship-aftersale-table">
            <thead>
              <tr>
                <th><?= __('业务键') ?></th>
                <th><?= __('平台') ?></th>
                <th><?= __('状态') ?></th>
                <th><?= __('补偿进度') ?></th>
                <th><?= __('错误原因') ?></th>
              </tr>
            </thead>
            <tbody>
            <?php foreach ($rows as $r): ?>
              <?php
                $statusTone = (string)($r['status_tone'] ?? 'neutral');
                $compTone = (string)($r['compensation_tone'] ?? 'neutral');
                $statusLabel = (string)($r['status_label'] ?? ($r['status'] ?? ''));
                $compLabel = (string)($r['compensation_label'] ?? '—');
              ?>
              <tr data-status="<?= $escape($r['status'] ?? '') ?>">
                <td><code class="w-text" data-size="sm"><?= $escape($r['biz_key'] ?? '') ?></code></td>
                <td><?= $escape($r['provider_code'] ?? '') ?></td>
                <td>
                  <span class="w-badge" data-tone="<?= $escape($statusTone) ?>" data-testid="dropship-aftersale-status">
                    <?= $escape($statusLabel) ?>
                  </span>
                </td>
                <td data-testid="dropship-aftersale-compensation" data-compensation="<?= $escape($r['compensation_status'] ?? '') ?>"<?php if (!empty($r['compensation_error_code'])): ?> title="<?= $escape($r['compensation_error_code']) ?>"<?php endif; ?>>
                  <span class="w-badge" data-tone="<?= $escape($compTone) ?>" data-variant="soft">
                    <?= $escape($compLabel) ?>
                  </span>
                </td>
                <td class="w-text" data-size="sm"><?= $escape($r['last_error'] ?? '') ?></td>
              </tr>
            <?php endforeach; ?>
            </tbody>
          </table>
        </div>
      <?php endif; ?>
    </div>
  </div>
</div>
