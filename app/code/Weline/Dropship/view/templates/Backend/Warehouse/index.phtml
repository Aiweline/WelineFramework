<?php
/**
 * 货源履约仓对接（原型变体 A）：货源轨 + 远程覆盖行内绑定 + 翻页。
 * @var \Weline\Framework\View\Template $this
 */
$providers = (array)$this->getData('provider_summaries');
if ($providers === []) {
    $providers = (array)$this->getData('providers');
}
$selectedProvider = (string)($this->getData('selected_provider') ?? '');
$selectedScope = (string)($this->getData('selected_scope') ?? 'default.default.default');
$coverage = (array)$this->getData('coverage');
$coverageRows = (array)($coverage['rows'] ?? []);
$stats = (array)($coverage['stats'] ?? []);
$coverageReady = (bool)$this->getData('coverage_ready');
$gapFilter = (string)($this->getData('gap_filter') ?? 'all');
$pagination = (array)$this->getData('pagination');
$page = max(1, (int)($pagination['page'] ?? 1));
$pageSize = max(5, (int)($pagination['page_size'] ?? 10));
$pageCount = max(1, (int)($pagination['page_count'] ?? 1));
$pageTotal = max(0, (int)($pagination['total'] ?? 0));
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$isGlobalScope = $selectedScope === '' || $selectedScope === 'default.default.default';
$queryBase = static function (array $extra = []) use ($selectedProvider, $selectedScope, $gapFilter, $pageSize): string {
    $params = array_merge([
        'provider_code' => $selectedProvider,
        'target_scope' => $selectedScope,
        'gap' => $gapFilter,
        'page_size' => (string)$pageSize,
    ], $extra);

    return http_build_query($params, '', '&', PHP_QUERY_RFC3986);
};
