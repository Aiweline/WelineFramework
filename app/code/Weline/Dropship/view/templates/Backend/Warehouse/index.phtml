<script data-dropship-wh-board="1">(function () {
  var root = document.querySelector('[data-dropship-admin="warehouses"]');
  var provider = document.getElementById('dropship-wh-provider');
  var btn = document.getElementById('dropship-wh-pull');
  var syncBtn = document.getElementById('dropship-wh-sync-pairs');
  var scopeHint = document.getElementById('dropship-wh-scope-hint');
  var gapFilter = document.getElementById('dropship-wh-gap-filter');
  if (!root || !provider) { return; }

  function themeToast(type, message) {
    var toast = window.Weline && window.Weline.UI && window.Weline.UI.toast;
    if (!toast) { return; }
    if (typeof toast[type] === 'function') {
      toast[type](String(message || ''));
      return;
    }
    if (typeof toast.show === 'function') {
      var tone = type === 'success' ? 'success' : (type === 'warning' ? 'warning' : 'danger');
      toast.show(String(message || ''), { tone: tone });
    }
  }
  function scopeValue() {
    var scopeInput = document.querySelector('#dropship-wh-scope_value, input[name="target_scope"]');
    return scopeInput ? String(scopeInput.value || '') : '';
  }
  function syncScopeHint() {
    if (!scopeHint) { return; }
    var v = scopeValue();
    var isGlobal = !v || v === 'default.default.default';
    scopeHint.style.display = isGlobal ? '' : 'none';
  }
  function appendCsrf(body) {
    if (window.site && window.site.csrf_token) {
      body.append('csrf_token', String(window.site.csrf_token));
    }
    var csrf = document.querySelector('input[name="csrf_token"], input[name="form_key"]');
    if (csrf && csrf.value) {
      body.append(csrf.name, csrf.value);
    }
  }
  function reloadWithQuery(extra) {
    var code = String(provider.value || '');
    var bootScope = String(root.getAttribute('data-selected-scope') || '');
    var scope = scopeValue() || bootScope || 'default.__website__.default';
    var url = new URL(window.location.href);
    if (code) { url.searchParams.set('provider_code', code); }
    url.searchParams.set('target_scope', scope);
    Object.keys(extra || {}).forEach(function (k) {
      var v = extra[k];
      if (v === null || v === undefined || v === '') {
        url.searchParams.delete(k);
      } else {
        url.searchParams.set(k, String(v));
      }
    });
    window.location.href = url.toString();
  }
  function rowLocalWarehouseId(row) {
    var input = row.querySelector('input[name="local_warehouse_id"]');
    return input ? String(input.value || '').trim() : '';
  }

  var bootScope = String(root.getAttribute('data-selected-scope') || '');
  var scopeRoot = document.getElementById('dropship-wh-scope');
  if (scopeRoot) {
    scopeRoot.addEventListener('change', function () {
      syncScopeHint();
      var next = scopeValue();
      var urlScope = new URL(window.location.href).searchParams.get('target_scope') || bootScope;
      if (urlScope && urlScope !== 'default.default.default' && (!next || next === 'default.default.default')) {
        return;
      }
      if (next && next === urlScope) {
        return;
      }
      reloadWithQuery({ page: '1' });
    });
    document.addEventListener('change', function (e) {
      if (e && e.target && (e.target.name === 'target_scope' || e.target.id === 'dropship-wh-scope_value')) {
        syncScopeHint();
      }
    });
  }
  syncScopeHint();

  if (gapFilter) {
    gapFilter.addEventListener('change', function () {
      reloadWithQuery({ gap: String(gapFilter.value || 'all'), page: '1' });
    });
  }

  root.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) { return; }
    var bindBtn = t.closest('[data-bind-row]');
    if (!bindBtn) { return; }
    var row = bindBtn.closest('.ds-wh-row');
    if (!row) { return; }
    var country = row.getAttribute('data-country') || '';
    var remoteId = row.getAttribute('data-remote-id') || '';
    var localId = rowLocalWarehouseId(row);
    var code = String(provider.value || '');
    var scopeVal = scopeValue() || bootScope;
    var saveUrl = String(root.getAttribute('data-save-url') || '');
    if (!saveUrl) { return; }
    if (!code) {
      themeToast('warning', <?= json_encode((string)__('请先选择左侧货源'), JSON_UNESCAPED_UNICODE) ?>);
      return;
    }
    if (!scopeVal || scopeVal === 'default.default.default') {
      themeToast('warning', <?= json_encode((string)__('请先选择具体网站（不能使用 Global）'), JSON_UNESCAPED_UNICODE) ?>);
      return;
    }
    if (!localId || Number(localId) <= 0) {
      themeToast('warning', <?= json_encode((string)__('请先选择本地仓'), JSON_UNESCAPED_UNICODE) ?>);
      return;
    }
    var body = new FormData();
    body.append('ajax', '1');
    body.append('provider_code', code);
    body.append('target_scope', scopeVal);
    body.append('remote_country_code', country);
    body.append('remote_storage_id', remoteId);
    body.append('local_warehouse_id', localId);
    appendCsrf(body);
    bindBtn.disabled = true;
    fetch(saveUrl, {
      method: 'POST',
      body: body,
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        var msg = (res && res.message) ? String(res.message) : '';
        if (res && res.success) {
          themeToast('success', msg || <?= json_encode((string)__('已绑定本地仓'), JSON_UNESCAPED_UNICODE) ?>);
          row.setAttribute('data-bound', '1');
          var badge = row.querySelector('[data-row-badge]');
          if (badge) {
            badge.setAttribute('data-tone', 'success');
            badge.textContent = <?= json_encode((string)__('可履约'), JSON_UNESCAPED_UNICODE) ?>;
          }
          bindBtn.textContent = <?= json_encode((string)__('改绑'), JSON_UNESCAPED_UNICODE) ?>;
          return;
        }
        themeToast('error', msg || <?= json_encode((string)__('绑定失败'), JSON_UNESCAPED_UNICODE) ?>);
      })
      .catch(function () {
        themeToast('error', <?= json_encode((string)__('绑定失败'), JSON_UNESCAPED_UNICODE) ?>);
      })
      .finally(function () { bindBtn.disabled = false; });
  });

  if (btn) {
    btn.addEventListener('click', function () {
      var url = String(btn.getAttribute('data-pull-url') || '');
      var code = String(provider.value || '');
      if (!url) { return; }
      if (!code) {
        themeToast('warning', <?= json_encode((string)__('请先选择左侧货源'), JSON_UNESCAPED_UNICODE) ?>);
        return;
      }
      var body = new FormData();
      body.append('provider_code', code);
      appendCsrf(body);
      btn.disabled = true;
      fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          var msg = (res && res.message) ? String(res.message) : '';
          if (res && res.success) {
            themeToast('success', msg || <?= json_encode((string)__('已拉取远程仓'), JSON_UNESCAPED_UNICODE) ?>);
            window.location.reload();
            return;
          }
          themeToast('error', msg || <?= json_encode((string)__('拉取失败'), JSON_UNESCAPED_UNICODE) ?>);
        })
        .catch(function () {
          themeToast('error', <?= json_encode((string)__('拉取失败'), JSON_UNESCAPED_UNICODE) ?>);
        })
        .finally(function () { btn.disabled = false; });
    });
  }

  if (syncBtn) {
    syncBtn.addEventListener('click', function () {
      var url = String(syncBtn.getAttribute('data-sync-url') || '');
      var code = String(provider.value || '');
      if (!url) { return; }
      if (!code) {
        themeToast('warning', <?= json_encode((string)__('请先选择左侧货源'), JSON_UNESCAPED_UNICODE) ?>);
        return;
      }
      var scopeVal = scopeValue() || bootScope;
      if (!scopeVal || scopeVal === 'default.default.default') {
        themeToast('warning', <?= json_encode((string)__('请先选择具体网站（不能使用 Global）'), JSON_UNESCAPED_UNICODE) ?>);
        return;
      }
      var body = new FormData();
      body.append('provider_code', code);
      body.append('target_scope', scopeVal);
      appendCsrf(body);
      syncBtn.disabled = true;
      fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          var msg = (res && res.message) ? String(res.message) : '';
          if (res && res.success) {
            themeToast('success', msg || <?= json_encode((string)__('已按国家配对'), JSON_UNESCAPED_UNICODE) ?>);
            window.location.reload();
            return;
          }
          themeToast('error', msg || <?= json_encode((string)__('配对失败'), JSON_UNESCAPED_UNICODE) ?>);
        })
        .catch(function () {
          themeToast('error', <?= json_encode((string)__('配对失败'), JSON_UNESCAPED_UNICODE) ?>);
        })
        .finally(function () { syncBtn.disabled = false; });
    });
  }
})();</script>
