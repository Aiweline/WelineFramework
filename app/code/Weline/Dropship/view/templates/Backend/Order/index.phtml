<script>
(function ensureOrderAccordion() {
  var panel = document.querySelector('[data-dropship-order-accordion="1"]');
  if (!panel) return;
  function boot() {
    if (panel.getAttribute('data-order-accordion-ready') === '1') return true;
    if (window.WelineDropshipOrderAccordion && typeof window.WelineDropshipOrderAccordion.boot === 'function') {
      window.WelineDropshipOrderAccordion.boot();
      return panel.getAttribute('data-order-accordion-ready') === '1';
    }
    return false;
  }
  if (boot()) return;
  var src = '/Weline/Dropship/view/statics/backend/order-accordion.js?v=1.0.69';
  var existing = document.querySelector('script[data-dropship-order-accordion-src]');
  if (existing) {
    existing.addEventListener('load', function () { boot(); });
    setTimeout(boot, 50);
    return;
  }
  var s = document.createElement('script');
  s.src = src;
  s.async = true;
  s.setAttribute('data-dropship-order-accordion-src', '1');
  s.onload = function () { boot(); };
  s.onerror = function () {
    console.warn('[Dropship] order-accordion.js load failed', src);
  };
  document.head.appendChild(s);
  setTimeout(boot, 1200);
})();
</script>
