<script>
(function () {
    function openCredDialog() {
        var list = document.querySelector('[data-dropship-admin="channels"]');
        var openCode = list ? String(list.getAttribute('data-cred-dialog') || '').trim() : '';
        if (!openCode) {
            try {
                openCode = String(new URLSearchParams(window.location.search).get('cred_dialog') || '').trim();
            } catch (e) {
                openCode = '';
            }
        }
        if (!openCode) {
            return false;
        }
        var safe = openCode.replace(/[^a-zA-Z0-9_-]+/g, '-');
        var dlg = document.getElementById('dropship-cred-dialog-' + safe);
        if (!dlg) {
            return false;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog && typeof window.Weline.UI.dialog.open === 'function') {
            window.Weline.UI.dialog.open(dlg);
            return dlg.getAttribute('data-state') === 'open';
        }
        return false;
    }
    function bindScopeReload() {
        document.querySelectorAll('[data-testid="dropship-cred-scope"]').forEach(function (wrap) {
            var field = wrap.querySelector('input[type="hidden"][name="target_scope"]')
                || wrap.querySelector('input[name="target_scope"]');
            if (!field || field.dataset.dropshipScopeBound === '1') {
                return;
            }
            field.dataset.dropshipScopeBound = '1';
            var code = String(wrap.getAttribute('data-provider-code') || '').trim();
            field.addEventListener('change', function () {
                var next = String(field.value || '').trim();
                if (!next) {
                    return;
                }
                var url = new URL(window.location.href);
                url.searchParams.set('target_scope', next);
                var parts = next.split('.');
                url.searchParams.set('website_code', parts[0] && parts[0] !== 'default' ? parts[0] : '');
                url.searchParams.set('store_code', parts[1] && parts[1] !== 'default' ? parts[1] : '');
                url.searchParams.set('channel_code', parts[2] && parts[2] !== 'default' ? parts[2] : '');
                if (code) {
                    url.searchParams.set('cred_dialog', code);
                }
                window.location.assign(url.toString());
            });
        });
    }
    function bindProbeButtons() {
        var list = document.querySelector('[data-dropship-admin="channels"]');
        var probeUrl = list ? String(list.getAttribute('data-probe-url') || '').trim() : '';
        if (!probeUrl) {
            return;
        }
        document.querySelectorAll('[data-dropship-probe]').forEach(function (button) {
            if (button.dataset.dropshipProbeBound === '1') {
                return;
            }
            button.dataset.dropshipProbeBound = '1';
            button.addEventListener('click', function () {
                var code = String(button.getAttribute('data-dropship-probe') || '').trim();
                if (!code) {
                    return;
                }
                button.disabled = true;
                var body = new FormData();
                body.append('provider_code', code);
                var notify = function (ok, message) {
                    if (window.Weline && window.Weline.UI && window.Weline.UI.toast) {
                        var toast = window.Weline.UI.toast;
                        if (ok && typeof toast.success === 'function') {
                            toast.success(message);
                            return;
                        }
                        if (!ok && typeof toast.error === 'function') {
                            toast.error(message);
                            return;
                        }
                    }
                    if (window.Weline && window.Weline.UI && window.Weline.UI.dialog && typeof window.Weline.UI.dialog.request === 'function') {
                        window.Weline.UI.dialog.request({
                            tone: ok ? 'success' : 'danger',
                            title: ok ? <?= json_encode((string)__('连接成功'), JSON_UNESCAPED_UNICODE) ?> : <?= json_encode((string)__('连接失败'), JSON_UNESCAPED_UNICODE) ?>,
                            message: message,
                            duration: ok ? 1600 : 0,
                            confirmable: !ok,
                            confirmLabel: <?= json_encode((string)__('知道了'), JSON_UNESCAPED_UNICODE) ?>
                        });
                        return;
                    }
                    window.alert(message);
                };
                // Channel::probe 返回纯 JSON；勿走未注册的 adminRequest('dropship')（会进 catch）。
                fetch(probeUrl, {
                    method: 'POST',
                    body: body,
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('HTTP ' + r.status);
                        }
                        return r.json();
                    })
                    .then(function (res) {
                        var data = (window.Weline && window.Weline.ApiBusiness && typeof window.Weline.ApiBusiness.unwrapBusiness === 'function')
                            ? window.Weline.ApiBusiness.unwrapBusiness(res)
                            : res;
                        var ok = !!(data && data.success);
                        notify(ok, String((data && data.message) || (ok ? <?= json_encode((string)__('连接成功'), JSON_UNESCAPED_UNICODE) ?> : <?= json_encode((string)__('连接失败'), JSON_UNESCAPED_UNICODE) ?>)));
                    })
                    .catch(function () {
                        notify(false, <?= json_encode((string)__('测试连接失败，请稍后重试'), JSON_UNESCAPED_UNICODE) ?>);
                    })
                    .finally(function () {
                        button.disabled = false;
                    });
            });
        });
    }
    function boot(attempt) {
        bindScopeReload();
        bindProbeButtons();
        if (openCredDialog() || attempt >= 20) {
            return;
        }
        window.setTimeout(function () { boot(attempt + 1); }, 100);
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { boot(0); });
    } else {
        boot(0);
    }
})();
</script>
