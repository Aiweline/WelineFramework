        refreshPickCount();
      }
      // 先渲染完再关 loading，避免 e2e/竞态在空表时误判完成
      if (loadingEl) loadingEl.hidden = true;
    }
    var url = panel.getAttribute('data-browse-url') || '';
    if (!url) {
      showState({ success: false, empty_reason: 'error', error: i18n.loadFail, items: [] });
      return;
    }
    if (loadingEl) loadingEl.hidden = false;
    var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
    var abortTimer = ctrl ? setTimeout(function () { try { ctrl.abort(); } catch (e) {} }, 90000) : null;
    fetch(url, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' },
      signal: ctrl ? ctrl.signal : undefined
    })
      .then(function (r) { return r.json(); })
      .then(function (payload) {
        if (abortTimer) clearTimeout(abortTimer);
        if (panel.getAttribute('data-include-categories') === '1') {
          renderCategories((payload && payload.categories) || []);
        }
        showState(payload || {});
      })
      .catch(function () {
        if (abortTimer) clearTimeout(abortTimer);
        if (panel.getAttribute('data-include-categories') === '1') renderCategories([]);
        showState({ success: false, empty_reason: 'error', error: i18n.loadFail, items: [] });
      });
  })();

  refreshPickCount();
  refreshListedCount();

  // 已刊手风琴：内联强制加载（绕过静态 JS 长缓存 / data-weline-load 竞态）
  (function ensureListedAccordion() {
    var panel = document.querySelector('[data-dropship-listed-accordion="1"]');
    if (!panel) return;
    function boot() {
      if (panel.getAttribute('data-listed-accordion-ready') === '1') return true;
      if (window.WelineDropshipListedAccordion && typeof window.WelineDropshipListedAccordion.boot === 'function') {
        window.WelineDropshipListedAccordion.boot();
        return panel.getAttribute('data-listed-accordion-ready') === '1';
      }
      return false;
    }
    if (boot()) return;
    var src = '/Weline/Dropship/view/statics/backend/listed-accordion.js?v=1.0.70';
    var existing = document.querySelector('script[data-dropship-listed-accordion-src]');
    if (existing) {
      existing.addEventListener('load', function () { boot(); });
      setTimeout(boot, 50);
      return;
    }
    var s = document.createElement('script');
    s.src = src;
    s.async = true;
    s.setAttribute('data-dropship-listed-accordion-src', '1');
    s.onload = function () { boot(); };
    s.onerror = function () {
      console.warn('[Dropship] listed-accordion.js load failed', src);
    };
    document.head.appendChild(s);
    // 若 data-weline-load 稍后成功，ready 标记会阻止重复绑定
    setTimeout(boot, 1200);
  })();
})();
</script>
