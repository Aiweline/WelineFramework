<?php
/**
 * 货源商品：选品三栏工作台 / 已刊登（供应商兼容，能力门控）。
 * @var \Weline\Framework\View\Template $this
 */
$activeTab = (string)($this->getData('active_tab') ?? 'listed');
if ($activeTab === 'search') {
    $activeTab = 'pick';
}
if (!in_array($activeTab, ['listed', 'pick'], true)) {
    $activeTab = 'listed';
}
$listings = (array)$this->getData('listings');
$warehouseNames = (array)$this->getData('warehouse_names');
$items = (array)$this->getData('items');
$providerOptions = (array)$this->getData('provider_options');
$selected = (array)$this->getData('selected_sources');
$providerCode = (string)$this->getData('provider_code');
$keyword = (string)$this->getData('keyword');
$countryCode = (string)($this->getData('country_code') ?: 'US');
$categoryId = (string)$this->getData('category_id');
$categories = (array)$this->getData('categories');
$browseEnabled = (bool)$this->getData('browse_enabled');
$browseCountryFilter = (bool)$this->getData('browse_country_filter');
$searchPage = max(1, (int)$this->getData('search_page'));
$searchHasMore = (bool)$this->getData('search_has_more');
$searchError = trim((string)$this->getData('search_error'));
$searchAttempted = (bool)$this->getData('search_attempted');
$emptyReason = (string)($this->getData('search_empty_reason') ?? ($searchAttempted ? 'no_results' : 'idle'));
$browseAsync = (bool)$this->getData('browse_async');
$browseUrl = (string)$this->getData('browse_url');
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$listedUrl = $this->getBackendUrl('dropship/backend/listing/index', ['tab' => 'listed']);
$pickTabUrl = $this->getBackendUrl('dropship/backend/listing/index', ['tab' => 'pick']);
$admitUrl = $this->getBackendUrl('dropship/backend/listing/admitDraft');
$basketSelectUrl = $this->getBackendUrl('dropship/backend/listing/basketSelect');
$basketCancelUrl = $this->getBackendUrl('dropship/backend/listing/basketCancel');
$publishSelectedUrl = $this->getBackendUrl('dropship/backend/listing/publishSelected');
$deleteSelectedUrl = $this->getBackendUrl('dropship/backend/listing/deleteSelected');
$browseIndexBase = $this->getBackendUrl('dropship/backend/listing/index');
$browseApiBase = $this->getBackendUrl('dropship/backend/listing/browse');
$localDetailUrl = (string)($this->getData('local_detail_url') ?: $this->getBackendUrl('dropship/backend/listing/localDetail'));
$browseBase = static function (array $extra) use ($providerCode, $keyword, $countryCode, $categoryId): array {
    return array_filter([
        'tab' => 'pick',
        'provider_code' => $providerCode,
        'q' => $keyword,
        'country_code' => $countryCode,
        'category_id' => $categoryId,
        ...$extra,
    ], static fn ($v) => $v !== null && $v !== '');
};
$money = static function (int $minor, string $currency = 'USD'): string {
    $currency = strtoupper(trim($currency));
    if ($currency === '') {
        $currency = 'USD';
    }

    return $currency . ' ' . number_format($minor / 100, 2, '.', '');
};
$thumbUrl = static function (array $item): string {
    $media = (array)($item['media'] ?? []);
    foreach ($media as $m) {
        if (!is_array($m)) {
            continue;
        }
        $url = trim((string)($m['url'] ?? ''));
        if ($url !== '' && (str_starts_with($url, 'http://') || str_starts_with($url, 'https://'))) {
            return $url;
        }
    }

    return '';
};
$providerTitle = $providerCode;
foreach ($providerOptions as $opt) {
    if ((string)($opt['code'] ?? '') === $providerCode) {
        $t = trim((string)($opt['title'] ?? ''));
        if ($t !== '') {
            $providerTitle = $t;
        }
        break;
    }
}
$categoryTitle = '';
if ($categoryId === '') {
    $categoryTitle = (string)__('全部');
} else {
    foreach ($categories as $cat) {
        if ((string)($cat['id'] ?? '') === $categoryId) {
            $categoryTitle = trim((string)($cat['name'] ?? $cat['path'] ?? $categoryId));
            break;
        }
    }
    if ($categoryTitle === '') {
        $categoryTitle = $categoryId;
    }
}
$categoryIsTree = false;
foreach ($categories as $cat) {
    $parent = trim((string)($cat['parent_id'] ?? ''));
    if ($parent !== '') {
        $categoryIsTree = true;
        break;
    }
}
