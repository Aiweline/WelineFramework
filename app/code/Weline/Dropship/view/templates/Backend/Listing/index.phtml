<script>
(function () {
  var root = document.querySelector('[data-dropship-admin="listings"]');
  if (!root) return;
  var modal = document.getElementById('dropship-publish-modal');
  var modalClose = document.getElementById('modal-close');
  var modalSnaps = document.getElementById('modal-snapshots-json');
  var modalProvider = document.getElementById('modal-provider');

  function selectedPickSnapshots() {
    var out = [];
    root.querySelectorAll('.ds-pick-check:checked').forEach(function (el) {
      try { out.push(JSON.parse(el.getAttribute('data-snapshot') || '{}')); } catch (e) {}
    });
    return out;
  }

  function operableChecks() {
    return root.querySelectorAll('.ds-pick-check');
  }

  function toastMsg(ok, msg) {
    if (window.Weline && Weline.UI && typeof Weline.UI.toast === 'function') {
      Weline.UI.toast({ tone: ok ? 'success' : 'danger', message: msg || '' });
      return;
    }
    if (msg) alert(msg);
  }

  function appendCsrf(body) {
    if (window.site && window.site.csrf_token) body.append('csrf_token', String(window.site.csrf_token));
    var csrf = document.querySelector('input[name="csrf_token"], input[name="form_key"]');
    if (csrf && csrf.value) body.append(csrf.name, csrf.value);
  }

  function markRowState(spu, st) {
    var tr = root.querySelector('tr[data-spu="' + String(spu).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"]');
    if (!tr) {
      tr = Array.prototype.find.call(root.querySelectorAll('tr[data-spu]'), function (node) {
        return node.getAttribute('data-spu') === spu;
      }) || null;
    }
    if (!tr) return;
    var locked = !!(st && st.locked);
    var basket = !!(st && st.in_basket) && !locked;
    tr.setAttribute('data-pull-locked', locked ? '1' : '0');
    tr.setAttribute('data-pull-basket', basket ? '1' : '0');
    var statusCell = tr.querySelector('.ds-pick-status-cell');
    var checkTd = tr.children[0];
    var snap = tr.getAttribute('data-snapshot') || '{}';
    // 已拉取 / 已入列表：禁止勾选（与 locked 同无 checkbox）
    if (locked || basket) {
      if (checkTd) checkTd.innerHTML = '<span class="w-text" data-tone="muted" data-size="sm">—</span>';
      if (statusCell) {
        statusCell.innerHTML = locked
          ? ('<span class="ds-pick-status" data-tone="locked" data-testid="dropship-pull-locked">' +
            <?= json_encode((string)__('已拉取'), JSON_UNESCAPED_UNICODE) ?> + '</span>')
          : ('<button type="button" class="ds-pick-status" data-action="basket-cancel" data-testid="dropship-pull-basket" title="' +
            <?= json_encode((string)__('点击移出货源列表'), JSON_UNESCAPED_UNICODE) ?> + '">' +
            <?= json_encode((string)__('已入列表'), JSON_UNESCAPED_UNICODE) ?> + '</button>');
      }
      return;
    }
    var existing = tr.querySelector('.ds-pick-check');
    if (!existing && checkTd) {
      checkTd.innerHTML = '';
      var input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'ds-pick-check';
      input.setAttribute('data-spu', spu);
      input.setAttribute('data-snapshot', snap);
      checkTd.appendChild(input);
      existing = input;
    }
    if (existing) {
      existing.checked = false;
      existing.disabled = false;
      existing.setAttribute('data-snapshot', snap);
    }
    if (statusCell) {
      statusCell.innerHTML = '<span class="w-text" data-tone="muted" data-size="sm">—</span>';
    }
  }

  function applyStateMap(state) {
    if (!state || typeof state !== 'object') return;
    Object.keys(state).forEach(function (spu) {
      markRowState(spu, state[spu]);
    });
    refreshPickCount();
  }

  function postBasket(url, snapshots) {
    var form = document.getElementById('dropship-admit-form');
    if (!form || !url) return Promise.resolve(null);
    var body = new FormData();
    body.append('provider_code', form.querySelector('[name="provider_code"]').value || '');
    body.append('country_code', form.querySelector('[name="country_code"]').value || '');
    body.append('category_id', form.querySelector('[name="category_id"]').value || '');
    body.append('snapshots_json', JSON.stringify(snapshots || []));
    appendCsrf(body);
    return fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .catch(function () { return { success: false, message: 'network_error' }; });
  }

  function refreshPickCount() {
    var n = root.querySelectorAll('.ds-pick-check:checked').length;
    var label = root.querySelector('#pick-sel-count');
    if (label) label.textContent = <?= json_encode((string)__('已选'), JSON_UNESCAPED_UNICODE) ?> + ' ' + n;
    var floatBar = document.getElementById('dropship-pick-float');
    if (floatBar) floatBar.hidden = n === 0;
    var selBtn = document.getElementById('pick-float-select');
    var cancelBtn = document.getElementById('pick-float-cancel');
    var pub = document.getElementById('pick-open-publish');
    // 已入列表不可勾选：悬浮「取消选择」仅清空当前勾选；移出列表点「已入列表」徽章
    if (selBtn) selBtn.disabled = n === 0;
    if (cancelBtn) cancelBtn.disabled = n === 0;
    if (pub) pub.disabled = n === 0;
  }

  function refreshListedCount() {
    var checks = root.querySelectorAll('.ds-listed-check:checked');
    var n = checks.length;
    var label = root.querySelector('[data-testid="listed-sel-count"]');
    if (label) label.textContent = <?= json_encode((string)__('已选'), JSON_UNESCAPED_UNICODE) ?> + ' ' + n;
    var pending = 0;
    var providers = {};
    checks.forEach(function (el) {
      if ((el.getAttribute('data-sync') || '') === 'pending') {
        pending++;
        providers[el.getAttribute('data-provider') || ''] = true;
      }
    });
    var btn = document.getElementById('listed-open-publish');
    if (btn) btn.disabled = pending === 0;
    var delBtn = document.getElementById('listed-open-delete');
    if (delBtn) delBtn.disabled = n === 0;
    var keys = Object.keys(providers).filter(Boolean);
    var hidden = document.getElementById('listed-publish-provider');
    if (hidden) hidden.value = keys.length === 1 ? keys[0] : '';
  }

  var pickLayout = root.querySelector('[data-testid="dropship-pick-layout"]');
  var toggleFilters = document.getElementById('dropship-toggle-filters');
  var keyRail = 'dropship.pick.railCollapsed';
  var keyCats = 'dropship.pick.catsCollapsed';
  var keyLegacy = 'dropship.pick.filtersCollapsed';
