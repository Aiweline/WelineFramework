<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Order::order_paid">
        <observer name="weline_dropship_order_paid"
                  instance="Weline\Dropship\Observer\OrderPaidObserver"
                  disabled="false" shared="true" sort="120"/>
    </event>
    <event name="Weline_Order::order_cancelled">
        <observer name="weline_dropship_order_cancelled"
                  instance="Weline\Dropship\Observer\OrderCancelledObserver"
                  disabled="false" shared="true" sort="120"/>
    </event>
    <event name="Weline_Order::order_refunded">
        <observer name="weline_dropship_order_refunded"
                  instance="Weline\Dropship\Observer\OrderRefundedObserver"
                  disabled="false" shared="true" sort="120"/>
    </event>
    <event name="Weline_Dropship::push_terminal">
        <observer name="weline_dropship_push_terminal_refund"
                  instance="Weline\Dropship\Observer\DropshipPushTerminalRefundObserver"
                  disabled="false" shared="true" sort="100"/>
    </event>
    <event name="Weline_Checkout::checkout::shipping_quote::overlay">
        <observer name="weline_dropship_checkout_shipping_quote_overlay"
                  instance="Weline\Dropship\Observer\CheckoutShippingQuoteOverlayObserver"
                  disabled="false" shared="false" sort="100"/>
    </event>
    <event name="Weline_Checkout::checkout::shipping_methods::enrich">
        <observer name="weline_dropship_checkout_shipping_methods_enrich"
                  instance="Weline\Dropship\Observer\CheckoutShippingMethodsEnrichObserver"
                  disabled="false" shared="false" sort="100"/>
    </event>
</config>
