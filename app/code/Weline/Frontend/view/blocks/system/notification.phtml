<?php
/** @var \Weline\Framework\View\Template $this */
$block = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Frontend\Block\System\Notification::class);
$notices = $block->getNotices();
?>
<div class="w-frontend-notifications" data-w-component="menu" data-w-placement="bottom-end">
    <button class="w-button" data-tone="quiet" data-size="sm" type="button" data-w-menu-trigger aria-expanded="false" aria-controls="w-frontend-notification-menu" aria-label="<?= htmlspecialchars((string)__('通知'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="bell" /></button>
    <div id="w-frontend-notification-menu" class="w-menu w-frontend-notifications__menu" data-w-menu-panel role="menu" hidden>
        <?php if ($notices === []): ?><div class="w-empty-state"><p><?= htmlspecialchars((string)__('暂无通知'), ENT_QUOTES, 'UTF-8') ?></p></div><?php endif; ?>
        <?php foreach ($notices as $notice): ?>
            <div class="w-menu__item" role="menuitem" tabindex="0"><w:icon name="bell" size="sm" /><span class="w-stack"><strong><?= htmlspecialchars((string)$notice->getTitle(), ENT_QUOTES, 'UTF-8') ?></strong><span><?= htmlspecialchars(strip_tags((string)$notice->getContent()), ENT_QUOTES, 'UTF-8') ?></span><small><?= htmlspecialchars((string)$notice->getCreateTime(), ENT_QUOTES, 'UTF-8') ?></small></span></div>
        <?php endforeach; ?>
    </div>
</div>
