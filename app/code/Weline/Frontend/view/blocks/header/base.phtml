<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\App\Env;
use Weline\Framework\App\State;
use Weline\Framework\Deploy\DeployPublicUrlMode;
use Weline\Framework\Session\SessionFactory;
use Weline\Framework\Session\SessionCookieNameResolver;
use Weline\Framework\View\PublicStaticUrl;

$host = rtrim((string)$this->request->getBaseHost(), '/');
$baseRouter = (string)$this->request->getRouterData('router');
$currentModule = (string)$this->request->getModuleName();
$hasSessionCookie = false;
try {
    $hasSessionCookie = SessionCookieNameResolver::hasRequestCookie();
} catch (\Throwable) {
    // A malformed or incomplete request context must not make the public shell fail.
}
$session = null;
$userId = 0;
if ($hasSessionCookie) {
    $session = SessionFactory::frontend();
    $userId = (int)$session->getLoginUserID();
}
$csrfToken = '';
if ($hasSessionCookie) {
    $csrfToken = (string)\Weline\Framework\Security\Token::create('csrf', 16, 600);
}
$apiHost = rtrim((string)$this->request->getUrlBuilder()->getFrontendApiUrl('/', [], false), '/');
$currentLang = (string)(\Weline\Framework\Env\WelineEnv::getLang() ?: 'zh_Hans_CN');
$currentCurrency = strtoupper(trim((string)(\Weline\Framework\Env\WelineEnv::getCurrency() ?: 'CNY')));
$defaultLang = (string)(\w_env('website.language', '') ?: Env::get('locale', Env::get('lang', 'zh_Hans_CN')) ?: 'zh_Hans_CN');
$defaultCurrency = strtoupper(trim((string)(\w_env('website.currency', '') ?: Env::get('currency', 'CNY')))) ?: 'CNY';
$availableCurrencies = [];
try {
    $availableCurrencies = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Framework\App\Localization\LocalizationProviderRegistry::class
    )->preferredCurrencyCodes();
} catch (\Throwable) {
    $availableCurrencies = [];
}
$availableCurrencies = array_values(array_unique(array_filter(array_map(
    static fn ($code): string => strtoupper(trim((string)$code)),
    is_array($availableCurrencies) ? $availableCurrencies : []
), static fn (string $code): bool => $code !== '' && preg_match('/^[A-Z]{3}$/', $code) === 1)));
if ($availableCurrencies === []) {
    $availableCurrencies = array_values(array_unique(array_filter([$currentCurrency, $defaultCurrency])));
}
$themePath = str_replace('\\', '/', (string)(Env::getInstance()->getTheme()['path'] ?? ''));
$useProdPublicUrls = DeployPublicUrlMode::useProduction();
$mediaTemplate = $host . '/' . (!$useProdPublicUrls
    ? '{module}/view/statics/{path}'
    : 'static/' . trim($themePath, '/') . '/{module}/view/statics/{path}');
// Client JS dictionary is no longer embedded in head — footer loads
// Weline_I18n::i18n-client/{area}/{locale}.js into Weline.i18n (ClientI18nBagPublisher).
$deployMeta = @json_decode((string)@file_get_contents(BP . 'var/deploy/current.json'), true);
$deployVersion = is_array($deployMeta) ? (string)($deployMeta['deploy_version'] ?? '') : '';
$workerBuildId = is_array($deployMeta) ? (string)($deployMeta['worker_build_id'] ?? '') : '';
// PROD 禁止沿用粘滞的 deploy_version=dev（会把 FPC 钉死在旧 ?v=dev-* 与烤死的 DEV 模块路径上）。
if (!$useProdPublicUrls) {
    if ($deployVersion === '') {
        $deployVersion = 'dev';
    }
    if ($workerBuildId === '') {
        $workerBuildId = 'dev';
    }
} else {
    if ($deployVersion === '' || strcasecmp($deployVersion, 'dev') === 0) {
        $deployVersion = 'prod';
    }
    if ($workerBuildId === '' || strcasecmp($workerBuildId, 'dev') === 0) {
        $workerBuildId = 'prod';
    }
}
$themePublishedVersionId = '';
$themePublishedVersion = '';
try {
    if (class_exists(\Weline\Theme\Service\ThemePublishedVersionRuntimeResolver::class)) {
        /** @var \Weline\Theme\Service\ThemePublishedVersionRuntimeResolver $themeVersionResolver */
        $themeVersionResolver = \Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Theme\Service\ThemePublishedVersionRuntimeResolver::class
        );
        $themeVersions = $themeVersionResolver->resolve();
        $themePublishedVersionId = (string)($themeVersions['themePublishedVersionId'] ?? '');
        $themePublishedVersion = (string)($themeVersions['themePublishedVersion'] ?? '');
    }
} catch (\Throwable) {
}
$workerUrl = PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/js/weline-api-worker.js');
$workerJsMtime = @filemtime(BP . 'app/code/Weline/Frontend/view/statics/js/weline-api-worker.js');
$workerUrl .= (str_contains($workerUrl, '?') ? '&' : '?') . 'v=' . rawurlencode($deployVersion . '-' . $workerBuildId . ($workerJsMtime ? ('-' . (string)$workerJsMtime) : ''));
// Bust lazy-loaded Weline.Api / Account / Theme widgets when source changes
// (local deploy_version is often sticky "dev" and would keep an old mini-cart.js).
$apiJsMtime = @filemtime(BP . 'app/code/Weline/Frontend/view/statics/js/weline-api.js');
$accountJsMtime = @filemtime(BP . 'app/code/Weline/Customer/view/statics/js/account-session.js');
$welineJsMtime = @filemtime(BP . 'app/code/Weline/Frontend/view/statics/js/weline.js');
$miniCartJsMtime = @filemtime(BP . 'app/code/Weline/Theme/view/statics/js/widgets/mini-cart-icon.js');
$miniCartCssMtime = @filemtime(BP . 'app/code/Weline/Theme/view/statics/css/widgets/mini-cart-drawer.css');
$miniCartQtyHitCssMtime = @filemtime(BP . 'app/code/Weline/Cart/view/statics/css/mini-cart-drawer-qty-hit.css');
$frontendJsMtime = max(
    (int)$apiJsMtime,
    (int)$accountJsMtime,
    (int)$welineJsMtime,
    (int)$miniCartJsMtime,
    (int)$miniCartCssMtime,
    (int)$miniCartQtyHitCssMtime,
    (int)$workerJsMtime
);
$staticBuildId = '';
try {
    $staticBuildId = \Weline\Framework\Deploy\StaticBuildId::current();
} catch (\Throwable) {
}
// 页面世代：主题 code + 发布版本号 + 部署构建号；Theme 侧不可用时退回部署构建号。
$pageGeneration = $staticBuildId;
try {
    if (class_exists(\Weline\Theme\Service\ThemeUpdate\ThemeUpdateRuntime::class)) {
        $pageGeneration = \Weline\Theme\Service\ThemeUpdate\ThemeUpdateRuntime::pageGeneration();
    }
} catch (\Throwable) {
}
$frontendAssetVersion = $staticBuildId !== ''
    ? $pageGeneration
    : ($deployVersion . ($frontendJsMtime > 0 ? ('-' . (string)$frontendJsMtime) : ''));
$modulesJsMtime = @filemtime(BP . 'app/code/Weline/Frontend/view/statics/base/weline.modules.js');
$modulesConfigUrl = PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/base/weline.modules.js');
if ($modulesJsMtime) {
    $modulesConfigUrl .= (str_contains($modulesConfigUrl, '?') ? '&' : '?') . 'v=' . rawurlencode((string)$modulesJsMtime);
}
// Keep the Worker endpoint on the current Website mount so its trusted binding
// refines the same Website navigation Scope rather than the host default.
// Root-relative only: absolute Origin breaks Weline.Api same-origin (e2e proxy / Host 切换).
$queryBinUrl = \Weline\Framework\Http\Url::toDocumentRootRelative(
    (string)\Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Http\Url::class)->getFrontendApiUrl('framework/query-bin', [], false)
);
$cacheCatalog = [];
try {
    $cacheCatalog = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Framework\Service\Query\BinQueryCacheCatalogExporter::class
    )->exportFrontendCatalog();
} catch (\Throwable) {
    $cacheCatalog = [];
}
if (!is_array($cacheCatalog)) {
    $cacheCatalog = [];
}
$scopeMeta = [];
try {
    $scopeMeta = \Weline\Framework\Runtime\RequestContext::scopeMetadata() ?? [];
} catch (\Throwable) {
    $scopeMeta = [];
}
if (!is_array($scopeMeta)) {
    $scopeMeta = [];
}
$runtime = [
    'env' => [
        'WELINE_ENV' => $useProdPublicUrls ? 'PROD' : 'DEV',
        'DEV' => !$useProdPublicUrls,
        'PROD' => $useProdPublicUrls,
        'useProductionPublicUrls' => $useProdPublicUrls,
    ],
    'area' => 'frontend',
    // baseUrl：在下方 JSON 用 url 标签注入根路径（禁止 PHP 赋 url 标签字符串 / getBaseUrl）
    'modulesConfigUrl' => $modulesConfigUrl,
    'modulesBaseUrl' => PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/js/weline-api'),
    'miniCartDrawerCss' => PublicStaticUrl::fromDevWebPath('/Weline/Theme/view/statics/css/widgets/mini-cart-drawer.css'),
    'miniCartQtyHitCss' => PublicStaticUrl::fromDevWebPath('/Weline/Cart/view/statics/css/mini-cart-drawer-qty-hit.css'),
    'storefrontPlaceholderUrl' => PublicStaticUrl::fromDevWebPath('/Weline/Theme/view/statics/images/storefront-placeholder/default.svg'),
    'assetVersion' => $frontendAssetVersion,
    'staticBaseUrl' => $staticBuildId !== '' ? '/static/' . $staticBuildId : '',
    'deployVersion' => $deployVersion,
    'workerBuildId' => $workerBuildId,
    'themePublishedVersionId' => $themePublishedVersionId,
    'themePublishedVersion' => $themePublishedVersion,
    'currentLang' => $currentLang,
    'currentCurrency' => $currentCurrency,
    'defaultLang' => $defaultLang,
    'defaultCurrency' => $defaultCurrency,
    'availableCurrencies' => $availableCurrencies,
    'debug' => DEV,
    'api' => [
        'workerUrl' => $workerUrl,
        'endpoint' => $queryBinUrl,
        'queryBinUrl' => $queryBinUrl,
        // Mirror root stamps into api so mergeApiConfig() alone cannot fall back to "dev"
        // or drop themePublishedVersionId (SharedWorker handshake → QueryBin 409).
        'deployVersion' => $deployVersion,
        'workerBuildId' => $workerBuildId,
        'themePublishedVersionId' => $themePublishedVersionId,
        'themePublishedVersion' => $themePublishedVersion,
        'locale' => $currentLang,
        'currency' => $currentCurrency,
        'availableCurrencies' => $availableCurrencies,
        'defaultCurrency' => $defaultCurrency,
        'cacheCatalog' => $cacheCatalog,
        'website_id' => (int)($scopeMeta['website_id'] ?? 0),
        'store_id' => (int)($scopeMeta['store_id'] ?? 0),
        'channel_id' => (int)($scopeMeta['channel_id'] ?? 0),
        // Soft Scope wait tip: server-localized (not page i18n bag) — first paint before bootstrap tips cache.
        'softTips' => [
            'scope_bootstrap_waiting' => \Weline\Frontend\Helper\FrontendScopeReloadTip::build('scope_bootstrap_waiting'),
        ],
        // Float-edge a11y: published slots may bake Chinese attrs; client overlays these.
        'floatEdge' => (static function () use ($currentLang): array {
            $sources = ['收起悬浮', '展开悬浮'];
            try {
                \Weline\Framework\Phrase\Parser::prefetchWords($sources, (string)$currentLang);
            } catch (\Throwable) {
            }
            $dismiss = '';
            $recall = '';
            try {
                $dismiss = \trim((string)__('收起悬浮'));
                $recall = \trim((string)__('展开悬浮'));
            } catch (\Throwable) {
            }
            $isZh = (bool)\preg_match('/^zh(_|-|$)/i', (string)$currentLang);
            if (!$isZh) {
                if ($dismiss === '' || $dismiss === '收起悬浮') {
                    $dismiss = 'Collapse float';
                }
                if ($recall === '' || $recall === '展开悬浮') {
                    $recall = 'Expand float';
                }
            }

            return [
                'dismiss' => $dismiss !== '' ? $dismiss : 'Collapse float',
                'recall' => $recall !== '' ? $recall : 'Expand float',
                'locale' => (string)$currentLang,
            ];
        })(),
    ],
    'url' => [
        'origin' => $host,
        'frontendHost' => $host,
        'apiHost' => $apiHost,
        'baseRouter' => $baseRouter,
        'defaultLocale' => $defaultLang,
        'defaultCurrency' => $defaultCurrency,
    ],
    'i18n' => [
        'locale' => $currentLang,
        'area' => 'frontend',
    ],
    'site' => [
        'user_id' => $userId,
        // The guest shell stays session-free so the response can be published to FPC.
        'csrf_token' => $csrfToken,
        'module' => $currentModule,
        'host' => $host . '/',
        'base_host' => (string)$this->request->getPrePath(),
        'base_router' => $baseRouter,
        'env_model_media_base_path_template' => $mediaTemplate,
        'api_host' => $apiHost,
        'currency' => $currentCurrency,
        'lang' => $currentLang,
    ],
];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
    | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE;
$runtimeJson = json_encode($runtime, $jsonFlags);
if (!is_string($runtimeJson) || $runtimeJson === '' || $runtimeJson[0] !== '{') {
    $runtimeJson = '{}';
}
$runtimeJsonTailBody = substr($runtimeJson, 1); // drop leading "{"
$canonicalPublicHost = strtolower(trim((string)(
    (Env::getInstance()->getConfig()['wls']['public_host'] ?? '')
)));
$canonicalApexHost = (str_starts_with($canonicalPublicHost, 'www.')
    && strlen($canonicalPublicHost) > 4)
    ? substr($canonicalPublicHost, 4)
    : '';
?>
<?php if ($canonicalApexHost !== ''): ?>
<script>
(function () {
    var canonical = <?= json_encode($canonicalPublicHost, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var apex = <?= json_encode($canonicalApexHost, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var host = String((location && location.hostname) || '').toLowerCase();
    if (!canonical || !apex || host !== apex) {
        return;
    }
    // Apex HTML must not boot query-bin (redirect:manual → opaque → WQB1 toast).
    location.replace(location.protocol + '//' + canonical + location.pathname + location.search + location.hash);
})();
</script>
<?php endif; ?>
<?php
/**
 * Weline 启动桩（inline，必须早于下面所有 defer 脚本）。
 *
 * 把 `Weline.declare` / `load` / `preLoad` / `mount` / `dom.observe` 在真正实现到位前的
 * 调用排进 `Weline.__bootQueue`，由 weline.js 初始化后统一回放 —— 这样下面这些核心脚本
 * 才能全部 `defer`（body 内联脚本会在解析期同步调用它们）。
 *
 * 放在本文件（所有主题共用的 header base）而不是主题 head 局部：defer 脚本由本文件发出，
 * 桩必须与之同处一地，否则不覆盖这些 head 局部的主题会在解析期报 TypeError。
 */
$welineBootDev = defined('DEV') ? (bool)DEV : null;
?>
<script data-weline-boot-stub="1">
(function (window) {
    'use strict';
    if (!window) { return; }
    if (window.Weline && window.Weline.__initialized) { return; }
    var W = window.Weline = window.Weline || {};
    if (W.__bootStubInstalled) { return; }
    W.__bootStubInstalled = true;
<?php if ($welineBootDev !== null): ?>
    if (typeof window.DEV === 'undefined') { window.DEV = <?= $welineBootDev ? 'true' : 'false' ?>; }
    if (typeof window.PROD === 'undefined') { window.PROD = !window.DEV; }
    if (typeof window.WELINE_ENV === 'undefined') { window.WELINE_ENV = window.DEV ? 'DEV' : 'PROD'; }
<?php endif; ?>
    var queue = W.__bootQueue = W.__bootQueue || [];
    function enqueue(api, args) {
        return new Promise(function (resolve, reject) {
            queue.push({ api: api, args: Array.prototype.slice.call(args), resolve: resolve, reject: reject });
        });
    }
    function install(apiPath) {
        var parts = apiPath.split('.');
        var host = W;
        for (var i = 0; i < parts.length - 1; i++) { host = host[parts[i]] = host[parts[i]] || {}; }
        var name = parts[parts.length - 1];
        if (typeof host[name] === 'function') { return; }
        var stubFn = function () { return enqueue(apiPath, arguments); };
        stubFn.__welineBootStub = true;
        host[name] = stubFn;
    }
    ['declare', 'load', 'preLoad', 'mount', 'observeMutationsCoalesced'].forEach(install);
    W.dom = W.dom || {};
    ['observe', 'observeMutations'].forEach(function (api) { install('dom.' + api); });
})(window);
</script>
<script type="application/json" id="weline-frontend-runtime-config" data-weline-runtime-config>{"baseUrl":"@url{'/'}",<?= $runtimeJsonTailBody ?></script>
<?php
// 生产：4 个启动依赖合并为 weline-core.js，head 外链 -3；DEV 仍逐文件加载便于调试。
$welineCoreAvailable = \is_file(PUB . 'static/Weline/Frontend/js/weline-core.js');
$welineCoreProd = $useProdPublicUrls && $welineCoreAvailable;
if ($welineCoreProd):
    $welineCoreSrc = PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/js/weline-core.js');
    $welineCoreSrc .= (str_contains($welineCoreSrc, '?') ? '&' : '?') . 'v=' . rawurlencode((string)$frontendAssetVersion);
    ?>
<script defer src="<?= htmlspecialchars($welineCoreSrc, ENT_QUOTES) ?>"></script>
<?php else: ?>
<js defer>Weline_Frontend::js/runtime.js</js>
<js defer>Weline_Framework::js/dom-observer.js</js>
<js defer>Weline_Frontend::js/weline-api-business.js</js>
<?php endif; ?>
<?php
// Bust sticky theme_static_version so weline.js edits are not stuck in WLS static cache.
$welineJsSrc = PublicStaticUrl::fromDevWebPath('/Weline/Frontend/view/statics/js/weline.js');
$welineJsSrc .= (str_contains($welineJsSrc, '?') ? '&' : '?') . 'v=' . rawurlencode((string)$frontendAssetVersion);
?>
<?php // defer：早期调用（declare/load/dom.observe）由 head 的 weline-boot-stub 排队，本文件初始化后回放 ?>
<script defer src="<?= htmlspecialchars($welineJsSrc, ENT_QUOTES) ?>"></script>
