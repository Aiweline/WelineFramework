<?php
/** @var \Weline\Framework\View\Template $this */

use Weline\Framework\App\Env;
use Weline\Framework\App\State;
use Weline\Framework\Session\SessionFactory;

$host = rtrim((string)$this->request->getBaseHost(), '/');
$baseRouter = (string)$this->request->getRouterData('router');
$currentModule = (string)$this->request->getModuleName();
$session = SessionFactory::frontend();
$userId = (int)$session->getLoginUserID();
$apiHost = rtrim((string)$this->request->getUrlBuilder()->getFrontendApiUrl('/', [], false), '/');
$currentLang = (string)(State::getLang() ?: 'zh_Hans_CN');
$currentCurrency = strtoupper(trim((string)(State::getCurrency() ?: 'CNY')));
$defaultLang = (string)(\w_env('website.language', '') ?: Env::get('locale', Env::get('lang', 'zh_Hans_CN')) ?: 'zh_Hans_CN');
$defaultCurrency = strtoupper(trim((string)(\w_env('website.currency', '') ?: Env::get('currency', 'CNY')))) ?: 'CNY';
$themePath = str_replace('\\', '/', (string)(Env::getInstance()->getTheme()['path'] ?? ''));
$mediaTemplate = $host . '/' . (DEV
    ? '{module}/view/statics/{path}'
    : 'static/' . trim($themePath, '/') . '/{module}/view/statics/{path}');
$i18nWords = \Weline\Framework\Phrase\Parser::getUsedWordsWithTranslations();
if (class_exists(\Weline\I18n\Helper\JsWordsRegistry::class)) {
    try {
        $registeredWords = \Weline\I18n\Helper\JsWordsRegistry::getWordsWithTranslations();
        if (is_array($registeredWords)) {
            $i18nWords = array_merge($i18nWords, $registeredWords);
        }
    } catch (\Throwable) {
    }
}
$deployMeta = @json_decode((string)@file_get_contents(BP . 'var/deploy/current.json'), true);
$deployVersion = is_array($deployMeta) ? (string)($deployMeta['deploy_version'] ?? 'dev') : 'dev';
$workerBuildId = is_array($deployMeta) ? (string)($deployMeta['worker_build_id'] ?? 'dev') : 'dev';
$workerUrl = DEV
    ? '/Weline/Frontend/view/statics/js/weline-api-worker.js'
    : '/static/Weline/Frontend/js/weline-api-worker.js';
$workerUrl .= '?v=' . rawurlencode($deployVersion . '-' . $workerBuildId);
$runtime = [
    'env' => ['WELINE_ENV' => DEV ? 'DEV' : 'PROD', 'DEV' => DEV, 'PROD' => !DEV],
    'area' => 'frontend',
    'baseUrl' => (string)$this->request->getBaseUrl(),
    'modulesConfigUrl' => DEV
        ? '/Weline/Frontend/view/statics/base/weline.modules.js'
        : '/static/Weline/Frontend/base/weline.modules.js',
    'modulesBaseUrl' => DEV
        ? '/Weline/Frontend/view/statics/js/weline-api'
        : '/static/Weline/Frontend/js/weline-api',
    'assetVersion' => $deployVersion,
    'deployVersion' => $deployVersion,
    'workerBuildId' => $workerBuildId,
    'currentLang' => $currentLang,
    'currentCurrency' => $currentCurrency,
    'defaultLang' => $defaultLang,
    'defaultCurrency' => $defaultCurrency,
    'debug' => DEV,
    'api' => [
        'workerUrl' => $workerUrl,
        'endpoint' => Env::getFrontendQueryBinPath(),
        'queryBinUrl' => Env::getFrontendQueryBinPath(),
        'locale' => $currentLang,
        'currency' => $currentCurrency,
        'cartCountCookieKey' => 'weline_cart_item_count',
    ],
    'url' => [
        'origin' => $host,
        'frontendHost' => $host,
        'apiHost' => $apiHost,
        'baseRouter' => $baseRouter,
        'defaultLocale' => $defaultLang,
        'defaultCurrency' => $defaultCurrency,
    ],
    'i18n' => [
        'dictionary' => $i18nWords,
        'close' => (string)__('关闭'),
        'confirm' => (string)__('确定'),
        'cancel' => (string)__('取消'),
        'retry' => (string)__('请重试'),
    ],
    'site' => [
        'user_id' => $userId,
        'csrf_token' => \Weline\Framework\Security\Token::create('csrf', 16, 600),
        'module' => $currentModule,
        'host' => $host . '/',
        'base_host' => (string)$this->request->getPrePath(),
        'base_router' => $baseRouter,
        'env_model_media_base_path_template' => $mediaTemplate,
        'api_host' => $apiHost,
        'currency' => $currentCurrency,
        'lang' => $currentLang,
        'i18n' => $i18nWords,
    ],
];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
    | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE;
?>
<script type="application/json" id="weline-frontend-runtime-config" data-weline-runtime-config><?= json_encode($runtime, $jsonFlags) ?: '{}' ?></script>
<js>Weline_Frontend::js/runtime.js</js>
<js>Weline_Frontend::js/weline-api-business.js</js>
<js>Weline_Frontend::js/weline.js</js>
<js>Weline_Framework::js/url-frontend.js</js>
<meta name="weline-worker-frontend-bootstrap-slot" content="">
