<?php
/** @var \Weline\Framework\View\Template $this */
// Document <base> must follow live getFrontendUrl at render time.
// Never mention Taglib URL shorthand in comments: the compiler may rewrite
// those tokens inside // lines, emit a PHP closer, and leak source into HTML.
$frontendRoot = (string)$this->getFrontendUrl('/');
// <base> is origin+path only; query/fragment (e.g. agent pierce) must not become part of base.
$frontendRoot = (string)preg_replace('/[?#].*$/', '', $frontendRoot);
// Root-relative path only — follow the live document Host (never bake absolute Origin).
$frontendRoot = \Weline\Framework\Http\Url::toDocumentRootRelative($frontendRoot);
$storefrontBaseHref = rtrim($frontendRoot, '/') . '/';
?>
<base href="<?= htmlspecialchars($storefrontBaseHref, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<?php // Fonts follow the rendered language: CJK families only on zh/ja/ko pages (theme-spec-gates S7). ?>
