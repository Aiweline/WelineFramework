    }
    #dev-tool-panel .wam-body {
        min-height: 120px;
    }
    #dev-tool-panel .maintenance-advanced-links {
        display: grid;
        gap: 12px;
        padding: 4px 0 8px;
    }
    #dev-tool-panel .maintenance-advanced-links__note {
        margin: 0;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #fde68a;
        background: #fffbeb;
        color: #92400e;
