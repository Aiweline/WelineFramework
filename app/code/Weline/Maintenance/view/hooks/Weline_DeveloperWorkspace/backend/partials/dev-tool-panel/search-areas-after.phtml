<?php
/**
 * Weline_Maintenance - 前台开发面板：高级维护（最右侧一级 Tab + 二级子页）
 * Hook：Weline_DeveloperWorkspace::backend::partials::dev-tool-panel::search-areas-after
 *
 * 一级：高级维护（order 很高，保证在 SEO / 访问事件之后）
 * 二级：维护页预览 + 其他模块通过 WelineAdvancedMaintenance.registerChild 挂入（如 DevRelay）
 *
 * @hook-priority 200
 * @hook-sort-order 100
 * @hook-solo false
 */

use Weline\Maintenance\Service\MaintenanceDevPreview;

if (!MaintenanceDevPreview::isAvailable()) {
    return;
}

$panelType = (string)($panelType ?? 'frontend');
if ($panelType !== 'frontend') {
    return;
}

$previewUrl = MaintenanceDevPreview::URI_MARKER;
$previewApiUrl = MaintenanceDevPreview::apiUrl();
$tabTitle = (string)__('高级维护');
$previewSubTitle = (string)__('维护页');
$hintText = (string)__('DEV 维护与连调入口');
$noteText = (string)__('开发预览：此地址仅在 DEV 环境可用。点击下方链接在新标签页查看维护页，可在预览页内切换语言。');
$openHtmlLabel = (string)__('打开维护页预览');
$openJsonLabel = (string)__('打开 JSON 预览');
?>
<div id="dev-tool-search-area-maintenance-advanced" style="display: none;">
    <div class="maintenance-advanced-toolbar">
        <span class="maintenance-advanced-toolbar__title"><?= htmlspecialchars($tabTitle, ENT_QUOTES, 'UTF-8') ?></span>
        <span class="maintenance-advanced-toolbar__hint"><?= htmlspecialchars($hintText, ENT_QUOTES, 'UTF-8') ?></span>
    </div>
</div>
<style>
    #dev-tool-panel .maintenance-advanced-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-height: 34px;
        font-size: 12px;
        color: #475569;
    }
    #dev-tool-panel .maintenance-advanced-toolbar__title {
        font-weight: 700;
        color: #1e293b;
    }
    #dev-tool-panel .maintenance-advanced-toolbar__hint {
        color: #64748b;
    }
    #dev-tool-panel .wam-shell {
        color: #0f172a;
        font-size: 13px;
    }
    #dev-tool-panel .wam-subtabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 6px;
        margin: 0 0 12px;
        border: 1px solid #d8e1ec;
        border-radius: 8px;
        background: #eef3f8;
    }
    #dev-tool-panel .wam-subtab {
        height: 36px;
