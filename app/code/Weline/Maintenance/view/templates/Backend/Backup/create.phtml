<script>
(function(g){
  if(g.__bqAdmin_maintenance) return;
  g.__bqAdmin_maintenance=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['maintenance']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('maintenance').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
(function() {
    'use strict';
    
    window.MaintenanceBackup = window.MaintenanceBackup || {};
    
    MaintenanceBackup.createBackup = function(event) {
        event.preventDefault();
        
        var submitBtn = document.getElementById('submitBtn');
        var originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="mdi mdi-loading mdi-spin me-2"></i><?= __('创建中...') ?>';

        var formData = new FormData(event.target);
        
        var createUrl = '<?= $this->getBackendUrl('maintenance/backend/backup/create') ?>';
        var createOpts = { method: 'POST', body: formData };
        bqAdmin['maintenance'](createUrl, createOpts)
        .then(function(res) {
            var data = (res && res.data) !== undefined ? res.data : res;
            if (data.success) {
                BackendToast.success(data.message);
                setTimeout(function() {
                    location.href = '<?= $this->getBackendUrl('maintenance/backend/backup/index') ?>';
                }, 1500);
            } else {
                BackendToast.error(data.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        })
        .catch(function(error) {
            BackendToast.error('<?= __('创建备份失败') ?>');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
    };

    var backupForm = document.getElementById('backupForm');
    if (backupForm) {
        backupForm.addEventListener('submit', MaintenanceBackup.createBackup);
    }
})();
</script>
