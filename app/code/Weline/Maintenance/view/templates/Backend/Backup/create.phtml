/**
 * 创建备份页面（内容模板）
 *
 * @var \Weline\Framework\View\Template $this
 */
?>
<!-- 页面标题 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
            <h4 class="w-text" style="--w-mb-sm:0;--w-font-size:1.125rem;"><lang>创建备份</lang></h4>
        </div>
    </div>
</div>

<!-- 消息提示区域 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <template>Weline_Component::message.phtml</template>
    </div>
</div>

<!-- 创建备份表单 -->
<div class="w-grid">
    <div style="--w-span-lg:8;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title" style="--w-mb:var(--weline-space-6);"><lang>备份设置</lang></h4>
                
                <w:form id="backupForm">
                    <div style="--w-mb:var(--weline-space-4);">
                        <label class="w-field__label"><lang>备份类型</lang></label>
                        <select class="w-select" id="backup_type" name="type" required>
                            <option value="full"><lang>完整备份（数据库+代码）</lang></option>
                            <option value="database"><lang>数据库备份</lang></option>
                            <option value="code"><lang>代码备份</lang></option>
                            <option value="config"><lang>配置文件备份</lang></option>
                        </select>
                    </div>

                    <div style="--w-mb:var(--weline-space-4);">
                        <div class="w-alert" data-tone="info">
                            <w:icon name="info" size="sm"></w:icon>
                            <lang>创建备份可能需要几分钟时间，请耐心等待。</lang>
                        </div>
                    </div>

                    <div style="--w-mb:var(--weline-space-4);">
                        <button type="submit" class="w-button" id="submitBtn" data-tone="primary">
                            <w:icon name="save" size="sm"></w:icon><lang>创建备份</lang>
                        </button>
                        <a href="<?= $this->getBackendUrl('maintenance/backend/backup/index') ?>" class="w-button" data-tone="neutral">
                            <lang>返回列表</lang>
                        </a>
                    </div>
                </w:form>
            </div>
        </div>
    </div>
</div>



<script>
(function() {
    'use strict';
    
    window.MaintenanceBackup = window.MaintenanceBackup || {};
    
    MaintenanceBackup.createBackup = function(event) {
        event.preventDefault();
        
        var submitBtn = document.getElementById('submitBtn');
        var originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<w:icon name="circle" size="sm"></w:icon><?= __('创建中...') ?>';

        var formData = new FormData(event.target);
        
        var createUrl = '<?= $this->getBackendUrl('maintenance/backend/backup/create') ?>';
        var createOpts = { method: 'POST', body: formData };
        Weline.adminRequest('maintenance', createUrl, createOpts)
        .then(function(res) {
            var data = (res && res.data) !== undefined ? res.data : res;
            if (data.success) {
                Weline.UI.toast.success(data.message);
                setTimeout(function() {
                    location.href = '<?= $this->getBackendUrl('maintenance/backend/backup/index') ?>';
                }, 1500);
            } else {
                Weline.UI.toast.error(data.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        })
        .catch(function(error) {
            Weline.UI.toast.error('<?= __('创建备份失败') ?>');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
    };

    var backupForm = document.getElementById('backupForm');
    if (backupForm) {
        backupForm.addEventListener('submit', MaintenanceBackup.createBackup);
    }
})();
</script>
