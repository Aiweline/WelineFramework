<?php
/**
 * Standalone maintenance document. It is included directly by MaintenanceInterceptor,
 * so every asset URL is resolved here instead of relying on template post-processing.
 *
 * @var \Weline\Framework\View\Template|null $template
 */

use Weline\Framework\View\Data\DataInterface;

$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$asset = static function (string $source, string $fallback) use ($template): string {
    try {
        if ($template instanceof \Weline\Framework\View\Template) {
            $url = $template->fetchTagSource(DataInterface::dir_type_STATICS, $source);
            if (is_string($url) && $url !== '') {
                return $url;
            }
        }
    } catch (\Throwable) {
    }
    return $fallback;
};

$foundationCss = $asset('Weline_Theme::ui/weline-foundation.css', '/Weline/Theme/view/statics/ui/weline-foundation.css');
$frontendCss = $asset('Weline_Theme::ui/weline-frontend.css', '/Weline/Theme/view/statics/ui/weline-frontend.css');
$pageCss = $asset('Weline_Theme::ui/pages/weline-maintenance.css', '/Weline/Theme/view/statics/ui/pages/weline-maintenance.css');
$uiJs = $asset('Weline_Theme::ui/weline-ui.js', '/Weline/Theme/view/statics/ui/weline-ui.js');
$pageJs = $asset('Weline_Theme::ui/pages/weline-maintenance.js', '/Weline/Theme/view/statics/ui/pages/weline-maintenance.js');
$currentLang = (string)($lang ?? 'zh_Hans_CN');
$currentShort = strtoupper(substr($currentLang, 0, 2));
if (str_starts_with($currentLang, 'zh_Hant')) {
    $currentShort = 'TW';
} elseif (str_starts_with($currentLang, 'zh_Hans')) {
    $currentShort = 'ZH';
}
$languageOptions = [
    'zh_Hans_CN' => '简体中文',
    'en_US' => 'English',
    'zh_Hant_TW' => '繁體中文',
];
