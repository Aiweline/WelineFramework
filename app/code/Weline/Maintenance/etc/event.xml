<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <!-- 
        维护模式拦截器：使用最早的事件时机
        - Weline_Framework::App::pre_route_gate 在 URL/FPC 之前触发
        - 此时没有数据库连接、没有第三方服务请求
        - sort=-999 确保优先于其他观察者执行（如 MediaManager 的 sort=0）
    -->
    <event name="Weline_Framework::App::pre_route_gate">
        <observer name="Weline_Maintenance::interceptor" instance="Weline\Maintenance\Observer\MaintenanceInterceptor" disabled="false" shared="true" sort="-999"/>
    </event>
    <event name="Weline_I18n::locale_catalog_changed">
        <observer name="Weline_Maintenance::locale_catalog_changed" instance="Weline\Maintenance\Observer\LocaleCatalogChangedObserver" disabled="false" shared="true" sort="0"/>
    </event>
    <event name="Weline_Framework_Setup::upgrade_after">
        <observer name="Weline_Maintenance::setup_upgrade_publish_static" instance="Weline\Maintenance\Observer\LocaleCatalogChangedObserver" disabled="false" shared="true" sort="200"/>
    </event>
    <event name="Weline_Framework::resource_changed"
           schema_version="1"
           async_mapper="Weline\Framework\Event\ResourceChange\ResourceChangePayloadMapper"
           data_contract="resource_change.v1">
        <observer name="Weline_Maintenance::config_resource_changed"
                  instance="Weline\Maintenance\Observer\MaintenanceConfigResourceChangedObserver"
                  delivery="async"
                  retry="standard"
                  coalesce="latest"
                  timeout="60"
                  disabled="false"
                  shared="true"
                  sort="120"/>
    </event>
</config>
