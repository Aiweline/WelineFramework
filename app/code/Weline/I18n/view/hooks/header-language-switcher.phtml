<script>
(function(){
    var modal=document.getElementById(<?= \json_encode($languageRequestId, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>);
    if(!modal||modal.dataset.bound==='1'){return;}
    modal.dataset.bound='1';
    var switcher=modal.previousElementSibling;
    var open=switcher?switcher.querySelector('[data-language-request-open]'):null;
    var body=modal.querySelector('[data-language-request-body]');
    var loaded=false,loading=false,returnFocus=null,draft=null;
    function executeScripts(container){
        Array.prototype.slice.call(container.querySelectorAll('script')).forEach(function(oldScript){
            var script=document.createElement('script');
            Array.prototype.slice.call(oldScript.attributes||[]).forEach(function(attribute){script.setAttribute(attribute.name,attribute.value);});
            script.text=oldScript.textContent||'';
            oldScript.parentNode.replaceChild(script,oldScript);
        });
    }
    function restoreDraft(){
        if(!draft){return;}
        var name=body.querySelector('[name=name]'),email=body.querySelector('[name=email]');
        if(name){name.value=String(draft.name||'');}
        if(email){email.value=String(draft.email||'');}
        var select=body.querySelector('.weline-language-select[data-component-id]');
        var id=select?select.getAttribute('data-component-id'):'';
        var component=id&&window.WelineLanguageSelect?window.WelineLanguageSelect[id]:null;
        if(component&&typeof component.setValues==='function'){component.setValues(Array.isArray(draft.locales)?draft.locales:[]);}
        draft=null;
    }
    function renderError(error){
        body.innerHTML='';
        var box=document.createElement('div'),message=document.createElement('p'),retry=document.createElement('button');
        box.className='weline-language-request-retry';
        message.textContent=error&&error.message?error.message:<?= \json_encode($i18nChrome('加载失败，请稍后重试'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>;
        retry.type='button';
        retry.textContent=<?= \json_encode($i18nChrome('重新加载'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>;
        retry.addEventListener('click',function(){load();});
        box.appendChild(message);box.appendChild(retry);body.appendChild(box);
    }
    function load(){
        if(loaded||loading){return;}
        loading=true;
        body.innerHTML='<div class="weline-language-request-loading" role="status">'+<?= \json_encode($i18nChrome('正在加载语言目录与人机验证...'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>+'</div>';
        Promise.resolve(window.Weline&&window.Weline.Api?window.Weline.Api.resource('i18n_language_requests'):Promise.reject(new Error('Weline.Api unavailable')))
            .then(function(api){return api.getLanguageSupportRequestForm({});})
            .then(function(result){
                var markup=result&&result.html?result.html:(result&&result.data&&result.data.html?result.data.html:'');
                if(!markup){throw new Error(<?= \json_encode($i18nChrome('申请表加载失败'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE) ?>);}
                body.innerHTML=markup;executeScripts(body);loaded=true;restoreDraft();
            })
            .catch(renderError)
            .finally(function(){loading=false;});
    }
    function focusable(){
        return Array.prototype.slice.call(modal.querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])'));
    }
    function show(){
        // The request CTA lives inside the language menu that is closed here;
        // restore focus to the visible switcher trigger rather than that now
        // hidden descendant.
        returnFocus=switcher||document.activeElement;
        if(switcher){switcher.classList.remove('weline-choice-open');switcher.setAttribute('aria-expanded','false');}
        modal.hidden=false;
        document.documentElement.style.overflow='hidden';
        var dialog=modal.querySelector('.weline-language-request-dialog');
        if(dialog){dialog.focus();}
        load();
    }
    function close(){
        if(modal.hidden){return;}
        modal.hidden=true;
        document.documentElement.style.overflow='';
        if(returnFocus&&typeof returnFocus.focus==='function'){returnFocus.focus();}
    }
    if(open){open.addEventListener('click',function(event){event.preventDefault();event.stopPropagation();show();});}
    modal.querySelectorAll('[data-language-request-close]').forEach(function(button){button.addEventListener('click',close);});
    modal.addEventListener('weline:captcha:refresh-requested',function(event){draft=event&&event.detail?event.detail:null;loaded=false;load();});
    modal.addEventListener('keydown',function(event){
        if(event.key==='Escape'){event.preventDefault();close();return;}
        if(event.key!=='Tab'){return;}
        var nodes=focusable();
        if(!nodes.length){event.preventDefault();return;}
        var first=nodes[0],last=nodes[nodes.length-1];
        if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}
        else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}
    });
})();
</script>
