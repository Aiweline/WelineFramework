<?php
/**
 * 
 * @hook-priority 50   Hook优先级：50（默认值）
 * @hook-sort-order 0  Hook排序顺序：0（默认值）
 * @hook-solo false    Hook独享：false（不独占）
 */

use Weline\Framework\App\State;
use Weline\Framework\Event\EventsManager;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RequestContext;
use Weline\I18n\Model\I18n;
use Weline\I18n\Service\ActiveLocaleCodeProvider;
use Weline\I18n\Service\LanguageSupportRequestService;
use Weline\Websites\Data\WebsiteData;

/** @var \Weline\Framework\View\Template $this */

// 获取当前语言
$currentLang = State::getLang();
$currentLangLocal = State::getLangLocal();

// 获取 I18n 模型
/** @var I18n $i18n */
$i18n = ObjectManager::getInstance(I18n::class);
$selectorPageSize = 50;
$activeLocaleCodes = [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$normalizeSearchText = static function (array $tokens): string {
    $normalized = [];
    foreach ($tokens as $token) {
        $token = trim(strip_tags((string)$token));
        if ($token === '') {
            continue;
        }
        $key = function_exists('mb_strtolower') ? mb_strtolower($token, 'UTF-8') : strtolower($token);
        $normalized[$key] = $token;
    }

    return implode(' ', array_values($normalized));
};
$shortLocaleCode = static function (string $localeCode): string {
    $parts = explode('_', $localeCode);
    $langDisplay = strtoupper(substr((string)($parts[0] ?? 'ZH'), 0, 2));
    if ($langDisplay === 'ZH' && isset($parts[1]) && strtoupper((string)$parts[1]) === 'HANT') {
        return 'TW';
    }

    return $langDisplay !== '' ? $langDisplay : 'ZH';
};
$sanitizeInlineFlagMarkup = static function (string $markup): string {
    if ($markup === '') {
        return '';
    }

    return (string)preg_replace('/<\\?xml[^?]*\\?>/i', '', $markup);
};
$getLanguageFlag = static function (string $localeCode) use ($i18n, $sanitizeInlineFlagMarkup): string {
    try {
        $flag = (string)($i18n->getCountryFlagWithLocal($localeCode, 24, 18)['flag'] ?? '');
        return $sanitizeInlineFlagMarkup($flag);
    } catch (\Throwable) {
        return '';
    }
};
$parseLocaleCodes = static function (mixed $raw): array {
    if (!\is_array($raw)) {
        return [];
    }
    $codes = [];
    foreach ($raw as $item) {
        if (\is_array($item) && isset($item['code'])) {
            $item = $item['code'];
        }
        if (!\is_scalar($item)) {
            continue;
        }
        $code = \trim((string)$item);
        if ($code === '') {
            continue;
        }
        $codes[\strtolower(\str_replace('-', '_', $code))] = $code;
    }

    return \array_values($codes);
};
$filterLanguagesByCodes = static function (array $languages, array $allowedCodes) use ($parseLocaleCodes): array {
    $allowed = $parseLocaleCodes($allowedCodes);
    if ($allowed === []) {
        return $languages;
    }
    $allowedMap = [];
    foreach ($allowed as $code) {
        $allowedMap[\strtolower(\str_replace('-', '_', $code))] = true;
    }
    $filtered = [];
    foreach ($languages as $language) {
        if (!\is_array($language)) {
            continue;
        }
        $code = \trim((string)($language['code'] ?? ''));
        if ($code === '') {
            continue;
        }
        $key = \strtolower(\str_replace('-', '_', $code));
        if (isset($allowedMap[$key])) {
            $filtered[] = $language;
        }
    }

    return $filtered !== [] ? $filtered : $languages;
};
$templateRequest = $this->request ?? null;
$resolveFrontendWebsiteId = static function () use ($templateRequest): ?int {
    try {
        $id = RequestContext::getWelineWebsiteId();
        if ($id !== null) {
            return (int)$id;
        }
    } catch (\Throwable) {
    }
    try {
        $id = WebsiteData::getWebsiteId();
        if ($id !== null) {
            return (int)$id;
        }
    } catch (\Throwable) {
    }
    try {
        if (\is_object($templateRequest)) {
            return (int)($templateRequest->getData('website_id') ?? 0);
        }
    } catch (\Throwable) {
    }

    return null;
};
$isBackendArea = false;
try {
    $area = \strtolower((string)(RequestContext::area() ?? ''));
    $isBackendArea = $area === 'backend' || $area === 'admin';
} catch (\Throwable) {
    $isBackendArea = false;
}
$frontendWebsiteId = $isBackendArea ? null : $resolveFrontendWebsiteId();
$showLanguageRequest = false;
if (!$isBackendArea) {
    try {
        $showLanguageRequest = ObjectManager::getInstance(LanguageSupportRequestService::class)->enabled();
    } catch (\Throwable) {
        $showLanguageRequest = false;
    }
}
$languageRequestId = 'weline-header-language-request-' . \bin2hex(\random_bytes(6));

// 获取可用语言列表
// 使用 try-catch 避免数据库错误影响页面渲染
try {
    // 后台语言来源：Locals 表里「已安装+已激活」的语言集合（与网站 id 无关）
    /** @var ActiveLocaleCodeProvider $activeLocaleCodeProvider */
    $activeLocaleCodeProvider = ObjectManager::getInstance(ActiveLocaleCodeProvider::class);
    $activeLocaleCodes = $activeLocaleCodeProvider->getInstalledActiveCodes();
    $allowedLocaleMap = $activeLocaleCodeProvider->getInstalledActiveCodeMap();
    
    // 获取语言本地化名称
    $langLocals = $i18n->getLocals($currentLangLocal);
    
    // 构建语言数据（仅已安装且已激活）
    $i18nLanguages = [];
    foreach ($langLocals as $localeCode => $localeName) {
        if (!empty($allowedLocaleMap) && !isset($allowedLocaleMap[(string)$localeCode]) && !isset($allowedLocaleMap[strtolower((string)$localeCode)])) {
            continue;
        }
        
        try {
            $selfName = (string)$i18n->getLocaleLanguageSelfName((string)$localeCode);
        } catch (\Throwable) {
            $selfName = '';
        }

        $i18nLanguages[] = [
            'code' => $localeCode,
            'name' => $localeName,
            'native' => $selfName !== '' ? $selfName : $localeName,
            'flag' => $getLanguageFlag((string)$localeCode),
        ];
    }
} catch (\Throwable $e) {
    // 如果获取失败，使用默认列表
    $i18nLanguages = [];
}

// 如果没有可用语言，使用默认列表
if (empty($i18nLanguages)) {
    $i18nLanguages = [
        ['code' => 'zh_Hans_CN', 'name' => '简体中文', 'native' => '简体中文', 'flag' => $getLanguageFlag('zh_Hans_CN')],
        ['code' => 'en_US', 'name' => 'English', 'native' => 'English', 'flag' => $getLanguageFlag('en_US')],
        ['code' => 'zh_Hant_TW', 'name' => '繁體中文', 'native' => '繁體中文', 'flag' => $getLanguageFlag('zh_Hant_TW')],
    ];
}

// 前台默认按站点 WebsiteLanguage 收窄；观察者可通过 allowed_locales 再覆盖。
$websiteLanguageCodes = [];
if (!$isBackendArea && $frontendWebsiteId !== null) {
    try {
        $websiteLanguageCodes = w_query('websites', 'getWebsiteLanguageCodes', [
            'website_id' => (int)$frontendWebsiteId,
        ]);
    } catch (\Throwable) {
        $websiteLanguageCodes = [];
    }
    if (\is_array($websiteLanguageCodes) && $websiteLanguageCodes !== []) {
        $i18nLanguages = $filterLanguagesByCodes($i18nLanguages, $websiteLanguageCodes);
    }
}

// 准备 event 数据
$eventData = [
    'currentLang' => $currentLang,
    'currentLangLocal' => $currentLangLocal,
    'languages' => $i18nLanguages, // I18n 模块的数据
    'allowed_locales' => null, // 观察者可设为站点自定义语言码列表
    'website_id' => $frontendWebsiteId,
    'is_backend' => $isBackendArea,
    'template' => $this,
    'request' => $this->request,
];

// 触发 event: Weline_I18n::header-language-switcher-data
/** @var EventsManager $eventsManager */
$eventsManager = ObjectManager::getInstance(EventsManager::class);
$eventsManager->dispatch('Weline_I18n::header-language-switcher-data', $eventData);

// 获取 event 对象（如果 event 被监听，数据可能已被修改）
$event = $eventsManager->getEventData('Weline_I18n::header-language-switcher-data');

// 检查 event 是否被监听并修改了数据
// Event 对象通过 getData() 方法获取数据，如果 event 被监听并修改，数据会更新
if ($event) {
    $eventDataResult = $event->getData('data');
    if (is_array($eventDataResult)) {
        $eventLanguages = $eventDataResult['languages'] ?? null;
        $eventCurrentLang = $eventDataResult['currentLang'] ?? null;
        $eventAllowedLocales = $eventDataResult['allowed_locales'] ?? null;
    } else {
        $eventLanguages = null;
        $eventCurrentLang = null;
        $eventAllowedLocales = null;
    }
} else {
    $eventLanguages = null;
    $eventCurrentLang = null;
    $eventAllowedLocales = null;
}

// 如果 event 返回了数据，使用 event 的数据，否则使用 I18n 的数据
$languages = $eventLanguages ?? $i18nLanguages;
$displayCurrentLang = (string)($eventCurrentLang ?? $currentLang);
if (\is_array($eventAllowedLocales) && $eventAllowedLocales !== []) {
    $languages = $filterLanguagesByCodes(
        \is_array($languages) ? $languages : [],
        $eventAllowedLocales
    );
}

// Cookie/路径残留了站点未启用的语言（如 ar_*）时，列表里没有对应项，
// 头部会显示幽灵短码 AR，且名称按阿拉伯语渲染。强制回落到列表首项。
$normalizeLangKey = static function (string $code): string {
    return strtolower(str_replace('-', '_', trim($code)));
};
$displayCurrentKey = $normalizeLangKey($displayCurrentLang);
$matchedDisplayLang = '';
if (\is_array($languages)) {
    foreach ($languages as $languageRow) {
        if (!\is_array($languageRow)) {
            continue;
        }
        $rowCode = trim((string)($languageRow['code'] ?? ''));
        if ($rowCode === '') {
            continue;
        }
        if ($normalizeLangKey($rowCode) === $displayCurrentKey) {
            $matchedDisplayLang = $rowCode;
            break;
        }
    }
    if ($matchedDisplayLang === '') {
        foreach ($languages as $languageRow) {
            if (!\is_array($languageRow)) {
                continue;
            }
            $rowCode = trim((string)($languageRow['code'] ?? ''));
            if ($rowCode !== '') {
                $matchedDisplayLang = $rowCode;
                break;
            }
        }
    }
}
if ($matchedDisplayLang !== '') {
    $displayCurrentLang = $matchedDisplayLang;
}

$websiteDisplayLocale = $displayCurrentLang !== ''
    ? $displayCurrentLang
    : ($currentLangLocal !== '' ? $currentLangLocal : (string)$currentLang);

$aliasDisplayLocales = [];
$addAliasDisplayLocale = static function (string $localeCode) use (&$aliasDisplayLocales): void {
    $localeCode = trim($localeCode);
    if ($localeCode === '') {
        return;
    }
    $aliasDisplayLocales[strtolower($localeCode)] = $localeCode;
};

foreach ([$currentLangLocal, $displayCurrentLang, 'zh_Hans_CN', 'en_US', 'es_ES', 'fr_FR', 'de_DE', 'ja_JP', 'ko_KR', 'pt_BR'] as $displayLocale) {
    $addAliasDisplayLocale((string)$displayLocale);
}

foreach ($activeLocaleCodes as $displayLocale) {
    if (count($aliasDisplayLocales) >= 20) {
        break;
    }
    $addAliasDisplayLocale((string)$displayLocale);
}

$localeNameMaps = [];
foreach ($aliasDisplayLocales as $displayLocale) {
    try {
        $localeNameMaps[$displayLocale] = $i18n->getLocals($displayLocale);
    } catch (\Throwable) {
        $localeNameMaps[$displayLocale] = [];
    }
}

$normalizedLanguages = [];
$seenLanguageCodes = [];
foreach ($languages as $lang) {
    if (!is_array($lang)) {
        continue;
    }

    $langCode = trim((string)($lang['code'] ?? ''));
    if ($langCode === '') {
        continue;
    }

    $langKey = strtolower($langCode);
    if (isset($seenLanguageCodes[$langKey])) {
        continue;
    }
    $seenLanguageCodes[$langKey] = true;

    $aliases = [];
    foreach ($localeNameMaps as $localeNames) {
        if (isset($localeNames[$langCode])) {
            $aliases[] = (string)$localeNames[$langCode];
        }
    }

    try {
        $aliases[] = $i18n->getLocaleLanguageSelfName($langCode);
    } catch (\Throwable) {
    }

    $firstAlias = reset($aliases);
    $langName = '';
    try {
        $langName = trim((string)$i18n->getLocaleName($langCode, $websiteDisplayLocale));
    } catch (\Throwable) {
        $langName = '';
    }
    if ($langName === '') {
        $langName = trim((string)($lang['name'] ?? ''));
    }
    if ($langName === '') {
        $langName = trim((string)($firstAlias ?: $langCode));
    }

    $langNative = '';
    try {
        $langNative = trim((string)$i18n->getLocaleLanguageSelfName($langCode));
    } catch (\Throwable) {
    }
    if ($langNative === '') {
        $langNative = trim((string)($lang['native'] ?? ''));
    }
    if ($langNative === '') {
        $langNative = $langName;
    }
    $flag = $sanitizeInlineFlagMarkup((string)($lang['flag'] ?? ''));
    if ($flag === '') {
        $flag = $getLanguageFlag($langCode);
    }

    $normalizedLanguages[] = [
        'code' => $langCode,
        'name' => $langName,
        'native' => $langNative,
        'flag' => $flag,
        'short' => $shortLocaleCode($langCode),
        'search' => $normalizeSearchText(array_merge([$langCode, $langName, $langNative], $aliases)),
    ];
}

$currentLanguages = [];
$otherLanguages = [];
foreach ($normalizedLanguages as $language) {
    if ((string)$language['code'] === (string)$displayCurrentLang) {
        $currentLanguages[] = $language;
        continue;
    }
    $otherLanguages[] = $language;
}

$languages = array_merge($currentLanguages, $otherLanguages);
$currentLanguageFlag = '';
$currentLanguageShort = $shortLocaleCode((string)$displayCurrentLang);
$currentLanguageName = '';
$currentLanguageNative = '';
foreach ($languages as $lang) {
    if ((string)$lang['code'] === (string)$displayCurrentLang) {
        $currentLanguageFlag = (string)($lang['flag'] ?? '');
        $currentLanguageShort = (string)($lang['short'] ?? $currentLanguageShort);
        $currentLanguageName = trim((string)($lang['name'] ?? ''));
        $currentLanguageNative = trim((string)($lang['native'] ?? $currentLanguageName));
        break;
    }
}
$currentLanguageFullLabel = $currentLanguageName !== ''
    ? $currentLanguageName
    : ($currentLanguageNative !== '' ? $currentLanguageNative : $currentLanguageShort);
$currentLanguageLabel = $currentLanguageNative !== '' && mb_strlen($currentLanguageNative) <= 12
    ? $currentLanguageNative
    : $currentLanguageShort;

// Framework path-locale hrefs: /{currency?}/{locale}/route (defaults omitted).
// Do not emit ?lang=&locale= — that is not the frontend contract.
$buildLanguageHref = static function (string $targetLocale): string {
    $targetLocale = trim(str_replace('-', '_', $targetLocale));
    if ($targetLocale === '') {
        return '#';
    }

    $resolvePublicRoutePath = static function (): string {
        // PageBuilder Router writes the public page handle into GET during rewrite.
        // Prefer it over REQUEST_URI, which is already the internal
        // /pagebuilder/frontend/page/view path by the time hooks render.
        // Url rewrite may only set page_id — recover handle from the page row.
        $handle = '';
        $pageId = 0;
        try {
            $handle = trim((string)\Weline\Framework\Env\WelineEnv::getGet('handle', ''));
            $pageId = (int)\Weline\Framework\Env\WelineEnv::getGet('page_id', 0);
        } catch (\Throwable) {
            $handle = '';
            $pageId = 0;
        }
        if ($handle === '' && $pageId > 0 && class_exists(\GuoLaiRen\PageBuilder\Model\Page::class)) {
            try {
                /** @var \GuoLaiRen\PageBuilder\Model\Page $pageModel */
                $pageModel = ObjectManager::getInstance(\GuoLaiRen\PageBuilder\Model\Page::class);
                $page = clone $pageModel;
                $page->load($pageId);
                if ($page->getId()) {
                    $handle = trim((string)$page->getData(\GuoLaiRen\PageBuilder\Model\Page::schema_fields_HANDLE));
                    if ((string)$page->getData(\GuoLaiRen\PageBuilder\Model\Page::schema_fields_TYPE)
                        === \GuoLaiRen\PageBuilder\Model\Page::TYPE_HOME
                    ) {
                        return '/';
                    }
                }
            } catch (\Throwable) {
            }
        }
        if ($handle !== '') {
            $normalizedHandle = strtolower($handle);
            if (in_array($normalizedHandle, ['index', 'home', 'ai-site'], true)) {
                return '/';
            }
            try {
                $websiteId = (int)(\Weline\Framework\Runtime\RequestContext::getWelineWebsiteId()
                    ?? \Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_ID', 0)
                    ?? 0);
                if ($websiteId > 0 && class_exists(\GuoLaiRen\PageBuilder\Model\Page::class)) {
                    /** @var \GuoLaiRen\PageBuilder\Model\Page $pageModel */
                    $pageModel = ObjectManager::getInstance(\GuoLaiRen\PageBuilder\Model\Page::class);
                    $page = clone $pageModel;
                    $page->clear()
                        ->where(\GuoLaiRen\PageBuilder\Model\Page::schema_fields_WEBSITE_ID, $websiteId)
                        ->where(\GuoLaiRen\PageBuilder\Model\Page::schema_fields_HANDLE, $handle)
                        ->find()
                        ->fetch();
                    if ($page->getId()
                        && (string)$page->getData(\GuoLaiRen\PageBuilder\Model\Page::schema_fields_TYPE)
                            === \GuoLaiRen\PageBuilder\Model\Page::TYPE_HOME
                    ) {
                        return '/';
                    }
                }
            } catch (\Throwable) {
            }

            return '/' . ltrim($handle, '/');
        }

        $candidates = [
            \Weline\Framework\Env\WelineEnv::server('WELINE_ORIGIN_REQUEST_URI', ''),
            \Weline\Framework\Env\WelineEnv::server('ORIGIN_REQUEST_URI', ''),
            \Weline\Framework\Env\WelineEnv::get('origin_request_uri', ''),
            \Weline\Framework\Env\WelineEnv::server('REQUEST_URI', ''),
            \Weline\Framework\Env\WelineEnv::get('request.uri', ''),
        ];

        $toPath = static function (mixed $candidate): string {
            if (!is_scalar($candidate)) {
                return '';
            }
            $uri = trim((string)$candidate);
            if ($uri === '') {
                return '';
            }
            if (str_contains($uri, '://')) {
                $parsed = parse_url($uri, PHP_URL_PATH);
                $uri = is_string($parsed) ? $parsed : '';
            } else {
                $parsed = parse_url($uri, PHP_URL_PATH);
                if (is_string($parsed) && $parsed !== '') {
                    $uri = $parsed;
                } else {
                    $uri = strtok($uri, '?') ?: $uri;
                }
            }

            return trim(str_replace('\\', '/', (string)$uri), '/');
        };

        $isInternalPageBuilderPath = static function (string $path): bool {
            $normalized = strtolower(trim($path, '/'));

            return $normalized === 'pagebuilder/frontend/page'
                || str_starts_with($normalized, 'pagebuilder/frontend/page/');
        };

        foreach ($candidates as $candidate) {
            $path = $toPath($candidate);
            if ($path === '') {
                if (is_scalar($candidate) && trim((string)$candidate) !== '') {
                    return '/';
                }
                continue;
            }
            if ($isInternalPageBuilderPath($path)) {
                continue;
            }

            $segments = array_values(array_filter(
                explode('/', $path),
                static fn(string $segment): bool => $segment !== ''
            ));
            try {
                $localization = \Weline\Framework\App\State::resolveLocalizationFromPathSegments($segments);
                $remaining = is_array($localization['remaining'] ?? null)
                    ? $localization['remaining']
                    : $segments;
            } catch (\Throwable) {
                $remaining = $segments;
            }

            $remainingPath = implode('/', array_map('strval', $remaining));
            // Locale/currency prefixes may wrap the internal controller path
            // (e.g. en_US/pagebuilder/frontend/page/view) — treat as home.
            if ($isInternalPageBuilderPath($remainingPath)) {
                return '/';
            }

            return $remaining === [] ? '/' : '/' . $remainingPath;
        }

        return '/';
    };

    $routePath = $resolvePublicRoutePath();
    $requestPathForCurrency = $routePath;
    try {
        $origin = (string)(\Weline\Framework\Env\WelineEnv::server('WELINE_ORIGIN_REQUEST_URI', '')
            ?: \Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '')
            ?: $routePath);
        $parsedOrigin = parse_url($origin, PHP_URL_PATH);
        if (is_string($parsedOrigin) && $parsedOrigin !== '') {
            $requestPathForCurrency = $parsedOrigin;
        }
    } catch (\Throwable) {
    }

    $segments = array_values(array_filter(
        explode('/', trim($requestPathForCurrency, '/')),
        static fn(string $segment): bool => $segment !== ''
    ));
    $currentCurrency = null;
    try {
        $localization = \Weline\Framework\App\State::resolveLocalizationFromPathSegments($segments);
        $currency = trim((string)($localization['currency'] ?? ''));
        if ($currency !== '') {
            $currentCurrency = $currency;
        }
    } catch (\Throwable) {
    }

    $defaultLocale = '';
    try {
        $defaultLocale = trim((string)\Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_LANGUAGE', ''));
    } catch (\Throwable) {
    }
    if ($defaultLocale === '') {
        try {
            if (class_exists(\Weline\Websites\Data\WebsiteData::class)) {
                $defaultLocale = trim((string)(\Weline\Websites\Data\WebsiteData::getDefaultLanguage() ?? ''));
            }
        } catch (\Throwable) {
        }
    }
    // Never fall back to the *current* request locale — that makes every language
    // look like the site default and drops its path segment.
    $defaultLocale = str_replace('-', '_', $defaultLocale !== '' ? $defaultLocale : 'zh_Hans_CN');
    // Debug-free hard preference: if website table default is available via query, prefer it.
    try {
        $websiteId = (int)(\Weline\Framework\Runtime\RequestContext::getWelineWebsiteId()
            ?? \Weline\Framework\Env\WelineEnv::server('WELINE_WEBSITE_ID', 0)
            ?? 0);
        if ($websiteId > 0) {
            $codes = w_query('websites', 'getWebsite', ['website_id' => $websiteId]);
            if (\is_array($codes)) {
                $fromWebsite = trim((string)($codes['default_language'] ?? ''));
                if ($fromWebsite !== '') {
                    $defaultLocale = str_replace('-', '_', $fromWebsite);
                }
            }
        }
    } catch (\Throwable) {
    }
    $defaultCurrency = strtoupper(trim((string)(
        \Weline\Framework\Env\WelineEnv::get('website.currency', '')
        ?: 'CNY'
    )));
    if ($defaultCurrency === '') {
        $defaultCurrency = 'CNY';
    }

    try {
        if (interface_exists(\Weline\I18n\Api\Seo\LocalizedUrlBuilderInterface::class)) {
            /** @var \Weline\I18n\Api\Seo\LocalizedUrlBuilderInterface $builder */
            $builder = ObjectManager::getInstance(\Weline\I18n\Api\Seo\LocalizedUrlBuilderInterface::class);
            $absolute = $builder->build(
                'https://weline.local',
                $routePath,
                $targetLocale,
                $defaultLocale,
                $currentCurrency,
                $defaultCurrency
            );
            $path = parse_url($absolute, PHP_URL_PATH);
            if (is_string($path) && $path !== '') {
                return $path;
            }
        }
    } catch (\Throwable) {
    }

    // Fallback when LocalizedUrlBuilder is unavailable.
    $parts = [];
    if ($currentCurrency !== null && strtoupper($currentCurrency) !== $defaultCurrency) {
        $parts[] = strtoupper($currentCurrency);
    }
    if (strtolower($targetLocale) !== strtolower($defaultLocale)) {
        $parts[] = $targetLocale;
    }
    $route = trim($routePath, '/');
    if ($route !== '') {
        $parts[] = $route;
    }

    return $parts === [] ? '/' : '/' . implode('/', $parts);
};

// 渲染语言切换器
// href 由服务端按框架路径契约生成；i18n.js 若加载可再校正。
// 使用 data-i18n-switcher 属性标记，供 JavaScript 识别和初始化
