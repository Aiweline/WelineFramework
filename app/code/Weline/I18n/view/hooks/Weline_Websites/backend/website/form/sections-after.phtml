<?php
/**
 * @hook-priority 100
 * @hook-sort-order 30
 */

$website = (array)($this->getData('website') ?? []);
$hasWebsiteIdentity = \array_key_exists('website_id', $website) || \array_key_exists('id', $website);
$websiteId = $hasWebsiteIdentity ? (int)($website['website_id'] ?? $website['id']) : -1;
$hookId = \preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'website'));
if (!\is_string($hookId) || $hookId === '' || \preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'website_' . (\is_string($hookId) ? $hookId : '');
}
$accordionParentId = \preg_replace(
    '/[^\w\-]+/',
    '_',
    (string)($this->getData('accordion_parent_id') ?? 'websiteFormAccordion')
);
$panelId = $hookId . '_language_requests';
?>
<div class="accordion-item"
     id="<?= \htmlspecialchars($panelId, ENT_QUOTES, 'UTF-8') ?>"
     data-language-request-panel
     data-website-id="<?= $websiteId ?>">
    <div class="accordion-header" id="<?= \htmlspecialchars($panelId . '_heading', ENT_QUOTES, 'UTF-8') ?>">
        <button class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#<?= \htmlspecialchars($panelId . '_body', ENT_QUOTES, 'UTF-8') ?>"
                aria-expanded="false"
                aria-controls="<?= \htmlspecialchars($panelId . '_body', ENT_QUOTES, 'UTF-8') ?>">
            <i class="mdi mdi-translate"></i>
            <span><lang>用户申请语言</lang></span>
            <span class="badge bg-primary-subtle text-primary ms-2" data-count hidden>0</span>
            <i class="mdi mdi-chevron-down ms-auto"></i>
        </button>
    </div>
    <div id="<?= \htmlspecialchars($panelId . '_body', ENT_QUOTES, 'UTF-8') ?>"
         class="accordion-collapse collapse"
         aria-labelledby="<?= \htmlspecialchars($panelId . '_heading', ENT_QUOTES, 'UTF-8') ?>"
         data-bs-parent="#<?= \htmlspecialchars((string)$accordionParentId, ENT_QUOTES, 'UTF-8') ?>">
        <div class="accordion-body">
            <?php if (!$hasWebsiteIdentity || $websiteId < 0): ?>
                <p class="text-muted mb-0"><lang>保存网站后即可查看用户申请并加入语言。</lang></p>
            <?php else: ?>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <p class="text-muted mb-0"><lang>仅显示已安装、已启用且语言包可运行的申请语言。</lang></p>
                    <button type="button" class="btn btn-sm btn-primary" data-assign-all disabled>
                        <i class="mdi mdi-playlist-plus"></i> <lang>全部加入</lang>
                    </button>
                </div>
                <div class="alert alert-light border py-2" data-feedback role="status" aria-live="polite">
                    <lang>展开后加载当前网站的就绪语言。</lang>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th><lang>语言</lang></th>
                            <th><lang>国家/地区</lang></th>
                            <th><lang>申请数</lang></th>
                            <th class="text-end"><lang>操作</lang></th>
                        </tr>
                        </thead>
                        <tbody data-items></tbody>
                    </table>
                </div>
            <?php endif; ?>
        </div>
    </div>
</div>
<?php if ($hasWebsiteIdentity && $websiteId >= 0): ?>
<script>
(function(){
    var root=document.getElementById('<?= \addslashes($panelId) ?>');
    if(!root||root.dataset.bound==='1'){return;}
    root.dataset.bound='1';
    var websiteId=Number(root.dataset.websiteId);
    var body=root.querySelector('[data-items]');
    var feedback=root.querySelector('[data-feedback]');
    var count=root.querySelector('[data-count]');
    var assignAll=root.querySelector('[data-assign-all]');
    var grantVersion=0;
    var items=[];
    var loaded=false;
    var loading=false;
    function esc(value){var node=document.createElement('span');node.textContent=String(value==null?'':value);return node.innerHTML;}
    function client(){return Promise.resolve(window.Weline.Api.resource('website_language_requests'));}
    function render(){
        count.textContent=String(items.length);
        count.hidden=items.length===0;
        assignAll.disabled=items.length===0;
        body.innerHTML=items.map(function(item){
            return '<tr><td><strong>'+esc(item.locale_code)+'</strong></td><td>'+esc(item.country_code||'—')+'</td><td>'+esc(item.request_count||0)+'</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" data-assign="'+esc(item.locale_code)+'"><?= \addslashes((string)__('一键加入')) ?></button></td></tr>';
        }).join('')||'<tr><td colspan="4" class="text-center text-muted py-4"><?= \addslashes((string)__('暂无可加入的申请语言')) ?></td></tr>';
    }
    function load(force){
        if(loading||(!force&&loaded)){return Promise.resolve();}
        loading=true;
        feedback.className='alert alert-light border py-2';
        feedback.textContent='<?= \addslashes((string)__('正在加载语言申请…')) ?>';
        return client().then(function(api){return api.listReady({website_id:websiteId});}).then(function(result){
            grantVersion=Number(result.grant_version||0);
            items=Array.isArray(result.items)?result.items:[];
            loaded=true;
            feedback.textContent=items.length?'<?= \addslashes((string)__('可将已就绪语言加入当前站点。')) ?>':'<?= \addslashes((string)__('当前没有可加入的申请语言。')) ?>';
            render();
        }).catch(function(error){
            feedback.className='alert alert-danger py-2';
            feedback.textContent=(error&&error.message)?error.message:String(error);
        }).finally(function(){loading=false;});
    }
    function assign(locales,button){
        if(!locales.length){return;}
        if(button){button.disabled=true;}
        assignAll.disabled=true;
        feedback.className='alert alert-light border py-2';
        feedback.textContent='<?= \addslashes((string)__('正在加入站点语言…')) ?>';
        client().then(function(api){
            return api.assign({website_id:websiteId,locales:locales,expected_grant_version:grantVersion});
        }).then(function(result){
            feedback.className='alert alert-success py-2';
            feedback.textContent=result.message||'<?= \addslashes((string)__('站点语言已加入')) ?>';
            loaded=false;
            return load(true);
        }).catch(function(error){
            feedback.className='alert alert-danger py-2';
            feedback.textContent=(error&&error.message)?error.message:String(error);
            assignAll.disabled=items.length===0;
            if(button){button.disabled=false;}
        });
    }
    root.addEventListener('shown.bs.collapse',function(event){
        if(event.target&&event.target.id==='<?= \addslashes($panelId . '_body') ?>'){load(false);}
    });
    body.addEventListener('click',function(event){
        var button=event.target.closest('[data-assign]');
        if(button){assign([button.getAttribute('data-assign')],button);}
    });
    assignAll.addEventListener('click',function(){
        assign(items.map(function(item){return item.locale_code;}),assignAll);
    });
})();
</script>
<?php endif; ?>
