<?php
/**
 * Storefront inline-edit shell (operator session only).
 *
 * Hook: Weline_Theme::frontend::layouts::base::body-end
 * Do NOT use short name `footer` — Theme footer widget + footer partial both
 * invoke `<w:hook>footer</w:hook>`, which double-injects the script and breaks save
 * (two IIFE state closures).
 *
 * @hook-priority 50
 * @hook-sort-order 0
 * @hook-solo false
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\View\PublicStaticUrl;
use Weline\I18n\Service\InlineEdit\InlineEditSession;

$__i18nInlineActive = false;
try {
    /** @var InlineEditSession $__i18nInlineSession */
    $__i18nInlineSession = ObjectManager::getInstance(InlineEditSession::class);
    $__i18nInlineActive = $__i18nInlineSession->isActive();
    if ($__i18nInlineActive) {
        $__i18nInlineSession->reinforceBrowserCookies();
    }
} catch (\Throwable) {
    $__i18nInlineActive = false;
}
?>
<?php if ($__i18nInlineActive): ?>
<?php
    /** @var \Weline\Framework\Http\Request $__i18nReq */
    $__i18nReq = ObjectManager::getInstance(\Weline\Framework\Http\Request::class);
    $__ub = $__i18nReq->getUrlBuilder();
    $__phraseUrl = htmlspecialchars((string)$__ub->getUrl('i18n/frontend/inline-edit/api/phrase'), ENT_QUOTES, 'UTF-8');
    $__localesUrl = htmlspecialchars((string)$__ub->getUrl('i18n/frontend/inline-edit/api/locales'), ENT_QUOTES, 'UTF-8');
    $__purgeUrl = htmlspecialchars((string)$__ub->getUrl('i18n/frontend/inline-edit/api/purgePage'), ENT_QUOTES, 'UTF-8');
    $__stopUrl = htmlspecialchars((string)$__ub->getUrl('i18n/frontend/inline-edit/api/stop'), ENT_QUOTES, 'UTF-8');
    $__shellJs = htmlspecialchars(
        PublicStaticUrl::fromDevWebPath('/Weline/I18n/view/statics/js/inline-edit-shell-20261014d.js') . '?v=1',
        ENT_QUOTES,
        'UTF-8'
    );
?>
    <span
        hidden
        data-w-component="i18n-inline-edit-shell"
        data-phrase-url="<?= $__phraseUrl ?>"
        data-locales-url="<?= $__localesUrl ?>"
        data-purge-url="<?= $__purgeUrl ?>"
        data-stop-url="<?= $__stopUrl ?>"
    ></span>
    <?php /* Sync unwrap before deferred shell: kills nested/data-i18n leaks even if shell cache is sticky. */ ?>
    <script>
    (function () {
        var RE = /\[\[W18N:([A-Za-z0-9_-]+):([A-Za-z0-9_-]+)\]\]/g;
        function b64(s) {
            try {
                s = String(s || '').replace(/-/g, '+').replace(/_/g, '/');
                while (s.length % 4) s += '=';
                return decodeURIComponent(escape(atob(s)));
            } catch (e) { return ''; }
        }
        function unwrap(raw) {
            var s = String(raw || ''), i = 0, next;
            while (i++ < 8 && s.indexOf('[[W18N:') !== -1) {
                next = s.replace(RE, function (_, a, b) { return b64(b) || b64(a) || ''; });
                if (next === s) break;
                s = next;
            }
            return s;
        }
        function sweep(root) {
            if (!root || !root.querySelectorAll) return;
            // Attrs only (data-i18n-*): leave text markers for shell books.
            root.querySelectorAll('*').forEach(function (el) {
                if (!el.attributes) return;
                Array.prototype.forEach.call(el.attributes, function (attr) {
                    if (attr.value && attr.value.indexOf('[[W18N:') !== -1) {
                        el.setAttribute(attr.name, unwrap(attr.value));
                    }
                });
            });
            // Header JS string table is assigned earlier; peel markers before header-default.js uses them.
            var tbl = window.__welineHeaderLabels;
            if (tbl && typeof tbl === 'object') {
                Object.keys(tbl).forEach(function (k) {
                    if (typeof tbl[k] === 'string' && tbl[k].indexOf('[[W18N:') !== -1) {
                        tbl[k] = unwrap(tbl[k]);
                    }
                });
            }
        }
        function run() { if (document.body) sweep(document.body); }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', run);
        } else {
            run();
        }
    })();
    </script>
    <script src="<?= $__shellJs ?>" defer></script>
<?php else: ?>
    <?php /* Session off: never show books; strip any FPC-stale [[W18N:]] leaks (no books). */ ?>
    <script>
    (function () {
        var RE = /\[\[W18N:([A-Za-z0-9_-]+):([A-Za-z0-9_-]+)\]\]/g;
        function b64(s) {
            try {
                s = String(s || '').replace(/-/g, '+').replace(/_/g, '/');
                while (s.length % 4) s += '=';
                return decodeURIComponent(escape(atob(s)));
            } catch (e) { return ''; }
        }
        function unwrap(raw) {
            var s = String(raw || ''), i = 0, next;
            while (i++ < 8 && s.indexOf('[[W18N:') !== -1) {
                next = s.replace(RE, function (_, a, b) { return b64(b) || b64(a) || ''; });
                if (next === s) break;
                s = next;
            }
            return s;
        }
        function sweep(root) {
            if (!root) return;
            var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), n, nodes = [];
            while ((n = w.nextNode())) {
                if (n.nodeValue && n.nodeValue.indexOf('[[W18N:') !== -1) nodes.push(n);
            }
            nodes.forEach(function (t) {
                t.nodeValue = unwrap(t.nodeValue);
            });
            (root.querySelectorAll ? root.querySelectorAll('*') : []).forEach(function (el) {
                if (!el.attributes) return;
                Array.prototype.forEach.call(el.attributes, function (attr) {
                    if (attr.value && attr.value.indexOf('[[W18N:') !== -1) {
                        el.setAttribute(attr.name, unwrap(attr.value));
                    }
                });
            });
        }
        if (document.body && document.body.innerHTML.indexOf('[[W18N:') !== -1) {
            sweep(document.body);
        }
    })();
    </script>
<?php endif; ?>
