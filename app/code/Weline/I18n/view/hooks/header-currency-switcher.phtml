<?php
/**
 *
 * @hook-priority 50
 * @hook-sort-order 0
 * @hook-solo false
 */

use Weline\Currency\Service\CurrencySwitcherIslandBuilder;
use Weline\Framework\Manager\ObjectManager;

/** @var \Weline\Framework\View\Template $this */

// Chrome lang-shell: emit pending island only — Partials hydrate stamps live HTML.
if (CurrencySwitcherIslandBuilder::isChromeShellBuild()) {
    echo CurrencySwitcherIslandBuilder::pendingIslandHtml();

    return;
}

try {
    /** @var CurrencySwitcherIslandBuilder $builder */
    $builder = ObjectManager::getInstance(CurrencySwitcherIslandBuilder::class);
    echo $builder->renderLiveIslandHtml();
} catch (\Throwable) {
    echo CurrencySwitcherIslandBuilder::pendingIslandHtml();
}
?>
