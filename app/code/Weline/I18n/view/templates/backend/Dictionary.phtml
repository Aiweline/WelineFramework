        confirmUnavailable: <?= json_encode((string)__('确认组件不可用，请刷新页面后重试。'), $jsonForScriptFlags) ?>,
        aiTranslateBusy: <?= json_encode((string)__('正在 AI 翻译…'), $jsonForScriptFlags) ?>,
        aiTranslateOthersBusy: <?= json_encode((string)__('正在翻译其他语言…'), $jsonForScriptFlags) ?>,
        aiTranslateDone: <?= json_encode((string)__('AI 翻译完成'), $jsonForScriptFlags) ?>,
        aiTranslateFailed: <?= json_encode((string)__('AI 翻译失败'), $jsonForScriptFlags) ?>,
        aiTranslateSseFailed: <?= json_encode((string)__('SSE 连接失败，请重试'), $jsonForScriptFlags) ?>,
        aiTranslateNeedWord: <?= json_encode((string)__('请先填写原文'), $jsonForScriptFlags) ?>,
        aiOthersSaveTitle: <?= json_encode((string)__('保存其他语言译文'), $jsonForScriptFlags) ?>,
        aiOthersSaveConfirmLabel: <?= json_encode((string)__('确认保存'), $jsonForScriptFlags) ?>,
        aiOthersSaveSuccess: <?= json_encode((string)__('其他语言译文已保存'), $jsonForScriptFlags) ?>,
        aiOthersSaveFailed: <?= json_encode((string)__('保存其他语言译文失败'), $jsonForScriptFlags) ?>,
        aiOthersEmpty: <?= json_encode((string)__('没有可保存的其他语言译文'), $jsonForScriptFlags) ?>,
        aiOthersAllSkipped: <?= json_encode((string)__('其他语言均已有译文，已跳过'), $jsonForScriptFlags) ?>,
        aiOthersEchoFailed: <?= json_encode((string)__('AI 未能译出有效译文（多语种仍返回原文），请检查翻译服务后重试'), $jsonForScriptFlags) ?>
    };

    function confirmAction(message, type, options) {
        options = Object.assign({
            title: dictionaryMessages.confirmTitle,
            tone: type || 'info',
            confirmLabel: dictionaryMessages.confirmLabel,
            cancelLabel: dictionaryMessages.cancelLabel,
        }, options || {});

        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.confirm === 'function') {
            // Node 可直接作 message（requestDialog 支持）；勿 String() 毁掉列表结构。
            var confirmMessage = (message && typeof message === 'object' && message.nodeType)
                ? message
                : String(message || '');
            return window.Weline.UI.dialog.confirm(confirmMessage, options);
        }

        if (window.I18nAdminUI && typeof window.I18nAdminUI.confirm === 'function') {
            var plain = (message && typeof message === 'object' && message.nodeType)
                ? String(message.textContent || '')
                : String(message || '');
            return window.I18nAdminUI.confirm(plain, options.tone, options);
        }

        toastAction('error', dictionaryMessages.confirmUnavailable);
        return Promise.resolve(false);
    }

    function toastAction(type, message) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast[type] === 'function') {
            window.Weline.UI.toast[type](message);
            return;
        }

        if (window.I18nAdminUI && typeof window.I18nAdminUI.toast === 'function') {
            window.I18nAdminUI.toast(type, message);
            return;
        }

        console[type === 'error' ? 'error' : 'log'](message);
    }

    var localeCode = <?= json_encode($localeCode, $jsonForScriptFlags) ?>;
    var moduleFilter = <?= json_encode($moduleFilter, $jsonForScriptFlags) ?>;
    var moduleSearch = <?= json_encode($moduleSearch, $jsonForScriptFlags) ?>;
    var activeTab = <?= json_encode($activeTab, $jsonForScriptFlags) ?>;
    var moduleExportDev = <?= $moduleExportDev ? 'true' : 'false' ?>;
    var moduleCatalogLoaded = <?= $moduleCatalogLoaded ? 'true' : 'false' ?>;
    var moduleCatalogLoading = false;
    var moduleCatalogHydrating = false;
    var endpoints = {
        collectWords: 'dictionary-collect',
        moduleTranslate: 'dictionary-module-translate',
        moduleExportCsv: 'dictionary-module-export-csv',
        moduleCatalog: 'dictionary-module-catalog',
        moduleCatalogStats: 'dictionary-module-catalog-stats',
        clearLocale: 'dictionary-clear-locale',
        clearAll: 'dictionary-clear-all',
        currentTranslationMode: 'dictionary-current-translation-mode',
        checkAutoRegister: 'dictionary-check-auto-register',
        enableAutoRegister: 'dictionary-auto-register-enable',
        disableAutoRegister: 'dictionary-auto-register-disable',
        setTranslationMode: 'dictionary-translation-mode',
        inlineEditStart: 'dictionary-inline-edit-start'
    };
    var moduleCatalogMessages = {
        loading: <?= json_encode((string)__('正在加载模块进度…'), $jsonForScriptFlags) ?>,
        emptyTitle: <?= json_encode((string)__('暂无模块语言包'), $jsonForScriptFlags) ?>,
        emptyHint: <?= json_encode((string)__('未找到带 i18n 目录的活跃模块，或搜索条件无匹配'), $jsonForScriptFlags) ?>,
        loadFailed: <?= json_encode((string)__('模块进度加载失败'), $jsonForScriptFlags) ?>,
        translateLabel: <?= json_encode((string)__('AI 翻译'), $jsonForScriptFlags) ?>,
        exportLabel: <?= json_encode((string)__('写回 CSV'), $jsonForScriptFlags) ?>,
        pendingStats: <?= json_encode((string)__('…'), $jsonForScriptFlags) ?>
    };

    function updateProgress(progress) {
        if (!progress) {
            return;
        }

        var translated = Number(progress.translated || 0);
        var total = Number(progress.total || 0);
        var untranslated = Number(progress.untranslated || Math.max(0, total - translated));
        var percent = Number(progress.progress_percent || 0);

        document.getElementById('dictionary-total-count').textContent = String(total);
        document.getElementById('dictionary-translated-count').textContent = String(translated);
        document.getElementById('dictionary-untranslated-count').textContent = String(untranslated);
        document.getElementById('dictionary-progress-translated').textContent = String(translated);
        document.getElementById('dictionary-progress-percent').textContent = String(percent).replace(/\.0$/, '') + '%';
        document.getElementById('dictionary-progress-bar').style.width = Math.max(0, Math.min(100, percent)) + '%';
    }

    function updateModeState(data) {
        if (!data) {
            return;
        }

        var modeName = data.mode_name || data.mode || '<?= addslashes(__('未知')) ?>';
        document.getElementById('dictionary-mode-label').textContent = modeName;
        document.getElementById('dictionary-mode-chip').textContent = modeName;
        document.getElementById('dictionary-auto-register-label').textContent = data.auto_register ? '<?= addslashes(__('激活')) ?>' : '<?= addslashes(__('停用')) ?>';
        document.getElementById('dictionary-auto-register-toggle').textContent = data.auto_register ? '<?= addslashes(__('停用')) ?>' : '<?= addslashes(__('自动词汇注册')) ?>';
        document.getElementById('dictionary-auto-register-toggle').dataset.enabled = data.auto_register ? '1' : '0';
    }

    function postJson(action, payload) {
        if (window.I18nAdminUI && typeof window.I18nAdminUI.requestBinAction === 'function') {
            return window.I18nAdminUI.requestBinAction(action, payload || {});
        }

        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(function () {
                return window.I18nAdminUI.requestBinAction(action, payload || {});
            });
        }

        return Promise.reject(new Error('<?= addslashes(__('Weline.Api bin-query 不可用')) ?>'));
    }

    function loadModeState() {
        postJson(endpoints.currentTranslationMode, {locale_code: localeCode}).then(function (data) {
            updateModeState(data);
        }).catch(function () {
            toastAction('warning', '<?= addslashes(__('加载失败')) ?>');
        });
    }

    function fillDictionaryEditForm(data) {
        data = data || {};
        var md5 = data.md5 || '';
        var word = data.word || '';
        var translate = data.translate || '';
        document.getElementById('dictionary-edit-md5').value = md5;
        document.getElementById('dictionary-edit-word').value = word;
        document.getElementById('dictionary-edit-translate').value = translate === word ? '' : translate;
        var editLocaleCode = data.localeCode || localeCode || '';
        var editLanguageRoot = document.getElementById('dictionary_edit_locale_selector_wrapper');
        var editLanguageSelector = editLanguageRoot
            ? (window.Weline && window.Weline.UI && typeof window.Weline.UI.get === 'function'
                ? window.Weline.UI.get(editLanguageRoot, 'language-select')
                : null)
            : null;
        if (editLanguageSelector && typeof editLanguageSelector.setValue === 'function') {
            editLanguageSelector.setValue(editLocaleCode);
        } else {
            var editLocaleInput = document.getElementById('dictionary-edit-locale-code');
            if (editLocaleInput) {
                editLocaleInput.value = editLocaleCode;
            }
        }
        resetDictionaryEditAiProgress();
    }

    function openDictionaryEditModal(data) {
        fillDictionaryEditForm(data);
        var modal = document.getElementById('dictionary-edit-modal');
        if (!modal) {
            return;
        }
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.open === 'function') {
            window.Weline.UI.dialog.open(modal);
            return;
        }
        modal.hidden = false;
        modal.setAttribute('data-state', 'open');
        modal.setAttribute('aria-hidden', 'false');
    }

    document.querySelectorAll('.dictionary-edit-trigger').forEach(function (button) {
        button.addEventListener('click', function () {
            fillDictionaryEditForm({
                md5: button.dataset.md5 || '',
                word: button.dataset.word || '',
                translate: button.dataset.translate || '',
                localeCode: button.dataset.localeCode || ''
            });
        });
    });

    var dictionaryEntriesBody = document.getElementById('dictionary-entries-body');
    if (dictionaryEntriesBody) {
        dictionaryEntriesBody.addEventListener('dblclick', function (event) {
