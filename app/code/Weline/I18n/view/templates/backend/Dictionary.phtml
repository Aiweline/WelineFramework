    function parseDictionarySseBuffer(buffer, onEvent) {
        var parts = String(buffer || '').split('\n\n');
        var rest = parts.pop() || '';
        parts.forEach(function (block) {
            if (!block || block.charAt(0) === ':') {
                return;
            }
            var eventName = 'message';
            var dataLines = [];
            String(block).split('\n').forEach(function (line) {
                if (line.indexOf('event:') === 0) {
                    eventName = line.slice(6).trim() || 'message';
                } else if (line.indexOf('data:') === 0) {
                    dataLines.push(line.slice(5).replace(/^ /, ''));
                }
            });
            if (!dataLines.length) {
                return;
            }
            var raw = dataLines.join('\n');
            var data = null;
            try {
                data = JSON.parse(raw);
            } catch (e) {
                data = { message: raw };
            }
            onEvent(eventName, data || {});
        });
        return rest;
    }

    function startDictionaryAiSse(url, fields, handlers) {
        handlers = handlers || {};
        if (aiStreamBusy) {
            return;
        }
        if (aiStreamXhr) {
            try { aiStreamXhr.abort(); } catch (e) {}
            aiStreamXhr = null;
        }

        setAiButtonsBusy(true);
        setDictionaryEditAiProgress(handlers.busyMessage || dictionaryMessages.aiTranslateBusy, 0, 'muted');

        var xhr = new XMLHttpRequest();
        aiStreamXhr = xhr;
        var seenBytes = 0;
        var sseBuffer = '';
        var settled = false;
        var failed = false;

        function finish(asFailed) {
            if (settled) {
                return;
            }
            settled = true;
            if (asFailed) {
                failed = true;
            }
            if (aiStreamXhr === xhr) {
                aiStreamXhr = null;
            }
            setAiButtonsBusy(false);
        }

        function handleEvent(eventName, data) {
            data = data || {};
            if (eventName === 'start' || eventName === 'progress' || eventName === 'message') {
                if (settled) {
                    return;
                }
                var progressMsg = data.message || data.msg || handlers.busyMessage || dictionaryMessages.aiTranslateBusy;
                var percent = data.percent != null ? data.percent : (data.progress != null ? data.progress : null);
                setDictionaryEditAiProgress(progressMsg, percent, 'muted');
                if (typeof handlers.onProgress === 'function') {
                    handlers.onProgress(data, eventName);
                }
                return;
            }
            if (eventName === 'failed' || eventName === 'error') {
                if (settled) {
                    return;
                }
                finish(true);
                if (typeof handlers.onFailed === 'function') {
                    handlers.onFailed(data);
                }
                return;
            }
            if (eventName === 'done' || eventName === 'complete') {
                // 已失败/已收口后忽略后续 done，避免 CSRF error 后再 complete 假绿
                if (settled || failed) {
                    return;
                }
                if (data.success === false) {
                    finish(true);
                    if (typeof handlers.onFailed === 'function') {
                        handlers.onFailed(data);
                    }
                    return;
                }
                finish(false);
                if (typeof handlers.onDone === 'function') {
                    handlers.onDone(data);
                }
                return;
            }
        }

        xhr.open('POST', resolveDictionarySameOriginUrl(url), true);
        xhr.withCredentials = true;
        // Multi-locale batch can exceed default proxy patience; keep client waiting.
        xhr.timeout = 600000;
        xhr.setRequestHeader('Accept', 'text/event-stream');
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.onprogress = function () {
            var text = xhr.responseText || '';
            if (text.length <= seenBytes) {
                return;
            }
            var chunk = text.slice(seenBytes);
            seenBytes = text.length;
            sseBuffer = parseDictionarySseBuffer(sseBuffer + chunk, handleEvent);
        };
        xhr.onload = function () {
            var text = xhr.responseText || '';
            if (text.length > seenBytes) {
                sseBuffer = parseDictionarySseBuffer(sseBuffer + text.slice(seenBytes), handleEvent);
                seenBytes = text.length;
            }
            // Flush trailing SSE frame without final blank line.
            if (sseBuffer && !settled) {
                sseBuffer = parseDictionarySseBuffer(sseBuffer + '\n\n', handleEvent);
            }
            if (settled) {
                return;
            }
            if (xhr.status >= 200 && xhr.status < 300) {
                try {
                    var json = JSON.parse(text || '{}');
                    if (json && json.success === false) {
                        handleEvent('failed', json);
                        return;
                    }
                    if (json && (json.translation != null || json.translations != null || json.drafts != null || json.success === true)) {
                        handleEvent('done', json);
                        return;
                    }
                } catch (e) {}
                // SSE body is not JSON; if stream ended without complete/failed, treat as failure.
            }
            finish(true);
            if (typeof handlers.onFailed === 'function') {
                handlers.onFailed({ message: dictionaryMessages.aiTranslateSseFailed });
            }
        };
        xhr.ontimeout = function () {
            if (settled) {
                return;
            }
            finish(true);
            if (typeof handlers.onFailed === 'function') {
                handlers.onFailed({ message: dictionaryMessages.aiTranslateSseFailed });
            }
        };
        xhr.onerror = function () {
            if (settled) {
                return;
            }
            finish(true);
            if (typeof handlers.onFailed === 'function') {
                handlers.onFailed({ message: dictionaryMessages.aiTranslateSseFailed });
            }
        };
        xhr.onabort = function () {
            finish(false);
        };

        var fd = new FormData();
        Object.keys(fields || {}).forEach(function (key) {
            fd.append(key, fields[key] == null ? '' : String(fields[key]));
        });
        if (!fd.has('sse')) {
            fd.append('sse', '1');
        }
        xhr.send(fd);
    }

    function truncateDictionaryPreview(text, maxLen) {
        var value = String(text == null ? '' : text).replace(/\s+/g, ' ').trim();
        var limit = maxLen || 96;
        if (value.length <= limit) {
            return value;
        }
        return value.slice(0, Math.max(0, limit - 1)) + '…';
    }

    /**
     * 其他语种确认摘要：可滚动「语种 | 译文」列表（Node）。
     * 禁止再 join('\\n') 塞进 textContent——默认 white-space 会把换行折成一团。
     */
    function buildOthersSummary(payload) {
        payload = payload || {};
        var translations = payload.drafts || payload.translations || payload.items || {};
        var codes = Object.keys(translations || {});
        var skipped = Array.isArray(payload.skipped) ? payload.skipped : [];
        var errors = Array.isArray(payload.errors) ? payload.errors : [];

        if (!codes.length && !skipped.length && !errors.length) {
            return dictionaryMessages.aiOthersEmpty;
        }

        var root = document.createElement('div');
        root.className = 'i18n-dictionary-others-summary w-stack';
        root.setAttribute('data-testid', 'dictionary-others-save-summary');
        root.style.setProperty('--w-gap', 'var(--weline-space-3)');

        var lead = document.createElement('p');
        lead.className = 'w-text';
        lead.setAttribute('data-size', 'sm');
        if (codes.length) {
            lead.textContent = '<?= addslashes(__('将保存以下')) ?> '
                + String(codes.length)
                + ' <?= addslashes(__('种语言的译文草稿，请逐行核对：')) ?>';
        } else {
            lead.textContent = String(payload.message || dictionaryMessages.aiOthersEmpty);
        }
        root.appendChild(lead);

        if (codes.length) {
            // 不在内部再套一层固定高度滚动：交给 .w-dialog__body（max-height:60vh; overflow:auto），
            // 避免内嵌 scroller 把 footer 叠在表格上。
            var panel = document.createElement('div');
            panel.className = 'i18n-dictionary-others-summary__panel';
            panel.setAttribute('data-testid', 'dictionary-others-save-summary-list');
            panel.style.padding = 'var(--weline-space-2)';
            panel.style.border = '1px solid var(--weline-theme-border)';
            panel.style.borderRadius = 'var(--weline-radius-md)';
            panel.style.background = 'var(--weline-theme-surface-muted)';

            var table = document.createElement('table');
            table.className = 'w-table i18n-dictionary-others-summary__table';
            table.style.width = '100%';
            table.style.borderCollapse = 'collapse';
            table.style.fontSize = 'var(--weline-font-size-sm)';

            var thead = document.createElement('thead');
            var headRow = document.createElement('tr');
            ['<?= addslashes(__('语种')) ?>', '<?= addslashes(__('译文预览')) ?>'].forEach(function (label, idx) {
                var th = document.createElement('th');
                th.textContent = label;
                th.style.textAlign = 'start';
                th.style.padding = 'var(--weline-space-1) var(--weline-space-2)';
                th.style.borderBottom = '1px solid var(--weline-theme-border)';
                th.style.position = 'sticky';
                th.style.top = '0';
                th.style.background = 'var(--weline-theme-surface-muted)';
                th.style.whiteSpace = 'nowrap';
                th.style.zIndex = '1';
                if (idx === 0) {
                    th.style.width = '7.5rem';
                }
                headRow.appendChild(th);
            });
            thead.appendChild(headRow);
            table.appendChild(thead);

            var tbody = document.createElement('tbody');
            codes.sort().forEach(function (code) {
                var tr = document.createElement('tr');
                var tdLocale = document.createElement('td');
                tdLocale.textContent = code;
                tdLocale.style.padding = 'var(--weline-space-1) var(--weline-space-2)';
                tdLocale.style.verticalAlign = 'top';
                tdLocale.style.whiteSpace = 'nowrap';
                tdLocale.style.fontWeight = '650';
                tdLocale.style.borderBottom = '1px solid var(--weline-theme-border)';

                var tdText = document.createElement('td');
                var raw = String(translations[code] == null ? '' : translations[code]);
                tdText.textContent = truncateDictionaryPreview(raw, 120);
                tdText.title = raw;
                tdText.style.padding = 'var(--weline-space-1) var(--weline-space-2)';
                tdText.style.verticalAlign = 'top';
                tdText.style.borderBottom = '1px solid var(--weline-theme-border)';
                tdText.style.wordBreak = 'break-word';

                tr.appendChild(tdLocale);
                tr.appendChild(tdText);
                tbody.appendChild(tr);
            });
            table.appendChild(tbody);
            panel.appendChild(table);
            root.appendChild(panel);
        }

        if (skipped.length || errors.length) {
            var meta = document.createElement('p');
            meta.className = 'w-text';
            meta.setAttribute('data-size', 'sm');
            meta.setAttribute('data-tone', 'muted');
            var bits = [];
            if (skipped.length) {
                bits.push('<?= addslashes(__('已跳过')) ?>: ' + String(skipped.length));
            }
            if (errors.length) {
                bits.push('<?= addslashes(__('失败')) ?>: ' + String(errors.length));
            }
            meta.textContent = bits.join(' · ');
            root.appendChild(meta);
        }

        return root;
    }

    if (aiTranslateBtn) {
        aiTranslateBtn.addEventListener('click', function () {
            var ctx = getDictionaryEditContext();
            if (!ctx.word) {
                toastAction('warning', dictionaryMessages.aiTranslateNeedWord);
                return;
            }
            startDictionaryAiSse(entryAiTranslateStreamUrl, {
                csrf: getDictionaryEditAiCsrf(),
                md5: ctx.md5,
                word: ctx.word,
                locale_code: ctx.localeCode
            }, {
                busyMessage: dictionaryMessages.aiTranslateBusy,
                onProgress: function (data) {
                    if (data.translation != null && data.translation !== '') {
                        document.getElementById('dictionary-edit-translate').value = String(data.translation);
                    }
                },
                onDone: function (data) {
                    data = data || {};
                    if (data.success === false) {
                        setDictionaryEditAiProgress(data.message || dictionaryMessages.aiTranslateFailed, null, 'danger');
                        toastAction('error', data.message || dictionaryMessages.aiTranslateFailed);
                        return;
                    }
                    var translation = data.translation != null ? String(data.translation) : '';
                    if (translation === '') {
                        setDictionaryEditAiProgress(dictionaryMessages.aiTranslateFailed, null, 'danger');
                        toastAction('error', dictionaryMessages.aiTranslateFailed);
                        return;
                    }
                    document.getElementById('dictionary-edit-translate').value = translation;
                    setDictionaryEditAiProgress(data.message || dictionaryMessages.aiTranslateDone, 100, 'success');
                    toastAction('success', data.message || dictionaryMessages.aiTranslateDone);
                },
                onFailed: function (data) {
                    setDictionaryEditAiProgress((data && data.message) || dictionaryMessages.aiTranslateFailed, null, 'danger');
                    toastAction('error', (data && data.message) || dictionaryMessages.aiTranslateFailed);
                }
            });
        });
    }

    if (aiTranslateOthersBtn) {
        aiTranslateOthersBtn.addEventListener('click', function () {
            var ctx = getDictionaryEditContext();
            if (!ctx.word) {
                toastAction('warning', dictionaryMessages.aiTranslateNeedWord);
                return;
            }
            lastOthersPayload = null;
            startDictionaryAiSse(entryAiTranslateOthersStreamUrl, {
                csrf: getDictionaryEditAiCsrf(),
                md5: ctx.md5,
                word: ctx.word,
                locale_code: ctx.localeCode
            }, {
                busyMessage: dictionaryMessages.aiTranslateOthersBusy,
                onDone: function (data) {
                    data = data || {};
                    if (data.success === false) {
                        setDictionaryEditAiProgress(data.message || dictionaryMessages.aiTranslateFailed, null, 'danger');
                        toastAction('error', data.message || dictionaryMessages.aiTranslateFailed);
                        return;
                    }
                    var draftMap = (data.drafts || data.translations || data.items) || {};
                    var draftCodes = Object.keys(draftMap);
                    var skippedList = Array.isArray(data.skipped) ? data.skipped : [];
                    if (!draftCodes.length) {
                        // success + empty drafts usually means every locale was skipped
                        // (already translated) — never paint the success copy as a red error.
                        var emptyMsg = skippedList.length
                            ? (dictionaryMessages.aiOthersAllSkipped || data.message || dictionaryMessages.aiOthersEmpty)
                            : (dictionaryMessages.aiOthersEmpty || data.message);
                        var emptyTone = skippedList.length ? 'success' : 'warning';
                        setDictionaryEditAiProgress(emptyMsg, null, emptyTone === 'success' ? 'success' : 'danger');
                        toastAction(emptyTone === 'success' ? 'success' : 'warning', emptyMsg);
                        return;
                    }
                    // 跨语种仍全文等于原文 → 无意义，禁止弹确认保存
                    var sourceWord = String(ctx.word || '').trim();
                    var echoCount = 0;
                    draftCodes.forEach(function (code) {
                        if (String(draftMap[code] == null ? '' : draftMap[code]).trim() === sourceWord) {
                            echoCount += 1;
                        }
                    });
                    if (sourceWord !== '' && echoCount === draftCodes.length) {
                        // Never reuse the success「草稿已就绪」copy for echo failures.
                        var echoMsg = dictionaryMessages.aiOthersEchoFailed;
                        setDictionaryEditAiProgress(echoMsg, null, 'danger');
                        toastAction('error', echoMsg);
                        return;
                    }
                    lastOthersPayload = data;
                    setDictionaryEditAiProgress(data.message || dictionaryMessages.aiTranslateDone, 100, 'success');
                    var summary = buildOthersSummary(data);
                    confirmAction(summary, 'info', {
                        title: dictionaryMessages.aiOthersSaveTitle,
                        tone: 'info',
                        size: 'lg',
                        confirmLabel: dictionaryMessages.aiOthersSaveConfirmLabel,
                    }).then(function (confirmed) {
                        if (!confirmed) {
                            return;
                        }
                        var translations = (lastOthersPayload && (lastOthersPayload.drafts || lastOthersPayload.translations || lastOthersPayload.items)) || {};
                        if (!translations || !Object.keys(translations).length) {
                            toastAction('warning', dictionaryMessages.aiOthersEmpty);
                            return;
                        }
                        var fd = new FormData();
                        fd.append('csrf', getDictionaryEditAiCsrf());
                        fd.append('md5', ctx.md5);
                        fd.append('word', ctx.word);
                        fd.append('locale_code', ctx.localeCode);
                        fd.append('translations', JSON.stringify(translations));
                        fetch(resolveDictionarySameOriginUrl(entryAiSaveOthersUrl), {
                            method: 'POST',
                            body: fd,
                            credentials: 'same-origin',
                            headers: {
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        }).then(function (response) {
                            return response.json().catch(function () {
                                return { success: false, message: dictionaryMessages.aiOthersSaveFailed };
                            }).then(function (json) {
                                return { ok: response.ok, json: json || {} };
                            });
                        }).then(function (result) {
                            if (result.ok && result.json.success !== false) {
                                toastAction('success', result.json.message || dictionaryMessages.aiOthersSaveSuccess);
                                return;
                            }
                            toastAction('error', (result.json && result.json.message) || dictionaryMessages.aiOthersSaveFailed);
                        }).catch(function (error) {
                            toastAction('error', dictionaryMessages.aiOthersSaveFailed + (error && error.message ? (': ' + error.message) : ''));
                        });
                    });
                },
                onFailed: function (data) {
                    setDictionaryEditAiProgress((data && data.message) || dictionaryMessages.aiTranslateFailed, null, 'danger');
                    toastAction('error', (data && data.message) || dictionaryMessages.aiTranslateFailed);
                }
            });
        });
    }

    var collectButton = document.getElementById('dictionary-collect-btn');
    var collectModal = document.getElementById('dictionary-collect-modal');
    var collectStreamUrl = '@backend-url{'*/backend/dictionary/collect-words-stream'}';

    function getCollectTerminal() {
        return window.WelineSseTerminal && window.WelineSseTerminal['dictionary-collect-terminal'];
    }

    function closeCollectModal() {
        if (collectModal) {
            collectModal.classList.remove('is-open');
        }
        var term = getCollectTerminal();
        if (term && typeof term.stop === 'function') {
            term.stop();
        }
    }

    function openCollectModal() {
        if (collectModal) {
            collectModal.classList.add('is-open');
        }
        var hint = document.getElementById('dictionary-collect-hint');
        if (hint) {
            hint.textContent = '';
        }
    }

    if (collectModal) {
        ['dictionary-collect-modal-close', 'dictionary-collect-close-btn', 'dictionary-collect-modal-backdrop'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) {
                el.addEventListener('click', closeCollectModal);
            }
        });
    }

    function startCollectStream() {
        var term = getCollectTerminal();
        if (!term) {
            toastAction('error', dictionaryMessages.confirmUnavailable);
            return;
        }

        openCollectModal();
        if (typeof term.clear === 'function') {
            term.clear();
        }

        var fd = new FormData();
        fd.append('csrf', document.getElementById('dictionary-collect-sse-csrf').value);
        fd.append('locale_code', localeCode);

        term.on('done', function (event) {
            collectButton.disabled = false;
            var data = event && event.data ? event.data : {};
            try {
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }
            } catch (parseError) {
                data = {};
            }

            if (data.progress) {
                updateProgress(data.progress);
            }
            toastAction('success', data.message || '<?= addslashes(__('收集完成')) ?>');
            var hint = document.getElementById('dictionary-collect-hint');
            if (hint && data.count !== undefined) {
                hint.textContent = '<?= addslashes(__('新增词条')) ?>: ' + String(data.count);
            }
        });

        term.on('failed', function (event) {
            collectButton.disabled = false;
            var data = event && event.data ? event.data : {};
            try {
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }
            } catch (parseError) {
                data = {};
            }
            toastAction('error', (data && data.message) ? data.message : '<?= addslashes(__('收集失败')) ?>');
        });

        term.on('error', function () {
            collectButton.disabled = false;
            toastAction('error', '<?= addslashes(__('SSE 连接失败，请重试')) ?>');
        });

        term.start(collectStreamUrl, { method: 'POST', body: fd, oneShot: true });
    }

    if (collectButton) {
        collectButton.addEventListener('click', function () {
            confirmAction(dictionaryMessages.collectMessage, 'info', {
                title: dictionaryMessages.collectTitle,
                tone: 'info',
                confirmLabel: dictionaryMessages.collectConfirmLabel,
            }).then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                collectButton.disabled = true;
                startCollectStream();
            });
        });
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatModulePercent(percent) {
        var raw = String(Number(percent || 0));
        return raw.replace(/\.0$/, '').replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '') + '%';
    }

    function renderModuleCatalogRows(items) {
        var body = document.getElementById('i18n-module-catalog-body');
        if (!body) {
            return;
        }
        items = Array.isArray(items) ? items : [];
        if (items.length === 0) {
            body.innerHTML = '<tr><td colspan="7" class="i18n-admin-empty">'
                + '<div class="w-text" data-weight="strong" style="--w-mb:var(--weline-space-2);">' + escapeHtml(moduleCatalogMessages.emptyTitle) + '</div>'
                + '<div>' + escapeHtml(moduleCatalogMessages.emptyHint) + '</div>'
                + '</td></tr>';
            body.setAttribute('data-catalog-loaded', '1');
            moduleCatalogLoaded = true;
            return;
        }

        var html = items.map(function (rowData) {
            var moduleName = String(rowData.module || '');
            var statsReady = rowData.stats_ready !== false;
            var total = Number(rowData.total || 0);
            var translated = Number(rowData.translated || 0);
            var untranslated = Number(rowData.untranslated || 0);
            var percent = Number(rowData.progress_percent || 0);
            var pending = Number(rowData.ai_pending_export || 0);
            var pendingLabel = moduleCatalogMessages.pendingStats;
            var translateDisabled = (!statsReady || untranslated <= 0) ? ' disabled' : '';
            var exportDisabled = (!statsReady || !moduleExportDev || pending <= 0) ? ' disabled' : '';
            return '<tr data-module-row="' + escapeHtml(moduleName) + '" data-stats-ready="' + (statsReady ? '1' : '0') + '">'
                + '<td><div class="w-text" data-weight="strong">' + escapeHtml(moduleName) + '</div>'
                + '<div class="w-text" data-tone="muted" data-size="sm">i18n/</div></td>'
                + '<td><span data-module-total>' + (statsReady ? total : escapeHtml(pendingLabel)) + '</span></td>'
                + '<td><span class="w-text" data-tone="success" data-module-translated>' + (statsReady ? translated : escapeHtml(pendingLabel)) + '</span></td>'
                + '<td><span class="w-text" data-tone="warning" data-module-untranslated>' + (statsReady ? untranslated : escapeHtml(pendingLabel)) + '</span></td>'
                + '<td><div class="w-text" data-size="sm" data-module-percent>' + (statsReady ? escapeHtml(formatModulePercent(percent)) : escapeHtml(pendingLabel)) + '</div>'
                + '<div class="i18n-admin-progress i18n-module-progress"><span style="width: ' + (statsReady ? Math.max(0, Math.min(100, percent)) : 0) + '%;"></span></div></td>'
                + '<td><span data-module-pending-export>' + pending + '</span></td>'
                + '<td class="w-text" data-align="center"><div class="w-cluster" data-wrap="true" data-justify="center" style="--w-gap:var(--weline-space-2);">'
                + '<button type="button" class="w-button i18n-module-translate-btn" data-module="' + escapeHtml(moduleName) + '" data-tone="success" data-variant="outline" data-size="sm"' + translateDisabled + '>'
                + escapeHtml(moduleCatalogMessages.translateLabel) + '</button>'
                + '<button type="button" class="w-button i18n-module-export-btn" data-module="' + escapeHtml(moduleName) + '" data-tone="primary" data-variant="outline" data-size="sm"' + exportDisabled + '>'
                + escapeHtml(moduleCatalogMessages.exportLabel) + '</button>'
                + '</div></td></tr>';
        }).join('');
        body.innerHTML = html;
        body.setAttribute('data-catalog-loaded', '1');
        moduleCatalogLoaded = true;
        bindModuleCatalogActions(body);
        hydrateModuleCatalogStats(items);
    }

    function hydrateModuleCatalogStats(items) {
        var pendingModules = (Array.isArray(items) ? items : [])
            .filter(function (rowData) {
                return rowData && rowData.module && rowData.stats_ready === false;
            })
            .map(function (rowData) {
                return String(rowData.module);
            });
        if (pendingModules.length === 0 || moduleCatalogHydrating) {
            return;
        }
        moduleCatalogHydrating = true;
        var batchSize = 6;
        var cursor = 0;
        var hydrateErrorShown = false;

        function runNextBatch() {
            if (cursor >= pendingModules.length) {
                moduleCatalogHydrating = false;
                return;
            }
            var chunk = pendingModules.slice(cursor, cursor + batchSize);
            cursor += batchSize;
            postJson(endpoints.moduleCatalogStats, {
                locale_code: localeCode,
                modules: chunk
            }).then(function (result) {
                if (result && result.success === false) {
                    if (!hydrateErrorShown) {
                        hydrateErrorShown = true;
                        toastAction('error', (result && result.message) || moduleCatalogMessages.loadFailed);
                    }
                    moduleCatalogHydrating = false;
                    return;
                }
                if (result && Array.isArray(result.items)) {
                    result.items.forEach(function (rowData) {
                        if (!rowData) {
                            return;
                        }
                        rowData.stats_ready = true;
                        updateModuleRow(rowData);
                    });
                }
                runNextBatch();
            }).catch(function (error) {
                if (!hydrateErrorShown) {
                    hydrateErrorShown = true;
                    toastAction('error', moduleCatalogMessages.loadFailed + (error && error.message ? (': ' + error.message) : ''));
                }
                moduleCatalogHydrating = false;
            });
        }

        runNextBatch();
    }

    function ensureModuleCatalogLoaded(forceReload) {
        var body = document.getElementById('i18n-module-catalog-body');
        if (!body) {
            return;
        }
        if (!forceReload && (moduleCatalogLoaded || body.getAttribute('data-catalog-loaded') === '1')) {
            return;
        }
        if (moduleCatalogLoading) {
            return;
        }
        moduleCatalogLoading = true;
        moduleCatalogHydrating = false;
        body.innerHTML = '<tr data-module-catalog-placeholder="1"><td colspan="7" class="i18n-admin-empty">'
            + '<div class="w-text" data-weight="strong">' + escapeHtml(moduleCatalogMessages.loading) + '</div>'
            + '</td></tr>';

        var searchInput = document.querySelector('#i18n-tab-panel-modules input[name="module_search"]');
        var searchValue = searchInput ? String(searchInput.value || '') : String(moduleSearch || '');
        postJson(endpoints.moduleCatalog, {
            locale_code: localeCode,
            module_search: searchValue
        }).then(function (result) {
            moduleCatalogLoading = false;
            if (result && result.dev_environment !== undefined) {
                moduleExportDev = !!result.dev_environment;
            }
            if (!result || result.success === false) {
                body.innerHTML = '<tr><td colspan="7" class="i18n-admin-empty">'
                    + '<div class="w-text" data-weight="strong">' + escapeHtml((result && result.message) || moduleCatalogMessages.loadFailed) + '</div>'
                    + '</td></tr>';
                body.setAttribute('data-catalog-loaded', '0');
                moduleCatalogLoaded = false;
                return;
            }
            renderModuleCatalogRows(result.items || []);
        }).catch(function (error) {
            moduleCatalogLoading = false;
            body.innerHTML = '<tr><td colspan="7" class="i18n-admin-empty">'
                + '<div class="w-text" data-weight="strong">' + escapeHtml(moduleCatalogMessages.loadFailed) + '</div>'
                + '<div>' + escapeHtml(error && error.message ? error.message : '') + '</div>'
                + '</td></tr>';
            body.setAttribute('data-catalog-loaded', '0');
            moduleCatalogLoaded = false;
        });
    }

    function switchTab(tabName) {
        activeTab = tabName === 'modules' ? 'modules' : 'dictionary';
        document.querySelectorAll('.i18n-dictionary-tab').forEach(function (btn) {
            var isActive = btn.getAttribute('data-i18n-tab') === activeTab;
            btn.classList.toggle('is-active', isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        var dictPanel = document.getElementById('i18n-tab-panel-dictionary');
        var modulePanel = document.getElementById('i18n-tab-panel-modules');
        if (dictPanel) {
            dictPanel.hidden = activeTab !== 'dictionary';
        }
        if (modulePanel) {
            modulePanel.hidden = activeTab !== 'modules';
        }
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('tab', activeTab);
            window.history.replaceState({}, '', url.toString());
        } catch (ignore) {}
        if (activeTab === 'modules') {
            ensureModuleCatalogLoaded(false);
        }
    }

    document.querySelectorAll('.i18n-dictionary-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
            switchTab(btn.getAttribute('data-i18n-tab') || 'dictionary');
        });
    });

    function updateModuleRow(rowData) {
        if (!rowData || !rowData.module) {
            return;
        }
        var row = document.querySelector('[data-module-row="' + String(rowData.module).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"]');
        if (!row) {
            return;
        }
        var statsReady = rowData.stats_ready !== false;
        row.setAttribute('data-stats-ready', statsReady ? '1' : '0');
        var totalEl = row.querySelector('[data-module-total]');
        var translatedEl = row.querySelector('[data-module-translated]');
        var untranslatedEl = row.querySelector('[data-module-untranslated]');
        var percentEl = row.querySelector('[data-module-percent]');
        var pendingEl = row.querySelector('[data-module-pending-export]');
        var progressBar = row.querySelector('.i18n-module-progress span');
        var translateBtn = row.querySelector('.i18n-module-translate-btn');
        var exportBtn = row.querySelector('.i18n-module-export-btn');

        if (totalEl) totalEl.textContent = statsReady ? String(rowData.total || 0) : moduleCatalogMessages.pendingStats;
        if (translatedEl) translatedEl.textContent = statsReady ? String(rowData.translated || 0) : moduleCatalogMessages.pendingStats;
        if (untranslatedEl) untranslatedEl.textContent = statsReady ? String(rowData.untranslated || 0) : moduleCatalogMessages.pendingStats;
        var percent = Number(rowData.progress_percent || 0);
        if (percentEl) percentEl.textContent = statsReady ? formatModulePercent(percent) : moduleCatalogMessages.pendingStats;
        if (progressBar) progressBar.style.width = (statsReady ? Math.max(0, Math.min(100, percent)) : 0) + '%';
        if (pendingEl) pendingEl.textContent = String(rowData.ai_pending_export || 0);
        if (translateBtn) translateBtn.disabled = !statsReady || Number(rowData.untranslated || 0) <= 0;
        if (exportBtn) exportBtn.disabled = !statsReady || !moduleExportDev || Number(rowData.ai_pending_export || 0) <= 0;
    }

    function bindModuleCatalogActions(root) {
        var scope = root || document;
        if (scope.getAttribute && scope.getAttribute('data-module-actions-bound') === '1') {
            return;
        }
        if (scope.setAttribute) {
            scope.setAttribute('data-module-actions-bound', '1');
        }
        scope.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || !target.closest) {
                return;
            }
            var translateBtn = target.closest('.i18n-module-translate-btn');
            if (translateBtn) {
                var translateModule = translateBtn.getAttribute('data-module') || '';
                if (!translateModule) {
                    return;
                }
                var translateMessage = dictionaryMessages.moduleTranslateMessage.replace('%{1}', translateModule);
                confirmAction(translateMessage, 'info', {
                    title: dictionaryMessages.moduleTranslateTitle,
                    tone: 'info',
                }).then(function (confirmed) {
                    if (!confirmed) {
                        return;
                    }
                    translateBtn.disabled = true;
                    postJson(endpoints.moduleTranslate, {
                        locale_code: localeCode,
                        module: translateModule,
                    }).then(function (result) {
                        if (result.success) {
                            var detail = result.translated !== undefined
                                ? ('<?= addslashes(__('本批成功')) ?>: ' + result.translated + '，<?= addslashes(__('剩余')) ?>: ' + (result.remaining || 0))
                                : (result.message || '');
                            toastAction('success', detail || '<?= addslashes(__('模块 AI 翻译完成')) ?>');
                            if (result.module_row) {
                                updateModuleRow(result.module_row);
                            }
                            return;
                        }
                        toastAction('error', result.message || '<?= addslashes(__('模块 AI 翻译失败')) ?>');
                        translateBtn.disabled = false;
                    }).catch(function (error) {
                        toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                        translateBtn.disabled = false;
                    });
                });
                return;
            }

            var exportBtn = target.closest('.i18n-module-export-btn');
            if (!exportBtn) {
                return;
            }
            var exportModule = exportBtn.getAttribute('data-module') || '';
            if (!exportModule) {
                return;
            }
            confirmAction(dictionaryMessages.moduleExportMessage, 'info', {
                title: dictionaryMessages.moduleExportTitle,
                tone: 'info',
            }).then(function (confirmed) {
                if (!confirmed) {
                    return;
                }
                exportBtn.disabled = true;
                postJson(endpoints.moduleExportCsv, {
                    locale_code: localeCode,
                    module: exportModule,
                }).then(function (result) {
                    if (result.success) {
                        toastAction('success', result.message || ('<?= addslashes(__('已写回')) ?> ' + (result.exported || 0) + ' <?= addslashes(__('条')) ?>'));
                        if (result.module_row) {
                            updateModuleRow(result.module_row);
                        }
                        return;
                    }
                    toastAction('error', result.message || '<?= addslashes(__('写回失败')) ?>');
                    exportBtn.disabled = false;
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                    exportBtn.disabled = false;
                });
            });
        });
    }

    bindModuleCatalogActions(document.getElementById('i18n-module-catalog-body') || document);

    function bindClearButton(buttonId, endpoint, message, payload) {
        var button = document.getElementById(buttonId);
        if (!button) {
            return;
        }

        button.addEventListener('click', function () {
            confirmAction(message, 'danger').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                button.disabled = true;
                postJson(endpoint, payload || {}).then(function (result) {
                    if (result.success) {
                        toastAction('success', result.message || '<?= addslashes(__('清理完成')) ?>');
                        return;
                    }

                    toastAction('error', result.message || '<?= addslashes(__('清理失败')) ?>');
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                }).finally(function () {
                    button.disabled = false;
                });
            });
        });
    }

    bindClearButton(
        'dictionary-clear-locale-btn',
        endpoints.clearLocale,
        <?= json_encode((string)__('确定清理当前目标语言 %{1} 的所有译文吗？基础词条会保留。', [$localeCode]), $jsonForScriptFlags) ?>,
        {locale_code: localeCode}
    );

    bindClearButton(
        'dictionary-clear-all-btn',
        endpoints.clearAll,
        <?= json_encode((string)__('确定清理全部词典和所有语言译文吗？此操作不可撤销。'), $jsonForScriptFlags) ?>,
        {}
    );

    var inlineEditStartBtn = document.getElementById('dictionary-inline-edit-start');
    if (inlineEditStartBtn) {
        inlineEditStartBtn.addEventListener('click', function () {
            confirmAction('<?= addslashes(__('店面点译')) ?>', 'info').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }
                postJson(endpoints.inlineEditStart, {}).then(function (result) {
                    if (!result.success || !result.jump_url) {
                        toastAction('error', result.message || '<?= addslashes(__('无法打开店面点译')) ?>');
                        return;
                    }
                    toastAction('success', result.message || '<?= addslashes(__('正在跳转店面')) ?>');
                    window.open(result.jump_url, '_blank', 'noopener');
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                });
            });
        });
    }

    var autoRegisterButton = document.getElementById('dictionary-auto-register-toggle');
    if (autoRegisterButton) {
        autoRegisterButton.addEventListener('click', function () {
            var enabled = autoRegisterButton.dataset.enabled === '1';
            var url = enabled ? endpoints.disableAutoRegister : endpoints.enableAutoRegister;

            confirmAction(enabled ? '<?= addslashes(__('停用')) ?>' : '<?= addslashes(__('自动词汇注册')) ?>', enabled ? 'warning' : 'success').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                postJson(url, {}).then(function (result) {
                    if (!result.success) {
                        toastAction('error', result.message || '<?= addslashes(__('保存失败')) ?>');
                        return;
                    }

                    toastAction('success', result.message || '<?= addslashes(__('保存成功')) ?>');
                    return postJson(endpoints.checkAutoRegister, {locale_code: localeCode}).then(function (statusResult) {
                        updateModeState({
                            mode: document.getElementById('dictionary-mode-chip').textContent,
                            mode_name: document.getElementById('dictionary-mode-chip').textContent,
                            auto_register: !!statusResult.enabled
                        });
                    });
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                });
            });
        });
    }

    document.querySelectorAll('#dictionary-import-modal form').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();

            var fileInput = form.querySelector('input[type="file"]');
            var file = fileInput && fileInput.files ? fileInput.files[0] : null;
            if (!file) {
                toastAction('error', '<?= addslashes(__('请选择要导入的CSV文件')) ?>');
                return;
            }

            file.text().then(function (content) {
                return postJson('dictionary-import', {
                    file_name: file.name,
                    csv_content: content
                });
            }).then(function (result) {
                if (!result.success) {
                    toastAction('error', result.message || '<?= addslashes(__('导入失败!')) ?>');
                    return;
                }

                toastAction('success', result.message || '<?= addslashes(__('导入完成!')) ?>');
                if (result.progress) {
                    updateProgress(result.progress);
                }
            }).catch(function (error) {
                toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
            });
        });
    });

    loadModeState();
    updateProgress(<?= json_encode($progress, $jsonForScriptFlags) ?>);
    switchTab(activeTab);
})();
</script>
