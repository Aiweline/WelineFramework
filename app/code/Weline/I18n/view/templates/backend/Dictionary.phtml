    function resolveDictionarySameOriginUrl(url) {
        var raw = String(url || '');
        if (!raw) {
            return raw;
        }
        try {
            var resolved = new URL(raw, window.location.href);
            return resolved.pathname + resolved.search + resolved.hash;
        } catch (e) {
            return raw;
        }
    }

