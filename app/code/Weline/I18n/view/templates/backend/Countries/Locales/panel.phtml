<?php
/** @var \Weline\Framework\View\Template $this */

$locales = $this->getData('locales') ?? [];
$pagination = $this->getData('pagination') ?: '';
$countryCode = (string)\w_env_get('country_code', '');
$search = (string)\w_env_get('search', '');

$readValue = static function ($item, string $key, mixed $default = null): mixed {
    if (is_array($item)) {
        return $item[$key] ?? $default;
    }
    if (is_object($item)) {
        if (method_exists($item, 'getData')) {
            $value = $item->getData($key);
            return $value === null ? $default : $value;
        }
        return $item->{$key} ?? $default;
    }

    return $default;
};

$renderHiddenFields = static function (array $fields): string {
    $html = '';
    foreach ($fields as $name => $value) {
        if ($value === '' || $value === null) {
            continue;
        }
        $html .= '<input type="hidden" name="' . htmlspecialchars((string)$name, ENT_QUOTES, 'UTF-8') . '" value="' .
            htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8') . '">' . PHP_EOL;
    }

    return $html;
};

$countryName = $countryCode;
foreach ($locales as $locale) {
    $countryName = (string)$readValue($locale, 'country_name', $countryCode);
    if ($countryName !== '') {
        break;
    }
}

$preserve = ['country_code' => $countryCode];
if ($search !== '') {
    $preserve['search'] = $search;
}
?>
<div class="i18n-locales-panel"
     data-locales-panel-root="1"
     data-country-code="<?= htmlspecialchars($countryCode, ENT_QUOTES, 'UTF-8') ?>"
     data-panel-base="@backend-url('*/backend/countries/locales')">
    <div class="i18n-locales-panel__intro" style="--w-mb:var(--weline-space-4);">
        <div class="w-text" data-tone="muted" data-size="sm"><?= __('国家名称') ?></div>
        <div class="w-text" data-weight="strong" data-size="lg" data-locales-panel-title>
            <?= htmlspecialchars($countryName !== '' ? $countryName : $countryCode, ENT_QUOTES, 'UTF-8') ?>
            <?php if ($countryCode !== ''): ?>
                <span class="w-text" data-tone="muted">/ <?= htmlspecialchars($countryCode, ENT_QUOTES, 'UTF-8') ?></span>
            <?php endif; ?>
        </div>
    </div>

    <form method="get"
          action="@backend-url('*/backend/countries/locales')"
          class="w-cluster i18n-locales-panel__search"
          data-wrap="true"
          data-align="end"
          data-locales-panel-search="1"
          style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);">
        <input type="hidden" name="country_code" value="<?= htmlspecialchars($countryCode, ENT_QUOTES, 'UTF-8') ?>">
        <label class="w-field i18n-locales-panel__search-field" style="--w-min:0;--w-flex:1;">
            <span class="w-field__label"><?= __('搜索') ?></span>
            <input type="text" name="search" class="w-input" value="<?= htmlspecialchars($search, ENT_QUOTES, 'UTF-8') ?>" placeholder="<?= __('地区代码或名称') ?>">
        </label>
        <div class="w-cluster i18n-locales-panel__search-actions" data-wrap="true" style="--w-gap:var(--weline-space-2);">
            <button type="submit" class="w-button" data-tone="primary"><?= __('搜索') ?></button>
            <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-locales-panel-reset="1"><?= __('重置') ?></button>
        </div>
    </form>

    <div class="i18n-locales-panel__list" data-testid="i18n-locales-panel-list">
        <?php if (!empty($locales)): ?>
            <?php foreach ($locales as $locale): ?>
                <?php
                $code = (string)$readValue($locale, 'code', '');
                $shortCode = (string)$readValue($locale, 'short_code', '');
                $localeName = (string)$readValue($locale, 'locale_name', $code);
                $localeCountryCode = (string)$readValue($locale, 'country_code', $countryCode);
                $isInstall = (int)$readValue($locale, 'is_install', 0) === 1;
                $isActive = (int)$readValue($locale, 'is_active', 0) === 1;
                ?>
                <article class="i18n-locales-panel__card" data-locale-code="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                    <div class="i18n-locales-panel__card-codes w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                        <span class="w-badge w-text" data-w-background="primary" data-tone="primary"><?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?></span>
                        <?php if ($shortCode !== ''): ?>
                            <span class="w-badge w-text" data-w-background="info" data-tone="info"><?= htmlspecialchars($shortCode, ENT_QUOTES, 'UTF-8') ?></span>
                        <?php endif; ?>
                    </div>

                    <div class="i18n-locales-panel__card-name">
                        <div class="w-text" data-weight="strong"><?= htmlspecialchars($localeName, ENT_QUOTES, 'UTF-8') ?></div>
                        <div class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$readValue($locale, 'country_name', $countryName), ENT_QUOTES, 'UTF-8') ?></div>
                    </div>

                    <div class="i18n-locales-panel__card-states w-cluster" data-wrap="true" style="--w-gap:var(--weline-space-2);">
                        <span class="w-text" data-locale-active-state>
                            <?php if ($isActive): ?>
                                <span class="w-badge w-text" data-w-background="success" data-tone="success"><?= __('已激活') ?></span>
                            <?php else: ?>
                                <span class="w-badge w-text" data-w-background="muted" data-tone="muted"><?= __('未激活') ?></span>
                            <?php endif; ?>
                        </span>
                        <span class="w-text" data-locale-install-state>
                            <?php if ($isInstall): ?>
                                <span class="w-badge w-text" data-w-background="primary" data-tone="primary"><?= __('已安装') ?></span>
                            <?php else: ?>
                                <span class="w-badge w-text" data-w-background="muted" data-tone="muted"><?= __('未安装') ?></span>
                            <?php endif; ?>
                        </span>
                    </div>

                    <div class="i18n-locales-panel__actions">
                        <?php if ($isInstall && $isActive): ?>
                            <a class="w-button"
                               href="@backend-url('*/backend/dictionary')?locale_code=<?= urlencode($code) ?>&country_code=<?= urlencode($localeCountryCode) ?>"
                               target="_blank"
                               rel="noopener"
                               data-tone="info"
                               data-variant="outline"
                               data-size="sm">
                                <?= __('词典管理') ?>
                            </a>
                        <?php endif; ?>

                        <?php if (!$isInstall): ?>
                            <w:form method="post"
                                  action="@backend-url('*/backend/countries/locales/install')"
                                  data-async-action="locale-install"
                                  data-async-transport="sse"
                                  data-async-reload="1"
                                  data-async-success-message="@var(__('区域已安装并激活，已刷新到列表顶部。'))"
                                  data-confirm-message="@var(__('确定安装 %{1} 吗？安装后将默认激活。', [$code]))"
                                  data-confirm-type="info">
                                <input type="hidden" name="code" value="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                                <?= $renderHiddenFields($preserve) ?>
                                <button type="submit" class="w-button" data-async-submit-label="<?= htmlspecialchars(__('安装中…'), ENT_QUOTES, 'UTF-8') ?>" data-async-complete-label="<?= htmlspecialchars(__('已安装并激活'), ENT_QUOTES, 'UTF-8') ?>" data-tone="primary" data-variant="outline" data-size="sm"><?= __('安装') ?></button>
                            </w:form>
                        <?php elseif (!$isActive): ?>
                            <w:form method="post"
                                  action="@backend-url('*/backend/countries/locales/active')"
                                  data-async-action="locale-activate"
                                  data-async-transport="sse"
                                  data-async-reload="1"
                                  data-async-success-message="@var(__('区域已激活，当前位置已保留。'))"
                                  data-confirm-message="@var(__('确定启用 %{1} 吗？所属国家会同步启用。', [$code]))"
                                  data-confirm-type="success">
                                <input type="hidden" name="code" value="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                                <?= $renderHiddenFields($preserve) ?>
                                <button type="submit" class="w-button" data-async-submit-label="<?= htmlspecialchars(__('激活中…'), ENT_QUOTES, 'UTF-8') ?>" data-async-complete-label="<?= htmlspecialchars(__('已激活'), ENT_QUOTES, 'UTF-8') ?>" data-tone="success" data-variant="outline" data-size="sm"><?= __('激活') ?></button>
                            </w:form>
                        <?php endif; ?>

                        <?php if ($isActive): ?>
                            <w:form method="post"
                                  action="@backend-url('*/backend/countries/locales/disable')"
                                  data-async-action="locale-deactivate"
                                  data-async-transport="http"
                                  data-async-reload="1"
                                  data-async-complete-label="@var(__('已停用'))"
                                  data-confirm-message="@var(__('确定停用 %{1} 吗？所属国家状态会自动同步。', [$code]))"
                                  data-confirm-type="warning">
                                <input type="hidden" name="code" value="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                                <?= $renderHiddenFields($preserve) ?>
                                <button type="submit" class="w-button" data-tone="warning" data-variant="outline" data-size="sm"><?= __('停用') ?></button>
                            </w:form>
                        <?php endif; ?>

                        <?php if ($isInstall): ?>
                            <w:form method="post"
                                  action="@backend-url('*/backend/countries/locales/uninstall')"
                                  data-async-action="locale-uninstall"
                                  data-async-transport="http"
                                  data-async-reload="1"
                                  data-async-complete-label="@var(__('已卸载'))"
                                  data-async-active-label="@var(__('未激活'))"
                                  data-confirm-message="@var(__('确定卸载 %{1} 吗？语言包和缓存会同步清理。', [$code]))"
                                  data-confirm-type="danger">
                                <input type="hidden" name="code" value="<?= htmlspecialchars($code, ENT_QUOTES, 'UTF-8') ?>">
                                <?= $renderHiddenFields($preserve) ?>
                                <button type="submit" class="w-button" data-tone="danger" data-variant="outline" data-size="sm"><?= __('卸载') ?></button>
                            </w:form>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        <?php else: ?>
            <div class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-10);--w-pb:var(--weline-space-10);"><?= __('暂无地区数据') ?></div>
        <?php endif; ?>
    </div>

    <?php if ($pagination !== ''): ?>
        <div class="i18n-locales-panel__pagination" data-locales-panel-pagination style="--w-mt:var(--weline-space-4);"><?= $pagination ?></div>
    <?php endif; ?>
</div>
