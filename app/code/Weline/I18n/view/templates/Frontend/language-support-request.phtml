<style>
.weline-language-request-form .w-name-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--weline-space-4)}.weline-language-request-form .w-field--email{max-width:22rem}.weline-language-request-form .w-field--locales{max-width:100%}
