<script>
(function () {
    'use strict';

    var dictionaryMessages = {
        confirmTitle: <?= json_encode((string)__('确认操作'), $jsonForScriptFlags) ?>,
        confirmLabel: <?= json_encode((string)__('确定'), $jsonForScriptFlags) ?>,
        cancelLabel: <?= json_encode((string)__('取消'), $jsonForScriptFlags) ?>,
        collectTitle: <?= json_encode((string)__('收集词典'), $jsonForScriptFlags) ?>,
        collectMessage: <?= json_encode((string)__('将从源码与模块语言包扫描词条，写入词典并刷新统计。继续吗？'), $jsonForScriptFlags) ?>,
        collectConfirmLabel: <?= json_encode((string)__('开始收集'), $jsonForScriptFlags) ?>,
        moduleTranslateTitle: <?= json_encode((string)__('模块 AI 翻译'), $jsonForScriptFlags) ?>,
        moduleTranslateMessage: <?= json_encode((string)__('将为模块 %{1} 翻译一批未译词条（已存在的译文不会重复翻译）。继续吗？'), $jsonForScriptFlags) ?>,
        moduleExportTitle: <?= json_encode((string)__('写回模块 CSV'), $jsonForScriptFlags) ?>,
        moduleExportMessage: <?= json_encode((string)__('将把词典中该模块的 AI 译文增量写回 i18n/{locale}.csv（开发环境）。继续吗？'), $jsonForScriptFlags) ?>,
        confirmUnavailable: <?= json_encode((string)__('确认组件不可用，请刷新页面后重试。'), $jsonForScriptFlags) ?>
    };

    function confirmAction(message, type, options) {
        options = Object.assign({
            title: dictionaryMessages.confirmTitle,
            tone: type || 'info',
            confirmLabel: dictionaryMessages.confirmLabel,
            cancelLabel: dictionaryMessages.cancelLabel,
        }, options || {});

        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog
            && typeof window.Weline.UI.dialog.confirm === 'function') {
            return window.Weline.UI.dialog.confirm(String(message || ''), options);
        }

        if (window.I18nAdminUI && typeof window.I18nAdminUI.confirm === 'function') {
            return window.I18nAdminUI.confirm(String(message || ''), options.tone, options);
        }

        toastAction('error', dictionaryMessages.confirmUnavailable);
        return Promise.resolve(false);
    }

    function toastAction(type, message) {
        if (window.Weline && window.Weline.UI && window.Weline.UI.toast
            && typeof window.Weline.UI.toast[type] === 'function') {
            window.Weline.UI.toast[type](message);
            return;
        }

        if (window.I18nAdminUI && typeof window.I18nAdminUI.toast === 'function') {
            window.I18nAdminUI.toast(type, message);
            return;
        }

        console[type === 'error' ? 'error' : 'log'](message);
    }

    var localeCode = <?= json_encode($localeCode, $jsonForScriptFlags) ?>;
    var moduleFilter = <?= json_encode($moduleFilter, $jsonForScriptFlags) ?>;
    var activeTab = <?= json_encode($activeTab, $jsonForScriptFlags) ?>;
    var moduleExportDev = <?= $moduleExportDev ? 'true' : 'false' ?>;
    var endpoints = {
        collectWords: 'dictionary-collect',
        moduleTranslate: 'dictionary-module-translate',
        moduleExportCsv: 'dictionary-module-export-csv',
        moduleCatalog: 'dictionary-module-catalog',
        clearLocale: 'dictionary-clear-locale',
        clearAll: 'dictionary-clear-all',
        currentTranslationMode: 'dictionary-current-translation-mode',
        checkAutoRegister: 'dictionary-check-auto-register',
        enableAutoRegister: 'dictionary-auto-register-enable',
        disableAutoRegister: 'dictionary-auto-register-disable',
        setTranslationMode: 'dictionary-translation-mode'
    };

    function updateProgress(progress) {
        if (!progress) {
            return;
        }

        var translated = Number(progress.translated || 0);
        var total = Number(progress.total || 0);
        var untranslated = Number(progress.untranslated || Math.max(0, total - translated));
        var percent = Number(progress.progress_percent || 0);

        document.getElementById('dictionary-total-count').textContent = String(total);
        document.getElementById('dictionary-translated-count').textContent = String(translated);
        document.getElementById('dictionary-untranslated-count').textContent = String(untranslated);
        document.getElementById('dictionary-progress-translated').textContent = String(translated);
        document.getElementById('dictionary-progress-percent').textContent = String(percent).replace(/\.0$/, '') + '%';
        document.getElementById('dictionary-progress-bar').style.width = Math.max(0, Math.min(100, percent)) + '%';
    }

    function updateModeState(data) {
        if (!data) {
            return;
        }

        var modeName = data.mode_name || data.mode || '<?= addslashes(__('未知')) ?>';
        document.getElementById('dictionary-mode-label').textContent = modeName;
        document.getElementById('dictionary-mode-chip').textContent = modeName;
        document.getElementById('dictionary-auto-register-label').textContent = data.auto_register ? '<?= addslashes(__('激活')) ?>' : '<?= addslashes(__('停用')) ?>';
        document.getElementById('dictionary-auto-register-toggle').textContent = data.auto_register ? '<?= addslashes(__('停用')) ?>' : '<?= addslashes(__('自动词汇注册')) ?>';
        document.getElementById('dictionary-auto-register-toggle').dataset.enabled = data.auto_register ? '1' : '0';
    }

    function postJson(action, payload) {
        if (window.I18nAdminUI && typeof window.I18nAdminUI.requestBinAction === 'function') {
            return window.I18nAdminUI.requestBinAction(action, payload || {});
        }

        if (window.Weline && typeof window.Weline.load === 'function') {
            return window.Weline.load('api').then(function () {
                return window.I18nAdminUI.requestBinAction(action, payload || {});
            });
        }

        return Promise.reject(new Error('<?= addslashes(__('Weline.Api bin-query 不可用')) ?>'));
    }

    function loadModeState() {
        postJson(endpoints.currentTranslationMode, {locale_code: localeCode}).then(function (data) {
            updateModeState(data);
        }).catch(function () {
            toastAction('warning', '<?= addslashes(__('加载失败')) ?>');
        });
    }

    document.querySelectorAll('.dictionary-edit-trigger').forEach(function (button) {
        button.addEventListener('click', function () {
            document.getElementById('dictionary-edit-md5').value = button.dataset.md5 || '';
            document.getElementById('dictionary-edit-word').value = button.dataset.word || '';
            document.getElementById('dictionary-edit-translate').value = button.dataset.translate === button.dataset.word ? '' : (button.dataset.translate || '');
            var editLocaleCode = button.dataset.localeCode || localeCode || '';
            var editLanguageRoot = document.getElementById('dictionary_edit_locale_selector_wrapper');
            var editLanguageSelector = editLanguageRoot
                ? Weline.UI.get(editLanguageRoot, 'language-select')
                : null;
            if (editLanguageSelector && typeof editLanguageSelector.setValue === 'function') {
                editLanguageSelector.setValue(editLocaleCode);
                return;
            }

            var editLocaleInput = document.getElementById('dictionary-edit-locale-code');
            if (editLocaleInput) {
                editLocaleInput.value = editLocaleCode;
            }
        });
    });

    var collectButton = document.getElementById('dictionary-collect-btn');
    var collectModal = document.getElementById('dictionary-collect-modal');
    var collectStreamUrl = '@backend-url{'*/backend/dictionary/collect-words-stream'}';

    function getCollectTerminal() {
        return window.WelineSseTerminal && window.WelineSseTerminal['dictionary-collect-terminal'];
    }

    function closeCollectModal() {
        if (collectModal) {
            collectModal.classList.remove('is-open');
        }
        var term = getCollectTerminal();
        if (term && typeof term.stop === 'function') {
            term.stop();
        }
    }

    function openCollectModal() {
        if (collectModal) {
            collectModal.classList.add('is-open');
        }
        var hint = document.getElementById('dictionary-collect-hint');
        if (hint) {
            hint.textContent = '';
        }
    }

    if (collectModal) {
        ['dictionary-collect-modal-close', 'dictionary-collect-close-btn', 'dictionary-collect-modal-backdrop'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) {
                el.addEventListener('click', closeCollectModal);
            }
        });
    }

    function startCollectStream() {
        var term = getCollectTerminal();
        if (!term) {
            toastAction('error', dictionaryMessages.confirmUnavailable);
            return;
        }

        openCollectModal();
        if (typeof term.clear === 'function') {
            term.clear();
        }

        var fd = new FormData();
        fd.append('csrf', document.getElementById('dictionary-collect-sse-csrf').value);
        fd.append('locale_code', localeCode);

        term.on('done', function (event) {
            collectButton.disabled = false;
            var data = event && event.data ? event.data : {};
            try {
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }
            } catch (parseError) {
                data = {};
            }

            if (data.progress) {
                updateProgress(data.progress);
            }
            toastAction('success', data.message || '<?= addslashes(__('收集完成')) ?>');
            var hint = document.getElementById('dictionary-collect-hint');
            if (hint && data.count !== undefined) {
                hint.textContent = '<?= addslashes(__('新增词条')) ?>: ' + String(data.count);
            }
        });

        term.on('failed', function (event) {
            collectButton.disabled = false;
            var data = event && event.data ? event.data : {};
            try {
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }
            } catch (parseError) {
                data = {};
            }
            toastAction('error', (data && data.message) ? data.message : '<?= addslashes(__('收集失败')) ?>');
        });

        term.on('error', function () {
            collectButton.disabled = false;
            toastAction('error', '<?= addslashes(__('SSE 连接失败，请重试')) ?>');
        });

        term.start(collectStreamUrl, { method: 'POST', body: fd, oneShot: true });
    }

    if (collectButton) {
        collectButton.addEventListener('click', function () {
            confirmAction(dictionaryMessages.collectMessage, 'info', {
                title: dictionaryMessages.collectTitle,
                tone: 'info',
                confirmLabel: dictionaryMessages.collectConfirmLabel,
            }).then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                collectButton.disabled = true;
                startCollectStream();
            });
        });
    }

    function switchTab(tabName) {
        activeTab = tabName === 'modules' ? 'modules' : 'dictionary';
        document.querySelectorAll('.i18n-dictionary-tab').forEach(function (btn) {
            var isActive = btn.getAttribute('data-i18n-tab') === activeTab;
            btn.classList.toggle('is-active', isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        var dictPanel = document.getElementById('i18n-tab-panel-dictionary');
        var modulePanel = document.getElementById('i18n-tab-panel-modules');
        if (dictPanel) {
            dictPanel.hidden = activeTab !== 'dictionary';
        }
        if (modulePanel) {
            modulePanel.hidden = activeTab !== 'modules';
        }
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('tab', activeTab);
            window.history.replaceState({}, '', url.toString());
        } catch (ignore) {}
    }

    document.querySelectorAll('.i18n-dictionary-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
            switchTab(btn.getAttribute('data-i18n-tab') || 'dictionary');
        });
    });

    function updateModuleRow(rowData) {
        if (!rowData || !rowData.module) {
            return;
        }
        var row = document.querySelector('[data-module-row="' + String(rowData.module).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"]');
        if (!row) {
            return;
        }
        var totalEl = row.querySelector('[data-module-total]');
        var translatedEl = row.querySelector('[data-module-translated]');
        var untranslatedEl = row.querySelector('[data-module-untranslated]');
        var percentEl = row.querySelector('[data-module-percent]');
        var pendingEl = row.querySelector('[data-module-pending-export]');
        var progressBar = row.querySelector('.i18n-module-progress span');
        var translateBtn = row.querySelector('.i18n-module-translate-btn');
        var exportBtn = row.querySelector('.i18n-module-export-btn');

        if (totalEl) totalEl.textContent = String(rowData.total || 0);
        if (translatedEl) translatedEl.textContent = String(rowData.translated || 0);
        if (untranslatedEl) untranslatedEl.textContent = String(rowData.untranslated || 0);
        var percent = Number(rowData.progress_percent || 0);
        if (percentEl) percentEl.textContent = String(percent).replace(/\.0$/, '') + '%';
        if (progressBar) progressBar.style.width = Math.max(0, Math.min(100, percent)) + '%';
        if (pendingEl) pendingEl.textContent = String(rowData.ai_pending_export || 0);
        if (translateBtn) translateBtn.disabled = Number(rowData.untranslated || 0) <= 0;
        if (exportBtn) exportBtn.disabled = !moduleExportDev || Number(rowData.ai_pending_export || 0) <= 0;
    }

    document.querySelectorAll('.i18n-module-translate-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var moduleName = btn.getAttribute('data-module') || '';
            if (!moduleName) {
                return;
            }
            var message = dictionaryMessages.moduleTranslateMessage.replace('%{1}', moduleName);
            confirmAction(message, 'info', {
                title: dictionaryMessages.moduleTranslateTitle,
                tone: 'info',
            }).then(function (confirmed) {
                if (!confirmed) {
                    return;
                }
                btn.disabled = true;
                postJson(endpoints.moduleTranslate, {
                    locale_code: localeCode,
                    module: moduleName,
                }).then(function (result) {
                    if (result.success) {
                        var detail = result.translated !== undefined
                            ? ('<?= addslashes(__('本批成功')) ?>: ' + result.translated + '，<?= addslashes(__('剩余')) ?>: ' + (result.remaining || 0))
                            : (result.message || '');
                        toastAction('success', detail || '<?= addslashes(__('模块 AI 翻译完成')) ?>');
                        if (result.module_row) {
                            updateModuleRow(result.module_row);
                        }
                        return;
                    }
                    toastAction('error', result.message || '<?= addslashes(__('模块 AI 翻译失败')) ?>');
                    btn.disabled = false;
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                    btn.disabled = false;
                });
            });
        });
    });

    document.querySelectorAll('.i18n-module-export-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var moduleName = btn.getAttribute('data-module') || '';
            if (!moduleName) {
                return;
            }
            confirmAction(dictionaryMessages.moduleExportMessage, 'info', {
                title: dictionaryMessages.moduleExportTitle,
                tone: 'info',
            }).then(function (confirmed) {
                if (!confirmed) {
                    return;
                }
                btn.disabled = true;
                postJson(endpoints.moduleExportCsv, {
                    locale_code: localeCode,
                    module: moduleName,
                }).then(function (result) {
                    if (result.success) {
                        toastAction('success', result.message || ('<?= addslashes(__('已写回')) ?> ' + (result.exported || 0) + ' <?= addslashes(__('条')) ?>'));
                        if (result.module_row) {
                            updateModuleRow(result.module_row);
                        }
                        return;
                    }
                    toastAction('error', result.message || '<?= addslashes(__('写回失败')) ?>');
                    btn.disabled = false;
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                    btn.disabled = false;
                });
            });
        });
    });

    function bindClearButton(buttonId, endpoint, message, payload) {
        var button = document.getElementById(buttonId);
        if (!button) {
            return;
        }

        button.addEventListener('click', function () {
            confirmAction(message, 'danger').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                button.disabled = true;
                postJson(endpoint, payload || {}).then(function (result) {
                    if (result.success) {
                        toastAction('success', result.message || '<?= addslashes(__('清理完成')) ?>');
                        return;
                    }

                    toastAction('error', result.message || '<?= addslashes(__('清理失败')) ?>');
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                }).finally(function () {
                    button.disabled = false;
                });
            });
        });
    }

    bindClearButton(
        'dictionary-clear-locale-btn',
        endpoints.clearLocale,
        <?= json_encode((string)__('确定清理当前目标语言 %{1} 的所有译文吗？基础词条会保留。', [$localeCode]), $jsonForScriptFlags) ?>,
        {locale_code: localeCode}
    );

    bindClearButton(
        'dictionary-clear-all-btn',
        endpoints.clearAll,
        <?= json_encode((string)__('确定清理全部词典和所有语言译文吗？此操作不可撤销。'), $jsonForScriptFlags) ?>,
        {}
    );

    document.querySelectorAll('[data-mode-switch]').forEach(function (button) {
        button.addEventListener('click', function () {
            var mode = button.getAttribute('data-mode-switch');
            confirmAction('<?= addslashes(__('翻译模式')) ?>: ' + mode, 'info').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                postJson(endpoints.setTranslationMode, {mode: mode}).then(function (result) {
                    if (!result.success) {
                        toastAction('error', result.message || '<?= addslashes(__('保存失败')) ?>');
                        return;
                    }

                    toastAction('success', result.message || '<?= addslashes(__('保存成功')) ?>');
                    loadModeState();
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                });
            });
        });
    });

    var autoRegisterButton = document.getElementById('dictionary-auto-register-toggle');
    if (autoRegisterButton) {
        autoRegisterButton.addEventListener('click', function () {
            var enabled = autoRegisterButton.dataset.enabled === '1';
            var url = enabled ? endpoints.disableAutoRegister : endpoints.enableAutoRegister;

            confirmAction(enabled ? '<?= addslashes(__('停用')) ?>' : '<?= addslashes(__('自动词汇注册')) ?>', enabled ? 'warning' : 'success').then(function (confirmed) {
                if (!confirmed) {
                    return;
                }

                postJson(url, {}).then(function (result) {
                    if (!result.success) {
                        toastAction('error', result.message || '<?= addslashes(__('保存失败')) ?>');
                        return;
                    }

                    toastAction('success', result.message || '<?= addslashes(__('保存成功')) ?>');
                    return postJson(endpoints.checkAutoRegister, {locale_code: localeCode}).then(function (statusResult) {
                        updateModeState({
                            mode: document.getElementById('dictionary-mode-chip').textContent,
                            mode_name: document.getElementById('dictionary-mode-chip').textContent,
                            auto_register: !!statusResult.enabled
                        });
                    });
                }).catch(function (error) {
                    toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
                });
            });
        });
    }

    document.querySelectorAll('#dictionary-import-modal form').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();

            var fileInput = form.querySelector('input[type="file"]');
            var file = fileInput && fileInput.files ? fileInput.files[0] : null;
            if (!file) {
                toastAction('error', '<?= addslashes(__('请选择要导入的CSV文件')) ?>');
                return;
            }

            file.text().then(function (content) {
                return postJson('dictionary-import', {
                    file_name: file.name,
                    csv_content: content
                });
            }).then(function (result) {
                if (!result.success) {
                    toastAction('error', result.message || '<?= addslashes(__('导入失败!')) ?>');
                    return;
                }

                toastAction('success', result.message || '<?= addslashes(__('导入完成!')) ?>');
                if (result.progress) {
                    updateProgress(result.progress);
                }
            }).catch(function (error) {
                toastAction('error', '<?= addslashes(__('请求错误！')) ?>' + ': ' + error.message);
            });
        });
    });

    loadModeState();
    updateProgress(<?= json_encode($progress, $jsonForScriptFlags) ?>);
    switchTab(activeTab);
})();
</script>
