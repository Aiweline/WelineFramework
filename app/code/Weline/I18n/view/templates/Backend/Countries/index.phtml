<script>
(function () {
    function showConfirm(message, type) {
        return Weline.UI.dialog.request({
            message: message,
            tone: type === 'danger' ? 'warning' : (type || 'info'),
            cancelable: true,
            confirmLabel: '<?= addslashes(__('确定')) ?>',
            cancelLabel: '<?= addslashes(__('取消')) ?>'
        }).then(function (result) {
            return !!result.confirmed;
        });
    }

    function showWarning(message) {
        if (typeof Weline.UI.toast !== 'undefined' && Weline.UI.toast.warning) {
            Weline.UI.toast.warning(message);
            return;
        }
        console.warn(message);
    }

    function collectSelectedCountryCodes() {
        return Array.from(document.querySelectorAll('.country-checkbox:checked'))
            .map(function (checkbox) {
                return checkbox.value;
            })
            .filter(Boolean);
    }

    function fillBatchForm(form, codes) {
        form.querySelectorAll('input[name="codes[]"]').forEach(function (input) {
            input.remove();
        });

        codes.forEach(function (code) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'codes[]';
            input.value = code;
            form.appendChild(input);
        });
    }

    window.submitCountryBatch = function (formId, message, type) {
        var codes = collectSelectedCountryCodes();
        if (!codes.length) {
            showWarning('<?= addslashes(__('请选择要操作的国家')) ?>');
            return;
        }

        var form = document.getElementById(formId);
        if (!form) {
            return;
        }

        showConfirm(message, type).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            fillBatchForm(form, codes);
            if (window.I18nAdminUI && typeof window.I18nAdminUI.requestForm === 'function') {
                window.I18nAdminUI.requestForm(form, {confirmed: true}).catch(function (error) {
                    showWarning(error && error.message ? error.message : '<?= addslashes(__('操作失败，请重试')) ?>');
                });
                return;
            }
            showWarning('<?= addslashes(__('异步组件不可用，请刷新页面后重试')) ?>');
        });
    };

    document.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-country-batch-form]');
        if (!trigger) {
            return;
        }

        event.preventDefault();
        window.submitCountryBatch(
            trigger.getAttribute('data-country-batch-form') || '',
            trigger.getAttribute('data-country-batch-message') || '',
            trigger.getAttribute('data-country-batch-type') || 'info'
        );
    });

    var selectAll = document.getElementById('country-select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.country-checkbox').forEach(function (checkbox) {
                checkbox.checked = selectAll.checked;
            });
        });
    }

})();
</script>
