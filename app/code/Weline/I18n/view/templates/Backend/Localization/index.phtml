<script>
(function () {
    function showConfirm(message, type) {
        return Weline.UI.dialog.request({
            message: message,
            tone: type === 'danger' ? 'warning' : (type || 'info'),
            cancelable: true,
            confirmLabel: '<?= addslashes(__('确定')) ?>',
            cancelLabel: '<?= addslashes(__('取消')) ?>'
        }).then(function (result) {
            return !!result.confirmed;
        });
    }

    function showWarning(message) {
        if (typeof Weline.UI.toast !== 'undefined' && Weline.UI.toast.warning) {
            Weline.UI.toast.warning(message);
            return;
        }
        console.warn(message);
    }

    function fillBatchForm(form, action, codes) {
        form.querySelectorAll('input[name="locale_codes[]"]').forEach(function (input) {
            input.remove();
        });

        var actionInput = form.querySelector('input[name="action"]');
        if (!actionInput) {
            actionInput = document.createElement('input');
            actionInput.type = 'hidden';
            actionInput.name = 'action';
            form.appendChild(actionInput);
        }
        actionInput.value = action;

        codes.forEach(function (code) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'locale_codes[]';
            input.value = code;
            form.appendChild(input);
        });
    }

    function collectSelectedLocales() {
        return Array.from(document.querySelectorAll('.locale-checkbox:checked'))
            .map(function (checkbox) {
                return checkbox.value;
            })
            .filter(Boolean);
    }

    window.submitUtilityForm = function (formId, message, type) {
        var form = document.getElementById(formId);
        if (!form) {
            return;
        }
        showConfirm(message, type).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            if (window.I18nAdminUI && typeof window.I18nAdminUI.requestForm === 'function') {
                window.I18nAdminUI.requestForm(form, {confirmed: true}).catch(function (error) {
                    showWarning(error && error.message ? error.message : '<?= addslashes(__('操作失败，请重试')) ?>');
                });
                return;
            }
            showWarning('<?= addslashes(__('异步组件不可用，请刷新页面后重试')) ?>');
        });
    };

    window.submitLocaleBatch = function (formId, action, message, type) {
        var codes = collectSelectedLocales();
        if (!codes.length) {
            showWarning('<?= addslashes(__('请选择操作和区域')) ?>');
            return;
        }

        var form = document.getElementById(formId);
        if (!form) {
            return;
        }

        showConfirm(message, type).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            fillBatchForm(form, action, codes);
            if (window.I18nAdminUI && typeof window.I18nAdminUI.requestForm === 'function') {
                window.I18nAdminUI.requestForm(form, {confirmed: true}).catch(function (error) {
                    showWarning(error && error.message ? error.message : '<?= addslashes(__('操作失败，请重试')) ?>');
                });
                return;
            }
            showWarning('<?= addslashes(__('异步组件不可用，请刷新页面后重试')) ?>');
        });
    };

    document.addEventListener('click', function (event) {
        var utilityTrigger = event.target.closest('[data-utility-form]');
        if (utilityTrigger) {
            event.preventDefault();
            window.submitUtilityForm(
                utilityTrigger.getAttribute('data-utility-form') || '',
                utilityTrigger.getAttribute('data-utility-message') || '',
                utilityTrigger.getAttribute('data-utility-type') || 'info'
            );
            return;
        }

        var batchTrigger = event.target.closest('[data-locale-batch-form]');
        if (!batchTrigger) {
            return;
        }

        event.preventDefault();
        window.submitLocaleBatch(
            batchTrigger.getAttribute('data-locale-batch-form') || '',
            batchTrigger.getAttribute('data-locale-batch-action') || '',
            batchTrigger.getAttribute('data-locale-batch-message') || '',
            batchTrigger.getAttribute('data-locale-batch-type') || 'info'
        );
    });

    var selectAll = document.getElementById('locale-select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.locale-checkbox').forEach(function (checkbox) {
                checkbox.checked = selectAll.checked;
            });
        });
    }

})();
</script>
</div>
