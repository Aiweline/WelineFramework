<script type="application/json" id="i18n-language-request-initial"><?= json_encode($requestData, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?></script>
<script>
(function(){
    var root=document.getElementById('i18n-language-request-admin');if(!root){return;}
    var data=JSON.parse(document.getElementById('i18n-language-request-initial').textContent||'{}');
    var itemsBody=root.querySelector('[data-items]'),aggregatesBody=root.querySelector('[data-aggregates]'),summary=root.querySelector('[data-summary]'),feedback=root.querySelector('[data-feedback]');
    function esc(value){var node=document.createElement('span');node.textContent=String(value==null?'':value);return node.innerHTML;}
    function render(next){data=next||{};var stats=data.summary||{};summary.innerHTML=['pending','accepted','ready','rejected','assigned'].map(function(status){return '<div class="col"><div class="card h-100"><div class="card-body"><small class="text-muted">'+esc(status)+'</small><div class="h4 mb-0">'+esc(stats[status]||0)+'</div></div></div></div>';}).join('');
        aggregatesBody.innerHTML=(data.aggregates||[]).map(function(row){return '<tr><td>'+esc(row.website_id)+'</td><td><strong>'+esc(row.locale_code)+'</strong><br><small>'+esc(row.country_code)+'</small></td><td>'+esc(row.applicant_count)+'</td><td>'+esc(row.request_count)+'</td><td>'+esc(row.latest_requested_at)+'</td></tr>';}).join('')||'<tr><td colspan="5" class="text-center text-muted py-4"><?= addslashes((string)__('暂无申请')) ?></td></tr>';
        itemsBody.innerHTML=(data.items||[]).map(function(row){return '<tr><td><input type="checkbox" data-item-id value="'+esc(row.item_id)+'"></td><td>'+esc(row.public_id)+'</td><td>'+esc(row.website_id)+'</td><td><strong>'+esc(row.name)+'</strong><br><small>'+esc(row.email)+'</small></td><td><strong>'+esc(row.locale_code)+'</strong><br><small>'+esc(row.country_code)+'</small></td><td><span class="badge bg-secondary">'+esc(row.status)+'</span></td><td>'+esc(row.created_at)+'</td></tr>';}).join('')||'<tr><td colspan="7" class="text-center text-muted py-4"><?= addslashes((string)__('暂无申请')) ?></td></tr>';
    }
    function api(){return Promise.resolve(window.Weline.Api.resource('i18n_language_requests_admin'));}
    function load(){var payload={};new FormData(root.querySelector('[data-filters]')).forEach(function(value,key){if(String(value).trim()!==''){payload[key]=value;}});return api().then(function(client){return client.list(payload);}).then(render);}
    root.querySelector('[data-filters]').addEventListener('submit',function(event){event.preventDefault();load().catch(function(error){feedback.textContent=error.message||String(error);});});
    root.querySelector('[data-check-all]').addEventListener('change',function(event){root.querySelectorAll('[data-item-id]').forEach(function(input){input.checked=event.target.checked;});});
    root.querySelectorAll('[data-review]').forEach(function(button){button.addEventListener('click',function(){var ids=Array.prototype.slice.call(root.querySelectorAll('[data-item-id]:checked')).map(function(input){return Number(input.value);});if(!ids.length){feedback.textContent='<?= addslashes((string)__('请选择语言申请')) ?>';return;}button.disabled=true;api().then(function(client){return client.review({item_ids:ids,status:button.dataset.review,note:''});}).then(function(result){feedback.textContent=result.message||'';return load();}).catch(function(error){feedback.textContent=error.message||String(error);}).finally(function(){button.disabled=false;});});});
    root.querySelector('[data-action=recalculate]').addEventListener('click',function(event){var button=event.currentTarget;button.disabled=true;api().then(function(client){return client.recalculateReady({});}).then(function(result){feedback.textContent=result.message||'';return load();}).catch(function(error){feedback.textContent=error.message||String(error);}).finally(function(){button.disabled=false;});});
    render(data);
})();
</script>
