/**
 * @meta.title {default="计划任务 CPU 预算",description="计划任务调度子进程的默认 CPU 额度：核数、单核占用上限与是否强制节流"}
 * @meta.description {default="额度上限 = CPU 个数 × 单核百分比 / 100 个核当量，超出部分通过睡眠出让。任务行自身声明非 0 时优先于本页默认值。"}
 * @config.area {backend}
