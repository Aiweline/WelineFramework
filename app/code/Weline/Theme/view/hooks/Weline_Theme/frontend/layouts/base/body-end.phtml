<?php
/**
 * Global storefront image placeholder + float-layer JS loader.
 * Float layer DOM + left/right w:slots live in partials/footer/default.phtml
 * so Theme Editor can select storefront-float-start/end.
 *
 * @hook-priority 40
 * @hook-sort-order 40
 */
$isBackend = str_contains(strtolower((string)($_SERVER['REQUEST_URI'] ?? '')), '/admin');
if ($isBackend) {
    return;
}

$placeholderSrc = \Weline\Theme\Helper\StorefrontImagePlaceholder::url();
$placeholderSrcJson = json_encode($placeholderSrc, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
?>
<script>
window.Weline = window.Weline || {};
window.Weline.Theme = window.Weline.Theme || {};
window.Weline.Theme.storefrontPlaceholderSrc = <?= $placeholderSrcJson ?: '""' ?>;
</script>
<?php // mini-cart-drawer：由 mini-cart-icon 组件自带；shopper-toast CSS：风格层 storefront-shopper-toast-amazon.css（head 加载） ?>
<div hidden
     data-weline-load="storefrontImageFallback,storefrontFloatLayer"
     aria-hidden="true"></div>
<?php // Theme 全局店面 JS：经 modules + data-weline-load，禁止 @static 直引 ?>
