<?php
/**
 * Theme default header account menu shell.
 *
 * Hook: header-account
 * Nested links: header-account-links（Customer / Shipping 等模块贡献）
 *
 * @hook-priority 100
 * @hook-sort-order 0
 */

use Weline\Framework\Session\SessionFactory;

/** @var \Weline\Framework\View\Template $this */

$session = SessionFactory::getInstance()->createFrontendSession();
$isLoggedIn = $session->isLoggedIn();
$userName = $isLoggedIn ? trim((string)($session->getUsername() ?? '')) : '';

$accountUrl = (string)$this->getFrontendUrl('customer/account/index');
$loginUrl = (string)$this->getFrontendUrl('customer/account/login');
$panelId = 'w-header-account-menu-' . substr(md5(uniqid((string)mt_rand(), true)), 0, 8);

$triggerLine1 = $isLoggedIn
    ? ($userName !== '' ? (string)__('您好, %{1}', [$userName]) : (string)__('您好'))
    : (string)__('您好, 登录');
$triggerLine2 = $isLoggedIn
    ? (string)__('个人中心')
    : (string)__('账户及心愿单');
?>
<div class="w-header-account w-menu-root"
     data-w-component="menu"
     data-w-placement="bottom-end"
     data-w-anchor-mode="element"
     data-state="closed">
    <button type="button"
            class="w-button w-header-account__trigger"
            data-tone="quiet"
            data-size="sm"
            data-w-menu-trigger
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="<?= htmlspecialchars($panelId, ENT_QUOTES, 'UTF-8') ?>">
        <w:icon name="user" size="sm"></w:icon>
        <span class="w-header-account__copy">
            <span class="w-header-account__line1"><?= htmlspecialchars($triggerLine1, ENT_QUOTES, 'UTF-8') ?></span>
            <span class="w-header-account__line2"><?= htmlspecialchars($triggerLine2, ENT_QUOTES, 'UTF-8') ?></span>
        </span>
        <w:icon name="chevron-down" size="sm"></w:icon>
    </button>
    <div id="<?= htmlspecialchars($panelId, ENT_QUOTES, 'UTF-8') ?>"
         class="w-menu w-header-account__menu"
         data-w-menu-panel
         data-state="closed"
         role="menu"
         hidden
         aria-hidden="true">
        <div class="w-menu__header w-header-account__header">
            <?php if ($isLoggedIn): ?>
                <a class="w-header-account__home" href="<?= htmlspecialchars($accountUrl, ENT_QUOTES, 'UTF-8') ?>">
                    <?= htmlspecialchars((string)__('个人中心'), ENT_QUOTES, 'UTF-8') ?>
                </a>
            <?php else: ?>
                <a class="w-header-account__home" href="<?= htmlspecialchars($loginUrl, ENT_QUOTES, 'UTF-8') ?>">
                    <?= htmlspecialchars((string)__('登录 / 注册'), ENT_QUOTES, 'UTF-8') ?>
                </a>
            <?php endif; ?>
        </div>
        <ul class="w-header-account__links" role="none">
            <w:hook>header-account-links</w:hook>
        </ul>
    </div>
</div>
