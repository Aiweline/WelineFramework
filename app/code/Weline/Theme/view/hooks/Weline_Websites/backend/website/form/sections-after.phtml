<?php
/**
 * @hook-priority 100
 * @hook-sort-order 15
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\WebsiteThemeBindingService;

$website = (array)($this->getData('website') ?? []);
$hasWebsiteIdentity = array_key_exists('website_id', $website) || array_key_exists('id', $website);
$websiteId = $hasWebsiteIdentity ? (int)($website['website_id'] ?? $website['id']) : -1;
$hookId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'website'));
if (!is_string($hookId) || $hookId === '' || preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'website_' . (is_string($hookId) ? $hookId : '');
}
$sectionId = $hookId . '_theme_binding';
$themeFieldId = $sectionId . '_theme_id';
$versionFieldId = $sectionId . '_version_id';

$summary = [
    'ok' => false,
    'theme_id' => 0,
    'theme_name' => '',
    'binding_source' => 'none',
    'inherited' => false,
    'version_id' => 0,
    'version_number' => 0,
    'version_name' => '',
    'storage_scope' => '',
    'themes' => [],
    'versions' => [],
];

try {
    /** @var WebsiteThemeBindingService $bindings */
    $bindings = ObjectManager::getInstance(WebsiteThemeBindingService::class);
    if ($hasWebsiteIdentity && $websiteId >= 0) {
        $summary = $bindings->summarize($website);
    } else {
        $summary['themes'] = $bindings->listFrontendThemes();
    }
} catch (\Throwable) {
}

echo $this->fetch('Weline_Theme::templates/backend/partials/scope-theme-binding-section.phtml', [
    'sectionId' => $sectionId,
    'themeFieldId' => $themeFieldId,
    'versionFieldId' => $versionFieldId,
    'hasIdentity' => $hasWebsiteIdentity && $websiteId >= 0,
    'pendingHint' => (string)__('请先保存网站后，再为本站选择店面主题。'),
    'introHint' => (string)__('本站店面主题写入网站应用引用；未配置时回落 Theme 注册的 Default 默认主题。'),
    'inheritedHint' => (string)__('当前显示为继承上级或 Theme 默认；保存时选择主题将写入本站专属应用引用。'),
    'ownHint' => (string)__('本站已配置专属主题应用引用。'),
    'emptyVersionHint' => (string)__('本站范围尚无已发布主题版本；可在主题编辑器发布后再选。'),
    'ownBindingSource' => 'website',
    'summary' => $summary,
]);
