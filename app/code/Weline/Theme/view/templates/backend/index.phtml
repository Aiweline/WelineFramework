$theme_website_bindings = is_array($theme_website_bindings ?? null) ? $theme_website_bindings : [];
$theme_edit_websites = is_array($theme_edit_websites ?? null) ? $theme_edit_websites : [];
$defaultEditWebsite = [
    'website_id' => (int)\Weline\Websites\Model\Website::ID_DEFAULT,
    'website_code' => (string)\Weline\Websites\Model\Website::CODE_DEFAULT,
];
$jsonFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT;
$backend_application_theme_id = (int)($backend_application_theme_id ?? 0);
$registered_default_backend_theme_id = (int)($registered_default_backend_theme_id ?? 0);
$openAiThemeId = (int)($open_ai_theme_id ?? 0);
$frontendThemeCount = 0;
$backendThemeCount = 0;
foreach ($themes as $themeItem) {
    if (!empty($themeItem['has_frontend'])) {
        $frontendThemeCount++;
    }
    if (!empty($themeItem['has_backend'])) {
        $backendThemeCount++;
    }
}
$pageHint = $h(__('店面主题在「网站 / 店铺 / 渠道信息 → 店面主题」配置；未配置时回落 Theme 注册的 Default。后台皮肤由系统配置决定。'));
$tabFrontendLabel = $h(__('前台主题'));
$tabBackendLabel = $h(__('后台主题'));
$countText = $h(__('前端 %{1} 个，后端 %{2} 个', [$frontendThemeCount, $backendThemeCount]));
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-theme-manage.css)">

<div class="w-stack weline-theme-manage" data-theme-manage data-testid="theme-manage">
    <?php if (empty($themes)): ?>
        <section class="w-card">
            <div class="w-card__body">
                <div class="weline-theme-manage__empty">
                    <w:icon name="palette" size="lg"></w:icon>
                    <h2><?= $h(__('暂无主题')) ?></h2>
                    <p class="w-text" data-tone="muted"><?= $h(__('系统中还没有安装任何主题')) ?></p>
                    <p class="w-text" data-tone="muted" data-size="sm">
                        <?= $h(__('请使用命令行安装主题：')) ?>
                        <code>php bin/w theme:install</code>
                    </p>
                </div>
            </div>
        </section>
    <?php else: ?>
        <p class="w-text weline-theme-manage__hint" data-tone="muted" data-size="sm"><?= $pageHint ?></p>
        <section class="w-card" data-w-component="tabs">
            <header class="w-card__header weline-theme-manage__tabbar">
                <nav class="w-tabs__list weline-theme-manage__tabs" role="tablist" aria-label="<?= $h(__('主题区域')) ?>">
                    <button
                        class="w-tabs__tab"
                        id="weline-theme-tab-frontend-trigger"
                        type="button"
                        role="tab"
                        aria-controls="weline-theme-tab-frontend"
                        aria-selected="true"
                    >
                        <w:icon name="store" size="sm"></w:icon>
                        <span><?= $tabFrontendLabel ?></span>
                    </button>
                    <button
                        class="w-tabs__tab"
                        id="weline-theme-tab-backend-trigger"
                        type="button"
                        role="tab"
                        aria-controls="weline-theme-tab-backend"
                        aria-selected="false"
                    >
                        <w:icon name="settings" size="sm"></w:icon>
                        <span><?= $tabBackendLabel ?></span>
                    </button>
                </nav>
                <div class="weline-theme-manage__toolbar w-cluster">
                    <button type="button" class="w-button" id="openAiVirtualThemeModal" data-theme-id="<?= $openAiThemeId ?>" data-tone="primary" data-size="sm">
                        <w:icon name="sparkles" size="sm"></w:icon> <?= $h(__('AI创建虚拟主题')) ?>
                    </button>
                    <button type="button" class="w-button" id="batchGeneratePreviews" data-tone="neutral" data-variant="outline" data-size="sm">
                        <w:icon name="image" size="sm"></w:icon> <?= $h(__('批量生成预览图')) ?>
                    </button>
                </div>
            </header>

            <div class="w-card__body">
                <p class="w-text weline-theme-manage__count" data-tone="muted" data-size="sm"><?= $countText ?></p>

                <?php
                $renderThemeCards = function (string $area) use (
                    $themes,
                    $h,
                    $theme_website_usage,
                    $theme_website_bindings,
                    $theme_edit_websites,
                    $defaultEditWebsite,
                    $backend_application_theme_id,
                    $registered_default_backend_theme_id,
                    $jsonFlags
                ) {
                    $supportField = $area === 'backend' ? 'has_backend' : 'has_frontend';
                    $filteredThemes = array_values(array_filter($themes, static function ($theme) use ($supportField) {
                        return !empty($theme[$supportField]);
                    }));

                    if (empty($filteredThemes)): ?>
                        <div class="w-alert" data-tone="info" style="--w-mb:0;">
                            <w:icon name="info" size="sm"></w:icon>
                            <?= $h(__('当前没有可用于该区域的主题')) ?>
                        </div>
                    <?php
                        return;
                    endif;

                    foreach ($filteredThemes as $theme):
                        $themeId = (int)($theme['id'] ?? 0);
                        $themeName = (string)($theme['name'] ?? '');
                        $moduleName = (string)($theme['module_name'] ?? '');
                        $parentThemeName = (string)($theme['parent_theme_name'] ?? '');
                        $websiteCodes = $area === 'frontend'
                            ? array_values(array_filter($theme_website_usage[$themeId] ?? [], static fn($c) => is_string($c) && $c !== ''))
                            : [];
                        $bindings = $area === 'frontend'
                            ? array_values(array_filter(
                                $theme_website_bindings[$themeId] ?? [],
                                static fn($row) => is_array($row)
                                    && isset($row['website_id'], $row['website_code'])
                                    && (string)$row['website_code'] !== ''
                            ))
                            : [];
                        $editWebsite = $theme_edit_websites[$themeId] ?? $defaultEditWebsite;
                        $editWebsiteId = max(0, (int)($editWebsite['website_id'] ?? $defaultEditWebsite['website_id']));
                        $editWebsiteCode = (string)($editWebsite['website_code'] ?? $defaultEditWebsite['website_code']);
                        if ($editWebsiteCode === '') {
                            $editWebsiteCode = $defaultEditWebsite['website_code'];
                        }
                        $editParams = [
                            'theme_id' => $themeId,
                            'editor_area' => $area,
                            'preview_area' => $area,
                            'scope_kind' => \Weline\Framework\Runtime\ScopeIdentity::KIND_WEBSITE,
                            'website_id' => $editWebsiteId,
                            'website_code' => $editWebsiteCode,
                        ];
                        $previewParams = [
                            'theme_id' => $themeId,
                            'area' => $area,
                            // Prefer latest draft/published ThemeLayoutVersion when present;
                            // no version → live storefront of the bound website (not admin mount).
                            'preview_mode' => 'version',
                            'status' => 'draft',
                            'scope_kind' => \Weline\Framework\Runtime\ScopeIdentity::KIND_WEBSITE,
                            'website_id' => $editWebsiteId,
                            'website_code' => $editWebsiteCode,
                        ];
                        $bindingsJson = json_encode($bindings, $jsonFlags) ?: '[]';
                        $websiteSelectOptions = [];
                        foreach ($bindings as $bindingRow) {
                            $bindingId = max(0, (int)($bindingRow['website_id'] ?? 0));
                            $bindingCode = (string)($bindingRow['website_code'] ?? '');
                            if ($bindingCode === '') {
                                continue;
                            }
                            $websiteSelectOptions[] = [
                                'value' => (string)$bindingId,
                                'website_id' => $bindingId,
                                'id' => $bindingId,
                                'code' => $bindingCode,
                                'label' => $bindingCode,
                                'name' => $bindingCode,
                            ];
                        }
                        $websiteSelectOptionsJson = json_encode($websiteSelectOptions, $jsonFlags) ?: '[]';
                        $canSwitchWebsite = $area === 'frontend' && count($bindings) >= 2;
                        $isBackendCurrent = $area === 'backend'
                            && $backend_application_theme_id > 0
                            && $themeId === $backend_application_theme_id;
                        $isBackendSystemDefault = $area === 'backend'
                            && $backend_application_theme_id < 1
                            && $registered_default_backend_theme_id > 0
                            && $themeId === $registered_default_backend_theme_id;
                        $highlightCurrent = $isBackendCurrent || $isBackendSystemDefault;
                        $websitePreviewMap = [];
                        if ($area === 'frontend') {
                            foreach ($bindings as $bindingRow) {
                                $boundId = max(0, (int)($bindingRow['website_id'] ?? 0));
                                $websitePreviewMap[(string)$boundId] = \Weline\Theme\Service\ThemePreviewGenerator::getPreviewImagePublicUrl(
                                    $themeId,
                                    'frontend',
                                    $boundId,
                                );
                            }
                            if ($websitePreviewMap === [] && $editWebsiteId >= 0) {
                                $websitePreviewMap[(string)$editWebsiteId] = \Weline\Theme\Service\ThemePreviewGenerator::getPreviewImagePublicUrl(
                                    $themeId,
                                    'frontend',
                                    $editWebsiteId,
                                );
                            }
                        }
                        $previewImageSrc = $area === 'frontend'
                            ? (string)($websitePreviewMap[(string)$editWebsiteId] ?? '')
                            : '';
                        // Frontend cards with website scope use per-site PNGs only —
                        // never the legacy shared DB path (wrong Host thumbnail).
                        if ($previewImageSrc === '' && $area === 'backend') {
                            $previewImage = $theme['backend_preview_image'] ?? '';
                            $previewImageSrc = $previewImage ? '/' . ltrim((string)$previewImage, '/') : '';
                            if ($previewImageSrc !== '') {
                                $previewAbs = PUB . ltrim(str_replace('\\', '/', (string)$previewImage), '/');
                                if (is_file($previewAbs)) {
                                    $previewImageSrc .= '?v=' . (string)filemtime($previewAbs);
                                }
                            }
                        } elseif ($previewImageSrc === '' && $area === 'frontend' && $bindings === []) {
                            $previewImage = $theme['frontend_preview_image'] ?? $theme['preview_image'] ?? '';
                            $previewImageSrc = $previewImage ? '/' . ltrim((string)$previewImage, '/') : '';
                            if ($previewImageSrc !== '') {
                                $previewAbs = PUB . ltrim(str_replace('\\', '/', (string)$previewImage), '/');
                                if (is_file($previewAbs)) {
                                    $previewImageSrc .= '?v=' . (string)filemtime($previewAbs);
                                }
                            }
                        }
                        $websitePreviewsJson = json_encode($websitePreviewMap, $jsonFlags) ?: '{}';
                        $hasPreview = $previewImageSrc !== '';
                        $cardClass = 'theme-card w-card' . ($highlightCurrent ? ' is-active' : '');
                        $previewImageClass = 'theme-preview-image';
                        $placeholderClass = 'theme-preview-placeholder';
                        $previewActionClass = 'w-button preview-action-btn' . ($hasPreview ? ' preview-action-btn--refresh' : ' preview-action-btn--generate');
                        $previewActionTone = $hasPreview ? 'neutral' : 'primary';
                        $previewActionVariant = $hasPreview ? 'outline' : '';
                        $previewActionTitle = $h($hasPreview ? __('刷新预览图') : __('生成预览图'));
                        $themeNameAttr = $h($themeName);
                        $moduleNameEsc = $h($moduleName);
                        $parentThemeEsc = $h($parentThemeName);
                ?>
                    <div class="theme-grid-item">
                        <article
                            class="<?= $h($cardClass) ?>"
                            data-theme-id="<?= $themeId ?>"
                            data-theme-name="<?= $themeNameAttr ?>"
                            data-area="<?= $h($area) ?>"
                            data-has-preview="<?= $hasPreview ? '1' : '0' ?>"
                            data-needs-preview="<?= $hasPreview ? '0' : '1' ?>"
                            data-edit-href="@backend-url{'theme/backend/theme-editor'|$editParams}"
                            data-edit-website-id="<?= $editWebsiteId ?>"
                            data-edit-website-code="<?= $h($editWebsiteCode) ?>"
                            data-website-bindings="<?= $h($bindingsJson) ?>"
                            data-website-previews="<?= $h($websitePreviewsJson) ?>"
                            data-testid="theme-card"
                            tabindex="0"
                            role="link"
                            aria-label="<?= $h(__('编辑主题')) ?>: <?= $themeNameAttr ?>"
                        >
                            <div class="theme-preview">
                                <img
                                    src="<?= $hasPreview ? $h($previewImageSrc) : '' ?>"
                                    alt="<?= $h(__('主题预览')) ?>"
                                    class="<?= $h($previewImageClass) ?>"
                                    data-fallback-target=".theme-preview-placeholder"
                                    <?= $hasPreview ? '' : 'hidden' ?>
                                >
                                <div class="<?= $h($placeholderClass) ?>" <?= $hasPreview ? 'hidden' : '' ?>>
                                    <w:icon name="image" size="sm"></w:icon>
                                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('暂无预览图')) ?></span>
                                </div>
                                <span class="theme-preview-status-badge" hidden></span>
                                <?php if ($highlightCurrent): ?>
                                    <span class="w-badge theme-active-badge" data-tone="success"><w:icon name="check" size="sm"></w:icon> <?= $h(__('当前后台')) ?></span>
                                <?php endif; ?>
                                <?php if ($canSwitchWebsite): ?>
                                    <button
                                        type="button"
                                        class="w-button theme-preview-nav theme-preview-nav--prev"
                                        data-theme-preview-nav="prev"
                                        data-tone="neutral"
                                        data-variant="outline"
                                        data-size="sm"
                                        data-icon-only="true"
                                        title="<?= $h(__('上一个绑定网站')) ?>"
                                        aria-label="<?= $h(__('上一个绑定网站')) ?>"
                                    >
                                        <w:icon name="chevron-left" size="sm"></w:icon>
                                    </button>
                                    <button
                                        type="button"
                                        class="w-button theme-preview-nav theme-preview-nav--next"
                                        data-theme-preview-nav="next"
                                        data-tone="neutral"
                                        data-variant="outline"
                                        data-size="sm"
                                        data-icon-only="true"
                                        title="<?= $h(__('下一个绑定网站')) ?>"
                                        aria-label="<?= $h(__('下一个绑定网站')) ?>"
                                    >
                                        <w:icon name="chevron-right" size="sm"></w:icon>
                                    </button>
                                <?php endif; ?>
                                <button
                                    type="button"
                                    class="<?= $h($previewActionClass) ?>"
                                    data-theme-id="<?= $themeId ?>"
                                    data-theme-name="<?= $themeNameAttr ?>"
                                    data-area="<?= $h($area) ?>"
                                    data-force="<?= $hasPreview ? '1' : '0' ?>"
                                    data-tone="<?= $h($previewActionTone) ?>"
                                    <?= $previewActionVariant !== '' ? 'data-variant="' . $h($previewActionVariant) . '"' : '' ?>
                                    data-size="sm"
                                    data-icon-only="true"
                                    title="<?= $previewActionTitle ?>"
                                    aria-label="<?= $previewActionTitle ?>"
                                >
                                    <span data-preview-icon="generate" <?= $hasPreview ? 'hidden' : '' ?>><w:icon name="camera" size="sm"></w:icon></span>
                                    <span data-preview-icon="refresh" <?= $hasPreview ? '' : 'hidden' ?>><w:icon name="refresh" size="sm"></w:icon></span>
                                </button>
                            </div>
                            <div class="theme-info">
                                <h3 class="theme-name"><?= $themeNameAttr ?></h3>
                                <div class="theme-meta"><w:icon name="folder" size="sm"></w:icon> <?= $moduleNameEsc ?></div>
                                <?php if ($parentThemeName !== ''): ?>
                                    <div class="theme-meta"><w:icon name="arrow-up" size="sm"></w:icon> <?= $h(__('继承自')) ?>: <?= $parentThemeEsc ?></div>
                                <?php endif; ?>
                                <?php if ($area === 'frontend'): ?>
                                    <?php if ($canSwitchWebsite): ?>
                                        <div class="theme-meta theme-meta--website-switch" data-testid="theme-website-usage">
                                            <w:icon name="globe" size="sm"></w:icon>
                                            <span class="theme-meta__label"><?= $h(__('网站')) ?></span>
                                            <div class="theme-card-website-select-wrap" data-theme-card-website-select>
                                                <w:websites:website:select
                                                    id="theme_card_website_<?= $themeId ?>"
                                                    name="theme_card_website_<?= $themeId ?>"
                                                    value="<?= $editWebsiteId ?>"
                                                    options="websiteSelectOptionsJson"
                                                    multiple="false"
                                                    clearable="false"
                                                    empty-label="@lang(选择网站)"
                                                    placeholder="@lang(搜索绑定网站)"
                                                    class="theme-card-website-select"
                                                />
                                            </div>
                                        </div>
                                    <?php elseif ($websiteCodes !== []): ?>
                                        <div class="theme-meta" data-testid="theme-website-usage">
                                            <w:icon name="globe" size="sm"></w:icon>
                                            <?= $h(__('网站：%{1}', [$editWebsiteCode !== '' ? $editWebsiteCode : implode(', ', $websiteCodes)])) ?>
                                        </div>
                                    <?php else: ?>
                                        <div class="theme-meta" data-tone="muted" data-testid="theme-website-usage-empty">
                                            <w:icon name="globe" size="sm"></w:icon>
                                            <?= $h(__('未绑定网站（回落 Default）')) ?>
                                        </div>
                                    <?php endif; ?>
                                <?php elseif ($highlightCurrent): ?>
                                    <div class="theme-meta" data-testid="theme-backend-current">
                                        <w:icon name="settings" size="sm"></w:icon>
                                        <?= $h($isBackendSystemDefault ? __('系统默认后台皮肤') : __('当前后台皮肤')) ?>
                                    </div>
                                <?php else: ?>
                                    <div class="theme-meta" data-tone="muted">
                                        <w:icon name="settings" size="sm"></w:icon>
                                        <?= $h(__('在系统配置中切换后台皮肤')) ?>
                                    </div>
                                <?php endif; ?>
                            </div>
                            <div class="theme-actions w-cluster">
                                <a href="@backend-url{'theme/backend/index/preview'|$previewParams}" class="w-button theme-preview-link" target="_blank" rel="noopener" title="<?= $h(__('预览主题')) ?>" data-tone="primary" data-variant="outline" data-size="sm" data-testid="theme-preview-link">
                                    <w:icon name="eye" size="sm"></w:icon> <?= $h(__('预览')) ?>
                                </a>
                                <a href="@backend-url{'theme/backend/theme-editor'|$editParams}" class="w-button theme-edit-link" title="<?= $h(__('可视化编辑')) ?>" data-tone="info" data-variant="outline" data-size="sm" data-testid="theme-edit-link" data-edit-website-id="<?= $editWebsiteId ?>" data-edit-website-code="<?= $h($editWebsiteCode) ?>">
                                    <w:icon name="palette" size="sm"></w:icon> <?= $h(__('编辑')) ?>
                                </a>
                            </div>
                        </article>
                    </div>
                <?php
                    endforeach;
                };
                ?>

                <div class="w-tabs__panel" id="weline-theme-tab-frontend" role="tabpanel" aria-labelledby="weline-theme-tab-frontend-trigger">
                    <div class="themes-grid" data-theme-list="frontend">
                        <p class="w-text themes-grid__hint" data-tone="muted" data-size="sm"><?= $h(__('各网站/店铺/渠道店面主题在对应范围信息中配置；此处仅展示安装主题与绑定关系。')) ?></p>
                        <?php $renderThemeCards('frontend'); ?>
                    </div>
                </div>
                <div class="w-tabs__panel" id="weline-theme-tab-backend" role="tabpanel" aria-labelledby="weline-theme-tab-backend-trigger" hidden>
                    <div class="themes-grid" data-theme-list="backend">
                        <p class="w-text themes-grid__hint" data-tone="muted" data-size="sm"><?= $h(__('后台皮肤由系统配置决定；此处仅展示安装主题与当前选用状态。')) ?></p>
                        <?php $renderThemeCards('backend'); ?>
                    </div>
                </div>
            </div>
        </section>
    <?php endif; ?>
</div>

