<script>
(function() {
    'use strict';

    const THEME_EDITOR_URL = '@backend-url{'theme/backend/theme-editor'}';
    const batchGenerateModalElement = document.getElementById('batchGenerateModal');
    const singleGenerateModalElement = document.getElementById('singleGenerateModal');
    const aiVirtualThemeModalElement = document.getElementById('aiVirtualThemeModal');

    function createModalAdapter(element) {
        if (!element) {
            return null;
        }

        return {
            show: function() { return Weline.UI.dialog.open(element); },
            hide: function() { return Weline.UI.dialog.close(element); }
        };
    }

    const batchGenerateModal = createModalAdapter(batchGenerateModalElement);
    const singleGenerateModal = createModalAdapter(singleGenerateModalElement);
    const aiVirtualThemeModal = createModalAdapter(aiVirtualThemeModalElement);
    let aiVirtualThemeCatalogPromise = null;
    let apiPromise = null;
    let runtimeApiPromise = null;
    const PREVIEW_TASK_STORAGE_PREFIX = 'weline.theme.preview.task.';
    const activePreviewPolls = new Map();
    const activeVirtualThemePolls = new Map();
    const activePreviewTargets = new Set();
    const RUNTIME_TERMINAL = {
        completed: true,
        failed: true,
        cancelled: true,
        expired: true,
        recovery_unsafe: true,
        event_backlog_limit: true,
        recovering: true,
    };
    let activeBatchTaskId = null;
    let activeSingleTaskId = null;

    function resolveFullApiModule(api) {
        if (window.WelineApiModule
            && window.WelineApiModule.__full === true
            && typeof window.WelineApiModule.resource === 'function') {
            return window.WelineApiModule;
        }
        return api;
    }

    function getApi() {
        if (!apiPromise) {
            apiPromise = (async function() {
                if (!window.Weline || typeof window.Weline.load !== 'function') {
                    throw new Error('<?= addslashes(__('加载失败')) ?>');
                }
                const Weline = window.Weline;
                const api = resolveFullApiModule(await Weline.load('api'));
                if (!api || typeof api.resource !== 'function') {
                    throw new Error('<?= addslashes(__('加载失败')) ?>');
                }
                if (window.Weline) {
                    window.Weline.Api = api;
                }
                return api;
            })();
        }
        return apiPromise;
    }

    function getRuntimeApi() {
        if (!runtimeApiPromise) {
            runtimeApiPromise = getApi().then(function(api) {
                return resolveFullApiModule(api);
            });
        }
        return runtimeApiPromise;
    }

    function createPreviewRequestId(prefix) {
        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
            const bytes = new Uint8Array(16);
            window.crypto.getRandomValues(bytes);
            return prefix + '-' + Array.from(bytes, function(byte) {
                return byte.toString(16).padStart(2, '0');
            }).join('');
        }
        return prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 14);
    }

    function normalizeRuntimeTaskHandle(value) {
        if (!value || typeof value !== 'object'
            || typeof value.task_id !== 'string' || !value.task_id
            || typeof value.lease_id !== 'string' || !value.lease_id) {
            throw new Error('<?= addslashes(__('后台任务启动响应无效。')) ?>');
        }
        return {
            task_id: value.task_id,
            lease_id: value.lease_id,
            stream_channel: typeof value.stream_channel === 'string' ? value.stream_channel : '',
        };
    }

    function previewTaskStorageKey(taskId) {
        return PREVIEW_TASK_STORAGE_PREFIX + taskId;
    }

    function persistPreviewTask(task, descriptor) {
        try {
            window.sessionStorage.setItem(previewTaskStorageKey(task.task_id), JSON.stringify({
                task_id: task.task_id,
                lease_id: task.lease_id,
                stream_channel: task.stream_channel,
                descriptor: descriptor,
            }));
        } catch (error) {
            // sessionStorage is optional and never controls task lifetime.
        }
    }

    function clearPreviewTask(taskId) {
        try {
            window.sessionStorage.removeItem(previewTaskStorageKey(taskId));
        } catch (error) {
            // Storage is optional and never controls task lifetime.
        }
    }

    function storedPreviewTasks() {
        const tasks = [];
        try {
            for (let index = 0; index < window.sessionStorage.length; index++) {
                const key = window.sessionStorage.key(index);
                if (!key || key.indexOf(PREVIEW_TASK_STORAGE_PREFIX) !== 0) {
                    continue;
                }
                const value = JSON.parse(window.sessionStorage.getItem(key) || '{}');
                if (!value || typeof value !== 'object' || !value.descriptor) {
                    continue;
                }
                tasks.push({
                    task: normalizeRuntimeTaskHandle(value),
                    descriptor: value.descriptor,
                });
            }
        } catch (error) {
            return [];
        }
        return tasks;
    }

    function taskFailureMessage(payload, fallback) {
        return String(
            payload?.terminal_reason
            || payload?.reason
            || payload?.message
            || payload?.error_code
            || fallback
        );
    }

    function runtimeResultData(snap) {
        const result = snap && snap.result;
        if (!result || typeof result !== 'object') {
            return {};
        }
        if (result.data && typeof result.data === 'object') {
            return result.data;
        }
        return result;
    }

    function checkpointState(snap) {
        const state = snap && snap.checkpoint && snap.checkpoint.state;
        return state && typeof state === 'object' ? state : {};
    }

    function setPreviewCancelButton(id, enabled) {
        const button = document.getElementById(id);
        if (button) {
            button.disabled = !enabled;
        }
    }

    function createPollHandle(api, task) {
        let stopped = false;
        return {
            task_id: task.task_id,
            close: function() { stopped = true; },
            stopped: function() { return stopped; },
            cancel: async function(reason) {
                stopped = true;
                await api.resource('runtime_task').cancel({
                    task_id: task.task_id,
                    intent_id: createPreviewRequestId('theme-cancel'),
                    reason: reason || '<?= addslashes(__('用户明确取消')) ?>',
                }, { silent: true });
            },
        };
    }

    function sleepMs(ms) {
        return new Promise(function(resolve) {
            window.setTimeout(resolve, ms);
        });
    }

    async function pollRuntimeTask(api, task, handle, onUpdate, intervalMs) {
        const taskApi = api.resource('runtime_task');
        const wait = Number(intervalMs) > 0 ? Number(intervalMs) : 1000;
        const startedAt = Date.now();
        let lastVersion = -1;
        while (!handle.stopped()) {
            if (Date.now() - startedAt > 70000) {
                activePreviewPolls.forEach(function(item) { item.close(); });
                throw new Error('<?= addslashes(__('预览图生成超时，已停止查询')) ?>');
            }
            try {
                await taskApi.touch({
                    task_id: task.task_id,
                    lease_id: task.lease_id,
                }, { silent: true });
            } catch (error) {
                // Lease renew is best-effort; status polling remains authoritative.
            }
            const snap = await taskApi.status({ task_id: task.task_id }, { silent: true });
            const version = Number(snap && snap.checkpoint && snap.checkpoint.version || 0);
            const status = String(snap && snap.status || '');
            if (version !== lastVersion || RUNTIME_TERMINAL[status]) {
                lastVersion = version;
                if (typeof onUpdate === 'function') {
                    onUpdate(snap || {});
                }
            }
            if (RUNTIME_TERMINAL[status]) {
                return snap || {};
            }
            await sleepMs(wait);
        }
        return null;
    }

    async function startThemePreviewTask(input) {
        const api = await getRuntimeApi();
        const taskApi = api.resource('runtime_task');
        // Do not force admin Host as capture_base_url — frontend shots resolve
        // bound-website origin server-side (avoids Hanfu paint for grocery etc.).
        const payload = Object.assign({}, input || {});
        if (payload.website_id == null && payload.capture_base_url == null) {
            payload.capture_base_url = null;
        }
        const task = normalizeRuntimeTaskHandle(await taskApi.start({
            type_code: 'theme.preview_batch',
            input: payload,
        }, { silent: true }));
        return { api: api, task: task };
    }

    async function runAiVirtualThemeTask(payload, onProgress) {
        const api = await getRuntimeApi();
        const task = normalizeRuntimeTaskHandle(await api.resource('runtime_task').start({
            type_code: 'theme.virtual_theme_generation',
            input: payload
        }, { silent: true }));
        const handle = createPollHandle(api, task);
        activeVirtualThemePolls.set(task.task_id, handle);
        try {
            const snap = await pollRuntimeTask(api, task, handle, function(update) {
                const state = checkpointState(update);
                if (typeof onProgress === 'function') {
                    onProgress({
                        current: Number(state.next_index || state.current || 0),
                        total: Number(state.total || 0),
                        message: state.message || '',
                    });
                }
            });
            if (!snap) {
                throw new Error('<?= addslashes(__('虚拟主题任务已断开')) ?>');
            }
            const status = String(snap.status || '');
            if (status === 'completed') {
                return runtimeResultData(snap);
            }
            throw new Error(taskFailureMessage(snap, '<?= addslashes(__('虚拟主题任务失败')) ?>'));
        } finally {
            activeVirtualThemePolls.delete(task.task_id);
            handle.close();
        }
    }

    async function cancelThemePreviewTask(taskId, reason) {
        const handle = activePreviewPolls.get(taskId);
        if (!handle) {
            return;
        }
        await handle.cancel(reason || '<?= addslashes(__('用户明确取消')) ?>');
    }

    window.addEventListener('pagehide', function() {
        activePreviewPolls.forEach(function(handle) {
            handle.close(); // detach only; task cancellation is always explicit
        });
        activeVirtualThemePolls.forEach(function(handle) {
            handle.close();
        });
    });

    function escapeHtml(text) {
        if (!text) {
            return '';
        }

        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showToast(type, message) {
        if (typeof Weline.UI.toast !== 'undefined' && typeof Weline.UI.toast[type] === 'function') {
            Weline.UI.toast[type](message);
            return;
        }

        const confirmType = type === 'success' ? 'success' : 'danger';
        Weline.UI.dialog.confirm(message, { tone: confirmType });
        return;

        console.log(message);
    }

    function isSuccessResponse(result) {
        return !!result && (
            result.status === 'success' ||
            result.success === true ||
            result.success === 1 ||
            result.success === '1' ||
            result.code === 200 ||
            result.code === '200'
        );
    }

    function normalizeAiCatalogItems(items) {
        if (items && typeof items === 'object' && !Array.isArray(items) && Array.isArray(items.items)) {
            items = items.items;
        }

        if (!Array.isArray(items)) {
            return [];
        }

        return items.map(function(item) {
            if (!item || typeof item !== 'object') {
                return null;
            }

            return {
                code: String(item.code || item.value || ''),
                name: String(item.name || item.label || item.code || item.value || ''),
                description: String(item.description || item.summary || item.name || item.label || ''),
                locked: !!item.locked,
                manual: !!item.manual,
                readonly: !!item.readonly
            };
        }).filter(function(item) {
            return item && item.code;
        });
    }

    function renderAiVirtualThemeSkills(items) {
        if (!items.length) {
            return '<span class="w-text" data-tone="muted" data-size="sm"><?= __('暂无可选技能') ?></span>';
        }

        return items.map(function(item) {
            const checked = item.locked || item.manual ? 'checked' : '';
            const disabled = item.readonly && !item.locked && !item.manual ? 'disabled' : '';
            return '<label class="ai-virtual-theme-choice">' +
                '<input type="checkbox" name="ai_virtual_theme_skill" value="' + escapeHtml(item.code) + '" ' + checked + ' ' + disabled + '>' +
                '<span><strong>' + escapeHtml(item.name || item.code) + '</strong><small>' + escapeHtml(item.description || item.code) + '</small></span>' +
                '</label>';
        }).join('');
    }

    function renderAiVirtualThemeStyles(items) {
        const auto = '<label class="ai-virtual-theme-choice">' +
            '<input type="radio" name="ai_virtual_theme_style" value="" checked>' +
            '<span><strong><?= __('自动匹配') ?></strong><small><?= __('由 Theme AI 根据当前指令选择方向') ?></small></span>' +
            '</label>';

        if (!items.length) {
            return auto;
        }

        return auto + items.map(function(item) {
            return '<label class="ai-virtual-theme-choice">' +
                '<input type="radio" name="ai_virtual_theme_style" value="' + escapeHtml(item.code) + '">' +
                '<span><strong>' + escapeHtml(item.name || item.code) + '</strong><small>' + escapeHtml(item.description || item.code) + '</small></span>' +
                '</label>';
        }).join('');
    }

    function readCheckedValues(root, selector) {
        if (!root) {
            return [];
        }

        return Array.from(root.querySelectorAll(selector))
            .filter(function(input) {
                return input.checked && !input.disabled;
            })
            .map(function(input) {
                return String(input.value || '').trim();
            })
            .filter(Boolean);
    }

    function setAiVirtualThemeStatus(type, message) {
        const status = document.getElementById('aiVirtualThemeStatus');
        if (!status) {
            return;
        }

        const tone = (type === 'danger' || type === 'success' || type === 'warning' || type === 'info')
            ? type
            : 'muted';
        status.className = 'w-alert';
        status.setAttribute('data-tone', tone);
        status.setAttribute('data-w-border', 'border');
        status.textContent = message;
    }

    function setAiVirtualThemeBusy(busy) {
        const button = document.getElementById('createAiVirtualTheme');
        if (!button) {
            return;
        }

        if (!button.dataset.idleLabel) {
            button.dataset.idleLabel = button.innerHTML;
        }
        button.disabled = !!busy;
        button.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (busy) {
            button.textContent = '<?= __('正在创建') ?>';
        } else {
            button.innerHTML = button.dataset.idleLabel;
        }
    }

    async function loadAiVirtualThemeCatalog() {
        if (!aiVirtualThemeCatalogPromise) {
            aiVirtualThemeCatalogPromise = getRuntimeApi().then(function(api) {
                return api.resource('theme').virtual_theme_catalog({}, { silent: true });
            }).then(function(result) {
                if (!isSuccessResponse(result)) {
                    throw new Error(result?.message || '<?= __('AI目录加载失败') ?>');
                }

                const data = result.data || result;
                return {
                    skills: normalizeAiCatalogItems(data.skills || []),
                    styles: normalizeAiCatalogItems(data.styles || data.directions || [])
                };
            });
        }

        return aiVirtualThemeCatalogPromise;
    }

    async function renderAiVirtualThemeCatalog() {
        const skillsEl = document.getElementById('aiVirtualThemeSkills');
        const stylesEl = document.getElementById('aiVirtualThemeStyles');
        if (!skillsEl || !stylesEl) {
            return;
        }

        skillsEl.innerHTML = '<span class="w-text" data-tone="muted" data-size="sm"><?= __('正在加载...') ?></span>';
        try {
            const catalog = await loadAiVirtualThemeCatalog();
            skillsEl.innerHTML = renderAiVirtualThemeSkills(catalog.skills);
            stylesEl.innerHTML = renderAiVirtualThemeStyles(catalog.styles);
        } catch (error) {
            skillsEl.innerHTML = '<span class="w-text" data-tone="danger" data-size="sm">' + escapeHtml(error.message || '<?= __('AI目录加载失败') ?>') + '</span>';
            stylesEl.innerHTML = renderAiVirtualThemeStyles([]);
        }
    }

    function buildThemeEditorUrl(themeId, layoutType, layoutOption) {
        const url = new URL(THEME_EDITOR_URL, window.location.origin);
        url.searchParams.set('theme_id', String(themeId));
        url.searchParams.set('page_type', layoutType || 'homepage');
        url.searchParams.set('layout_type', layoutType || 'homepage');
        url.searchParams.set('layout_option', layoutOption || 'default');
        return url.toString();
    }

    function openAiVirtualThemeDialog(themeId, themeName) {
        if (!aiVirtualThemeModalElement || !aiVirtualThemeModal) {
            return;
        }

        const select = document.getElementById('aiVirtualThemeBaseTheme');
        const title = document.getElementById('aiVirtualThemeTitle');
        const result = document.getElementById('aiVirtualThemeResult');
        const instructions = document.getElementById('aiVirtualThemeInstructions');

        if (select && themeId) {
            select.value = String(themeId);
        }
        if (title) {
            title.innerText = themeName
                ? '<?= __('AI创建虚拟主题') ?> - ' + themeName
                : '<?= __('AI创建虚拟主题') ?>';
        }
        if (instructions) {
            instructions.value = '';
        }
        if (result) {
            result.style.display = 'none';
            result.innerHTML = '';
        }

        setAiVirtualThemeStatus('light', '<?= __('AI 会完全参照默认主题全部默认布局源码生成虚拟主题草稿，发布前不会影响前台渲染。') ?>');
        renderAiVirtualThemeCatalog();
        aiVirtualThemeModal.show();
        window.setTimeout(function() {
            instructions?.focus();
        }, 180);
    }

    async function createAiVirtualThemeDraft() {
        const modal = aiVirtualThemeModalElement;
        const select = document.getElementById('aiVirtualThemeBaseTheme');
        const instructions = document.getElementById('aiVirtualThemeInstructions');
        const resultEl = document.getElementById('aiVirtualThemeResult');
        const themeId = select ? Number(select.value || 0) : 0;

        if (!themeId) {
            setAiVirtualThemeStatus('warning', '<?= __('请选择参照主题') ?>');
            return;
        }

        setAiVirtualThemeBusy(true);
        setAiVirtualThemeStatus('info', '<?= __('正在按参照主题全部布局类型创建虚拟主题草稿...') ?>');
        if (resultEl) {
            resultEl.style.display = 'none';
            resultEl.innerHTML = '';
        }

        try {
            const payload = {
                theme_id: themeId,
                area: 'frontend',
                page_type: 'all',
                layout_type: 'all',
                layout_option: 'all',
                all_layout_types: true,
                request_id: 'theme-manage-ai-create-' + themeId + '-' + Date.now(),
                instructions: instructions ? instructions.value : '',
                selected_skill_codes: readCheckedValues(modal, 'input[name="ai_virtual_theme_skill"]'),
                selected_style_codes: readCheckedValues(modal, 'input[name="ai_virtual_theme_style"]'),
                use_ai: true
            };
            const data = await runAiVirtualThemeTask(payload, function(progress) {
                const current = Number(progress.current || 0);
                const total = Number(progress.total || 0);
                setAiVirtualThemeStatus('info', total > 0
                    ? '<?= __('正在创建虚拟主题草稿') ?> (' + current + '/' + total + ')'
                    : '<?= __('正在创建虚拟主题草稿...') ?>');
            });
            const layoutOption = data.layout_option || 'default';
            const layoutTypes = Array.isArray(data.layout_types) ? data.layout_types : [];
            const previewLayoutType = layoutTypes.indexOf('homepage') !== -1
                ? 'homepage'
                : (layoutTypes[0] || 'homepage');
            const createdCount = Number(data.created_count || (Array.isArray(data.results) ? data.results.length : 0));
            const editorUrl = buildThemeEditorUrl(themeId, previewLayoutType, layoutOption);
            setAiVirtualThemeStatus('success', '<?= __('虚拟主题草稿已创建') ?>');
            if (resultEl) {
                resultEl.style.display = 'block';
                resultEl.innerHTML =
                    '<div class="w-alert" data-tone="success" style="--w-mb:0;">' +
                    '<div class="w-cluster" data-wrap="true" data-align="center" data-justify="between" style="--w-gap:var(--weline-space-2);">' +
                    '<span><w:icon name="check" size="sm"></w:icon>' + escapeHtml('<?= __('已创建虚拟主题草稿') ?>') +
                    ' <code>' + escapeHtml(layoutOption) + '</code>' +
                    (createdCount > 0 ? ' <small class="w-text" data-tone="muted"><?= __('已覆盖布局类型') ?> ' + createdCount + '</small>' : '') +
                    '</span>' +
                    '<a class="w-button" href="' + escapeHtml(editorUrl) + '" data-tone="primary" data-size="sm">' +
                    '<w:icon name="palette" size="sm"></w:icon> <?= __('打开可视化编辑') ?></a>' +
                    '</div>' +
                    '</div>';
            }
            showToast('success', '<?= __('虚拟主题草稿已创建') ?>');
        } catch (error) {
            const message = error.message || '<?= __('虚拟主题创建失败') ?>';
            setAiVirtualThemeStatus('danger', message);
            if (resultEl) {
                resultEl.style.display = 'block';
                resultEl.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;">' + escapeHtml(message) + '</div>';
            }
        } finally {
            setAiVirtualThemeBusy(false);
        }
    }

    function findThemeCard(themeId, area) {
        return Array.from(document.querySelectorAll('.theme-card')).find(function(card) {
            return card.dataset.themeId === String(themeId) && card.dataset.area === area;
        }) || null;
    }

    function appendPreviewCacheBuster(url) {
        if (!url) {
            return '';
        }

        return url + (url.indexOf('?') === -1 ? '?' : '&') + 't=' + Date.now();
    }

    function knownPreviewUrl(themeId, area) {
        const id = Number(themeId);
        const normalizedArea = area === 'backend' ? 'backend' : 'frontend';
        if (!id) {
            return '';
        }
        return '/theme_previews/theme_' + id + '_' + normalizedArea + '.png';
    }

    function showSinglePreviewImage(url) {
        const image = document.getElementById('singlePreviewImage');
        const camera = document.getElementById('singlePreviewCamera');
        if (!image || !url) {
            return Promise.resolve(false);
        }
        return new Promise(function(resolve) {
            let settled = false;
            const finish = function(ok) {
                if (settled) {
                    return;
                }
                settled = true;
                image.hidden = !ok;
                if (camera) {
                    camera.hidden = !!ok;
                }
                resolve(ok);
            };
            image.onload = function() { finish(image.naturalWidth > 0); };
            image.onerror = function() { finish(false); };
            image.src = appendPreviewCacheBuster(url);
        });
    }

    function revealKnownPreview(descriptor) {
        if (!descriptor || !descriptor.theme_id) {
            return Promise.resolve(false);
        }
        const url = knownPreviewUrl(descriptor.theme_id, descriptor.area);
        if (!url) {
            return Promise.resolve(false);
        }
        updateThemeCardPreview(findThemeCard(descriptor.theme_id, descriptor.area), url);
        return showSinglePreviewImage(url);
    }

    function updatePreviewActionButton(card, hasPreview) {
        if (!card) {
            return;
        }

        const button = card.querySelector('.preview-action-btn');
        card.dataset.hasPreview = hasPreview ? '1' : '0';
        card.dataset.needsPreview = hasPreview ? '0' : '1';

        if (!button) {
            return;
        }

        const title = hasPreview ? '<?= __('刷新预览图') ?>' : '<?= __('生成预览图') ?>';
        button.dataset.force = hasPreview ? '1' : '0';
        button.title = title;
        button.setAttribute('aria-label', title);
        button.classList.toggle('preview-action-btn--refresh', !!hasPreview);
        button.classList.toggle('preview-action-btn--generate', !hasPreview);
        button.setAttribute('data-tone', hasPreview ? 'neutral' : 'primary');
        if (hasPreview) {
            button.setAttribute('data-variant', 'outline');
        } else {
            button.removeAttribute('data-variant');
        }

        button.querySelectorAll('[data-preview-icon]').forEach(function(icon) {
            icon.hidden = icon.getAttribute('data-preview-icon') !== (hasPreview ? 'refresh' : 'generate');
        });
    }

    function setThemeCardStatus(card, type, message) {
        if (!card) {
            return;
        }

        const badge = card.querySelector('.theme-preview-status-badge');
        if (!badge) {
            return;
        }

        if (!message) {
            badge.textContent = '';
            badge.className = 'theme-preview-status-badge';
            badge.hidden = true;
            return;
        }

        badge.textContent = message;
        badge.className = 'theme-preview-status-badge preview-status--' + type;
        badge.hidden = false;
    }

    function setThemeCardGenerating(card, generating) {
        if (!card) {
            return;
        }

        card.classList.toggle('is-generating', generating);
        const button = card.querySelector('.preview-action-btn');
        if (button) {
            button.disabled = generating;
        }
    }

    function showThemePreviewPlaceholder(image, placeholder) {
        if (!image) {
            return;
        }

        const targetSelector = image.getAttribute('data-fallback-target') || '.theme-preview-placeholder';
        const target = placeholder || (image.parentNode ? image.parentNode.querySelector(targetSelector) : null);
        image.hidden = true;
        if (target) {
            target.hidden = false;
        }
    }

    function bindThemePreviewImageFallback(image, placeholder) {
        if (!image || image.dataset.fallbackBound === '1') {
            return;
        }

        image.dataset.fallbackBound = '1';
        image.addEventListener('error', function() {
            showThemePreviewPlaceholder(image, placeholder);
        });
    }

    document.querySelectorAll('.theme-preview-image[data-fallback-target]').forEach(function(image) {
        bindThemePreviewImageFallback(image);
    });

    function updateThemeCardPreview(card, imageUrl, websiteId) {
        if (!card || !imageUrl) {
            return;
        }

        const preview = card.querySelector('.theme-preview');
        let image = card.querySelector('.theme-preview-image');
        const placeholder = card.querySelector('.theme-preview-placeholder');
        const bustedUrl = appendPreviewCacheBuster(imageUrl);
        const resolvedWebsiteId = websiteId != null
            ? Number(websiteId)
            : Number.parseInt(String(card.getAttribute('data-edit-website-id') || ''), 10);

        if (!image && preview) {
            image = document.createElement('img');
            image.alt = '<?= __('主题预览') ?>';
            image.className = 'theme-preview-image';
            image.setAttribute('data-fallback-target', '.theme-preview-placeholder');
            bindThemePreviewImageFallback(image, placeholder);
            preview.insertBefore(image, preview.firstChild);
        } else {
            bindThemePreviewImageFallback(image, placeholder);
        }

        if (Number.isFinite(resolvedWebsiteId) && resolvedWebsiteId >= 0) {
            const previews = parseThemeCardWebsitePreviews(card);
            previews[String(resolvedWebsiteId)] = bustedUrl;
            card.setAttribute('data-website-previews', JSON.stringify(previews));
        }

        if (image) {
            image.src = bustedUrl;
            image.hidden = false;
        }

        if (placeholder) {
            placeholder.hidden = true;
        }

        updatePreviewActionButton(card, true);
    }

    function previewTargetKey(themeId, area) {
        return 'theme_' + Number(themeId) + '_' + area;
    }

    function setSinglePreviewModalState(type, message) {
        const spinner = document.getElementById('singleSpinner');
        const status = document.getElementById('singleStatus');
        if (spinner) {
            spinner.hidden = type !== 'working';
        }
        if (!status) {
            return;
        }
        if (type === 'success') {
            status.innerHTML = '<span class="w-text" data-tone="success"><w:icon name="check" size="sm"></w:icon> ' + escapeHtml(message) + '</span>';
        } else if (type === 'error') {
            status.innerHTML = '<span class="w-text" data-tone="danger"><w:icon name="warning" size="sm"></w:icon> ' + escapeHtml(message) + '</span>';
        } else {
            status.textContent = message;
        }
    }

    function applySinglePreviewResult(descriptor, result) {
        const card = findThemeCard(descriptor.theme_id, descriptor.area);
        const shot = document.getElementById('singlePreviewImage');
        let success = !!(result && result.success);
        let message = success
            ? (descriptor.success_message || '<?= __('预览图已更新') ?>')
            : String(result?.error || descriptor.error_message || '<?= __('生成失败') ?>');
        if (!success && shot && !shot.hidden && shot.naturalWidth > 0) {
            success = true;
            message = descriptor.success_message || '<?= __('预览图已刷新') ?>';
        }
        if (success) {
            const imageUrl = (result && result.image_url) || knownPreviewUrl(descriptor.theme_id, descriptor.area);
            if (imageUrl) {
                showSinglePreviewImage(imageUrl);
            }
        }
        if (card && success) {
            updateThemeCardPreview(
                card,
                result.image_url || '',
                result.website_id != null ? result.website_id : descriptor.website_id,
            );
            setThemeCardStatus(card, 'success', message);
            window.setTimeout(function() {
                setThemeCardStatus(card, '', '');
            }, 1800);
        } else if (card) {
            setThemeCardStatus(card, 'error', message);
        }
        if (descriptor.show_modal) {
            setSinglePreviewModalState(success ? 'success' : 'error', message);
            if (success && singleGenerateModal) {
                window.setTimeout(function() {
                    singleGenerateModal.hide();
                }, 2200);
            }
        }
        return success;
    }

    async function attachSinglePreviewTask(api, task, descriptor) {
        if (activePreviewPolls.has(task.task_id)) {
            return null;
        }
        const targetKey = previewTargetKey(descriptor.theme_id, descriptor.area);
        const card = findThemeCard(descriptor.theme_id, descriptor.area);
        const handle = createPollHandle(api, task);
        activePreviewPolls.set(task.task_id, handle);
        activePreviewTargets.add(targetKey);
        activeSingleTaskId = task.task_id;
        setPreviewCancelButton('cancelSinglePreviewTask', true);
        if (card) {
            setThemeCardGenerating(card, true);
            setThemeCardStatus(card, 'info', descriptor.status_message || '<?= __('正在生成') ?>');
        }

        let finished = false;
        const finish = function(outcome) {
            if (finished) {
                return outcome;
            }
            finished = true;
            activePreviewPolls.delete(task.task_id);
            activePreviewTargets.delete(targetKey);
            clearPreviewTask(task.task_id);
            if (activeSingleTaskId === task.task_id) {
                activeSingleTaskId = null;
                setPreviewCancelButton('cancelSinglePreviewTask', false);
            }
            if (card) {
                setThemeCardGenerating(card, false);
            }
            handle.close();
            return outcome;
        };
        const resultForTarget = function(data) {
            const results = data && data.results;
            if (Array.isArray(results)) {
                return results.find(function(item) { return item && item.key === targetKey; }) || null;
            }
            if (results && typeof results === 'object') {
                return results[targetKey] || null;
            }
            return null;
        };

        try {
            const snap = await pollRuntimeTask(api, task, handle, function(update) {
                const state = checkpointState(update);
                const partial = state.results ? state.results[targetKey] : null;
                if (partial) {
                    applySinglePreviewResult(descriptor, partial);
                } else if (partial === undefined && state.current && Number(state.current.theme_id) === Number(descriptor.theme_id)
                    && state.current.area === descriptor.area && card) {
                    setThemeCardStatus(card, 'info', String(state.message || descriptor.status_message || '<?= __('正在生成') ?>'));
                }
            });
            if (!snap) {
                return finish({ success: false, detached: true });
            }
            const status = String(snap.status || '');
            if (status === 'completed') {
                const result = resultForTarget(runtimeResultData(snap));
                const success = applySinglePreviewResult(descriptor, result || {
                    success: false,
                    error: '<?= __('未找到预览图任务结果') ?>',
                });
                return finish({ success: success });
            }
            if (await revealKnownPreview(descriptor)) {
                applySinglePreviewResult(descriptor, {
                    success: true,
                    image_url: knownPreviewUrl(descriptor.theme_id, descriptor.area),
                });
                return finish({ success: true });
            }
            const message = taskFailureMessage(snap, status === 'cancelled'
                ? '<?= __('预览图生成已取消') ?>'
                : (status === 'expired'
                    ? '<?= __('客户端失联超时，预览图任务已停止') ?>'
                    : '<?= __('预览图生成失败') ?>'));
            applySinglePreviewResult(descriptor, { success: false, error: message });
            return finish({ success: false, error: message });
        } catch (error) {
            if (await revealKnownPreview(descriptor)) {
                applySinglePreviewResult(descriptor, {
                    success: true,
                    image_url: knownPreviewUrl(descriptor.theme_id, descriptor.area),
                });
                return finish({ success: true });
            }
            const message = error && error.message
                ? String(error.message)
                : '<?= __('预览图生成失败') ?>';
            applySinglePreviewResult(descriptor, { success: false, error: message });
            return finish({ success: false, error: message });
        }
    }

    async function generateSinglePreview(themeId, area, options = {}) {
        const config = Object.assign({
            force: true,
            showModal: false,
            card: null,
            title: '',
            statusMessage: '',
            successMessage: '',
            errorMessage: '',
        }, options);
        const normalizedThemeId = Number(themeId);
        const targetKey = previewTargetKey(normalizedThemeId, area);
        if (!normalizedThemeId || activePreviewTargets.has(targetKey)) {
            return null;
        }

        const card = config.card || findThemeCard(normalizedThemeId, area);
        if (config.showModal && singleGenerateModal) {
            document.getElementById('singleGenerateTitle').innerText = config.title || '<?= __('生成预览图') ?>';
            setSinglePreviewModalState('working', config.statusMessage || '<?= __('正在生成预览图，请稍候...') ?>');
            singleGenerateModal.show();
            revealKnownPreview({
                theme_id: normalizedThemeId,
                area: area,
                success_message: config.successMessage || '',
            });
        }
        if (card) {
            setThemeCardGenerating(card, true);
            setThemeCardStatus(card, 'info', config.statusMessage || '<?= __('正在生成') ?>');
        }
        try {
            const taskInput = {
                request_id: createPreviewRequestId('theme-preview'),
                scope: 'single',
                theme_id: normalizedThemeId,
                area: area,
                force: config.force,
            };
            if (config.website_id != null && Number.isFinite(Number(config.website_id))) {
                taskInput.website_id = Number(config.website_id);
            }
            if (config.website_code) {
                taskInput.website_code = String(config.website_code);
            }
            const started = await startThemePreviewTask(taskInput);
            const descriptor = {
                kind: 'single',
                theme_id: normalizedThemeId,
                area: area,
                website_id: config.website_id != null ? Number(config.website_id) : null,
                show_modal: !!config.showModal,
                status_message: config.statusMessage || '',
                success_message: config.successMessage || '',
                error_message: config.errorMessage || '',
            };
            persistPreviewTask(started.task, descriptor);
            return await attachSinglePreviewTask(started.api, started.task, descriptor);
        } catch (error) {
            const message = (config.errorMessage || '<?= __('无法启动预览图任务') ?>') + ': ' + (error?.message || '');
            if (card) {
                setThemeCardGenerating(card, false);
                setThemeCardStatus(card, 'error', message);
            }
            if (config.showModal) {
                setSinglePreviewModalState('error', message);
            }
            return null;
        }
    }

    async function autoGenerateMissingPreviews() {
        const cards = Array.from(document.querySelectorAll('.theme-card[data-needs-preview="1"]'));
        if (cards.length === 0 || activeBatchTaskId) {
            return;
        }

        cards.forEach(function(card) {
            setThemeCardGenerating(card, true);
            setThemeCardStatus(
                card,
                'info',
                '<?= __('自动生成中') ?>' + ' ' + ((card.dataset.area || 'frontend') === 'backend' ? '<?= __('后台') ?>' : '<?= __('前台') ?>')
            );
        });

        try {
            // One silent batch with force=false: existing preview files are skipped,
            // missing ones are created, and empty DB paths are filled from disk.
            const started = await startThemePreviewTask({
                request_id: createPreviewRequestId('theme-preview-auto'),
                scope: 'all',
                force: false,
            });
            const descriptor = {
                kind: 'batch',
                silent: true,
                auto_missing: true,
            };
            persistPreviewTask(started.task, descriptor);
            await attachBatchPreviewTask(started.api, started.task, descriptor);
        } catch (error) {
            const message = '<?= __('自动生成失败') ?>: ' + (error?.message || '');
            cards.forEach(function(card) {
                setThemeCardGenerating(card, false);
                setThemeCardStatus(card, 'error', message);
            });
        }
    }

    function batchPreviewElements() {
        return {
            status: document.getElementById('batchStatus'),
            count: document.getElementById('batchCount'),
            result: document.getElementById('batchResult'),
            bar: document.getElementById('batchProgressBar') || document.querySelector('#batchProgress .w-progress__bar'),
        };
    }

    function setBatchPreviewProgress(payload) {
        const elements = batchPreviewElements();
        const current = Number(payload.current || 0);
        const total = Number(payload.total || 0);
        const progress = Number(payload.progress || (total > 0 ? (current / total) * 100 : 0));
        const clamped = Math.max(0, Math.min(100, progress));
        if (elements.bar) {
            elements.bar.style.setProperty('--w-progress', clamped + '%');
            elements.bar.style.width = '';
            elements.bar.setAttribute('aria-valuenow', String(Math.round(clamped)));
        }
        if (elements.status) {
            elements.status.textContent = String(payload.message || '<?= __('正在批量生成预览图，请稍候...') ?>');
        }
        if (elements.count) {
            elements.count.textContent = current + ' / ' + total;
        }
    }

    function renderBatchPreviewSummary(result) {
        const elements = batchPreviewElements();
        const success = Number(result?.success || 0);
        const failed = Number(result?.failed || 0);
        const items = Array.isArray(result?.results) ? result.results : [];
        items.forEach(function(item) {
            const card = findThemeCard(item?.theme_id, item?.area);
            if (!card) {
                return;
            }
            if (item.success) {
                updateThemeCardPreview(card, item.image_url || '');
                setThemeCardStatus(card, 'success', '<?= __('预览图已更新') ?>');
            } else {
                setThemeCardStatus(card, 'error', String(item.error || '<?= __('生成失败') ?>'));
            }
            setThemeCardGenerating(card, false);
        });
        if (elements.bar) {
            elements.bar.style.width = '100%';
        }
        if (elements.status) {
            elements.status.textContent = failed > 0
                ? '<?= __('批量生成已完成，但存在失败项') ?>'
                : '<?= __('批量生成完成') ?>';
        }
        if (elements.count) {
            elements.count.textContent = '<?= __('成功') ?> ' + success + ' / <?= __('失败') ?> ' + failed;
        }
        if (failed > 0 && elements.result) {
            const messages = items.filter(function(item) {
                return item && !item.success;
            }).map(function(item) {
                return '<li>' + escapeHtml(String(item.error || (item.theme_id + ' ' + item.area))) + '</li>';
            }).join('');
            elements.result.style.display = 'block';
            elements.result.innerHTML = '<div class="w-alert" data-tone="warning" style="--w-mb:0;"><ul style="--w-mb:0;">' + messages + '</ul></div>';
        }
    }

    async function attachBatchPreviewTask(api, task, descriptor) {
        if (activePreviewPolls.has(task.task_id)) {
            return null;
        }
        const handle = createPollHandle(api, task);
        activePreviewPolls.set(task.task_id, handle);
        activeBatchTaskId = task.task_id;
        setPreviewCancelButton('cancelBatchPreviewTask', true);
        let finished = false;
        const finish = function(outcome) {
            if (finished) {
                return outcome;
            }
            finished = true;
            activePreviewPolls.delete(task.task_id);
            clearPreviewTask(task.task_id);
            if (activeBatchTaskId === task.task_id) {
                activeBatchTaskId = null;
                setPreviewCancelButton('cancelBatchPreviewTask', false);
            }
            handle.close();
            return outcome;
        };
        const silent = !!descriptor.silent;
        const applyCheckpointProgress = function(state) {
            if (!silent) {
                setBatchPreviewProgress({
                    current: state.next_index || 0,
                    total: Number(state.total || Object.keys(state.results || {}).length),
                    message: String(state.message || '<?= __('自动生成中') ?>'),
                });
            }
            const results = state.results && typeof state.results === 'object' ? state.results : {};
            Object.keys(results).forEach(function(key) {
                const payload = results[key];
                if (!payload || typeof payload !== 'object') {
                    return;
                }
                const card = findThemeCard(payload.theme_id, payload.area);
                if (!card) {
                    return;
                }
                if (payload.success) {
                    updateThemeCardPreview(card, payload.image_url || '');
                    setThemeCardStatus(card, 'success', '<?= __('自动生成完成') ?>');
                    setThemeCardGenerating(card, false);
                } else if (payload.error) {
                    setThemeCardStatus(card, 'error', String(payload.error));
                    setThemeCardGenerating(card, false);
                }
            });
            const current = state.current;
            if (current && typeof current === 'object') {
                const card = findThemeCard(current.theme_id, current.area);
                if (card) {
                    setThemeCardStatus(card, 'info', String(state.message || '<?= __('自动生成中') ?>'));
                }
            }
        };

        try {
            const snap = await pollRuntimeTask(api, task, handle, function(update) {
                applyCheckpointProgress(checkpointState(update));
            });
            if (!snap) {
                return finish({ success: false, detached: true });
            }
            const status = String(snap.status || '');
            if (status === 'completed') {
                const result = runtimeResultData(snap);
                renderBatchPreviewSummary(result);
                if (silent) {
                    document.querySelectorAll('.theme-card.is-generating').forEach(function(card) {
                        setThemeCardGenerating(card, false);
                    });
                }
                return finish({ success: Number(result.failed || 0) === 0 });
            }
            const elements = batchPreviewElements();
            const message = taskFailureMessage(snap, status === 'cancelled'
                ? '<?= __('批量预览图生成已取消') ?>'
                : (status === 'expired'
                    ? '<?= __('客户端失联超时，批量预览图任务已停止') ?>'
                    : '<?= __('批量预览图生成失败') ?>'));
            if (!silent) {
                if (elements.status) {
                    elements.status.textContent = message;
                }
                if (elements.result) {
                    elements.result.style.display = 'block';
                    elements.result.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;">' + escapeHtml(message) + '</div>';
                }
            } else {
                document.querySelectorAll('.theme-card[data-needs-preview="1"]').forEach(function(card) {
                    setThemeCardGenerating(card, false);
                    setThemeCardStatus(card, 'error', message);
                });
            }
            return finish({ success: false, error: message });
        } catch (error) {
            const message = error && error.message
                ? String(error.message)
                : '<?= __('批量预览图生成失败') ?>';
            return finish({ success: false, error: message });
        }
    }

    async function runBatchPreviewGeneration() {
        if (!batchGenerateModal) {
            return;
        }
        const elements = batchPreviewElements();
        batchGenerateModal.show();
        if (elements.bar) {
            elements.bar.style.width = '0%';
        }
        if (elements.status) {
            elements.status.textContent = '<?= __('正在批量生成预览图，请稍候...') ?>';
        }
        if (elements.count) {
            elements.count.textContent = '';
        }
        if (elements.result) {
            elements.result.style.display = 'none';
            elements.result.innerHTML = '';
        }
        try {
            const started = await startThemePreviewTask({
                request_id: createPreviewRequestId('theme-preview-batch'),
                scope: 'all',
                force: true,
            });
            const descriptor = { kind: 'batch' };
            persistPreviewTask(started.task, descriptor);
            return await attachBatchPreviewTask(started.api, started.task, descriptor);
        } catch (error) {
            const message = '<?= __('无法启动批量预览图任务') ?>: ' + (error?.message || '');
            if (elements.status) {
                elements.status.textContent = message;
            }
            if (elements.result) {
                elements.result.style.display = 'block';
                elements.result.innerHTML = '<div class="w-alert" data-tone="danger" style="--w-mb:0;">' + escapeHtml(message) + '</div>';
            }
            return null;
        }
    }

    async function restoreActivePreviewTasks() {
        const entries = storedPreviewTasks();
        if (entries.length === 0) {
            return;
        }
        let api;
        try {
            api = await getRuntimeApi();
        } catch (error) {
            return;
        }
        entries.forEach(function(entry) {
            if (activePreviewPolls.has(entry.task.task_id)) {
                return;
            }
            const restore = entry.descriptor.kind === 'single'
                ? attachSinglePreviewTask(api, entry.task, entry.descriptor)
                : attachBatchPreviewTask(api, entry.task, entry.descriptor);
            restore.catch(function(error) {
                console.warn('Unable to restore Theme preview task poll', error);
            });
        });
    }

    document.getElementById('batchGeneratePreviews')?.addEventListener('click', function() {
        runBatchPreviewGeneration();
    });

    document.getElementById('cancelBatchPreviewTask')?.addEventListener('click', function() {
        if (!activeBatchTaskId) {
            return;
        }
        setPreviewCancelButton('cancelBatchPreviewTask', false);
        cancelThemePreviewTask(activeBatchTaskId, '<?= addslashes(__('用户取消批量预览图任务')) ?>').catch(function(error) {
            setPreviewCancelButton('cancelBatchPreviewTask', true);
            showToast('error', error?.message || '<?= __('取消任务失败') ?>');
        });
    });

    document.getElementById('cancelSinglePreviewTask')?.addEventListener('click', function() {
        if (!activeSingleTaskId) {
            return;
        }
        setPreviewCancelButton('cancelSinglePreviewTask', false);
        cancelThemePreviewTask(activeSingleTaskId, '<?= addslashes(__('用户取消预览图任务')) ?>').catch(function(error) {
            setPreviewCancelButton('cancelSinglePreviewTask', true);
            showToast('error', error?.message || '<?= __('取消任务失败') ?>');
        });
    });

    document.getElementById('openAiVirtualThemeModal')?.addEventListener('click', function() {
        const themeId = this.dataset.themeId || document.getElementById('aiVirtualThemeBaseTheme')?.value || '';
        openAiVirtualThemeDialog(themeId, '');
    });

    document.getElementById('createAiVirtualTheme')?.addEventListener('click', function() {
        createAiVirtualThemeDraft();
    });

    document.querySelectorAll('.preview-action-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const themeId = this.dataset.themeId;
            const themeName = this.dataset.themeName;
            const area = this.dataset.area || 'frontend';
            const force = this.dataset.force === '1';
            const card = findThemeCard(themeId, area);
            const websiteId = card
                ? Number.parseInt(String(card.getAttribute('data-edit-website-id') || ''), 10)
                : NaN;
            const websiteCode = card
                ? String(card.getAttribute('data-edit-website-code') || '').trim().toLowerCase()
                : '';
            const areaLabel = area === 'backend' ? '<?= __('后台') ?>' : '<?= __('前台') ?>';
            const actionText = force ? '<?= __('刷新') ?>' : '<?= __('生成') ?>';

            generateSinglePreview(themeId, area, {
                force: force,
                showModal: true,
                card: card,
                website_id: Number.isFinite(websiteId) && websiteId >= 0 ? websiteId : null,
                website_code: websiteCode,
                title: actionText + ' "' + themeName + '" ' + areaLabel + ' <?= __('预览图') ?>',
                statusMessage: actionText + '<?= __('中...') ?>',
                successMessage: force ? '<?= __('预览图已刷新') ?>' : '<?= __('预览图生成成功') ?>',
                errorMessage: force ? '<?= __('刷新失败') ?>' : '<?= __('生成失败') ?>',
            });
        });
    });

    document.querySelectorAll('[data-theme-preview-nav]').forEach(function(button) {
        button.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();
            const card = button.closest('.theme-card');
            if (!card) {
                return;
            }
            const dir = button.getAttribute('data-theme-preview-nav') === 'prev' ? -1 : 1;
            stepThemeCardWebsite(card, dir);
        });
    });

    const THEME_LIST_WEBSITE_STORAGE_PREFIX = 'weline.theme.list.website.';

    function parseThemeCardWebsiteBindings(card) {
        try {
            const raw = card.getAttribute('data-website-bindings') || '[]';
            const parsed = JSON.parse(raw);
            return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
            return [];
        }
    }

    function defaultThemeCardWebsiteScope() {
        return { website_id: 0, website_code: 'default' };
    }

    /**
     * 预览/编辑共用网站范围：仅 1 个绑定站 → 直接用该站；0 绑定 → Default；
     * ≥2 → 用卡上当前选中（须 ∈ bindings），否则首个绑定。
     */
    function resolveThemeCardWebsiteScope(card) {
        const bindings = parseThemeCardWebsiteBindings(card);
        if (bindings.length === 1) {
            return {
                website_id: Math.max(0, Number.parseInt(String(bindings[0]?.website_id ?? 0), 10) || 0),
                website_code: String(bindings[0]?.website_code || '').trim().toLowerCase() || 'default',
            };
        }
        if (bindings.length === 0) {
            return defaultThemeCardWebsiteScope();
        }
        const currentId = Math.max(0, Number.parseInt(String(card.getAttribute('data-edit-website-id') || ''), 10) || 0);
        const currentCode = String(card.getAttribute('data-edit-website-code') || '').trim().toLowerCase();
        const match = bindings.find(function(row) {
            const rowId = Number.parseInt(String(row?.website_id ?? ''), 10);
            const rowCode = String(row?.website_code || '').trim().toLowerCase();
            if (Number.isFinite(currentId) && currentId === rowId) {
                return true;
            }
            return currentCode !== '' && currentCode === rowCode;
        });
        const picked = match || bindings[0];
        return {
            website_id: Math.max(0, Number.parseInt(String(picked?.website_id ?? 0), 10) || 0),
            website_code: String(picked?.website_code || '').trim().toLowerCase() || 'default',
        };
    }

    function ensureThemeCardWebsiteScope(card, persist) {
        const scope = resolveThemeCardWebsiteScope(card);
        applyThemeCardWebsite(card, scope.website_id, scope.website_code, !!persist);
        return scope;
    }

    function patchThemeUrlWithWebsite(url, websiteId, websiteCode) {
        const absolute = new URL(String(url || ''), window.location.origin);
        absolute.searchParams.set('scope_kind', 'website');
        absolute.searchParams.set('website_id', String(websiteId));
        absolute.searchParams.set('website_code', String(websiteCode || ''));
        const original = String(url || '');
        if (/^https?:\/\//i.test(original)) {
            return absolute.href;
        }
        return absolute.pathname + absolute.search + absolute.hash;
    }

    function parseThemeCardWebsitePreviews(card) {
        try {
            const raw = card.getAttribute('data-website-previews') || '{}';
            const parsed = JSON.parse(raw);
            return parsed && typeof parsed === 'object' ? parsed : {};
        } catch (error) {
            return {};
        }
    }

    function applyThemeCardPreviewImage(card, websiteId) {
        const previews = parseThemeCardWebsitePreviews(card);
        const imageUrl = String(previews[String(websiteId)] || '').trim();
        const image = card.querySelector('.theme-preview-image');
        const placeholder = card.querySelector('.theme-preview-placeholder');
        if (!(image instanceof HTMLImageElement)) {
            return;
        }
        if (imageUrl) {
            image.src = imageUrl;
            image.hidden = false;
            if (placeholder) {
                placeholder.hidden = true;
            }
            card.setAttribute('data-has-preview', '1');
            card.setAttribute('data-needs-preview', '0');
            updatePreviewActionButton(card, true);
        } else {
            image.removeAttribute('src');
            image.hidden = true;
            if (placeholder) {
                placeholder.hidden = false;
            }
            card.setAttribute('data-has-preview', '0');
            card.setAttribute('data-needs-preview', '1');
            updatePreviewActionButton(card, false);
        }
    }

    function applyThemeCardWebsite(card, websiteId, websiteCode, persist) {
        const id = Math.max(0, Number.parseInt(String(websiteId), 10) || 0);
        const code = String(websiteCode || '').trim().toLowerCase();
        card.setAttribute('data-edit-website-id', String(id));
        card.setAttribute('data-edit-website-code', code);
        applyThemeCardPreviewImage(card, id);

        const editLink = card.querySelector('.theme-edit-link');
        const previewLink = card.querySelector('.theme-preview-link');
        const currentEditHref = String(
            card.getAttribute('data-edit-href')
            || (editLink ? editLink.getAttribute('href') : '')
            || ''
        ).trim();
        if (currentEditHref) {
            const nextEditHref = patchThemeUrlWithWebsite(currentEditHref, id, code);
            card.setAttribute('data-edit-href', nextEditHref);
            if (editLink) {
                editLink.setAttribute('href', nextEditHref);
                editLink.setAttribute('data-edit-website-id', String(id));
                editLink.setAttribute('data-edit-website-code', code);
            }
        }
        if (previewLink) {
            const previewHref = String(previewLink.getAttribute('href') || '').trim();
            if (previewHref) {
                previewLink.setAttribute('href', patchThemeUrlWithWebsite(previewHref, id, code));
            }
        }

        if (!persist) {
            return;
        }
        const themeId = String(card.getAttribute('data-theme-id') || '').trim();
        if (!themeId) {
            return;
        }
        try {
            window.sessionStorage.setItem(
                THEME_LIST_WEBSITE_STORAGE_PREFIX + themeId,
                JSON.stringify({ website_id: id, website_code: code })
            );
        } catch (error) {
            // sessionStorage is optional.
        }
    }

    function stepThemeCardWebsite(card, direction) {
        const bindings = parseThemeCardWebsiteBindings(card);
        if (bindings.length < 2) {
            return;
        }
        const currentId = Number.parseInt(String(card.getAttribute('data-edit-website-id') || ''), 10);
        let index = bindings.findIndex(function(row) {
            return Number.parseInt(String(row?.website_id ?? ''), 10) === currentId;
        });
        if (index < 0) {
            index = 0;
        }
        const nextIndex = (index + (direction < 0 ? -1 : 1) + bindings.length) % bindings.length;
        const next = bindings[nextIndex];
        if (!next) {
            return;
        }
        applyThemeCardWebsite(card, next.website_id, next.website_code, true);
        const themeId = String(card.getAttribute('data-theme-id') || '').trim();
        const selectApi = themeId && window.WelineWebsiteSelect
            ? window.WelineWebsiteSelect['theme_card_website_' + themeId]
            : null;
        if (selectApi && typeof selectApi.setValue === 'function') {
            selectApi.setValue(String(next.website_id));
        }
    }

    function rememberThemeCardWebsiteFromStorage(card) {
        const bindings = parseThemeCardWebsiteBindings(card);
        if (!bindings.length) {
            return null;
        }
        const themeId = String(card.getAttribute('data-theme-id') || '').trim();
        if (!themeId) {
            return null;
        }
        try {
            const raw = window.sessionStorage.getItem(THEME_LIST_WEBSITE_STORAGE_PREFIX + themeId);
            if (!raw) {
                return null;
            }
            const remembered = JSON.parse(raw);
            const rememberedId = Number.parseInt(String(remembered?.website_id ?? ''), 10);
            const rememberedCode = String(remembered?.website_code || '').trim().toLowerCase();
            return bindings.find(function(row) {
                const rowId = Number.parseInt(String(row?.website_id ?? ''), 10);
                const rowCode = String(row?.website_code || '').trim().toLowerCase();
                if (Number.isFinite(rememberedId) && rememberedId === rowId) {
                    return true;
                }
                return rememberedCode !== '' && rememberedCode === rowCode;
            }) || null;
        } catch (error) {
            return null;
        }
    }

    document.querySelectorAll('[data-theme-card-website-select]').forEach(function(wrap) {
        wrap.addEventListener('click', function(event) {
            event.stopPropagation();
        });
        const card = wrap.closest('.theme-card');
        const hidden = wrap.querySelector('[data-website-select-value]');
        if (!card || !hidden) {
            return;
        }
        hidden.addEventListener('change', function() {
            const websiteId = Number.parseInt(String(hidden.value || ''), 10);
            if (!Number.isFinite(websiteId) || websiteId < 0) {
                return;
            }
            const bindings = parseThemeCardWebsiteBindings(card);
            const match = bindings.find(function(row) {
                return Number.parseInt(String(row?.website_id ?? ''), 10) === websiteId;
            });
            if (!match) {
                return;
            }
            applyThemeCardWebsite(
                card,
                match.website_id,
                match.website_code,
                true
            );
        });
    });

    document.querySelectorAll('.theme-card[data-website-bindings]').forEach(function(card) {
        const remembered = rememberThemeCardWebsiteFromStorage(card);
        if (remembered) {
            applyThemeCardWebsite(
                card,
                Math.max(0, Number.parseInt(String(remembered.website_id ?? ''), 10) || 0),
                String(remembered.website_code || '').trim().toLowerCase(),
                false
            );
        } else {
            // 单范围（或无绑定回落 Default）在加载时就写好预览/编辑 href，点击直接跳转。
            ensureThemeCardWebsiteScope(card, false);
        }
        const scope = resolveThemeCardWebsiteScope(card);
        const themeId = String(card.getAttribute('data-theme-id') || '').trim();
        const selectApi = themeId && window.WelineWebsiteSelect
            ? window.WelineWebsiteSelect['theme_card_website_' + themeId]
            : null;
        if (selectApi && typeof selectApi.setValue === 'function') {
            const currentValue = typeof selectApi.getValue === 'function'
                ? String(selectApi.getValue() || '')
                : '';
            if (currentValue !== String(scope.website_id)) {
                selectApi.setValue(String(scope.website_id));
            }
        }
    });

    // 预览与编辑同一套网站范围：仅 1 个绑定站 → 直接跳转；多站用当前选中站。
    function openThemeCardEditor(card) {
        ensureThemeCardWebsiteScope(card, true);
        const liveHref = String(card.getAttribute('data-edit-href') || '').trim();
        if (!liveHref) {
            return;
        }
        window.location.href = liveHref;
    }

    function openThemeCardPreview(card) {
        ensureThemeCardWebsiteScope(card, true);
        const previewLink = card.querySelector('.theme-preview-link');
        const href = String(previewLink?.getAttribute('href') || '').trim();
        if (!href) {
            return;
        }
        window.open(href, '_blank', 'noopener');
    }

    document.querySelectorAll('.theme-card .theme-preview-link').forEach(function(link) {
        link.addEventListener('click', function(event) {
            if (event.defaultPrevented || event.button !== 0) {
                return;
            }
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                return;
            }
            const card = link.closest('.theme-card');
            if (!card) {
                return;
            }
            event.preventDefault();
            openThemeCardPreview(card);
        });
    });

    document.querySelectorAll('.theme-card .theme-edit-link').forEach(function(link) {
        link.addEventListener('click', function(event) {
            if (event.defaultPrevented || event.button !== 0) {
                return;
            }
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                return;
            }
            const card = link.closest('.theme-card');
            if (!card) {
                return;
            }
            event.preventDefault();
            openThemeCardEditor(card);
        });
    });

    // 整卡进入编辑：预览图/标题区点击等同「编辑」；预览按钮保持独立并用同一范围解析。
    document.querySelectorAll('.theme-card[data-edit-href]').forEach(function(card) {
        card.addEventListener('click', function(event) {
            if (event.defaultPrevented || event.button !== 0) {
                return;
            }
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                return;
            }
            if (event.target.closest(
                'a, button, input, label, select, textarea, .theme-actions, [data-theme-card-website-select], .weline-website-select, .weline-website-dropdown, [data-theme-preview-nav]'
            )) {
                return;
            }
            openThemeCardEditor(card);
        });

        card.addEventListener('keydown', function(event) {
            if (event.target !== card) {
                return;
            }
            if (event.key !== 'Enter' && event.key !== ' ') {
                return;
            }
            event.preventDefault();
            openThemeCardEditor(card);
        });
    });

    restoreActivePreviewTasks().finally(function() {
        window.setTimeout(autoGenerateMissingPreviews, 300);
    });
})();
</script>
