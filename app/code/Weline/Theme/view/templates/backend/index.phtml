                </div>
                <div class="w-alert" id="aiVirtualThemeStatus" data-w-border="border" data-tone="muted" style="--w-mt:var(--weline-space-4);--w-mb:0;">
                    <w:icon name="info" size="sm"></w:icon>
                    <?= __('AI 会完全参照默认主题全部默认布局源码生成虚拟主题草稿，发布前不会影响前台渲染。') ?>
                </div>
                <div id="aiVirtualThemeResult" style="display: none;"></div>
            </div>
            <div class="w-dialog__footer">
                <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><?= __('取消') ?></button>
                <button type="button" class="w-button" id="createAiVirtualTheme" data-tone="primary">
                    <w:icon name="sparkles" size="sm"></w:icon> <?= __('创建虚拟主题') ?>
                </button>
            </div>
        </div>
    </div>
</div>

