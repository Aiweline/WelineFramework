<div class="w-dialog" id="singleGenerateModal" tabindex="-1" aria-hidden="true" data-w-component="dialog" data-state="closed" hidden>
    <div class="w-dialog__frame">
        <div class="w-dialog__surface theme-preview-modal">
            <div class="w-dialog__header">
                <h5 class="w-dialog__title" id="singleGenerateTitle"><?= __('生成预览图') ?></h5>
                <button type="button" class="w-button" aria-label="Close" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm"></button>
            </div>
            <div class="w-dialog__body">
                <div class="w-stack" id="singlePreviewMark" style="--w-gap:var(--weline-space-3);--w-pt:var(--weline-space-4);--w-pb:var(--weline-space-2);">
                    <div class="w-spinner" role="status" id="singleSpinner" data-tone="primary" data-self="center" hidden>
                        <span class="w-visually-hidden">Loading...</span>
                    </div>
