<?php
/**
 * Unified backend preview content stub.
 *
 * Controller lifecycle observers rewrite this template into themed backend layouts.
 */
$content = $this->getData('content');
if (is_string($content) && $content !== '') {
    echo $content;
    return;
}
// Empty content must stay empty: emitting a stub here becomes meta.content and
// replaces homepage nested slots (hero/featured), wiping amazon-card markup.
return;
