<?php
/**
 * 部件配置表单
 * 
 * @var \Weline\Framework\View\Template $this
 * @var array $widget
 * @var array $params
 */

$widget = $this->getData('widget');
$params = $this->getData('params') ?? [];
$config = $widget['config'] ?? [];

if (!$widget) return;

$widgetName = (string)($widget['meta']['name'] ?? $widget['widget_code'] ?? '');
$widgetDesc = (string)($widget['meta']['description'] ?? '');
$widgetType = (string)($widget['widget_type'] ?? 'content');

// 获取部件图标
$typeIcons = [
    'header' => 'circle',
    'footer' => 'circle',
    'sidebar' => 'circle',
    'banner' => 'image',
    'carousel' => 'circle',
    'product' => 'pin',
    'category' => 'folder',
    'navigation' => 'menu',
    'search' => 'search',
    'social' => 'share',
    'newsletter' => 'mail',
    'content' => 'file',
];
$icon = $typeIcons[$widgetType] ?? 'circle';

$normalizeFileImageNode = static function (mixed $raw): ?array {
    if (is_string($raw)) {
        $trimmed = trim($raw);
        if ($trimmed === '' || $trimmed[0] !== '{') {
            return null;
        }
        $decoded = json_decode($trimmed, true);
        if (!is_array($decoded)) {
            return null;
        }
        $raw = $decoded;
    }
    if (!is_array($raw) || ($raw['type'] ?? null) !== 'file-image' || !is_array($raw['usage'] ?? null)) {
        return null;
    }
    $usage = $raw['usage'];
    if ((int)($usage['version'] ?? 0) !== 1
        || trim((string)($usage['asset_id'] ?? '')) === ''
        || trim((string)($usage['locale_code'] ?? '')) === ''
    ) {
        return null;
    }
    return ['type' => 'file-image', 'usage' => $usage];
};
$serializeFileImage = static function (mixed $raw) use ($normalizeFileImageNode): string {
    $node = $normalizeFileImageNode($raw);
    if ($node !== null) {
        return json_encode(
            $node,
            JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE,
        ) ?: '';
    }
    return is_scalar($raw) || $raw instanceof \Stringable ? trim((string)$raw) : '';
};
$legacyImagePreview = static function (mixed $raw) use ($normalizeFileImageNode): string {
    if ($normalizeFileImageNode($raw) !== null || (!is_scalar($raw) && !$raw instanceof \Stringable)) {
        return '';
    }
    $url = trim(html_entity_decode((string)$raw, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($url === ''
        || strlen($url) > 8192
        || preg_match('/[\x00-\x1F\x7F\\\\]/', $url) === 1
        || str_starts_with($url, '//')
    ) {
        return '';
    }
    if (str_starts_with($url, '/')) {
        return $url;
    }
    $parts = parse_url($url);
    if ($parts === false
        || isset($parts['user'])
        || isset($parts['pass'])
        || (isset($parts['host']) && !isset($parts['scheme']))
    ) {
        return '';
    }
    $scheme = strtolower((string)($parts['scheme'] ?? ''));
    if ($scheme !== '' && (!in_array($scheme, ['http', 'https'], true) || trim((string)($parts['host'] ?? '')) === '')) {
        return '';
    }
    return $url;
};
?>

<div class="config-widget-header">
    <div class="config-widget-icon">
        <w:icon name="icon|circle" size="md"></w:icon>
    </div>
    <div class="config-widget-info">
        <h4><?= htmlspecialchars($widgetName) ?></h4>
        <p><?= htmlspecialchars($widgetDesc) ?></p>
    </div>
</div>

<w:form class="config-form w-param-form" id="widgetConfigForm" data-layout-id="@var($widget['layout_id'] ?? '')">
    <?php if (empty($params)): ?>
        <p class="w-text" data-tone="muted"><?= __('该部件暂无可配置参数') ?></p>
    <?php else: ?>
        <?php foreach ($params as $key => $param): 
            $semanticType = (string)($param['type'] ?? 'string');
            $type = (string)($param['ui_type'] ?? $param['input'] ?? $semanticType);
            $label = (string)($param['label'] ?? $key);
            $default = $param['default'] ?? '';
            $value = $config[$key] ?? $default;
            // 确保 value 是可转换为字符串的类型
            if (is_array($value)) {
                // 保持数组形式
            } elseif (is_bool($value)) {
                // 保持布尔形式
            } else {
                $value = (string)$value;
            }
            $required = (bool)($param['required'] ?? false);
            $description = (string)($param['description'] ?? '');
            $placeholder = (string)($param['placeholder'] ?? '');
            $options = $param['options'] ?? [];
        ?>
            <div class="w-field">
                <label for="config_<?= $key ?>">
                    <?= htmlspecialchars($label) ?>
                    <?php if ($required): ?>
                        <span class="w-text" data-tone="danger">*</span>
                    <?php endif; ?>
                </label>
                
                <?php if ($type === 'string'): ?>
                    <input type="text" class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" value="<?= htmlspecialchars((string)($value ?? '')) ?>" placeholder="<?= htmlspecialchars($placeholder) ?>" <?= $required ? 'required' : '' ?>>
                
                <?php elseif ($type === 'number'): ?>
                    <input type="number" class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" value="<?= htmlspecialchars((string)($value ?? '')) ?>" placeholder="<?= htmlspecialchars($placeholder) ?>" <?= $required ? 'required' : '' ?>>
                
                <?php elseif (in_array($semanticType, ['bool', 'boolean'], true)): ?>
                    <?php
                    $boolValue = ($value === true || $value === 1 || $value === '1' || $value === 'true' || $value === 'on') ? '1' : '0';
                    $boolOptions = !empty($options) ? $options : [
                        '1' => str_starts_with(strtolower((string)$key), 'show') ? __('显示') : __('是'),
                        '0' => str_starts_with(strtolower((string)$key), 'show') ? __('隐藏') : __('否'),
                    ];
                    ?>
                    <select class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" <?= $required ? 'required' : '' ?>>
                        <?php foreach ($boolOptions as $optValue => $optLabel): ?>
                            <option value="<?= htmlspecialchars((string)$optValue) ?>" <?= (string)$boolValue === (string)$optValue ? 'selected' : '' ?>>
                                <?= htmlspecialchars((string)$optLabel) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                <?php elseif ($type === 'select'): ?>
                    <select class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" <?= $required ? 'required' : '' ?>>
                        <option value=""><?= __('-- 请选择 --') ?></option>
                        <?php foreach ($options as $optValue => $optLabel): ?>
                            <option value="<?= htmlspecialchars((string)($optValue ?? '')) ?>" <?= $value == $optValue ? 'selected' : '' ?>>
                                <?= htmlspecialchars((string)($optLabel ?? '')) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                
                <?php elseif ($type === 'url'): ?>
                    <input type="url" class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" value="<?= htmlspecialchars((string)($value ?? '')) ?>" placeholder="<?= htmlspecialchars($placeholder ?: 'https://') ?>" <?= $required ? 'required' : '' ?>>
                
                <?php elseif (in_array($type, ['image', 'image_picker', 'media_image', 'file_image'], true)): ?>
                    <?php
                    $imageNode = $normalizeFileImageNode($value);
                    $imageStoredValue = $serializeFileImage($value);
                    $imagePreviewUrl = $legacyImagePreview($value);
                    $imageHasValue = $imageStoredValue !== '';
                    $imageMediaOptions = is_array($param['media_options'] ?? null) ? $param['media_options'] : [];
                    $imageDefaultDirectory = (string)($imageMediaOptions['default_directory'] ?? $param['default_directory'] ?? 'banner');
                    $imagePlaceholder = $imageNode !== null
                        ? trim((string)($imageNode['usage']['alt'] ?? $imageNode['usage']['asset_id']))
                        : (string)__($imageHasValue ? '旧图片地址仅兼容显示，请从媒体库重新选择' : '从媒体库选择');
                    ?>
                    <div class="w-param-media-image">
                        <div class="w-param-image-preview<?= $imageHasValue ? ' w-param-has-image' : '' ?>" id="config_<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>_preview">
                            <?php if ($imagePreviewUrl !== ''): ?>
                                <img src="<?= htmlspecialchars($imagePreviewUrl, ENT_QUOTES, 'UTF-8') ?>" alt="<?= __('预览') ?>">
                            <?php endif; ?>
                            <div class="w-param-image-placeholder"<?= $imagePreviewUrl !== '' ? ' hidden' : '' ?>><?= htmlspecialchars($imagePlaceholder, ENT_QUOTES, 'UTF-8') ?></div>
                            <div class="w-param-image-actions">
                                <button type="button" class="w-button w-param-image-select w-param-media-image-select" data-target="config_<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>" data-default-dir="<?= htmlspecialchars($imageDefaultDirectory, ENT_QUOTES, 'UTF-8') ?>" data-tone="primary" data-variant="outline" data-size="sm">
                                    <w:icon name="image" size="sm"></w:icon> <?= __('选择') ?>
                                </button>
                                <?php if ($imageHasValue): ?>
                                    <button type="button" class="w-button w-param-image-clear" data-target="config_<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>" data-tone="danger" data-variant="outline" data-size="sm" data-icon-only="true" aria-label="<?= __('清除图片') ?>">×</button>
                                <?php endif; ?>
                            </div>
                        </div>
                        <input type="hidden" id="config_<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>" name="<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>" value="<?= htmlspecialchars($imageStoredValue, ENT_QUOTES, 'UTF-8') ?>" data-preview="config_<?= htmlspecialchars((string)$key, ENT_QUOTES, 'UTF-8') ?>_preview" data-clear-label="<?= __('清除图片') ?>">
                    </div>
                
                <?php elseif ($type === 'color'): ?>
                    <div class="w-field__control">
                        <input type="color" class="w-input w-theme-editor-color-input w-theme-editor-color-swatch" id="config_<?= $key ?>_picker" value="<?= htmlspecialchars((string)($value ?? '#000000')) ?>">
                        <input type="text" class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" value="<?= htmlspecialchars((string)($value ?? '')) ?>" placeholder="#000000">
                    </div>
                
                <?php elseif ($type === 'textarea'): ?>
                    <textarea class="w-textarea" id="config_<?= $key ?>" name="<?= $key ?>" rows="4" placeholder="<?= htmlspecialchars($placeholder) ?>" <?= $required ? 'required' : '' ?>><?= htmlspecialchars((string)($value ?? '')) ?></textarea>
                
                <?php elseif ($type === 'array'): ?>
                    <textarea class="w-textarea" id="config_<?= $key ?>" name="<?= $key ?>" rows="4" placeholder="<?= __('JSON格式数组') ?>" <?= $required ? 'required' : '' ?>><?= is_array($value) ? json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) : htmlspecialchars((string)($value ?? '')) ?></textarea>
                    <small class="w-field__hint"><?= __('请使用JSON格式输入') ?></small>
                
                <?php else: ?>
                    <input type="text" class="w-input" id="config_<?= $key ?>" name="<?= $key ?>" value="<?= htmlspecialchars((string)($value ?? '')) ?>" <?= $required ? 'required' : '' ?>>
                <?php endif; ?>
                
                <?php if ($description): ?>
                    <small class="w-field__hint"><?= htmlspecialchars($description) ?></small>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    <?php endif; ?>
</w:form>
