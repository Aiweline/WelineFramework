<?php
/**
 * 预览区域中的部件项
 * 
 * @var \Weline\Framework\View\Template $this
 * @var array $widget
 */

$widget = $this->getData('widget');
if (!$widget) return;

$layoutId = (string)($widget['layout_id'] ?? '');
$slotId = (string)($widget['slot_id'] ?? '');
if ($slotId === '') {
    $slotId = (string)($widget['area'] ?? '');
}
$widgetCode = (string)($widget['widget_code'] ?? '');
$widgetModule = (string)($widget['widget_module'] ?? '');
$widgetType = (string)($widget['widget_type'] ?? '');
$config = $widget['config'] ?? [];
$meta = $widget['meta'] ?? [];
$widgetName = (string)($meta['name'] ?? $widgetCode ?: '');
$widgetDesc = (string)($meta['description'] ?? '');
$jsonForAttributeFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;

// 获取部件图标
$typeIcons = [
    'header' => 'circle',
    'footer' => 'circle',
    'sidebar' => 'circle',
    'banner' => 'image',
    'carousel' => 'circle',
    'product' => 'pin',
    'category' => 'folder',
    'navigation' => 'menu',
    'search' => 'search',
    'social' => 'share',
    'newsletter' => 'mail',
    'content' => 'file',
];
$icon = $typeIcons[$widgetType] ?? 'circle';
?>

<div class="preview-widget-item" 
     data-layout-id="<?= htmlspecialchars($layoutId) ?>"
     data-slot-id="<?= htmlspecialchars($slotId) ?>"
     data-widget-code="<?= htmlspecialchars($widgetCode) ?>"
     data-widget-module="<?= htmlspecialchars($widgetModule) ?>"
     data-widget-type="<?= htmlspecialchars($widgetType) ?>"
     data-config='<?= htmlspecialchars(json_encode($config, $jsonForAttributeFlags) ?: '{}', ENT_QUOTES, 'UTF-8') ?>'>
    
    <div class="widget-header">
        <span class="widget-name">
            <i class="<?= $icon ?>"></i>
            <?= htmlspecialchars($widgetName) ?>
        </span>
        <div class="widget-actions">
            <button type="button" class="w-button btn-edit-widget" title="@lang{编辑}" data-tone="primary" data-variant="outline" data-size="sm">
                <w:icon name="edit" size="sm"></w:icon>
            </button>
            <button type="button" class="w-button btn-delete-widget" title="@lang{删除}" data-tone="danger" data-variant="outline" data-size="sm">
                <w:icon name="trash" size="sm"></w:icon>
            </button>
        </div>
    </div>
    
    <div class="widget-preview">
        <?php if (!empty($meta['template'])): ?>
            <span class="w-text" data-tone="muted"><?= htmlspecialchars($widgetDesc ?: __('点击配置此部件')) ?></span>
        <?php else: ?>
            <span class="w-text" data-tone="warning"><?= __('无模板') ?></span>
        <?php endif; ?>
    </div>
</div>
