<?php
/**
 * 预览区域中的部件项
 * 
 * @var \Weline\Framework\View\Template $this
 * @var array $widget
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Service\Ui\IconRegistry;

$widget = $this->getData('widget');
$widget = is_array($widget) ? $widget : [];
if ($widget === []) {
    return;
}
$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$layoutId = (string)($widget['layout_id'] ?? '');
$slotId = (string)($widget['slot_id'] ?? '');
if ($slotId === '') {
    $slotId = (string)($widget['area'] ?? '');
}
$widgetCode = (string)($widget['widget_code'] ?? '');
$widgetModule = (string)($widget['widget_module'] ?? '');
$widgetType = (string)($widget['widget_type'] ?? '');
$config = is_array($widget['config'] ?? null) ? $widget['config'] : [];
$meta = is_array($widget['meta'] ?? null) ? $widget['meta'] : [];
$widgetName = (string)($meta['name'] ?? ($widgetCode ?: ''));
$widgetDesc = (string)($meta['description'] ?? '');
$jsonForAttributeFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;

// 获取部件图标
$typeIcons = [
    'header' => 'circle',
    'footer' => 'circle',
    'sidebar' => 'circle',
    'banner' => 'image',
    'carousel' => 'circle',
    'product' => 'pin',
    'category' => 'folder',
    'navigation' => 'menu',
    'search' => 'search',
    'social' => 'share',
    'newsletter' => 'mail',
    'content' => 'file',
];
$icon = $typeIcons[$widgetType] ?? 'circle';
$iconHtml = ObjectManager::getInstance(IconRegistry::class)->render($icon, 'sm');
$layoutIdSafe = $escape($layoutId);
$slotIdSafe = $escape($slotId);
$widgetCodeSafe = $escape($widgetCode);
$widgetModuleSafe = $escape($widgetModule);
$widgetTypeSafe = $escape($widgetType);
$configJsonSafe = $escape(json_encode($config, $jsonForAttributeFlags) ?: '{}');
$widgetNameSafe = $escape($widgetName);
$previewText = !empty($meta['template'])
    ? $escape($widgetDesc !== '' ? $widgetDesc : __('点击配置此部件'))
    : $escape(__('无模板'));
$previewTone = !empty($meta['template']) ? 'muted' : 'warning';
?>

<div class="preview-widget-item" 
     data-layout-id="<?= $layoutIdSafe ?>"
     data-slot-id="<?= $slotIdSafe ?>"
     data-widget-code="<?= $widgetCodeSafe ?>"
     data-widget-module="<?= $widgetModuleSafe ?>"
     data-widget-type="<?= $widgetTypeSafe ?>"
     data-config='<?= $configJsonSafe ?>'>
    
    <div class="widget-header">
        <span class="widget-name">
            <?php echo $iconHtml; ?>
            <?= $widgetNameSafe ?>
        </span>
        <div class="widget-actions">
            <button type="button" class="w-button w-theme-editor-edit-widget" title="@lang{编辑}" data-tone="primary" data-variant="outline" data-size="sm">
                <w:icon name="edit" size="sm"></w:icon>
            </button>
            <button type="button" class="w-button w-theme-editor-delete-widget" title="@lang{删除}" data-tone="danger" data-variant="outline" data-size="sm">
                <w:icon name="trash" size="sm"></w:icon>
            </button>
        </div>
    </div>
    
    <div class="widget-preview">
        <span class="w-text" data-tone="<?= $previewTone ?>"><?= $previewText ?></span>
    </div>
</div>
