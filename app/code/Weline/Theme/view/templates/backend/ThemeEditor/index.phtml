        <button type="button" class="w-button" data-w-action="dialog.close" data-w-close
                data-tone="quiet" data-size="sm" aria-label="@lang{关闭}"><w:icon name="close" size="sm"></w:icon></button>
    </header>
    <div class="w-dialog__body w-theme-editor-dialog__body">
        <p class="w-theme-editor-reset-draft__hint">@lang{仅清理当前主题、当前作用域与当前编辑草稿上的物化配置，不会删除版本历史或已发布内容。}</p>
        <fieldset class="w-theme-editor-reset-draft__resources">
            <legend>@lang{资源类型}</legend>
            <label><input type="checkbox" name="reset_resource" value="layout" checked> @lang{布局信息}</label>
            <label><input type="checkbox" name="reset_resource" value="meta" checked> @lang{部件元数据}</label>
            <label><input type="checkbox" name="reset_resource" value="appearance" checked> @lang{外观盘}</label>
            <label><input type="checkbox" name="reset_resource" value="theme_binding"> @lang{主题绑定}</label>
            <label><input type="checkbox" name="reset_resource" value="i18n"> @lang{翻译信息}</label>
        </fieldset>
        <fieldset class="w-theme-editor-reset-draft__layout-scope">
            <legend>@lang{布局范围}</legend>
            <label><input type="radio" name="reset_layout_scope" value="current_layout" checked> @lang{仅当前页面类型}</label>
            <label><input type="radio" name="reset_layout_scope" value="all_layouts"> @lang{当前主题与作用域下全部页面类型草稿}</label>
        </fieldset>
        <details class="w-theme-editor-reset-draft__danger">
            <summary>@lang{高危：重置所有}</summary>
            <p class="w-theme-editor-reset-draft__danger-hint">@lang{将勾选当前范围内全部资源类型（含翻译与主题绑定）并清空当前编辑草稿物化。仍不会删除版本历史。}</p>
            <button type="button" class="w-button" data-tone="danger" data-variant="solid" data-size="sm" id="btnResetDraftAllResources">@lang{重置所有}</button>
        </details>
        <details class="w-theme-editor-reset-draft__factory">
            <summary>@lang{完全初始化（不可恢复）}</summary>
            <p class="w-theme-editor-reset-draft__factory-hint">@lang{清空 Theme 模块全部数据库表、theme meta 与 theme 元数据字典，并重装默认主题。请输入 RESET 确认。}</p>
            <label class="w-theme-editor-reset-draft__factory-confirm">
                <span>@lang{确认词}</span>
                <input type="text" id="themeEditorFactoryResetConfirm" autocomplete="off" placeholder="RESET">
            </label>
            <button type="button" class="w-button" data-tone="danger" data-variant="solid" data-size="sm" id="btnFactoryResetConfirm">@lang{完全初始化}</button>
        </details>
    </div>
    <footer class="w-dialog__footer">
        <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm" id="btnResetDraftCancel" data-w-action="dialog.close">@lang{取消}</button>
        <button type="button" class="w-button" data-tone="warning" data-variant="solid" data-size="sm" id="btnResetDraftConfirm">@lang{确认重置}</button>
    </footer>
</dialog>

<!-- 部件配置对话框：业务表单与保存流程不变，仅切换为 Weline UI 壳。 -->
<dialog class="w-dialog w-theme-editor-dialog" id="widgetConfigModal"
