<!-- 组件预览对话框：完整保留 PC / iPad / Mobile / 响应式四种视口。 -->
<dialog class="w-dialog w-theme-editor-dialog w-theme-editor-preview-dialog" id="componentPreviewModal"
        aria-labelledby="componentPreviewModalLabel" data-w-component="dialog" data-state="closed"
        data-size="lg" data-w-closable="true" data-w-backdrop="dismissible">
    <header class="w-dialog__header">
        <h2 class="w-dialog__title" id="componentPreviewModalLabel">
            <w:icon name="device-mobile" size="sm"></w:icon>
            <span id="componentPreviewModalTitle">@lang{组件预览}</span>
        </h2>
        <button type="button" class="w-button" data-w-action="dialog.close" data-w-close
                data-tone="quiet" data-size="sm" aria-label="@lang{关闭}"><w:icon name="close" size="sm"></w:icon></button>
    </header>
    <div class="w-dialog__body w-theme-editor-preview-dialog__body">
        <div class="w-tabs" id="componentPreviewTabs" data-w-component="tabs">
            <div class="w-tabs__list" role="tablist" aria-label="@lang{预览设备}">
                <button class="w-tabs__tab" id="tab-pc" type="button" role="tab"
                        aria-controls="panel-pc" aria-selected="true">PC (1200px)</button>
                <button class="w-tabs__tab" id="tab-ipad" type="button" role="tab"
                        aria-controls="panel-ipad" aria-selected="false">iPad (768px)</button>
                <button class="w-tabs__tab" id="tab-mobile" type="button" role="tab"
                        aria-controls="panel-mobile" aria-selected="false">Mobile (375px)</button>
                <button class="w-tabs__tab" id="tab-responsive" type="button" role="tab"
                        aria-controls="panel-responsive" aria-selected="false">@lang{响应式}</button>
            </div>
            <div class="w-tabs__content" id="componentPreviewTabContent">
                <div class="w-tabs__panel" id="panel-pc" role="tabpanel" aria-labelledby="tab-pc">
                    <div class="component-preview-viewport component-preview-viewport-pc" data-width="1200">
                        <div class="component-preview-inner"></div>
                    </div>
                </div>
                <div class="w-tabs__panel" id="panel-ipad" role="tabpanel" aria-labelledby="tab-ipad" hidden>
                    <div class="component-preview-viewport component-preview-viewport-ipad" data-width="768">
                        <div class="component-preview-inner"></div>
                    </div>
                </div>
                <div class="w-tabs__panel" id="panel-mobile" role="tabpanel" aria-labelledby="tab-mobile" hidden>
                    <div class="component-preview-viewport component-preview-viewport-mobile" data-width="375">
                        <div class="component-preview-inner"></div>
                    </div>
                </div>
                <div class="w-tabs__panel" id="panel-responsive" role="tabpanel" aria-labelledby="tab-responsive" hidden>
                    <div class="component-preview-responsive-wrap">
                        <label class="w-field w-theme-editor-responsive-field">
                            <span class="w-field__label">@lang{宽度}</span>
                            <input type="range" class="w-range" id="componentPreviewResponsiveWidth" min="320" max="1200" value="768">
                            <output id="componentPreviewResponsiveWidthLabel" for="componentPreviewResponsiveWidth">768px</output>
                        </label>
                        <div class="component-preview-viewport component-preview-viewport-responsive" id="componentPreviewViewportResponsive">
                            <div class="component-preview-inner"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="w-theme-editor-loading" id="componentPreviewLoading" role="status">
            <span class="w-spinner" aria-hidden="true"></span>
            <span>@lang{加载预览...}</span>
        </div>
    </div>
</dialog>

