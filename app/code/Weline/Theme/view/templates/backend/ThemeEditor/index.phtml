<?php
/**
 * 主题可视化编辑器
 *
 * @var \Weline\Framework\View\Template $this
 * @var int $theme_id
 * @var string $page_type
 */

$theme_id = (int)($this->getData('theme_id') ?: 0);
$page_type = $this->getData('page_type') ?: 'homepage';
$layout_option = (string)($this->getData('layout_option') ?: 'default');
$layout_options_by_type = $this->getData('layout_options_by_type') ?: [];
$installed_locales = $this->getData('installed_locales') ?: [];
$installed_locales = is_array($installed_locales) ? $installed_locales : [];
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;
$layout_options_json = json_encode($layout_options_by_type, $jsonForScriptFlags) ?: '{}';
$installed_locales_json = json_encode($installed_locales, $jsonForScriptFlags) ?: '[]';
$editor_user_id = max(0, (int)($this->getData('editor_user_id') ?: 0));
$editor_area = $this->getData('editor_area') ?: 'frontend';
$theme_has_backend = (bool)$this->getData('theme_has_backend');
$preview_context = $this->getData('preview_context') ?: [];
$preview_status = is_array($preview_context) ? (string)($preview_context['status'] ?? 'draft') : 'draft';
$layout_editor_lock = $this->getData('layout_editor_lock') ?: ['enabled' => false];
$layout_editor_lock = is_array($layout_editor_lock) ? $layout_editor_lock : ['enabled' => false];
$layout_editor_locked = !empty($layout_editor_lock['enabled']);
$layout_lock_source = strtolower(trim((string)($layout_editor_lock['lock_source'] ?? '')));
$scope_legacy_readonly = (bool)$this->getData('scope_legacy_readonly');
$editorShellClasses = ['theme-editor-container'];
if ($layout_editor_locked) {
    $editorShellClasses[] = 'theme-editor-locked';
}
if ($layout_lock_source === 'cms') {
    $editorShellClasses[] = 'theme-editor-cms-embed';
}
if (!empty($layout_editor_lock['product_layout_mode']) || !empty($layout_editor_lock['hide_chrome_editing']) || $layout_lock_source === 'product') {
    $editorShellClasses[] = 'theme-editor-product-layout';
    $editorShellClasses[] = 'theme-editor-hide-chrome';
}
if ($scope_legacy_readonly) {
    $editorShellClasses[] = 'theme-editor-scope-readonly';
}
$layout_editor_lock_json = json_encode($layout_editor_lock, $jsonForScriptFlags) ?: '{"enabled":false}';
$layout_identity = $this->getData('layout_identity') ?: [];
$layout_identity = is_array($layout_identity) ? $layout_identity : [];
$layout_identity_scope = (string)($layout_identity['scope'] ?? ($preview_context['scope'] ?? $this->request->getParam('scope', 'default')));
$selected_scope = trim((string)$this->getData('selected_scope'));
if ($selected_scope !== '') {
    $layout_identity_scope = $selected_scope;
}
$layout_identity_target_type = (string)($layout_identity['target_type'] ?? (
    $preview_context['theme_layout_target_type']
    ?? $this->request->getParam('theme_layout_target_type', $this->request->getParam('target_type', 'global'))
));
$layout_identity_target_id = max(0, (int)($layout_identity['target_id'] ?? (
    $preview_context['theme_layout_target_id']
    ?? $this->request->getParam('theme_layout_target_id', $this->request->getParam('target_id', 0))
)));
$layout_identity_locale = (string)($layout_identity['locale_code'] ?? (
    $preview_context['locale'] ?? $this->request->getParam('locale_code', $this->request->getParam('locale', ''))
));
$frontend_theme_id = (int)($this->getData('frontend_theme_id') ?: ($editor_area === 'frontend' ? $theme_id : 0));
$backend_theme_id = (int)($this->getData('backend_theme_id') ?: ($editor_area === 'backend' ? $theme_id : 0));
$default_locale = \Weline\Framework\App\Env::default_LANGUAGE_CODE;
$previewParams = [
    'theme_id' => $theme_id,
    'page_type' => $page_type,
    'layout_type' => $page_type,
    'layout_option' => $layout_option,
    'editor_mode' => '1',
    'preview_mode' => 'live',
    'status' => $preview_status,
    'editor_area' => $editor_area,
    'preview_area' => $editor_area,
    'frontend_theme_id' => $frontend_theme_id,
    'backend_theme_id' => $backend_theme_id,
    'locale' => $layout_identity_locale !== '' ? $layout_identity_locale : (string)$this->request->getParam('locale', $default_locale),
    'locale_code' => $layout_identity_locale !== '' ? $layout_identity_locale : (string)$this->request->getParam('locale', $default_locale),
    '_t' => time(),
];
$previewTargetIsConcrete = static function (string $targetType, int $targetId): bool {
    return $targetType !== ''
        && $targetType !== 'global'
        && ($targetId > 0 || $targetType === 'website');
};
if ($layout_editor_locked) {
    $previewParams['scope'] = (string)($layout_editor_lock['scope'] ?? ($preview_context['scope'] ?? 'default'));
    $previewParams['store_mode'] = (string)($layout_editor_lock['store_mode'] ?? 'normal');
    $previewParams['website_id'] = (int)($layout_editor_lock['website_id'] ?? 0);
    $previewParams['website_code'] = (string)($layout_editor_lock['website_code'] ?? '');
    $previewParams['store_id'] = (int)($layout_editor_lock['store_id'] ?? 0);
    $previewParams['store_code'] = (string)($layout_editor_lock['store_code'] ?? '');
    $previewTargetType = trim((string)($layout_editor_lock['target_type'] ?? ''));
    $previewTargetId = (int)($layout_editor_lock['target_id'] ?? 0);
    if ($previewTargetIsConcrete($previewTargetType, $previewTargetId)) {
        $previewParams['target_type'] = $previewTargetType;
        $previewParams['target_id'] = $previewTargetId;
        $previewParams['theme_layout_target_type'] = $previewTargetType;
        $previewParams['theme_layout_target_id'] = $previewTargetId;
        $previewParams['theme_layout_source_target_type'] = $previewTargetType;
        $previewParams['theme_layout_source_target_id'] = $previewTargetId;
    }
} else {
    $previewScope = trim((string)($preview_context['scope'] ?? $this->request->getParam('scope', '')));
    if ($previewScope !== '') {
        $previewParams['scope'] = $previewScope;
    }
    $previewTargetType = trim((string)(
        $preview_context['theme_layout_target_type']
        ?? $this->request->getParam('theme_layout_target_type', '')
    ));
    $previewTargetId = (int)(
        $preview_context['theme_layout_target_id']
        ?? $this->request->getParam('theme_layout_target_id', 0)
    );
    if ($previewTargetIsConcrete($previewTargetType, $previewTargetId)) {
        $previewParams['target_type'] = $previewTargetType;
        $previewParams['target_id'] = $previewTargetId;
        $previewParams['theme_layout_target_type'] = $previewTargetType;
        $previewParams['theme_layout_target_id'] = $previewTargetId;
        $previewParams['theme_layout_source_target_type'] = trim((string)(
            $preview_context['theme_layout_source_target_type']
            ?? $this->request->getParam('theme_layout_source_target_type', $previewTargetType)
        ));
        $previewParams['theme_layout_source_target_id'] = (int)(
            $preview_context['theme_layout_source_target_id']
            ?? $this->request->getParam('theme_layout_source_target_id', $previewTargetId)
        );
    }
}
$initialPreviewToken = trim((string)($this->getData('initial_preview_token') ?: ''));
$initialPreviewPath = '';
$initialPreviewArea = '';
// Always start blank: a server-rendered content URL without typed editor_context
// races the JS authorized preview and can hang a worker until the browser aborts it.
$initialPreviewUrl = 'about:blank';
if ($theme_id) {
    if ($editor_area === 'frontend') {
        $initialPreviewPath = 'theme/frontend/theme-preview/content';
        $initialPreviewArea = 'frontend';
    } else {
        $initialPreviewPath = 'theme/backend/theme-editor/layout-preview';
        $initialPreviewArea = 'backend';
    }
}
$initialPreviewUrlSafe = htmlspecialchars($initialPreviewUrl, ENT_QUOTES, 'UTF-8');

// Theme 动态图片必须由 MediaManager 返回 file-image/ImageUsage。
// 旧文件管理器只能返回路径或 URL，允许它参与新选择会把裸 URL
// 再次写入布局，并绕过 FileAsset 的翻译、权限与 URL Adapter。
$fileManagerConnectorPath = 'media/backend/manager/iframe';

$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$editorShellClassSafe = $escape(implode(' ', $editorShellClasses));
$themeIdSafe = (string)$theme_id;
$editorAreaSafe = $escape($editor_area);
$previewStatusSafe = $escape($preview_status);
$themeHasBackendSafe = $theme_has_backend ? '1' : '0';
$pageTypeSafe = $escape($page_type);
$layoutOptionSafe = $escape($layout_option);
$layoutIdentityScopeSafe = $escape($layout_identity_scope);
$layoutIdentityTargetTypeSafe = $escape($layout_identity_target_type);
$layoutIdentityTargetIdSafe = (string)$layout_identity_target_id;
$layoutIdentityLocaleSafe = $escape($layout_identity_locale);
$defaultLocaleSafe = $escape($default_locale);
$layoutOptionsJsonSafe = $escape($layout_options_json);
$installedLocalesJsonSafe = $escape($installed_locales_json);
$layoutLockEnabledSafe = $layout_editor_locked ? '1' : '0';
$layoutLockSourceSafe = $escape($layout_lock_source);
$layoutEditorLockJsonSafe = $escape($layout_editor_lock_json);
$editorUserIdSafe = (string)$editor_user_id;
$selectorDisabledAttribute = ($layout_editor_locked || $scope_legacy_readonly) ? ' disabled' : '';
$editorAreaHiddenAttribute = $theme_has_backend ? '' : ' hidden';
$initialPreviewTokenSafe = $escape($initialPreviewToken);
$themeOptionsHtml = (string)$this->getData('theme_options_html');
$scopeIdentity = $this->getData('scope_identity');
$scopeIdentity = is_array($scopeIdentity) ? $scopeIdentity : [];
$scope_identity_json = json_encode($scopeIdentity, $jsonForScriptFlags) ?: '{}';
$scope_identity_json_safe = $escape($scope_identity_json);
$scope_control_disabled = $layout_editor_locked || $scope_legacy_readonly;
$scopeLegacyReadonlySafe = $scope_legacy_readonly ? '1' : '0';
$scopeLegacyValueSafe = $escape($selected_scope);
$scopeLegacyAlertHiddenAttribute = $scope_legacy_readonly ? '' : ' hidden';
$pageTypeOptionsHtml = (string)$this->getData('page_type_options_html');
$layoutOptionsHtml = (string)$this->getData('layout_options_html');
$editorAreaOptionsHtml = (string)$this->getData('editor_area_options_html');
$localeOptionsHtml = (string)$this->getData('locale_options_html');
$widgetLibraryHtml = (string)$this->getData('widget_library_html');
$structureWidgetsHtml = $this->getData('structure_widgets_html');
$structureWidgetsHtml = is_array($structureWidgetsHtml) ? $structureWidgetsHtml : [];
$headerStructureHtml = (string)($structureWidgetsHtml['header'] ?? '');
$contentStructureHtml = (string)($structureWidgetsHtml['content'] ?? '');
$footerStructureHtml = (string)($structureWidgetsHtml['footer'] ?? '');

?>
