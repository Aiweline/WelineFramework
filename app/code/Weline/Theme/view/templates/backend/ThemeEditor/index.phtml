<?php
/**
 * Weline UI 2.0 theme workbench.
 *
 * @var \Weline\Framework\View\Template $this
 */

$themeId = max(0, (int)($this->getData('theme_id') ?: 0));
$themes = is_array($this->getData('themes')) ? $this->getData('themes') : [];
$pageType = (string)($this->getData('page_type') ?: 'homepage');
$pageTypes = is_array($this->getData('page_types')) ? $this->getData('page_types') : [];
$layoutOption = (string)($this->getData('layout_option') ?: 'default');
$layoutOptionsByType = is_array($this->getData('layout_options_by_type'))
    ? $this->getData('layout_options_by_type')
    : [];
$currentLayoutOptions = is_array($layoutOptionsByType[$pageType] ?? null)
    ? $layoutOptionsByType[$pageType]
    : [];
if ($currentLayoutOptions === []) {
    $currentLayoutOptions[] = [
        'value' => $layoutOption,
        'label' => $layoutOption === 'default' ? (string)__('默认') : $layoutOption,
    ];
}
$installedLocales = is_array($this->getData('installed_locales'))
    ? $this->getData('installed_locales')
    : [];
$editorArea = (string)($this->getData('editor_area') ?: 'frontend');
$editorArea = $editorArea === 'backend' ? 'backend' : 'frontend';
$themeHasBackend = (bool)$this->getData('theme_has_backend');
$previewContext = is_array($this->getData('preview_context')) ? $this->getData('preview_context') : [];
$previewStatus = (string)($previewContext['status'] ?? 'draft');
$layoutLock = is_array($this->getData('layout_editor_lock'))
    ? $this->getData('layout_editor_lock')
    : ['enabled' => false];
$editorLocked = !empty($layoutLock['enabled']);
$layoutIdentity = is_array($this->getData('layout_identity')) ? $this->getData('layout_identity') : [];
$scope = (string)($layoutIdentity['scope'] ?? $previewContext['scope'] ?? 'default');
$targetType = (string)($layoutIdentity['target_type'] ?? 'global');
$targetId = max(0, (int)($layoutIdentity['target_id'] ?? 0));
$frontendThemeId = max(0, (int)($this->getData('frontend_theme_id') ?: ($editorArea === 'frontend' ? $themeId : 0)));
$backendThemeId = max(0, (int)($this->getData('backend_theme_id') ?: ($editorArea === 'backend' ? $themeId : 0)));
$defaultLocale = \Weline\Framework\App\Env::default_LANGUAGE_CODE;
$selectedLocale = trim((string)$this->request->getParam('locale', ''));
$jsonFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_INVALID_UTF8_SUBSTITUTE;
$layoutOptionsJson = json_encode($layoutOptionsByType, $jsonFlags) ?: '{}';

$previewParams = [
    'theme_id' => $themeId,
    'frontend_theme_id' => $frontendThemeId,
    'backend_theme_id' => $backendThemeId,
    'page_type' => $pageType,
    'layout_type' => $pageType,
    'layout_option' => $layoutOption,
    'editor_area' => $editorArea,
    'preview_area' => $editorArea,
    'preview_mode' => 'live',
    'editor_mode' => '1',
    'status' => $previewStatus,
    'scope' => $scope,
    'target_type' => $targetType,
    'target_id' => $targetId,
    'locale' => $selectedLocale !== '' ? $selectedLocale : $defaultLocale,
];
$previewUrl = 'about:blank';
if ($themeId > 0) {
    $previewUrl = $editorArea === 'backend'
        ? $this->getUrl('theme/backend/theme-editor/layout-preview', $previewParams)
        : $this->getFrontendUrl('theme/frontend/theme-preview/content', $previewParams);
}
$safe = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-theme-editor.css)">

<section
    id="w-theme-editor"
    class="w-theme-editor"
    data-w-component="theme-editor"
    data-theme-id="<?= $themeId ?>"
    data-frontend-theme-id="<?= $frontendThemeId ?>"
    data-backend-theme-id="<?= $backendThemeId ?>"
    data-editor-area="<?= $safe($editorArea) ?>"
    data-page-type="<?= $safe($pageType) ?>"
    data-layout-option="<?= $safe($layoutOption) ?>"
    data-layout-options="<?= $safe($layoutOptionsJson) ?>"
    data-preview-status="<?= $safe($previewStatus) ?>"
    data-preview-url="<?= $safe($previewUrl) ?>"
    data-scope="<?= $safe($scope) ?>"
    data-target-type="<?= $safe($targetType) ?>"
    data-target-id="<?= $targetId ?>"
    data-editor-locked="<?= $editorLocked ? 'true' : 'false' ?>"
    data-api-widgets="<?= $safe($this->getUrl('theme/backend/theme-editor/widgets')) ?>"
    data-api-publish="<?= $safe($this->getUrl('theme/backend/theme-editor/publish')) ?>"
    data-api-versions="<?= $safe($this->getUrl('theme/backend/theme-editor/versions')) ?>"
    data-api-save-version="<?= $safe($this->getUrl('theme/backend/theme-editor/save-version')) ?>"
>
    <header class="w-theme-editor__toolbar">
        <div class="w-theme-editor__heading">
            <a class="w-button" data-tone="quiet" data-size="sm" href="<?= $safe($this->getBackendUrl('theme/backend/index')) ?>">
                <w:icon name="arrow-left" size="sm" />
                <span><?= $safe(__('主题列表')) ?></span>
            </a>
            <div>
                <h1><?= $safe(__('主题编辑器')) ?></h1>
                <p><?= $safe(__('使用当前主题与布局上下文预览、检查并发布页面。')) ?></p>
            </div>
        </div>

        <div class="w-theme-editor__actions">
            <button type="button" class="w-button" data-tone="neutral" data-size="sm" data-w-editor-action="refresh-preview">
                <w:icon name="refresh" size="sm" />
                <span><?= $safe(__('刷新预览')) ?></span>
            </button>
            <button type="button" class="w-button" data-tone="neutral" data-size="sm" data-w-editor-action="open-preview">
                <w:icon name="external-link" size="sm" />
                <span><?= $safe(__('新窗口预览')) ?></span>
            </button>
            <button type="button" class="w-button" data-tone="neutral" data-size="sm" data-w-editor-action="versions">
                <w:icon name="history" size="sm" />
                <span><?= $safe(__('版本')) ?></span>
            </button>
            <button type="button" class="w-button" data-size="sm" data-w-editor-action="publish" <?= $themeId < 1 || $editorLocked ? 'disabled' : '' ?>>
                <w:icon name="upload" size="sm" />
                <span><?= $safe(__('发布')) ?></span>
            </button>
        </div>
    </header>

    <?php if ($editorLocked): ?>
        <div class="w-alert" data-tone="info" role="status">
            <w:icon name="lock" />
            <div>
                <strong><?= $safe(__('当前布局由上游上下文锁定')) ?></strong>
                <p><?= $safe(__('可浏览预览与版本；需要在拥有该布局的入口中进行变更。')) ?></p>
            </div>
        </div>
    <?php endif; ?>

    <form class="w-theme-editor__selectors" data-w-editor-selectors>
        <label class="w-field">
            <span class="w-field__label"><?= $safe(__('主题')) ?></span>
            <select class="w-select" name="theme_id" data-w-editor-select="theme_id" <?= $editorLocked ? 'disabled' : '' ?>>
                <option value=""><?= $safe(__('-- 选择主题 --')) ?></option>
                <?php foreach ($themes as $theme): ?>
                    <?php
                    $candidateId = (int)(is_array($theme) ? ($theme['id'] ?? 0) : (is_object($theme) ? $theme->getId() : 0));
                    $candidateName = (string)(is_array($theme)
                        ? ($theme['name'] ?? '')
                        : (is_object($theme) && method_exists($theme, 'getName') ? $theme->getName() : ''));
                    $active = (bool)(is_array($theme)
                        ? ($theme['is_active'] ?? false)
                        : (is_object($theme) && method_exists($theme, 'getIsActive') ? $theme->getIsActive() : false));
                    ?>
                    <option value="<?= $candidateId ?>" <?= $candidateId === $themeId ? 'selected' : '' ?>><?= $safe($candidateName . ($active ? ' · ' . __('已启用') : '')) ?></option>
                <?php endforeach; ?>
            </select>
        </label>

        <label class="w-field">
            <span class="w-field__label"><?= $safe(__('布局类型')) ?></span>
            <select class="w-select" name="page_type" data-w-editor-select="page_type" <?= $editorLocked ? 'disabled' : '' ?>>
                <?php foreach ($pageTypes as $code => $label): ?>
                    <option value="<?= $safe($code) ?>" <?= (string)$code === $pageType ? 'selected' : '' ?>><?= $safe($label) ?></option>
                <?php endforeach; ?>
            </select>
        </label>

        <label class="w-field">
            <span class="w-field__label"><?= $safe(__('布局选项')) ?></span>
            <select class="w-select" name="layout_option" data-w-editor-select="layout_option" <?= $editorLocked ? 'disabled' : '' ?>>
                <?php foreach ($currentLayoutOptions as $option): ?>
                    <?php $value = (string)($option['value'] ?? 'default'); ?>
                    <option value="<?= $safe($value) ?>" <?= $value === $layoutOption ? 'selected' : '' ?>><?= $safe($option['label'] ?? $value) ?></option>
                <?php endforeach; ?>
            </select>
        </label>

        <label class="w-field" <?= !$themeHasBackend ? 'hidden' : '' ?>>
            <span class="w-field__label"><?= $safe(__('区域')) ?></span>
            <select class="w-select" name="editor_area" data-w-editor-select="editor_area" <?= $editorLocked ? 'disabled' : '' ?>>
                <option value="frontend" <?= $editorArea === 'frontend' ? 'selected' : '' ?>><?= $safe(__('前台')) ?></option>
                <option value="backend" <?= $editorArea === 'backend' ? 'selected' : '' ?>><?= $safe(__('后台')) ?></option>
            </select>
        </label>

        <label class="w-field">
            <span class="w-field__label"><?= $safe(__('语言')) ?></span>
            <select class="w-select" name="locale" data-w-editor-select="locale">
                <option value=""><?= $safe(__('默认语言')) ?></option>
                <?php foreach ($installedLocales as $locale): ?>
                    <?php
                    $localeData = is_object($locale)
                        ? (method_exists($locale, 'getData') ? (array)$locale->getData() : get_object_vars($locale))
                        : (is_array($locale) ? $locale : []);
                    $localeCode = trim((string)($localeData['code'] ?? ''));
                    if ($localeCode === '') continue;
                    $localeName = trim((string)($localeData['name'] ?? $localeCode));
                    ?>
                    <option value="<?= $safe($localeCode) ?>" <?= $localeCode === $selectedLocale ? 'selected' : '' ?>><?= $safe($localeCode . ($localeName !== $localeCode ? ' · ' . $localeName : '')) ?></option>
                <?php endforeach; ?>
            </select>
        </label>
    </form>

    <div class="w-theme-editor__workspace">
        <aside class="w-card w-theme-editor__library" aria-labelledby="w-theme-editor-library-title">
            <div class="w-card__header">
                <div>
                    <h2 id="w-theme-editor-library-title" class="w-card__title"><?= $safe(__('部件目录')) ?></h2>
                    <p><?= $safe(__('按当前区域和布局显示可用部件。')) ?></p>
                </div>
                <span class="w-badge" data-tone="neutral" data-w-widget-count>0</span>
            </div>
            <div class="w-card__body w-stack" data-gap="sm">
                <label class="w-visually-hidden" for="w-theme-editor-widget-search"><?= $safe(__('搜索部件')) ?></label>
                <input id="w-theme-editor-widget-search" class="w-input" type="search" autocomplete="off" placeholder="<?= $safe(__('搜索部件…')) ?>" data-w-widget-search>
                <div class="w-theme-editor__widget-list" data-w-widget-list aria-live="polite">
                    <div class="w-skeleton" data-shape="line"></div>
                    <div class="w-skeleton" data-shape="line"></div>
                    <div class="w-skeleton" data-shape="line"></div>
                </div>
            </div>
        </aside>

        <section class="w-card w-theme-editor__preview" aria-labelledby="w-theme-editor-preview-title">
            <div class="w-card__header">
                <div>
                    <h2 id="w-theme-editor-preview-title" class="w-card__title"><?= $safe(__('实时预览')) ?></h2>
                    <p data-w-preview-status><?= $safe($previewStatus === 'published' ? __('已发布版本') : __('草稿版本')) ?></p>
                </div>
                <span class="w-spinner" data-size="sm" data-w-preview-spinner hidden><span class="w-visually-hidden"><?= $safe(__('加载中')) ?></span></span>
            </div>
            <div class="w-theme-editor__frame-wrap">
                <iframe
                    class="w-theme-editor__frame"
                    src="<?= $safe($previewUrl) ?>"
                    title="<?= $safe(__('主题布局预览')) ?>"
                    data-w-preview-frame
                    referrerpolicy="same-origin"
                ></iframe>
            </div>
        </section>

        <aside class="w-card w-theme-editor__summary" aria-labelledby="w-theme-editor-summary-title">
            <div class="w-card__header">
                <h2 id="w-theme-editor-summary-title" class="w-card__title"><?= $safe(__('当前上下文')) ?></h2>
            </div>
            <dl class="w-card__body w-description-list">
                <div><dt><?= $safe(__('主题 ID')) ?></dt><dd><?= $themeId ?: '—' ?></dd></div>
                <div><dt><?= $safe(__('区域')) ?></dt><dd><?= $safe($editorArea) ?></dd></div>
                <div><dt><?= $safe(__('布局')) ?></dt><dd><?= $safe($pageType . ' / ' . $layoutOption) ?></dd></div>
                <div><dt><?= $safe(__('作用域')) ?></dt><dd><?= $safe($scope) ?></dd></div>
                <div><dt><?= $safe(__('目标')) ?></dt><dd><?= $safe($targetType . ':' . $targetId) ?></dd></div>
            </dl>
        </aside>
    </div>

    <dialog id="w-theme-editor-versions" class="w-dialog" data-size="lg" data-w-component="dialog" aria-labelledby="w-theme-editor-versions-title">
        <div class="w-dialog__header">
            <h2 id="w-theme-editor-versions-title"><?= $safe(__('布局版本')) ?></h2>
            <button type="button" class="w-button" data-tone="quiet" data-size="sm" data-w-action="dialog.close" data-w-target="#w-theme-editor-versions" aria-label="<?= $safe(__('关闭')) ?>">
                <w:icon name="close" />
            </button>
        </div>
        <div class="w-dialog__body w-stack">
            <form class="w-cluster" data-w-version-form>
                <label class="w-field w-theme-editor__version-name">
                    <span class="w-field__label"><?= $safe(__('新版本名称')) ?></span>
                    <input class="w-input" name="version_name" maxlength="120" required>
                </label>
                <button type="submit" class="w-button"><w:icon name="save" size="sm" /><?= $safe(__('保存当前版本')) ?></button>
            </form>
            <div class="w-divider"></div>
            <div class="w-theme-editor__version-list" data-w-version-list aria-live="polite"></div>
        </div>
    </dialog>
</section>

<script type="module" src="@static(Weline_Theme::ui/pages/weline-theme-editor.js)"></script>
