<?php
/**
 * 变量表单（内容模板）
 *
 * 页面骨架（main / h1 / 面包屑）由 backend layout + partials/layout/main-content 统一输出。
 *
 * @var \Weline\Framework\View\Template $this
 * @var array|\Weline\Theme\Model\WelineTheme $theme
 * @var string $area
 * @var string $scope
 * @var string $file
 * @var array $data
 */
$themeData = is_array($theme ?? null)
    ? $theme
    : (is_object($theme ?? null) && method_exists($theme, 'getData') ? (array)$theme->getData() : []);
$themeId = (int)($themeData['id'] ?? 0);
$themeName = trim((string)($themeData['name'] ?? ''));
$area = (string)($area ?? 'frontend') ?: 'frontend';
$scope = (string)($scope ?? 'default') ?: 'default';
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$categories = is_array($data['categories'] ?? null) ? $data['categories'] : [];
$fileName = (string)($data['name'] ?? ucfirst((string)($file ?? '')));
?>
<div class="w-stack theme-variable-form" data-testid="theme-variable-form">
    <section class="w-card">
        <header class="w-card__header">
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <h2 class="w-card__title">
                    <?= $h(__('配置变量')) ?> - <?= $h($fileName) ?>
                </h2>
                <div class="w-cluster">
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('主题：')) ?><?= $h($themeName) ?></span>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('区域：')) ?><?= $h($area) ?></span>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('作用域：')) ?><?= $h($scope) ?></span>
                </div>
            </div>
        </header>

        <div class="w-card__body">
            <div class="w-toolbar">
                <div class="w-cluster">
                    <label class="w-field__label w-visually-hidden" for="search-input" >
                        <?= $h(__('搜索变量名...')) ?>
                    </label>
                    <input
                        type="text"
                        id="search-input"
                        class="w-input"
                        data-variable-filter-control
                        placeholder="<?= $h(__('搜索变量名...')) ?>"
                    >
                    <label class="w-field__label w-visually-hidden" for="category-filter" >
                        <?= $h(__('所有分类')) ?>
                    </label>
                    <select id="category-filter" class="w-select" data-variable-filter-control>
                        <option value=""><?= $h(__('所有分类')) ?></option>
                        <?php foreach (array_keys($categories) as $category): ?>
                            <option value="<?= $h($category) ?>"><?= $h($category) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="w-cluster">
                    <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-variable-action="reset">
                        <w:icon name="refresh" size="sm"></w:icon>
                        <?= $h(__('重置为默认值')) ?>
                    </button>
                </div>
            </div>

            <?php if ($categories === []): ?>
                <div class="w-empty">
                    <span class="w-empty__icon"><w:icon name="palette" size="lg"></w:icon></span>
                    <p class="w-empty__title"><?= $h(__('暂无可用变量')) ?></p>
                    <div class="w-empty__actions">
                        <a class="w-button" data-tone="neutral" data-variant="outline" data-size="sm" href="@url{'theme/backend/config/variables'}">
                            <?= $h(__('返回')) ?>
                        </a>
                    </div>
                </div>
            <?php else: ?>
                <w:form id="variable-form">
                    <input type="hidden" name="theme_id" value="<?= $themeId ?>">
                    <input type="hidden" name="area" value="<?= $h($area) ?>">
                    <input type="hidden" name="scope" value="<?= $h($scope) ?>">

                    <div class="w-stack">
                        <?php foreach ($categories as $category => $vars): ?>
                            <?php $vars = is_array($vars) ? $vars : []; ?>
                            <section class="w-stack category-group" data-category="<?= $h($category) ?>">
                                <h3 class="w-card__title"><?= $h($category) ?></h3>

                                <div class="w-stack">
                                    <?php foreach ($vars as $var): ?>
                                        <?php
                                        $var = is_array($var) ? $var : [];
                                        $cssName = (string)($var['cssName'] ?? '');
                                        $metaIdentify = (string)($var['meta_identify'] ?? '');
                                        $varValue = (string)($var['value'] ?? '');
                                        $varDefault = (string)($var['default'] ?? '');
                                        $varDescription = (string)($var['description'] ?? '');
                                        $varType = (string)($var['type'] ?? 'text');
                                        $isColor = !empty($var['is_color']);
                                        $fieldBaseId = 'var-' . preg_replace('/[^A-Za-z0-9_-]/', '-', $cssName);
                                        ?>
                                        <div
                                            class="w-field variable-item"
                                            data-var-name="<?= $h(strtolower($cssName)) ?>"
                                            data-category="<?= $h($category) ?>"
                                        >
                                            <label class="w-field__label" for="<?= $h($fieldBaseId) ?>">
                                                <code><?= $h($cssName) ?></code>
                                            </label>

                                            <div class="w-cluster variable-input-group">
                                                <?php if ($isColor): ?>
                                                    <input
                                                        type="color"
                                                        id="<?= $h($fieldBaseId) ?>"
                                                        data-meta-identify="<?= $h($metaIdentify) ?>"
                                                        value="<?= $h($varValue !== '' ? $varValue : $varDefault) ?>"
                                                        data-variable-color-input
                                                        title="<?= $h($varDescription) ?>"
                                                    >
                                                    <input
                                                        type="text"
                                                        class="w-input color-text-input"
                                                        data-color-input="<?= $h($fieldBaseId) ?>"
                                                        value="<?= $h($varValue !== '' ? $varValue : $varDefault) ?>"
                                                        data-variable-color-text
                                                        placeholder="#000000"
                                                        aria-label="<?= $h($cssName) ?>"
                                                    >
                                                <?php elseif ($varType === 'spacing'): ?>
                                                    <?php
                                                    $spacingValue = $varValue !== '' ? $varValue : $varDefault;
                                                    $spacingNum = '';
                                                    $spacingUnit = 'rem';
                                                    if (strpos($spacingValue, 'var(') !== 0) {
                                                        if (preg_match('/^(\d+(?:\.\d+)?)(rem|px|em|%)?$/', trim($spacingValue), $matches)) {
                                                            $spacingNum = $matches[1];
                                                            $spacingUnit = $matches[2] ?? 'rem';
                                                        }
                                                    }
                                                    ?>
                                                    <input
                                                        type="number"
                                                        step="0.01"
                                                        id="<?= $h($fieldBaseId) ?>-num"
                                                        class="w-input"
                                                        value="<?= $h($spacingNum) ?>"
                                                        data-spacing-css-name="<?= $h($cssName) ?>"
                                                        placeholder="1"
                                                        aria-label="<?= $h($cssName) ?>"
                                                    >
                                                    <select
                                                        id="<?= $h($fieldBaseId) ?>-unit"
                                                        class="w-select"
                                                        data-spacing-css-name="<?= $h($cssName) ?>"
                                                        aria-label="<?= $h($cssName) ?>"
                                                    >
                                                        <option value="rem" <?= $spacingUnit === 'rem' ? 'selected' : '' ?>>rem</option>
                                                        <option value="px" <?= $spacingUnit === 'px' ? 'selected' : '' ?>>px</option>
                                                        <option value="em" <?= $spacingUnit === 'em' ? 'selected' : '' ?>>em</option>
                                                        <option value="%" <?= $spacingUnit === '%' ? 'selected' : '' ?>>%</option>
                                                    </select>
                                                    <input
                                                        type="hidden"
                                                        id="<?= $h($fieldBaseId) ?>"
                                                        data-meta-identify="<?= $h($metaIdentify) ?>"
                                                        value="<?= $h($spacingValue) ?>"
                                                    >
                                                <?php else: ?>
                                                    <input
                                                        type="text"
                                                        id="<?= $h($fieldBaseId) ?>"
                                                        class="w-input"
                                                        data-meta-identify="<?= $h($metaIdentify) ?>"
                                                        value="<?= $h($varValue !== '' ? $varValue : $varDefault) ?>"
                                                        data-variable-text-input
                                                        placeholder="<?= $h($varDefault) ?>"
                                                    >
                                                <?php endif; ?>
                                            </div>

                                            <?php if ($varDescription !== ''): ?>
                                                <p class="w-text variable-description" data-tone="muted" data-size="sm"><?= $h($varDescription) ?></p>
                                            <?php endif; ?>
                                            <p class="w-text default-value" data-tone="muted" data-size="xs">
                                                <?= $h(__('默认：')) ?><?= $h($varDefault) ?>
                                            </p>
                                        </div>
                                    <?php endforeach; ?>
                                </div>
                            </section>
                        <?php endforeach; ?>
                    </div>
                </w:form>
            <?php endif; ?>
        </div>

        <?php if ($categories !== []): ?>
            <footer class="w-card__footer">
                <div class="w-cluster">
                    <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-variable-action="reset">
                        <?= $h(__('重置为默认值')) ?>
                    </button>
                </div>
                <div class="w-cluster">
                    <button type="button" class="w-button" data-tone="primary" data-variable-action="save-all">
                        <w:icon name="check" size="sm"></w:icon>
                        <?= $h(__('保存所有配置')) ?>
                    </button>
                    <button type="button" class="w-button" data-tone="primary" data-variant="outline" data-variable-action="save-preview">
                        <w:icon name="eye" size="sm"></w:icon>
                        <?= $h(__('保存并预览')) ?>
                    </button>
                </div>
            </footer>
        <?php endif; ?>
    </section>

    <section class="w-card" id="variable-preview-card" hidden>
        <header class="w-card__header">
            <h2 class="w-card__title"><?= $h(__('预览')) ?></h2>
        </header>
        <div class="w-card__body">
            <iframe id="preview-iframe" class="preview-iframe" width="100%" height="600" src=""></iframe>
        </div>
    </section>
</div>

<script>
(function () {
    'use strict';

    // 页面级初始化：CSS 变量编辑（实时保存 + 预览）。
    (function (g) {
        if (g.WelineThemeBinQuery) return;
        g.WelineThemeBinQuery = {
            request: function (url, options) {
                options = options || {};
                var method = String(options.method || 'GET').toUpperCase();
                var body = '';
                if (options.body != null) {
                    if (typeof options.body === 'string') {
                        body = options.body;
                    } else if (typeof FormData !== 'undefined' && options.body instanceof FormData) {
                        var p = new URLSearchParams();
                        options.body.forEach(function (v, k) {
                            if (!(typeof File !== 'undefined' && v instanceof File)) p.append(k, String(v));
                        });
                        body = p.toString();
                    } else {
                        try { body = JSON.stringify(options.body); } catch (e) { body = ''; }
                    }
                }
                var run = function (api) {
                    return api.resource('theme').editorRequest({ url: url, method: method, headers: options.headers || {}, body: body })
                        .then(function (data) {
                            var b = g.WelineApiBusiness || (g.Weline && g.Weline.ApiBusiness);
                            return (b && typeof b.wrapAdminBridgeResult === 'function') ? b.wrapAdminBridgeResult(data) : data;
                        });
                };
                if (g.Weline && g.Weline.load) return g.Weline.load('api').then(run);
                return Promise.resolve(run(g.Weline.Api));
            }
        };
    })(window);

    var themeId = <?= json_encode((string)$themeId) ?>;
    var area = <?= json_encode($area) ?>;
    var scope = <?= json_encode($scope) ?>;

    function notify(type, message) {
        var ui = window.Weline && window.Weline.UI;
        if (ui && ui.toast && typeof ui.toast[type] === 'function') {
            ui.toast[type](message);
            return;
        }
        console[type === 'error' ? 'error' : 'log'](message);
    }

    function unwrap(response) {
        var b = window.WelineApiBusiness || (window.Weline && window.Weline.ApiBusiness);
        return (b && typeof b.unwrapBusiness === 'function')
            ? b.unwrapBusiness(response)
            : (response && response.data !== undefined ? response.data : response);
    }

    function isOk(response, data) {
        return (response && (response.ok === true || response.success === true))
            || (data && (data.code === 200 || data.success === true || data.status === 'success'));
    }

    function collectVariables() {
        var variables = {};
        document.querySelectorAll('[data-meta-identify]').forEach(function (input) {
            var metaIdentify = input.getAttribute('data-meta-identify');
            var value = input.value;

            if (input.type === 'hidden' && input.id.indexOf('var-') === 0
                && input.id.indexOf('-num') === -1 && input.id.indexOf('-unit') === -1) {
                var cssName = input.id.replace('var-', '');
                var numInput = document.getElementById('var-' + cssName + '-num');
                var unitSelect = document.getElementById('var-' + cssName + '-unit');
                if (numInput && unitSelect && numInput.value !== '') {
                    value = numInput.value + unitSelect.value;
                }
            }

            if (metaIdentify && value !== null && value !== '') {
                variables[metaIdentify] = value;
            }
        });
        return variables;
    }

    function saveAllVariables() {
        var form = document.getElementById('variable-form');
        if (!form) return;
        var formData = new FormData(form);
        formData.append('variables', JSON.stringify(collectVariables()));

        WelineThemeBinQuery.request('@url{'theme/backend/config/variables/save'}', { method: 'POST', body: formData })
            .then(function (response) {
                var data = unwrap(response);
                if (!isOk(response, data)) {
                    notify('error', (data && (data.msg || data.message)) || '<?= addslashes((string)__('未知错误')) ?>');
                    return;
                }
                notify('success', '<?= addslashes((string)__('保存成功')) ?>');
                if (data && data.preview_url) {
                    refreshPreview(data.preview_url);
                }
            })
            .catch(function () {
                notify('error', '<?= addslashes((string)__('网络错误')) ?>');
            });
    }

    function saveVariable(metaIdentify, value) {
        var formData = new FormData();
        formData.append('theme_id', themeId);
        formData.append('area', area);
        formData.append('scope', scope);
        formData.append('meta_identify', metaIdentify);
        formData.append('value', value);

        WelineThemeBinQuery.request('@url{'theme/backend/config/variables/saveVariable'}', { method: 'POST', body: formData, silent: true })
            .then(function (response) {
                var data = unwrap(response);
                if (isOk(response, data) && data && data.preview_url) {
                    refreshPreview(data.preview_url);
                }
            })
            .catch(function () {
                // 实时保存失败不打断编辑，保留控制台错误便于排查。
                console.error('<?= addslashes((string)__('保存失败')) ?>');
            });
    }

    function updateColorValue(colorInput) {
        var textInput = findColorTextInput(colorInput.id);
        if (textInput) {
            textInput.value = colorInput.value;
        }
        var metaIdentify = colorInput.getAttribute('data-meta-identify');
        if (metaIdentify) {
            saveVariable(metaIdentify, colorInput.value);
        }
    }

    function updateColorFromText(textInput) {
        var colorInputId = textInput.getAttribute('data-color-input');
        var colorInput = document.getElementById(colorInputId);
        if (colorInput && /^#[0-9a-fA-F]{6}$/.test(textInput.value)) {
            colorInput.value = textInput.value;
            var metaIdentify = colorInput.getAttribute('data-meta-identify');
            if (metaIdentify) {
                saveVariable(metaIdentify, textInput.value);
            }
        }
    }

    function findColorTextInput(colorInputId) {
        return Array.prototype.slice.call(document.querySelectorAll('[data-color-input]'))
            .find(function (input) { return input.getAttribute('data-color-input') === colorInputId; }) || null;
    }

    function updateSpacingValue(cssName) {
        var numInput = document.getElementById('var-' + cssName + '-num');
        var unitSelect = document.getElementById('var-' + cssName + '-unit');
        var hiddenInput = document.getElementById('var-' + cssName);

        if (numInput && unitSelect && hiddenInput) {
            var numValue = numInput.value;
            var unitValue = unitSelect.value;
            if (numValue !== '') {
                var value = numValue + unitValue;
                hiddenInput.value = value;
                var metaIdentify = hiddenInput.getAttribute('data-meta-identify');
                if (metaIdentify) {
                    saveVariable(metaIdentify, value);
                }
            }
        }
    }

    function updateVariableValue(input) {
        var metaIdentify = input.getAttribute('data-meta-identify');
        if (metaIdentify) {
            saveVariable(metaIdentify, input.value);
        }
    }

    function saveAndPreview() {
        var form = document.getElementById('variable-form');
        if (!form) return;
        var formData = new FormData(form);
        formData.append('variables', JSON.stringify(collectVariables()));

        WelineThemeBinQuery.request('@url{'theme/backend/config/variables/save'}', { method: 'POST', body: formData })
            .then(function (response) {
                var data = unwrap(response);
                if (!isOk(response, data)) {
                    notify('error', (data && (data.msg || data.message)) || '<?= addslashes((string)__('未知错误')) ?>');
                    return;
                }
                if (data && data.preview_url) {
                    refreshPreview(data.preview_url);
                    notify('success', '<?= addslashes((string)__('保存成功，预览已更新')) ?>');
                    return;
                }
                notify('success', '<?= addslashes((string)__('保存成功')) ?>');
            })
            .catch(function () {
                notify('error', '<?= addslashes((string)__('网络错误')) ?>');
            });
    }

    function refreshPreview(previewUrl) {
        var iframe = document.getElementById('preview-iframe');
        var card = document.getElementById('variable-preview-card');
        if (!iframe || !previewUrl) return;
        iframe.src = previewUrl;
        if (card) {
            card.hidden = false;
        }
    }

    function resetToDefaults() {
        document.querySelectorAll('[data-meta-identify]').forEach(function (input) {
            var item = input.closest('.variable-item');
            var defaultEl = item ? item.querySelector('.default-value') : null;
            var defaultValue = defaultEl ? defaultEl.textContent.replace('<?= addslashes((string)__('默认：')) ?>', '').trim() : '';
            if (input.type === 'color') {
                input.value = defaultValue;
                var textInput = findColorTextInput(input.id);
                if (textInput) {
                    textInput.value = defaultValue;
                }
            } else if (input.type === 'hidden' && input.id.indexOf('var-') === 0
                && input.id.indexOf('-num') === -1 && input.id.indexOf('-unit') === -1) {
                var cssName = input.id.replace('var-', '');
                var numInput = document.getElementById('var-' + cssName + '-num');
                var unitSelect = document.getElementById('var-' + cssName + '-unit');
                if (numInput && unitSelect) {
                    var match = defaultValue.match(/^(\d+(?:\.\d+)?)(rem|px|em|%)?$/);
                    if (match) {
                        numInput.value = match[1];
                        unitSelect.value = match[2] || 'rem';
                        input.value = defaultValue;
                    }
                } else {
                    input.value = defaultValue;
                }
            } else {
                input.value = defaultValue;
            }
        });

        saveAllVariables();
    }

    function filterVariables() {
        var searchInput = document.getElementById('search-input');
        var categoryFilter = document.getElementById('category-filter');
        var searchText = searchInput ? searchInput.value.toLowerCase() : '';
        var category = categoryFilter ? categoryFilter.value : '';

        document.querySelectorAll('.variable-item').forEach(function (item) {
            var varName = item.getAttribute('data-var-name') || '';
            var itemCategory = item.getAttribute('data-category') || '';
            var matchesSearch = !searchText || varName.indexOf(searchText) !== -1;
            var matchesCategory = !category || itemCategory === category;
            item.hidden = !(matchesSearch && matchesCategory);
        });

        document.querySelectorAll('.category-group').forEach(function (group) {
            var visibleItems = group.querySelectorAll('.variable-item:not([hidden])');
            group.hidden = visibleItems.length === 0;
        });
    }

    (function bindVariableFormEvents() {
        var root = document.querySelector('.theme-variable-form');
        if (!root) return;

        root.addEventListener('keyup', function (event) {
            if (event.target.matches('[data-variable-filter-control]')) {
                filterVariables();
            }
        });

        root.addEventListener('change', function (event) {
            var target = event.target;

            if (target.matches('[data-variable-filter-control]')) {
                filterVariables();
                return;
            }
            if (target.matches('[data-variable-color-input]')) {
                updateColorValue(target);
                return;
            }
            if (target.matches('[data-variable-color-text]')) {
                updateColorFromText(target);
                return;
            }
            if (target.matches('[data-spacing-css-name]')) {
                var cssName = target.getAttribute('data-spacing-css-name');
                if (cssName) {
                    updateSpacingValue(cssName);
                }
                return;
            }
            if (target.matches('[data-variable-text-input]')) {
                updateVariableValue(target);
            }
        });

        root.addEventListener('click', function (event) {
            var actionButton = event.target.closest('[data-variable-action]');
            if (!actionButton || !root.contains(actionButton)) return;

            var action = actionButton.getAttribute('data-variable-action');
            if (action === 'save-all') {
                saveAllVariables();
                return;
            }
            if (action === 'save-preview') {
                saveAndPreview();
                return;
            }
            if (action === 'reset') {
                resetToDefaults();
            }
        });
    })();
})();
</script>
