<?php
/**
 * 主题 Meta 配置片段（内容片段，用于布局弹窗）
 *
 * 不写页面骨架与 h1：由调用方页面/弹窗提供标题。
 *
 * @var \Weline\Framework\View\Template $this
 * @var array|\Weline\Theme\Model\WelineTheme $theme
 * @var string $area
 * @var string $scope
 */
$themeData = is_array($theme ?? null)
    ? $theme
    : (is_object($theme ?? null) && method_exists($theme, 'getData') ? (array)$theme->getData() : []);
$themeId = (int)($themeData['id'] ?? 0);
$themeName = trim((string)($themeData['name'] ?? ''));
$area = (string)($area ?? 'backend') ?: 'backend';
$scope = (string)($scope ?? 'default') ?: 'default';
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

// 当前 theme 的 Meta 都存放在统一 namespace=theme 下
$baseNamespace = 'theme';
$identityId = $themeId;

$metaTabs = [
    ['key' => 'layouts', 'label' => __('布局'), 'type' => 'layout', 'namespace' => $baseNamespace],
    ['key' => 'colors', 'label' => __('色系'), 'type' => 'color', 'namespace' => $baseNamespace],
    ['key' => 'partials', 'label' => __('部件'), 'type' => 'partial', 'namespace' => $baseNamespace],
    ['key' => 'variables', 'label' => __('变量'), 'type' => 'variable', 'namespace' => $baseNamespace],
    ['key' => 'components', 'label' => __('组件'), 'type' => 'component', 'namespace' => $baseNamespace],
];
$layoutNamespace = $baseNamespace;
$colorNamespace = $baseNamespace;
$partialsNamespace = $baseNamespace;
$variableNamespace = $baseNamespace;
$componentNamespace = $baseNamespace;
?>
<div class="w-stack theme-meta-manager-fragment" data-testid="theme-meta-manager">
    <div class="w-cluster" data-justify="between">
        <div class="w-stack" style="--w-gap:var(--weline-space-1);">
            <strong><?= $h(__('主题 Meta 配置')) ?></strong>
            <span class="w-text" data-tone="muted" data-size="xs">
                <?= $h($themeName) ?> / <?= $h($area) ?> / <?= $h($scope) ?>
            </span>
        </div>
    </div>

    <div class="w-tabs" data-w-component="tabs">
        <nav class="w-tabs__list" role="tablist" aria-label="<?= $h(__('主题 Meta 分类')) ?>">
            <?php foreach ($metaTabs as $index => $tab): ?>
                <button
                    class="w-tabs__tab"
                    id="theme-meta-tab-<?= $h($tab['key']) ?>"
                    type="button"
                    role="tab"
                    aria-controls="theme-meta-pane-<?= $h($tab['key']) ?>"
                    aria-selected="<?= $index === 0 ? 'true' : 'false' ?>"
                >
                    <?= $h($tab['label']) ?>
                </button>
            <?php endforeach; ?>
        </nav>

        <div class="w-tabs__panels">
            <?php foreach ($metaTabs as $index => $tab): ?>
                <div
                    class="w-tabs__panel"
                    id="theme-meta-pane-<?= $h($tab['key']) ?>"
                    role="tabpanel"
                    aria-labelledby="theme-meta-tab-<?= $h($tab['key']) ?>"
                    <?= $index === 0 ? '' : 'hidden' ?>
                >
                    <w:meta-manager
                            namespace="$<?= $h($tab['type'] === 'layout' ? 'layoutNamespace' : ($tab['type'] === 'color' ? 'colorNamespace' : ($tab['type'] === 'partial' ? 'partialsNamespace' : ($tab['type'] === 'variable' ? 'variableNamespace' : 'componentNamespace')))) ?>"
                            area="$area"
                            scope="$scope"
                            identity-id="$identityId"
                            type="<?= $h($tab['type']) ?>"
                            default-namespace="$<?= $h($tab['type'] === 'layout' ? 'layoutNamespace' : ($tab['type'] === 'color' ? 'colorNamespace' : ($tab['type'] === 'partial' ? 'partialsNamespace' : ($tab['type'] === 'variable' ? 'variableNamespace' : 'componentNamespace')))) ?>"
                            show-filters="true"
                            show-tree="true"/>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
</div>
