<?php
/**
 * 主题布局配置（内容模板）
 *
 * 页面骨架（main / h1 / 面包屑）由 backend layout + partials/layout/main-content 统一输出，
 * 本模板只负责内容：卡片 + 表单 + 标准组件类。
 *
 * @var \Weline\Framework\View\Template $this
 * @var array|\Weline\Theme\Model\WelineTheme $theme
 * @var array<string, list<string>> $frontendLayouts
 * @var array<string, list<string>> $backendLayouts
 * @var array<string, string> $frontendLayoutConfig
 * @var array<string, string> $backendLayoutConfig
 */
$themeData = is_array($theme ?? null)
    ? $theme
    : (is_object($theme ?? null) && method_exists($theme, 'getData') ? (array)$theme->getData() : []);
$themeId = (int)($themeData['id'] ?? 0);
$themeName = trim((string)($themeData['name'] ?? ''));
$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$frontendLayouts = is_array($frontendLayouts ?? null) ? $frontendLayouts : [];
$backendLayouts = is_array($backendLayouts ?? null) ? $backendLayouts : [];
$frontendLayoutConfig = is_array($frontendLayoutConfig ?? null) ? $frontendLayoutConfig : [];
$backendLayoutConfig = is_array($backendLayoutConfig ?? null) ? $backendLayoutConfig : [];

$renderLayoutFieldset = static function (string $area, array $layouts, array $layoutConfig) use ($h): void {
    if ($layouts === []) {
        ?>
        <div class="w-empty">
            <span class="w-empty__icon"><w:icon name="layout" size="lg"></w:icon></span>
            <p class="w-empty__title"><?= $h(__($area === 'backend' ? '该主题暂无后端布局选项' : '该主题暂无前端布局选项')) ?></p>
            <div class="w-empty__actions">
                <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-size="sm" onclick="location.reload()">
                    <w:icon name="refresh" size="sm"></w:icon> <?= $h(__('刷新')) ?>
                </button>
            </div>
        </div>
        <?php
        return;
    }
    ?>
    <div class="w-stack">
        <?php foreach ($layouts as $layoutType => $options): ?>
            <?php
            $layoutType = (string)$layoutType;
            $options = is_array($options) ? $options : [];
            $fieldId = 'layout-' . $area . '-' . preg_replace('/[^A-Za-z0-9_-]/', '-', $layoutType);
            $current = (string)($layoutConfig[$layoutType] ?? 'default');
            ?>
            <div class="w-field">
                <label class="w-field__label" for="<?= $h($fieldId) ?>">
                    <?= $h(ucfirst($layoutType)) ?> <?= $h(__('布局')) ?>
                </label>
                <select
                    name="<?= $h($area . '_layouts[' . $layoutType . ']') ?>"
                    id="<?= $h($fieldId) ?>"
                    class="w-select"
                    data-area="<?= $h($area) ?>"
                    data-layout-type="<?= $h($layoutType) ?>"
                >
                    <?php foreach ($options as $option): ?>
                        <?php $option = (string)$option; ?>
                        <option value="<?= $h($option) ?>" <?= $current === $option ? 'selected' : '' ?>>
                            <?= $h(ucfirst($option)) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        <?php endforeach; ?>
    </div>
    <?php
};
?>
<div class="w-stack theme-layout-config">
    <section class="w-card" data-testid="theme-layout-config">
        <header class="w-card__header">
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <h2 class="w-card__title"><?= $h(__('主题布局配置')) ?></h2>
                <?php if ($themeName !== ''): ?>
                    <p class="w-text" data-tone="muted" data-size="sm">
                        <?= $h(__('主题：%{name}', ['name' => $themeName])) ?>
                    </p>
                <?php endif; ?>
            </div>
        </header>

        <div class="w-card__body">
            <w:form id="layout-config-form" method="post" action="@url{'theme/backend/config/layout/save'}">
                <input type="hidden" name="theme_id" value="<?= $themeId ?>" id="theme-id">

                <div class="w-grid">
                    <div class="w-stack" style="--w-span:6;">
                        <h3 class="w-text" data-size="md" data-weight="strong"><?= $h(__('前端配置')) ?></h3>
                        <div class="w-stack" id="frontend-config-card" data-config-area="frontend">
                            <?php $renderLayoutFieldset('frontend', $frontendLayouts, $frontendLayoutConfig); ?>
                        </div>
                    </div>
                    <div class="w-stack" style="--w-span:6;">
                        <h3 class="w-text" data-size="md" data-weight="strong"><?= $h(__('后端配置')) ?></h3>
                        <div class="w-stack" id="backend-config-card" data-config-area="backend">
                            <?php $renderLayoutFieldset('backend', $backendLayouts, $backendLayoutConfig); ?>
                        </div>
                    </div>
                </div>

                <div class="w-cluster" data-justify="end" style="--w-mt:var(--weline-space-6);">
                    <a href="@url{'theme/backend'}" class="w-button" data-tone="neutral" data-variant="outline">
                        <?= $h(__('返回')) ?>
                    </a>
                    <button type="submit" class="w-button" data-tone="primary">
                        <w:icon name="check" size="sm"></w:icon> <?= $h(__('保存配置')) ?>
                    </button>
                </div>
            </w:form>
        </div>
    </section>
</div>

<script>
(function () {
    'use strict';

    // 页面级初始化：主题配置保存（走后台 admin bridge，与默认主题其它配置页一致）。
    (function (g) {
        if (g.WelineThemeBinQuery) return;
        g.WelineThemeBinQuery = {
            request: function (url, options) {
                options = options || {};
                var method = String(options.method || 'GET').toUpperCase();
                var body = '';
                if (options.body != null) {
                    if (typeof options.body === 'string') {
                        body = options.body;
                    } else if (typeof FormData !== 'undefined' && options.body instanceof FormData) {
                        var p = new URLSearchParams();
                        options.body.forEach(function (v, k) {
                            if (!(typeof File !== 'undefined' && v instanceof File)) p.append(k, String(v));
                        });
                        body = p.toString();
                    } else {
                        try { body = JSON.stringify(options.body); } catch (e) { body = ''; }
                    }
                }
                var run = function (api) {
                    return api.resource('theme').editorRequest({ url: url, method: method, headers: options.headers || {}, body: body })
                        .then(function (data) {
                            var b = g.WelineApiBusiness || (g.Weline && g.Weline.ApiBusiness);
                            return (b && typeof b.wrapAdminBridgeResult === 'function') ? b.wrapAdminBridgeResult(data) : data;
                        });
                };
                if (g.Weline && g.Weline.load) return g.Weline.load('api').then(run);
                return Promise.resolve(run(g.Weline.Api));
            }
        };
    })(window);

    function notify(type, message) {
        var ui = window.Weline && window.Weline.UI;
        if (ui && ui.toast && typeof ui.toast[type] === 'function') {
            ui.toast[type](message);
            return;
        }
        console[type === 'error' ? 'error' : 'log'](message);
    }

    var form = document.getElementById('layout-config-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var themeIdInput = document.getElementById('theme-id');
        var themeId = themeIdInput ? themeIdInput.value : '';
        var saveBtn = form.querySelector('button[type="submit"]');
        var originalBtnHtml = saveBtn ? saveBtn.innerHTML : '';
        if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="w-spinner" data-size="sm" aria-hidden="true"></span>';
        }

        function collect(area) {
            var container = document.getElementById(area + '-config-card');
            var data = new FormData();
            data.append('theme_id', themeId);
            data.append('area', area);
            if (!container) return data;
            container.querySelectorAll('select[data-layout-type]').forEach(function (select) {
                data.append('layouts[' + select.getAttribute('data-layout-type') + ']', select.value);
            });
            return data;
        }

        var layoutSaveUrl = '@url{'theme/backend/config/layout/save'}';
        var frontendData = collect('frontend');
        var backendData = collect('backend');

        WelineThemeBinQuery.request(layoutSaveUrl, { method: 'POST', body: frontendData })
            .then(function (res) {
                var data = (res && res.data !== undefined) ? res.data : res;
                if (!data || data.status !== 'success') {
                    throw new Error((data && data.message) || '<?= addslashes((string)__('保存失败')) ?>');
                }
                return WelineThemeBinQuery.request(layoutSaveUrl, { method: 'POST', body: backendData });
            })
            .then(function (res) {
                var data = (res && res.data !== undefined) ? res.data : res;
                if (data && data.status === 'success') {
                    notify('success', '<?= addslashes((string)__('配置保存成功')) ?>');
                    setTimeout(function () { location.reload(); }, 600);
                    return;
                }
                throw new Error((data && data.message) || '<?= addslashes((string)__('保存失败')) ?>');
            })
            .catch(function (error) {
                notify('error', (error && error.message) || '<?= addslashes((string)__('保存失败')) ?>');
            })
            .finally(function () {
                if (!saveBtn) return;
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalBtnHtml;
            });
    });
})();
</script>
