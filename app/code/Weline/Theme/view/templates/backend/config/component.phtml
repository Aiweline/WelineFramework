<?php
/**
 * 组件预览（内容模板）
 *
 * 页面骨架（main / h1 / 面包屑）由 backend layout + partials/layout/main-content 统一输出；
 * 本页在标准卡片内渲染主题组件，并按组件所属 area 声明所需前端资源。
 *
 * @var \Weline\Framework\View\Template $this
 * @var array|\Weline\Theme\Model\WelineTheme $theme
 * @var string $area
 * @var string $component
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\ComponentMetaParser;
use Weline\Theme\Helper\ThemeConfigManager;
use Weline\Framework\Event\EventsManager;

$themeModel = ObjectManager::getInstance(\Weline\Theme\Model\WelineTheme::class);
if (is_object($theme ?? null) && method_exists($theme, 'getId')) {
    $themeModel = $theme;
} elseif (is_array($theme ?? null) && (int)($theme['id'] ?? 0) > 0) {
    $themeModel->load((int)$theme['id']);
}

$h = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$area = (string)($area ?? 'frontend') ?: 'frontend';
$component = (string)($component ?? '');
$componentPath = 'Weline_Theme::theme/' . $area . '/components/' . $component . '.phtml';
$themeBasePath = trim((string)$themeModel->getData('path'), "\\/");
$componentFile = ($themeBasePath !== '' && $component !== '')
    ? $themeBasePath . DIRECTORY_SEPARATOR . $area . DIRECTORY_SEPARATOR . 'components' . DIRECTORY_SEPARATOR . $component . '.phtml'
    : '';
$meta = ($componentFile !== '' && is_file($componentFile))
    ? ComponentMetaParser::parse($componentFile)
    : ['params' => []];
$meta = is_array($meta) ? $meta : ['params' => []];

$scope = 'default';
$componentConfig = ThemeConfigManager::getConfig($themeModel, 'components', $area);
$componentParams = $componentConfig[$component] ?? [];
$componentParams = is_array($componentParams[$scope] ?? null) ? $componentParams[$scope] : [];

$metaKeyPrefix = 'theme.component.' . strtolower($component);
$translations = [];
if (!empty($meta['component'])) {
    $translations[] = [
        'word' => '@meta::' . $metaKeyPrefix . '.info.name',
        'translate' => $meta['component'],
        'module' => 'Weline_Theme',
    ];
}
if (!empty($meta['description'])) {
    $translations[] = [
        'word' => '@meta::' . $metaKeyPrefix . '.info.description',
        'translate' => $meta['description'],
        'module' => 'Weline_Theme',
    ];
}

// 组件预览所需资源（组件所属 area 的前端资源，标准 taglib 声明，不写页面 <link>）
if ($area === 'backend') {
    ?>
    <css>Weline_Admin::backend/lib/bootstrap-5.1.3-dist/css/bootstrap.min.css</css>
    <css>Weline_Admin::backend/lib/font-awesome-4.7.0/css/font-awesome.min.css</css>
    <js>Weline_Backend::/backend/lib/jquery/3.6.0/jquery.js</js>
    <?php
} else {
    ?>
    <css>Weline_Frontend::libs/bootstrap-5.1.3-dist/css/bootstrap.min.css</css>
    <css>Weline_Frontend::/libs/font-awesome-4.7.0/css/font-awesome.min.css</css>
    <js>Weline_Frontend::/libs/jquery/3.6.0/jquery.js</js>
    <?php
}
?>
<div class="w-stack theme-component-preview" data-testid="theme-component-preview">
    <section class="w-card">
        <header class="w-card__header">
            <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <h2 class="w-card__title"><?= $h(__('组件预览')) ?></h2>
                <div class="w-cluster">
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('主题')) ?>：<?= $h($themeModel->getName()) ?></span>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('区域')) ?>：<?= $h($area) ?></span>
                    <span class="w-text" data-tone="muted" data-size="sm"><?= $h(__('组件')) ?>：<?= $h($component) ?></span>
                </div>
            </div>
        </header>
        <div class="w-card__body">
            <?php if (!empty($meta['params'])): ?>
                <w:form id="componentParamsForm" method="post" action="@url{'theme/backend/config/component/saveParams'}">
                    <input type="hidden" name="theme_id" value="<?= (int)$themeModel->getId() ?>">
                    <input type="hidden" name="component" value="<?= $h($component) ?>">
                    <input type="hidden" name="area" value="<?= $h($area) ?>">
                    <input type="hidden" name="scope" value="<?= $h($scope) ?>">

                    <div class="w-stack">
                        <?php foreach ($meta['params'] as $param): ?>
                            <?php
                            $param = is_array($param) ? $param : [];
                            $paramName = (string)($param['name'] ?? '');
                            $paramType = (string)($param['type'] ?? 'mixed');
                            $paramDesc = (string)($param['description'] ?? '');
                            $paramRequired = !empty($param['required']);
                            $paramDefault = $param['default'] ?? null;
                            $paramValue = $componentParams[$paramName] ?? $paramDefault;
                            $fieldId = 'component-param-' . preg_replace('/[^A-Za-z0-9_-]/', '-', $paramName);
                            $paramMetaKey = $metaKeyPrefix . '.param.' . $paramName . '.description';
                            if ($paramDesc !== '') {
                                $translations[] = [
                                    'word' => '@meta::' . $paramMetaKey,
                                    'translate' => $paramDesc,
                                    'module' => 'Weline_Theme',
                                ];
                            }
                            ?>
                            <div class="w-field">
                                <label class="w-field__label" for="<?= $h($fieldId) ?>">
                                    <code><?= $h($paramName) ?></code>
                                    <span class="w-text" data-tone="muted" data-size="xs">(<?= $h($paramType) ?>)</span>
                                    <?php if ($paramRequired): ?>
                                        <span class="w-badge" data-w-background="danger"><?= $h(__('必填')) ?></span>
                                    <?php endif; ?>
                                </label>
                                <?php if ($paramDesc !== ''): ?>
                                    <p class="w-text" data-tone="muted" data-size="sm">
                                        <w:meta type="translate" prefix="<?= $metaKeyPrefix ?>" scope="<?= $scope ?>">param.<?= $paramName ?>.description</w:meta>
                                    </p>
                                <?php endif; ?>

                                <?php if ($paramType === 'bool'): ?>
                                    <select name="params[<?= $h($paramName) ?>]" id="<?= $h($fieldId) ?>" class="w-select">
                                        <option value="1" <?= ($paramValue === true || $paramValue === '1' || $paramValue === 1) ? 'selected' : '' ?>><?= $h(__('是')) ?></option>
                                        <option value="0" <?= ($paramValue === false || $paramValue === '0' || $paramValue === 0 || $paramValue === '') ? 'selected' : '' ?>><?= $h(__('否')) ?></option>
                                    </select>
                                <?php elseif ($paramType === 'int' || $paramType === 'float'): ?>
                                    <input
                                        type="number"
                                        id="<?= $h($fieldId) ?>"
                                        name="params[<?= $h($paramName) ?>]"
                                        class="w-input"
                                        value="<?= $h($paramValue ?? '') ?>"
                                        <?= $paramRequired ? 'required' : '' ?>
                                    >
                                <?php elseif ($paramType === 'array'): ?>
                                    <textarea
                                        id="<?= $h($fieldId) ?>"
                                        name="params[<?= $h($paramName) ?>]"
                                        class="w-textarea"
                                        rows="3"
                                        <?= $paramRequired ? 'required' : '' ?>
                                    ><?= $h(is_array($paramValue) ? json_encode($paramValue, JSON_UNESCAPED_UNICODE) : ($paramValue ?? '')) ?></textarea>
                                    <p class="w-text" data-tone="muted" data-size="sm">
                                        <?= $h(__('JSON格式，例如：["item1", "item2"]')) ?>
                                    </p>
                                <?php else: ?>
                                    <input
                                        type="text"
                                        id="<?= $h($fieldId) ?>"
                                        name="params[<?= $h($paramName) ?>]"
                                        class="w-input"
                                        value="<?= $h($paramValue ?? '') ?>"
                                        placeholder="<?= $paramDefault !== null ? $h(__('默认值：%{value}', ['value' => (string)$paramDefault])) : '' ?>"
                                        <?= $paramRequired ? 'required' : '' ?>
                                    >
                                <?php endif; ?>

                                <?php if ($paramDefault !== null): ?>
                                    <p class="w-text" data-tone="muted" data-size="xs">
                                        <?= $h(__('默认值')) ?>: <code><?= $h($paramDefault) ?></code>
                                    </p>
                                <?php endif; ?>
                            </div>
                        <?php endforeach; ?>
                    </div>

                    <div class="w-cluster" data-justify="end" style="--w-mt:var(--weline-space-6);">
                        <button type="button" class="w-button" data-tone="neutral" data-variant="outline" data-component-reset>
                            <w:icon name="refresh" size="sm"></w:icon>
                            <?= $h(__('重置')) ?>
                        </button>
                        <button type="submit" class="w-button" data-tone="primary">
                            <w:icon name="check" size="sm"></w:icon>
                            <?= $h(__('保存参数')) ?>
                        </button>
                    </div>
                </w:form>
            <?php else: ?>
                <div class="w-empty">
                    <span class="w-empty__icon"><w:icon name="layout" size="lg"></w:icon></span>
                    <p class="w-empty__title"><?= $h(__('该组件没有可配置的参数')) ?></p>
                </div>
            <?php endif; ?>
        </div>
    </section>

    <section class="w-card">
        <header class="w-card__header">
            <h2 class="w-card__title"><?= $h($meta['component'] ?? $component) ?></h2>
            <?php if (!empty($meta['description'])): ?>
                <span class="w-text" data-tone="muted" data-size="sm">
                    <w:meta type="translate" prefix="<?= $metaKeyPrefix ?>" scope="<?= $scope ?>">info.description</w:meta>
                </span>
            <?php endif; ?>
        </header>
        <div class="w-card__body component-preview-content">
            <?php
            $componentData = is_array($componentParams) ? $componentParams : [];
            if ($componentData === []) {
                switch ($component) {
                    case 'alert':
                        $componentData = [
                            'type' => 'success',
                            'message' => __('这是一个成功提示信息示例'),
                            'title' => __('提示'),
                            'dismissible' => true,
                        ];
                        break;
                    case 'button':
                        $componentData = [
                            'text' => __('按钮'),
                            'type' => 'primary',
                            'size' => 'md',
                        ];
                        break;
                    case 'card':
                        $componentData = [
                            'title' => __('卡片标题'),
                            'content' => __('这是卡片内容示例'),
                            'footer' => __('卡片底部'),
                        ];
                        break;
                    default:
                        $componentData = [];
                }
            }
            foreach (($meta['params'] ?? []) as $param) {
                $paramName = (string)($param['name'] ?? '');
                if (!isset($componentData[$paramName]) && isset($param['default'])) {
                    $defaultValue = $param['default'];
                    if (is_string($defaultValue) && !str_starts_with($defaultValue, '$')) {
                        $componentData[$paramName] = $defaultValue;
                    }
                }
            }
            foreach ($componentData as $key => $value) {
                $this->assign($key, $value);
            }

            try {
                echo $this->fetch($componentPath, $componentData);
            } catch (\Throwable $componentRenderError) {
                ?>
                <div class="w-alert" data-tone="danger">
                    <strong><?= $h(__('组件不存在')) ?></strong>
                    <span><?= $h($componentRenderError->getMessage()) ?></span>
                </div>
                <?php
            }
            ?>
        </div>
    </section>
</div>

<?php
// 收集组件信息/参数描述的翻译词（保持原有 i18n 收集行为）
if ($translations !== []) {
    /** @var EventsManager $eventsManager */
    $eventsManager = ObjectManager::getInstance(EventsManager::class);
    $eventsManager->dispatch('Weline_I18n::collect_translations', [
        'translations' => $translations,
        'module' => 'Weline_Theme',
    ]);
}
?>

<div data-weline-load="themeComponentParams" hidden aria-hidden="true"></div>

