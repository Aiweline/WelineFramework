<?php
/**
 * Unified preview content stub.
 *
 * Controller lifecycle observers rewrite this template into themed layouts.
 */
$content = $this->getData('content');
$isEditorPreview = (bool)($this->getData('editor_mode') ?? false)
    || (bool)($this->getData('theme_preview_content') ?? false)
    || in_array((string)($this->getData('layout_preview_mode') ?? ''), ['live', 'version', 'draft', 'default'], true);
if (!$isEditorPreview) {
    try {
        $editorModeFlag = trim((string)(\Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Framework\Http\Request::class
        )->getParam('editor_mode', '')));
        $isEditorPreview = ($editorModeFlag === '1' || strtolower($editorModeFlag) === 'true');
    } catch (\Throwable) {
        $isEditorPreview = false;
    }
}
if (is_string($content) && $content !== '' && !$isEditorPreview) {
    echo $content;
    return;
}
// Empty content must stay empty: emitting a stub here becomes meta.content and
// replaces homepage nested slots (hero/featured), wiping amazon-card markup.
// Editor preview also ignores prebuilt content so nested w:slot shells survive.
return;
