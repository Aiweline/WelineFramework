<?php
/**
 * @meta.name {default="Weline UI 2.0 后台 1280 布局",name="Weline UI 2.0 后台 1280 布局"}
 * @meta.description {default="Centered backend content capped at 1280 pixels.",name="最大宽度 1280 的后台内容布局"}
 * @param.showHeader {default=true,name="显示顶部栏"}
 * @param.showFooter {default=true,name="显示页脚"}
 * @param.class {default="",name="额外 Weline CSS 类"}
 * @var \Weline\Framework\View\Template $this
 */
$themeConfig = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Backend\Api\View\BackendThemeConfigInterface::class);
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$classes = array_values(array_filter(preg_split('/\s+/', trim((string)($meta['class'] ?? ''))) ?: [], static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" data-local="{{lang_local}}" data-lang="{{lang}}" <?= $themeConfig->getThemeHtmlAttributes() ?>>
<head>
    <w:template>Weline_Admin::common/head.phtml</w:template>
    <w:block class="Weline\Theme\Block\Partials" area="backend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::backend::layouts::default::1280::head-after</w:hook>
</head>
<body>
    <w:hook>Weline_Theme::backend::layouts::default::1280::body-start</w:hook>
    <?php if (($meta['showHeader'] ?? true) !== false): ?><w:block class="Weline\Theme\Block\Partials" area="backend" type="topbar" default-option="default"/><?php endif; ?>
    <div class="w-backend-standalone" data-layout-size="1280">
        <?php $layoutMainClass = trim('w-backend-page w-backend-standalone__content ' . implode(' ', $classes)); echo $this->fetch('Weline_Theme::theme/backend/partials/layout/main-content.phtml'); ?>
    </div>
    <?php if (($meta['showFooter'] ?? true) !== false): ?><w:block class="Weline\Theme\Block\Partials" area="backend" type="footer" default-option="default"/><?php endif; ?>
    <w:hook>Weline_Theme::backend::layouts::default::1280::body-end</w:hook>
</body>
</html>
