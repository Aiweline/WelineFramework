<?php
/**
 * @meta.name {default="Weline UI 2.0 后台打印布局",name="Weline UI 2.0 后台打印布局"}
 * @meta.description {default="Accessible print-first backend document.",name="后台打印文档布局"}
 * @param.class {default="",name="额外 Weline CSS 类"}
 * @var \Weline\Framework\View\Template $this
 */
$themeConfig = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Backend\Api\View\BackendThemeConfigInterface::class);
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$classes = array_values(array_filter(preg_split('/\s+/', trim((string)($meta['class'] ?? ''))) ?: [], static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" data-local="{{lang_local}}" data-lang="{{lang}}" <?= $themeConfig->getThemeHtmlAttributes() ?>>
<head>
    <w:template>Weline_Admin::common/head.phtml</w:template>
    <w:block class="Weline\Theme\Block\Partials" area="backend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::backend::layouts::print::head-after</w:hook>
</head>
<body>
    <w:hook>Weline_Theme::backend::layouts::print::body-start</w:hook>
    <div class="w-backend-print-shell">
        <?php
        $layoutMainClass = trim('w-backend-page w-backend-print-document ' . implode(' ', $classes));
        $layoutShowPageHeader = false;
        $layoutShowMessages = false;
        echo $this->fetch('Weline_Theme::theme/backend/partials/layout/main-content.phtml');
        ?>
        <div class="w-backend-print-actions">
            <button type="button" class="w-button" data-w-action="page.print">
                <w:icon name="printer" size="sm" />
                <span><?= htmlspecialchars((string)__('打印'), ENT_QUOTES, 'UTF-8') ?></span>
            </button>
        </div>
    </div>
    <w:hook>Weline_Theme::backend::layouts::print::body-end</w:hook>
</body>
</html>
