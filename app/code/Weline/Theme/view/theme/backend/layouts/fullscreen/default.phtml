<?php
/**
 * @meta.name {default="Weline UI 2.0 后台全屏布局",name="Weline UI 2.0 后台全屏布局"}
 * @meta.description {default="Full viewport backend canvas without sidebar.",name="无侧栏的后台全屏画布"}
 * @param.showHeader {default=true,name="显示顶部栏"}
 * @param.showFooter {default=false,name="显示页脚"}
 * @param.class {default="",name="额外 Weline CSS 类"}
 * @var \Weline\Framework\View\Template $this
 */
$themeConfig = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Backend\Api\View\BackendThemeConfigInterface::class);
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$classes = array_values(array_filter(
    preg_split('/\s+/', trim((string)($meta['class'] ?? ''))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1
));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" data-local="{{lang_local}}" data-lang="{{lang}}" <?= $themeConfig->getThemeHtmlAttributes() ?>>
<head>
    <w:hook>Weline_Theme::backend::layouts::base::head-before</w:hook>
    <w:template>Weline_Admin::common/head.phtml</w:template>
    <w:block class="Weline\Theme\Block\Partials" area="backend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::backend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::backend::layouts::fullscreen::head-after</w:hook>
<!--@weline-global:head:begin--><?= \Weline\Theme\Region\GlobalRegion::render('head') ?><!--@weline-global:head:end--></head>
<body><!--@weline-global:body_open:begin--><?= \Weline\Theme\Region\GlobalRegion::render('body_open') ?><!--@weline-global:body_open:end-->
    <w:hook>Weline_Theme::backend::layouts::fullscreen::body-start</w:hook>
    <?php if (($meta['showHeader'] ?? true) !== false): ?>
        <w:block class="Weline\Theme\Block\Partials" area="backend" type="topbar" default-option="default"/>
    <?php endif; ?>
    <div class="w-backend-standalone" data-layout-size="fullscreen">
        <?php
        $layoutMainClass = trim('w-backend-page w-backend-standalone__content ' . implode(' ', $classes));
        echo $this->fetch('Weline_Theme::theme/backend/partials/layout/main-content.phtml');
        ?>
    </div>
    <?php if (($meta['showFooter'] ?? false) !== false): ?>
        <w:block class="Weline\Theme\Block\Partials" area="backend" type="footer" default-option="standard"/>
    <?php endif; ?>
    <w:hook>Weline_Theme::backend::layouts::fullscreen::body-end</w:hook>
    <w:hook>Weline_Theme::backend::layouts::base::body-end</w:hook>
<!--@weline-global:body_end:begin--><?= \Weline\Theme\Region\GlobalRegion::render('body_end') ?><!--@weline-global:body_end:end--></body>
</html>
