<?php
/**
 * 组件：Loading
 *
 * 后台全局加载指示器（Theme UI host）。操作侧请用 Weline.UI.loading.show/hide/with。
 * 字段
 * @meta.name {default="Loading加载组件",name="Loading加载组件",description="后台全局加载指示器组件"}
 * @meta.description {default="后台全局加载指示器组件",name="全局加载指示器",description="Token 化全屏 loading host，配合 Weline.UI.loading"}
 * @param.id {default="weline-global-loading",name="元素ID",description="元素ID"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类"}
 * @param.text {default="加载中",name="加载文字提示",description="默认加载文案"}
 * @param.overlay {default=true,name="是否显示遮罩层",description="是否显示遮罩层"}
 * @param.enabled {default=true,name="是否启用",description="为 false 时不输出 host"}
 * @param.autoHideOnLoad {default=true,name="首屏自动关闭",description="页面 load 后确保 closed"}
 */
/** @var \Weline\Framework\View\Template $this */
$esc = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? 'weline-global-loading'));
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$text = (string)($this->getData('text') ?? $this->getData('meta.text') ?? __('加载中'));
$overlay = ($this->getData('overlay') ?? $this->getData('meta.overlay') ?? true) !== false;
$enabled = ($this->getData('enabled') ?? $this->getData('meta.enabled') ?? true) !== false;
$autoHideOnLoad = ($this->getData('autoHideOnLoad') ?? $this->getData('meta.autoHideOnLoad') ?? true) !== false;

if (!$enabled) {
    return;
}

$rootClass = trim('w-loading' . ($class !== '' ? ' ' . $class : ''));
?>
<section id="<?= $esc($id) ?>"
         class="<?= $esc($rootClass) ?>"
         data-w-component="loading"
         data-w-scope="global"
         data-state="closed"
         role="status"
         aria-live="polite"
         aria-hidden="true"
         hidden>
    <?php if ($overlay): ?>
        <span class="w-loading__backdrop" aria-hidden="true"></span>
    <?php endif; ?>
    <span class="w-loading__content">
        <span class="w-spinner" aria-hidden="true"></span>
        <span data-w-loading-message><?= $esc($text) ?></span>
    </span>
</section>
<?php if ($autoHideOnLoad): ?>
<script>
(function () {
    var root = document.getElementById(<?= json_encode($id, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);
    if (!root) return;
    function ensureClosed() {
        if (document.documentElement && document.documentElement.dataset.wGlobalLoading === 'true') {
            return;
        }
        root.setAttribute('data-state', 'closed');
        root.setAttribute('aria-hidden', 'true');
        root.hidden = true;
    }
    if (document.readyState === 'complete') {
        ensureClosed();
    } else {
        window.addEventListener('load', ensureClosed, { once: true });
    }
})();
</script>
<?php endif; ?>
