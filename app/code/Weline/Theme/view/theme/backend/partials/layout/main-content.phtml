<?php
/** @var \Weline\Framework\View\Template $this */

$meta = is_array($meta ?? null) ? $meta : (is_array($this->getData('meta')) ? $this->getData('meta') : []);
$asBool = static function (mixed $value, bool $default = true): bool {
    if ($value === null || $value === '') return $default;
    if (is_bool($value)) return $value;
    if (is_numeric($value)) return (int)$value !== 0;
    return !in_array(strtolower(trim((string)$value)), ['0', 'false', 'no', 'off'], true);
};
$layoutMainId = (string)($layoutMainId ?? 'main-content');
if (preg_match('/^[A-Za-z][A-Za-z0-9_-]*$/', $layoutMainId) !== 1) {
    $layoutMainId = 'main-content';
}
$layoutMainClasses = array_values(array_filter(
    preg_split('/\s+/', trim((string)($layoutMainClass ?? 'w-backend-page'))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1
));
if ($layoutMainClasses === []) $layoutMainClasses = ['w-backend-page'];
$showPageHeader = $asBool($layoutShowPageHeader ?? ($meta['showPageHeader'] ?? true), true);
$showMessages = $asBool($layoutShowMessages ?? ($meta['showMessages'] ?? true), true);
$contentHtml = $layoutContentHtml ?? (string)$this->fetch('Weline_Theme::theme/backend/partials/layout/content.phtml');
$fallbackTitle = trim((string)($layoutTitle ?? $title ?? $this->getData('title') ?? ($meta['title'] ?? '')));
$pageHeader = \Weline\Framework\Manager\ObjectManager::getInstance(
    \Weline\Theme\Service\BackendPageHeaderResolver::class
)->resolve($fallbackTitle);
$pageTitle = trim((string)($pageHeader['title'] ?? ''));
$breadcrumbs = is_array($pageHeader['breadcrumbs'] ?? null) ? $pageHeader['breadcrumbs'] : [];
?>
<main class="<?= htmlspecialchars(implode(' ', $layoutMainClasses), ENT_QUOTES, 'UTF-8') ?>"
      id="<?= htmlspecialchars($layoutMainId, ENT_QUOTES, 'UTF-8') ?>"
      data-layout="main_content">
    <?php if ($showPageHeader && $pageTitle !== ''): ?>
        <header class="w-backend-page__heading">
            <h1><?= htmlspecialchars($pageTitle, ENT_QUOTES, 'UTF-8') ?></h1>
            <?php if ($breadcrumbs !== []): ?>
                <nav aria-label="<?= htmlspecialchars((string)__('面包屑'), ENT_QUOTES, 'UTF-8') ?>">
                    <ol class="w-breadcrumb">
                        <?php foreach ($breadcrumbs as $breadcrumb): ?>
                            <li>
                                <?php if (empty($breadcrumb['active']) && !empty($breadcrumb['url'])): ?>
                                    <a href="<?= htmlspecialchars((string)$breadcrumb['url'], ENT_QUOTES, 'UTF-8') ?>">
                                        <?= htmlspecialchars((string)($breadcrumb['title'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
                                    </a>
                                <?php else: ?>
                                    <span aria-current="page"><?= htmlspecialchars((string)($breadcrumb['title'] ?? ''), ENT_QUOTES, 'UTF-8') ?></span>
                                <?php endif; ?>
                            </li>
                        <?php endforeach; ?>
                    </ol>
                </nav>
            <?php endif; ?>
        </header>
    <?php endif; ?>

    <?php if ($showMessages): ?>
        <div class="w-stack" data-backend-system-messages>
            <template>Weline_Component::message.phtml</template>
        </div>
    <?php endif; ?>

    <?= $contentHtml ?>
</main>
