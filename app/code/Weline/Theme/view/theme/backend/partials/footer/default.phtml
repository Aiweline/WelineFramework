<?php
/**
 * 片段：Backend Footer - 默认风格
 * 
 * 后端管理界面的默认底部
 * 字段
 * @info description 描述：后端管理界面的默认底部
 * @info name 名称：Footer底部片段
 * @param copyright 版权信息
 * @param class 额外CSS类
 */
$copyright = \Weline\Theme\Helper\FooterCopyrightHelper::resolve(
    $this->getData('copyright') !== null ? (string) $this->getData('copyright') : null
);
$classes = array_values(array_filter(
    preg_split('/\s+/', trim((string)($this->getData('class') ?? ''))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1
));
?>
<footer class="w-backend-footer <?= htmlspecialchars(implode(' ', $classes), ENT_QUOTES, 'UTF-8') ?>">
    <p><?= htmlspecialchars($copyright, ENT_QUOTES, 'UTF-8') ?></p>
</footer>
