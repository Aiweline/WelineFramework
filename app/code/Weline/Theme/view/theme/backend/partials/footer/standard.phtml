<?php
/**
 * 片段：Backend Footer - 标准页脚（Backend Theme Standard）
 *
 * @meta.name {default="Backend 标准页脚",name="Backend 标准页脚"}
 * @meta.description {default="后台默认主题统一页脚：版权 + 站点链接；由布局按 showFooter 输出。",name="后台标准页脚"}
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="role",name="鉴权维度"}
 * @param.class {default="",name="额外 Weline CSS 类"}
 *
 * 标准：app/code/Weline/Theme/doc/backend/后端主题开发标准.md
 * @var \Weline\Framework\View\Template $this
 */
$copyright = \Weline\Theme\Helper\FooterCopyrightHelper::resolve(
    $this->getData('copyright') !== null ? (string)$this->getData('copyright') : null
);
$classes = array_values(array_filter(
    preg_split('/\s+/', trim((string)($this->getData('class') ?? ''))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', (string)$class) === 1
));
?>
<footer class="w-backend-footer <?= htmlspecialchars(implode(' ', $classes), ENT_QUOTES, 'UTF-8') ?>">
    <span><?= htmlspecialchars($copyright, ENT_QUOTES, 'UTF-8') ?></span>
    <a href="https://www.aiweline.com/" target="_blank" rel="noopener noreferrer">aiweline.com</a>
</footer>
