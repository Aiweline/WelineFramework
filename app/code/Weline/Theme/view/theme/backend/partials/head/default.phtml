<?php
/**
 * @meta.name {default="Weline UI 2.0 Backend Head",name="Weline UI 2.0 后台头部"}
 * @meta.description {default="Loads the explicit Weline UI foundation, backend shell and native UI runtime.",name="后台 UI 资源入口"}
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="role",name="鉴权维度"}
 *
 * work_mode=default_theme — head emission; packs via ThemeHeadChromeCssPack.
 */
$diskOverrideHtml = '';
try {
    $diskOverrideHtml = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\Disk\ThemeDiskHeadService::class
    )->buildOverrideLinkHtml('backend');
} catch (\Throwable $e) {
    $diskOverrideHtml = '';
}
$headPack = null;
$tokenHtml = null;
$uiPackHtml = null;
try {
    $headPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeCssPack::class
    );
    $tokenHtml = $headPack->tryLinkHtml('backend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS_BACKEND, [
        'include_disk' => true,
    ]);
    $uiPackHtml = $headPack->tryLinkHtml('backend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_UI, [
        'layout_css' => true,
    ]);
} catch (\Throwable $e) {
    $headPack = null;
    $tokenHtml = null;
    $uiPackHtml = null;
}
$diskAbsorbed = $headPack instanceof \Weline\Theme\Service\ThemeHeadChromeCssPack
    && $tokenHtml !== null
    && $headPack->diskIncludedInPack('backend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS_BACKEND);
$earlyJsHtml = null;
$afterCssJsHtml = null;
try {
    $jsPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeJsPack::class
    );
    $earlyJsHtml = $jsPack->tryScriptHtml('backend', \Weline\Theme\Service\ThemeHeadChromeJsPack::PACK_EARLY);
    $afterCssJsHtml = $jsPack->tryScriptHtml('backend', \Weline\Theme\Service\ThemeHeadChromeJsPack::PACK_AFTER_CSS);
} catch (\Throwable $e) {
    $earlyJsHtml = null;
    $afterCssJsHtml = null;
}
?>
<w:template>Weline_Theme::templates/partials/head/css-fouc-bootstrap.phtml</w:template>
<theme:layout-critical area="backend"/>
<?php if ($earlyJsHtml !== null): ?>
<?= $earlyJsHtml ?>
<?php else: ?>
<script src="@static(Weline_Theme::ui/weline-theme-prepaint.js)"></script>
<?php endif; ?>
<w:theme:font src="Weline_Theme::NotoSansSC-Regular.ttf" family="Noto Sans SC" weight="400" display="swap"/>
<w:theme:font src="Weline_Theme::NotoSansSC-Bold.ttf" family="Noto Sans SC" weight="700" display="swap"/>
<?php if ($tokenHtml !== null): ?>
<?= $tokenHtml ?>
<?php else: ?>
<theme:css>Weline_Theme::theme/backend/colors/_light.css</theme:css>
<theme:css>Weline_Theme::theme/backend/colors/_default.css</theme:css>
<theme:css>Weline_Theme::theme/backend/colors/_dark.css</theme:css>
<?php endif; ?>
<?php if (!$diskAbsorbed) { echo $diskOverrideHtml; } ?>
<?php if ($uiPackHtml !== null): ?>
<?= $uiPackHtml ?>
<?php else: ?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-foundation.css)" data-weline-layout-css>
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-backend.css)" data-weline-layout-css>
<?php endif; ?>
<?php if ($afterCssJsHtml !== null): ?>
<?= $afterCssJsHtml ?>
<?php else: ?>
<script src="@static(Weline_Theme::ui/weline-css-ready.js)"></script>
<?php endif; ?>
<script type="module" src="@static(Weline_Theme::ui/weline-ui.js)"></script>
