<?php
/**
 * 组件：Button
 *
 * 按钮组件，支持多种样式和状态
 * 字段
 * @meta.name {default="Button按钮组件",name="Button按钮组件",description="Button按钮组件，用于描述组件的名称"}
 * @meta.description {default="按钮组件，支持多种样式和状态",name="按钮组件，支持多种样式和状态",description="按钮组件，支持多种样式和状态，用于描述组件的用途"}
 * @widget.supports {["builder-component","builder-action"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param.text {default="了解更多",name="按钮文字",description="按钮文字，必填参数"}
 * @param.type {default="primary",name="按钮类型",description="按钮类型，可选值：primary/secondary/danger/success/info"}
 * @param.size {default="md",name="按钮大小",description="按钮大小，可选值：sm/md/lg"}
 * @param.icon {default="",name="图标类名",description="图标类名，用于设置按钮图标"}
 * @param.iconPosition {default="left",name="图标位置",description="图标位置，可选值：left/right"}
 * @param.align {default="start",name="对齐方式",description="start/center/end"}
 * @param.fullWidth {default=false,name="是否满宽",description="是否占满容器宽度"}
 * @param.radius {default="",name="圆角",description="例如 999px、12px"}
 * @param.backgroundColor {default="",name="背景色",description="支持 #111、rgba()、var(--token)"}
 * @param.textColor {default="",name="文字颜色",description="支持 #fff、rgba()、var(--token)"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
 * @param.id {default="",name="元素ID",description="元素ID，用于设置按钮ID"}
 * @param.disabled {default=false,name="是否禁用",description="是否禁用，用于控制按钮的禁用状态"}
 * @param.loading {default=false,name="是否显示加载状态",description="是否显示加载状态，用于控制按钮的加载状态"}
 * @param.href {default="",name="链接地址",description="链接地址，如果提供，渲染为<a>标签"}
 * @param.onclick {default="",name="点击事件",description="点击事件，用于设置按钮点击事件"}
 * @param.data {default=[],name="data属性数组",description="data属性数组，用于设置data属性"}
 * @param.attributes {default="",name="额外的HTML属性字符串",description="额外的HTML属性字符串，用于设置额外的HTML属性"}
 */

use Weline\Theme\Helper\ThemeData;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('button');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$metaParams = ThemeData::getFileParams('components.button');
foreach ($metaParams as $key => $value) {
    if ($this->getData("meta.{$key}") === null) {
        $this->setData("meta.{$key}", $value);
    }
}

if (!function_exists('weline_component_escape')) {
    function weline_component_escape(mixed $value): string
    {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}

if (!function_exists('weline_component_safe_url')) {
    function weline_component_safe_url(mixed $url): string
    {
        $url = trim((string)$url);
        if ($url === '') {
            return '';
        }

        $compact = strtolower(preg_replace('/[\x00-\x20\x7f]+/', '', html_entity_decode($url, ENT_QUOTES, 'UTF-8')));
        if (str_starts_with($compact, 'javascript:') || str_starts_with($compact, 'vbscript:') || str_starts_with($compact, 'data:')) {
            return '';
        }

        return $url;
    }
}

if (!function_exists('weline_component_safe_data_key')) {
    function weline_component_safe_data_key(mixed $key): string
    {
        $key = strtolower(trim((string)$key));
        return preg_match('/^[a-z0-9_-]+$/', $key) ? $key : '';
    }
}

if (!function_exists('weline_builder_component_css_length')) {
    function weline_builder_component_css_length(mixed $value, string $fallback = ''): string
    {
        $value = trim((string)$value);
        if ($value === '') {
            return $fallback;
        }
        if (preg_match('/^(0|[0-9]+(?:\.[0-9]+)?(?:px|rem|em|%|vh|vw|svh|lvh|dvh))$/', $value)) {
            return $value;
        }
        if (preg_match('/^clamp\([0-9a-zA-Z%.,\s+\-]+\)$/', $value)) {
            return $value;
        }
        return $fallback;
    }
}

$text = $this->getData('text') ?? $this->getData('meta.text') ?? __('了解更多');
$type = strtolower(trim((string)($this->getData('type') ?? $this->getData('meta.type') ?? 'primary')));
$size = strtolower(trim((string)($this->getData('size') ?? $this->getData('meta.size') ?? 'md')));
$icon = (string)($this->getData('icon') ?? $this->getData('meta.icon') ?? '');
$iconPosition = (string)($this->getData('iconPosition') ?? $this->getData('meta.iconPosition') ?? 'left');
$align = strtolower(trim((string)($this->getData('align') ?? $this->getData('meta.align') ?? 'start')));
$fullWidth = filter_var($this->getData('fullWidth') ?? $this->getData('meta.fullWidth') ?? false, FILTER_VALIDATE_BOOL);
$radius = weline_builder_component_css_length($this->getData('radius') ?? $this->getData('meta.radius') ?? '');
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? ''));
$disabled = (bool)($this->getData('disabled') ?? $this->getData('meta.disabled') ?? false);
$loading = (bool)($this->getData('loading') ?? $this->getData('meta.loading') ?? false);
$href = (string)($this->getData('href') ?? $this->getData('meta.href') ?? '');
$clickAction = (string)($this->getData('onclick') ?? $this->getData('meta.onclick') ?? '');
$data = $this->getData('data') ?? $this->getData('meta.data') ?? [];
$attributes = (string)($this->getData('attributes') ?? $this->getData('meta.attributes') ?? '');

$typeDefaults = [
    'primary' => ['bg' => 'var(--weline-theme-primary)', 'color' => 'var(--weline-theme-on-primary)'],
    'secondary' => ['bg' => 'var(--weline-theme-surface-muted)', 'color' => 'var(--weline-theme-text)'],
    'danger' => ['bg' => 'var(--weline-theme-danger)', 'color' => 'var(--weline-theme-on-primary)'],
    'success' => ['bg' => 'var(--weline-theme-success)', 'color' => 'var(--weline-theme-on-primary)'],
    'info' => ['bg' => 'var(--weline-theme-info)', 'color' => 'var(--weline-theme-on-primary)'],
];
if (!isset($typeDefaults[$type])) {
    $type = 'primary';
}
$defaults = $typeDefaults[$type];

$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('backgroundColor') ?? $this->getData('meta.backgroundColor') ?? '',
    $defaults['bg']
);
$textColor = ThemeUiColor::sanitize(
    $this->getData('textColor') ?? $this->getData('meta.textColor') ?? '',
    $defaults['color']
);

$allowedAlign = ['start', 'center', 'end'];
if (!in_array($align, $allowedAlign, true)) {
    $align = 'start';
}
$allowedSizes = ['sm', 'md', 'lg'];
if (!in_array($size, $allowedSizes, true)) {
    $size = 'md';
}

$rootStyle = '--wc-button-bg:' . $backgroundColor . ';--wc-button-color:' . $textColor . ';';
if ($radius !== '') {
    $rootStyle .= '--wc-button-radius:' . $radius . ';';
}

$wrapperClass = trim($wc . ' w-builder-button-wrap w-builder-align-' . $align . ($fullWidth ? ' is-full-width' : '') . ($class !== '' ? ' ' . $class : ''));
$btnClass = trim('w-btn w-builder-button w-btn-' . $type . ' w-btn-' . $size . ($fullWidth ? ' w-builder-button-full' : '') . ($loading ? ' w-btn-loading' : ''));

$attrs = [
    'class="' . $esc($btnClass) . '"',
    'data-tone="' . $esc($type) . '"',
];
if ($id !== '') {
    $attrs[] = 'id="' . $esc($id) . '"';
}
if ($disabled) {
    $attrs[] = 'disabled';
}
if ($clickAction !== '') {
    $attrs[] = 'data-weline-click="' . $esc($clickAction) . '"';
}
foreach ($data as $key => $value) {
    $safeKey = weline_component_safe_data_key($key);
    if ($safeKey !== '') {
        $attrs[] = 'data-' . $safeKey . '="' . $esc((string)$value) . '"';
    }
}

$iconHtml = $icon !== '' ? '<i class="' . $esc($icon) . '"></i>' : '';
if ($icon !== '' && $iconPosition === 'right') {
    $content = $esc((string)$text) . ' ' . $iconHtml;
} elseif ($icon !== '') {
    $content = $iconHtml . ' ' . $esc((string)$text);
} else {
    $content = $esc((string)$text);
}

$attrString = implode(' ', $attrs);
?>

<section class="<?= $esc($wrapperClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>"
         data-align="<?= $esc($align) ?>">
    <?php if ($href !== ''): ?>
        <?php $safeHref = weline_component_safe_url($href); ?>
        <?php if ($safeHref === ''): ?>
            <button type="button" <?= $attrString ?> aria-disabled="true"><?= $content ?></button>
        <?php else: ?>
            <a href="<?= $esc($safeHref) ?>" <?= $attrString ?>><?= $content ?></a>
        <?php endif; ?>
    <?php else: ?>
        <?php
        $buttonType = 'button';
        if ($attributes !== '' && preg_match('/type=["\']([^"\']+)["\']/', $attributes, $matches)) {
            $candidateType = strtolower(trim($matches[1]));
            if (in_array($candidateType, ['button', 'submit', 'reset'], true)) {
                $buttonType = $candidateType;
            }
        }
        ?>
        <button type="<?= $esc($buttonType) ?>" <?= $attrString ?>><?= $content ?></button>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    display: flex;
    justify-content: flex-start;
}

.<?= $wc ?>[data-align="center"] {
    justify-content: center;
}

.<?= $wc ?>[data-align="end"] {
    justify-content: flex-end;
}

.<?= $wc ?>.is-full-width .w-btn,
.<?= $wc ?>.is-full-width .w-builder-button {
    width: 100%;
}

.<?= $wc ?> .w-btn,
.<?= $wc ?> .w-builder-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-2);
    padding: var(--weline-space-2) var(--weline-space-4);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) transparent;
    border-radius: var(--wc-button-radius);
    background: var(--wc-button-bg);
    color: var(--wc-button-color);
    font-size: var(--weline-font-size-base);
    font-weight: var(--weline-font-weight-semibold);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: opacity var(--weline-theme-transition-base), transform var(--weline-theme-transition-base);
}

.<?= $wc ?> .w-btn-sm,
.<?= $wc ?> .w-btn.w-btn-sm {
    padding: var(--weline-space-1) var(--weline-space-3);
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .w-btn-lg,
.<?= $wc ?> .w-btn.w-btn-lg {
    padding: var(--weline-space-3) var(--weline-space-6);
    font-size: var(--weline-font-size-lg);
}

.<?= $wc ?> .w-btn:hover,
.<?= $wc ?> .w-builder-button:hover {
    opacity: 0.9;
}

.<?= $wc ?> .w-btn:disabled,
.<?= $wc ?> .w-builder-button:disabled,
.<?= $wc ?> .w-btn[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
}

.<?= $wc ?> .w-btn-loading {
    pointer-events: none;
    opacity: 0.75;
}
</style>
