<!--
组件：Dropdown

下拉菜单组件，用于显示选项列表
字段
@meta.name {default="Dropdown下拉菜单组件",name="Dropdown下拉菜单组件",description="Dropdown下拉菜单组件，用于描述组件的名称"}
@meta.description {default="下拉菜单组件，用于显示选项列表",name="下拉菜单组件，用于显示选项列表",description="下拉菜单组件，用于显示选项列表，用于描述组件的用途"}
@widget.supports {["builder-component","builder-action","builder-display"]}
@widget.position {["content"]}
@widget.page_layouts {["*","dashboard"]}
@widget.compatible {true}
@param.id {default="",name="下拉菜单ID",description="下拉菜单ID，必填参数"}
@param.trigger {default="",name="触发器内容",description="触发器内容（HTML字符串），必填参数"}
@param.items {default=[],name="菜单项数组",description="菜单项数组，必填参数"}
@param.position {default="left",name="位置",description="位置，可选值：left/right"}
@param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
-->
<?php
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('dropdown');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? ''));
$trigger = (string)($this->getData('trigger') ?? $this->getData('meta.trigger') ?? '');
$items = $this->getData('items') ?? $this->getData('meta.items') ?? [];
$position = strtolower(trim((string)($this->getData('position') ?? $this->getData('meta.position') ?? 'left')));
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));

if (!function_exists('weline_dropdown_safe_url')) {
    function weline_dropdown_safe_url(mixed $url): string
    {
        $url = trim((string)$url);
        if ($url === '') {
            return '#';
        }

        $compact = strtolower(preg_replace('/[\x00-\x20\x7f]+/', '', html_entity_decode($url, ENT_QUOTES, 'UTF-8')));
        if (str_starts_with($compact, 'javascript:') || str_starts_with($compact, 'vbscript:') || str_starts_with($compact, 'data:')) {
            return '#';
        }

        return $url;
    }
}

if ($id === '') {
    $id = 'dropdown-' . substr($scope->uid, -8);
}

$rootClass = trim($wc . ' w-dropdown' . ($position === 'right' ? ' w-dropdown-right is-right' : '') . ($class !== '' ? ' ' . $class : ''));
$triggerHtml = $trigger !== '' ? $trigger : '{{trigger}}';
?>

<div class="<?= $esc($rootClass) ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>"
     data-w-component="menu">
    <button class="w-button w-dropdown-toggle dropdown-trigger"
            type="button"
            id="<?= $esc($id) ?>"
            data-w-menu-trigger
            data-tone="neutral"
            data-variant="outline"
            aria-haspopup="menu"
            aria-expanded="false">
        <?= $triggerHtml ?>
    </button>
    <div class="w-dropdown-menu w-menu dropdown-panel"
         aria-labelledby="<?= $esc($id) ?>"
         data-w-menu-panel
         role="menu"
         data-state="closed"
         aria-hidden="true"
         hidden>
        <?php foreach ($items as $item): ?>
            <?php if (isset($item['divider']) && $item['divider']): ?>
                <div class="w-dropdown-divider w-menu__divider dropdown-divider" role="separator"></div>
            <?php elseif (isset($item['header'])): ?>
                <h6 class="w-dropdown-header w-menu__header dropdown-header"><?= $esc((string)$item['header']) ?></h6>
            <?php else: ?>
                <?php
                $itemUrl = $esc(weline_dropdown_safe_url($item['url'] ?? '#'));
                $itemClickAttr = isset($item['onclick']) ? ' data-weline-click="' . $esc((string)$item['onclick']) . '"' : '';
                $itemIcon = isset($item['icon']) ? $esc((string)$item['icon']) : '';
                ?>
                <a class="w-dropdown-item w-menu__item dropdown-item"
                   href="<?= $itemUrl ?>"<?= $itemClickAttr ?>
                   role="menuitem"
                   tabindex="-1">
                    <?php if ($itemIcon !== ''): ?>
                        <span class="w-menu__icon dropdown-icon" data-icon="<?= $itemIcon ?>" aria-hidden="true"></span>
                    <?php endif; ?>
                    <?= $esc((string)($item['text'] ?? '')) ?>
                </a>
            <?php endif; ?>
        <?php endforeach; ?>
    </div>
</div>

<style>
.<?= $wc ?> {
    position: relative;
    display: inline-block;
}

.<?= $wc ?> .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--weline-space-2);
    padding: var(--weline-space-2) var(--weline-space-3);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface);
    color: var(--weline-theme-text);
    cursor: pointer;
}

.<?= $wc ?> .dropdown-panel {
    position: absolute;
    top: calc(100% + var(--weline-space-1));
    left: 0;
    z-index: 20;
    min-width: var(--token-size-12rem);
    padding: var(--weline-space-1);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface-raised);
    box-shadow: var(--weline-shadow-md);
}

.<?= $wc ?>.is-right .dropdown-panel {
    left: auto;
    right: 0;
}

.<?= $wc ?> .dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--weline-space-2);
    padding: var(--weline-space-2) var(--weline-space-3);
    border-radius: var(--weline-radius-sm);
    color: var(--weline-theme-text);
    text-decoration: none;
}

.<?= $wc ?> .dropdown-item:hover {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .dropdown-header {
    margin: 0;
    padding: var(--weline-space-2) var(--weline-space-3);
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-xs);
    font-weight: var(--weline-font-weight-semibold);
    text-transform: uppercase;
}

.<?= $wc ?> .dropdown-divider {
    height: var(--spacing-px);
    margin: var(--weline-space-1) 0;
    background: var(--weline-theme-border);
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var trigger = root.querySelector('[data-w-menu-trigger]');
    var panel = root.querySelector('[data-w-menu-panel]');
    if (!trigger || !panel) return;

    function setOpen(open) {
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.setAttribute('data-state', open ? 'open' : 'closed');
        panel.setAttribute('aria-hidden', open ? 'false' : 'true');
        panel.hidden = !open;
    }

    trigger.addEventListener('click', function (event) {
        event.preventDefault();
        setOpen(panel.hidden);
    });

    document.addEventListener('click', function (event) {
        if (!root.contains(event.target)) {
            setOpen(false);
        }
    });
})();
</script>
