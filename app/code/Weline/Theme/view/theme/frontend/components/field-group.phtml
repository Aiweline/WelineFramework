<?php
/**
 * 组件：Field Group
 *
 * @meta.name {default="Field Group 字段分组",name="Field Group 字段分组",description="可嵌套字段的字段集"}
 * @meta.description {default="可嵌套字段的字段集",name="描述",description="组件用途"}
 * @widget.supports {["builder-component","builder-container","builder-field"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @widget.is_container {true}
 * @widget.slots {"fields":{"id":"field-group:{layout_id}","name":"字段分组","accept":["builder-field"],"multiple":true}}
 * @param.legend {default="字段分组",name="标题",description="分组标题"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('field-group');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$layoutId = (string)($this->getData('layout_id') ?? $this->getData('_layout_id') ?? 'preview');
$legend = (string)($this->getData('legend') ?? $this->getData('meta.legend') ?? __('字段分组'));
$editorMode = (bool)($this->getData('editor_mode') ?? $this->getData('preview_mode') ?? false);
$slotId = 'field-group:' . ($layoutId !== '' ? $layoutId : 'preview');
?>

<fieldset class="<?= $esc($wc) ?> w-builder-field-group"
          weline-code="<?= $esc($scope->code) ?>"
          data-uid="<?= $esc($scope->uid) ?>"
          data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($legend !== ''): ?>
        <legend class="field-group-legend"><?= $esc($legend) ?></legend>
    <?php endif; ?>
    <div class="field-group-body"
         data-wslot="<?= $esc($slotId) ?>"
         data-wslot-name="<?= $esc((string)__('字段分组')) ?>"
         data-wslot-accept="builder-field"
         data-wslot-multiple="true">
        <?php if ($editorMode): ?>
            <div class="w-builder-slot-placeholder slot-placeholder"><?= __('拖入字段') ?></div>
        <?php endif; ?>
    </div>
</fieldset>

<style>
.<?= $wc ?> {
    margin: 0 0 var(--weline-space-4);
    padding: var(--weline-space-4);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface);
}

.<?= $wc ?> .field-group-legend {
    padding: 0 var(--weline-space-2);
    color: var(--weline-theme-text);
    font-size: var(--weline-font-size-base);
    font-weight: var(--weline-font-weight-semibold);
}

.<?= $wc ?> .field-group-body {
    display: grid;
    gap: var(--weline-space-3);
}
</style>
