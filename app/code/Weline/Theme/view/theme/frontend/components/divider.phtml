<?php
/**
 * 组件：Divider
 *
 * @meta.name {default="Divider 分割线",name="Divider 分割线",description="用于分隔页面内容区域"}
 * @meta.description {default="用于分隔页面内容区域",name="描述",description="组件用途"}
 * @widget.supports {["builder-component","builder-display"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param.label {default="",name="中间文字",description="可选的分割线文字"}
 * @param.style {default="solid",name="线条样式",description="solid/dashed/dotted"}
 * @param.labelPosition {default="center",name="文字位置",description="start/center/end"}
 * @param.color {default="",name="线条颜色",description="支持 #ddd、rgba()、var(--token)"}
 * @param.thickness {default="",name="线条粗细",description="例如 1px、2px"}
 * @param.spacing {default="",name="上下间距",description="例如 24px、3rem"}
 * @param.maxWidth {default="",name="最大宽度",description="例如 960px、80%"}
 * @param.class {default="",name="额外 CSS 类",description="追加样式类"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('divider');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

if (!function_exists('weline_builder_component_css_length')) {
    function weline_builder_component_css_length(mixed $value, string $fallback = ''): string
    {
        $value = trim((string)$value);
        if ($value === '') {
            return $fallback;
        }
        if (preg_match('/^(0|[0-9]+(?:\.[0-9]+)?(?:px|rem|em|%|vh|vw|svh|lvh|dvh))$/', $value)) {
            return $value;
        }
        if (preg_match('/^clamp\([0-9a-zA-Z%.,\s+\-]+\)$/', $value)) {
            return $value;
        }
        return $fallback;
    }
}

$label = (string)($this->getData('label') ?? $this->getData('meta.label') ?? '');
$style = strtolower(trim((string)($this->getData('style') ?? $this->getData('meta.style') ?? 'solid')));
$labelPosition = strtolower(trim((string)($this->getData('labelPosition') ?? $this->getData('meta.labelPosition') ?? 'center')));
$color = ThemeUiColor::sanitize(
    $this->getData('color') ?? $this->getData('meta.color') ?? '',
    'var(--weline-theme-border)'
);
$thickness = weline_builder_component_css_length($this->getData('thickness') ?? $this->getData('meta.thickness') ?? '', '1px');
$spacing = weline_builder_component_css_length($this->getData('spacing') ?? $this->getData('meta.spacing') ?? '', 'var(--weline-space-6, 24px)');
$maxWidth = weline_builder_component_css_length($this->getData('maxWidth') ?? $this->getData('meta.maxWidth') ?? '');
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));

$allowedStyles = ['solid', 'dashed', 'dotted'];
if (!in_array($style, $allowedStyles, true)) {
    $style = 'solid';
}
$allowedLabelPositions = ['start', 'center', 'end'];
if (!in_array($labelPosition, $allowedLabelPositions, true)) {
    $labelPosition = 'center';
}

$rootStyle = '--wc-divider-color:' . $color . ';'
    . '--wc-divider-thickness:' . $thickness . ';'
    . '--wc-divider-spacing:' . $spacing . ';';
if ($maxWidth !== '') {
    $rootStyle .= '--wc-divider-max:' . $maxWidth . ';';
}

$rootClass = trim($wc . ' w-builder-divider w-builder-divider--' . $style . ' w-builder-divider-label-' . $labelPosition . ($class !== '' ? ' ' . $class : ''));
?>

<div class="<?= $esc($rootClass) ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>"
     style="<?= $esc($rootStyle) ?>"
     role="separator"
     aria-orientation="horizontal">
    <?php if ($label !== ''): ?>
        <span class="divider-label"><?= $esc($label) ?></span>
    <?php endif; ?>
</div>

<style>
.<?= $wc ?> {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
    width: 100%;
    max-width: var(--wc-divider-max);
    margin-block: var(--wc-divider-spacing);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>::before,
.<?= $wc ?>::after {
    content: '';
    flex: 1;
    border-block-start: var(--wc-divider-thickness) <?= $esc($style) ?> var(--wc-divider-color);
}

.<?= $wc ?>:not(:has(.divider-label))::after {
    display: none;
}

.<?= $wc ?>.w-builder-divider-label-start::before {
    flex: 0 0 10%;
}

.<?= $wc ?>.w-builder-divider-label-end::after {
    flex: 0 0 10%;
}

.<?= $wc ?> .divider-label {
    flex-shrink: 0;
    font-size: var(--weline-font-size-sm);
    white-space: nowrap;
}
</style>
