<!--
组件：Badge

徽章组件，用于显示标签和状态
字段
@meta.name {default="Badge徽章组件",name="Badge徽章组件",description="Badge徽章组件，用于描述组件的名称"}
@meta.description {default="徽章组件，用于显示标签和状态",name="徽章组件，用于显示标签和状态",description="徽章组件，用于显示标签和状态，用于描述组件的用途"}
@widget.supports {["builder-component","builder-display"]}
@widget.position {["content"]}
@widget.page_layouts {["*","dashboard"]}
@widget.compatible {true}
@param.text {default="标签",name="徽章文字",description="徽章文字，必填参数"}
@param.type {default="primary",name="类型",description="类型，可选值：primary/secondary/success/danger/warning/info"}
@param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
@param.id {default="",name="元素ID",description="元素ID，用于设置徽章ID"}
-->
<?php
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('badge');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$text = $this->getData('text') ?? $this->getData('meta.text') ?? __('标签');
$type = strtolower(trim((string)($this->getData('type') ?? $this->getData('meta.type') ?? 'primary')));
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? ''));

$allowedTypes = ['primary', 'secondary', 'success', 'danger', 'warning', 'info'];
if (!in_array($type, $allowedTypes, true)) {
    $type = 'primary';
}

$rootClass = trim($wc . ' w-badge w-badge-' . $type . ($class !== '' ? ' ' . $class : ''));
?>

<span class="<?= $esc($rootClass) ?>"
      weline-code="<?= $esc($scope->code) ?>"
      data-uid="<?= $esc($scope->uid) ?>"
      data-js-ns="<?= $esc($scope->jsNs) ?>"
      data-tone="<?= $esc($type) ?>"<?= $id !== '' ? ' id="' . $esc($id) . '"' : '' ?>>
    <?= $esc((string)$text) ?>
</span>

<style>
.<?= $wc ?> {
    display: inline-flex;
    align-items: center;
    padding: var(--weline-space-1) var(--weline-space-2);
    font-size: var(--weline-font-size-xs);
    font-weight: var(--weline-font-weight-semibold);
    line-height: 1.2;
    border-radius: var(--weline-radius-round);
    background: var(--weline-theme-primary-surface);
    color: var(--weline-theme-primary);
}

.<?= $wc ?>[data-tone="secondary"] {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>[data-tone="success"] {
    background: var(--weline-theme-success-surface);
    color: var(--weline-theme-success);
}

.<?= $wc ?>[data-tone="danger"] {
    background: var(--weline-theme-danger-surface);
    color: var(--weline-theme-danger);
}

.<?= $wc ?>[data-tone="warning"] {
    background: var(--weline-theme-warning-surface);
    color: var(--weline-theme-warning);
}

.<?= $wc ?>[data-tone="info"] {
    background: var(--weline-theme-info-surface);
    color: var(--weline-theme-info);
}
</style>
