<?php
/**
 * 组件：Tabs
 *
 * @meta.name {default="Tabs 标签页",name="Tabs 标签页",description="可嵌套内容的标签页容器"}
 * @meta.description {default="可嵌套内容的标签页容器",name="描述",description="组件用途"}
 * @widget.supports {["builder-component","builder-container","builder-display"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @widget.is_container {true}
 * @widget.slots {"panel":{"id":"tabs-panel:{layout_id}:{tab_key}","name":"标签页内容","accept":["builder-component","builder-form","builder-display","builder-container"],"multiple":true}}
 * @param.tabs {default=["概览","详情"],name="标签",description="标签数组或 key=>label 数组"}
 */
$layoutId = (string)($this->getData('layout_id') ?? $this->getData('_layout_id') ?? 'preview');
$tabs = $this->getData('tabs') ?? $this->getData('meta.tabs') ?? ['概览', '详情'];
$editorMode = (bool)($this->getData('editor_mode') ?? $this->getData('preview_mode') ?? false);
if (!is_array($tabs) || $tabs === []) {
    $tabs = ['概览', '详情'];
}
$normalizedTabs = [];
foreach ($tabs as $key => $label) {
    $tabKey = is_string($key) ? preg_replace('/[^a-zA-Z0-9_-]+/', '-', $key) : 'tab-' . (count($normalizedTabs) + 1);
    $tabLabel = is_array($label) ? (string)($label['label'] ?? $label['name'] ?? $tabKey) : (string)$label;
    $normalizedTabs[] = ['key' => trim($tabKey, '-') ?: 'tab-' . (count($normalizedTabs) + 1), 'label' => $tabLabel];
}
$dragPlaceholder = __('拖入标签页内容');
?>
<section class="w-builder-tabs" weline-code="theme.components.section_1">
    <nav class="w-tabs w-tabs__list" role="tablist" data-w-component="tabs">
        <?php foreach ($normalizedTabs as $index => $tab): ?>
            <?php
            $tabLabelEsc = htmlspecialchars($tab['label'], ENT_QUOTES, 'UTF-8');
            $tabClass = 'w-tabs__tab w-tab' . ($index === 0 ? ' active' : '');
            $selected = $index === 0 ? 'true' : 'false';
            ?>
            <button class="<?= $tabClass ?>" type="button" role="tab" aria-selected="<?= $selected ?>" data-state="<?= $index === 0 ? 'active' : 'inactive' ?>">
                <?= $tabLabelEsc ?>
            </button>
        <?php endforeach; ?>
    </nav>
    <div class="w-tab-content w-tabs__content w-builder-tabs-content">
        <?php foreach ($normalizedTabs as $index => $tab): ?>
            <?php
            $panelSlotId = 'tabs-panel:' . ($layoutId !== '' ? $layoutId : 'preview') . ':' . $tab['key'];
            $panelSlotIdEsc = htmlspecialchars($panelSlotId, ENT_QUOTES, 'UTF-8');
            $tabLabelEsc = htmlspecialchars($tab['label'], ENT_QUOTES, 'UTF-8');
            $paneClass = 'w-tabs__panel w-tab-pane' . ($index === 0 ? ' is-active' : '');
            $paneHidden = $index === 0 ? 'false' : 'true';
            ?>
            <section class="<?= $paneClass ?>"
                     data-wslot="<?= $panelSlotIdEsc ?>"
                     data-wslot-name="<?= $tabLabelEsc ?>"
                     data-wslot-accept="builder-component,builder-form,builder-display,builder-container"
                     data-wslot-multiple="true"
                     role="tabpanel"
                     aria-hidden="<?= $paneHidden ?>"
                     weline-code="theme.components.section_2">
                <?php if ($editorMode): ?>
                    <div class="w-builder-slot-placeholder"><?= htmlspecialchars($dragPlaceholder, ENT_QUOTES, 'UTF-8') ?></div>
                <?php endif; ?>
            </section>
        <?php endforeach; ?>
    </div>
</section>
