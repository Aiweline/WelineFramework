<?php
/**
 * 组件：Loading
 *
 * 全局加载指示器组件（Theme UI host）。操作侧请用 Weline.UI.loading.show/hide/with。
 * 字段
 * @meta.name {default="Loading加载组件",name="Loading加载组件",description="Loading加载组件"}
 * @meta.description {default="全局加载指示器组件",name="全局加载指示器组件",description="全局加载指示器组件"}
 * @param.id {default="weline-global-loading",name="元素ID",description="元素ID"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类"}
 * @param.text {default="",name="加载文字提示",description="加载文字提示"}
 * @param.overlay {default=true,name="是否显示遮罩层",description="是否显示遮罩层"}
 * @param.autoHide {default=true,name="是否自动隐藏",description="页面加载后是否自动隐藏"}
 * @param.enabled {default=true,name="是否启用",description="为 false 时不输出 host"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('loading');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? 'weline-global-loading'));
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$text = (string)($this->getData('text') ?? $this->getData('meta.text') ?? '');
$overlay = (bool)($this->getData('overlay') ?? $this->getData('meta.overlay') ?? true);
$autoHide = (bool)($this->getData('autoHide') ?? $this->getData('meta.autoHide') ?? true);
$enabled = ($this->getData('enabled') ?? $this->getData('meta.enabled') ?? true) !== false;

if (!$enabled) {
    return;
}

$rootClass = trim($wc . ' w-loading' . ($class !== '' ? ' ' . $class : ''));
?>

<section id="<?= $esc($id) ?>"
         class="<?= $esc($rootClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-w-component="loading"
         data-w-scope="global"
         data-state="<?= $autoHide ? 'closed' : 'open' ?>"
         role="status"
         aria-live="polite"
         aria-hidden="<?= $autoHide ? 'true' : 'false' ?>"<?= $autoHide ? ' hidden' : '' ?>>
    <?php if ($overlay): ?>
        <span class="w-loading__backdrop loading-backdrop" aria-hidden="true"></span>
    <?php endif; ?>
    <span class="w-loading__content loading-content">
        <span class="w-spinner loading-spinner" aria-hidden="true"></span>
        <span class="loading-message" data-w-loading-message><?= $esc($text) ?></span>
    </span>
</section>

<style>
.<?= $wc ?> {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
}

.<?= $wc ?>[data-state="closed"],
.<?= $wc ?>[hidden] {
    display: none;
}

.<?= $wc ?> .loading-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--weline-theme-canvas) 72%, transparent);
}

.<?= $wc ?> .loading-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--weline-space-3);
    padding: var(--weline-space-6);
    border-radius: var(--weline-radius-lg);
    background: var(--weline-theme-surface-raised);
    color: var(--weline-theme-text);
    box-shadow: var(--weline-shadow-md);
}

.<?= $wc ?> .loading-spinner {
    width: var(--spacing-xl);
    height: var(--spacing-xl);
    border: var(--border-width-thick) solid var(--weline-theme-border);
    border-top-color: var(--weline-theme-primary);
    border-radius: 50%;
    animation: <?= $esc($scope->jsNs) ?>-spin 0.8s linear infinite;
}

.<?= $wc ?> .loading-message {
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
}

@keyframes <?= $scope->jsNs ?>-spin {
    to { transform: rotate(360deg); }
}
</style>

<?php if ($autoHide): ?>
<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;
    function ensureClosed() {
        if (document.documentElement && document.documentElement.dataset.wGlobalLoading === 'true') {
            return;
        }
        root.setAttribute('data-state', 'closed');
        root.setAttribute('aria-hidden', 'true');
        root.hidden = true;
    }
    if (document.readyState === 'complete') {
        ensureClosed();
    } else {
        window.addEventListener('load', ensureClosed, { once: true });
    }
})();
</script>
<?php endif; ?>
