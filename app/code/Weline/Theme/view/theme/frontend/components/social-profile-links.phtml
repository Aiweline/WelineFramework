<?php
/**
 * Shared social profile icon links (footer row + edge float).
 *
 * @var \Weline\Framework\View\Template $this
 * @param items list<array{name?:string,icon?:string,url?:string}>
 * @param link_class string
 * @param icon_class string
 * @param icon_size string|int
 */

use Weline\Theme\Helper\FooterDefaultLinksHelper;
use Weline\Theme\Helper\SocialIconHelper;
use Weline\Theme\Helper\WidgetI18n;

$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$label = static function (mixed $value) use ($esc): string {
    $raw = trim((string)$value);
    if ($raw === '') {
        return '';
    }

    return $esc(WidgetI18n::label($raw));
};

$items = $this->getData('items');
if (!is_array($items) || $items === []) {
    return;
}

$linkClass = trim((string)($this->getData('link_class') ?? 'footer-social-link'));
if ($linkClass === '') {
    $linkClass = 'footer-social-link';
}
$iconClass = trim((string)($this->getData('icon_class') ?? 'footer-social-icon'));
if ($iconClass === '') {
    $iconClass = 'footer-social-icon';
}
$iconSize = (string)($this->getData('icon_size') ?? '20');
if (!preg_match('/^\d{1,3}$/', $iconSize)) {
    $iconSize = '20';
}

foreach ($items as $social) {
    if (!is_array($social)) {
        continue;
    }
    $socialName = trim((string)($social['name'] ?? ''));
    $socialUrl = trim((string)($social['url'] ?? '#'));
    $platform = FooterDefaultLinksHelper::resolveSocialPlatformCode($social);
    $iconSvg = SocialIconHelper::renderIcon($platform, [
        'class' => $iconClass,
        'width' => $iconSize,
        'height' => $iconSize,
    ]);
    ?>
    <a class="<?= $esc($linkClass) ?>"
       href="<?= $esc($socialUrl !== '' ? $socialUrl : '#') ?>"
       title="<?= $label($socialName) ?>"
       aria-label="<?= $label($socialName) ?>"
       target="_blank"
       rel="noopener noreferrer">
        <?php if ($iconSvg !== ''): ?>
            <?= $iconSvg ?>
        <?php elseif (!empty($social['icon'])): ?>
            <i class="<?= $esc((string)$social['icon']) ?>" aria-hidden="true"></i>
        <?php endif; ?>
        <span class="w-visually-hidden"><?= $label($socialName) ?></span>
    </a>
    <?php
}
