<?php
/**
 * 组件：Image
 *
 * @meta.name {default="Image 图片媒体",name="Image 图片媒体",description="用于展示图片、说明和链接的媒体组件"}
 * @meta.description {default="用于展示图片、说明和链接的媒体组件",name="描述",description="组件用途"}
 * @widget.supports {["builder-component","builder-display"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param.src {default="",type="image",name="图片",description="从媒体库选择图片"}
 * @param.alt {default="图片",name="替代文本",description="图片 alt 文本"}
 * @param.caption {default="",name="图片说明",description="图片下方说明"}
 * @param.href {default="",name="链接地址",description="点击图片跳转地址"}
 * @param.ratio {default="16x9",name="宽高比",description="auto/1x1/4x3/16x9/21x9"}
 * @param.objectFit {default="cover",name="填充方式",description="cover/contain"}
 * @param.objectPosition {default="center",name="图片焦点",description="center/top/bottom/left/right"}
 * @param.align {default="start",name="对齐方式",description="start/center/end"}
 * @param.maxWidth {default="",name="最大宽度",description="例如 640px、100%"}
 * @param.radius {default="",name="圆角",description="例如 24px"}
 * @param.shadow {default="none",name="阴影",description="none/sm/md/lg"}
 * @param.class {default="",name="额外 CSS 类",description="追加样式类"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('image');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

if (!function_exists('weline_builder_component_css_length')) {
    function weline_builder_component_css_length(mixed $value, string $fallback = ''): string
    {
        $value = trim((string)$value);
        if ($value === '') {
            return $fallback;
        }
        if (preg_match('/^(0|[0-9]+(?:\.[0-9]+)?(?:px|rem|em|%|vh|vw|svh|lvh|dvh))$/', $value)) {
            return $value;
        }
        if (preg_match('/^clamp\([0-9a-zA-Z%.,\s+\-]+\)$/', $value)) {
            return $value;
        }
        return $fallback;
    }
}

$src = LegacyMediaUrl::sanitize($this->getData('src') ?? $this->getData('meta.src') ?? '');
$srcFileHtml = (string)($this->getData('src_file_html') ?? '');
$alt = (string)($this->getData('alt') ?? $this->getData('meta.alt') ?? __('图片'));
$caption = (string)($this->getData('caption') ?? $this->getData('meta.caption') ?? '');
$href = LegacyMediaUrl::sanitize($this->getData('href') ?? $this->getData('meta.href') ?? '');
$ratio = strtolower(trim((string)($this->getData('ratio') ?? $this->getData('meta.ratio') ?? '16x9')));
$objectFit = strtolower(trim((string)($this->getData('objectFit') ?? $this->getData('meta.objectFit') ?? 'cover')));
$objectPosition = strtolower(trim((string)($this->getData('objectPosition') ?? $this->getData('meta.objectPosition') ?? 'center')));
$align = strtolower(trim((string)($this->getData('align') ?? $this->getData('meta.align') ?? 'start')));
$maxWidth = weline_builder_component_css_length($this->getData('maxWidth') ?? $this->getData('meta.maxWidth') ?? '');
$radius = weline_builder_component_css_length($this->getData('radius') ?? $this->getData('meta.radius') ?? '', 'var(--weline-radius-md, 8px)');
$shadow = strtolower(trim((string)($this->getData('shadow') ?? $this->getData('meta.shadow') ?? 'none')));
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));

$allowedRatios = ['auto', '1x1', '4x3', '16x9', '21x9'];
$allowedObjectFit = ['cover', 'contain'];
$allowedPosition = ['center', 'top', 'bottom', 'left', 'right'];
$allowedAlign = ['start', 'center', 'end'];
$allowedShadow = ['none', 'sm', 'md', 'lg'];
if (!in_array($ratio, $allowedRatios, true)) {
    $ratio = '16x9';
}
if (!in_array($objectFit, $allowedObjectFit, true)) {
    $objectFit = 'cover';
}
if (!in_array($objectPosition, $allowedPosition, true)) {
    $objectPosition = 'center';
}
if (!in_array($align, $allowedAlign, true)) {
    $align = 'start';
}
if (!in_array($shadow, $allowedShadow, true)) {
    $shadow = 'none';
}

if ($src === '' && $srcFileHtml === '') {
    $src = ThemeDemoCatalog::productImage(0);
    if ($alt === __('图片')) {
        $alt = __('春季系列展示');
    }
    if ($caption === '') {
        $caption = __('可在属性面板替换为媒体库图片');
    }
}

$ratioMap = [
    'auto' => 'auto',
    '1x1' => '1 / 1',
    '4x3' => '4 / 3',
    '16x9' => '16 / 9',
    '21x9' => '21 / 9',
];

$rootStyle = '--wc-image-max:' . ($maxWidth !== '' ? $maxWidth : '100%') . ';'
    . '--wc-image-radius:' . $radius . ';'
    . '--wc-image-object-position:' . $objectPosition . ';'
    . '--wc-image-ratio:' . ($ratioMap[$ratio] ?? '16 / 9') . ';';

$rootClass = trim($wc . ' w-builder-image w-builder-image--' . $ratio . ' w-builder-image--' . $objectFit . ' w-builder-align-' . $align . ' w-builder-shadow-' . $shadow . ($class !== '' ? ' ' . $class : ''));

$mediaHtml = $src !== ''
    ? '<img src="' . $esc($src) . '" alt="' . $esc($alt) . '" loading="lazy" class="image-media">'
    : '<div class="w-builder-image__placeholder image-placeholder">' . $esc(__('添加图片地址')) . '</div>';
?>

<?php if ($srcFileHtml !== ''): ?>
<div class="<?= $esc($rootClass . ' w-builder-image__asset') ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>"
     data-shadow="<?= $esc($shadow) ?>"
     style="<?= $esc($rootStyle) ?>">
    <?php if ($href !== ''): ?>
        <a class="w-builder-image__link image-link" href="<?= $esc($href) ?>"><?= $srcFileHtml ?></a>
    <?php else: ?>
        <?= $srcFileHtml ?>
    <?php endif; ?>
    <?php if ($caption !== ''): ?>
        <figcaption class="w-builder-image__caption image-caption"><?= $esc($caption) ?></figcaption>
    <?php endif; ?>
</div>
<?php else: ?>
<figure class="<?= $esc($rootClass) ?>"
        weline-code="<?= $esc($scope->code) ?>"
        data-uid="<?= $esc($scope->uid) ?>"
        data-js-ns="<?= $esc($scope->jsNs) ?>"
        data-shadow="<?= $esc($shadow) ?>"
        style="<?= $esc($rootStyle) ?>">
    <div class="image-frame">
        <?php if ($href !== '' && $src !== ''): ?>
            <a class="w-builder-image__link image-link" href="<?= $esc($href) ?>">
                <?= $mediaHtml ?>
            </a>
        <?php else: ?>
            <?= $mediaHtml ?>
        <?php endif; ?>
    </div>
    <?php if ($caption !== ''): ?>
        <figcaption class="w-builder-image__caption image-caption"><?= $esc($caption) ?></figcaption>
    <?php endif; ?>
</figure>
<?php endif; ?>

<style>
.<?= $wc ?> {
    display: block;
    max-width: var(--wc-image-max);
    margin: 0;
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>.w-builder-align-center {
    margin-inline: auto;
}

.<?= $wc ?>.w-builder-align-end {
    margin-left: auto;
}

.<?= $wc ?>[data-shadow="sm"] .image-frame {
    box-shadow: var(--weline-shadow-sm);
}

.<?= $wc ?>[data-shadow="md"] .image-frame {
    box-shadow: var(--weline-shadow-md);
}

.<?= $wc ?>[data-shadow="lg"] .image-frame {
    box-shadow: var(--weline-shadow-lg);
}

.<?= $wc ?> .image-frame {
    overflow: hidden;
    border-radius: var(--wc-image-radius);
    background: var(--weline-theme-surface-muted);
    aspect-ratio: var(--wc-image-ratio);
}

.<?= $wc ?>.w-builder-image--auto .image-frame {
    aspect-ratio: auto;
}

.<?= $wc ?> .image-link,
.<?= $wc ?> .image-media,
.<?= $wc ?> img {
    display: block;
    width: 100%;
    height: 100%;
}

.<?= $wc ?>.w-builder-image--cover .image-media,
.<?= $wc ?>.w-builder-image--cover img {
    object-fit: cover;
    object-position: var(--wc-image-object-position);
}

.<?= $wc ?>.w-builder-image--contain .image-media,
.<?= $wc ?>.w-builder-image--contain img {
    object-fit: contain;
    object-position: var(--wc-image-object-position);
}

.<?= $wc ?> .image-placeholder {
    display: grid;
    place-items: center;
    min-height: var(--token-size-12rem);
    padding: var(--weline-space-4);
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .image-caption {
    margin-top: var(--weline-space-2);
    font-size: var(--weline-font-size-sm);
    text-align: center;
}
</style>
