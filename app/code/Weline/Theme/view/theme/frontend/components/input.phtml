<?php
/**
 * 组件：Input
 *
 * 输入框组件，支持多种类型和验证
 * 字段
 * @meta.name {default="Input输入框组件",name="Input输入框组件",description="Input输入框组件，用于描述组件的名称"}
 * @meta.description {default="输入框组件，支持多种类型和验证",name="输入框组件，支持多种类型和验证",description="输入框组件，支持多种类型和验证，用于描述组件的用途"}
 * @widget.supports {["builder-component","builder-field"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param.name {default="",name="字段名",description="字段名，必填参数"}
 * @param.type {default="text",name="输入类型",description="输入类型，可选值：text/password/email/tel/number等"}
 * @param.label {default="",name="标签文字",description="标签文字，用于设置标签文字"}
 * @param.placeholder {default="",name="占位符",description="占位符，用于设置占位符"}
 * @param.value {default="",name="默认值",description="默认值，用于设置默认值"}
 * @param.required {default=false,name="是否必填",description="是否必填，用于控制字段的必填状态"}
 * @param.disabled {default=false,name="是否禁用",description="是否禁用，用于控制字段的禁用状态"}
 * @param.readonly {default=false,name="是否只读",description="是否只读，用于控制字段的只读状态"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
 * @param.id {default="",name="元素ID",description="元素ID，用于设置输入框ID"}
 * @param.help {default="",name="帮助文字",description="帮助文字，用于设置帮助文字"}
 * @param.error {default="",name="错误信息",description="错误信息，用于设置错误信息"}
 * @param.icon {default="",name="图标类名",description="图标类名，用于设置输入框图标"}
 * @param.autocomplete {default="",name="自动完成",description="自动完成，用于设置自动完成属性"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('input');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$name = (string)($this->getData('name') ?? $this->getData('meta.name') ?? '');
$type = (string)($this->getData('type') ?? $this->getData('meta.type') ?? 'text');
$label = (string)($this->getData('label') ?? $this->getData('meta.label') ?? '');
$placeholder = (string)($this->getData('placeholder') ?? $this->getData('meta.placeholder') ?? '');
$value = (string)($this->getData('value') ?? $this->getData('meta.value') ?? '');
$required = (bool)($this->getData('required') ?? $this->getData('meta.required') ?? false);
$disabled = (bool)($this->getData('disabled') ?? $this->getData('meta.disabled') ?? false);
$readonly = (bool)($this->getData('readonly') ?? $this->getData('meta.readonly') ?? false);
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$id = (string)($this->getData('id') ?? $this->getData('meta.id') ?? $name);
$help = (string)($this->getData('help') ?? $this->getData('meta.help') ?? '');
$error = (string)($this->getData('error') ?? $this->getData('meta.error') ?? '');
$icon = (string)($this->getData('icon') ?? $this->getData('meta.icon') ?? '');
$autocomplete = (string)($this->getData('autocomplete') ?? $this->getData('meta.autocomplete') ?? 'off');

$inputClass = trim('w-form-control w-input input-control' . ($error !== '' ? ' w-is-invalid' : '') . ($class !== '' ? ' ' . $class : ''));
$rootClass = trim($wc . ' w-form-group' . ($error !== '' ? ' has-error' : ''));
?>

<div class="<?= $esc($rootClass) ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($label !== ''): ?>
        <label for="<?= $esc($id) ?>" class="w-form-label input-label">
            <?= $esc($label) ?>
            <?php if ($required): ?>
                <span class="required-mark">*</span>
            <?php endif; ?>
        </label>
    <?php endif; ?>

    <div class="input-wrapper">
        <?php if ($icon !== ''): ?>
            <i class="<?= $esc($icon) ?> input-icon"></i>
        <?php endif; ?>
        <input type="<?= $esc($type) ?>"
               name="<?= $esc($name) ?>"
               id="<?= $esc($id) ?>"
               class="<?= $esc($inputClass) ?>"
               placeholder="<?= $esc($placeholder) ?>"
               value="<?= $esc($value) ?>"
               autocomplete="<?= $esc($autocomplete) ?>"
               <?= $required ? 'required' : '' ?>
               <?= $disabled ? 'disabled' : '' ?>
               <?= $readonly ? 'readonly' : '' ?>>
    </div>

    <?php if ($help !== '' && $error === ''): ?>
        <small class="w-form-text input-help"><?= $esc($help) ?></small>
    <?php endif; ?>

    <?php if ($error !== ''): ?>
        <div class="w-invalid-feedback input-error"><?= $esc($error) ?></div>
    <?php endif; ?>
</div>

<style>
.<?= $wc ?> {
    display: grid;
    gap: var(--weline-space-2);
    margin-bottom: var(--weline-space-4);
}

.<?= $wc ?> .input-label {
    color: var(--weline-theme-text);
    font-size: var(--weline-font-size-sm);
    font-weight: var(--weline-font-weight-medium);
}

.<?= $wc ?> .required-mark {
    color: var(--weline-theme-danger);
    margin-left: var(--weline-space-1);
}

.<?= $wc ?> .input-wrapper {
    position: relative;
}

.<?= $wc ?> .input-icon {
    position: absolute;
    left: var(--weline-space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .input-wrapper:has(.input-icon) .input-control {
    padding-left: calc(var(--weline-space-3) + var(--weline-space-5));
}

.<?= $wc ?> .input-control {
    width: 100%;
    padding: var(--weline-space-2) var(--weline-space-3);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface);
    color: var(--weline-theme-text);
    font-size: var(--weline-font-size-base);
}

.<?= $wc ?> .input-control:focus {
    outline: var(--spacing-0_5) solid color-mix(in srgb, var(--weline-theme-primary) 35%, transparent);
    outline-offset: var(--spacing-px);
}

.<?= $wc ?> .input-control:disabled {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-text-muted);
    cursor: not-allowed;
}

.<?= $wc ?> .input-help {
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?> .input-error {
    color: var(--weline-theme-danger);
    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?>.has-error .input-control {
    border-color: var(--weline-theme-danger);
}
</style>
