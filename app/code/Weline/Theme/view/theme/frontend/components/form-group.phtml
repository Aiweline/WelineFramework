<!--
组件：FormGroup

表单组组件，用于包装表单字段
字段
@meta.name {default="FormGroup表单组组件",name="FormGroup表单组组件",description="FormGroup表单组组件，用于描述组件的名称"}
@meta.description {default="表单组组件，用于包装表单字段",name="表单组组件，用于包装表单字段",description="表单组组件，用于包装表单字段，用于描述组件的用途"}
@widget.supports {["builder-component","builder-field","builder-container"]}
@widget.position {["content"]}
@widget.page_layouts {["*","dashboard"]}
@widget.compatible {true}
@param.label {default="",name="字段标签",description="字段标签，用于设置字段标签"}
@param.input {default="",name="输入框HTML",description="输入框HTML，必填参数"}
@param.help {default="",name="帮助文字",description="帮助文字，用于设置帮助文字"}
@param.error {default="",name="错误信息",description="错误信息，用于设置错误信息"}
@param.required {default=false,name="是否必填",description="是否必填，用于控制字段的必填状态"}
@param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
-->
<?php
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('form-group');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$label = (string)($this->getData('label') ?? $this->getData('meta.label') ?? '');
$input = (string)($this->getData('input') ?? $this->getData('meta.input') ?? '');
$help = (string)($this->getData('help') ?? $this->getData('meta.help') ?? '');
$error = (string)($this->getData('error') ?? $this->getData('meta.error') ?? '');
$required = (bool)($this->getData('required') ?? $this->getData('meta.required') ?? false);
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));

$rootClass = trim($wc . ' w-form-group' . ($error !== '' ? ' has-error' : '') . ($class !== '' ? ' ' . $class : ''));
?>

<div class="<?= $esc($rootClass) ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($label !== ''): ?>
        <label class="w-form-label form-group-label">
            <?= $esc($label) ?>
            <?php if ($required): ?>
                <span class="required-mark"><?= $esc('*') ?></span>
            <?php endif; ?>
        </label>
    <?php endif; ?>

    <div class="form-group-input">
        <?= $input !== '' ? $input : '{{input}}' ?>
    </div>

    <?php if ($help !== '' && $error === ''): ?>
        <small class="w-form-text form-group-help"><?= $esc($help) ?></small>
    <?php endif; ?>

    <?php if ($error !== ''): ?>
        <div class="w-invalid-feedback form-group-error"><?= $esc($error) ?></div>
    <?php endif; ?>
</div>

<style>
.<?= $wc ?> {
    display: grid;
    gap: var(--weline-space-2);
    margin-bottom: var(--weline-space-4);
}

.<?= $wc ?> .form-group-label {
    color: var(--weline-theme-text);
    font-size: var(--weline-font-size-sm);
    font-weight: var(--weline-font-weight-medium);
}

.<?= $wc ?> .required-mark {
    color: var(--weline-theme-danger);
    margin-left: var(--weline-space-1);
}

.<?= $wc ?> .form-group-help {
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?> .form-group-error {
    color: var(--weline-theme-danger);
    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?>.has-error .w-form-control,
.<?= $wc ?>.has-error .w-input,
.<?= $wc ?>.has-error .w-textarea,
.<?= $wc ?>.has-error .w-select {
    border-color: var(--weline-theme-danger);
}
</style>
