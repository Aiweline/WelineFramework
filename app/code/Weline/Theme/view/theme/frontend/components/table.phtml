<?php
/**
 * 组件：Table
 *
 * 表格组件，用于展示结构化数据
 * 字段
 * @meta.name {default="Table表格组件",name="Table表格组件",description="Table表格组件，用于描述组件的名称"}
 * @meta.description {default="表格组件，用于展示结构化数据",name="表格组件，用于展示结构化数据",description="表格组件，用于展示结构化数据，用于描述组件的用途"}
 * @widget.supports {["builder-component","builder-display"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param headers {default=[],name="表头数组",description="表头数组，必填参数"}
 * @param rows {default=[],name="数据行数组",description="数据行数组，必填参数"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
 * @param.id {default="",name="元素ID",description="元素ID，用于设置表格ID"}
 * @param.striped {default=false,name="是否条纹样式",description="是否条纹样式，用于控制表格的条纹样式"}
 * @param.bordered {default=false,name="是否带边框",description="是否带边框，用于控制表格的边框显示"}
 * @param.hover {default=false,name="是否悬停效果",description="是否悬停效果，用于控制表格的悬停效果"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('table');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$headers = $this->getData('headers') ?? $this->getData('meta.headers') ?? [];
$rows = $this->getData('rows') ?? $this->getData('meta.rows') ?? [];
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$id = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? ''));
$striped = (bool)($this->getData('striped') ?? $this->getData('meta.striped') ?? false);
$bordered = (bool)($this->getData('bordered') ?? $this->getData('meta.bordered') ?? false);
$hover = (bool)($this->getData('hover') ?? $this->getData('meta.hover') ?? false);

if ($headers === []) {
    $headers = [__('指标'), __('状态'), __('趋势')];
}
if ($rows === []) {
    $rows = [
        [__('订单'), __('正常'), '+12%'],
        [__('支付'), __('稳定'), '+4%'],
    ];
}

$tableClass = trim('w-table table-inner'
    . ($striped ? ' w-table-striped is-striped' : '')
    . ($bordered ? ' w-table-bordered is-bordered' : '')
    . ($hover ? ' w-table-hover is-hover' : '')
    . ($class !== '' ? ' ' . $class : ''));

$rootClass = trim($wc . ' w-table-wrap');
?>

<section class="<?= $esc($rootClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="table-scroll">
        <table class="<?= $esc($tableClass) ?>"<?= $id !== '' ? ' id="' . $esc($id) . '"' : '' ?>>
            <?php if ($headers !== []): ?>
                <thead>
                    <tr>
                        <?php foreach ($headers as $header): ?>
                            <th><?= $esc((string)$header) ?></th>
                        <?php endforeach; ?>
                    </tr>
                </thead>
            <?php endif; ?>
            <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <?php foreach ($row as $cell): ?>
                            <td><?= $esc((string)(is_array($cell) ? ($cell['content'] ?? '') : $cell)) ?></td>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</section>

<style>
.<?= $wc ?> {
    width: 100%;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .table-scroll {
    overflow-x: auto;
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface);
}

.<?= $wc ?> .table-inner {
    width: 100%;
    border-collapse: collapse;
}

.<?= $wc ?> th,
.<?= $wc ?> td {
    padding: var(--weline-space-3) var(--weline-space-4);
    text-align: left;
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?> th {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-text);
    font-size: var(--weline-font-size-sm);
    font-weight: var(--weline-font-weight-semibold);
}

.<?= $wc ?> tbody tr:last-child td {
    border-bottom: 0;
}

.<?= $wc ?> .is-striped tbody tr:nth-child(even) {
    background: var(--weline-theme-surface-muted);
}

.<?= $wc ?> .is-bordered th,
.<?= $wc ?> .is-bordered td {
    border-right: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?> .is-hover tbody tr:hover {
    background: color-mix(in srgb, var(--weline-theme-primary) 8%, var(--weline-theme-surface));
}
</style>
