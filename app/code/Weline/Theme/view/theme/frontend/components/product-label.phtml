<!--
组件：ProductLabel 商品标签

用于商品卡片上的 NEW / SALE 等角标，配色由主题色盘全局控制，部件可覆盖。
字段
@meta.name {default="商品标签",name="商品标签",description="商品标签组件名称"}
@meta.description {default="商品角标标签，支持主题全局配色与部件级覆盖",name="商品角标标签",description="商品角标标签组件用途"}
@widget.supports {["builder-component","builder-display"]}
@widget.position {["content"]}
@widget.page_layouts {["*","homepage","product"]}
@widget.compatible {true}
@param.kind {default="new",name="标签类型",description="标签类型：new / sale / demo"}
@param.text {default="",name="标签文字",description="留空时使用类型默认文案"}
@param.class {default="",name="额外CSS类",description="额外 CSS 类名"}
@param.icon {default="",name="图标",description="可选图标名"}
-->
<?php

use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('product-label');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$kind = strtolower(trim((string)($this->getData('kind') ?? $this->getData('meta.kind') ?? ProductLabelStyle::KIND_NEW)));
if (!in_array($kind, ProductLabelStyle::KINDS, true)) {
    $kind = ProductLabelStyle::KIND_NEW;
}

$text = trim((string)($this->getData('text') ?? $this->getData('meta.text') ?? ''));
if ($text === '') {
    $text = match ($kind) {
        ProductLabelStyle::KIND_SALE => (string)__('SALE'),
        ProductLabelStyle::KIND_DEMO => (string)__('DEMO'),
        default => (string)__('NEW'),
    };
} elseif (preg_match('/\p{Han}/u', $text) === 1) {
    // Catalog/layout may bake Chinese badge copy; resolve by path locale.
    $text = WidgetI18n::label($text);
}

$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$icon = trim((string)($this->getData('icon') ?? $this->getData('meta.icon') ?? ''));
$rootClass = trim('w-product-label ' . $wc . ($class !== '' ? ' ' . $class : ''));
$backgroundColor = match ($kind) {
    ProductLabelStyle::KIND_SALE => 'var(--w-product-label-sale-bg, var(--weline-product-label-sale-bg, var(--color-product-label-sale-bg)))',
    ProductLabelStyle::KIND_DEMO => 'var(--w-product-label-demo-bg, var(--weline-product-label-demo-bg, var(--color-product-label-demo-bg)))',
    default => 'var(--w-product-label-new-bg, var(--weline-product-label-new-bg, var(--color-product-label-new-bg)))',
};
$textColor = match ($kind) {
    ProductLabelStyle::KIND_SALE => 'var(--w-product-label-sale-text, var(--weline-product-label-sale-text, var(--color-product-label-sale-text)))',
    ProductLabelStyle::KIND_DEMO => 'var(--w-product-label-demo-text, var(--weline-product-label-demo-text, var(--color-product-label-demo-text)))',
    default => 'var(--w-product-label-new-text, var(--weline-product-label-new-text, var(--color-product-label-new-text)))',
};
$inlineStyle = 'background: ' . $backgroundColor
    . '; color: ' . $textColor
    . '; box-shadow: inset 0 0 0 1px color-mix(in srgb, ' . $textColor . ' 12%, transparent);';
?>

<span class="<?= $esc($rootClass) ?>"
      data-kind="<?= $esc($kind) ?>"
      style="<?= $esc($inlineStyle) ?>"
      weline-code="<?= $esc($scope->code) ?>"
      data-uid="<?= $esc($scope->uid) ?>"
      data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($icon !== ''): ?>
        <w:icon name="<?= $esc($icon) ?>" size="sm"></w:icon>
    <?php endif; ?>
    <?= $esc($text) ?>
</span>
