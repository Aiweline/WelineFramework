<?php
/**
 * 组件：Alert
 *
 * 提示信息组件，支持多种类型和样式
 * 字段
 * @meta.name {default="Alert提示组件",name="Alert提示组件",description="Alert提示组件，用于描述组件的名称"}
 * @meta.description {default="提示信息组件，支持多种类型和样式",name="提示信息组件，支持多种类型和样式",description="提示信息组件，支持多种类型和样式，用于描述组件的用途"}
 * @widget.supports {["builder-component","builder-display"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @param type {default="info",name="类型",description="类型，可选值：success/error/warning/info"}
 * @param message {default="您的订单已支付成功，预计 2 个工作日内发货。",name="提示信息",description="提示信息，必填参数"}
 * @param title {default="订单已确认",name="标题",description="标题，用于设置提示标题"}
 * @param dismissible {default=false,name="是否可关闭",description="是否可关闭，用于控制提示是否可关闭"}
 * @param icon {default="",name="自定义图标",description="自定义图标，用于设置自定义图标"}
 * @param class {default="",name="额外CSS类",description="额外CSS类，用于设置组件额外CSS类"}
 * @param html {default=false,name="是否解析HTML",description="是否解析HTML，设为true时message中的HTML标签会被渲染"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('alert');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$type = $this->getData('type') ?? $this->getData('meta.type') ?? 'info';
$message = $this->getData('message') ?? $this->getData('meta.message') ?? __('您的订单已支付成功，预计 2 个工作日内发货。');
$title = $this->getData('title') ?? $this->getData('meta.title') ?? __('订单已确认');
$dismissible = (bool)($this->getData('dismissible') ?? $this->getData('meta.dismissible') ?? false);
$icon = (string)($this->getData('icon') ?? $this->getData('meta.icon') ?? '');
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$allowHtml = (bool)($this->getData('html') ?? $this->getData('meta.html') ?? false);
$alertId = trim((string)($this->getData('id') ?? $this->getData('meta.id') ?? ''));

$tone = match ($type) {
    'success' => 'success',
    'error', 'danger' => 'danger',
    'warning' => 'warning',
    default => 'info',
};

if ($icon === '') {
    $icon = match ($tone) {
        'success' => 'check',
        'danger', 'warning' => 'warning',
        default => 'info',
    };
}

$rootClass = trim($wc . ' w-alert' . ($dismissible ? ' w-alert-dismissible' : '') . ($class !== '' ? ' ' . $class : ''));
?>

<section class="<?= $esc($rootClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-tone="<?= $esc($tone) ?>"
         role="alert"<?= $alertId !== '' ? ' id="' . $esc($alertId) . '"' : '' ?>>
    <?php if ($icon !== ''): ?>
        <w:icon name="icon" size="sm"></w:icon>
    <?php endif; ?>

    <div class="alert-content">
        <?php if ($title !== ''): ?>
            <strong class="alert-title"><?= $esc((string)$title) ?></strong>
        <?php endif; ?>

        <span class="alert-message">
            <?php if ($allowHtml): ?>
                <?= $message ?>
            <?php else: ?>
                <?= $esc((string)$message) ?>
            <?php endif; ?>
        </span>
    </div>

    <?php if ($dismissible): ?>
        <button type="button"
                class="w-button alert-close"
                data-tone="quiet"
                data-size="sm"
                aria-label="<?= $esc((string)__('关闭')) ?>">
            <w:icon name="close" size="sm"></w:icon>
        </button>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--weline-space-3);
    padding: var(--weline-space-4);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    border-radius: var(--weline-radius-md);
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-text);
}

.<?= $wc ?>[data-tone="success"] {
    background: var(--weline-theme-success-surface);
    color: var(--weline-theme-success);
    border-color: color-mix(in srgb, var(--weline-theme-success) 24%, var(--weline-theme-border));
}

.<?= $wc ?>[data-tone="danger"] {
    background: var(--weline-theme-danger-surface);
    color: var(--weline-theme-danger);
    border-color: color-mix(in srgb, var(--weline-theme-danger) 24%, var(--weline-theme-border));
}

.<?= $wc ?>[data-tone="warning"] {
    background: var(--weline-theme-warning-surface);
    color: var(--weline-theme-warning);
    border-color: color-mix(in srgb, var(--weline-theme-warning) 24%, var(--weline-theme-border));
}

.<?= $wc ?>[data-tone="info"] {
    background: var(--weline-theme-info-surface);
    color: var(--weline-theme-info);
    border-color: color-mix(in srgb, var(--weline-theme-info) 24%, var(--weline-theme-border));
}

.<?= $wc ?> .alert-content {
    display: grid;
    gap: var(--weline-space-1);
    min-width: 0;
}

.<?= $wc ?> .alert-title {
    font-weight: var(--weline-font-weight-semibold);
}

.<?= $wc ?> .alert-close {
    justify-self: end;
    align-self: start;
    color: inherit;
}

.<?= $wc ?>.is-hidden {
    display: none;
}
</style>

<?php if ($dismissible): ?>
<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var closeBtn = root.querySelector('.alert-close');
    if (!closeBtn) return;

    closeBtn.addEventListener('click', function () {
        root.classList.add('is-hidden');
    });
})();
</script>
<?php endif; ?>
