<?php
/**
 * 组件：Section
 *
 * @meta.name {default="Section 区块容器",name="Section 区块容器",description="带标题、说明和内嵌插槽的页面区块"}
 * @meta.description {default="带标题、说明和内嵌插槽的页面区块",name="描述",description="组件用途"}
 * @widget.supports {["builder-component","builder-container"]}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*","dashboard"]}
 * @widget.compatible {true}
 * @widget.is_container {true}
 * @widget.slots {"content":{"id":"section-content:{layout_id}","name":"区块内容","accept":["builder-component","builder-form","builder-display","builder-container"],"multiple":true}}
 * @param.title {default="区块标题",name="标题",description="区块标题"}
 * @param.subtitle {default="",name="副标题",description="区块副标题"}
 * @param.content {default="",name="说明内容",description="区块默认说明内容"}
 * @param.variant {default="default",name="区块样式",description="default/hero/cta/subtle"}
 * @param.align {default="start",name="对齐方式",description="start/center/end"}
 * @param.verticalAlign {default="top",name="垂直对齐",description="top/center/bottom"}
 * @param.padding {default="",name="内边距",description="例如 32px、4rem、clamp(32px,6vw,96px)"}
 * @param.minHeight {default="",name="最小高度",description="例如 420px、60vh"}
 * @param.maxWidth {default="",name="最大宽度",description="例如 1180px、90%"}
 * @param.radius {default="",name="圆角",description="例如 24px"}
 * @param.backgroundColor {default="",name="背景色",description="支持 #fff、rgba()、var(--token)"}
 * @param.backgroundImage {default="",type="image",name="背景图",description="从媒体库选择背景图片"}
 * @param.backgroundPosition {default="center",name="背景位置",description="center/top/bottom/left/right"}
 * @param.textColor {default="",name="文字颜色",description="支持 #111、rgba()、var(--token)"}
 * @param.class {default="",name="额外 CSS 类",description="追加样式类"}
 * @param.code {default="theme.builder.section",name="区块 Code",description="事件溯源用 weline-code，建议 theme.{layout}.{role}"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forComponent('section');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

if (!function_exists('weline_builder_component_css_length')) {
    function weline_builder_component_css_length(mixed $value, string $fallback = ''): string
    {
        $value = trim((string)$value);
        if ($value === '') {
            return $fallback;
        }
        if (preg_match('/^(0|[0-9]+(?:\.[0-9]+)?(?:px|rem|em|%|vh|vw|svh|lvh|dvh))$/', $value)) {
            return $value;
        }
        if (preg_match('/^clamp\([0-9a-zA-Z%.,\s+\-]+\)$/', $value)) {
            return $value;
        }
        return $fallback;
    }
}

$layoutId = (string)($this->getData('layout_id') ?? $this->getData('_layout_id') ?? 'preview');
$title = (string)($this->getData('title') ?? $this->getData('meta.title') ?? __('区块标题'));
$subtitle = (string)($this->getData('subtitle') ?? $this->getData('meta.subtitle') ?? '');
$content = (string)($this->getData('content') ?? $this->getData('meta.content') ?? '');
$variant = strtolower(trim((string)($this->getData('variant') ?? $this->getData('meta.variant') ?? 'default')));
$align = strtolower(trim((string)($this->getData('align') ?? $this->getData('meta.align') ?? 'start')));
$verticalAlign = strtolower(trim((string)($this->getData('verticalAlign') ?? $this->getData('meta.verticalAlign') ?? 'top')));
$padding = weline_builder_component_css_length($this->getData('padding') ?? $this->getData('meta.padding') ?? '');
$minHeight = weline_builder_component_css_length($this->getData('minHeight') ?? $this->getData('meta.minHeight') ?? '');
$maxWidth = weline_builder_component_css_length($this->getData('maxWidth') ?? $this->getData('meta.maxWidth') ?? '');
$radius = weline_builder_component_css_length($this->getData('radius') ?? $this->getData('meta.radius') ?? '');
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('backgroundColor') ?? $this->getData('meta.backgroundColor') ?? '',
    'var(--weline-theme-surface)'
);
$backgroundImage = LegacyMediaUrl::sanitize(
    $this->getData('backgroundImage') ?? $this->getData('meta.backgroundImage') ?? '',
    true,
);
$backgroundImageFileHtml = (string)($this->getData('backgroundImage_file_html') ?? '');
$backgroundPosition = strtolower(trim((string)($this->getData('backgroundPosition') ?? $this->getData('meta.backgroundPosition') ?? 'center')));
$textColor = ThemeUiColor::sanitize(
    $this->getData('textColor') ?? $this->getData('meta.textColor') ?? '',
    'var(--weline-theme-text)'
);
$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? ''));
$editorMode = (bool)($this->getData('editor_mode') ?? $this->getData('preview_mode') ?? false);
$slotId = 'section-content:' . ($layoutId !== '' ? $layoutId : 'preview');

$allowedVariants = ['default', 'hero', 'cta', 'subtle'];
$allowedAlign = ['start', 'center', 'end'];
$allowedVerticalAlign = ['top', 'center', 'bottom'];
$allowedBackgroundPosition = ['center', 'top', 'bottom', 'left', 'right'];
if (!in_array($variant, $allowedVariants, true)) {
    $variant = 'default';
}
if (!in_array($align, $allowedAlign, true)) {
    $align = 'start';
}
if (!in_array($verticalAlign, $allowedVerticalAlign, true)) {
    $verticalAlign = 'top';
}
if (!in_array($backgroundPosition, $allowedBackgroundPosition, true)) {
    $backgroundPosition = 'center';
}

$rootStyle = '--wc-section-bg:' . $backgroundColor . ';'
    . '--wc-section-color:' . $textColor . ';'
    . '--wc-section-bg-position:' . $backgroundPosition . ';';
if ($padding !== '') {
    $rootStyle .= '--wc-section-padding:' . $padding . ';';
}
if ($minHeight !== '') {
    $rootStyle .= '--wc-section-min-height:' . $minHeight . ';';
}
if ($maxWidth !== '') {
    $rootStyle .= '--wc-section-max-width:' . $maxWidth . ';';
}
if ($radius !== '') {
    $rootStyle .= '--wc-section-radius:' . $radius . ';';
}
if ($backgroundImageFileHtml === '' && $backgroundImage !== '') {
    $rootStyle .= 'background-image:url("' . $esc($backgroundImage) . '");';
}

$rootClass = trim($wc . ' w-builder-section w-builder-section--' . $variant . ' w-builder-align-' . $align . ($class !== '' ? ' ' . $class : ''));
?>

<section class="<?= $esc($rootClass) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-variant="<?= $esc($variant) ?>"
         data-vertical-align="<?= $esc($verticalAlign) ?>"
         style="<?= $esc($rootStyle) ?>">
    <?php if ($backgroundImageFileHtml !== ''): ?>
        <div class="w-builder-section__background-media section-background"><?= $backgroundImageFileHtml ?></div>
    <?php endif; ?>

    <div class="section-inner">
        <?php if ($title !== '' || $subtitle !== '' || $content !== ''): ?>
            <header class="w-builder-section__header section-header">
                <?php if ($subtitle !== ''): ?>
                    <p class="w-builder-section__eyebrow section-eyebrow"><?= $esc($subtitle) ?></p>
                <?php endif; ?>
                <?php if ($title !== ''): ?>
                    <h2 class="w-builder-section__title section-title"><?= $esc($title) ?></h2>
                <?php endif; ?>
                <?php if ($content !== ''): ?>
                    <p class="w-builder-section__description section-description"><?= nl2br($esc($content)) ?></p>
                <?php endif; ?>
            </header>
        <?php endif; ?>

        <div class="w-builder-section__body section-body"
             data-wslot="<?= $esc($slotId) ?>"
             data-wslot-name="<?= $esc((string)__('区块内容')) ?>"
             data-wslot-accept="builder-component,builder-form,builder-display,builder-container"
             data-wslot-position="content"
             data-wslot-multiple="true">
            <?php if ($editorMode): ?>
                <div class="w-builder-slot-placeholder slot-placeholder"><?= __('拖入内容组件') ?></div>
            <?php endif; ?>
        </div>
    </div>
</section>

<style>
.<?= $wc ?> {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: var(--wc-section-min-height);
    padding: var(--wc-section-padding);
    border-radius: var(--wc-section-radius);
    background-color: var(--wc-section-bg);
    background-size: cover;
    background-position: var(--wc-section-bg-position);
    color: var(--wc-section-color);
    overflow: hidden;
}

.<?= $wc ?>[data-vertical-align="center"] {
    align-items: center;
}

.<?= $wc ?>[data-vertical-align="bottom"] {
    align-items: flex-end;
}

.<?= $wc ?>.w-builder-align-center .section-inner {
    text-align: center;
}

.<?= $wc ?>.w-builder-align-end .section-inner {
    text-align: right;
}

.<?= $wc ?>.w-builder-section--hero {
    min-height: var(--wc-section-min-height);
    background-color: var(--wc-section-bg);
}

.<?= $wc ?>.w-builder-section--cta {
    background-color: var(--wc-section-bg);
    color: var(--wc-section-color);
}

.<?= $wc ?>.w-builder-section--subtle {
    background-color: var(--wc-section-bg);
}

.<?= $wc ?> .section-background,
.<?= $wc ?> .section-background figure,
.<?= $wc ?> .section-background img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}

.<?= $wc ?> .section-background img {
    object-fit: cover;
}

.<?= $wc ?> .section-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--wc-section-max-width);
}

.<?= $wc ?> .section-eyebrow {
    margin: 0 0 var(--weline-space-2);
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-sm);
    font-weight: var(--weline-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--token-size-0-04em);
}

.<?= $wc ?> .section-title {
    margin: 0;
    font-size: clamp(var(--font-size-2xl), 2vw, var(--spacing-2_25));
    font-weight: var(--weline-font-weight-bold);
}

.<?= $wc ?> .section-description {
    margin: var(--weline-space-3) 0 0;
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-base);
    line-height: 1.6;
}

.<?= $wc ?> .section-body {
    margin-top: var(--weline-space-6);
}
</style>
