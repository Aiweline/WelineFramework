<?php
/**
 * Header 搜索框部件
 *
 * 视觉对齐 Theme 页头默认 Amazon 风格搜索栏（分类下拉 + 直角输入 + 橙色搜索钮）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {header-search}
 * @widget.name {Header 搜索框}
 * @widget.description {搜索框部件，热搜对接 Weline_Search，支持自动补全}
 * @widget.type {search}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {search}
 * @widget.supports {["layout-header-search","layout-global-header-search"]}
 * @widget.exclusive {true}
 *
 * @param placeholder {default="搜索商品...",type="string",label="占位符文字"}
 * @param show_hot_words {default=true,type="bool",label="显示热搜词"}
 * @param show_category {default=true,type="bool",label="显示分类下拉"}
 * @param auto_complete {default=true,type="bool",label="启用自动补全"}
 * @param search_type {default="all",type="select",label="搜索范围",options={all:"全站搜索",product:"仅搜商品",category:"仅搜分类"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('header-search');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$placeholder = $this->getData('placeholder') ?? __('搜索商品...');
$showHotWords = (bool)($this->getData('show_hot_words') ?? true);
$searchType = (string)($this->getData('search_type') ?? 'all');
$query = (string)($this->request->getParam('q') ?? '');
$selectedType = trim((string)($this->request->getParam('type') ?? ''));
$searchCategoryId = (int)($this->request->getParam('category_id') ?? 0);
?>

<link rel="stylesheet"
      href="@static(Weline_Theme::css/widgets/header-chrome-amazon.css)?v=20260825-type-label-sync1">
<link rel="stylesheet"
      href="@static(Weline_Theme::css/widgets/header-search-amazon.css)?v=20260825-type-label-sync1">

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?= $this->fetch('Weline_Theme::theme/frontend/partials/search/header-bar.phtml', [
        'placeholder' => (string)$placeholder,
        'query' => $query,
        'show_hot_words' => $showHotWords,
        'panel_id' => 'header-search-panel',
        'search_type' => $searchType,
        'selected_type' => $selectedType,
        'search_category_id' => $searchCategoryId,
    ]) ?>
</section>

<style>
.<?= $wc ?> {
    width: 100%;
    max-width: none;
    font-family: var(--weline-layout-font-family, var(--font-family-base, sans-serif));
}

.<?= $wc ?> .header-search-form,
.<?= $wc ?> .w-search-form {
    position: relative;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    max-width: 100%;
}
</style>

<script src="@static(Weline_Theme::js/widgets/header-search.js)?v=20260825-type-label-sync1"
        defer
        data-no-extract="true"
        data-w-header-search-loader="true"></script>
