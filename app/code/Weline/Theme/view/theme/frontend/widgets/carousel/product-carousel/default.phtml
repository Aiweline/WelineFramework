<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-carousel-product-carousel-default.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-carousel-product-carousel-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js,Weline_Product::css/frontend/product-card.css}
 * 产品轮播部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {product-carousel}
 * @widget.name {产品轮播}
 * @widget.description {以轮播形式展示产品列表}
 * @widget.type {carousel}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page", "category"]}
 *
 * @param title {default="",type="string",label="标题"}
 * @param product_source {default="featured",type="select",label="产品来源",options={featured:"推荐产品",new:"新品",bestseller:"畅销",sale:"促销"}}
 * @param product_ids {default="",type="product_picker",label="指定产品",description="搜索选择产品；留空使用来源",i18n=false}
 * @param limit {default=10,type="number",label="显示数量"}
 * @param slides_per_view {default=4,type="number",label="每屏显示数量"}
 * @param autoplay {default=false,type="bool",label="自动播放"}
 * @param loop {default=true,type="bool",label="循环播放"}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */

use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('product-carousel');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);
$showPrice = true;
$showRating = true;
$showAddToCart = true;

$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? '';
$productSource = $this->getData('product_source') ?? 'featured';
$productIds = $this->getData('product_ids') ?? '';
$limit = (int)($this->getData('limit') ?? 10);
$slidesPerView = (int)($this->getData('slides_per_view') ?? 4);
$autoplay = (bool)($this->getData('autoplay') ?? false);
$loop = (bool)($this->getData('loop') ?? true);

$products = ThemeDemoCatalog::products($limit, 80);
if ($title === '') {
    $title = __('精选轮播');
}

$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);
?>


<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-slides-per-view="<?= $esc((string)$slidesPerView) ?>"
         data-autoplay="<?= $autoplay ? 'true' : 'false' ?>"
         data-loop="<?= $loop ? 'true' : 'false' ?>"<?= $scopeLabelStyle !== '' ? ' data-widget-style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>

    <?php if ($title): ?>
        <div class="widget-header">
            <h2 class="widget-title"><?= $esc((string)$title) ?></h2>
        </div>
    <?php endif; ?>

    <div class="carousel-container">
        <button class="carousel-arrow carousel-prev" type="button" aria-label="<?= __('上一组') ?>">
            <w:icon name="arrow-left" size="sm"></w:icon>
        </button>

        <div class="carousel-viewport">
            <div class="carousel-track">
                <?php foreach ($products as $index => $product): ?>
                    <div class="carousel-slide">
                        <?php
                        $labelFlags = ProductLabelStyle::resolveFlags($product, $index);
                        $product['is_demo'] = !empty($labelFlags['is_demo']);
                        $product['is_new'] = !empty($labelFlags['is_new']);
                        $product['is_sale'] = !empty($labelFlags['is_sale']);
                        ?>
                        <w:product:card product="product" show-price="showPrice" show-rating="showRating" show-add-to-cart="showAddToCart" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" density="standard" wishlist-pixel="true" />
                    </div>
                <?php endforeach; ?>
            </div>
        </div>

        <button class="carousel-arrow carousel-next" type="button" aria-label="<?= __('下一组') ?>">
            <w:icon name="arrow-right" size="sm"></w:icon>
        </button>
    </div>
</section>

<span hidden data-widget-script="theme-carousel-product-carousel-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
