         data-autoplay="<?= $autoplay ? 'true' : 'false' ?>"
         data-loop="<?= $loop ? 'true' : 'false' ?>"<?= $scopeLabelStyle !== '' ? ' style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
