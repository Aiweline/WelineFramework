<?php
/**
 * 猜你喜欢部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {you-may-like}
 * @widget.name {猜你喜欢}
 * @widget.description {基于用户行为智能推荐产品}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-product-related-products","layout-product-list-recommendations","layout-search-recommendations","layout-default-content"]}
 * @widget.compatible {true}
 * 
 * @param title {default="猜你喜欢",type="string",label="标题"}
 * @param subtitle {default="根据您的浏览记录推荐",type="string",label="副标题"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列"}}
 * @param layout {default="grid",type="select",label="布局方式",options={grid:"网格",carousel:"轮播"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 */


use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('you-may-like');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = (string)($this->getData('title') ?? __('猜你喜欢'));
$subtitle = (string)($this->getData('subtitle') ?? __('根据您的浏览记录推荐'));
$limit = (int)($this->getData('limit') ?? 8);
$columns = (string)($this->getData('columns') ?? '4');
$layout = (string)($this->getData('layout') ?? 'grid');

$products = [];
foreach (ThemeDemoCatalog::products($limit, 40) as $index => $demo) {
    $products[] = $demo + ['match_score' => 92 - ($index % 8)];
}

?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="widget-header">
        <?php if ($title): ?>
            <h2 class="widget-title">
                <w:icon name="circle" size="sm"></w:icon>
                <?= htmlspecialchars($title) ?>
            </h2>
        <?php endif; ?>
        <?php if ($subtitle): ?>
            <p class="widget-subtitle"><?= htmlspecialchars($subtitle) ?></p>
        <?php endif; ?>
    </div>
    
    <div class="products-container layout-<?= htmlspecialchars($layout) ?>">
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-prev" type="button">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>
        
        <div class="products-wrapper">
            <div class="products-grid columns-<?= htmlspecialchars($columns) ?>">
                <?php foreach ($products as $product): ?>
                    <?php
                    $actionProductId = (int)($product['id'] ?? $product['product_id'] ?? 0);
                    // 确保所有产品字段都是字符串，避免null值
                    $productUrl = (string)($product['url'] ?? '');
                    $productImage = (string)($product['image'] ?? '');
                    $productName = (string)($product['name'] ?? '');
                    ?>
                    <div class="product-card" data-product-id="<?= $actionProductId ?>">
                        <div class="product-image-wrapper">
                            <a href="<?= htmlspecialchars($productUrl) ?>" class="product-image-link">
                                <img src="<?= htmlspecialchars($productImage) ?>" 
                                     alt="<?= htmlspecialchars($productName) ?>"
                                     class="product-image"
                                     loading="lazy">
                            </a>
                            
                            <div class="match-badge">
                                <w:icon name="circle" size="sm"></w:icon>
                                <?= $product['match_score'] ?>% <?= __('匹配') ?>
                            </div>
                            
                            <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/shopper-actions.phtml', [
                                'product_id' => $actionProductId,
                                'show_wishlist' => $shopperActions['show_wishlist'],
                                'show_compare' => $shopperActions['show_compare'],
                                'show_quickview' => $shopperActions['show_quickview'],
                            ]) ?>
                        </div>
                        
                        <div class="product-info">
                            <h3 class="product-name">
                                <a href="<?= htmlspecialchars($productUrl) ?>">
                                    <?= htmlspecialchars($productName) ?>
                                </a>
                            </h3>
                            
                            <div class="product-rating">
                                <div class="stars">
                                    <?php for ($s = 1; $s <= 5; $s++): ?>
                                        <span class="w-rating-star" data-state="<?= $s <= floor($product['rating']) ? 'filled' : 'empty' ?>"><w:icon name="star" size="sm"></w:icon></span>
                                    <?php endfor; ?>
                                </div>
                                <span class="review-count">(<?= $product['review_count'] ?>)</span>
                            </div>
                            
                            <div class="product-price">
                                <?php if ($product['original_price'] > $product['price']): ?>
                                    <span class="price-original">¥<?= number_format($product['original_price'], 2) ?></span>
                                <?php endif; ?>
                                <span class="price-current">¥<?= number_format($product['price'], 2) ?></span>
                            </div>
                            
                            <button class="btn-add-to-cart" data-product-id="<?= $product['id'] ?>">
                                <w:icon name="pin" size="sm"></w:icon>
                                <span><?= __('加入购物车') ?></span>
                            </button>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
        
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-next" type="button">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
    </div>
</section>

