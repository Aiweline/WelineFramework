<?php
/**
 * 图文组合部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {image-text}
 * @widget.name {图文组合}
 * @widget.description {图片和文字的组合布局，支持多种排列方式}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param image {default="",type="image",label="图片"}
 * @param title {default="春季系列上新",type="string",label="标题"}
 * @param content {default="采用轻盈面料与极简剪裁，适合通勤与周末出行。现在下单可享限时包邮。",type="textarea",label="内容"}
 * @param button_text {default="立即选购",type="string",label="按钮文字"}
 * @param button_link {default="/products",type="string",label="按钮链接"}
 * @param layout {default="image-left",type="select",label="布局",options={image-left:"图左文右",image-right:"图右文左",image-top:"图上文下",image-bg:"图片背景"}}
 * @param image_width {default="50",type="select",label="图片宽度",options={33:"33%",40:"40%",50:"50%",60:"60%"}}
 */

use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('image-text');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$defaultImage = ThemeDemoCatalog::productImage(1);
$image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('image') ?? $defaultImage);
$backgroundImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($image, true);
$imageFileHtml = (string)($this->getData('image_file_html') ?? '');
$title = trim((string)($this->getData('title') ?? __('春季系列上新')));
$content = (string)($this->getData('content') ?? __('采用轻盈面料与极简剪裁，适合通勤与周末出行。现在下单可享限时包邮。'));
$buttonText = trim((string)($this->getData('button_text') ?? __('立即选购')));
$buttonLink = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('button_link') ?? '/products');
$layout = strtolower(trim((string)($this->getData('layout') ?? 'image-left')));
$imageWidth = (string)($this->getData('image_width') ?? '50');

if (!in_array($layout, ['image-left', 'image-right', 'image-top', 'image-bg'], true)) {
    $layout = 'image-left';
}
if (!in_array($imageWidth, ['33', '40', '50', '60'], true)) {
    $imageWidth = '50';
}

$rootStyle = '--wc-image-width:' . $imageWidth . '%;';
if ($layout === 'image-bg' && $imageFileHtml === '' && $backgroundImage !== '') {
    $rootStyle .= 'background-image:url("' . $esc($backgroundImage) . '");';
}
?>

<section class="<?= $esc($wc) ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">

    <?php if ($layout === 'image-bg'): ?>
        <div class="bg-container">
            <?php if ($imageFileHtml !== ''): ?>
                <div class="bg-media"><?= $imageFileHtml ?></div>
            <?php endif; ?>
            <div class="bg-overlay"></div>
            <div class="text-content">
                <?php if ($title !== ''): ?>
                    <h2 class="content-title"><?= $esc($title) ?></h2>
                <?php endif; ?>
                <?php if ($content !== ''): ?>
                    <div class="content-text"><?= $content ?></div>
                <?php endif; ?>
                <?php if ($buttonText !== '' && $buttonLink !== ''): ?>
                    <a href="<?= $esc($buttonLink) ?>" class="content-button"><?= $esc($buttonText) ?></a>
                <?php endif; ?>
            </div>
        </div>
    <?php elseif ($layout === 'image-top'): ?>
        <div class="image-section">
            <?php if ($imageFileHtml !== ''): ?>
                <div class="content-image content-image--asset"><?= $imageFileHtml ?></div>
            <?php else: ?>
                <img src="<?= $esc($image) ?>" alt="<?= $esc($title) ?>" class="content-image" loading="lazy">
            <?php endif; ?>
        </div>
        <div class="text-section">
            <?php if ($title !== ''): ?>
                <h2 class="content-title"><?= $esc($title) ?></h2>
            <?php endif; ?>
            <?php if ($content !== ''): ?>
                <div class="content-text"><?= $content ?></div>
            <?php endif; ?>
            <?php if ($buttonText !== '' && $buttonLink !== ''): ?>
                <a href="<?= $esc($buttonLink) ?>" class="content-button"><?= $esc($buttonText) ?></a>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="content-row">
            <div class="image-section">
                <?php if ($imageFileHtml !== ''): ?>
                    <div class="content-image content-image--asset"><?= $imageFileHtml ?></div>
                <?php else: ?>
                    <img src="<?= $esc($image) ?>" alt="<?= $esc($title) ?>" class="content-image" loading="lazy">
                <?php endif; ?>
            </div>
            <div class="text-section">
                <?php if ($title !== ''): ?>
                    <h2 class="content-title"><?= $esc($title) ?></h2>
                <?php endif; ?>
                <?php if ($content !== ''): ?>
                    <div class="content-text"><?= $content ?></div>
                <?php endif; ?>
                <?php if ($buttonText !== '' && $buttonLink !== ''): ?>
                    <a href="<?= $esc($buttonLink) ?>" class="content-button"><?= $esc($buttonText) ?></a>
                <?php endif; ?>
            </div>
        </div>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    margin: var(--weline-space-8, 30px) 0;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .content-row {
    display: flex;
    align-items: center;
    gap: var(--weline-space-10, 40px);
}

.<?= $wc ?>.layout-image-right .content-row {
    flex-direction: row-reverse;
}

.<?= $wc ?> .image-section {
    overflow: hidden;
    border-radius: var(--weline-radius-xl, 12px);
}

.<?= $wc ?>.layout-image-left .image-section,
.<?= $wc ?>.layout-image-right .image-section {
    flex: 0 0 var(--wc-image-width, 50%);
}

.<?= $wc ?> .content-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--weline-theme-transition-slow, 0.5s ease);
}

.<?= $wc ?> .content-image--asset img {
    display: block;
    width: 100%;
    height: auto;
}

.<?= $wc ?>:hover .content-image {
    transform: scale(1.03);
}

.<?= $wc ?> .text-section {
    flex: 1;
}

.<?= $wc ?> .content-title {
    font-size: var(--weline-font-size-3xl, 28px);
    font-weight: 700;
    margin: 0 0 var(--weline-space-4, 15px);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .content-text {
    font-size: var(--weline-font-size-base, 16px);
    line-height: 1.7;
    color: var(--weline-theme-text-muted);
    margin-bottom: var(--weline-space-5, 20px);
}

.<?= $wc ?> .content-button {
    display: inline-block;
    padding: var(--weline-space-3, 12px) var(--weline-space-8, 30px);
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
    text-decoration: none;
    border-radius: var(--weline-radius-lg, 8px);
    font-weight: 600;
    transition: all var(--weline-theme-transition-base, 0.3s ease);
}

.<?= $wc ?> .content-button:hover {
    background: var(--weline-theme-primary-hover);
    transform: translateY(-2px);
    box-shadow: var(--weline-theme-shadow-md);
}

.<?= $wc ?>.layout-image-top .text-section {
    text-align: center;
    padding: var(--weline-space-8, 30px) 0;
}

.<?= $wc ?>.layout-image-bg .bg-container {
    position: relative;
    min-height: 400px;
    background-size: cover;
    background-position: center;
    border-radius: var(--weline-radius-xl, 12px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.<?= $wc ?>.layout-image-bg .bg-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--weline-theme-overlay) 50%, transparent);
    z-index: 1;
}

.<?= $wc ?>.layout-image-bg .bg-media,
.<?= $wc ?>.layout-image-bg .bg-media figure,
.<?= $wc ?>.layout-image-bg .bg-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}

.<?= $wc ?>.layout-image-bg .bg-media img {
    object-fit: cover;
}

.<?= $wc ?>.layout-image-bg .text-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--weline-space-10, 40px);
    max-width: 700px;
}

.<?= $wc ?>.layout-image-bg .content-title {
    color: var(--weline-theme-on-primary);
    font-size: var(--weline-font-size-4xl, 36px);
}

.<?= $wc ?>.layout-image-bg .content-text {
    color: color-mix(in srgb, var(--weline-theme-on-primary) 90%, transparent);
}

.<?= $wc ?>.layout-image-bg .content-button {
    background: var(--weline-theme-surface-raised);
    color: var(--weline-theme-text);
}

.<?= $wc ?>.layout-image-bg .content-button:hover {
    background: var(--weline-theme-surface);
}

.widget-preview-canvas .<?= $wc ?>.layout-image-bg .bg-container,
.<?= $wc ?>.is-preview.layout-image-bg .bg-container {
    min-height: 120px;
}

@media (max-width: 768px) {
    .<?= $wc ?> .content-row {
        flex-direction: column;
    }

    .<?= $wc ?>.layout-image-right .content-row {
        flex-direction: column;
    }

    .<?= $wc ?> .image-section {
        flex: none !important;
        width: 100%;
    }

    .<?= $wc ?> .content-title {
        font-size: var(--weline-font-size-xl, 22px);
    }
}
</style>
