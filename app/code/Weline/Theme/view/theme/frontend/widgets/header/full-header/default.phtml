<?php
/**
 * @widget.source {Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-header-full-header-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * @widget.layout_source {Weline_Theme::css/widgets/widget-header-full-header-default.css}
 * 完整头部部件模板 (独占部件)
 *
 * @var array $config 部件配置
 * @var \Weline\Framework\View\Block $block 当前 Block 实例
 *
 * @widget.code {full-header}
 * @widget.name {完整头部}
 * @widget.description {一个完整的、自包含的头部组件，包含Logo、搜索框、导航菜单、用户区域。独占头部区域，整体替换默认Header。}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.exclusive {true}
 *
 * @param logo_text {default="",type="string",label="Logo文字",description="留空则使用当前网站名称"}
 * @param logo_image {default="",type="media_image",label="Logo图片",description="从媒体库选择 Logo，留空显示文字",i18n=false}
 * @param sticky {default=true,type="bool",label="吸顶效果"}
 * @param bg_color {default="var(--weline-theme-surface)",type="color",label="背景颜色"}
 * @param text_color {default="var(--weline-theme-text)",type="color",label="文字颜色"}
 * @param accent_color {default="var(--weline-theme-primary)",type="color",label="强调色"}
 * @param search_placeholder {default="搜索商品...",type="string",label="搜索框占位符"}
 * @param show_search {default=true,type="bool",label="显示搜索框"}
 * @param show_account {default=true,type="bool",label="显示账户"}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_cart {default=true,type="bool",label="显示购物车"}
 * @param show_nav {default=true,type="bool",label="显示导航菜单"}
 * @param nav_style {default="simple",type="select",label="导航样式",options={simple:"简洁",expanded:"展开",mega:"Mega菜单"}}
 * @param shadow {default=true,type="bool",label="显示阴影"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteBrand;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('full-header');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$config = $config ?? [];
$isPreviewMode = (bool)($config['preview_mode'] ?? false);
$configuredLogoText = trim((string)($config['logo_text'] ?? ''));
$logoText = $configuredLogoText;
try {
    $siteBrand = ObjectManager::getInstance(SiteBrand::class);
    if ($siteBrand instanceof SiteBrand) {
        $logoText = $siteBrand->resolveFrontendWordmark($configuredLogoText);
    }
} catch (\Throwable) {
}
if ($logoText === '') {
    $logoText = 'Store';
}
$logoImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($config['logo_image'] ?? '');
$logoImageFileHtml = (string)($config['logo_image_file_html'] ?? '');
$sticky = (bool)($config['sticky'] ?? true);
$bgColor = ThemeUiColor::sanitize($config['bg_color'] ?? '', 'var(--weline-theme-surface)');
$textColor = ThemeUiColor::sanitize($config['text_color'] ?? '', 'var(--weline-theme-text)');
$accentColor = ThemeUiColor::sanitize($config['accent_color'] ?? '', 'var(--weline-theme-primary)');
$searchPlaceholder = $config['search_placeholder'] ?? __('搜索商品...');
$showSearch = (bool)($config['show_search'] ?? true);
$showAccount = (bool)($config['show_account'] ?? true);
$showWishlist = (bool)($config['show_wishlist'] ?? true);
$showCart = (bool)($config['show_cart'] ?? true);
$showNav = (bool)($config['show_nav'] ?? true);
$navStyle = strtolower(trim((string)($config['nav_style'] ?? 'simple')));
if (!in_array($navStyle, ['simple', 'expanded', 'mega'], true)) {
    $navStyle = 'simple';
}
$shadow = (bool)($config['shadow'] ?? true);

$rootStyle = '--wc-header-bg:' . $bgColor . ';'
    . '--wc-header-text:' . $textColor . ';'
    . '--wc-header-accent:' . $accentColor . ';'
    . ($shadow ? '' : '--wc-header-shadow:none;');
?>

<section class="<?= $esc($wc) ?><?= $sticky ? ' is-sticky' : '' ?> nav-style-<?= $esc($navStyle) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-style="<?= $esc($rootStyle) ?>">
    <div class="header-topbar">
        <div class="w-container">
            <div class="topbar-left">
                <span class="topbar-text"><?= __('国际配送，售后有保障') ?></span>
            </div>
            <div class="topbar-right">
                <a href="@url{'faq'}" class="topbar-link"><?= __('帮助中心') ?></a>
                <span class="topbar-divider">|</span>
                <a href="@url{'customer/account/index'}#orders" class="topbar-link"><?= __('订单跟踪') ?></a>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="w-container">
            <button class="mobile-menu-toggle" type="button" aria-label="<?= __('打开菜单') ?>" aria-expanded="false">
                <w:icon name="menu" size="sm"></w:icon>
            </button>
            <div class="header-logo">
                <a href="@url{'/'}" class="logo-link" title="<?= $esc((string)$logoText) ?>">
                    <?php if ($logoImageFileHtml !== ''): ?>
                        <span class="logo-image logo-image--asset"><?= $logoImageFileHtml ?></span>
                    <?php elseif ($logoImage !== ''): ?>
                        <img src="<?= $esc($logoImage) ?>" alt="<?= $esc((string)$logoText) ?>" class="logo-image">
                    <?php else: ?>
                        <span class="logo-text"><?= $esc((string)$logoText) ?></span>
                    <?php endif; ?>
                </a>
            </div>

            <?php if ($showSearch): ?>
            <div class="header-search">
                <w:form action="@url{'search'}" method="get" class="search-form">
                    <div class="search-input-wrapper">
                        <input type="text" name="q" class="search-input" placeholder="<?= $esc((string)$searchPlaceholder) ?>" autocomplete="off">
                        <button type="submit" class="search-btn" aria-label="<?= __('搜索') ?>">
                            <w:icon name="search" size="sm"></w:icon>
                        </button>
                    </div>
                </w:form>
            </div>
            <?php endif; ?>

            <div class="header-tools">
                <?php if ($showAccount): ?>
                <div class="tool-item tool-account">
                    <a href="@url{'customer/account'}" class="tool-link">
                        <w:icon name="user" size="sm"></w:icon>
                        <span class="tool-label"><?= __('账户') ?></span>
                    </a>
                </div>
                <?php endif; ?>
                <?php if ($showWishlist): ?>
                <div class="tool-item tool-wishlist">
                    <a href="@url{'customer/account/index'}#wishlist" class="tool-link">
                        <w:icon name="heart" size="sm"></w:icon>
                        <span class="tool-label"><?= __('收藏') ?></span>
                        <span class="tool-badge wishlist-count" data-count="0" hidden>0</span>
                    </a>
                </div>
                <?php endif; ?>
                <?php if ($showCart): ?>
                <div class="tool-item tool-cart">
                    <a href="@url{'cart'}" class="tool-link">
                        <w:icon name="pin" size="sm"></w:icon>
                        <span class="tool-label"><?= __('购物车') ?></span>
                        <span class="tool-badge cart-count" data-count="0">0</span>
                    </a>
                </div>
                <?php endif; ?>
            </div>
        </div>
    </div>

    <?php if ($showNav): ?>
    <nav class="header-nav">
        <div class="w-container">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="@url{'/'}" class="nav-link" data-state="active">
                        <w:icon name="home" size="sm"></w:icon><span><?= __('首页') ?></span>
                    </a>
                </li>
                <li class="nav-item has-dropdown">
                    <a href="@url{'categories'}" class="nav-link">
                        <w:icon name="grid" size="sm"></w:icon><span><?= __('商品分类') ?></span>
                        <w:icon name="arrow-down" size="sm"></w:icon>
                    </a>
                    <div class="nav-dropdown">
                        <div class="dropdown-inner">
                            <div class="dropdown-column">
                                <h4 class="dropdown-title"><?= __('热门分类') ?></h4>
                                <ul class="dropdown-list">
                                    <li><a href="@url{'products'}"><?= __('全部商品') ?></a></li>
                                    <li><a href="@url{'categories'}"><?= __('商品分类') ?></a></li>
                                    <li><a href="@url{'new-arrivals'}"><?= __('新品上市') ?></a></li>
                                    <li><a href="@url{'best-sellers'}"><?= __('热卖精选') ?></a></li>
                                </ul>
                            </div>
                            <div class="dropdown-column">
                                <h4 class="dropdown-title"><?= __('特色推荐') ?></h4>
                                <ul class="dropdown-list">
                                    <li><a href="@url{'products'|['filter' => 'new']}"><?= __('新品上市') ?></a></li>
                                    <li><a href="@url{'promotion/deals'}"><?= __('限时特惠') ?></a></li>
                                    <li><a href="@url{'blog'}"><?= __('博客') ?></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="nav-item"><a href="@url{'products'|['filter' => 'hot']}" class="nav-link"><w:icon name="fire" size="sm"></w:icon><span><?= __('热卖') ?></span></a></li>
                <li class="nav-item"><a href="@url{'products'|['filter' => 'new']}" class="nav-link"><w:icon name="bolt" size="sm"></w:icon><span><?= __('新品') ?></span></a></li>
                <li class="nav-item"><a href="@url{'promotion'}" class="nav-link highlight"><w:icon name="circle" size="sm"></w:icon><span><?= __('促销活动') ?></span></a></li>
                <li class="nav-item"><a href="@url{'about'}" class="nav-link"><w:icon name="info" size="sm"></w:icon><span><?= __('关于我们') ?></span></a></li>
            </ul>
        </div>
    </nav>
    <?php endif; ?>
</section>

<?php if ($sticky): ?>
<div class="header-placeholder" hidden></div>
<?php endif; ?>

<span hidden data-widget-script="theme-header-full-header-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>" data-v1="<?= htmlspecialchars((string)((bool)($sticky) ? 1 : 0), ENT_QUOTES, 'UTF-8') ?>"></span>
