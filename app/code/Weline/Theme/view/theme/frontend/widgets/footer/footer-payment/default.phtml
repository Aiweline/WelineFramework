<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-footer-footer-payment-default.css}
 * 页脚支付图标部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-payment}
 * @widget.name {支付方式}
 * @widget.description {展示支持的支付方式图标}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {payment}
 * @widget.supports {["layout-footer-payment","layout-global-footer-payment"]}
 * @widget.exclusive {true}
 *
 * @param title {default="支付方式",type="string",label="标题"}
 * @param payment_methods {default=["visa","mastercard","paypal","alipay","wechat"],type="array",label="支付方式"}
 * @param show_label {default=true,type="bool",label="显示标签"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-payment');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('支付方式');
$paymentMethods = $this->getData('payment_methods') ?? ['visa', 'mastercard', 'paypal', 'alipay', 'wechat'];
$showLabel = (bool)($this->getData('show_label') ?? true);

$paymentIcons = [
    'visa' => ['icon' => 'circle', 'name' => 'Visa'],
    'mastercard' => ['icon' => 'circle', 'name' => 'Mastercard'],
    'amex' => ['icon' => 'circle', 'name' => 'American Express'],
    'paypal' => ['icon' => 'circle', 'name' => 'PayPal'],
    'alipay' => ['icon' => 'circle', 'name' => '支付宝'],
    'wechat' => ['icon' => 'circle', 'name' => '微信支付'],
    'unionpay' => ['icon' => 'circle', 'name' => '银联'],
    'jcb' => ['icon' => 'circle', 'name' => 'JCB'],
    'discover' => ['icon' => 'circle', 'name' => 'Discover'],
    'applepay' => ['icon' => 'circle', 'name' => 'Apple Pay'],
    'googlepay' => ['icon' => 'circle', 'name' => 'Google Pay'],
];
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($showLabel && $title !== ''): ?>
        <span class="payment-label"><?= $esc((string)$title) ?>:</span>
    <?php endif; ?>
    <div class="payment-icons">
        <?php foreach ($paymentMethods as $method):
            $payment = $paymentIcons[$method] ?? ['icon' => 'circle', 'name' => ucfirst((string)$method)];
        ?>
            <span class="payment-icon" title="<?= $esc($payment['name']) ?>">
                <w:icon name="payment.icon|circle" size="sm"></w:icon>
            </span>
        <?php endforeach; ?>
    </div>
</section>

