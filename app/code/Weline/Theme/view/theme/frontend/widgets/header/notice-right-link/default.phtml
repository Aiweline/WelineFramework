<?php
/**
 * 页头通知条右侧：通用入口（供其他模块复用）
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {notice-right-link}
 * @widget.name {通知右侧入口}
 * @widget.description {可配置的页头通知条右侧链接。仅可放入 notice-rights 槽，可与帮助中心/订单跟踪等并排。}
 * @widget.type {notice-rights}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {top-bar-rights}
 * @widget.supports {["notice-rights","layout-header-notice-rights","top-bar-rights"]}
 * @widget.exclusive {false}
 *
 * @param label {default="快捷入口",type="string",label="链接文字"}
 * @param url {default="#",type="string",label="链接地址"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('notice-right-link');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$label = WidgetI18n::label(trim((string)($this->getData('label') ?? '')), '快捷入口');
$url = LegacyMediaUrl::sanitize((string)($this->getData('url') ?? '#'));
if ($url === '') {
    $url = '#';
}
?>

<a class="<?= $esc($wc) ?> header-site-notice-right-link<?= $isPreviewMode ? ' is-preview' : '' ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-widget-type="notice-rights"
   href="<?= $esc($url) ?>"><?= $esc($label) ?></a>

<style>
.<?= $wc ?> {
    color: inherit;
    text-decoration: none;
    font: inherit;
    line-height: inherit;
    opacity: 0.92;
}
.<?= $wc ?>:hover {
    text-decoration: underline;
    opacity: 1;
}
</style>
