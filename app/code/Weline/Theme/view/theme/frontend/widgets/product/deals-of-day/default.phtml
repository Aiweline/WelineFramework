<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-product-deals-of-day-default.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-product-deals-of-day-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js,Weline_Product::css/frontend/product-card.css}
 * 今日特价部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {deals-of-day}
 * @widget.name {今日特价}
 * @widget.description {限时抢购特价产品，支持倒计时和库存显示}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * 
 * @param title {default="今日特价",type="string",label="标题"}
 * @param subtitle {default="限时抢购，错过不再",type="string",label="副标题"}
 * @param limit {default=4,type="number",label="显示数量"}
 * @param show_countdown {default=true,type="bool",label="显示倒计时"}
 * @param countdown_end {default="",type="string",label="倒计时结束时间"}
 * @param show_discount_percent {default=true,type="bool",label="显示折扣百分比"}
 * @param show_stock_bar {default=true,type="bool",label="显示库存进度条"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */


use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('deals-of-day');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);
$showPrice = true;
$showRating = true;
$showAddToCart = true;

$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
// 布局配置存中文源串；必须经 WidgetI18n，禁止 getData 直接输出绕过翻译
$title = WidgetI18n::label(trim((string)($this->getData('title') ?? '')), '今日特价');
$subtitle = WidgetI18n::label(trim((string)($this->getData('subtitle') ?? '')), '限时抢购，错过不再');
$limit = (int)($this->getData('limit') ?? 4);
$showCountdown = (bool)($this->getData('show_countdown') ?? true);
// 空串会绕过 ??，写入 data-end="" 后 Date 解析为 NaN；非空才用配置值
$countdownEndRaw = $this->getData('countdown_end');
$countdownEnd = (is_string($countdownEndRaw) && trim($countdownEndRaw) !== '')
    ? trim($countdownEndRaw)
    : date('Y-m-d 23:59:59');
$showDiscountPercent = (bool)($this->getData('show_discount_percent') ?? true);
$showStockBar = (bool)($this->getData('show_stock_bar') ?? true);
$columns = (string)($this->getData('columns') ?? '4');
if (!in_array($columns, ['2', '3', '4', '5'], true)) {
    $columns = '4';
}
$colNum = max(2, min(5, (int)$columns));
// WO-HP-P3-MALL-04：特价货架 1 行
if ($limit <= 0 || $limit > $colNum) {
    $limit = $colNum;
}

$products = [];
try {
    if (class_exists(\Weline\Product\Service\StorefrontProductWidgetCatalog::class)) {
        $catalog = \Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Product\Service\StorefrontProductWidgetCatalog::class
        );
        // 首页三货架错开：仅真实折扣≥15%或限时标（WO-HP-P1-02）；不足不借其它货架
        // WO-BUILD-HOME-ZERO：特价货架再兜底剥零价卡
        $rawDeals = $catalog->homepageDealsCards(max($limit * 3, 12));
        $products = [];
        foreach ($rawDeals as $card) {
            if (!is_array($card) || (float)($card['price'] ?? 0) <= 0.0) {
                continue;
            }
            if (!empty($card['currency_unavailable']) || !empty($card['quote_only'])) {
                continue;
            }
            $products[] = $card;
            if (count($products) >= $limit) {
                break;
            }
        }
    }
} catch (\Throwable) {
    $products = [];
}
if ($products === [] && $isPreviewMode) {
    foreach (ThemeDemoCatalog::products($limit, 60) as $index => $demo) {
        $discount = 20 + (($index % 4) * 8);
        $originalPrice = (float)$demo['original_price'];
        $products[] = [
            'id' => $demo['id'],
            'name' => $demo['name'],
            'url' => $demo['url'],
            'image' => $demo['image'],
            'price' => round($originalPrice * (100 - $discount) / 100, 2),
            'original_price' => $originalPrice,
            'discount_percent' => $discount,
            'rating' => $demo['rating'],
            'review_count' => $demo['review_count'],
            'stock_total' => 80 + ($index * 15),
            'stock_sold' => 35 + ($index * 9),
            'is_new' => ($index % 3 === 0) ? 1 : 0,
            'is_sale' => 1,
        ];
    }
} elseif ($products !== []) {
    foreach ($products as $index => &$row) {
        $price = (float)($row['price'] ?? 0);
        $original = (float)($row['original_price'] ?? 0);
        // 禁止伪造划线价凑折扣；仅保留真实 original_price / discount_percent
        if ($original <= $price) {
            $original = $price;
        }
        $discount = isset($row['discount_percent'])
            ? (int)$row['discount_percent']
            : ($original > $price && $original > 0
                ? (int)round((1 - ($price / $original)) * 100)
                : 0);
        $row['original_price'] = $original;
        $row['discount_percent'] = max(0, min(70, $discount));
        $row['stock_total'] = (int)($row['stock_total'] ?? (80 + ($index * 15)));
        $row['stock_sold'] = (int)($row['stock_sold'] ?? (35 + ($index * 9)));
        $row['is_sale'] = 1;
    }
    unset($row);
}

if ($products === []) {
    ?>
<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="deals-of-day-empty"
         hidden
         aria-hidden="true"></section>
    <?php
    return;
}

$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);

?>


<section class="<?= $esc($wc) ?> weline-product-card-shelf<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-code="deals-of-day"<?= $scopeLabelStyle !== '' ? ' data-widget-style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
    <div class="widget-header">
        <div class="header-left">
            <?php if ($title): ?>
                <h2 class="widget-title">
                    <w:icon name="bolt" size="sm"></w:icon>
                    <?= htmlspecialchars($title) ?>
                </h2>
            <?php endif; ?>
            <?php if ($subtitle): ?>
                <p class="widget-subtitle"><?= htmlspecialchars($subtitle) ?></p>
            <?php endif; ?>
        </div>
        
        <?php if ($showCountdown): ?>
            <div class="header-countdown" data-end="<?= htmlspecialchars($countdownEnd) ?>">
                <span class="countdown-label"><?= __('距离结束') ?>:</span>
                <div class="countdown-timer">
                    <div class="time-block">
                        <span class="time-value" data-unit="hours">00</span>
                        <span class="time-label"><?= __('时') ?></span>
                    </div>
                    <span class="time-separator">:</span>
                    <div class="time-block">
                        <span class="time-value" data-unit="minutes">00</span>
                        <span class="time-label"><?= __('分') ?></span>
                    </div>
                    <span class="time-separator">:</span>
                    <div class="time-block">
                        <span class="time-value" data-unit="seconds">00</span>
                        <span class="time-label"><?= __('秒') ?></span>
                    </div>
                </div>
            </div>
        <?php endif; ?>
    </div>
    
    <div class="products-container">
        <div class="products-grid columns-<?= htmlspecialchars($columns) ?>">
            <?php foreach ($products as $index => $product): ?>
                <?php
                $labelFlags = ProductLabelStyle::resolveFlags($product, $index);
                $product['is_demo'] = !empty($labelFlags['is_demo']);
                $product['is_new'] = !empty($labelFlags['is_new']);
                $product['is_sale'] = !empty($labelFlags['is_sale']);
                $product['is_hot'] = !empty($labelFlags['is_hot']);
                $product['free_shipping'] = !empty($labelFlags['is_free_shipping']);
                $product['discount_percent'] = (int)($labelFlags['discount_percent'] ?? ($product['discount_percent'] ?? 0));
                if ($showDiscountPercent && $product['discount_percent'] > 0) {
                    $product['sale_badge_text'] = '-' . $product['discount_percent'] . '%';
                } else {
                    $product['sale_badge_text'] = (string)($labelFlags['sale_text'] ?? '特价');
                }
                ?>
                <w:product:card product="product" show-price="showPrice" show-rating="showRating" show-add-to-cart="showAddToCart" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" density="shelf" wishlist-pixel="true" />
            <?php endforeach; ?>
        </div>
    </div>

    <div class="widget-footer" data-testid="deals-of-day-view-more">
        <a href="@url{'products'|['filter' => 'sale']}" class="btn-view-all">
            <?= __('查看更多') ?>
            <w:icon name="arrow-right" size="sm"></w:icon>
        </a>
    </div>
</section>

<span hidden data-widget-script="theme-product-deals-of-day-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
