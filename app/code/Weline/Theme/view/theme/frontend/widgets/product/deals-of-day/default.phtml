<?php
/**
 * 今日特价部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {deals-of-day}
 * @widget.name {今日特价}
 * @widget.description {限时抢购特价产品，支持倒计时和库存显示}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * 
 * @param title {default="今日特价",type="string",label="标题"}
 * @param subtitle {default="限时抢购，错过不再",type="string",label="副标题"}
 * @param limit {default=4,type="number",label="显示数量"}
 * @param show_countdown {default=true,type="bool",label="显示倒计时"}
 * @param countdown_end {default="",type="string",label="倒计时结束时间"}
 * @param show_discount_percent {default=true,type="bool",label="显示折扣百分比"}
 * @param show_stock_bar {default=true,type="bool",label="显示库存进度条"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列"}}
 */


use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('deals-of-day');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('今日特价');
$subtitle = $this->getData('subtitle') ?? __('限时抢购，错过不再');
$limit = (int)($this->getData('limit') ?? 4);
$showCountdown = (bool)($this->getData('show_countdown') ?? true);
$countdownEnd = $this->getData('countdown_end') ?? date('Y-m-d 23:59:59');
$showDiscountPercent = (bool)($this->getData('show_discount_percent') ?? true);
$showStockBar = (bool)($this->getData('show_stock_bar') ?? true);
$columns = $this->getData('columns') ?? '4';

$products = [];
foreach (ThemeDemoCatalog::products($limit, 60) as $index => $demo) {
    $discount = 20 + (($index % 4) * 8);
    $originalPrice = (float)$demo['original_price'];
    $products[] = [
        'id' => $demo['id'],
        'name' => $demo['name'],
        'url' => $demo['url'],
        'image' => $demo['image'],
        'price' => round($originalPrice * (100 - $discount) / 100, 2),
        'original_price' => $originalPrice,
        'discount_percent' => $discount,
        'rating' => $demo['rating'],
        'review_count' => $demo['review_count'],
        'stock_total' => 80 + ($index * 15),
        'stock_sold' => 35 + ($index * 9),
    ];
}

?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="widget-header">
        <div class="header-left">
            <?php if ($title): ?>
                <h2 class="widget-title">
                    <w:icon name="bolt" size="sm"></w:icon>
                    <?= htmlspecialchars($title) ?>
                </h2>
            <?php endif; ?>
            <?php if ($subtitle): ?>
                <p class="widget-subtitle"><?= htmlspecialchars($subtitle) ?></p>
            <?php endif; ?>
        </div>
        
        <?php if ($showCountdown): ?>
            <div class="header-countdown" data-end="<?= htmlspecialchars($countdownEnd) ?>">
                <span class="countdown-label"><?= __('距离结束') ?>:</span>
                <div class="countdown-timer">
                    <div class="time-block">
                        <span class="time-value" data-unit="hours">00</span>
                        <span class="time-label"><?= __('时') ?></span>
                    </div>
                    <span class="time-separator">:</span>
                    <div class="time-block">
                        <span class="time-value" data-unit="minutes">00</span>
                        <span class="time-label"><?= __('分') ?></span>
                    </div>
                    <span class="time-separator">:</span>
                    <div class="time-block">
                        <span class="time-value" data-unit="seconds">00</span>
                        <span class="time-label"><?= __('秒') ?></span>
                    </div>
                </div>
            </div>
        <?php endif; ?>
    </div>
    
    <div class="products-container">
        <div class="products-grid columns-<?= htmlspecialchars($columns) ?>">
            <?php foreach ($products as $product): ?>
                <?php
                // 确保所有产品字段都是字符串，避免null值
                $productUrl = (string)($product['url'] ?? '');
                $productImage = (string)($product['image'] ?? '');
                $productName = (string)($product['name'] ?? '');
                ?>
                <div class="product-card deal-card">
                    <div class="product-image-wrapper">
                        <a href="<?= htmlspecialchars($productUrl) ?>" class="product-image-link">
                            <img src="<?= htmlspecialchars($productImage) ?>" 
                                 alt="<?= htmlspecialchars($productName) ?>"
                                 class="product-image"
                                 loading="lazy">
                        </a>
                        
                        <?php if ($showDiscountPercent): ?>
                            <div class="discount-badge">
                                -<?= $product['discount_percent'] ?>%
                            </div>
                        <?php endif; ?>
                        
                        <div class="product-actions">
                            <button class="action-btn btn-wishlist" title="<?= __('加入收藏') ?>">
                                <w:icon name="heart" size="sm"></w:icon>
                            </button>
                            <button class="action-btn btn-quickview" title="<?= __('快速查看') ?>">
                                <w:icon name="eye" size="sm"></w:icon>
                            </button>
                        </div>
                    </div>
                    
                    <div class="product-info">
                        <h3 class="product-name">
                            <a href="<?= htmlspecialchars($productUrl) ?>">
                                <?= htmlspecialchars($productName) ?>
                            </a>
                        </h3>
                        
                        <div class="product-rating">
                            <div class="stars">
                                <?php for ($s = 1; $s <= 5; $s++): ?>
                                    <span class="w-rating-star" data-state="<?= $s <= floor($product['rating']) ? 'filled' : 'empty' ?>"><w:icon name="star" size="sm"></w:icon></span>
                                <?php endfor; ?>
                            </div>
                            <span class="review-count">(<?= $product['review_count'] ?>)</span>
                        </div>
                        
                        <div class="product-price">
                            <span class="price-original">¥<?= number_format($product['original_price'], 2) ?></span>
                            <span class="price-current">¥<?= number_format($product['price'], 2) ?></span>
                        </div>
                        
                        <?php if ($showStockBar): ?>
                            <div class="stock-progress">
                                <div class="w-progress__bar">
                                    <?php
                                    $stockTotal = max(1, (int)$product['stock_total']);
                                    $stockProgress = min(100, max(0, ((int)$product['stock_sold'] / $stockTotal) * 100));
                                    ?>
                                    <div class="progress-fill" style="--wc-progress: <?= $esc((string)$stockProgress) ?>"></div>
                                </div>
                                <div class="stock-info">
                                    <span class="sold"><?= __('已售') ?> <?= $product['stock_sold'] ?></span>
                                    <span class="remaining"><?= __('剩余') ?> <?= $product['stock_total'] - $product['stock_sold'] ?></span>
                                </div>
                            </div>
                        <?php endif; ?>
                        
                        <button class="btn-add-to-cart btn-deal" data-product-id="<?= $product['id'] ?>">
                            <w:icon name="bolt" size="sm"></w:icon>
                            <span><?= __('立即抢购') ?></span>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
</section>

