<?php
/**
 * Footer 整页脚主部件
 *
 * 配置驱动：链接分组（可开关/可增）、分项、法律链、社交、版权；标准四列挂固定扩展槽。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-container}
 * @widget.name {全局页脚}
 * @widget.description {独立站全局页脚：品牌、服务、法律、社交与语言货币；标准四列保留业务扩展槽。独占底部区域。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer}
 * @widget.exclusive {true}
 * @widget.is_container {true}
 * @widget.supports {["layout-global-footer","footer-container"]}
 * @widget.slots {"footer-about-links":{"name":"了解我们扩展","accept":["footer-blog-link","footer-news-link","layout-footer-about-links"],"multiple":true},"footer-partner-links":{"name":"合作信息扩展","accept":["footer-publish-link","footer-promote-link","layout-footer-partner-links"],"multiple":true},"footer-payment-account-links":{"name":"支付与账户扩展","accept":["footer-payment-methods-link","footer-social-login-link","footer-currency-rates-link","footer-campaign-link","layout-footer-payment-account-links"],"multiple":true},"footer-help-links":{"name":"帮助中心扩展","accept":["footer-my-account-link","footer-my-orders-link","footer-shipping-info-link","footer-returns-policy-link","footer-faq-link","footer-contact-service-link","layout-footer-help-links"],"multiple":true},"footer-language":{"name":"语言","accept":["language-switcher","language"],"max":1},"footer-currency":{"name":"货币","accept":["currency-switcher","currency"],"max":1},"footer-social":{"name":"社交媒体","accept":["footer-social","social"],"max":1},"footer-copyright":{"name":"版权信息","accept":["footer-copyright","copyright"],"max":1}}
 * @widget.default_injections {[{ "layout_type":"homepage", "slot":"footer", "area":"footer", "sort_order":0, "required":true, "exclusive":true, "reason":"整页脚主部件默认安装到全局 chrome 载体（homepage），非首页继承合并" }]}
 *
 * @widget.layout_source {Weline_Theme::css/widgets/footer-chrome-amazon.css,Weline_Theme::css/widgets/widget-container-footer-default.css}
 * @widget.source {Weline_Theme::css/widgets/footer-chrome-amazon.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-container-footer-default-0.js}
 * @param link_groups {default=[],type="footer_link_groups",label="链接分组",description="默认四组；enabled=false 时不渲染该列及扩展槽；自定义分组不带新槽"}
 * @param link_items {default=[],type="footer_link_items",label="链接分项",description="group_key 对应分组键；先于扩展槽渲染"}
 * @param columns {default="4",type="select",label="链接列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param show_back_to_top {default=true,type="bool",label="显示回到顶部"}
 * @param show_locale {default=true,type="bool",label="显示语言/货币条"}
 * @param show_social {default=true,type="bool",label="显示社交媒体"}
 * @param social_items {default=[],type="footer_social_items",label="社交媒体"}
 * @param float_social {default=true,type="bool",label="侧边悬浮社媒",description="与底部社媒同源链接；关闭则不显示屏幕边缘竖条"}
 * @param float_social_side {default="left",type="select",label="悬浮位置",options={left:"左侧",right:"右侧"}}
 * @param show_legal {default=true,type="bool",label="显示法律链接与版权"}
 * @param legal_links {default=[],type="footer_legal_links",label="法律与政策链接"}
 * @param copyright_text {default="",type="string",label="版权文字",description="留空使用主题默认；可用 year 占位符"}
 * @param site_logo_text {default="",type="string",label="页脚 Logo 文字",description="留空使用当前网站名称；框架占位 Weline/韦林 同样回落到网站名称"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\FooterCopyrightHelper;
use Weline\Theme\Helper\FooterDefaultLinksHelper;
use Weline\Theme\Helper\SiteBrand;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-container');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$label = static function (mixed $value) use ($esc): string {
    $raw = trim((string)$value);
    if ($raw === '') {
        return '';
    }

    return $esc(WidgetI18n::label($raw));
};
$toBool = static function (mixed $value, bool $default): bool {
    if ($value === null) {
        return $default;
    }
    if (is_bool($value)) {
        return $value;
    }
    if (is_int($value) || is_float($value)) {
        return ((int)$value) !== 0;
    }
    $normalized = strtolower(trim((string)$value));
    if (in_array($normalized, ['1', 'true', 'yes', 'on'], true)) {
        return true;
    }
    if (in_array($normalized, ['0', 'false', 'no', 'off', ''], true)) {
        return false;
    }

    return $default;
};

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$linkGroups = FooterDefaultLinksHelper::normalizeRenderableGroups(
    $this->getData('link_groups'),
    $this->getData('link_items')
);
$columns = (string)($this->getData('columns') ?? '4');
if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '4';
}
$showBackToTop = $toBool($this->getData('show_back_to_top'), true);
$showLocale = $toBool($this->getData('show_locale'), true);
$showSocial = $toBool($this->getData('show_social'), true);
$floatSocial = $toBool($this->getData('float_social'), true);
$floatSocialSide = strtolower(trim((string)($this->getData('float_social_side') ?? 'left')));
if (!in_array($floatSocialSide, ['left', 'right'], true)) {
    $floatSocialSide = 'left';
}
$showLegal = $toBool($this->getData('show_legal'), true);
$socialItems = FooterDefaultLinksHelper::normalizeSocialItems($this->getData('social_items'));
$legalLinks = FooterDefaultLinksHelper::normalizeLegalLinks($this->getData('legal_links'));
$themeFallbackSiteLogoText = '';
/** @var SiteBrand $siteBrand */
$siteBrand = ObjectManager::getInstance(SiteBrand::class);
$siteLogoText = $siteBrand instanceof SiteBrand
    ? $siteBrand->resolveFrontendWordmark(
        trim((string)($this->getData('site_logo_text') ?? '')),
    )
    : WidgetI18n::label(
        trim((string)($this->getData('site_logo_text') ?? '')),
    );
$localizedSiteLogoText = $siteLogoText;
$localizedRights = WidgetI18n::label('保留所有权利');
$rawCopyright = $this->getData('copyright_text');
if ($rawCopyright === null || trim((string)$rawCopyright) === '') {
    $copyrightText = '© ' . date('Y') . ' ' . $localizedSiteLogoText . '. ' . $localizedRights;
} else {
    $copyrightText = FooterCopyrightHelper::resolve((string)$rawCopyright);
    $copyrightText = str_replace(
        ['Weline', '韦林', '保留所有权利'],
        [$localizedSiteLogoText, $localizedSiteLogoText, $localizedRights],
        $copyrightText,
    );
}
$gridClass = 'footer-content footer-content--cols-' . $columns;
?>
<footer id="footer"
        class="weline-footer <?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
        weline-code="<?= $esc($scope->code) ?>"
        data-uid="<?= $esc($scope->uid) ?>"
        data-js-ns="<?= $esc($scope->jsNs) ?>"
        data-widget-code="footer-container"
        data-testid="footer-container"
        data-layout="default"
        data-layout-type="default"
        data-layout-option="default">
    <w:hook>Weline_Theme::frontend::partials::footer::before</w:hook>
    <w:hook>footer</w:hook>

    <?php if ($showBackToTop): ?>
        <button type="button" class="footer-back-to-top" id="navBackToTop" title="<?= $esc((string)__("回到顶部")) ?>">
            <i class="fas fa-arrow-up footer-back-to-top__icon" aria-hidden="true"></i>
            <span class="footer-back-to-top__text"><lang>回到顶部</lang></span>
        </button>
        <span hidden data-widget-script="theme-container-footer-default-0"></span>
    <?php endif; ?>

    <div class="footer-nav">
        <div class="footer-container">
            <w:hook>Weline_Theme::frontend::partials::footer::content-before</w:hook>

            <div class="<?= $esc($gridClass) ?>">
                <?php foreach ($linkGroups as $group):
                    $sectionClass = trim('footer-section ' . (string)($group['section_class'] ?? ''));
                    $titleHtml = $label($group['title'] ?? '');
                    $items = is_array($group['items'] ?? null) ? $group['items'] : [];
                    ?>
                    <div class="<?= $esc($sectionClass) ?>" data-footer-group="<?= $esc((string)($group['key'] ?? '')) ?>">
                        <?php if ($titleHtml !== ''): ?>
                            <h3 class="footer-section__title"><?= $titleHtml ?></h3>
                        <?php endif; ?>
                        <?php
                        $groupKey = (string)($group['key'] ?? '');
                        $hasExtrasSlot = in_array($groupKey, ['about', 'partner', 'payment', 'help'], true);
                        if ($items !== [] || $hasExtrasSlot):
                            ?>
                            <div class="footer-section__links">
                                <?php foreach ($items as $item):
                                    $itemLabel = $label($item['label'] ?? '');
                                    $itemUrl = FooterDefaultLinksHelper::splitUrlForTaglib((string)($item['url'] ?? '#'));
                                    $openNew = !empty($item['open_in_new']);
                                    if ($itemLabel === '') {
                                        continue;
                                    }
                                    ?>
                                    <a class="footer-section__link"
                                       href="<?php if ($itemUrl['url'] !== ''): ?><?= $esc($itemUrl['url']) ?><?php else: ?>@url{$itemUrl['url_path']}<?php endif; ?>"<?= $openNew ? ' target="_blank" rel="noopener noreferrer"' : '' ?>>
                                        <?= $itemLabel ?>
                                    </a>
                                <?php endforeach; ?>
                                <?php
                                // 槽 id 必须字面量，供 Taglib/槽目录静态扫描；仅标准 key 输出固定扩展槽。
                                // 扩展部件（如我要推广）为裸 a，硬链须同结构，禁止另开 ul。
                                if ($groupKey === 'about'): ?>
                                    <w:slot id="footer-about-links"
                                            name="了解我们扩展"
                                            accept="footer-blog-link,footer-news-link,layout-footer-about-links"
                                            multiple="true"
                                            position="footer"
                                            class="footer-section__extras"></w:slot>
                                <?php elseif ($groupKey === 'partner'): ?>
                                    <w:slot id="footer-partner-links"
                                            name="合作信息扩展"
                                            accept="footer-publish-link,footer-promote-link,layout-footer-partner-links"
                                            multiple="true"
                                            position="footer"
                                            class="footer-section__extras"></w:slot>
                                <?php elseif ($groupKey === 'payment'): ?>
                                    <w:slot id="footer-payment-account-links"
                                            name="支付与账户扩展"
                                            accept="footer-payment-methods-link,footer-social-login-link,footer-currency-rates-link,footer-campaign-link,layout-footer-payment-account-links"
                                            multiple="true"
                                            position="footer"
                                            class="footer-section__extras"></w:slot>
                                <?php elseif ($groupKey === 'help'): ?>
                                    <w:slot id="footer-help-links"
                                            name="帮助中心扩展"
                                            accept="footer-my-account-link,footer-my-orders-link,footer-shipping-info-link,footer-returns-policy-link,footer-faq-link,footer-contact-service-link,layout-footer-help-links"
                                            multiple="true"
                                            position="footer"
                                            class="footer-section__extras"></w:slot>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>

            <w:hook>Weline_Theme::frontend::partials::footer::content-after</w:hook>
        </div>
    </div>

    <?php if ($showLocale): ?>
        <div class="footer-locale w-surface-inverse" data-surface="inverse" role="navigation" aria-label="<?= $esc((string)__("站点偏好")) ?>">
            <div class="footer-container footer-locale__inner">
                <a class="footer-locale__logo" href="@url{'/'}" title="<?= $esc($siteLogoText) ?>">
                    <span class="footer-locale__logo-mark" aria-hidden="true"><?= $esc(mb_substr($siteLogoText, 0, 1)) ?></span>
                    <span class="footer-locale__logo-text"><?= $esc($siteLogoText) ?></span>
                </a>
                <div class="footer-locale__controls">
                    <w:slot id="footer-language"
                            name="语言"
                            accept="layout-footer-language,language-switcher,language"
                            exclusive="true"
                            position="footer"
                            class="footer-locale__control">
                        <w:hook>footer-language-switcher<else/>
                            <w:hook>header-language-switcher<else/>
                                <span class="footer-locale__chip"><lang>语言</lang></span>
                            </w:hook>
                        </w:hook>
                    </w:slot>
                    <w:slot id="footer-currency"
                            name="货币"
                            accept="layout-footer-currency,currency-switcher,currency"
                            exclusive="true"
                            position="footer"
                            class="footer-locale__control">
                        <w:hook>footer-currency-switcher<else/>
                            <w:hook>header-currency-switcher<else/>
                                <span class="footer-locale__chip"><lang>货币</lang></span>
                            </w:hook>
                        </w:hook>
                    </w:slot>
                </div>
            </div>
        </div>
    <?php endif; ?>

    <div class="footer-bottom-band">
        <w:hook>Weline_Theme::frontend::partials::footer::social-media-before<else/></w:hook>
        <?php if ($showSocial && $socialItems !== []): ?>
            <w:slot id="footer-social"
                    name="社交媒体"
                    accept="layout-footer-social,layout-global-footer-social,footer-social,social"
                    exclusive="true"
                    position="footer"
                    class="footer-social-media">
                <div class="footer-container footer-social-media__inner">
                    <?= $this->fetch('Weline_Theme::theme/frontend/components/social-profile-links.phtml', [
                        'items' => $socialItems,
                        'link_class' => 'footer-social-link',
                        'icon_class' => 'footer-social-icon',
                        'icon_size' => '20',
                    ]) ?>
                </div>
            </w:slot>
        <?php endif; ?>
        <w:hook>Weline_Theme::frontend::partials::footer::social-media-after<else/></w:hook>

        <?php if ($showLegal): ?>
            <w:slot id="footer-copyright"
                    name="版权信息"
                    accept="layout-footer-copyright,layout-global-footer-copyright,footer-copyright,copyright"
                    exclusive="true"
                    position="footer"
                    class="footer-legal">
                <div class="footer-container">
                    <w:hook>Weline_Theme::frontend::partials::footer::copyright-before</w:hook>
                    <nav class="footer-legal__links" aria-label="<?= $esc((string)__("法律与政策")) ?>">
                        <?php foreach ($legalLinks as $legal):
                            $openNew = !empty($legal['open_in_new']);
                            $legalUrl = FooterDefaultLinksHelper::splitUrlForTaglib((string)($legal['url'] ?? '#'));
                            ?>
                            <a href="<?php if ($legalUrl['url'] !== ''): ?><?= $esc($legalUrl['url']) ?><?php else: ?>@url{$legalUrl['url_path']}<?php endif; ?>"<?= $openNew ? ' target="_blank" rel="noopener noreferrer"' : '' ?>>
                                <?= $label($legal['text'] ?? '') ?>
                            </a>
                        <?php endforeach; ?>
                    </nav>
                    <p class="footer-legal__copy"><?= $esc($copyrightText) ?></p>
                    <w:hook>Weline_Theme::frontend::partials::footer::copyright-after</w:hook>
                </div>
            </w:slot>
        <?php endif; ?>
    </div>

    <?php if ($floatSocial && $socialItems !== []):
        $floatPanelId = 'footer-social-float-panel-' . $esc($scope->uid);
        ?>
        <nav class="footer-social-float"
             data-side="<?= $esc($floatSocialSide) ?>"
             data-testid="footer-social-float"
             data-weline-load="footerSocialFloat"
             data-collapsed-label="<?= $esc((string)__('展开社交媒体')) ?>"
             data-expanded-label="<?= $esc((string)__('收起社交媒体')) ?>"
             aria-label="<?= $esc((string)__('官方社交媒体')) ?>">
            <div class="footer-social-float__panel"
                 id="<?= $floatPanelId ?>"
                 data-float-panel>
                <?= $this->fetch('Weline_Theme::theme/frontend/components/social-profile-links.phtml', [
                    'items' => $socialItems,
                    'link_class' => 'footer-social-link footer-social-float__link',
                    'icon_class' => 'footer-social-icon',
                    'icon_size' => '14',
                ]) ?>
            </div>
            <button type="button"
                    class="footer-social-float__toggle"
                    data-float-toggle
                    data-testid="footer-social-float-toggle"
                    aria-expanded="true"
                    aria-controls="<?= $floatPanelId ?>"
                    aria-label="<?= $esc((string)__('收起社交媒体')) ?>">
                <span class="footer-social-float__toggle-icon" aria-hidden="true">
                    <w:icon name="chevron-left" size="xs"></w:icon>
                </span>
            </button>
        </nav>
    <?php endif; ?>

    <w:hook>Weline_Theme::frontend::partials::footer::after</w:hook>
</footer>

