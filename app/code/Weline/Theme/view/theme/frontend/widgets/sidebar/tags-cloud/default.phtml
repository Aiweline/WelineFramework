<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-sidebar-tags-cloud-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 标签云部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {tags-cloud}
 * @widget.name {标签云}
 * @widget.description {以标签云形式展示热门标签}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="热门标签",type="string",label="标题"}
 * @param limit {default=20,type="number",label="显示数量"}
 * @param order_by {default="count",type="select",label="排序方式",options={count:"使用次数",name:"名称",random:"随机"}}
 * @param show_count {default=false,type="bool",label="显示使用次数"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('tags-cloud');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('热门标签');
$limit = (int)($this->getData('limit') ?? 20);
$orderBy = $this->getData('order_by') ?? 'count';
$showCount = (bool)($this->getData('show_count') ?? false);

$tags = [
    ['name' => __('手机'), 'url' => '/tag/phone', 'count' => 156],
    ['name' => __('电脑'), 'url' => '/tag/computer', 'count' => 89],
    ['name' => __('耳机'), 'url' => '/tag/headphone', 'count' => 67],
    ['name' => __('相机'), 'url' => '/tag/camera', 'count' => 45],
    ['name' => __('智能手表'), 'url' => '/tag/smartwatch', 'count' => 78],
    ['name' => __('平板'), 'url' => '/tag/tablet', 'count' => 56],
    ['name' => __('充电器'), 'url' => '/tag/charger', 'count' => 34],
    ['name' => __('数据线'), 'url' => '/tag/cable', 'count' => 123],
    ['name' => __('保护壳'), 'url' => '/tag/case', 'count' => 98],
    ['name' => __('蓝牙'), 'url' => '/tag/bluetooth', 'count' => 76],
    ['name' => __('音箱'), 'url' => '/tag/speaker', 'count' => 45],
    ['name' => __('键盘'), 'url' => '/tag/keyboard', 'count' => 67],
    ['name' => __('鼠标'), 'url' => '/tag/mouse', 'count' => 89],
    ['name' => __('显示器'), 'url' => '/tag/monitor', 'count' => 34],
    ['name' => __('路由器'), 'url' => '/tag/router', 'count' => 23],
];

switch ($orderBy) {
    case 'name':
        usort($tags, fn ($a, $b) => strcmp($a['name'], $b['name']));
        break;
    case 'random':
        shuffle($tags);
        break;
    default:
        usort($tags, fn ($a, $b) => $b['count'] - $a['count']);
}

$tags = array_slice($tags, 0, $limit);
$maxCount = max(array_column($tags, 'count'));
$minCount = min(array_column($tags, 'count'));
$countRange = $maxCount - $minCount ?: 1;
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($title !== ''): ?>
        <h3 class="widget-title">
            <w:icon name="circle" size="sm"></w:icon>
            <?= $esc((string)$title) ?>
        </h3>
    <?php endif; ?>
    <div class="tags-container">
        <?php foreach ($tags as $tag):
            $fontSize = 12 + (($tag['count'] - $minCount) / $countRange) * 8;
        ?>
            <a href="<?= $esc((string)$tag['url']) ?>"
               class="tag-item"
               data-widget-style="--wc-tag-size: <?= round($fontSize) ?>px">
                <?= $esc((string)$tag['name']) ?>
                <?php if ($showCount): ?>
                    <span class="tag-count">(<?= (int)$tag['count'] ?>)</span>
                <?php endif; ?>
            </a>
        <?php endforeach; ?>
    </div>
</section>

