<?php
/**
 * 新品到达部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {new-arrivals}
 * @widget.name {新品上架}
 * @widget.description {展示最新上架的产品}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page", "category"]}
 * @widget.supports {["layout-homepage-new-arrivals","layout-homepage-content","layout-products-recommendations","layout-cms-content","layout-default-content"]}
 *
 * @param title {default="新品上架",type="string",label="标题"}
 * @param subtitle {default="发现最新商品",type="string",label="副标题"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param days {default=30,type="number",label="天数范围",description="多少天内上架的算新品"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param show_new_badge {default=true,type="bool",label="显示新品标签"}
 * @param layout {default="grid",type="select",label="布局方式",options={grid:"网格",carousel:"轮播"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */


use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\ProductCardRenderer;
use Weline\Product\Service\StorefrontProductWidgetCatalog;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductCardUrl;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('new-arrivals');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = WidgetI18n::label((string)($this->getData('title') ?? '新品上架'));
$subtitle = WidgetI18n::label((string)($this->getData('subtitle') ?? '发现最新商品'));
$limit = (int)($this->getData('limit') ?? 8);
$days = (int)($this->getData('days') ?? 30);
$columns = $this->getData('columns') ?? '4';
$showNewBadge = (bool)($this->getData('show_new_badge') ?? true);
$layout = $this->getData('layout') ?? 'grid';
$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);

$products = [];
try {
    if (class_exists(StorefrontProductWidgetCatalog::class)) {
        $products = ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)
            ->newArrivalCards($limit, $days);
    }
} catch (\Throwable) {
    $products = [];
}

if ($products === [] && $isPreviewMode) {
    foreach (ThemeDemoCatalog::products($limit, 20) as $index => $demo) {
        $products[] = [
            'id' => $demo['id'],
            'product_id' => $demo['id'],
            'name' => $demo['name'],
            'url' => $demo['url'],
            'image' => $demo['image'],
            'price' => $demo['price'],
            'original_price' => $demo['original_price'],
            'rating' => $demo['rating'],
            'review_count' => $demo['review_count'],
            'created_at' => date('Y-m-d', strtotime('-' . min($days, rand(1, max(1, $days))) . ' days')),
            'is_new' => 1,
            'is_demo' => 1,
            'stock' => 20 + ($index * 11),
        ];
    }
}

// 店面：新品窗口无命中时回退到同目录精选货架，避免首页货架空洞。
if ($products === [] && !$isPreviewMode) {
    try {
        if (class_exists(StorefrontProductWidgetCatalog::class)) {
            $products = ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)->cards($limit);
        }
    } catch (\Throwable) {
        $products = [];
    }
}

if ($products === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty
    // HTML as a warning toast. Keep visually hidden so storefront still "hides".
    ?>
<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="new-arrivals-empty"
         hidden
         aria-hidden="true"></section>
    <?php
    return;
}

foreach ($products as $index => &$product) {
    $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
    $product['id'] = $productId;
    $product['product_id'] = $productId;
    $route = trim((string)($product['url'] ?? ''));
    $productLink = ProductCardUrl::splitForTaglib($route);
    $product['url'] = $productLink['url'];
    $product['url_path'] = $productLink['url_path'];
    if ($isPreviewMode && !empty($product['is_demo']) && !isset($product['stock'])) {
        $product['stock'] = 20 + ($index * 11);
    }
}
unset($product);
$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);
$showPrice = true;
$showRating = true;
$showAddToCart = true;


?>


<section class="<?= $esc($wc) ?> weline-product-card-shelf<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"<?= $scopeLabelStyle !== '' ? ' style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
    <?php if ($title || $subtitle): ?>
        <div class="widget-header">
            <?php if ($title): ?>
                <h2 class="widget-title"><?= htmlspecialchars($title) ?></h2>
            <?php endif; ?>
            <?php if ($subtitle): ?>
                <p class="widget-subtitle"><?= htmlspecialchars($subtitle) ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>
    
    <div class="products-container layout-<?= htmlspecialchars($layout) ?>">
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-prev" type="button">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>
        
        <div class="products-wrapper">
            <div class="products-grid columns-<?= htmlspecialchars($columns) ?>">
                <?php foreach ($products as $index => $product): ?>
                    <?php
                    $labelFlags = ProductLabelStyle::resolveFlags($product, $index);
                    $product['is_demo'] = !empty($labelFlags['is_demo']);
                    $product['is_new'] = !empty($labelFlags['is_new']);
                    $product['is_sale'] = !empty($labelFlags['is_sale']);
                    ?>
                    <w:product:card product="product" show-price="showPrice" show-rating="showRating" show-add-to-cart="showAddToCart" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="showNewBadge" density="standard" wishlist-pixel="true" />
                <?php endforeach; ?>
            </div>
        </div>
        
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-next" type="button">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
    </div>
    
    <div class="widget-footer">
        <a href="@url{'new-arrivals'}" class="btn-view-all">
            <?= __('查看全部新品') ?>
            <w:icon name="arrow-right" size="sm"></w:icon>
        </a>
    </div>
</section>

<style>
.<?= $wc ?> {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-block: var(--weline-space-8);
    padding-inline: 0;
    box-sizing: border-box;
}

.<?= $wc ?> .widget-header { margin-bottom: var(--weline-space-5); }
.<?= $wc ?> .widget-title {
    margin: 0;
    color: var(--weline-theme-text);
    font-size: clamp(var(--font-size-2xl), 2vw, var(--font-size-4xl));
    font-weight: var(--weline-font-weight-bold);
    line-height: 1.2;
}
.<?= $wc ?> .widget-subtitle { margin: var(--weline-space-2) 0 0; color: var(--weline-theme-text-muted); }
.<?= $wc ?> .products-container { width: 100%; }
.<?= $wc ?> .products-wrapper { width: 100%; overflow: visible; }
.<?= $wc ?> .layout-carousel .products-wrapper { overflow: hidden; }
.<?= $wc ?> .products-grid {
    display: grid;
    gap: var(--weline-space-4);
    width: 100%;
    box-sizing: border-box;
    align-items: stretch;
}
.<?= $wc ?> .products-grid.columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.<?= $wc ?> .products-grid.columns-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.<?= $wc ?> .products-grid.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.<?= $wc ?> .products-grid.columns-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.<?= $wc ?> .products-grid.columns-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.<?= $wc ?> .layout-carousel .products-grid {
    display: flex;
    gap: var(--weline-space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
}
.<?= $wc ?> .layout-carousel .product-card {
    flex: 0 0 auto;
    width: min(var(--layout-sidebar-width), calc((100% - var(--spacing-2xl)) / 4));
    scroll-snap-align: start;
}
.<?= $wc ?> .widget-footer { text-align: center; margin-top: var(--weline-space-8); }
.<?= $wc ?> .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--weline-space-3) var(--weline-space-8);
    border: var(--border-width-medium) solid var(--weline-theme-primary);
    color: var(--weline-theme-primary);
    text-decoration: none;
    border-radius: var(--token-size-30px);
    font-weight: 600;
    transition: all 0.3s;
}
.<?= $wc ?> .btn-view-all:hover {
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
}

@media (max-width: 980px) {
    .<?= $wc ?> .products-grid.columns-4,
    .<?= $wc ?> .products-grid.columns-5,
    .<?= $wc ?> .products-grid.columns-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* Keep 2 columns through theme-editor iframe widths (~600–640px); 1-col only on true phones. */
@media (max-width: 480px) {
    .<?= $wc ?> .products-grid,
    .<?= $wc ?> .products-grid.columns-2,
    .<?= $wc ?> .products-grid.columns-3,
    .<?= $wc ?> .products-grid.columns-4,
    .<?= $wc ?> .products-grid.columns-5,
    .<?= $wc ?> .products-grid.columns-6 {
        grid-template-columns: minmax(0, 1fr);
    }
}
</style>
