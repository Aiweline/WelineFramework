<?php
/**
 * 页脚「FAQ/常见问题」扩展：Theme FAQ 入口（/faq）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-faq-link}
 * @widget.name {页脚 FAQ 链接}
 * @widget.description {页脚帮助扩展槽：跳转 Theme /faq FAQ 布局；默认注入 footer-help-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-help-links}
 * @widget.supports {["footer-faq-link","layout-footer-help-links"]}
 *
 * @param label {default="FAQ/常见问题",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-faq-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: 'FAQ/常见问题';
$label = WidgetI18n::label($labelSource, 'FAQ/常见问题');
?>
<a class="footer-help-link footer-faq-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-faq-link"
   href="@url{'faq'}"><?= $esc($label) ?></a>
