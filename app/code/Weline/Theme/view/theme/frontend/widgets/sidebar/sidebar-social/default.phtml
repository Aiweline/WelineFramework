<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-sidebar-sidebar-social-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 社交链接（侧栏）部件
 *
 * @widget.code {sidebar-social}
 * @widget.name {侧栏社交}
 * @widget.description {侧边栏社交媒体链接，支持微信二维码}
 * @widget.type {social}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-contact-methods","layout-contact-sidebar","social"]}
 * @widget.compatible {true}
 *
 * @param title {default="关注我们",name="标题",description="部件标题",type=string}
 * @param custom_links {default="",name="自定义社交链接",description="JSON格式的自定义社交链接配置",type=string}
 * @param icon_style {default="colored",name="图标样式",description="图标显示样式",type=select,options={colored:"彩色",mono:"单色",outline:"线框"}}
 * @param gap {default="10px",name="图标间距",description="图标之间的间距",type=string}
 * @param wechat_qr {default="",name="微信二维码",description="从媒体库选择微信公众号二维码",type=media_image}
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\SocialIconHelper;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-social');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('关注我们');
$iconStyle = $this->getData('icon_style') ?? 'colored';
if (!in_array($iconStyle, ['colored', 'mono', 'outline'], true)) {
    $iconStyle = 'colored';
}
$gap = $this->getData('gap') ?? '10px';
if (preg_match('/^(\d{1,3}(?:\.\d{1,2})?)(px|rem|em)$/', trim((string)$gap)) !== 1) {
    $gap = '10px';
}
$wechatQr = LegacyMediaUrl::sanitize($this->getData('wechat_qr') ?? '');
$wechatQrFileHtml = trim((string)($this->getData('wechat_qr_file_html') ?? ''));

$safeHref = static function (mixed $url): string {
    $url = LegacyMediaUrl::sanitize($url);

    return $url !== '' && !str_starts_with($url, '#') ? $url : '';
};

$customLinks = $this->getData('custom_links') ?? '';
$socials = [];

if ($customLinks) {
    $customLinksArray = json_decode((string)$customLinks, true);
    if (is_array($customLinksArray)) {
        foreach ($customLinksArray as $link) {
            if (!empty($link['platform']) && !empty($link['url'])) {
                $platform = preg_replace('/[^a-z0-9_-]/', '', strtolower((string)$link['platform'])) ?: 'link';
                $url = $safeHref($link['url']);
                if ($url === '') {
                    continue;
                }
                $socials[] = [
                    'platform' => $platform,
                    'name' => SocialIconHelper::getName($platform) ?? $link['name'] ?? $platform,
                    'url' => $url,
                    'color' => SocialIconHelper::getColor($platform) ?? '#666',
                ];
            }
        }
    }
}

if (empty($socials)) {
    $platforms = ['facebook', 'twitter', 'instagram', 'youtube', 'linkedin', 'pinterest', 'tiktok', 'weibo', 'wechat', 'github', 'telegram', 'whatsapp', 'discord', 'reddit', 'snapchat'];
    foreach ($platforms as $platform) {
        $url = $this->getData($platform) ?? '';
        if ($url) {
            $url = $safeHref($url);
            if ($url === '') {
                continue;
            }
            $socials[] = [
                'platform' => $platform,
                'name' => SocialIconHelper::getName($platform) ?? ucfirst($platform),
                'url' => $url,
                'color' => SocialIconHelper::getColor($platform) ?? '#666',
            ];
        }
    }
}

if ($socials === [] && $wechatQr === '' && $wechatQrFileHtml === '' && !$isPreviewMode) {
    return;
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-style="<?= $esc($iconStyle) ?>"
         data-widget-style="--wc-social-gap: <?= $esc((string)$gap) ?>;">
    <?php if ($title !== ''): ?>
        <h3 class="widget-title"><?= $esc((string)$title) ?></h3>
    <?php endif; ?>
    <div class="social-links">
        <?php foreach ($socials as $social): ?>
            <a href="<?= $esc((string)$social['url']) ?>"
               class="social-link social-link-<?= $esc((string)$social['platform']) ?>"
               title="<?= $esc((string)$social['name']) ?>"
               target="_blank"
               rel="noopener noreferrer"
               data-widget-style="--brand-color: <?= $esc((string)$social['color']) ?>;">
                <?= SocialIconHelper::renderIcon($social['platform'], ['class' => 'social-icon', 'width' => '20', 'height' => '20']) ?>
            </a>
        <?php endforeach; ?>
    </div>
    <?php if ($wechatQrFileHtml !== '' || $wechatQr !== ''): ?>
        <div class="wechat-qr">
            <p class="qr-label">
                <?= SocialIconHelper::renderIcon('wechat', ['class' => 'wechat-icon', 'width' => '18', 'height' => '18']) ?>
                <?= __('微信扫码关注') ?>
            </p>
            <?php if ($wechatQrFileHtml !== ''): ?>
                <div class="qr-image qr-image--asset"><?= $wechatQrFileHtml ?></div>
            <?php else: ?>
                <img src="<?= $esc($wechatQr) ?>" alt="<?= __('微信二维码') ?>" class="qr-image">
            <?php endif; ?>
        </div>
    <?php endif; ?>
</section>

