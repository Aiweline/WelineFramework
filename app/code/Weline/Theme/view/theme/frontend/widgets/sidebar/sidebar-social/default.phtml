<?php
/**
 * 社交链接（侧栏）部件
 *
 * @widget.code {sidebar-social}
 * @widget.name {侧栏社交}
 * @widget.description {侧边栏社交媒体链接，支持微信二维码}
 * @widget.type {social}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-contact-methods","layout-contact-sidebar","social"]}
 * @widget.compatible {true}
 *
 * @param title {default="关注我们",name="标题",description="部件标题",type=string}
 * @param custom_links {default="",name="自定义社交链接",description="JSON格式的自定义社交链接配置",type=string}
 * @param icon_style {default="colored",name="图标样式",description="图标显示样式",type=select,options={colored:"彩色",mono:"单色",outline:"线框"}}
 * @param gap {default="10px",name="图标间距",description="图标之间的间距",type=string}
 * @param wechat_qr {default="",name="微信二维码",description="微信公众号二维码图片URL",type=string}
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Theme\Helper\SocialIconHelper;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-social');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('关注我们');
$iconStyle = $this->getData('icon_style') ?? 'colored';
if (!in_array($iconStyle, ['colored', 'mono', 'outline'], true)) {
    $iconStyle = 'colored';
}
$gap = $this->getData('gap') ?? '10px';
if (preg_match('/^(\d{1,3}(?:\.\d{1,2})?)(px|rem|em)$/', trim((string)$gap)) !== 1) {
    $gap = '10px';
}
$wechatQr = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('wechat_qr') ?? '');

$customLinks = $this->getData('custom_links') ?? '';
$socials = [];

if ($customLinks) {
    $customLinksArray = json_decode((string)$customLinks, true);
    if (is_array($customLinksArray)) {
        foreach ($customLinksArray as $link) {
            if (!empty($link['platform']) && !empty($link['url'])) {
                $platform = (string)$link['platform'];
                $socials[] = [
                    'platform' => $platform,
                    'name' => SocialIconHelper::getName($platform) ?? $link['name'] ?? $platform,
                    'url' => $link['url'],
                    'color' => SocialIconHelper::getColor($platform) ?? '#666',
                ];
            }
        }
    }
}

if (empty($socials)) {
    $platforms = ['facebook', 'twitter', 'instagram', 'youtube', 'linkedin', 'pinterest', 'tiktok', 'weibo', 'wechat', 'github', 'telegram', 'whatsapp', 'discord', 'reddit', 'snapchat'];
    foreach ($platforms as $platform) {
        $url = $this->getData($platform) ?? '';
        if ($url) {
            $socials[] = [
                'platform' => $platform,
                'name' => SocialIconHelper::getName($platform) ?? ucfirst($platform),
                'url' => $url,
                'color' => SocialIconHelper::getColor($platform) ?? '#666',
            ];
        }
    }
}

if (empty($socials)) {
    $socials = [
        ['platform' => 'facebook', 'name' => 'Facebook', 'url' => '#', 'color' => '#1877f2'],
        ['platform' => 'twitter', 'name' => 'Twitter/X', 'url' => '#', 'color' => '#000000'],
        ['platform' => 'instagram', 'name' => 'Instagram', 'url' => '#', 'color' => '#e4405f'],
        ['platform' => 'youtube', 'name' => 'YouTube', 'url' => '#', 'color' => '#ff0000'],
    ];
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-style="<?= $esc($iconStyle) ?>"
         style="--wc-social-gap: <?= $esc((string)$gap) ?>;">
    <?php if ($title !== ''): ?>
        <h3 class="widget-title"><?= $esc((string)$title) ?></h3>
    <?php endif; ?>
    <div class="social-links">
        <?php foreach ($socials as $social): ?>
            <a href="<?= $esc((string)$social['url']) ?>"
               class="social-link social-link-<?= $esc((string)$social['platform']) ?>"
               title="<?= $esc((string)$social['name']) ?>"
               target="_blank"
               rel="noopener noreferrer"
               style="--brand-color: <?= $esc((string)$social['color']) ?>;">
                <?= SocialIconHelper::renderIcon($social['platform'], ['class' => 'social-icon', 'width' => '20', 'height' => '20']) ?>
            </a>
        <?php endforeach; ?>
    </div>
    <?php if ($wechatQr !== ''): ?>
        <div class="wechat-qr">
            <p class="qr-label">
                <?= SocialIconHelper::renderIcon('wechat', ['class' => 'wechat-icon', 'width' => '18', 'height' => '18']) ?>
                <?= __('微信扫码关注') ?>
            </p>
            <img src="<?= $esc($wechatQr) ?>" alt="<?= __('微信二维码') ?>" class="qr-image">
        </div>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg, 10px);
    padding: var(--weline-space-5, 20px);
    box-sizing: border-box;
}

.<?= $wc ?> .widget-title {
    font-size: var(--weline-font-size-base, 16px);
    font-weight: 600;
    margin: 0 0 var(--weline-space-4, 15px);
    text-align: center;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .social-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--wc-social-gap, var(--weline-space-3, 10px));
}

.<?= $wc ?> .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    text-decoration: none;
    transition: all var(--weline-theme-transition-base, 0.3s ease);
}

.<?= $wc ?>[data-style="colored"] .social-link {
    background: var(--brand-color);
    color: var(--weline-theme-on-primary);
}

.<?= $wc ?>[data-style="colored"] .social-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--weline-theme-shadow-md);
}

.<?= $wc ?>[data-style="mono"] .social-link {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>[data-style="mono"] .social-link:hover {
    background: var(--brand-color);
    color: var(--weline-theme-on-primary);
}

.<?= $wc ?>[data-style="outline"] .social-link {
    background: transparent;
    border: var(--weline-theme-border-width, 2px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>[data-style="outline"] .social-link:hover {
    border-color: var(--brand-color);
    color: var(--brand-color);
}

.<?= $wc ?> .wechat-qr {
    margin-top: var(--weline-space-5, 20px);
    padding-top: var(--weline-space-5, 20px);
    border-top: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
    text-align: center;
}

.<?= $wc ?> .qr-label {
    font-size: var(--weline-font-size-sm, 13px);
    color: var(--weline-theme-success);
    margin: 0 0 var(--weline-space-3, 10px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-1, 5px);
}

.<?= $wc ?> .qr-image {
    max-width: 150px;
    border-radius: var(--weline-radius-md, 8px);
    display: block;
    margin: 0 auto;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-3, 12px);
}
</style>
