<script>
(function () {
    var popup = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!popup) return;

    if (popup.classList.contains('editor-preview-mode') || popup.classList.contains('is-preview') || popup.closest('.widget-preview-canvas')) {
        popup.style.display = 'block';
        return;
    }

    var trigger = popup.dataset.trigger;
    var delay = parseInt(popup.dataset.delay, 10);
    var scrollPercent = parseInt(popup.dataset.scroll, 10);
    var showOnce = popup.dataset.showOnce === 'true';
    var cookieDays = parseInt(popup.dataset.cookieDays, 10);
    var cookieName = '<?= $esc($scope->jsNs) ?>-shown-' + popup.getAttribute('data-uid');

    function getCookie(name) {
        var value = '; ' + document.cookie;
        var parts = value.split('; ' + name + '=');
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    function setCookie(name, value, days) {
        var date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = name + '=' + value + ';expires=' + date.toUTCString() + ';path=/';
    }

    if (showOnce && getCookie(cookieName)) {
        return;
    }

    function showPopup() {
        popup.style.display = 'block';
        document.body.style.overflow = 'hidden';
        if (showOnce) {
            setCookie(cookieName, '1', cookieDays);
        }
    }

    function hidePopup() {
        popup.style.display = 'none';
        document.body.style.overflow = '';
    }

    if (trigger === 'delay') {
        setTimeout(showPopup, delay);
    } else if (trigger === 'scroll') {
        var triggered = false;
        window.addEventListener('scroll', function () {
            if (triggered) return;
            var scrolled = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
            if (scrolled >= scrollPercent) {
                triggered = true;
                showPopup();
            }
        });
    } else if (trigger === 'exit-intent') {
        var exitTriggered = false;
        document.addEventListener('mouseout', function (e) {
            if (exitTriggered) return;
            if (e.clientY <= 0) {
                exitTriggered = true;
                showPopup();
            }
        });
    }

    var closeBtn = popup.querySelector('.popup-close');
    var overlay = popup.querySelector('.popup-overlay');
    if (closeBtn) closeBtn.addEventListener('click', hidePopup);
    if (overlay) overlay.addEventListener('click', hidePopup);

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && popup.style.display === 'block') {
            hidePopup();
        }
    });
})();
</script>
