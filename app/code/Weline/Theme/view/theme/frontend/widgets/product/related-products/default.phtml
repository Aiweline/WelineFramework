    font-weight: 700;
}

.<?= $wc ?> .carousel-arrow {
    display: none;
}

@media (max-width: 768px) {
    .<?= $wc ?> .products-grid,
    .<?= $wc ?> .products-grid.columns-2,
    .<?= $wc ?> .products-grid.columns-3,
    .<?= $wc ?> .products-grid.columns-4,
    .<?= $wc ?> .products-grid.columns-5 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 480px) {
    .<?= $wc ?> .products-grid,
    .<?= $wc ?> .products-grid.columns-2,
