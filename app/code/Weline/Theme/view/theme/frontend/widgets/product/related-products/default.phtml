    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width-thin) solid var(--weline-theme-border);
    border-radius: var(--radius-lg);
    background: var(--weline-theme-surface-raised);
    box-shadow: var(--shadow-sm);
}

