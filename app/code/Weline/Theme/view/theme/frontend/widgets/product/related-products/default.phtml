    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.<?= $wc ?> .product-actions {
    position: absolute;
    top: var(--weline-space-3);
    right: var(--weline-space-3);
    display: flex;
    gap: var(--spacing-sm);
}

.<?= $wc ?> .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-2_25);
    height: var(--spacing-2_25);
    border: 0;
    border-radius: var(--border-radius-full);
    background: var(--color-on-dark-92);
    color: var(--weline-theme-text);
    cursor: pointer;
    box-shadow: 0 var(--spacing-sm) var(--weline-space-5) var(--color-overlay-12);
    text-decoration: none;
}

.<?= $wc ?> .action-btn:disabled {
    cursor: wait;
    opacity: .7;
}

.<?= $wc ?> .btn-wishlist.is-active {
    color: var(--weline-theme-danger);
}

.<?= $wc ?> .action-icon {
    display: block;
    width: var(--font-size-lg);
    height: var(--font-size-lg);
    fill: currentColor;
}

.<?= $wc ?> .product-info {
    display: flex;
    width: auto;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: var(--token-size-6rem);
    padding: var(--spacing-4);
}

.<?= $wc ?> .product-name {
    margin: 0;
    font-size: var(--font-size-base);
    line-height: 1.35;
}

.<?= $wc ?> .product-name a {
    color: var(--weline-theme-text);
    text-decoration: none;
}

.<?= $wc ?> .product-name a:hover {
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .product-rating {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
