}

.<?= $wc ?> .price-original {
    color: var(--weline-theme-text-muted);
    text-decoration: line-through;
}

.<?= $wc ?> .price-current {
    color: var(--weline-theme-primary);
    font-weight: 800;
}

.<?= $wc ?> .btn-add-to-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    width: 100%;
    min-height: var(--spacing-2_75);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
