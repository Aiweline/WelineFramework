<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-content-brand-logos-default.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-content-brand-logos-default-0.js}
 * 品牌Logo部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {brand-logos}
 * @widget.name {品牌Logo}
 * @widget.description {展示合作品牌 Logo；空列表时回退 Theme 织艺谱系目录}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-brands","layout-cms-content","layout-default-content"]}
 * @widget.compatible {true}
 *
 * @param title {default="合作品牌",type="string",label="标题"}
 * @param brands {default=[],type="brand_logo_items",label="品牌列表",description="每项包含名称、图片与链接"}
 * @param columns {default="6",type="select",label="每行列数",options={4:"4列",5:"5列",6:"6列",8:"8列"}}
 * @param layout {default="grid",type="select",label="布局",options={grid:"网格",carousel:"轮播"}}
 * @param grayscale {default=true,type="bool",label="灰度效果"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('brand-logos');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = (string)($this->getData('title') ?? __('合作品牌'));
$brands = $this->getData('brands') ?? [];
if (is_string($brands)) {
    $decoded = json_decode($brands, true);
    $brands = is_array($decoded) ? $decoded : [];
}
if (!is_array($brands)) {
    $brands = [];
}
$columns = (string)($this->getData('columns') ?? '6');
$layout = (string)($this->getData('layout') ?? 'grid');
$grayscale = (bool)($this->getData('grayscale') ?? true);
$hoverColor = (bool)($this->getData('hover_color') ?? true);
$usesCraftDirectory = $brands === [];
$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    $translated = trim(\Weline\Theme\Helper\WidgetI18n::label($source));
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};

// 空列表回退织艺目录时：仅无标题或已是谱系标题才改成谱系名；显式「合作品牌」保留。
if ($usesCraftDirectory && in_array(trim($title), ['', '织艺谱系 · Textile Heritage', (string) __('织艺谱系 · Textile Heritage')], true)) {
    $title = $translateDefaultCopy('织艺谱系 · Textile Heritage', 'Textile Heritage');
} elseif (in_array(trim($title), ['合作品牌', (string) __('合作品牌'), 'Partner brands', 'Partner Brands'], true)) {
    $title = $translateDefaultCopy('合作品牌', 'Partner brands');
}

if (!in_array($columns, ['4', '5', '6', '8'], true)) {
    $columns = '6';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'grid';
}

// 兼容已发布布局中仍挂着空 brands 的 brand-logos：数据权威在 Theme TextileHeritageCatalog。
if ($usesCraftDirectory && class_exists(\Weline\Theme\Service\TextileHeritageCatalog::class)) {
    foreach (\Weline\Theme\Service\TextileHeritageCatalog::items() as $item) {
        $displayName = $translateDefaultCopy($item['name'], $item['caption_en']);
        $brands[] = [
            'name' => $displayName,
            'caption' => $translateDefaultCopy($item['caption'], $item['caption_en']),
            'image' => $item['image'],
            'link' => $item['link'],
        ];
    }
}
?>

<section class="<?= $esc($wc) ?><?= $grayscale ? ' is-grayscale' : '' ?><?= $hoverColor ? ' has-hover-color' : '' ?><?= $usesCraftDirectory ? ' is-craft-directory' : '' ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-site-block="brand-logos"
         data-columns="<?= $esc($columns) ?>">

    <?php if ($title !== ''): ?>
        <div class="brands-header">
            <h2 class="brands-title"><?= $esc($title) ?></h2>
        </div>
    <?php endif; ?>

    <div class="brands-container">
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-prev" type="button" aria-label="<?= __('上一组') ?>">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>

        <div class="brands-wrapper">
            <div class="brands-grid columns-<?= $esc($columns) ?>">
                <?php foreach ($brands as $brand): ?>
                    <?php
                    $rawBrandLink = trim((string)($brand['link'] ?? ''));
                    $brandLinkIsAbsolute = false;
                    $brandLinkPath = '';
                    if ($rawBrandLink !== '') {
                        if (preg_match('#^(?:https?:)?//#i', $rawBrandLink) === 1) {
                            $brandLinkIsAbsolute = true;
                            $brandLinkPath = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($rawBrandLink);
                        } else {
                            $sanitizedBrandLink = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($rawBrandLink);
                            $brandLinkPath = ltrim($sanitizedBrandLink !== '' ? $sanitizedBrandLink : $rawBrandLink, '/');
                        }
                    }
                    $brandImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($brand['image'] ?? '');
                    $brandImageHtml = trim((string)($brand['image_file_html'] ?? ''));
                    $brandName = trim((string)($brand['name'] ?? ''));
                    $brandCaption = trim((string)($brand['caption'] ?? ''));
                    ?>
                    <?php if ($brandLinkIsAbsolute && $brandLinkPath !== ''): ?>
                        <a href="<?= $esc($brandLinkPath) ?>"
                           class="brand-item"
                           title="<?= $esc($brandName) ?>">
                    <?php elseif ($brandLinkPath !== ''): ?>
                        <a href="@url{$brandLinkPath}"
                           class="brand-item"
                           title="<?= $esc($brandName) ?>">
                    <?php else: ?>
                        <div class="brand-item">
                    <?php endif; ?>
                        <?php if ($brandImageHtml !== ''): ?>
                            <div class="brand-logo-media"><?= $brandImageHtml ?></div>
                        <?php elseif ($brandImage !== ''): ?>
                            <img src="<?= $esc($brandImage) ?>"
                                 alt="<?= $esc($brandName) ?>"
                                 class="brand-logo"
                                 loading="lazy">
                        <?php endif; ?>
                        <?php if ($brandName !== ''): ?>
                            <?php if ($brandImage !== '' || $brandImageHtml !== ''): ?>
                                <span class="brand-copy">
                                    <span class="brand-name"><?= $esc($brandName) ?></span>
                                    <?php if ($brandCaption !== '' && $brandCaption !== $brandName): ?>
                                        <span class="brand-caption"><?= $esc($brandCaption) ?></span>
                                    <?php endif; ?>
                                </span>
                            <?php elseif ($brandCaption !== ''): ?>
                                <span class="brand-copy">
                                    <span class="brand-name"><?= $esc($brandName) ?></span>
                                    <span class="brand-caption"><?= $esc($brandCaption) ?></span>
                                </span>
                            <?php else: ?>
                                <span class="brand-name"><?= $esc($brandName) ?></span>
                            <?php endif; ?>
                        <?php endif; ?>
                    <?= $brandLinkPath !== '' ? '</a>' : '</div>' ?>
                <?php endforeach; ?>
            </div>
        </div>

        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-next" type="button" aria-label="<?= __('下一组') ?>">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
    </div>
</section>

<?php if ($layout === 'carousel'): ?>
<span hidden data-widget-script="theme-content-brand-logos-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
<?php endif; ?>
