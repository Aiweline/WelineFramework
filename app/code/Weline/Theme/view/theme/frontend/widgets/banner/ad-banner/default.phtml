<?php
/**
 * 广告横幅部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {ad-banner}
 * @widget.name {广告横幅}
 * @widget.description {通用广告横幅，支持图片链接}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 *
 * @param image {default="",type="media_image",label="广告图片",description="从媒体库选择广告图片"}
 * @param link {default="",type="string",label="链接地址"}
 * @param alt_text {default="广告",type="string",label="替代文字"}
 * @param open_new_tab {default=false,type="bool",label="新窗口打开"}
 * @param border_radius {default="8px",type="string",label="圆角大小"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('ad-banner');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('image') ?? '');
$imageFileHtml = (string)($this->getData('image_file_html') ?? '');
$link = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('link') ?? '');
$altText = $this->getData('alt_text') ?? __('广告');
$openNewTab = (bool)($this->getData('open_new_tab') ?? false);
$borderRadius = trim((string)($this->getData('border_radius') ?? '8px'));
if (preg_match('/^(?:0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em|%))$/D', $borderRadius) !== 1) {
    $borderRadius = '8px';
}
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

if ($isPreviewMode && $image === '') {
    $image = '';
} elseif (empty($image)) {
    $image = $placeholder;
}

$rootStyle = 'border-radius:' . $borderRadius . ';';
if ($isPreviewMode && $image === '') {
    $rootStyle .= 'background:linear-gradient(135deg,var(--weline-theme-primary) 0%,var(--weline-theme-primary-hover) 100%);min-height:56px;';
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">
    <?php if ($link): ?>
        <a href="<?= $esc($link) ?>"
           class="ad-link"
           <?= $openNewTab ? 'target="_blank" rel="noopener noreferrer"' : '' ?>>
    <?php endif; ?>

    <?php if ($imageFileHtml !== ''): ?>
        <div class="ad-image ad-image--asset"><?= $imageFileHtml ?></div>
    <?php elseif ($image !== ''): ?>
        <img src="<?= $esc($image) ?>"
             alt="<?= $esc((string)$altText) ?>"
             class="ad-image"
             loading="lazy">
    <?php elseif ($isPreviewMode): ?>
        <div class="ad-image ad-image--preview" aria-hidden="true"></div>
    <?php endif; ?>

    <span class="ad-label"><?= __('广告') ?></span>

    <?php if ($link): ?>
        </a>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
}

.<?= $wc ?> .ad-link {
    display: block;
    text-decoration: none;
}

.<?= $wc ?> .ad-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--weline-theme-transition-base);
}

.<?= $wc ?> .ad-image--asset img {
    display: block;
    width: 100%;
    height: auto;
}

.<?= $wc ?>:hover .ad-image {
    transform: scale(1.02);
}

.<?= $wc ?> .ad-label {
    position: absolute;
    top: var(--weline-space-2);
    right: var(--weline-space-2);
    padding: var(--spacing-0_5) var(--weline-space-2);
    background: color-mix(in srgb, var(--weline-theme-overlay) 60%, transparent);
    color: var(--weline-theme-on-primary);
    font-size: var(--weline-font-size-xs);
    border-radius: var(--weline-radius-sm);
    text-transform: uppercase;
    letter-spacing: var(--token-size-0-5px);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--size-control-2xl);
}

.widget-preview-canvas .<?= $wc ?> .ad-image,
.<?= $wc ?>.is-preview .ad-image {
    min-height: var(--size-control-2xl);
}

.widget-preview-canvas .<?= $wc ?> .ad-image--preview,
.<?= $wc ?>.is-preview .ad-image--preview {
    width: 100%;
    min-height: var(--size-control-2xl);
    background: linear-gradient(135deg, color-mix(in srgb, var(--weline-theme-on-primary) 15%, transparent) 0%, color-mix(in srgb, var(--weline-theme-on-primary) 5%, transparent) 100%);
}

.widget-preview-canvas .<?= $wc ?> .ad-label,
.<?= $wc ?>.is-preview .ad-label {
    top: var(--spacing-1_5);
    right: var(--spacing-1_5);
    font-size: var(--token-size-9px);
}
</style>
