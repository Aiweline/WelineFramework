<?php
/**
 * Header 导航菜单部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {main-nav}
 * @widget.name {主导航菜单}
 * @widget.description {Header 主导航菜单，支持多级下拉和Mega菜单}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {navigation}
 * @widget.supports {["layout-header-navigation","layout-global-header-navigation"]}
 * @widget.exclusive {true}
 *
 * @param menu_style {default="horizontal",type="select",label="菜单样式",options={horizontal:"水平",vertical:"垂直",mega:"Mega菜单"}}
 * @param show_icons {default=false,type="bool",label="显示图标"}
 * @param max_depth {default=3,type="number",label="最大层级"}
 * @param menu_items {default=[],type="array",label="菜单项(兼容)",description="旧版混合列表；若同时配置 category_items/shortcut_items 则忽略"}
 * @param category_items {default=[],type="array",label="左侧分类菜单",description="跟在「全部」后的分类项，可含 children"}
 * @param shortcut_items {default=[],type="array",label="右侧快捷入口",description="今日特价～客户服务等营销/服务入口，小屏换到第二行"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('main-nav');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$menuStyle = $this->getData('menu_style') ?? 'horizontal';
if (!in_array($menuStyle, ['horizontal', 'vertical', 'mega'], true)) {
    $menuStyle = 'horizontal';
}
$showIcons = (bool)($this->getData('show_icons') ?? false);
$maxDepth = (int)($this->getData('max_depth') ?? 3);

$defaultShortcuts = [
    ['label' => __('今日特价'), 'url' => '/deals'],
    ['label' => __('会员视频'), 'url' => '/video'],
    ['label' => __('礼品心愿单'), 'url' => '/registry'],
    ['label' => __('礼品卡'), 'url' => '/gift-cards'],
    ['label' => __('客户服务'), 'url' => '/help'],
];
$defaultCategories = [
    ['label' => __('电子产品'), 'url' => '/category/electronics', 'children' => [
        ['label' => __('手机通讯'), 'url' => '/category/electronics/phones'],
        ['label' => __('电脑办公'), 'url' => '/category/electronics/computers'],
        ['label' => __('智能设备'), 'url' => '/category/electronics/smart-devices'],
    ]],
    ['label' => __('服装鞋帽'), 'url' => '/category/fashion'],
    ['label' => __('家居生活'), 'url' => '/category/home'],
];

$categoryItems = $this->getData('category_items');
$shortcutItems = $this->getData('shortcut_items');
$menuItems = $this->getData('menu_items') ?? [];

$shortcutUrlSet = [];
foreach ($defaultShortcuts as $s) {
    $shortcutUrlSet[(string)($s['url'] ?? '')] = true;
}

// 优先显式分组；否则从旧版 menu_items 拆分；全空则用默认两组
if ($categoryItems !== null || $shortcutItems !== null) {
    $categoryItems = is_array($categoryItems) ? $categoryItems : [];
    $shortcutItems = is_array($shortcutItems) ? $shortcutItems : [];
} elseif (is_array($menuItems) && $menuItems !== []) {
    $categoryItems = [];
    $shortcutItems = [];
    foreach ($menuItems as $item) {
        if (!is_array($item)) {
            continue;
        }
        $url = (string)($item['url'] ?? '');
        $group = (string)($item['group'] ?? '');
        $hasChildren = !empty($item['children']) && is_array($item['children']);
        if ($group === 'shortcut' || (!$hasChildren && isset($shortcutUrlSet[$url]))) {
            $shortcutItems[] = $item;
        } else {
            $categoryItems[] = $item;
        }
    }
} else {
    // main-nav 挂在右侧「导航」槽：默认只出快捷入口；分类由左侧 category-menu 槽负责
    $categoryItems = [];
    $shortcutItems = $defaultShortcuts;
}

$renderMenuItem = function ($item, $depth = 0, $maxDepth = 3, $showIcons = false) use (&$renderMenuItem, $esc) {
    $hasChildren = !empty($item['children']) && $depth < $maxDepth;
    $icon = $item['icon'] ?? '';
    ?>
    <li class="nav-item<?= $hasChildren ? ' has-children' : '' ?>">
        <a href="<?= $esc((string)($item['url'] ?? '#')) ?>" class="nav-link">
            <?php if ($showIcons && $icon !== ''): ?>
                <i class="<?= $esc((string)$icon) ?>"></i>
            <?php endif; ?>
            <span><?= $esc((string)($item['label'] ?? '')) ?></span>
            <?php if ($hasChildren): ?>
                <w:icon name="arrow-down" size="sm"></w:icon>
            <?php endif; ?>
        </a>
        <?php if ($hasChildren): ?>
            <ul class="dropdown-menu" role="menu">
                <?php foreach ($item['children'] as $child): ?>
                    <?php $renderMenuItem($child, $depth + 1, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </li>
    <?php
};
?>

<section class="<?= $esc($wc) ?> nav-style-<?= $esc((string)$menuStyle) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <nav class="main-nav main-nav-split" aria-label="<?= __('主导航') ?>">
        <?php if ($categoryItems !== []): ?>
            <ul class="nav-menu nav-menu-primary" aria-label="<?= __('分类菜单') ?>">
                <?php foreach ($categoryItems as $item): ?>
                    <?php $renderMenuItem($item, 0, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
        <?php if ($shortcutItems !== []): ?>
            <ul class="nav-menu nav-menu-shortcuts" aria-label="<?= __('快捷导航') ?>">
                <?php foreach ($shortcutItems as $item): ?>
                    <?php $renderMenuItem($item, 0, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </nav>
</section>

<style>
.<?= $wc ?> {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
}

.<?= $wc ?> .main-nav-split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    min-width: 0;
    column-gap: var(--weline-space-2);
    row-gap: 0;
}

.<?= $wc ?>.nav-style-horizontal .nav-menu {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--weline-space-1);
}

/* 左侧分类：紧跟「全部」 */
.<?= $wc ?> .nav-menu-primary {
    flex: 0 1 auto;
    min-width: 0;
}

/* 右侧快捷：今日特价～客服；宽屏靠右，窄屏整行换到第二行 */
.<?= $wc ?> .nav-menu-shortcuts {
    flex: 0 1 auto;
    min-width: 0;
    margin-left: auto;
}

.<?= $wc ?>.nav-style-horizontal .nav-item {
    position: relative;
    flex: 0 0 auto;
}

.<?= $wc ?> .nav-link {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--weline-space-2);
    padding: var(--weline-space-3) var(--weline-space-4);
    color: var(--weline-theme-text);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--weline-theme-transition-base), background-color var(--weline-theme-transition-base);
    border-radius: var(--weline-radius-sm);
}

.<?= $wc ?> .nav-link span {
    white-space: nowrap;
}

.<?= $wc ?> .nav-link:hover {
    color: var(--weline-theme-primary);
    background-color: var(--weline-theme-primary-surface);
}

/* Amazon 深色次级顶栏内：浅色链接，避免 foundation 主色压暗 */
.weline-header .header-main-nav .<?= $wc ?> .nav-link,
.header-main-nav .<?= $wc ?> .nav-link {
    color: var(--color-bg-primary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-0_65);
    border-radius: var(--border-radius-sm);
}

.weline-header .header-main-nav .<?= $wc ?> .nav-link:hover,
.header-main-nav .<?= $wc ?> .nav-link:hover {
    color: var(--color-bg-primary);
    background-color: var(--color-on-dark-12);
}

.weline-header .header-main-nav .<?= $wc ?> .dropdown-menu .nav-link,
.header-main-nav .<?= $wc ?> .dropdown-menu .nav-link {
    color: var(--weline-theme-text);
}

.weline-header .header-main-nav .<?= $wc ?> .dropdown-menu .nav-link:hover,
.header-main-nav .<?= $wc ?> .dropdown-menu .nav-link:hover {
    color: var(--weline-theme-primary);
    background-color: var(--weline-theme-primary-surface);
}

.<?= $wc ?>.nav-style-horizontal .has-children:hover > .nav-link w-icon {
    transform: rotate(180deg);
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: var(--size-panel-200);
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-md);
    box-shadow: var(--weline-theme-shadow-md);
    list-style: none;
    padding: var(--weline-space-2) 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--spacing-2_5));
    transition: all var(--weline-theme-transition-base);
    z-index: 1000;
}

.<?= $wc ?>.nav-style-horizontal .has-children:hover > .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu .nav-link {
    padding: var(--weline-space-3) var(--weline-space-5);
    border-radius: 0;
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu .dropdown-menu {
    top: 0;
    left: 100%;
}

.<?= $wc ?>.nav-style-vertical .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?>.nav-style-vertical .nav-link {
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?>.nav-style-vertical .dropdown-menu {
    list-style: none;
    padding-left: var(--weline-space-5);
    margin: 0;
}

.<?= $wc ?>.nav-style-mega .dropdown-menu {
    min-width: var(--token-size-600px);
    padding: var(--weline-space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--weline-space-5);
}

.<?= $wc ?>.nav-style-mega .dropdown-menu .nav-item {
    flex: 1;
    min-width: var(--size-panel-150);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    overflow-x: auto;
}

.widget-preview-canvas .<?= $wc ?> .nav-link,
.<?= $wc ?>.is-preview .nav-link {
    padding: var(--weline-space-2) var(--weline-space-3);
    font-size: var(--weline-font-size-xs);
}

@media (max-width: 992px) {
    .<?= $wc ?> .main-nav-split {
        width: 100%;
    }

    .<?= $wc ?> .nav-menu-shortcuts {
        flex: 1 1 100%;
        margin-left: 0;
        order: 2;
    }

    .<?= $wc ?> .nav-menu-primary {
        flex: 1 1 auto;
        order: 1;
    }

    .<?= $wc ?> .main-nav {
        width: 100%;
        min-width: 0;
        overflow-x: visible;
        overflow-y: visible;
    }

    .<?= $wc ?>.nav-style-horizontal .nav-menu {
        flex-wrap: nowrap;
        width: max-content;
        max-width: 100%;
        overflow-x: auto;
        gap: 0;
        scrollbar-width: none;
    }

    .<?= $wc ?>.nav-style-horizontal .nav-menu::-webkit-scrollbar {
        display: none;
    }

    .<?= $wc ?> .nav-link {
        padding: var(--spacing-sm) var(--weline-space-3);
        font-size: var(--font-size-13);
    }

    .<?= $wc ?>.nav-style-horizontal .dropdown-menu {
        display: none;
    }
}
</style>
