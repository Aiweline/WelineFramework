<?php
/**
 * @widget.layout_source {Weline_Theme::css/widgets/widget-navigation-main-nav-default.css}
 * Header 导航菜单部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {main-nav}
 * @widget.name {主导航菜单}
 * @widget.description {Header 主导航菜单，支持多级下拉和Mega菜单}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {navigation}
 * @widget.supports {["layout-header-navigation","layout-global-header-navigation"]}
 * @widget.exclusive {true}
 *
 * @param menu_style {default="horizontal",type="select",label="菜单样式",options={horizontal:"水平",vertical:"垂直",mega:"Mega菜单"}}
 * @param show_icons {default=false,type="bool",label="显示图标"}
 * @param max_depth {default=3,type="number",label="最大层级"}
 * @param menu_items {default=[],type="array",label="菜单项(兼容)",description="旧版混合列表；若同时配置 category_items/shortcut_items 则忽略"}
 * @param category_items {default=[],type="array",label="左侧分类菜单",description="跟在「全部」后的分类项，可含 children"}
 * @param shortcut_items {default=[],type="array",label="右侧快捷入口",description="今日特价～客户服务等营销/服务入口，小屏换到第二行"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('main-nav');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$menuStyle = $this->getData('menu_style') ?? 'horizontal';
if (!in_array($menuStyle, ['horizontal', 'vertical', 'mega'], true)) {
    $menuStyle = 'horizontal';
}
$showIcons = (bool)($this->getData('show_icons') ?? false);
$maxDepth = (int)($this->getData('max_depth') ?? 3);

$defaultShortcuts = [
    ['label' => __('今日特价'), 'url' => $this->getFrontendUrl('promotion/deals')],
    ['label' => __('客户服务'), 'url' => $this->getFrontendUrl('faq')],
];

$categoryItems = $this->getData('category_items');
$shortcutItems = $this->getData('shortcut_items');
$menuItems = $this->getData('menu_items') ?? [];

$shortcutUrlSet = [];
foreach ($defaultShortcuts as $s) {
    $shortcutUrlSet[(string)($s['url'] ?? '')] = true;
}

// 优先显式分组；否则从旧版 menu_items 拆分；全空则用默认两组
if ($categoryItems !== null || $shortcutItems !== null) {
    $categoryItems = is_array($categoryItems) ? $categoryItems : [];
    $shortcutItems = is_array($shortcutItems) ? $shortcutItems : [];
} elseif (is_array($menuItems) && $menuItems !== []) {
    $categoryItems = [];
    $shortcutItems = [];
    foreach ($menuItems as $item) {
        if (!is_array($item)) {
            continue;
        }
        $url = (string)($item['url'] ?? '');
        $group = (string)($item['group'] ?? '');
        $hasChildren = !empty($item['children']) && is_array($item['children']);
        if ($group === 'shortcut' || (!$hasChildren && isset($shortcutUrlSet[$url]))) {
            $shortcutItems[] = $item;
        } else {
            $categoryItems[] = $item;
        }
    }
} else {
    // main-nav 挂在右侧「导航」槽：默认只出快捷入口；分类由左侧 category-menu 槽负责
    $categoryItems = [];
    $shortcutItems = $defaultShortcuts;
}

$renderMenuItem = function ($item, $depth = 0, $maxDepth = 3, $showIcons = false) use (&$renderMenuItem, $esc) {
    $hasChildren = !empty($item['children']) && $depth < $maxDepth;
    $icon = $item['icon'] ?? '';
    ?>
    <li class="nav-item<?= $hasChildren ? ' has-children' : '' ?>">
        <a href="<?= $esc((string)($item['url'] ?? '#')) ?>" class="nav-link">
            <?php if ($showIcons && $icon !== ''): ?>
                <i class="<?= $esc((string)$icon) ?>"></i>
            <?php endif; ?>
            <span><?= $esc((string)($item['label'] ?? '')) ?></span>
            <?php if ($hasChildren): ?>
                <w:icon name="arrow-down" size="sm"></w:icon>
            <?php endif; ?>
        </a>
        <?php if ($hasChildren): ?>
            <ul class="dropdown-menu" role="menu">
                <?php foreach ($item['children'] as $child): ?>
                    <?php $renderMenuItem($child, $depth + 1, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </li>
    <?php
};
?>

<section class="<?= $esc($wc) ?> nav-style-<?= $esc((string)$menuStyle) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <nav class="main-nav main-nav-split" aria-label="<?= __('主导航') ?>">
        <?php if ($categoryItems !== []): ?>
            <ul class="nav-menu nav-menu-primary" aria-label="<?= __('分类菜单') ?>">
                <?php foreach ($categoryItems as $item): ?>
                    <?php $renderMenuItem($item, 0, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
        <?php if ($shortcutItems !== []): ?>
            <ul class="nav-menu nav-menu-shortcuts" aria-label="<?= __('快捷导航') ?>">
                <?php foreach ($shortcutItems as $item): ?>
                    <?php $renderMenuItem($item, 0, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </nav>
</section>

