<?php
/**
 * Header 导航菜单部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {main-nav}
 * @widget.name {主导航菜单}
 * @widget.description {Header 主导航菜单，支持多级下拉和Mega菜单}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {navigation}
 * @widget.supports {["layout-header-navigation","layout-global-header-navigation"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"navigation","area":"header","sort_order":0}]}
 * @widget.exclusive {true}
 *
 * @param menu_style {default="horizontal",type="select",label="菜单样式",options={horizontal:"水平",vertical:"垂直",mega:"Mega菜单"}}
 * @param show_icons {default=false,type="bool",label="显示图标"}
 * @param max_depth {default=3,type="number",label="最大层级"}
 * @param menu_items {default=[],type="array",label="菜单项",description="菜单项数组，每项包含label、url、icon、children"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('main-nav');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$menuStyle = $this->getData('menu_style') ?? 'horizontal';
if (!in_array($menuStyle, ['horizontal', 'vertical', 'mega'], true)) {
    $menuStyle = 'horizontal';
}
$showIcons = (bool)($this->getData('show_icons') ?? false);
$maxDepth = (int)($this->getData('max_depth') ?? 3);
$menuItems = $this->getData('menu_items') ?? [];

if (empty($menuItems)) {
    $menuItems = [
        ['label' => __('首页'), 'url' => '/', 'icon' => 'home'],
        ['label' => __('商品'), 'url' => '/products', 'icon' => 'pin', 'children' => [
            ['label' => __('新品上架'), 'url' => '/products/new'],
            ['label' => __('热销商品'), 'url' => '/products/bestsellers'],
            ['label' => __('特价促销'), 'url' => '/products/sale'],
        ]],
        ['label' => __('分类'), 'url' => '/categories', 'icon' => 'grid', 'children' => [
            ['label' => __('电子产品'), 'url' => '/category/electronics'],
            ['label' => __('服装鞋帽'), 'url' => '/category/fashion'],
            ['label' => __('家居生活'), 'url' => '/category/home'],
        ]],
        ['label' => __('关于我们'), 'url' => '/about', 'icon' => 'info'],
        ['label' => __('联系我们'), 'url' => '/contact', 'icon' => 'mail'],
    ];
}

$renderMenuItem = function ($item, $depth = 0, $maxDepth = 3, $showIcons = false) use (&$renderMenuItem, $esc) {
    $hasChildren = !empty($item['children']) && $depth < $maxDepth;
    $icon = $item['icon'] ?? '';
    ?>
    <li class="nav-item<?= $hasChildren ? ' has-children' : '' ?>">
        <a href="<?= $esc((string)($item['url'] ?? '#')) ?>" class="nav-link">
            <?php if ($showIcons && $icon !== ''): ?>
                <i class="<?= $esc((string)$icon) ?>"></i>
            <?php endif; ?>
            <span><?= $esc((string)($item['label'] ?? '')) ?></span>
            <?php if ($hasChildren): ?>
                <w:icon name="arrow-down" size="sm"></w:icon>
            <?php endif; ?>
        </a>
        <?php if ($hasChildren): ?>
            <ul class="dropdown-menu" role="menu">
                <?php foreach ($item['children'] as $child): ?>
                    <?php $renderMenuItem($child, $depth + 1, $maxDepth, $showIcons); ?>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </li>
    <?php
};
?>

<section class="<?= $esc($wc) ?> nav-style-<?= $esc((string)$menuStyle) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <nav class="main-nav" aria-label="<?= __('主导航') ?>">
        <ul class="nav-menu">
            <?php foreach ($menuItems as $item): ?>
                <?php $renderMenuItem($item, 0, $maxDepth, $showIcons); ?>
            <?php endforeach; ?>
        </ul>
    </nav>
</section>

<style>
.<?= $wc ?> {
    position: relative;
}

.<?= $wc ?>.nav-style-horizontal .nav-menu {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--weline-space-1, 5px);
}

.<?= $wc ?>.nav-style-horizontal .nav-item {
    position: relative;
    flex: 0 0 auto;
}

.<?= $wc ?> .nav-link {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--weline-space-2, 6px);
    padding: var(--weline-space-3, 10px) var(--weline-space-4, 15px);
    color: var(--weline-theme-text);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--weline-theme-transition-base, 0.2s ease), background-color var(--weline-theme-transition-base, 0.2s ease);
    border-radius: var(--weline-radius-sm, 4px);
}

.<?= $wc ?> .nav-link span {
    white-space: nowrap;
}

.<?= $wc ?> .nav-link:hover {
    color: var(--weline-theme-primary);
    background-color: var(--weline-theme-primary-surface);
}

.<?= $wc ?>.nav-style-horizontal .has-children:hover > .nav-link w-icon {
    transform: rotate(180deg);
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-md, 8px);
    box-shadow: var(--weline-theme-shadow-md);
    list-style: none;
    padding: var(--weline-space-2, 8px) 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all var(--weline-theme-transition-base, 0.2s ease);
    z-index: 1000;
}

.<?= $wc ?>.nav-style-horizontal .has-children:hover > .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu .nav-link {
    padding: var(--weline-space-3, 10px) var(--weline-space-5, 20px);
    border-radius: 0;
}

.<?= $wc ?>.nav-style-horizontal .dropdown-menu .dropdown-menu {
    top: 0;
    left: 100%;
}

.<?= $wc ?>.nav-style-vertical .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?>.nav-style-vertical .nav-link {
    border-bottom: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
}

.<?= $wc ?>.nav-style-vertical .dropdown-menu {
    list-style: none;
    padding-left: var(--weline-space-5, 20px);
    margin: 0;
}

.<?= $wc ?>.nav-style-mega .dropdown-menu {
    min-width: 600px;
    padding: var(--weline-space-5, 20px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--weline-space-5, 20px);
}

.<?= $wc ?>.nav-style-mega .dropdown-menu .nav-item {
    flex: 1;
    min-width: 150px;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    overflow-x: auto;
}

.widget-preview-canvas .<?= $wc ?> .nav-link,
.<?= $wc ?>.is-preview .nav-link {
    padding: var(--weline-space-2, 8px) var(--weline-space-3, 12px);
    font-size: var(--weline-font-size-xs, 12px);
}

@media (max-width: 992px) {
    .<?= $wc ?> .main-nav {
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .<?= $wc ?> .main-nav::-webkit-scrollbar {
        display: none;
    }

    .<?= $wc ?>.nav-style-horizontal .nav-menu {
        width: max-content;
        min-width: 100%;
        gap: 0;
    }

    .<?= $wc ?> .nav-link {
        padding: 0.5rem 0.75rem;
        font-size: 0.8125rem;
    }

    .<?= $wc ?>.nav-style-horizontal .dropdown-menu {
        display: none;
    }
}
</style>
