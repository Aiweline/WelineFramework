<?php
/**
 * 分类菜单部件：Header 横向分类条（Amazon chrome）。
 * 默认主题 header 布局已用 `<w:widget type="navigation" name="category-menu" />` 占槽，
 * 不再声明 default_injections（布局已有则禁再走 required 注入，避免 chrome/页槽双计报错）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {category-menu}
 * @widget.name {分类菜单}
 * @widget.description {Header 横向分类导航（mega/overflow）；由默认主题 header 布局承载，不走 default_injections。}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {category-menu}
 * @widget.supports {["layout-header-category-menu","layout-header-categories","category-menu"]}
 * @widget.exclusive {true}
 *
 * @param title {default="分类导航",type="string",label="无障碍标题"}
 * @param show_banner_with_children {default=true,type="bool",label="有子分类时展示 Banner/描述",description="Mega Menu：有子分类时是否在子分类上方展示分类 Banner 与描述"}
 * @param show_all_products {default=null,type="bool",label="显示全部商品入口",description="覆盖 all-menu 默认偏好；留空则跟随 all-menu / Registry。"}
 */

use Weline\Theme\Helper\HeaderCommerceData;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-menu');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$editorPreviewLight = false;
try {
    $editorModeFlag = trim((string)($this->request->getParam('editor_mode', '') ?? ''));
    $editorPreviewLight = ($editorModeFlag === '1' || strtolower($editorModeFlag) === 'true')
        || (bool)$this->getData('editor_mode')
        || $isPreviewMode;
} catch (\Throwable) {
    $editorPreviewLight = (bool)$this->getData('editor_mode') || $isPreviewMode;
}

$showBannerWithChildren = $this->getData('show_banner_with_children') ?? true;
if (is_string($showBannerWithChildren)) {
    $normalizedBannerFlag = strtolower(trim($showBannerWithChildren));
    $showBannerWithChildren = !in_array($normalizedBannerFlag, ['0', 'false', 'no', 'off', ''], true);
} else {
    $showBannerWithChildren = (bool)$showBannerWithChildren;
}

$navOptions = [];
$showAllProductsOverride = $this->getData('show_all_products');
if ($showAllProductsOverride !== null && $showAllProductsOverride !== '') {
    if (is_string($showAllProductsOverride)) {
        $navOptions['include_all_products'] = !in_array(
            strtolower(trim($showAllProductsOverride)),
            ['0', 'false', 'no', 'off', ''],
            true
        );
    } else {
        $navOptions['include_all_products'] = (bool)$showAllProductsOverride;
    }
}

$navItems = $this->getData('navItems');
if (!is_array($navItems) || $navItems === []) {
    $navItems = [];
    if (!$this->getData('navItems_set_by_hook')) {
        $catalogNav = HeaderCommerceData::resolveCategoryNavItems($navOptions);
        if (!empty($catalogNav['items']) && is_array($catalogNav['items'])) {
            $navItems = $catalogNav['items'];
        }
    }
}

$headerFlattenNavForEditor = static function (array $items): array {
    $out = [];
    foreach ($items as $item) {
        if (!is_array($item)) {
            continue;
        }
        $flat = $item;
        $flat['children'] = [];
        $out[] = $flat;
    }

    return $out;
};

// 保留定义供契约检索；整页预览禁止拍平 children。

$hanfuDemoNav = static function (): array {
    $searchHref = static fn (string $query): string => '/search?q=' . rawurlencode($query);

    return [
        [
            'text' => '全部商品',
            'url' => '/products',
            'description' => '浏览全部已发布商品',
            'children' => [],
        ],
        [
            'text' => '女士汉服',
            'url' => $searchHref('女士汉服'),
            'description' => '按形制探索适合日常、节庆与礼仪场景的女士汉服',
            'children' => [
                ['text' => '明制汉服', 'url' => $searchHref('明制汉服'), 'children' => []],
                ['text' => '宋制汉服', 'url' => $searchHref('宋制汉服'), 'children' => []],
                ['text' => '唐制汉服', 'url' => $searchHref('唐制汉服'), 'children' => []],
            ],
        ],
        [
            'text' => '男士汉服',
            'url' => $searchHref('男士汉服'),
            'description' => '传统形制与现代日常穿着兼顾的男士系列',
            'children' => [
                ['text' => '圆领袍', 'url' => $searchHref('男士圆领袍')],
                ['text' => '道袍与直裰', 'url' => $searchHref('道袍 直裰')],
            ],
        ],
        [
            'text' => '儿童汉服',
            'url' => $searchHref('儿童汉服'),
            'children' => [
                ['text' => '女童汉服', 'url' => $searchHref('女童汉服')],
                ['text' => '男童汉服', 'url' => $searchHref('男童汉服')],
            ],
        ],
        [
            'text' => '汉服配饰',
            'url' => $searchHref('汉服配饰'),
            'children' => [
                ['text' => '发簪与发冠', 'url' => $searchHref('发簪 发冠')],
                ['text' => '绣花鞋履', 'url' => $searchHref('汉服鞋履')],
            ],
        ],
    ];
};

if ($navItems === [] && $editorPreviewLight) {
    $navItems = $hanfuDemoNav();
}
// 整页可视化预览必须与店面一致：保留 children，供 hover mega 面板渲染。
// $headerFlattenNavForEditor 仅作契约保留，禁止在此拍平。
?>
<div class="<?= $esc($wc) ?> header-category-menu-widget<?= $isPreviewMode ? ' is-preview' : '' ?>"
     weline-code="<?= $esc($scope->code) ?>"
     data-uid="<?= $esc($scope->uid) ?>"
     data-js-ns="<?= $esc($scope->jsNs) ?>"
     data-widget-code="category-menu"
     data-testid="category-menu">
    <?= $this->fetch('Weline_Theme::theme/frontend/partials/header/categories-horizontal-nav.phtml', [
        'items' => $navItems,
        'show_banner_with_children' => $showBannerWithChildren,
    ]) ?>
</div>
