<?php
/**
 * 分类菜单部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {category-menu}
 * @widget.name {分类菜单}
 * @widget.description {Header 分类下拉菜单，支持多级展开}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {category-menu}
 * @widget.supports {["layout-header-category-menu","layout-header-categories","layout-header-navigation"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"category-menu","area":"header","sort_order":0}]}
 *
 * @param title {default="全部分类",type="string",label="标题"}
 * @param max_depth {default=3,type="number",label="最大层级"}
 * @param show_icons {default=true,type="bool",label="显示图标"}
 * @param show_count {default=false,type="bool",label="显示产品数量"}
 * @param expand_on_hover {default=true,type="bool",label="悬停展开"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-menu');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('全部分类');
$maxDepth = (int)($this->getData('max_depth') ?? 3);
$showIcons = (bool)($this->getData('show_icons') ?? true);
$showCount = (bool)($this->getData('show_count') ?? false);
$expandOnHover = (bool)($this->getData('expand_on_hover') ?? true);
$style = $this->getData('style') ?? 'flyout';
if (!in_array($style, ['flyout', 'accordion'], true)) {
    $style = 'flyout';
}

$categories = [
    [
        'id' => 1,
        'name' => __('电子产品'),
        'url' => '/category/electronics',
        'icon' => 'phone',
        'count' => 156,
        'children' => [
            [
                'id' => 11,
                'name' => __('手机'),
                'url' => '/category/phones',
                'count' => 45,
                'children' => [
                    ['id' => 111, 'name' => 'iPhone', 'url' => '/category/iphone', 'count' => 15],
                    ['id' => 112, 'name' => 'Android', 'url' => '/category/android', 'count' => 30],
                ],
            ],
            ['id' => 12, 'name' => __('电脑'), 'url' => '/category/computers', 'count' => 38],
            ['id' => 13, 'name' => __('平板'), 'url' => '/category/tablets', 'count' => 22],
            ['id' => 14, 'name' => __('配件'), 'url' => '/category/accessories', 'count' => 51],
        ],
    ],
    [
        'id' => 2,
        'name' => __('服装鞋帽'),
        'url' => '/category/fashion',
        'icon' => 'circle',
        'count' => 243,
        'children' => [
            ['id' => 21, 'name' => __('男装'), 'url' => '/category/mens', 'count' => 89],
            ['id' => 22, 'name' => __('女装'), 'url' => '/category/womens', 'count' => 112],
            ['id' => 23, 'name' => __('童装'), 'url' => '/category/kids', 'count' => 42],
        ],
    ],
    ['id' => 3, 'name' => __('家居生活'), 'url' => '/category/home', 'icon' => 'home', 'count' => 178],
    ['id' => 4, 'name' => __('美妆个护'), 'url' => '/category/beauty', 'icon' => 'heart', 'count' => 134],
    ['id' => 5, 'name' => __('食品生鲜'), 'url' => '/category/food', 'icon' => 'circle', 'count' => 89],
    ['id' => 6, 'name' => __('运动户外'), 'url' => '/category/sports', 'icon' => 'circle', 'count' => 112],
];

$renderSubmenu = function ($items, $depth = 1, $maxDepth = 3, $showCount = false) use (&$renderSubmenu, $esc) {
    if ($depth >= $maxDepth || empty($items)) {
        return;
    }
    ?>
    <ul class="submenu submenu-depth-<?= $depth ?>">
        <?php foreach ($items as $item): ?>
            <li class="submenu-item <?= !empty($item['children']) ? 'has-children' : '' ?>">
                <a href="<?= $esc((string)$item['url']) ?>" class="submenu-link">
                    <span class="item-name"><?= $esc((string)$item['name']) ?></span>
                    <?php if ($showCount && isset($item['count'])): ?>
                        <span class="item-count"><?= (int)$item['count'] ?></span>
                    <?php endif; ?>
                    <?php if (!empty($item['children'])): ?>
                        <w:icon name="arrow-right" size="sm"></w:icon>
                    <?php endif; ?>
                </a>
                <?php if (!empty($item['children'])): ?>
                    <?php $renderSubmenu($item['children'], $depth + 1, $maxDepth, $showCount); ?>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
    <?php
};
?>

<section class="<?= $esc($wc) ?> menu-style-<?= $esc((string)$style) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-expand-on-hover="<?= $expandOnHover ? 'true' : 'false' ?>">
    <button class="menu-trigger" type="button" aria-expanded="false">
        <w:icon name="menu" size="sm"></w:icon>
        <span><?= $esc((string)$title) ?></span>
        <w:icon name="arrow-down" size="sm"></w:icon>
    </button>
    <div class="menu-dropdown">
        <ul class="category-menu-list">
            <?php foreach ($categories as $category): ?>
                <li class="menu-item <?= !empty($category['children']) ? 'has-children' : '' ?>">
                    <a href="<?= $esc((string)$category['url']) ?>" class="menu-link">
                        <?php if ($showIcons && !empty($category['icon'])): ?>
                            <w:icon name="category.icon|circle" size="sm"></w:icon>
                        <?php endif; ?>
                        <span class="item-name"><?= $esc((string)$category['name']) ?></span>
                        <?php if ($showCount && isset($category['count'])): ?>
                            <span class="item-count"><?= (int)$category['count'] ?></span>
                        <?php endif; ?>
                        <?php if (!empty($category['children'])): ?>
                            <w:icon name="arrow-right" size="sm"></w:icon>
                        <?php endif; ?>
                    </a>
                    <?php if (!empty($category['children'])): ?>
                        <?php $renderSubmenu($category['children'], 1, $maxDepth, $showCount); ?>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</section>

<style>
.<?= $wc ?> {
    position: relative;
}

.<?= $wc ?> .menu-trigger {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3, 10px);
    padding: var(--weline-space-3, 12px) var(--weline-space-5, 20px);
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
    border: none;
    border-radius: var(--weline-radius-md, 8px);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--weline-theme-transition-base, 0.2s ease);
    width: 100%;
}

.<?= $wc ?> .menu-trigger:hover {
    background: var(--weline-theme-primary-hover);
}

.<?= $wc ?> .menu-trigger w-icon:last-child {
    margin-left: auto;
    transition: transform var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?>.menu-open .menu-trigger w-icon:last-child {
    transform: rotate(180deg);
}

.<?= $wc ?> .menu-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 280px;
    background: var(--weline-theme-surface-raised);
    border-radius: 0 0 var(--weline-radius-md, 8px) var(--weline-radius-md, 8px);
    box-shadow: var(--weline-theme-shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all var(--weline-theme-transition-base, 0.2s ease);
    z-index: 1000;
}

.<?= $wc ?>:hover .menu-dropdown,
.<?= $wc ?>.menu-open .menu-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.<?= $wc ?> .category-menu-list {
    list-style: none;
    margin: 0;
    padding: var(--weline-space-3, 10px) 0;
}

.<?= $wc ?> .menu-item {
    position: relative;
}

.<?= $wc ?> .menu-link,
.<?= $wc ?> .submenu-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3, 12px);
    padding: var(--weline-space-3, 12px) var(--weline-space-5, 20px);
    color: var(--weline-theme-text);
    text-decoration: none;
    transition: all var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .menu-link:hover,
.<?= $wc ?> .submenu-link:hover {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .item-name {
    flex: 1;
    font-size: var(--weline-font-size-sm, 14px);
}

.<?= $wc ?> .item-count {
    font-size: var(--weline-font-size-xs, 12px);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?>.menu-style-flyout .submenu {
    position: absolute;
    top: 0;
    left: 100%;
    width: 250px;
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-md, 8px);
    box-shadow: var(--weline-theme-shadow-lg);
    list-style: none;
    margin: 0;
    padding: var(--weline-space-3, 10px) 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?>.menu-style-flyout .menu-item:hover > .submenu,
.<?= $wc ?>.menu-style-flyout .submenu-item:hover > .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
}

.<?= $wc ?>.menu-style-accordion .submenu {
    position: static;
    width: 100%;
    background: var(--weline-theme-surface-muted);
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: max-height var(--weline-theme-transition-base, 0.3s ease);
}

.<?= $wc ?>.menu-style-accordion .menu-item.expanded > .submenu {
    max-height: 500px;
}

.<?= $wc ?>.menu-style-accordion .submenu-link {
