</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var trigger = root.querySelector('.menu-trigger');

    if (trigger) {
        trigger.addEventListener('click', function () {
            var open = root.classList.toggle('menu-open');
            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    }

    document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) {
            root.classList.remove('menu-open');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
    });

    if (root.classList.contains('menu-style-accordion')) {
        root.querySelectorAll('.has-children > .menu-link, .has-children > .submenu-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                this.closest('.menu-item, .submenu-item')?.classList.toggle('expanded');
            });
        });
    }
})();
</script>
