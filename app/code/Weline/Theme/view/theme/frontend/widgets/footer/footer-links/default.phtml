<?php
/**
 * 页脚链接部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-links}
 * @widget.name {页脚链接}
 * @widget.description {Footer 区域的链接列表，支持多列分组}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {links}
 * @widget.supports {["layout-footer-links","layout-global-footer-links"]}
 * @widget.exclusive {true}
 *
 * @param link_groups {default=[],type="array",label="链接分组",description="每组包含title和links数组"}
 * @param columns {default="4",type="select",label="列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param text_color {default="var(--weline-theme-text-on-dark, #f8fafc)",type="color",label="文字颜色"}
 */

use Weline\Theme\Helper\FooterDefaultLinksHelper;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-links');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$linkGroups = $this->getData('link_groups') ?? [];
$columns = (string)($this->getData('columns') ?? '4');
if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '4';
}
$textColor = ThemeUiColor::sanitize(
    $this->getData('text_color') ?? '',
    'var(--weline-theme-text-on-dark, #f8fafc)'
);

if (empty($linkGroups)) {
    $linkGroups = FooterDefaultLinksHelper::widgetLinkGroups();
}
?>

<section class="<?= $esc($wc) ?> columns-<?= $esc($columns) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="--wc-footer-text: <?= $esc($textColor) ?>;">
    <?php foreach ($linkGroups as $group): ?>
        <div class="link-group">
            <?php if (!empty($group['title'])): ?>
                <h4 class="group-title"><?= $esc((string)__($group['title'])) ?></h4>
            <?php endif; ?>
            <?php if (!empty($group['links'])): ?>
                <ul class="group-links">
                    <?php foreach ($group['links'] as $link): ?>
                        <li>
                            <a href="<?= $esc((string)($link['url'] ?? '#')) ?>"><?= $esc((string)__($link['label'])) ?></a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
</section>

<style>
.<?= $wc ?> {
    display: grid;
    gap: var(--weline-space-8);
    color: var(--wc-footer-text);
}

.<?= $wc ?>.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?>.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?>.columns-4 { grid-template-columns: repeat(4, 1fr); }

.<?= $wc ?> .group-title {
    font-family: inherit;
    font-size: var(--font-size-base, 1rem);
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 var(--spacing-3_5, 0.875rem);
    color: var(--wc-footer-text);
}

.<?= $wc ?> .group-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2_5, 0.625rem);
}

.<?= $wc ?> .group-links a {
    color: var(--weline-theme-footer-link, #dddddd);
    text-decoration: none;
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.3;
    transition: color 0.2s ease;
}

.<?= $wc ?> .group-links a:hover,
.<?= $wc ?> .group-links a:focus-visible {
    color: var(--wc-footer-text);
    text-decoration: underline;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: var(--weline-space-4);
}

@media (max-width: 992px) {
    .<?= $wc ?>.columns-4 {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .<?= $wc ?> {
        grid-template-columns: 1fr !important;
    }
}
</style>
