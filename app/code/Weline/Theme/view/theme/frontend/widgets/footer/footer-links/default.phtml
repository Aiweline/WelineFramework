<?php
/**
 * 页脚链接部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-links}
 * @widget.name {页脚链接}
 * @widget.description {Footer 区域的链接列表，支持多列分组}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {links}
 * @widget.supports {["layout-footer-links","layout-global-footer-links"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"footer-links","area":"footer","sort_order":0}]}
 *
 * @param link_groups {default=[],type="array",label="链接分组",description="每组包含title和links数组"}
 * @param columns {default="4",type="select",label="列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param text_color {default="var(--weline-theme-on-primary)",type="color",label="文字颜色"}
 */

use Weline\Theme\Helper\FooterDefaultLinksHelper;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-links');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$linkGroups = $this->getData('link_groups') ?? [];
$columns = (string)($this->getData('columns') ?? '4');
if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '4';
}
$textColor = ThemeUiColor::sanitize($this->getData('text_color') ?? '', 'var(--weline-theme-on-primary)');

if (empty($linkGroups)) {
    $linkGroups = FooterDefaultLinksHelper::widgetLinkGroups();
}
?>

<section class="<?= $esc($wc) ?> columns-<?= $esc($columns) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="--wc-footer-text:<?= $esc($textColor) ?>;">
    <?php foreach ($linkGroups as $group): ?>
        <div class="link-group">
            <?php if (!empty($group['title'])): ?>
                <h4 class="group-title"><?= $esc((string)__($group['title'])) ?></h4>
            <?php endif; ?>
            <?php if (!empty($group['links'])): ?>
                <ul class="group-links">
                    <?php foreach ($group['links'] as $link): ?>
                        <li>
                            <a href="<?= $esc((string)($link['url'] ?? '#')) ?>"><?= $esc((string)__($link['label'])) ?></a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
</section>

<style>
.<?= $wc ?> {
    display: grid;
    gap: var(--weline-space-8, 30px);
    color: var(--wc-footer-text, var(--weline-theme-on-primary));
}

.<?= $wc ?>.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?>.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?>.columns-4 { grid-template-columns: repeat(4, 1fr); }

.<?= $wc ?> .group-title {
    font-size: var(--weline-font-size-base, 16px);
    font-weight: 600;
    margin: 0 0 var(--weline-space-5, 20px);
}

.<?= $wc ?> .group-links {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?> .group-links li {
    margin-bottom: var(--weline-space-3, 12px);
}

.<?= $wc ?> .group-links a {
    color: color-mix(in srgb, var(--wc-footer-text, var(--weline-theme-on-primary)) 70%, transparent);
    text-decoration: none;
    font-size: var(--weline-font-size-sm, 14px);
    transition: all var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .group-links a:hover {
    color: var(--wc-footer-text, var(--weline-theme-on-primary));
    padding-left: var(--weline-space-1, 5px);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: var(--weline-space-4, 15px);
}

@media (max-width: 992px) {
    .<?= $wc ?>.columns-4 {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .<?= $wc ?> {
        grid-template-columns: 1fr !important;
    }
}
</style>
