<?php
/**
 * Header 用户账户部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {account}
 * @widget.name {用户账户入口}
 * @widget.description {Header 用户账户入口，支持登录状态显示和下拉菜单}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions"]}
 *
 * @param show_avatar {default=true,type="bool",label="显示头像"}
 * @param show_name {default=false,type="bool",label="显示用户名"}
 * @param dropdown_items {default=[],type="array",label="下拉菜单项"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('account');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$label = static fn (string $source, array $args = []): string => WidgetI18n::label($source, '', $args);

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showAvatar = (bool)($this->getData('show_avatar') ?? true);
$showName = (bool)($this->getData('show_name') ?? false);
$dropdownItems = $this->getData('dropdown_items') ?? [];

// Always SSR the guest chrome shell. Session login state is applied client-side by
// Weline_Frontend weline-api-account.js::syncHeaderAccountChrome (account.current),
// so FPC / half-session cannot paint a signed-in header on guest pages (e.g. login).
$userName = '';
$userAvatar = '';

if (empty($dropdownItems)) {
    $dropdownItems = null;
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="api,account"
         data-w-header-account="1"
         data-auth-state="guest"
         data-header-account-ssr="guest-v1"
         data-account-url="@url{'customer/account/index'}"
         data-login-url="@url{'customer/account/login'}"
         data-register-url="@url{'customer/account/register'}"
         data-logout-url="@url{'customer/account/logout'}"
         data-i18n-login="<?= $esc($label('登录')) ?>"
         data-i18n-register="<?= $esc($label('注册')) ?>"
         data-i18n-hello="<?= $esc($label('您好')) ?>"
         data-i18n-hello-named="<?= $esc($label('您好, %{1}', ['%USERNAME%'])) ?>"
         data-i18n-account="<?= $esc($label('我的账户')) ?>"
         data-i18n-orders="<?= $esc($label('我的订单')) ?>"
         data-i18n-addresses="<?= $esc($label('地址管理')) ?>"
         data-i18n-logout="<?= $esc($label('退出登录')) ?>"
         data-i18n-welcome="<?= $esc($label('欢迎回来')) ?>"
         data-show-avatar="<?= $showAvatar ? '1' : '0' ?>"
         data-show-name="<?= $showName ? '1' : '0' ?>">
    <div class="account-logged-in" data-account-shell="signed-in" hidden>
        <a href="@url{'customer/account/index'}" class="account-link" data-account-home-link>
            <?php if ($showAvatar): ?>
                <span class="account-avatar" data-account-avatar-wrap>
                    <?php /* Always emit img so account.current can paint a real avatar after guest SSR. */ ?>
                    <img<?= $userAvatar !== '' ? ' src="' . $esc($userAvatar) . '"' : '' ?>
                         alt="<?= $esc($userName) ?>"
                         data-account-avatar
                         class="account-avatar__img"
                         <?= $userAvatar === '' ? 'hidden' : '' ?>>
                    <span class="account-avatar__fallback" data-account-avatar-fallback<?= $userAvatar !== '' ? ' hidden' : '' ?> aria-hidden="true">
                        <w:icon name="user" size="sm"></w:icon>
                    </span>
                </span>
            <?php endif; ?>
            <?php if ($showName): ?>
                <span class="account-name" data-account-display-name><?= $esc($userName) ?></span>
            <?php endif; ?>
            <span class="account-text">
                <span class="login-text" data-account-line1><?= $esc($label('您好')) ?></span>
                <span class="register-text" data-account-line2>
                    <?= $esc($label('我的账户')) ?>
                    <span class="account-menu-signal-badge" data-account-menu-signal-total hidden aria-hidden="true"></span>
                </span>
            </span>
            <w:icon name="arrow-down" size="sm"></w:icon>
        </a>
        <div class="account-dropdown">
            <div class="dropdown-header">
                <span class="welcome-text"><?= $esc($label('欢迎回来')) ?></span>
                <span class="user-name" data-account-menu-name><?= $esc($label('我的账户')) ?></span>
            </div>
            <ul class="dropdown-menu account-dropdown-menu" role="menu" data-account-menu>
                <?php if ($dropdownItems === null): ?>
                    <?php /* 导航入口由各模块 header-account-links 贡献；退出登录由宿主固定在底部 */ ?>
                    <w:hook>header-account-links<else/>
                        <li role="none">
                            <a href="@url{'customer/account/index'}" role="menuitem">
                                <?= $esc($label('我的账户')) ?>
                            </a>
                        </li>
                        <li role="none">
                            <a href="@url{'customer/account/index'}#orders" role="menuitem">
                                <?= $esc($label('我的订单')) ?>
                            </a>
                        </li>
                        <li role="none">
                            <a href="@url{'customer/account/index'}#addresses" role="menuitem">
                                <?= $esc($label('地址管理')) ?>
                            </a>
                        </li>
                    </w:hook>
                <?php else: ?>
                <?php foreach ($dropdownItems as $item): ?>
                    <?php if (($item['type'] ?? '') === 'divider'): ?>
                        <li class="divider" role="separator"></li>
                    <?php else: ?>
                        <li role="none">
                            <a href="<?= $esc((string)($item['url'] ?? '#')) ?>" role="menuitem">
                                <?php if (!empty($item['icon'])): ?>
                                    <i class="<?= $esc((string)$item['icon']) ?>"></i>
                                <?php endif; ?>
                                <?= $esc(WidgetI18n::label((string)($item['label'] ?? ''))) ?>
                            </a>
                        </li>
                    <?php endif; ?>
                <?php endforeach; ?>
                <?php endif; ?>
                <li class="divider" role="separator" data-account-menu-auth="signed-in" hidden></li>
                <li role="none" data-account-menu-auth="signed-in" hidden>
                    <a class="logout-link" href="@url{'customer/account/logout'}" role="menuitem" data-account-logout-confirm>
                        <?= $esc($label('退出登录')) ?>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="account-guest" data-account-shell="guest">
        <a href="@url{'customer/account/login'}" class="account-link" data-account-home-link>
            <span class="account-avatar">
                <w:icon name="user" size="sm"></w:icon>
            </span>
            <span class="account-text">
                <span class="login-text"><?= $esc($label('登录')) ?></span>
                <span class="register-text"><?= $esc($label('注册')) ?></span>
            </span>
        </a>
    </div>
</section>

<style>
.<?= $wc ?> {
    position: relative;
}

.<?= $wc ?> .account-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-2);
    text-decoration: none;
    color: var(--weline-chrome-text-light, var(--weline-theme-text-on-dark, inherit));
    padding: var(--weline-space-2) var(--weline-space-3);
    border-radius: var(--weline-radius-md);
    border: var(--border-width-thin, 1px) solid transparent;
    transition: background-color var(--weline-theme-transition-base), border-color var(--weline-theme-transition-base);
}

.<?= $wc ?> .account-link:hover {
    background-color: var(--color-on-dark-soft, var(--weline-theme-surface-muted));
    border-color: var(--weline-chrome-text-light, transparent);
}

.<?= $wc ?> .account-avatar {
    width: var(--size-control-sm);
    height: var(--size-control-sm);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.<?= $wc ?> .account-avatar img,
.<?= $wc ?> .account-avatar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.<?= $wc ?> .account-avatar__img[hidden],
.<?= $wc ?> .account-avatar__fallback[hidden] {
    display: none !important;
}

.<?= $wc ?> .account-avatar__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .account-name {
    font-weight: 500;
    max-width: var(--token-size-100px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.<?= $wc ?> .account-text {
    display: flex;
    flex-direction: column;
    font-size: var(--weline-font-size-sm);
    line-height: 1.3;
}

.<?= $wc ?> .account-menu-signal-badge,
.account-menu-signal-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.1rem;
    height: 1.1rem;
    margin-left: 0.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: #b12704;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
}

.<?= $wc ?> .account-menu-signal-badge[hidden],
.account-menu-signal-badge[hidden] {
    display: none !important;
}

.<?= $wc ?> .login-text {
    font-weight: 400;
    font-size: var(--weline-font-size-xs);
    color: var(--weline-chrome-text-light-secondary, var(--weline-theme-text-muted));
    max-width: var(--token-size-100px, 7.5rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.<?= $wc ?> .register-text {
    color: var(--weline-chrome-text-light, var(--weline-theme-text));
    font-size: var(--weline-font-size-sm);
    font-weight: 700;
}

.<?= $wc ?> .account-logged-in {
    position: relative;
}

.<?= $wc ?> .account-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: var(--size-panel-220);
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg);
    box-shadow: var(--weline-theme-shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--spacing-2_5));
    transition: opacity var(--weline-theme-transition-base),
        visibility var(--weline-theme-transition-base),
        transform var(--weline-theme-transition-base);
    z-index: 1000;
    /* Visual gap only; ::before keeps :hover while the pointer crosses it. */
    margin-top: var(--weline-space-3);
    /* Isolate from header chrome light text (inherit white on dark). */
    color: var(--weline-theme-text);
}

/* Invisible hit bridge across margin-top so the menu does not dismiss mid-move. */
.<?= $wc ?> .account-dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: var(--weline-space-3);
}

.<?= $wc ?> .account-logged-in:hover .account-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.<?= $wc ?> .dropdown-header {
    padding: var(--weline-space-4) var(--weline-space-5);
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    background: var(--weline-theme-surface-muted);
    border-radius: var(--weline-radius-lg) var(--weline-radius-lg) 0 0;
}

.<?= $wc ?> .welcome-text {
    display: block;
    font-size: var(--weline-font-size-xs);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .user-name {
    display: block;
    font-weight: 600;
    font-size: var(--weline-font-size-base);
    color: var(--weline-theme-text);
}

/*
 * theme.css 全局 .dropdown-menu { display:none } 面向 .dropdown/.w-dropdown 触发器。
 * 本部件由 .account-logged-in:hover 展开外层面板，内层 ul 必须常显，否则只剩「欢迎回来」头。
 */
.<?= $wc ?> .account-dropdown .dropdown-menu,
.<?= $wc ?> .account-dropdown .account-dropdown-menu {
    display: block;
    position: static;
    inset: auto;
    top: auto;
    z-index: auto;
    list-style: none;
    margin: 0;
    min-width: 0;
    width: 100%;
    padding: var(--weline-space-2) 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

/* Beat .weline-header .header-user-area a/:visited { color: inherit } (chrome light). */
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a:link,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a:visited {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
    padding: var(--weline-space-3) var(--weline-space-5);
    color: var(--weline-theme-text);
    text-decoration: none;
    transition: background-color var(--weline-theme-transition-base),
        color var(--weline-theme-transition-base);
}

.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a:hover {
    background-color: var(--weline-theme-surface-muted);
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a.logout-link,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a.logout-link:link,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a.logout-link:visited,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a[data-account-logout-confirm],
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a[data-account-logout-confirm]:link,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a[data-account-logout-confirm]:visited {
    color: var(--weline-theme-danger);
}

.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a.logout-link:hover,
.<?= $wc ?> .account-logged-in .account-dropdown .dropdown-menu a[data-account-logout-confirm]:hover {
    background-color: var(--weline-theme-danger-surface);
    color: var(--weline-theme-danger-hover);
}

.<?= $wc ?> .dropdown-menu .divider {
    height: var(--spacing-px);
    background: var(--weline-theme-border);
    margin: var(--weline-space-2) 0;
}

.<?= $wc ?> [data-account-menu-auth][hidden],
.<?= $wc ?> [data-account-menu-auth].is-account-menu-hidden {
    display: none !important;
}

.widget-preview-canvas .<?= $wc ?> .account-dropdown,
.<?= $wc ?>.is-preview .account-dropdown {
    display: none;
}

@media (max-width: 768px) {
    .<?= $wc ?> .account-link {
        color: inherit;
        padding: var(--spacing-1_5) var(--spacing-0_4);
        min-height: var(--size-control-lg);
        gap: var(--spacing-0_4);
    }

    .<?= $wc ?> .account-avatar {
        width: var(--size-control-xs);
        height: var(--size-control-xs);
        background: transparent;
        color: inherit;
    }

    .<?= $wc ?> .account-text {
        flex-direction: row;
        align-items: center;
        gap: var(--token-size-0-15rem);
    }

    .<?= $wc ?> .register-text {
        display: none;
    }

    .<?= $wc ?> .login-text::after {
        content: " ›";
        font-weight: 700;
    }

    .<?= $wc ?> .account-dropdown {
        display: none;
    }
}
</style>
