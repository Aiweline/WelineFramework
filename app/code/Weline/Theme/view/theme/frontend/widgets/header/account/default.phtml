<?php
/**
 * Header 用户账户部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {account}
 * @widget.name {用户账户入口}
 * @widget.description {Header 用户账户入口，支持登录状态显示和下拉菜单}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"user-area","area":"header","sort_order":0}]}
 *
 * @param show_avatar {default=true,type="bool",label="显示头像"}
 * @param show_name {default=false,type="bool",label="显示用户名"}
 * @param dropdown_items {default=[],type="array",label="下拉菜单项"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('account');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showAvatar = (bool)($this->getData('show_avatar') ?? true);
$showName = (bool)($this->getData('show_name') ?? false);
$dropdownItems = $this->getData('dropdown_items') ?? [];

$isLoggedIn = false;
$userName = '用户名';
$userAvatar = '';

if (empty($dropdownItems)) {
    $dropdownItems = [
        ['label' => __('我的账户'), 'url' => '/account', 'icon' => 'user'],
        ['label' => __('我的订单'), 'url' => '/customer/account/index#orders', 'icon' => 'list'],
        ['label' => __('我的收藏'), 'url' => '/account/wishlist', 'icon' => 'heart'],
        ['label' => __('地址管理'), 'url' => '/account/addresses', 'icon' => 'pin'],
        ['type' => 'divider'],
        ['label' => __('退出登录'), 'url' => '/account/logout', 'icon' => 'box'],
    ];
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($isLoggedIn): ?>
        <div class="account-logged-in">
            <a href="/account" class="account-link">
                <?php if ($showAvatar): ?>
                    <span class="account-avatar">
                        <?php if ($userAvatar !== ''): ?>
                            <img src="<?= $esc($userAvatar) ?>" alt="<?= $esc($userName) ?>">
                        <?php else: ?>
                            <w:icon name="user" size="sm"></w:icon>
                        <?php endif; ?>
                    </span>
                <?php endif; ?>
                <?php if ($showName): ?>
                    <span class="account-name"><?= $esc($userName) ?></span>
                <?php endif; ?>
                <w:icon name="arrow-down" size="sm"></w:icon>
            </a>
            <div class="account-dropdown">
                <div class="dropdown-header">
                    <span class="welcome-text"><?= __('欢迎回来') ?></span>
                    <span class="user-name"><?= $esc($userName) ?></span>
                </div>
                <ul class="dropdown-menu" role="menu">
                    <?php foreach ($dropdownItems as $item): ?>
                        <?php if (($item['type'] ?? '') === 'divider'): ?>
                            <li class="divider" role="separator"></li>
                        <?php else: ?>
                            <li>
                                <a href="<?= $esc((string)($item['url'] ?? '#')) ?>">
                                    <?php if (!empty($item['icon'])): ?>
                                        <i class="<?= $esc((string)$item['icon']) ?>"></i>
                                    <?php endif; ?>
                                    <?= $esc((string)($item['label'] ?? '')) ?>
                                </a>
                            </li>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </ul>
            </div>
        </div>
    <?php else: ?>
        <div class="account-guest">
            <a href="/account/login" class="account-link">
                <span class="account-avatar">
                    <w:icon name="user" size="sm"></w:icon>
                </span>
                <span class="account-text">
                    <span class="login-text"><?= __('登录') ?></span>
                    <span class="register-text"><?= __('注册') ?></span>
                </span>
            </a>
        </div>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    position: relative;
}

.<?= $wc ?> .account-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-2, 8px);
    text-decoration: none;
    color: var(--weline-theme-text);
    padding: var(--weline-space-2, 8px) var(--weline-space-3, 12px);
    border-radius: var(--weline-radius-md, 8px);
    transition: background-color var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .account-link:hover {
    background-color: var(--weline-theme-surface-muted);
}

.<?= $wc ?> .account-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--weline-theme-surface-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.<?= $wc ?> .account-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.<?= $wc ?> .account-name {
    font-weight: 500;
    max-width: 100px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.<?= $wc ?> .account-text {
    display: flex;
    flex-direction: column;
    font-size: var(--weline-font-size-sm, 13px);
    line-height: 1.3;
}

.<?= $wc ?> .login-text {
    font-weight: 600;
}

.<?= $wc ?> .register-text {
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-xs, 12px);
}

.<?= $wc ?> .account-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 220px;
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg, 12px);
    box-shadow: var(--weline-theme-shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all var(--weline-theme-transition-base, 0.2s ease);
    z-index: 1000;
    margin-top: var(--weline-space-3, 10px);
}

.<?= $wc ?> .account-logged-in:hover .account-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.<?= $wc ?> .dropdown-header {
    padding: var(--weline-space-4, 15px) var(--weline-space-5, 20px);
    border-bottom: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
    background: var(--weline-theme-surface-muted);
    border-radius: var(--weline-radius-lg, 12px) var(--weline-radius-lg, 12px) 0 0;
}

.<?= $wc ?> .welcome-text {
    display: block;
    font-size: var(--weline-font-size-xs, 12px);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .user-name {
    display: block;
    font-weight: 600;
    font-size: var(--weline-font-size-base, 15px);
}

.<?= $wc ?> .dropdown-menu {
    list-style: none;
    margin: 0;
    padding: var(--weline-space-2, 8px) 0;
}

.<?= $wc ?> .dropdown-menu li a {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3, 12px);
    padding: var(--weline-space-3, 10px) var(--weline-space-5, 20px);
    color: var(--weline-theme-text);
    text-decoration: none;
    transition: all var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .dropdown-menu li a:hover {
    background-color: var(--weline-theme-surface-muted);
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .dropdown-menu .divider {
    height: 1px;
    background: var(--weline-theme-border);
    margin: var(--weline-space-2, 8px) 0;
}

.widget-preview-canvas .<?= $wc ?> .account-dropdown,
.<?= $wc ?>.is-preview .account-dropdown {
    display: none;
}
</style>
