<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-pagination-pagination-default.css}
 * 分页部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {pagination}
 * @widget.name {分页}
 * @widget.description {列表分页导航}
 * @widget.type {pagination}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["category", "search", "cms_page"]}
 * @widget.supports {["layout-category-pagination","layout-products-pagination"]}
 *
 * @param style {default="default",type="select",label="样式",options={default:"默认",simple:"简洁",minimal:"极简"}}
 * @param show_first_last {default=true,type="bool",label="显示首尾按钮"}
 * @param show_prev_next {default=true,type="bool",label="显示上下页按钮"}
 * @param page_range {default=5,type="number",label="显示页码数量"}
 * @param prev_text {default="上一页",type="string",label="上一页文字"}
 * @param next_text {default="下一页",type="string",label="下一页文字"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('pagination');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$style = $this->getData('style') ?? 'default';
$showFirstLast = (bool)($this->getData('show_first_last') ?? true);
$showPrevNext = (bool)($this->getData('show_prev_next') ?? true);
$pageRange = (int)($this->getData('page_range') ?? 5);
$prevText = $this->getData('prev_text') ?? __('上一页');
$nextText = $this->getData('next_text') ?? __('下一页');
$currentPage = (int)($this->getData('current_page') ?? 1);
$totalPages = (int)($this->getData('total_pages') ?? 10);
$baseUrl = $this->getData('base_url') ?? '?page=';

$startPage = max(1, $currentPage - (int)floor($pageRange / 2));
$endPage = min($totalPages, $startPage + $pageRange - 1);
if ($endPage - $startPage + 1 < $pageRange) {
    $startPage = max(1, $endPage - $pageRange + 1);
}

if ($totalPages <= 1) {
    return;
}
?>

<section class="<?= $esc($wc) ?> style-<?= $esc((string)$style) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <nav class="pagination-nav" aria-label="<?= __('分页导航') ?>">
        <ul class="pagination-list">
            <?php if ($showFirstLast && $currentPage > 1): ?>
                <li class="page-item">
                    <a href="<?= $esc((string)$baseUrl . '1') ?>" class="page-link page-first" title="<?= __('第一页') ?>">
                        <w:icon name="circle" size="sm"></w:icon>
                    </a>
                </li>
            <?php endif; ?>
            <?php if ($showPrevNext): ?>
                <li class="page-item <?= $currentPage <= 1 ? 'is-disabled' : '' ?>">
                    <?php if ($currentPage > 1): ?>
                        <a href="<?= $esc((string)$baseUrl . ($currentPage - 1)) ?>" class="page-link page-prev">
                            <w:icon name="arrow-left" size="sm"></w:icon>
                            <span><?= $esc((string)$prevText) ?></span>
                        </a>
                    <?php else: ?>
                        <span class="page-link page-prev">
                            <w:icon name="arrow-left" size="sm"></w:icon>
                            <span><?= $esc((string)$prevText) ?></span>
                        </span>
                    <?php endif; ?>
                </li>
            <?php endif; ?>
            <?php if ($startPage > 1): ?>
                <li class="page-item"><a href="<?= $esc((string)$baseUrl . '1') ?>" class="page-link">1</a></li>
                <?php if ($startPage > 2): ?>
                    <li class="page-item is-ellipsis"><span class="page-link">...</span></li>
                <?php endif; ?>
            <?php endif; ?>
            <?php for ($i = $startPage; $i <= $endPage; $i++): ?>
                <li class="page-item <?= $i === $currentPage ? 'is-active' : '' ?>">
                    <?php if ($i === $currentPage): ?>
                        <span class="page-link" aria-current="page"><?= $i ?></span>
                    <?php else: ?>
                        <a href="<?= $esc((string)$baseUrl . $i) ?>" class="page-link"><?= $i ?></a>
                    <?php endif; ?>
                </li>
            <?php endfor; ?>
            <?php if ($endPage < $totalPages): ?>
                <?php if ($endPage < $totalPages - 1): ?>
                    <li class="page-item is-ellipsis"><span class="page-link">...</span></li>
                <?php endif; ?>
                <li class="page-item"><a href="<?= $esc((string)$baseUrl . $totalPages) ?>" class="page-link"><?= $totalPages ?></a></li>
            <?php endif; ?>
            <?php if ($showPrevNext): ?>
                <li class="page-item <?= $currentPage >= $totalPages ? 'is-disabled' : '' ?>">
                    <?php if ($currentPage < $totalPages): ?>
                        <a href="<?= $esc((string)$baseUrl . ($currentPage + 1)) ?>" class="page-link page-next">
                            <span><?= $esc((string)$nextText) ?></span>
                            <w:icon name="arrow-right" size="sm"></w:icon>
                        </a>
                    <?php else: ?>
                        <span class="page-link page-next">
                            <span><?= $esc((string)$nextText) ?></span>
                            <w:icon name="arrow-right" size="sm"></w:icon>
                        </span>
                    <?php endif; ?>
                </li>
            <?php endif; ?>
            <?php if ($showFirstLast && $currentPage < $totalPages): ?>
                <li class="page-item">
                    <a href="<?= $esc((string)$baseUrl . $totalPages) ?>" class="page-link page-last" title="<?= __('最后一页') ?>">
                        <w:icon name="circle" size="sm"></w:icon>
                    </a>
                </li>
            <?php endif; ?>
        </ul>
    </nav>
</section>

