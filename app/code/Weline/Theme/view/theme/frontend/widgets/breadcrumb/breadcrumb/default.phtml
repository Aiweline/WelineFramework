<?php
/**
 * 面包屑导航部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {breadcrumb}
 * @widget.name {面包屑导航}
 * @widget.description {显示当前页面的导航路径}
 * @widget.type {breadcrumb}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 *
 * @param show_home {default=true,type="bool",label="显示首页"}
 * @param home_text {default="首页",type="string",label="首页文字"}
 * @param home_icon {default=true,type="bool",label="显示首页图标"}
 * @param separator {default="/",type="string",label="分隔符"}
 * @param show_current {default=true,type="bool",label="显示当前页"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('breadcrumb');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showHome = (bool)($this->getData('show_home') ?? true);
$homeText = $this->getData('home_text') ?? __('首页');
$homeIcon = (bool)($this->getData('home_icon') ?? true);
$separator = $this->getData('separator') ?? '/';
$showCurrent = (bool)($this->getData('show_current') ?? true);
$breadcrumbs = $this->getData('breadcrumbs') ?? [];

if (empty($breadcrumbs)) {
    $breadcrumbs = [
        ['label' => __('分类'), 'url' => '/category'],
        ['label' => __('电子产品'), 'url' => '/category/electronics'],
        ['label' => __('手机'), 'url' => ''],
    ];
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <nav class="breadcrumb-nav" aria-label="<?= __('面包屑导航') ?>">
        <ol class="breadcrumb-list">
            <?php if ($showHome): ?>
                <li class="breadcrumb-item">
                    <a href="/" class="breadcrumb-link">
                        <?php if ($homeIcon): ?>
                            <w:icon name="home" size="sm"></w:icon>
                        <?php endif; ?>
                        <span><?= $esc((string)$homeText) ?></span>
                    </a>
                    <span class="breadcrumb-separator"><?= $esc((string)$separator) ?></span>
                </li>
            <?php endif; ?>
            <?php foreach ($breadcrumbs as $index => $crumb):
                $isLast = ($index === count($breadcrumbs) - 1);
                $hasUrl = !empty($crumb['url']);
                if ($isLast && !$showCurrent) continue;
            ?>
                <li class="breadcrumb-item <?= $isLast ? 'active' : '' ?>">
                    <?php if ($hasUrl && !$isLast): ?>
                        <a href="<?= $esc((string)$crumb['url']) ?>" class="breadcrumb-link"><?= $esc((string)$crumb['label']) ?></a>
                        <span class="breadcrumb-separator"><?= $esc((string)$separator) ?></span>
                    <?php else: ?>
                        <span class="breadcrumb-current" aria-current="page"><?= $esc((string)$crumb['label']) ?></span>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ol>
    </nav>
</section>

<style>
.<?= $wc ?> {
    padding: var(--weline-space-4, 15px) 0;
}

.<?= $wc ?> .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--weline-font-size-sm, 14px);
}

.<?= $wc ?> .breadcrumb-item {
    display: flex;
    align-items: center;
}

.<?= $wc ?> .breadcrumb-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-1, 5px);
    color: var(--weline-theme-text-muted);
    text-decoration: none;
    transition: color var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .breadcrumb-link:hover {
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .breadcrumb-separator {
    margin: 0 var(--weline-space-3, 10px);
    color: var(--weline-theme-border);
}

.<?= $wc ?> .breadcrumb-current {
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .breadcrumb-item.active {
    font-weight: 500;
    color: var(--weline-theme-text);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-2, 8px) 0;
    font-size: var(--weline-font-size-xs, 12px);
}
</style>
