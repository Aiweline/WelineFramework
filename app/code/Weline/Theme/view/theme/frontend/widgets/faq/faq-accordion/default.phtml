<?php
/**
 * @widget.code {faq-accordion}
 * @widget.name {FAQ折叠}
 * @widget.description {通用常见问题，支持键盘展开、搜索与单项或多项展开}
 * @widget.type {faq}
 * @widget.area {frontend}
 * @widget.position {["content","sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-contact-faq","layout-contact-content","layout-cms-content","layout-default-content","faq"]}
 * @widget.compatible {true}
 * @param title {default="常见问题",type="string",label="标题"}
 * @param subtitle {default="",type="string",label="副标题"}
 * @param faqs {default=[],type="site_faq_items",label="FAQ列表"}
 * @param expand_first {default=true,type="bool",label="默认展开第一个"}
 * @param allow_multiple {default=false,type="bool",label="允许同时展开多个"}
 * @param search_enabled {default=false,type="bool",label="显示搜索"}
 */

use Weline\Theme\Helper\SiteBlockConfig as Block;
use Weline\Theme\Helper\WidgetUiScope;
use Weline\Theme\Helper\WidgetI18n;

$scope = WidgetUiScope::forWidget('faq-accordion');
$esc = [Block::class, 'escape'];
$t = static fn (mixed $value): string => Block::escape(WidgetI18n::label(Block::text($value)));
$title = Block::text($this->getData('title') ?? '常见问题');
$subtitle = Block::text($this->getData('subtitle'));
$faqs = Block::items($this->getData('faqs'));
$expandFirst = Block::boolean($this->getData('expand_first'), true);
$allowMultiple = Block::boolean($this->getData('allow_multiple'));
$searchEnabled = Block::boolean($this->getData('search_enabled'));
?>
<link rel="stylesheet" href="@static(Weline_Theme::css/widgets/site-blocks.css)">
<section class="<?= $esc($scope->cssClass) ?> weline-site-block" weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>" data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="siteBlocks" data-site-block="faq" data-allow-multiple="<?= $allowMultiple ? 'true' : 'false' ?>">
    <?php if ($title !== '' || $subtitle !== ''): ?>
        <header class="sb-header">
            <?php if ($title !== ''): ?><h2 class="sb-title"><?= $t($title) ?></h2><?php endif; ?>
            <?php if ($subtitle !== ''): ?><p class="sb-lead"><?= $t($subtitle) ?></p><?php endif; ?>
        </header>
    <?php endif; ?>
    <?php if ($searchEnabled): ?>
        <input type="search" class="w-input sb-search" data-faq-search aria-label="@lang{搜索问题}" placeholder="@lang{搜索问题}">
    <?php endif; ?>
    <div class="w-card sb-card">
        <?php foreach ($faqs as $index => $faq): ?>
            <details class="sb-faq" <?= !$allowMultiple ? 'name="' . $esc($scope->uid) . '-faq"' : '' ?> <?= $expandFirst && $index === 0 ? 'open' : '' ?>>
                <summary><?= $t($faq['question'] ?? '') ?></summary>
                <div class="sb-copy"><?= $t($faq['answer'] ?? '') ?></div>
            </details>
        <?php endforeach; ?>
    </div>
    <p class="sb-empty" data-faq-empty <?= $faqs !== [] ? 'hidden' : '' ?>><lang>暂无匹配的问题</lang></p>
</section>
