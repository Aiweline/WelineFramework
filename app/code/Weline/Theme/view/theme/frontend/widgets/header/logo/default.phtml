<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-header-logo-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js,Weline_Theme::js/widgets/widget-logo-fallback.js}
 * @widget.layout_source {Weline_Theme::css/widgets/widget-header-logo-default.css}
 * Header Logo 部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {logo}
 * @widget.name {Header Logo}
 * @widget.description {网站 Logo，支持图片或文字显示}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {logo}
 * @widget.supports {["layout-header-logo","layout-global-header-logo"]}
 * @widget.exclusive {true}
 *
 * @param logo_image {default="",type="media_image",label="Logo图片",description="从媒体库选择 Logo，留空使用文字",i18n=false}
 * @param logo_text {default="",type="string",label="Logo文字",description="留空使用当前网站名称"}
 * @param logo_link {default="/",type="string",label="Logo链接"}
 * @param logo_height {default=40,type="number",label="Logo高度(px)"}
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\SiteBrand;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('logo');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$logoImage = LegacyMediaUrl::sanitize($this->getData('logo_image') ?? '');
$logoImageFileHtml = (string)($this->getData('logo_image_file_html') ?? '');
$configuredLogoText = trim((string)($this->getData('logo_text') ?? ''));
$logoText = 'Weline';
try {
    $siteBrandForName = ObjectManager::getInstance(SiteBrand::class);
    if ($siteBrandForName instanceof SiteBrand) {
        $logoText = $siteBrandForName->resolveFrontendWordmark($configuredLogoText, 'Weline Store');
    } elseif ($configuredLogoText !== '') {
        $logoText = $configuredLogoText;
    }
} catch (\Throwable) {
    if ($configuredLogoText !== '') {
        $logoText = $configuredLogoText;
    }
}
$logoLink = LegacyMediaUrl::sanitize($this->getData('logo_link') ?? '/');
if ($logoLink === '') {
    $logoLink = '/';
}
$logoHeight = max(16, min(400, (int)($this->getData('logo_height') ?? 40)));

if ($logoImage === '' && $logoImageFileHtml === '') {
    $defaultLogoUrl = '/Weline/Theme/view/theme/frontend/assets/images/theme/logo.png';
    try {
        $siteBrand = ObjectManager::getInstance(SiteBrand::class);
        if ($siteBrand instanceof SiteBrand) {
            $resolved = $siteBrand->resolveFrontendLogoUrl($this);
            if (is_string($resolved) && $resolved !== '') {
                $defaultLogoUrl = $resolved;
            }
        }
    } catch (\Throwable) {
        // keep Theme module default mark
    }
    $logoImage = $defaultLogoUrl;
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-style="--wc-logo-height: <?= $logoHeight ?>px;">
    <a href="<?= $esc($logoLink) ?>" class="logo-link" title="<?= $esc((string)$logoText) ?>">
        <?php if ($logoImageFileHtml !== ''): ?>
            <span class="logo-image logo-image--asset"><?= $logoImageFileHtml ?></span>
        <?php else: ?>
            <img src="<?= $esc($logoImage) ?>"
                 alt="<?= $esc((string)$logoText) ?>"
                 class="logo-image"
                 width="420"
                 height="159"
                 decoding="async"
                 data-widget-style-class="eef44f2a1b0e4367"
                 data-widget-logo-image>
            <span class="logo-text" data-widget-style-class="8387420c4b8f095e"><?= $esc((string)$logoText) ?></span>
        <?php endif; ?>
    </a>
</section>

