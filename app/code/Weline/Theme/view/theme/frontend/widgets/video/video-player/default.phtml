<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-video-video-player-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 视频播放器部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {video-player}
 * @widget.name {视频播放器}
 * @widget.description {视频播放器，支持YouTube、Vimeo和自托管视频}
 * @widget.type {video}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param video_type {default="youtube",type="select",label="视频类型",options={youtube:"YouTube",vimeo:"Vimeo",self:"自托管",embed:"嵌入代码"}}
 * @param video_url {default="",type="url",label="视频地址",placeholder="https://www.youtube.com/watch?v=…",description="YouTube / Vimeo 页面链接，或自托管 mp4 地址",i18n=false}
 * @param title {default="",type="string",label="区标题",description="首页等场景可选显示在播放器上方"}
 * @param embed_code {default="",type="textarea",label="嵌入代码",placeholder="<iframe src=\"https://www.youtube.com/embed/…\"></iframe>",description="仅「嵌入代码」类型必填。若误把 YouTube 链接贴到这里，也会自动识别。",i18n=false}
 * @param poster {default="",type="media_image",label="封面图片",description="从媒体库选择封面图（自托管视频用）",i18n=false}
 * @param autoplay {default=false,type="bool",label="自动播放",description="与「静音播放」独立。开启后建议同时开启静音，否则多数浏览器会拦截带声自动播放"}
 * @param muted {default=false,type="bool",label="静音播放",description="与「自动播放」独立。关闭后预览与前台均不强制静音；与自动播放同开时部分浏览器可能禁止自动开始"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\VideoEmbedResolver;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('video-player');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$videoType = strtolower(trim((string)($this->getData('video_type') ?? 'youtube')));
$videoUrlRaw = (string)($this->getData('video_url') ?? '');
$embedCodeRaw = trim((string)($this->getData('embed_code') ?? ''));
$sectionTitleRaw = trim((string)($this->getData('title') ?? ''));
// Hydrated file-image → src string; legacy URL rows still sanitize for render-only.
$poster = LegacyMediaUrl::sanitize($this->getData('poster') ?? '');
$aspectRatio = $this->getData('aspect_ratio') ?? '16:9';

$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    $translated = trim((string)WidgetI18n::label($source));
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};

// Default homepage demo: public, embeddable YouTube when unset.
$defaultYoutubeUrl = 'https://www.youtube.com/watch?v=aqz-KE-bpKQ';
if ($videoType === 'youtube'
    && trim($videoUrlRaw) === ''
    && $embedCodeRaw === ''
) {
    $videoUrlRaw = $defaultYoutubeUrl;
}
if ($sectionTitleRaw === '') {
    $sectionTitleRaw = $translateDefaultCopy('穿搭灵感 · YouTube', 'Style inspiration · YouTube');
} elseif (in_array($sectionTitleRaw, ['穿搭灵感 · YouTube', 'Style inspiration · YouTube'], true)) {
    $sectionTitleRaw = $translateDefaultCopy('穿搭灵感 · YouTube', 'Style inspiration · YouTube');
}
$sectionTitle = $sectionTitleRaw;

// Avoid (bool)"0" === true when config arrives as string.
$videoBool = static function (mixed $value): bool {
    if (is_bool($value)) {
        return $value;
    }
    if (is_int($value) || is_float($value)) {
        return (int)$value === 1;
    }
    $normalized = strtolower(trim((string)$value));
    return in_array($normalized, ['1', 'true', 'yes', 'on'], true);
};
$autoplay = $videoBool($this->getData('autoplay') ?? false);
$muted = $videoBool($this->getData('muted') ?? false);
$loop = $videoBool($this->getData('loop') ?? false);
// Respect muted checkbox literally; do not force-mute when autoplay is on.
$playbackMuted = $muted;

if ($videoType === 'local') {
    $videoType = 'self';
}

$ratioMap = [
    '16:9' => '56.25%',
    '4:3'  => '75%',
    '1:1'  => '100%',
    '9:16' => '177.78%',
];
$paddingTop = $ratioMap[$aspectRatio] ?? '56.25%';

$sanitizeEmbedCode = static function (mixed $html): string {
    $html = trim((string)$html);
    if ($html === '') {
        return '';
    }

    $allowedTags = ['iframe' => true, 'video' => true, 'source' => true, 'embed' => true];
    $allowedAttrs = [
        'iframe' => ['src', 'width', 'height', 'title', 'allow', 'allowfullscreen', 'loading', 'referrerpolicy', 'class'],
        'video' => ['src', 'poster', 'width', 'height', 'controls', 'autoplay', 'muted', 'loop', 'playsinline', 'preload', 'class'],
        'source' => ['src', 'type', 'media'],
        'embed' => ['src', 'type', 'width', 'height', 'class'],
    ];
    $trustedIframeHosts = VideoEmbedResolver::trustedEmbedHosts();

    $previous = libxml_use_internal_errors(true);
    try {
        $wrapped = '<!DOCTYPE html><html><head><meta charset="UTF-8"></head><body>' . $html . '</body></html>';
        if (function_exists('mb_encode_numericentity')) {
            $wrapped = mb_encode_numericentity($wrapped, [0x80, 0x10FFFF, 0, 0xFFFF], 'UTF-8');
        }
        $doc = new DOMDocument('1.0', 'UTF-8');
        $doc->loadHTML($wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
        $xpath = new DOMXPath($doc);

        $nodes = [];
        foreach ($xpath->query('//body//*') as $node) {
            if ($node instanceof DOMElement) {
                $nodes[] = $node;
            }
        }

        foreach ($nodes as $node) {
            if (!$node->parentNode) {
                continue;
            }
            $tag = strtolower($node->tagName);
            if (!isset($allowedTags[$tag])) {
                if (!in_array($tag, ['script', 'style', 'object'], true)) {
                    while ($node->firstChild) {
                        $node->parentNode->insertBefore($node->firstChild, $node);
                    }
                }
                $node->parentNode?->removeChild($node);
                continue;
            }

            $toRemove = [];
            foreach ($node->attributes as $attr) {
                $name = strtolower($attr->name);
                $value = (string)$attr->value;
                if (str_starts_with($name, 'on') || $name === 'style' || $name === 'srcdoc' || !in_array($name, $allowedAttrs[$tag], true)) {
                    $toRemove[] = $attr->name;
                    continue;
                }

                if (in_array($name, ['src', 'poster'], true)) {
                    $safeUrl = VideoEmbedResolver::safeHttpUrl($value);
                    if ($safeUrl === '') {
                        $toRemove[] = $attr->name;
                        continue;
                    }
                    if ($tag === 'iframe') {
                        $host = strtolower((string)parse_url($safeUrl, PHP_URL_HOST));
                        if (!in_array($host, $trustedIframeHosts, true)) {
                            $toRemove[] = $attr->name;
                            continue;
                        }
                    }
                    $node->setAttribute($attr->name, $safeUrl);
                } elseif ($name === 'class') {
                    $node->setAttribute($attr->name, trim((string)preg_replace('/[^a-zA-Z0-9_\-\s]/', '', $value)));
                } elseif (in_array($name, ['width', 'height'], true) && !preg_match('/^\d{1,4}(?:\.\d{1,2})?%?$/', $value)) {
                    $toRemove[] = $attr->name;
                } elseif ($name === 'allow') {
                    $node->setAttribute($attr->name, preg_replace('/[^a-zA-Z0-9;,\-\s]/', '', $value) ?: '');
                }
            }
            foreach ($toRemove as $name) {
                $node->removeAttribute($name);
            }

            if (($tag === 'iframe' || $tag === 'embed') && !$node->hasAttribute('src')) {
                $node->parentNode?->removeChild($node);
                continue;
            }
            if ($tag === 'iframe') {
                $node->setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation');
                $node->setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
                $node->setAttribute('loading', 'lazy');
            }
        }

        $body = $doc->getElementsByTagName('body')->item(0);
        $safeHtml = '';
        if ($body) {
            foreach ($body->childNodes as $child) {
                $safeHtml .= $doc->saveHTML($child);
            }
        }
        return $safeHtml;
    } catch (Throwable) {
        return '';
    } finally {
        libxml_clear_errors();
        libxml_use_internal_errors($previous);
    }
};

$videoUrl = VideoEmbedResolver::coalesceSourceUrl($videoUrlRaw, $embedCodeRaw);
$embedCode = $sanitizeEmbedCode($embedCodeRaw);

$videoId = '';
$parseBlob = trim($videoUrl . "\n" . $embedCodeRaw);
if ($videoType === 'youtube') {
    $videoId = VideoEmbedResolver::resolveYoutubeId($parseBlob);
} elseif ($videoType === 'vimeo') {
    $videoId = VideoEmbedResolver::resolveVimeoId($parseBlob);
}

// Bare YouTube/Vimeo URL pasted into embed_code with type=embed → promote to provider iframe.
if ($videoType === 'embed' && $embedCode === '' && $videoUrl !== '') {
    $yt = VideoEmbedResolver::resolveYoutubeId($videoUrl);
    $vm = $yt === '' ? VideoEmbedResolver::resolveVimeoId($videoUrl) : '';
    if ($yt !== '') {
        $videoType = 'youtube';
        $videoId = $yt;
    } elseif ($vm !== '') {
        $videoType = 'vimeo';
        $videoId = $vm;
    }
}

$hasPlayable = ($videoType === 'youtube' && $videoId !== '')
    || ($videoType === 'vimeo' && $videoId !== '')
    || ($videoType === 'self' && $videoUrl !== '')
    || ($videoType === 'embed' && $embedCode !== '');

$placeholderMessage = __('请填写视频地址');
if ($videoType === 'embed') {
    $placeholderMessage = __('请粘贴嵌入代码（iframe）或视频链接');
} elseif ($videoType === 'self') {
    $placeholderMessage = __('请填写自托管视频地址（mp4 等）');
} elseif (($videoUrlRaw !== '' || $embedCodeRaw !== '') && !$hasPlayable) {
    $placeholderMessage = __('无法识别该视频地址，请检查链接是否正确');
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-site-block="video-player">
    <?php if ($sectionTitle !== ''): ?>
        <header class="video-player-header">
            <h2 class="video-player-title"><?= $esc($sectionTitle) ?></h2>
        </header>
    <?php endif; ?>
    <div class="video-container" data-widget-style="--wc-aspect-padding: <?= $esc($paddingTop) ?>">
        <?php if ($videoType === 'youtube' && $videoId): ?>
            <iframe src="https://www.youtube.com/embed/<?= $esc($videoId) ?>?<?= $autoplay ? 'autoplay=1&' : '' ?><?= $playbackMuted ? 'mute=1&' : '' ?><?= $loop ? 'loop=1&playlist=' . $esc($videoId) : '' ?>"
                    class="video-iframe"
                    title="<?= $esc(__('YouTube 视频')) ?>"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    sandbox="allow-scripts allow-same-origin allow-presentation"
                    referrerpolicy="strict-origin-when-cross-origin"
                    loading="<?= $isPreviewMode ? 'eager' : 'lazy' ?>"
                    allowfullscreen></iframe>

        <?php elseif ($videoType === 'vimeo' && $videoId): ?>
            <iframe src="https://player.vimeo.com/video/<?= $esc($videoId) ?>?<?= $autoplay ? 'autoplay=1&' : '' ?><?= $playbackMuted ? 'muted=1&' : '' ?><?= $loop ? 'loop=1' : '' ?>"
                    class="video-iframe"
                    title="<?= $esc(__('Vimeo 视频')) ?>"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture"
                    sandbox="allow-scripts allow-same-origin allow-presentation"
                    referrerpolicy="strict-origin-when-cross-origin"
                    loading="<?= $isPreviewMode ? 'eager' : 'lazy' ?>"
                    allowfullscreen></iframe>

        <?php elseif ($videoType === 'self' && $videoUrl): ?>
            <video class="video-native"
                   <?= $autoplay ? 'autoplay' : '' ?>
                   <?= $playbackMuted ? 'muted' : '' ?>
                   <?= $loop ? 'loop' : '' ?>
                   <?= $poster ? 'poster="' . $esc($poster) . '"' : '' ?>
                   controls
                   playsinline>
                <source src="<?= $esc($videoUrl) ?>" type="video/mp4">
                <?= __('您的浏览器不支持视频标签。') ?>
            </video>

        <?php elseif ($videoType === 'embed' && $embedCode): ?>
            <?= $embedCode ?>

        <?php else: ?>
            <div class="video-placeholder" role="status">
                <w:icon name="play" size="sm"></w:icon>
                <p><?= $esc((string)$placeholderMessage) ?></p>
                <p class="video-placeholder-hint"><?= $esc((string)__('在左侧「视频地址」填入 YouTube / Vimeo 链接后即可预览')) ?></p>
            </div>
        <?php endif; ?>
    </div>
</section>

