<?php
/**
 * 信任徽章部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {trust-badges}
 * @widget.name {信任徽章}
 * @widget.description {展示安全支付、退款保障等信任标识}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-homepage-trust","layout-cart-trust","layout-checkout-trust","layout-contact-help","layout-contact-methods","layout-contact-content","layout-default-content"]}
 * @widget.compatible {true}
 *
 * @param title {default="",type="string",label="标题"}
 * @param badges {default=[],type="array",label="自定义徽章"}
 * @param preset_badges {default=["secure-payment","money-back","free-shipping","24-7-support"],type="array",label="预设徽章"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param style {default="icon-text",type="select",label="样式",options={icon-text:"图标+文字",icon-only:"仅图标",card:"卡片"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('trust-badges');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = trim((string)($this->getData('title') ?? ''));
$badges = $this->getData('badges') ?? [];
$presetBadges = $this->getData('preset_badges') ?? ['secure-payment', 'money-back', 'free-shipping', '24-7-support'];
$columns = (string)($this->getData('columns') ?? '4');
$style = (string)($this->getData('style') ?? 'icon-text');

if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '4';
}
if (!in_array($style, ['icon-text', 'icon-only', 'card'], true)) {
    $style = 'icon-text';
}

$presetConfig = [
    'secure-payment' => ['icon' => 'check', 'title' => __('安全支付'), 'description' => __('SSL加密保护')],
    'money-back'     => ['icon' => 'circle', 'title' => __('无忧退款'), 'description' => __('30天无理由退货')],
    'free-shipping'  => ['icon' => 'truck', 'title' => __('免费配送'), 'description' => __('满额包邮')],
    '24-7-support'   => ['icon' => 'circle', 'title' => __('全天候客服'), 'description' => __('7×24小时在线')],
    'ssl-secure'     => ['icon' => 'lock', 'title' => __('SSL安全'), 'description' => __('数据加密传输')],
    'verified-seller'=> ['icon' => 'circle', 'title' => __('认证商家'), 'description' => __('正品保证')],
];

$allBadges = [];
if (is_array($presetBadges)) {
    foreach ($presetBadges as $preset) {
        if (isset($presetConfig[$preset])) {
            $allBadges[] = $presetConfig[$preset];
        }
    }
}
if (is_array($badges)) {
    $allBadges = array_merge($allBadges, $badges);
}
?>

<section class="<?= $esc($wc) ?> style-<?= $esc($style) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">

    <?php if ($title !== ''): ?>
        <h3 class="badges-heading"><?= $esc($title) ?></h3>
    <?php endif; ?>

    <div class="badges-grid columns-<?= $esc($columns) ?>">
        <?php foreach ($allBadges as $badge): ?>
            <div class="badge-item">
                <div class="badge-icon" aria-hidden="true">
                    <w:icon name="badge.icon|check" size="md"></w:icon>
                </div>

                <?php if ($style !== 'icon-only'): ?>
                    <div class="badge-content">
                        <h4 class="badge-title"><?= $esc((string)($badge['title'] ?? '')) ?></h4>
                        <?php if ($style === 'card' && !empty($badge['description'])): ?>
                            <p class="badge-description"><?= $esc((string)$badge['description']) ?></p>
                        <?php endif; ?>
                    </div>
                <?php else: ?>
                    <span class="w-visually-hidden"><?= $esc((string)($badge['title'] ?? '')) ?></span>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</section>

<style>
.<?= $wc ?> {
    padding: var(--weline-space-8) 0;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .badges-heading {
    font-size: var(--weline-font-size-lg);
    font-weight: 600;
    margin: 0 0 var(--weline-space-5);
    text-align: center;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .badges-grid {
    display: grid;
    gap: var(--weline-space-5);
}

.<?= $wc ?> .badges-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?> .badges-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?> .badges-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }

.<?= $wc ?>.style-icon-only .badge-item {
    display: flex;
    justify-content: center;
}

.<?= $wc ?>.style-icon-only .badge-icon {
    width: var(--spacing-15);
    height: var(--spacing-15);
    background: var(--weline-theme-surface-muted);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--weline-theme-primary);
}

.<?= $wc ?>.style-icon-text .badge-item {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
}

.<?= $wc ?>.style-icon-text .badge-icon {
    width: var(--size-control-50);
    height: var(--size-control-50);
    background: var(--weline-theme-primary);
    border-radius: var(--weline-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--weline-theme-on-primary);
}

.<?= $wc ?>.style-icon-text .badge-title {
    margin: 0;
    font-size: var(--weline-font-size-sm);
    font-weight: 600;
    color: var(--weline-theme-text);
}

.<?= $wc ?>.style-card .badge-item {
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-xl);
    padding: var(--weline-space-6);
    text-align: center;
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    box-shadow: var(--weline-theme-shadow-sm);
    transition: all var(--weline-theme-transition-base);
}

.<?= $wc ?>.style-card .badge-item:hover {
    box-shadow: var(--weline-theme-shadow-md);
    transform: translateY(var(--spacing-neg-1_5));
}

.<?= $wc ?>.style-card .badge-icon {
    width: var(--layout-header-height);
    height: var(--layout-header-height);
    background: var(--weline-theme-primary-surface);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--weline-space-4);
    color: var(--weline-theme-primary);
}

.<?= $wc ?>.style-card .badge-title {
    margin: 0 0 var(--weline-space-2);
    font-size: var(--weline-font-size-base);
    font-weight: 600;
}

.<?= $wc ?>.style-card .badge-description {
    margin: 0;
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-4) 0;
}

@media (max-width: 768px) {
    .<?= $wc ?> .badges-grid {
        grid-template-columns: repeat(2, 1fr) !important;
    }
}

@media (max-width: 480px) {
    .<?= $wc ?> .badges-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>
