<?php
/**
 * 信任徽章部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {trust-badges}
 * @widget.name {信任徽章}
 * @widget.description {展示安全支付、退款保障等信任标识}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-footer-above","layout-homepage-trust","layout-cart-trust","layout-checkout-trust","layout-contact-help","layout-contact-methods","layout-contact-content","layout-default-content"]}
 * @widget.compatible {true}
 *
 * @param title {default="",type="string",label="标题"}
 * @param badges {default=[],type="array",label="自定义徽章"}
 * @param preset_badges {default=["secure-payment","money-back","free-shipping","24-7-support"],type="array",label="预设徽章"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param style {default="icon-text",type="select",label="样式",options={icon-text:"图标+文字",icon-only:"仅图标",card:"卡片"}}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('trust-badges');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = WidgetI18n::label(trim((string)($this->getData('title') ?? '')));
$badges = $this->getData('badges') ?? [];
$presetBadges = $this->getData('preset_badges') ?? ['secure-payment', 'money-back', 'free-shipping', '24-7-support'];
$columns = (string)($this->getData('columns') ?? '4');
$style = (string)($this->getData('style') ?? 'icon-text');

if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '4';
}
if (!in_array($style, ['icon-text', 'icon-only', 'card'], true)) {
    $style = 'icon-text';
}

$presetConfig = [
    'secure-payment' => ['icon' => 'coin', 'title' => '安全支付', 'description' => 'SSL加密保护'],
    'money-back'     => ['icon' => 'shield', 'title' => '无忧退款', 'description' => '30天无理由退货'],
    'free-shipping'  => ['icon' => 'box', 'title' => '免费配送', 'description' => '满额包邮'],
    '24-7-support'   => ['icon' => 'message', 'title' => '全天候客服', 'description' => '7×24小时在线'],
    'ssl-secure'     => ['icon' => 'lock', 'title' => 'SSL安全', 'description' => '数据加密传输'],
    'verified-seller'=> ['icon' => 'seal', 'title' => '认证商家', 'description' => '正品保证'],
];

$allBadges = [];
if (is_array($presetBadges)) {
    foreach ($presetBadges as $preset) {
        if (isset($presetConfig[$preset])) {
            $allBadges[] = $presetConfig[$preset];
        }
    }
}
if (is_array($badges)) {
    $allBadges = array_merge($allBadges, $badges);
}
foreach ($allBadges as &$badge) {
    if (!is_array($badge)) {
        continue;
    }
    $badge['title'] = WidgetI18n::label(trim((string)($badge['title'] ?? '')));
    if (isset($badge['description'])) {
        $badge['description'] = WidgetI18n::label(trim((string)$badge['description']));
    }
}
unset($badge);
?>

<section class="<?= $esc($wc) ?> style-<?= $esc($style) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">

    <div class="badges-inner">
        <?php if ($title !== ''): ?>
            <h3 class="badges-heading"><?= $esc($title) ?></h3>
        <?php endif; ?>

        <div class="badges-grid columns-<?= $esc($columns) ?>">
            <?php foreach ($allBadges as $badge): ?>
                <div class="badge-item">
                        <div class="badge-icon" aria-hidden="true">
                        <?php
                        $badgeIcon = trim((string)($badge['icon'] ?? 'check'));
                        if ($badgeIcon === '' || preg_match('/^[a-z0-9][a-z0-9_-]*$/i', $badgeIcon) !== 1) {
                            $badgeIcon = 'check';
                        }
                        ?>
                        <w:icon name="<?= $esc($badgeIcon) ?>" size="md"></w:icon>
                    </div>

                    <?php if ($style !== 'icon-only'): ?>
                        <div class="badge-content">
                            <h4 class="badge-title"><?= $esc((string)($badge['title'] ?? '')) ?></h4>
                            <?php if ($style === 'card' && !empty($badge['description'])): ?>
                                <p class="badge-description"><?= $esc((string)$badge['description']) ?></p>
                            <?php endif; ?>
                        </div>
                    <?php else: ?>
                        <span class="w-visually-hidden"><?= $esc((string)($badge['title'] ?? '')) ?></span>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
</section>

