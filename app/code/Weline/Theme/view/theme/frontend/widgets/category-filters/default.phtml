<?php
/**
 * 部件模板：分类页左侧筛选（Category Filters）
 *
 * @widget.code {category-filters}
 * @widget.name {分类筛选}
 * @widget.description {分类页左侧筛选器，支持价格、品牌、属性筛选}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["category", "search"]}
 * @widget.supports {["layout-category-filters","layout-product-list-filters"]}
 *
 * @param html {default="",type="textarea",label="筛选 HTML",description="业务渲染的筛选结构，留空则使用 Hook 或 Mock"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-filters');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$meta = $this->getData('meta') ?? [];
$filtersHtml = $this->getData('html') ?? ($meta['filters'] ?? '');
$hasExternalHtml = is_string($filtersHtml) && trim($filtersHtml) !== '';

if ($hasExternalHtml) {
    ?>
<section class="<?= $esc($wc) ?> has-external<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="filters-body"><?= $filtersHtml ?></div>
</section>
<style>
.<?= $wc ?> {
    color: var(--weline-theme-text);
}
.<?= $wc ?> .filters-body {
    width: 100%;
}
</style>
    <?php
    return;
}

$hookContent = $this->getHook('Weline_Theme::frontend::layouts::category::filters-sidebar', true);

if (is_string($hookContent) && trim($hookContent) !== '') {
    ?>
<section class="<?= $esc($wc) ?> has-hook<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="filters-body"><?= $hookContent ?></div>
</section>
<style>
.<?= $wc ?> {
    color: var(--weline-theme-text);
}
.<?= $wc ?> .filters-body {
    width: 100%;
}
</style>
    <?php
    return;
}
?>

<?php if (!$isPreviewMode): ?>
<section class="<?= $esc($wc) ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <p class="filters-empty"><?= __('暂无可用筛选条件') ?></p>
</section>
<style>
.<?= $wc ?> .filters-empty {
    margin: 0;
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-sm);
}
</style>
<?php
    return;
}
?>

<section class="<?= $esc($wc) ?> is-preview"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">

    <div class="filter-panel">
        <div class="filter-header">
            <div class="filter-title"><?= __('筛选条件') ?></div>
            <button type="button" class="filter-clear"><?= __('清除全部') ?></button>
        </div>

        <div class="filter-group">
            <div class="filter-group-title"><?= __('价格区间') ?></div>
            <ul class="filter-list">
                <li><a href="#" class="filter-item"><span class="label"><?= __('0 - 99 元') ?></span><span class="count">128</span></a></li>
                <li><a href="#" class="filter-item"><span class="label"><?= __('100 - 299 元') ?></span><span class="count">86</span></a></li>
                <li><a href="#" class="filter-item"><span class="label"><?= __('300 元以上') ?></span><span class="count">42</span></a></li>
            </ul>
        </div>
    </div>
</section>

<style>
.<?= $wc ?> {
    color: var(--weline-theme-text);
}

.<?= $wc ?> .filter-panel {
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg);
    padding: var(--weline-space-5);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?> .filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--weline-space-4);
    padding-bottom: var(--weline-space-4);
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?> .filter-title {
    font-size: var(--weline-font-size-base);
    font-weight: 600;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .filter-clear {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-primary);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: var(--spacing-0_5);
}

.<?= $wc ?> .filter-group {
    margin-bottom: var(--weline-space-5);
}

.<?= $wc ?> .filter-group:last-child {
    margin-bottom: 0;
}

.<?= $wc ?> .filter-group-title {
    font-size: var(--weline-font-size-sm);
    font-weight: 600;
    margin-bottom: var(--weline-space-3);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .filter-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?> .filter-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--weline-space-3);
    padding: var(--weline-space-2) 0;
    color: var(--weline-theme-text-muted);
    text-decoration: none;
    font-size: var(--weline-font-size-sm);
    transition: color var(--weline-theme-transition-base);
}

.<?= $wc ?> .filter-item:hover {
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .filter-item .count {
    color: var(--weline-theme-text-muted);
    font-size: var(--weline-font-size-xs);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--size-panel-120);
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    root.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var action = target.closest('.filter-clear, .filter-item');
        if (!action || !root.contains(action)) return;

        event.preventDefault();
    });
})();
</script>
