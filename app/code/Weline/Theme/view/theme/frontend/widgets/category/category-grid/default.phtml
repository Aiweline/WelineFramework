<?php
/**
 * 分类网格部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {category-grid}
 * @widget.name {分类网格}
 * @widget.description {以网格形式展示商品分类}
 * @widget.type {category}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-categories","layout-homepage-content","layout-category-children","layout-category-recommendations","layout-cms-content","layout-default-content"]}
 *
 * @param title {default="热门分类",type="string",label="标题"}
 * @param subtitle {default="浏览我们的商品分类",type="string",label="副标题"}
 * @param category_ids {default="",type="string",label="指定分类ID",description="逗号分隔，留空自动获取"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param show_count {default=true,type="bool",label="显示产品数量"}
 * @param image_ratio {default="square",type="select",label="图片比例",options={square:"正方形",portrait:"竖向",landscape:"横向"}}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-grid');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
if (preg_match('#/([a-z]{2}(?:_[A-Za-z]{2,4}){1,2})(?:/|$)#', $requestUri, $localeMatch) === 1) {
    $currentLocale = (string)$localeMatch[1];
}
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    $translated = trim(WidgetI18n::label($source));
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};

$titleSource = trim((string)($this->getData('title') ?? ''));
$subtitleSource = trim((string)($this->getData('subtitle') ?? ''));
$title = in_array($titleSource, ['', '热门分类', '按汉服品类选购'], true)
    ? $translateDefaultCopy('按汉服品类选购', 'Shop Hanfu by Category')
    : WidgetI18n::label($titleSource);
$subtitle = in_array($subtitleSource, ['', '浏览我们的商品分类', '从准确形制开始选择'], true)
    ? $translateDefaultCopy('从准确形制开始选择', 'Start with the garment form that matches your needs')
    : WidgetI18n::label($subtitleSource);
$categoryIds = (string)($this->getData('category_ids') ?? '');
$limit = max(1, min(5, (int)($this->getData('limit') ?? 5)));
$columns = (string)($this->getData('columns') ?? '5');
$showCount = (bool)($this->getData('show_count') ?? false);
$imageRatio = (string)($this->getData('image_ratio') ?? 'square');

if (!in_array($columns, ['2', '3', '4', '5', '6'], true)) {
    $columns = '5';
}

$ratioMap = [
    'square'    => '100%',
    'landscape' => '56.25%',
    'portrait'  => '133.33%',
];
$paddingTop = $ratioMap[$imageRatio] ?? '100%';

$categoryNames = [
    [
        'id' => 164,
        'code' => 'women',
        'name_zh' => '女装',
        'name_en' => "Women's Hanfu",
        'alt_zh' => '女装汉服分类图，展示女性汉服的裙装层次',
        'alt_en' => "Women's Hanfu category image showing layered skirt silhouettes",
    ],
    [
        'id' => 175,
        'code' => 'men',
        'name_zh' => '男装',
        'name_en' => "Men's Hanfu",
        'alt_zh' => '男装汉服分类图，展示男性袍衫轮廓',
        'alt_en' => "Men's Hanfu category image showing robe silhouettes",
    ],
    [
        'id' => 180,
        'code' => 'kids',
        'name_zh' => '童装',
        'name_en' => "Children's Hanfu",
        'alt_zh' => '童装汉服分类图，展示儿童尺度汉服',
        'alt_en' => "Children's Hanfu category image showing child-proportioned garments",
    ],
    [
        'id' => 183,
        'code' => 'accessories',
        'name_zh' => '配饰',
        'name_en' => 'Accessories',
        'alt_zh' => '汉服配饰分类图，展示头饰、佩饰与鞋履',
        'alt_en' => 'Hanfu accessories category image showing headwear, pendants, and footwear',
    ],
    [
        'id' => 188,
        'code' => 'sets',
        'name_zh' => '套装与场景',
        'name_en' => 'Sets & Occasions',
        'alt_zh' => '汉服套装分类图，展示完整上下装搭配',
        'alt_en' => 'Hanfu sets category image showing a complete coordinated outfit',
    ],
];
$categories = [];
foreach (array_slice($categoryNames, 0, $limit) as $category) {
    $code = (string)$category['code'];
    $categories[] = [
        'id' => (int)$category['id'],
        'name' => $translateDefaultCopy($category['name_zh'], $category['name_en']),
        'alt' => $translateDefaultCopy($category['alt_zh'], $category['alt_en']),
        'url' => '/category/' . $code,
        'image' => '/pub/media/catalog/hanfu/r2/categories/icons/' . $code . '.webp',
        'count' => 0,
    ];
}
$rootStyle = '--wc-category-ratio:' . $paddingTop . ';';
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">

    <?php if ($title !== '' || $subtitle !== ''): ?>
        <div class="grid-header">
            <?php if ($title !== ''): ?>
                <h2 class="grid-title"><?= $esc($title) ?></h2>
            <?php endif; ?>
            <?php if ($subtitle !== ''): ?>
                <p class="grid-subtitle"><?= $esc($subtitle) ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <div class="category-grid columns-<?= $esc($columns) ?>">
        <?php foreach ($categories as $category): ?>
            <?php
            $categoryImage = trim((string)($category['image'] ?? ''));
            $categoryImageIsBanner = str_contains($categoryImage, '/banners/');
            $categoryImageWidth = $categoryImageIsBanner ? 1500 : 800;
            $categoryImageHeight = $categoryImageIsBanner ? 300 : 800;
            ?>
            <a href="<?= $esc(\Weline\Theme\Helper\HeaderNavFragment::localizeHref((string)($category['url'] ?? '#'))) ?>" class="category-card">
                <div class="category-image-wrapper">
                    <img src="<?= $esc($categoryImage) ?>"
                         alt="<?= $esc((string)($category['alt'] ?? $category['name'] ?? '')) ?>"
                         class="category-image"
                         width="<?= (int)$categoryImageWidth ?>"
                         height="<?= (int)$categoryImageHeight ?>"
                         loading="lazy"
                         decoding="async">
                    <div class="category-overlay"></div>
                </div>

                <div class="category-info">
                    <h3 class="category-name"><?= $esc((string)($category['name'] ?? '')) ?></h3>
                    <?php if ($showCount && (int)($category['count'] ?? 0) > 0): ?>
                        <span class="category-count"><?= (int)($category['count'] ?? 0) ?> <?= __('件商品') ?></span>
                    <?php endif; ?>
                </div>
            </a>
        <?php endforeach; ?>
    </div>
</section>

<style>
.<?= $wc ?> {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-block: var(--weline-space-8);
    padding-inline: 0;
    box-sizing: border-box;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .grid-header {
    text-align: center;
    margin-bottom: var(--weline-space-8);
}

.<?= $wc ?> .grid-title {
    font-size: var(--weline-font-size-3xl);
    font-weight: 700;
    margin: 0 0 var(--weline-space-3);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .grid-subtitle {
    font-size: var(--weline-font-size-base);
    color: var(--weline-theme-text-muted);
    margin: 0;
}

.<?= $wc ?> .category-grid {
    display: grid;
    gap: var(--weline-space-5);
}

.<?= $wc ?> .category-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?> .category-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?> .category-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.<?= $wc ?> .category-grid.columns-5 { grid-template-columns: repeat(5, 1fr); }
.<?= $wc ?> .category-grid.columns-6 { grid-template-columns: repeat(6, 1fr); }

.<?= $wc ?> .category-card {
    display: block;
    text-decoration: none;
    border-radius: var(--weline-radius-xl);
    overflow: hidden;
    background: var(--weline-theme-surface-raised);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    box-shadow: var(--weline-theme-shadow-sm);
    transition: all var(--weline-theme-transition-base);
    color: inherit;
}

.<?= $wc ?> .category-card:hover {
    box-shadow: var(--weline-theme-shadow-md);
    transform: translateY(var(--token-size-5px));
}

.<?= $wc ?> .category-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: var(--wc-category-ratio);
}

.<?= $wc ?> .category-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--weline-theme-transition-slow);
}

.<?= $wc ?> .category-card:hover .category-image {
    transform: scale(1.1);
}

.<?= $wc ?> .category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--weline-theme-overlay) 40%, transparent) 100%
    );
    opacity: 0;
    transition: opacity var(--weline-theme-transition-base);
}

.<?= $wc ?> .category-card:hover .category-overlay {
    opacity: 1;
}

.<?= $wc ?> .category-info {
    padding: var(--weline-space-4);
    text-align: center;
}

.<?= $wc ?> .category-name {
    margin: 0 0 var(--weline-space-1);
    font-size: var(--weline-font-size-base);
    font-weight: 600;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .category-count {
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-5) 0;
}

@media (max-width: 992px) {
    .<?= $wc ?> .category-grid.columns-5,
    .<?= $wc ?> .category-grid.columns-6 {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (max-width: 768px) {
    .<?= $wc ?> .category-grid {
        grid-template-columns: repeat(2, 1fr) !important;
    }

    .<?= $wc ?> .grid-title {
        font-size: var(--weline-font-size-xl);
    }
}
</style>
