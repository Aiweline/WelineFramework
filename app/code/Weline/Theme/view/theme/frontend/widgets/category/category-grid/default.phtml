<?php
/**
 * 分类网格部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {category-grid}
 * @widget.name {分类网格}
 * @widget.description {以网格形式展示商品分类}
 * @widget.type {category}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-categories","layout-homepage-content","layout-category-children","layout-category-recommendations","layout-cms-content","layout-default-content"]}
 *
 * @param title {default="热门分类",type="string",label="标题"}
 * @param subtitle {default="浏览我们的商品分类",type="string",label="副标题"}
 * @param category_ids {default="",type="string",label="指定分类ID",description="逗号分隔，留空自动获取"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param show_count {default=true,type="bool",label="显示产品数量"}
 * @param image_ratio {default="square",type="select",label="图片比例",options={square:"正方形",portrait:"竖向",landscape:"横向"}}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-grid');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '热门分类';
$subtitleSource = trim((string)($this->getData('subtitle') ?? '')) ?: '浏览我们的商品分类';
$title = WidgetI18n::label($titleSource, '热门分类');
$subtitle = WidgetI18n::label($subtitleSource, '浏览我们的商品分类');
$categoryIds = (string)($this->getData('category_ids') ?? '');
$limit = max(1, min(24, (int)($this->getData('limit') ?? 8)));
$columns = (string)($this->getData('columns') ?? '4');
$showCount = (bool)($this->getData('show_count') ?? true);
$imageRatio = (string)($this->getData('image_ratio') ?? 'square');

if (!in_array($columns, ['2', '3', '4', '5', '6'], true)) {
    $columns = '4';
}

$ratioMap = [
    'square'    => '100%',
    'landscape' => '56.25%',
    'portrait'  => '133.33%',
];
$paddingTop = $ratioMap[$imageRatio] ?? '100%';

$categoryNames = [
    ['id' => 1, 'name' => '电子产品', 'url' => '/category/electronics', 'count' => 156],
    ['id' => 2, 'name' => '服装鞋帽', 'url' => '/category/fashion', 'count' => 243],
    ['id' => 3, 'name' => '家居生活', 'url' => '/category/home', 'count' => 178],
    ['id' => 4, 'name' => '美妆个护', 'url' => '/category/beauty', 'count' => 134],
    ['id' => 5, 'name' => '食品生鲜', 'url' => '/category/food', 'count' => 89],
    ['id' => 6, 'name' => '母婴用品', 'url' => '/category/baby', 'count' => 67],
    ['id' => 7, 'name' => '运动户外', 'url' => '/category/sports', 'count' => 112],
    ['id' => 8, 'name' => '图书文具', 'url' => '/category/books', 'count' => 78],
];
$categories = [];
foreach (array_slice($categoryNames, 0, $limit) as $index => $category) {
    $categories[] = $category + ['image' => ThemeDemoCatalog::productImage($index + 10)];
}
$rootStyle = '--wc-category-ratio:' . $paddingTop . ';';
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">

    <?php if ($title !== '' || $subtitle !== ''): ?>
        <div class="grid-header">
            <?php if ($title !== ''): ?>
                <h2 class="grid-title"><?= $esc($title) ?></h2>
            <?php endif; ?>
            <?php if ($subtitle !== ''): ?>
                <p class="grid-subtitle"><?= $esc($subtitle) ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <div class="category-grid columns-<?= $esc($columns) ?>">
        <?php foreach ($categories as $category): ?>
            <a href="<?= $esc((string)($category['url'] ?? '#')) ?>" class="category-card">
                <div class="category-image-wrapper">
                    <img src="<?= $esc((string)($category['image'] ?? '')) ?>"
                         alt="<?= $esc((string)($category['name'] ?? '')) ?>"
                         class="category-image"
                         loading="lazy">
                    <div class="category-overlay"></div>
                </div>

                <div class="category-info">
                    <h3 class="category-name"><?= $esc((string)($category['name'] ?? '')) ?></h3>
                    <?php if ($showCount): ?>
                        <span class="category-count"><?= (int)($category['count'] ?? 0) ?> <?= __('件商品') ?></span>
                    <?php endif; ?>
                </div>
            </a>
        <?php endforeach; ?>
    </div>
</section>

<style>
.<?= $wc ?> {
    padding: var(--weline-space-10) 0;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .grid-header {
    text-align: center;
    margin-bottom: var(--weline-space-8);
}

.<?= $wc ?> .grid-title {
    font-size: var(--weline-font-size-3xl);
    font-weight: 700;
    margin: 0 0 var(--weline-space-3);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .grid-subtitle {
    font-size: var(--weline-font-size-base);
    color: var(--weline-theme-text-muted);
    margin: 0;
}

.<?= $wc ?> .category-grid {
    display: grid;
    gap: var(--weline-space-5);
}

.<?= $wc ?> .category-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?> .category-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?> .category-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.<?= $wc ?> .category-grid.columns-5 { grid-template-columns: repeat(5, 1fr); }
.<?= $wc ?> .category-grid.columns-6 { grid-template-columns: repeat(6, 1fr); }

.<?= $wc ?> .category-card {
    display: block;
    text-decoration: none;
    border-radius: var(--weline-radius-xl);
    overflow: hidden;
    background: var(--weline-theme-surface-raised);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    box-shadow: var(--weline-theme-shadow-sm);
    transition: all var(--weline-theme-transition-base);
    color: inherit;
}

.<?= $wc ?> .category-card:hover {
    box-shadow: var(--weline-theme-shadow-md);
    transform: translateY(var(--token-size-5px));
}

.<?= $wc ?> .category-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: var(--wc-category-ratio);
}

.<?= $wc ?> .category-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--weline-theme-transition-slow);
}

.<?= $wc ?> .category-card:hover .category-image {
    transform: scale(1.1);
}

.<?= $wc ?> .category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--weline-theme-overlay) 40%, transparent) 100%
    );
    opacity: 0;
    transition: opacity var(--weline-theme-transition-base);
}

.<?= $wc ?> .category-card:hover .category-overlay {
    opacity: 1;
}

.<?= $wc ?> .category-info {
    padding: var(--weline-space-4);
    text-align: center;
}

.<?= $wc ?> .category-name {
    margin: 0 0 var(--weline-space-1);
    font-size: var(--weline-font-size-base);
    font-weight: 600;
    color: var(--weline-theme-text);
}

.<?= $wc ?> .category-count {
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-5) 0;
}

@media (max-width: 992px) {
    .<?= $wc ?> .category-grid.columns-5,
    .<?= $wc ?> .category-grid.columns-6 {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (max-width: 768px) {
    .<?= $wc ?> .category-grid {
        grid-template-columns: repeat(2, 1fr) !important;
    }

    .<?= $wc ?> .grid-title {
        font-size: var(--weline-font-size-xl);
    }
}
</style>
