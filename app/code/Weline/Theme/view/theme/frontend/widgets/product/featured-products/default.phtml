<script>
(function() {
    const root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;
    
    const layout = '<?= $layout ?>';
    
    if (layout === 'carousel') {
        const wrapper = root.querySelector('.products-grid');
        const prevBtn = root.querySelector('.carousel-prev');
        const nextBtn = root.querySelector('.carousel-next');
        
        if (!wrapper || !prevBtn || !nextBtn) return;
        
        const cards = wrapper.querySelectorAll('.product-card');
        const cardWidth = cards[0]?.offsetWidth || 0;
        const gap = 20;
        let currentPosition = 0;
        const maxPosition = Math.max(0, (cards.length - 4) * (cardWidth + gap));
        
        function updatePosition() {
            wrapper.style.transform = 'translateX(-' + currentPosition + 'px)';
        }
        
        prevBtn.addEventListener('click', function() {
            currentPosition = Math.max(0, currentPosition - (cardWidth + gap));
            updatePosition();
        });
        
        nextBtn.addEventListener('click', function() {
            currentPosition = Math.min(maxPosition, currentPosition + (cardWidth + gap));
            updatePosition();
        });
    }
    
    // 加入购物车功能
    root.querySelectorAll('.btn-add-to-cart').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const productId = this.dataset.productId;
            // 这里应该调用实际的加购API
            return;
            
            // 显示添加动画
            this.innerHTML = '<w:icon name="check" size="sm"></w:icon> <span><?= __('已添加') ?></span>';
            this.style.background = 'var(--weline-theme-success)';
            
            setTimeout(() => {
                this.innerHTML = '<w:icon name="pin" size="sm"></w:icon> <span><?= __('加入购物车') ?></span>';
                this.style.background = '';
            }, 2000);
        });
    });
    function updateCartCountFromFeaturedProducts(count) {
        document.querySelectorAll('.cart-count, [data-cart-count]').forEach(function(el) {
            el.textContent = count;
            el.style.display = count > 0 ? '' : 'none';
        });
    }

    let featuredCartApiPromise = null;

    function getFeaturedCartApi() {
        if (!featuredCartApiPromise) {
            featuredCartApiPromise = Promise.resolve(window.Weline.Api.resource('cart'));
        }

        return featuredCartApiPromise;
    }

    function postFeaturedProductAddToCart(productId, done) {
        getFeaturedCartApi().then(function (CartApi) {
            return CartApi.add({product_id: parseInt(productId, 10), qty: 1}, {silent: true});
        }).then(function (response) {
            const payload = response && response.data ? response.data : (response || {});
            done(!!payload.success, payload);
        }).catch(function (error) {
            console.error('[WeShop Featured] add-to-cart exception', error);
            done(false, { message: error && error.message ? error.message : String(error) });
        });
    }

    root.querySelectorAll('.btn-add-to-cart').forEach(function(btn) {
        if (btn.closest('form.product-add-to-cart-form')) {
            return;
        }
        if (btn.dataset.weshopFeaturedAddBound === '1') {
            return;
        }
        btn.dataset.weshopFeaturedAddBound = '1';
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();

            const productId = this.dataset.productId;
            console.log('[WeShop Featured] add-to-cart click', productId);
            postFeaturedProductAddToCart(productId, (success, payload) => {
                if (success) {
                    updateCartCountFromFeaturedProducts(parseInt(payload.cart_count || 0, 10));
                    document.dispatchEvent(new CustomEvent('weshop:cart:added', { detail: payload }));
                } else {
                    document.dispatchEvent(new CustomEvent('weshop:cart:error', { detail: payload }));
                }
            });
        });
    });
})();
</script>
