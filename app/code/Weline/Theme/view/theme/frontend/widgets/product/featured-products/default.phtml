<?php
/**
 * 推荐产品部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {featured-products}
 * @widget.name {推荐产品}
 * @widget.description {展示精选推荐产品，支持网格和轮播布局}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page", "category"]}
 * @widget.supports {["layout-homepage-featured","layout-homepage-content","layout-product-list-recommendations","layout-category-recommendations","layout-cms-content","layout-default-content"]}
 *
 * @param title {default="推荐产品",type="string",label="标题"}
 * @param subtitle {default="为您精选的优质商品",type="string",label="副标题"}
 * @param product_ids {default="",type="string",label="产品ID",description="指定产品ID，逗号分隔"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param show_price {default=true,type="bool",label="显示价格"}
 * @param show_rating {default=true,type="bool",label="显示评分"}
 * @param show_add_to_cart {default=true,type="bool",label="显示加购按钮"}
 * @param layout {default="grid",type="select",label="布局方式",options={grid:"网格",carousel:"轮播"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */


use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\StorefrontProductWidgetCatalog;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\ProductCardAddToCartParams;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductCardUrl;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('featured-products');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$normalize = static function ($value, string $default = ''): string {
    if (is_string($value) || is_numeric($value)) {
        return (string)$value;
    }
    return $default;
};

$title = WidgetI18n::label($normalize($this->getData('title')), '推荐产品');
$subtitle = WidgetI18n::label($normalize($this->getData('subtitle')), '为您精选的优质商品');
$productIds = $normalize($this->getData('product_ids'), '');
$limit = (int)($this->getData('limit') ?? 8);
$columns = $normalize($this->getData('columns'), '4');
$showPrice = (bool)($this->getData('show_price') ?? true);
$showRating = (bool)($this->getData('show_rating') ?? true);
$showAddToCart = (bool)($this->getData('show_add_to_cart') ?? true);
$layout = $normalize($this->getData('layout'), 'grid');
$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);

$products = [];
try {
    if (class_exists(StorefrontProductWidgetCatalog::class)) {
        $products = ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)->cards($limit);
    }
} catch (\Throwable) {
    $products = [];
}

if ($products === [] && $isPreviewMode) {
    foreach (ThemeDemoCatalog::products($limit, 30) as $index => $demo) {
        $products[] = [
            'id' => $demo['id'],
            'product_id' => $demo['id'],
            'name' => $demo['name'],
            'url' => $demo['url'],
            'image' => $demo['image'],
            'price' => $demo['price'],
            'original_price' => $demo['original_price'],
            'rating' => $demo['rating'],
            'review_count' => $demo['review_count'],
            'is_new' => $index % 3 === 0 ? 1 : 0,
            'is_sale' => $index % 4 === 0 ? 1 : 0,
            'is_demo' => 1,
            'stock' => 20 + ($index * 11),
        ];
    }
}

if ($products === []) {
    // Never return a blank string: DEV WidgetHtmlHealthInspector treats empty
    // HTML as a warning toast. Keep visually hidden so storefront still "hides".
    ?>
<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="featured-products-empty"
         hidden
         aria-hidden="true"></section>
    <?php
    return;
}

foreach ($products as $index => &$product) {
    $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
    $product['id'] = $productId;
    $product['product_id'] = $productId;
    $route = trim((string)($product['url'] ?? ''));
    $productLink = ProductCardUrl::splitForTaglib($route);
    $product['url'] = $productLink['url'];
    $product['url_path'] = $productLink['url_path'];
    if ($isPreviewMode && !empty($product['is_demo']) && !isset($product['stock'])) {
        $product['stock'] = 20 + ($index * 11);
    }
}
unset($product);

?>

<link rel="stylesheet"
      href="@static(Weline_Theme::css/widgets/amazon-product-card.css)&amp;v=20260828-amz-actions1"
      data-no-extract="true">

<section class="<?= $esc($wc) ?> weline-amz-card-widget<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"<?= $scopeLabelStyle !== '' ? ' style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?php if ($title || $subtitle): ?>
        <div class="widget-header">
            <?php if ($title): ?>
                <h2 class="widget-title"><?= htmlspecialchars($title) ?></h2>
            <?php endif; ?>
            <?php if ($subtitle): ?>
                <p class="widget-subtitle"><?= htmlspecialchars($subtitle) ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>
    
    <div class="products-container layout-<?= htmlspecialchars($layout) ?>" 
         data-columns="<?= htmlspecialchars($columns) ?>">
        
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-prev" type="button">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>
        
        <div class="products-wrapper">
            <div class="products-grid columns-<?= htmlspecialchars($columns) ?>">
                <?php foreach ($products as $index => $product): ?>
                    <?php $actionProductId = (int)($product['id'] ?? $product['product_id'] ?? 0); ?>
                    <?php $labelFlags = ProductLabelStyle::resolveFlags($product, $index); ?>
                    <article class="product-card" data-product-id="<?= $actionProductId ?>">
                        <div class="product-image-wrapper">
                            <a href="<?php if (!empty($product['url'])): ?><?= htmlspecialchars((string)$product['url'], ENT_QUOTES, 'UTF-8') ?><?php else: ?>@url{$product['url_path']}<?php endif; ?>" class="product-image-link">
                                <img src="<?= htmlspecialchars($product['image'] ?? '') ?>" 
                                     alt="<?= htmlspecialchars($product['name'] ?? '') ?>"
                                     class="product-image"
                                     loading="lazy">
                            </a>
                            
                            <!-- 标签 -->
                            <?php if ($labelFlags['is_demo'] || $labelFlags['is_new'] || $labelFlags['is_sale']): ?>
                                <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/labels.phtml', [
                                    'is_demo' => $labelFlags['is_demo'],
                                    'is_new' => $labelFlags['is_new'],
                                    'is_sale' => $labelFlags['is_sale'],
                                ]) ?>
                            <?php endif; ?>
                            
                            <?= $this->fetch('Weline_Theme::theme/frontend/partials/product/shopper-actions.phtml', [
                                'product_id' => $actionProductId,
                                'show_wishlist' => $shopperActions['show_wishlist'],
                                'show_compare' => $shopperActions['show_compare'],
                                'show_quickview' => $shopperActions['show_quickview'],
                                'wishlist_pixel' => true,
                            ]) ?>
                        </div>
                        
                        <div class="product-info">
                            <h3 class="product-name">
                                <a href="<?php if (!empty($product['url'])): ?><?= htmlspecialchars((string)$product['url'], ENT_QUOTES, 'UTF-8') ?><?php else: ?>@url{$product['url_path']}<?php endif; ?>">
                                    <?= htmlspecialchars($product['name'] ?? '') ?>
                                </a>
                            </h3>
                            
                            <div class="product-meta">
                                <?php if ($showRating): ?>
                                    <div class="product-rating">
                                        <div class="stars" aria-label="<?= number_format((float)$product['rating'], 1) ?>">
                                            <?php for ($s = 1; $s <= 5; $s++): ?>
                                                <span class="w-rating-star" data-state="<?= $s <= floor((float)$product['rating']) ? 'filled' : 'empty' ?>"><w:icon name="star" size="sm"></w:icon></span>
                                            <?php endfor; ?>
                                        </div>
                                        <span class="review-count">(<?= (int)$product['review_count'] ?>)</span>
                                    </div>
                                <?php endif; ?>
                            </div>

                            <?php if ($showPrice): ?>
                                <div class="product-price">
                                    <span class="price-current weline-pixel::add_to_cart:value" data-pixel-value="<?= htmlspecialchars((string)(float)$product['price'], ENT_QUOTES, 'UTF-8') ?>">¥<?= number_format($product['price'], 2) ?></span>
                                    <?php if ($product['original_price'] > $product['price']): ?>
                                        <span class="price-original">¥<?= number_format($product['original_price'], 2) ?></span>
                                    <?php endif; ?>
                                </div>
                            <?php endif; ?>
                            
                            <?php if ($showAddToCart): ?>
                                <div class="product-cart">
                                    <?= $this->fetch(
                                        'Weline_Theme::theme/frontend/partials/product/add-to-cart.phtml',
                                        ProductCardAddToCartParams::fetchDictionary($product)
                                    ) ?>
                                </div>
                            <?php endif; ?>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>
        </div>
        
        <?php if ($layout === 'carousel'): ?>
            <button class="carousel-arrow carousel-next" type="button">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
    </div>
</section>

<style>
/* 部件容器 */
.<?= $wc ?> {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-block: var(--weline-space-8);
    padding-inline: 0;
    box-sizing: border-box;
}

.<?= $wc ?> .widget-header {
    text-align: center;
    margin-bottom: var(--weline-space-8);
}

.<?= $wc ?> .widget-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    margin: 0 0 var(--spacing-2_5);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .widget-subtitle {
    font-size: var(--font-size-base);
    color: var(--weline-theme-text-muted);
    margin: 0;
}

.<?= $wc ?> .products-container {
    position: relative;
}

.<?= $wc ?> .products-wrapper {
    overflow: hidden;
}

.<?= $wc ?> .products-grid {
    display: grid;
    gap: var(--weline-space-5);
}

.<?= $wc ?> .products-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.<?= $wc ?> .products-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.<?= $wc ?> .products-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.<?= $wc ?> .products-grid.columns-5 { grid-template-columns: repeat(5, 1fr); }
.<?= $wc ?> .products-grid.columns-6 { grid-template-columns: repeat(6, 1fr); }

.<?= $wc ?> .layout-carousel .products-grid {
    display: flex;
    gap: var(--weline-space-5);
    transition: transform 0.3s ease;
}

.<?= $wc ?> .layout-carousel .product-card {
    flex: 0 0 auto;
    width: calc((100% - var(--spacing-15)) / 4);
}

.<?= $wc ?> .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--size-control-lg);
    height: var(--size-control-lg);
    background: var(--weline-theme-surface-raised);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 var(--spacing-xs) var(--spacing-3_5) var(--token-color-rgba-0-0-0-0-15);
    z-index: 10;
    transition: all 0.3s;
}

.<?= $wc ?> .carousel-arrow:hover {
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
}

.<?= $wc ?> .carousel-prev { left: var(--token-size-22px); }
.<?= $wc ?> .carousel-next { right: var(--token-size-22px); }

.<?= $wc ?> .product-card-purchase-actions {
    display: grid;
    gap: 6px;
    width: 100%;
}
.<?= $wc ?> .btn-add-to-cart,
.<?= $wc ?> .btn-buy-now {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-2);
    width: 100%;
    min-height: 2.5rem;
    border-radius: var(--weline-radius-lg);
    cursor: pointer;
    font-size: var(--font-size-sm);
    font-weight: 700;
    appearance: none;
    -webkit-appearance: none;
    box-sizing: border-box;
}
.<?= $wc ?> .btn-add-to-cart {
    border: 1px solid #fcd200;
    background: linear-gradient(180deg, #ffe08a 0%, #ffd814 100%);
    color: #0f1111;
}
.<?= $wc ?> .btn-buy-now {
    border: 1px solid #ff8f00;
    background: linear-gradient(180deg, #ffb84d 0%, #ffa41c 100%);
    color: #0f1111;
}
.<?= $wc ?> .btn-add-to-cart:hover {
    background: linear-gradient(180deg, #f7ca00 0%, #f0b800 100%);
}
.<?= $wc ?> .btn-buy-now:hover {
    background: linear-gradient(180deg, #ff9f1a 0%, #fa8900 100%);
}

@media (max-width: 1200px) {
    .<?= $wc ?> .products-grid.columns-5,
    .<?= $wc ?> .products-grid.columns-6 {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (max-width: 992px) {
    .<?= $wc ?> .products-grid.columns-4,
    .<?= $wc ?> .products-grid.columns-5,
    .<?= $wc ?> .products-grid.columns-6 {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 768px) {
    .<?= $wc ?> .products-grid {
        grid-template-columns: repeat(2, 1fr) !important;
    }

    .<?= $wc ?> .widget-title {
        font-size: var(--font-size-2_5xl);
    }

    .<?= $wc ?> .carousel-arrow {
        display: none;
    }
}
</style>

<script>
(function() {
    const root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;
    
    const layout = '<?= $layout ?>';
    
    if (layout === 'carousel') {
        const wrapper = root.querySelector('.products-grid');
        const prevBtn = root.querySelector('.carousel-prev');
        const nextBtn = root.querySelector('.carousel-next');
        
        if (!wrapper || !prevBtn || !nextBtn) return;
        
        const cards = wrapper.querySelectorAll('.product-card');
        const cardWidth = cards[0]?.offsetWidth || 0;
        const gap = 20;
        let currentPosition = 0;
        const maxPosition = Math.max(0, (cards.length - 4) * (cardWidth + gap));
        
        function updatePosition() {
            wrapper.style.transform = 'translateX(-' + currentPosition + 'px)';
        }
        
        prevBtn.addEventListener('click', function() {
            currentPosition = Math.max(0, currentPosition - (cardWidth + gap));
            updatePosition();
        });
        
        nextBtn.addEventListener('click', function() {
            currentPosition = Math.min(maxPosition, currentPosition + (cardWidth + gap));
            updatePosition();
        });
    }
})();
</script>
