<?php
/**
 * @widget.code {testimonials}
 * @widget.name {评价与引言}
 * @widget.description {展示真实评价或引言，支持网格与横向滚动}
 * @widget.type {testimonial}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 * @param title {default="评价与引言",type="string",label="标题"}
 * @param subtitle {default="",type="string",label="副标题"}
 * @param testimonials {default=[],type="testimonial_items",label="评价列表"}
 * @param columns {default="3",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列"}}
 * @param layout {default="grid",type="select",label="布局",options={grid:"网格",carousel:"横向滚动"}}
 * @param show_rating {default=true,type="bool",label="显示评分"}
 * @param show_avatar {default=true,type="bool",label="显示头像"}
 */

use Weline\Theme\Helper\SiteBlockConfig as Block;
use Weline\Theme\Helper\WidgetUiScope;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\LegacyMediaUrl;

$scope = WidgetUiScope::forWidget('testimonials');
$esc = [Block::class, 'escape'];
$t = static fn (mixed $value): string => Block::escape(WidgetI18n::label(Block::text($value)));
$title = Block::text($this->getData('title') ?? '评价与引言');
$subtitle = Block::text($this->getData('subtitle'));
$items = Block::items($this->getData('testimonials'));
$columns = Block::choice($this->getData('columns'), ['2','3','4'], '3');
$layout = Block::choice($this->getData('layout'), ['grid','carousel'], 'grid');
$showRating = Block::boolean($this->getData('show_rating'), true);
$showAvatar = Block::boolean($this->getData('show_avatar'), true);
?>
<link rel="stylesheet" href="@static(Weline_Theme::css/widgets/site-blocks.css)">
<section class="<?= $esc($scope->cssClass) ?> weline-site-block" weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>" data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="siteBlocks" data-site-block="testimonials">
    <header class="sb-header">
        <?php if ($title !== ''): ?><h2 class="sb-title"><?= $t($title) ?></h2><?php endif; ?>
        <?php if ($subtitle !== ''): ?><p class="sb-lead"><?= $t($subtitle) ?></p><?php endif; ?>
    </header>
    <div class="sb-grid columns-<?= $esc($columns) ?><?= $layout === 'carousel' ? ' sb-scroll' : '' ?>" <?= $layout === 'carousel' ? 'tabindex="0" role="region" aria-label="' . $t('评价列表') . '"' : '' ?>>
        <?php foreach ($items as $item):
            $rating = max(0, min(5, (int)($item['rating'] ?? 0)));
            $avatar = LegacyMediaUrl::sanitize($item['avatar'] ?? '');
            $avatarHtml = Block::text($item['avatar_file_html'] ?? '');
        ?>
            <blockquote class="w-card sb-card sb-body sb-quote">
                <?php if ($showRating && $rating > 0): ?><div class="sb-rating" aria-label="<?= $esc(WidgetI18n::label('评分：%{1}/5', '', [$rating])) ?>"><span aria-hidden="true"><?= str_repeat('★', $rating) . str_repeat('☆', 5 - $rating) ?></span></div><?php endif; ?>
                <p class="sb-copy"><?= $t($item['content'] ?? '') ?></p>
                <footer>
                    <?php if ($showAvatar && ($avatarHtml !== '' || $avatar !== '')): ?>
                        <div class="sb-avatar">
                            <?php if ($avatarHtml !== ''): ?><?= $avatarHtml ?><?php else: ?><img src="<?= $esc($avatar) ?>" alt="<?= $t($item['author'] ?? '') ?>" loading="lazy" decoding="async"><?php endif; ?>
                        </div>
                    <?php endif; ?>
                    <strong><?= $t($item['author'] ?? '') ?></strong>
                    <?php if (!empty($item['position'])): ?><p class="sb-copy sb-muted"><?= $t($item['position']) ?></p><?php endif; ?>
                </footer>
            </blockquote>
        <?php endforeach; ?>
    </div>
    <?php if ($layout === 'carousel' && count($items) > 1): ?>
        <div class="sb-actions">
            <button type="button" class="w-button w-button-outline" data-tone="neutral" data-variant="outline" data-scroll-direction="-1"><lang>上一条</lang></button>
            <button type="button" class="w-button w-button-outline" data-tone="neutral" data-variant="outline" data-scroll-direction="1"><lang>下一条</lang></button>
        </div>
    <?php endif; ?>
    <?php if ($items === []): ?><p class="sb-empty"><lang>请在部件配置中添加真实内容</lang></p><?php endif; ?>
</section>
