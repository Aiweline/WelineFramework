use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('testimonials');
$wc = $scope->cssClass;
$esc = static fn (mixed $value): string => htmlspecialchars(
    is_array($value) ? implode(', ', array_map('strval', $value)) : (string)$value,
    ENT_QUOTES,
    'UTF-8'
);

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = (string)($this->getData('title') ?? __('客户评价'));
$subtitle = (string)($this->getData('subtitle') ?? __('看看客户怎么说'));
$testimonials = $this->getData('testimonials') ?? [];
$columns = (string)($this->getData('columns') ?? '3');
$layout = (string)($this->getData('layout') ?? 'grid');
$showRating = (bool)($this->getData('show_rating') ?? true);
$showAvatar = (bool)($this->getData('show_avatar') ?? true);
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

if (!in_array($columns, ['2', '3', '4'], true)) {
    $columns = '3';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'grid';
}

if (empty($testimonials)) {
    $testimonials = [
        [
            'content' => __('产品质量非常好，物流速度也很快，下次还会继续购买！'),
            'author' => '张先生',
            'position' => __('企业客户'),
            'avatar' => $placeholder,
            'rating' => 5,
        ],
        [
            'content' => __('客服态度很好，有问题都能及时解决，购物体验非常满意。'),
            'author' => '李女士',
            'position' => __('普通用户'),
            'avatar' => $placeholder,
            'rating' => 5,
        ],
        [
            'content' => __('价格实惠，性价比很高，已经推荐给身边的朋友了。'),
            'author' => '王先生',
            'position' => __('VIP会员'),
            'avatar' => $placeholder,
            'rating' => 4,
        ],
    ];
}
?>

<section class="<?= $esc($wc) ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">

    <?php if ($title !== '' || $subtitle !== ''): ?>
        <div class="testimonials-header">
            <?php if ($title !== ''): ?>
                <h2 class="testimonials-title"><?= $esc($title) ?></h2>
            <?php endif; ?>
            <?php if ($subtitle !== ''): ?>
                <p class="testimonials-subtitle"><?= $esc($subtitle) ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <div class="testimonials-container">
        <?php if ($layout === 'carousel' && count($testimonials) > 1): ?>
            <button class="carousel-arrow carousel-prev" type="button" aria-label="<?= __('上一条') ?>">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
        <?php endif; ?>

        <div class="testimonials-track">
            <div class="testimonials-grid columns-<?= $esc($columns) ?>">
                <?php foreach ($testimonials as $index => $testimonial): ?>
                    <?php
                    $avatar = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($testimonial['avatar'] ?? '');
                    $avatarHtml = trim((string)($testimonial['avatar_file_html'] ?? ''));
                    $rating = (int)($testimonial['rating'] ?? 0);
                    ?>
                    <article class="testimonial-card<?= $layout === 'carousel' && $index === 0 ? ' is-active' : '' ?>"
                             data-index="<?= (int)$index ?>">
                        <div class="testimonial-quote" aria-hidden="true">
                            <w:icon name="circle" size="sm"></w:icon>
                        </div>

                        <?php if ($showRating && $rating > 0): ?>
                            <div class="testimonial-rating" aria-label="<?= __('评分 %d', $rating) ?>">
                                <?php for ($i = 1; $i <= 5; $i++): ?>
                                    <span class="rating-star" data-state="<?= $i <= $rating ? 'filled' : 'empty' ?>">
                                        <w:icon name="star" size="sm"></w:icon>
                                    </span>
                                <?php endfor; ?>
                            </div>
                        <?php endif; ?>

                        <p class="testimonial-content"><?= $esc($testimonial['content'] ?? '') ?></p>

                        <div class="testimonial-author">
                            <?php if ($showAvatar && ($avatarHtml !== '' || $avatar !== '')): ?>
                                <?php if ($avatarHtml !== ''): ?>
                                    <div class="author-avatar-media"><?= $avatarHtml ?></div>
                                <?php else: ?>
                                    <img src="<?= $esc($avatar) ?>"
                                         alt="<?= $esc($testimonial['author'] ?? '') ?>"
                                         class="author-avatar"
                                         loading="lazy">
                                <?php endif; ?>
                            <?php endif; ?>

                            <div class="author-info">
                                <h4 class="author-name"><?= $esc($testimonial['author'] ?? '') ?></h4>
                                <?php if (!empty($testimonial['position'])): ?>
                                    <span class="author-position"><?= $esc($testimonial['position']) ?></span>
                                <?php endif; ?>
                            </div>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>
        </div>

        <?php if ($layout === 'carousel' && count($testimonials) > 1): ?>
            <button class="carousel-arrow carousel-next" type="button" aria-label="<?= __('下一条') ?>">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
            <div class="carousel-dots">
                <?php foreach ($testimonials as $index => $testimonial): ?>
                    <button class="carousel-dot<?= $index === 0 ? ' is-active' : '' ?>"
                            type="button"
                            data-index="<?= (int)$index ?>"
                            aria-label="<?= __('第%d条', $index + 1) ?>"></button>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>
</section>

