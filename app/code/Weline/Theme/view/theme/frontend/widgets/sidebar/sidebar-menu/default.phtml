<?php
/**
 * 侧栏菜单部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {sidebar-menu}
 * @widget.name {侧栏菜单}
 * @widget.description {侧边栏导航菜单，支持多级折叠}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="导航菜单",type="string",label="标题"}
 * @param menu_items {default=[],type="array",label="菜单项"}
 * @param collapsed_by_default {default=false,type="bool",label="默认折叠"}
 * @param show_icons {default=true,type="bool",label="显示图标"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-menu');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('导航菜单');
$menuItems = $this->getData('menu_items') ?? [];
$collapsedByDefault = (bool)($this->getData('collapsed_by_default') ?? false);
$showIcons = (bool)($this->getData('show_icons') ?? true);

if (empty($menuItems)) {
    $menuItems = [
        ['label' => __('我的账户'), 'url' => '/account', 'icon' => 'user'],
        ['label' => __('我的订单'), 'url' => '/customer/account/index#orders', 'icon' => 'list'],
        ['label' => __('我的收藏'), 'url' => '/account/wishlist', 'icon' => 'heart'],
        ['label' => __('浏览历史'), 'url' => '/account/history', 'icon' => 'history'],
        ['label' => __('地址管理'), 'url' => '/account/addresses', 'icon' => 'pin'],
        ['label' => __('账户安全'), 'url' => '/account/security', 'icon' => 'shield'],
    ];
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($title !== ''): ?>
        <h3 class="widget-title"><?= $esc((string)$title) ?></h3>
    <?php endif; ?>
    <ul class="sidebar-menu-list">
        <?php foreach ($menuItems as $item): ?>
            <li class="menu-item <?= !empty($item['children']) ? 'has-children' : '' ?> <?= !empty($item['active']) ? 'active' : '' ?>">
                <a href="<?= $esc((string)($item['url'] ?? '#')) ?>" class="menu-link">
                    <?php if ($showIcons && !empty($item['icon'])): ?>
                        <i class="<?= $esc((string)$item['icon']) ?>"></i>
                    <?php endif; ?>
                    <span><?= $esc((string)$item['label']) ?></span>
                    <?php if (!empty($item['badge'])): ?>
                        <span class="menu-badge"><?= $esc((string)$item['badge']) ?></span>
                    <?php endif; ?>
                    <?php if (!empty($item['children'])): ?>
                        <w:icon name="arrow-down" size="sm"></w:icon>
                    <?php endif; ?>
                </a>
                <?php if (!empty($item['children'])): ?>
                    <ul class="submenu" <?= $collapsedByDefault ? 'hidden' : '' ?>>
                        <?php foreach ($item['children'] as $child): ?>
                            <li class="submenu-item">
                                <a href="<?= $esc((string)($child['url'] ?? '#')) ?>"><?= $esc((string)$child['label']) ?></a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
</section>

<style>
.<?= $wc ?> {
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg);
    padding: var(--weline-space-5);
}

.<?= $wc ?> .widget-title {
    font-size: var(--weline-font-size-base);
    font-weight: 600;
    margin: 0 0 var(--weline-space-4);
    padding-bottom: var(--weline-space-4);
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .sidebar-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?> .menu-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
    padding: var(--weline-space-3) var(--weline-space-4);
    color: var(--weline-theme-text);
    text-decoration: none;
    border-radius: var(--weline-radius-md);
    transition: all var(--weline-theme-transition-base);
}

.<?= $wc ?> .menu-link:hover,
.<?= $wc ?> .menu-item.active .menu-link {
    background: var(--weline-theme-primary-surface);
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .menu-badge {
    padding: var(--spacing-0_5) var(--weline-space-2);
    background: var(--weline-theme-danger);
    color: var(--weline-theme-on-primary);
    font-size: var(--weline-font-size-xs);
    font-weight: 600;
    border-radius: var(--weline-radius-round);
    margin-left: auto;
}

.<?= $wc ?> .submenu {
    list-style: none;
    margin: var(--weline-space-1) 0 0;
    padding: 0 0 0 var(--weline-space-12);
}

.<?= $wc ?> .submenu-item a {
    display: block;
    padding: var(--weline-space-2) var(--weline-space-4);
    color: var(--weline-theme-text-muted);
    text-decoration: none;
    font-size: var(--weline-font-size-sm);
    border-radius: var(--weline-radius-sm);
}

.<?= $wc ?> .submenu-item a:hover {
    background: var(--weline-theme-surface-muted);
    color: var(--weline-theme-primary);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-3);
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    root.querySelectorAll('.has-children > .menu-link').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            var item = this.closest('.menu-item');
            var submenu = item?.querySelector('.submenu');
            if (!submenu) return;
            item.classList.toggle('expanded');
            submenu.hidden = !submenu.hidden;
        });
    });
})();
</script>
