<?php
/**
 * Header 语言切换部件
 *
 * 语言目录、当前语言和路径均由 Weline_I18n 按当前网站范围在运行时提供。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {language-switcher}
 * @widget.name {语言切换}
 * @widget.description {网站范围语言切换器，支持当前路径的本地化导航}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {language}
 * @widget.supports {["layout-header-language","language"]}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('language-switcher');
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
?>

<section class="<?= $esc($scope->cssClass) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="i18n">
    <?php // i18n：框架核心模组（Weline_Framework）；主题部件声明加载；Weline_I18n 仅增强 ?>
    <w:i18n:switcher navigation="path" />
</section>
