<?php
/**
 * 社交分享部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {social-share}
 * @widget.name {社交分享}
 * @widget.description {社交媒体分享按钮，支持多平台}
 * @widget.type {social}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["product", "cms_page"]}
 * @widget.compatible {true}
 *
 * @param title {default="分享到",type="string",label="标题"}
 * @param platforms {default=["facebook","twitter","linkedin","whatsapp","email"],type="array",label="分享平台"}
 * @param style {default="icon",type="select",label="样式",options={icon:"仅图标",icon-text:"图标+文字",button:"按钮"}}
 * @param layout {default="horizontal",type="select",label="布局",options={horizontal:"横向",vertical:"纵向"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('social-share');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('分享到');
$platforms = $this->getData('platforms') ?? ['facebook', 'twitter', 'linkedin', 'whatsapp', 'email'];
$style = $this->getData('style') ?? 'icon';
$layout = $this->getData('layout') ?? 'horizontal';
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT;

$platformConfig = [
    'facebook' => ['icon' => 'circle', 'name' => 'Facebook', 'color' => '#1877f2', 'url' => 'https://www.facebook.com/sharer/sharer.php?u={url}'],
    'twitter' => ['icon' => 'circle', 'name' => 'Twitter/X', 'color' => '#000', 'url' => 'https://twitter.com/intent/tweet?url={url}&text={title}'],
    'linkedin' => ['icon' => 'link', 'name' => 'LinkedIn', 'color' => '#0077b5', 'url' => 'https://www.linkedin.com/shareArticle?mini=true&url={url}&title={title}'],
    'pinterest' => ['icon' => 'pin', 'name' => 'Pinterest', 'color' => '#bd081c', 'url' => 'https://pinterest.com/pin/create/button/?url={url}&description={title}'],
    'whatsapp' => ['icon' => 'circle', 'name' => 'WhatsApp', 'color' => '#25d366', 'url' => 'https://wa.me/?text={title}%20{url}'],
    'telegram' => ['icon' => 'circle', 'name' => 'Telegram', 'color' => '#0088cc', 'url' => 'https://t.me/share/url?url={url}&text={title}'],
    'wechat' => ['icon' => 'circle', 'name' => '微信', 'color' => '#07c160', 'url' => '#', 'action' => 'qrcode'],
    'weibo' => ['icon' => 'circle', 'name' => '微博', 'color' => '#e6162d', 'url' => 'https://service.weibo.com/share/share.php?url={url}&title={title}'],
    'qq' => ['icon' => 'circle', 'name' => 'QQ', 'color' => '#12b7f5', 'url' => 'https://connect.qq.com/widget/shareqq/index.html?url={url}&title={title}'],
    'email' => ['icon' => 'mail', 'name' => (string)__('邮件'), 'color' => '#666', 'url' => 'mailto:?subject={title}&body={url}'],
    'copy' => ['icon' => 'link', 'name' => (string)__('复制链接'), 'color' => '#333', 'url' => '#', 'action' => 'copy'],
];
?>

<section class="<?= $esc($wc) ?> style-<?= $esc((string)$style) ?> layout-<?= $esc((string)$layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-url="<?= $esc((string)\w_env_request_uri()) ?>"
         data-title="<?= $esc((string)($this->getData('page_title') ?? '')) ?>">
    <?php if ($title !== ''): ?>
        <span class="share-title"><?= $esc((string)$title) ?></span>
    <?php endif; ?>
    <div class="share-buttons">
        <?php foreach ($platforms as $platform):
            if (!isset($platformConfig[$platform])) continue;
            $config = $platformConfig[$platform];
        ?>
            <button class="share-btn share-<?= $esc((string)$platform) ?>"
                    type="button"
                    data-platform="<?= $esc((string)$platform) ?>"
                    data-url="<?= $esc($config['url']) ?>"
                    data-action="<?= $esc($config['action'] ?? 'share') ?>"
                    style="--btn-color: <?= $esc($config['color']) ?>;"
                    title="<?= $esc($config['name']) ?>">
                <w:icon name="config.icon|share" size="sm"></w:icon>
                <?php if ($style !== 'icon'): ?>
                    <span><?= $esc($config['name']) ?></span>
                <?php endif; ?>
            </button>
        <?php endforeach; ?>
    </div>
    <span class="share-status" role="status" aria-live="polite"></span>
</section>

<style>
.<?= $wc ?> {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
}

.<?= $wc ?>.layout-vertical {
    flex-direction: column;
    align-items: flex-start;
}

.<?= $wc ?> .share-title {
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
    white-space: nowrap;
}

.<?= $wc ?> .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weline-space-2);
}

.<?= $wc ?>.layout-vertical .share-buttons {
    flex-direction: column;
}

.<?= $wc ?> .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-2);
    border: none;
    cursor: pointer;
    transition: all var(--weline-theme-transition-base);
    background: var(--btn-color);
    color: var(--weline-theme-on-primary);
}

.<?= $wc ?>.style-icon .share-btn {
    width: var(--size-control-sm);
    height: var(--size-control-sm);
    border-radius: 50%;
    padding: 0;
}

.<?= $wc ?>.style-icon-text .share-btn,
.<?= $wc ?>.style-button .share-btn {
    padding: var(--weline-space-2) var(--weline-space-4);
    border-radius: var(--weline-radius-sm);
}

.<?= $wc ?> .share-btn:hover {
    transform: translateY(var(--spacing-neg-0_5));
    box-shadow: var(--weline-theme-shadow-md);
}

.<?= $wc ?> .share-status {
    font-size: var(--weline-font-size-sm);
    color: var(--weline-theme-text-muted);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    flex-wrap: wrap;
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var shareMessages = {
        wechatQr: <?= json_encode((string)__('请使用微信扫描二维码分享'), $jsonForScriptFlags) ?>
    };

    var pageUrl = encodeURIComponent(window.location.href);
    var pageTitle = encodeURIComponent(document.title);

    function showShareNotice(message, type) {
        if (window.Weline && window.Weline.UI.toast && typeof window.Weline.UI.toast.show === 'function') {
            window.Weline.UI.toast.show(message, {tone: type || 'info'});
            return;
        }
        var status = root.querySelector('.share-status');
        if (status) {
            status.textContent = message;
            return;
        }
        console.info(message);
    }

    root.querySelectorAll('.share-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var action = this.dataset.action;
            var url = this.dataset.url;

            if (action === 'copy') {
                navigator.clipboard.writeText(window.location.href).then(function () {
                    btn.dataset.state = 'copied';
                    setTimeout(function () { btn.dataset.state = 'idle'; }, 2000);
                });
                return;
            }

            if (action === 'qrcode') {
                showShareNotice(shareMessages.wechatQr, 'info');
                return;
            }

            url = url.replace('{url}', pageUrl).replace('{title}', pageTitle);
            window.open(url, '_blank', 'width=600,height=400');
        });
    });
})();
</script>
