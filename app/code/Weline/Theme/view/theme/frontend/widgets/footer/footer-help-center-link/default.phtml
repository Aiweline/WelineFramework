<?php
/**
 * 页脚「帮助中心」扩展：Theme 帮助中心入口（/help）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-help-center-link}
 * @widget.name {页脚帮助中心链接}
 * @widget.description {页脚帮助中心扩展槽：跳转 Theme /help 帮助中心布局；默认注入 footer-help-links。}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {footer-help-links}
 * @widget.supports {["footer-help-center-link","layout-footer-help-links"]}
 * @widget.default_injections {[{ "layout_type":"*", "slot":"footer-help-links", "area":"footer", "sort_order":40, "required":true, "reason":"页脚帮助中心默认展示 Theme /help 入口", "config":{"label":"帮助中心"} }]}
 *
 * @param label {default="帮助中心",type="string",label="链接文字"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-help-center-link');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$labelSource = trim((string)($this->getData('label') ?? '')) ?: '帮助中心';
$label = WidgetI18n::label($labelSource, '帮助中心');
?>
<a class="footer-help-link footer-help-center-link <?= $esc($wc) ?>"
   weline-code="<?= $esc($scope->code) ?>"
   data-uid="<?= $esc($scope->uid) ?>"
   data-js-ns="<?= $esc($scope->jsNs) ?>"
   data-testid="footer-help-center-link"
   href="@url{'help'}"><?= $esc($label) ?></a>
