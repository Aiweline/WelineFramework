<?php
/**
 * 侧栏广告部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {sidebar-ads}
 * @widget.name {侧栏广告}
 * @widget.description {侧边栏广告位，支持多个广告轮换}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param ads {default=[],type="sidebar_ad_items",label="广告列表",description="每项包含图片、链接与语境文本"}
 * @param show_label {default=true,type="bool",label="显示广告标签"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-ads');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$ads = $this->getData('ads') ?? [];
$showLabel = (bool)($this->getData('show_label') ?? true);
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

if (empty($ads)) {
    $ads = [
        ['image' => $placeholder, 'link' => '/promotions/summer', 'alt' => __('夏季促销'), 'open_new_tab' => false],
        ['image' => $placeholder, 'link' => '/promotions/new-arrivals', 'alt' => __('新品上市'), 'open_new_tab' => false],
    ];
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php foreach ($ads as $ad): ?>
        <?php
        $adLink = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($ad['link'] ?? '#');
        $adLink = $adLink !== '' ? $adLink : '#';
        $adImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($ad['image'] ?? '');
        $adImageHtml = trim((string)($ad['image_file_html'] ?? ''));
        ?>
        <div class="ad-item">
            <a href="<?= $esc($adLink) ?>"
               class="ad-link"
               <?= !empty($ad['open_new_tab']) ? 'target="_blank" rel="noopener"' : '' ?>>
                <?php if ($adImageHtml !== ''): ?>
                    <div class="ad-image-media"><?= $adImageHtml ?></div>
                <?php elseif ($adImage !== ''): ?>
                    <img src="<?= $esc($adImage) ?>"
                         alt="<?= $esc((string)($ad['alt'] ?? __('广告'))) ?>"
                         class="ad-image"
                         loading="lazy">
                <?php endif; ?>
                <?php if ($showLabel): ?>
                    <span class="ad-label"><?= __('广告') ?></span>
                <?php endif; ?>
            </a>
        </div>
    <?php endforeach; ?>
</section>

<style>
.<?= $wc ?> {
    display: flex;
    flex-direction: column;
    gap: var(--weline-space-4);
}

.<?= $wc ?> .ad-item {
    position: relative;
    border-radius: var(--weline-radius-lg);
    overflow: hidden;
}

.<?= $wc ?> .ad-link {
    display: block;
}

.<?= $wc ?> .ad-image,
.<?= $wc ?> .ad-image-media img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--weline-theme-transition-base);
}

.<?= $wc ?> .ad-item:hover .ad-image,
.<?= $wc ?> .ad-item:hover .ad-image-media img {
    transform: scale(1.03);
}

.<?= $wc ?> .ad-label {
    position: absolute;
    top: var(--weline-space-2);
    right: var(--weline-space-2);
    padding: var(--spacing-0_5) var(--weline-space-2);
    background: color-mix(in srgb, var(--weline-theme-overlay) 60%, transparent);
    color: var(--weline-theme-on-primary);
    font-size: var(--weline-font-size-xs);
    border-radius: var(--weline-radius-sm);
    text-transform: uppercase;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    gap: var(--weline-space-2);
}
</style>
