<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js,Weline_Customer::css/widgets/widget-account-login.css}
 * 账号登录部件（Theme 归属）：全宽舞台 + 左侧文案轨 + 右侧悬浮登录卡（对齐原型 v1）。
 * 供 account/auth 布局 slot 模板内嵌；主题编辑器可换背景/文案（Copy-on-Write）。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {account-login}
 * @widget.name {客户登录}
 * @widget.description {全宽登录舞台：背景铺满，左侧品牌文案，右侧悬浮登录表单}
 * @widget.type {form}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["account"]}
 * @widget.exclusive {true}
 * @widget.supports {["layout-account-auth-content","account-auth-content","account-auth","auth-form","account-login","login"]}
 *
 * @param background_image {default="",type="media_image",label="背景图",description="全宽舞台背景；留空则用水墨山水默认舞台"}
 * @param background_color {default="#1f2124",type="color",label="背景主色"}
 * @param accent_color {default="#b84a3c",type="color",label="背景点缀色",description="无背景图时与主色组成水墨渐隐"}
 * @param overlay_opacity {default="0.35",type="select",label="背景遮罩",options={0:"无遮罩",0.2:"20%",0.35:"35%",0.5:"50%",0.65:"65%"}}
 * @param promo_eyebrow {default="Weline Account",type="string",label="舞台眉题"}
 * @param promo_title {default="欢迎回来",type="string",label="舞台标题"}
 * @param promo_subtitle {default="登录后继续浏览优惠与订单",type="string",label="舞台副文案"}
 * @param promo_trust {default="安全登录 · 订单与优惠同步",type="string",label="舞台信任文案"}
 * @param title {default="登录",type="string",label="表单标题"}
 * @param subtitle {default="使用您的账户继续购物",type="string",label="表单副标题"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('account-login');
$wc = $scope->cssClass;
$esc = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false)
    || (bool)($this->getData('editor_mode') ?? false);

$backgroundImage = LegacyMediaUrl::sanitize($this->getData('background_image') ?? '', true);
$backgroundImageFileHtml = (string)($this->getData('background_image_file_html') ?? '');
// 旧亚马逊舞台色 → 水墨玄墨/朱砂（古风商城默认）
$rawBackgroundColor = trim((string)($this->getData('background_color') ?? ''));
$rawAccentColor = trim((string)($this->getData('accent_color') ?? ''));
if ($rawBackgroundColor === '' || strcasecmp($rawBackgroundColor, '#1b2430') === 0) {
    $rawBackgroundColor = '#1f2124';
}
if ($rawAccentColor === '' || strcasecmp($rawAccentColor, '#e08a2a') === 0) {
    $rawAccentColor = '#b84a3c';
}
$backgroundColor = ThemeUiColor::sanitize($rawBackgroundColor, '#1f2124');
$accentColor = ThemeUiColor::sanitize($rawAccentColor, '#b84a3c');
$overlayOpacity = (float)($this->getData('overlay_opacity') ?? 0.35);
if ($overlayOpacity < 0) {
    $overlayOpacity = 0.0;
}
if ($overlayOpacity > 0.9) {
    $overlayOpacity = 0.9;
}

$promoEyebrowRaw = trim((string)($this->getData('promo_eyebrow') ?? 'Weline Account'));
$promoEyebrowSite = '';
if ($promoEyebrowRaw === '' || $promoEyebrowRaw === 'Weline Account') {
    try {
        /** @var \Weline\Theme\Helper\SiteBrand $siteBrand */
        $siteBrand = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Theme\Helper\SiteBrand::class);
        $siteName = trim($siteBrand->resolveFrontendSiteName());
        if ($siteName !== '' && !$siteBrand->isGenericBrandPlaceholder($siteName)) {
            $promoEyebrowSite = $siteName;
        }
    } catch (\Throwable) {
    }
}
$promoTitleRaw = trim((string)($this->getData('promo_title') ?? '欢迎回来'));
$promoSubtitleRaw = trim((string)($this->getData('promo_subtitle') ?? '登录后继续浏览优惠与订单'));
$promoTrustRaw = trim((string)($this->getData('promo_trust') ?? '安全登录 · 订单与优惠同步'));
// Static defaults render via <lang> in this widget markup so locale bake matches
// other storefront chrome; only merchant overrides go through __().
$promoEyebrow = $promoEyebrowRaw !== '' && $promoEyebrowRaw !== 'Weline Account'
    ? (string)__($promoEyebrowRaw)
    : $promoEyebrowRaw;
$promoTitleIsDefault = ($promoTitleRaw === '' || $promoTitleRaw === '欢迎回来');
$promoSubtitleIsDefault = ($promoSubtitleRaw === '' || $promoSubtitleRaw === '登录后继续浏览优惠与订单');
$promoTrustIsDefault = ($promoTrustRaw === '' || $promoTrustRaw === '安全登录 · 订单与优惠同步');
$promoTitle = $promoTitleIsDefault ? '' : (string)__($promoTitleRaw);
$promoSubtitle = $promoSubtitleIsDefault ? '' : (string)__($promoSubtitleRaw);
$promoTrust = $promoTrustIsDefault ? '' : (string)__($promoTrustRaw);

$title = trim((string)($this->getData('title') ?? ''));
$subtitle = trim((string)($this->getData('subtitle') ?? ''));
// Keep form defaults on <lang> in login.phtml (compile-time locale bake). Forward
// only customized Theme Editor copy so Chinese source defaults are not echoed raw.
if ($title !== '' && $title !== '登录') {
    $this->setData('login_widget_title', (string)__($title));
}
if ($subtitle !== '' && $subtitle !== '使用您的账户继续购物') {
    $this->setData('login_widget_subtitle', (string)__($subtitle));
}

$hasImage = $backgroundImageFileHtml !== '' || $backgroundImage !== '';
$rootStyle = '--account-login-promo-bg:' . $backgroundColor . ';'
    . '--account-login-accent:' . $accentColor . ';'
    . '--account-login-overlay:' . $overlayOpacity . ';';
$backdropStyle = '';
if ($backgroundImageFileHtml === '' && $backgroundImage !== '') {
    $backdropStyle = 'background-image:url("' . $esc($backgroundImage) . '");';
}
?>
<section class="<?= $esc($wc) ?> account-login-widget<?= $hasImage ? ' account-login-widget--has-image' : ' account-login-widget--wash' ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-w-component="account-login-stage"
         data-widget-style="<?= $esc($rootStyle) ?>">
    <div class="account-login-widget__backdrop"
         data-widget-style="<?= $esc($backdropStyle) ?>"
         aria-hidden="true">
        <?php if ($backgroundImageFileHtml !== ''): ?>
            <div class="account-login-widget__media"><?= $backgroundImageFileHtml ?></div>
        <?php endif; ?>
        <div class="account-login-widget__overlay"></div>
    </div>

    <div class="account-login-widget__rail" aria-label="<?= $esc((string)__('登录品牌文案')) ?>">
        <?php if ($promoEyebrowSite !== ''): ?>
            <p class="account-login-widget__eyebrow"><?= $esc($promoEyebrowSite) ?></p>
        <?php elseif ($promoEyebrowRaw === 'Weline Account'): ?>
            <p class="account-login-widget__eyebrow"><lang>Weline Account</lang></p>
        <?php elseif ($promoEyebrow !== ''): ?>
            <p class="account-login-widget__eyebrow"><?= $esc($promoEyebrow) ?></p>
        <?php endif; ?>
        <?php if ($promoTitleIsDefault): ?>
            <p class="account-login-widget__promo-title"><lang>欢迎回来</lang></p>
        <?php elseif ($promoTitle !== ''): ?>
            <p class="account-login-widget__promo-title"><?= $esc($promoTitle) ?></p>
        <?php endif; ?>
        <?php if ($promoSubtitleIsDefault): ?>
            <p class="account-login-widget__promo-subtitle"><lang>登录后继续浏览优惠与订单</lang></p>
        <?php elseif ($promoSubtitle !== ''): ?>
            <p class="account-login-widget__promo-subtitle"><?= $esc($promoSubtitle) ?></p>
        <?php endif; ?>
        <?php if ($promoTrustIsDefault): ?>
            <p class="account-login-widget__promo-trust"><lang>安全登录 · 订单与优惠同步</lang></p>
        <?php elseif ($promoTrust !== ''): ?>
            <p class="account-login-widget__promo-trust"><?= $esc($promoTrust) ?></p>
        <?php endif; ?>
    </div>

    <div class="account-login-widget__dock">
        <div class="account-login-widget__stage">
            <?= $this->fetch('Weline_Customer::templates/frontend/account/login.phtml') ?>
        </div>
    </div>
</section>
