    opacity: 0;
}

.<?= $wc ?> .slide[data-tone="dark"] .slide-kicker {
    color: var(--color-primary-light);
}

.<?= $wc ?> .slide-title {
    font-family: var(--font-family-serif), var(--font-family-base);
    font-size: clamp(var(--weline-layout-font-size-2xl), 3.2vw, var(--weline-layout-font-size-4xl));
