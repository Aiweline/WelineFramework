<?php
/**
 * Hero 轮播图部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {hero-slider}
 * @widget.name {Hero 轮播图}
 * @widget.description {首页大图轮播Banner，支持多张图片轮播展示}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-hero","layout-homepage-content","layout-cms-hero","layout-default-content"]}
 *
 * @param slides {default=[],type="banner_items",label="轮播图片",description="图片数组，每项包含 image、title、subtitle、link、button_text"}
 * @param autoplay {default=true,type="bool",label="自动播放"}
 * @param autoplay_speed {default=5000,type="number",label="播放间隔",description="自动播放间隔（毫秒）"}
 * @param show_dots {default=true,type="bool",label="显示指示点"}
 * @param show_arrows {default=true,type="bool",label="显示箭头"}
 * @param effect {default="slide",type="select",label="切换效果",options={slide:"滑动",fade:"淡入淡出"}}
 * @param aspect_ratio {default="1920/600",type="string",label="宽高比",description="仅无图渐变帧兜底；有图时高度跟随图片自然比例，避免定高/强比例裁切烘焙文案"}
 * @param height {default="auto",type="string",label="轮播高度",description="默认 auto（图片自适应）。仅特殊场景写死 px/rem/var 作为 max-height；旧配置 var(--size-hero-height) 视为自适应"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('hero-slider');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$slides = $this->getData('slides') ?? [];
if (is_string($slides)) {
    $decoded = json_decode($slides, true);
    $slides = (is_array($decoded)) ? $decoded : [];
}
if (!is_array($slides)) {
    $slides = [];
}
// 部件 CSS 自我完全：默认按宽高比自适应高度（禁止定高+cover 裁左右）。库卡片缩略由编辑器外壳 viewport+scale 完成，
// 禁止按 preview_mode/editor_mode 压高度，也禁止选择外部编辑器类名。
$autoplay = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('autoplay') ?? $this->getData('auto_play'), true);
$autoplaySpeed = max(1000, min(600000, (int)($this->getData('autoplay_speed') ?? $this->getData('interval') ?? 5000)));
$showDots = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('show_dots'), true);
$showArrows = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('show_arrows'), true);
$effect = strtolower(trim((string)($this->getData('effect') ?? 'slide')));
if (!in_array($effect, ['slide', 'fade'], true)) {
    $effect = 'slide';
}
$aspectRatioRaw = trim((string)($this->getData('aspect_ratio') ?? '1920/600'));
if (preg_match('/^(\d+(?:\.\d+)?)\s*[\/:]\s*(\d+(?:\.\d+)?)$/D', $aspectRatioRaw, $aspectMatch) !== 1) {
    $aspectMatch = [1 => '1920', 2 => '600'];
}
$aspectRatioCss = $aspectMatch[1] . ' / ' . $aspectMatch[2];
$configuredHeight = trim((string)($this->getData('height') ?? 'auto'));
// 旧默认 token / auto / 空 = 自适应；仅显式长度才作为 max-height 上限。
$useAdaptiveHeight = $configuredHeight === ''
    || strcasecmp($configuredHeight, 'auto') === 0
    || $configuredHeight === 'var(--size-hero-height)';
$maxHeight = '';
if (!$useAdaptiveHeight) {
    $maxHeight = \Weline\Theme\Helper\SiteBlockConfig::length($configuredHeight, '');
}
$rootStyle = '--wc-hero-aspect:' . $aspectRatioCss . ';';
if ($maxHeight !== '') {
    $rootStyle .= 'max-height:' . $maxHeight . ';';
}
$placeholder = '';
try {
    $placeholder = \Weline\Theme\Helper\StorefrontImagePlaceholder::url();
} catch (\Throwable) {
    $placeholder = '/Weline/Theme/view/statics/images/storefront-placeholder/default.svg';
}
// hero-slider 未声明 title/subtitle/button_text 参数；共享 Template 上的页面 title
//（如主题名 Weline_Theme）不得当作轮播文案，否则 slides 为空时会落成单页半成品。
$configTitle = '';
$configSubtitle = '';
$configButtonText = '';
$configLink = '#';
$configTextPosition = 'left';
$configImage = '';

$defaultGradients = [
    'linear-gradient(135deg, var(--weline-theme-primary) 0%, var(--weline-theme-primary-hover) 100%)',
    'linear-gradient(135deg, var(--weline-theme-info) 0%, var(--weline-theme-primary) 100%)',
    'linear-gradient(135deg, var(--weline-theme-success) 0%, var(--weline-theme-info) 100%)',
];

$resolveSlideBackground = static function (array $slide, int $index) use ($defaultGradients, $placeholder): string {
    $gradient = trim((string)($slide['gradient'] ?? ''));
    if ($gradient === ''
        || strlen($gradient) > 512
        || preg_match('/^linear-gradient\([0-9a-zA-Z#(),.%\s+\-]+\)$/D', $gradient) !== 1
    ) {
        $gradient = $defaultGradients[$index % count($defaultGradients)];
    }
    $image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($slide['image'] ?? '', true);
    if (trim((string)($slide['image_file_html'] ?? '')) !== '') {
        return 'background: ' . $gradient . ';';
    }
    if ($image !== '' && $image !== $placeholder && !str_contains($image, 'placeholder.png')) {
        return 'background-image:linear-gradient(rgba(0,0,0,0.25),rgba(0,0,0,0.25)),url("'
            . $image
            . '");background-size:cover;background-position:center;';
    }
    return 'background: ' . $gradient . ';';
};

// 无运营配置时提供可直接上线的汉服视觉；图片不烘焙文字，文案按当前 storefront locale 输出。
$requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
if ($currentLocale === ''
    && preg_match('#/([a-z]{2}(?:_[A-Za-z]{2,4}){1,2})(?:/|$)#', $requestUri, $localeMatch) === 1
) {
    $currentLocale = (string)$localeMatch[1];
}
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    try {
        $translated = trim((string)\Weline\Theme\Helper\WidgetI18n::label($source));
    } catch (\Throwable) {
        $translated = $source;
    }
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};
$heroImage = static function (string $slug, string $alt, bool $priority = false) use ($esc): string {
    $desktop = '/pub/media/catalog/hanfu/r2/homepage/' . $slug . '.webp';
    $mobile = '/pub/media/catalog/hanfu/r2/homepage/' . $slug . '-mobile.webp';
    return '<picture>'
        . '<source media="(max-width: 768px)" srcset="' . $esc($mobile) . '" width="900" height="1200" />'
        . '<img src="' . $esc($desktop) . '" alt="' . $esc($alt) . '" '
        . 'width="1920" height="600" '
        . 'loading="' . ($priority ? 'eager' : 'lazy') . '" decoding="async"'
        . ($priority ? ' fetchpriority="high"' : '')
        . '>'
        . '</picture>';
};

// 运营配置里可能烘焙了旧版 image_file_html（缺 width/height）；渲染前补齐，避免 CLS / SEO 尺寸告警。
$ensureHeroMediaDimensions = static function (string $html): string {
    $html = trim($html);
    if ($html === '') {
        return $html;
    }
    $html = preg_replace_callback(
        '/<source\b([^>]*)>/i',
        static function (array $m): string {
            $attrs = $m[1];
            if (!preg_match('/\bwidth\s*=/i', $attrs)) {
                $attrs .= ' width="900"';
            }
            if (!preg_match('/\bheight\s*=/i', $attrs)) {
                $attrs .= ' height="1200"';
            }

            return '<source' . $attrs . '>';
        },
        $html
    ) ?? $html;
    $html = preg_replace_callback(
        '/<img\b([^>]*)>/i',
        static function (array $m): string {
            $attrs = $m[1];
            if (!preg_match('/\bwidth\s*=/i', $attrs)) {
                $attrs .= ' width="1920"';
            }
            if (!preg_match('/\bheight\s*=/i', $attrs)) {
                $attrs .= ' height="600"';
            }

            return '<img' . $attrs . '>';
        },
        $html
    ) ?? $html;

    return $html;
};
foreach ($slides as $slideIndex => $slide) {
    if (!is_array($slide)) {
        continue;
    }
    $mediaHtml = trim((string)($slide['image_file_html'] ?? ''));
    if ($mediaHtml !== '') {
        $slides[$slideIndex]['image_file_html'] = $ensureHeroMediaDimensions($mediaHtml);
    }
    // 运营配置 slides 常烘焙中文源串；渲染时按当前 locale 解析（与默认汉服幻灯同路径）
    foreach (['kicker', 'title', 'subtitle', 'button_text', 'alt'] as $copyKey) {
        $rawCopy = trim((string)($slides[$slideIndex][$copyKey] ?? ''));
        if ($rawCopy === '') {
            continue;
        }
        $slides[$slideIndex][$copyKey] = $translateDefaultCopy($rawCopy, $rawCopy);
    }
}

if (empty($slides)) {
    // 素材：人物抠图 + 自衣饰母题发散的水墨山水底（r2/homepage/{slug}(.|-mobile).webp）
    $defaults = [
        [
            'slug' => 'taoyuan-qingmeng',
            'tone' => 'light',
            'kicker_zh' => '桃花源意',
            'kicker_en' => 'Peach Blossom Spring',
            'title_zh' => '桃园清梦 · 明制花鸟套装',
            'title_en' => 'Peach Garden Dream · Ming-Style Set',
            'subtitle_zh' => '裙上桃鸟入画：烟粉远山，上衣与马面可单选成套',
            'subtitle_en' => 'Peach birds from the skirt become misty mountains; top or mamian alone, or as a set',
            'alt_zh' => '桃园清梦明制花鸟套装立于桃花源意山水画前',
            'alt_en' => 'Peach Garden Dream Ming-style set before a peach-blossom landscape painting',
            'link' => '/products',
        ],
        [
            'slug' => 'shenlong-yin',
            'tone' => 'dark',
            'kicker_zh' => '妆花江山',
            'kicker_en' => 'Zhuanghua Rivers & Mountains',
            'title_zh' => '神龙吟 · 妆花马面裙',
            'title_en' => 'Dragon Chant · Zhuanghua Mamian',
            'subtitle_zh' => '裙幅青绿峰与金鹤散作朱砂江山，同系可选',
            'subtitle_en' => 'Teal peaks and golden cranes from the skirt unfold into cinnabar mountains',
            'alt_zh' => '神龙吟妆花马面立于青绿金鹤山水画前',
            'alt_en' => 'Dragon Chant zhuanghua mamian before a teal-and-gold landscape painting',
            'link' => '/products',
        ],
        [
            'slug' => 'zuimeng-xifeng',
            'tone' => 'dark',
            'kicker_zh' => '泼金暮山',
            'kicker_en' => 'Gold-Splashed Evening Peaks',
            'title_zh' => '醉梦夕风 · 仙鹤织金',
            'title_en' => 'Evening Wind · Crane Brocade',
            'subtitle_zh' => '裙裾金山水与蝶影化作夜色泼金，单裙或套装可入藏',
            'subtitle_en' => 'Gold mountains and butterflies from the hem become a night ink wash; skirt or set',
            'alt_zh' => '醉梦夕风织金马面立于泼金暮山山水画前',
            'alt_en' => 'Evening Wind brocade mamian before a gold-splashed night landscape painting',
            'link' => '/products',
        ],
    ];
    $slides = [];
    foreach ($defaults as $index => $default) {
        $slides[] = [
            'gradient' => $defaultGradients[$index],
            'tone' => $default['tone'],
            'kicker' => $translateDefaultCopy($default['kicker_zh'], $default['kicker_en']),
            'title' => $translateDefaultCopy($default['title_zh'], $default['title_en']),
            'subtitle' => $translateDefaultCopy($default['subtitle_zh'], $default['subtitle_en']),
            'button_text' => $translateDefaultCopy('浏览系列', 'Explore collection'),
            'link' => $default['link'],
            'text_position' => 'left',
            'image_file_html' => $heroImage(
                $default['slug'],
                $translateDefaultCopy($default['alt_zh'], $default['alt_en']),
                $index === 0,
            ),
        ];
    }
}

?>

<link rel="stylesheet" href="@static(Weline_Theme::css/widgets/site-blocks.css)">
<section class="<?= $esc($wc) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="siteBlocks" data-site-block="hero"
         data-autoplay="<?= $autoplay ? 'true' : 'false' ?>" data-autoplay-speed="<?= $autoplaySpeed ?>"
         style="<?= $esc($rootStyle) ?>">
    <div class="slider-container effect-<?= htmlspecialchars($effect ?? '') ?>">
        <div class="slider-wrapper">
            <?php foreach ($slides as $index => $slide): ?>
                <?php
                $textPosition = strtolower(trim((string)($slide['text_position'] ?? 'left')));
                if (!in_array($textPosition, ['left', 'center', 'right'], true)) {
                    $textPosition = 'left';
                }
                $tone = strtolower(trim((string)($slide['tone'] ?? $slide['text_tone'] ?? 'light')));
                if (!in_array($tone, ['light', 'dark'], true)) {
                    $tone = 'light';
                }
                $slideLink = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($slide['link'] ?? '#');
                if ($slideLink === '' || $slideLink === '#') {
                    $slideLink = '#';
                } else {
                    $slideLinkParts = \Weline\Theme\Helper\ProductCardUrl::splitForTaglib($slideLink);
                    $slideLink = $slideLinkParts['url'] !== ''
                        ? $slideLinkParts['url']
                        : ($slideLinkParts['url_path'] !== '' ? $this->getUrl($slideLinkParts['url_path']) : '#');
                }
                ?>
                <div class="slide <?= $index === 0 ? 'active' : '' ?>"
                     data-index="<?= $index ?>"
                     data-tone="<?= $esc($tone) ?>"
                     style="<?= htmlspecialchars($resolveSlideBackground($slide, $index), ENT_QUOTES, 'UTF-8') ?>">
                    <?php if (trim((string)($slide['image_file_html'] ?? '')) !== ''): ?>
                        <div class="slide-media"><?= (string)$slide['image_file_html'] ?></div>
                    <?php endif; ?>
                    <div class="slide-overlay" aria-hidden="true"></div>
                    <div class="slide-content text-<?= htmlspecialchars($textPosition, ENT_QUOTES, 'UTF-8') ?>">
                        <div class="slide-text">
                            <?php if (!empty($slide['kicker'])): ?>
                                <p class="slide-kicker"><?= htmlspecialchars((string)$slide['kicker'], ENT_QUOTES, 'UTF-8') ?></p>
                            <?php endif; ?>
                            <?php if (!empty($slide['title'])): ?>
                                <h2 class="slide-title"><?= htmlspecialchars($slide['title'] ?? '') ?></h2>
                            <?php endif; ?>
                            <?php if (!empty($slide['subtitle'])): ?>
                                <p class="slide-subtitle"><?= htmlspecialchars($slide['subtitle'] ?? '') ?></p>
                            <?php endif; ?>
                            <?php if (!empty($slide['button_text'])): ?>
                                <a href="<?= htmlspecialchars($slideLink, ENT_QUOTES, 'UTF-8') ?>"
                                   class="slide-button w-button w-button-primary"
                                   data-pixel-event="hero_cta_click">
                                    <?= htmlspecialchars($slide['button_text'] ?? '') ?>
                                </a>
                            <?php endif; ?>
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        
        <?php if ($showArrows && count($slides) > 1): ?>
            <button class="slider-arrow slider-prev" type="button" aria-label="<?= __('上一张') ?>">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
            <button class="slider-arrow slider-next" type="button" aria-label="<?= __('下一张') ?>">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
        
        <?php if ($showDots && count($slides) > 1): ?>
            <div class="slider-dots">
                <?php foreach ($slides as $index => $slide): ?>
                    <button class="dot <?= $index === 0 ? 'active' : '' ?>" 
                            data-index="<?= $index ?>"
                            type="button"
                            aria-label="<?= htmlspecialchars(sprintf((string)__('第%d张'), $index + 1), ENT_QUOTES, 'UTF-8') ?>"></button>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
        <?php if ($autoplay && count($slides) > 1): ?>
            <button type="button" class="slider-pause w-button w-button-outline" data-slider-pause aria-pressed="false" data-play-label="@lang{播放轮播}" data-pause-label="@lang{暂停轮播}"><lang>暂停轮播</lang></button>
        <?php endif; ?>
    </div>

<style>
.<?= $wc ?> {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 0;
    /* 高度由当前激活帧图片自然撑开，禁止定高/强比例导致 cover 裁左右文案 */
    overflow: hidden;
}

.<?= $wc ?> .slider-container {
    position: relative;
    width: 100%;
    height: auto;
}

.<?= $wc ?> .slider-wrapper {
    position: relative;
    width: 100%;
    height: auto;
}

.<?= $wc ?> .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.7s ease;
    z-index: 1;
}

.<?= $wc ?> .slide.active {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    opacity: 1;
    z-index: 2;
}

/* 无图渐变帧：用宽高比兜底，避免塌成一条线 */
.<?= $wc ?> .slide.active:not(:has(.slide-media)) {
    aspect-ratio: var(--wc-hero-aspect, 1920 / 600);
    min-height: 0;
}

.<?= $wc ?> .slide-media {
    position: relative;
    inset: auto;
    display: block;
    width: 100%;
    height: auto;
    line-height: 0;
    z-index: 1;
}

.<?= $wc ?> .slide-media figure {
    margin: 0;
}

/* file-image 出图带 figcaption；Hero 文案已在 slide-text，避免图下再露一行英文 */
.<?= $wc ?> .slide-media figcaption {
    display: none;
}

.<?= $wc ?> .slide-media :is(picture, img) {
    position: static;
    inset: auto;
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: unset;
    object-position: center center;
}

/* Slide效果 */
.<?= $wc ?> .effect-slide .slide {
    transform: translateX(100%);
    transition: transform 0.7s ease, opacity 0.7s ease;
}

.<?= $wc ?> .effect-slide .slide.active {
    transform: translateX(0);
}

.<?= $wc ?> .effect-slide .slide.prev {
    transform: translateX(-100%);
}

/* 遮罩：纸色/墨色轻罩，露出山水画远峰，不挡右侧人物 */
.<?= $wc ?> .slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-bg-canvas) 72%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-canvas) 36%, transparent) 32%,
        color-mix(in srgb, var(--color-bg-canvas) 8%, transparent) 55%,
        transparent 72%
    );
}

.<?= $wc ?> .slide[data-tone="dark"] .slide-overlay {
    background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-bg-dark) 68%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-dark) 38%, transparent) 34%,
        color-mix(in srgb, var(--color-bg-dark) 10%, transparent) 58%,
        transparent 76%
    );
}

/* 内容：叠在 slide-media 之上（勿 relative 流式跟在图后，否则下半截只剩渐变红底） */
.<?= $wc ?> .slide-content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    padding: 0 clamp(var(--weline-space-5), 8vw, 10%);
    pointer-events: none;
}

.<?= $wc ?> .slide-content .slide-text,
.<?= $wc ?> .slide-content .slide-button {
    pointer-events: auto;
}

.<?= $wc ?> .slide-text {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--size-content-640);
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    backdrop-filter: none;
}

.<?= $wc ?> .text-left .slide-text {
    text-align: left;
}

.<?= $wc ?> .text-center {
    justify-content: center;
}

.<?= $wc ?> .text-center .slide-text {
    text-align: center;
}

.<?= $wc ?> .text-right {
    justify-content: flex-end;
}

.<?= $wc ?> .text-right .slide-text {
    text-align: right;
}

.<?= $wc ?> .slide-kicker {
    margin: 0 0 var(--weline-space-3);
    font-size: var(--weline-layout-font-size-sm);
    font-weight: 600;
    letter-spacing: 0.18em;
