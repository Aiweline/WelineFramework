    position: relative;
    width: 100%;
    overflow: hidden;
}

.<?= $wc ?> .slider-container {
    position: relative;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slider-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: 1;
}

.<?= $wc ?> .slide.active {
    opacity: 1;
    z-index: 2;
}

.<?= $wc ?> .slide-media,
.<?= $wc ?> .slide-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slide-media img {
    object-fit: cover;
}

/* Slide效果 */
.<?= $wc ?> .effect-slide .slide {
    transform: translateX(100%);
    transition: transform 0.6s ease, opacity 0.6s ease;
}

.<?= $wc ?> .effect-slide .slide.active {
    transform: translateX(0);
}

.<?= $wc ?> .effect-slide .slide.prev {
    transform: translateX(-100%);
}

/* 遮罩 */
.<?= $wc ?> .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, var(--color-overlay-50) 0%, var(--color-overlay-light) 100%);
}

/* 内容 */
.<?= $wc ?> .slide-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 10%;
}

.<?= $wc ?> .text-left .slide-text {
    text-align: left;
}

.<?= $wc ?> .text-center {
    justify-content: center;
}

.<?= $wc ?> .text-center .slide-text {
    text-align: center;
}

.<?= $wc ?> .text-right {
    justify-content: flex-end;
}

.<?= $wc ?> .text-right .slide-text {
    text-align: right;
}

.<?= $wc ?> .slide-title {
    font-size: var(--spacing-2xl);
    font-weight: 700;
    color: var(--weline-theme-on-primary);
    margin: 0 0 var(--spacing-3_5);
    text-shadow: 0 var(--spacing-0_5) var(--spacing-sm) color-mix(in srgb, var(--weline-theme-overlay) 40%, transparent);
    animation: heroSlideUp 0.6s ease forwards;
}

.<?= $wc ?> .slide-subtitle {
    font-size: var(--font-size-xl);
    color: color-mix(in srgb, var(--weline-theme-on-primary) 90%, transparent);
    margin: 0 0 var(--weline-space-8);
    text-shadow: 0 var(--spacing-px) var(--spacing-xs) color-mix(in srgb, var(--weline-theme-overlay) 35%, transparent);
    animation: heroSlideUp 0.6s 0.2s ease forwards;
    opacity: 0;
}

.<?= $wc ?> .slide-button {
    display: inline-block;
    padding: var(--spacing-3_5) var(--size-control-md);
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
    text-decoration: none;
    border-radius: var(--weline-radius-round);
    font-weight: 600;
    font-size: var(--font-size-base);
    transition: all var(--weline-theme-transition-base);
    animation: heroSlideUp 0.6s 0.4s ease forwards;
    opacity: 0;
}

.<?= $wc ?> .slide-button:hover {
    background: var(--weline-theme-primary-hover);
    transform: translateY(var(--spacing-neg-1_5));
    box-shadow: var(--weline-theme-shadow-md);
}

@keyframes heroSlideUp {
    from {
        opacity: 0;
        transform: translateY(var(--weline-space-8));
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 箭头 */
.<?= $wc ?> .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--size-control-50);
    height: var(--size-control-50);
    background: color-mix(in srgb, var(--weline-theme-surface-raised) 92%, transparent);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all var(--weline-theme-transition-base);
    opacity: 0;
    color: var(--weline-theme-text);
}

.<?= $wc ?>:hover .slider-arrow {
    opacity: 1;
}

.<?= $wc ?> .slider-arrow:hover {
    background: var(--weline-theme-surface-raised);
    box-shadow: var(--weline-theme-shadow-md);
}

.<?= $wc ?> .slider-prev {
    left: var(--weline-space-5);
}

.<?= $wc ?> .slider-next {
    right: var(--weline-space-5);
}

/* 指示点 */
.<?= $wc ?> .slider-dots {
    position: absolute;
    bottom: var(--weline-space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--spacing-2_5);
    z-index: 10;
}

.<?= $wc ?> .dot {
    width: var(--font-size-xs);
    height: var(--font-size-xs);
    border-radius: 50%;
    background: var(--token-color-rgba-255-255-255-0-5);
    border: none;
    cursor: pointer;
    transition: all 0.3s;
}

.<?= $wc ?> .dot:hover,
.<?= $wc ?> .dot.active {
    background: var(--weline-theme-on-primary);
    transform: scale(1.2);
}

/* 部件库 / 编辑器预览：压缩高度并缩小文案，避免灰块占位 */
.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--size-panel-120);
}

.widget-preview-canvas .<?= $wc ?> .slide-overlay,
.<?= $wc ?>.is-preview .slide-overlay {
    background: linear-gradient(to right, var(--token-color-rgba-0-0-0-0-35) 0%, var(--color-overlay-05) 100%);
}

.widget-preview-canvas .<?= $wc ?> .slide-content,
.<?= $wc ?>.is-preview .slide-content {
    padding: 0 6%;
}

.widget-preview-canvas .<?= $wc ?> .slide-title,
.<?= $wc ?>.is-preview .slide-title {
    font-size: var(--token-size-1-1rem);
    margin-bottom: var(--spacing-xs);
    animation: none;
    opacity: 1;
}

.widget-preview-canvas .<?= $wc ?> .slide-subtitle,
.<?= $wc ?>.is-preview .slide-subtitle {
    font-size: var(--font-size-xs);
    margin-bottom: var(--spacing-sm);
    animation: none;
    opacity: 1;
}

.widget-preview-canvas .<?= $wc ?> .slide-button,
.<?= $wc ?>.is-preview .slide-button {
    padding: var(--spacing-xs) var(--weline-space-3);
    font-size: var(--spacing-0_7);
    animation: none;
    opacity: 1;
}

.widget-preview-canvas .<?= $wc ?> .slider-arrow,
.<?= $wc ?>.is-preview .slider-arrow {
    width: var(--spacing-lg);
    height: var(--spacing-lg);
    opacity: 0.85;
}

.widget-preview-canvas .<?= $wc ?> .slider-arrow i,
.<?= $wc ?>.is-preview .slider-arrow i {
    font-size: var(--font-size-sm);
}

.widget-preview-canvas .<?= $wc ?> .slider-dots,
.<?= $wc ?>.is-preview .slider-dots {
    bottom: var(--spacing-sm);
    gap: var(--spacing-xs);
}

.widget-preview-canvas .<?= $wc ?> .dot,
.<?= $wc ?>.is-preview .dot {
    width: var(--size-scrollbar);
    height: var(--size-scrollbar);
}

/* 响应式 */
@media (max-width: 768px) {
    .<?= $wc ?> .slide-title {
        font-size: var(--font-size-4xl);
    }
    
    .<?= $wc ?> .slide-subtitle {
        font-size: var(--font-size-base);
    }
    
    .<?= $wc ?> .slide-button {
        padding: var(--weline-space-3) var(--weline-space-8);
        font-size: var(--spacing-0_9);
    }
    
    .<?= $wc ?> .slider-arrow {
        width: var(--size-control-md);
        height: var(--size-control-md);
    }
}
</style>

<script>
(function() {
    const slider = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!slider) return;
    
    const slides = slider.querySelectorAll('.slide');
    const dots = slider.querySelectorAll('.dot');
    const prevBtn = slider.querySelector('.slider-prev');
    const nextBtn = slider.querySelector('.slider-next');
    
    let currentIndex = 0;
    let autoplayInterval = null;
    const autoplay = <?= $autoplay ? 'true' : 'false' ?>;
    const autoplaySpeed = <?= $autoplaySpeed ?>;
    
    function goToSlide(index) {
        slides[currentIndex].classList.remove('active');
        if (dots[currentIndex]) dots[currentIndex].classList.remove('active');
        
        currentIndex = (index + slides.length) % slides.length;
        
        slides[currentIndex].classList.add('active');
        if (dots[currentIndex]) dots[currentIndex].classList.add('active');
    }
    
    function nextSlide() {
        goToSlide(currentIndex + 1);
    }
    
    function prevSlide() {
        goToSlide(currentIndex - 1);
    }
    
    function startAutoplay() {
        if (autoplay && slides.length > 1) {
            autoplayInterval = setInterval(nextSlide, autoplaySpeed);
        }
    }
    
    function stopAutoplay() {
        if (autoplayInterval) {
            clearInterval(autoplayInterval);
            autoplayInterval = null;
        }
    }
    
    // 事件绑定
    if (prevBtn) prevBtn.addEventListener('click', function() {
        prevSlide();
        stopAutoplay();
        startAutoplay();
    });
    
    if (nextBtn) nextBtn.addEventListener('click', function() {
        nextSlide();
        stopAutoplay();
        startAutoplay();
    });
    
    dots.forEach(function(dot, index) {
        dot.addEventListener('click', function() {
            goToSlide(index);
            stopAutoplay();
            startAutoplay();
        });
    });
    
    // 鼠标悬停暂停
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    
    // 触摸支持
    let touchStartX = 0;
    let touchEndX = 0;
    
    slider.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
    }, { passive: true });
    
    slider.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
        startAutoplay();
    }, { passive: true });
    
    function handleSwipe() {
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
            if (diff > 0) {
                nextSlide();
            } else {
                prevSlide();
            }
        }
    }
    
    // 启动自动播放
    startAutoplay();
})();
</script>
