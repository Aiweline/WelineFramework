    font-size: var(--weline-layout-font-size-lg);
    line-height: 1.6;
    color: var(--weline-theme-text-secondary);
    margin: 0 0 var(--weline-space-8);
    max-width: 28em;
    text-shadow: none;
    opacity: 0;
}

.<?= $wc ?> .slide[data-tone="dark"] .slide-subtitle {
    color: var(--color-text-on-dark-muted);
}

.<?= $wc ?> .slide-button {
    display: inline-flex;
