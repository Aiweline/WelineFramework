<?php
/**
 * Hero 轮播图部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {hero-slider}
 * @widget.name {Hero 轮播图}
 * @widget.description {首页大图轮播Banner，支持多张图片轮播展示}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-hero","layout-homepage-content","layout-cms-hero","layout-default-content"]}
 *
 * @param slides {default=[],type="banner_items",label="轮播图片",description="图片数组，每项包含 image、title、subtitle、link、button_text"}
 * @param autoplay {default=true,type="bool",label="自动播放"}
 * @param autoplay_speed {default=5000,type="number",label="播放间隔",description="自动播放间隔（毫秒）"}
 * @param show_dots {default=true,type="bool",label="显示指示点"}
 * @param show_arrows {default=true,type="bool",label="显示箭头"}
 * @param effect {default="slide",type="select",label="切换效果",options={slide:"滑动",fade:"淡入淡出"}}
 * @param height {default="var(--size-hero-height)",type="string",label="轮播高度"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('hero-slider');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$slides = $this->getData('slides') ?? [];
if (is_string($slides)) {
    $decoded = json_decode($slides, true);
    $slides = (is_array($decoded)) ? $decoded : [];
}
if (!is_array($slides)) {
    $slides = [];
}
// 部件 CSS/尺寸自我完全：始终用配置 height。库卡片缩略由编辑器外壳 viewport+scale 完成，
// 禁止按 preview_mode/editor_mode 压高度，也禁止选择外部编辑器类名。
$autoplay = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('autoplay') ?? $this->getData('auto_play'), true);
$autoplaySpeed = max(1000, min(600000, (int)($this->getData('autoplay_speed') ?? $this->getData('interval') ?? 5000)));
$showDots = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('show_dots'), true);
$showArrows = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('show_arrows'), true);
$effect = strtolower(trim((string)($this->getData('effect') ?? 'slide')));
if (!in_array($effect, ['slide', 'fade'], true)) {
    $effect = 'slide';
}
$height = \Weline\Theme\Helper\SiteBlockConfig::length($this->getData('height'), 'var(--size-hero-height)');
$placeholder = '';
try {
    $placeholder = \Weline\Theme\Helper\StorefrontImagePlaceholder::url();
} catch (\Throwable) {
    $placeholder = '/Weline/Theme/view/statics/images/storefront-placeholder/default.svg';
}
// hero-slider 未声明 title/subtitle/button_text 参数；共享 Template 上的页面 title
//（如主题名 Weline_Theme）不得当作轮播文案，否则 slides 为空时会落成单页半成品。
$configTitle = '';
$configSubtitle = '';
$configButtonText = '';
$configLink = '#';
$configTextPosition = 'left';
$configImage = '';

$defaultGradients = [
    'linear-gradient(135deg, var(--weline-theme-primary) 0%, var(--weline-theme-primary-hover) 100%)',
    'linear-gradient(135deg, var(--weline-theme-info) 0%, var(--weline-theme-primary) 100%)',
    'linear-gradient(135deg, var(--weline-theme-success) 0%, var(--weline-theme-info) 100%)',
];

$resolveSlideBackground = static function (array $slide, int $index) use ($defaultGradients, $placeholder): string {
    $gradient = trim((string)($slide['gradient'] ?? ''));
    if ($gradient === ''
        || strlen($gradient) > 512
        || preg_match('/^linear-gradient\([0-9a-zA-Z#(),.%\s+\-]+\)$/D', $gradient) !== 1
    ) {
        $gradient = $defaultGradients[$index % count($defaultGradients)];
    }
    $image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($slide['image'] ?? '', true);
    if (trim((string)($slide['image_file_html'] ?? '')) !== '') {
        return 'background: ' . $gradient . ';';
    }
    if ($image !== '' && $image !== $placeholder && !str_contains($image, 'placeholder.png')) {
        return 'background-image:linear-gradient(rgba(0,0,0,0.25),rgba(0,0,0,0.25)),url("'
            . $image
            . '");background-size:cover;background-position:center;';
    }
    return 'background: ' . $gradient . ';';
};

// 无运营配置时提供可直接上线的汉服视觉；图片不烘焙文字，文案按当前 storefront locale 输出。
$requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
if ($currentLocale === ''
    && preg_match('#/([a-z]{2}(?:_[A-Za-z]{2,4}){1,2})(?:/|$)#', $requestUri, $localeMatch) === 1
) {
    $currentLocale = (string)$localeMatch[1];
}
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    try {
        $translated = trim((string)\Weline\Theme\Helper\WidgetI18n::label($source));
    } catch (\Throwable) {
        $translated = $source;
    }
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }

    return $isChineseLocale ? $source : $english;
};
$heroImage = static function (string $slug, string $alt, bool $priority = false) use ($esc): string {
    $desktop = '/pub/media/catalog/hanfu/r2/homepage/' . $slug . '.webp';
    $mobile = '/pub/media/catalog/hanfu/r2/homepage/' . $slug . '-mobile.webp';
    return '<picture>'
        . '<source media="(max-width: 768px)" srcset="' . $esc($mobile) . '" />'
        . '<img src="' . $esc($desktop) . '" alt="' . $esc($alt) . '" '
        . 'loading="' . ($priority ? 'eager' : 'lazy') . '" decoding="async"'
        . ($priority ? ' fetchpriority="high"' : '')
        . '>'
        . '</picture>';
};

if (empty($slides)) {
    $defaults = [
        [
            'slug' => 'taoyuan-qingmeng',
            'title_zh' => '桃园清梦 · 明制花鸟套装',
            'title_en' => 'Peach Garden Dream · Ming-Style Set',
            'subtitle_zh' => '烟粉花鸟，上衣与马面裙可选',
            'subtitle_en' => 'Ivory and blush florals, with top and mamian options',
            'alt_zh' => '桃园清梦米白粉色明制上衣与马面裙套装',
            'alt_en' => 'Peach Garden Dream ivory-and-pink Ming-style top and mamian set',
            'link' => '/products',
        ],
        [
            'slug' => 'shenlong-yin',
            'title_zh' => '神龙吟 · 妆花马面裙',
            'title_en' => 'Dragon Chant · Zhuanghua Mamian',
            'subtitle_zh' => '黑红妆花，马面裙与飞机袖可选',
            'subtitle_en' => 'Black-and-red zhuanghua, with mamian and feijixiu options',
            'alt_zh' => '神龙吟黑红妆花明制马面裙造型',
            'alt_en' => 'Dragon Chant black-and-red zhuanghua Ming-style mamian look',
            'link' => '/products',
        ],
        [
            'slug' => 'zuimeng-xifeng',
            'title_zh' => '醉梦夕风 · 仙鹤织金',
            'title_en' => 'Evening Wind · Crane Brocade',
            'subtitle_zh' => '仙鹤织金，单裙与套装可选',
            'subtitle_en' => 'Crane brocade, available as a skirt or coordinated set',
            'alt_zh' => '醉梦夕风深色仙鹤织金马面裙造型',
            'alt_en' => 'Evening Wind dark crane-brocade mamian look',
            'link' => '/products',
        ],
    ];
    $slides = [];
    foreach ($defaults as $index => $default) {
        $slides[] = [
            'gradient' => $defaultGradients[$index],
            'title' => $translateDefaultCopy($default['title_zh'], $default['title_en']),
            'subtitle' => $translateDefaultCopy($default['subtitle_zh'], $default['subtitle_en']),
            'button_text' => $translateDefaultCopy('浏览系列', 'Explore collection'),
            'link' => $default['link'],
            'text_position' => 'left',
            'image_file_html' => $heroImage(
                $default['slug'],
                $translateDefaultCopy($default['alt_zh'], $default['alt_en']),
                $index === 0,
            ),
        ];
    }
}

?>

<link rel="stylesheet" href="@static(Weline_Theme::css/widgets/site-blocks.css)">
<section class="<?= $esc($wc) ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="siteBlocks" data-site-block="hero"
         data-autoplay="<?= $autoplay ? 'true' : 'false' ?>" data-autoplay-speed="<?= $autoplaySpeed ?>"
         style="height: <?= $esc($height) ?>;">
    <div class="slider-container effect-<?= htmlspecialchars($effect ?? '') ?>">
        <div class="slider-wrapper">
            <?php foreach ($slides as $index => $slide): ?>
                <?php
                $textPosition = strtolower(trim((string)($slide['text_position'] ?? 'left')));
                if (!in_array($textPosition, ['left', 'center', 'right'], true)) {
                    $textPosition = 'left';
                }
                $slideLink = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($slide['link'] ?? '#');
                if ($slideLink === '' || $slideLink === '#') {
                    $slideLink = '#';
                } else {
                    $slideLinkParts = \Weline\Theme\Helper\ProductCardUrl::splitForTaglib($slideLink);
                    $slideLink = $slideLinkParts['url'] !== ''
                        ? $slideLinkParts['url']
                        : ($slideLinkParts['url_path'] !== '' ? $this->getUrl($slideLinkParts['url_path']) : '#');
                }
                ?>
                <div class="slide <?= $index === 0 ? 'active' : '' ?>" 
                     data-index="<?= $index ?>"
                     style="<?= htmlspecialchars($resolveSlideBackground($slide, $index), ENT_QUOTES, 'UTF-8') ?>">
                    <?php if (trim((string)($slide['image_file_html'] ?? '')) !== ''): ?>
                        <div class="slide-media"><?= (string)$slide['image_file_html'] ?></div>
                    <?php endif; ?>
                    <div class="slide-overlay"></div>
                    <div class="slide-content text-<?= htmlspecialchars($textPosition, ENT_QUOTES, 'UTF-8') ?>">
                        <div class="slide-text">
                            <?php if (!empty($slide['title'])): ?>
                                <h2 class="slide-title"><?= htmlspecialchars($slide['title'] ?? '') ?></h2>
                            <?php endif; ?>
                            <?php if (!empty($slide['subtitle'])): ?>
                                <p class="slide-subtitle"><?= htmlspecialchars($slide['subtitle'] ?? '') ?></p>
                            <?php endif; ?>
                            <?php if (!empty($slide['button_text'])): ?>
                                <a href="<?= htmlspecialchars($slideLink, ENT_QUOTES, 'UTF-8') ?>" class="slide-button w-button w-button-primary">
                                    <?= htmlspecialchars($slide['button_text'] ?? '') ?>
                                </a>
                            <?php endif; ?>
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        
        <?php if ($showArrows && count($slides) > 1): ?>
            <button class="slider-arrow slider-prev" type="button" aria-label="<?= __('上一张') ?>">
                <w:icon name="arrow-left" size="sm"></w:icon>
            </button>
            <button class="slider-arrow slider-next" type="button" aria-label="<?= __('下一张') ?>">
                <w:icon name="arrow-right" size="sm"></w:icon>
            </button>
        <?php endif; ?>
        
        <?php if ($showDots && count($slides) > 1): ?>
            <div class="slider-dots">
                <?php foreach ($slides as $index => $slide): ?>
                    <button class="dot <?= $index === 0 ? 'active' : '' ?>" 
                            data-index="<?= $index ?>"
                            type="button"
                            aria-label="<?= htmlspecialchars(sprintf((string)__('第%d张'), $index + 1), ENT_QUOTES, 'UTF-8') ?>"></button>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
        <?php if ($autoplay && count($slides) > 1): ?>
            <button type="button" class="slider-pause w-button w-button-outline" data-slider-pause aria-pressed="false" data-play-label="@lang{播放轮播}" data-pause-label="@lang{暂停轮播}"><lang>暂停轮播</lang></button>
        <?php endif; ?>
    </div>

<style>
.<?= $wc ?> {
    position: relative;
    width: 100%;
    overflow: hidden;
}

.<?= $wc ?> .slider-container {
    position: relative;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slider-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: 1;
}

.<?= $wc ?> .slide.active {
    opacity: 1;
    z-index: 2;
}

.<?= $wc ?> .slide-media,
.<?= $wc ?> .slide-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

.<?= $wc ?> .slide-media img {
    object-fit: cover;
    object-position: 75% center;
}

/* Slide效果 */
.<?= $wc ?> .effect-slide .slide {
    transform: translateX(100%);
    transition: transform 0.6s ease, opacity 0.6s ease;
}

.<?= $wc ?> .effect-slide .slide.active {
    transform: translateX(0);
}

.<?= $wc ?> .effect-slide .slide.prev {
    transform: translateX(-100%);
}

/* 遮罩 */
.<?= $wc ?> .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, var(--color-overlay-50) 0%, var(--color-overlay-light) 100%);
}

/* 内容 */
.<?= $wc ?> .slide-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 10%;
}

.<?= $wc ?> .slide-text {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--size-content-640);
    padding: var(--weline-space-6);
    background: color-mix(in srgb, var(--weline-theme-surface-raised) 92%, transparent);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border-color);
    border-radius: var(--weline-theme-radius-xl);
    box-shadow: var(--weline-theme-shadow-lg);
    backdrop-filter: blur(var(--spacing-sm));
}

.<?= $wc ?> .text-left .slide-text {
    text-align: left;
}

.<?= $wc ?> .text-center {
    justify-content: center;
}

.<?= $wc ?> .text-center .slide-text {
    text-align: center;
}

.<?= $wc ?> .text-right {
    justify-content: flex-end;
}

.<?= $wc ?> .text-right .slide-text {
    text-align: right;
}

.<?= $wc ?> .slide-title {
    font-size: var(--weline-layout-font-size-4xl);
    font-weight: 700;
    color: var(--weline-theme-text);
    margin: 0 0 var(--spacing-3_5);
    text-shadow: none;
    animation: heroSlideUp 0.6s ease forwards;
}

.<?= $wc ?> .slide-subtitle {
    font-size: var(--weline-layout-font-size-xl);
    color: var(--weline-theme-text-secondary);
    margin: 0 0 var(--weline-space-8);
    text-shadow: none;
    animation: heroSlideUp 0.6s 0.2s ease forwards;
    opacity: 0;
}

.<?= $wc ?> .slide-button {
    display: inline-block;
    padding: var(--spacing-3_5) var(--size-control-md);
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
    text-decoration: none;
    border-radius: var(--weline-radius-round);
    font-weight: 600;
    font-size: var(--weline-layout-font-size-base);
    transition: all var(--weline-theme-transition-base);
    animation: heroSlideUp 0.6s 0.4s ease forwards;
    opacity: 0;
}

.<?= $wc ?> .slide-button:hover {
    background: var(--weline-theme-primary-hover);
    transform: translateY(var(--spacing-neg-1_5));
    box-shadow: var(--weline-theme-shadow-md);
}

@keyframes heroSlideUp {
    from {
        opacity: 0;
        transform: translateY(var(--weline-space-8));
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 箭头 */
.<?= $wc ?> .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--size-control-50);
    height: var(--size-control-50);
    background: color-mix(in srgb, var(--weline-theme-surface-raised) 92%, transparent);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all var(--weline-theme-transition-base);
    opacity: 0;
    color: var(--weline-theme-text);
}

.<?= $wc ?>:hover .slider-arrow,
.<?= $wc ?>:focus-within .slider-arrow {
    opacity: 1;
}

.<?= $wc ?> .slider-arrow:hover {
    background: var(--weline-theme-surface-raised);
    box-shadow: var(--weline-theme-shadow-md);
}

.<?= $wc ?> .slider-prev {
    left: var(--weline-space-5);
}

.<?= $wc ?> .slider-next {
    right: var(--weline-space-5);
}

.<?= $wc ?> .slider-pause { position: absolute; bottom: var(--spacing-md); inset-inline-end: var(--spacing-md); z-index: 10; }

/* 指示点 */
.<?= $wc ?> .slider-dots {
    position: absolute;
    bottom: var(--weline-space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--spacing-2_5);
    z-index: 10;
}

.<?= $wc ?> .dot {
    width: var(--font-size-xs);
    height: var(--font-size-xs);
    border-radius: 50%;
    background: var(--token-color-rgba-255-255-255-0-5);
    border: none;
    cursor: pointer;
    transition: all 0.3s;
}

.<?= $wc ?> .dot:hover,
.<?= $wc ?> .dot.active {
    background: var(--weline-theme-on-primary);
    transform: scale(1.2);
}

/* 响应式 */
@media (max-width: 768px) {
    .<?= $wc ?> .slide-media img {
        object-position: center;
    }

    .<?= $wc ?> .slide-content {
        align-items: flex-end;
        padding: var(--weline-space-8) var(--weline-space-5) var(--weline-space-12);
    }

    .<?= $wc ?> .slide-text {
        max-width: var(--size-content-640);
        padding: var(--weline-space-5);
    }

    .<?= $wc ?> .slide-title {
        font-size: var(--weline-layout-font-size-2xl);
    }
    
    .<?= $wc ?> .slide-subtitle {
        font-size: var(--weline-layout-font-size-base);
    }
    
    .<?= $wc ?> .slide-button {
        padding: var(--weline-space-3) var(--weline-space-8);
        font-size: var(--spacing-0_9);
    }
    
    .<?= $wc ?> .slider-arrow {
        top: var(--weline-space-8);
        width: var(--size-control-md);
        height: var(--size-control-md);
        transform: none;
    }
}
</style>

</section>
