<?php
/**
 * 页脚版权部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {footer-copyright}
 * @widget.name {版权信息}
 * @widget.description {Footer 版权和备案信息}
 * @widget.type {footer}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {copyright}
 * @widget.supports {["layout-footer-copyright","layout-global-footer-copyright"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"footer-copyright","area":"footer","sort_order":0}]}
 * @widget.exclusive {true}
 *
 * @param copyright_text {default="© {year} {site_name}. All Rights Reserved.",type="string",label="版权文字"}
 * @param icp_number {default="",type="string",label="ICP备案号"}
 * @param icp_link {default="https://beian.miit.gov.cn/",type="string",label="ICP备案链接"}
 * @param police_number {default="",type="string",label="公安备案号"}
 * @param police_link {default="",type="string",label="公安备案链接"}
 * @param text_color {default="var(--weline-theme-on-primary)",type="color",label="文字颜色"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-copyright');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$copyrightText = $this->getData('copyright_text') ?? '© {year} {site_name}. All Rights Reserved.';
$icpNumber = $this->getData('icp_number') ?? '';
$icpLink = $this->getData('icp_link') ?? 'https://beian.miit.gov.cn/';
$policeNumber = $this->getData('police_number') ?? '';
$policeLink = $this->getData('police_link') ?? '';
$additionalText = $this->getData('additional_text') ?? '';
$textColor = ThemeUiColor::sanitize($this->getData('text_color') ?? '', 'var(--weline-theme-on-primary)');
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

$siteName = 'WeShop';
$copyrightText = str_replace(['{year}', '{site_name}'], [date('Y'), $siteName], (string)$copyrightText);
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="--wc-copyright-text:<?= $esc($textColor) ?>;">
    <div class="copyright-text"><?= $esc($copyrightText) ?></div>
    <?php if ($icpNumber !== '' || $policeNumber !== '' || $additionalText !== ''): ?>
        <div class="copyright-links">
            <?php if ($icpNumber !== ''): ?>
                <a href="<?= $esc((string)$icpLink) ?>" target="_blank" rel="noopener noreferrer" class="icp-link"><?= $esc((string)$icpNumber) ?></a>
            <?php endif; ?>
            <?php if ($policeNumber !== ''): ?>
                <a href="<?= $esc((string)$policeLink) ?>" target="_blank" rel="noopener noreferrer" class="police-link">
                    <img src="<?= $esc($placeholder) ?>" alt="" class="police-icon">
                    <?= $esc((string)$policeNumber) ?>
                </a>
            <?php endif; ?>
            <?php if ($additionalText !== ''): ?>
                <span class="additional-text"><?= $esc((string)$additionalText) ?></span>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    text-align: center;
    padding: var(--weline-space-5, 20px) 0;
    font-size: var(--weline-font-size-sm, 13px);
    color: color-mix(in srgb, var(--wc-copyright-text, var(--weline-theme-on-primary)) 60%, transparent);
}

.<?= $wc ?> .copyright-text {
    margin-bottom: var(--weline-space-3, 10px);
}

.<?= $wc ?> .copyright-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--weline-space-5, 20px);
}

.<?= $wc ?> .copyright-links a {
    color: color-mix(in srgb, var(--wc-copyright-text, var(--weline-theme-on-primary)) 60%, transparent);
    text-decoration: none;
    transition: color var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .copyright-links a:hover {
    color: var(--wc-copyright-text, var(--weline-theme-on-primary));
}

.<?= $wc ?> .police-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-1, 5px);
}

.<?= $wc ?> .police-icon {
    width: 16px;
    height: 16px;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-3, 12px) 0;
    font-size: var(--weline-font-size-xs, 11px);
}
</style>
