<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-product-cross-sell-default.css,Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-product-cross-sell-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js,Weline_Product::css/frontend/product-card.css}
 * 交叉销售部件
 * 
 * @var \Weline\Framework\View\Template $this
 * 
 * @widget.code {cross-sell}
 * @widget.name {交叉销售}
 * @widget.description {展示经常一起购买的产品组合}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["product", "cart"]}
 * @widget.supports {["layout-cart-recommendations","layout-product-cross-sell","layout-product-sidebar"]}
 * 
 * @param title {default="经常一起购买",type="string",label="标题"}
 * @param limit {default=4,type="number",label="显示数量"}
 * @param show_add_all_button {default=true,type="bool",label="显示一键添加按钮"}
 * @param show_total_price {default=true,type="bool",label="显示组合总价"}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */


use Weline\Product\Service\ProductCardRenderer;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('cross-sell');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);
$showPrice = true;
$showRating = true;
$showAddToCart = true;

$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = (string)($this->getData('title') ?? __('经常一起购买'));
$limit = (int)($this->getData('limit') ?? 4);
$showAddAllButton = (bool)($this->getData('show_add_all_button') ?? true);
$showTotalPrice = (bool)($this->getData('show_total_price') ?? true);
$jsonForScriptFlags = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_APOS
    | JSON_HEX_AMP
    | JSON_HEX_QUOT;

$products = ThemeDemoCatalog::products($limit, 70);
$totalPrice = array_sum(array_map(static fn (array $product): float => (float)$product['price'], $products));
foreach ($products as &$product) {
    $product['selected'] = true;
}
unset($product);

$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);

?>


<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"<?= $scopeLabelStyle !== '' ? ' data-widget-style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
    <h3 class="widget-title">
        <w:icon name="link" size="sm"></w:icon>
        <?= htmlspecialchars($title) ?>
    </h3>
    
    <div class="cross-sell-container">
        <div class="cross-sell-products">
            <?php foreach ($products as $index => $product): ?>
                <?php if ($index > 0): ?>
                    <span class="plus-sign">+</span>
                <?php endif; ?>
                <div class="cross-product">
                    <div class="product-checkbox">
                        <input type="checkbox"
                               id="cross-product-<?= (int)($product['id'] ?? 0) ?>"
                               class="cross-checkbox"
                               data-price="<?= (float)($product['price'] ?? 0) ?>"
                               <?= !empty($product['selected']) ? 'checked' : '' ?>>
                        <label for="cross-product-<?= (int)($product['id'] ?? 0) ?>"></label>
                    </div>
                    <?php
                    $labelFlags = ProductLabelStyle::resolveFlags($product, $index);
                    $product['is_demo'] = !empty($labelFlags['is_demo']);
                    $product['is_new'] = !empty($labelFlags['is_new']);
                    $product['is_sale'] = !empty($labelFlags['is_sale']);
                    ?>
                    <w:product:card product="product" show-price="showPrice" show-rating="showRating" show-add-to-cart="showAddToCart" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" density="standard" wishlist-pixel="true" />
                </div>
            <?php endforeach; ?>
        </div>
        
        <div class="cross-sell-summary">
            <?php if ($showTotalPrice): ?>
                <div class="total-price">
                    <span class="label"><?= __('总价') ?>:</span>
                    <span class="value" data-original-total="<?= $totalPrice ?>">¥<?= number_format($totalPrice, 2) ?></span>
                </div>
            <?php endif; ?>
            
            <?php if ($showAddAllButton): ?>
                <button class="btn-add-all" type="button">
                    <w:icon name="cart" size="sm"></w:icon>
                    <span data-cross-sell-label><?= __('全部加入购物车') ?></span>
                </button>
            <?php endif; ?>
            <div class="cross-sell-status" role="status" aria-live="polite"></div>
        </div>
    </div>
</section>

<span hidden data-widget-script="theme-product-cross-sell-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>" data-v1="<?= htmlspecialchars((string)(json_encode((string)__('请至少选择一个商品'), $jsonForScriptFlags)), ENT_QUOTES, 'UTF-8') ?>" data-v2="<?= htmlspecialchars((string)(json_encode((string)__('已添加'), $jsonForScriptFlags)), ENT_QUOTES, 'UTF-8') ?>" data-v3="<?= htmlspecialchars((string)(json_encode((string)__('全部加入购物车'), $jsonForScriptFlags)), ENT_QUOTES, 'UTF-8') ?>"></span>
