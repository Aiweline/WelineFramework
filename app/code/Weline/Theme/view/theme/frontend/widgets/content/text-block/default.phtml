<?php
/**
 * 文本块部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {text-block}
 * @widget.name {文本块}
 * @widget.description {富文本内容区块，支持标题和样式设置}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="内容标题",type="string",label="标题"}
 * @param content {default="",type="rich_text",label="内容"}
 * @param alignment {default="left",type="select",label="对齐方式",options={left:"左对齐",center:"居中",right:"右对齐"}}
 * @param background_color {default="transparent",type="color",label="背景颜色"}
 * @param padding {default="var(--spacing-component-padding)",type="string",label="内边距"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('text-block');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = trim((string)($this->getData('title') ?? __('内容标题')));
$content = (string)($this->getData('content') ?? '');
$alignment = strtolower(trim((string)($this->getData('alignment') ?? 'left')));
if (!in_array($alignment, ['left', 'center', 'right'], true)) {
    $alignment = 'left';
}
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('background_color') ?? '',
    'transparent'
);
$padding = \Weline\Theme\Helper\SiteBlockConfig::length($this->getData('padding'), 'var(--spacing-component-padding)');

$rootStyle = '--wc-text-bg:' . $backgroundColor . ';--wc-text-padding:' . $padding . ';';
?>

<section class="<?= $esc($wc) ?> align-<?= $esc($alignment) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">

    <div class="block-panel">
    <?php if ($title !== ''): ?>
        <h2 class="block-title"><?= $esc($title) ?></h2>
    <?php endif; ?>

    <?php if ($content !== ''): ?>
        <div class="block-content"><?= $content ?></div>
    <?php endif; ?>
    </div>
</section>

<style>
.<?= $wc ?> {
    width: 100%;
    max-width: none;
    padding-inline: 0;
    margin-block: var(--spacing-section-margin);
    color: var(--weline-theme-body-text);
}

.<?= $wc ?> .block-panel {
    border-radius: var(--weline-radius-md);
    background-color: var(--wc-text-bg);
    padding: var(--wc-text-padding);
    color: var(--weline-theme-text);
}

.<?= $wc ?>.align-left { text-align: left; }
.<?= $wc ?>.align-center { text-align: center; }
.<?= $wc ?>.align-right { text-align: right; }

.<?= $wc ?> .block-title {
    font-size: var(--weline-font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--weline-space-4);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .block-content {
    font-size: var(--weline-font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .block-content p {
    margin: 0 0 var(--weline-space-4);
}

.<?= $wc ?> .block-content p:last-child {
    margin-bottom: 0;
}

.<?= $wc ?> .block-content a {
    color: var(--weline-theme-body-link);
    text-decoration: underline;
    text-underline-offset: var(--spacing-0_5);
}

.<?= $wc ?> .block-content a:hover {
    color: var(--color-link-hover);
}

.<?= $wc ?> .block-content ul,
.<?= $wc ?> .block-content ol {
    margin: var(--weline-space-4) 0;
    padding-left: var(--weline-space-6);
}

.<?= $wc ?> .block-content li {
    margin-bottom: var(--weline-space-2);
}

.<?= $wc ?> .block-content--placeholder {
    opacity: 0.65;
    font-style: italic;
}

@media (max-width: 768px) {
    .<?= $wc ?> .block-title {
        font-size: var(--weline-font-size-xl);
    }
}
</style>
