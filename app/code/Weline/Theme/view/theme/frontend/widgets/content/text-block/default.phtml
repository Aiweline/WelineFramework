<?php
/**
 * 文本块部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {text-block}
 * @widget.name {文本块}
 * @widget.description {富文本内容区块，支持标题和样式设置}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="品牌故事",type="string",label="标题"}
 * @param content {default="<p>我们专注提供高品质日常好物，从选材到交付都经过严格质检。</p><p>默认内容可直接预览排版效果，接入 CMS 后可替换为正式文案。</p>",type="textarea",label="内容"}
 * @param alignment {default="left",type="select",label="对齐方式",options={left:"左对齐",center:"居中",right:"右对齐"}}
 * @param background_color {default="transparent",type="color",label="背景颜色"}
 * @param padding {default="20px",type="string",label="内边距"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('text-block');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = trim((string)($this->getData('title') ?? __('品牌故事')));
$content = (string)($this->getData('content') ?? '<p>' . __('我们专注提供高品质日常好物，从选材到交付都经过严格质检。') . '</p><p>' . __('默认内容可直接预览排版效果，接入 CMS 后可替换为正式文案。') . '</p>');
$alignment = strtolower(trim((string)($this->getData('alignment') ?? 'left')));
if (!in_array($alignment, ['left', 'center', 'right'], true)) {
    $alignment = 'left';
}
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('background_color') ?? '',
    'transparent'
);
$padding = trim((string)($this->getData('padding') ?? '20px'));
if (preg_match('/^(?:0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em|%))$/D', $padding) !== 1) {
    $padding = '20px';
}

$rootStyle = '--wc-text-bg:' . $backgroundColor . ';--wc-text-padding:' . $padding . ';';
?>

<section class="<?= $esc($wc) ?> align-<?= $esc($alignment) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">

    <?php if ($title !== ''): ?>
        <h2 class="block-title"><?= $esc($title) ?></h2>
    <?php endif; ?>

    <?php if ($content !== ''): ?>
        <div class="block-content"><?= $content ?></div>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    border-radius: var(--weline-radius-lg);
    background-color: var(--wc-text-bg);
    padding: var(--wc-text-padding);
    color: var(--weline-theme-text);
}

.<?= $wc ?>.align-left { text-align: left; }
.<?= $wc ?>.align-center { text-align: center; }
.<?= $wc ?>.align-right { text-align: right; }

.<?= $wc ?> .block-title {
    font-size: var(--weline-font-size-2xl);
    font-weight: 700;
    margin: 0 0 var(--weline-space-4);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .block-content {
    font-size: var(--weline-font-size-base);
    line-height: 1.7;
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .block-content p {
    margin: 0 0 var(--weline-space-4);
}

.<?= $wc ?> .block-content p:last-child {
    margin-bottom: 0;
}

.<?= $wc ?> .block-content a {
    color: var(--weline-theme-primary);
    text-decoration: underline;
    text-underline-offset: var(--spacing-0_5);
}

.<?= $wc ?> .block-content a:hover {
    color: var(--weline-theme-primary-hover);
}

.<?= $wc ?> .block-content ul,
.<?= $wc ?> .block-content ol {
    margin: var(--weline-space-4) 0;
    padding-left: var(--weline-space-6);
}

.<?= $wc ?> .block-content li {
    margin-bottom: var(--weline-space-2);
}

.<?= $wc ?> .block-content--placeholder {
    opacity: 0.65;
    font-style: italic;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--size-control-xl);
}

@media (max-width: 768px) {
    .<?= $wc ?> .block-title {
        font-size: var(--weline-font-size-xl);
    }
}
</style>
