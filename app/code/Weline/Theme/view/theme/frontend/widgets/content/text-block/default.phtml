<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-content-text-block-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 文本块部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {text-block}
 * @widget.name {文本块}
 * @widget.description {富文本内容区块，支持标题和样式设置}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="内容标题",type="string",label="标题"}
 * @param content {default="",type="rich_text",label="内容"}
 * @param alignment {default="left",type="select",label="对齐方式",options={left:"左对齐",center:"居中",right:"右对齐"}}
 * @param background_color {default="transparent",type="color",label="背景颜色"}
 * @param padding {default="var(--spacing-component-padding)",type="string",label="内边距"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('text-block');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = trim((string)($this->getData('title') ?? __('内容标题')));
$content = (string)($this->getData('content') ?? '');
$alignment = strtolower(trim((string)($this->getData('alignment') ?? 'left')));
if (!in_array($alignment, ['left', 'center', 'right'], true)) {
    $alignment = 'left';
}
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('background_color') ?? '',
    'transparent'
);
$padding = \Weline\Theme\Helper\SiteBlockConfig::length($this->getData('padding'), 'var(--spacing-component-padding)');

$rootStyle = '--wc-text-bg:' . $backgroundColor . ';--wc-text-padding:' . $padding . ';';
?>

<section class="<?= $esc($wc) ?> align-<?= $esc($alignment) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-style="<?= $esc($rootStyle) ?>">

    <div class="block-panel">
    <?php if ($title !== ''): ?>
        <h2 class="block-title"><?= $esc($title) ?></h2>
    <?php endif; ?>

    <?php if ($content !== ''): ?>
        <div class="block-content"><?= $content ?></div>
    <?php endif; ?>
    </div>
</section>

