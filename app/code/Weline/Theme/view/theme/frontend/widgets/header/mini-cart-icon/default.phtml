    font-weight: 600;
}

.<?= $wc ?> .mini-cart-items {
    max-height: var(--size-panel-300);
    overflow-y: auto;
    padding: var(--weline-space-3) 0;
}

.<?= $wc ?> .mini-cart-empty {
    padding: var(--weline-space-6) var(--weline-space-5);
    text-align: center;
