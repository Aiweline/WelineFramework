<?php
/**
 * Header 购物车图标部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {mini-cart-icon}
 * @widget.name {Header 购物车}
 * @widget.description {购物车图标，对接 Weline_Cart 显示真实数量与小计}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions"]}
 *
 * @param show_quantity {default=true,type="bool",label="显示数量"}
 * @param show_subtotal {default=true,type="bool",label="显示小计"}
 * @param icon_style {default="cart",type="select",label="图标样式",options={cart:"购物车",bag:"购物袋",basket:"购物篮"}}
 */

use Weline\Theme\Helper\HeaderCommerceData;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('mini-cart-icon');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showQuantity = (bool)($this->getData('show_quantity') ?? true);
$showSubtotal = (bool)($this->getData('show_subtotal') ?? true);
// Header chrome stays live in theme editor: never skip cart APIs for demo placeholders.
$isDemoChrome = false;

$cart = HeaderCommerceData::resolveCartSummary(false, 20);
$cartQuantity = (int)$cart['cart_count'];
$cartSubtotal = (string)$cart['subtotal_formatted'];
$cartItems = $cart['items'];
$isEmpty = (bool)$cart['is_empty'];
$isDemo = (bool)$cart['is_demo'];
$placeholder = (string)($this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '');

$renderLine = static function (array $item) use ($esc, $placeholder, $cart): string {
    $name = (string)($item['name'] ?? __('商品'));
    $image = LegacyMediaUrl::sanitize((string)($item['image'] ?? '')) ?: $placeholder;
    $qty = (int)($item['qty'] ?? $item['quantity'] ?? 1);
    $price = (float)($item['price'] ?? 0);
    $rowTotal = (float)($item['row_total'] ?? ($price * $qty));
    $priceText = HeaderCommerceData::formatMoney($rowTotal, (string)$cart['currency']);
    $compareAtMinor = max(0, (int)($item['compare_at_minor'] ?? 0));
    $unitMinor = max(0, (int)($item['unit_price_minor'] ?? (int)round($price * 100)));
    $originalPrice = (float)($item['original_price'] ?? ($compareAtMinor > 0 ? $compareAtMinor / 100 : 0));
    $hasDeal = !empty($item['has_deal'])
        || ($compareAtMinor > $unitMinor && $unitMinor > 0)
        || ($originalPrice > $price && $price > 0);
    $campaignLabel = trim((string)($item['campaign_label'] ?? ''));
    $campaignUrl = trim((string)($item['campaign_url'] ?? ''));
    $originalText = $hasDeal && $originalPrice > 0
        ? HeaderCommerceData::formatMoney($originalPrice * max(1, $qty), (string)$cart['currency'])
        : '';
    $itemId = (string)($item['item_id'] ?? '');
    $url = (string)($item['url'] ?? '/cart');
    $options = is_array($item['options'] ?? null) ? $item['options'] : [];
    $optionRows = [];
    foreach ($options as $option) {
        if (!is_array($option)) {
            continue;
        }
        $label = trim((string)($option['label'] ?? $option['code'] ?? ''));
        $value = trim((string)($option['value_label'] ?? $option['value'] ?? ''));
        if ($label === '' || $value === '') {
            continue;
        }
        $swatchImage = LegacyMediaUrl::sanitize((string)($option['swatch_image'] ?? ''));
        $swatchColor = trim((string)($option['swatch_color'] ?? ''));
        if ($swatchColor !== '' && preg_match('/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/', $swatchColor) !== 1) {
            $swatchColor = '';
        }
        $optionRows[] = [
            'label' => $label,
            'value' => $value,
            'swatch_image' => $swatchImage,
            'swatch_color' => $swatchColor,
        ];
    }
    $variant = '';
    if ($optionRows === []) {
        $variant = trim((string)($item['variant_label'] ?? $item['sku'] ?? ''));
        if ($variant === '' && !empty($item['selected_options']) && is_array($item['selected_options'])) {
            $parts = [];
            foreach ($item['selected_options'] as $optionKey => $optionValue) {
                if (is_scalar($optionValue) && (string)$optionValue !== '') {
                    $parts[] = (string)$optionValue;
                } elseif (is_array($optionValue)) {
                    $label = trim((string)($optionValue['label'] ?? $optionValue['value'] ?? ''));
                    if ($label !== '') {
                        $parts[] = $label;
                    }
                } elseif (is_string($optionKey) && $optionKey !== '' && is_scalar($optionValue)) {
                    $parts[] = $optionKey . ': ' . (string)$optionValue;
                }
            }
            $variant = implode(' / ', $parts);
        }
    }

    ob_start();
    ?>
    <article class="mini-cart-drawer__line"
             data-mini-cart-line="1"
             <?= $itemId !== '' ? 'data-item-id="' . $esc($itemId) . '"' : '' ?>>
        <a href="<?= $esc($url) ?>" class="mini-cart-drawer__line-media" tabindex="-1" aria-hidden="true">
            <?php if ($image !== ''): ?>
                <img src="<?= $esc($image) ?>" alt="">
            <?php endif; ?>
        </a>
        <div class="mini-cart-drawer__line-details">
            <a href="<?= $esc($url) ?>" class="mini-cart-drawer__line-title"><?= $esc($name) ?></a>
            <?php if ($optionRows !== []): ?>
                <ul class="mini-cart-drawer__line-options">
                    <?php foreach ($optionRows as $optionRow): ?>
                        <li class="mini-cart-drawer__line-option">
                            <?php if ($optionRow['swatch_image'] !== ''): ?>
                                <img class="mini-cart-drawer__line-option-swatch"
                                     src="<?= $esc($optionRow['swatch_image']) ?>"
                                     alt="">
                            <?php elseif ($optionRow['swatch_color'] !== ''): ?>
                                <span class="mini-cart-drawer__line-option-swatch mini-cart-drawer__line-option-swatch--color"
                                      style="background-color: <?= $esc($optionRow['swatch_color']) ?>"
                                      aria-hidden="true"></span>
                            <?php endif; ?>
                            <span class="mini-cart-drawer__line-option-text">
                                <?= $esc($optionRow['label'] . ': ' . $optionRow['value']) ?>
                            </span>
                        </li>
                    <?php endforeach; ?>
                </ul>
            <?php elseif ($variant !== ''): ?>
                <p class="mini-cart-drawer__line-variant"><?= $esc($variant) ?></p>
            <?php endif; ?>
            <div class="mini-cart-drawer__line-meta">
                <div class="mini-cart-drawer__qty" data-qty-control>
                    <button type="button" data-qty-decrease aria-label="<?= $esc(__('减少数量')) ?>">−</button>
                    <input type="number"
                           class="mini-cart-drawer__qty-input"
                           min="1"
                           max="999"
                           value="<?= $qty ?>"
                           inputmode="numeric"
                           aria-label="<?= $esc(__('数量')) ?>"
                           data-qty-input>
                    <button type="button" data-qty-increase aria-label="<?= $esc(__('增加数量')) ?>">+</button>
                </div>
                <button type="button" class="mini-cart-drawer__remove" data-remove-item>
                    <?= __('移除') ?>
                </button>
            </div>
        </div>
        <div class="mini-cart-drawer__line-price" data-line-total>
            <span class="mini-cart-drawer__line-price-row" data-line-price-row>
                <span class="mini-cart-drawer__line-price-now" data-line-price-now><?= $esc($priceText) ?></span>
                <?php if ($hasDeal && $originalText !== ''): ?>
                    <span class="mini-cart-drawer__line-price-was" data-line-price-was><?= $esc($originalText) ?></span>
                <?php endif; ?>
            </span>
            <?php if ($hasDeal && $originalText !== '' && $campaignLabel !== ''): ?>
                <?php if ($campaignUrl !== ''): ?>
                    <a class="mini-cart-drawer__line-price-campaign"
                       data-line-price-campaign
                       href="<?= $esc($campaignUrl) ?>"><?= $esc($campaignLabel) ?></a>
                <?php else: ?>
                    <span class="mini-cart-drawer__line-price-campaign"
                          data-line-price-campaign><?= $esc($campaignLabel) ?></span>
                <?php endif; ?>
            <?php endif; ?>
        </div>
    </article>
    <?php
    return (string)ob_get_clean();
};
?>
<link rel="stylesheet"
      href="@static(Weline_Theme::css/widgets/mini-cart-drawer.css)&v=20260908-theme-minicart-generic"
      data-no-extract="true"
      data-weline-mini-cart-drawer="1">
<section class="header-cart header-action-item <?= $esc($wc) ?><?= $isEmpty ? ' is-empty' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-w-mini-cart="1"
         data-editor-interactive
         data-weline-load="miniCartIcon,miniCartExtras"
         data-demo-chrome="<?= $isDemoChrome ? '1' : '0' ?>"
         data-preview-mode="0"
         data-cart-count="<?= $cartQuantity ?>"
         data-cart-subtotal="<?= $esc($cartSubtotal) ?>"
         data-i18n-empty="<?= $esc(__('购物车是空的')) ?>"
         data-i18n-continue="<?= $esc(__('继续购物')) ?>"
         data-i18n-remove="<?= $esc(__('移除')) ?>"
         data-i18n-subtotal="<?= $esc(__('小计')) ?>"
         data-i18n-checkout="<?= $esc(__('去结算')) ?>"
         data-i18n-checkout-loading="<?= $esc(__('正在前往结算...')) ?>"
         data-i18n-view-cart="<?= $esc(__('查看购物车')) ?>"
         data-i18n-note="<?= $esc(__('税费与运费将在结算时计算')) ?>"
         data-i18n-qty="<?= $esc(__('数量')) ?>"
         data-i18n-decrease="<?= $esc(__('减少数量')) ?>"
         data-i18n-increase="<?= $esc(__('增加数量')) ?>"
         data-i18n-loading="<?= $esc(__('正在加载购物车...')) ?>"
         data-i18n-updating="<?= $esc(__('正在更新购物车...')) ?>"
         data-i18n-goods-subtotal="<?= $esc(__('商品小计')) ?>"
         data-i18n-discount-coupon="<?= $esc(__('优惠券')) ?>"
         data-i18n-discount-stack="<?= $esc(__('叠加优惠')) ?>"
         data-i18n-discount-automatic="<?= $esc(__('自动优惠')) ?>"
         data-placeholder-image="<?= $esc($placeholder) ?>">
    <a href="@url{'cart'}"
       class="cart-link"
       aria-label="<?= __('购物车') ?>"
       aria-expanded="false"
       aria-controls="mini-cart-drawer"
       data-mini-cart-trigger>
        <span class="cart-icon-wrapper">
            <span class="header-cart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M3 4h1.5l1.2 6.2a2 2 0 0 0 2 1.8h9.1a2 2 0 0 0 1.95-1.55L20 7H6.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="9" cy="19" r="1.4" fill="currentColor" stroke="none"/>
                    <circle cx="17" cy="19" r="1.4" fill="currentColor" stroke="none"/>
                </svg>
            </span>
            <?php if ($showQuantity): ?>
                <span class="cart-count" data-cart-count-badge <?= $cartQuantity > 0 ? '' : 'hidden' ?>>
                    <?= $cartQuantity > 99 ? '99+' : $cartQuantity ?>
                </span>
            <?php endif; ?>
        </span>
        <?php if ($showSubtotal): ?>
            <span class="cart-info">
                <span class="cart-label"><?= __('购物车') ?></span>
                <span class="cart-meta" data-mini-cart-meta>
                    <span data-mini-cart-type-caption hidden></span>
                    <span class="cart-subtotal" data-cart-subtotal-text><?= $esc($cartSubtotal) ?></span>
                </span>
            </span>
        <?php else: ?>
            <span class="cart-info">
                <span class="cart-label"><?= __('购物车') ?></span>
                <span data-mini-cart-type-caption hidden></span>
            </span>
        <?php endif; ?>
    </a>

    <div class="mini-cart-drawer__overlay"
         id="mini-cart-overlay"
         data-mini-cart-overlay
         hidden></div>

    <aside class="mini-cart-drawer mini-cart-drawer--amazon"
           id="mini-cart-drawer"
           role="dialog"
           aria-modal="true"
           aria-label="<?= $esc(__('购物车')) ?>"
           aria-hidden="true"
           data-mini-cart-drawer>
        <header class="mini-cart-drawer__header">
            <div class="mini-cart-drawer__heading">
                <div data-mini-cart-type-host></div>
                <h2 class="mini-cart-drawer__title">
                    <span data-mini-cart-title><?= __('购物车') ?></span>
                    (<span class="item-count" data-cart-item-count><?= $cartQuantity ?></span>)
                </h2>
            </div>
            <button type="button"
                    class="mini-cart-drawer__close"
                    data-mini-cart-close
                    aria-label="<?= $esc(__('关闭')) ?>">
                <w:icon name="close" size="sm"></w:icon>
            </button>
        </header>

        <div class="mini-cart-drawer__body" data-mini-cart-items>
            <div class="mini-cart-drawer__loading" data-mini-cart-loading hidden>
                <span class="mini-cart-drawer__spinner" aria-hidden="true"></span>
                <p><?= __('正在加载购物车...') ?></p>
            </div>
        </div>

        <footer class="mini-cart-drawer__footer" data-mini-cart-footer hidden>
            <w:slot id="footer-extras"
                    layout="mini-cart"
                    name="底部扩展区"
                    accept="layout-mini-cart-footer-extras,mini-cart-coupon,checkout-coupon,order-notice,marketing,order"
                    multiple="true"
                    position="footer"
                    class="mini-cart-drawer__extras"></w:slot>
            <div class="mini-cart-drawer__totals" data-mini-cart-discount-breakdown hidden>
                <div class="mini-cart-drawer__subtotal mini-cart-drawer__subtotal--goods">
                    <span><?= __('商品小计') ?></span>
                    <span data-cart-goods-subtotal><?= $esc($cartSubtotal) ?></span>
                </div>
                <div class="mini-cart-drawer__discount-lines" data-mini-cart-discount-lines></div>
            </div>
            <div class="mini-cart-drawer__subtotal mini-cart-drawer__subtotal--payable">
                <span><?= __('小计') ?></span>
                <strong class="total-amount" data-cart-total-amount><?= $esc($cartSubtotal) ?></strong>
            </div>
            <p class="mini-cart-drawer__note"><?= __('税费与运费将在结算时计算') ?></p>
            <div class="mini-cart-drawer__actions">
                <a href="@url{'checkout'}"
                   class="mini-cart-drawer__btn mini-cart-drawer__btn--primary"
                   data-mini-cart-checkout="1"><?= __('去结算') ?></a>
                <a href="@url{'cart'}" class="mini-cart-drawer__btn mini-cart-drawer__btn--secondary"><?= __('查看购物车') ?></a>
            </div>
        </footer>
    </aside>
</section>

