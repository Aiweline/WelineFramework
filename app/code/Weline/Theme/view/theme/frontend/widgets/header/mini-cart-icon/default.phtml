<?php
/**
 * Header 购物车图标部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {mini-cart-icon}
 * @widget.name {Header 购物车}
 * @widget.description {购物车图标，对接 Weline_Cart 显示真实数量与小计}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions"]}
 *
 * @param show_quantity {default=true,type="bool",label="显示数量"}
 * @param show_subtotal {default=true,type="bool",label="显示小计"}
 * @param icon_style {default="cart",type="select",label="图标样式",options={cart:"购物车",bag:"购物袋",basket:"购物篮"}}
 */

use Weline\Theme\Helper\HeaderCommerceData;
use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('mini-cart-icon');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showQuantity = (bool)($this->getData('show_quantity') ?? true);
$showSubtotal = (bool)($this->getData('show_subtotal') ?? true);

// 预览模式：真实购物车为空/不可用时才回落演示数据，保证主题观察完整性
$cart = HeaderCommerceData::resolveCartSummary($isPreviewMode, 5);
$cartQuantity = (int)$cart['cart_count'];
$cartSubtotal = (string)$cart['subtotal_formatted'];
$cartItems = $cart['items'];
$isEmpty = (bool)$cart['is_empty'];
$isDemo = (bool)$cart['is_demo'];
$placeholder = (string)($this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '');
?>

<section class="header-cart header-action-item <?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?><?= $isEmpty ? ' is-empty' : '' ?><?= $isDemo ? ' is-demo' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-w-mini-cart="1"
         data-preview-mode="<?= $isPreviewMode ? '1' : '0' ?>"
         data-cart-count="<?= $cartQuantity ?>"
         data-cart-subtotal="<?= $esc($cartSubtotal) ?>">
    <a href="/cart" class="cart-link" title="<?= __('购物车') ?>">
        <span class="cart-icon-wrapper">
            <span class="header-cart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M3 4h1.5l1.2 6.2a2 2 0 0 0 2 1.8h9.1a2 2 0 0 0 1.95-1.55L20 7H6.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="9" cy="19" r="1.4" fill="currentColor" stroke="none"/>
                    <circle cx="17" cy="19" r="1.4" fill="currentColor" stroke="none"/>
                </svg>
            </span>
            <?php if ($showQuantity): ?>
                <span class="cart-count" data-cart-count-badge <?= $cartQuantity > 0 ? '' : 'hidden' ?>>
                    <?= $cartQuantity > 99 ? '99+' : $cartQuantity ?>
                </span>
            <?php endif; ?>
        </span>
        <?php if ($showSubtotal): ?>
            <span class="cart-info">
                <span class="cart-label"><?= __('购物车') ?></span>
                <span class="cart-subtotal" data-cart-subtotal-text><?= $esc($cartSubtotal) ?></span>
            </span>
        <?php endif; ?>
    </a>

    <div class="mini-cart-dropdown" data-mini-cart-dropdown>
        <div class="mini-cart-header">
            <span class="mini-cart-title"><?= __('购物车') ?> (<span class="item-count" data-cart-item-count><?= $cartQuantity ?></span>)</span>
        </div>
        <div class="mini-cart-items" data-mini-cart-items>
            <?php if ($isEmpty): ?>
                <div class="mini-cart-empty" data-mini-cart-empty>
                    <p><?= __('购物车是空的') ?></p>
                    <a href="/" class="action-btn action-btn-primary"><?= __('继续购物') ?></a>
                </div>
            <?php else: ?>
                <?php foreach ($cartItems as $item): ?>
                    <?php
                    $name = (string)($item['name'] ?? __('商品'));
                    $image = LegacyMediaUrl::sanitize((string)($item['image'] ?? '')) ?: $placeholder;
                    $qty = (int)($item['qty'] ?? $item['quantity'] ?? 1);
                    $price = (float)($item['price'] ?? 0);
                    $priceText = HeaderCommerceData::formatMoney($price, (string)$cart['currency']);
                    ?>
                    <div class="mini-cart-item">
                        <?php if ($image !== ''): ?>
                            <img src="<?= $esc($image) ?>" alt="<?= $esc($name) ?>" class="item-image">
                        <?php endif; ?>
                        <div class="item-info">
                            <h4 class="item-name"><?= $esc($name) ?></h4>
                            <span class="item-price"><?= $esc($priceText) ?> × <?= $qty ?></span>
                        </div>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
        <div class="mini-cart-footer" data-mini-cart-footer <?= $isEmpty ? 'hidden' : '' ?>>
            <div class="mini-cart-total">
                <span><?= __('小计') ?>:</span>
                <span class="total-amount" data-cart-total-amount><?= $esc($cartSubtotal) ?></span>
            </div>
            <div class="mini-cart-actions">
                <a href="/cart" class="action-btn action-btn-outline"><?= __('查看购物车') ?></a>
                <a href="/checkout" class="action-btn action-btn-primary"><?= __('去结算') ?></a>
            </div>
        </div>
    </div>
</section>

<style>
