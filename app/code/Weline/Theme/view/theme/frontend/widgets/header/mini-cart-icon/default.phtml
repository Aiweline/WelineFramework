<?php
/**
 * Header 购物车图标部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {mini-cart-icon}
 * @widget.name {Header 购物车}
 * @widget.description {购物车图标，显示购物车商品数量和小计}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {user-area}
 * @widget.supports {["layout-header-actions","layout-global-header-actions"]}
 * @widget.default_injections {[{"layout_type":"*","layout_option":"default","slot":"user-area","area":"header","sort_order":1}]}
 *
 * @param show_quantity {default=true,type="bool",label="显示数量"}
 * @param show_subtotal {default=true,type="bool",label="显示小计"}
 * @param icon_style {default="cart",type="select",label="图标样式",options={cart:"购物车",bag:"购物袋",basket:"购物篮"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('mini-cart-icon');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$showQuantity = (bool)($this->getData('show_quantity') ?? true);
$showSubtotal = (bool)($this->getData('show_subtotal') ?? true);
$iconStyle = $this->getData('icon_style') ?? 'cart';
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

$icons = ['cart' => 'pin', 'bag' => 'pin', 'basket' => 'pin'];
$icon = $icons[$iconStyle] ?? $icons['cart'];

$cartQuantity = 3;
$cartSubtotal = '¥299.00';
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <a href="/cart" class="cart-link" title="<?= __('购物车') ?>">
        <span class="cart-icon-wrapper">
            <w:icon name="icon|pin" size="sm"></w:icon>
            <?php if ($showQuantity && $cartQuantity > 0): ?>
                <span class="cart-count"><?= $cartQuantity > 99 ? '99+' : $cartQuantity ?></span>
            <?php endif; ?>
        </span>
        <?php if ($showSubtotal): ?>
            <span class="cart-info">
                <span class="cart-label"><?= __('购物车') ?></span>
                <span class="cart-subtotal"><?= $esc($cartSubtotal) ?></span>
            </span>
        <?php endif; ?>
    </a>

    <div class="mini-cart-dropdown">
        <div class="mini-cart-header">
            <span class="mini-cart-title"><?= __('购物车') ?> (<span class="item-count"><?= $cartQuantity ?></span>)</span>
        </div>
        <div class="mini-cart-items">
            <div class="mini-cart-item">
                <img src="<?= $esc($placeholder) ?>" alt="Product" class="item-image">
                <div class="item-info">
                    <h4 class="item-name"><?= __('示例商品名称') ?></h4>
                    <span class="item-price">¥99.00 × 1</span>
                </div>
                <button class="item-remove" type="button" title="<?= __('删除') ?>">
                    <w:icon name="close" size="sm"></w:icon>
                </button>
            </div>
        </div>
        <div class="mini-cart-footer">
            <div class="mini-cart-total">
                <span><?= __('小计') ?>:</span>
                <span class="total-amount"><?= $esc($cartSubtotal) ?></span>
            </div>
            <div class="mini-cart-actions">
                <a href="/cart" class="action-btn action-btn-outline"><?= __('查看购物车') ?></a>
                <a href="/checkout" class="action-btn action-btn-primary"><?= __('去结算') ?></a>
            </div>
        </div>
    </div>
</section>

