    position: absolute;
    top: var(--token-size-4px);
    right: var(--token-size-2px);
    min-width: var(--font-size-lg);
    height: var(--font-size-lg);
    background: var(--weline-chrome-primary, var(--weline-theme-primary));
    color: var(--weline-chrome-text-primary, var(--color-text-primary));
    font-size: var(--weline-font-size-xs);
    font-weight: 600;
    border-radius: var(--weline-radius-round);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--weline-space-1);
}

