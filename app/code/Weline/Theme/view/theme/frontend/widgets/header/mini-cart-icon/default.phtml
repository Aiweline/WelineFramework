    padding: var(--weline-space-4) var(--weline-space-5);
    border-top: var(--border-width-thin) solid var(--weline-theme-border);
    background: var(--weline-theme-surface-muted);
}

.<?= $wc ?> .mini-cart-total {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--weline-space-4);
}

.<?= $wc ?> .total-amount {
    font-weight: 700;
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .mini-cart-actions {
    display: flex;
    gap: var(--weline-space-3);
}

.<?= $wc ?> .action-btn {
    flex: 1;
    padding: var(--weline-space-3) var(--weline-space-4);
    text-align: center;
    border-radius: var(--weline-radius-md);
    font-weight: 500;
    text-decoration: none;
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .action-btn-outline {
    border: var(--border-width-thin) solid var(--weline-theme-border);
    color: var(--weline-theme-text);
    background: var(--color-bg-primary);
}

.<?= $wc ?> .action-btn-primary {
    background: var(--weline-theme-primary);
    color: var(--color-bg-primary);
}

.widget-preview-canvas .<?= $wc ?> .mini-cart-dropdown,
.<?= $wc ?>.is-preview .mini-cart-dropdown {
    display: none;
}

@media (max-width: 768px) {
    .<?= $wc ?> .cart-info {
        display: none;
    }

    .<?= $wc ?> .cart-link {
        padding: var(--spacing-1_5);
        min-width: var(--size-control-lg);
        min-height: var(--size-control-lg);
        justify-content: center;
    }

    .<?= $wc ?> .cart-count[hidden] {
        display: flex !important;
    }

    .<?= $wc ?> .mini-cart-dropdown {
        display: none;
    }
