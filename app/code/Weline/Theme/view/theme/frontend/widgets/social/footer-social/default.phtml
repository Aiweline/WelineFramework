<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-social-footer-social-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 页脚社交图标部件
 *
 * @widget.code {footer-social}
 * @widget.name {页脚社交图标}
 * @widget.description {Footer 区域的社交媒体图标链接}
 * @widget.type {social}
 * @widget.area {frontend}
 * @widget.position {["footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {social}
 * @widget.supports {["layout-footer-social","layout-global-footer-social"]}
 * @widget.exclusive {true}
 *
 * @param title {default="",name="标题",description="部件标题，可选",type=string}
 * @param custom_links {default="",name="自定义社交链接",description="JSON格式的自定义社交链接配置",type=string}
 * @param alignment {default="left",name="对齐方式",description="图标对齐方式",type=select,options={left:"左对齐",center:"居中",right:"右对齐"}}
 * @param icon_size {default="medium",name="图标尺寸",description="图标大小",type=select,options={small:"小号",medium:"中号",large:"大号"}}
 * @param icon_style {default="colored",name="图标样式",description="图标显示样式",type=select,options={colored:"彩色",mono:"单色",outline:"线框"}}
 * @param gap {default="10px",name="图标间距",description="图标之间的间距",type=string}
 *
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\SocialIconHelper;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('footer-social');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? '';
$alignment = $this->getData('alignment') ?? 'left';
$iconSize = $this->getData('icon_size') ?? 'medium';
$iconStyle = $this->getData('icon_style') ?? 'colored';
$gap = $this->getData('gap') ?? '10px';

$safeHref = static function (mixed $url): string {
    $url = LegacyMediaUrl::sanitize($url);

    return $url !== '' && !str_starts_with($url, '#') ? $url : '';
};

if (preg_match('/^(\d{1,3}(?:\.\d{1,2})?)(px|rem|em)$/', trim((string)$gap), $gapMatch)) {
    $gap = rtrim(rtrim(number_format((float)$gapMatch[1], 2, '.', ''), '0'), '.') . $gapMatch[2];
} else {
    $gap = '10px';
}

if (!in_array($alignment, ['left', 'center', 'right'], true)) $alignment = 'left';
if (!in_array($iconSize, ['small', 'medium', 'large'], true)) $iconSize = 'medium';
if (!in_array($iconStyle, ['colored', 'mono', 'outline'], true)) $iconStyle = 'colored';

$customLinks = $this->getData('custom_links') ?? '';
$socials = [];

if ($customLinks) {
    $customLinksArray = json_decode((string)$customLinks, true);
    if (is_array($customLinksArray)) {
        foreach ($customLinksArray as $link) {
            if (!empty($link['platform']) && !empty($link['url'])) {
                $platform = preg_replace('/[^a-z0-9_-]/', '', strtolower((string)$link['platform'])) ?: 'link';
                $url = $safeHref($link['url']);
                if ($url === '') {
                    continue;
                }
                $socials[] = [
                    'platform' => $platform,
                    'name' => SocialIconHelper::getName($platform) ?? $link['name'] ?? $platform,
                    'url' => $url,
                    'color' => SocialIconHelper::getColor($platform) ?? '#666',
                ];
            }
        }
    }
}

if (empty($socials)) {
    foreach (['facebook', 'twitter', 'instagram', 'youtube', 'linkedin', 'pinterest', 'tiktok', 'weibo', 'wechat', 'github', 'telegram', 'whatsapp', 'discord', 'reddit', 'snapchat'] as $platform) {
        $url = $this->getData($platform) ?? '';
        if ($url) {
            $url = $safeHref($url);
            if ($url === '') {
                continue;
            }
            $socials[] = [
                'platform' => $platform,
                'name' => SocialIconHelper::getName($platform) ?? ucfirst($platform),
                'url' => $url,
                'color' => SocialIconHelper::getColor($platform) ?? '#666',
            ];
        }
    }
}

if ($socials === [] && !$isPreviewMode) {
    return;
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-size="<?= $esc($iconSize) ?>"
         data-style="<?= $esc($iconStyle) ?>"
         data-align="<?= $esc($alignment) ?>"
         data-widget-style="--wc-social-gap: <?= $esc($gap) ?>;">
    <?php if ($title !== ''): ?>
        <h4 class="social-title"><?= $esc((string)$title) ?></h4>
    <?php endif; ?>
    <div class="social-links">
        <?php foreach ($socials as $social): ?>
            <a href="<?= $esc((string)$social['url']) ?>"
               class="social-link social-link-<?= $esc((string)$social['platform']) ?>"
               title="<?= $esc((string)$social['name']) ?>"
               target="_blank"
               rel="noopener noreferrer"
               data-widget-style="--brand-color: <?= $esc((string)$social['color']) ?>;">
                <?= SocialIconHelper::renderIcon($social['platform'], ['class' => 'social-icon', 'width' => '20', 'height' => '20']) ?>
            </a>
        <?php endforeach; ?>
    </div>
</section>

