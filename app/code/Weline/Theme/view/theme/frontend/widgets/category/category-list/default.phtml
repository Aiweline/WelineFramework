$parentId = (int)($this->getData('parent_id') ?? 0);
$maxDepth = max(1, min(5, (int)($this->getData('max_depth') ?? 2)));
$showCount = (bool)($this->getData('show_count') ?? false);
$showImage = (bool)($this->getData('show_image') ?? false);
$collapsed = (bool)($this->getData('collapsed') ?? false);
$searchHref = static fn (string $query): string => '/search?q=' . rawurlencode($query);

$categories = [
    [
        'id' => 1,
        'name' => __('女士汉服'),
        'url' => $searchHref('女士汉服'),
        'children' => [
            ['id' => 11, 'name' => __('明制汉服'), 'url' => $searchHref('明制汉服')],
            ['id' => 12, 'name' => __('宋制汉服'), 'url' => $searchHref('宋制汉服')],
            ['id' => 13, 'name' => __('唐制汉服'), 'url' => $searchHref('唐制汉服')],
        ],
    ],
    [
        'id' => 2,
        'name' => __('男士汉服'),
        'url' => $searchHref('男士汉服'),
        'children' => [
            ['id' => 21, 'name' => __('道袍与直裰'), 'url' => $searchHref('道袍 直裰')],
