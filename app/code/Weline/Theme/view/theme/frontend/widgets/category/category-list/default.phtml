        'url' => $searchHref('儿童汉服'),
        'children' => [
            ['id' => 31, 'name' => __('女童汉服'), 'url' => $searchHref('女童汉服')],
            ['id' => 32, 'name' => __('男童汉服'), 'url' => $searchHref('男童汉服')],
            ['id' => 33, 'name' => __('亲子系列'), 'url' => $searchHref('亲子汉服')],
        ],
    ],
    [
        'id' => 4,
        'name' => __('汉服配饰'),
        // 分类页有货；勿链 /search?q=汉服配饰（QA-03：仅 blog/FAQ）
        'url' => '/category/accessories',
        'children' => [
