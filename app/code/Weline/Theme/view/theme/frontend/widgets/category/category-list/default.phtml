            <w:icon name="grid" size="sm"></w:icon>
            <?= $esc($title) ?>
        </h3>
    <?php endif; ?>

    <?php $renderCategoryList($categories, 0, $maxDepth, $showCount, $showImage, $collapsed); ?>
</section>

<span hidden data-widget-script="theme-category-category-list-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
