<?php
/**
 * 分类列表部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {category-list}
 * @widget.name {分类列表}
 * @widget.description {以列表形式展示商品分类，支持多级嵌套}
 * @widget.type {category}
 * @widget.area {frontend}
 * @widget.position {["sidebar", "content"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="商品分类",type="string",label="标题"}
 * @param parent_id {default=0,type="number",label="父分类ID",description="0表示显示所有顶级分类"}
 * @param max_depth {default=2,type="number",label="最大层级"}
 * @param show_count {default=true,type="bool",label="显示产品数量"}
 * @param show_image {default=false,type="bool",label="显示分类图片"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('category-list');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = (string)($this->getData('title') ?? __('商品分类'));
$parentId = (int)($this->getData('parent_id') ?? 0);
$maxDepth = max(1, min(5, (int)($this->getData('max_depth') ?? 2)));
$showCount = (bool)($this->getData('show_count') ?? true);
$showImage = (bool)($this->getData('show_image') ?? false);
$collapsed = (bool)($this->getData('collapsed') ?? false);
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png') ?? '';

$categories = [
    [
        'id' => 1,
        'name' => __('电子产品'),
        'url' => '/category/electronics',
        'image' => $placeholder,
        'count' => 156,
        'children' => [
            ['id' => 11, 'name' => __('手机'), 'url' => '/category/phones', 'count' => 45],
            ['id' => 12, 'name' => __('电脑'), 'url' => '/category/computers', 'count' => 38],
            ['id' => 13, 'name' => __('平板'), 'url' => '/category/tablets', 'count' => 22],
        ],
    ],
    [
        'id' => 2,
        'name' => __('服装鞋帽'),
        'url' => '/category/fashion',
        'image' => $placeholder,
        'count' => 243,
        'children' => [
            ['id' => 21, 'name' => __('男装'), 'url' => '/category/mens', 'count' => 89],
            ['id' => 22, 'name' => __('女装'), 'url' => '/category/womens', 'count' => 112],
            ['id' => 23, 'name' => __('童装'), 'url' => '/category/kids', 'count' => 42],
        ],
    ],
    [
        'id' => 3,
        'name' => __('家居生活'),
        'url' => '/category/home',
        'image' => $placeholder,
        'count' => 178,
        'children' => [
            ['id' => 31, 'name' => __('家具'), 'url' => '/category/furniture', 'count' => 56],
            ['id' => 32, 'name' => __('家纺'), 'url' => '/category/textiles', 'count' => 67],
            ['id' => 33, 'name' => __('收纳'), 'url' => '/category/storage', 'count' => 55],
        ],
    ],
    [
        'id' => 4,
        'name' => __('美妆个护'),
        'url' => '/category/beauty',
        'count' => 134,
    ],
    [
        'id' => 5,
        'name' => __('食品生鲜'),
        'url' => '/category/food',
        'count' => 89,
    ],
];

$renderCategoryList = static function (
    array $items,
    int $depth = 0,
    int $maxDepth = 2,
    bool $showCount = true,
    bool $showImage = false,
    bool $collapsed = false
) use (&$renderCategoryList, $esc): void {
    if ($depth >= $maxDepth || $items === []) {
        return;
    }

    $isCollapsed = $collapsed && $depth > 0;
    echo '<ul class="category-list depth-' . $depth . '"' . ($isCollapsed ? ' hidden' : '') . '>';
    foreach ($items as $category) {
        $hasChildren = !empty($category['children']);
        echo '<li class="category-item' . ($hasChildren ? ' has-children' : '') . '">';
        echo '<a href="' . $esc((string)($category['url'] ?? '#')) . '" class="category-link">';

        if ($showImage && !empty($category['image'])) {
            echo '<img src="' . $esc((string)$category['image']) . '" alt="' . $esc((string)($category['name'] ?? '')) . '" class="category-image" loading="lazy">';
        }

        echo '<span class="category-name">' . $esc((string)($category['name'] ?? '')) . '</span>';

        if ($showCount && isset($category['count'])) {
            echo '<span class="category-count">(' . (int)$category['count'] . ')</span>';
        }

        echo '</a>';

        if ($hasChildren) {
            echo '<button class="toggle-btn' . ($isCollapsed ? ' is-collapsed' : '') . '" type="button" aria-expanded="' . ($isCollapsed ? 'false' : 'true') . '">';
            echo '<w:icon name="chevron-right" size="sm"></w:icon>';
            echo '</button>';
            $renderCategoryList(
                $category['children'],
                $depth + 1,
                $maxDepth,
                $showCount,
                $showImage,
                $collapsed
            );
        }

        echo '</li>';
    }
    echo '</ul>';
};
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">

    <?php if ($title !== ''): ?>
        <h3 class="list-title">
            <w:icon name="grid" size="sm"></w:icon>
            <?= $esc($title) ?>
        </h3>
    <?php endif; ?>

    <?php $renderCategoryList($categories, 0, $maxDepth, $showCount, $showImage, $collapsed); ?>
</section>

<style>
.<?= $wc ?> {
    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg);
    padding: var(--weline-space-5);
    border: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .list-title {
    font-size: var(--weline-font-size-base);
    font-weight: 600;
    margin: 0 0 var(--weline-space-4);
    padding-bottom: var(--weline-space-4);
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
    display: flex;
    align-items: center;
    gap: var(--weline-space-2);
    color: var(--weline-theme-text);
}

.<?= $wc ?> .list-title w-icon,
.<?= $wc ?> .list-title [class*="icon"] {
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.<?= $wc ?> .category-list[hidden] {
    display: none;
}

.<?= $wc ?> .category-list.depth-1,
.<?= $wc ?> .category-list.depth-2 {
    padding-left: var(--weline-space-4);
    margin-top: var(--weline-space-1);
}

.<?= $wc ?> .category-item {
    position: relative;
}

.<?= $wc ?> .category-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-3);
    padding: var(--weline-space-3) var(--weline-space-8) var(--weline-space-3) 0;
    color: var(--weline-theme-text);
    text-decoration: none;
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style)
        color-mix(in srgb, var(--weline-theme-border) 50%, transparent);
    transition: all var(--weline-theme-transition-base);
}

.<?= $wc ?> .category-item:last-child > .category-link {
    border-bottom: none;
}

.<?= $wc ?> .category-link:hover {
    color: var(--weline-theme-primary);
    padding-left: var(--weline-space-1);
}

.<?= $wc ?> .category-image {
    width: var(--spacing-7);
    height: var(--spacing-7);
    border-radius: var(--weline-radius-md);
    object-fit: cover;
}

.<?= $wc ?> .category-name {
    flex: 1;
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .category-count {
    font-size: var(--weline-font-size-xs);
    color: var(--weline-theme-text-muted);
}

.<?= $wc ?> .toggle-btn {
    position: absolute;
    right: 0;
    top: var(--spacing-sm);
    width: var(--spacing-lg);
    height: var(--spacing-lg);
    background: transparent;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--weline-theme-text-muted);
    transition: all var(--weline-theme-transition-base);
}

.<?= $wc ?> .toggle-btn:hover {
    color: var(--weline-theme-primary);
}

.<?= $wc ?> .toggle-btn.is-collapsed {
    transform: rotate(0deg);
}

.<?= $wc ?> .toggle-btn:not(.is-collapsed) {
    transform: rotate(90deg);
}

.<?= $wc ?> .depth-1 .category-link {
    padding: var(--weline-space-2) var(--weline-space-8) var(--weline-space-2) 0;
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .depth-2 .category-link {
    padding: var(--weline-space-1) var(--weline-space-8) var(--weline-space-1) 0;
    font-size: var(--weline-font-size-xs);
    color: var(--weline-theme-text-muted);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--sidebar-collapsed-width);
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    root.querySelectorAll('.toggle-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var item = btn.closest('.category-item');
            if (!item) return;
            var subList = item.querySelector(':scope > .category-list');
            if (!subList) return;

            var isHidden = subList.hasAttribute('hidden');
            if (isHidden) {
                subList.removeAttribute('hidden');
            } else {
                subList.setAttribute('hidden', '');
            }
            btn.classList.toggle('is-collapsed', !isHidden);
            btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
        });
    });
})();
</script>
