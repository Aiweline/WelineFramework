<?php
/**
 * @widget.source {Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-header-top-bar-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * @widget.layout_source {Weline_Theme::css/widgets/widget-header-top-bar-default.css}
 * 页头店铺通知条目（notice 类型，可多个并排放入 top-bar 槽）
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {top-bar}
 * @widget.name {店铺通知}
 * @widget.description {页头顶部通知条目。仅可放入「店铺通知」槽，可与其他通知部件并排。}
 * @widget.type {notice}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {top-bar}
 * @widget.supports {["notice","layout-header-notice","layout-header-announcement","top-bar","site-notice","announcement"]}
 * @widget.exclusive {false}
 *
 * @param text {default="欢迎光临 · 精选好物上新",type="string",label="通知文案",i18n=true}
 * @param link_text {default="",type="string",label="链接文字",i18n=true}
 * @param link_url {default="",type="string",label="链接地址",i18n=false}
 * @param show_icon {default=true,type="bool",label="显示喇叭图标",i18n=false}
 * @param closeable {default=false,type="bool",label="允许关闭",i18n=false}
 * @param text_color {default="",type="color",label="文字色",i18n=false}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('top-bar');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
// text/link_text：布局存中文源串；SlotRenderer 已按 locale 合并部件 meta 译文。
// WidgetI18n 仅兜底仍为中文源串、且无 meta 覆盖时的 CSV 翻译。
$text = WidgetI18n::label(trim((string)($this->getData('text') ?? '')), '欢迎光临 · 精选好物上新');
$linkText = WidgetI18n::label(trim((string)($this->getData('link_text') ?? '')), '');
$linkUrl = \Weline\Theme\Helper\LegacyMediaUrl::sanitize((string)($this->getData('link_url') ?? ''));
$showIcon = (bool)($this->getData('show_icon') ?? true);
$closeable = (bool)($this->getData('closeable') ?? false);
$textColor = ThemeUiColor::sanitize((string)($this->getData('text_color') ?? ''), '');

$rootStyle = $textColor !== '' ? ('--wc-notice-text:' . $textColor . ';') : '';
?>

<section class="<?= $esc($wc) ?> header-site-notice-item<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-type="notice"
         <?php if ($rootStyle !== ''): ?>data-widget-style="<?= $esc($rootStyle) ?>"<?php endif; ?>>
    <?php if ($showIcon): ?>
        <i class="fas fa-bullhorn" aria-hidden="true"></i>
    <?php endif; ?>
    <span class="notice-text"><?= $esc($text) ?></span>
    <?php if ($linkUrl !== '' && $linkText !== ''): ?>
        <a class="notice-link" href="<?= $esc($linkUrl) ?>"><?= $esc($linkText) ?></a>
    <?php endif; ?>
    <?php if ($closeable): ?>
        <button type="button" class="notice-close" aria-label="<?= $esc((string)__('关闭通知')) ?>" data-notice-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    <?php endif; ?>
</section>

<?php if ($closeable): ?>
<span hidden data-widget-script="theme-header-top-bar-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
<?php endif; ?>
