<?php
/**
 * 页头店铺通知条目（notice 类型，可多个并排放入 top-bar 槽）
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {top-bar}
 * @widget.name {店铺通知}
 * @widget.description {页头顶部通知条目。仅可放入「店铺通知」槽，可与其他通知部件并排。}
 * @widget.type {notice}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {top-bar}
 * @widget.supports {["notice","layout-header-notice","layout-header-announcement","top-bar","site-notice","announcement"]}
 * @widget.exclusive {false}
 *
 * @param text {default="欢迎光临！满 ¥299 包邮 · 新客首单立减",type="string",label="通知文案"}
 * @param link_text {default="",type="string",label="链接文字"}
 * @param link_url {default="",type="string",label="链接地址"}
 * @param show_icon {default=true,type="bool",label="显示喇叭图标"}
 * @param closeable {default=false,type="bool",label="允许关闭"}
 * @param text_color {default="",type="color",label="文字色"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('top-bar');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$text = WidgetI18n::label(trim((string)($this->getData('text') ?? '')), '欢迎光临！满 ¥299 包邮 · 新客首单立减');
$linkText = WidgetI18n::label(trim((string)($this->getData('link_text') ?? '')), '');
$linkUrl = \Weline\Theme\Helper\LegacyMediaUrl::sanitize((string)($this->getData('link_url') ?? ''));
$showIcon = (bool)($this->getData('show_icon') ?? true);
$closeable = (bool)($this->getData('closeable') ?? false);
$textColor = ThemeUiColor::sanitize((string)($this->getData('text_color') ?? ''), '');

$rootStyle = $textColor !== '' ? ('--wc-notice-text:' . $textColor . ';') : '';
?>

<section class="<?= $esc($wc) ?> header-site-notice-item<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-widget-type="notice"
         <?php if ($rootStyle !== ''): ?>style="<?= $esc($rootStyle) ?>"<?php endif; ?>>
    <?php if ($showIcon): ?>
        <i class="fas fa-bullhorn" aria-hidden="true"></i>
    <?php endif; ?>
    <span class="notice-text"><?= $esc($text) ?></span>
    <?php if ($linkUrl !== '' && $linkText !== ''): ?>
        <a class="notice-link" href="<?= $esc($linkUrl) ?>"><?= $esc($linkText) ?></a>
    <?php endif; ?>
    <?php if ($closeable): ?>
        <button type="button" class="notice-close" aria-label="<?= $esc((string)__('关闭通知')) ?>" data-notice-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-0_45);
    min-width: 0;
    max-width: 100%;
    color: var(--wc-notice-text, inherit);
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    line-height: 1.4;
}

.<?= $wc ?> .notice-text {
    min-width: 0;
}

.<?= $wc ?> .notice-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: var(--spacing-0_5);
    white-space: nowrap;
}

.<?= $wc ?> .notice-close {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    padding: var(--token-size-0-1rem) var(--token-size-0-3rem);
    opacity: 0.75;
}

.<?= $wc ?> .notice-close:hover {
    opacity: 1;
}

.<?= $wc ?>.is-hidden {
    display: none !important;
}
</style>

<?php if ($closeable): ?>
<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;
    var btn = root.querySelector('[data-notice-close]');
    if (!btn) return;
    var key = 'weline-notice-hidden:' + root.getAttribute('data-uid');
    btn.addEventListener('click', function () {
        root.classList.add('is-hidden');
        try { sessionStorage.setItem(key, '1'); } catch (e) {}
    });
    try {
        if (sessionStorage.getItem(key) === '1') {
            root.classList.add('is-hidden');
        }
    } catch (e) {}
})();
</script>
<?php endif; ?>
