<?php
/**
 * @widget.source {Weline_Theme::css/widgets/widget-banner-promo-banner-default.css,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * 促销横幅部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {promo-banner}
 * @widget.name {促销横幅}
 * @widget.description {顶部促销横幅，支持倒计时和关闭功能}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content", "header"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-homepage-promo","layout-homepage-hero","layout-cms-hero","layout-default-content"]}
 *
 * @param background_image {default="",type="media_image",label="背景图片",description="从媒体库选择背景图"}
 * @param background_color {default="var(--weline-theme-primary-subtle)",type="color",label="背景颜色"}
 * @param text {default="运费以结算页为准",type="string",label="促销文字"}
 * @param text_color {default="var(--weline-theme-primary-text-emphasis)",type="color",label="文字颜色"}
 * @param text_show_background {default=false,type="bool",label="促销文字显示背景"}
 * @param text_background_color {default="var(--weline-theme-primary-surface)",type="color",label="促销文字背景色"}
 * @param text_show_border {default=false,type="bool",label="促销文字显示边框"}
 * @param text_border_color {default="var(--weline-theme-primary-text-emphasis)",type="color",label="促销文字边框色"}
 * @param text_show_shadow {default=false,type="bool",label="促销文字显示阴影"}
 * @param link {default="",type="string",label="链接地址"}
 * @param closeable {default=true,type="bool",label="允许关闭"}
 * @param countdown_end {default="",type="string",label="倒计时结束时间",description="格式：2026-12-31 23:59:59"}
 * @param countdown_show_background {default=true,type="bool",label="倒计时显示背景"}
 * @param countdown_background_color {default="",type="color",label="倒计时背景色",description="空则跟随文字色半透明"}
 * @param countdown_show_border {default=false,type="bool",label="倒计时显示边框"}
 * @param countdown_border_color {default="var(--weline-theme-primary-text-emphasis)",type="color",label="倒计时边框色"}
 * @param countdown_show_shadow {default=false,type="bool",label="倒计时显示阴影"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('promo-banner');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$backgroundImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize(
    $this->getData('background_image') ?? '',
    true,
);
$backgroundImageFileHtml = (string)($this->getData('background_image_file_html') ?? '');
if ($backgroundImageFileHtml !== '') {
    // file-image 常带英文 figcaption；促销主文案已在 .promo-text，剥离避免串语（WO-HP-P1-04）
    $backgroundImageFileHtml = (string)preg_replace(
        '#<figcaption\b[^>]*>.*?</figcaption>#is',
        '',
        $backgroundImageFileHtml
    );
}
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('background_color') ?? '',
    'var(--weline-theme-primary-subtle)'
);
$text = WidgetI18n::label(trim((string)($this->getData('text') ?? '')), '运费以结算页为准');
$textColor = ThemeUiColor::sanitize(
    $this->getData('text_color') ?? '',
    'var(--weline-theme-primary-text-emphasis)'
);
$textShowBackground = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('text_show_background'), false);
$textShowBorder = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('text_show_border'), false);
$textBackgroundColor = ThemeUiColor::sanitize(
    $this->getData('text_background_color') ?? '',
    'var(--weline-theme-primary-surface)'
);
$textBorderColor = ThemeUiColor::sanitize(
    $this->getData('text_border_color') ?? '',
    'var(--weline-theme-primary-text-emphasis)'
);
$textShowShadow = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('text_show_shadow'), false);
$link = \Weline\Theme\Helper\SiteBlockConfig::link($this->getData('link') ?? '');
$closeable = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('closeable'), true);
$countdownEnd = trim((string)($this->getData('countdown_end') ?? ''));
$hasCountdown = $countdownEnd !== '';
$countdownShowBackground = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('countdown_show_background'), true);
$countdownShowBorder = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('countdown_show_border'), false);
$countdownBackgroundRaw = trim((string)($this->getData('countdown_background_color') ?? ''));
$countdownBackgroundColor = $countdownBackgroundRaw !== ''
    ? ThemeUiColor::sanitize($countdownBackgroundRaw, '')
    : '';
$countdownBorderColor = ThemeUiColor::sanitize(
    $this->getData('countdown_border_color') ?? '',
    'var(--weline-theme-primary-text-emphasis)'
);
$countdownShowShadow = \Weline\Theme\Helper\SiteBlockConfig::boolean($this->getData('countdown_show_shadow'), false);

$textChipClass = 'promo-text'
    . ($textShowBackground ? ' has-bg' : '')
    . ($textShowBorder ? ' has-border' : '')
    . ($textShowShadow ? ' has-shadow' : '');
$countdownChipClass = 'promo-countdown'
    . ($countdownShowBackground ? ' has-bg' : '')
    . ($countdownShowBorder ? ' has-border' : '')
    . ($countdownShowShadow ? ' has-shadow' : '');

$rootStyle = '--wc-promo-bg:' . $backgroundColor . ';--wc-promo-text:' . $textColor . ';';
$rootStyle .= '--wc-promo-text-bg:' . $textBackgroundColor . ';';
$rootStyle .= '--wc-promo-text-border:' . $textBorderColor . ';';
$rootStyle .= '--wc-promo-countdown-border:' . $countdownBorderColor . ';';
if ($countdownBackgroundColor !== '') {
    $rootStyle .= '--wc-promo-countdown-bg:' . $countdownBackgroundColor . ';';
}
if ($backgroundImageFileHtml === '' && $backgroundImage !== '') {
    $rootStyle .= 'background-image:url("' . $esc($backgroundImage) . '");';
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-weline-load="siteBlocks" data-site-block="promo"
         data-widget-style="<?= $esc($rootStyle) ?>">
    <?php if ($backgroundImageFileHtml !== ''): ?>
        <div class="promo-background"><?= $backgroundImageFileHtml ?></div>
    <?php endif; ?>

    <div class="promo-content">
        <?php if ($link !== ''): ?>
            <a href="<?= $esc($link) ?>" class="promo-link">
        <?php endif; ?>

        <span class="<?= $esc($textChipClass) ?>"><?= $esc((string)$text) ?></span>

        <?php if ($hasCountdown): ?>
            <span class="<?= $esc($countdownChipClass) ?>" data-end="<?= $esc($countdownEnd) ?>">
                <span class="countdown-label"><?= __('剩余') ?>:</span>
                <span class="countdown-timer">
                    <span class="time-part" data-unit="days"><span class="time-value">00</span><span class="time-label"><?= __('天') ?></span></span>
                    <span class="time-part" data-unit="hours"><span class="time-value">00</span><span class="time-label"><?= __('时') ?></span></span>
                    <span class="time-part" data-unit="minutes"><span class="time-value">00</span><span class="time-label"><?= __('分') ?></span></span>
                    <span class="time-part" data-unit="seconds"><span class="time-value">00</span><span class="time-label"><?= __('秒') ?></span></span>
                </span>
            </span>
        <?php endif; ?>

        <?php if ($link !== ''): ?>
            <span class="promo-arrow"><w:icon name="arrow-right" size="sm"></w:icon></span>
            </a>
        <?php endif; ?>
    </div>

    <?php if ($closeable): ?>
        <button class="promo-close" type="button" aria-label="<?= __('关闭') ?>">
            <w:icon name="close" size="sm"></w:icon>
        </button>
    <?php endif; ?>
</section>

