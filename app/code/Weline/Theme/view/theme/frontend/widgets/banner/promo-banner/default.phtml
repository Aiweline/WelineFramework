<?php
/**
 * 促销横幅部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {promo-banner}
 * @widget.name {促销横幅}
 * @widget.description {顶部促销横幅，支持倒计时和关闭功能}
 * @widget.type {banner}
 * @widget.area {frontend}
 * @widget.position {["content", "header"]}
 * @widget.page_layouts {["*"]}
 * @widget.supports {["layout-homepage-promo","layout-homepage-hero","layout-cms-hero","layout-default-content"]}
 *
 * @param background_image {default="",type="media_image",label="背景图片",description="从媒体库选择背景图"}
 * @param background_color {default="var(--weline-theme-danger-surface)",type="color",label="背景颜色"}
 * @param text {default="限时特惠！全场满300减50",type="string",label="促销文字"}
 * @param text_color {default="var(--weline-theme-danger)",type="color",label="文字颜色"}
 * @param link {default="",type="string",label="链接地址"}
 * @param closeable {default=true,type="bool",label="允许关闭"}
 * @param countdown_end {default="",type="string",label="倒计时结束时间",description="格式：2026-12-31 23:59:59"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('promo-banner');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$backgroundImage = \Weline\Theme\Helper\LegacyMediaUrl::sanitize(
    $this->getData('background_image') ?? '',
    true,
);
$backgroundImageFileHtml = (string)($this->getData('background_image_file_html') ?? '');
$backgroundColor = ThemeUiColor::sanitize(
    $this->getData('background_color') ?? '',
    'var(--weline-theme-danger-surface)'
);
$text = $this->getData('text') ?? __('限时特惠！全场满300减50');
$textColor = ThemeUiColor::sanitize(
    $this->getData('text_color') ?? '',
    'var(--weline-theme-danger)'
);
$link = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($this->getData('link') ?? '');
$closeable = (bool)($this->getData('closeable') ?? true);
$countdownEnd = trim((string)($this->getData('countdown_end') ?? ''));
$hasCountdown = $countdownEnd !== '';

$rootStyle = '--wc-promo-bg:' . $backgroundColor . ';--wc-promo-text:' . $textColor . ';';
if ($backgroundImageFileHtml === '' && $backgroundImage !== '') {
    $rootStyle .= 'background-image:url("' . $esc($backgroundImage) . '");';
}
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="<?= $esc($rootStyle) ?>">
    <?php if ($backgroundImageFileHtml !== ''): ?>
        <div class="promo-background"><?= $backgroundImageFileHtml ?></div>
    <?php endif; ?>

    <div class="promo-content">
        <?php if ($link !== ''): ?>
            <a href="<?= $esc($link) ?>" class="promo-link">
        <?php endif; ?>

        <span class="promo-text"><?= $esc((string)$text) ?></span>

        <?php if ($hasCountdown): ?>
            <span class="promo-countdown" data-end="<?= $esc($countdownEnd) ?>">
                <span class="countdown-label"><?= __('剩余') ?>:</span>
                <span class="countdown-timer">
                    <span class="time-part" data-unit="days"><span class="time-value">00</span><span class="time-label"><?= __('天') ?></span></span>
                    <span class="time-part" data-unit="hours"><span class="time-value">00</span><span class="time-label"><?= __('时') ?></span></span>
                    <span class="time-part" data-unit="minutes"><span class="time-value">00</span><span class="time-label"><?= __('分') ?></span></span>
                    <span class="time-part" data-unit="seconds"><span class="time-value">00</span><span class="time-label"><?= __('秒') ?></span></span>
                </span>
            </span>
        <?php endif; ?>

        <?php if ($link !== ''): ?>
            <span class="promo-arrow"><w:icon name="arrow-right" size="sm"></w:icon></span>
            </a>
        <?php endif; ?>
    </div>

    <?php if ($closeable): ?>
        <button class="promo-close" type="button" aria-label="<?= __('关闭') ?>">
            <w:icon name="close" size="sm"></w:icon>
        </button>
    <?php endif; ?>
</section>

<style>
.<?= $wc ?> {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--weline-space-3) var(--weline-space-12);
    background-color: var(--wc-promo-bg);
    background-size: cover;
    background-position: center;
    color: var(--wc-promo-text);
    border-bottom: var(--weline-theme-border-width) var(--weline-theme-border-style) var(--weline-theme-border);
}

.<?= $wc ?> .promo-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-4);
    flex-wrap: wrap;
}

.<?= $wc ?> .promo-background,
.<?= $wc ?> .promo-background figure,
.<?= $wc ?> .promo-background img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}

.<?= $wc ?> .promo-background img {
    object-fit: cover;
}

.<?= $wc ?> .promo-link {
    display: flex;
    align-items: center;
    gap: var(--weline-space-4);
    color: inherit;
    text-decoration: none;
    transition: opacity var(--weline-theme-transition-base);
}

.<?= $wc ?> .promo-link:hover {
    opacity: 0.85;
}

.<?= $wc ?> .promo-text {
    font-size: var(--weline-font-size-base);
    font-weight: 600;
}

.<?= $wc ?> .promo-arrow {
    display: flex;
    align-items: center;
}

.<?= $wc ?> .promo-countdown {
    display: flex;
    align-items: center;
    gap: var(--weline-space-2);
    padding: var(--weline-space-1) var(--weline-space-3);
    background: color-mix(in srgb, var(--wc-promo-text) 12%, transparent);
    border-radius: var(--weline-radius-round);
}

.<?= $wc ?> .countdown-label {
    font-size: var(--weline-font-size-sm);
}

.<?= $wc ?> .countdown-timer {
    display: flex;
    gap: var(--weline-space-1);
}

.<?= $wc ?> .time-part {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-0_5);
}

.<?= $wc ?> .time-value {
    font-weight: 700;
    font-size: var(--weline-font-size-base);
    font-family: var(--weline-font-mono);
}

.<?= $wc ?> .time-label {
    font-size: var(--weline-font-size-xs);
}

.<?= $wc ?> .promo-close {
    position: absolute;
    right: var(--weline-space-4);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: var(--weline-space-1);
    opacity: 0.65;
    transition: opacity var(--weline-theme-transition-base);
    z-index: 3;
}

.<?= $wc ?> .promo-close:hover {
    opacity: 1;
}

.<?= $wc ?>.is-hidden {
    display: none;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: var(--size-control-xl);
    padding: var(--weline-space-2) var(--weline-space-9) var(--weline-space-2) var(--weline-space-3);
}

.widget-preview-canvas .<?= $wc ?> .promo-text,
.<?= $wc ?>.is-preview .promo-text {
    font-size: var(--weline-font-size-xs);
    line-height: 1.3;
}

@media (max-width: 768px) {
    .<?= $wc ?> {
        padding: var(--weline-space-2) var(--weline-space-10) var(--weline-space-2) var(--weline-space-4);
    }

    .<?= $wc ?> .promo-text {
        font-size: var(--weline-font-size-sm);
    }
}
</style>

<script>
(function () {
    var root = document.querySelector('[data-uid="<?= $esc($scope->uid) ?>"]');
    if (!root) return;

    var storageKey = '<?= $esc($scope->jsNs) ?>-closed-' + root.getAttribute('data-uid');

    var closeBtn = root.querySelector('.promo-close');
    if (closeBtn) {
        closeBtn.addEventListener('click', function () {
            root.classList.add('is-hidden');
            try { localStorage.setItem(storageKey, String(Date.now())); } catch (e) {}
        });

        try {
            var closedTime = localStorage.getItem(storageKey);
            if (closedTime) {
                var hoursSinceClosed = (Date.now() - parseInt(closedTime, 10)) / (1000 * 60 * 60);
                if (hoursSinceClosed < 24) {
                    root.classList.add('is-hidden');
                }
            }
        } catch (e) {}
    }

    var countdown = root.querySelector('.promo-countdown');
    if (!countdown) return;

    var endDate = new Date(countdown.dataset.end).getTime();
    if (!Number.isFinite(endDate)) return;

    function updateCountdown() {
        var diff = endDate - Date.now();
        if (diff <= 0) {
            root.classList.add('is-hidden');
            return;
        }

        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff % 86400000) / 3600000);
        var minutes = Math.floor((diff % 3600000) / 60000);
        var seconds = Math.floor((diff % 60000) / 1000);

        var map = { days: days, hours: hours, minutes: minutes, seconds: seconds };
        Object.keys(map).forEach(function (unit) {
            var el = countdown.querySelector('[data-unit="' + unit + '"] .time-value');
            if (el) el.textContent = String(map[unit]).padStart(2, '0');
        });
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
})();
</script>
