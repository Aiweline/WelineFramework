    background: var(--weline-theme-surface-raised);
    border-radius: var(--weline-radius-lg, 10px);
    padding: var(--weline-space-5, 20px);
}

.<?= $wc ?> .widget-header {
    margin-bottom: var(--weline-space-4, 15px);
    padding-bottom: var(--weline-space-4, 15px);
    border-bottom: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
}

