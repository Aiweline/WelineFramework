    margin-top: var(--weline-space-4, 15px);
}

.<?= $wc ?> .action-btn {
    flex: 1;
    padding: var(--weline-space-3, 10px) var(--weline-space-4, 15px);
    text-align: center;
    border-radius: var(--weline-radius-sm, 6px);
    font-weight: 500;
    text-decoration: none;
    font-size: var(--weline-font-size-sm, 13px);
}

.<?= $wc ?> .action-btn-outline {
    border: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
    color: var(--weline-theme-text);
    background: var(--weline-theme-surface);
}

.<?= $wc ?> .action-btn-primary {
    background: var(--weline-theme-primary);
    color: var(--weline-theme-on-primary);
}

.widget-preview-canvas .<?= $wc ?>,
