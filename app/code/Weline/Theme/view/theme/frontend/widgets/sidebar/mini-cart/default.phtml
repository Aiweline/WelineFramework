    display: flex;
    gap: var(--weline-space-3, 12px);
    padding: var(--weline-space-3, 12px) 0;
    border-bottom: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
}

.<?= $wc ?> .item-image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--weline-radius-sm, 6px);
}

.<?= $wc ?> .item-name {
    margin: 0 0 var(--weline-space-1, 5px);
    font-size: var(--weline-font-size-sm, 13px);
    font-weight: 500;
    line-height: 1.3;
}

.<?= $wc ?> .item-price {
    color: var(--weline-theme-danger);
