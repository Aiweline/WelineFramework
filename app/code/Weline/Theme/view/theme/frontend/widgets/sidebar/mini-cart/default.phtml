<?php
/**
 * 迷你购物车部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {mini-cart}
 * @widget.name {迷你购物车}
 * @widget.description {侧边栏购物车预览，显示商品列表和小计}
 * @widget.type {sidebar}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="购物车",type="string",label="标题"}
 * @param max_items {default=5,type="number",label="最多显示数量"}
 * @param show_subtotal {default=true,type="bool",label="显示小计"}
 * @param show_checkout_button {default=true,type="bool",label="显示结算按钮"}
 * @param show_view_cart_button {default=true,type="bool",label="显示查看购物车按钮"}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('mini-cart');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('购物车');
$maxItems = (int)($this->getData('max_items') ?? 5);
$showSubtotal = (bool)($this->getData('show_subtotal') ?? true);
$showCheckoutButton = (bool)($this->getData('show_checkout_button') ?? true);
$showViewCartButton = (bool)($this->getData('show_view_cart_button') ?? true);
$placeholder = $this->getStaticUrl('Weline_Theme::theme/frontend/assets/images/theme/placeholder.png');

$cartItems = [
    ['id' => 1, 'name' => __('示例商品 1'), 'image' => $placeholder, 'price' => 99.00, 'qty' => 2],
    ['id' => 2, 'name' => __('示例商品 2'), 'image' => $placeholder, 'price' => 149.00, 'qty' => 1],
    ['id' => 3, 'name' => __('示例商品 3'), 'image' => $placeholder, 'price' => 79.00, 'qty' => 1],
];
$cartItems = array_slice($cartItems, 0, $maxItems);
$subtotal = array_sum(array_map(fn ($item) => $item['price'] * $item['qty'], $cartItems));
$itemCount = count($cartItems);
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <div class="widget-header">
        <h3 class="widget-title">
            <w:icon name="pin" size="sm"></w:icon>
            <?= $esc((string)$title) ?>
            <span class="item-count">(<?= $itemCount ?>)</span>
        </h3>
    </div>

    <?php if (empty($cartItems)): ?>
        <div class="cart-empty">
            <w:icon name="pin" size="sm"></w:icon>
            <p><?= __('购物车是空的') ?></p>
            <a href="/products" class="btn-shop"><?= __('去购物') ?></a>
        </div>
    <?php else: ?>
        <div class="cart-items">
            <?php foreach ($cartItems as $item): ?>
                <div class="cart-item" data-item-id="<?= (int)$item['id'] ?>">
                    <img src="<?= $esc((string)($item['image'] ?? '')) ?>" alt="<?= $esc((string)($item['name'] ?? '')) ?>" class="item-image">
                    <div class="item-details">
                        <h4 class="item-name"><?= $esc((string)($item['name'] ?? '')) ?></h4>
                        <div class="item-meta">
                            <span class="item-price">¥<?= number_format($item['price'], 2) ?></span>
                            <span class="item-qty">× <?= (int)$item['qty'] ?></span>
                        </div>
                    </div>
                    <button class="item-remove" type="button" title="<?= __('删除') ?>">
                        <w:icon name="close" size="sm"></w:icon>
                    </button>
                </div>
            <?php endforeach; ?>
        </div>
        <?php if ($showSubtotal): ?>
            <div class="cart-subtotal">
                <span class="label"><?= __('小计') ?>:</span>
                <span class="value">¥<?= number_format($subtotal, 2) ?></span>
            </div>
        <?php endif; ?>
        <div class="cart-actions">
            <?php if ($showViewCartButton): ?>
                <a href="/cart" class="action-btn action-btn-outline"><?= __('查看购物车') ?></a>
            <?php endif; ?>
            <?php if ($showCheckoutButton): ?>
                <a href="/checkout" class="action-btn action-btn-primary"><?= __('去结算') ?></a>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</section>

<style>
