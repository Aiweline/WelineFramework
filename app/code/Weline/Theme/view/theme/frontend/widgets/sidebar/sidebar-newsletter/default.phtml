<?php
/**
 * 邮件订阅（侧栏）部件
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {sidebar-newsletter}
 * @widget.name {侧栏订阅}
 * @widget.description {侧边栏邮件订阅表单}
 * @widget.type {newsletter}
 * @widget.area {frontend}
 * @widget.position {["sidebar"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 *
 * @param title {default="订阅我们",type="string",label="标题"}
 * @param description {default="订阅获取最新优惠信息",type="string",label="描述"}
 * @param button_text {default="订阅",type="string",label="按钮文字"}
 * @param placeholder {default="请输入邮箱地址",type="string",label="占位符"}
 * @param bg_color {default="var(--weline-theme-primary)",type="color",label="背景色"}
 * @param text_color {default="var(--weline-theme-on-primary)",type="color",label="文字色"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('sidebar-newsletter');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$title = $this->getData('title') ?? __('订阅我们');
$description = $this->getData('description') ?? __('订阅获取最新优惠信息');
$buttonText = $this->getData('button_text') ?? __('订阅');
$placeholder = $this->getData('placeholder') ?? __('请输入邮箱地址');
$bgColor = ThemeUiColor::sanitize($this->getData('bg_color') ?? '', 'var(--weline-theme-primary)');
$textColor = ThemeUiColor::sanitize($this->getData('text_color') ?? '', 'var(--weline-theme-on-primary)');
?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         style="--wc-newsletter-bg:<?= $esc($bgColor) ?>;--wc-newsletter-text:<?= $esc($textColor) ?>;">
    <div class="newsletter-icon">
        <w:icon name="mail" size="sm"></w:icon>
    </div>
    <?php if ($title !== ''): ?>
        <h3 class="widget-title"><?= $esc((string)$title) ?></h3>
    <?php endif; ?>
    <?php if ($description !== ''): ?>
        <p class="widget-description"><?= $esc((string)$description) ?></p>
    <?php endif; ?>
    <w:form class="newsletter-form" action="/newsletter/subscribe" method="post">
        <input type="email" name="email" class="newsletter-input" placeholder="<?= $esc((string)$placeholder) ?>" required>
        <button type="submit" class="newsletter-submit"><?= $esc((string)$buttonText) ?></button>
    </w:form>
    <p class="newsletter-privacy">
        <w:icon name="check" size="sm"></w:icon>
        <?= __('我们不会分享您的邮箱地址') ?>
    </p>
</section>

<style>
.<?= $wc ?> {
    background: var(--wc-newsletter-bg, var(--weline-theme-primary));
    border-radius: var(--weline-radius-lg, 12px);
    padding: var(--weline-space-6, 25px);
    text-align: center;
    color: var(--wc-newsletter-text, var(--weline-theme-on-primary));
}

.<?= $wc ?> .newsletter-icon {
    width: 60px;
    height: 60px;
    background: color-mix(in srgb, var(--wc-newsletter-text, var(--weline-theme-on-primary)) 20%, transparent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--weline-space-4, 15px);
}

.<?= $wc ?> .widget-title {
    font-size: var(--weline-font-size-lg, 18px);
    font-weight: 600;
    margin: 0 0 var(--weline-space-3, 10px);
}

.<?= $wc ?> .widget-description {
    font-size: var(--weline-font-size-sm, 13px);
    opacity: 0.9;
    margin: 0 0 var(--weline-space-5, 20px);
}

.<?= $wc ?> .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--weline-space-3, 10px);
}

.<?= $wc ?> .newsletter-input {
    width: 100%;
    padding: var(--weline-space-3, 12px) var(--weline-space-4, 15px);
    border: none;
    border-radius: var(--weline-radius-md, 8px);
    font-size: var(--weline-font-size-sm, 14px);
    outline: none;
}

.<?= $wc ?> .newsletter-submit {
    width: 100%;
    padding: var(--weline-space-3, 12px);
    border: none;
    border-radius: var(--weline-radius-md, 8px);
    background: var(--weline-theme-surface);
    color: var(--weline-theme-primary);
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--weline-theme-transition-base, 0.2s ease);
}

.<?= $wc ?> .newsletter-submit:hover {
    transform: translateY(-2px);
}

.<?= $wc ?> .newsletter-privacy {
    font-size: var(--weline-font-size-xs, 11px);
    opacity: 0.8;
    margin: var(--weline-space-4, 15px) 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--weline-space-1, 5px);
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    padding: var(--weline-space-4, 15px);
}
</style>
