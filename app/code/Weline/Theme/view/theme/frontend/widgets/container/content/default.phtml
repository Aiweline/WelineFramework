<?php
/**
 * Content 容器部件模板
 *
 * @var array $config 部件配置
 * @var array $children 子部件（按插槽分组）
 *
 * @widget.code {content-container}
 * @widget.name {Content 容器}
 * @widget.description {主内容区域容器，包含 Hero、推荐、主内容、侧栏等插槽。支持多种布局。}
 * @widget.type {container}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["*"]}
 * @widget.is_container {true}
 * @widget.exclusive {true}
 * @widget.slots {"hero":{"name":"Hero 区域","position":"top","accept":["hero-slider","promo-banner"],"max":1},"featured":{"name":"推荐区域","position":"top-middle","accept":["featured-products","category-grid","deals-of-day"],"max":2},"main":{"name":"主内容区","position":"middle","accept":["*"],"max":10},"sidebar-left":{"name":"左侧栏","position":"left","accept":["category-filters","category-list","sidebar-menu","sidebar-ads"],"max":5},"sidebar-right":{"name":"右侧栏","position":"right","accept":["mini-cart","recently-viewed","sidebar-newsletter","sidebar-social","tags-cloud","sidebar-ads","sidebar-menu"],"max":5},"bottom":{"name":"底部区域","position":"bottom","accept":["testimonials","brand-logos","faq-accordion","trust-badges"],"max":3}}
 *
 * @param layout {default="full-width",type="select",label="布局类型",options={full-width:"全宽",with-left:"带左侧栏",with-right:"带右侧栏",with-both:"双侧栏"}}
 * @param sidebar_width {default="25",type="select",label="侧栏宽度",options={20:"20%",25:"25%",30:"30%",33:"33%"}}
 * @param container_width {default="container",type="select",label="容器宽度",options={container:"标准宽度",container-fluid:"全宽",container-lg:"大屏宽度"}}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('content-container');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$config = $config ?? [];
$children = $children ?? [];
$isPreviewMode = (bool)($config['preview_mode'] ?? false);

$layout = (string)($config['layout'] ?? 'full-width');
if (!in_array($layout, ['full-width', 'with-left', 'with-right', 'with-both'], true)) {
    $layout = 'full-width';
}

$sidebarWidth = (string)($config['sidebar_width'] ?? '25');
if (!in_array($sidebarWidth, ['20', '25', '30', '33'], true)) {
    $sidebarWidth = '25';
}

$containerWidth = (string)($config['container_width'] ?? 'container');
if (!in_array($containerWidth, ['container', 'container-fluid', 'container-lg'], true)) {
    $containerWidth = 'container';
}

$contentWidth = 100;
if ($layout === 'with-left' || $layout === 'with-right') {
    $contentWidth = 100 - (int)$sidebarWidth;
} elseif ($layout === 'with-both') {
    $contentWidth = 100 - ((int)$sidebarWidth * 2);
}

$rootStyle = '--wc-sidebar-width:' . $sidebarWidth . '%;';
?>

<main class="<?= $esc($wc) ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
      weline-code="<?= $esc($scope->code) ?>"
      data-uid="<?= $esc($scope->uid) ?>"
      data-js-ns="<?= $esc($scope->jsNs) ?>"
      data-layout="<?= $esc($layout) ?>"
      style="<?= $esc($rootStyle) ?>">

    <div class="content-shell <?= $esc($containerWidth) ?>">

        <w:slot id="widget-hero"
                name="Hero轮播区域"
                accept="hero-slider,promo-banner,deals-of-day,featured-products,image-text,video-player,countdown,text-block,product-carousel,category-grid,new-arrivals,bestsellers,breadcrumb,search-bar,product-grid,product-list-view"
                exclusive="true"
                position="content"
                wrapper="section"
                class="content-slot slot-hero"
                weline-code="theme.widgets.widget_hero">
            <?php if (!empty($children['hero'])): ?>
                <?php foreach ($children['hero'] as $child): ?>
                    <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                        <?= $child['html'] ?? '' ?>
                    </div>
                <?php endforeach; ?>
            <?php else: ?>
                <div class="slot-placeholder slot-placeholder-large">
                    <w:icon name="circle" size="sm"></w:icon>
                    <span><?= __('Hero 轮播区域') ?></span>
                    <small><?= __('拖放轮播图或促销横幅到此处') ?></small>
                </div>
            <?php endif; ?>
        </w:slot>

        <w:slot id="widget-featured"
                name="推荐区域"
                accept="featured-products,category-grid,deals-of-day,bestsellers,new-arrivals,product-carousel,you-may-like"
                multiple="true"
                position="content"
                wrapper="section"
                class="content-slot slot-featured"
                weline-code="theme.widgets.widget_featured">
            <?php if (!empty($children['featured'])): ?>
                <?php foreach ($children['featured'] as $child): ?>
                    <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                        <?= $child['html'] ?? '' ?>
                    </div>
                <?php endforeach; ?>
            <?php else: ?>
                <div class="slot-placeholder">
                    <w:icon name="star" size="sm"></w:icon>
                    <span><?= __('推荐区域') ?></span>
                    <small><?= __('推荐产品、分类网格或特价商品') ?></small>
                </div>
            <?php endif; ?>
        </w:slot>

        <div class="content-body">
            <?php if ($layout === 'with-left' || $layout === 'with-both'): ?>
            <w:slot id="widget-sidebar-left"
                    name="左侧栏"
                    accept="category-filters,category-list,sidebar-menu,sidebar-ads,mini-cart,tags-cloud,sidebar-social,sidebar-newsletter"
                    multiple="true"
                    position="sidebar"
                    wrapper="aside"
                    class="content-slot slot-sidebar-left">
                <?php if (!empty($children['sidebar-left'])): ?>
                    <?php foreach ($children['sidebar-left'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder slot-placeholder-vertical">
                        <w:icon name="circle" size="sm"></w:icon>
                        <span><?= __('左侧栏') ?></span>
                        <small><?= __('筛选、菜单、广告') ?></small>
                    </div>
                <?php endif; ?>
            </w:slot>
            <?php endif; ?>

            <w:slot id="widget-main"
                    name="主内容区"
                    accept="*"
                    multiple="true"
                    position="content"
                    wrapper="section"
                    class="content-slot slot-main"
                    weline-code="theme.widgets.widget_main">
                <?php if (!empty($children['main'])): ?>
                    <?php foreach ($children['main'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder slot-placeholder-large">
                        <w:icon name="circle" size="sm"></w:icon>
                        <span><?= __('主内容区') ?></span>
                        <small><?= __('产品列表、文章、自定义内容') ?></small>
                    </div>
                <?php endif; ?>
            </w:slot>

            <?php if ($layout === 'with-right' || $layout === 'with-both'): ?>
            <w:slot id="widget-sidebar-right"
                    name="右侧栏"
                    accept="mini-cart,recently-viewed,sidebar-newsletter,sidebar-social,tags-cloud,sidebar-ads,sidebar-menu"
                    multiple="true"
                    position="sidebar"
                    wrapper="aside"
                    class="content-slot slot-sidebar-right">
                <?php if (!empty($children['sidebar-right'])): ?>
                    <?php foreach ($children['sidebar-right'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder slot-placeholder-vertical">
                        <w:icon name="circle" size="sm"></w:icon>
                        <span><?= __('右侧栏') ?></span>
                        <small><?= __('购物车、最近浏览、订阅') ?></small>
                    </div>
                <?php endif; ?>
            </w:slot>
            <?php endif; ?>
        </div>

        <w:slot id="widget-bottom"
                name="底部区域"
                accept="testimonials,brand-logos,faq-accordion,trust-badges,deals-of-day,newsletter-popup,social-share"
                multiple="true"
                position="content"
                wrapper="section"
                class="content-slot slot-bottom"
                weline-code="theme.widgets.widget_bottom">
            <?php if (!empty($children['bottom'])): ?>
                <?php foreach ($children['bottom'] as $child): ?>
                    <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                        <?= $child['html'] ?? '' ?>
                    </div>
                <?php endforeach; ?>
            <?php else: ?>
                <div class="slot-placeholder">
                    <w:icon name="circle" size="sm"></w:icon>
                    <span><?= __('底部区域') ?></span>
                    <small><?= __('客户评价、品牌Logo、FAQ等') ?></small>
                </div>
            <?php endif; ?>
        </w:slot>

    </div>
</main>

<style>
.<?= $wc ?> {
    width: 100%;
    padding: var(--weline-space-5, 20px) 0;
    color: var(--weline-theme-text);
}

