    margin-bottom: var(--weline-space-8, 30px);
}

.<?= $wc ?> .content-body {
    display: flex;
    gap: var(--weline-space-8, 30px);
    margin-bottom: var(--weline-space-8, 30px);
}

.<?= $wc ?> .slot-sidebar-left,
.<?= $wc ?> .slot-sidebar-right {
    flex: 0 0 var(--wc-sidebar-width, 25%);
}

