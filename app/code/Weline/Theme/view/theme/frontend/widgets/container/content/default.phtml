    flex: 1;
    min-height: 400px;
}

.<?= $wc ?> .slot-bottom {
    margin-top: var(--weline-space-8, 30px);
    padding-top: var(--weline-space-8, 30px);
    border-top: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
}

.<?= $wc ?> .content-slot {
    position: relative;
    min-height: 50px;
}

.<?= $wc ?> .content-slot.slot-selected,
.<?= $wc ?> [data-slot].slot-selected,
.<?= $wc ?> [data-wslot].slot-selected {
    outline: 3px solid var(--weline-theme-primary) !important;
    outline-offset: 2px;
    background: color-mix(in srgb, var(--weline-theme-primary) 5%, transparent) !important;
}

.<?= $wc ?> .slot-widget {
    position: relative;
    margin-bottom: var(--weline-space-5, 20px);
}

.<?= $wc ?> .slot-widget:last-child {
    margin-bottom: 0;
}

.widget-preview-canvas .<?= $wc ?>,
.<?= $wc ?>.is-preview {
    min-height: 120px;
}

@media (max-width: 992px) {
    .<?= $wc ?> .content-body {
        flex-wrap: wrap;
    }

    .<?= $wc ?> .slot-sidebar-left,
    .<?= $wc ?> .slot-sidebar-right {
        flex: 0 0 100% !important;
        order: 2;
    }

    .<?= $wc ?> .slot-main {
