<?php
/**
 * @widget.code {card-grid}
 * @widget.name {内容卡片}
 * @widget.description {图片、标题、说明与链接组成的通用卡片网格}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content","sidebar","footer"]}
 * @widget.page_layouts {["*"]}
 * @widget.compatible {true}
 * @widget.source {Weline_Theme::css/widgets/site-blocks.css}
 * @param title {default="内容卡片",type="string",label="标题"}
 * @param subtitle {default="",type="textarea",label="副标题"}
 * @param columns {default="3",type="select",label="每行列数",options={1:"1列",2:"2列",3:"3列",4:"4列"}}
 * @param items {default=[],type="site_card_items",label="展示项目"}
 */

use Weline\Theme\Helper\SiteBlockConfig as Block;
use Weline\Theme\Helper\WidgetUiScope;
use Weline\Theme\Helper\WidgetI18n;

$scope = WidgetUiScope::forWidget('card-grid');
$esc = [Block::class, 'escape'];
$t = static fn (mixed $value): string => Block::escape(WidgetI18n::label(Block::text($value)));
$title = Block::text($this->getData('title') ?? '内容卡片');
$subtitle = Block::text($this->getData('subtitle'));
$columns = Block::choice($this->getData('columns'), ['1','2','3','4'], '3');
$items = Block::items($this->getData('items'));
?>
<section class="<?= $esc($scope->cssClass) ?> weline-site-block" weline-code="<?= $esc($scope->code) ?>" data-uid="<?= $esc($scope->uid) ?>" data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($title !== '' || $subtitle !== ''): ?>
        <header class="sb-header">
            <?php if ($title !== ''): ?><h2 class="sb-title"><?= $t($title) ?></h2><?php endif; ?>
            <?php if ($subtitle !== ''): ?><p class="sb-lead"><?= $t($subtitle) ?></p><?php endif; ?>
        </header>
    <?php endif; ?>
    <div class="sb-grid columns-<?= $esc($columns) ?>">
        <?php foreach ($items as $index => $item):
            $image = \Weline\Theme\Helper\LegacyMediaUrl::sanitize($item['image'] ?? '');
            $mediaHtml = Block::mediaHtml($item['image_file_html'] ?? '', $item['title'] ?? '');
            $url = Block::link($item['link'] ?? '');
        ?>
            <article class="w-card sb-card">
                <?php if ($mediaHtml !== '' || $image !== ''): ?>
                    <div class="sb-media">
                        <?php if ($mediaHtml !== ''): ?><?= $mediaHtml ?><?php else: ?><img src="<?= $esc($image) ?>" alt="<?= $t($item['title'] ?? '') ?>" loading="lazy" decoding="async"><?php endif; ?>
                    </div>
                <?php endif; ?>
                <div class="sb-body">
                    <h3 class="sb-card-title"><?= $t($item['title'] ?? '') ?></h3>
                    <?php if (!empty($item['text'])): ?><p class="sb-copy"><?= $t($item['text']) ?></p><?php endif; ?>
                    <?php if ($url !== ''): ?><a class="sb-link" href="<?= $esc($url) ?>"><?= $t(Block::text($item['link_label'] ?? '') ?: '了解更多') ?></a><?php endif; ?>
                </div>
            </article>
        <?php endforeach; ?>
    </div>
    <?php if ($items === []): ?><p class="sb-empty"><lang>请在部件配置中添加真实内容</lang></p><?php endif; ?>
</section>
