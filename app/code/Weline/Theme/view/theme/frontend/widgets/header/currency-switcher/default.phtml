<?php
/**
 * Header 货币切换部件
 *
 * 可用货币、当前货币、本地化名称与切换行为均复用 Weline_I18n 的网站范围实现。
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {currency-switcher}
 * @widget.name {货币切换}
 * @widget.description {网站范围货币切换器，支持本地化名称与搜索}
 * @widget.type {header}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {currency}
 * @widget.supports {["layout-header-currency","currency"]}
 */

use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('currency-switcher');
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
?>

<section class="<?= $esc($scope->cssClass) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <w:hook>header-currency-switcher</w:hook>
</section>
