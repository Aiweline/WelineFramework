<?php
/**
 * @widget.source {Weline_Theme::js/widgets/widget-assets-runtime.js,Weline_Theme::js/widgets/widget-container-header-default-0.js,Weline_Theme::css/widgets/widget-instance-styles.css,Weline_Theme::js/widgets/widget-instance-styles.js}
 * Header 容器部件模板
 *
 * @var array $config 部件配置
 * @var array $children 子部件（按插槽分组）
 *
 * @widget.code {header-container}
 * @widget.name {Header 容器}
 * @widget.description {页面头部容器，包含 Logo、搜索框、导航、用户区域等插槽。独占头部区域。}
 * @widget.type {container}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.is_container {true}
 * @widget.exclusive {true}
 * @widget.supports {["layout-global-header","header-container"]}
 * @widget.slots {"logo":{"name":"Logo 插槽","position":"left","accept":["logo"],"max":1},"search":{"name":"搜索框插槽","position":"center","accept":["header-search"],"max":1},"navigation":{"name":"导航菜单插槽","position":"center-bottom","accept":["main-nav","category-menu"],"max":1},"user-area":{"name":"用户区域插槽","position":"right","accept":["account","mini-cart-icon","wishlist-icon","language-switcher","currency-switcher"],"max":5}}
 *
 * @widget.layout_source {Weline_Theme::css/widgets/header-chrome-amazon.css,Weline_Theme::css/widgets/header-search-amazon.css,Weline_Theme::css/widgets/widget-container-header-default.css}
 * @param sticky {default=true,type="bool",label="吸顶效果"}
 * @param bg_color {default="var(--weline-theme-header-bg, var(--color-bg-dark-secondary))",type="color",label="背景颜色"}
 * @param shadow {default=true,type="bool",label="显示阴影"}
 */

use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('header-container');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$config = $config ?? [];
$children = $children ?? [];
$isPreviewMode = (bool)($config['preview_mode'] ?? false);
$sticky = (bool)($config['sticky'] ?? true);
$bgColor = ThemeUiColor::sanitize(
    $config['bg_color'] ?? '',
    'var(--weline-theme-header-bg, var(--color-bg-dark-secondary))'
);
$shadow = (bool)($config['shadow'] ?? true);

$rootStyle = '--wc-header-bg:' . $bgColor . ';';
if ($shadow) {
    $rootStyle .= '--wc-header-shadow:var(--weline-theme-shadow-sm);';
}
?>

<header class="<?= $esc($wc) ?><?= $sticky ? ' is-sticky' : '' ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
        weline-code="<?= $esc($scope->code) ?>"
        data-uid="<?= $esc($scope->uid) ?>"
        data-js-ns="<?= $esc($scope->jsNs) ?>"
        data-widget-style="<?= $esc($rootStyle) ?>">

<div class="header-main">
        <div class="header-inner header-inner--primary">
            <div class="header-slot slot-logo" data-slot="logo" data-accept="logo">
                <button type="button"
                        class="header-mobile-menu-btn"
                        aria-label="<?= __('打开菜单') ?>"
                        aria-expanded="false"
                        aria-controls="<?= $esc($scope->uid) ?>-mobile-nav">
                    <w:icon name="menu" size="sm"></w:icon>
                </button>
                <?php if (!empty($children['logo'])): ?>
                    <?php foreach ($children['logo'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder">
                        <w:icon name="image" size="sm"></w:icon>
                        <span><?= __('Logo') ?></span>
                    </div>
                <?php endif; ?>
            </div>

            <div class="header-slot slot-search" data-slot="search" data-accept="header-search">
                <?php if (!empty($children['search'])): ?>
                    <?php foreach ($children['search'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder">
                        <w:icon name="search" size="sm"></w:icon>
                        <span><?= __('搜索框') ?></span>
                    </div>
                <?php endif; ?>
            </div>

            <div class="header-slot slot-user-area" data-slot="user-area" data-accept="account,mini-cart-icon,wishlist-icon,language-switcher,currency-switcher">
                <?php if (!empty($children['user-area'])): ?>
                    <?php foreach ($children['user-area'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder">
                        <w:icon name="user" size="sm"></w:icon>
                        <span><?= __('用户区域') ?></span>
                    </div>
                <?php endif; ?>
            </div>
        </div>
    </div>

    <div class="header-nav" id="<?= $esc($scope->uid) ?>-mobile-nav">
        <div class="header-inner">
            <div class="header-slot slot-navigation" data-slot="navigation" data-accept="main-nav,category-menu">
                <?php if (!empty($children['navigation'])): ?>
                    <?php foreach ($children['navigation'] as $child): ?>
                        <div class="slot-widget" data-widget-code="<?= $esc((string)($child['code'] ?? '')) ?>">
                            <?= $child['html'] ?? '' ?>
                        </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="slot-placeholder">
                        <w:icon name="menu" size="sm"></w:icon>
                        <span><?= __('导航菜单') ?></span>
                    </div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</header>

<span hidden data-widget-script="theme-container-header-default-0" data-v0="<?= htmlspecialchars((string)($esc($scope->uid)), ENT_QUOTES, 'UTF-8') ?>"></span>
