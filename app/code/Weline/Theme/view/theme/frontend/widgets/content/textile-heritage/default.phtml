<?php
/**
 * 织艺谱系（Textile Heritage）— Theme 原生通用内容部件。
 *
 * @var \Weline\Framework\View\Template $this
 * @widget.code {textile-heritage}
 * @widget.name {织艺谱系}
 * @widget.description {可复用的真实织绣馆藏目录；默认展示云锦、宋锦、蜀锦、苏绣、妆花与花罗}
 * @widget.type {content}
 * @widget.area {frontend}
 * @widget.position {["content"]}
 * @widget.page_layouts {["homepage", "cms_page"]}
 * @widget.supports {["layout-homepage-brands","layout-cms-content","layout-default-content","brand-list","brands","textile-heritage"]}
 * @widget.compatible {true}
 * @widget.source {Weline_Theme::css/widgets/textile-heritage.css}
 * @param title {default="织艺谱系 · Textile Heritage",type="string",label="标题"}
 * @param brands {default=[],type="brand_logo_items",label="谱系项",description="每项包含名称、说明、真实图片、文章链接与素材来源；主链默认由 Theme Catalog 指向 blog/textile-*（@url / base 带语言货币）"}
 * @param columns {default="6",type="select",label="每行列数",options={4:"4列",5:"5列",6:"6列",8:"8列"}}
 * @param layout {default="grid",type="select",label="布局",options={grid:"网格",carousel:"横向滚动"}}
 * @param grayscale {default=false,type="bool",label="灰度效果"}
 */

use Weline\Theme\Helper\LegacyMediaUrl;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;
use Weline\Theme\Service\TextileHeritageCatalog;
use Weline\Theme\Service\TextileHeritageLabels;

$scope = WidgetUiScope::forWidget('textile-heritage');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$title = trim((string)($this->getData('title') ?? TextileHeritageCatalog::TITLE));
$brands = $this->getData('brands') ?? [];
if (is_string($brands)) {
    $decoded = json_decode($brands, true);
    $brands = is_array($decoded) ? $decoded : [];
}
if (!is_array($brands)) {
    $brands = [];
}
$columns = (string)($this->getData('columns') ?? '6');
$layout = (string)($this->getData('layout') ?? 'grid');
$grayscale = (bool)($this->getData('grayscale') ?? false);
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
if (!in_array($columns, ['4', '5', '6', '8'], true)) {
    $columns = '6';
}
if (!in_array($layout, ['grid', 'carousel'], true)) {
    $layout = 'grid';
}

$currentLocale = WidgetI18n::storefrontLocale();
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$translateDefaultCopy = static function (string $source, string $english) use ($isChineseLocale): string {
    $translated = trim(WidgetI18n::label($source));
    if ($translated !== '' && $translated !== $source) {
        return $translated;
    }
    return $isChineseLocale ? $source : $english;
};
if ($title === '' || $title === TextileHeritageCatalog::TITLE) {
    $title = $translateDefaultCopy(TextileHeritageCatalog::TITLE, 'Textile Heritage');
}
$sourceLabel = $translateDefaultCopy('藏品来源', 'Source');
$catalogByName = [];
foreach (TextileHeritageCatalog::items() as $catalogItem) {
    $catalogByName[$catalogItem['name']] = $catalogItem;
}
if ($brands === []) {
    $brands = TextileHeritageCatalog::items();
}
?>
<section class="<?= $esc($wc) ?> weline-textile-heritage<?= $grayscale ? ' is-grayscale' : '' ?> layout-<?= $esc($layout) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-columns="<?= $esc($columns) ?>"
         data-testid="textile-heritage">
    <?php if ($title !== ''): ?>
        <header class="heritage-header"><h2 class="heritage-title"><?= $esc($title) ?></h2></header>
    <?php endif; ?>

    <div class="heritage-viewport">
        <div class="heritage-grid">
            <?php foreach ($brands as $brand): ?>
                <?php
                if (!is_array($brand)) {
                    continue;
                }
                $name = trim((string)($brand['name'] ?? ''));
                $sourceName = $name;
                $canonical = $catalogByName[$name] ?? [];
                $caption = trim((string)($brand['caption'] ?? ($canonical['caption'] ?? '')));
                $catalogLink = trim((string)($canonical['link'] ?? ''));
                $rawLink = trim((string)($catalogLink !== '' ? $catalogLink : ($brand['link'] ?? '')));
                $articleTitle = TextileHeritageLabels::articleTitle($rawLink, $currentLocale);
                if ($articleTitle !== '') {
                    $name = $articleTitle;
                    $caption = '';
                } else {
                    if ($name !== '') {
                        $name = trim(WidgetI18n::label($name));
                    }
                    if ($caption !== '' && $caption !== $name) {
                        $caption = trim(WidgetI18n::label($caption));
                    }
                }
                $image = LegacyMediaUrl::sanitize($brand['image'] ?? ($canonical['image'] ?? ''));
                $imageHtml = trim((string)($brand['image_file_html'] ?? ''));
                // Catalog owns article deep links; persisted brand lists may still carry legacy /search?q= or /blog/... URLs.
                $linkIsAbsolute = false;
                $linkPath = '';
                $linkHref = '';
                if ($rawLink !== '') {
                    if (preg_match('#^(?:https?:)?//#i', $rawLink) === 1) {
                        $linkIsAbsolute = true;
                        $linkPath = LegacyMediaUrl::sanitize($rawLink);
                        $linkHref = $linkPath;
                    } else {
                        // blog/* (no leading slash) so locale+currency apply via Url service.
                        // Avoid @url inside templates that may be re-included from closures.
                        $sanitizedLink = LegacyMediaUrl::sanitize($rawLink);
                        $linkPath = ltrim($sanitizedLink !== '' ? $sanitizedLink : $rawLink, '/');
                        try {
                            /** @var \Weline\Framework\Http\Url $url */
                            $url = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Framework\Http\Url::class);
                            $linkHref = (string)$url->getUrl($linkPath);
                        } catch (\Throwable) {
                            $linkHref = '/' . $linkPath;
                        }
                    }
                }
                $sourceUrl = LegacyMediaUrl::sanitize($brand['source_url'] ?? ($canonical['source_url'] ?? ''));
                $licenseUrl = LegacyMediaUrl::sanitize($brand['license_url'] ?? ($canonical['license_url'] ?? ''));
                $objectTitleSource = trim((string)($brand['object_title'] ?? ($canonical['object_title'] ?? $name)));
                $objectTitleEn = trim((string)($brand['object_title_en'] ?? ($canonical['object_title_en'] ?? $objectTitleSource)));
                $objectTitle = $objectTitleSource !== ''
                    ? $translateDefaultCopy($objectTitleSource, $objectTitleEn !== '' ? $objectTitleEn : $objectTitleSource)
                    : '';
                $creatorSource = trim((string)($brand['creator'] ?? ($canonical['creator'] ?? '')));
                $creatorEn = trim((string)($brand['creator_en'] ?? ($canonical['creator_en'] ?? $creatorSource)));
                $creator = $creatorSource !== ''
                    ? $translateDefaultCopy($creatorSource, $creatorEn !== '' ? $creatorEn : $creatorSource)
                    : '';
                $collection = trim((string)($brand['collection'] ?? ($canonical['collection'] ?? '')));
                $license = trim((string)($brand['license'] ?? ($canonical['license'] ?? '')));
                if ($name === '' || ($image === '' && $imageHtml === '')) {
                    continue;
                }
                ?>
                <article class="heritage-card"
                         data-technique="<?= $esc($sourceName !== '' ? $sourceName : $name) ?>"
                         data-source-url="<?= $esc($sourceUrl) ?>"
                         data-license="<?= $esc($license) ?>">
                    <?php if ($linkIsAbsolute && $linkHref !== ''): ?>
                        <a class="heritage-primary" href="<?= $esc($linkHref) ?>" title="<?= $esc($name) ?>">
                    <?php elseif ($linkHref !== ''): ?>
                        <a class="heritage-primary" href="<?= $esc($linkHref) ?>" title="<?= $esc($name) ?>">
                    <?php else: ?>
                        <div class="heritage-primary">
                    <?php endif; ?>
                        <span class="heritage-media">
                            <?php if ($imageHtml !== ''): ?>
                                <div class="heritage-image heritage-image--asset brand-logo"><?= $imageHtml ?></div>
                            <?php else: ?>
                                <img class="heritage-image brand-logo"
                                     src="<?= $esc($image) ?>"
                                     alt="<?= $esc($objectTitle !== '' ? $objectTitle : $name) ?>"
                                     width="400" height="400" loading="lazy" decoding="async">
                            <?php endif; ?>
                        </span>
                        <span class="heritage-copy brand-copy">
                            <span class="heritage-name brand-name"><?= $esc($name) ?></span>
                            <?php if ($caption !== '' && $caption !== $name): ?>
                                <span class="heritage-caption brand-caption"><?= $esc($caption) ?></span>
                            <?php endif; ?>
                        </span>
                    <?= $linkHref !== '' ? '</a>' : '</div>' ?>

                    <?php if ($sourceUrl !== ''): ?>
                        <a class="heritage-source" href="<?= $esc($sourceUrl) ?>" target="_blank" rel="noopener noreferrer"
                           title="<?= $esc(trim($objectTitle . ' · ' . $creator . ' · ' . $collection)) ?>">
                            <span><?= $esc($sourceLabel) ?></span>
                            <?php if ($license !== ''): ?>
                                <span aria-hidden="true">·</span><span><?= $esc($license) ?></span>
                            <?php endif; ?>
                        </a>
                    <?php elseif ($licenseUrl !== ''): ?>
                        <a class="heritage-source" href="<?= $esc($licenseUrl) ?>" target="_blank" rel="noopener noreferrer"><?= $esc($license) ?></a>
                    <?php endif; ?>
                </article>
            <?php endforeach; ?>
        </div>
    </div>
</section>
