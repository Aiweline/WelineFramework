<?php
/**
 * Bestsellers product root.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {bestsellers}
 * @widget.name {热销产品}
 * @widget.description {展示最受欢迎的热销产品}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["homepage", "cms_page", "category", "product"]}
 * @widget.supports {["layout-homepage-bestsellers","layout-product-bestsellers","layout-search-recommendations","layout-product-list-recommendations","layout-cms-content","layout-default-content"]}
 * @widget.default_injections {[{"layout_type":"homepage","layout_option":"default","slot":"homepage-bestsellers","area":"content","sort_order":0},{"layout_type":"product","layout_option":"default","slot":"product-bestsellers","area":"content","sort_order":0},{"layout_type":"search","layout_option":"default","slot":"search-recommendations","area":"content","sort_order":0}]}
 * @widget.compatible {true}
 */


use Weline\Theme\Helper\ThemeUiColor;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('bestsellers');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '热销产品';
$subtitleSource = trim((string)($this->getData('subtitle') ?? '')) ?: '最受欢迎的商品';
$widgetTitle = WidgetI18n::label($titleSource, '热销产品');
$widgetSubtitle = WidgetI18n::label($subtitleSource, '最受欢迎的商品');
$limit = max(1, (int)($this->getData('limit') ?? 8));
$period = (string)($this->getData('period') ?? 'month');
$showSalesCount = (bool)($this->getData('show_sales_count') ?? false);
$columns = (string)($this->getData('columns') ?? '4');
$layout = (string)($this->getData('layout') ?? 'grid');

$products = ThemeDemoCatalog::products($limit, 10);
foreach ($products as $index => &$product) {
    $product['rank'] = $index + 1;
    $product['sales_count'] = 240 + (($index + 1) * 173);
}
unset($product);

$realProducts = [];
try {
    $recommendationService = \Weline\Framework\Manager\ObjectManager::getInstance(\WeShop\Product\Service\ProductRecommendationService::class);
    $realProducts = $recommendationService->getRecommendations([], $limit);
} catch (\Throwable) {
    $realProducts = [];
}
if ($realProducts !== []) {
    $products = $realProducts;
    foreach ($products as $index => &$product) {
        $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
        $handle = trim((string)($product['handle'] ?? ''));
        $product['id'] = $productId;
        $product['rank'] = $index + 1;
        $product['url'] = $handle !== ''
            ? $this->getUrl('product/' . $handle)
            : $this->getUrl('weshop/product/view', ['id' => $productId]);
        $product['sales_count'] = (int)($product['sales_count'] ?? max(20, (int)($product['review_count'] ?? 0)) * 8 + (($index + 1) * 37));
    }
    unset($product);
}

?>

<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>">
    <?php if ($titleSource !== '' || $subtitleSource !== ''): ?>
        <div class="widget-header">
            <?php if ($titleSource !== ''): ?>
                <h2 class="widget-title">
                    <w:icon name="fire" size="sm"></w:icon>
                    <?= htmlspecialchars($widgetTitle, ENT_QUOTES, 'UTF-8') ?>
                </h2>
            <?php endif; ?>
            <?php if ($subtitleSource !== ''): ?>
                <p class="widget-subtitle"><?= htmlspecialchars($widgetSubtitle, ENT_QUOTES, 'UTF-8') ?></p>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <div class="products-container layout-<?= htmlspecialchars($layout, ENT_QUOTES, 'UTF-8') ?>">
        <div class="products-wrapper">
            <div class="products-grid columns-<?= htmlspecialchars($columns, ENT_QUOTES, 'UTF-8') ?>">
                <?php foreach ($products as $product): ?>
                    <article class="product-card">
                        <div class="product-image-wrapper">
                            <?php if ((int)$product['rank'] <= 3): ?>
                                <span class="rank-badge rank-<?= (int)$product['rank'] ?>"><?= (int)$product['rank'] ?></span>
                            <?php endif; ?>
                            <a href="<?= htmlspecialchars((string)$product['url'], ENT_QUOTES, 'UTF-8') ?>" class="product-image-link">
                                <img src="<?= htmlspecialchars((string)$product['image'], ENT_QUOTES, 'UTF-8') ?>"
                                     alt="<?= htmlspecialchars((string)$product['name'], ENT_QUOTES, 'UTF-8') ?>"
                                     class="product-image"
                                     loading="lazy">
                            </a>
                            <div class="product-badges">
                                <span class="w-badge badge-hot">HOT</span>
                            </div>
                            <div class="product-actions">
                                <button class="action-btn btn-wishlist weline-pixel::add_to_wishlist" type="button" title="<?= __('加入收藏') ?>">
                                    <w:icon name="heart" size="sm"></w:icon>
                                </button>
                                <button class="action-btn btn-quickview" type="button" title="<?= __('快速查看') ?>">
                                    <w:icon name="eye" size="sm"></w:icon>
                                </button>
                            </div>
                        </div>

                        <div class="product-info">
                            <h3 class="product-name">
                                <a href="<?= htmlspecialchars((string)$product['url'], ENT_QUOTES, 'UTF-8') ?>">
                                    <?= htmlspecialchars((string)$product['name'], ENT_QUOTES, 'UTF-8') ?>
                                </a>
                            </h3>
                            <?php if ($showSalesCount): ?>
                                <div class="product-sales">
                                    <w:icon name="pin" size="sm"></w:icon>
                                    <?= number_format((int)$product['sales_count']) ?> <?= __('已售') ?>
                                </div>
                            <?php endif; ?>
                            <div class="product-rating">
                                <div class="stars" aria-label="<?= number_format((float)$product['rating'], 1) ?>">
                                    <?php for ($s = 1; $s <= 5; $s++): ?>
                                        <span class="w-rating-star" data-state="<?= $s <= floor((float)$product['rating']) ? 'filled' : 'empty' ?>"><w:icon name="star" size="sm"></w:icon></span>
                                    <?php endfor; ?>
                                </div>
                                <span class="review-count">(<?= (int)$product['review_count'] ?>)</span>
                            </div>
                            <div class="product-price">
                                <?php if ((float)$product['original_price'] > (float)$product['price']): ?>
                                    <span class="price-original">¥<?= number_format((float)$product['original_price'], 2) ?></span>
                                <?php endif; ?>
                                <span class="price-current weline-pixel::add_to_cart:value" data-pixel-value="<?= htmlspecialchars((string)(float)$product['price'], ENT_QUOTES, 'UTF-8') ?>">¥<?= number_format((float)$product['price'], 2) ?></span>
                            </div>
                            <button class="btn-add-to-cart weline-pixel::add_to_cart" type="button" data-product-id="<?= (int)$product['id'] ?>">
                                <w:icon name="pin" size="sm"></w:icon>
                                <span class="weline-pixel::add_to_cart"><?= __('加入购物车') ?></span>
                            </button>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
</section>

<style>
