    overflow: hidden;
    border: var(--weline-theme-border-width, 1px) var(--weline-theme-border-style, solid) var(--weline-theme-border);
    border-radius: var(--weline-radius-lg, 12px);
    background: var(--weline-theme-surface-raised);
    box-shadow: var(--weline-theme-shadow-sm);
}
