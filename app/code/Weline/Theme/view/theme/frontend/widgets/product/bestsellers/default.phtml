    display: flex;
    align-items: center;
    gap: var(--weline-space-2, 0.5rem);
    margin: 0;
    color: var(--weline-theme-text);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: var(--weline-font-weight-bold, 700);
    line-height: 1.2;
}
.<?= $wc ?> .widget-title :is(i, svg) { color: var(--weline-theme-primary); }
