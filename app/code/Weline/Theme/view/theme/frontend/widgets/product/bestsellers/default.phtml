<?php
/**
 * Bestsellers product root.
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {bestsellers}
 * @widget.name {热销产品}
 * @widget.description {展示最受欢迎的热销产品}
 * @widget.type {product}
 * @widget.area {frontend}
 * @widget.position {["content", "sidebar"]}
 * @widget.page_layouts {["homepage", "cms_page", "category", "product"]}
 * @widget.supports {["layout-homepage-bestsellers","layout-product-bestsellers","layout-search-recommendations","layout-products-recommendations","layout-cms-content","layout-default-content"]}
 * @widget.compatible {true}
 *
 * @param title {default="热销产品",type="string",label="标题"}
 * @param subtitle {default="最受欢迎的商品",type="string",label="副标题"}
 * @param limit {default=8,type="number",label="显示数量"}
 * @param period {default="month",type="select",label="统计周期",options={week:"近7天",month:"近30天",year:"近一年",all:"全部"}}
 * @param show_sales_count {default=false,type="bool",label="显示销量"}
 * @param columns {default="4",type="select",label="每行列数",options={2:"2列",3:"3列",4:"4列",5:"5列",6:"6列"}}
 * @param layout {default="grid",type="select",label="布局方式",options={grid:"网格",masonry:"瀑布流"}}
 * @param show_wishlist {default=true,type="bool",label="显示收藏"}
 * @param show_compare {default=true,type="bool",label="显示对比"}
 * @param show_quickview {default=true,type="bool",label="显示快速查看"}
 * @param label_new_bg {default="",type="color",label="新品标签背景",description="留空使用主题全局色盘"}
 * @param label_new_text {default="",type="color",label="新品标签文字",description="留空使用主题全局色盘"}
 * @param label_sale_bg {default="",type="color",label="促销标签背景",description="留空使用主题全局色盘"}
 * @param label_sale_text {default="",type="color",label="促销标签文字",description="留空使用主题全局色盘"}
 */


use Weline\Framework\Manager\ObjectManager;
use Weline\Product\Service\ProductCardRenderer;
use Weline\Product\Service\StorefrontProductWidgetCatalog;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\ProductCardShopperActionParams;
use Weline\Theme\Helper\ProductCardUrl;
use Weline\Theme\Helper\ProductLabelStyle;
use Weline\Theme\Helper\WidgetUiScope;

$scope = WidgetUiScope::forWidget('bestsellers');
$shopperActions = ProductCardShopperActionParams::fromTemplate($this);
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$titleSource = trim((string)($this->getData('title') ?? '')) ?: '热销产品';
if (preg_match('/^Weline_[A-Za-z0-9_]+$/', $titleSource)) {
    $titleSource = '热销产品';
}
$subtitleSource = trim((string)($this->getData('subtitle') ?? '')) ?: '最受欢迎的商品';
$widgetTitle = WidgetI18n::label($titleSource, '热销产品');
$widgetSubtitle = WidgetI18n::label($subtitleSource, '最受欢迎的商品');
$limit = max(1, (int)($this->getData('limit') ?? 8));
$period = (string)($this->getData('period') ?? 'month');
$showSalesCount = (bool)($this->getData('show_sales_count') ?? false);
$columns = (string)($this->getData('columns') ?? '4');
$layout = (string)($this->getData('layout') ?? 'grid');
$allowedColumns = ['2', '3', '4', '5', '6'];
if (!in_array($columns, $allowedColumns, true)) {
    $columns = '4';
}
if (!in_array($layout, ['grid', 'masonry'], true)) {
    $layout = 'grid';
}
$masonryAspectRatios = ['3 / 4', '1 / 1', '4 / 5', '1 / 1', '5 / 6', '3 / 4'];

$products = [];
try {
    // Editor / theme-preview shells: prefer demo cards first so a cold
    // StorefrontCatalogViewService::rememberPublishedOffers() rebuild cannot
    // stall the product-layout iframe.
    if ($isPreviewMode || (bool)($this->getData('editor_mode') ?? false)) {
        $products = ThemeDemoCatalog::products($limit, 10);
    } elseif (class_exists(StorefrontProductWidgetCatalog::class)) {
        // 首页三货架错开：热销走销量/热度池并与 Featured/Deals 互斥（WO-HP-P1-02）
        $products = ObjectManager::getInstance(StorefrontProductWidgetCatalog::class)
            ->homepageHotCards($limit);
    }
} catch (\Throwable) {
    $products = [];
}

if ($products === [] && $isPreviewMode) {
    $products = ThemeDemoCatalog::products($limit, 10);
}

if ($products === []) {
    // Keep the editor health inspector satisfied without leaking demo products
    // into the live storefront when no real catalog cards are available.
    ?>
<section class="<?= $esc($wc) ?><?= $isPreviewMode ? ' is-preview' : '' ?> is-empty"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"
         data-testid="bestsellers-empty"
         hidden
         aria-hidden="true"></section>
    <?php
    return;
}

foreach ($products as $index => &$product) {
    $productId = (int)($product['product_id'] ?? $product['id'] ?? 0);
    $product['id'] = $productId;
    $product['rank'] = $index + 1;
    $route = trim((string)($product['url'] ?? ''));
    $productLink = ProductCardUrl::splitForTaglib($route);
    $product['url'] = $productLink['url'];
    $product['url_path'] = $productLink['url_path'];
    $product['sales_count'] = (int)($product['sales_count'] ?? max(20, (int)($product['review_count'] ?? 0)) * 8 + (($index + 1) * 37));
}
unset($product);
$cardShowWishlist = !empty($shopperActions['show_wishlist']);
$cardShowCompare = !empty($shopperActions['show_compare']);
$cardShowQuickview = !empty($shopperActions['show_quickview']);
$showPrice = true;
$showRating = true;
$showAddToCart = true;


$labelOverrides = ProductLabelStyle::widgetOverridesFromTemplate($this);
$scopeLabelStyle = ProductLabelStyle::scopeStyleAttribute($labelOverrides);

?>


<section class="<?= $esc($wc) ?> weline-product-card-shelf<?= $isPreviewMode ? ' is-preview' : '' ?>"
         weline-code="<?= $esc($scope->code) ?>"
         data-uid="<?= $esc($scope->uid) ?>"
         data-js-ns="<?= $esc($scope->jsNs) ?>"<?= $scopeLabelStyle !== '' ? ' style="' . $esc($scopeLabelStyle) . '"' : '' ?>>
    <?= ProductCardRenderer::emitStylesheetLinkOnce() ?>
    <?php if ($titleSource !== '' || $subtitleSource !== ''): ?>
        <header class="widget-header">
            <div class="widget-header__inner">
                <div class="widget-header__badge" aria-hidden="true">
                    <w:icon name="fire" size="md"></w:icon>
                </div>
                <div class="widget-header__copy">
                    <?php if ($titleSource !== ''): ?>
                        <h2 class="widget-title"><?= htmlspecialchars($widgetTitle, ENT_QUOTES, 'UTF-8') ?></h2>
                    <?php endif; ?>
                    <?php if ($subtitleSource !== ''): ?>
                        <p class="widget-subtitle"><?= htmlspecialchars($widgetSubtitle, ENT_QUOTES, 'UTF-8') ?></p>
                    <?php endif; ?>
                </div>
            </div>
        </header>
    <?php endif; ?>

    <div class="products-container layout-<?= htmlspecialchars($layout, ENT_QUOTES, 'UTF-8') ?>"
         data-columns="<?= htmlspecialchars($columns, ENT_QUOTES, 'UTF-8') ?>">
        <div class="products-wrapper">
            <div class="products-grid columns-<?= htmlspecialchars($columns, ENT_QUOTES, 'UTF-8') ?> layout-<?= htmlspecialchars($layout, ENT_QUOTES, 'UTF-8') ?>">
                <?php foreach ($products as $index => $product): ?>
                    <?php
                    $labelFlags = ProductLabelStyle::resolveFlags($product, $index);
                    $product['is_demo'] = !empty($labelFlags['is_demo']);
                    $product['is_new'] = !empty($labelFlags['is_new']);
                    $product['is_sale'] = !empty($labelFlags['is_sale']);
                    ?>
                    <w:product:card product="product" show-price="showPrice" show-rating="showRating" show-add-to-cart="showAddToCart" show-wishlist="cardShowWishlist" show-compare="cardShowCompare" show-quickview="cardShowQuickview" show-labels="true" density="standard" wishlist-pixel="true" />
                <?php endforeach; ?>
            </div>
        </div>
    </div>
</section>

