.<?= $wc ?> .rank-2 { background: linear-gradient(135deg, var(--weline-theme-surface-muted), var(--weline-theme-border)); color: var(--weline-theme-text-muted); }
.<?= $wc ?> .rank-3 { background: linear-gradient(135deg, var(--weline-theme-warning), var(--weline-theme-warning)); color: var(--weline-theme-on-primary); }
.<?= $wc ?> .product-badges { position: absolute; left: 10px; bottom: 10px; }
.<?= $wc ?> .badge-hot { display: inline-flex; align-items: center; border-radius: 999px; background: linear-gradient(135deg, var(--weline-theme-danger), var(--weline-theme-danger)); color: var(--weline-theme-on-primary); padding: .25rem .55rem; font-size: .75rem; font-weight: 700; }
.<?= $wc ?> .product-actions { position: absolute; top: .75rem; right: .75rem; display: flex; gap: .5rem; }
