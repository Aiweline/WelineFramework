.<?= $wc ?> .product-card { transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
.<?= $wc ?> .product-card:hover { transform: translateY(-2px); border-color: var(--weline-theme-primary); box-shadow: var(--shadow-md, 0 12px 30px rgba(15,23,42,.10)); }
