}
.<?= $wc ?> .btn-add-to-cart:hover { opacity: .92; box-shadow: var(--shadow-md, 0 10px 24px rgba(37,99,235,.22)); }
.<?= $wc ?> .btn-add-to-cart:active { transform: translateY(1px); }
.<?= $wc ?> .btn-add-to-cart i { font-size: 1.05rem; }
</style>
