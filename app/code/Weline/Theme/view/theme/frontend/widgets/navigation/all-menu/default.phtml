<?php
/**
 * 全部菜单部件：桌面「全部」触发器 + 向抽屉发布 menu_tree
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.code {all-menu}
 * @widget.name {全部菜单}
 * @widget.description {Header「全部」按钮与抽屉导航树。配置为名字+URL+标签的嵌套数组（最多三级），页面/分类/自定义可交叉。}
 * @widget.type {navigation}
 * @widget.area {frontend}
 * @widget.position {["header"]}
 * @widget.page_layouts {["*"]}
 * @widget.slot {all-menu}
 * @widget.supports {["layout-header-all-menu","all-menu","hamburger"]}
 * @widget.exclusive {true}
 * @widget.default_injections {[{"slot":"all-menu","page_layouts":["*"]}]}
 *
 * @param label {default="全部",type="string",label="按钮文字"}
 * @param menu_tree {default=[],type="all_menu_tree",label="导航树"}
 */

use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Helper\WidgetUiScope;
use Weline\Theme\Service\AllMenu\AllMenuTreeRegistry;
use Weline\Theme\Service\AllMenu\MenuTreeNormalizer;
use Weline\Theme\Service\AllMenu\PageCandidateService;

$scope = WidgetUiScope::forWidget('all-menu');
$wc = $scope->cssClass;
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');

$isPreviewMode = (bool)($this->getData('preview_mode') ?? false);
$labelSource = trim((string)($this->getData('label') ?? '全部'));
$label = WidgetI18n::label($labelSource !== '' ? $labelSource : '全部', '全部');

$normalizer = new MenuTreeNormalizer();
$rawTree = $this->getData('menu_tree');
$menuTree = $normalizer->normalize($rawTree);
if ($menuTree === []) {
    $menuTree = (new PageCandidateService())->defaultSeedTree();
}

AllMenuTreeRegistry::publish($menuTree);
?>

<a href="#"
   class="<?= $esc($wc) ?> hamburger-menu-btn js-header-drawer-trigger<?= $isPreviewMode ? ' is-preview' : '' ?>"
   id="hamburger-menu"
   role="button"
   aria-label="<?= $esc(WidgetI18n::label('打开所有类别菜单')) ?>"
   aria-expanded="false"
   aria-controls="categories-sidebar"
   data-all-menu-widget="1"
   data-menu-count="<?= count($menuTree) ?>">
    <svg class="hamburger-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <span class="hamburger-label"><?= $esc($label) ?></span>
</a>

<style>
.<?= $wc ?> {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-sm, 0.5rem);
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
}

.<?= $wc ?> .hamburger-label {
    white-space: nowrap;
    writing-mode: horizontal-tb;
    line-height: 1.4;
}

.<?= $wc ?> .hamburger-menu-icon {
    width: var(--spacing-5_5, 1.375rem);
    height: var(--spacing-5_5, 1.375rem);
    flex-shrink: 0;
}
</style>
