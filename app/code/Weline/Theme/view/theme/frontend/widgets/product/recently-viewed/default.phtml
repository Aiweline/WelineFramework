    width: 100%;
    max-width: var(--layout-max-width, 1600px);
    margin: 0 auto;
    padding: var(--weline-space-8, 2rem) var(--weline-space-6, 1.5rem);
    box-sizing: border-box;
    background: var(--weline-theme-surface-muted);
}

