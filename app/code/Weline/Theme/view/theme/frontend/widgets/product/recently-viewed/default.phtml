    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    font-weight: var(--weline-font-weight-bold, 700);
    line-height: 1.2;
}
.<?= $wc ?> .widget-title :is(i, svg) { color: var(--weline-theme-text-muted); }
.<?= $wc ?> .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--weline-space-4, 1rem);
    width: 100%;
    box-sizing: border-box;
}
