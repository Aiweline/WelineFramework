.<?= $wc ?> .product-name { margin: 0; color: var(--weline-theme-text); font-size: .875rem; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.<?= $wc ?> .product-rating { display: flex; align-items: center; gap: .45rem; }
.<?= $wc ?> .stars { display: flex; align-items: center; gap: 2px; }
.<?= $wc ?> .card-link:hover .product-name { color: var(--weline-theme-primary); }
.<?= $wc ?> .price-current { color: var(--weline-theme-primary); font-weight: 800; }
</style>
