<?php
/**
 * Route-invariant head prefix (critical → tokens → base → disk → overlay).
 * Big widget layout pack is placed after theme/disk/overlay by WidgetAssetHtmlPlacement.
 *
 * Head CSS order (Amazon-aligned):
 * 1) layout-critical (tiny skeleton)
 * 2) tokens pack (① variables / light colors)
 * 3) storefront base pack (② foundation + theme.css + dark)
 * 4) theme config disk override
 * 5) design overlay pack (③ layout-scoped private leaves)
 * 6) (later) big layout pack / other CSS via placement
 *
 * JS policy (default Theme): **no Theme scripts in head**. Frontend `weline.js`
 * (pixel/ModuleLoader bootstrap) stays via Weline_Frontend::header/base. Theme
 * chrome JS → modules / body-end. Custom design themes are out of this wave.
 *
 * work_mode=default_theme — head emission only; pack service is theme_module_runtime.
 *
 * @meta.name {default="Storefront head assets prefix",name="店面 head 资源前缀"}
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="guest",name="鉴权维度"}
 * @meta.cache.ttl {default="300",name="新鲜期秒"}
 */
$diskOverrideHtml = '';
try {
    $diskOverrideHtml = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\Disk\ThemeDiskHeadService::class
    )->buildOverrideLinkHtml('frontend');
} catch (\Throwable $e) {
    $diskOverrideHtml = '';
}
$this->assign('__head_disk_override_html', $diskOverrideHtml);

$headPack = null;
$tokensPackHtml = null;
$storefrontPackHtml = null;
$overlayPackHtml = null;
try {
    $headPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeCssPack::class
    );
    $tokensPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS,
        ['include_disk' => false, 'include_theme_overlay' => false]
    );
    $storefrontPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_STOREFRONT,
        ['include_disk' => true, 'include_theme_overlay' => false]
    );
    $overlayPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_OVERLAY,
        ['include_disk' => false, 'include_theme_overlay' => true]
    );
} catch (\Throwable $e) {
    $headPack = null;
    $tokensPackHtml = null;
    $storefrontPackHtml = null;
    $overlayPackHtml = null;
}
$diskAbsorbed = $headPack instanceof \Weline\Theme\Service\ThemeHeadChromeCssPack
    && $storefrontPackHtml !== null
    && $headPack->diskIncludedInPack(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_STOREFRONT
    );
$overlayAbsorbed = $headPack instanceof \Weline\Theme\Service\ThemeHeadChromeCssPack
    && $overlayPackHtml !== null
    && $headPack->themeOverlayAbsorbed('frontend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_OVERLAY);
?>
<w:template>Weline_Theme::templates/partials/head/css-fouc-bootstrap.phtml</w:template>
<theme:layout-critical area="frontend"/>
<?php if ($tokensPackHtml !== null): ?>
<?= $tokensPackHtml ?>
<?php endif; ?>
<?php if ($storefrontPackHtml !== null): ?>
<?= $storefrontPackHtml ?>
<?php else: ?>
<?php if ($tokensPackHtml === null): ?>
<theme:css>Weline_Theme::theme/frontend/variables/_spacing.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_auto-literals.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_typography.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_default.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_ink.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_light.css</theme:css>
<?php endif; ?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-foundation.css)">
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-frontend.css)">
<theme:css>Weline_Theme::theme/frontend/assets/css/theme.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_dark.css</theme:css>
<?php endif; ?>
<?php if (!$diskAbsorbed) { echo $diskOverrideHtml; } ?>
<?php if ($overlayPackHtml !== null): ?>
<?= $overlayPackHtml ?>
<?php endif; ?>
<?php // no Theme scripts here — weline.js from Frontend header/base only ?>
