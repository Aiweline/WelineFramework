<?php
/**
 * 片段：商品标签组
 *
 * 热路径请直接调用 ProductLabelMarkup::renderBadges()，避免列表循环内再 fetch 本文件。
 *
 * @meta.name {default="商品标签组",name="商品标签组",description="商品卡片角标标签组"}
 * @meta.description {default="统一渲染 NEW / SALE / DEMO / 热销 / 包邮 等商品标签，全局主题色盘 + 部件级覆盖",name="统一商品标签渲染",description="商品标签组片段用途"}
 * @param is_new {default=false,type=bool,name="显示新品标签",description="是否显示新品标签"}
 * @param is_sale {default=false,type=bool,name="显示促销标签",description="是否显示促销标签"}
 * @param is_demo {default=false,type=bool,name="显示演示标签",description="是否显示演示商品标签"}
 * @param is_hot {default=false,type=bool,name="显示热销标签",description="是否显示热销角标"}
 * @param is_free_shipping {default=false,type=bool,name="显示包邮标签",description="是否显示包邮角标"}
 * @param class {default="product-badges",name="容器类名",description="标签容器额外类名"}
 * @param sale_text {default="",name="促销文案",description="留空：有折扣显示 -N%，否则「特价」"}
 */

use Weline\Theme\Helper\ProductLabelMarkup;

$class = trim((string)($this->getData('class') ?? $this->getData('meta.class') ?? 'product-badges'));
echo ProductLabelMarkup::renderBadges([
    'is_demo' => (bool)($this->getData('is_demo') ?? $this->getData('meta.is_demo') ?? false),
    'is_new' => (bool)($this->getData('is_new') ?? $this->getData('meta.is_new') ?? false),
    'is_sale' => (bool)($this->getData('is_sale') ?? $this->getData('meta.is_sale') ?? false),
    'is_hot' => (bool)($this->getData('is_hot') ?? $this->getData('meta.is_hot') ?? false),
    'is_free_shipping' => (bool)($this->getData('is_free_shipping') ?? $this->getData('meta.is_free_shipping') ?? false),
    'sale_text' => trim((string)($this->getData('sale_text') ?? $this->getData('meta.sale_text') ?? '')),
], $class !== '' ? $class : 'product-badges');
