<?php
/** @meta.name {default="Weline UI 2.0 前台极简顶部",name="Weline UI 2.0 前台极简顶部"} */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteBrand;
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$logo = trim((string)($meta['logo'] ?? '')) ?: ObjectManager::getInstance(SiteBrand::class)->resolveFrontendLogoUrl($this);
$logoText = (string)($meta['logoText'] ?? 'Weline');
?>
<header class="w-frontend-header">
    <div class="w-container w-frontend-nav">
        <a class="w-frontend-brand" href="/"><?php if ($logo !== ''): ?><img src="<?= htmlspecialchars($logo, ENT_QUOTES, 'UTF-8') ?>" alt="<?= htmlspecialchars($logoText, ENT_QUOTES, 'UTF-8') ?>"><?php else: ?><span><?= htmlspecialchars($logoText, ENT_QUOTES, 'UTF-8') ?></span><?php endif; ?></a>
        <div class="w-frontend-nav__actions">
            <w:hook>header-language-switcher</w:hook>
            <w:hook>header-currency-switcher</w:hook>
            <w:hook>header-orders</w:hook>
            <w:hook>header-cart</w:hook>
            <w:hook>header-account</w:hook>
        </div>
    </div>
</header>
