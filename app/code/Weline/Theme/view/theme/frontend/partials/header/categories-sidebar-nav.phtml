<?php
/**
 * 汉堡/全部分类抽屉：一级图文列表；有子级时向右侧飞出（复用 mega-menu-panel）。
 * 名称/描述：优先节点 i18n（主题一键 AI 翻译），再走 esc / esc_desc。
 *
 * @var list<array<string,mixed>> $items
 * @var callable(string):string|null $esc
 * @var callable(string):string|null $esc_desc
 */
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetI18n;

$items = is_array($items ?? null) ? $items : [];
if ($items === []) {
    return;
}
$esc = is_callable($esc ?? null) ? $esc : static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
$escDesc = is_callable($esc_desc ?? null)
    ? $esc_desc
    : static function (string $v): string {
        $v = trim($v);
        if ($v === '') {
            return '';
        }
        try {
            return htmlspecialchars(WidgetI18n::label($v), ENT_QUOTES, 'UTF-8');
        } catch (\Throwable) {
            return htmlspecialchars((string)__($v), ENT_QUOTES, 'UTF-8');
        }
    };
$escAttr = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');

$resolveLocale = static function (): string {
    try {
        $lang = trim((string)\Weline\Framework\App\State::getLangLocal());
    } catch (\Throwable) {
        $lang = '';
    }
    $requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
    if ($requestUri !== '' && preg_match('#/(en_US|zh_Hans_CN|zh_CN|zh_Hant_TW)(?:/|$)#', $requestUri, $matches)) {
        return (string)$matches[1];
    }

    return $lang !== '' ? $lang : 'zh_Hans_CN';
};

$resolveImage = static function (array $node, int $seed): string {
    $image = trim((string)($node['image'] ?? $node['img'] ?? $node['icon_url'] ?? ''));
    // Hard forbid: never output data:image media; use one shared static SVG src.
    if ($image !== '' && !str_starts_with($image, 'data:image/')) {
        return $image;
    }

    return ThemeDemoCatalog::productImage($seed);
};

$resolveName = static function (array $node) use ($resolveLocale): string {
    $name = trim((string)($node['text'] ?? $node['name'] ?? ''));
    $locale = $resolveLocale();
    $i18nMap = $node['i18n']['name'] ?? null;
    if (is_array($i18nMap)) {
        $localized = trim((string)($i18nMap[$locale] ?? ''));
        if ($localized !== '') {
            // EN 店面：拒绝用错误 i18n 映射把已英文化的 text（Hanfu）覆盖成 CJK（汉服）。
            $rejectCjkOverwrite = $locale === 'en_US'
                && $name !== ''
                && !preg_match('/\p{Han}/u', $name)
                && preg_match('/\p{Han}/u', $localized);
            if (!$rejectCjkOverwrite) {
                $name = $localized;
            }
        }
    }
    if ($name === '') {
        return '';
    }

    // 中文源串（如「全部商品」）在 EN 店面仍需按 CSV 解析；已是拉丁文的 catalog 名不要再翻。
    if ($locale === 'en_US' && preg_match('/\p{Han}/u', $name)) {
        try {
            $translated = trim(WidgetI18n::label($name));
            if ($translated !== '') {
                $name = $translated;
            }
        } catch (\Throwable) {
            $translated = (string)__($name);
            if ($translated !== '') {
                $name = $translated;
            }
        }
    }

    // Catalog / toNavItems 已解析店面语言；勿再走 headerEsc/__()（会把 Hanfu 反向翻成 汉服）。
    return htmlspecialchars($name, ENT_QUOTES, 'UTF-8');
};

$resolveDescription = static function (array $node, string $label) use ($resolveLocale, $escDesc): string {
    $description = trim((string)($node['description'] ?? $node['desc'] ?? $node['subtitle'] ?? ''));
    $locale = $resolveLocale();
    $i18nMap = $node['i18n']['description'] ?? null;
    if (is_array($i18nMap)) {
        $localized = trim((string)($i18nMap[$locale] ?? ''));
        if ($localized !== '') {
            return htmlspecialchars($localized, ENT_QUOTES, 'UTF-8');
        }
    }
    if ($description !== '') {
        return $escDesc($description);
    }
    $fallback = (string)__('浏览 %{1} 相关商品与配件', [$label]);

    return htmlspecialchars($fallback, ENT_QUOTES, 'UTF-8');
};

foreach ($items as $index => $item) {
    if (!is_array($item)) {
        continue;
    }
    $textHtml = $resolveName($item);
    if ($textHtml === '') {
        continue;
    }
    $textPlain = trim((string)($item['text'] ?? $item['name'] ?? ''));
    $url = \Weline\Theme\Helper\HeaderNavFragment::localizeHref((string)($item['url'] ?? '#'));
    $children = is_array($item['children'] ?? null) ? $item['children'] : [];
    $hasChildren = $children !== [];
    $image = $resolveImage($item, ((int)$index + 1) * 19);
    // text 已由 MenuTreeNormalizer / catalog locale 解析；勿再 __()，避免 KeyBuilder 滞后时 Hanfu→汉服。
    $labelForFallback = $textPlain !== '' ? $textPlain : strip_tags($textHtml);
    $descHtml = $resolveDescription($item, $labelForFallback);

    if (!$hasChildren):
        ?>
        <li class="sidebar-category-item">
            <a class="sidebar-category-card sidebar-category-card--row" href="<?= $escAttr($url) ?>">
                <span class="sidebar-category-card__media">
                    <img src="<?= $escAttr($image) ?>" alt="" loading="lazy" width="48" height="48">
                </span>
                <span class="sidebar-category-card__body">
                    <span class="sidebar-category-card__title"><?= $textHtml ?></span>
                    <span class="sidebar-category-card__desc"><?= $descHtml ?></span>
                </span>
            </a>
        </li>
        <?php
        continue;
    endif;

    ?>
    <li class="sidebar-category-item has-children sidebar-category-item--mega"
        data-w-component="popover"
        data-w-open-on="hover"
        data-w-placement="right-start"
        data-w-gap="0"
        data-sidebar-mega-source="<?= $escAttr($url) ?>"
        data-sidebar-mega-deferred="1">
        <div class="sidebar-category-card sidebar-category-card--trigger"
             data-w-popover-trigger
             data-w-gap="0"
             aria-haspopup="dialog"
             aria-expanded="false">
            <a class="sidebar-category-card__link" href="<?= $escAttr($url) ?>">
                <span class="sidebar-category-card__media">
                    <img src="<?= $escAttr($image) ?>" alt="" loading="lazy" width="48" height="48">
                </span>
                <span class="sidebar-category-card__body">
                    <span class="sidebar-category-card__title"><?= $textHtml ?></span>
                    <span class="sidebar-category-card__desc"><?= $descHtml ?></span>
                </span>
            </a>
            <span class="sidebar-category-card__chevron" aria-hidden="true">▶</span>
        </div>
        <!-- Mega panel is cloned from the desktop category-menu only when the drawer opens. -->
    </li>
    <?php
}
?>
