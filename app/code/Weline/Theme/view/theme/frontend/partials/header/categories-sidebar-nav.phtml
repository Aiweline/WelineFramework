<?php
/**
 * 汉堡/全部分类抽屉：一级图文列表；有子级时向右侧飞出（复用 mega-menu-panel）。
 * 名称/描述：优先节点 i18n（主题一键 AI 翻译），再走 esc / esc_desc。
 * 分类节点用缩略图；页面/自定义菜单用菜单图标，禁止商品占位图 + 「浏览商品」套话。
 *
 * @var list<array<string,mixed>> $items
 * @var callable(string):string|null $esc
 * @var callable(string):string|null $esc_desc
 */
use Weline\Theme\Helper\ThemeDemoCatalog;
use Weline\Theme\Helper\WidgetI18n;
use Weline\Theme\Service\AllMenu\MenuTreeNormalizer;

$items = is_array($items ?? null) ? $items : [];
if ($items === []) {
    return;
}
$esc = is_callable($esc ?? null) ? $esc : static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
$escDesc = is_callable($esc_desc ?? null)
    ? $esc_desc
    : static function (string $v): string {
        $v = trim($v);
        if ($v === '') {
            return '';
        }
        try {
            return htmlspecialchars(WidgetI18n::label($v), ENT_QUOTES, 'UTF-8');
        } catch (\Throwable) {
            return htmlspecialchars((string)__($v), ENT_QUOTES, 'UTF-8');
        }
    };
$escAttr = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');

$resolveLocale = static function (): string {
    $requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
    $pathLocale = WidgetI18n::localeFromRequestUri($requestUri);
    if ($pathLocale !== null) {
        return $pathLocale;
    }
    try {
        $lang = trim((string)\Weline\Framework\App\State::getLangLocal());
    } catch (\Throwable) {
        $lang = '';
    }

    return $lang !== '' ? $lang : 'zh_Hans_CN';
};

/**
 * Catalog category vs CMS/page/custom menu link.
 *
 * @param array<string,mixed> $node
 */
$isCatalogCategory = static function (array $node): bool {
    $tag = strtolower(trim((string)($node['tag'] ?? $node['type'] ?? '')));
    if ($tag === MenuTreeNormalizer::TAG_CATEGORY) {
        return true;
    }
    if (in_array($tag, [MenuTreeNormalizer::TAG_PAGE, MenuTreeNormalizer::TAG_CUSTOM], true)) {
        return false;
    }
    $nodeId = (string)($node['id'] ?? '');
    $nodeUrl = strtolower((string)($node['url'] ?? ''));
    if (str_starts_with($nodeId, 'page_') || str_starts_with($nodeId, 'cms_')) {
        return false;
    }
    if (str_starts_with($nodeId, 'category') || str_contains($nodeUrl, '/category/')) {
        return true;
    }
    // Bare CMS shells (no /category/) — treat as page even when tag was dropped.
    if (preg_match('#/(about|contact|faq|qa|policy|terms|privacy|cookie|help|documentation|solutions|supported|support)(/|$)#i', $nodeUrl)) {
        return false;
    }

    return false;
};

/**
 * Font Awesome class for page/menu nodes (not catalog thumbs).
 *
 * @param array<string,mixed> $node
 */
$resolveMenuIconClass = static function (array $node): string {
    $hay = strtolower(trim((string)($node['id'] ?? '') . ' ' . (string)($node['url'] ?? '') . ' ' . (string)($node['text'] ?? $node['name'] ?? '')));
    $map = [
        'about' => 'fas fa-info-circle',
        'contact' => 'fas fa-envelope',
        'faq' => 'fas fa-circle-question',
        'qa' => 'fas fa-circle-question',
        'help' => 'fas fa-life-ring',
        'support' => 'fas fa-life-ring',
        'supported' => 'fas fa-life-ring',
        'documentation' => 'fas fa-book',
        'docs' => 'fas fa-book',
        'solution' => 'fas fa-lightbulb',
        'policy' => 'fas fa-scale-balanced',
        'privacy' => 'fas fa-user-shield',
        'terms' => 'fas fa-file-contract',
        'cookie' => 'fas fa-cookie-bite',
        'shipping' => 'fas fa-truck',
        'refund' => 'fas fa-rotate-left',
        'return' => 'fas fa-rotate-left',
        'product' => 'fas fa-store',
        'shop' => 'fas fa-store',
        'blog' => 'fas fa-newspaper',
        'journal' => 'fas fa-newspaper',
        'sanctuary' => 'fas fa-spa',
        'lounge' => 'fas fa-shirt',
    ];
    foreach ($map as $needle => $icon) {
        if (str_contains($hay, $needle)) {
            return $icon;
        }
    }

    return 'fas fa-file-lines';
};

$resolveCatalogImage = static function (array $node, int $seed): string {
    $image = trim((string)($node['image'] ?? $node['img'] ?? $node['icon_url'] ?? ''));
    // Hard forbid: never output data:image media; use one shared static SVG src.
    if ($image !== '' && !str_starts_with($image, 'data:image/') && $image !== 'Array') {
        return $image;
    }

    return ThemeDemoCatalog::productImage($seed);
};

$resolveName = static function (array $node) use ($resolveLocale, $isCatalogCategory): string {
    $name = trim((string)($node['text'] ?? $node['name'] ?? ''));
    $locale = $resolveLocale();
    $i18nMap = $node['i18n']['name'] ?? null;
    if (is_array($i18nMap)) {
        $localized = trim((string)($i18nMap[$locale] ?? ''));
        if ($localized !== '') {
            // EN 店面：拒绝用错误 i18n 映射把已英文化的 text（Hanfu）覆盖成 CJK（汉服）。
            $rejectCjkOverwrite = $locale === 'en_US'
                && $name !== ''
                && !preg_match('/\p{Han}/u', $name)
                && preg_match('/\p{Han}/u', $localized);
            if (!$rejectCjkOverwrite) {
                $name = $localized;
            }
        }
    }
    if ($name === '') {
        return '';
    }

    if ($isCatalogCategory($node)) {
        return htmlspecialchars($name, ENT_QUOTES, 'UTF-8');
    }

    // 中文源串（如「全部商品」）在非中文店面仍需按 CSV/词典解析；已是目标语的 catalog 名不要再翻。
    $isChineseLocale = str_starts_with(strtolower(str_replace('-', '_', $locale)), 'zh');
    if (!$isChineseLocale && preg_match('/\p{Han}/u', $name)) {
        try {
            $translated = trim(WidgetI18n::label($name));
            if ($translated !== '') {
                $name = $translated;
            }
        } catch (\Throwable) {
            $translated = (string)__($name);
            if ($translated !== '') {
                $name = $translated;
            }
        }
    }

    // Catalog / toNavItems 已解析店面语言；勿再走 headerEsc/__()（会把 Hanfu 反向翻成 汉服）。
    return htmlspecialchars($name, ENT_QUOTES, 'UTF-8');
};

$resolveDescription = static function (array $node, string $label, bool $isCategory) use ($resolveLocale, $escDesc): string {
    $description = trim((string)($node['description'] ?? $node['desc'] ?? $node['subtitle'] ?? ''));
    $locale = $resolveLocale();
    $i18nMap = $node['i18n']['description'] ?? null;
    if (is_array($i18nMap)) {
        $localized = trim((string)($i18nMap[$locale] ?? ''));
        if ($localized !== '') {
            return htmlspecialchars($localized, ENT_QUOTES, 'UTF-8');
        }
    }
    if ($description !== '') {
        // Reject catalog product-copy templates stuck on page/menu nodes.
        $looksLikeProductBrowse = (bool)preg_match(
            '/浏览.+相关商品|Browse .+ products and accessories/iu',
            $description
        );
        if (!($looksLikeProductBrowse && !$isCategory)) {
            return $escDesc($description);
        }
    }
    if ($isCategory) {
        $fallback = WidgetI18n::label('浏览 %{1} 相关商品与配件', '', [$label]);

        return htmlspecialchars($fallback, ENT_QUOTES, 'UTF-8');
    }
    $fallback = WidgetI18n::label('打开 %{1} 页面', '', [$label]);

    return htmlspecialchars($fallback, ENT_QUOTES, 'UTF-8');
};

/**
 * @param array<string,mixed> $node
 */
$renderMedia = static function (array $node, string $label, int $seed, bool $isCategory) use (
    $escAttr,
    $resolveCatalogImage,
    $resolveMenuIconClass
): void {
    if ($isCategory) {
        $image = $resolveCatalogImage($node, $seed);
        ?>
        <span class="sidebar-category-card__media">
            <img src="<?= $escAttr($image) ?>" alt="<?= $escAttr($label) ?>" loading="lazy" width="48" height="48">
        </span>
        <?php
        return;
    }
    $iconClass = $resolveMenuIconClass($node);
    ?>
    <span class="sidebar-category-card__media sidebar-category-card__media--icon" aria-hidden="true">
        <i class="<?= $escAttr($iconClass) ?>"></i>
    </span>
    <?php
};

foreach ($items as $index => $item) {
    if (!is_array($item)) {
        continue;
    }
    $textHtml = $resolveName($item);
    if ($textHtml === '') {
        continue;
    }
    $url = \Weline\Theme\Helper\HeaderNavFragment::localizeHref((string)($item['url'] ?? '#'));
    $children = is_array($item['children'] ?? null) ? $item['children'] : [];
    $hasChildren = $children !== [];
    $isCategory = $isCatalogCategory($item);
    // Prefer rendered (possibly WidgetI18n) title for alt/desc so hi_IN etc. do not keep Chinese.
    $labelForFallback = strip_tags($textHtml);
    $descHtml = $resolveDescription($item, $labelForFallback, $isCategory);
    $seed = ((int)$index + 1) * 19;
    $itemClass = $isCategory
        ? 'sidebar-category-item'
        : 'sidebar-category-item sidebar-category-item--page';

    if (!$hasChildren):
        ?>
        <li class="<?= $escAttr($itemClass) ?>">
            <a class="sidebar-category-card sidebar-category-card--row<?= $isCategory ? '' : ' sidebar-category-card--page' ?>" href="<?= $escAttr($url) ?>">
                <?php $renderMedia($item, $labelForFallback, $seed, $isCategory); ?>
                <span class="sidebar-category-card__body">
                    <span class="sidebar-category-card__title"><?= $textHtml ?></span>
                    <span class="sidebar-category-card__desc"><?= $descHtml ?></span>
                </span>
            </a>
        </li>
        <?php
        continue;
    endif;

    ?>
    <li class="<?= $escAttr($itemClass) ?> has-children sidebar-category-item--mega"
        data-w-component="popover"
        data-w-open-on="hover"
        data-w-placement="right-start"
        data-w-gap="0"
        data-sidebar-mega-source="<?= $escAttr($url) ?>"
        data-sidebar-mega-deferred="1">
        <div class="sidebar-category-card sidebar-category-card--trigger<?= $isCategory ? '' : ' sidebar-category-card--page' ?>"
             data-w-popover-trigger
             data-w-gap="0"
             aria-haspopup="dialog"
             aria-expanded="false">
            <a class="sidebar-category-card__link" href="<?= $escAttr($url) ?>">
                <?php $renderMedia($item, $labelForFallback, $seed, $isCategory); ?>
                <span class="sidebar-category-card__body">
                    <span class="sidebar-category-card__title"><?= $textHtml ?></span>
                    <span class="sidebar-category-card__desc"><?= $descHtml ?></span>
                </span>
            </a>
            <span class="sidebar-category-card__chevron" aria-hidden="true">▶</span>
        </div>
        <!-- Mega panel is cloned from the desktop category-menu only when the drawer opens. -->
    </li>
    <?php
}
?>
