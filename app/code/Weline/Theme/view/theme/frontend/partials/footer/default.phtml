<?php
/**
 * @meta.name {default="Weline UI 2.0 前台页脚",name="Weline UI 2.0 前台页脚"}
 * @param.copyright {default="",name="版权信息"}
 * @param.links {default=[],name="链接分组"}
 * @param.showBackToTop {default=true,name="显示返回顶部"}
 */
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$copyright = \Weline\Theme\Helper\FooterCopyrightHelper::resolve(
    isset($meta['copyright']) ? (string)$meta['copyright'] : null
);
$links = is_array($meta['links'] ?? null) ? $meta['links'] : [];
$showBackToTop = ($meta['showBackToTop'] ?? true) !== false;
?>
<footer class="w-frontend-footer">
    <w:hook>Weline_Theme::frontend::partials::footer::before</w:hook>
    <div class="w-container w-frontend-footer__content">
        <?php if ($links !== []): ?>
            <nav class="w-frontend-footer__links" aria-label="<?= htmlspecialchars((string)__('页脚导航'), ENT_QUOTES, 'UTF-8') ?>">
                <?php foreach ($links as $sectionIndex => $section): ?>
                    <?php if (!is_array($section)) continue; ?>
                    <?php $footerSectionCode = 'theme.footer.link_group_' . (string)$sectionIndex; ?>
                    <section class="w-stack" weline-code="<?= htmlspecialchars($footerSectionCode, ENT_QUOTES, 'UTF-8') ?>">
                        <?php if (!empty($section['title'])): ?><h2 class="w-frontend-footer__title"><?= htmlspecialchars((string)$section['title'], ENT_QUOTES, 'UTF-8') ?></h2><?php endif; ?>
                        <ul class="w-frontend-footer__list">
                            <?php foreach ((array)($section['items'] ?? []) as $item): ?>
                                <?php if (!is_array($item)) continue; ?>
                                <li><a href="<?= htmlspecialchars((string)($item['url'] ?? '#'), ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string)($item['text'] ?? ''), ENT_QUOTES, 'UTF-8') ?></a></li>
                            <?php endforeach; ?>
                        </ul>
                    </section>
                <?php endforeach; ?>
            </nav>
        <?php endif; ?>
        <div class="w-frontend-footer__bottom">
            <small><?= htmlspecialchars($copyright, ENT_QUOTES, 'UTF-8') ?></small>
            <?php if ($showBackToTop): ?><a class="w-button" data-tone="quiet" data-size="sm" href="#top"><w:icon name="arrow-up" size="sm" /><?= htmlspecialchars((string)__('返回顶部'), ENT_QUOTES, 'UTF-8') ?></a><?php endif; ?>
        </div>
    </div>
    <w:hook>footer</w:hook>
    <w:hook>Weline_Theme::frontend::partials::footer::after</w:hook>
</footer>
