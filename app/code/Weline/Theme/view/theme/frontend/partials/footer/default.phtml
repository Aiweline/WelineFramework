/**
 * 全局悬浮层 + 尾 chrome：真正的 <w:slot> 挂在 footer chrome 内，主题编辑器可点选。
 * 跨模块部件（进店音乐 / 客服 / Compare / Consent / B2B / Theme idle）经 default_injections，
 * 禁止 Theme 内嵌业务 DOM。float + tail CSS → layout 合包一次 emit。
 */
echo \Weline\Theme\Service\SharedChromeService::emitPartialsFooterShellLayoutCssHtml();
// Prefetch before __(): storefront Phrase layers are page-bag only and will
// otherwise return CJK source for missing float a11y labels on en_US.
$floatEdgeLabelSources = ['收起悬浮', '展开悬浮'];
try {
    $floatEdgeLocale = '';
    if (class_exists(\Weline\Framework\App\State::class)) {
        $floatEdgeLocale = trim((string)(\Weline\Framework\App\State::getLang() ?: ''));
    }
    if ($floatEdgeLocale === '' && function_exists('locale_get_default')) {
        $floatEdgeLocale = (string)locale_get_default();
    }
    if ($floatEdgeLocale === '') {
        $floatEdgeLocale = 'en_US';
    }
    \Weline\Framework\Phrase\Parser::prefetchWords($floatEdgeLabelSources, $floatEdgeLocale);
} catch (\Throwable) {
    // Best-effort; __() still runs below.
}
$floatEdgeDismissRaw = trim((string)__('收起悬浮'));
$floatEdgeRecallRaw = trim((string)__('展开悬浮'));
// Non-Chinese locale must not keep Chinese source identity (active_locale_must_show_target_language).
try {
    $floatEdgeLang = class_exists(\Weline\Framework\App\State::class)
        ? trim((string)(\Weline\Framework\App\State::getLang() ?: ''))
        : '';
} catch (\Throwable) {
    $floatEdgeLang = '';
}
$floatEdgeLangIsZh = $floatEdgeLang !== '' && (bool)preg_match('/^zh(_|-|$)/i', $floatEdgeLang);
if (!$floatEdgeLangIsZh) {
    if ($floatEdgeDismissRaw === '' || $floatEdgeDismissRaw === '收起悬浮') {
        $floatEdgeDismissRaw = 'Collapse float';
    }
    if ($floatEdgeRecallRaw === '' || $floatEdgeRecallRaw === '展开悬浮') {
        $floatEdgeRecallRaw = 'Expand float';
    }
}
$floatEdgeDismissLabel = htmlspecialchars($floatEdgeDismissRaw, ENT_QUOTES, 'UTF-8');
$floatEdgeRecallLabel = htmlspecialchars($floatEdgeRecallRaw, ENT_QUOTES, 'UTF-8');
?>
