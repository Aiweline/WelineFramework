<?php
/**
 * 片段：Footer（薄壳）
 *
 * 独占槽 `footer` 承接整页脚主部件 `footer-container`。
 * 链接分组 / 法律 / 社交 / 标准扩展槽由部件模板输出，不再在 partial 内按标题猜槽。
 *
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="guest",name="鉴权维度"}
 * @meta.name {default="Footer底部片段",name="Footer底部片段",description="Footer 薄壳：footer-above 扩展槽 + 独占槽挂载 footer-container"}
 * @meta.description {default="页脚上方扩展（默认 trust-badges）与页面底部区域（由 footer-container 部件渲染）",name="页面底部区域",description="footer-above 默认信任徽章；页脚主区由 footer-container 配置与渲染"}
 * @param.class {default="",name="额外CSS类",description="额外CSS类（兼容保留）"}
 */
?>
<!-- theme-partial:footer option=default -->
<w:slot id="footer-above"
        name="页脚上方扩展"
        accept="layout-footer-above,trust-badges,footer-newsletter,layout-footer-newsletter,banner,promo-banner,testimonial,content,container"
        reject="header,footer,navigation"
        multiple="true"
        append="true"
        position="content"
        class="weline-footer-above-slot">
    <w:hook>Weline_Theme::frontend::partials::footer::above<else/>
        <?php /* WO-HP-P2-05：页底精简版三枚（包邮门槛 + 退换 + 安全支付），与首屏条同口径 */ ?>
        <w:widget type="content" name="trust-badges" params='{"preset_badges":["free-shipping","money-back","secure-payment"],"columns":"3","style":"icon-text"}' />
    </w:hook>
</w:slot>

<w:slot id="footer"
        name="整体底部"
        accept="layout-global-footer,footer-container"
        exclusive="true"
        position="footer"
        class="weline-footer-slot">

    <!-- 回退：尚未默认安装 footer-container 时的最小壳；安装后由独占部件整段替换 -->
    <footer id="footer" class="weline-footer weline-footer--shell" data-layout="shell">
        <w:hook>Weline_Theme::frontend::partials::footer::before</w:hook>
        <w:hook>footer</w:hook>
        <w:hook>Weline_Theme::frontend::partials::footer::after</w:hook>
    </footer>

</w:slot>

<?php
$themeData = $this->getData('theme') ?? [];
$area = $themeData['area'] ?? 'frontend';
$layoutType = $themeData['layoutType'] ?? null;
$layoutOption = $themeData['layoutOption'] ?? null;
$theme = $themeData['theme'] ?? null;

if (!empty($layoutType) && !empty($layoutOption) && $theme && $theme->getId()) {
    $assetsManager = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Theme\Helper\LayoutAssetsManager::class);
    try {
        $layoutAssetsEnabled = (bool)\Weline\Framework\App\Env::getInstance()
            ->getConfig('theme.layout_assets.enabled', false);
        $jsPath = $layoutAssetsEnabled
            ? $assetsManager->getGeneratedJsPath($area, $layoutType, $layoutOption, $theme)
            : '';
        $hasLayoutJs = $jsPath !== '' && is_file($jsPath) && (filesize($jsPath) ?: 0) > 0;
        if ($hasLayoutJs) {
            $jsUrl = $assetsManager->getJsUrl($area, $layoutType, $layoutOption, $theme, $this);
            ?>
<script src="<?= htmlspecialchars($jsUrl) ?>"></script>
            <?php
        }
    } catch (\Exception $e) {
        if (defined('DEV') && DEV) {
            try {
                $logger = \Weline\Framework\App\Env::getInstance()->getLogger();
                if ($logger) {
                    $logger->error('Footer Partial: 无法获取布局JS URL', [
                        'layoutType' => $layoutType,
                        'layoutOption' => $layoutOption,
                        'error' => $e->getMessage(),
                    ]);
                }
            } catch (\Exception $logError) {
            }
        }
    }
}
?>
