<?php
/**
 * Route-invariant head suffix (theme CSS / UI / module declarations).
 * wave9-9s: nested under storefrontHeadAssetsPolicy — shared across URLs.
 *
 * work_mode=default_theme — head emission only; pack service is theme_module_runtime.
 *
 * @meta.name {default="Storefront head assets suffix",name="店面 head 资源后缀"}
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="guest",name="鉴权维度"}
 * @meta.cache.ttl {default="300",name="新鲜期秒"}
 */
$diskOverrideHtml = (string)($this->getData('__head_disk_override_html') ?? '');
if ($diskOverrideHtml === '') {
    try {
        $diskOverrideHtml = \Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Theme\Service\Disk\ThemeDiskHeadService::class
        )->buildOverrideLinkHtml('frontend');
    } catch (\Throwable $e) {
        $diskOverrideHtml = '';
    }
}
$headPack = null;
$tokenPreHtml = null;
$tokenPostHtml = null;
$uiPackHtml = null;
try {
    $headPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeCssPack::class
    );
    $tokenPreHtml = $headPack->tryLinkHtml('frontend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS_PRE);
    $tokenPostHtml = $headPack->tryLinkHtml('frontend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS_POST, [
        'include_disk' => true,
    ]);
    $uiPackHtml = $headPack->tryLinkHtml('frontend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_UI, [
        'layout_css' => true,
    ]);
} catch (\Throwable $e) {
    $headPack = null;
    $tokenPreHtml = null;
    $tokenPostHtml = null;
    $uiPackHtml = null;
}
$diskAbsorbed = $headPack instanceof \Weline\Theme\Service\ThemeHeadChromeCssPack
    && $tokenPostHtml !== null
    && $headPack->diskIncludedInPack('frontend', \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS_POST);
$afterCssJsHtml = null;
try {
    $afterCssJsHtml = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeJsPack::class
    )->tryScriptHtml('frontend', \Weline\Theme\Service\ThemeHeadChromeJsPack::PACK_AFTER_CSS);
} catch (\Throwable $e) {
    $afterCssJsHtml = null;
}
?>
<?php if ($tokenPreHtml !== null): ?>
<?= $tokenPreHtml ?>
<?php else: ?>
<theme:css>Weline_Theme::theme/frontend/colors/_light.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_default.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_ink.css</theme:css>
<?php endif; ?>
<w:hook>Weline_Theme::frontend::partials::head::styles-after</w:hook>
<?php if ($tokenPostHtml !== null): ?>
<?= $tokenPostHtml ?>
<?php else: ?>
<theme:css>Weline_Theme::theme/frontend/colors/_dark.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_spacing.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_typography.css</theme:css>
<?php endif; ?>
<?php if (!$diskAbsorbed) { echo $diskOverrideHtml; } ?>
<?php if ($uiPackHtml !== null): ?>
<?= $uiPackHtml ?>
<?php else: ?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-foundation.css)" data-weline-layout-css>
<link rel="stylesheet" href="@static(Weline_Theme::ui/weline-frontend.css)" data-weline-layout-css>
<?php endif; ?>
<theme:css data-weline-layout-css>Weline_Theme::theme/frontend/assets/css/theme.css</theme:css>
<link rel="stylesheet" href="@static(Weline_Theme::css/widgets/storefront-shopper-toast-amazon.css)" data-weline-layout-css>
<?php if ($afterCssJsHtml !== null): ?>
<?= $afterCssJsHtml ?>
<?php else: ?>
<script src="@static(Weline_Theme::ui/weline-css-ready.js)"></script>
<?php endif; ?>
<?php // site-blocks.css：由部件 @widget.source bake→head（page.phtml HeadAssets），禁止此处 @static 重复 ?>
<script type="module" src="@static(Weline_Theme::ui/weline-ui.js)"></script>
<?php // weline.js 已由 Frontend header/base 注入；此后声明业务模块（含 i18n） ?>
<w:hook>Weline_Theme::frontend::partials::head::module-declarations</w:hook>
