<?php
/**
 * Route-invariant head suffix (module declarations + theme-CSS fallback).
 * Big layout pack is injected by WidgetAssetHtmlPlacement after theme/disk/overlay.
 *
 * JS policy (default Theme): no Theme scripts in head. weline-ui / prepaint load via
 * modules + body-end after Frontend weline.js. Custom design themes out of this wave.
 *
 * @meta.name {default="Storefront head assets suffix",name="店面 head 资源后缀"}
 * @meta.cache.mode {default="chrome",name="缓存模式"}
 * @meta.cache.auth {default="guest",name="鉴权维度"}
 * @meta.cache.ttl {default="300",name="新鲜期秒"}
 */
$diskOverrideHtml = (string)($this->getData('__head_disk_override_html') ?? '');
if ($diskOverrideHtml === '') {
    try {
        $diskOverrideHtml = \Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Theme\Service\Disk\ThemeDiskHeadService::class
        )->buildOverrideLinkHtml('frontend');
    } catch (\Throwable $e) {
        $diskOverrideHtml = '';
    }
}
$headPack = null;
$tokensPackHtml = null;
$storefrontPackHtml = null;
$overlayPackHtml = null;
try {
    $headPack = \Weline\Framework\Manager\ObjectManager::getInstance(
        \Weline\Theme\Service\ThemeHeadChromeCssPack::class
    );
    $tokensPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_TOKENS,
        ['include_disk' => false, 'include_theme_overlay' => false]
    );
    $storefrontPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_STOREFRONT,
        ['include_disk' => false, 'include_theme_overlay' => false]
    );
    $overlayPackHtml = $headPack->tryLinkHtml(
        'frontend',
        \Weline\Theme\Service\ThemeHeadChromeCssPack::PACK_OVERLAY,
        ['include_disk' => false, 'include_theme_overlay' => true]
    );
} catch (\Throwable $e) {
    $headPack = null;
    $tokensPackHtml = null;
    $storefrontPackHtml = null;
    $overlayPackHtml = null;
}
$diskAbsorbed = false;
?>
<?php if ($tokensPackHtml === null && $storefrontPackHtml === null): ?>
<theme:css>Weline_Theme::theme/frontend/variables/_spacing.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_auto-literals.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/variables/_typography.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_default.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_ink.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_light.css</theme:css>
<link rel="preload" as="style" href="@static(Weline_Theme::ui/weline-foundation.css)" onload="this.onload=null;this.rel='stylesheet'">
<link rel="preload" as="style" href="@static(Weline_Theme::ui/weline-frontend.css)" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" data-weline-preload-fallback="1" href="@static(Weline_Theme::ui/weline-foundation.css)"><link rel="stylesheet" data-weline-preload-fallback="1" href="@static(Weline_Theme::ui/weline-frontend.css)"></noscript>
<theme:css>Weline_Theme::theme/frontend/assets/css/theme.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_dark.css</theme:css>
<?php if (!$diskAbsorbed) { echo $diskOverrideHtml; } ?>
<?php if ($overlayPackHtml !== null): ?>
<?= $overlayPackHtml ?>
<?php endif; ?>
<?php endif; ?>
<w:hook>Weline_Theme::frontend::partials::head::styles-after</w:hook>
<?php // site-blocks.css：由部件 @widget.source bake→head；禁止此处 @static 重复 ?>
<?php // weline.js 已由 Frontend header/base 注入；此后声明业务模块（含 i18n） ?>
<w:hook>Weline_Theme::frontend::partials::head::module-declarations</w:hook>

