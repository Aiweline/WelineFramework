$uiAssetVersion = static function (string $relative): string {
    $path = BP . 'app/code/Weline/Theme/view/statics/ui/' . \ltrim($relative, '/');
    return \is_file($path) ? (string)\filemtime($path) : '0';
};
$foundationV = $uiAssetVersion('weline-foundation.css');
$frontendV = $uiAssetVersion('weline-frontend.css');
