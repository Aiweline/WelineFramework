<script>
(function () {
    try {
        var root = document.documentElement;
        var preference = localStorage.getItem('weline_theme_preference') || root.getAttribute('data-theme-preference') || 'system';
        if (preference !== 'system' && preference !== 'light' && preference !== 'dark') {
            preference = 'system';
        }
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = preference === 'dark' || (preference === 'system' && systemDark) ? 'dark' : 'light';
        root.setAttribute('data-theme-preference', preference);
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
    } catch (e) {}
})();
</script>
<w:template>Weline_Frontend::templates/public/head.phtml</w:template>
<theme:css>Weline_Theme::theme/frontend/colors/_light.css</theme:css>
<theme:css>frontend/colors/_light.css</theme:css>
<theme:css>Weline_Theme::theme/frontend/colors/_dark.css</theme:css>
<theme:css>frontend/colors/_dark.css</theme:css>
<css>Weline_Theme::ui/weline-foundation.css</css>
<css>Weline_Theme::ui/weline-frontend.css</css>
<js type="module">Weline_Theme::ui/weline-ui.js</js>
