/* 更多下拉菜单容器：More 与链接列表同级，用同一 gap 当作一项 */
.header-nav-links {
    display: flex;
    align-items: center;
    gap: var(--weline-space-5);
    height: 100%;
}

.nav-links-list {
    display: flex;
    align-items: center;
    gap: var(--weline-space-5);
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--spacing-md);
    flex-wrap: nowrap; /* 禁止换行 */
}

.nav-links-list li {
    flex-shrink: 0; /* 禁止项被压缩 */
}

.nav-links-list a {
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    transition: color 0.2s ease;
    padding: var(--spacing-sm) 0;
    display: block;
}

.nav-links-list a:hover {
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.categories-overflow-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

.categories-overflow-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--weline-space-3);
    background-color: transparent;
    border: none;
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    border-radius: var(--border-radius-sm);
}

.categories-overflow-btn:hover {
    background-color: var(--color-on-dark-10);
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.categories-overflow-btn i {
    font-size: var(--spacing-2_5);
    transition: transform 0.2s ease;
}

.categories-overflow-wrapper.active .categories-overflow-btn i,
.categories-overflow-wrapper:hover .categories-overflow-btn i {
    transform: rotate(180deg);
}

.categories-overflow-list {
    /* base styles defined with flyout parity above */
}

.categories-overflow-list > .category-item > .category-link-wrapper {
    width: 100%;
    justify-content: space-between;
}

.categories-overflow-list .category-link {
    color: var(--weline-theme-body-text, #0f1111);
    text-decoration: none !important;
}





/* 更多按钮：与 .nav-links-list a 同级视觉间距，不贴前一项 */
.nav-more-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

.nav-more-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) 0;
    margin: 0;
    background-color: transparent;
    border: none;
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    border-radius: var(--border-radius-sm);
}

.nav-more-btn.w-button {
    min-inline-size: 0;
    padding-inline: 0;
}

.nav-more-btn:hover {
    background-color: var(--color-on-dark-10);
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.nav-more-btn i {
    font-size: var(--spacing-2_5);
    transition: transform 0.2s ease;
}

.nav-more-wrapper.active .nav-more-btn i {
    transform: rotate(180deg);
}

.nav-more-menu.w-menu {
    --w-surface-fg: var(--weline-theme-body-text, #0f1111);
    --w-surface-fg-muted: var(--weline-theme-body-text-muted, #666666);
    --w-floating-max-inline-size: min(28rem, calc(100vw - 2rem));
    min-inline-size: min(16rem, calc(100vw - 2rem));
    max-inline-size: min(28rem, calc(100vw - 2rem)) !important;
    padding: var(--weline-space-3, 0.75rem);
    border: 1px solid rgba(255, 255, 255, 0.72);
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.92) 100%);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    box-shadow:
        0 20px 40px rgba(15, 23, 42, 0.16),
        0 6px 12px rgba(15, 23, 42, 0.08);
    border-radius: var(--weline-radius-lg, 12px);
    color: var(--weline-theme-body-text, #0f1111);
}

/* More 收纳：Mega 分栏宽度与一级分类悬浮一致，不再套用 28rem 小列表 */
.categories-overflow-panel.w-popover.is-megamenu,
.categories-overflow-panel.w-popover.is-mega-panel-split,
body > .categories-overflow-panel.w-popover.is-megamenu,
body > .categories-overflow-panel.w-popover.is-mega-panel-split {
    --w-surface-fg: var(--weline-theme-body-text, #0f1111);
    --w-surface-fg-muted: var(--weline-theme-body-text-muted, #666666);
    /* L1 More 侧栏 + 内嵌完整 Mega（L2+L3），需比单层 Mega 更宽 */
    --w-floating-inline-size: min(1120px, calc(100vw - 2rem));
    --w-floating-max-inline-size: min(1120px, calc(100vw - 2rem));
    inline-size: min(1120px, calc(100vw - 2rem));
    min-inline-size: min(860px, calc(100vw - 2rem));
    max-inline-size: min(1120px, calc(100vw - 2rem)) !important;
    padding: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--weline-theme-text-on-dark, #ffffff) 18%, transparent);
    background: var(--weline-chrome-bg-dark-secondary, #232f3e);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow:
        0 20px 40px rgba(15, 23, 42, 0.16),
        0 6px 12px rgba(15, 23, 42, 0.08);
    border-radius: var(--weline-radius-lg, 12px);
    color: var(--weline-theme-text-on-dark, #ffffff);
}

/* More 右侧：嵌入与顶栏悬停一致的完整 Mega */
.categories-overflow-panel .mega-menu-panels:has(.mega-menu-panel--nested-mega) {
    padding: 0;
    overflow: hidden;
}
.categories-overflow-panel .mega-menu-panel--nested-mega.is-active {
    display: flex;
    align-items: stretch;
    min-height: 18rem;
    max-height: min(70vh, 32.5rem);
    height: 100%;
}
.categories-overflow-panel .mega-menu-nested-host {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    border: 0;
    box-shadow: none;
    background: transparent;
    overflow: hidden;
}
.categories-overflow-panel .mega-menu-nested-host .mega-menu-layout {
    width: 100%;
    min-height: 18rem;
    max-height: min(70vh, 32.5rem);
}

/* hover时也显示箭头旋转 */
.nav-more-wrapper:hover .nav-more-btn i {
    transform: rotate(180deg);
}

.nav-more-menu .w-menu__item {
    display: block;
    padding: var(--weline-space-3) var(--spacing-md);
    color: var(--weline-theme-body-text, #0f1111);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
}

.nav-more-menu .w-menu__item:hover {
    background-color: var(--weline-theme-surface-hover, rgba(0, 0, 0, 0.06));
    color: var(--weline-theme-body-link-hover, var(--weline-theme-menu-panel-text-hover));
}

/* 隐藏的菜单项 */
.nav-links-list li.hidden {
    display: none;
}



/* 侧边栏菜单（全部分类） */
.categories-sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--token-color-rgba-0-0-0-0-55);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.categories-sidebar-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    /* 不拦截指针：否则会挡住右侧飞出层，导致无法移入子集菜单 */
    pointer-events: none;
}

.categories-sidebar-close {
    pointer-events: auto;
}

.categories-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: min(88vw, var(--size-panel-300, 22rem));
    max-width: 88vw;
    height: 100dvh;
    background-color: <?= htmlspecialchars($colors['bgPrimary'] ?? 'var(--color-bg-primary)') ?>;
    box-shadow: var(--spacing-0_5) 0 var(--spacing-sm) var(--color-overlay-light);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
}

.categories-sidebar[aria-hidden="false"] {
    transform: translateX(0);
}

.categories-sidebar-header {
    display: flex;
