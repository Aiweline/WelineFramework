}

@keyframes slideDown {
    from {
        opacity: 0;
        max-height: 0;
        transform: translateY(var(--spacing-neg-2_5));
    }
    to {
        opacity: 1;
        max-height: var(--token-size-500px);
        transform: translateY(0);
    }
}

.my-menu-submenu.active .my-menu-submenu-content {
    display: block;
}

.my-menu-submenu-item {
    display: flex;
    align-items: center;
    padding: var(--spacing-2_5) var(--weline-space-5) var(--spacing-2_5) var(--token-size-2-5rem); /* 左侧缩进，表示二级菜单 */
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: all 0.2s ease;
    white-space: nowrap;
    position: relative;
}

.my-menu-submenu-item::before {
    content: '';
    position: absolute;
    left: var(--spacing-7);
    top: 50%;
    transform: translateY(-50%);
    width: var(--spacing-xs);
    height: var(--spacing-xs);
    border-radius: 50%;
    background-color: <?= htmlspecialchars($colors['textSecondary'] ?? 'var(--color-text-faint)') ?>;
    transition: background-color 0.2s ease;
}

.my-menu-submenu-item:hover {
    background-color: <?= htmlspecialchars($colors['bgTertiary'] ?? 'var(--color-bg-tertiary)') ?>;
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    padding-left: var(--spacing-2_75); /* 悬停时稍微右移 */
}

.my-menu-submenu-item:hover::before {
    background-color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.my-menu-submenu-item.active {
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    font-weight: 600;
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-muted)') ?>;
}

.my-menu-submenu-item.active::before {
    background-color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    width: var(--size-scrollbar);
    height: var(--size-scrollbar);
}

.action-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--spacing-sm);
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    border: var(--border-width-thin) solid transparent;
    border-radius: var(--border-radius-sm);
    transition: border-color 0.2s ease;
    line-height: 1.2;
    min-width: var(--spacing-15);
}

.action-link:hover {
    border-color: var(--weline-theme-text-on-dark);
}

.action-line-1 {
    font-size: var(--font-size-xs);
    color: var(--weline-theme-text-on-dark-muted);
}

.action-line-2 {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--weline-theme-text-on-dark);
}

/* 语言切换器 */
.header-language-switcher,
.header-currency-switcher {
