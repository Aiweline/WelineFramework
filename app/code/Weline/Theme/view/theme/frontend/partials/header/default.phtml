// 默认 Logo：优先站点品牌配置，否则使用 Theme 模块现用标识
$defaultLogoUrl = '/Weline/Theme/view/theme/frontend/assets/images/theme/logo.png';
try {
    $siteBrand = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Theme\Helper\SiteBrand::class);
    if ($siteBrand instanceof \Weline\Theme\Helper\SiteBrand) {
        $resolvedLogo = $siteBrand->resolveFrontendLogoUrl($this);
        if (is_string($resolvedLogo) && $resolvedLogo !== '') {
            $defaultLogoUrl = $resolvedLogo;
        }
    }
} catch (\Throwable) {
    // 保持 Theme 模块默认标识
}
if ($logo === '' || $logo === null) {
    $logo = $defaultLogoUrl;
}

