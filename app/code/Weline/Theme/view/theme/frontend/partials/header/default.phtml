}
@media (max-width: 768px) {
    .header-policy-links-slot {
        display: none;
    }
}

@media (max-width: 768px) {
    .header-nav-left,
    .header-nav-left-slot,
    .header-categories {
        overflow: hidden;
    }
}

/* 右侧快捷：在右簇内跟条目内容自适应 */
.header-nav-fill,
.header-nav-right-slot,
.header-nav-links-slot {
    flex: 0 1 auto;
    min-width: 0;
    max-width: none;
    width: auto;
    margin-left: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    height: auto;
    min-height: var(--size-control-md);
}

/* 右簇内扩展槽（博客等）：与快捷导航并列，不参与主行换行 */
.header-nav-extensions {
    flex: 0 0 auto;
    min-width: 0;
    max-width: none;
    width: auto;
    margin-left: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--weline-space-5);
    flex-wrap: nowrap;
    position: relative;
    overflow: hidden;
    height: auto;
    min-height: var(--size-control-md);
}

.header-nav-extensions:empty {
    display: none;
}

.header-nav-extensions .header-nav-extension-link,
.header-nav-extensions a,
.header-nav-right-cluster > .header-nav-extension-link,
.header-nav-right-cluster > .header-blog-link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-weight: 500;
}

.header-nav-extensions .header-nav-extension-link:hover,
.header-nav-extensions a:hover,
.header-nav-right-cluster > .header-nav-extension-link:hover,
.header-nav-right-cluster > .header-blog-link:hover {
    text-decoration: underline;
}

.header-nav-fill-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    width: auto;
    max-width: 100%;
    overflow: hidden;
}

.header-nav-right {
    flex: 0 0 auto;
}

/* 空 exclusive 槽 / 空 hook 不占 gap；「更多」已提到右簇旁，默认 display:none 亦不占位 */
.header-nav-right:not(:has(*)),
.header-nav-right-cluster > .header-nav-right-slot:has(#nav-links-list:empty) {
    display: none;
}

/* 「更多」未展开时不占 flex 位；出现时（JS 写 display:flex）再申请宽度 */
.header-nav-right-cluster > .nav-more-wrapper[style*="display: none"],
.header-nav-right-cluster > .nav-more-wrapper[hidden] {
    display: none !important;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 0;
    overflow: hidden;
    flex: 0 0 0;
}

.header-nav-right-cluster > .header-nav-extension-link.is-nav-overflow-hidden,
.header-nav-right-cluster .nav-links-list > li.is-nav-overflow-hidden {
    display: none !important;
}

/* 左簇整体 More：挂在左簇末（分类+政策之后），未展开不占位 */
.header-nav-left-cluster > .categories-overflow-wrapper.header-left-cluster-more {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    flex-shrink: 0;
}
.header-nav-left-cluster > .categories-overflow-wrapper.header-left-cluster-more[style*="display: none"],
.header-nav-left-cluster > .categories-overflow-wrapper.header-left-cluster-more[hidden] {
    display: none !important;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 0;
    overflow: hidden;
    flex: 0 0 0;
}
.categories-list > .category-item.is-nav-overflow-hidden {
    display: none !important;
}

/* 窄屏兜底两行（与 is-nav-stacked 同构）；宽屏保持单行+更多 */
@media (max-width: 768px) {
    .header-main-nav-inner {
        flex-wrap: wrap;
        gap: 0;
    }

    .header-nav-left-cluster {
        flex: 1 1 auto;
        min-width: 0;
        order: 1;
        overflow: hidden;
    }

    .header-nav-right-cluster {
        flex: 1 1 100%;
        order: 2;
        justify-content: flex-start;
        overflow: hidden;
        min-height: var(--size-control-md);
    }

    .header-nav-fill-inner {
        justify-content: flex-start;
        overflow: hidden;
        width: 100%;
    }
}

/* 汉堡菜单 */
.hamburger-menu-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: transparent;
    border: none;
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

/* 确保整个按钮区域都可以点击 - 让子元素不拦截点击事件 */
.hamburger-menu-btn * {
    pointer-events: none;
}

.hamburger-menu-btn:hover {
    background-color: var(--color-on-dark-10);
}

.hamburger-menu-btn i {
    font-size: var(--font-size-base);
}

/* 分类菜单内容：未抬升时仍可横向裁剪；抬升后由 [data-wf-raised] 强制 overflow:visible */
.header-categories .categories-nav,
.header-nav-left-slot .categories-nav {
    flex: 0 1 auto;
    min-width: 0;
    width: max-content;
    max-width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
}

/* 当宽度小于 200px 时隐藏 */
.header-categories.hide-narrow {
    display: none !important;
}

/* 渐变遮罩：提示有更多内容 (移至父容器以保持固定) */
.header-categories::after {
    content: '';
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    width: var(--spacing-15);
    height: 100%;
    background: linear-gradient(to right, transparent, var(--weline-chrome-bg-dark-secondary, #232f3e));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10;
}

html[dir="rtl"] .header-categories::after,
html[data-dir="rtl"] .header-categories::after,
html.is-rtl .header-categories::after {
    background: linear-gradient(to left, transparent, var(--weline-chrome-bg-dark-secondary, #232f3e));
}

.header-categories.has-overflow::after {
    opacity: 1;
}

.categories-nav {
    display: flex;
    align-items: center;
    width: 100%;
    overflow: visible; /* 允许子菜单溢出显示 */
}

.categories-list {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
}

.category-item {
    position: relative;
    display: flex;
    align-items: center;
}

.categories-list > li.hidden {
    display: none !important;
}

.category-link-wrapper {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.header-main-nav .categories-list > .category-item > .category-link,
.header-main-nav .categories-list > .category-item > .category-link-wrapper > .category-link {
    padding: var(--spacing-sm) var(--weline-space-3);
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    pointer-events: auto;
    flex: 1;
}

.header-main-nav .categories-list > .category-item > .category-link:hover,
.header-main-nav .categories-list > .category-item > .category-link-wrapper:hover > .category-link {
    background-color: var(--weline-theme-mega-menu-top-hover-bg, var(--weline-chrome-mega-menu-top-hover-bg, var(--color-on-dark-15, rgba(255, 255, 255, 0.15)))) !important;
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.header-main-nav .categories-list > .category-item:hover > .category-link,
.header-main-nav .categories-list > .category-item > .category-link-wrapper:hover > .category-link {
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.category-arrow {
    width: 0;
    height: 0;
    border-left: var(--spacing-xs) solid transparent;
    border-right: var(--spacing-xs) solid transparent;
    border-top: var(--spacing-xs) solid var(--weline-theme-text-on-dark);
    margin-right: var(--spacing-sm);
    cursor: pointer;
    pointer-events: auto;
    flex-shrink: 0;
    transition: transform 0.2s ease, border-top-color 0.2s ease;
}

.category-item.has-children:hover .category-arrow {
    transform: rotate(180deg);
    border-top-color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.category-link-wrapper:hover .category-arrow {
    border-top-color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

/* 分类子菜单：由 Weline.UI Popover 托管（portal + host+1），不再用 CSS :hover 绝对定位 */
.category-item.has-children > .category-submenu,
.category-item.has-children > .category-link-wrapper:hover ~ .category-submenu,
.category-item.has-children .category-link:hover ~ .category-submenu,


.header-category-panel.w-popover {
    --w-floating-max-inline-size: min(1100px, calc(100vw - 2rem));
    min-inline-size: min(18rem, calc(100vw - 2rem));
    border-radius: var(--weline-radius-lg, 12px);
}

.header-category-panel.is-megamenu {
    --w-surface-fg: var(--weline-theme-text-on-dark, #ffffff);
    --w-surface-fg-muted: var(--weline-theme-text-on-dark-muted, #dddddd);
    --w-surface-fg-subtle: var(--weline-theme-text-on-dark-muted, #dddddd);
    --w-floating-inline-size: min(1100px, calc(100vw - 2rem));
    inline-size: min(1100px, calc(100vw - 2rem));
    min-inline-size: min(680px, calc(100vw - 2rem));
    max-inline-size: min(1100px, calc(100vw - 2rem)) !important;
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--weline-theme-text-on-dark, #ffffff) 18%, transparent);
    /* 顶层 chrome 沿用主导航底色，右侧内容区由 .mega-menu-panels 自带浅色表面 */
    background: var(--weline-chrome-bg-dark-secondary, #232f3e);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow:
        0 24px 48px rgba(15, 23, 42, 0.18),
        0 8px 16px rgba(15, 23, 42, 0.08);
    color: var(--weline-theme-text-on-dark, #ffffff);
    transform-origin: top left;
    transition:
        opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.header-category-panel.is-flyout,
.header-category-panel.w-surface-body:not(.is-megamenu) {
    color: var(--weline-theme-body-text, var(--color-text-primary));
}

.header-category-panel.is-megamenu[data-state="open"] {
    animation: header-megamenu-enter 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.header-category-panel.is-mega-panel-split {
    --w-floating-inline-size: min(960px, calc(100vw - 2rem));
    inline-size: min(960px, calc(100vw - 2rem));
    min-inline-size: min(720px, calc(100vw - 2rem));
    padding: 0;
    overflow: hidden;
}

.mega-menu-layout {
    display: flex;
    align-items: stretch;
    min-height: 18rem;
    max-height: min(70vh, 32.5rem);
}

.mega-menu-sidebar {
    list-style: none;
    margin: 0;
    padding: 1rem 0.75rem;
    flex: 0 0 15.5rem;
    border-right: 1px solid color-mix(in srgb, var(--weline-theme-text-on-dark, #ffffff) 14%, transparent);
    overflow-y: auto;
    /* 侧栏与主导航同色；字色：mega-menu-top-hover-color 默认白 */
    --weline-chrome-mega-menu-top-hover-bg: rgba(255, 255, 255, 0.15);
    --weline-theme-mega-menu-top-hover-bg: rgba(255, 255, 255, 0.15);
    background: var(--weline-chrome-bg-dark-secondary, #232f3e);
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.mega-menu-sidebar-item-wrap {
    margin: 0;
}

.header-category-panel.is-megamenu .mega-menu-sidebar-item,
.categories-overflow-panel.is-megamenu .mega-menu-sidebar-item,
.mega-menu-sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    text-align: left;
    border: none;
    background: transparent;
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.35;
    padding: 0.55rem 0.65rem;
    border-radius: var(--weline-radius-md, 8px);
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
    transition: background 0.15s ease, color 0.15s ease;
}

.mega-menu-sidebar-item__media {
    display: grid;
    place-items: center;
    flex: 0 0 2.25rem;
    width: 2.25rem;
    height: 2.25rem;
    overflow: hidden;
    border-radius: var(--weline-radius-sm, 6px);
    background: #ffffff;
}

.mega-menu-sidebar-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.mega-menu-sidebar-item__label {
    min-width: 0;
    flex: 1 1 auto;
}

.mega-menu-sidebar-item:hover,
.mega-menu-sidebar-item.is-active,
.mega-menu-sidebar-item:focus-visible {
    background: var(--weline-theme-mega-menu-top-hover-bg, var(--weline-chrome-mega-menu-top-hover-bg, rgba(255, 255, 255, 0.15)));
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
    outline: none;
}

.mega-menu-panels {
    flex: 1 1 auto;
    position: relative;
    padding: 1.5rem 1.75rem;
    overflow-y: auto;
    background: #ffffff;
}

.mega-menu-panel {
    display: none;
}

.mega-menu-panel.is-active {
    display: block;
}

.mega-menu-panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--weline-theme-menu-panel-border, rgba(0, 0, 0, 0.08));
}

.mega-menu-panel__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--weline-theme-body-text-heading, #0f1111);
}

.mega-menu-panel__all {
    font-size: 0.85rem;
    color: var(--weline-theme-body-text-muted, #666666);
    text-decoration: none;
    white-space: nowrap;
}

.mega-menu-panel__all:hover {
    color: var(--weline-theme-body-link-hover, var(--weline-theme-primary, #149a78));
}

.mega-menu-panel__intro {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
}

.mega-menu-panel__banner {
    overflow: hidden;
    border-radius: var(--weline-radius-md, 10px);
    background: var(--weline-theme-surface-muted, #f4f6f8);
}

.mega-menu-panel__banner img {
    display: block;
    width: 100%;
    max-height: 9rem;
    object-fit: cover;
}

.mega-menu-panel__intro-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--weline-theme-body-text-secondary, #565959);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.mega-menu-subgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 2rem;
}

.mega-menu-subgrid--cards {
    gap: 0.75rem 1rem;
    align-items: start;
}

.mega-menu-subgrid__link {
    display: block;
    padding: 0.4rem 0;
    color: var(--weline-theme-body-text-secondary, #565959);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
}

.mega-menu-subgrid__link:hover {
    color: var(--weline-theme-body-link-hover, var(--weline-theme-primary, #149a78));
}

.mega-menu-card {
    position: relative;
    border-radius: var(--weline-radius-md, 10px);
    background: #ffffff;
    border: 1px solid transparent;
    transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        background-color 0.18s ease;
}

.mega-menu-card__link {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.65rem 0.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: inherit;
}

.mega-menu-card__media {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border-radius: var(--weline-radius-md, 10px);
    background: var(--weline-theme-surface-muted, #f4f6f8);
}

.mega-menu-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.mega-menu-card__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
}

.mega-menu-card__title {
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--weline-theme-body-text-heading, #0f1111);
}

.mega-menu-card__desc {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--weline-theme-body-text-muted, #666666);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.mega-menu-card:hover,
.mega-menu-card.is-expanded {
    border-color: var(--weline-theme-menu-panel-border, rgba(0, 0, 0, 0.08));
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
}

.mega-menu-card:hover .mega-menu-card__title,
.mega-menu-card.is-expanded .mega-menu-card__title {
    color: var(--weline-theme-menu-panel-text-hover, var(--weline-theme-primary, #149a78));
}

.mega-menu-card.has-expand.is-expanded .mega-menu-card__desc {
    -webkit-line-clamp: 3;
}

/* 三级默认内联展开：不悬浮、不遮盖相邻卡片 */
.mega-menu-card__children {
    list-style: none;
    margin: 0;
    padding: 0 0.75rem 0.75rem 5.75rem;
    display: none;
    gap: 0.15rem;
}

.mega-menu-card.has-expand.is-expanded > .mega-menu-card__children {
    display: grid;
}

.mega-menu-card__children a {
    display: block;
    padding: 0.28rem 0;
    font-size: 0.8rem;
    color: var(--weline-theme-body-text-secondary, #565959);
    text-decoration: none;
}

.mega-menu-card__children a:hover {
    color: var(--weline-theme-menu-panel-text-hover, var(--weline-theme-primary, #149a78));
}

.mega-menu-panel__empty {
    margin: 0;
    font-size: 0.875rem;
}

@media (max-width: 768px) {
    .header-category-panel.is-mega-panel-split {
        --w-floating-inline-size: calc(100vw - 1rem);
        inline-size: calc(100vw - 1rem);
        min-inline-size: calc(100vw - 1rem);
    }

    .mega-menu-layout {
        flex-direction: column;
        max-height: min(80vh, 36rem);
    }

    .mega-menu-sidebar {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: nowrap;
        gap: 0.35rem;
        overflow-x: auto;
        border-right: none;
        border-bottom: 1px solid var(--weline-theme-menu-panel-border, rgba(0, 0, 0, 0.08));
        padding: 0.75rem;
    }

    .mega-menu-sidebar-item {
        white-space: nowrap;
        width: auto;
    }

    .mega-menu-sidebar-item__media {
        flex: 0 0 1.75rem;
        width: 1.75rem;
        height: 1.75rem;
    }

    .mega-menu-subgrid,
    .mega-menu-subgrid--cards {
        grid-template-columns: 1fr;
    }

    .mega-menu-card__link {
        grid-template-columns: 3.75rem minmax(0, 1fr);
    }

    .mega-menu-card__media {
        width: 3.75rem;
        height: 3.75rem;
    }

    .mega-menu-card__children {
        padding-left: 4.75rem;
    }
}

@keyframes header-megamenu-enter {
    from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.header-category-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--weline-space-3, 0.75rem) var(--weline-space-5, 1.25rem);
}

.header-category-panel.is-megamenu .header-category-panel__list {
    grid-template-columns: repeat(4, minmax(220px, 1fr));
    gap: 2rem;
    column-gap: 3rem;
}

.header-category-panel.is-megamenu .header-category-panel__list > .category-item {
    display: flex;
    flex-direction: column;
    min-width: 220px;
    max-width: 280px;
    align-items: flex-start;
}

.header-category-panel.is-flyout .header-category-panel__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 12rem;
}

.header-category-panel .category-item {
    display: block;
    min-width: 0;
}

.header-category-panel .category-link-wrapper {
    width: 100%;
}

.header-category-panel.w-surface-body .category-link,
.header-category-panel.w-surface-body .category-link-wrapper .category-link {
    display: flex;
    width: 100%;
    color: var(--weline-theme-body-text, var(--color-text-primary));
    background: transparent;
