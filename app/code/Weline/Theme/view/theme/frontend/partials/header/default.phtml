<!-- Visual Editor Live Preview Listener -->
<script>
(function() {
    window.addEventListener('message', function(event) {
        // Accept messages from any origin (for iframe preview)
        if (event.data && event.data.type === 'WELINE_THEME_UPDATE') {
            const cssVars = event.data.cssVars;
            if (cssVars && typeof cssVars === 'object') {
                const root = document.documentElement;
                for (const [varName, value] of Object.entries(cssVars)) {
                    root.style.setProperty(varName, value);
                }
                console.log('Theme colors updated via postMessage:', cssVars);
            }
        }
    });
})();
</script>
