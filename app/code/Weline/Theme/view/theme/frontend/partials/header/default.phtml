    z-index: 1000;
}

.language-switcher:hover .language-options,
.currency-switcher:hover .currency-options {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.language-option,
.currency-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--weline-space-3) var(--spacing-md);
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
    text-decoration: none;
    transition: background-color 0.2s ease;
}

.language-option:hover,
.currency-option:hover {
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-muted)') ?>;
}

.language-option.active .fa-check,
.currency-option.active .fa-check {
    display: inline-block;
}

.language-option .fa-check,
.currency-option .fa-check {
    display: none;
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

/* 账户菜单 */
.header-account {
    position: relative;
}

.account-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    background-color: <?= htmlspecialchars($colors['bgPrimary'] ?? 'var(--color-bg-primary)') ?>;
    border: var(--border-width-thin) solid <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
    border-radius: var(--border-radius-md);
    box-shadow: 0 var(--spacing-xs) var(--spacing-sm) var(--color-overlay-light);
    min-width: var(--size-panel-200);
    margin-top: var(--spacing-xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--spacing-neg-2_5));
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 1000;
}

.header-account:hover .account-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.account-dropdown ul {
    list-style: none;
    margin: 0;
    padding: var(--spacing-sm) 0;
}

.account-dropdown li {
    margin: 0;
}

.account-dropdown a {
    display: block;
    padding: var(--weline-space-3) var(--spacing-md);
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
    text-decoration: none;
    transition: background-color 0.2s ease;
}

.account-dropdown a:hover {
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-muted)') ?>;
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

/* 购物车 */
.cart-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    border: var(--border-width-thin) solid transparent;
    border-radius: var(--border-radius-sm);
    transition: border-color 0.2s ease;
    background: none;
    border: none;
    color: var(--weline-theme-text-on-dark);
    cursor: pointer;
    position: relative; /* 让数量角标相对按钮定位 */
}

.cart-link:hover {
    border-color: var(--weline-theme-text-on-dark);
}

.cart-count {
    position: absolute;
    top: var(--spacing-neg-0_5);
    right: var(--spacing-neg-0_5);
    background-color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
    font-size: var(--spacing-0_7);
    font-weight: 700;
    padding: 0;
    width: var(--font-size-xl);
    height: var(--font-size-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 0 var(--spacing-0_5) var(--spacing-xs) var(--token-color-rgba-0-0-0-0-2);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.header-cart:hover .cart-count {
    transform: scale(1.2);
}

.cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--token-size-1-5em); /* 基于字体大小的高度 */
    min-height: var(--spacing-lg); /* 最小高度保证 */
}

.cart-icon svg {
    height: 100%; /* SVG高度跟随容器 */
    width: auto; /* 宽度自适应保持比例 */
    display: block; /* 确保正确渲染 */
}

/* 迷你购物车 */
.mini-cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay-50);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.header-cart.mini-cart-open ~ .mini-cart-overlay,
.header-cart.mini-cart-open .mini-cart-overlay {
    opacity: 1;
    visibility: visible;
}

.mini-cart {
    position: fixed;
    top: var(--spacing-15);
    right: 0;
    width: var(--size-panel-400);
    max-width: 90vw;
    max-height: calc(100vh - var(--spacing-15));
    background-color: <?= htmlspecialchars($colors['bgPrimary'] ?? 'var(--color-bg-primary)') ?>;
    box-shadow: var(--token-size-4px) 0 var(--spacing-sm) var(--color-overlay-light);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow: hidden;
}

.header-cart.mini-cart-open .mini-cart {
    transform: translateX(0);
}

.mini-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md);
    border-bottom: var(--border-width-thin) solid <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
}

.mini-cart-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
}

.mini-cart-close {
    background: none;
    border: none;
    font-size: var(--font-size-xl);
    color: <?= htmlspecialchars($colors['textSecondary'] ?? 'var(--color-text-gray)') ?>;
    cursor: pointer;
    padding: var(--spacing-xs);
    transition: color 0.2s ease;
}

.mini-cart-close:hover {
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
}

.mini-cart-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-md);
}

.mini-cart-empty {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-md);
    color: <?= htmlspecialchars($colors['textSecondary'] ?? 'var(--color-text-gray)') ?>;
}

.mini-cart-empty i {
    font-size: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
    color: <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
}

.mini-cart-items {
    display: none;
}

.mini-cart-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.mini-cart-footer {
    padding: var(--spacing-md);
    border-top: var(--border-width-thin) solid <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-muted)') ?>;
}

.mini-cart-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-lg);
    font-weight: 600;
}

.mini-cart-actions {
    display: flex;
    gap: var(--spacing-sm);
}

.mini-cart-actions .w-btn {
    flex: 1;
    padding: var(--weline-space-3) var(--spacing-md);
    border: none;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.mini-cart-actions .w-btn-primary {
    background-color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
}

.mini-cart-actions .w-btn-primary:hover {
    background-color: <?= htmlspecialchars($colors['primaryDark'] ?? 'var(--token-color-e68900)') ?>;
}

.mini-cart-actions .w-btn-secondary {
    background-color: <?= htmlspecialchars($colors['bgPrimary'] ?? 'var(--color-bg-primary)') ?>;
    color: <?= htmlspecialchars($colors['textPrimary'] ?? 'var(--color-text-primary)') ?>;
    border: var(--border-width-thin) solid <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
}

.mini-cart-actions .w-btn-secondary:hover {
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-muted)') ?>;
}

/* ========== 底部导航栏（nav-main）- 亚马逊风格：全宽底色 + 版心内容 ========== */
.header-main-nav {
    width: 100%;
    background-color: var(--weline-chrome-bg-dark-secondary, #232f3e);
    color: var(--weline-theme-text-on-dark);
    overflow: visible;
    position: relative;
    z-index: 0;
    box-sizing: border-box;
}

.header-main-nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    max-width: var(--weline-layout-content-max-width);
    margin: 0 auto;
    padding: 0 var(--weline-layout-content-padding-inline);
    box-sizing: border-box;
    background: transparent;
    color: inherit;
    min-height: var(--size-control-md);
    gap: var(--spacing-sm);
}

/* 全部菜单：内容宽度，不被左右菜单挤压覆盖 */
.header-nav-all {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    position: relative;
}

/* 左侧分类：跟在「全部」后，可收缩。弹出层抬升由 data-wf-stack + Weline.UI.stack 基建处理 */
.header-nav-left,
.header-nav-left-slot,
.header-categories {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    max-width: none;
    width: auto;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
}

@media (max-width: 768px) {
    .header-nav-left,
    .header-nav-left-slot,
    .header-categories {
        overflow: hidden;
    }
}

/* 右侧快捷：宽屏同一行；窄屏整行换到第二行（见下方 media） */
.header-nav-fill,
.header-nav-right-slot,
.header-nav-links-slot {
    flex: 1 1 0;
    min-width: 0;
    max-width: none;
    width: auto;
    margin-left: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    height: auto;
    min-height: var(--size-control-md);
}

.header-nav-fill-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    width: 100%;
    overflow: hidden;
}

.header-nav-right {
    flex: 0 0 auto;
}

/* 平板及以下：右侧快捷整行换到第二行；左侧「全部+分类」留在第一行；overflow 收纳进 More，不用横向滑走 All/More */
@media (max-width: 992px) {
    .header-main-nav-inner {
        flex-wrap: wrap;
        gap: 0;
    }

    .header-nav-all {
        flex: 0 0 auto;
        order: 1;
        display: flex;
    }

    .header-nav-left,
    .header-nav-left-slot,
    .header-categories {
        flex: 1 1 auto;
        min-width: 0;
        order: 1;
        overflow: hidden;
    }

    .header-nav-fill,
    .header-nav-right-slot,
    .header-nav-links-slot {
        flex: 1 1 100%;
        order: 2;
        margin-left: 0;
        justify-content: flex-start;
        overflow: hidden;
        height: auto;
        min-height: var(--size-control-md);
    }

    .header-nav-fill-inner {
        justify-content: flex-start;
        overflow: hidden;
        width: 100%;
    }
}

/* 汉堡菜单 */
.hamburger-menu-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: transparent;
    border: none;
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

/* 确保整个按钮区域都可以点击 - 让子元素不拦截点击事件 */
.hamburger-menu-btn * {
    pointer-events: none;
}

.hamburger-menu-btn:hover {
    background-color: var(--color-on-dark-10);
}

.hamburger-menu-btn i {
    font-size: var(--font-size-base);
}

/* 分类菜单内容：未抬升时仍可横向裁剪；抬升后由 [data-wf-raised] 强制 overflow:visible */
.header-categories .categories-nav,
.header-nav-left-slot .categories-nav {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
}

/* 当宽度小于 200px 时隐藏 */
.header-categories.hide-narrow {
    display: none !important;
}

/* 渐变遮罩：提示有更多内容 (移至父容器以保持固定) */
.header-categories::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: var(--spacing-15);
    height: 100%;
    background: linear-gradient(to right, transparent, var(--weline-chrome-bg-dark-secondary, #232f3e));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10;
}

.header-categories.has-overflow::after {
    opacity: 1;
}

.categories-nav {
    display: flex;
    align-items: center;
    width: 100%;
    overflow: visible; /* 允许子菜单溢出显示 */
}

.categories-list {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
}

.category-item {
    position: relative;
    display: flex;
    align-items: center;
}

.categories-list > li.hidden {
    display: none !important;
}

.category-link-wrapper {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.header-main-nav .categories-list > .category-item > .category-link,
.header-main-nav .categories-list > .category-item > .category-link-wrapper > .category-link {
    padding: var(--spacing-sm) var(--weline-space-3);
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    pointer-events: auto;
    flex: 1;
}

.header-main-nav .categories-list > .category-item > .category-link:hover,
.header-main-nav .categories-list > .category-item > .category-link-wrapper:hover > .category-link {
    background-color: var(--weline-theme-mega-menu-top-hover-bg, var(--weline-chrome-mega-menu-top-hover-bg, var(--color-on-dark-15, rgba(255, 255, 255, 0.15)))) !important;
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.header-main-nav .categories-list > .category-item:hover > .category-link,
.header-main-nav .categories-list > .category-item > .category-link-wrapper:hover > .category-link {
    color: var(--weline-theme-mega-menu-top-hover-color, var(--weline-chrome-mega-menu-top-hover-color, #ffffff));
}

.category-arrow {
    width: 0;
    height: 0;
    border-left: var(--spacing-xs) solid transparent;
    border-right: var(--spacing-xs) solid transparent;
    border-top: var(--spacing-xs) solid var(--weline-theme-text-on-dark);
    margin-right: var(--spacing-sm);
    cursor: pointer;
    pointer-events: auto;
    flex-shrink: 0;
    transition: transform 0.2s ease, border-top-color 0.2s ease;
}

