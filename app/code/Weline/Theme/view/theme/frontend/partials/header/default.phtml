$editorPreviewLight = false;
try {
    $editorModeFlag = trim((string)($this->request->getParam('editor_mode', '') ?? ''));
    $editorPreviewLight = ($editorModeFlag === '1' || strtolower($editorModeFlag) === 'true')
        || (bool)$this->getData('editor_mode');
} catch (\Throwable) {
    $editorPreviewLight = (bool)$this->getData('editor_mode');
}
$headerFlattenNavForEditor = static function (array $items): array {
    $out = [];
    foreach ($items as $item) {
        if (!is_array($item)) {
            continue;
        }
        $flat = $item;
        $flat['children'] = [];
        $out[] = $flat;
    }

    return $out;
};

