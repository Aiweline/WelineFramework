    width: 100%;
    background-color: var(--weline-chrome-bg-dark-secondary, #232f3e);
    color: var(--weline-theme-text-on-dark);
    overflow: visible;
    position: relative;
    z-index: 0;
    box-sizing: border-box;
}

.header-main-nav-inner {
    display: flex;
    /* 业界：宽屏单行 nowrap，靠「更多」收项；禁止 flex 自然换行后再挤回一行 */
    flex-wrap: nowrap;
    align-items: center;
    width: min(100%, var(--weline-layout-content-max-width));
    max-width: 100%;
    margin-inline: auto;
    padding: 0 var(--weline-layout-content-padding-inline);
    box-sizing: border-box;
    background: transparent;
    color: inherit;
    min-height: var(--size-control-md);
    gap: var(--spacing-sm);
}

/* 锁两行：JS 滞回 class，或 ≤768 媒体查询兜底（二者任一即栈） */
.header-main-nav-inner.is-nav-stacked {
    flex-wrap: wrap;
    gap: 0;
}

.header-main-nav-inner.is-nav-stacked .header-nav-left-cluster {
    flex: 1 1 auto;
    min-width: 0;
    order: 1;
    overflow: hidden;
}

.header-main-nav-inner.is-nav-stacked .header-nav-right-cluster {
    flex: 1 1 100%;
    order: 2;
    justify-content: flex-start;
    overflow: hidden;
    min-height: var(--size-control-md);
}

.header-main-nav-inner.is-nav-stacked .header-nav-fill-inner {
    justify-content: flex-start;
    overflow: hidden;
    width: 100%;
}

/* 左大簇：严格内容宽（max-content），永不吃中间空白；空白归右簇 */
.header-nav-left-cluster {
    display: flex;
    align-items: center;
    flex: 0 1 auto;
    flex-grow: 0;
    width: max-content;
    min-width: 0;
    max-width: 100%;
    gap: var(--spacing-sm);
    overflow: hidden;
}

/* 右大簇：吃剩余宽，右对齐；左空则右自动铺满，再在实宽内决定是否「更多」 */
.header-nav-right-cluster {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 1 1 0%;
    min-width: 0;
    gap: var(--weline-space-5);
    overflow: hidden;
}

/* 全部菜单：内容宽度，不被左右菜单挤压覆盖 */
