}

select::-webkit-scrollbar-thumb,
textarea::-webkit-scrollbar-thumb,
.search-category-select::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
}

select::-webkit-scrollbar-thumb:hover,
textarea::-webkit-scrollbar-thumb:hover,
.search-category-select::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
}

/* 跳过内容链接：默认视觉隐藏，仅键盘聚焦时显示 */
.skip-to-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    z-index: calc(var(--weline-z-overlay, 900) + 1);
