    flex: 0 0 auto;
    display: flex;
    align-items: center;
    position: relative;
}

/* 左侧分类：跟在「全部」后，按可见内容宽（禁止 flex-grow 把中间空白留在左槽） */
.header-nav-left,
.header-nav-left-slot,
.header-categories {
    display: flex;
    align-items: center;
    flex: 0 1 auto;
    flex-grow: 0;
    min-width: 0;
    max-width: 100%;
    width: max-content;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
}

/* 分类后政策槽：与分类同属左簇溢出候选，隐藏项不占宽 */
