/* ========================================
   Amazon风格 - Header样式
   ======================================== */

/* 全局滚动条样式（遵循主题规范） */
html,
body {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
    width: var(--size-scrollbar);
    height: var(--size-scrollbar);
}

html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track {
    background: var(--scrollbar-track);
}

html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
}

html::-webkit-scrollbar-thumb:hover,
body::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
}

/* 表单控件与下拉框滚动条（包含搜索分类 select） */
select,
textarea,
.search-category-select {
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
}

select::-webkit-scrollbar,
textarea::-webkit-scrollbar,
.search-category-select::-webkit-scrollbar {
    width: var(--size-scrollbar);
    height: var(--size-scrollbar);
}

select::-webkit-scrollbar-track,
textarea::-webkit-scrollbar-track,
.search-category-select::-webkit-scrollbar-track {
    background: var(--scrollbar-track);
}

select::-webkit-scrollbar-thumb,
textarea::-webkit-scrollbar-thumb,
.search-category-select::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
}

select::-webkit-scrollbar-thumb:hover,
textarea::-webkit-scrollbar-thumb:hover,
.search-category-select::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
}

/* 跳过内容链接：默认视觉隐藏，仅键盘聚焦时显示 */
.skip-to-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    z-index: calc(var(--weline-z-overlay, 900) + 1);
}

.skip-to-content:focus-visible {
    width: auto;
    height: auto;
    margin: 0;
    left: 50%;
    top: var(--weline-space-2, 0.5rem);
    transform: translateX(-50%);
    padding: var(--spacing-sm) var(--spacing-md);
    overflow: visible;
    clip: auto;
    clip-path: none;
    background: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
    color: var(--weline-theme-text-on-dark);
    text-decoration: none;
    border-radius: var(--border-radius-md);
}

/* Header主容器 */
.weline-header {
    width: 100%;
    background-color: var(--weline-chrome-bg-dark, var(--color-bg-amazon, var(--color-bg-dark-secondary)));
    position: sticky;
    top: 0;
    z-index: var(--weline-z-sticky-header, 100);
    box-shadow: 0 var(--spacing-0_5) var(--spacing-sm) var(--color-overlay-light);
    overflow: visible; 
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
}

/* 粘性状态下应用精致的磨砂玻璃效果 */
.weline-header.is-compact {
    background-color: var(--token-color-rgba-19-25-33-0-9);
    backdrop-filter: blur(var(--spacing-3_5)) saturate(160%);
    box-shadow: 0 var(--spacing-xs) var(--spacing-3_5) var(--token-color-rgba-0-0-0-0-3);
}

.weline-header.is-compact .header-belt {
