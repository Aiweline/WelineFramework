    transition: border-color 0.2s ease;
}

.language-switcher-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: var(--spacing-xs);
}

.language-switcher-icon svg {
    display: block;
    width: var(--weline-chrome-action-icon-size, var(--spacing-7, 1.75rem));
    height: var(--weline-chrome-action-icon-size, var(--spacing-7, 1.75rem));
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
}

.language-switcher:hover,
.currency-switcher:hover {
    border-color: var(--weline-theme-text-on-dark);
}

.currency-switcher-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: var(--spacing-xs);
}

.currency-switcher-icon svg {
    display: block;
    width: var(--weline-chrome-action-icon-size, var(--spacing-7, 1.75rem));
    height: var(--weline-chrome-action-icon-size, var(--spacing-7, 1.75rem));
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
}

.language-options,
.currency-options {
    position: absolute;
    top: 100%;
    right: 0;
    background-color: <?= htmlspecialchars($colors['bgPrimary'] ?? 'var(--color-bg-primary)') ?>;
    border: var(--border-width-thin) solid <?= htmlspecialchars($colors['borderDefault'] ?? 'var(--color-border-default)') ?>;
    border-radius: var(--border-radius-md);
    box-shadow: 0 var(--spacing-xs) var(--spacing-sm) var(--color-overlay-light);
    min-width: var(--size-panel-200);
    margin-top: var(--spacing-xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--spacing-neg-2_5));
