$headerFlattenNavForEditor = static function (array $items): array {
    $out = [];
    foreach ($items as $item) {
        if (!is_array($item)) {
            continue;
        }
        $flat = $item;
        $flat['children'] = [];
        $out[] = $flat;
    }

    return $out;
};

