$headerCapitalize = static function (string $label): string {
    if ($label === '') {
        return '';
    }
    if (function_exists('mb_substr') && function_exists('mb_strtoupper') && function_exists('mb_strlen')) {
        $first = mb_substr($label, 0, 1, 'UTF-8');
        if ($first === '') {
            return $label;
        }

        return mb_strtoupper($first, 'UTF-8') . mb_substr($label, 1, null, 'UTF-8');
    }

    return ucfirst($label);
};
$headerLabel = static function ($value) use ($headerCategoryService, $headerCapitalize): string {
    $key = trim((string)($value ?? ''));
    if ($key === '') {
        return '';
    }
    $widgetLabel = \Weline\Theme\Helper\WidgetI18n::label($key);
    if ($widgetLabel !== ''
        && ($widgetLabel !== $key || preg_match('/\p{sc=Han}/u', $key) !== 1)
    ) {
        return $headerCapitalize($widgetLabel);
    }
    if ($headerCategoryService instanceof \WeShop\Catalog\Service\CategoryService) {
        $categoryLabel = $headerCategoryService->localizeCategoryDisplayName($key);
        if ($categoryLabel !== '' && $categoryLabel !== $key) {
            return $headerCapitalize($categoryLabel);
        }
    }
    $translated = (string)__($key);

    return $headerCapitalize($translated !== '' ? $translated : $key);
};
$headerDesc = static function ($value) use ($headerCategoryService): string {
    $key = trim((string)($value ?? ''));
    if ($key === '') {
        return '';
    }
    try {
        $widgetLabel = \Weline\Theme\Helper\WidgetI18n::label($key);
        if ($widgetLabel !== ''
            && ($widgetLabel !== $key || preg_match('/\p{sc=Han}/u', $key) !== 1)
        ) {
            return $widgetLabel;
        }
    } catch (\Throwable) {
    }
    if ($headerCategoryService instanceof \WeShop\Catalog\Service\CategoryService
        && method_exists($headerCategoryService, 'localizeCategoryDescription')) {
        $categoryDescription = (string)$headerCategoryService->localizeCategoryDescription($key);
        if ($categoryDescription !== '' && $categoryDescription !== $key) {
            return $categoryDescription;
        }
    }
    $translated = (string)__($key);

    return $translated !== '' ? $translated : $key;
};
$headerEsc = static function ($value) use ($headerLabel): string {
    return htmlspecialchars($headerLabel($value), ENT_QUOTES, 'UTF-8');
};
$headerEscDesc = static function ($value) use ($headerDesc): string {
    return htmlspecialchars($headerDesc($value), ENT_QUOTES, 'UTF-8');
};

// 注意：navItems 可能在 hook (Weline_Theme::frontend::partials::header::categories-before) 中被设置
// 默认导航由 active theme 链上的 partials/header/nav-defaults.phtml 提供（design 可覆盖）。
$defaultNavItemsFactory = static function (): array {
    static $defaultNavItems = null;
    if ($defaultNavItems !== null) {
        return $defaultNavItems;
    }

    try {
        /** @var \Weline\Theme\Helper\HeaderDefaultNavItems $resolver */
        $resolver = \Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Theme\Helper\HeaderDefaultNavItems::class
        );
        $defaultNavItems = $resolver->resolve();
    } catch (\Throwable) {
        $defaultNavItems = \Weline\Theme\Helper\HeaderDefaultNavItems::genericDefaults();
    }

    return $defaultNavItems;
};

