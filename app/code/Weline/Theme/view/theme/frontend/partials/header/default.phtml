/* 展开/收起箭头图标 */
.my-menu-submenu-arrow {
    margin-left: auto;
    margin-right: 0;
    width: auto;
    font-size: var(--font-size-xs);
    color: <?= htmlspecialchars($colors['textSecondary'] ?? 'var(--color-text-faint)') ?>;
    transition: transform 0.3s ease, color 0.2s ease;
}

.my-menu-submenu.active .my-menu-submenu-arrow {
    transform: rotate(90deg);
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.my-menu-submenu-title:hover .my-menu-submenu-arrow {
    color: <?= htmlspecialchars($colors['primary'] ?? 'var(--color-brand-orange)') ?>;
}

.my-menu-submenu-content {
    display: none;
    padding: var(--spacing-xs) 0;
    background-color: <?= htmlspecialchars($colors['bgSecondary'] ?? 'var(--color-bg-secondary)') ?>;
    border-top: var(--border-width-thin) solid <?= htmlspecialchars($colors['bgTertiary'] ?? 'var(--color-bg-tertiary)') ?>;
