<?php
/**
 * 服务条款默认布局（亚马逊条款式壳 + policy-document 可编辑正文）
 *
 * Theme 主题默认条款页：页面骨架 + 单一内容 slot；正文由 policy-document 承载。
 * 真实法务文案可通过 meta.content 或整页替换 content slot。
 *
 * @meta.name {default="服务条款页面布局",name="服务条款页面布局",description="Theme 自有的服务条款默认布局"}
 * @meta.description {default="包含 header、面包屑与整页内容 slot（默认服务条款部件）",name="描述",description="内容区为单一 slot 的服务条款默认页"}
 * @param.title {default="服务条款",name="页面标题",description="服务条款页面标题"}
 * @param.meta_title {default="",name="SEO标题",description="SEO标题，留空时回退页面标题；有实体SEO时不覆盖实体"}
 * @param.meta_description {default="阅读使用本站服务前需要了解的条款与条件。",name="SEO描述",description="SEO描述，用于搜索结果和社交摘要；有实体SEO时不覆盖实体"}
 * @param.subtitle {default="",name="页面副标题",description="留空时使用部件默认导语"}
 * @param.content {default="",name="主要内容（HTML）",description="非空时整页替换默认条款正文"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.showBreadcrumb {default=true,name="显示面包屑",description="是否显示面包屑导航"}
 * @param.class {default="",name="额外 CSS 类",description="服务条款主内容区域的额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::terms::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body class="terms-layout amazon-terms-layout amazon-policy-layout <?= $escape($meta['class'] ?? '') ?>">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::terms::body-start</w:hook>

    <div class="weline-page-wrapper amazon-terms amazon-policy" data-testid="storefront-terms-page" data-layout="terms">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <main class="amazon-terms__main amazon-policy__main" id="main-content" data-layout="terms">
            <w:slot id="content"
                    name="内容区"
                    accept="layout-terms-content,layout-policy-term-condition-content,layout-policy-content,layout-default-content,content,policy-content,term-condition,terms,cms-content,faq"
                    reject="header,footer,navigation,cart,checkout"
                    multiple="true"
                    position="content"
                    class="amazon-terms__content-root-slot amazon-policy__content-root-slot">
            <div class="policy-main <?= $escape($meta['class'] ?? '') ?>" data-layout="terms">
                <w:slot id="policy-content"
                        name="服务条款正文"
                        accept="layout-terms-content,layout-policy-term-condition-content,layout-policy-content,policy-content,content,faq,terms"
                        reject="header,footer"
                        multiple="true"
                        position="content"
                        class="amazon-policy__content-slot">
                <if condition="meta.content">
                    {{meta.content}}
                <else/>
                    <div class="amazon-terms__stage amazon-policy__stage">
                        <if condition="meta.showBreadcrumb">
                            <div class="amazon-terms__breadcrumb amazon-policy__breadcrumb">
                                <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
                                <w:hook>Weline_Theme::frontend::layouts::terms::breadcrumb-before</w:hook>
                                <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
                                <w:hook>Weline_Theme::frontend::layouts::terms::breadcrumb-after</w:hook>
                                <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>
                            </div>
                        </if>
                        <w:widget type="content" name="policy-document" params='{"page":"terms","variant":"amazon"}' />
                    </div>
                </if>
                </w:slot>
            </div>
            </w:slot>
        </main>

        <w:slot id="terms-bottom"
                name="条款页底部扩展"
                accept="layout-terms-bottom,banner,promo-banner,content,container,product,category,carousel,trust-badges,contact-info"
                reject="header,footer,navigation"
                multiple="true"
                append="true"
                position="content"
                class="terms-bottom-slot">
            <w:hook>
                Weline_Theme::frontend::layouts::terms::bottom
                <else/>
                <w:widget type="content" name="contact-info" />
            </w:hook>
        </w:slot>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default"/>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-after</w:hook>
        </if>
    </div>

    <w:hook>Weline_Theme::frontend::layouts::terms::body-end</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>
    <w:hook>seo::footer</w:hook>
</body>
</html>
