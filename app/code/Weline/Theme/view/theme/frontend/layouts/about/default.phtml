 * 关于我们默认布局（通用店面壳）
 *
 * Theme 提供页面骨架、slot 协议与默认品牌故事内容；真实文案/团队可通过 hook/slot 接入。
 * 通用关于页骨架；品牌故事由 app/design 主题覆盖。
 *
 * @meta.name {default="关于我们",name="关于我们",description="品牌故事与站点介绍（站名取自 Website 基础信息）"}
 * @meta.description {default="包含 header、面包屑、使命主视觉、故事、价值观、里程碑与 footer",name="描述",description="带布局级 slot 的关于我们默认页面"}
 * @param.title {default="关于我们",name="页面标题",description="关于我们页面标题"}
 * @param.meta_title {default="",name="SEO标题",description="SEO标题，留空时回退页面标题；有实体SEO时不覆盖实体"}
 * @param.meta_description {default="",name="SEO描述",description="留空时回退网站简介（Website 基础信息）"}
 * @param.subtitle {default="",name="页面副标题",description="留空时使用站点描述"}
 * @param.mission {default="",name="使命文案",description="主视觉使命说明，留空使用默认文案"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.showBreadcrumb {default=true,name="显示面包屑",description="是否显示面包屑导航"}
 * @param.class {default="",name="额外 CSS 类",description="关于我们主内容区域的额外 CSS 类"}
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteContactInfo;
use Weline\Theme\Helper\WidgetI18n;

$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$contact = [
    'site_name' => '',
    'site_description' => (string)WidgetI18n::label('精选优质商品与可靠服务，覆盖日常选购与礼赠场景。'),
    'contact_email' => SiteContactInfo::PLACEHOLDER_EMAIL,
    'contact_phone' => '',
    'service_hours' => (string)WidgetI18n::label('周一至周五 9:00 - 18:00（法定节假日除外）'),
    'contact_address' => '',
];
try {
    $resolver = ObjectManager::getInstance(SiteContactInfo::class);
    if ($resolver instanceof SiteContactInfo) {
        $contact = array_merge($contact, $resolver->resolve());
    }
} catch (\Throwable) {
}
try {
    $siteBrand = ObjectManager::getInstance(\Weline\Theme\Helper\SiteBrand::class);
    if ($siteBrand instanceof \Weline\Theme\Helper\SiteBrand) {
        $resolvedName = trim($siteBrand->resolveFrontendSiteName((string)($contact['site_name'] ?? '')));
        if ($resolvedName !== '') {
            $contact['site_name'] = $resolvedName;
        }
        $resolvedDescription = trim($siteBrand->resolveFrontendSiteDescription((string)($contact['site_description'] ?? '')));
        if ($resolvedDescription !== '') {
            $contact['site_description'] = $resolvedDescription;
        }
    }
} catch (\Throwable) {
}

$siteName = trim((string)$contact['site_name']);
$candidate = trim((string)($meta['title'] ?? ''));
if ($candidate === '' || \Weline\Framework\View\Helper\EmbeddedPageTitle::isModulePlaceholder($candidate)) {
    $title = WidgetI18n::label('关于我们');
} else {
    $title = WidgetI18n::label($candidate);
}
if ($title === '' || \Weline\Framework\View\Helper\EmbeddedPageTitle::isModulePlaceholder($title)) {
    $title = '关于我们';
}
$this->setData('title', $title);
$subtitle = trim((string)($meta['subtitle'] ?? ''));
if ($subtitle === '' || $subtitle === '官方商城帮助与客户服务') {
    $subtitle = trim((string)($contact['site_description'] ?? ''));
}
if ($subtitle === '' || $subtitle === '官方商城帮助与客户服务') {
    $subtitle = '精选优质商品与可靠服务，覆盖日常选购与礼赠场景。';
}
$subtitle = WidgetI18n::label($subtitle);
$mission = trim((string)($meta['mission'] ?? ''));
if ($mission === '') {
    $mission = '以清晰规格与可靠履约为准绳，把日常好物送到每一位顾客手中。';
}
$mission = WidgetI18n::label($mission);

$stats = [
    ['value' => WidgetI18n::label('精选货架'), 'label' => WidgetI18n::label('日常品类')],
    ['value' => WidgetI18n::label('真实可售'), 'label' => WidgetI18n::label('在售商品')],
    ['value' => __('7×24'), 'label' => WidgetI18n::label('客户支持')],
    ['value' => WidgetI18n::label('安心售后'), 'label' => WidgetI18n::label('退换指引')],
];

$values = [
    [
        'title' => WidgetI18n::label('选品有据'),
        'desc' => WidgetI18n::label('先看清规格与场景，再下单，让每一次选购都踏实可依。'),
    ],
    [
        'title' => WidgetI18n::label('描述可信'),
        'desc' => WidgetI18n::label('标题、卖点与详情对齐真实可售商品，不堆砌空洞口号。'),
    ],
    [
        'title' => WidgetI18n::label('日常可用'),
        'desc' => WidgetI18n::label('覆盖居家、礼赠与刚需补给等多种场景，买得到、用得上。'),
    ],
    [
        'title' => WidgetI18n::label('履约可靠'),
        'desc' => WidgetI18n::label('订单可追踪、售后有指引，独立站多语言与本地配送并行。'),
    ],
];

$milestones = [
    ['year' => '2019', 'text' => WidgetI18n::label('从品类整理起步，建立清晰的入门选购标准。')],
    ['year' => '2021', 'text' => WidgetI18n::label('扩展主力货架与日用矩阵，覆盖更多日常场景。')],
    ['year' => '2023', 'text' => WidgetI18n::label('完善规格、养护与退换指引，服务独立站顾客。')],
    ['year' => '2026', 'text' => WidgetI18n::label('打磨可上线的多站店面体验，让品牌故事与货架一致。')],
];
