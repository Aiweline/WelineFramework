<?php
/**
 * 布局：政策页面 - 默认布局（单栏 + policy-document）
 * @meta.name {default="政策页面默认布局",name="政策页面默认布局",description="政策页面默认布局"}
 * @meta.description {default="政策页面默认布局，适用于隐私政策、服务条款等内容页面",name="政策页面默认布局",description="政策汇总页"}
 * @param title {default="政策页面",name="页面标题",description="页面标题"}
 * @param meta_title {default="",name="SEO标题",description="SEO标题"}
 * @param meta_description {default="阅读本站隐私、Cookie、退款与相关法律政策说明。",name="SEO描述",description="SEO描述"}
 * @param content {default="",name="主要内容（HTML字符串）",description="非空时覆盖默认正文"}
 * @param showHeader {default=true,name="是否显示header",description="是否显示header"}
 * @param showFooter {default=true,name="是否显示footer",description="是否显示footer"}
 * @param showBreadcrumb {default=true,name="显示面包屑",description="是否显示面包屑导航"}
 * @param class {default="",name="额外CSS类",description="额外CSS类"}
 */
$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::policy::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body>
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::policy::body-start</w:hook>

    <div class="weline-page-wrapper weline-policy-page">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::policy::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::policy::header-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <if condition="meta.showBreadcrumb">
            <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::policy::breadcrumb-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
            <w:hook>Weline_Theme::frontend::layouts::policy::breadcrumb-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>
        </if>

        <div class="weline-main-content">
            <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::policy::content-before</w:hook>
            <w:slot id="content"
                    name="内容区"
                    accept="layout-policy-content,layout-default-content,content,policy-content,cms-content,faq"
                    reject="header,footer"
                    multiple="true"
                    position="content"
                    class="policy-main__content-root-slot">
            <w:hook>Weline_Theme::frontend::layouts::policy::main-before</w:hook>
            <main class="policy-main <?= $escape($meta['class'] ?? '') ?> default" id="policy-main" data-layout="policy">
                <w:slot id="policy-content"
                        name="政策正文内容"
                        accept="layout-policy-content,layout-cms-content,policy-content,content,faq"
                        reject="header,footer"
                        multiple="true"
                        position="content"
                        class="policy-main__content-slot">
                <if condition="meta.content">
                    {{meta.content}}
                <else/>
                    <w:widget type="content" name="policy-document" params='{"page":"default","variant":"plain"}' />
                </if>
                </w:slot>
            </main>
            <w:hook>Weline_Theme::frontend::layouts::policy::main-after</w:hook>
            </w:slot>
            <w:hook>Weline_Theme::frontend::layouts::policy::content-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
        </div>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::policy::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default"/>
            <w:hook>Weline_Theme::frontend::layouts::policy::footer-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-after</w:hook>
        </if>
    </div>

    <w:hook>Weline_Theme::frontend::layouts::policy::body-end</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>
    <w:hook>seo::footer</w:hook>
</body>
</html>
