<?php
/**
 * 帮助中心默认布局（电商常见模板）
 *
 * 自动读取站点名称、描述与联系方式；提供主题话题、FAQ、联系卡片，
 * 并预留可扩展 slot 供其他模块投放小部件。
 *
 * @meta.name {default="帮助中心",name="帮助中心",description="电商帮助中心默认布局"}
 * @meta.description {default="站点帮助中心：主题导航、FAQ、联系方式与可扩展部件槽",name="描述",description="帮助中心页面布局"}
 * @preview.login {default=0,option={0:不需要登录,1:需要登录},name="是否需要登录",description="帮助中心通常允许访客访问"}
 * @param.title {default="帮助中心",name="页面标题",description="帮助中心标题"}
 * @param.subtitle {default="",name="副标题",description="留空时使用站点描述"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.class {default="",name="额外 CSS 类",description="主内容额外 CSS 类"}
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteContactInfo;

$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$contact = [
    'site_name' => 'Weline',
    'site_description' => (string)__('官方商城帮助与客户服务'),
    'contact_email' => 'support@example.com',
    'contact_phone' => '',
    'service_hours' => (string)__('周一至周五 9:00 - 18:00（法定节假日除外）'),
    'contact_address' => '',
];
try {
    $resolver = ObjectManager::getInstance(SiteContactInfo::class);
    if ($resolver instanceof SiteContactInfo) {
        $contact = array_merge($contact, $resolver->resolve());
    }
} catch (\Throwable) {
}

$title = (string)($meta['title'] ?? __('帮助中心'));
$subtitle = trim((string)($meta['subtitle'] ?? ''));
if ($subtitle === '') {
    $subtitle = (string)$contact['site_description'];
}
$siteName = (string)$contact['site_name'];
$email = (string)$contact['contact_email'];
$phone = (string)$contact['contact_phone'];
$hours = (string)$contact['service_hours'];
$address = (string)$contact['contact_address'];
$mailHref = 'mailto:' . $email;
$trackUrl = '/orders/track';
$contactUrl = '/contact';
$accountUrl = '/account';
$cartUrl = '/cart';

$topics = [
    ['icon' => 'truck', 'title' => __('物流配送'), 'desc' => __('发货时效、运费与配送范围'), 'url' => '#help-shipping'],
    ['icon' => 'undo', 'title' => __('退换货'), 'desc' => __('退货条件、流程与退款进度'), 'url' => '/rma'],
    ['icon' => 'credit-card', 'title' => __('支付与发票'), 'desc' => __('支付方式、账单与发票开具'), 'url' => '#help-payment'],
    ['icon' => 'box', 'title' => __('订单问题'), 'desc' => __('下单、改单、取消与订单状态'), 'url' => $trackUrl],
    ['icon' => 'user', 'title' => __('账户与安全'), 'desc' => __('登录、密码与个人信息'), 'url' => $accountUrl],
    ['icon' => 'headset', 'title' => __('联系客服'), 'desc' => __('电话、邮箱与在线支持通道'), 'url' => $contactUrl],
];

$faqs = [
    ['q' => __('下单后多久发货？'), 'a' => __('一般情况下，现货订单在付款成功后 24–48 小时内发出；预售或定制商品以商品页说明为准。')],
    ['q' => __('如何查询物流？'), 'a' => __('可在「订单跟踪」页输入订单号与下单邮箱/手机号查询；登录账户后也可在「我的订单」中查看物流。')],
    ['q' => __('支持哪些支付方式？'), 'a' => __('支持常见在线支付与站点已开通的支付渠道。具体可用方式以结算页展示为准。')],
    ['q' => __('如何申请退换货？'), 'a' => __('请确认商品在可退换期内且符合退换政策，然后前往退换货中心提交申请，或联系客服协助处理。')],
];
?>
