<?php
/**
 * 指南/政策类文档默认布局（亚马逊风格壳）
 *
 * 供 Shipping guide/* 等内容页通过 layoutType=guide.default 注入正文。
 * 壳层：weline-page-wrapper + header/footer；正文区按主题内容宽度 Token 居中，并与头尾拉开纵向间距。
 *
 * @meta.name {default="指南文档布局",name="指南文档布局",description="亚马逊风格政策/指南页壳层"}
 * @meta.description {default="页面包裹器 + 主题宽度正文区，供 guide 内容模板注入",name="描述",description="避免正文贴页头页脚"}
 * @preview.login {default=0,option={0:不需要登录,1:需要登录},name="是否需要登录",description="指南页通常允许访客访问"}
 * @param.title {default="指南",name="页面标题",description="页面标题"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.class {default="",name="额外 CSS 类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$rawContent = (string)($this->getData('meta.content') ?: $this->getData('content') ?: ($meta['content'] ?? ''));
$contentTemplate = (string)($this->getData('meta.contentTemplate') ?: ($meta['contentTemplate'] ?? ''));
$title = (string)($meta['title'] ?? __('指南'));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::guide::head-after</w:hook>
    <style>
        body.guide-layout {
            margin: 0;
            min-height: 100vh;
            color: var(--weline-layout-text-primary, #0f1111);
            background: var(--color-bg-canvas, #fff);
        }
        .amazon-policy-doc.weline-page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: transparent;
        }
        .amazon-policy-doc__main {
            flex: 1 0 auto;
            width: 100%;
            background:
                linear-gradient(180deg, var(--color-bg-secondary, #eaeded) 0, var(--color-bg-muted, #f3f3f3) 12rem);
        }
        .amazon-policy-doc__stage {
            box-sizing: border-box;
            width: min(100%, var(--weline-layout-content-max-width));
            max-width: 100%;
            min-width: 0;
            margin-inline: auto;
            padding-inline: var(--weline-layout-content-padding-inline);
            padding-block: clamp(2.25rem, 4.5vw, 3.25rem) clamp(3rem, 6vw, 4.5rem);
        }
        .amazon-policy-doc__stage > * {
            width: 100%;
            max-width: none;
            margin-inline: 0;
            padding-inline: 0;
            box-sizing: border-box;
        }
    </style>
    <w:hook>seo::head</w:hook>
</head>
<body class="guide-layout amazon-policy-doc-layout <?= $escape($meta['class'] ?? '') ?>">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::guide::body-start</w:hook>

    <div class="weline-page-wrapper amazon-policy-doc" data-testid="storefront-guide-page" data-layout="guide">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <main class="amazon-policy-doc__main" id="main-content" aria-label="<?= $escape($title) ?>">
            <div class="amazon-policy-doc__stage">
                <w:slot id="content"
                        name="指南正文"
                        accept="layout-guide-content,layout-policy-content,content,faq,policy-content"
                        reject="header,footer,navigation"
                        multiple="true"
                        position="content"
                        class="amazon-policy-doc__content-slot">
                    <w:hook>
                        Weline_Theme::frontend::layouts::guide::content
                        <else/>
                        <?php if (trim($rawContent) !== ''): ?>
                            <?= $rawContent ?>
                        <?php elseif ($contentTemplate !== ''): ?>
                            <?= $this->fetch($contentTemplate) ?>
                        <?php endif; ?>
                    </w:hook>
                </w:slot>
            </div>
        </main>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default" vars="copyright,links,showBackToTop,socialMedia,showSocialMedia"/>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-after</w:hook>
        </if>
    </div>

    <w:hook>Weline_Theme::frontend::layouts::guide::body-end</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>
    <w:hook>seo::footer</w:hook>
</body>
</html>
