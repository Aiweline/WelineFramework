                            <?= $this->fetch($contentTemplate) ?>
                        <?php else: ?>
                            <div class="guide-default-widget-stack" weline-code="theme.guide.widget_stack">
                                <w:widget type="content" name="section-heading" />
                                <w:widget type="faq" name="faq-accordion" />
