/**
 * 联系我们页面布局。
 *
 * Theme 只提供页面骨架、slot 协议和默认兜底内容；真实客服、FAQ 或表单可以通过 hook/slot 接入。
 *
 * @meta.name {default="联系我们页面布局",name="联系我们页面布局",description="Theme 自有的联系我们页面布局样本"}
 * @meta.description {default="包含 header、面包屑、联系主视觉、联系方式、表单、FAQ 和 footer",name="描述",description="带布局级 slot 的联系我们默认页面"}
 * @param.title {default="联系我们",name="页面标题",description="联系我们页面标题"}
 * @param.meta_title {default="",name="SEO标题",description="SEO标题，留空时回退页面标题；有实体SEO时不覆盖实体"}
 * @param.meta_description {default="",name="SEO描述",description="留空时回退网站简介（Website 基础信息）"}
 * @param.subtitle {default="告诉我们你需要什么，支持团队会将请求分派给合适的处理人。",name="页面副标题",description="联系我们页面引导文案"}
 * @param.contactEmail {default="",name="客服邮箱",description="留空则用网站 SMTP / SiteContactInfo；勿写 example.com 占位"}
 * @param.contactPhone {default="",name="客服电话",description="留空则用网站联系配置"}
 * @param.contactHours {default="",name="服务时间",description="留空则用网站联系配置"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.class {default="",name="额外 CSS 类",description="联系我们主内容区域的额外 CSS 类"}
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteContactInfo;
use Weline\Theme\Helper\WidgetI18n;

$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$title = WidgetI18n::label(trim((string)($meta['title'] ?? '')) !== '' ? (string)$meta['title'] : '联系我们');
$subtitle = WidgetI18n::label(
    trim((string)($meta['subtitle'] ?? '')) !== ''
        ? (string)$meta['subtitle']
        : '告诉我们你需要什么，支持团队会将请求分派给合适的处理人。'
);

$contact = [
    'contact_email' => '',
    'contact_phone' => '',
    'service_hours' => (string)WidgetI18n::label('周一至周五，9:00 - 18:00'),
];
try {
    $resolver = ObjectManager::getInstance(SiteContactInfo::class);
    if ($resolver instanceof SiteContactInfo) {
        $contact = array_merge($contact, $resolver->resolve());
    }
} catch (\Throwable) {
}

$paramEmail = trim((string)($meta['contactEmail'] ?? ''));
$contactEmail = ($paramEmail !== '' && !preg_match('/@example\\.com$/i', $paramEmail))
    ? $paramEmail
    : (string)($contact['contact_email'] ?? '');
if ($contactEmail === '' || preg_match('/@example\\.com$/i', $contactEmail)) {
    $contactEmail = '';
}

$paramPhone = trim((string)($meta['contactPhone'] ?? ''));
$contactPhone = ($paramPhone !== '' && !preg_match('/^\\+1\\s*0{3}/', $paramPhone))
    ? $paramPhone
    : (string)($contact['contact_phone'] ?? '');

$paramHours = trim((string)($meta['contactHours'] ?? ''));
$contactHours = WidgetI18n::label(
    $paramHours !== ''
        ? $paramHours
        : (trim((string)($contact['service_hours'] ?? '')) !== ''
            ? (string)$contact['service_hours']
            : '周一至周五，9:00 - 18:00')
);
$mailHref = $contactEmail !== '' ? ('mailto:' . $contactEmail) : '#';
?>
