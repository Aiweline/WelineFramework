<?php
/**
 * 问答页默认布局：Theme 只提供共享壳层与问答内容槽。
 *
 * @meta.name {default="问答页默认布局",name="问答页默认布局",description="问答页面的共享头尾与内容槽"}
 * @meta.description {default="共享站点 chrome、语义主内容和问答业务槽",name="描述",description="问答数据与结构化内容由业务模块提供"}
 * @param title {default="问答",name="页面标题",description="用于主内容区的无障碍名称"}
 * @param content {default="",name="主要内容（HTML）",description="由业务模块或编辑器注入的内容"}
 * @param contentTemplate {default="",name="内容模板",description="由业务模块提供的模板标识"}
 * @param showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param class {default="",name="额外 CSS 类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$title = (string)($meta['title'] ?? __('问答'));
$rawContent = (string)($this->getData('meta.content') ?: $this->getData('content') ?: ($meta['content'] ?? ''));
$contentTemplate = (string)($this->getData('meta.contentTemplate') ?: ($meta['contentTemplate'] ?? ''));
$renderedTemplateContent = trim($rawContent) === '' && $contentTemplate !== ''
    ? (string)$this->fetch($contentTemplate)
    : '';
?>
