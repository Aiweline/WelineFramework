<?php
/**
 * 布局：服务异常页面（镜像 404 壳）- 头尾 + 说明区
 *
 * @meta.name {default="服务异常页面布局",name="服务异常页面布局",description="Amazon 风格 500/服务异常壳，供主题编辑与公网 /error 发现"}
 * @meta.description {default="Amazon 风格服务异常布局",name="服务异常页面布局",description="服务异常页模板；运行时静态 500 仍可走 pub/errors"}
 * @param title {default="服务暂时不可用",name="页面标题",description="页面标题"}
 * @param pageTitle {default="服务暂时不可用",name="异常标题",description="异常主标题"}
 * @param pageLead {default="我们正在处理问题，请稍后再试。",name="异常说明",description="异常主要说明"}
 * @param pageHint {default="您可以返回首页继续浏览，或稍后刷新本页。",name="异常提示",description="异常次要提示"}
 * @param homeHref {default="/",name="首页链接",description="返回首页链接"}
 * @param statusCode {default=500,name="状态码",description="HTTP 状态码"}
 * @param class {default="",name="额外CSS类",description="额外 CSS 类"}
 */
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$statusCode = (int)($meta['statusCode'] ?? 500);
$pageTitle = (string)($meta['pageTitle'] ?? $meta['title'] ?? __('服务暂时不可用'));
$pageLead = (string)($meta['pageLead'] ?? __('我们正在处理问题，请稍后再试。'));
$pageHint = (string)($meta['pageHint'] ?? __('您可以返回首页继续浏览，或稍后刷新本页。'));
$homeHref = (string)($meta['homeHref'] ?? '/');
$homeJs = json_encode($homeHref !== '' ? $homeHref : '/', JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
$esc = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
$seoTitle = trim((string)$statusCode) . ' · ' . $pageTitle;
$this->setData('seo', [
    'page_type' => 'error',
    'title' => $seoTitle,
    'robots' => 'noindex,nofollow',
]);
?>
