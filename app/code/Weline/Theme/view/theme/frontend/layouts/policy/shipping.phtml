$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::policy.shipping::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body class="amazon-policy-layout <?= $escape($meta['class'] ?? '') ?>">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::policy.shipping::body-start</w:hook>

    <div class="weline-page-wrapper amazon-policy weline-shipping-policy" data-testid="storefront-shipping-page" data-layout="policy-shipping">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <main class="amazon-policy__main" id="main-content">
            <w:slot id="content"
                    name="内容区"
                    accept="layout-policy-shipping-content,layout-policy-content,layout-default-content,content,policy-content,cms-content,faq"
                    reject="header,footer"
                    multiple="true"
                    position="content"
                    class="amazon-policy__content-root-slot">
            <div class="policy-main <?= $escape($meta['class'] ?? '') ?>" data-layout="policy-shipping">
                <w:slot id="policy-content"
                        name="配送政策正文"
                        accept="layout-policy-shipping-content,layout-policy-content,policy-content,content,faq"
                        reject="header,footer"
                        multiple="true"
                        position="content"
                        class="amazon-policy__content-slot">
                <if condition="meta.content">
                    {{meta.content}}
                <else/>
                    <div class="amazon-policy__stage">
                        <if condition="meta.showBreadcrumb">
                            <div class="amazon-policy__breadcrumb">
                                <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
                                <w:hook>Weline_Theme::frontend::layouts::policy::breadcrumb-before</w:hook>
                                <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
                                <w:hook>Weline_Theme::frontend::layouts::policy::breadcrumb-after</w:hook>
                                <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>
                            </div>
                        </if>
                        <w:widget type="content" name="policy-document" params='{"page":"shipping","variant":"amazon"}' />
                    </div>
                </if>
                </w:slot>
            </div>
            </w:slot>
        </main>

        <w:slot id="policy-bottom"
                name="政策页底部扩展"
                accept="layout-policy-bottom,banner,promo-banner,content,container,product,category,carousel,trust-badges,contact-info"
                reject="header,footer,navigation"
                multiple="true"
                append="true"
                position="content"
                class="policy-bottom-slot">
            <w:hook>
                Weline_Theme::frontend::layouts::policy::bottom
                <else/>
                <w:widget type="content" name="contact-info" />
            </w:hook>
        </w:slot>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
