                                'search_type' => $searchType,
                                'search_category_id' => $searchCategoryId,
                                'search_types' => $searchTypes,
                            ]);
                            ?>
                        <?php endif; ?>
                        <?php if ($searchType === 'product'): ?>
                            <w:hook>Weline_Search::frontend::search::filters::product</w:hook>
                        <?php endif; ?>
                        <w:slot id="search-filters"
                                name="搜索筛选区"
                                accept="layout-search-filters,layout-category-filters,category-filters,attribute-filter,price-filter"
                                multiple="true"
                                position="sidebar">
                            <if condition="meta.filters">
                                {{meta.filters}}
                            <else/>
                                <w:hook>Weline_Theme::frontend::layouts::search::filters</w:hook>
                            </if>
                        </w:slot>
                    </aside>

                    <section class="search-layout__results" weline-code="theme.search.section_1">
                        <w:slot id="search-results"
                                name="搜索结果区"
                                accept="layout-search-results,layout-product-list-grid,product-grid,product-list-view,search-results"
                                reject="header,footer"
                                multiple="true"
                                position="content">
                            <w:hook>Weline_Theme::frontend::layouts::search::results-before</w:hook>
                            <if condition="meta.content">
                                {{meta.content}}
                            <elseif condition="content"/>
                                {{content}}
                            <elseif condition="meta.contentTemplate"/>
                                <?php echo $this->fetch($this->getData("meta.contentTemplate")); ?>
                            <elseif condition="contentTemplate"/>
                                <?php echo $this->fetch($this->getData("contentTemplate")); ?>
