/** @var \Weline\Framework\View\Template $this */
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$showHeader = ($meta['showHeader'] ?? true) !== false;
$showFooter = ($meta['showFooter'] ?? true) !== false;
$rawContent = (string)($this->getData('meta.content') ?: $this->getData('content') ?: ($meta['content'] ?? ''));
$contentTemplate = (string)($this->getData('meta.contentTemplate') ?: ($meta['contentTemplate'] ?? ''));
$extraClasses = array_values(array_filter(
    preg_split('/\s+/', trim((string)($meta['class'] ?? ''))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1
));
?>
