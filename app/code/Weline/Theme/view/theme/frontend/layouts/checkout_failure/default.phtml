/**
 * 结算失败页规范布局：Theme 只提供共享壳层与恢复内容槽。
 *
 * `checkout_failer` 仍作为历史输入别名，新的 Theme 范围统一写入 `checkout_failure`。
 *
 * @meta.name {default="结算失败页默认布局",name="结算失败页默认布局",description="结算失败页面的共享头尾与恢复内容槽"}
 * @meta.description {default="共享站点 chrome、语义主内容和结算失败业务槽",name="描述",description="错误原因、订单状态与恢复操作由 Checkout 模块提供"}
 * @preview.login {default=0,option={0:不需要登录,1:需要登录},name="是否需要登录",description="结算结果可由访客或登录用户访问"}
 * @param title {default="结算结果",name="页面标题",description="用于主内容区的无障碍名称"}
 * @param content {default="",name="主要内容（HTML）",description="由 Checkout 模块或编辑器注入的内容"}
 * @param contentTemplate {default="",name="内容模板",description="由 Checkout 模块提供的模板标识"}
 * @param showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param class {default="",name="额外 CSS 类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$title = (string)($meta['title'] ?? __('结算结果'));
$rawContent = (string)($this->getData('meta.content') ?: $this->getData('content') ?: ($meta['content'] ?? ''));
$contentTemplate = (string)($this->getData('meta.contentTemplate') ?: ($meta['contentTemplate'] ?? ''));
$renderedTemplateContent = trim($rawContent) === '' && $contentTemplate !== ''
    ? (string)$this->fetch($contentTemplate)
    : '';
?>
