<?php
/**
 * FAQ/常见问题默认布局（亚马逊风格）
 *
 * 自动读取站点名称、描述与联系方式；提供主题话题、FAQ、联系卡片，
 * 并预留可扩展 slot 供其他模块投放小部件。
 *
 * @meta.name {default="FAQ/常见问题",name="FAQ/常见问题",description="电商 FAQ/常见问题默认布局"}
 * @meta.description {default="站点 FAQ：主题导航、问答、联系方式与可扩展部件槽",name="描述",description="FAQ/常见问题页面布局"}
 * @preview.login {default=0,option={0:不需要登录,1:需要登录},name="是否需要登录",description="FAQ 页通常允许访客访问"}
 * @param.title {default="FAQ/常见问题",name="页面标题",description="FAQ 标题"}
 * @param.subtitle {default="",name="副标题",description="留空时使用站点描述"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.class {default="",name="额外 CSS 类",description="主内容额外 CSS 类"}
 */
use Weline\Framework\Manager\ObjectManager;
use Weline\Theme\Helper\SiteContactInfo;
use Weline\Theme\Helper\WidgetI18n;

$meta = $this->getData('meta') ?? [];
$escape = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');

$contact = [
    'site_name' => 'Weline',
    'site_description' => (string)WidgetI18n::label('官方商城常见问题与客户服务'),
    'contact_email' => 'support@example.com',
    'contact_phone' => '',
    'service_hours' => (string)WidgetI18n::label('周一至周五 9:00 - 18:00（法定节假日除外）'),
    'contact_address' => '',
];
try {
    $resolver = ObjectManager::getInstance(SiteContactInfo::class);
    if ($resolver instanceof SiteContactInfo) {
        $contact = array_merge($contact, $resolver->resolve());
    }
} catch (\Throwable) {
}

$title = (string)($meta['title'] ?? WidgetI18n::label('FAQ/常见问题'));
$subtitle = trim((string)($meta['subtitle'] ?? ''));
if ($subtitle === '') {
    $subtitle = (string)$contact['site_description'];
}
if ($subtitle === '' || $subtitle === (string)$contact['site_description']) {
    $lead = (string)WidgetI18n::label('查找订单、配送、退换、支付与账户问题的自助指南。也可搜索关键词，或从下方主题快速进入。');
} else {
    $lead = $subtitle;
}
$siteName = (string)$contact['site_name'];
$email = (string)$contact['contact_email'];
$phone = (string)$contact['contact_phone'];
$hours = (string)$contact['service_hours'];
$address = (string)$contact['contact_address'];
$mailHref = 'mailto:' . $email;
$updatedAt = date('Y-m-d');

$topics = $this->getData('faq_topics');
$faqs = $this->getData('faq_faqs');
$quickLinks = $this->getData('faq_quick_links');
$faqArticle = is_array($this->getData('faq_article')) ? $this->getData('faq_article') : null;
$faqSpiTemplate = trim((string)($this->getData('faq_spi_template') ?? ''));
$isFaqArticle = is_array($faqArticle) && (
    $faqSpiTemplate !== ''
    || trim((string)($faqArticle['slug'] ?? '')) !== ''
    || trim((string)($faqArticle['title'] ?? '')) !== ''
);
if (!$isFaqArticle && ((!is_array($topics) || $topics === []) || (!is_array($faqs) || $faqs === []) || (!is_array($quickLinks) || $quickLinks === []))) {
    try {
        /** @var \Weline\Faq\Service\FaqHubContent $hub */
        $hub = ObjectManager::getInstance(\Weline\Faq\Service\FaqHubContent::class);
        if (!is_array($topics) || $topics === []) {
            $topics = $hub->topics();
        }
        if (!is_array($faqs) || $faqs === []) {
            $faqs = $hub->faqs();
        }
        if (!is_array($quickLinks) || $quickLinks === []) {
            $quickLinks = $hub->quickLinks();
        }
    } catch (\Throwable) {
        $topics = is_array($topics) ? $topics : [];
        $faqs = is_array($faqs) ? $faqs : [];
        $quickLinks = is_array($quickLinks) ? $quickLinks : [];
    }
}
$topics = is_array($topics) ? $topics : [];
$faqs = is_array($faqs) ? $faqs : [];
$quickLinks = is_array($quickLinks) ? $quickLinks : [];
$ariaSupport = (string)WidgetI18n::label('FAQ 支持');
$ariaQuick = (string)WidgetI18n::label('快捷入口');
$ariaSearch = (string)WidgetI18n::label('搜索常见问题');
$searchPlaceholder = (string)WidgetI18n::label('搜索常见问题，例如：退货、运费、发票');
?>
