<?php
/**
 * Theme shop hub — public path /shop (layout_resolve 1:1).
 * Design themes may override, e.g.:
 * - app/design/Weline/daocharms/frontend/layouts/shop/default.phtml
 * - app/design/Weline/hanfu/frontend/layouts/shop/default.phtml
 *
 * Default theme (no design override) must still render a usable hub — not a bare title.
 *
 * @meta.name {default="选购",name="选购",description="选购入口：品类与精选商品"}
 * @param.title {default="选购",name="页面标题",description="页面标题"}
 * @param.showHeader {default=true,name="显示 header",description="是否渲染站点头部"}
 * @param.showFooter {default=true,name="显示 footer",description="是否渲染站点底部"}
 * @param.showBreadcrumb {default=true,name="显示面包屑",description="是否显示面包屑"}
 */
$meta = is_array($this->getData('meta') ?? null) ? $this->getData('meta') : [];
$title = \Weline\Theme\Helper\WidgetI18n::label((string)($meta['title'] ?? '选购'));
$meta['title'] = $title;
$this->assign('title', $title);
$this->assign('meta', $meta);
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
$lede = (string)\Weline\Theme\Helper\WidgetI18n::label('按分类浏览，或进入全部商品列表继续选购。');
$ctaProducts = (string)\Weline\Theme\Helper\WidgetI18n::label('浏览全部商品');
$ctaCategory = (string)\Weline\Theme\Helper\WidgetI18n::label('按分类选购');
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::shop::head-after</w:hook>
    <w:hook>seo::head</w:hook>
    <style data-theme-inline="theme-shop-hub">
        .theme-shop-hub { width: min(100%, var(--weline-layout-content-max-width, 1280px)); margin: 0 auto; padding: 1.25rem 1rem 2.5rem; }
        .theme-shop-hub__hero { margin: 0 0 1.75rem; max-width: 42rem; }
        .theme-shop-hub__title { margin: 0 0 0.65rem; font-size: clamp(1.75rem, 2.4vw, 2.35rem); line-height: 1.2; }
        .theme-shop-hub__lede { margin: 0 0 1.1rem; font-size: 1.05rem; line-height: 1.55; opacity: 0.9; }
        .theme-shop-hub__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
        .theme-shop-hub__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.5rem; padding: 0.5rem 1.1rem; border-radius: var(--weline-theme-radius-sm, 4px); text-decoration: none; font-weight: 600; }
        .theme-shop-hub__btn--primary { background: var(--weline-theme-accent, #b84a3c); color: #fff; }
        .theme-shop-hub__btn--ghost { border: 1px solid var(--weline-theme-border, #d8d2c8); color: inherit; }
        .theme-shop-hub__section { margin: 2rem 0 0; }
    </style>
</head>
<body class="theme-layout-shop" data-layout="shop">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <div class="weline-page-wrapper" data-testid="storefront-shop-page">
        <if condition="meta.showHeader">
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
        </if>
        <if condition="meta.showBreadcrumb">
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
        </if>
        <main id="main-content" data-layout="shop">
            <w:slot id="content"
                    name="内容区"
                    accept="layout-shop-content,content,category-grid,product,banner,cta"
                    multiple="true"
                    position="content">
                <w:hook>Weline_Theme::frontend::layouts::shop::content<else/>
                    <article class="theme-shop-hub" weline-code="theme.shop.hub">
                        <header class="theme-shop-hub__hero">
                            <h1 class="theme-shop-hub__title" id="shop-hub-title"><?= $escape($title) ?></h1>
                            <p class="theme-shop-hub__lede"><?= $escape($lede) ?></p>
                            <div class="theme-shop-hub__actions">
                                <a class="theme-shop-hub__btn theme-shop-hub__btn--primary" href="@url{'products'}"><?= $escape($ctaProducts) ?></a>
                                <a class="theme-shop-hub__btn theme-shop-hub__btn--ghost" href="@url{'category'}"><?= $escape($ctaCategory) ?></a>
                            </div>
                        </header>
                        <section class="theme-shop-hub__section" aria-labelledby="shop-hub-title" weline-code="theme.shop.categories">
                            <w:widget type="category" name="category-grid" params='{"display_mode":"strip","limit":"8","columns":"4","show_count":true}' />
                        </section>
                        <section class="theme-shop-hub__section" weline-code="theme.shop.featured">
                            <w:widget type="product" name="featured-products" params='{"limit":"8","columns":"4"}' />
                        </section>
                        <section class="theme-shop-hub__section" weline-code="theme.shop.new_arrivals">
                            <w:widget type="product" name="new-arrivals" params='{"limit":"8","columns":"4"}' />
                        </section>
                    </article>
                </w:hook>
            </w:slot>
        </main>
        <if condition="meta.showFooter">
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default" vars="copyright,links,showBackToTop,socialMedia,showSocialMedia"/>
        </if>
    </div>
    <w:hook>Weline_Theme::frontend::layouts::shop::body-end</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>
    <w:hook>seo::footer</w:hook>
</body>
</html>
