<?php
/**
 * Layout: homepage default.
 *
 * Keeps the established homepage slot ids while making the default Theme page
 * complete without any store/catalog module.
 *
 * @meta.name {default="Homepage Default",name="Homepage Default",description="Default homepage layout"}
 * @param.title {default="Home",name="Page Title",description="Page title"}
 * @param.content {default="",name="Content HTML",description="Main content"}
 * @param.showHeader {default=true,name="Show Header",description="Whether to render header"}
 * @param.showFooter {default=true,name="Show Footer",description="Whether to render footer"}
 * @param.class {default="",name="Extra CSS class",description="Extra CSS class"}
 */

$meta = $this->getData('meta') ?? [];
$class = htmlspecialchars((string)($meta['class'] ?? ''), ENT_QUOTES, 'UTF-8');
$metaContent = (string)($meta['content'] ?? '');
$isEditorPreview = (bool)($this->getData('editor_mode') ?? false)
    || (string)($this->getData('preview_mode') ?? '') !== '';
$shouldRenderMetaContent = trim($metaContent) !== '' && !$isEditorPreview;
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <style data-theme-inline="layout-homepage-default">
        .theme-layout-homepage .homepage-main {
            overflow: hidden;
        }

        .theme-layout-homepage .homepage-section {
            padding: clamp(var(--weline-layout-spacing-xl), 6vw, calc(var(--weline-layout-spacing-3xl) * 1.2)) 0;
        }

        .theme-layout-homepage .homepage-section--soft {
            background: var(--weline-theme-surface-subtle);
        }
    </style>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::homepage::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body class="theme-layout-homepage <?= $class ?>">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::homepage::body-start</w:hook>

    <div class="weline-page-wrapper">
        <if condition="meta.showHeader">
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::homepage::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::homepage::header-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        </if>

        <main class="weline-main-content homepage-main" id="homepage-main" data-layout="homepage">
            <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::homepage::content-before</w:hook>

            <w:slot id="content"
                    name="Homepage content"
                    accept="layout-homepage-content,layout-default-content,content,container,banner,carousel,product,category"
                    multiple="true"
                    reject="header,footer"
                    position="content"
                    class="homepage-content-slot">
                <w:hook>
                    Weline_Theme::frontend::layouts::homepage::content
                    <else/>
                <?php if ($shouldRenderMetaContent): ?>
                    <?php echo $metaContent; ?>
                <?php else: ?>
                    <w:slot id="homepage-hero"
                            name="Homepage hero"
                            accept="layout-homepage-hero,hero-slider,promo-banner,banner,carousel,hero"
                            exclusive="true"
                            multiple="false"
                            position="content"
                            wrapper="section"
                            class="homepage-section homepage-hero" weline-code="theme.homepage.homepage_hero">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::hero<else/></w:hook>
                    </w:slot>

                    <w:slot id="homepage-featured"
                            name="Homepage featured"
