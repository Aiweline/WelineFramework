/**
 * Layout: homepage default.
 *
 * Keeps the established homepage slot ids while making the default Theme page
 * complete without any store/catalog module.
 *
 * @meta.name {default="首页",name="首页",description="默认商城首页（站名取自 Website 基础信息）"}
 * @param.title {default="",name="页面标题 · Page title",description="留空则使用当前网站名称（Website 基础信息）"}
 * @param.meta_title {default="",name="SEO标题",description="SEO标题，留空时回退页面标题；有实体SEO时不覆盖实体"}
 * @param.meta_description {default="",name="SEO描述",description="SEO描述，用于搜索结果和社交摘要；有实体SEO时不覆盖实体"}
 * @param.content {default="",name="Content HTML",description="Main content"}
 * @param.showHeader {default=true,name="Show Header",description="Whether to render header"}
 * @param.showFooter {default=true,name="Show Footer",description="Whether to render footer"}
 * @param.class {default="",name="Extra CSS class",description="Extra CSS class"}
 */

$meta = $this->getData('meta') ?? [];
if (!is_array($meta)) {
    $meta = [];
}
// wave9-9s4: prevent omitted showHeader from dropping Partials chrome (Taglib ?? null).
$meta['showHeader'] = ($meta['showHeader'] ?? $this->getData('showHeader') ?? true);
$meta['showFooter'] = ($meta['showFooter'] ?? $this->getData('showFooter') ?? ($meta['showHeader'] !== false));
$this->assign('meta', $meta);
$class = htmlspecialchars((string)($meta['class'] ?? ''), ENT_QUOTES, 'UTF-8');
$metaContent = (string)($meta['content'] ?? '');
$isEditorPreview = (bool)($this->getData('editor_mode') ?? false);
if (!$isEditorPreview) {
    try {
        $editorModeFlag = trim((string)(\Weline\Framework\Manager\ObjectManager::getInstance(
            \Weline\Framework\Http\Request::class
        )->getParam('editor_mode', '')));
        $isEditorPreview = ($editorModeFlag === '1' || strtolower($editorModeFlag) === 'true');
    } catch (\Throwable) {
        $isEditorPreview = false;
    }
}
// Nested homepage-* slots + layout entities own the content tree on storefront.
// Never let meta.content (wrap residue / WLS meta leak) suppress hero/featured/videos.
$shouldRenderMetaContent = false;

$requestUri = (string)(\Weline\Framework\Env\WelineEnv::server('REQUEST_URI', '') ?: ($_SERVER['REQUEST_URI'] ?? ''));
$currentLocale = trim(\Weline\Framework\App\State::getLangLocal());
if ($currentLocale === ''
    && preg_match('#/([a-z]{2}(?:_[A-Za-z]{2,4}){1,2})(?:/|$)#', $requestUri, $localeMatch) === 1
) {
    $currentLocale = (string)$localeMatch[1];
}
$normalizedLocale = strtolower(str_replace('_', '-', $currentLocale));
$isChineseLocale = $normalizedLocale === '' || str_starts_with($normalizedLocale, 'zh');
$useEnglishCopy = !$isChineseLocale;
$translateThemeCopy = static function (string $source, string $english) use ($useEnglishCopy): string {
    try {
        $translated = trim((string)\Weline\Theme\Helper\WidgetI18n::label($source));
    } catch (\Throwable) {
        $translated = $source;
    }
    if ($translated === '') {
        $translated = $source;
    }

    return $useEnglishCopy && $translated === $source ? $english : $translated;
};

$defaultBrandTitle = '';
try {
    $siteBrand = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\Theme\Helper\SiteBrand::class);
    if ($siteBrand instanceof \Weline\Theme\Helper\SiteBrand) {
        $defaultBrandTitle = trim($siteBrand->resolveFrontendSiteName());
    }
} catch (\Throwable) {
    $defaultBrandTitle = '';
}
$localizedBrandTitle = $defaultBrandTitle !== ''
    ? $translateThemeCopy($defaultBrandTitle, $defaultBrandTitle)
    : '';
$configuredTitle = trim((string)($meta['title'] ?? $this->getData('title') ?? ''));
if ($configuredTitle === '' || preg_match('/^[A-Z][A-Za-z0-9]*_[A-Z][A-Za-z0-9_]*$/', $configuredTitle) === 1) {
    $configuredTitle = $defaultBrandTitle;
}
$semanticTitle = ($defaultBrandTitle !== '' && $configuredTitle === $defaultBrandTitle)
    ? $localizedBrandTitle
    : $configuredTitle;
?>
