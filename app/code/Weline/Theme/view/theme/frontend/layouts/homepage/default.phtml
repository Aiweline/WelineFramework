                            wrapper="section"
                            class="homepage-section" weline-code="theme.homepage.homepage_categories">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::categories<else/></w:hook>
                    </w:slot>

                    <w:slot id="homepage-promo"
                            name="Homepage promotion"
