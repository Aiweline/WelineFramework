                    </w:slot>

                    <w:slot id="homepage-bestsellers"
                            name="Homepage bestsellers"
                            accept="layout-homepage-bestsellers,bestseller-products,product-list,product,content"
                            multiple="true"
                            position="content"
                            wrapper="section"
                            class="homepage-section" weline-code="theme.homepage.homepage_bestsellers">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::bestsellers<else/></w:hook>
                    </w:slot>

                    <w:slot id="homepage-brands"
                            name="Homepage brands"
                            accept="layout-homepage-brands,brand-list,brands,content"
                            multiple="true"
                            position="content"
                            wrapper="section"
                            class="homepage-section homepage-section--soft" weline-code="theme.homepage.homepage_brands">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::brands<else/></w:hook>
                    </w:slot>

                    <w:slot id="homepage-trust"
                            name="Homepage trust"
                            accept="layout-homepage-trust,trust-badges,testimonial,content"
                            multiple="true"
                            position="content"
                            wrapper="section"
                            class="homepage-section" weline-code="theme.homepage.homepage_trust">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::trust<else/></w:hook>
                    </w:slot>
                <?php endif; ?>
                </w:hook>
            </w:slot>

            <w:hook>Weline_Theme::frontend::layouts::homepage::content-after</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
        </main>

        <if condition="meta.showFooter">
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:hook>Weline_Theme::frontend::layouts::homepage::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default" vars="copyright,links,showBackToTop,socialMedia,showSocialMedia"/>
            <w:hook>Weline_Theme::frontend::layouts::homepage::footer-after</w:hook>
