                            multiple="true"
                            position="content"
                            wrapper="section"
                            class="homepage-section homepage-section--soft" weline-code="theme.homepage.homepage_featured">
                        <w:hook>Weline_Theme::frontend::layouts::homepage::featured<else/></w:hook>
                    </w:slot>

                    <w:slot id="homepage-categories"
                            name="Homepage categories"
