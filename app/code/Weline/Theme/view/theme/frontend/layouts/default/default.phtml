<?php
/**
 * @meta.name {default="Weline UI 2.0 前台默认布局",name="Weline UI 2.0 前台默认布局"}
 * @meta.description {default="Native frontend shell with explicit resources and slots.",name="自研前台壳层"}
 * @param.title {default="Weline",name="页面标题"}
 * @param.content {default="",name="主要内容"}
 * @param.showHeader {default=true,name="显示顶部"}
 * @param.showFooter {default=true,name="显示页脚"}
 * @param.class {default="",name="额外 Weline CSS 类"}
 */
/** @var \Weline\Framework\View\Template $this */
$meta = is_array($this->getData('meta')) ? $this->getData('meta') : [];
$showHeader = ($meta['showHeader'] ?? true) !== false;
$showFooter = ($meta['showFooter'] ?? true) !== false;
$rawContent = (string)($this->getData('meta.content') ?: $this->getData('content') ?: ($meta['content'] ?? ''));
$contentTemplate = (string)($this->getData('meta.contentTemplate') ?: ($meta['contentTemplate'] ?? ''));
$extraClasses = array_values(array_filter(
    preg_split('/\s+/', trim((string)($meta['class'] ?? ''))) ?: [],
    static fn(string $class): bool => preg_match('/^w-[a-z0-9_-]+$/', $class) === 1
));
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-w-area="frontend" data-theme-preference="light" data-theme="light">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::default::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body id="top">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::default::body-start</w:hook>

    <div class="w-frontend-shell <?= htmlspecialchars(implode(' ', $extraClasses), ENT_QUOTES, 'UTF-8') ?>">
        <w:slot id="page-top" name="Page top" accept="layout-page-top,announcement,banner,content" multiple="true" append="true" position="content" class="w-frontend-page-top">
            <w:hook>Weline_Theme::frontend::layouts::default::page-top</w:hook>
        </w:slot>

        <?php if ($showHeader): ?>
            <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
            <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
        <?php endif; ?>

        <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
        <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
        <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>

        <main class="w-frontend-main" id="main-content" data-layout="default">
            <div class="w-container w-frontend-page">
                <w:slot id="content-before" name="Content before" accept="layout-content-before,layout-default-before,banner,content,container" multiple="true" append="true" position="content" class="w-frontend-content-before">
                    <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>
                    <w:hook>Weline_Theme::frontend::layouts::default::content-before</w:hook>
                </w:slot>

                <div class="w-frontend-content-grid">
                    <w:slot id="sidebar-left" name="Left sidebar" accept="layout-sidebar,sidebar,filter,navigation,content" multiple="true" position="sidebar" class="w-frontend-sidebar">
                        <w:hook>Weline_Theme::frontend::layouts::default::sidebar-left</w:hook>
                    </w:slot>

                    <w:slot id="content" name="Content" accept="layout-default-content,content,container,banner,carousel,product,category,faq,video" reject="header,footer" multiple="true" position="content" class="w-frontend-content">
                        <w:hook>
                            Weline_Theme::frontend::layouts::default::content
                            <else/>
                            <?php if (trim($rawContent) !== ''): ?>
                                <?= $rawContent ?>
                            <?php elseif ($contentTemplate !== ''): ?>
                                <?= $this->fetch($contentTemplate) ?>
                            <?php else: ?>
                                <section class="w-card w-empty-state" weline-code="theme.layouts.default.empty_state">
                                    <div class="w-card__body w-stack">
                                        <h1><?= htmlspecialchars((string)($meta['title'] ?? __('Weline 默认页面')), ENT_QUOTES, 'UTF-8') ?></h1>
                                        <p><?= htmlspecialchars((string)__('该页面尚未提供内容。'), ENT_QUOTES, 'UTF-8') ?></p>
                                        <div class="w-cluster"><a class="w-button" href="/"><?= htmlspecialchars((string)__('返回首页'), ENT_QUOTES, 'UTF-8') ?></a></div>
                                    </div>
                                </section>
                            <?php endif; ?>
                        </w:hook>
                    </w:slot>

                    <w:slot id="sidebar-right" name="Right sidebar" accept="layout-sidebar,sidebar,filter,navigation,content" multiple="true" position="sidebar" class="w-frontend-sidebar">
                        <w:hook>Weline_Theme::frontend::layouts::default::sidebar-right</w:hook>
                    </w:slot>
                </div>

                <w:slot id="content-after" name="Content after" accept="layout-content-after,layout-default-after,banner,content,container" multiple="true" append="true" position="content" class="w-frontend-content-after">
                    <w:hook>Weline_Theme::frontend::layouts::default::content-after</w:hook>
                    <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
                </w:slot>
            </div>
        </main>

        <?php if ($showFooter): ?>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-before</w:hook>
            <w:block class="Weline\Theme\Block\Partials" area="frontend" type="footer" default-option="default" vars="copyright,links,showBackToTop,socialMedia,showSocialMedia"/>
            <w:hook>Weline_Theme::frontend::layouts::base::footer-after</w:hook>
        <?php endif; ?>

        <w:slot id="page-bottom" name="Page bottom" accept="layout-page-bottom,announcement,banner,content" multiple="true" append="true" position="content" class="w-frontend-page-bottom">
            <w:hook>Weline_Theme::frontend::layouts::default::page-bottom</w:hook>
        </w:slot>
    </div>

    <w:hook>Weline_Theme::frontend::layouts::default::body-end</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-end</w:hook>
    <w:hook>seo::footer</w:hook>
</body>
</html>
