    "ui-advanced": ["combobox", "tree", "transfer-list", "reorder-list", "icon-picker"],
    "datatable-js": ["data-table"],
    "datatable-form-js": ["data-table-form"],
    "language-select-js": ["language-select"],
    "language-switcher-js": ["language-switcher"],
    "online-translation-collector-js": ["online-translation-collector"],
    "scope-persistence-js": ["scope-persistence"],
    "file-picker-js": ["file-preview", "file-picker"],
    "local-translation-js": ["local-translation"],
    "customer-account-recovery-js": ["account-recovery"]
  },
  "component_assets": {
    "data-table": {
      "owner": "Weline_DataTable",
      "components": ["data-table"],
      "bundles": ["datatable-css", "datatable-common-js", "datatable-js"]
    },
    "data-table-form": {
      "owner": "Weline_DataTable",
      "components": ["data-table-form"],
      "bundles": ["datatable-css", "datatable-common-js", "datatable-form-js"]
    },
    "choice-filter": {
      "owner": "Weline_I18n",
      "components": ["choice-filter"],
      "bundles": ["choice-selector-css", "choice-selector-js"]
    },
    "language-select": {
      "owner": "Weline_I18n",
      "components": ["language-select"],
      "bundles": ["language-select-css", "language-select-js"]
    },
    "language-switcher": {
      "owner": "Weline_I18n",
      "components": ["language-switcher"],
      "bundles": ["language-switcher-js"]
    },
    "online-translation-collector": {
      "owner": "Weline_I18n",
      "components": ["online-translation-collector"],
      "bundles": ["online-translation-collector-js"]
    },
    "scope-persistence": {
      "owner": "Weline_Taglib",
      "components": ["scope-persistence"],
      "bundles": ["scope-persistence-js"]
    },
    "file-picker": {
      "owner": "Weline_FileManager",
      "components": ["file-preview", "file-picker"],
      "bundles": ["file-picker-css", "file-picker-js"]
    },
    "local-translation": {
      "owner": "Weline_I18n",
      "components": ["local-translation"],
      "bundles": ["local-translation-js"]
    },
    "account-recovery": {
      "owner": "Weline_Customer",
      "components": ["account-recovery"],
      "bundles": ["customer-account-recovery-css", "customer-account-recovery-js"]
    }
  },
