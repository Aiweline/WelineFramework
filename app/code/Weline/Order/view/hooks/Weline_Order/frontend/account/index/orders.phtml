<?php
/**
 * Default account orders panel（MOD-P2F-006 / TEST-BROWSER-02）.
 *
 * Hook: Weline_Order::frontend::account::index::orders
 *
 * Group 默认汇总；多子订单或退款/履约差异时展开子 Order。
 * 必须挂在 Customer account.sidebar / account.sidebar.content，禁止独立个人中心页。
 *
 * @hook-priority 160
 * @hook-sort-order 10
 * @hook-solo false
 */
use Weline\Order\Service\AccountCheckoutGroupPresenter;

/** @var list<array<string, mixed>> $accountCheckoutGroups 由站点 Order 模块注入；缺省演示空态 */
$accountCheckoutGroups = $accountCheckoutGroups ?? [];
$accountOrderDetail = is_array($accountOrderDetail ?? null) ? $accountOrderDetail : null;
$requestedOrderUuid = trim((string)($requestedOrderUuid ?? ''));
$presenter = new AccountCheckoutGroupPresenter();
$escape = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$formatMoney = static fn(string $currency, mixed $minor): string => sprintf(
    '%s %s',
    $currency,
    number_format(((int) $minor) / 100, 2, '.', ','),
);
$statusLabel = static function (string $status): string {
    return match ($status) {
        'paid' => (string) __('已支付'),
        'pending_payment' => (string) __('待支付'),
        'cancelled' => (string) __('已取消'),
        'closed' => (string) __('已关闭'),
        default => $status !== '' ? $status : (string) __('未知状态'),
    };
};
?>
<div class="account-orders"
     data-account-orders="true"
     data-account-layout="customer-sidebar"
     aria-labelledby="account-orders-title">
    <header class="account-orders__header">
        <h2 id="account-orders-title"><?= __('我的订单') ?></h2>
        <p class="account-orders__hint" data-testid="account-orders-hint"><?= __('多仓会拆成多个子订单；同一子订单也可分批发货') ?></p>
    </header>
<?php if ($accountOrderDetail === null && $requestedOrderUuid !== ''): ?>
    <p class="account-orders__locate-miss"
       data-account-order-locate-miss="true"
       data-order-uuid="<?= $escape($requestedOrderUuid) ?>"
       data-testid="account-order-locate-miss"
       role="status"><?= __('未找到该订单或无权查看') ?></p>
<?php endif; ?>
<?php if ($accountOrderDetail !== null): ?>
    <?php
    $detailCurrency = trim((string) ($accountOrderDetail['currency'] ?? ''));
    $detailMoney = is_array($accountOrderDetail['money'] ?? null) ? $accountOrderDetail['money'] : [];
    $detailItems = is_array($accountOrderDetail['items'] ?? null) ? $accountOrderDetail['items'] : [];
    $detailShipping = is_array($accountOrderDetail['shipping'] ?? null) ? $accountOrderDetail['shipping'] : [];
    $detailAddress = is_array($detailShipping['address'] ?? null) ? $detailShipping['address'] : [];
    $isHelpPayOrder = !empty($accountOrderDetail['help_pay'])
        || !empty($accountOrderDetail['shipping_locked'])
        || !empty($accountOrderDetail['shipping_redacted'])
        || !empty($detailShipping['shipping_locked'])
        || !empty($detailShipping['shipping_redacted']);
    if ($isHelpPayOrder) {
        $detailAddress = [];
        $detailAddressLine = '';
    } else {
        $detailAddressLine = implode(' · ', array_filter([
            trim((string)($detailAddress['country_code'] ?? '')),
            trim((string)($detailAddress['province'] ?? '')),
            trim((string)($detailAddress['city'] ?? '')),
            trim((string)($detailAddress['address1'] ?? '')),
            trim((string)($detailAddress['postal_code'] ?? '')),
        ], static fn(string $value): bool => $value !== ''));
    }
    ?>
    <section class="account-order-detail"
             data-account-order-detail="true"
             data-order-uuid="<?= $escape($accountOrderDetail['order_uuid'] ?? '') ?>"
             data-shipping-redacted="<?= $isHelpPayOrder ? '1' : '0' ?>"
             aria-labelledby="account-order-detail-title"
             weline-code="order.account.detail.section_1">
        <header class="account-order-detail__header">
            <div>
                <p class="account-order-detail__eyebrow"><?= __('订单详情') ?></p>
                <h3 id="account-order-detail-title"><?= $escape($accountOrderDetail['display_number'] ?? $accountOrderDetail['order_uuid'] ?? '') ?></h3>
                <p class="account-order-detail__uuid"><?= $escape($accountOrderDetail['order_uuid'] ?? '') ?></p>
                <?php
                $detailGroupCtx = is_array($accountOrderDetail['group_context'] ?? null)
                    ? $accountOrderDetail['group_context']
                    : [];
                if ($detailGroupCtx === [] && $accountCheckoutGroups !== []) {
                    $detailUuid = trim((string)($accountOrderDetail['order_uuid'] ?? ''));
                    foreach ($accountCheckoutGroups as $gProbe) {
                        $gOrders = is_array($gProbe['orders'] ?? null) ? $gProbe['orders'] : [];
                        $found = false;
                        foreach ($gOrders as $oProbe) {
                            if (!is_array($oProbe)) {
                                continue;
                            }
                            if (trim((string)($oProbe['order_uuid'] ?? '')) === $detailUuid) {
                                $found = true;
                                break;
                            }
                        }
                        if (!$found) {
                            continue;
                        }
                        $siblingPresenter = new \Weline\Order\Service\CheckoutGroupSiblingPresenter();
                        $detailGroupCtx = $siblingPresenter->presentFromRows(
                            array_map(static function (array $o): array {
                                return [
                                    'order_id' => (int)($o['order_id'] ?? 0),
                                    'order_uuid' => (string)($o['order_uuid'] ?? ''),
                                    'order_number' => (string)($o['display_number'] ?? ''),
                                    'status' => (string)($o['status'] ?? ''),
                                    'fulfillment_status' => (string)($o['fulfillment_status'] ?? ''),
                                    'shipment_count' => (int)($o['shipment_count'] ?? 0),
                                    'is_shipping_charge_owner' => !empty($o['is_shipping_charge_owner']),
                                ];
                            }, array_values(array_filter($gOrders, 'is_array'))),
                            $detailUuid,
                            [],
                            (string)($gProbe['group_uuid'] ?? '')
                        );
                        break;
                    }
                }
                ?>
                <?php if (trim((string)($detailGroupCtx['group_display'] ?? '')) !== ''): ?>
                    <p class="account-order-detail__group"
                       data-testid="account-order-group-label">
                        <?= $escape($detailGroupCtx['group_display']) ?>
                        <?php if (!empty($detailGroupCtx['is_multi_order']) && trim((string)($detailGroupCtx['child_badge'] ?? '')) !== ''): ?>
                            · <span data-testid="account-order-child-badge"><?= $escape($detailGroupCtx['child_badge']) ?></span>
                        <?php endif; ?>
                    </p>
                <?php endif; ?>
            </div>
            <span class="account-orders__badge" data-order-status="true" data-status="<?= $escape($accountOrderDetail['status'] ?? '') ?>">
                <?= $escape($statusLabel((string) ($accountOrderDetail['status'] ?? ''))) ?>
            </span>
            <?php
            $detailTypeView = $presenter->present([
                'group_uuid' => 'account-order-detail',
                'status' => (string) ($accountOrderDetail['status'] ?? ''),
                'grand_total_minor' => 0,
                'currency' => (string) ($accountOrderDetail['currency'] ?? 'CNY'),
                'orders' => [[
                    'order_uuid' => (string) ($accountOrderDetail['order_uuid'] ?? 'detail'),
                    'status' => (string) ($accountOrderDetail['status'] ?? ''),
                    'amount_minor' => 0,
                    'order_type' => (string) ($accountOrderDetail['order_type'] ?? 'toc'),
                ]],
            ]);
            $detailTypeCode = (string) ($detailTypeView['order_type'] ?? 'toc');
            $detailTypeLabel = (string) ($detailTypeView['order_type_label'] ?? '');
            $detailTypeTone = (string) ($detailTypeView['order_type_tone'] ?? 'info');
            if ($detailTypeTone === 'muted') {
                $detailTypeTone = 'info';
            }
            ?>
            <?php if ($detailTypeLabel !== ''): ?>
            <span class="account-orders__badge account-orders__badge--type"
                  data-order-type="true"
                  data-order-type-code="<?= $escape($detailTypeCode) ?>"
                  data-tone="<?= $escape($detailTypeTone) ?>"
                  data-testid="account-order-detail-type-badge"><?= $escape($detailTypeLabel) ?></span>
            <?php endif; ?>
        </header>

        <div class="account-order-detail__table-wrap">
            <div class="account-order-detail__table" role="table" aria-label="<?= __('订单商品') ?>" data-order-item-count="<?= count($detailItems) ?>">
                <div class="account-order-detail__row account-order-detail__row--head" role="row">
                    <span role="columnheader"><?= __('商品') ?></span>
                    <span role="columnheader"><?= __('SKU') ?></span>
                    <span role="columnheader"><?= __('数量') ?></span>
                    <span role="columnheader"><?= __('单价') ?></span>
                    <span role="columnheader"><?= __('小计') ?></span>
                </div>
                <?php foreach ($detailItems as $item): ?>
                    <?php if (!is_array($item)) { continue; } ?>
                    <?php
                    $itemName = trim((string)($item['name'] ?? $item['product_name'] ?? ''));
                    $itemImageSrc = trim((string)($item['image_src'] ?? $item['image'] ?? $item['image_url'] ?? $item['thumbnail'] ?? ''));
                    $itemImageFallback = trim((string)($item['image_fallback'] ?? ''));
                    $itemProductId = (int)($item['product_id'] ?? 0);
                    if ($itemImageSrc === '' && class_exists(\Weline\Theme\Helper\StorefrontImagePlaceholder::class)) {
                        $imageResolved = \Weline\Theme\Helper\StorefrontImagePlaceholder::resolve('', $itemProductId);
                        $itemImageSrc = $imageResolved['src'];
                        $itemImageFallback = $imageResolved['fallback'];
                    } elseif ($itemImageFallback === '' && class_exists(\Weline\Theme\Helper\StorefrontImagePlaceholder::class)) {
                        $itemImageFallback = \Weline\Theme\Helper\StorefrontImagePlaceholder::url($itemProductId);
                    }
                    ?>
                    <div class="account-order-detail__row" role="row" data-order-item="1"<?php if ($itemProductId > 0): ?> data-product-id="<?= $escape((string)$itemProductId) ?>"<?php endif; ?>>
                        <span class="account-order-detail__cell account-order-detail__cell--product" role="cell" data-label="<?= __('商品') ?>">
                            <span class="account-order-detail__product" data-testid="account-order-item-product">
                                <span class="account-order-detail__product-media" data-testid="account-order-item-image">
                                    <?php if ($itemImageSrc !== ''): ?>
                                    <img src="<?= $escape($itemImageSrc) ?>"
                                         alt=""
                                         width="48"
                                         height="48"
                                         data-storefront-img="1"
                                         data-fallback="<?= $escape($itemImageFallback !== '' ? $itemImageFallback : $itemImageSrc) ?>"
                                         loading="lazy"
                                         decoding="async">
                                    <?php endif; ?>
                                </span>
                                <span class="account-order-detail__product-name"><?= $escape($itemName) ?></span>
                            </span>
                        </span>
                        <span class="account-order-detail__cell" role="cell" data-label="<?= __('SKU') ?>"><?= $escape($item['sku'] ?? '') ?></span>
                        <span class="account-order-detail__cell" role="cell" data-label="<?= __('数量') ?>"><?= $escape($item['qty_minor'] ?? 0) ?></span>
                        <span class="account-order-detail__cell" role="cell" data-label="<?= __('单价') ?>"><?= $escape($formatMoney($detailCurrency, $item['unit_price_minor'] ?? 0)) ?></span>
                        <span class="account-order-detail__cell" role="cell" data-label="<?= __('小计') ?>"><?= $escape($formatMoney($detailCurrency, $item['row_total_minor'] ?? 0)) ?></span>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>

        <?php if ($detailAddress !== []): ?>
        <section class="account-order-detail__shipping" data-order-shipping-address="true" aria-labelledby="account-order-shipping-title" weline-code="order-detail-shipping">
            <div class="account-order-detail__shipping-header">
                <h4 id="account-order-shipping-title"><?= __('收货信息') ?></h4>
                <?php if (trim((string)($detailShipping['method'] ?? '')) !== ''): ?>
                    <span><?= $escape(__((string)$detailShipping['method'])) ?></span>
                <?php endif; ?>
            </div>
            <p class="account-order-detail__shipping-recipient">
                <strong><?= $escape($detailAddress['name'] ?? '') ?></strong>
                <?php if (trim((string)($detailAddress['phone'] ?? '')) !== ''): ?>
                    <span><?= $escape($detailAddress['phone']) ?></span>
                <?php endif; ?>
                <?php if (trim((string)($detailAddress['email'] ?? '')) !== ''): ?>
                    <span><?= $escape($detailAddress['email']) ?></span>
                <?php endif; ?>
            </p>
            <?php if ($detailAddressLine !== ''): ?>
                <p class="account-order-detail__shipping-address"><?= $escape($detailAddressLine) ?></p>
            <?php endif; ?>
        </section>
        <?php elseif ($isHelpPayOrder): ?>
        <section class="account-order-detail__shipping account-order-detail__shipping--redacted"
                 data-order-shipping-redacted="true"
                 data-testid="order-shipping-redacted"
                 weline-code="order-detail-shipping-redacted">
            <h4><?= __('收货信息') ?></h4>
            <p><?= __('帮我付订单在店面不展示收货地址。如需更正，请撤销后重新发起。') ?></p>
            <?php if (trim((string)($detailShipping['method'] ?? '')) !== ''): ?>
                <p><?= __('物流方式') ?>: <?= $escape(__((string)$detailShipping['method'])) ?></p>
            <?php endif; ?>
        </section>
        <?php endif; ?>

        <?php
        // 发货记录优先于订单级追踪面板：紧挨收货信息，顾客可立刻看到本子单全部运单。
        $accountShipmentOrderUuid = trim((string)($accountOrderDetail['order_uuid'] ?? ''));
        if ($accountShipmentOrderUuid !== '' && is_object($this) && method_exists($this, 'assign')) {
            $this->assign('account_shipment_order_uuid', $accountShipmentOrderUuid);
        }
        ?>
        <w:slot id="account-order-shipments"
                name="<?= __('发货记录') ?>"
                accept="account-order-shipments,order-shipments,shipping"
                exclusive="true"
                multiple="false"
                position="content"
                class="account-order-shipments-slot"
                weline-code="order.account.detail.shipments_slot">
            <w:hook name="Weline_Order::frontend::account::order-detail::shipments"/>
        </w:slot>

        <?php
        // 无 OrderShipment 行时才回退订单级物流追踪（可渲染 shipments[] 多运单）。
        $accountOrderTracking = is_array($accountOrderTracking ?? null) ? $accountOrderTracking : null;
        if ($accountOrderTracking !== null):
            $trackingResult = $accountOrderTracking;
            $trackingPanelTestId = 'account-order-tracking-result';
        ?>
        <section class="account-order-detail__tracking" data-account-order-tracking="true" aria-labelledby="account-order-tracking-title" weline-code="order.account.detail.tracking">
            <h4 id="account-order-tracking-title"><?= __('物流追踪') ?></h4>
            <link rel="stylesheet" href="@static(Weline_Order::css/order-tracking.css)&v=20260904-amazon3">
            <?php include BP . 'app/code/Weline/Order/view/templates/frontend/tracking/result-panel.phtml'; ?>
        </section>
        <?php endif; ?>

        <div class="account-order-detail__totals">
            <div><span><?= __('商品小计') ?></span><strong><?= $escape($formatMoney($detailCurrency, $detailMoney['subtotal_minor'] ?? 0)) ?></strong></div>
            <div><span><?= __('运费') ?></span><strong><?= $escape($formatMoney($detailCurrency, $detailMoney['shipping_amount_minor'] ?? 0)) ?></strong></div>
            <div><span><?= __('税费') ?></span><strong><?= $escape($formatMoney($detailCurrency, $detailMoney['tax_amount_minor'] ?? 0)) ?></strong></div>
            <div class="account-order-detail__grand-total"><span><?= __('订单总额') ?></span><strong><?= $escape($formatMoney($detailCurrency, $detailMoney['grand_total_minor'] ?? 0)) ?></strong></div>
        </div>

        <?php
        // 支付历史空槽：由 Weline_Payment Hook 注入；禁止本模板直读 Payment 表。
        $accountPaymentOrderUuid = trim((string)($accountOrderDetail['order_uuid'] ?? ''));
        if ($accountPaymentOrderUuid !== '' && is_object($this) && method_exists($this, 'assign')) {
            $this->assign('account_payment_order_uuid', $accountPaymentOrderUuid);
        }
        ?>
        <w:slot id="account-order-payment-records"
                name="<?= __('支付历史') ?>"
                accept="account-order-payment-records,payment-records,payment"
                exclusive="true"
                multiple="false"
                position="content"
                class="account-order-payment-records-slot"
                weline-code="order.account.detail.payment_records_slot">
            <w:hook name="Weline_Order::frontend::account::order-detail::payment-records"/>
        </w:slot>

        <?php
        $detailHang = null;
        $detailOrderUuid = trim((string)($accountOrderDetail['order_uuid'] ?? ''));
        if ($detailOrderUuid !== '') {
            foreach ($accountCheckoutGroups as $groupForHang) {
                foreach ((array)($groupForHang['orders'] ?? []) as $orderForHang) {
                    if (!is_array($orderForHang)) {
                        continue;
                    }
                    if (trim((string)($orderForHang['order_uuid'] ?? '')) !== $detailOrderUuid) {
                        continue;
                    }
                    if (is_array($orderForHang['hang'] ?? null)) {
                        $detailHang = $orderForHang['hang'];
                    }
                    break 2;
                }
            }
        }
        $hangPartial = BP . 'app/code/Weline/B2B/view/templates/frontend/partials/account-order-hang.phtml';
        if ($detailHang !== null && is_file($hangPartial)) {
            $hang = $detailHang;
            $orderUuid = $detailOrderUuid;
            $checkoutUrl = '/checkout';
            include $hangPartial;
        }
        ?>

        <a class="account-order-detail__back"
           data-account-orders-back="true"
           href="@url{'customer/account/index'}#orders"><?= __('返回订单列表') ?></a>
    </section>
<?php endif; ?>
<?php if ($accountCheckoutGroups === []): ?>
    <p class="account-orders__empty" data-orders-empty="true" role="status"><?= __('暂无订单') ?></p>
<?php else: ?>
    <ul class="account-orders__groups" data-orders-groups="true" role="list">
    <?php foreach ($accountCheckoutGroups as $group): ?>
        <?php $view = $presenter->present($group); ?>
        <?php $primaryOrderUuid = trim((string)($group['orders'][0]['order_uuid'] ?? '')); ?>
        <?php
        $hang = is_array($view['hang'] ?? null) ? $view['hang'] : null;
        $hangPartial = BP . 'app/code/Weline/B2B/view/templates/frontend/partials/account-order-hang.phtml';
        $hasHang = $hang !== null && is_file($hangPartial);
        $hasPartial = !empty($view['partial']) && !empty($view['orders']);
        $useAccordion = $hasHang || $hasPartial;
        $chatUnread = 0;
        if ($hang !== null) {
            $chatUnread = max(0, (int)($hang['chat_unread'] ?? $hang['unread'] ?? 0));
        }
        // 多子订单必须默认展开：否则子单追踪摘要与详情链被折叠，等同不可用。
        $accordionOpen = $chatUnread > 0 || $hasPartial;
        ?>
        <li class="account-orders__group"
            data-group-uuid="<?= htmlspecialchars((string) $view['group_uuid'], ENT_QUOTES, 'UTF-8') ?>"
            data-view="<?= htmlspecialchars((string) $view['view'], ENT_QUOTES, 'UTF-8') ?>"
            data-partial="<?= !empty($view['partial']) ? '1' : '0' ?>"
            data-accordion="<?= $useAccordion ? '1' : '0' ?>"
            aria-label="<?= htmlspecialchars((string) $view['summary_line'], ENT_QUOTES, 'UTF-8') ?>">
            <?php if ($useAccordion): ?>
            <details class="account-orders__accordion"
                     data-account-orders-accordion="true"
                     data-testid="account-orders-accordion"
                     <?= $accordionOpen ? 'open' : '' ?>>
                <summary class="account-orders__summary" data-group-summary="true">
                    <span class="account-orders__chevron" aria-hidden="true"></span>
            <?php else: ?>
                <div class="account-orders__summary" data-group-summary="true">
            <?php endif; ?>
                    <strong data-testid="account-order-group-label"><?= htmlspecialchars((string) $view['display_number'], ENT_QUOTES, 'UTF-8') ?></strong>
                    <span data-testid="account-order-group-count"><?= htmlspecialchars((string) $view['order_count_label'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php if (trim((string)($view['group_shipment_count_label'] ?? '')) !== ''): ?>
                        <span class="account-orders__badge" data-testid="account-order-group-shipment-count"><?= htmlspecialchars((string) $view['group_shipment_count_label'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endif; ?>
                    <?php if (trim((string) ($view['order_type_label'] ?? '')) !== ''): ?>
                        <span class="account-orders__badge account-orders__badge--type"
                              data-order-type="true"
                              data-order-type-code="<?= htmlspecialchars((string) ($view['order_type'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                              data-tone="<?= htmlspecialchars((string) ($view['order_type_tone'] ?? 'info'), ENT_QUOTES, 'UTF-8') ?>"
                              data-testid="account-order-type-badge"><?= htmlspecialchars((string) $view['order_type_label'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endif; ?>
                    <span class="account-orders__badge"
                          data-order-status="true"
                          data-status="<?= htmlspecialchars((string) $view['status'], ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string) $view['status_label'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php if (!empty($view['tracking_summary'])): ?>
                        <span class="account-orders__badge" data-order-tracking-summary="true"><?= htmlspecialchars((string) $view['tracking_summary'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endif; ?>
                    <span class="account-orders__total" data-order-total="true"><?= htmlspecialchars((string) $view['total_label'], ENT_QUOTES, 'UTF-8') ?></span>
                    <?php if (!$useAccordion): ?>
                    <span class="account-orders__actions" data-account-orders-actions="true">
                    <?php if (!empty($view['continue_pay_reachable']) && trim((string)($view['continue_pay_url'] ?? '')) !== ''): ?>
                        <a class="account-orders__continue-pay"
                           data-continue-pay="true"
                           data-testid="account-order-continue-pay"
                           data-order-uuid="<?= htmlspecialchars($primaryOrderUuid, ENT_QUOTES, 'UTF-8') ?>"
                           href="<?= htmlspecialchars((string)$view['continue_pay_url'], ENT_QUOTES, 'UTF-8') ?>"><?= __('继续支付') ?></a>
                    <?php endif; ?>
                    <?php if ($primaryOrderUuid !== ''): ?>
                        <a class="account-orders__detail-link"
                           data-order-detail-link="true"
                           data-order-uuid="<?= htmlspecialchars($primaryOrderUuid, ENT_QUOTES, 'UTF-8') ?>"
                           href="@url{'customer/account/index'|['order_uuid' => $primaryOrderUuid]}#orders"><?= __('查看详情') ?></a>
                    <?php endif; ?>
                    </span>
                    <?php endif; ?>
                    <?php if ($chatUnread > 0): ?>
                        <span class="account-orders__badge account-orders__badge--unread"
                              data-account-orders-unread="true"
                              data-testid="account-orders-unread"><?= htmlspecialchars((string) $chatUnread, ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endif; ?>
                    <?php foreach (($view['refund_semantics'] ?? []) as $label): ?>
                        <span class="account-orders__badge" data-refund-semantic="true"><?= htmlspecialchars((string) $label, ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endforeach; ?>
                    <?php foreach (($view['invoice_semantics'] ?? []) as $label): ?>
                        <span class="account-orders__badge" data-invoice-semantic="true"><?= htmlspecialchars((string) $label, ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endforeach; ?>
                    <?php foreach (($view['fulfillment_semantics'] ?? []) as $label): ?>
                        <span class="account-orders__badge" data-fulfillment-semantic="true"><?= htmlspecialchars((string) $label, ENT_QUOTES, 'UTF-8') ?></span>
                    <?php endforeach; ?>
            <?php if ($useAccordion): ?>
                </summary>
                <span class="account-orders__actions account-orders__actions--below-summary" data-account-orders-actions="true">
                <?php if (!empty($view['continue_pay_reachable']) && trim((string)($view['continue_pay_url'] ?? '')) !== ''): ?>
                    <a class="account-orders__continue-pay"
                       data-continue-pay="true"
                       data-testid="account-order-continue-pay"
                       data-order-uuid="<?= htmlspecialchars($primaryOrderUuid, ENT_QUOTES, 'UTF-8') ?>"
                       href="<?= htmlspecialchars((string)$view['continue_pay_url'], ENT_QUOTES, 'UTF-8') ?>"><?= __('继续支付') ?></a>
                <?php endif; ?>
                <?php if ($primaryOrderUuid !== ''): ?>
                    <a class="account-orders__detail-link"
                       data-order-detail-link="true"
                       data-order-uuid="<?= htmlspecialchars($primaryOrderUuid, ENT_QUOTES, 'UTF-8') ?>"
                       href="@url{'customer/account/index'|['order_uuid' => $primaryOrderUuid]}#orders"><?= __('查看详情') ?></a>
                <?php endif; ?>
                </span>
                <div class="account-orders__panel" data-account-orders-panel="true">
                    <?php if ($hasHang):
                        $orderUuid = trim((string)($hang['order_ref'] ?? $primaryOrderUuid));
                        $checkoutUrl = '/checkout';
                        $chatOpen = true;
                    ?>
                    <div class="account-orders__hang"
                         data-account-orders-hang="true"
                         data-chat-embedded="1"
                         data-testid="account-orders-hang">
                        <?php include $hangPartial; ?>
                    </div>
                    <?php endif; ?>
                    <?php if ($hasPartial): ?>
                    <ul class="account-orders__partial"
                        data-partial-expanded="true"
                        role="list"
                        aria-label="<?= __('订单明细') ?>">
                        <?php foreach ($view['orders'] as $order): ?>
                        <li data-order-uuid="<?= htmlspecialchars((string) $order['order_uuid'], ENT_QUOTES, 'UTF-8') ?>"
                            data-account-order-row="true">
                            <?php if (trim((string)($order['child_label'] ?? '')) !== ''): ?>
                                <span class="account-orders__badge" data-tone="info" data-testid="account-order-child-badge"><?= htmlspecialchars((string)($order['child_badge'] !== '' ? $order['child_badge'] : $order['child_label']), ENT_QUOTES, 'UTF-8') ?></span>
                            <?php endif; ?>
                            <span><?= htmlspecialchars((string) $order['display_number'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php if (trim((string)($order['shipment_badge'] ?? '')) !== ''): ?>
                                <span class="account-orders__badge" data-testid="account-order-child-shipment-badge"><?= htmlspecialchars((string) $order['shipment_badge'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php endif; ?>
                            <?php if (trim((string) ($order['order_type_label'] ?? '')) !== ''): ?>
                                <span class="account-orders__badge account-orders__badge--type"
                                      data-order-type="true"
                                      data-order-type-code="<?= htmlspecialchars((string) ($order['order_type'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
                                      data-tone="<?= htmlspecialchars((string) ($order['order_type_tone'] ?? 'info'), ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string) $order['order_type_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php endif; ?>
                            <span data-order-status="true"><?= htmlspecialchars((string) $order['status_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php if (!empty($order['tracking_summary'])): ?>
                                <span data-order-tracking-summary="true"><?= htmlspecialchars((string) $order['tracking_summary'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php endif; ?>
                            <span data-order-total="true"><?= htmlspecialchars((string) $order['total_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <span data-refund-label="true"><?= htmlspecialchars((string) $order['refund_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <span data-invoice-label="true"><?= htmlspecialchars((string) $order['invoice_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <span data-fulfillment-label="true"><?= htmlspecialchars((string) $order['fulfillment_label'], ENT_QUOTES, 'UTF-8') ?></span>
                            <?php $childUuid = trim((string)($order['order_uuid'] ?? '')); ?>
                            <?php if ($childUuid !== ''): ?>
                                <a class="account-orders__detail-link"
                                   data-order-detail-link="true"
                                   data-testid="account-order-split-detail-link"
                                   data-order-uuid="<?= htmlspecialchars($childUuid, ENT_QUOTES, 'UTF-8') ?>"
                                   href="@url{'customer/account/index'|['order_uuid' => $childUuid]}#orders"><?= __('查看详情') ?></a>
                            <?php endif; ?>
                        </li>
                        <?php endforeach; ?>
                    </ul>
                    <?php elseif (!$hasHang): ?>
                    <p class="account-orders__panel-empty"
                       data-account-orders-panel-empty="true"
                       role="status"><?= __('暂无子订单明细，请点击查看详情') ?></p>
                    <?php endif; ?>
                </div>
            </details>
            <?php else: ?>
                </div>
            <?php endif; ?>
        </li>
    <?php endforeach; ?>
    </ul>
<?php endif; ?>
</div>
