<?php
/**
 * Weline_Order module - account page content section.
 *
 * Hook: account.sidebar.content
 *
 * 注入 `$accountCheckoutGroups`（按当前登录顾客 + website Scope 聚合），
 * 再渲染 orders 子 Hook。禁止独立个人中心页。
 *
 * @hook-priority 160
 * @hook-sort-order 10
 * @hook-solo false
 */
use Weline\Customer\Api\View\AccountSidebarProjectionProviderInterface;
use Weline\Customer\Service\AccountSidebarContentGate;
use Weline\Framework\Http\Request;
use Weline\Framework\Manager\ObjectManager;
use Weline\Framework\Runtime\RuntimeProviderResolver;
use Weline\Order\Service\AccountCheckoutGroupLoader;
use Weline\Order\Service\AccountOrderDetailResolver;
use Weline\Order\Service\AccountOrderScopePresenter;
use Weline\Order\Service\Tracking\OrderTrackingService;

if (!AccountSidebarContentGate::accepts('orders')) {
    return;
}

$projectionProvider = ObjectManager::getInstance(RuntimeProviderResolver::class)
    ->resolve(AccountSidebarProjectionProviderInterface::class);
if (!$projectionProvider instanceof AccountSidebarProjectionProviderInterface) {
    throw new \LogicException('Required Customer account sidebar projection provider is unavailable.');
}

$request = ObjectManager::getInstance(Request::class);
$parseOptionalInt = static function (mixed $raw): ?int {
    if ($raw === null || $raw === '') {
        return null;
    }
    if (is_int($raw)) {
        return $raw >= 0 ? $raw : null;
    }
    $s = trim((string)$raw);
    if ($s === '' || !preg_match('/^(?:0|[1-9][0-9]*)$/D', $s)) {
        return null;
    }

    return (int)$s;
};
$scopeStoreFilter = $parseOptionalInt(AccountSidebarContentGate::requestParam(
    'scope_store',
    $request->getParam('scope_store', null),
));
$scopeChannelFilter = $parseOptionalInt(AccountSidebarContentGate::requestParam(
    'scope_channel',
    $request->getParam('scope_channel', null),
));

$projection = $projectionProvider->forSections('orders');
$accountCheckoutGroups = [];
$accountOrderScopeFilter = [
    'current_store_id' => $scopeStoreFilter,
    'current_channel_id' => $scopeChannelFilter,
    'options' => [[
        'store_id' => null,
        'label' => (string)__('全部范围'),
        'selected' => $scopeStoreFilter === null,
    ]],
];
$customerId = 0;
$websiteId = 0;
/** @var AccountCheckoutGroupLoader|null $loader */
$loader = null;
if ($projection !== null && $projection->getCustomerId() !== null) {
    $customerId = (int)$projection->getCustomerId();
    $websiteId = (int)$projection->getWebsiteId();
    /** @var AccountCheckoutGroupLoader $loader */
    $loader = ObjectManager::getInstance(AccountCheckoutGroupLoader::class);
    $accountCheckoutGroups = $loader->loadForCustomer(
        $customerId,
        $websiteId,
        20,
        $scopeStoreFilter,
        $scopeChannelFilter,
    );
    $accountOrderScopeFilter = $loader->buildScopeFilter(
        $customerId,
        $websiteId,
        $scopeStoreFilter,
        $scopeChannelFilter,
    );
}
$this->assign('accountCheckoutGroups', $accountCheckoutGroups);
$this->assign('accountOrderScopeFilter', $accountOrderScopeFilter);

$requestedOrderUuid = trim((string) AccountSidebarContentGate::requestParam(
    'order_uuid',
    $request->getParam('order_uuid', ''),
));
$accountOrderDetail = null;
$accountOrderTracking = null;
$accountOrderDetailScope = null;
if ($requestedOrderUuid !== '' && $loader !== null && $customerId > 0) {
    /** @var AccountOrderDetailResolver $detailResolver */
    $detailResolver = ObjectManager::getInstance(AccountOrderDetailResolver::class);
    $accountOrderDetail = $detailResolver->resolve($accountCheckoutGroups, $requestedOrderUuid);
    // 范围过滤可能藏起目标单：详情归属回退到未过滤加载。
    if ($accountOrderDetail === null && ($scopeStoreFilter !== null || $scopeChannelFilter !== null)) {
        $unfiltered = $loader->loadForCustomer($customerId, $websiteId, 20, null, null);
        $accountOrderDetail = $detailResolver->resolve($unfiltered, $requestedOrderUuid);
    }
    if (is_array($accountOrderDetail)) {
        /** @var AccountOrderScopePresenter $scopePresenter */
        $scopePresenter = ObjectManager::getInstance(AccountOrderScopePresenter::class);
        $accountOrderDetailScope = $scopePresenter->presentFromDetail($accountOrderDetail);
        // 有 OrderShipment 行时以账户「发货记录」槽为准；无发货行才回退订单级物流追踪面板。
        $hasShipmentRows = false;
        if (class_exists(\Weline\Shipping\Service\BackendOrderShipmentsService::class)) {
            try {
                /** @var \Weline\Order\Model\Order $orderModel */
                $orderModel = ObjectManager::getInstance(\Weline\Order\Model\Order::class);
                $orderModel->clear()
                    ->where(\Weline\Order\Model\Order::schema_fields_ORDER_UUID, $requestedOrderUuid)
                    ->find()
                    ->fetch();
                $detailOrderId = (int)$orderModel->getId();
                if ($detailOrderId > 0) {
                    /** @var \Weline\Shipping\Service\BackendOrderShipmentsService $shipmentsService */
                    $shipmentsService = ObjectManager::getInstance(
                        \Weline\Shipping\Service\BackendOrderShipmentsService::class
                    );
                    $hasShipmentRows = $shipmentsService->listForOrderId($detailOrderId) !== [];
                }
            } catch (\Throwable) {
                $hasShipmentRows = false;
            }
        }
        if (!$hasShipmentRows) {
            /** @var OrderTrackingService $trackingService */
            $trackingService = ObjectManager::getInstance(OrderTrackingService::class);
            $accountOrderTracking = $trackingService->trackByOrderUuid($requestedOrderUuid);
        }
    }
}
$this->assign('accountOrderDetail', $accountOrderDetail);
$this->assign('accountOrderDetailScope', $accountOrderDetailScope);
$this->assign('accountOrderTracking', $accountOrderTracking);
$this->assign('requestedOrderUuid', $requestedOrderUuid);

?>
<section class="account-hook-section account-index__section motor-account-section" id="orders-section" data-account-section="orders" data-requested-order-uuid="<?= htmlspecialchars($requestedOrderUuid, ENT_QUOTES, 'UTF-8') ?>" data-order-detail-resolved="<?= $accountOrderDetail !== null ? '1' : '0' ?>" data-order-tracking-resolved="<?= is_array($accountOrderTracking) ? '1' : '0' ?>" hidden weline-code="order.hook.account_sidebar_content.orders_section">
    <w:hook name="Weline_Order::frontend::account::index::orders"/>
</section>
