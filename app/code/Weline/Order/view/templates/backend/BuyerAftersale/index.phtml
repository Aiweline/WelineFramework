<script>
(function () {
    var enabled = <?= $buyerAftersaleEnabled ? 'true' : 'false' ?>;
    var root = document.querySelector('[data-testid="order-buyer-aftersale-management"]');
    if (!root) {
        return;
    }

    function api() {
        return Promise.resolve(window.Weline && window.Weline.load ? window.Weline.load('api') : window.Weline.Api);
    }

    function toast(ok, text) {
        if (!window.Weline || !window.Weline.UI || !window.Weline.UI.toast) {
            return;
        }
        if (ok) {
            window.Weline.UI.toast.success(text);
            return;
        }
        window.Weline.UI.toast.error(text);
    }

    function runOp(operation, requestUuid, extra) {
        var payload = Object.assign({ request_uuid: requestUuid }, extra || {});
        return api().then(function (client) {
            return client.resource('buyer-aftersale-admin')[operation](payload);
        });
    }

    function selectedUuids() {
        return Array.prototype.map.call(
            root.querySelectorAll('[data-buyer-aftersale-check="1"]:checked'),
            function (box) { return box.value; }
        ).filter(Boolean);
    }

    root.addEventListener('change', function (event) {
        var target = event.target;
        if (!target || target.getAttribute('data-testid') !== 'buyer-aftersale-check-all') {
            return;
        }
        root.querySelectorAll('[data-buyer-aftersale-check="1"]').forEach(function (box) {
            box.checked = target.checked;
        });
    });

    root.addEventListener('click', function (event) {
        var button = event.target.closest('[data-buyer-aftersale-op], [data-buyer-aftersale-batch], [data-buyer-aftersale-reship]');
        if (!button || !enabled) {
            return;
        }
        var row = button.closest('[data-request-uuid]');
        var operation = button.getAttribute('data-buyer-aftersale-op') || button.getAttribute('data-buyer-aftersale-batch');
        if (button.hasAttribute('data-buyer-aftersale-reship')) {
            var dialog = document.getElementById('buyer-aftersale-reship-dialog');
            var form = document.getElementById('buyer-aftersale-reship-form');
            if (!dialog || !form || !row || !window.Weline || !window.Weline.UI) {
                return;
            }
            form.elements.request_uuid.value = row.getAttribute('data-request-uuid') || '';
            form.elements.tracking_no.value = '';
            window.Weline.UI.dialog.open(dialog);
            return;
        }
        if (!operation) {
            return;
        }
        var uuids = button.hasAttribute('data-buyer-aftersale-batch')
            ? selectedUuids()
            : [row ? (row.getAttribute('data-request-uuid') || '') : ''];
        uuids = uuids.filter(Boolean);
        if (uuids.length === 0) {
            toast(false, <?= json_encode((string)__('请先选择申请'), JSON_UNESCAPED_UNICODE) ?>);
            return;
        }
        var confirmText = <?= json_encode((string)__('确定处理所选申请吗？'), JSON_UNESCAPED_UNICODE) ?>;
        if (operation.indexOf('reject') >= 0) {
            confirmText = <?= json_encode((string)__('确定拒绝所选申请吗？'), JSON_UNESCAPED_UNICODE) ?>;
        } else if (operation.indexOf('receive') >= 0) {
            confirmText = <?= json_encode((string)__('确定确认收货吗？'), JSON_UNESCAPED_UNICODE) ?>;
        } else if (operation.indexOf('approve') >= 0) {
            confirmText = <?= json_encode((string)__('确定通过所选申请吗？'), JSON_UNESCAPED_UNICODE) ?>;
        }
        var go = function () {
            var chain = Promise.resolve();
            uuids.forEach(function (uuid) {
                chain = chain.then(function () { return runOp(operation, uuid); });
            });
            chain.then(function () { window.location.reload(); }).catch(function () {
                toast(false, <?= json_encode((string)__('操作失败，请稍后重试'), JSON_UNESCAPED_UNICODE) ?>);
            });
        };
        if (window.Weline && window.Weline.UI && window.Weline.UI.dialog) {
            window.Weline.UI.dialog.confirm(confirmText, {
                title: <?= json_encode((string)__('确认'), JSON_UNESCAPED_UNICODE) ?>,
                confirmLabel: <?= json_encode((string)__('确定'), JSON_UNESCAPED_UNICODE) ?>,
                cancelLabel: <?= json_encode((string)__('取消'), JSON_UNESCAPED_UNICODE) ?>
            }).then(function (confirmed) {
                if (confirmed) {
                    go();
                }
            });
            return;
        }
        go();
    });

    var reshipForm = document.getElementById('buyer-aftersale-reship-form');
    if (reshipForm) {
        reshipForm.addEventListener('submit', function (event) {
            event.preventDefault();
            if (!enabled) {
                return;
            }
            runOp('reshipBuyerAftersale', reshipForm.elements.request_uuid.value, {
                tracking_no: reshipForm.elements.tracking_no.value
            }).then(function (data) {
                if (data && data.success) {
                    window.location.reload();
                    return;
                }
                toast(false, (data && data.error_code) || <?= json_encode((string)__('保存失败'), JSON_UNESCAPED_UNICODE) ?>);
            }).catch(function () {
                toast(false, <?= json_encode((string)__('保存失败'), JSON_UNESCAPED_UNICODE) ?>);
            });
        });
    }
})();
</script>
