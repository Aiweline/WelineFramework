<?php
/**
 * @widget.code {order-notice}
 * @widget.name {订单留言}
 * @widget.type {content}
 * @widget.source {Weline_Order::css/widgets/order-notice.css}
 *
 * @var \Weline\Framework\View\Template $this
 *
 * @widget.description {迷你购物车 / 购物车页 / 结账页订单留言输入，会话保存后在创建订单时带入。}
 * @widget.area {frontend}
 * @widget.position {["footer","summary","content"]}
 * @widget.page_layouts {["mini-cart","cart","checkout"]}
 * @widget.slot {footer-extras}
 * @widget.supports {["layout-mini-cart-footer-extras","order-notice","mini-cart-footer-extras","cart-summary-note","checkout-summary-note","order"]}
 * @param title {default="订单留言",type="string",label="标题"}
 * @param placeholder {default="如有特殊要求请留言",type="string",label="占位提示"}
 * @param surface {default="mini-cart",type="string",label="表面标识"}
 *
 * @widget.default_injections {[{"layout_type":"mini-cart","layout_option":"default","slot":"footer-extras","area":"footer","sort_order":20,"required":true,"reason":"迷你购物车默认提供订单留言输入","config":{"title":"订单留言","placeholder":"如有特殊要求请留言","surface":"mini-cart"}},{"layout_type":"cart","layout_option":"default","slot":"cart-summary-note","area":"content","sort_order":20,"required":true,"reason":"购物车摘要默认提供订单留言输入","config":{"title":"订单留言","placeholder":"如有特殊要求请留言","surface":"cart"}},{"layout_type":"checkout","layout_option":"default","slot":"checkout-summary-note","area":"content","sort_order":20,"required":true,"reason":"结账摘要默认提供订单留言输入","config":{"title":"订单留言","placeholder":"如有特殊要求请留言","surface":"checkout"}}]}
 */
$rawTitle = trim((string)($this->getData('title') ?? ''));
$title = $rawTitle !== '' ? (string)__($rawTitle) : (string)__('订单留言');
$rawPlaceholder = trim((string)($this->getData('placeholder') ?? ''));
$placeholder = $rawPlaceholder !== '' ? (string)__($rawPlaceholder) : (string)__('如有特殊要求请留言');
$surface = strtolower(trim((string)($this->getData('surface') ?? 'mini-cart')));
if (!in_array($surface, ['mini-cart', 'cart', 'checkout'], true)) {
    $surface = 'mini-cart';
}
$inputId = 'w-order-notice-input-' . preg_replace('/[^a-z0-9_-]+/', '-', $surface);
$isMiniCart = $surface === 'mini-cart';
$modifier = $isMiniCart ? 'w-order-notice--mini-cart' : 'w-order-notice--summary';
?>
<div class="w-order-notice <?= htmlspecialchars($modifier, ENT_QUOTES, 'UTF-8') ?>"
     data-testid="order-notice-widget"
     data-order-notice-surface="<?= htmlspecialchars($surface, ENT_QUOTES, 'UTF-8') ?>"
     data-weline-load="orderNotice"
     data-mini-cart-tab-label="<?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?>">
    <?php if ($isMiniCart): ?>
        <span class="w-order-notice__label" data-mini-cart-tab-label-source hidden><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></span>
    <?php else: ?>
        <label class="w-order-notice__label" for="<?= htmlspecialchars($inputId, ENT_QUOTES, 'UTF-8') ?>" data-mini-cart-tab-label-source>
            <?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?>
        </label>
    <?php endif; ?>
    <textarea id="<?= htmlspecialchars($inputId, ENT_QUOTES, 'UTF-8') ?>"
              class="w-order-notice__input"
              rows="<?= $isMiniCart ? '2' : '3' ?>"
              maxlength="1000"
              data-order-notice-input
              data-testid="order-notice-input"
              placeholder="<?= htmlspecialchars($placeholder, ENT_QUOTES, 'UTF-8') ?>"></textarea>
    <p class="w-order-notice__message" data-order-notice-message aria-live="polite"></p>
</div>
<?php // orderNotice：CSS 经 @widget.source bake→head；JS 由 data-weline-load 声明 ?>
