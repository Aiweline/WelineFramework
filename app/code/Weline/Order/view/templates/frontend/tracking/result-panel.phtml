<?php
/**
 * Shared order tracking result panel（账户详情 / Theme 访客兜底共用）.
 *
 * 注意：本文件常被 PHP include，不经 Taglib 编译——禁止写未编译的 w:static/@static 标签，
 * 否则浏览器会把未闭合自定义标签里的后续内容挤进窄宽容器（一字一排竖折）。
 *
 * @var array|null $trackingResult OrderTrackingService 返回结构
 * @var string|null $trackingPanelTestId
 * @var \Weline\Framework\View\Template|null $this
 */
$trackingResult = is_array($trackingResult ?? null) ? $trackingResult : null;
if ($trackingResult === null) {
    return;
}

$escape = static fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$provider = is_array($trackingResult['provider'] ?? null) ? $trackingResult['provider'] : [];
$display = is_array($provider['display'] ?? null) ? $provider['display'] : [];
$tracking = is_array($trackingResult['tracking'] ?? null) ? $trackingResult['tracking'] : [];
$stages = is_array($tracking['stages'] ?? null) ? $tracking['stages'] : [];
$nodes = is_array($tracking['nodes'] ?? null) ? $tracking['nodes'] : [];
$title = (string) ($display['title'] ?? __('系统订单追踪'));
$summary = (string) ($tracking['summary'] ?? ($trackingResult['message'] ?? ''));
$icon = trim((string) ($display['icon_url'] ?? $display['icon'] ?? ''));
$testId = trim((string) ($trackingPanelTestId ?? 'order-tracking-result'));
$ok = !empty($trackingResult['ok']);

$iconUrl = '';
if ($icon !== '' && isset($this) && is_object($this) && method_exists($this, 'fetchTagSource')) {
    try {
        $resolved = (string) $this->fetchTagSource(
            \Weline\Framework\View\Data\DataInterface::dir_type_STATICS,
            $icon
        );
        if ($resolved !== '' && !str_contains($resolved, '@static')) {
            $iconUrl = $resolved;
        }
    } catch (\Throwable) {
        $iconUrl = '';
    }
}
?>
<section class="order-tracking-result"
         data-testid="<?= $escape($testId) ?>"
         data-ok="<?= $ok ? '1' : '0' ?>"
         weline-code="order.tracking.result.panel">
    <?php if (!$ok): ?>
        <p class="order-tracking-result__tips" data-tone="danger"><?= $escape((string) ($trackingResult['message'] ?? __('查询失败'))) ?></p>
    <?php else: ?>
        <header class="order-tracking-result__head">
            <?php if ($iconUrl !== ''): ?>
                <img class="order-tracking-result__icon"
                     src="<?= $escape($iconUrl) ?>"
                     alt=""
                     width="36"
                     height="36"
                     decoding="async">
            <?php endif; ?>
            <div class="order-tracking-result__provider">
                <p class="order-tracking-result__provider-title"><?= $escape($title) ?></p>
                <?php if (!empty($display['description'])): ?>
                    <p class="order-tracking-result__provider-desc"><?= $escape((string) $display['description']) ?></p>
                <?php endif; ?>
            </div>
        </header>

        <?php if ($summary !== ''): ?>
            <p class="order-tracking-result__summary"><?= $escape($summary) ?></p>
        <?php endif; ?>
        <?php if (!empty($tracking['tracking_number'])): ?>
            <p class="order-tracking-result__tracking-no"><?= $escape(__('物流单号')) ?>：<code><?= $escape((string) $tracking['tracking_number']) ?></code></p>
        <?php endif; ?>

        <?php if ($stages !== []): ?>
            <ol class="order-tracking-result__stages" data-tracking-stages="true">
                <?php foreach ($stages as $stage): ?>
                    <?php
                    if (!is_array($stage)) {
                        continue;
                    }
                    $state = (string) ($stage['state'] ?? 'upcoming');
                    $label = (string) ($stage['label'] ?? $stage['code'] ?? '');
                    $isCurrent = $state === 'current';
                    ?>
                    <li class="order-tracking-result__stage"
                        data-state="<?= $escape($state) ?>"
                        <?= $isCurrent ? 'aria-current="step"' : '' ?>>
                        <span class="order-tracking-result__rail" aria-hidden="true"></span>
                        <span class="order-tracking-result__dot" aria-hidden="true"></span>
                        <span class="order-tracking-result__meta">
                            <span class="order-tracking-result__label"><?= $escape($label) ?></span>
                            <?php if ($isCurrent): ?>
                                <span class="order-tracking-result__current-tag"><?= $escape(__('当前')) ?></span>
                            <?php endif; ?>
                        </span>
                    </li>
                <?php endforeach; ?>
            </ol>
        <?php endif; ?>

        <?php if ($nodes !== []): ?>
            <ol class="order-tracking-result__nodes" data-tracking-nodes="true">
                <?php foreach ($nodes as $index => $node): ?>
                    <?php if (!is_array($node)) { continue; } ?>
                    <li class="order-tracking-result__node"<?= $index === 0 ? ' data-latest="1"' : '' ?>>
                        <span class="order-tracking-result__node-rail" aria-hidden="true"></span>
                        <span class="order-tracking-result__node-dot" aria-hidden="true"></span>
                        <div class="order-tracking-result__node-body">
                            <p class="order-tracking-result__node-text"><?= $escape((string) ($node['text'] ?? '')) ?></p>
                            <?php if (!empty($node['time'])): ?>
                                <time class="order-tracking-result__node-time"><?= $escape((string) $node['time']) ?></time>
                            <?php endif; ?>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ol>
        <?php endif; ?>
    <?php endif; ?>
</section>
