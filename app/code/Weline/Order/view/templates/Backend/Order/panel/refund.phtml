<?php
/** @var list<array<string,mixed>> $candidates */
/** @var list<array<string,mixed>> $cases */
/** @var string $returnUrl */
use Weline\Order\Service\BackendOrderOutcomeChip;

$candidates = is_array($candidates ?? null) ? $candidates : [];
$cases = is_array($cases ?? null) ? $cases : [];
$returnUrl = (string)($returnUrl ?? '');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="w-stack" style="--w-gap:var(--weline-space-3);" data-testid="order-edit-panel-refund">
  <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;"><?= __('本单可退项；占额由服务端重算。') ?></p>
  <div class="w-table-wrap">
    <table class="w-table" data-w-vertical="middle">
      <thead>
        <tr>
          <th><?= __('商品') ?></th>
          <th><?= __('可退数量') ?></th>
          <th><?= __('提交') ?></th>
        </tr>
      </thead>
      <tbody>
        <?php if ($candidates === []): ?>
          <tr><td colspan="3" class="w-text" data-align="center" data-tone="muted"><?= __('本单暂无可退款订单项') ?></td></tr>
        <?php else: foreach ($candidates as $row): ?>
          <tr data-testid="refund-candidate">
            <td>
              <div><?= $escape($row['product_name'] ?? '') ?></div>
              <code class="w-text" data-size="sm"><?= $escape($row['item_uuid'] ?? '') ?></code>
            </td>
            <td><?= (int)($row['qty_minor'] ?? 0) ?></td>
            <td>
              <w:form method="post" action="@backend-url{'order/backend/refund/execute'}" class="w-cluster" data-align="end" style="--w-gap:var(--weline-space-2);">
                <input type="hidden" name="order_uuid" value="<?= $escape($row['order_uuid'] ?? '') ?>">
                <input type="hidden" name="item_uuid" value="<?= $escape($row['item_uuid'] ?? '') ?>">
                <input type="hidden" name="expected_grant_version" value="<?= (int)($row['expected_grant_version'] ?? 0) ?>">
                <input type="hidden" name="shipping_refund_minor" value="0">
                <?php if ($returnUrl !== ''): ?>
                <input type="hidden" name="return_url" value="<?= $escape($returnUrl) ?>">
                <?php endif; ?>
                <input class="w-input" type="number" min="1" max="<?= max(1, (int)($row['qty_minor'] ?? 1)) ?>" name="qty_minor" value="1" required aria-label="<?= __('退款数量') ?>" data-size="sm" style="width:5.5rem;">
                <input class="w-input" type="text" maxlength="255" name="reason" value="<?= __('后台退款') ?>" required aria-label="<?= __('退款原因') ?>" data-size="sm" style="width:8rem;">
                <input type="hidden" name="idempotency_key" value="refund-ui-<?= bin2hex(random_bytes(12)) ?>">
                <button class="w-button" type="submit" data-testid="refund-submit" data-tone="danger" data-size="sm"><?= __('退款') ?></button>
              </w:form>
            </td>
          </tr>
        <?php endforeach; endif; ?>
      </tbody>
    </table>
  </div>
  <?php if ($cases !== []): ?>
  <div class="w-table-wrap">
    <table class="w-table" data-testid="order-edit-refund-history">
      <thead>
        <tr>
          <th><?= __('案例') ?></th>
          <th><?= __('金额') ?></th>
          <th><?= __('支付方式') ?></th>
          <th><?= __('渠道退款号') ?></th>
          <th><?= __('原因') ?></th>
          <th><?= __('状态') ?></th>
          <th><?= __('顾客视图') ?></th>
        </tr>
      </thead>
      <tbody>
        <?php foreach ($cases as $row): ?>
          <tr data-testid="refund-case-row">
            <td><code><?= $escape($row['refund_case_uuid'] ?? '') ?></code></td>
            <td><?= $escape(($row['currency'] ?? '') . ' ' . number_format(((int)($row['amount_minor'] ?? 0)) / 100, 2, '.', '')) ?></td>
            <td><?= $escape($row['payment_method'] ?? '') ?></td>
            <td>
              <code><?= $escape($row['provider_refund_id'] ?? '') ?></code>
              <?php if (trim((string)($row['payment_refund_code'] ?? '')) !== ''): ?>
                <div class="w-text" data-size="sm" data-tone="muted"><?= $escape($row['payment_refund_code'] ?? '') ?></div>
              <?php endif; ?>
            </td>
            <td><?= $escape($row['reason'] ?? '') ?></td>
            <td>
              <div class="w-cluster" style="--w-gap:var(--weline-space-1);" data-testid="order-edit-refund-status">
                <?php foreach (BackendOrderOutcomeChip::presentMany(
                    (string)($row['status'] ?? ''),
                    (string)($row['channel_status'] ?? ''),
                ) as $outcomeChip): ?>
                  <?= $this->fetch('Weline_Order::templates/Backend/Order/partial/outcome-chip.phtml', [
                      'chip' => $outcomeChip,
                      'testid' => 'order-edit-refund-status-chip',
                  ]) ?>
                <?php endforeach; ?>
              </div>
            </td>
            <td data-testid="order-edit-refund-customer-view">
              <?php
              $customerChip = BackendOrderOutcomeChip::present((string)($row['customer_view'] ?? ''));
              echo $this->fetch('Weline_Order::templates/Backend/Order/partial/outcome-chip.phtml', [
                  'chip' => $customerChip,
                  'testid' => 'order-edit-refund-customer-view-chip',
              ]);
              ?>
            </td>
          </tr>
        <?php endforeach; ?>
      </tbody>
    </table>
  </div>
  <?php endif; ?>
</div>
