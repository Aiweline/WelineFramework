<?php
/** @var list<array<string,mixed>> $candidates */
/** @var list<array<string,mixed>> $progress */
/** @var string $returnUrl */
$candidates = is_array($candidates ?? null) ? $candidates : [];
$progress = is_array($progress ?? null) ? $progress : [];
$returnUrl = (string)($returnUrl ?? '');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="w-stack" style="--w-gap:var(--weline-space-3);" data-testid="order-edit-panel-shipment">
  <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;"><?= __('本单待发履约单元；提交后写入仓维进度账本。') ?></p>
  <div class="w-table-wrap">
    <table class="w-table" data-w-vertical="middle">
      <thead>
        <tr>
          <th><?= __('履约单元') ?></th>
          <th><?= __('仓库') ?></th>
          <th><?= __('已发/总量') ?></th>
          <th><?= __('提交') ?></th>
        </tr>
      </thead>
      <tbody>
        <?php if ($candidates === []): ?>
          <tr><td colspan="4" class="w-text" data-align="center" data-tone="muted"><?= __('本单暂无可发货履约单元') ?></td></tr>
        <?php else: foreach ($candidates as $row): ?>
          <tr data-testid="shipment-candidate">
            <td><code><?= $escape($row['fulfillment_unit_uuid'] ?? '') ?></code></td>
            <td><?= (int)($row['warehouse_id'] ?? 0) ?></td>
            <td><?= (int)($row['fulfilled_qty_minor'] ?? 0) ?> / <?= (int)($row['qty_minor'] ?? 0) ?></td>
            <td>
              <w:form method="post" action="@backend-url{'order/backend/shipment/execute'}" class="w-cluster" data-align="end" style="--w-gap:var(--weline-space-2);">
                <input type="hidden" name="fulfillment_unit_uuid" value="<?= $escape($row['fulfillment_unit_uuid'] ?? '') ?>">
                <input type="hidden" name="expected_version" value="<?= (int)($row['fulfillment_version'] ?? 0) ?>">
                <input type="hidden" name="expected_grant_version" value="<?= (int)($row['expected_grant_version'] ?? 0) ?>">
                <?php if ($returnUrl !== ''): ?>
                <input type="hidden" name="return_url" value="<?= $escape($returnUrl) ?>">
                <?php endif; ?>
                <input class="w-input" type="number" min="1" max="<?= max(1, (int)($row['remaining_qty_minor'] ?? 1)) ?>" name="qty_minor" value="<?= min(1, max(1, (int)($row['remaining_qty_minor'] ?? 1))) ?>" required aria-label="<?= __('发货数量') ?>" data-size="sm" style="width:5.5rem;">
                <input class="w-input" type="hidden" name="idempotency_key" value="ship-ui-<?= bin2hex(random_bytes(12)) ?>">
                <button class="w-button" type="submit" data-testid="shipment-submit" data-tone="primary" data-size="sm"><?= __('发货') ?></button>
              </w:form>
            </td>
          </tr>
        <?php endforeach; endif; ?>
      </tbody>
    </table>
  </div>
  <?php if ($progress !== []): ?>
  <div class="w-table-wrap">
    <table class="w-table">
      <thead><tr><th><?= __('进度') ?></th><th><?= __('数量') ?></th><th><?= __('版本') ?></th><th><?= __('时间') ?></th></tr></thead>
      <tbody>
        <?php foreach ($progress as $row): ?>
          <tr data-testid="shipment-progress-row">
            <td><code><?= $escape($row['fulfillment_unit_uuid'] ?? '') ?></code></td>
            <td><?= (int)($row['qty_minor'] ?? 0) ?></td>
            <td><?= (int)($row['expected_version'] ?? 0) ?> → <?= (int)($row['new_version'] ?? 0) ?></td>
            <td><?= $escape($row['created_at'] ?? '') ?></td>
          </tr>
        <?php endforeach; ?>
      </tbody>
    </table>
  </div>
  <?php endif; ?>
</div>
