<?php
/**
 * 结果态芯片：成功绿勾 / 失败红叉，禁止裸英文 code。
 * @var array{tone?: string, icon?: string, label?: string, kind?: string}|null $chip
 * @var string $testid
 */
$chip = is_array($chip ?? null) ? $chip : [];
$label = trim((string)($chip['label'] ?? ''));
if ($label === '') {
    return;
}
$tone = trim((string)($chip['tone'] ?? ''));
$kind = trim((string)($chip['kind'] ?? ''));
$testid = trim((string)($testid ?? 'order-outcome-chip'));
$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<span class="w-badge w-cluster"
      data-align="center"
      style="--w-gap:var(--weline-space-1);"
      <?php if ($tone !== ''): ?>data-tone="<?= $escape($tone) ?>"<?php endif; ?>
      data-kind="<?= $escape($kind) ?>"
      data-testid="<?= $escape($testid) ?>">
    <?php if ($kind === 'success'): ?>
        <w:icon name="check-circle" size="sm"></w:icon>
    <?php elseif ($kind === 'failed'): ?>
        <w:icon name="x-circle" size="sm"></w:icon>
    <?php elseif ($kind === 'processing'): ?>
        <w:icon name="clock" size="sm"></w:icon>
    <?php elseif ($kind === 'cancelled'): ?>
        <w:icon name="close" size="sm"></w:icon>
    <?php endif; ?>
    <span><?= $escape($label) ?></span>
</span>
