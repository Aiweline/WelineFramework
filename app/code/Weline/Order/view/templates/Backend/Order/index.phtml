<?php
/**
 * 订单列表 - 内容模板
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Order\Model\Order;
use Weline\Order\Service\BackendOrderListPresenter;

$orders = $this->getData('orders') ?? [];
$total = $this->getData('total') ?? 0;
$page = $this->getData('page') ?? 1;
$pageSize = $this->getData('page_size') ?? 20;
$totalPages = $this->getData('total_pages') ?? 1;
$filters = $this->getData('filters') ?? [];
$orderTypeRows = $this->getData('order_type_rows') ?? [];
/** @var \Weline\Order\Service\CommerceOrderTypeRegistry|null $orderTypeRegistry */
$orderTypeRegistry = $this->getData('order_type_registry');
$listPresenter = new BackendOrderListPresenter();

?>
<div class="w-grid">
    <template>Weline_Component::message.phtml</template>
</div>

<div class="w-grid" data-testid="order-management">
    <div style="--w-span:12;">
        <div class="w-card">
            <div class="w-card__header">
                <div class="w-grid" data-align="center">
                    <div style="--w-span-md:6;">
                        <h5 class="w-card__title" style="--w-mb:0;"><?= __('订单列表') ?></h5>
                    </div>
                    <div class="w-text" data-align="end" style="--w-span-md:6;">
                        <a href="@backend-url{'order/backend/order/edit'}" class="w-button" data-tone="primary">
                            <w:icon name="plus" size="sm"></w:icon> <?= __('新建订单') ?>
                        </a>
                    </div>
                </div>
            </div>
            <div class="w-card__body">
                <w:form method="get" action="@backend-url{'order/backend/order/index'}" style="--w-mb:var(--weline-space-4);">
                    <div class="w-grid" style="--w-gap:var(--weline-space-4);">
                        <div style="--w-span-md:3;">
                            <input type="text" name="keyword" class="w-input" placeholder="<?= __('搜索订单号、客户姓名、邮箱') ?>" value="<?= htmlspecialchars($filters['keyword'] ?? '') ?>">
                        </div>
                        <div style="--w-span-md:2;">
                            <select name="status" class="w-select">
                                <option value=""><?= __('全部状态') ?></option>
                                <option value="pending" <?= ($filters['status'] ?? '') === 'pending' ? 'selected' : '' ?>><?= __('待处理') ?></option>
                                <option value="processing" <?= ($filters['status'] ?? '') === 'processing' ? 'selected' : '' ?>><?= __('处理中') ?></option>
                                <option value="paid" <?= ($filters['status'] ?? '') === 'paid' ? 'selected' : '' ?>><?= __('已支付') ?></option>
                                <option value="fulfilled" <?= ($filters['status'] ?? '') === 'fulfilled' ? 'selected' : '' ?>><?= __('已发货') ?></option>
                                <option value="completed" <?= ($filters['status'] ?? '') === 'completed' ? 'selected' : '' ?>><?= __('已完成') ?></option>
                                <option value="cancelled" <?= ($filters['status'] ?? '') === 'cancelled' ? 'selected' : '' ?>><?= __('已取消') ?></option>
                            </select>
                        </div>
                        <div style="--w-span-md:2;">
                            <select name="payment_status" class="w-select">
                                <option value=""><?= __('全部支付状态') ?></option>
                                <option value="pending" <?= ($filters['payment_status'] ?? '') === 'pending' ? 'selected' : '' ?>><?= __('待支付') ?></option>
                                <option value="paid" <?= ($filters['payment_status'] ?? '') === 'paid' ? 'selected' : '' ?>><?= __('已支付') ?></option>
                                <option value="partial" <?= ($filters['payment_status'] ?? '') === 'partial' ? 'selected' : '' ?>><?= __('部分支付') ?></option>
                            </select>
                        </div>
                        <div style="--w-span-md:2;">
                            <select name="fulfillment_status" class="w-select">
                                <option value=""><?= __('全部发货状态') ?></option>
                                <option value="pending" <?= ($filters['fulfillment_status'] ?? '') === 'pending' ? 'selected' : '' ?>><?= __('待发货') ?></option>
                                <option value="shipped" <?= ($filters['fulfillment_status'] ?? '') === 'shipped' ? 'selected' : '' ?>><?= __('已发货') ?></option>
                                <option value="delivered" <?= ($filters['fulfillment_status'] ?? '') === 'delivered' ? 'selected' : '' ?>><?= __('已送达') ?></option>
                            </select>
                        </div>
                        <div style="--w-span-md:2;">
                            <select name="order_type" class="w-select" data-testid="order-type-filter">
                                <option value=""><?= __('全部类型') ?></option>
                                <?php foreach ($orderTypeRows as $row): ?>
                                    <?php
                                    $code = (string)($row['code'] ?? '');
                                    if ($code === '') {
                                        continue;
                                    }
                                    ?>
                                    <option value="<?= htmlspecialchars($code) ?>" <?= ($filters['order_type'] ?? '') === $code ? 'selected' : '' ?>><?= htmlspecialchars((string)($row['label'] ?? $code)) ?></option>
                                <?php endforeach; ?>
                            </select>
                        </div>
                        <div style="--w-span-md:2;">
                            <button type="submit" class="w-button" data-w-width="full" data-tone="primary">
                                <w:icon name="search" size="sm"></w:icon> <?= __('搜索') ?>
                            </button>
                        </div>
                        <div style="--w-span-md:1;">
                            <a href="@backend-url{'order/backend/order/index'}" class="w-button" data-w-width="full" data-tone="neutral">
                                <w:icon name="refresh" size="sm"></w:icon> <?= __('重置') ?>
                            </a>
                        </div>
                    </div>
                </w:form>

                <div class="w-table-wrap">
                    <table class="w-table">
                        <thead>
                            <tr>
                                <th><?= __('订单号') ?></th>
                                <th><?= __('类型') ?></th>
                                <th><?= __('客户') ?></th>
                                <th><?= __('订单总额') ?></th>
                                <th><?= __('订单状态') ?></th>
                                <th><?= __('支付状态') ?></th>
                                <th><?= __('发货状态') ?></th>
                                <th><?= __('创建时间') ?></th>
                                <th><?= __('操作') ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (empty($orders)): ?>
                                <tr>
                                    <td colspan="9" class="w-text" data-align="center"><?= __('暂无数据') ?></td>
                                </tr>
                            <?php else: ?>
                                <?php foreach ($orders as $order): ?>
                                    <?php
                                    $orderData = is_object($order) ? $order->getData() : $order;
                                    $presented = $listPresenter->present(is_array($orderData) ? $orderData : []);
                                    $status = $orderData[Order::schema_fields_STATUS] ?? '';
                                    $paymentStatus = $orderData[Order::schema_fields_PAYMENT_STATUS] ?? '';
                                    $fulfillmentStatus = $orderData[Order::schema_fields_FULFILLMENT_STATUS] ?? '';
                                    $rowOrderType = strtolower(trim((string)($orderData[Order::schema_fields_ORDER_TYPE] ?? '')));
                                    if ($rowOrderType === '') {
                                        $rowOrderType = \Weline\Order\Service\CommerceOrderTypeRegistry::CODE_TOC;
                                    }
                                    $rowTypeLabel = $orderTypeRegistry instanceof \Weline\Order\Service\CommerceOrderTypeRegistry
                                        ? $orderTypeRegistry->resolveLabel($rowOrderType)
                                        : $rowOrderType;
                                    $rowTypeTone = $orderTypeRegistry instanceof \Weline\Order\Service\CommerceOrderTypeRegistry
                                        ? $orderTypeRegistry->resolveBadgeTone($rowOrderType)
                                        : 'secondary';
                                    if ($rowTypeTone === 'muted') {
                                        $rowTypeTone = 'secondary';
                                    }
                                    ?>
                                    <tr>
                                        <td>
                                            <a href="@backend-url{'order/backend/order/view'|['id' => $orderData[Order::schema_fields_ID] ?? '']}">
                                                <?= htmlspecialchars($orderData[Order::schema_fields_ORDER_NUMBER] ?? '') ?>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="w-badge bg-<?= htmlspecialchars($rowTypeTone) ?>" data-testid="order-type-badge"><?= htmlspecialchars($rowTypeLabel) ?></span>
                                        </td>
                                        <td data-testid="order-list-customer">
                                            <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-1);">
                                                <?php if ($presented['customer_name'] !== ''): ?>
                                                    <span><?= htmlspecialchars($presented['customer_name']) ?></span>
                                                <?php elseif ($presented['is_anonymous']): ?>
                                                    <span><?= __('匿名') ?></span>
                                                <?php else: ?>
                                                    <span>—</span>
                                                <?php endif; ?>
                                                <?php if ($presented['is_anonymous'] && $presented['customer_name'] !== ''): ?>
                                                    <span class="w-badge bg-secondary"><?= __('匿名') ?></span>
                                                <?php endif; ?>
                                            </div>
                                            <?php if ($presented['customer_email'] !== ''): ?>
                                                <small class="w-text" data-tone="muted"><?= htmlspecialchars($presented['customer_email']) ?></small>
                                            <?php endif; ?>
                                        </td>
                                        <td>
                                            <strong><?= htmlspecialchars($orderData[Order::schema_fields_CURRENCY] ?? 'CNY') ?> <?= number_format((float)($orderData[Order::schema_fields_GRAND_TOTAL] ?? 0), 2) ?></strong>
                                        </td>
                                        <td>
                                            <?php
                                            $statusText = \Weline\Order\Model\Order::getStatusLabel($status);
                                            $statusClass = \Weline\Order\Model\Order::getStatusClassByCode($status);
                                            ?>
                                            <span class="w-badge bg-<?= $statusClass ?>"><?= $statusText ?></span>
                                        </td>
                                        <td>
                                            <?php
                                            $paymentClass = match($paymentStatus) {
                                                'pending' => 'warning',
                                                'paid' => 'success',
                                                'partial' => 'info',
                                                'refunded' => 'secondary',
                                                default => 'secondary',
                                            };
                                            $paymentText = Order::getPaymentStatusLabel($paymentStatus);
                                            ?>
                                            <span class="w-badge bg-<?= $paymentClass ?>"><?= $paymentText ?></span>
                                        </td>
                                        <td>
                                            <?php
                                            $fulfillmentClass = match($fulfillmentStatus) {
                                                'pending' => 'warning',
                                                'shipped' => 'info',
                                                'delivered' => 'success',
                                                default => 'secondary',
                                            };
                                            $fulfillmentText = Order::getFulfillmentStatusLabel($fulfillmentStatus);
                                            ?>
                                            <span class="w-badge bg-<?= $fulfillmentClass ?>"><?= $fulfillmentText ?></span>
                                        </td>
                                        <td data-testid="order-list-created-at"><?= htmlspecialchars($presented['created_at']) ?></td>
                                        <td>
                                            <div class="w-button-group">
                                                <a href="@backend-url{'order/backend/order/view'|['id' => $orderData[Order::schema_fields_ID] ?? '']}" class="w-button" title="<?= __('查看详情') ?>" data-tone="primary" data-size="sm">
                                                    <w:icon name="eye" size="sm"></w:icon>
                                                </a>
                                                <a href="@backend-url{'order/backend/order/edit'|['id' => $orderData[Order::schema_fields_ID] ?? '']}" class="w-button" title="<?= __('编辑') ?>" data-tone="info" data-size="sm">
                                                    <w:icon name="edit" size="sm"></w:icon>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>

                <?php if ($totalPages > 1): ?>
                    <nav aria-label="Page navigation">
                        <ul class="w-pagination" data-justify="center">
                            <?php if ($page > 1): ?>
                                <li class="w-pagination__item">
                                    <a class="w-pagination__link" href="@backend-url{'order/backend/order/index'}?page=<?= $page - 1 ?>&page_size=<?= $pageSize ?><?= !empty($filters) ? '&' . http_build_query($filters) : '' ?>">
                                        <?= __('上一页') ?>
                                    </a>
                                </li>
                            <?php endif; ?>
                            <?php for ($i = 1; $i <= $totalPages; $i++): ?>
                                <li class="w-pagination__item <?= $i === $page ? 'active' : '' ?>">
                                    <a class="w-pagination__link" href="@backend-url{'order/backend/order/index'}?page=<?= $i ?>&page_size=<?= $pageSize ?><?= !empty($filters) ? '&' . http_build_query($filters) : '' ?>">
                                        <?= $i ?>
                                    </a>
                                </li>
                            <?php endfor; ?>
                            <?php if ($page < $totalPages): ?>
                                <li class="w-pagination__item">
                                    <a class="w-pagination__link" href="@backend-url{'order/backend/order/index'}?page=<?= $page + 1 ?>&page_size=<?= $pageSize ?><?= !empty($filters) ? '&' . http_build_query($filters) : '' ?>">
                                        <?= __('下一页') ?>
                                    </a>
                                </li>
                            <?php endif; ?>
                        </ul>
                    </nav>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>
