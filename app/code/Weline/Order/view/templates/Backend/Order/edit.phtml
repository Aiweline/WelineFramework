                                <?php foreach ($items as $index => $item): ?>
                                    <?php
                                    $itemData = is_object($item) ? $item->getData() : $item;
                                    ?>
                                    <div class="order-item" data-w-border="border" style="--w-mb:var(--weline-space-2);--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">
                                        <div class="w-grid">
                                            <div style="--w-span-md:4;">
                                                <input type="text" name="items[<?= $index ?>][product_name]" class="w-input" placeholder="<?= __('商品名称') ?>" value="<?= htmlspecialchars($itemData[OrderItem::schema_fields_PRODUCT_NAME] ?? '') ?>" required>
                                            </div>
                                            <div style="--w-span-md:2;">
                                                <input type="text" name="items[<?= $index ?>][product_sku]" class="w-input" placeholder="<?= __('SKU') ?>" value="<?= htmlspecialchars($itemData[OrderItem::schema_fields_PRODUCT_SKU] ?? '') ?>">
                                            </div>
                                            <div style="--w-span-md:2;">
                                                <input type="number" name="items[<?= $index ?>][qty_ordered]" class="w-input" placeholder="<?= __('数量') ?>" value="<?= htmlspecialchars($itemData[OrderItem::schema_fields_QTY_ORDERED] ?? '1') ?>" required step="0.01">
                                            </div>
                                            <div style="--w-span-md:2;">
                                                <input type="number" name="items[<?= $index ?>][price]" class="w-input" placeholder="<?= __('单价') ?>" value="<?= htmlspecialchars($itemData[OrderItem::schema_fields_PRICE] ?? '0') ?>" required step="0.01">
                                            </div>
                                            <div style="--w-span-md:2;">
                                                <button type="button" class="w-button remove-item" data-tone="danger" data-size="sm"><?= __('删除') ?></button>
