                        </div>
                    </div>
                    
                    <div class="w-grid">
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('客户邮箱') ?></label>
                                <input type="email" name="customer_email" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_CUSTOMER_EMAIL] ?? '') ?>">
                            </div>
                        </div>
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('客户电话') ?></label>
                                <input type="text" name="customer_phone" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_CUSTOMER_PHONE] ?? '') ?>">
                            </div>
                        </div>
                    </div>
                    
                    <div class="w-grid">
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('支付方式') ?></label>
                                <input type="text" name="payment_method" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_PAYMENT_METHOD] ?? '') ?>">
                            </div>
                        </div>
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('配送方式') ?></label>
                                <input type="text" name="shipping_method" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_SHIPPING_METHOD] ?? '') ?>">
