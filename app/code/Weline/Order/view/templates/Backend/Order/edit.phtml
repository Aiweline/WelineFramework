                    </div>
                    
                    <div class="w-text" data-align="end">
                        <a href="<?= $this->getBackendUrl('weline_order/backend/order/index') ?>" class="w-button" data-tone="neutral"><?= __('取消') ?></a>
                        <button type="submit" class="w-button" data-tone="primary"><?= __('保存') ?></button>
                    </div>
                </w:form>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    
    var itemIndex = <?= count($items) ?>;
    
    document.getElementById('add-item').addEventListener('click', function() {
        var itemsContainer = document.getElementById('order-items');
        var itemHtml = '<div class="order-item" data-w-border="border" style="--w-mb:var(--weline-space-2);--w-pt:var(--weline-space-2);--w-pe:var(--weline-space-2);--w-pb:var(--weline-space-2);--w-ps:var(--weline-space-2);">' +
            '<div class="w-grid">' +
            '<div style="--w-span-md:4;">' +
            '<input type="text" name="items[' + itemIndex + '][product_name]" class="w-input" placeholder="<?= __('商品名称') ?>" required>' +
            '</div>' +
            '<div style="--w-span-md:2;">' +
            '<input type="text" name="items[' + itemIndex + '][product_sku]" class="w-input" placeholder="<?= __('SKU') ?>">' +
            '</div>' +
            '<div style="--w-span-md:2;">' +
            '<input type="number" name="items[' + itemIndex + '][qty_ordered]" class="w-input" placeholder="<?= __('数量') ?>" required step="0.01" value="1">' +
            '</div>' +
            '<div style="--w-span-md:2;">' +
            '<input type="number" name="items[' + itemIndex + '][price]" class="w-input" placeholder="<?= __('单价') ?>" required step="0.01" value="0">' +
            '</div>' +
            '<div style="--w-span-md:2;">' +
            '<button type="button" class="w-button remove-item" data-tone="danger" data-size="sm"><?= __('删除') ?></button>' +
            '</div>' +
            '</div>' +
            '</div>';
        itemsContainer.insertAdjacentHTML('beforeend', itemHtml);
        itemIndex++;
    });
    
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-item')) {
            e.target.closest('.order-item').remove();
        }
    });
})();
</script>
