<script>
(function () {
    'use strict';
    var root = document.querySelector('[data-order-ops-async="1"]');
    if (!root) return;
    var loadingText = root.getAttribute('data-i18n-loading') || '…';
    var failedText = root.getAttribute('data-i18n-failed') || 'Error';

    function loadPanel(tab) {
        var src = tab.getAttribute('data-panel-src');
        if (!src) return;
        var panelId = tab.getAttribute('aria-controls') || '';
        var panel = document.getElementById(panelId);
        if (!panel || panel.getAttribute('data-loaded') === '1') return;
        panel.setAttribute('data-loading', '1');
        panel.innerHTML = '<p class="w-text" data-tone="muted" data-size="sm">' + loadingText + '</p>';
        fetch(src, {
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            }
        }).then(function (res) {
            if (!res.ok) throw new Error('http');
            return res.text();
        }).then(function (html) {
            var tmp = document.createElement('div');
            tmp.innerHTML = html;
            var frag = tmp.querySelector('[data-testid^="order-edit-panel-"]');
            panel.innerHTML = frag ? frag.outerHTML : html;
            panel.setAttribute('data-loaded', '1');
            panel.removeAttribute('data-loading');
            // 异步面板注入后补装 data-weline-load（模块可选）
            panel.querySelectorAll('[data-weline-load]').forEach(function (el) {
                var name = el.getAttribute('data-weline-load');
                if (!name || !window.Weline || typeof window.Weline.load !== 'function') {
                    return;
                }
                window.Weline.load(name).then(function (mod) {
                    if (mod && typeof mod.boot === 'function') {
                        mod.boot({ el: el });
                    } else if (mod && typeof mod.init === 'function') {
                        mod.init({ el: el });
                    }
                }).catch(function () { /* optional module */ });
            });
        }).catch(function () {
            panel.innerHTML = '<p class="w-text" data-tone="danger" data-size="sm">' + failedText + '</p>';
            panel.removeAttribute('data-loading');
        });
    }

    root.addEventListener('click', function (ev) {
        var tab = ev.target && ev.target.closest ? ev.target.closest('[role="tab"]') : null;
        if (!tab || !root.contains(tab)) return;
        window.setTimeout(function () { loadPanel(tab); }, 0);
    });

    root.querySelectorAll('[role="tab"][aria-selected="true"]').forEach(function (tab) {
        loadPanel(tab);
    });

})();
</script>
