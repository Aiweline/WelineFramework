                    <?php if ($isEdit): ?>
                        <input type="hidden" name="order_id" value="<?= $orderId ?>">
                    <?php endif; ?>
                    
                    <div class="w-grid">
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('客户ID') ?></label>
                                <input type="number" name="customer_id" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_CUSTOMER_ID] ?? '') ?>">
                            </div>
                        </div>
                        <div style="--w-span-md:6;">
                            <div style="--w-mb:var(--weline-space-4);">
                                <label class="w-field__label"><?= __('客户姓名') ?></label>
                                <input type="text" name="customer_name" class="w-input" value="<?= htmlspecialchars($orderData[Order::schema_fields_CUSTOMER_NAME] ?? '') ?>" required>
