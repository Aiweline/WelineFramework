<?php
/**
 * 后台订单顶部状态轨（管理页 / 详情共用）
 * @var \Weline\Framework\View\Template $this
 */

use Weline\Order\Service\BackendOrderOutcomeChip;

$flow = is_array($this->getData('status_flow') ?? null) ? $this->getData('status_flow') : [];
$steps = is_array($flow['steps'] ?? null) ? $flow['steps'] : [];
if ($steps === []) {
    return;
}
$refunds = is_array($flow['refunds'] ?? null) ? $flow['refunds'] : [];
$hasRefund = !empty($flow['has_refund']);
$escape = static fn (mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?>
<div class="w-stack" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-2);" data-testid="order-status-flow">
    <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
        <span class="w-text" data-tone="muted" data-size="sm"><lang>状态流转</lang></span>
        <?php if (trim((string)($flow['current_label'] ?? '')) !== ''): ?>
            <span class="w-badge" data-tone="<?= $escape((string)($flow['steps'][array_key_last($steps)]['tone'] ?? 'info')) ?>"
                  data-testid="order-status-flow-current"><?= $escape((string)$flow['current_label']) ?></span>
        <?php endif; ?>
        <?php if (trim((string)($flow['payment_method_label'] ?? '')) !== ''): ?>
            <span class="w-badge" data-tone="info" data-testid="order-status-flow-payment-method"><?= $escape((string)$flow['payment_method_label']) ?></span>
        <?php endif; ?>
        <?php
        $paymentStatusLabel = trim((string)($flow['payment_status_label'] ?? ''));
        $currentLabel = trim((string)($flow['current_label'] ?? ''));
        if ($paymentStatusLabel !== '' && $paymentStatusLabel !== $currentLabel):
            ?>
            <span class="w-text" data-size="sm" data-testid="order-status-flow-payment-status"><?= $escape($paymentStatusLabel) ?></span>
        <?php endif; ?>
        <?php if (trim((string)($flow['fulfillment_status_label'] ?? '')) !== ''): ?>
            <span class="w-text" data-tone="muted" data-size="sm" data-testid="order-status-flow-fulfillment"><?= $escape((string)$flow['fulfillment_status_label']) ?></span>
        <?php endif; ?>
    </div>
    <ol class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);list-style:none;padding:0;margin:0;" data-testid="order-status-flow-steps">
        <?php foreach ($steps as $index => $step):
            if (!is_array($step)) {
                continue;
            }
            $tone = trim((string)($step['tone'] ?? ''));
            $state = trim((string)($step['state'] ?? ''));
            ?>
            <?php if ((int)$index > 0): ?>
                <li class="w-text" data-tone="muted" aria-hidden="true">→</li>
            <?php endif; ?>
            <li>
                <span class="w-badge"
                      <?php if ($tone !== ''): ?>data-tone="<?= $escape($tone) ?>"<?php endif; ?>
                      data-state="<?= $escape($state) ?>"
                      data-testid="order-status-flow-step"><?= $escape((string)($step['label'] ?? '')) ?></span>
            </li>
        <?php endforeach; ?>
    </ol>
    <?php if ($hasRefund): ?>
        <div class="w-stack" style="--w-gap:var(--weline-space-1);" data-testid="order-status-flow-refunds">
            <?php if ($refunds === []): ?>
                <div class="w-cluster" data-align="baseline" style="--w-gap:var(--weline-space-2);">
                    <span class="w-text" data-tone="muted" data-size="sm"><lang>退款</lang></span>
                    <?= $this->fetch('Weline_Order::templates/Backend/Order/partial/outcome-chip.phtml', [
                        'chip' => BackendOrderOutcomeChip::present((string)($flow['current_code'] ?? 'refunded')),
                        'testid' => 'order-status-flow-refund-chip',
                    ]) ?>
                </div>
            <?php else: ?>
                <?php foreach ($refunds as $refund):
                    if (!is_array($refund)) {
                        continue;
                    }
                    ?>
                    <div class="w-cluster" data-align="baseline" style="--w-gap:var(--weline-space-2);" data-testid="order-status-flow-refund">
                        <span class="w-text" data-tone="muted" data-size="sm"><lang>退款</lang></span>
                        <?php if (trim((string)($refund['payment_method'] ?? '')) !== ''): ?>
                            <span><?= $escape((string)$refund['payment_method']) ?></span>
                        <?php endif; ?>
                        <?php foreach (BackendOrderOutcomeChip::presentMany(
                            (string)($refund['status'] ?? ''),
                            (string)($refund['channel_status'] ?? ''),
                        ) as $outcomeChip): ?>
                            <?= $this->fetch('Weline_Order::templates/Backend/Order/partial/outcome-chip.phtml', [
                                'chip' => $outcomeChip,
                                'testid' => 'order-status-flow-refund-chip',
                            ]) ?>
                        <?php endforeach; ?>
                        <?php if (trim((string)($refund['provider_refund_id'] ?? '')) !== ''): ?>
                            <span class="w-text" data-tone="muted" data-size="sm"><lang>渠道退款号</lang></span>
                            <code data-testid="order-status-flow-refund-id"><?= $escape((string)$refund['provider_refund_id']) ?></code>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    <?php endif; ?>
    <?php if (!$hasRefund && trim((string)($flow['latest_comment'] ?? '')) !== ''): ?>
        <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;" data-testid="order-status-flow-comment"><?= $escape((string)$flow['latest_comment']) ?></p>
    <?php endif; ?>
</div>
