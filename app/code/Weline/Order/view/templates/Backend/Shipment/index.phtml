<?php
/**
 * Backend shipment management — Shopify-aligned Mark as fulfilled (optional tracking).
 *
 * @var list<array<string,mixed>> $candidates
 * @var list<array<string,mixed>> $progress
 * @var list<array<string,mixed>> $tracking_carriers
 * @var list<array<string,mixed>> $label_services
 * @var array<string,mixed> $shipping_ref
 */
$candidates = is_array($candidates ?? null) ? $candidates : [];
$progress = is_array($progress ?? null) ? $progress : [];
$tracking_carriers = is_array($tracking_carriers ?? null) ? $tracking_carriers : [];
$label_services = is_array($label_services ?? null) ? $label_services : [];
$shipping_ref = is_array($shipping_ref ?? null) ? $shipping_ref : [];
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$defaultCarrierId = (int)($shipping_ref['checkout_carrier_id'] ?? 0);
?>
<div class="w-grid" data-testid="order-shipment-management" weline-code="order.backend.shipment.section_1">
  <div style="--w-span:12;">
    <div class="w-backend-page__heading">
      <h4 class="w-backend-page__title"><w:icon name="truck" size="sm"></w:icon><?= __('订单发货管理') ?></h4>
    </div>
    <div><template>Weline_Component::message.phtml</template></div>
    <div class="w-alert" data-tone="info" style="--w-mb:var(--weline-space-4);">
      <?= __('对齐 Shopify：可先登记发货，运单号可后补；无运单号时不会发送「已发货」邮件。结账配送仅作参考。') ?>
    </div>

    <div class="w-stack" style="--w-gap:var(--weline-space-4); --w-mb:var(--weline-space-4);">
      <h5 class="w-text" style="--w-mb:0;"><?= __('待发货履约单元') ?></h5>
      <?php if ($candidates === []): ?>
        <div class="w-alert" data-tone="muted"><?= __('暂无可发货履约单元') ?></div>
      <?php else: foreach ($candidates as $row):
        $remaining = max(1, (int)($row['remaining_qty_minor'] ?? 1));
        $unitShort = (string)($row['unit_short'] ?? '');
        if ($unitShort === '') {
          $uuid = (string)($row['fulfillment_unit_uuid'] ?? '');
          $parts = explode('-', $uuid);
          $unitShort = (string)end($parts);
        }
        ?>
        <div class="w-card" data-testid="shipment-candidate" data-unit-uuid="<?= $escape($row['fulfillment_unit_uuid'] ?? '') ?>">
          <div class="w-card__body">
            <div class="w-cluster" data-justify="between" style="--w-gap:var(--weline-space-2);margin-bottom:var(--weline-space-3);">
              <div class="w-stack" style="--w-gap:var(--weline-space-1);">
                <div class="w-cluster" data-align="center" style="--w-gap:var(--weline-space-2);">
                  <a class="w-text" href="@backend-url{'order/backend/order/view'|['id' => (int)($row['order_id'] ?? 0)]}">
                    <strong><?= $escape($row['order_number'] ?? '') ?></strong>
                  </a>
                  <span class="w-badge" data-tone="info"><?= __('包裹') ?> <?= $escape($unitShort) ?></span>
                  <?php if (!empty($row['status_label'])): ?>
                    <span class="w-badge" data-tone="warning"><?= $escape($row['status_label']) ?></span>
                  <?php endif; ?>
                </div>
                <p class="w-text" data-tone="muted" data-size="sm" style="--w-mb:0;">
                  <?= __('发货仓') ?>：<?= $escape($row['warehouse_label'] ?? __('平台履约（未绑仓库）')) ?>
                  · <?= __('已发/总量') ?>：<?= (int)($row['fulfilled_qty_minor'] ?? 0) ?> / <?= (int)($row['qty_minor'] ?? 0) ?>
                  · CAS <?= (int)($row['fulfillment_version'] ?? 0) ?>
                </p>
              </div>
            </div>

            <w:form method="post" action="@backend-url{'order/backend/shipment/execute'}" class="w-stack" style="--w-gap:var(--weline-space-3);" data-testid="shipment-command-form">
              <input type="hidden" name="fulfill_mode" value="manual">
              <input type="hidden" name="fulfillment_unit_uuid" value="<?= $escape($row['fulfillment_unit_uuid'] ?? '') ?>">
              <input type="hidden" name="expected_version" value="<?= (int)($row['fulfillment_version'] ?? 0) ?>">
              <input type="hidden" name="expected_grant_version" value="<?= (int)($row['expected_grant_version'] ?? 0) ?>">
              <input type="hidden" name="idempotency_key" value="ship-ui-<?= bin2hex(random_bytes(12)) ?>">
              <div class="w-grid" style="--w-gap:var(--weline-space-3);">
                <div style="--w-span:4;">
                  <label class="w-label"><?= __('承运商') ?></label>
                  <select class="w-input" name="carrier_id" data-size="sm" data-testid="shipment-carrier-select">
                    <option value="0"><?= __('其他（手填名称）') ?></option>
                    <?php foreach ($tracking_carriers as $c): ?>
                      <option value="<?= (int)$c['carrier_id'] ?>" <?= $defaultCarrierId === (int)$c['carrier_id'] ? 'selected' : '' ?>>
                        <?= $escape($c['carrier_name'] ?? $c['carrier_code'] ?? '') ?>
                      </option>
                    <?php endforeach; ?>
                  </select>
                </div>
                <div style="--w-span:4;">
                  <label class="w-label"><?= __('其他承运商名称') ?></label>
                  <input class="w-input" type="text" name="carrier_name" maxlength="100" placeholder="<?= __('选「其他」时填写') ?>" data-size="sm">
                </div>
                <div style="--w-span:4;">
                  <label class="w-label"><?= __('物流单号') ?> <span class="w-text" data-tone="muted" data-size="sm"><?= __('可选') ?></span></label>
                  <input class="w-input" type="text" name="tracking_number" maxlength="100" placeholder="<?= __('留空则不发送发货邮件') ?>" data-size="sm" data-testid="shipment-tracking-number">
                </div>
                <div style="--w-span:3;">
                  <label class="w-label"><?= __('数量') ?></label>
                  <input class="w-input" type="number" min="1" max="<?= $remaining ?>" name="qty_minor" value="<?= min($remaining, max(1, (int)($row['remaining_qty_minor'] ?? 1))) ?>" required data-size="sm" aria-label="<?= __('发货数量') ?>">
                </div>
                <div style="--w-span:9;padding-top:1.5rem;" class="w-cluster" data-align="end" data-justify="between">
                  <label class="w-check">
                    <input type="checkbox" name="notify_customer" value="1" data-testid="shipment-notify-customer">
                    <?= __('有运单号时发送「已发货」邮件') ?>
                  </label>
                  <button class="w-button" type="submit" data-testid="shipment-submit" data-tone="primary" data-size="sm"><?= __('确认发货') ?></button>
                </div>
              </div>
            </w:form>
          </div>
        </div>
      <?php endforeach; endif; ?>
    </div>

    <div class="w-card"><div class="w-card__body">
      <h5><?= __('仓维发货进度账本') ?></h5>
      <div class="w-table-wrap"><table class="w-table"><thead><tr><th><?= __('订单') ?></th><th><?= __('履约单元') ?></th><th><?= __('数量') ?></th><th><?= __('版本') ?></th><th><?= __('幂等键') ?></th><th><?= __('时间') ?></th></tr></thead><tbody>
      <?php if ($progress === []): ?><tr><td colspan="6" class="w-text" data-align="center" data-tone="muted"><?= __('暂无进度记录') ?></td></tr>
      <?php else: foreach ($progress as $row): ?><tr data-testid="shipment-progress-row"><td><?= $escape($row['order_number'] ?? '') ?></td><td><code><?= $escape($row['fulfillment_unit_uuid'] ?? '') ?></code></td><td><?= (int)($row['qty_minor'] ?? 0) ?></td><td><?= (int)($row['expected_version'] ?? 0) ?> → <?= (int)($row['new_version'] ?? 0) ?></td><td><code><?= $escape($row['idempotency_key'] ?? '') ?></code></td><td><?= $escape($row['created_at'] ?? '') ?></td></tr><?php endforeach; endif; ?>
      </tbody></table></div>
    </div></div>
  </div>
</div>
