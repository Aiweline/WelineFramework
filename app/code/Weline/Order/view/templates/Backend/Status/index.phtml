<script>
(function() {
    'use strict';

    function statusOperation(operation, id, grantVersion) {
        return Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
        .then(function(api) {
            return api.resource('order_admin')[operation]({
                id: id,
                expected_grant_version: grantVersion
            });
        });
    }
    
    function performDelete(id) {
        statusOperation(
            'deleteStatus',
            id,
            <?= (int)($status_grant_versions[\Weline\Acl\Api\Authorization\ObjectAction::DELETE] ?? 0) ?>
        )
        .then(function(data) {
            if (data.success) {
                if (typeof Weline.UI.toast !== 'undefined') {
                    Weline.UI.toast.success('<?= __('状态已删除') ?>');
                }
                setTimeout(function() { location.reload(); }, 1500);
            } else {
                if (typeof Weline.UI.toast !== 'undefined') {
                    Weline.UI.toast.error(data.message || '<?= __('删除失败') ?>');
                }
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            if (typeof Weline.UI.toast !== 'undefined') {
                Weline.UI.toast.error('<?= __('删除失败，请重试') ?>');
            }
        });
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // 切换启用状态
        document.querySelectorAll('.weline-order-toggle-status').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-id');
                
                statusOperation(
                    'toggleStatus',
                    id,
                    <?= (int)($status_grant_versions[\Weline\Acl\Api\Authorization\ObjectAction::UPDATE] ?? 0) ?>
                )
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        if (typeof Weline.UI.toast !== 'undefined') {
                            Weline.UI.toast.error(data.message || '<?= __('操作失败') ?>');
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.error('<?= __('操作失败，请重试') ?>');
                    }
                });
            });
        });
        
        // 删除状态
        document.querySelectorAll('.weline-order-delete-status').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-id');
                var code = this.getAttribute('data-code');
                
                Weline.UI.dialog.confirm('<?= __('确定要删除状态') ?> ' + code + ' <?= __('吗？') ?>', {
                    title: '<?= __('确认删除') ?>',
                    confirmLabel: '<?= __('确定删除') ?>',
                    cancelLabel: '<?= __('取消') ?>',
                    tone: 'danger',
                    dangerous: true
                }).then(function(confirmed) {
                    if (confirmed) performDelete(id);
                });
            });
        });
    });
})();
</script>
