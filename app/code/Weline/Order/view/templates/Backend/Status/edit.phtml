<script>
(function() {
    'use strict';
    
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('weline-order-status-form');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            var formData = new FormData(form);
            var payload = new URLSearchParams();
            formData.forEach(function(value, key) {
                if (!(typeof File !== 'undefined' && value instanceof File)) {
                    payload.append(key, String(value));
                }
            });
            var grantVersion = parseInt(formData.get('expected_grant_version') || '0', 10);

            Promise.resolve(window.Weline.load ? window.Weline.load('api') : window.Weline.Api)
            .then(function(api) {
                return api.resource('order_admin').saveStatus({
                    payload: payload.toString(),
                    expected_grant_version: grantVersion
                });
            })
            .then(function(data) {
                if (data.success) {
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.success(data.message || '<?= __('保存成功') ?>');
                    }
                    setTimeout(function() {
                        location.href = '<?= $this->getBackendUrl("weline_order/backend/status/index") ?>';
                    }, 1500);
                } else {
                    if (typeof Weline.UI.toast !== 'undefined') {
                        Weline.UI.toast.error(data.message || '<?= __('保存失败') ?>');
                    }
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                if (typeof Weline.UI.toast !== 'undefined') {
                    Weline.UI.toast.error('<?= __('保存失败，请重试') ?>');
                }
            });
        });
    });
})();
</script>
