<?php
$record_type=$record_type??'record'; $record_title=$record_title??__('订单业务记录'); $columns=$columns??[]; $records=$records??[];
$status=$status??''; $load_error=$load_error??'';
$escape=static fn(mixed $value):string=>htmlspecialchars((string)$value,ENT_QUOTES,'UTF-8');
?>
<div class="w-grid" data-testid="order-<?= $escape($record_type) ?>-management"><div style="--w-span:12;">
  <div class="w-backend-page__heading"><h4 class="w-backend-page__title"><?= $escape($record_title) ?></h4></div>
  <?php if($load_error!==''):?><div class="w-alert" data-tone="danger"><?= $escape($load_error) ?></div><?php endif;?>
  <div class="w-card"><div class="w-card__body">
    <form method="get" class="w-grid" style="--w-gap:var(--weline-space-2);--w-mb:var(--weline-space-4);"><div style="--w-span-md:4;"><input class="w-input" name="status" value="<?= $escape($status) ?>" placeholder="<?= __('按状态筛选') ?>"></div><div><button class="w-button" type="submit" data-tone="primary"><?= __('筛选') ?></button></div></form>
    <div class="w-table-wrap"><table class="w-table"><thead><tr><?php foreach($columns as $label):?><th><?= $escape($label) ?></th><?php endforeach;?></tr></thead><tbody>
    <?php if($records===[]):?><tr><td colspan="<?= max(1,count($columns)) ?>" class="w-text" data-align="center" data-tone="muted"><?= __('暂无记录') ?></td></tr>
    <?php else:foreach($records as $record):?><tr><?php foreach($columns as $field=>$label):?><td>
      <?php if($field==='order_id'):?><a href="<?= $this->getBackendUrl('weline_order/backend/order/view?id='.(int)($record[$field]??0)) ?>"><?= (int)($record[$field]??0) ?></a>
      <?php elseif(in_array($field,['transaction_id','tracking_number','invoice_number'],true)):?><code><?= $escape($record[$field]??'') ?></code>
      <?php else:?><?= $escape($record[$field]??'') ?><?php endif;?>
    </td><?php endforeach;?></tr><?php endforeach;endif;?></tbody></table></div>
  </div></div>
</div></div>
