<?php
$record_type=$record_type??'record'; $record_title=$record_title??__('订单业务记录'); $columns=$columns??[]; $records=$records??[];
$status=$status??''; $load_error=$load_error??'';
$escape=static fn(mixed $value):string=>htmlspecialchars((string)$value,ENT_QUOTES,'UTF-8');
?>
<div class="row" data-testid="order-<?= $escape($record_type) ?>-management"><div class="col-12">
  <div class="page-title-box"><h4 class="page-title"><?= $escape($record_title) ?></h4></div>
  <?php if($load_error!==''):?><div class="alert alert-danger"><?= $escape($load_error) ?></div><?php endif;?>
  <div class="card"><div class="card-body">
    <form method="get" class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="status" value="<?= $escape($status) ?>" placeholder="<?= __('按状态筛选') ?>"></div><div class="col-auto"><button class="btn btn-primary" type="submit"><?= __('筛选') ?></button></div></form>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><?php foreach($columns as $label):?><th><?= $escape($label) ?></th><?php endforeach;?></tr></thead><tbody>
    <?php if($records===[]):?><tr><td colspan="<?= max(1,count($columns)) ?>" class="text-center text-muted"><?= __('暂无记录') ?></td></tr>
    <?php else:foreach($records as $record):?><tr><?php foreach($columns as $field=>$label):?><td>
      <?php if($field==='order_id'):?><a href="<?= $this->getBackendUrl('weline_order/backend/order/view?id='.(int)($record[$field]??0)) ?>"><?= (int)($record[$field]??0) ?></a>
      <?php elseif(in_array($field,['transaction_id','tracking_number','invoice_number'],true)):?><code><?= $escape($record[$field]??'') ?></code>
      <?php else:?><?= $escape($record[$field]??'') ?><?php endif;?>
    </td><?php endforeach;?></tr><?php endforeach;endif;?></tbody></table></div>
  </div></div>
</div></div>
