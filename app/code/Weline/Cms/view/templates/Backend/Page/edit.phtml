$websites = $this->getData('websites') ?: [];
$layoutOptions = $this->getData('layout_options') ?: [];
$layoutSelection = $this->getData('layout_selection') ?: [];
$localePayload = $this->getData('locale_payload') ?: [];
$editorContext = $this->getData('editor_context') ?: [];
$storeOptions = $this->getData('store_options') ?: [];
$localeAllowedValues = array_values((array)($localePayload['supported_locales'] ?? []));
$currentLocale = (string)($localePayload['current_locale'] ?? '');
$sourceLocale = (string)($localePayload['source_locale'] ?? '');
$localeTitles = (array)($localePayload['titles'] ?? []);
$missingLocaleValues = [];
foreach ($localeAllowedValues as $localeCode) {
    $localeCode = trim((string)$localeCode);
    if ($localeCode !== '' && $localeCode !== $sourceLocale && trim((string)($localeTitles[$localeCode] ?? '')) === '') {
        $missingLocaleValues[] = $localeCode;
    }
}
$missingLocaleCount = count($missingLocaleValues);
$currentLocaleTitle = (string)($localePayload['current_title'] ?? ($page['title'] ?? ''));
$themeEditorUrl = (string)($this->getData('theme_editor_url') ?: '');
$previewUrl = (string)($this->getData('preview_url') ?: '');
$pageId = (int)($page['page_id'] ?? 0);
$hasPage = $pageId > 0;
$currentWebsiteId = (int)($page['website_id'] ?? 0);
$currentWebsiteCode = (string)($page['website_code'] ?? 'default');
$hasPathGroupContext = $hasPage && trim((string)($page['path_group'] ?? '')) !== '';
$currentLayoutOption = (string)($layoutSelection['layout_option'] ?? 'default');
$currentStoreId = (int)($editorContext['store_id'] ?? $localePayload['store_id'] ?? 0);
$currentStoreCode = (string)($editorContext['store_code'] ?? $localePayload['store_code'] ?? '');
$currentStoreMode = (string)($editorContext['store_mode'] ?? $localePayload['store_mode'] ?? 'normal');
$canonicalScope = (string)($editorContext['scope'] ?? $page['scope'] ?? 'default');
$currentVariant = (array)($localePayload['current_variant'] ?? []);
$currentVariantStatus = (string)($currentVariant['variant_status'] ?? 'draft');
$currentTranslationState = (string)($currentVariant['translation_state'] ?? 'draft');
$layoutOptionsPairs = [];
foreach ($layoutOptions as $option) {
    $value = (string)($option['value'] ?? 'default');
    $label = (string)($option['label'] ?? $value);
    $layoutOptionsPairs[] = str_replace([',', ':'], [' ', ' '], $value) . ':' . str_replace([',', ':'], [' ', ' '], $label);
}
$layoutOptionsStr = implode(',', $layoutOptionsPairs);
$layoutPlaceholder = __('请选择或搜索布局...');
$cmsEditorState = [
    'page_id' => $pageId,
    'supported_locales' => $localeAllowedValues,
    'source_locale' => $sourceLocale,
    'current_locale' => $currentLocale,
    'titles' => $localeTitles,
    'layout_option' => $currentLayoutOption,
    'pageId' => $pageId,
    'websiteId' => $currentWebsiteId,
    'websiteCode' => $currentWebsiteCode,
    'storeId' => $currentStoreId,
    'storeCode' => $currentStoreCode,
    'storeMode' => $currentStoreMode,
    'scope' => $canonicalScope,
    'variant_status' => $currentVariantStatus,
    'translation_state' => $currentTranslationState,
    'translation' => [
        'type_code' => 'cms.page_translation',
        'missing_locales' => $missingLocaleValues,
        'messages' => [
            'button' => (string)__('一键翻译缺失语言'),
            'continue' => (string)__('继续查看翻译任务'),
            'running' => (string)__('翻译进行中'),
            'save_first' => (string)__('请先保存页面，再翻译缺失语言。'),
            'save_source_first' => (string)__('英语标题已修改，请先保存页面再翻译。'),
            'ready' => (string)__('待补全语言：'),
            'starting' => (string)__('正在启动翻译任务…'),
            'reconnecting' => (string)__('正在恢复上次翻译任务…'),
            'progress' => (string)__('正在翻译语言'),
            'complete' => (string)__('网站支持的语言均已补全。'),
            'completed_partial' => (string)__('翻译任务完成，仍有未补全语言：'),
            'failed' => (string)__('翻译任务未完成，请稍后重试。'),
            'disconnected' => (string)__('连接暂时中断，点击按钮可继续查看任务。'),
        ],
    ],
];
$localeTitlesJson = json_encode($localeTitles, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '{}';
$websiteSelectOptions = [];
foreach ($websites as $website) {
    if (!is_array($website)) {
        continue;
    }
    $websiteId = (int)($website['website_id'] ?? $website['id'] ?? 0);
    $websiteCode = trim((string)($website['code'] ?? 'default'));
    if ($websiteCode === '') {
        $websiteCode = 'default';
    }
    $websiteSelectOptions[] = [
        'value' => (string)$websiteId,
        'label' => (string)($website['label'] ?? $website['name'] ?? $websiteCode),
        'meta' => $websiteCode,
    ];
}
$websiteSelectValue = '';
if ($currentWebsiteId > 0) {
    $websiteSelectValue = (string)$currentWebsiteId;
} else {
    foreach ($websiteSelectOptions as $option) {
        if ((string)($option['meta'] ?? '') === $currentWebsiteCode) {
            $websiteSelectValue = (string)($option['value'] ?? '');
            break;
        }
    }
    if ($websiteSelectValue === '' && $websiteSelectOptions !== []) {
        $websiteSelectValue = (string)($websiteSelectOptions[0]['value'] ?? '');
    }
}
$websiteSelectDisplay = '';
foreach ($websiteSelectOptions as $option) {
    if ((string)($option['value'] ?? '') === $websiteSelectValue) {
        $websiteSelectDisplay = trim((string)($option['label'] ?? ''));
        if ($websiteSelectDisplay === '') {
            $websiteSelectDisplay = '#' . $websiteSelectValue;
        }
        break;
    }
}
if ($websiteSelectDisplay === '' && $websiteSelectValue !== '') {
    $websiteSelectDisplay = '#' . $websiteSelectValue;
}
$websiteSelectOptionsJson = json_encode($websiteSelectOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]';
?>
