<script>
(function () {
    const codeInput = document.querySelector('.cms-page-settings-bar [data-cms-website-code]');
    if (!codeInput) {
        return;
    }
    const syncCodeFromItem = function (item) {
        if (item && item.meta) {
            codeInput.value = String(item.meta);
            return;
        }
        const api = window.WelineWebsiteSelect && window.WelineWebsiteSelect['cms-page-website'];
        if (api && typeof api.getSelected === 'function') {
            const selected = api.getSelected();
            const first = selected && selected[0] ? selected[0] : null;
            codeInput.value = first && first.meta ? String(first.meta) : '';
            return;
        }
        const hidden = document.querySelector('.cms-page-settings-bar input[name="website_id"][data-website-select-value]');
        if (!hidden || !hidden.value) {
            return;
        }
    };
    window.cmsPageWebsiteOnSelect = function (item) {
        syncCodeFromItem(item || null);
    };
    syncCodeFromItem(null);
})();
</script>
