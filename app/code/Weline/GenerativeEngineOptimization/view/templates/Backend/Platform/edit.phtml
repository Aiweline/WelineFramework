<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Geo\Model\Platform $platform
 * @var array $platform_catalog
 * @var array $used_platform_codes
 */
$catalog = $platform_catalog ?? [];
$usedCodes = $used_platform_codes ?? [];
$isNew = !(bool)$platform->getId();
$currentCode = (string)($platform->getData('platform_code') ?? '');
$currentFormat = (string)($platform->getData('feed_format') ?? 'json_feed');
if ($currentFormat === '') {
    $currentFormat = 'json_feed';
}

$platformOptions = [];
foreach ($catalog as $code => $meta) {
    $label = (string)(($meta['name'] ?? $code) . ' (' . $code . ')');
    if ($isNew && !empty($usedCodes[$code])) {
        $label .= ' — ' . __('已配置');
    }
    $platformOptions[] = [
        'value' => (string)$code,
        'label' => $label,
    ];
}
$platformOptionsJson = (string)(json_encode($platformOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');

$formatOptions = [
    ['value' => 'json_feed', 'label' => 'JSON Feed'],
    ['value' => 'xml', 'label' => 'XML'],
    ['value' => 'rss', 'label' => 'RSS'],
];
$formatOptionsJson = (string)(json_encode($formatOptions, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
?>
<div class="content-body">
    <p class="w-text" data-tone="muted" style="--w-mb:var(--weline-space-4);">
        <?= __('选择内置平台后会自动填入官方推送地址与内容源格式。API 密钥请到「平台账户」配置；当前不支持一键 OAuth 授权。') ?>
    </p>
    <w:form id="platform-form" class="form-horizontal">
        <input type="hidden" name="id" value="<?= $platform->getId() ?>">

        <div class="w-field">
            <label class="control-label"><?= __('平台') ?> <span class="required">*</span></label>
            <w:theme:search-select
                id="platform-code"
                name="platform_code"
                value="<?= htmlspecialchars($currentCode, ENT_QUOTES, 'UTF-8') ?>"
                options-json="<?= htmlspecialchars($platformOptionsJson, ENT_QUOTES, 'UTF-8') ?>"
                placeholder="<?= htmlspecialchars((string)__('请选择或搜索平台...'), ENT_QUOTES, 'UTF-8') ?>"
                required="true"
                clearable="<?= $isNew ? 'true' : 'false' ?>"
                disabled="<?= $isNew ? 'false' : 'true' ?>"
            />
            <?php if (!$isNew): ?>
                <small class="w-field__hint w-text" data-tone="muted"><?= __('平台代码保存后不可更改') ?></small>
            <?php elseif ($usedCodes !== []): ?>
                <small class="w-field__hint w-text" data-tone="muted"><?= __('标注「已配置」的平台再次保存会更新现有记录') ?></small>
            <?php endif; ?>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('平台名称') ?> <span class="required">*</span></label>
            <input type="text" name="platform_name" id="platform-name" class="w-input" value="<?= htmlspecialchars($platform->getData('platform_name') ?? '') ?>" required>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('推送 API 地址') ?></label>
            <input type="text" name="api_endpoint" id="api-endpoint" class="w-input" value="<?= htmlspecialchars($platform->getData('api_endpoint') ?? '') ?>" placeholder="<?= htmlspecialchars(__('选择平台后自动填入')) ?>" readonly>
            <small class="w-field__hint w-text" data-tone="muted" id="endpoint-hint"><?= __('由内置适配器提供；一般无需手改。') ?></small>
            <label class="w-cluster" data-align="center" style="--w-mt:var(--weline-space-2);">
                <input type="checkbox" id="endpoint-override">
                <span class="w-text" data-tone="muted"><?= __('我要自定义推送地址') ?></span>
            </label>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('内容源格式') ?></label>
            <w:theme:search-select
                id="feed-format"
                name="feed_format"
                value="<?= htmlspecialchars($currentFormat, ENT_QUOTES, 'UTF-8') ?>"
                options-json="<?= htmlspecialchars($formatOptionsJson, ENT_QUOTES, 'UTF-8') ?>"
                placeholder="<?= htmlspecialchars((string)__('请选择内容源格式...'), ENT_QUOTES, 'UTF-8') ?>"
                required="true"
                clearable="false"
            />
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('是否启用') ?></label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="is_enabled" value="1" <?= $platform->getData('is_enabled') ? 'checked' : '' ?>>
                    <?= __('启用') ?>
                </label>
            </div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('高级配置（JSON）') ?></label>
            <textarea name="config" id="platform-config" class="w-textarea" rows="4"><?= htmlspecialchars($platform->getData('config') ?? '{}') ?></textarea>
            <small class="w-field__hint w-text" data-tone="muted" id="auth-hint"><?= __('密钥不写在这里。保存平台后，请到该平台的「账户」里填写 API Key。') ?></small>
        </div>

        <div class="w-field">
            <button type="submit" class="w-button" data-tone="primary">
                <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?>
            </button>
            <a href="@url{'geo/backend/platform'}" class="w-button" data-tone="neutral">
                <?= __('取消') ?>
            </a>
        </div>
    </w:form>
</div>

<script>
(function () {
    var catalog = <?= json_encode($catalog, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?> || {};
    var formatLabels = { json_feed: 'JSON Feed', xml: 'XML', rss: 'RSS' };
    var codeEl = document.getElementById('platform-code_value');
    var nameEl = document.getElementById('platform-name');
    var endpointEl = document.getElementById('api-endpoint');
    var formatEl = document.getElementById('feed-format_value');
    var configEl = document.getElementById('platform-config');
    var authHintEl = document.getElementById('auth-hint');
    var overrideEl = document.getElementById('endpoint-override');
    var isNew = <?= $isNew ? 'true' : 'false' ?>;

    function setSearchSelectValue(id, value, label) {
        var hidden = document.getElementById(id + '_value');
        var display = document.getElementById(id + '_display');
        var container = document.getElementById(id + '_container');
        if (!hidden) {
            return;
        }
        hidden.value = value || '';
        if (display) {
            display.textContent = label || value || '';
            display.style.display = '';
        }
        if (container) {
            container.classList.toggle('has-value', !!(value || ''));
        }
        hidden.dispatchEvent(new Event('input', { bubbles: true }));
        hidden.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function applyPreset(code, force) {
        var meta = catalog[code];
        if (!meta) {
            return;
        }
        if (force || !nameEl.value) {
            nameEl.value = meta.name || code;
        }
        if (force || overrideEl.checked === false) {
            endpointEl.value = meta.api_endpoint || '';
        }
        if (force || !(formatEl && formatEl.value)) {
            var fmt = meta.feed_format || 'json_feed';
            setSearchSelectValue('feed-format', fmt, formatLabels[fmt] || fmt);
        }
        if (force && (!configEl.value || configEl.value === '{}')) {
            configEl.value = meta.config_default || '{}';
        }
        if (authHintEl && meta.auth_hint) {
            authHintEl.textContent = meta.auth_hint;
        }
    }

    if (codeEl) {
        codeEl.addEventListener('change', function () {
            applyPreset(codeEl.value, true);
        });
        if (codeEl.value) {
            applyPreset(codeEl.value, isNew);
        }
    }

    if (overrideEl && endpointEl) {
        overrideEl.addEventListener('change', function () {
            endpointEl.readOnly = !overrideEl.checked;
            if (!overrideEl.checked && codeEl && codeEl.value) {
                applyPreset(codeEl.value, true);
            }
        });
    }

    document.getElementById('platform-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        var url = '@url{'geo/backend/platform/save'}';
        var opts = { method: 'POST', body: formData };
        Weline.adminRequest('geo', url, opts)
            .then(function (res) {
                var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
                    ? Weline.ApiBusiness.unwrapBusiness(res)
                    : res;
                if (data && data.success) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: '<?= __('Success') ?>',
                        message: data.message || '<?= __('Saved successfully') ?>',
                        duration: 2000,
                        confirmable: false
                    }).then(function () {
                        window.location.href = '@url{'geo/backend/platform'}';
                    });
                } else {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: '<?= __('保存失败') ?>',
                        message: (data && data.message) || '<?= __('保存失败') ?>',
                        confirmLabel: '<?= __('确定') ?>'
                    });
                }
            })
            .catch(function (error) {
                var detail = (error && (error.message || error.error && error.error.message)) || '';
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: '<?= __('保存失败') ?>',
                    message: detail || '<?= __('请重试') ?>',
                    confirmLabel: '<?= __('确定') ?>'
                });
            });
    });
})();
</script>
