<script>
(function() {
    'use strict';

    const errorTitle = <?= json_encode((string)__('错误信息'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    const confirmText = <?= json_encode((string)__('确定'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    const retryOkTitle = <?= json_encode((string)__('重试结果'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    const retryFailTitle = <?= json_encode((string)__('重试失败'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;

    document.querySelectorAll('[data-geo-error-message]').forEach(function(button) {
        button.addEventListener('click', function() {
            const message = button.getAttribute('data-geo-error-message') || '';
            Weline.UI.dialog.request({tone: 'danger', title: errorTitle, message: message, confirmLabel: confirmText});
        });
    });

    document.querySelectorAll('[data-geo-retry-log]').forEach(function(button) {
        button.addEventListener('click', function() {
            const logId = button.getAttribute('data-geo-retry-log') || '';
            if (!logId) {
                return;
            }
            button.disabled = true;
            const body = new FormData();
            body.set('log_id', logId);
            Weline.adminRequest('geo', '@url{'geo/backend/push/execute'}', { method: 'POST', body: body })
                .then(function(res) {
                    var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
                        ? Weline.ApiBusiness.unwrapBusiness(res)
                        : res;
                    var message = String((data && data.message) || '');
                    if (data && data.success) {
                        Weline.UI.dialog.request({
                            tone: 'success',
                            title: retryOkTitle,
                            message: message,
                            confirmLabel: confirmText
                        });
                        setTimeout(function() { window.location.reload(); }, 800);
                        return;
                    }
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: retryFailTitle,
                        message: message || <?= json_encode((string)__('请检查平台账户后重试'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
                        confirmLabel: confirmText
                    });
                    button.disabled = false;
                })
                .catch(function(error) {
                    var message = '';
                    try {
                        if (error && error.response && error.response.data) {
                            var payload = error.response.data;
                            if (typeof payload === 'object' && payload.message) {
                                message = String(payload.message);
                            }
                        }
                    } catch (e) {}
                    if (!message && error && error.message) {
                        message = String(error.message);
                    }
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: retryFailTitle,
                        message: message || <?= json_encode((string)__('请检查平台账户后重试'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
                        confirmLabel: confirmText
                    });
                    button.disabled = false;
                });
        });
    });
})();
</script>
