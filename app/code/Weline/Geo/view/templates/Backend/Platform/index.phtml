<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var array $platforms
 */
?>
<div class="content-header">
    <h1><?= __('平台管理') ?></h1>
    <div class="action-bar">
        <a href="<?= $this->getUrl('geo/backend/platform/edit') ?>" class="w-button" data-tone="primary">
            <w:icon name="plus" size="sm"></w:icon> <?= __('添加平台') ?>
        </a>
    </div>
</div>

<div class="content-body">
    <table class="w-table">
        <thead>
            <tr>
                <th><?= __('ID') ?></th>
                <th><?= __('平台代码') ?></th>
                <th><?= __('平台名称') ?></th>
                <th><?= __('API端点') ?></th>
                <th><?= __('Feed格式') ?></th>
                <th><?= __('状态') ?></th>
                <th><?= __('操作') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php if (empty($platforms)): ?>
                <tr>
                    <td colspan="7" class="w-text" data-align="center"><?= __('暂无数据') ?></td>
                </tr>
            <?php else: ?>
                <?php foreach ($platforms as $platform): ?>
                    <tr>
                        <td><?= $platform['id'] ?></td>
                        <td><?= htmlspecialchars($platform['platform_code']) ?></td>
                        <td><?= htmlspecialchars($platform['platform_name']) ?></td>
                        <td><?= htmlspecialchars($platform['api_endpoint'] ?? '') ?></td>
                        <td><?= htmlspecialchars($platform['feed_format'] ?? 'json_feed') ?></td>
                        <td>
                            <?php if ($platform['is_enabled']): ?>
                                <span class="w-badge" data-tone="success"><?= __('启用') ?></span>
                            <?php else: ?>
                                <span class="w-badge" data-tone="muted"><?= __('禁用') ?></span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <a href="<?= $this->getUrl('geo/backend/platform/edit', ['id' => $platform['id']]) ?>" class="w-button" data-tone="primary" data-size="sm">
                                <w:icon name="edit" size="sm"></w:icon> <?= __('编辑') ?>
                            </a>
                            <a href="<?= $this->getUrl('geo/backend/platform/account', ['platform_id' => $platform['id']]) ?>" class="w-button" data-tone="info" data-size="sm">
                                <w:icon name="user" size="sm"></w:icon> <?= __('账户') ?>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            <?php endif; ?>
        </tbody>
    </table>
</div>
