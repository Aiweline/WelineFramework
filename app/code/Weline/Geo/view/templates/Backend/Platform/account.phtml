<script>
(function(g){
  if(g.__bqAdmin_geo) return;
  g.__bqAdmin_geo=true;
  g.bqAdmin=g.bqAdmin||{};
  g.bqAdmin['geo']=function(url, options){
    options=options||{};
    var body=options.body;
    if(body && typeof FormData!=='undefined' && body instanceof FormData){
      var p=new URLSearchParams(); body.forEach(function(v,k){ if(!(typeof File!=='undefined'&&v instanceof File)) p.append(k,String(v)); }); body=p.toString();
    } else if(body && typeof body!=='string'){ try{ body=JSON.stringify(body); }catch(e){ body=''; } }
    var run=function(api){ return api.resource('geo').adminRequest({url:url, method:options.method||'POST', headers:options.headers||{}, body:body||''}); };
    var toResp=function(data){
      var _biz=g.WelineApiBusiness||(g.Weline&&g.Weline.ApiBusiness);
      if(_biz&&typeof _biz.wrapAdminBridgeResult==='function'){
        return _biz.wrapAdminBridgeResult(data);
      }
      var body=(data&&typeof data==='object'&&!Array.isArray(data))?data:{success:true,data:data};
      var ok=!(body&&body.success===false);
      var resp={ok:ok,status:ok?200:400,json:function(){return Promise.resolve(body);},text:function(){return Promise.resolve(typeof body==='string'?body:JSON.stringify(body==null?{}:body));}};
      Object.keys(body).forEach(function(k){ if(k==='ok'||k==='json'||k==='text'||k==='status') return; resp[k]=body[k]; });
      return resp;
    };
    var p=(g.Weline&&g.Weline.load)?g.Weline.load('api').then(run):Promise.resolve(run(g.Weline.Api));
    return p.then(toResp);
  };
})(window);
</script>
<script>
function showAddAccountModal() {
    document.getElementById('addAccountModal').style.display = 'block';
}

function hideAddAccountModal() {
    document.getElementById('addAccountModal').style.display = 'none';
}

function testConnection(accountId) {
    const formData = new FormData();
    formData.append('account_id', accountId);
    
    var testUrl = '<?= $this->getUrl('geo/backend/platform/testConnection') ?>';
    var testOpts = { method: 'POST', body: formData };
    bqAdmin['geo'](testUrl, testOpts)
    .then(function(res) {
        var data = (res && res.data) !== undefined ? res.data : res;
        Weline.UI.dialog.request({
            tone: data.success ? 'success' : 'error',
            title: data.success ? '<?= __('测试成功') ?>' : '<?= __('测试失败') ?>',
            message: data.message,
            duration: data.success ? 2000 : 0,
            confirmable: !data.success
        });
        if (data.success) {
            location.reload();
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Weline.UI.dialog.request({
            tone: 'danger',
            title: '<?= __('测试失败') ?>',
            message: '<?= __('请重试') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    });
}

document.getElementById('account-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    var saveUrl = '<?= $this->getUrl('geo/backend/platform/saveAccount') ?>';
    var saveOpts = { method: 'POST', body: formData };
    bqAdmin['geo'](saveUrl, saveOpts)
    .then(function(res) {
        var data = (res && res.data) !== undefined ? res.data : res;
        if (data.success) {
            Weline.UI.dialog.request({
                tone: 'success',
                title: '<?= __('成功') ?>',
                message: '<?= __('保存成功') ?>',
                duration: 2000,
                confirmable: false
            }).then(() => location.reload());
        } else {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('保存失败') ?>',
                message: data.message || '<?= __('保存失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Weline.UI.dialog.request({
            tone: 'danger',
            title: '<?= __('保存失败') ?>',
            message: '<?= __('请重试') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    });
});

document.querySelectorAll('[data-geo-account-action]').forEach(function(button) {
    button.addEventListener('click', function() {
        if (button.getAttribute('data-geo-account-action') === 'show') {
            showAddAccountModal();
            return;
        }

        hideAddAccountModal();
    });
});

document.querySelectorAll('[data-geo-account-test]').forEach(function(button) {
    button.addEventListener('click', function() {
        testConnection(parseInt(button.getAttribute('data-geo-account-test') || '0', 10));
    });
});
</script>
