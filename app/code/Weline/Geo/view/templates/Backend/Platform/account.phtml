<script>
(function () {
    'use strict';

    var form = document.getElementById('geo-account-form');
    if (!form || form.dataset.geoBound === '1') {
        return;
    }
    form.dataset.geoBound = '1';

    var okTitle = <?= json_encode((string)__('保存成功'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var failTitle = <?= json_encode((string)__('保存失败'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var testOk = <?= json_encode((string)__('测试成功'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var testFail = <?= json_encode((string)__('测试失败'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var confirmText = <?= json_encode((string)__('确定'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var retryText = <?= json_encode((string)__('请重试'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var jsonNeedFile = <?= json_encode((string)__('请先上传服务账号 JSON 文件'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var jsonInvalid = <?= json_encode((string)__('不是有效的服务账号 JSON（需含 private_key 与 client_email）'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var jsonReadyPrefix = <?= json_encode((string)__('已载入'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var jsonEmpty = <?= json_encode((string)__('尚未选择文件'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;

    var apiKeyInput = document.getElementById('geo-account-api-key');
    var jsonFileInput = document.getElementById('geo-account-api-key-file');
    var jsonStatus = form.querySelector('[data-geo-json-status]');

    function setJsonStatus(text, tone) {
        if (!jsonStatus) {
            return;
        }
        jsonStatus.textContent = text;
        if (tone) {
            jsonStatus.setAttribute('data-tone', tone);
        }
    }

    if (jsonFileInput && apiKeyInput) {
        jsonFileInput.addEventListener('change', function () {
            var file = jsonFileInput.files && jsonFileInput.files[0];
            apiKeyInput.value = '';
            if (!file) {
                setJsonStatus(jsonEmpty, 'muted');
                return;
            }
            var reader = new FileReader();
            reader.onload = function () {
                var raw = String(reader.result || '');
                var parsed;
                try {
                    parsed = JSON.parse(raw);
                } catch (err) {
                    setJsonStatus(jsonInvalid, 'danger');
                    return;
                }
                if (!parsed || typeof parsed !== 'object' || !parsed.private_key || !parsed.client_email) {
                    setJsonStatus(jsonInvalid, 'danger');
                    return;
                }
                apiKeyInput.value = raw;
                var label = file.name + (parsed.client_email ? ' · ' + parsed.client_email : '');
                setJsonStatus(jsonReadyPrefix + '：' + label, 'success');
            };
            reader.onerror = function () {
                setJsonStatus(jsonInvalid, 'danger');
            };
            reader.readAsText(file);
        });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (jsonFileInput && apiKeyInput && !String(apiKeyInput.value || '').trim()) {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: failTitle,
                message: jsonNeedFile,
                confirmLabel: confirmText
            });
            return;
        }
        var body = new FormData(form);
        // file input 不入库，凭证已写入 api_key
        body.delete('api_key_file');
        Weline.adminRequest('geo', '@url{'geo/backend/platform/saveAccount'}', { method: 'POST', body: body })
            .then(function (res) {
                var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
                    ? Weline.ApiBusiness.unwrapBusiness(res)
                    : res;
                if (data && data.success) {
                    Weline.UI.dialog.request({
                        tone: 'success',
                        title: okTitle,
                        message: String(data.message || okTitle),
                        duration: 1600,
                        confirmable: false
                    }).then(function () { location.reload(); });
                    return;
                }
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: failTitle,
                    message: String((data && data.message) || failTitle),
                    confirmLabel: confirmText
                });
            })
            .catch(function () {
                Weline.UI.dialog.request({
                    tone: 'danger',
                    title: failTitle,
                    message: retryText,
                    confirmLabel: confirmText
                });
            });
    });

    document.querySelectorAll('[data-geo-account-test]').forEach(function (button) {
        button.addEventListener('click', function () {
            var accountId = parseInt(button.getAttribute('data-geo-account-test') || '0', 10);
            if (!accountId) {
                return;
            }
            var body = new FormData();
            body.append('account_id', String(accountId));
            Weline.adminRequest('geo', '@url{'geo/backend/platform/testConnection'}', { method: 'POST', body: body })
                .then(function (res) {
                    var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
                        ? Weline.ApiBusiness.unwrapBusiness(res)
                        : res;
                    var ok = !!(data && data.success);
                    Weline.UI.dialog.request({
                        tone: ok ? 'success' : 'danger',
                        title: ok ? testOk : testFail,
                        message: String((data && data.message) || (ok ? testOk : retryText)),
                        duration: ok ? 1600 : 0,
                        confirmable: !ok,
                        confirmLabel: confirmText
                    });
                    if (ok) {
                        setTimeout(function () { location.reload(); }, 900);
                    }
                })
                .catch(function () {
                    Weline.UI.dialog.request({
                        tone: 'danger',
                        title: testFail,
                        message: retryText,
                        confirmLabel: confirmText
                    });
                });
        });
    });
})();
</script>
