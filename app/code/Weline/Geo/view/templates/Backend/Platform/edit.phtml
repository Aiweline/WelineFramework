<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Geo\Model\Platform $platform
 * @var array $supported_platforms
 */
$isEdit = $platform->getId() > 0;
?>
<div class="content-header">
    <h1><?= $isEdit ? __('编辑平台') : __('添加平台') ?></h1>
</div>

<div class="content-body">
    <w:form id="platform-form" class="form-horizontal">
        <input type="hidden" name="id" value="<?= $platform->getId() ?>">
        
        <div class="w-field">
            <label class="control-label"><?= __('平台代码') ?> <span class="required">*</span></label>
            <select name="platform_code" class="w-input" required>
                <option value=""><?= __('请选择') ?></option>
                <?php foreach ($supported_platforms as $code): ?>
                    <option value="<?= $code ?>" <?= $platform->getData('platform_code') === $code ? 'selected' : '' ?>>
                        <?= htmlspecialchars($code) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('平台名称') ?> <span class="required">*</span></label>
            <input type="text" name="platform_name" class="w-input" value="<?= htmlspecialchars($platform->getData('platform_name') ?? '') ?>" required>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('API端点') ?></label>
            <input type="text" name="api_endpoint" class="w-input" value="<?= htmlspecialchars($platform->getData('api_endpoint') ?? '') ?>" placeholder="https://api.example.com/endpoint">
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('Feed格式') ?></label>
            <select name="feed_format" class="w-input">
                <option value="json_feed" <?= ($platform->getData('feed_format') ?? 'json_feed') === 'json_feed' ? 'selected' : '' ?>>
                    JSON Feed
                </option>
                <option value="xml" <?= ($platform->getData('feed_format') ?? '') === 'xml' ? 'selected' : '' ?>>
                    XML
                </option>
                <option value="rss" <?= ($platform->getData('feed_format') ?? '') === 'rss' ? 'selected' : '' ?>>
                    RSS
                </option>
            </select>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('是否启用') ?></label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="is_enabled" value="1" 
                           <?= $platform->getData('is_enabled') ? 'checked' : '' ?>>
                    <?= __('启用') ?>
                </label>
            </div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('配置（JSON）') ?></label>
            <textarea name="config" class="w-textarea" rows="5"><?= htmlspecialchars($platform->getData('config') ?? '{}') ?></textarea>
        </div>

        <div class="w-field">
            <button type="submit" class="w-button" data-tone="primary">
                <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?>
            </button>
            <a href="<?= $this->getUrl('geo/backend/platform') ?>" class="w-button" data-tone="neutral">
                <?= __('取消') ?>
            </a>
        </div>
    </w:form>
</div>



<script>
document.getElementById('platform-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    var url = '<?= $this->getUrl('geo/backend/platform/save') ?>';
    var opts = { method: 'POST', body: formData };
    Weline.adminRequest('geo', url, opts)
    .then(function(res) {
        var data = (res && res.data) !== undefined ? res.data : res;
        if (data.success) {
            Weline.UI.dialog.request({
                tone: 'success',
                title: '<?= __('成功') ?>',
                message: '<?= __('保存成功') ?>',
                duration: 2000,
                confirmable: false
            }).then(() => {
                window.location.href = '<?= $this->getUrl('geo/backend/platform') ?>';
            });
        } else {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('保存失败') ?>',
                message: data.message || '<?= __('保存失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Weline.UI.dialog.request({
            tone: 'danger',
            title: '<?= __('保存失败') ?>',
            message: '<?= __('请重试') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    });
});
</script>
