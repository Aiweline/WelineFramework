<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Geo\Model\Feed $feed
 * @var array $feed_types
 * @var array $source_types
 * @var array $update_frequencies
 */
$escape = static fn(mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$feedType = (string)($feed->getData('feed_type') ?? '');
$sourceType = (string)($feed->getData('source_type') ?? '');
$frequency = (string)($feed->getData('update_frequency') ?? '');
$feedTypeLabel = $feed_types[$feedType] ?? $feedType;
$sourceTypeLabel = $source_types[$sourceType] ?? $sourceType;
$frequencyLabel = $update_frequencies[$frequency] ?? $frequency;
$autoPush = (int)($feed->getData('is_auto_push') ?? 0) === 1;
?>
<div class="content-body">
    <p class="w-text" data-tone="muted" style="margin-bottom: var(--weline-theme-space-4, 1rem);">
        <?= __('内容源由系统自动维护，元数据不可修改；此处仅可开关是否启用。') ?>
    </p>

    <w:form id="feed-form" class="form-horizontal">
        <input type="hidden" name="id" value="<?= (int)$feed->getId() ?>">

        <div class="w-field">
            <label class="control-label"><?= __('Feed名称') ?></label>
            <div class="w-text"><?= $escape($feed->getData('feed_name') ?? '') ?></div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('Feed类型') ?></label>
            <div class="w-text"><?= $escape($feedTypeLabel) ?></div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('数据源类型') ?></label>
            <div class="w-text"><?= $escape($sourceTypeLabel) ?></div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('数据源配置（JSON）') ?></label>
            <pre class="w-text" data-tone="muted" style="white-space:pre-wrap;margin:0;"><?= $escape($feed->getData('source_config') ?? '{}') ?></pre>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('Feed URL') ?></label>
            <div class="w-text" data-truncate="true" title="<?= $escape($feed->getData('feed_url') ?? '') ?>"><?= $escape($feed->getData('feed_url') ?? '—') ?></div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('更新频率') ?></label>
            <div class="w-text"><?= $escape($frequencyLabel) ?></div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('自动推送') ?></label>
            <div class="w-text"><?= $autoPush ? __('是') : __('否') ?>
                <span class="w-text" data-tone="muted">（<?= __('由系统策略维护') ?>）</span>
            </div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('配置（JSON）') ?></label>
            <pre class="w-text" data-tone="muted" style="white-space:pre-wrap;margin:0;"><?= $escape($feed->getData('config') ?? '{}') ?></pre>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('是否启用') ?> <span class="required">*</span></label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="is_enabled" value="1"
                           <?= (int)($feed->getData('is_enabled') ?? 0) === 1 ? 'checked' : '' ?>>
                    <?= __('启用') ?>
                </label>
            </div>
        </div>

        <div class="w-field">
            <button type="submit" class="w-button" data-tone="primary">
                <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?>
            </button>
            <a href="@url{'geo/backend/feed'}" class="w-button" data-tone="neutral">
                <?= __('取消') ?>
            </a>
        </div>
    </w:form>
</div>

<script>
document.getElementById('feed-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(this);

    var feedUrl = '@url{'geo/backend/feed/save'}';
    var feedOpts = { method: 'POST', body: formData };
    Weline.adminRequest('geo', feedUrl, feedOpts)
    .then(function(res) {
        var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
            ? Weline.ApiBusiness.unwrapBusiness(res)
            : res;
        if (data.success) {
            Weline.UI.dialog.request({
                tone: 'success',
                title: '<?= __('Success') ?>',
                message: '<?= __('Saved successfully') ?>',
                duration: 2000,
                confirmable: false
            }).then(() => {
                window.location.href = '@url{'geo/backend/feed'}';
            });
        } else {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('保存失败') ?>',
                message: data.message || '<?= __('保存失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Weline.UI.dialog.request({
            tone: 'danger',
            title: '<?= __('保存失败') ?>',
            message: '<?= __('请重试') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    });
});
</script>
