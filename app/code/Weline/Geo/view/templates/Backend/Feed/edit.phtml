<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Geo\Model\Feed $feed
 * @var array $feed_types
 * @var array $source_types
 * @var array $update_frequencies
 */
$isEdit = $feed->getId() > 0;
?>
<div class="content-header">
    <h1><?= $isEdit ? __('编辑Feed') : __('添加Feed') ?></h1>
</div>

<div class="content-body">
    <w:form id="feed-form" class="form-horizontal">
        <input type="hidden" name="id" value="<?= $feed->getId() ?>">
        
        <div class="w-field">
            <label class="control-label"><?= __('Feed名称') ?> <span class="required">*</span></label>
            <input type="text" name="feed_name" class="w-input" value="<?= htmlspecialchars($feed->getData('feed_name') ?? '') ?>" required>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('Feed类型') ?></label>
            <select name="feed_type" class="w-input">
                <?php foreach ($feed_types as $value => $label): ?>
                    <option value="<?= $value ?>" 
                            <?= ($feed->getData('feed_type') ?? 'content') === $value ? 'selected' : '' ?>>
                        <?= htmlspecialchars($label) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('数据源类型') ?></label>
            <select name="source_type" class="w-input">
                <?php foreach ($source_types as $value => $label): ?>
                    <option value="<?= $value ?>" 
                            <?= ($feed->getData('source_type') ?? 'database') === $value ? 'selected' : '' ?>>
                        <?= htmlspecialchars($label) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('数据源配置（JSON）') ?></label>
            <textarea name="source_config" class="w-textarea" rows="5"><?= htmlspecialchars($feed->getData('source_config') ?? '{}') ?></textarea>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('Feed URL') ?></label>
            <input type="text" name="feed_url" class="w-input" value="<?= htmlspecialchars($feed->getData('feed_url') ?? '') ?>" placeholder="https://example.com/feed.json">
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('更新频率') ?></label>
            <select name="update_frequency" class="w-input">
                <?php foreach ($update_frequencies as $value => $label): ?>
                    <option value="<?= $value ?>" 
                            <?= ($feed->getData('update_frequency') ?? 'daily') === $value ? 'selected' : '' ?>>
                        <?= htmlspecialchars($label) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('自动推送') ?></label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="is_auto_push" value="1" 
                           <?= ($feed->getData('is_auto_push') !== 0 && $feed->getData('is_auto_push') !== null) || !$feed->getId() ? 'checked' : '' ?>>
                    <?= __('启用自动推送') ?>
                    <small class="w-text" data-tone="muted">（关闭后Cron任务将不再推送此Feed）</small>
                </label>
            </div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('是否启用') ?></label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="is_enabled" value="1" 
                           <?= $feed->getData('is_enabled') !== 0 ? 'checked' : '' ?>>
                    <?= __('启用') ?>
                </label>
            </div>
        </div>

        <div class="w-field">
            <label class="control-label"><?= __('配置（JSON）') ?></label>
            <textarea name="config" class="w-textarea" rows="5"><?= htmlspecialchars($feed->getData('config') ?? '{}') ?></textarea>
        </div>

        <div class="w-field">
            <button type="submit" class="w-button" data-tone="primary">
                <w:icon name="save" size="sm"></w:icon> <?= __('保存') ?>
            </button>
            <a href="<?= $this->getUrl('geo/backend/feed') ?>" class="w-button" data-tone="neutral">
                <?= __('取消') ?>
            </a>
        </div>
    </w:form>
</div>



<script>
document.getElementById('feed-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    var feedUrl = '<?= $this->getUrl('geo/backend/feed/save') ?>';
    var feedOpts = { method: 'POST', body: formData };
    Weline.adminRequest('geo', feedUrl, feedOpts)
    .then(function(res) {
        var data = (res && res.data) !== undefined ? res.data : res;
        if (data.success) {
            Weline.UI.dialog.request({
                tone: 'success',
                title: '<?= __('成功') ?>',
                message: '<?= __('保存成功') ?>',
                duration: 2000,
                confirmable: false
            }).then(() => {
                window.location.href = '<?= $this->getUrl('geo/backend/feed') ?>';
            });
        } else {
            Weline.UI.dialog.request({
                tone: 'danger',
                title: '<?= __('保存失败') ?>',
                message: data.message || '<?= __('保存失败') ?>',
                confirmLabel: '<?= __('确定') ?>'
            });
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Weline.UI.dialog.request({
            tone: 'danger',
            title: '<?= __('保存失败') ?>',
            message: '<?= __('请重试') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    });
});
</script>

