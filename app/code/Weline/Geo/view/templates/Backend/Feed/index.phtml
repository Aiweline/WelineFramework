<?php
/**
 * @var \Weline\Framework\View\Template $this
 * @var \Weline\Framework\DataObject\DataObject $feeds
 * @var \Weline\Framework\DataObject\DataObject $pagination
 */
?>
<div class="content-header">
    <p class="w-text" data-tone="muted"><?= __('内容源由系统自动维护；仅可开关是否启用，不可新建或改元数据。') ?></p>
</div>

<div class="content-body">
    <table class="w-table">
        <thead>
            <tr>
                <th><?= __('ID') ?></th>
                <th><?= __('Feed名称') ?></th>
                <th><?= __('Feed类型') ?></th>
                <th><?= __('数据源') ?></th>
                <th><?= __('更新频率') ?></th>
                <th><?= __('自动推送') ?></th>
                <th><?= __('状态') ?></th>
                <th><?= __('最后生成') ?></th>
                <th><?= __('操作') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php if (empty($feeds)): ?>
                <tr>
                    <td colspan="9" class="w-text" data-align="center"><?= __('暂无数据') ?></td>
                </tr>
            <?php else: ?>
                <?php foreach ($feeds as $feed): ?>
                    <tr>
                        <td><?= $feed['id'] ?></td>
                        <td><?= htmlspecialchars($feed['feed_name']) ?></td>
                        <td><?= htmlspecialchars($feed['feed_type']) ?></td>
                        <td><?= htmlspecialchars($feed['source_type']) ?></td>
                        <td><?= htmlspecialchars($feed['update_frequency']) ?></td>
                        <td>
                            <?php if ($feed['is_auto_push']): ?>
                                <span class="w-badge" data-tone="info"><?= __('是') ?></span>
                            <?php else: ?>
                                <span class="w-badge" data-tone="muted"><?= __('否') ?></span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php if ($feed['is_enabled']): ?>
                                <span class="w-badge" data-tone="success"><?= __('启用') ?></span>
                            <?php else: ?>
                                <span class="w-badge" data-tone="muted"><?= __('禁用') ?></span>
                            <?php endif; ?>
                        </td>
                        <td><?= $feed['last_generated_at'] ? date('Y-m-d H:i:s', $feed['last_generated_at']) : '-' ?></td>
                        <td>
                            <a href="@url{'geo/backend/feed/edit'|['id' => $feed['id']]}" class="w-button" data-tone="primary" data-size="sm">
                                <w:icon name="edit" size="sm"></w:icon> <?= __('启用设置') ?>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            <?php endif; ?>
        </tbody>
    </table>

    <?php if ($pagination && $pagination->getTotalPages() > 1): ?>
        <div class="w-pagination">
            <?= $this->getPaginationHtml($pagination) ?>
        </div>
    <?php endif; ?>
</div>
