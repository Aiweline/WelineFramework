                    <?php endforeach; ?>
                </div>
            </div>

            <div class="w-field">
                <button type="submit" class="w-button" data-tone="primary">
                    <w:icon name="arrow-right" size="sm"></w:icon> <?= __('开始推送') ?>
                </button>
                <a href="@url{'geo/backend/push'}" class="w-button" data-tone="neutral"><?= __('返回历史') ?></a>
            </div>
        </w:form>

        <div id="push-result" style="display: none; margin-top: var(--weline-theme-space-4, 1rem);"></div>
    <?php endif; ?>
</div>

<?php if (!empty($feeds) && !empty($platforms)): ?>
<script>
function renderPushResult(resultDiv, type, message) {
    if (!resultDiv) {
        return;
    }
    while (resultDiv.firstChild) {
        resultDiv.removeChild(resultDiv.firstChild);
    }
    var alert = document.createElement('div');
    alert.className = 'alert alert-' + type;
    alert.style.whiteSpace = 'pre-wrap';
    alert.textContent = message == null ? '' : String(message);
    resultDiv.appendChild(alert);
}

function collectPushDetail(payload) {
    if (!payload || typeof payload !== 'object') {
        return '';
    }
    var parts = [];
    if (payload.message) {
        parts.push(String(payload.message));
    }
    var results = [];
    if (payload.data && Array.isArray(payload.data.results)) {
        results = payload.data.results;
    } else if (Array.isArray(payload.results)) {
        results = payload.results;
    }
    results.forEach(function(result) {
        if (!result || result.success !== false) {
            return;
        }
        var name = result.platform_name || (result.platform_id != null ? ('#' + result.platform_id) : '');
        var reason = String(result.message || '').trim();
        if (!reason) {
            return;
        }
        var line = name ? (name + ': ' + reason) : reason;
        var covered = parts.some(function(part) {
            return part === line || part === reason || String(part).indexOf(line) !== -1;
        });
        if (!covered) {
            parts.push(line);
        }
    });
    return parts.join('\n');
}

function describePushFailure(error) {
    var fallback = <?= json_encode((string)__('请重试。若持续失败，请检查平台账户密钥与推送地址。'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var top = error && error.response ? error.response.data : null;
    var fromTop = collectPushDetail(top);
    if (fromTop) {
        return fromTop;
    }
    if (window.Weline && Weline.ApiBusiness) {
        if (typeof Weline.ApiBusiness.businessPayload === 'function') {
            var business = Weline.ApiBusiness.businessPayload(error);
            // businessPayload may return nested data{} without message; merge top message.
            if (business && typeof business === 'object') {
                var merged = Object.assign({}, business);
                if (!merged.message && top && top.message) {
                    merged.message = top.message;
                }
                if (!merged.results && top && top.data && Array.isArray(top.data.results)) {
                    merged.results = top.data.results;
                }
                var fromBusiness = collectPushDetail(merged);
                if (fromBusiness) {
                    return fromBusiness;
                }
            }
        }
        if (typeof Weline.ApiBusiness.formatApiError === 'function') {
            var formatted = String(Weline.ApiBusiness.formatApiError(error, '') || '').trim();
            if (formatted && formatted !== 'Request failed.' && formatted !== 'Business error') {
                return formatted;
            }
        }
    }
    if (error && error.message && !/^(Request failed\.?|Business error|Failed to fetch)$/i.test(String(error.message))) {
        return String(error.message);
    }
    return fallback;
}

function showPushFailure(detail) {
    Weline.UI.dialog.request({
        tone: 'danger',
        title: <?= json_encode((string)__('推送失败'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
        message: detail || <?= json_encode((string)__('请重试。若持续失败，请检查平台账户密钥与推送地址。'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
        confirmLabel: <?= json_encode((string)__('确定'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>
    });
}

document.getElementById('push-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const platformIds = Array.from(document.querySelectorAll('input[name="platform_ids[]"]:checked'))
        .map(function(input) { return input.value; });

    if (!formData.get('feed_id') || platformIds.length === 0) {
        Weline.UI.dialog.request({
            tone: 'warning',
            title: <?= json_encode((string)__('提示'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
            message: <?= json_encode((string)__('请选择内容源和至少一个平台'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
            confirmLabel: <?= json_encode((string)__('确定'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>
        });
        return;
    }

    formData.set('platform_ids', JSON.stringify(platformIds));

    var geoPushUrl = '@url{'geo/backend/push/execute'}';
    var geoPushOpts = { method: 'POST', body: formData };
    Weline.adminRequest('geo', geoPushUrl, geoPushOpts)
    .then(function(res) {
        var data = (window.Weline && Weline.ApiBusiness && typeof Weline.ApiBusiness.unwrapBusiness === 'function')
            ? Weline.ApiBusiness.unwrapBusiness(res)
            : res;
        var resultDiv = document.getElementById('push-result');
        resultDiv.style.display = 'block';
        var detail = collectPushDetail(data) || String(data && data.message || '');

        if (data && data.success) {
            renderPushResult(resultDiv, 'success', detail || data.message);
            setTimeout(function() {
                window.location.href = '@url{'geo/backend/push'}';
            }, 1200);
            return;
        }

        renderPushResult(resultDiv, 'danger', detail);
        showPushFailure(detail);
    })
    .catch(function(error) {
        console.error('Error:', error);
        var detail = describePushFailure(error);
        var resultDiv = document.getElementById('push-result');
        if (resultDiv) {
            resultDiv.style.display = 'block';
            renderPushResult(resultDiv, 'danger', detail);
        }
        showPushFailure(detail);
    });
});
</script>
<?php endif; ?>
