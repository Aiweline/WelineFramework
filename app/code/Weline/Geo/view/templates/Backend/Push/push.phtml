?>
<div class="content-body">
    <p class="w-text" data-tone="muted" style="margin-bottom: var(--weline-theme-space-4, 1rem);">
        <?= __('此页仅人工立即推送。定时推送请回到「推送管理」用统一配置开关开启（每天一次）。') ?>
    </p>

    <?php if (empty($feeds) || empty($platforms)): ?>
        <div class="w-stack" data-gap="sm" style="padding: var(--weline-theme-space-4, 1rem) 0;">
            <?php if (empty($feeds)): ?>
                <div class="w-text"><?= __('没有已启用的内容源。请先到内容源管理开启。') ?></div>
                <a href="@url{'geo/backend/feed'}" class="w-button" data-tone="primary" data-size="sm"><?= __('内容源管理') ?></a>
            <?php endif; ?>
            <?php if (empty($platforms)): ?>
                <div class="w-text"><?= __('没有已启用的平台。请先添加平台并在「账户」中配置密钥。') ?></div>
                <a href="@url{'geo/backend/platform'}" class="w-button" data-tone="primary" data-size="sm"><?= __('平台管理') ?></a>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <w:form id="push-form" class="form-horizontal">
            <div class="w-field">
                <label class="control-label"><?= __('选择内容源') ?></label>
                <select name="feed_id" class="w-input" required>
                    <option value=""><?= __('请选择内容源') ?></option>
                    <?php foreach ($feeds as $feed): ?>
                        <option value="<?= (int)$feed['id'] ?>"><?= $escape($feed['feed_name'] ?? '') ?></option>
                    <?php endforeach; ?>
                </select>
