                    <?php foreach ($platforms as $platform): ?>
                        <label class="checkbox-inline">
                            <input type="checkbox" name="platform_ids[]" value="<?= (int)$platform['id'] ?>">
                            <?= $escape($platform['platform_name'] ?? '') ?>
