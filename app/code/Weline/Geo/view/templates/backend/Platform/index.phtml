        </p>
        <a href="@url{'geo/backend/platform/edit'}" class="w-button" data-tone="primary" data-shrink="false">
            <w:icon name="plus" size="sm"></w:icon> <?= __('添加平台') ?>
        </a>
    </div>
</div>

<div class="content-body">
    <div class="w-table-wrap">
        <table class="w-table">
            <thead>
                <tr>
                    <th><?= __('平台') ?></th>
                    <th><?= __('代码') ?></th>
                    <th><?= __('格式') ?></th>
                    <th><?= __('状态') ?></th>
                    <th><?= __('操作') ?></th>
                </tr>
            </thead>
            <tbody>
