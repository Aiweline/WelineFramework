                                <div>
                                    <a href="@url{'geo/backend/platform/edit'}" class="w-button" data-tone="primary" data-size="sm" data-shrink="false">
                                        <w:icon name="plus" size="sm"></w:icon> <?= __('添加平台') ?>
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                <?php else: ?>
                    <?php foreach ($platforms as $platform): ?>
                        <?php
                        $id = (int)($platform['id'] ?? 0);
                        $code = (string)($platform['platform_code'] ?? '');
                        $name = (string)($platform['platform_name'] ?? '');
                        $format = (string)($platform['feed_format'] ?? 'json_feed');
                        $enabled = !empty($platform['is_enabled']);
                        ?>
                        <tr>
                            <td>
                                <span class="w-text" data-truncate="true" title="<?= $escape($name) ?>" style="font-weight:600;"><?= $escape($name !== '' ? $name : ('#' . $id)) ?></span>
                            </td>
                            <td><code class="w-text" data-truncate="true"><?= $escape($code) ?></code></td>
                            <td><span class="w-text" data-truncate="true"><?= $escape($format) ?></span></td>
                            <td>
                                <?php if ($enabled): ?>
                                    <span class="w-badge" data-tone="success" data-shrink="false"><?= __('启用') ?></span>
                                <?php else: ?>
                                    <span class="w-badge" data-tone="muted" data-shrink="false"><?= __('禁用') ?></span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <div class="w-cluster" data-align="center" data-wrap="false" style="--w-gap:var(--weline-space-2);">
