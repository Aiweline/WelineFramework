<?php
/**
 * @hook-priority 100
 * @hook-sort-order 20
 */

use Weline\Framework\Manager\ObjectManager;
use Weline\Geo\Model\Feed;
use Weline\Geo\Model\WebsiteProtocolConfig;

$website = (array)($this->getData('website') ?? []);
$hasWebsiteIdentity = array_key_exists('website_id', $website) || array_key_exists('id', $website);
$websiteId = $hasWebsiteIdentity ? (int)($website['website_id'] ?? $website['id']) : -1;
$hookId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('id') ?? 'website'));
if (!is_string($hookId) || $hookId === '' || preg_match('/^[A-Za-z_]/D', $hookId) !== 1) {
    $hookId = 'website_' . (is_string($hookId) ? $hookId : '');
}
$accordionParentId = preg_replace('/[^\w\-]+/', '_', (string)($this->getData('accordion_parent_id') ?? 'websiteFormAccordion'));
$sectionId = $hookId . '_geo_protocol';
$llmsFieldId = $sectionId . '_llms_enabled';
$feedEnabledFieldId = $sectionId . '_feed_enabled';
$autoPushFieldId = $sectionId . '_auto_push';
$feedIdFieldId = $sectionId . '_feed_id';
$llmsIntroFieldId = $sectionId . '_llms_intro';

$llmsEnabled = true;
$feedEnabled = true;
$autoPush = true;
$feedId = 0;
$llmsIntro = '';
$feeds = [];

try {
    if ($hasWebsiteIdentity && $websiteId >= 0) {
        /** @var WebsiteProtocolConfig $protocolConfig */
        $protocolConfig = ObjectManager::getInstance(WebsiteProtocolConfig::class)->loadByWebsiteId($websiteId);
        $llmsEnabled = $protocolConfig->isLlmsEnabled();
        $feedEnabled = $protocolConfig->isFeedEnabled();
        $autoPush = $protocolConfig->isAutoPushEnabled();
        $feedId = $protocolConfig->getFeedId();
        $llmsIntro = $protocolConfig->getLlmsIntro();
    }

    /** @var Feed $feedModel */
    $feedModel = ObjectManager::getInstance(Feed::class);
    $feeds = $feedModel->reset()
        ->order(Feed::schema_fields_ID, 'ASC')
        ->select()
        ->fetchArray();
} catch (\Throwable) {
    $feeds = [];
}
?>
<div class="w-disclosure" data-w-component="disclosure">
    <div id="<?= htmlspecialchars($sectionId . '_heading', ENT_QUOTES, 'UTF-8') ?>">
        <button class="w-disclosure__trigger collapsed" type="button" aria-expanded="false" aria-controls="<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" data-w-target="#<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" data-w-action="disclosure.toggle" data-w-disclosure-trigger>
            <w:icon name="robot" size="sm"></w:icon>
            <span><lang>GEO 协议与 AI 搜索发现</lang></span>
            <w:icon name="chevron-down" size="sm"></w:icon>
        </button>
    </div>
    <div id="<?= htmlspecialchars($sectionId . '_body', ENT_QUOTES, 'UTF-8') ?>" class="w-disclosure__panel" aria-labelledby="<?= htmlspecialchars($sectionId . '_heading', ENT_QUOTES, 'UTF-8') ?>" data-w-disclosure-panel hidden>
        <div class="w-disclosure__body">
            <div class="w-grid">
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>llms.txt / ai.txt</lang></label>
                    <input type="hidden" name="extensions[geo][llms_enabled]" value="0">
                    <div class="w-switch" style="--w-mt:var(--weline-space-2);">
                        <input type="checkbox" id="<?= htmlspecialchars($llmsFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[geo][llms_enabled]" value="1" <?= $llmsEnabled ? 'checked' : '' ?>>
                        <label for="<?= htmlspecialchars($llmsFieldId, ENT_QUOTES, 'UTF-8') ?>"><lang>启用 AI 搜索发现文件</lang></label>
                    </div>
                </div>
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>GEO Feed</lang></label>
                    <input type="hidden" name="extensions[geo][feed_enabled]" value="0">
                    <div class="w-switch" style="--w-mt:var(--weline-space-2);">
                        <input type="checkbox" id="<?= htmlspecialchars($feedEnabledFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[geo][feed_enabled]" value="1" <?= $feedEnabled ? 'checked' : '' ?>>
                        <label for="<?= htmlspecialchars($feedEnabledFieldId, ENT_QUOTES, 'UTF-8') ?>"><lang>启用 JSON Feed / RSS Feed</lang></label>
                    </div>
                </div>
                <div style="--w-span:4;--w-mb:var(--weline-space-4);">
                    <label class="w-field__label"><lang>自动推送</lang></label>
                    <input type="hidden" name="extensions[geo][auto_push]" value="0">
                    <div class="w-switch" style="--w-mt:var(--weline-space-2);">
                        <input type="checkbox" id="<?= htmlspecialchars($autoPushFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[geo][auto_push]" value="1" <?= $autoPush ? 'checked' : '' ?>>
                        <label for="<?= htmlspecialchars($autoPushFieldId, ENT_QUOTES, 'UTF-8') ?>"><lang>内容更新后由 Weline_Geo 自动处理推送</lang></label>
                    </div>
                </div>
                <div style="--w-span:6;--w-mb:var(--weline-space-4);">
                    <label for="<?= htmlspecialchars($feedIdFieldId, ENT_QUOTES, 'UTF-8') ?>" class="w-field__label"><lang>站点 GEO Feed</lang></label>
                    <select class="w-select" id="<?= htmlspecialchars($feedIdFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[geo][feed_id]">
                        <option value="0"><lang>使用第一个启用 Feed</lang></option>
                        <?php foreach ($feeds as $feed): ?>
                            <?php
                            $id = (int)($feed[Feed::schema_fields_ID] ?? 0);
                            $name = (string)($feed[Feed::schema_fields_FEED_NAME] ?? ('Feed #' . $id));
                            ?>
                            <option value="<?= $id ?>" <?= $feedId === $id ? 'selected' : '' ?>>
                                <?= htmlspecialchars($name, ENT_QUOTES, 'UTF-8') ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div style="--w-span:6;--w-mb:var(--weline-space-4);">
                    <label for="<?= htmlspecialchars($llmsIntroFieldId, ENT_QUOTES, 'UTF-8') ?>" class="w-field__label"><lang>llms.txt 站点说明</lang></label>
                    <textarea class="w-textarea" id="<?= htmlspecialchars($llmsIntroFieldId, ENT_QUOTES, 'UTF-8') ?>" name="extensions[geo][llms_intro]" rows="4" placeholder="A concise site description for AI agents."><?= htmlspecialchars($llmsIntro, ENT_QUOTES, 'UTF-8') ?></textarea>
                    <div class="w-field__hint"><lang>留空时由 Weline_Geo 使用站点名称和默认说明自动生成。</lang></div>
                </div>
            </div>
        </div>
    </div>
</div>
