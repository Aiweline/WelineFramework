<?php
$developers = is_iterable($developers ?? null) ? $developers : [];
$totalBalance = (float)($total_balance ?? 0);
$totalEarnings = (float)($total_earnings ?? 0);
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<div class="w-container" style="--w-pt:var(--weline-space-4);--w-pb:var(--weline-space-4);">
    <h1 class="h4" style="--w-mb:var(--weline-space-1);"><?= __('收益管理') ?></h1>
    <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-4);"><?= __('按开发者汇总余额与累计收益。') ?></div>
    <div class="w-grid" style="--w-gap:var(--weline-space-4);--w-mb:var(--weline-space-4);">
        <div style="--w-span:12;--w-span-md:6;">
            <div class="w-card"><div class="w-card__body">
                <div class="w-text" data-tone="muted" data-size="sm"><?= __('余额合计') ?></div>
                <div class="display-6" style="--w-mb:0;"><?= $escape(number_format($totalBalance, 2)) ?></div>
            </div></div>
        </div>
        <div style="--w-span:12;--w-span-md:6;">
            <div class="w-card"><div class="w-card__body">
                <div class="w-text" data-tone="muted" data-size="sm"><?= __('累计收益') ?></div>
                <div class="display-6" style="--w-mb:0;"><?= $escape(number_format($totalEarnings, 2)) ?></div>
            </div></div>
        </div>
    </div>
    <?php if (!$developers): ?>
        <div class="w-card"><div class="w-card__body w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-10);--w-pb:var(--weline-space-10);"><?= __('暂无收益数据。') ?></div></div>
    <?php else: ?>
        <div class="w-table-wrap">
            <table class="w-table">
                <thead><tr><th><?= __('开发者') ?></th><th><?= __('余额') ?></th><th><?= __('累计收益') ?></th></tr></thead>
                <tbody>
                <?php foreach ($developers as $row): if (!is_array($row)) continue; ?>
                    <tr>
                        <td><?= $escape($row['name'] ?? '') ?></td>
                        <td><?= $escape(number_format((float)($row['balance'] ?? 0), 2)) ?></td>
                        <td><?= $escape(number_format((float)($row['total_earnings'] ?? 0), 2)) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
