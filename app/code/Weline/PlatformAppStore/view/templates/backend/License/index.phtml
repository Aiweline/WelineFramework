<?php
$licenses = is_iterable($licenses ?? null) ? $licenses : [];
$total = (int)($total ?? 0);
$escape = static fn($v): string => htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
<div class="w-container" style="--w-pt:var(--weline-space-4);--w-pb:var(--weline-space-4);">
    <h1 class="h4" style="--w-mb:var(--weline-space-1);"><?= __('许可证管理') ?></h1>
    <div class="w-text" data-tone="muted" data-size="sm" style="--w-mb:var(--weline-space-4);"><?= __('共 %{1} 条许可证。', [$total]) ?></div>
    <?php if (!$licenses): ?>
        <div class="w-card"><div class="w-card__body w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-10);--w-pb:var(--weline-space-10);"><?= __('暂无许可证。') ?></div></div>
    <?php else: ?>
        <div class="w-table-wrap">
            <table class="w-table">
                <thead><tr><th>ID</th><th><?= __('许可证 Key') ?></th><th><?= __('模块ID') ?></th><th><?= __('域名') ?></th><th><?= __('状态') ?></th></tr></thead>
                <tbody>
                <?php foreach ($licenses as $row): if (!is_array($row)) continue; ?>
                    <tr>
                        <td><?= (int)($row['license_id'] ?? 0) ?></td>
                        <td><code><?= $escape($row['license_key'] ?? '') ?></code></td>
                        <td><?= (int)($row['module_id'] ?? 0) ?></td>
                        <td><?= $escape($row['domain'] ?? '') ?></td>
                        <td><?= $escape($row['status'] ?? '') ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
