        <p><lang>该 Scope 近期无慢请求</lang></p>
    <?php else: ?>
        <table class="w-table">
            <thead>
            <tr>
                <th><lang>时间</lang></th><th>q</th><th>type</th><th>engine</th>
                <th>elapsed_ms</th><th>hit_count</th><th>reason</th>
            </tr>
            </thead>
            <tbody>
            <?php foreach (($slow['items'] ?? []) as $row): ?>
                <tr>
                    <td><?= $esc((string)($row['created_at'] ?? '')) ?></td>
                    <td><?= $esc((string)($row['q'] ?? '')) ?></td>
                    <td><?= $esc((string)($row['type'] ?? '')) ?></td>
                    <td><?= $esc((string)($row['engine'] ?? '')) ?></td>
                    <td><?= (int)($row['elapsed_ms'] ?? 0) ?></td>
                    <td><?= (int)($row['hit_count'] ?? 0) ?></td>
                    <td><?= $esc((string)($row['reason'] ?? '')) ?></td>
                </tr>
