<?php
/** @var array<string,mixed> $slow */
/** @var string $range */
/** @var int $threshold_ms */
$slow = is_array($this->getData('slow') ?? null) ? $this->getData('slow') : [];
$esc = static fn (mixed $v): string => htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8');
?>
<div class="search-admin-slowlog" id="search-slowlog-root">
    <h1><lang>搜索管理 · 性能慢日志</lang></h1>
    <w:scope url="@backend-url('backend/user-data')" container-id="search-slowlog-root" event="input change click"/>
    <form method="get" class="search-admin-slowlog__filters">
        <p><lang>阈值</lang>: ≥ <?= (int)$threshold_ms ?>ms</p>
        <label><lang>时间</lang>
            <select name="range">
                <option value="24h"<?= $range === '24h' ? ' selected' : '' ?>><lang>近 24h</lang></option>
                <option value="7d"<?= $range === '7d' ? ' selected' : '' ?>><lang>近 7 天</lang></option>
                <option value="30d"<?= $range === '30d' ? ' selected' : '' ?>><lang>近 30 天</lang></option>
            </select>
        </label>
        <button type="submit"><lang>刷新</lang></button>
    </form>
    <div class="search-admin-slowlog__cards">
        <div class="w-card"><div class="w-card__body"><strong><lang>慢请求数</lang></strong><div><?= (int)($slow['slow_count'] ?? 0) ?></div></div></div>
        <div class="w-card"><div class="w-card__body"><strong>P95 ms</strong><div><?= (int)($slow['p95_ms'] ?? 0) ?></div></div></div>
        <div class="w-card"><div class="w-card__body"><strong><lang>最慢 ms</lang></strong><div><?= (int)($slow['max_ms'] ?? 0) ?></div></div></div>
    </div>
    <h2><lang>耗时分布</lang></h2>
    <ul>
        <?php $b = $slow['buckets'] ?? []; ?>
        <li>0-100: <?= (int)($b['0_100'] ?? 0) ?></li>
        <li>100-200: <?= (int)($b['100_200'] ?? 0) ?></li>
        <li>200-500: <?= (int)($b['200_500'] ?? 0) ?></li>
        <li>500+: <?= (int)($b['500_plus'] ?? 0) ?></li>
    </ul>
    <h2><lang>慢请求列表</lang></h2>
