<?php
$code = (string)($this->getData('workspace_code') ?? 'unknown');
$title = (string)($this->getData('workspace_title') ?? __('搜索管理'));
$status = (array)($this->getData('workspace_status') ?? []);
$datasets = (array)($this->getData('workspace_datasets') ?? []);
$configurationForm = $this->getData('workspace_config_form');
$configurationForm = is_array($configurationForm) ? $configurationForm : null;
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$display = static function (mixed $value) use ($escape): string {
    if (is_bool($value)) return $value ? (string)__('是') : (string)__('否');
    if (is_array($value)) return $escape(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[]');
    return $escape($value);
};
?>
<section class="commerce-control-center" data-testid="search-<?= $escape($code) ?>-management" data-workspace="<?= $escape($code) ?>">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between"><h4 class="mb-sm-0"><?= $escape($title) ?></h4><span class="badge <?= $configurationForm === null ? 'bg-info text-dark' : 'bg-primary' ?>"><?= $configurationForm === null ? __('只读诊断') : __('配置管理') ?></span></div>
    <div class="alert alert-info" role="status"><?= $configurationForm === null
            ? __('此页面只读取当前索引事实；重建、迁移和生产切流仍只能通过受控 CLI 执行。')
            : __('后台只允许切换安全的关闭或影子模式；生产启用、白名单和迁移操作仍只能通过受控 CLI 执行。') ?></div>
    <?php if ($configurationForm !== null): ?>
        <div class="card mb-3" data-testid="search-config-form">
            <div class="card-header"><h5 class="mb-0"><?= __('运行模式') ?></h5></div>
            <div class="card-body">
                <?php if (!empty($configurationForm['env_locked'])): ?>
                    <div class="alert alert-warning mb-0" data-testid="search-config-env-locked"><?= __('当前配置由环境变量锁定，后台不可修改。') ?></div>
                <?php else: ?>
                    <w:form method="post" action="@backend-url('search/backend/controlcenter/config')">
                        <label class="form-label" for="search-rollout-mode"><?= __('搜索运行模式') ?></label>
                        <select class="form-select mb-3" id="search-rollout-mode" name="mode" data-testid="search-rollout-mode">
                            <option value="off" <?= ($configurationForm['mode'] ?? '') === 'off' ? 'selected' : '' ?>><?= __('关闭') ?></option>
                            <option value="shadow" <?= ($configurationForm['mode'] ?? '') === 'shadow' ? 'selected' : '' ?>><?= __('影子比对') ?></option>
                        </select>
                        <button class="btn btn-primary" type="submit" data-testid="search-config-submit"><?= __('保存安全模式') ?></button>
                    </w:form>
                <?php endif; ?>
            </div>
        </div>
    <?php endif; ?>
    <?php if ($status !== []): ?><div class="card mb-3"><div class="card-body"><div class="row g-3">
        <?php foreach ($status as $key => $value): ?><div class="col-md-4"><div class="text-muted small"><?= $escape($key) ?></div><div class="fw-semibold"><?= $display($value) ?></div></div><?php endforeach; ?>
    </div></div></div><?php endif; ?>
    <?php foreach ($datasets as $dataset): ?><div class="card mb-3"><div class="card-header"><h5 class="mb-0"><?= $escape($dataset['label'] ?? '') ?></h5></div><div class="card-body">
        <?php if (!empty($dataset['error'])): ?><div class="alert alert-warning mb-0"><?= $escape($dataset['error']) ?></div>
        <?php elseif (empty($dataset['rows'])): ?><div class="text-muted"><?= __('当前没有记录。') ?></div>
        <?php else: ?><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><?php foreach (array_keys($dataset['rows'][0]) as $field): ?><th><?= $escape($field) ?></th><?php endforeach; ?></tr></thead><tbody>
            <?php foreach ($dataset['rows'] as $row): ?><tr><?php foreach ($row as $value): ?><td><?= $display($value) ?></td><?php endforeach; ?></tr><?php endforeach; ?>
        </tbody></table></div><?php endif; ?>
    </div></div><?php endforeach; ?>
</section>
