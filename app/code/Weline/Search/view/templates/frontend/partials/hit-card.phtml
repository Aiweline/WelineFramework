<?php
/** @var array<string,mixed> $hit */
$title = trim((string)($hit['title'] ?? ''));
$url = trim((string)($hit['url'] ?? ''));
$entityId = trim((string)($hit['entity_id'] ?? ''));
if ($url !== '' && !str_starts_with($url, 'http') && !str_starts_with($url, '/')) {
    $url = (string)$this->getUrl($url);
} elseif ($url === '' && $entityId !== '') {
    $url = (string)$this->getUrl('product/' . $entityId);
}
?>
<article class="storefront-search__card" data-entity-id="<?= htmlspecialchars($entityId, ENT_QUOTES, 'UTF-8') ?>">
    <h3>
        <?php if ($url !== ''): ?>
            <a href="<?= htmlspecialchars($url, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($title !== '' ? $title : $entityId, ENT_QUOTES, 'UTF-8') ?></a>
        <?php else: ?>
            <?= htmlspecialchars($title !== '' ? $title : $entityId, ENT_QUOTES, 'UTF-8') ?>
        <?php endif; ?>
    </h3>
</article>
