<?php
/** @var array<string,mixed> $hit */
$title = trim((string)($hit['title'] ?? ''));
$url = trim((string)($hit['url'] ?? ''));
$entityId = trim((string)($hit['entity_id'] ?? ''));
$productId = (int)($hit['product_id'] ?? 0);
$isAbsolute = str_starts_with($url, 'http://') || str_starts_with($url, 'https://');
if ($url !== '' && !$isAbsolute && !str_starts_with($url, '/')) {
    // keep as route path for @url
} elseif ($url === '' && $productId > 0) {
    $url = 'product/' . $productId;
    $isAbsolute = false;
} elseif ($url === '' && $entityId !== '') {
    $url = 'product/' . $entityId;
    $isAbsolute = false;
} elseif ($url !== '' && str_starts_with($url, '/')) {
    $url = ltrim($url, '/');
    $isAbsolute = false;
}
?>
<article class="storefront-search__card" data-entity-id="<?= htmlspecialchars($entityId, ENT_QUOTES, 'UTF-8') ?>">
    <h3>
        <?php if ($url !== ''): ?>
            <a href="<?php if ($isAbsolute): ?><?= htmlspecialchars($url, ENT_QUOTES, 'UTF-8') ?><?php else: ?>@url{$url}<?php endif; ?>"><?= htmlspecialchars($title !== '' ? $title : $entityId, ENT_QUOTES, 'UTF-8') ?></a>
        <?php else: ?>
            <?= htmlspecialchars($title !== '' ? $title : $entityId, ENT_QUOTES, 'UTF-8') ?>
        <?php endif; ?>
    </h3>
</article>
