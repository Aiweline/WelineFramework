<?php
/**
 * Layout: search/default
 *
 * Search page shell. Theme owns only chrome and slot mount points; search
 * modules provide result data through content or hooks.
 *
 * @meta.name {default="搜索页默认布局",name="搜索页默认布局",description="搜索结果页面布局"}
 * @meta.description {default="包含搜索结果、筛选和推荐区的可部件化布局",name="描述",description="搜索结果页面布局"}
 * @param.title {default="搜索结果",name="页面标题",description="页面标题"}
 * @param.meta_title {default="",name="SEO标题",description="SEO标题，留空时回退页面标题；有实体SEO时不覆盖实体"}
 * @param.meta_description {default="",name="SEO描述",description="SEO描述，用于搜索结果和社交摘要；有实体SEO时不覆盖实体"}
 * @param.content {default="",name="搜索结果内容",description="搜索结果内容 HTML"}
 * @param.filters {default="",name="筛选内容",description="搜索筛选内容 HTML"}
 * @param.showHeader {default=true,name="是否显示header",description="是否显示顶栏"}
 * @param.showFooter {default=true,name="是否显示footer",description="是否显示底栏"}
 * @param.class {default="",name="额外CSS类",description="主内容额外 CSS 类"}
 */
$meta = $this->getData('meta') ?? [];
$searchQuery = trim((string)($this->getData('search_query') ?? ''));
$searchType = trim((string)($this->getData('search_type') ?? 'all')) ?: 'all';
$searchCategoryId = (int)($this->getData('search_category_id') ?? 0);
$searchTypes = $this->getData('search_types') ?? [];
$searchTypes = is_array($searchTypes) ? $searchTypes : [];
$showSearchTypeFilter = $searchTypes !== [];
$searchBodyClass = 'search-layout__body' . ($showSearchTypeFilter ? ' search-layout__body--with-sidebar' : '');

// wave9-9s4: Taglib `if(($meta['showHeader'] ?? null))` treats missing as false → 丢头尾.
// Align with products/category — PHP-default chrome on so /search never drops shell.
$showHeader = $meta['showHeader'] ?? $this->getData('showHeader') ?? true;
$showFooter = $meta['showFooter'] ?? $this->getData('showFooter') ?? true;
$meta['showHeader'] = $showHeader;
$meta['showFooter'] = $showFooter;
$this->setData('meta', $meta);

$bodyClasses = ['search-layout-root'];
try {
    $websiteCode = \strtolower(\trim(
        (string)\Weline\Framework\Runtime\RequestContext::getWelineWebsiteCode()
    ));
    if ($websiteCode !== '' && \preg_match('/^[a-z0-9_-]+$/', $websiteCode) === 1) {
        $bodyClasses[] = $websiteCode . '-storefront';
        $bodyClasses[] = $websiteCode . '-page';
    }
} catch (\Throwable) {
}
$bodyClassAttr = \htmlspecialchars(\implode(' ', $bodyClasses), ENT_QUOTES, 'UTF-8');
?>
<!DOCTYPE html>
<html lang="{{htmlLang}}" dir="{{htmlDir}}" data-local="{{lang_local}}" data-lang="{{lang}}" data-dir="{{htmlDir}}" data-w-area="frontend" data-theme-preference="light" data-theme="light">
<head>
    <w:hook>Weline_Theme::frontend::layouts::base::head-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="head" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::head-after</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::search::head-after</w:hook>
    <w:hook>seo::head</w:hook>
</head>
<body class="<?= $bodyClassAttr ?>">
    <w:hook>seo::body</w:hook>
    <w:hook>Weline_Theme::frontend::layouts::base::body-start</w:hook>
<w:hook>Weline_Theme::frontend::layouts::search::body-start</w:hook>

<div class="weline-page-wrapper search-layout">
    <?php if ($showHeader): ?>
        <w:hook>Weline_Theme::frontend::layouts::base::header-before</w:hook>
        <w:hook>Weline_Theme::frontend::layouts::search::header-before</w:hook>
        <w:block class="Weline\Theme\Block\Partials" area="frontend" type="header" default-option="default" vars="logo,logoText,navItems,showSearch,showUserMenu"/>
        <w:hook>Weline_Theme::frontend::layouts::search::header-after</w:hook>
        <w:hook>Weline_Theme::frontend::layouts::base::header-after</w:hook>
    <?php endif; ?>

    <div class="search-layout__surface w-surface-body" data-surface="body">
    <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-before</w:hook>
    <w:block class="Weline\Theme\Block\Partials" area="frontend" type="breadcrumb" default-option="default"/>
    <w:hook>Weline_Theme::frontend::layouts::base::breadcrumb-after</w:hook>

    <div class="weline-main-content">
        <w:hook>Weline_Theme::frontend::layouts::base::content-before</w:hook>
        <w:hook>Weline_Theme::frontend::layouts::search::content-before</w:hook>

        <main class="search-main <?= htmlspecialchars($meta['class'] ?? '') ?>"
              id="main-content"
              data-layout="search">
            <w:hook>Weline_Theme::frontend::layouts::search::main-before</w:hook>
            <w:slot id="content"
                    name="内容区"
                    accept="layout-search-content,layout-default-content,content,search-content,search-filters,search-results,product-grid,product-carousel"
                    reject="header,footer"
                    multiple="true"
                    position="content"
                    class="search-main__content-root-slot">
                <div class="<?= htmlspecialchars($searchBodyClass, ENT_QUOTES, 'UTF-8') ?>">
                    <aside class="search-layout__filters" aria-label="@lang('搜索筛选')">
                        <?php if ($showSearchTypeFilter): ?>
                            <?php
                            echo $this->fetch('Weline_Search::templates/frontend/partials/type-filter.phtml', [
                                'search_query' => $searchQuery,
                                'search_type' => $searchType,
                                'search_category_id' => $searchCategoryId,
                                'search_types' => $searchTypes,
                            ]);
                            ?>
                        <?php endif; ?>
                        <?php /* Path-only FPC: never SSR product filter hook; JS mounts host when type=product. */ ?>
                        <w:slot id="search-filters"
                                name="搜索筛选区"
                                accept="layout-search-filters,layout-category-filters,category-filters,attribute-filter,price-filter"
                                multiple="true"
                                position="sidebar">
                            <if condition="meta.filters">
                                {{meta.filters}}
                            <else/>
                                <w:hook>Weline_Theme::frontend::layouts::search::filters</w:hook>
                            </if>
                        </w:slot>
                    </aside>

                    <section class="search-layout__results" weline-code="theme.search.section_1">
                        <w:slot id="search-results"
                                name="搜索结果区"
                                accept="layout-search-results,layout-products-grid,product-grid,product-list-view,search-results"
                                reject="header,footer"
                                multiple="true"
                                position="content">
                            <w:hook>Weline_Theme::frontend::layouts::search::results-before</w:hook>
                            <if condition="meta.content">
                                {{meta.content}}
                            <elseif condition="content"/>
                                {{content}}
                            <elseif condition="meta.contentTemplate"/>
                                <?php echo $this->fetch($this->getData("meta.contentTemplate")); ?>
                            <elseif condition="contentTemplate"/>
                                <?php echo $this->fetch($this->getData("contentTemplate")); ?>
                            <else/>
                                <w:hook>Weline_Theme::frontend::layouts::search::results</w:hook>
                            </if>
                            <w:hook>Weline_Theme::frontend::layouts::search::results-after</w:hook>
                        </w:slot>
                    </section>
                </div>

                <w:slot id="search-recommendations"
                        name="搜索推荐区"
                        accept="layout-search-recommendations,bestsellers,recently-viewed,you-may-like,featured-products,product-carousel"
                        multiple="true"
                        position="content"
                        wrapper="section"
                        class="search-layout__recommendations"
                        weline-code="theme.search.search_recommendations">
                    <?php
                    // Do not sync-render bestsellers here: cold publishedOffers() rebuilds the
                    // full storefront catalog and dominates /search TTFB. Theme injections via
                    // this hook/slot remain available when explicitly configured.
                    ?>
                    <w:hook>Weline_Theme::frontend::layouts::search::recommendations</w:hook>
                </w:slot>
            </w:slot>
            <w:hook>Weline_Theme::frontend::layouts::search::main-after</w:hook>
        </main>

        <w:hook>Weline_Theme::frontend::layouts::search::content-after</w:hook>
        <w:hook>Weline_Theme::frontend::layouts::base::content-after</w:hook>
    </div>
    </div>


    <w:slot id="search-bottom"
            name="搜索页底部扩展"
            accept="layout-search-bottom,banner,promo-banner,content,container,product,category,carousel,trust-badges"
            reject="header,footer,navigation"
