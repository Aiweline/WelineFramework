<?xml version="1.0"?>
<config xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
        xs:noNamespaceSchemaLocation="urn:Weline_Framework::Event/etc/xsd/event.xsd"
        xmlns="urn:Weline_Framework::Event/etc/xsd/event.xsd">
    <event name="Weline_Framework::resource_changed"
           schema_version="1"
           async_mapper="Weline\Framework\Event\ResourceChange\ResourceChangePayloadMapper"
           data_contract="resource_change.v1">
        <observer name="search_product_projection_changed"
                  instance="Weline\Search\Observer\ProductSearchProjectionChangedObserver"
                  delivery="async"
                  retry="standard"
                  coalesce="none"
                  timeout="30"
                  disabled="false"
                  shared="true"
                  sort="200"/>
    </event>
    <event name="Weline_Search::hot_words_changed">
        <observer name="search_hot_words_cache_invalidator"
                  instance="Weline\Search\Observer\SearchHotWordsCacheInvalidator"
                  disabled="false"
                  shared="true"
                  sort="100"/>
    </event>
</config>
