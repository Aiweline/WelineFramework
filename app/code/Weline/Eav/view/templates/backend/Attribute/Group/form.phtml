<js:part>
(function () {
    'use strict';

    var entitySelect = document.getElementById('validationEntity');
    var setSelect = document.getElementById('validationSet');
    if (!entitySelect || !setSelect) {
        return;
    }

    function renderAttributeSet(entityId) {
        if (!entityId) {
            return;
        }
        var url = "@backend-url('*/backend/attribute/set/api-search')?eav_entity_id=" + encodeURIComponent(entityId);
        var req = window.bqAdmin['eav_admin'](url, { silent: true });
        req.then(function (res) {
            var payload = (res && res.data) ? res.data : res;
            var items = (payload && payload.items) ? payload.items : {};
            var selectedValue = setSelect.getAttribute('data-selected') || '';
            setSelect.innerHTML = '';
            Object.keys(items).forEach(function (key) {
                var item = items[key] || {};
                var option = document.createElement('option');
                option.value = String(item.set_id);
                option.textContent = String(item.name);
                if (String(item.set_id) === selectedValue) {
                    option.selected = true;
                }
                setSelect.appendChild(option);
            });
        }).catch(function () {
        });
    }

    entitySelect.addEventListener('change', function () {
        renderAttributeSet(entitySelect.value);
    });

    if (!setSelect.value) {
        renderAttributeSet(entitySelect.value);
    }
})();
</js:part>
