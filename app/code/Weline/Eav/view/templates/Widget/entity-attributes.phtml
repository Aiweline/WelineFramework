<?php
/**
 * Entity attribute renderer.
 *
 * @var \Weline\Eav\Block\Widget\EntityAttributes $block
 */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$entity = $block->getEntity();
if (!$entity) {
    echo '<div class="w-alert" data-tone="warning">' . $escape(__('未找到指定实体')) . '</div>';
    return;
}

$attributeData = $block->getFullAttributeData();
$isEditMode = $block->isEditMode();
$entityId = (string)$block->getData('entity_id');
?>
<section class="w-eav-entity w-stack"
         data-w-entity-code="<?= $escape($entity->getData('code')) ?>"
         data-w-entity-id="<?= $escape($entityId) ?>">
    <?php if (empty($attributeData)): ?>
        <div class="w-empty">
            <w:icon name="database" size="xl" />
            <p><?= $escape(__('暂无属性数据')) ?></p>
        </div>
    <?php else: ?>
        <?php foreach ($attributeData as $setData): ?>
            <?php $set = is_array($setData['set'] ?? null) ? $setData['set'] : []; ?>
            <section class="w-card">
                <header class="w-card__header">
                    <h2 class="w-card__title">
                        <w:icon name="folder" size="sm" />
                        <?= $escape($set['local_name'] ?? $set['name'] ?? $set['code'] ?? '') ?>
                    </h2>
                </header>
                <div class="w-card__body w-stack">
                    <?php foreach (($setData['groups'] ?? []) as $groupData): ?>
                        <?php $group = is_array($groupData['group'] ?? null) ? $groupData['group'] : []; ?>
                        <details class="w-disclosure" open>
                            <summary class="w-disclosure__trigger">
                                <span class="w-cluster">
                                    <w:icon name="folder" size="sm" />
                                    <?= $escape($group['local_name'] ?? $group['name'] ?? $group['code'] ?? '') ?>
                                </span>
                                <w:icon name="chevron-down" size="sm" />
                            </summary>
                            <div class="w-disclosure__panel">
                                <?php if ($isEditMode): ?>
                                    <div class="w-grid">
                                        <?php foreach (($groupData['attributes'] ?? []) as $attribute): ?>
                                            <?php
                                            $element = (string)($attribute['element'] ?? 'input');
                                            $value = $attribute['value'] ?? '';
                                            $code = (string)($attribute['code'] ?? '');
                                            $label = $attribute['local_name'] ?? $attribute['name'] ?? $code;
                                            ?>
                                            <label class="w-field">
                                                <span class="w-field__label"><?= $escape($label) ?></span>
                                                <?php if ($element === 'select' && !empty($attribute['options'])): ?>
                                                    <select class="w-select" name="eav[<?= $escape($code) ?>]">
                                                        <option value=""><?= $escape(__('请选择')) ?></option>
                                                        <?php foreach ($attribute['options'] as $option): ?>
                                                            <?php $optionCode = (string)($option['code'] ?? ''); ?>
                                                            <option value="<?= $escape($optionCode) ?>" <?= (string)$value === $optionCode ? 'selected' : '' ?>>
                                                                <?= $escape($option['value'] ?? $optionCode) ?>
                                                            </option>
                                                        <?php endforeach; ?>
                                                    </select>
                                                <?php elseif ($element === 'textarea'): ?>
                                                    <textarea class="w-textarea" name="eav[<?= $escape($code) ?>]" rows="3"><?= $escape($value) ?></textarea>
                                                <?php elseif ($element === 'checkbox'): ?>
                                                    <span class="w-check">
                                                        <input type="checkbox" name="eav[<?= $escape($code) ?>]" value="1" <?= $value ? 'checked' : '' ?>>
                                                    </span>
                                                <?php else: ?>
                                                    <input type="text" class="w-input" name="eav[<?= $escape($code) ?>]" value="<?= $escape($value) ?>">
                                                <?php endif; ?>
                                            </label>
                                        <?php endforeach; ?>
                                    </div>
                                <?php else: ?>
                                    <div class="w-table-wrap">
                                        <table class="w-table">
                                            <tbody>
                                                <?php foreach (($groupData['attributes'] ?? []) as $attribute): ?>
                                                    <?php
                                                    $value = $attribute['value'] ?? '';
                                                    $displayValue = $value;
                                                    $swatchColor = '';
                                                    if (!empty($attribute['options']) && $value !== '') {
                                                        foreach ($attribute['options'] as $option) {
                                                            if ((string)($option['code'] ?? '') !== (string)$value) {
                                                                continue;
                                                            }
                                                            $displayValue = $option['value'] ?? $value;
                                                            $candidate = (string)($option['swatch_color'] ?? '');
                                                            if (preg_match('/^#[0-9a-fA-F]{6}$/', $candidate)) {
                                                                $swatchColor = $candidate;
                                                            }
                                                            break;
                                                        }
                                                    }
                                                    ?>
                                                    <tr>
                                                        <th scope="row" class="w-text" data-tone="muted">
                                                            <?= $escape($attribute['local_name'] ?? $attribute['name'] ?? $attribute['code'] ?? '') ?>
                                                        </th>
                                                        <td>
                                                            <?php if ($swatchColor !== ''): ?>
                                                                <span class="w-cluster">
                                                                    <input type="color" value="<?= $escape($swatchColor) ?>" disabled aria-label="<?= $escape(__('颜色样本')) ?>">
                                                                    <span><?= $escape($displayValue) ?></span>
                                                                </span>
                                                            <?php elseif ((string)$displayValue !== ''): ?>
                                                                <?= $escape($displayValue) ?>
                                                            <?php else: ?>
                                                                <span class="w-text" data-tone="muted">-</span>
                                                            <?php endif; ?>
                                                        </td>
                                                    </tr>
                                                <?php endforeach; ?>
                                            </tbody>
                                        </table>
                                    </div>
                                <?php endif; ?>
                            </div>
                        </details>
                    <?php endforeach; ?>
                </div>
            </section>
        <?php endforeach; ?>
    <?php endif; ?>
</section>
