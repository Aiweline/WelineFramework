<?php
/**
 * 实体属性展示组件模板
 * 
 * @var \Weline\Eav\Block\Widget\EntityAttributes $block
 */

$entity = $block->getEntity();
if (!$entity) {
    echo '<div class="w-alert" data-tone="warning">未找到指定实体</div>';
    return;
}

$attributeData = $block->getFullAttributeData();
$isEditMode = $block->isEditMode();
$entityId = $block->getData('entity_id');
?>

<div class="eav-entity-attributes" data-entity-code="<?= $entity->getData('code') ?>" data-entity-id="<?= $entityId ?>">
    
    <?php if (empty($attributeData)): ?>
        <div class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-6);--w-pb:var(--weline-space-6);">
            <w:icon name="database" size="sm"></w:icon>
            <?= __('暂无属性数据') ?>
        </div>
    <?php else: ?>
        
        <?php foreach ($attributeData as $setData): ?>
            <?php $set = $setData['set']; ?>
            
            <div class="eav-attribute-set" style="--w-mb:var(--weline-space-6);">
                <h5 data-w-border="bottom" style="--w-pb:var(--weline-space-2);--w-mb:var(--weline-space-4);">
                    <w:icon name="folder" size="sm"></w:icon>
                    <?= $set['local_name'] ?? $set['name'] ?? $set['code'] ?>
                </h5>
                
                <?php foreach ($setData['groups'] as $groupData): ?>
                    <?php $group = $groupData['group']; ?>
                    
                    <div class="eav-attribute-group" style="--w-mb:var(--weline-space-4);">
                        <h6 class="w-text" data-tone="muted" style="--w-mb:var(--weline-space-2);">
                            <w:icon name="folder" size="sm"></w:icon>
                            <?= $group['local_name'] ?? $group['name'] ?? $group['code'] ?>
                        </h6>
                        
                        <?php if ($isEditMode): ?>
                            <!-- 编辑模式 -->
                            <div class="w-grid">
                                <?php foreach ($groupData['attributes'] as $attr): ?>
                                    <div style="--w-span-md:6;--w-mb:var(--weline-space-4);">
                                        <label class="w-field__label">
                                            <?= $attr['local_name'] ?? $attr['name'] ?? $attr['code'] ?>
                                        </label>
                                        <?php 
                                        $element = $attr['element'] ?? 'input';
                                        $value = $attr['value'] ?? '';
                                        $attrCode = $attr['code'];
                                        ?>
                                        
                                        <?php if ($element === 'select' && !empty($attr['options'])): ?>
                                            <select class="w-select" name="eav[<?= $attrCode ?>]">
                                                <option value=""><?= __('请选择') ?></option>
                                                <?php foreach ($attr['options'] as $option): ?>
                                                    <option value="<?= htmlspecialchars($option['code']) ?>" 
                                                            <?= $value == $option['code'] ? 'selected' : '' ?>>
                                                        <?= htmlspecialchars($option['value']) ?>
                                                    </option>
                                                <?php endforeach; ?>
                                            </select>
                                        <?php elseif ($element === 'textarea'): ?>
                                            <textarea class="w-textarea" name="eav[<?= $attrCode ?>]" rows="3"><?= htmlspecialchars($value) ?></textarea>
                                        <?php elseif ($element === 'checkbox'): ?>
                                            <div class="w-check">
                                                <input type="checkbox" name="eav[<?= $attrCode ?>]" value="1" <?= $value ? 'checked' : '' ?>>
                                            </div>
                                        <?php else: ?>
                                            <input type="text" class="w-input" name="eav[<?= $attrCode ?>]" value="<?= htmlspecialchars($value) ?>">
                                        <?php endif; ?>
                                    </div>
                                <?php endforeach; ?>
                            </div>
                        <?php else: ?>
                            <!-- 查看模式 -->
                            <table class="w-table">
                                <tbody>
                                    <?php foreach ($groupData['attributes'] as $attr): ?>
                                        <tr>
                                            <th style="width: 200px;" class="w-text" data-tone="muted">
                                                <?= $attr['local_name'] ?? $attr['name'] ?? $attr['code'] ?>
                                            </th>
                                            <td>
                                                <?php 
                                                $value = $attr['value'] ?? '';
                                                
                                                // 如果有选项，显示选项值
                                                if (!empty($attr['options']) && $value) {
                                                    foreach ($attr['options'] as $option) {
                                                        if ($option['code'] == $value) {
                                                            $value = $option['value'];
                                                            
                                                            // 如果有样本颜色
                                                            if (!empty($option['swatch_color'])) {
                                                                echo '<span class="w-cluster" data-align="center">';
                                                                echo '<span class="me-2" style="display:inline-block;width:16px;height:16px;border-radius:3px;background-color:' . htmlspecialchars($option['swatch_color']) . '"></span>';
                                                                echo htmlspecialchars($value);
                                                                echo '</span>';
                                                            } else {
                                                                echo htmlspecialchars($value);
                                                            }
                                                            break;
                                                        }
                                                    }
                                                } else {
                                                    echo htmlspecialchars($value) ?: '<span class="w-text" data-tone="muted">-</span>';
                                                }
                                                ?>
                                            </td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
                            </table>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endforeach; ?>
        
    <?php endif; ?>
    
</div>
