<?php
/** @var \Weline\Framework\View\Template $this */
?>
<link rel="stylesheet" href="@static(Weline_Eav::css/eav-entity-list.css)">

<div class="w-stack w-eav-entity-list" data-gap="lg">
    <header class="w-eav-entity-list__hero">
        <div class="w-eav-entity-list__hero-icon" aria-hidden="true">
            <w:icon name="database" size="lg" />
        </div>
        <div class="w-eav-entity-list__hero-copy">
            <h1><lang>Eav实体</lang></h1>
            <p><lang>查看已注册的 EAV 实体定义，可搜索代码、名称与类名</lang></p>
        </div>
        <div class="w-eav-entity-list__hero-actions">
            <a class="w-button" data-tone="primary" data-variant="outline" data-size="sm"
               href="@backend-url('*/backend/manager')">
                <w:icon name="layers" size="sm" />
                <lang>打开 EAV 管理器</lang>
            </a>
        </div>
    </header>

    <div>
        <template>Weline_Component::message.phtml</template>
    </div>

    <section class="w-card w-eav-entity-list__card">
        <div class="w-card__header">
            <div>
                <h2 class="w-eav-entity-list__card-title"><lang>实体列表</lang></h2>
                <p class="w-eav-entity-list__card-desc"><lang>系统实体不可修改或删除</lang></p>
            </div>
            <div class="w-eav-entity-list__toolbar">
                <block class="Weline\Component\Block\Form\Search"
                       id="entity-search"
                       action="*/backend/entity"
                       method="get"
                       keyword="search"
                       value=""
                       placeholder="请输入代码、名称或类名"></block>
            </div>
        </div>

        <div class="w-card__body w-eav-entity-list__body">
            <div class="w-eav-entity-list__table-wrap">
                <table class="w-eav-entity-list__table" id="eav-entity-list-table">
                    <thead>
                    <tr>
                        <th><lang>实体ID</lang></th>
                        <th><lang>代码</lang></th>
                        <th><lang>名称</lang></th>
                        <th><lang>类</lang></th>
                        <th><lang>主键类型</lang></th>
                        <th><lang>主键长度</lang></th>
                        <th><lang>类型</lang></th>
                        <th><lang>创建时间</lang></th>
                        <th><lang>更新时间</lang></th>
                        <th><lang>操作</lang></th>
                    </tr>
                    </thead>
                    <tbody>
                    <foreach name="entities" item="entity" key="key">
                        <tr>
                            <td class="w-eav-entity-list__id">{{entity.eav_entity_id}}</td>
                            <td><code class="w-eav-entity-list__code">{{entity.code}}</code></td>
                            <td class="w-eav-entity-list__name">
                                <local name="entity-name"
                                       model="Weline\Eav\Model\EavEntity\LocalDescription"
                                       field="name"
                                       id="entity.eav_entity_id">
                                    {{entity.local_name|entity.name}}
                                </local>
                            </td>
                            <td>
                                <div class="w-eav-entity-list__class" title="{{entity.class}}">{{entity.class}}</div>
                            </td>
                            <td class="w-eav-entity-list__meta">{{entity.eav_entity_id_field_type}}</td>
                            <td class="w-eav-entity-list__meta">{{entity.eav_entity_id_field_length}}</td>
                            <td>
                                <if condition="entity.is_system">
                                    <span class="w-badge" data-w-background="warning"><lang>系统实体</lang></span>
                                    <else/>
                                    <span class="w-badge" data-w-background="neutral"><lang>自定义</lang></span>
                                </if>
                            </td>
                            <td class="w-eav-entity-list__meta">{{entity.create_time}}</td>
                            <td class="w-eav-entity-list__meta">{{entity.update_time}}</td>
                            <td>
                                <div class="w-eav-entity-list__actions">
                                    <if condition="entity.is_system == 0">
                                        <a class="w-button" data-tone="primary" data-variant="outline" data-size="sm"
                                           href="@backend-url('*/backend/entity/edit')?code={{entity.code}}">
                                            <lang>修改</lang>
                                        </a>
                                        <a class="w-button" data-tone="danger" data-variant="outline" data-size="sm"
                                           href="@backend-url('*/backend/entity/delete')?code={{entity.code}}">
                                            <lang>删除</lang>
                                        </a>
                                        <else/>
                                        <span class="w-text" data-tone="muted" data-size="sm"><lang>系统实体</lang></span>
                                    </if>
                                </div>
                            </td>
                        </tr>
                    </foreach>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="w-eav-entity-list__footer">
            {{pagination}}
        </div>
    </section>
</div>
