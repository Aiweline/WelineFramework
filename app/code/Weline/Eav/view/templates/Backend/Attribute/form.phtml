                                <span v-text='offRow?"@lang{编辑配置项}":"@lang{添加配置项}"'></span>
                            </h5>
                            <button type='button' class="w-button w-text" aria-label='@lang{关闭}' data-w-action="drawer.close" data-w-close="" data-tone="quiet" data-size="sm"></button>
                        </div>
                        <div class="w-drawer__body">
                            <!-- 使用网格系统布局 -->
                            <div class="w-grid">
                                <div style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field required">
                                        <label for='value' data-toggle='tooltip' title='@lang{每个配置项名称}'>
                                            <lang>配置项</lang>
                                        </label>
                                        <input type='text' class="w-input" id='value' v-model="addParams.value" placeholder='@lang{请输入配置项名称}' required>
                                    </div>
                                </div>
                                <div style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field required">
                                        <label for='code' data-toggle='tooltip'
                                               title='@lang{每个配置项应该有自己的代码，请填写对应实体和属性时的唯一编码。}'>
                                            <lang>代码</lang>
                                        </label>
                                        <input type='text' class="w-input" id='code' v-model="addParams.code" placeholder='@lang{请输入代码}' required>
                                    </div>
                                </div>


                                <div v-if="activeAttrItem.swatch_color" style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field required">
                                        <label for='code' data-toggle='tooltip' title='@lang{每个配置颜色，请填写}'>
                                            <lang>颜色</lang>
                                        </label>
                                        <div id="swatch_color_picker" class="w-field__control colorpicker-component">
                                            <input type="text" v-model="addParams.swatch_color" :style="{backgroundColor:addParams.swatch_color}" placeholder='@lang{请选择}' class="w-input" />
                                        </div>

                                    </div>
                                </div>
                                <div v-if="activeAttrItem.swatch_image" style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field required">
                                        <label for='code' data-toggle='tooltip'
                                               title='@lang{每个配置的图片，请选择}'>
                                            <lang>图片</lang>
                                        </label>

                                        <div class="w-input" style="padding:0px;">
                                            <img :src="'/media/image/'+ addParams.swatch_image + '?w=50&h=50'"
                                                 alt="" v-if="addParams.swatch_image">
                                            <button type="button" class="w-button waves-light" data-tone="primary" data-size="sm"><lang>选择图片</lang>
                                            </button>
                                        </div>


                                        <input type='hidden' class="w-input" id='callBackImg' placeholder='@lang{请选中图片}' required>

                                    </div>
                                </div>
                                <div v-if="activeAttrItem.swatch_text" style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field required">
                                        <label for='code' data-toggle='tooltip'
                                               title='@lang{每个配置的文本，请填写}'>
                                            <lang>文本</lang>
                                        </label>
                                        <input type='text' class="w-input" id='code' v-model="addParams.swatch_text" placeholder='@lang{请输入文本}' required>
                                    </div>
                                </div>

                                <div class="w-cluster" data-align="end" style="--w-span:4;--w-span-md:3;--w-span-lg:2;">
                                    <div class="w-field">
                                        <button type='button' class="w-button" href='' data-tone="primary">
                                            <span v-text='offRow?"@lang{编辑}":"@lang{添加}"'></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- 选择图片 -->

                    <div class="w-dialog" :style="{display:chooseImgModel?'block':'none'}" data-w-component="dialog" data-state="open" tabindex="-1">
                        <div class="w-dialog__frame modal-fullscreen">
                            <div class="w-dialog__surface">
                                <div class="w-dialog__header">
                                    
                                    <h5 id="chooseImgModelLabel" class="w-dialog__title">
                                        <lang>图片选择器</lang>
                                        <span class="w-text" data-tone="danger"><lang>（双击选中图片）最大支持100kb</lang></span>
                                    </h5>
                                    <button type="button" aria-label="Close" class="w-button" data-w-action="dialog.close" data-w-close="" data-tone="quiet" data-size="sm"></button>
                                </div>
                                <div class="w-dialog__body">
                                    <iframe src="@file-manager-connector{target='#callBackImg' close='#closeImgModel' path='media/store/logo/' multi='0' ext='png,jpeg,jpg,webp,svg,ico' size='102400'}" frameborder="0" data-w-width="full" data-w-height="full"></iframe>
                                </div>
                                <div class="w-dialog__footer">
                                    <button type="button" class="w-button" data-tone="neutral">
                                        <lang>关闭</lang>
                                    </button>
                                    <button type="button" id="closeImgModel" class="w-button waves-light" data-w-action="dialog.close" data-tone="primary">
                                        <lang>确定</lang>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div v-if="(activeName=='progress-attribute-details'&&params.data_has_option!=1)||activeName=='progress-attribute-option'">
                    <button class="w-button" data-tone="primary">
                        <lang>提交</lang>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<js:part name="debounce"/>
<js:part>
(function() {
    'use strict';
    
    window.AttributePage = new Vue({
        el: '#AttributePage',
        data: {
            chooseImgModel: false,
            params: {
                attribute_id: '{{attribute.attribute_id}}',
                eav_entity_id: '{{attribute.eav_entity_id}}',
                set_id: '{{attribute.set_id}}',
                group_id: '{{attribute.group_id}}',
                code: '{{attribute.code}}',
                name: '{{attribute.name}}',
                type_id: '{{attribute.type_id|0}}',
                basic_is_enable: '{{attribute.basic_is_enable|1}}',
                frontend_is_visible: '{{attribute.frontend_is_visible|0}}',
                frontend_is_filterable: '{{attribute.frontend_is_filterable|0}}',
                frontend_is_searchable: '{{attribute.frontend_is_searchable|0}}',
                data_has_option: '{{attribute.data_has_option|0}}',
                is_system: '{{attribute.is_system|0}}',
                data_is_multiple: '{{attribute.data_is_multiple|0}}'
            },
            addParams: {
                option_id: 0,
                value: '',
                code: '',
                swatch_color: '',
                swatch_image: '',
                swatch_text: ''
            },
            stopable: 0,
            EntitiesVal: '',
            entityNameGroup: '',
            entityGroup: '',
            entities: <?= isset($entities) ? json_encode($entities) : '[]' ?>,
            sets: [],
            groups: [],
            types: <?= isset($types) ? json_encode($types) : '[]' ?>,
            activeName: '{{attribute.progress|"progress-select-entity"}}',
            tableData: <?= isset($attribute['options']) ? json_encode($attribute['options']) : '[]' ?>,
            activeAttrItem: {
                swatch_color: 0,
                swatch_image: 0,
                swatch_text: 0
            },
            offRow: '',
            EditIndex: 0,
            totalOptions: 0
        },
        mounted: function() {
            var self = this;
            this.activeName = '{{attribute.progress|"progress-select-entity"}}';
            if (this.params.eav_entity_id) {
                this.renderSearchEntityAttributeSet();
            }
            if (this.params.set_id) {
                this.renderSearchEntityAttributeSetGroup();
            }
            if ('{{entity_type}}' && '{{entity_type}}' !== '') {
                var entity = this.entities.find(function(e) { return e.code === '{{entity_type}}'; });
                if (entity) {
                    this.params.eav_entity_id = entity.eav_entity_id;
                    this.renderSearchEntityAttributeSet();
                }
                this.activeName = 'progress-select-set';
                this.$nextTick(function() {
                    $(".twitter-bs-wizard-nav li").eq(0).addClass('disabled').css({'pointer-events':'none','opacity':0.5});
                });
            }
            for (var i = 0; i < this.types.length; i++) {
                var type = this.types[i];
                if (type.type_id == this.params.type_id && type.is_swatch == 1) {
                    this.stopable = 1;
                    this.activeAttrItem.swatch_color = type.swatch_color;
                    this.activeAttrItem.swatch_image = type.swatch_image;
                    this.activeAttrItem.swatch_text = type.swatch_text;
                }
            }
        },
        methods: {
            submitAttr: function() {
                var self = this;
                if (!this.params.name) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性名再操作！}',
                        message: '@lang{当前属性名为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-attribute-details';
                        }
                    });
                    return false;
                }
                if (!this.params.code) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性再操作！}',
                        message: '@lang{当前属性代码为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-attribute-details';
                        }
                    });
                    return false;
                }
                if (!this.params.type_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择属性类型再操作！}',
                        message: '@lang{当前属性类型为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            self.activeName = 'progress-attribute-details';
                            $('.btn-close').click();
                        }
                    });
                    return false;
                }
                if (!this.params.eav_entity_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择实体再操作！}',
                        message: '@lang{当前实体为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-entity';
                        }
                    });
                    return false;
                }
                if (!this.params.set_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性集再操作！}',
                        message: '@lang{当前属性集代码为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-set';
                        }
                    });
                    return false;
                }
                if (!this.params.group_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性组再操作！}',
                        message: '@lang{当前属性组代码为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-group';
                        }
                    });
                    return false;
                }
                console.log(this.params, '@lang{获取已填写数据}', this.tableData, '@lang{第5部分的数据}');
                var saveUrl = "@backend-url('*/backend/attribute/save')";
                var saveData = { base: this.params, option: this.tableData };
                var req = bqAdmin['eav_admin'](saveUrl, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(saveData) });
                req.then(function(res) {
                    var resData = (res && res.data) || res;
                    if (resData && resData.code == 0) {
                            Weline.UI.dialog.request({
                                title: resData.msg,
                                tone: 'success',
                                confirmLabel: '@lang{好的}'
                            }).then(function(result) {
                                if (result.confirmed) {
                                    showLoading();
                                    window.parent.location.reload();
                                }
                            });
                        }
                }).catch(function() {});
            },
            closeImgModel: function() {
                console.log($('#callBackImg').val(), '图片回显的值');
                this.chooseImgModel = false;
                this.addParams.swatch_image = decodeURIComponent($('#callBackImg').val());
                this.offRow = '';
            },
            debounceChange: debounce(function (code, eav_entity_id, set_id, group_id) {
                var self = this;
                if (!eav_entity_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择实体再操作！}',
                        message: '@lang{当前实体为空！无法创建属性！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            self.activeName = 'progress-select-entity';
                        }
                    });
                    return false;
                }
                if (!set_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性集再操作！}',
                        message: '@lang{当前属性集代码为空！无法创建属性！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            self.activeName = 'progress-select-set';
                        }
                    });
                    return false;
                }
                if (!group_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择属性组再操作！}',
                        message: '@lang{当前属性组代码为空！无法创建属性！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            self.activeName = 'progress-select-group';
                        }
                    });
                    return false;
                }
                var searchUrl = '@backend-url("*/backend/attribute/search")?field=code&limit=1&search=' + encodeURIComponent(code) + '&eav_entity_id=' + eav_entity_id + '&set_id=' + set_id + '&group_id=' + group_id;
                var req2 = bqAdmin['eav_admin'](searchUrl, { silent: true });
                req2.then(function(res) {
                    var resData2 = (res && res.data) || res;
                    if (resData2 && resData2.items && resData2.items.length > 0) {
                            Weline.UI.dialog.request({
                                title: '@lang{属性已存在！}',
                                message: '@lang{该属性已存在！}',
                                tone: 'warning',
                                confirmLabel: '@lang{好的}'
                            }).then(function (result) {
                                if (result.confirmed) {
                                    $('#progress-attribute-code').css({border: 'red 1px solid'});
                                }
                            });
                        } else {
                            $('#progress-attribute-code').css({border: 'green 1px solid'});
                        }
                }).catch(function(res) { console.log(res); });
            }, 500),
            debounceSaveType: debounce(function (type) {
                var data_has_option = 0;
                if (type.is_swatch == 1) {
                    data_has_option = 1;
                    this.params.data_has_option = data_has_option;
                }
                var udUrl = "@backend-url('backend/user-data')";
                var udBody = 'scope=attribute&name=data_has_option&value=' + encodeURIComponent(data_has_option);
                var req3 = bqAdmin['eav_admin'](udUrl, { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: udBody, silent: true });
                req3.catch(function(res) { console.log(res, '保存失败'); });
            }, 500),
            checkCode: function(e) {
                this.debounceChange(this.params.code, this.params.eav_entity_id, this.params.set_id, this.params.group_id);
            },
            editRow: function(row, index) {
                var self = this;
                $('#addOption').click();
                if (this.activeAttrItem.swatch_color) {
                    $('#swatch_color_picker').colorpicker();
                    $('#swatch_color_picker').on('change', function(event) {
                        self.addParams.swatch_color = event.value;
                    });
                }
                this.addParams = JSON.parse(JSON.stringify(row));
                this.offRow = row;
                this.EditIndex = index;
            },
            deleteRow: function(row, index) {
                var self = this;
                Weline.UI.dialog.request({
                    title: '@lang{提示}',
                    message: '@lang{确认删除当前列吗？}',
                    tone: 'info',
                    confirmLabel: '@lang{确定}',
                    cancelLabel: '@lang{取消}',
                    confirmable: true,
                    cancelable: true
                }).then(function(result) {
                    if (result.confirmed) {
                        self.tableData.splice(index, 1);
                        if (row.option_id) {
                            var delUrl = "@backend-url('*/backend/attribute/option/delete')";
                            var delBody = 'id=' + encodeURIComponent(row.option_id);
                            var req4 = bqAdmin['eav_admin'](delUrl, { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: delBody, silent: true });
                            req4.catch(function() {});
                        }
                    }
                });
            },
            showAddOff: function() {
                var self = this;
                console.log('监听点击了显示添加弹窗');
                this.addParams = {
                    value: '',
                    code: '',
                    swatch_color: '',
                    swatch_image: '',
                    swatch_text: ''
                };
                if (this.activeAttrItem.swatch_color) {
                    $('#swatch_color_picker').colorpicker();
                    $('#swatch_color_picker').on('change', function(event) {
                        self.addParams.swatch_color = event.value;
                    });
                }
                this.offRow = '';
            },
            addRow: function() {
                var self = this;
                if (!this.stopable) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择属性类型再操作！}',
                        message: '@lang{当前属性类型为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            self.activeName = 'progress-attribute-details';
                            $('.btn-close').click();
                        }
                    });
                    return false;
                }
                if (!this.params.eav_entity_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择实体再操作！}',
                        message: '@lang{当前实体为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-entity';
                        }
                    });
                    return false;
                }
                if (!this.params.set_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性集再操作！}',
                        message: '@lang{当前属性集代码为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-set';
                        }
                    });
                    return false;
                }
                if (!this.params.group_id) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先创建属性组再操作！}',
                        message: '@lang{当前属性组代码为空！无法创建属性配置项！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    }).then(function(result) {
                        if (result.confirmed) {
                            $('.btn-close').click();
                            self.activeName = 'progress-select-group';
                        }
                    });
                    return false;
                }
                if (!this.addParams.value || !this.addParams.code) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先填写配置项和代码再操作！}',
                        message: '@lang{当前属性配置项或代码为空！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    });
                    return false;
                }
                if (this.activeAttrItem.swatch_color && !this.addParams.swatch_color) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择颜色再操作！}',
                        message: '@lang{当前属性颜色为空！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    });
                    return false;
                }
                if (this.activeAttrItem.swatch_image && !this.addParams.swatch_image) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先选择图片再操作！}',
                        message: '@lang{当前属性图片为空！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    });
                    return false;
                }
                if (this.activeAttrItem.swatch_text && !this.addParams.swatch_text) {
                    Weline.UI.dialog.request({
                        title: '@lang{请先填写文本再操作！}',
                        message: '@lang{当前属性文本为空！}',
                        tone: 'warning',
                        confirmLabel: '@lang{好的}'
                    });
                    return false;
                }
                var params = JSON.parse(JSON.stringify(this.addParams));
                if (this.offRow) {
                    params.update_time = new Date().toLocaleString();
                    this.tableData.splice(this.EditIndex, 1, params);
                } else {
                    params.create_time = new Date().toLocaleString();
                    params.update_time = new Date().toLocaleString();
                    this.tableData.push(params);
                }
                $('.btn-close').click();
            },
            renderSearchEntities: function(e) {
                var self = this;
                var url = '@backend-url("*/backend/entity/search")?search=' + encodeURIComponent(this.EntitiesVal);
                var req = bqAdmin['eav_admin'](url, { silent: true });
                req.then(function(res) {
                    var data = (res && res.data) || res;
                    if (data && data.items) {
                        self.entities = data.items;
                        self.EntitiesVal = '';
                    }
                }).catch(function() {});
            },
            renderSearchEntityAttributeSet: function(e) {
                var self = this;
                var url = '@backend-url("*/backend/attribute/set/search")?search=' + encodeURIComponent(this.entityGroup) + '&eav_entity_id=' + this.params.eav_entity_id;
                var req = bqAdmin['eav_admin'](url, { silent: true });
                req.then(function(res) {
                    var data = (res && res.data) || res;
                    if (data && data.msg) {
                        Weline.UI.dialog.request({ title: '警告！', message: data.msg, tone: 'danger', dangerous: true, confirmLabel: '@lang{好的}' });
                        return;
                    }
                    if (data && data.items) {
                        self.sets = data.items;
                        self.entityGroup = '';
                    }
                }).catch(function() {});
            },
            renderSearchEntityAttributeSetGroup: function(e) {
                var self = this;
                var url = '@backend-url("*/backend/attribute/group/search")?search=' + encodeURIComponent(this.entityNameGroup) + '&eav_entity_id=' + this.params.eav_entity_id + '&set_id=' + this.params.set_id;
                var req = bqAdmin['eav_admin'](url, { silent: true });
                req.then(function(res) {
                    var data = (res && res.data) || res;
                    if (data && data.msg) {
                        Weline.UI.dialog.request({ title: '警告！', message: data.msg, tone: 'danger', dangerous: true, confirmLabel: '@lang{好的}' });
                        return;
                    }
                    if (data && data.items) {
                        self.groups = data.items;
                        self.entityNameGroup = '';
                    }
                }).catch(function() {});
            },
            findLabel: function(arr, id, key, name) {
                var label = '';
                arr.forEach(function(item) {
                    if (item[key] == id) {
                        label = item[name];
                    }
                });
                return label;
            },
            changeType: function(arr, id) {
                var self = this;
                var find_item = {};
                arr.forEach(function(item) {
                    if (item.type_id == Number(id)) {
                        self.params.data_has_option = item.is_swatch;
                        self.stopable = item.is_swatch;
                        find_item = item;
                    }
                });
                this.debounceSaveType(find_item);
                this.activeAttrItem = find_item;
                console.log(find_item);
            },
            changeNav: function(name) {
                this.activeName = name;
                console.log(this.activeName);
                if (this.params.eav_entity_id) {
                    this.renderSearchEntityAttributeSet();
                }
                if (this.params.set_id) {
                    this.renderSearchEntityAttributeSetGroup();
                }
            }
        }
    });
})();
</js:part>
