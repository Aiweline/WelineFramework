<js:part>
(function() {
    'use strict';
    
    $('#optionConfig').on('weline:ui:dialog:before-open', function (event) {
        showLoading();
        var button = event.relatedTarget;
        var attribute_code = button.getAttribute('data-code');
        var eav_entity_id = button.getAttribute('data-eav_entity_id');
        var url = '@backend-url("*/backend/attribute/option/search")?eav_entity_id={eav_entity_id}&attribute_code={attribute_code}'
            .replace('{eav_entity_id}', eav_entity_id).replace('{attribute_code}', attribute_code);
        var req = bqAdmin['eav_admin'](url, { silent: true });
        req.then(function(res) {
            var resData = (res && res.data) || res;
            var attributeOption = $('#attributeOption');
            attributeOption.empty();
            var options = (resData && resData['option']) || resData;
            if (options && typeof options === 'object') {
                for (var opt in options) {
                    attributeOption.append('');
                }
            }
        }).catch(function() {}).finally(function() { hideLoading(); });
    });
    
    $('.ajax-delete').on('click', function () {
        var self = this;
        Weline.UI.dialog.request({
            title: '<lang>确认删除</lang>',
            tone: 'warning',
            cancelable: true,
            confirmTone: 'primary',
            cancelTone: 'neutral',
            confirmLabel: '<lang>确认</lang>',
            cancelLabel: '<lang>取消</lang>',
            reverseActions: true
        }).then(function(result) {
            if (result.confirmed) {
                showLoading();
                var delUrl = $(self).data('href');
                var req = bqAdmin['eav_admin'](delUrl, { silent: true });
                req.then(function(res) {
                    var data = (res && res.data) || res;
                    if (data && data['code'] == 1) {
                        Weline.UI.dialog.request({ title: '<lang>删除成功</lang>', tone: 'success', duration: 2000, confirmTone: 'primary', confirmLabel: '<lang>确认</lang>' }).then(function() { location.reload(); });
                    }
                }).catch(function() {}).finally(function() { hideLoading(); });
            }
        });
    });
})();
</js:part>
