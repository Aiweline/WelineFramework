<?php
/**
 * EAV unified manager page.
 *
 * @var \Weline\Framework\View\Template $this
 */
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
/** @var array{code:string,entityId:int,name:string}|null $entityScope */
$entityScope = is_array($this->getData('entityScope') ?? null) ? $this->getData('entityScope') : null;
$entityScopeError = trim((string)($this->getData('entityScopeError') ?? ''));
?>
<link rel="stylesheet" href="@static(Weline_Theme::ui/pages/weline-eav-manager.css)">

<div class="w-stack w-eav-manager-page" data-gap="lg">
    <?php if ($entityScope): ?>
        <header class="w-eav-manager-page__hero">
            <div class="w-eav-manager-page__hero-icon" aria-hidden="true">
                <w:icon name="layers" size="lg" />
            </div>
            <div class="w-eav-manager-page__hero-copy">
                <h1><?= $escape((string)__('%{1} 属性管理', $entityScope['name'])) ?></h1>
                <p><?= $escape((string)__('管理 %{1}（%{2}）的属性集、属性组与属性', [$entityScope['name'], $entityScope['code']])) ?></p>
            </div>
            <code class="w-eav-manager-page__hero-code"><?= $escape($entityScope['code']) ?></code>
        </header>
    <?php elseif ($entityScopeError !== ''): ?>
        <p class="w-eav-manager-page__intro w-text" data-tone="danger">
            <w:icon name="warning" size="sm" /> <?= $escape($entityScopeError) ?>
        </p>
    <?php else: ?>
        <p class="w-eav-manager-page__intro w-text" data-tone="muted">
            <?= $escape(__('按实体、属性集、属性组和属性维护 EAV 结构')) ?>
        </p>
    <?php endif; ?>

    <?= $this->fetch('Weline_Eav::templates/Backend/Manager/surface.phtml', [
        'entityScope' => $entityScope,
        'entityScopeError' => $entityScopeError,
        'compact' => true,
    ]) ?>
</div>

<script type="module" src="@static(Weline_Theme::ui/pages/weline-eav-manager.js)"></script>
