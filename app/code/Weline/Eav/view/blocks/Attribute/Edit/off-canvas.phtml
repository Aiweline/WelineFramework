<a class="w-field__addon link-info" style='cursor: pointer' type='button' aria-controls='{{id}}' data-w-target='#{{id}}' data-w-action="drawer.open">
    <w:icon name="language" size="sm"></w:icon><lang>{{target_button_text}}</lang>
</a>
<!-- {{id}} -->
<div class="w-drawer {{class_names}}" tabindex='-1' id='{{id}}' aria-labelledby='{{id}}Label' data-w-width="75" data-w-component="drawer" data-state="closed" hidden aria-hidden="true">
    <div class="w-drawer__header">
        <h5 id='{{id}}Label'>
            <lang>{{title}}</lang>
        </h5>
        <has name="close_button_show">
            <button type='button' class="w-button w-text" aria-label='{{close_button_text}}' data-w-action="drawer.close" data-w-close="" data-tone="quiet" data-size="sm"></button>
        </has>
    </div>
    <div class="w-drawer__body">
        <div data-w-position="relative" data-w-width="full" data-w-height="full">
            <iframe id='{{id}}Iframe' data-src="{{action}}" frameborder='0' data-w-width="full" data-w-height="full"></iframe>
        </div>
    </div>
</div>
<script>
    //weline:ui:drawer:before-open
    $('#{{id}}').on('weline:ui:drawer:before-open', function () {
        let Iframe = $('#{{id}}Iframe')
        Iframe.attr('src', Iframe.attr('data-src'))
    })
</script>