$adapterCallbackUrl = static function (array $adapter) use ($templateInstance, $scope): string {
    $callbackPathRaw = ltrim(trim((string)($adapter['callback-path'] ?? '')), '/');
    $fragment = '';
    $callbackPath = $callbackPathRaw;
    if (str_contains($callbackPathRaw, '#')) {
        [$callbackPath, $fragment] = \explode('#', $callbackPathRaw, 2);
        $callbackPath = ltrim(trim($callbackPath), '/');
        $fragment = trim($fragment);
    }
    $asOriginRaw = strtolower(trim((string)($adapter['callback-as-origin'] ?? '0')));
    $asOrigin = \in_array($asOriginRaw, ['1', 'true', 'yes', 'on'], true);
    $asHostRaw = strtolower(trim((string)($adapter['callback-as-host'] ?? '0')));
    $asHost = \in_array($asHostRaw, ['1', 'true', 'yes', 'on'], true);
    if ($callbackPath === '' && !$asOrigin && !$asHost) {
        return '';
    }

    $appendScopeRaw = strtolower(trim((string)($adapter['callback-append-scope'] ?? '1')));
    $appendScope = !\in_array($appendScopeRaw, ['0', 'false', 'no', 'off'], true);
    if ($appendScope && !$asOrigin && !$asHost && $scope === '') {
        return '';
    }

    // 与支付 OAuth redirect_uri 同源，避免展示地址与实际授权不一致
    if (!$asOrigin
        && !$asHost
        && $appendScope
        && (str_starts_with($callbackPath, 'payment/frontend/callback/')
            && !str_contains($callbackPath, '/return/')
            && !str_ends_with($callbackPath, '.cancel')
            && $callbackPath !== 'payment/frontend/callback/notify')
        && class_exists(\Weline\Payment\Service\PayPalOAuthService::class)
    ) {
        try {
            /** @var \Weline\Payment\Service\PayPalOAuthService $oauth */
            $oauth = \Weline\Framework\Manager\ObjectManager::getInstance(
                \Weline\Payment\Service\PayPalOAuthService::class
            );

            return $oauth->browserReturnUrl($scope);
        } catch (\Throwable) {
            // fall through to generic builder
        }
    }

    $resolvePath = $callbackPath !== '' ? $callbackPath : 'customer/account/login';
    $base = '';
    if (method_exists($templateInstance, 'getFrontendUrl')) {
        $base = trim((string)$templateInstance->getFrontendUrl($resolvePath));
    }
    if ($base === '') {
        $base = trim((string)$templateInstance->getUrl($resolvePath));
    }
    if ($base === '' || !preg_match('#^https?://#i', $base)) {
        return '';
    }

    if ($asOrigin || $asHost) {
        $parts = parse_url($base);
        if (!\is_array($parts) || empty($parts['scheme']) || empty($parts['host'])) {
            return '';
        }
        if ($asHost) {
            // Meta「应用域名」通常只要 host（不含 scheme/port/path）
            return (string)$parts['host'];
        }
        $origin = $parts['scheme'] . '://' . $parts['host'];
        if (isset($parts['port'])) {
            $origin .= ':' . $parts['port'];
        }

        return $origin;
    }

    if (!$appendScope) {
        // Fixed OAuth redirect_uri: never include storefront /CURRENCY/locale prefixes.
        $base = \Weline\Framework\Http\Url::withoutStorefrontLocalizationPrefix($base);

        return $fragment !== '' ? ($base . '#' . $fragment) : $base;
    }

    $parts = parse_url($base);
    if (!\is_array($parts) || empty($parts['scheme']) || empty($parts['host'])) {
        return '';
    }
    $query = [];
    if (!empty($parts['query']) && \is_string($parts['query'])) {
        parse_str($parts['query'], $query);
        if (!\is_array($query)) {
            $query = [];
        }
    }
    $query['target_scope'] = $scope;
    $rebuilt = $parts['scheme'] . '://' . $parts['host'];
    if (isset($parts['port'])) {
        $rebuilt .= ':' . $parts['port'];
    }
    $rebuilt .= $parts['path'] ?? '';
    $rebuilt .= '?' . http_build_query($query, '', '&', PHP_QUERY_RFC3986);
    if (!empty($parts['fragment'])) {
        $rebuilt .= '#' . $parts['fragment'];
    } elseif ($fragment !== '') {
        $rebuilt .= '#' . $fragment;
    }

    return $rebuilt;
};
$adapterAction = static function (array $adapter) use ($templateInstance, $adapterQueryParams, $adapterScopeParams): array {
    $url = '';
    $target = trim((string)($adapter['target'] ?? ''));
    $queryParams = array_merge($adapterQueryParams($adapter), $adapterScopeParams);

    if (!empty($adapter['external-url'])) {
        $url = trim((string)$adapter['external-url']);
        $target = $target !== '' ? $target : '_blank';
    } elseif (!empty($adapter['backend-url']) || !empty($adapter['manage-url'])) {
        $route = trim((string)($adapter['backend-url'] ?? $adapter['manage-url'] ?? ''));
        if ($route !== '') {
            if (str_contains($route, '://') || str_starts_with($route, '/')) {
                $url = $route;
                if ($queryParams !== []) {
                    $url .= (str_contains($url, '?') ? '&' : '?') . http_build_query($queryParams);
                }
            } else {
                $routePath = $route;
                $routeParams = [];
                if (str_contains($route, '?')) {
                    [$routePath, $routeQuery] = explode('?', $route, 2);
                    parse_str($routeQuery, $routeParams);
                    $routeParams = is_array($routeParams) ? $routeParams : [];
                }
                $url = (string)$templateInstance->getBackendUrl(
                    $routePath,
                    array_merge($routeParams, $queryParams),
                    false,
                );
            }
        }
    } elseif (!empty($adapter['frontend-url'])) {
        $route = trim((string)$adapter['frontend-url']);
        if ($route !== '') {
            if (str_contains($route, '://') || str_starts_with($route, '/')) {
                $url = $route;
                if ($queryParams !== []) {
                    $url .= (str_contains($url, '?') ? '&' : '?') . http_build_query($queryParams);
                }
            } elseif (method_exists($templateInstance, 'getFrontendUrl')) {
                $url = (string)$templateInstance->getFrontendUrl($route, $queryParams);
            } else {
                $url = (string)$templateInstance->getUrl($route, $queryParams);
            }
        }
    } elseif (!empty($adapter['url'])) {
        $url = trim((string)$adapter['url']);
        if ($queryParams !== []) {
            $url .= (str_contains($url, '?') ? '&' : '?') . http_build_query($queryParams);
        }
    }

    $connected = !empty($adapter['connected']);
    $actionLabel = trim((string)($adapter['action-label'] ?? ''));
    if ($connected) {
        $connectedActionLabel = trim((string)($adapter['action-label-connected'] ?? ''));
        if ($connectedActionLabel !== '') {
            $actionLabel = $connectedActionLabel;
        }
    }
    if ($actionLabel === '') {
        $actionLabel = (string)__('打开');
    }

    return [
        'url' => $url,
        'target' => $target,
        'label' => (string)__($actionLabel),
        'connected' => $connected,
    ];
};
$sourceKindTone = static function (string $sourceKind): string {
    return match ($sourceKind) {
        'exact' => 'success',
        'fallback' => 'info',
        'locked' => 'danger',
        'suppressed' => 'warning',
        default => 'neutral',
    };
};
