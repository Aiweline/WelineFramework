<?php
$flashMarkup = (string)\Weline\Framework\Manager\ObjectManager::getInstance(
    \Weline\Framework\Manager\MessageManager::class
);
$flashPlain = \Weline\Framework\Manager\MessageManager::htmlToPlainText($flashMarkup);
$flashTone = 'danger';
if (preg_match('/data-tone="([^"]+)"/', $flashMarkup, $flashToneMatch)) {
    $flashTone = (string)$flashToneMatch[1];
}
$flashToastFn = match ($flashTone) {
    'success' => 'success',
    'warning' => 'warning',
    'info', 'neutral' => 'info',
    default => 'error',
};
?>
<?php if ($flashPlain !== ''): ?>
<script>
(function () {
    var msg = <?= json_encode($flashPlain, JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) ?>;
    var fn = <?= json_encode($flashToastFn, JSON_THROW_ON_ERROR) ?>;
    function emitFlashToast() {
        var toast = window.Weline && window.Weline.UI && window.Weline.UI.toast;
        if (!toast || typeof toast[fn] !== 'function') {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', emitFlashToast, { once: true });
            } else {
                setTimeout(emitFlashToast, 60);
            }
            return;
        }
        toast[fn](msg);
    }
    emitFlashToast();
})();
</script>
<?php endif; ?>

