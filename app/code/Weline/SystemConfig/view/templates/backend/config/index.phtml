<?php
$flashMarkup = (string)\Weline\Framework\Manager\ObjectManager::getInstance(
    \Weline\Framework\Manager\MessageManager::class
);
$flashPlain = \Weline\Framework\Manager\MessageManager::htmlToPlainText($flashMarkup);
$flashTitle = '';
$flashBody = $flashPlain;
if (preg_match('/class="w-alert__title"[^>]*>(.*?)<\/strong>/is', $flashMarkup, $flashTitleMatch)) {
    $flashTitle = trim(html_entity_decode(strip_tags((string)$flashTitleMatch[1]), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
}
if (preg_match('/class="w-alert__message"[^>]*>(.*?)<\/span>/is', $flashMarkup, $flashBodyMatch)) {
    $rawBody = (string)$flashBodyMatch[1];
    $rawBody = preg_replace('/<br\s*\/?>/i', "\n", $rawBody) ?? $rawBody;
    $flashBody = trim(html_entity_decode(strip_tags($rawBody), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    $flashBody = preg_replace('/[^\S\n]+/u', ' ', $flashBody) ?? $flashBody;
}
if ($flashTitle !== '' && str_starts_with($flashPlain, $flashTitle)) {
    // Prefer structured title/body for toast hierarchy.
    $flashPlain = $flashBody !== '' ? ($flashTitle . "\n" . $flashBody) : $flashTitle;
}
$flashTone = 'danger';
if (preg_match('/data-tone="([^"]+)"/', $flashMarkup, $flashToneMatch)) {
    $flashTone = (string)$flashToneMatch[1];
}
$flashToastFn = match ($flashTone) {
    'success' => 'success',
    'warning' => 'warning',
    'info', 'neutral' => 'info',
    default => 'error',
};
?>
<?php if ($flashPlain !== ''): ?>
<script>
(function () {
    var msg = <?= json_encode($flashBody !== '' ? $flashBody : $flashPlain, JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) ?>;
    var title = <?= json_encode($flashTitle, JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) ?>;
    var fn = <?= json_encode($flashToastFn, JSON_THROW_ON_ERROR) ?>;
    function emitFlashToast() {
        var toast = window.Weline && window.Weline.UI && window.Weline.UI.toast;
        if (!toast || typeof toast[fn] !== 'function') {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', emitFlashToast, { once: true });
            } else {
                setTimeout(emitFlashToast, 60);
            }
            return;
        }
        if (title) {
            toast[fn](msg, { title: title, duration: 6500 });
        } else {
            toast[fn](msg, { duration: 6500 });
        }
    }
    emitFlashToast();
})();
</script>
<?php endif; ?>

