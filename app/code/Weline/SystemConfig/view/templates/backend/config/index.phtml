 * @var array $modules
 * @var array $tree
 * @var string $selected_module
 * @var string $selected_area
 * @var string $search
 * @var string $scope
 * @var string $locale
 * @var array $fallback_scopes
 * @var string $post_url
 * @var array $target_scope
 * @var array $scope_catalog
 * @var int $expected_grant_version
 */
$modules = $modules ?? [];
$tree = $tree ?? ['modules' => []];
$selectedModule = (string)($selected_module ?? '');
