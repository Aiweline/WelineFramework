$parseOptions = static function (string $options): array {
    $options = trim($options);
    if ($options === '' || str_starts_with($options, '$')) {
        return [];
    }
    $result = [];
    foreach (array_filter(array_map('trim', preg_split('/[,;]/', $options) ?: [])) as $option) {
        if (str_contains($option, ':')) {
            [$value, $label] = explode(':', $option, 2);
            $result[trim($value)] = trim($label);
        } else {
            $result[$option] = $option;
        }
    }
    return $result;
};
$resolveFieldOptions = static function (array $field) use ($parseOptions): array {
    $options = $parseOptions((string)($field['options'] ?? ''));
    $source = strtolower(trim((string)($field['options-source'] ?? $field['options_source'] ?? '')));
    if ($source === 'i18n:countries' || $source === 'countries') {
        try {
            /** @var \Weline\I18n\Model\I18n $i18n */
            $i18n = \Weline\Framework\Manager\ObjectManager::getInstance(\Weline\I18n\Model\I18n::class);
            $locale = (string)(\Weline\Framework\App\State::getLangLocal() ?: 'zh_Hans_CN');
            $countries = $i18n->getCountries($locale);
            if (is_array($countries) && $countries !== []) {
                $resolved = [];
                foreach ($countries as $code => $name) {
                    $code = strtoupper(trim((string)$code));
                    if ($code === '' || !preg_match('/\A[A-Z]{2}\z/D', $code)) {
                        continue;
                    }
                    $label = trim((string)$name);
                    $resolved[$code] = $label !== '' ? ($label . ' (' . $code . ')') : $code;
                }
                if ($resolved !== []) {
                    asort($resolved, SORT_NATURAL | SORT_FLAG_CASE);
                    return $resolved;
                }
            }
        } catch (\Throwable) {
            // Fall through to literal options / empty.
        }
    }
    return $options;
};
$splitCsvValues = static function (string $raw): array {
