<?php
/**
 * Default shell for <w:config:embed>.
 *
 * @var array<string, mixed> $embed
 * @var string $embedFieldPartial
 */
$layout = htmlspecialchars((string)($embed['layout'] ?? 'vertical'), ENT_QUOTES, 'UTF-8');
$module = htmlspecialchars((string)($embed['module'] ?? ''), ENT_QUOTES, 'UTF-8');
$area = htmlspecialchars((string)($embed['area'] ?? 'backend'), ENT_QUOTES, 'UTF-8');
$storageScope = htmlspecialchars((string)($embed['storage_scope'] ?? 'default.default.default'), ENT_QUOTES, 'UTF-8');
$locale = htmlspecialchars((string)($embed['locale'] ?? 'default'), ENT_QUOTES, 'UTF-8');
$grantVersion = (int)($embed['expected_grant_version'] ?? 0);
$canUpdate = !empty($embed['can_update']);
$denyTip = (string)($embed['deny_tip'] ?? '');
$ok = !empty($embed['ok']);
$blockError = (string)($embed['error'] ?? '');
$target = is_array($embed['target'] ?? null) ? $embed['target'] : [];
$items = is_array($embed['items'] ?? null) ? $embed['items'] : [];

static $wConfigEmbedAssets = false;
if (!$wConfigEmbedAssets) {
    $wConfigEmbedAssets = true;
    $cssUrl = trim((string)($embedCssUrl ?? ''));
    $jsUrl = trim((string)($embedJsUrl ?? ''));
    if ($cssUrl !== '') {
        echo '<link rel="stylesheet" href="' . htmlspecialchars($cssUrl, ENT_QUOTES, 'UTF-8') . '" data-no-extract="true">';
    }
    if ($jsUrl !== '') {
        echo '<script defer src="' . htmlspecialchars($jsUrl, ENT_QUOTES, 'UTF-8') . '" data-no-extract="true"></script>';
    }
}
?>
<div
    class="w-config-embed layout-<?= $layout ?><?= $ok ? '' : ' is-error' ?><?= $canUpdate ? '' : ' is-readonly' ?>"
    data-w-config-embed
    data-testid="config-embed"
    data-module="<?= $module ?>"
    data-area="<?= $area ?>"
    data-locale="<?= $locale ?>"
    data-storage-scope="<?= $storageScope ?>"
    data-website-code="<?= htmlspecialchars((string)($target['website_code'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
    data-store-code="<?= htmlspecialchars((string)($target['store_code'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
    data-channel-code="<?= htmlspecialchars((string)($target['channel_code'] ?? ''), ENT_QUOTES, 'UTF-8') ?>"
    data-grant-version="<?= $grantVersion ?>"
    data-can-update="<?= $canUpdate ? '1' : '0' ?>"
    data-layout="<?= $layout ?>"
>
    <?php if ($blockError !== '' && (!$ok || $items === [])): ?>
        <div class="w-alert" data-tone="danger" data-testid="config-embed-block-error">
            <?= htmlspecialchars($blockError, ENT_QUOTES, 'UTF-8') ?>
        </div>
    <?php endif; ?>

    <?php if (!$canUpdate && $denyTip !== '' && $ok): ?>
        <div class="w-alert" data-tone="warning" data-testid="config-embed-acl-tip" title="<?= htmlspecialchars($denyTip, ENT_QUOTES, 'UTF-8') ?>">
            <?= htmlspecialchars($denyTip, ENT_QUOTES, 'UTF-8') ?>
        </div>
    <?php endif; ?>

    <?php if ($ok && $items !== []): ?>
        <div class="w-config-embed__list" data-w-config-embed-list>
            <?php foreach ($items as $item): ?>
                <?php
                if (!is_array($item)) {
                    continue;
                }
                $kind = (string)($item['kind'] ?? 'field');
                if ($kind === 'hint'):
                    $hintTone = htmlspecialchars((string)($item['type'] ?? 'info'), ENT_QUOTES, 'UTF-8');
                    ?>
                    <div class="w-config-embed__hint w-alert" data-tone="<?= $hintTone ?>" data-testid="config-embed-hint">
                        <?= htmlspecialchars((string)($item['text'] ?? ''), ENT_QUOTES, 'UTF-8') ?>
                    </div>
                <?php elseif ($kind === 'adapter'): ?>
                    <div class="w-config-embed__adapter" data-testid="config-embed-adapter">
                        <div class="w-config-embed__label"><?= htmlspecialchars((string)($item['label'] ?? ''), ENT_QUOTES, 'UTF-8') ?></div>
                        <?php if ((string)($item['description'] ?? '') !== ''): ?>
                            <div class="w-text" data-tone="muted" data-size="sm"><?= htmlspecialchars((string)$item['description'], ENT_QUOTES, 'UTF-8') ?></div>
                        <?php endif; ?>
                        <?php if ((string)($item['manage_url'] ?? '') !== ''): ?>
                            <a class="w-btn" data-variant="secondary" data-size="sm" href="<?= htmlspecialchars((string)$item['manage_url'], ENT_QUOTES, 'UTF-8') ?>">
                                <lang>管理</lang>
                            </a>
                        <?php endif; ?>
                    </div>
                <?php else: ?>
                    <?php
                    $fieldSource = (string)($embedFieldSource ?? 'Weline_SystemConfig::templates/taglib/config-embed-field.phtml');
                    echo $block->fetchHtml($fieldSource, ['field' => $item]);
                    ?>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
