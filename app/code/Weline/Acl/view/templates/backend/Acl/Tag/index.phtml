<?php
/**
 * ACL 标签元数据管理
 * @var \Weline\Framework\View\Template $this
 */
$tags = $this->getData('tags') ?: [];
$tagCount = \is_array($tags) ? \count($tags) : 0;
$withMeta = 0;
$totalResources = 0;
foreach ($tags as $row) {
    $totalResources += (int)($row['resource_count'] ?? 0);
    if (!empty($row['has_meta'])) {
        $withMeta++;
    }
}
