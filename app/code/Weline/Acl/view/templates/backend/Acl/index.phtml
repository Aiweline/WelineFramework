<?php
/** * ACL 权限管理列表页 * @var \Weline\Framework\View\Template $this */ $acls = $this->getData('acls') ?: [];
$filterTypes = $this->getData('filter_types') ?: [ \Weline\Acl\Model\Acl::type_MENUS, \Weline\Acl\Model\Acl::type_PC, \Weline\Acl\Model\Acl::type_API, \Weline\Acl\Model\Acl::type_QUERY, \Weline\Acl\Model\Acl::type_TASK, \Weline\Acl\Model\Acl::type_OPERATION,
];
$typeStats = $this->getData('type_stats');
if (!\is_array($typeStats)) { $typeStats = []; foreach ($acls as $acl) { $type = $acl->getType() ?: 'other'; $typeStats[$type] = ($typeStats[$type] ?? 0) + 1; }
}
foreach ($filterTypes as $filterType) { if (!isset($typeStats[$filterType])) { $typeStats[$filterType] = 0; }
}
$totalCount = (int)($this->getData('stat_total') ?? \count($acls));
$moduleCount = (int)($this->getData('stat_module_count') ?? 0);
$typeCount = (int)($this->getData('stat_type_count') ?? \count(\array_filter($typeStats)));
$currentType = (string)($this->getData('current_type') ?: '');
$currentModule = (string)($this->getData('current_module') ?: '');
$currentTagsValue = (string)($this->getData('current_tags_value') ?: '');
$currentSearch = (string)($this->request->getGet('search') ?: '');
$listDimension = (string)($this->getData('list_dimension') ?: 'module');
$isTagDimension = $listDimension === 'tag';
$listBaseRoute = (string)($this->getData('list_base_route') ?: ($isTagDimension ? '*/backend/acl/by-tag' : '*/backend/acl'));
$moduleListPath = '*/backend/acl';
$tagListPath = '*/backend/acl/by-tag';
$buildFilterParams = static function (array $overrides = []) use ( $currentSearch, $currentType, $currentModule, $currentTagsValue, $isTagDimension
): array { $params = [ 'search' => $currentSearch, 'type' => $currentType, ]; if ($isTagDimension) { $params['tags'] = $currentTagsValue; } else { $params['module'] = $currentModule; } foreach ($overrides as $key => $value) { $params[$key] = $value; } $query = []; foreach ($params as $key => $value) { $value = \trim((string)$value); if ($value === '') { continue; } $query[$key] = $value; } return $query;
}; $hasActiveFilters = $currentType !== '' || $currentSearch !== '' || ($isTagDimension ? $currentTagsValue !== '' : $currentModule !== '');
?>
