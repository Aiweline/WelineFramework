><lang>涉及模块</lang></div> </div> </div> <div class="weline-acl-stat-card"> <div class="weline-acl-stat-icon info"> <w:icon name="circle" size="sm"></w:icon> </div> <div class="weline-acl-stat-content"> <div class="weline-acl-stat-value"><?php echo $typeCount; ?></div> <div class="weline-acl-stat-label"><lang>资源类型数</lang></div> </div> </div> </div> <!-- 分类型统计 --> <div class="weline-acl-stats-row acl-offset-top" > <?php $typeIcons = [ 'menus' => 'menu', 'pc' => 'api', 'api' => 'cloud-outline', 'query' => 'database-search', 'task' => 'timeline-clock', 'operation' => 'wrench', ]; foreach ($filterTypes as $statType): $statCount = (int)($typeStats[$statType] ?? 0); $label = \Weline\Acl\Service\Resource\AclResourcePresentation::typeLabel((string)$statType); $isActive = $currentType === (string)$statType; $typeParams = $buildFilterParams(['type' => $isActive ? '' : (string)$statType]); ?> <a class="weline-acl-stat-card<?php echo $isActive ? ' is-active' : ''; ?><?php echo $statCount === 0 ? ' is-muted' : ''; ?>" href="@backend-url{$listBaseRoute|$typeParams}" title="<?php echo htmlspecialchars($label); ?>"> <div class="weline-acl-stat-icon warning"> <i class="mdi mdi-<?php echo htmlspecialchars($typeIcons[$statType] ?? 'key'); ?>"></i> </div> <div class="weline-acl-stat-content"> <div class="weline-acl-stat-value"><?php echo $statCount; ?></div> <div class="weline-acl-stat-label"><?php echo htmlspecialchars($label); ?></div> </div> </a> <?php endforeach; ?> </div> <!-- 工具栏 --> <div class="weline-acl-toolbar"> <div class="weline-acl-toolbar-row"> <!-- 搜索框 --> <div class="weline-acl-search-box"> <w:form action="@backend-url{$listBaseRoute}" method="get" class="weline-acl-search-form" id="acl-list-filter-form"> <div class="weline-acl-search-input"> <w:icon name="search" size="sm"></w:icon> <input type="text" name="search" value="<?php echo htmlspecialchars($currentSearch); ?>" placeholder="<?php echo $isTagDimension ? __('搜索权限名称、ID、标签...') : __('搜索权限名称、ID、路由...'); ?>"> </div> <button type="submit" class="weline-acl-search-btn"> <w:icon name="search" size="sm"></w:icon> <lang>搜索</lang> </button> </w:form> </div> <!-- 筛选器：模块维只用模块；标签维只用标签 --> <div class="weline-acl-filters"> <select id="acl-filter-type" class="weline-acl-filter-select" name="type" form="acl-list-filter-form" onchange="this.form.submit()"> <option value=""><?php echo __('所有类型'); ?></option> <?php foreach ($filterTypes as $filterType): ?> <option value="<?php echo htmlspecialchars((string)$filterType); ?>" <?php echo $currentType === (string)$filterType ? 'selected' : ''; ?>> <?php echo htmlspecialchars(\Weline\Acl\Service\Resource\AclResourcePresentation::typeLabel((string)$filterType)); ?> (<?php echo (int)($typeStats[$filterType] ?? 0); ?>) </option> <?php endforeach; ?> </select> <?php if ($isTagDimension): $acl_tag_filter_empty = __('所有标签'); $acl_tag_filter_placeholder = __('搜索标签'); $acl_tag_filter_value = $currentTagsValue; $acl_tag_filter_options_json = (string)($this->getData('acl_tag_filter_options_json') ?: '[]'); ?> <w:acl:tag:select id="acl-filter-tags" name="tags" value="acl_tag_filter_value" options="acl_tag_filter_options_json" empty-label="acl_tag_filter_empty" placeholder="acl_tag_filter_placeholder" class="weline-acl-tag-filter" form="acl-list-filter-form" on-change="var f=document.getElementById('acl-list-filter-form'); if(f){f.requestSubmit ? f.requestSubmit() : f.submit();}" /> <?php else: $acl_module_filter_empty = __('所有模块'); $acl_module_filter_placeholder = __('搜索模块名称'); ?> <w:module-manager:module:select id="acl-filter-module" name="module" value="current_module" allow-empty="true" clearable="true" empty-label="acl_module_filter_empty" placeholder="acl_module_filter_placeholder" class="weline-acl-module-filter" form="acl-list-filter-form" on-change="var f=document.getElementById('acl-list-filter-form'); if(f){f.requestSubmit ? f.requestSubmit() : f.submit();}" /> <?php endif; ?> </div> </div> </div> <!-- 权限列表 --> <div class="weline-acl-table-card"> <div class="weline-acl-table-header"> <span class="weline-acl-table-title"> <w:icon name="list" size="sm"></w:icon> <lang>权限列表</lang> </span> <span class="acl-muted-sm"> <lang>共</lang> <strong id="visible-count"><?php echo $totalCount; ?></strong> <lang>条记录</lang> </span> </div> <div class="weline-acl-table-body"> <?php if (empty($acls)): ?> <div class="weline-acl-empty"> <w:icon name="database" size="sm"></w:icon> <p><lang>暂无权限数据</lang></p> </div> <?php else: ?> <table class="weline-acl-table" id="acl-table"> <thead> <tr> <th><lang>资源标识</lang></th> <th><lang>资源名称</lang></th> <th><lang>类型</lang></th> <th><lang>标签</lang></th> <th><lang>请求方法</lang></th> <th><lang>路由</lang></th> <th><lang>所属模块</lang></th> <th><lang>更新时间</lang></th> </tr> </thead> <tbody> <?php foreach ($acls as $acl): ?> <?php $type = $acl->getType() ?: 'other'; $method = strtolower($acl->getMethod() ?: 'all'); $typeClass = 'type-' . $type; $methodClass = $method; $typeLabel = \Weline\Acl\Service\Resource\AclResourcePresentation::typeLabel($type); $sourceId = (string)$acl->getSourceId(); $sourceParts = explode('::', $sourceId, 2); $sourceModule = $sourceParts[0] ?? $sourceId; $sourceCode = $sourceParts[1] ?? ''; $route = trim((string)($acl->getRoute() ?: '')); $moduleName = trim((string)($acl->getModule() ?: '')); $updatedAt = (string)($acl->getUpdateTime() ?: $acl->getCreateTime() ?: ''); $tags = \Weline\Acl\Service\Resource\AclResourcePresentation::tagsFromSourceId( $sourceId, (string)$acl->getData(\Weline\Acl\Model\Acl::schema_fields_RESOURCE_METADATA) ); ?> <tr data-type="<?php echo htmlspecialchars($type); ?>" data-module="<?php echo htmlspecialchars($moduleName); ?>"> <td> <code class="weline-acl-source-id" title="<?php echo htmlspecialchars($sourceId); ?>"> <span class="sid-module"><?php echo htmlspecialchars($sourceModule); ?></span><?php if ($sourceCode !== ''): ?><span class="sid-sep">::</span><span class="sid-code"><?php echo htmlspecialchars($sourceCode); ?></span><?php endif; ?> </code> </td> <td> <span class="weline-acl-source-name"><?php echo htmlspecialchars($acl->getSourceName() ?: '—'); ?></span> <?php if ($acl->getDocument()): ?> <span class="weline-acl-source-doc"><?php echo htmlspecialchars((string)$acl->getDocument()); ?></span> <?php endif; ?> </td> <td> <span class="weline-acl-badge <?php echo htmlspecialchars($typeClass); ?>"> <i class="mdi mdi-<?php echo htmlspecialchars(\Weline\Acl\Service\Resource\AclResourcePresentation::typeIcon($type)); ?>"></i> <?php echo htmlspecialchars($typeLabel); ?> </span> </td> <td> <?php if ($tags === []): ?> <span class="weline-acl-empty-cell">—</span> <?php else: ?> <div class="weline-acl-tag-list"> <?php foreach ($tags as $tag): $tagJumpParams = ['tags' => $tag]; ?> <a class="weline-acl-tag-chip" href="@backend-url{$tagListPath|$tagJumpParams}" title="<?php echo htmlspecialchars(__('在标签维度查看')); ?>"> <?php echo htmlspecialchars($tag); ?> </a> <?php endforeach; ?> </div> <?php endif; ?> </td> <td> <span class="weline-acl-method <?php echo htmlspecialchars($methodClass); ?>"> <?php echo strtoupper($acl->getMethod() ?: 'ALL'); ?> </span> </td> <td> <?php if ($route === ''): ?> <span class="weline-acl-empty-cell">—</span> <?php else: ?> <span class="weline-acl-route" title="<?php echo htmlspecialchars($route); ?>"><?php echo htmlspecialchars($route); ?></span> <?php endif; ?> </td> <td> <?php if ($moduleName === ''): ?> <span class="weline-acl-empty-cell">—</span> <?php else: $moduleJumpParams = ['module' => $moduleName]; ?> <a class="weline-acl-module" href="@backend-url{$moduleListPath|$moduleJumpParams}" title="<?php echo htmlspecialchars(__('在模块维度查看') . ': ' . $moduleName); ?>"><?php echo htmlspecialchars($moduleName); ?></a> <?php endif; ?> </td> <td> <?php if ($updatedAt === ''): ?> <span class="weline-acl-empty-cell">—</span> <?php else: $timeTs = strtotime($updatedAt); $timeDate = $timeTs ? date('Y-m-d', $timeTs) : $updatedAt; $timeClock = $timeTs ? date('H:i:s', $timeTs) : ''; ?> <span class="weline-acl-time" title="<?php echo htmlspecialchars($updatedAt); ?>"> <span class="time-date"><?php echo htmlspecialchars($timeDate); ?></span> <?php if ($timeClock !== ''): ?> <span class="time-clock"><?php echo htmlspecialchars($timeClock); ?></span> <?php endif; ?> </span> <?php endif; ?> </td> </tr> <?php endforeach; ?> </tbody> </table> <?php endif; ?> </div> <?php if (!empty($acls)): ?> <div class="weline-acl-pagination"> {{pagination}} </div> <?php endif; ?> </div>
