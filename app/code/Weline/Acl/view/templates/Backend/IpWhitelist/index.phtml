                    <button type="button" class="w-button" data-w-action="dialog.close" data-tone="neutral"><lang>取消</lang></button>
                    <button type="submit" class="w-button" data-tone="primary"><lang>保存</lang></button>
                </div>
            </w:form>
        </div>
    </div>
</div>



<script>
(function() {
    'use strict';

    function confirmAction(message) {
        return Weline.UI.dialog.confirm(message, {tone: 'warning'});
    }
    
    window.showAddModal = function() {
        document.getElementById('modalTitle').textContent = '<?= __('添加IP白名单') ?>';
        document.getElementById('item_id').value = '0';
        document.getElementById('ip').value = '';
        document.getElementById('description').value = '';
        document.getElementById('is_active').checked = true;
        Weline.UI.dialog.open('#ipWhitelistModal');
    };
    
    window.editItem = function(id) {
        Weline.UI.toast.info('<?= __('编辑ID：') ?>' + id);
    };
    
    window.saveItem = function(event) {
        event.preventDefault();
        var formData = new FormData(event.target);
        var id = formData.get('id');
        var form = event.target;
        form.dataset.ipWhitelistState = 'submitting';
        delete form.dataset.ipWhitelistError;
        if (id === '0') {
            var runCreate = function(api) {
                return api.resource('acl').createIpWhitelist({
                    ip: String(formData.get('ip') || ''),
                    description: String(formData.get('description') || ''),
                    is_active: formData.getAll('is_active').indexOf('1') !== -1
                });
            };
            var createPromise = (window.Weline && window.Weline.load)
                ? window.Weline.load('api').then(runCreate)
                : Promise.resolve(runCreate(window.Weline.Api));
            createPromise.then(function(result) {
                var data = result && result.data && result.success === undefined ? result.data : result;
                if (data && data.success) {
                    form.dataset.ipWhitelistState = 'created';
                    Weline.UI.toast.success(data.message);
                    Weline.UI.dialog.close('#ipWhitelistModal');
                    setTimeout(function() { location.reload(); }, 250);
                    return;
                }
                form.dataset.ipWhitelistState = 'failed';
                form.dataset.ipWhitelistError = String(data && data.message || '<?= __('操作失败') ?>');
                Weline.UI.toast.error(form.dataset.ipWhitelistError);
            }).catch(function(error) {
                form.dataset.ipWhitelistState = 'failed';
                form.dataset.ipWhitelistError = String(error && error.message || error || '<?= __('操作失败') ?>');
                Weline.UI.toast.error(form.dataset.ipWhitelistError);
            });
            return;
        }
        var url = id === '0' 
            ? '<?= $this->getBackendUrl('*/backend/ip-whitelist/add') ?>'
            : '<?= $this->getBackendUrl('*/backend/ip-whitelist/edit') ?>';
        
        Weline.adminRequest('acl', url, {
            method: 'POST',
            body: formData
        })
        .then(function(response){ return response; })
        .then(function(data) {
            if (data.success) {
                form.dataset.ipWhitelistState = 'updated';
                Weline.UI.toast.success(data.message);
                Weline.UI.dialog.close('#ipWhitelistModal');
                setTimeout(function() {
                    location.reload();
                }, 1000);
            } else {
                form.dataset.ipWhitelistState = 'failed';
                form.dataset.ipWhitelistError = String(data.message || '');
                Weline.UI.toast.error(data.message);
            }
        })
        .catch(function(error) {
            form.dataset.ipWhitelistState = 'failed';
            form.dataset.ipWhitelistError = String(error && error.message || error || '');
            Weline.UI.toast.error('<?= __('操作失败') ?>');
        });
    };
    
    window.toggleStatus = function(id, currentStatus) {
        confirmAction('<?= __('确定要切换状态吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
            
            var formData = new FormData();
            formData.append('id', id);
            
            var url = '<?= $this->getBackendUrl('*/backend/ip-whitelist/toggle') ?>';
            var opts = { method: 'POST', body: formData };
            Weline.adminRequest('acl', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('操作失败') ?>');
            });
        });
    };
    
    window.deleteItem = function(id) {
        confirmAction('<?= __('确定要删除这条记录吗？') ?>').then(function(confirmed) {
            if (!confirmed) return;
            
            var formData = new FormData();
            formData.append('id', id);
            
            var url = '<?= $this->getBackendUrl('*/backend/ip-whitelist/delete') ?>';
            var opts = { method: 'POST', body: formData };
            Weline.adminRequest('acl', url, opts)
            .then(function(res) {
                var data = (res && res.data) !== undefined ? res.data : res;
                if (data.success) {
                    Weline.UI.toast.success(data.message);
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                } else {
                    Weline.UI.toast.error(data.message);
                }
            })
            .catch(function(error) {
                Weline.UI.toast.error('<?= __('操作失败') ?>');
            });
        });
    };

    document.addEventListener('click', function(event) {
        var target = event.target;
        if (!(target instanceof Element)) {
            return;
        }

        var actionBtn = target.closest('[data-ip-whitelist-action]');
        if (!actionBtn) {
            return;
        }

        event.preventDefault();
        var id = actionBtn.dataset.itemId || '0';
        switch (actionBtn.dataset.ipWhitelistAction) {
            case 'add':
                window.showAddModal();
                break;
            case 'edit':
                window.editItem(id);
                break;
            case 'toggle':
                window.toggleStatus(id, actionBtn.dataset.currentStatus === '1' ? 1 : 0);
                break;
            case 'delete':
                window.deleteItem(id);
                break;
        }
    });

    var form = document.querySelector('[data-ip-whitelist-form]');
    if (form) {
        form.addEventListener('submit', window.saveItem);
    }
})();
</script>
