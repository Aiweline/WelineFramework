            <w:form id="ipWhitelistForm" data-ip-whitelist-form="1">
                <div class="w-dialog__body">
                    <input type="hidden" id="item_id" name="id" value="0">
                    <div style="--w-mb:var(--weline-space-4);">
                        <label class="w-field__label"><lang>IP地址</lang> <span class="w-text" data-tone="danger">*</span></label>
