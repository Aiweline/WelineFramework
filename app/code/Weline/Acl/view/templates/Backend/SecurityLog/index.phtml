<?php
/**
 * 安全日志列表页面 - 内容模板
 *
 * @var \Weline\Framework\View\Template $this
 * @var array $logs
 * @var int $total
 * @var int $page
 * @var int $limit
 * @var int $total_pages
 * @var string $event_type
 * @var string $keyword
 * @var array $event_types
 */

$logs = $logs ?? [];
$total = (int)($total ?? 0);
$page = (int)($page ?? 1);
$limit = (int)($limit ?? 20);
$totalPages = (int)($total_pages ?? 0);
$eventType = $event_type ?? '';
$keyword = $keyword ?? '';
$eventTypes = $event_types ?? [];
// 闭包替代全局函数，避免模板被多次包含时 Cannot redeclare function（禁止在模板中定义全局函数）
$getEventTypeBadgeClass = function ($eventType) {
    $classes = [
        \Weline\Acl\Model\SecurityLog::EVENT_LOGIN_FAILED => 'danger',
        \Weline\Acl\Model\SecurityLog::EVENT_LOGIN_SUCCESS => 'success',
        \Weline\Acl\Model\SecurityLog::EVENT_PERMISSION_DENIED => 'warning',
        \Weline\Acl\Model\SecurityLog::EVENT_ACL_VIOLATION => 'danger',
        \Weline\Acl\Model\SecurityLog::EVENT_SUSPICIOUS_ACTIVITY => 'warning',
    ];
    return $classes[$eventType] ?? 'secondary';
};
?>
<!-- 页面标题 -->
<div class="w-grid" data-testid="acl-security-log-management">
    <div style="--w-span:12;">
        <div class="w-backend-page__heading w-cluster" data-align="center" data-justify="between">
            <h4 class="w-text" style="--w-mb-sm:0;--w-font-size:1.125rem;"><lang>安全日志</lang></h4>
        </div>
    </div>
</div>

<!-- 消息提示区域 -->
<div class="w-grid">
    <div style="--w-span:12;">
        <template>Weline_Component::message.phtml</template>
    </div>
</div>

<!-- 搜索和筛选 -->
<div class="w-grid">
    <div style="--w-span-lg:12;">
        <div class="w-card">
            <div class="w-card__body">
                <w:form method="get" action="@var($this->getBackendUrl('*/backend/security-log'))" class="w-grid" style="--w-gap:var(--weline-space-4);">
                    <div style="--w-span-md:3;">
                        <label class="w-field__label"><lang>事件类型</lang></label>
                        <select class="w-select" name="event_type">
                            <option value=""><lang>全部</lang></option>
                            <?php foreach ($eventTypes as $type => $label): ?>
                            <option value="<?= $type ?>" <?= $eventType === $type ? 'selected' : '' ?>>
                                <?= htmlspecialchars($label) ?>
                            </option>
                            <?php endforeach; ?>
                        </select>
                    </div>
                    <div style="--w-span-md:6;">
                        <label class="w-field__label"><lang>关键词</lang></label>
                        <input type="text" class="w-input" name="keyword" value="<?= htmlspecialchars($keyword) ?>" placeholder="<?= __('搜索消息或IP地址') ?>">
                    </div>
                    <div style="--w-span-md:3;">
                        <label class="w-field__label">&nbsp;</label>
                        <div>
                            <button type="submit" class="w-button" data-tone="primary">
                                <w:icon name="search" size="sm"></w:icon><lang>搜索</lang>
                            </button>
                            <a href="<?= $this->getBackendUrl('*/backend/security-log') ?>" class="w-button" data-tone="neutral">
                                <w:icon name="refresh" size="sm"></w:icon><lang>重置</lang>
                            </a>
                        </div>
                    </div>
                </w:form>
            </div>
        </div>
    </div>
</div>

<!-- 日志列表 -->
<div class="w-grid">
    <div style="--w-span-lg:12;">
        <div class="w-card">
            <div class="w-card__body">
                <h4 class="w-card__title" style="--w-mb:var(--weline-space-6);"><lang>日志列表</lang></h4>
                
                <?php if (!empty($logs)): ?>
                <div class="w-table-wrap">
                    <table class="w-table" data-w-vertical="middle" style="--w-mb:0;">
                        <thead>
                            <tr>
                                <th><lang>ID</lang></th>
                                <th><lang>事件类型</lang></th>
                                <th><lang>用户ID</lang></th>
                                <th><lang>IP地址</lang></th>
                                <th><lang>消息</lang></th>
                                <th><lang>创建时间</lang></th>
                                <th><lang>操作</lang></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($logs as $log): ?>
                            <?php 
                            $logData = is_object($log) ? $log->getData() : $log;
                            $eventTypeLabel = $eventTypes[$logData['event_type'] ?? ''] ?? $logData['event_type'] ?? '';
                            ?>
                            <tr>
                                <td><?= $logData['log_id'] ?? $logData['id'] ?? '' ?></td>
                                <td>
                                    <span class="w-badge bg-<?= $getEventTypeBadgeClass($logData['event_type'] ?? '') ?>">
                                        <?= htmlspecialchars($eventTypeLabel) ?>
                                    </span>
                                </td>
                                <td><?= $logData['user_id'] ?? '-' ?></td>
                                <td><?= htmlspecialchars($logData['ip'] ?? '-') ?></td>
                                <td><?= htmlspecialchars($logData['message'] ?? '-') ?></td>
                                <td><?= $logData['created_at'] ?? '-' ?></td>
                                <td>
                                    <button type="button" class="w-button" data-security-log-details="1" data-log-id="<?= $logData['log_id'] ?? $logData['id'] ?? 0 ?>" data-tone="info" data-size="sm">
                                        <lang>查看详情</lang>
                                    </button>
                                </td>
                            </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>

                <!-- 分页 -->
                <?php if ($totalPages > 1): ?>
                <div class="w-grid" style="--w-mt:var(--weline-space-6);">
                    <div style="--w-span:12;--w-span-md:5;">
                        <div class="dataTables_info">
                            <lang>显示</lang> <?= (($page - 1) * $limit + 1) ?> 
                            <lang>到</lang> <?= min($page * $limit, $total) ?> 
                            <lang>共</lang> <?= $total ?> <lang>条记录</lang>
                        </div>
                    </div>
                    <div style="--w-span:12;--w-span-md:7;">
                        <div class="dataTables_paginate paging_simple_numbers">
                            <ul class="w-pagination">
                                <?php if ($page > 1): ?>
                                <li class="paginate_button w-pagination__item previous">
                                    <a href="?page=<?= $page - 1 ?>&event_type=<?= urlencode($eventType) ?>&keyword=<?= urlencode($keyword) ?>" class="w-pagination__link">
                                        <lang>上一页</lang>
                                    </a>
                                </li>
                                <?php endif; ?>
                                
                                <?php for ($i = max(1, $page - 2); $i <= min($totalPages, $page + 2); $i++): ?>
                                <li class="paginate_button w-pagination__item <?= $i === $page ? 'active' : '' ?>">
                                    <a href="?page=<?= $i ?>&event_type=<?= urlencode($eventType) ?>&keyword=<?= urlencode($keyword) ?>" class="w-pagination__link">
                                        <?= $i ?>
                                    </a>
                                </li>
                                <?php endfor; ?>
                                
                                <?php if ($page < $totalPages): ?>
                                <li class="paginate_button w-pagination__item next">
                                    <a href="?page=<?= $page + 1 ?>&event_type=<?= urlencode($eventType) ?>&keyword=<?= urlencode($keyword) ?>" class="w-pagination__link">
                                        <lang>下一页</lang>
                                    </a>
                                </li>
                                <?php endif; ?>
                            </ul>
                        </div>
                    </div>
                </div>
                <?php endif; ?>

                <?php else: ?>
                <div class="w-text" data-align="center" data-tone="muted" style="--w-pt:var(--weline-space-12);--w-pb:var(--weline-space-12);">
                    <w:icon name="warning" size="sm"></w:icon>
                    <p style="--w-mt:var(--weline-space-4);"><lang>暂无安全日志记录</lang></p>
                </div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    
    window.viewDetails = function(logId) {
        Weline.UI.toast.info('<?= __('查看日志ID：') ?>' + logId);
    };

    document.addEventListener('click', function(event) {
        var target = event.target;
        if (!(target instanceof Element)) {
            return;
        }

        var detailsBtn = target.closest('[data-security-log-details]');
        if (!detailsBtn) {
            return;
        }

        event.preventDefault();
        window.viewDetails(detailsBtn.dataset.logId || '0');
    });
})();
</script>
