<script>
(function() {
    'use strict';
    // 类型/模块筛选走服务端 ?type=&module=；快捷键聚焦搜索框
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
            e.preventDefault();
            var searchInput = document.querySelector('.weline-acl-search-input input');
            if (searchInput) {
                searchInput.focus();
            }
        }
    });
})();
</script>
