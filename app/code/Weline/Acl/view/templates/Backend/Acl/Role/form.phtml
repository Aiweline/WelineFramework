<?php
/** @var \Weline\Framework\View\Template $this */
$role = $this->getData('edit_role');
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$value = static function (mixed $item, string $key, mixed $default = ''): mixed {
    if (is_array($item)) return $item[$key] ?? $default;
    if (is_object($item) && method_exists($item, 'getData')) return $item->getData($key) ?? $default;
    return $default;
};
$roleId = max(0, (int)$value($role, 'role_id'));
$action = (string)($this->getData('action') ?: $this->getBackendUrl('*/backend/acl/role/add'));
?>
<main class="w-backend-page w-stack">
    <header class="w-backend-page__heading">
        <div class="w-stack"><h1><w:icon name="<?= $roleId > 0 ? 'edit' : 'plus' ?>" size="md"></w:icon><?= $escape($roleId > 0 ? __('编辑角色') : __('添加角色')) ?></h1><p class="w-text" data-tone="muted"><?= $escape(__('角色只描述职责，具体能力在权限配置页中授予。')) ?></p></div>
        <a class="w-button" data-tone="neutral" href="@backend-url('*/backend/acl/role')"><w:icon name="arrow-left" size="sm"></w:icon><?= $escape(__('返回列表')) ?></a>
    </header>
    <section class="w-card">
        <div class="w-card__body">
            <form class="w-form w-stack" action="<?= $escape($action) ?>" method="post">
                <input type="hidden" name="form_key" value="<?= $escape($this->getFormKeyValue()) ?>">
                <?php if ($roleId > 0): ?><input type="hidden" name="role_id" value="<?= $roleId ?>"><?php endif; ?>
                <label class="w-field"><span class="w-field__label"><?= $escape(__('角色名')) ?></span><input class="w-input" type="text" name="role_name" value="<?= $escape($value($role, 'role_name')) ?>" required maxlength="120" autocomplete="off"><span class="w-field__error"><?= $escape(__('请输入角色名称')) ?></span></label>
                <label class="w-field"><span class="w-field__label"><?= $escape(__('角色描述')) ?></span><textarea class="w-textarea" name="role_description" rows="5" required maxlength="500"><?= $escape($value($role, 'role_description')) ?></textarea><span class="w-field__error"><?= $escape(__('请输入角色描述')) ?></span></label>
                <div><button class="w-button" type="submit" data-tone="primary"><w:icon name="save" size="sm"></w:icon><?= $escape(__('保存角色')) ?></button></div>
            </form>
        </div>
    </section>
</main>
