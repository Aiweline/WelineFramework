                        <?php for ($number = max(1, $page - 2), $end = min($lastPage, $page + 2); $number <= $end; ++$number): ?>
                            <li class="w-pagination__item" <?= $number === $page ? 'data-state="active"' : '' ?>><a class="w-pagination__link" href="<?= $escape($pageUrl($number)) ?>" <?= $number === $page ? 'aria-current="page"' : '' ?>><?= $number ?></a></li>
                        <?php endfor; ?>
                        <li class="w-pagination__item"><a class="w-pagination__link" href="<?= $escape($pageUrl(min($lastPage, $page + 1))) ?>" <?= $page >= $lastPage ? 'aria-disabled="true" tabindex="-1"' : '' ?>><?= $escape(__('下一页')) ?></a></li>
