<?php
/** @var \Weline\Framework\View\Template $this */
$roles = is_iterable($this->getData('roles')) ? $this->getData('roles') : [];
$pagination = is_array($this->getData('pagination')) ? $this->getData('pagination') : [];
$search = trim((string)$this->getData('search'));
$page = max(1, (int)($pagination['page'] ?? 1));
$lastPage = max(1, (int)($pagination['lastPage'] ?? 1));
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$value = static function (mixed $role, string $key, mixed $default = ''): mixed {
    if (is_array($role)) {
        return $role[$key] ?? $default;
    }
    if (is_object($role) && method_exists($role, 'getData')) {
        $resolved = $role->getData($key);
        return $resolved === null ? $default : $resolved;
    }
    return $default;
};
$listUrl = $this->getBackendUrl('*/backend/acl/role');
$pageUrl = static function (int $number) use ($listUrl, $search): string {
    $params = ['page' => max(1, $number)];
    if ($search !== '') {
        $params['search'] = $search;
    }
    return $listUrl . '?' . http_build_query($params);
};
?>

