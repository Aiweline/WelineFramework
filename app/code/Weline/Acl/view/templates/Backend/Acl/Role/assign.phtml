<?php
/** @var \Weline\Framework\View\Template $this */
$trees = is_iterable($this->getData('trees')) ? $this->getData('trees') : [];
$tagTree = is_array($this->getData('tag_tree')) ? $this->getData('tag_tree') : [];
$statistics = is_array($this->getData('tree_statistics')) ? $this->getData('tree_statistics') : [];
$selectedIds = is_array($this->getData('selected_source_ids')) ? $this->getData('selected_source_ids') : [];
$selected = array_fill_keys(array_map('strval', $selectedIds), true);
$tagGrants = array_fill_keys(array_map('strval', is_array($this->getData('tag_grants')) ? $this->getData('tag_grants') : []), true);
$assignRole = is_array($this->getData('assign_role')) ? $this->getData('assign_role') : [];
$userRole = $this->getData('user_role');
$assignmentMode = (string)($this->getData('assignment_mode') ?: 'role');
$assignmentAction = (string)($this->getData('assignment_action') ?: $this->getBackendUrl('*/backend/acl/role/assign'));
$assignmentIdentifierName = (string)($this->getData('assignment_identifier_name') ?: 'role_id');
$assignmentIdentifierValue = max(0, (int)($this->getData('assignment_identifier_value') ?: ($assignRole['role_id'] ?? 0)));
$assignmentTitle = (string)($this->getData('assignment_title') ?: __('角色权限配置'));
$assignmentDescription = (string)($this->getData('assignment_description') ?: __('使用原生权限树控制菜单、接口、任务和运维能力'));
$assignmentBackUrl = (string)($this->getData('assignment_back_url') ?: $this->getBackendUrl('*/backend/acl/role'));
$assignmentBackLabel = (string)($this->getData('assignment_back_label') ?: __('返回列表'));
$assignmentSubjectLabel = (string)($this->getData('assignment_subject_label') ?: __('配置角色'));
$assignmentSubjectName = (string)($this->getData('assignment_subject_name') ?: ($assignRole['role_name'] ?? ''));
$assignmentSubjectIcon = (string)($this->getData('assignment_subject_icon') ?: 'shield');
$assignmentContextLabel = (string)($this->getData('assignment_context_label') ?: __('操作者'));
$assignmentContextIcon = (string)($this->getData('assignment_context_icon') ?: 'user');
$showTagDimension = $this->getData('assignment_show_tags') !== false;
$escape = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$roleValue = static function (mixed $role, string $key, mixed $default = ''): mixed {
    if (is_array($role)) {
        return $role[$key] ?? $default;
    }
    if (is_object($role) && method_exists($role, 'getData')) {
        $value = $role->getData($key);
        return $value === null ? $default : $value;
    }
    return $default;
};
$assignmentContextName = (string)($this->getData('assignment_context_name') ?: $roleValue($userRole, 'role_name', __('未知')));
$totalAll = 0;
$selectedAll = 0;
foreach ($statistics as $stat) {
    $totalAll += max(0, (int)($stat['total'] ?? 0));
    $selectedAll += max(0, (int)($stat['selected'] ?? 0));
}
$selectedPercent = $totalAll > 0 ? min(100, (int)round(($selectedAll / $totalAll) * 100)) : 0;
$typeLabel = static fn(string $type): string => \Weline\Acl\Service\Resource\AclResourcePresentation::typeLabel($type);
$typeIcon = static fn(string $type): string => \Weline\Acl\Service\Resource\AclResourcePresentation::typeIcon($type);

$renderPermissionNodes = function (iterable $nodes, int $depth = 0) use (&$renderPermissionNodes, $selected, $escape, $typeLabel, $typeIcon, $statistics): void {
    echo '<ul class="w-tree w-acl-tree__list">';
    foreach ($nodes as $node) {
        if (!is_object($node) || !method_exists($node, 'getSourceId')) {
            continue;
        }
        $sourceId = trim((string)$node->getSourceId());
        if ($sourceId === '') {
            continue;
        }
        $children = is_iterable($node->getSub()) ? $node->getSub() : [];
        $children = is_array($children) ? $children : iterator_to_array($children);
        $hasChildren = $children !== [];
        $name = (string)$node->getSourceName();
        $type = (string)$node->getType();
        $module = (string)$node->getModule();
        if ($module === '') {
            $module = (string)(explode('::', $sourceId)[0] ?? '');
        }
        $method = strtoupper(trim((string)$node->getMethod()));
        $description = trim((string)$node->getDocument());
        $checked = !$hasChildren && isset($selected[$sourceId]);
        $search = trim($name . ' ' . $sourceId . ' ' . $description);
        echo '<li class="w-acl-tree__node" data-acl-node data-module="' . $escape($module) . '" data-type="' . $escape($type) . '" data-search="' . $escape($search) . '">';
        if ($hasChildren) {
            echo '<details class="w-acl-tree__branch"' . ($depth < 2 ? ' open' : '') . '>';
            echo '<summary class="w-acl-tree__row">';
        } else {
            echo '<div class="w-acl-tree__row">';
        }
        echo '<label class="w-check w-acl-tree__check" title="' . $escape($description !== '' ? $description : $sourceId) . '">';
        echo '<input type="checkbox" name="ids[]" value="' . $escape($sourceId) . '" data-acl-source="' . $escape($sourceId) . '"' . ($checked ? ' checked' : '') . '>';
        echo '<w-icon name="' . $escape($typeIcon($type)) . '" size="sm"></w-icon>';
        echo '<span class="w-acl-tree__name">' . $escape($name !== '' ? $name : $sourceId) . '</span>';
        if ($method !== '') {
            echo '<span class="w-badge" data-tone="neutral">' . $escape($method) . '</span>';
        }
        echo '<span class="w-badge" data-tone="info">' . $escape($typeLabel($type)) . '</span>';
        if (isset($statistics[$sourceId])) {
            $stat = $statistics[$sourceId];
            echo '<span class="w-badge" data-tone="neutral">' . max(0, (int)($stat['selected'] ?? 0)) . '/' . max(0, (int)($stat['total'] ?? 0)) . '</span>';
        }
        echo '</label>';
        if ($hasChildren) {
            echo '</summary>';
            $renderPermissionNodes($children, $depth + 1);
            echo '</details>';
        } else {
            echo '</div>';
        }
        echo '</li>';
    }
    echo '</ul>';
};

$renderTagNodes = function (array $nodes, int $depth = 0, bool $ancestorGranted = false) use (&$renderTagNodes, $tagGrants, $selected, $escape, $typeLabel): void {
    echo '<ul class="w-tree w-acl-tree__list">';
    foreach ($nodes as $node) {
        if (!is_array($node)) {
            continue;
        }
        $path = trim((string)($node['tag_path'] ?? ''));
        if ($path === '') {
            continue;
        }
        $name = (string)($node['name'] ?? $path);
        $explicitGrant = isset($tagGrants[$path]);
        $covered = $ancestorGranted || $explicitGrant;
        $children = is_array($node['children'] ?? null) ? $node['children'] : [];
        $leaves = is_array($node['leaves'] ?? null) ? $node['leaves'] : [];
        echo '<li class="w-acl-tree__node" data-acl-node data-tag-node data-search="' . $escape($name . ' ' . $path) . '">';
        echo '<details class="w-acl-tree__branch"' . ($depth < 2 ? ' open' : '') . '>';
        echo '<summary class="w-acl-tree__row">';
        echo '<label class="w-check w-acl-tree__check" title="' . $escape($path) . '">';
        echo '<input type="checkbox" name="tag_paths[]" value="' . $escape($path) . '" data-acl-tag="' . $escape($path) . '"' . ($explicitGrant ? ' checked' : '') . '>';
        echo '<w-icon name="tag" size="sm"></w-icon><span class="w-acl-tree__name">' . $escape($name) . '</span><span class="w-badge" data-tone="info">' . $escape(__('标签包')) . '</span>';
        echo '</label></summary>';
        if ($children !== []) {
            $renderTagNodes($children, $depth + 1, $covered);
        }
        if ($leaves !== []) {
            echo '<ul class="w-tree w-acl-tree__list">';
            foreach ($leaves as $leaf) {
                if (!is_array($leaf)) {
                    continue;
                }
                $sourceId = trim((string)($leaf['source_id'] ?? $leaf['id'] ?? ''));
                if ($sourceId === '') {
                    continue;
                }
                $leafName = (string)($leaf['name'] ?? $sourceId);
                $leafType = (string)($leaf['type'] ?? '');
                $leafModule = (string)($leaf['module'] ?? (explode('::', $sourceId)[0] ?? ''));
                $leafChecked = $covered || isset($selected[$sourceId]) || !empty($leaf['selected']);
                echo '<li class="w-acl-tree__node" data-acl-node data-module="' . $escape($leafModule) . '" data-type="' . $escape($leafType) . '" data-search="' . $escape($leafName . ' ' . $sourceId) . '">';
                echo '<div class="w-acl-tree__row"><label class="w-check w-acl-tree__check" title="' . $escape($sourceId) . '">';
                echo '<input type="checkbox" name="ids[]" value="' . $escape($sourceId) . '" data-acl-source="' . $escape($sourceId) . '" data-parent-tag-path="' . $escape($path) . '"' . ($leafChecked ? ' checked' : '') . '>';
                echo '<w-icon name="key" size="sm"></w-icon><span class="w-acl-tree__name">' . $escape($leafName) . '</span><span class="w-badge" data-tone="neutral">' . $escape($typeLabel($leafType)) . '</span>';
                echo '</label></div></li>';
            }
            echo '</ul>';
        }
        echo '</details></li>';
    }
    echo '</ul>';
};
?>
