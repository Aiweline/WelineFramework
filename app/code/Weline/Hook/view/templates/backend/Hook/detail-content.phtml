<script>
document.addEventListener('click', function(event) {
    const trigger = event.target.closest('[data-hook-copy]');
    if (!trigger) return;
    event.preventDefault();
    copyHookName();
});

function copyHookName() {
    const hookCode = document.getElementById('hook-code-value');
    if (!hookCode) return;
    
    const text = hookCode.textContent;
    
    // 使用现代 Clipboard API
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
            showCopySuccess();
        }).catch(function(err) {
            console.error('复制失败:', err);
            fallbackCopyText(text);
        });
    } else {
        // 降级方案
        fallbackCopyText(text);
    }
}

function fallbackCopyText(text) {
    const textArea = document.createElement('textarea');
    textArea.value = text;
    textArea.style.position = 'fixed';
    textArea.style.left = '-999999px';
    document.body.appendChild(textArea);
    textArea.select();
    try {
        document.execCommand('copy');
        showCopySuccess();
    } catch (err) {
        console.error('复制失败:', err);
        Weline.UI.dialog.request({
            tone: 'warning',
            title: '<?= __('复制失败') ?>',
            message: '<?= __('请手动复制') ?>',
            confirmLabel: '<?= __('确定') ?>'
        });
    }
    document.body.removeChild(textArea);
}

function showCopySuccess() {
    const btn = document.querySelector('.btn-copy');
    if (!btn) return;
    
    const originalHTML = btn.innerHTML;
    btn.innerHTML = '<w:icon name="check" size="sm"></w:icon>';
    btn.style.color = '#28a745';
    setTimeout(function() {
        btn.innerHTML = originalHTML;
        btn.style.color = '';
    }, 2000);
}
</script>
