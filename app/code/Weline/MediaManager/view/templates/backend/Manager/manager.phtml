<css>Weline_MediaManager::css/backend-theme-vars.css</css>
<notempty name="is_iframe">
<script>(function(){var d=document.documentElement,b=document.body,p='{{$theme_preference|default:"system"}}';d.classList.add('mmf-iframe-host');if(['system','light','dark'].indexOf(p)<0)p='system';var q=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)');var applyFallback=function(){var m=p==='dark'||(p==='system'&&q&&q.matches)?'dark':'light';d.setAttribute('data-w-area','backend');d.setAttribute('data-theme-preference',p);d.setAttribute('data-theme',m);d.style.colorScheme=m;};applyFallback();function fitIframeViewport(){d.style.removeProperty('height');d.style.removeProperty('max-height');d.style.minHeight='0';d.style.overflow='hidden';if(b){b.classList.add('mmf-iframe-host');b.style.removeProperty('height');b.style.removeProperty('max-height');b.style.minHeight='0';b.style.overflow='hidden';b.style.margin='0';}var m=document.querySelector('main.w-backend-page,#main-content');if(m){m.style.removeProperty('height');m.style.removeProperty('max-height');m.style.minHeight='0';m.style.flex='1 1 auto';m.style.display='flex';m.style.flexDirection='column';m.style.overflow='hidden';m.style.padding='0';m.style.margin='0';}var w=document.querySelector('.mmf-wrap.mmf-iframe-mode');if(w){w.style.removeProperty('height');w.style.removeProperty('max-height');w.style.minHeight='0';}}fitIframeViewport();window.addEventListener('resize',fitIframeViewport,{passive:true});document.addEventListener('DOMContentLoaded',function(){if(b)b.classList.add('mmf-iframe-host');fitIframeViewport();var runtime=window.__WelineBackendThemeRuntime;if(runtime&&typeof runtime.apply==='function'){runtime.apply(p);return;}if(p==='system'&&q){if(q.addEventListener)q.addEventListener('change',applyFallback);else if(q.addListener)q.addListener(applyFallback);}fitIframeViewport();},{once:true});window.addEventListener('load',fitIframeViewport,{once:true});})();</script>
<!-- Weline backend theme: tool-internal styles, see 后端主题开发标准 §12 (pending migration) -->
<style id="mmf-iframe-layout-critical">
html.mmf-iframe-host,
html.mmf-iframe-host body,
html:has(.mmf-wrap.mmf-iframe-mode),
html:has(.mmf-wrap.mmf-iframe-mode) body {
    block-size: 100% !important;
    max-block-size: 100% !important;
    min-block-size: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
}
html.mmf-iframe-host body,
html:has(.mmf-wrap.mmf-iframe-mode) body {
    display: flex !important;
    flex-direction: column !important;
}
html.mmf-iframe-host main.w-backend-page,
html.mmf-iframe-host #main-content,
html:has(.mmf-wrap.mmf-iframe-mode) main.w-backend-page,
html:has(.mmf-wrap.mmf-iframe-mode) #main-content {
    flex: 1 1 auto !important;
    block-size: 100% !important;
    max-block-size: 100% !important;
    min-block-size: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    padding: 0 !important;
    margin: 0 !important;
}
.mmf-wrap.mmf-iframe-mode {
    flex: 1 1 auto !important;
    block-size: 100% !important;
    max-block-size: 100% !important;
    min-block-size: 0 !important;
    display: grid !important;
    grid-template-columns: auto minmax(0, 1fr) auto !important;
    grid-template-rows: minmax(0, 1fr) !important;
    align-items: stretch !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-main,
.mmf-wrap.mmf-iframe-mode .mmf-sidebar,
.mmf-wrap.mmf-iframe-mode .mmf-preview {
    min-block-size: 0 !important;
    max-block-size: 100% !important;
    block-size: 100% !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-sidebar {
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-sidebar .mmf-sidebar-head,
.mmf-wrap.mmf-iframe-mode .mmf-sidebar .mmf-sidebar-title {
    flex: 0 0 auto !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-sidebar .mmf-sidebar-search {
    flex: 0 0 auto !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-sidebar .mmf-tree {
    flex: 1 1 auto !important;
    min-block-size: 0 !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-main {
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-content {
    flex: 1 1 auto !important;
    min-block-size: 0 !important;
    overflow-y: auto !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-preview {
    display: grid !important;
    grid-template-rows: auto minmax(0, 1fr) !important;
    overflow: hidden !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-preview-content,
.mmf-wrap.mmf-iframe-mode .mmf-preview-info {
    min-block-size: 0 !important;
    overflow: hidden !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-select-bar {
    position: static !important;
    flex: 0 0 auto !important;
}
.mmf-wrap.mmf-iframe-mode .mmf-preview-title .mmf-chrome-close {
    display: none !important;
}
@media (max-width: 768px) {
    .mmf-wrap.mmf-iframe-mode {
        display: block !important;
        position: relative !important;
        overflow: hidden !important;
    }
    .mmf-wrap.mmf-iframe-mode .mmf-main {
        block-size: 100% !important;
        max-block-size: 100% !important;
    }
    .mmf-wrap.mmf-iframe-mode .mmf-sidebar,
    .mmf-wrap.mmf-iframe-mode .mmf-preview {
        block-size: auto !important;
        display: flex !important;
        position: absolute !important;
    }
}
</style>
</notempty>
<css>Weline_MediaManager::css/manager.css</css>
<script src="@static(Weline_MediaManager::js/manager.js)&v=20260918-statusbar-float" defer></script>

<div class="mmf-wrap<notempty name="is_iframe"> mmf-iframe-mode</notempty>" data-weline-load="mediaManagerBoot">
    <div class="mmf-chrome-backdrop" data-mmf-chrome-backdrop hidden aria-hidden="true"></div>
    <!-- 侧边树 -->
    <div class="mmf-sidebar" id="mmf-sidebar" data-mmf-sidebar>
        <div class="mmf-sidebar-head">
            <div class="mmf-storage-selector">
                <label class="mmf-storage-label"><lang>Storage</lang></label>
                <select class="mmf-storage-select" id="mmf-storage-select">
                    <option value="local::filesystem::media" selected><lang>Local Storage</lang></option>
                </select>
            </div>
            <button type="button" class="mmf-chrome-close" data-mmf-close-sidebar aria-label="@lang{关闭}">&times;</button>
        </div>
        <div class="mmf-sidebar-title"><lang>Folders</lang></div>
        <div class="mmf-sidebar-search">
            <label class="mmf-search-label" for="mmf-search-input"><lang>Search</lang></label>
            <input type="search"
                   class="mmf-search-input"
                   id="mmf-search-input"
                   placeholder="@lang{搜索文件或文件夹…}"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="false"
                   aria-controls="mmf-search-results"
                   aria-autocomplete="list">
            <div class="mmf-search-results" id="mmf-search-results" role="listbox" hidden></div>
        </div>
        <ul class="mmf-tree" role="tree"></ul>
        <div class="mmf-ref-panel" id="mmf-ref-panel" hidden>
            <div class="mmf-sidebar-title"><lang>引用标签筛</lang></div>
            <label class="mmf-field"><span><lang>大类</lang></span>
                <select id="mmf-ref-root">
                    <option value="">—</option>
                    <option value="product">product</option>
                    <option value="widget">widget</option>
                    <option value="theme">theme</option>
                    <option value="catalog">catalog</option>
                    <option value="blog">blog</option>
                    <option value="config">config</option>
                    <option value="smtp">smtp</option>
                </select>
            </label>
            <label class="mmf-field"><span>scope</span><input type="text" id="mmf-ref-scope" placeholder="default.default.default"></label>
            <label class="mmf-field"><span>sku / code</span><input type="text" id="mmf-ref-code" placeholder="SKU / theme / slug"></label>
            <label class="mmf-field"><span>kind</span><input type="text" id="mmf-ref-kind" placeholder="media / detail"></label>
            <label class="mmf-field"><span>component</span><input type="text" id="mmf-ref-component" placeholder="banner"></label>
            <div class="mmf-ref-actions">
                <button type="button" class="mmf-btn mmf-btn-primary" id="mmf-ref-apply"><lang>筛选</lang></button>
                <button type="button" class="mmf-btn" id="mmf-ref-unbind-prefix"><lang>卸引用前缀</lang></button>
                <button type="button" class="mmf-btn" id="mmf-ref-unreferenced"><lang>无引用</lang></button>
                <button type="button" class="mmf-btn mmf-btn-danger" id="mmf-ref-close-scope"><lang>关站清引用</lang></button>
            </div>
            <div class="mmf-ref-report" id="mmf-ref-report" aria-live="polite"></div>
        </div>
    </div>

    <!-- 主区域 -->
    <div class="mmf-main">
        <div class="mmf-identity-bar is-collapsed" id="mmf-identity-bar" data-mmf-identity-bar hidden>
            <button type="button"
                    class="mmf-identity-bar__toggle"
                    data-mmf-identity-toggle
                    aria-expanded="false"
                    aria-controls="mmf-identity-panel">
                <span class="mmf-identity-bar__chevron" aria-hidden="true">&#9662;</span>
                <span class="mmf-identity-bar__title"><lang>当前身份引用</lang></span>
                <span class="mmf-identity-bar__summary" data-mmf-identity-summary></span>
            </button>
            <div class="mmf-identity-bar__panel" id="mmf-identity-panel" data-mmf-identity-panel hidden>
                <div class="mmf-identity-bar__head">
                    <button type="button" class="mmf-identity-chip mmf-identity-chip--all is-active" data-mmf-identity-all aria-pressed="true">
                        <lang>全部</lang>
                    </button>
                    <span class="mmf-identity-bar__hint" data-mmf-identity-hint aria-live="polite"></span>
                </div>
                <div class="mmf-identity-bar__groups" data-mmf-identity-groups role="group" aria-label="@lang{身份标签组}"></div>
            </div>
        </div>
        <!-- 工具栏 -->
        <div class="mmf-toolbar">
            <button type="button" class="mmf-btn mmf-btn-chrome" id="mmf-btn-folders" data-mmf-toggle-sidebar title="@lang{目录}" aria-expanded="false" aria-controls="mmf-sidebar">
                &#x1F4C1; <lang>目录</lang>
            </button>
            <button type="button" class="mmf-btn mmf-btn-primary" id="mmf-btn-upload" title="@lang{Upload}">
                &#x2B06; <lang>Upload</lang>
            </button>
            <button type="button" class="mmf-btn" id="mmf-btn-newfolder" title="@lang{New Folder}">
                &#x1F4C1; <lang>New Folder</lang>
            </button>
            <span class="mmf-toolbar-sep"></span>
            <button type="button" class="mmf-btn" id="mmf-btn-rename" title="@lang{Rename}">
                &#x270F;&#xFE0F; <lang>Rename</lang>
            </button>
            <button type="button" class="mmf-btn" id="mmf-btn-download" title="@lang{Download}">
                &#x1F4E5; <lang>Download</lang>
            </button>
            <button type="button" class="mmf-btn mmf-btn-danger" id="mmf-btn-delete" title="@lang{Delete}">
                &#x1F5D1;&#xFE0F; <lang>Delete</lang>
            </button>
            <span class="mmf-toolbar-sep"></span>
            <div class="mmf-mode-switch" role="group" aria-label="@lang{管理视图}">
                <button type="button" class="mmf-btn is-active" id="mmf-mode-files" data-mmf-view-mode="files" title="@lang{文件管理}">
                    <lang>文件管理</lang>
                </button>
                <button type="button" class="mmf-btn" id="mmf-mode-refs" data-mmf-view-mode="refs" title="@lang{引用管理}">
                    <lang>引用管理</lang>
                </button>
            </div>
            <button type="button" class="mmf-btn" id="mmf-btn-trash" title="@lang{垃圾箱}">
                &#x1F5D1; <lang>垃圾箱</lang>
            </button>
            <span class="mmf-toolbar-sep"></span>
            <button type="button" class="mmf-btn" id="mmf-btn-refresh" title="@lang{Refresh}">
                &#x1F504; <lang>Refresh</lang>
            </button>
            <button type="button" class="mmf-btn mmf-btn-ai" id="mmf-btn-ai-draw" title="@lang{AI 作图}">
                &#x2728; <lang>AI 作图</lang>
            </button>
            <label class="mmf-ai-auto-translate" title="@lang{开启后由 cron 自动补缺未翻译语言；已有文案不覆盖。上传一键翻译不受此开关影响。}">
                <input type="checkbox" id="mmf-ai-auto-translate" data-mmf-ai-auto-translate>
                <span><lang>AI 自动翻译</lang></span>
            </label>
            <span class="mmf-toolbar-spacer" aria-hidden="true"></span>
            <button type="button" class="mmf-btn mmf-btn-primary mmf-iframe-confirm" id="mmf-btn-select" title="@lang{Select}">
                &#x2714; <lang>Select</lang>
            </button>
        </div>
        <div class="mmf-path-row">
            <div class="mmf-path" aria-label="@lang{当前目录}"></div>
            <button type="button" class="mmf-btn mmf-path-lock" id="mmf-btn-path-lock" hidden title="@lang{解锁目录}" aria-pressed="true">
                <span class="mmf-path-lock-icon" aria-hidden="true">&#x1F512;</span>
                <span class="mmf-path-lock-label"><lang>解锁目录</lang></span>
            </button>
        </div>
        <div class="mmf-aspect-hint" id="mmf-aspect-hint" hidden role="status" aria-live="polite"></div>

        <!-- 上传进度与无障碍状态 -->
        <div class="mmf-upload-progress" role="progressbar" aria-label="@lang{文件上传进度}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-hidden="true">
            <div class="mmf-progress-bar-wrap"><div class="mmf-progress-bar"></div></div>
            <div class="mmf-progress-text">0%</div>
        </div>
        <div class="mmf-interaction-status mmf-sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

        <!-- 文件列表 -->
        <div class="mmf-content">
            <div class="mmf-upload-drop" aria-hidden="true"><lang>松开即可上传到当前文件夹</lang></div>
            <div class="mmf-grid" style="display:none;"></div>
            <div class="mmf-loading"><span class="mmf-spinner"></span><lang>Loading...</lang></div>
        </div>

        <!-- 状态栏：悬浮在文件区底部 -->
        <div class="mmf-statusbar">
            <span class="mmf-status-info"></span>
            <span class="mmf-status-size"></span>
        </div>
        
        <!-- iframe 模式下的多选工具栏 -->
        <div class="mmf-select-bar" id="mmf-select-bar" style="display:none;">
            <div class="mmf-select-bar-left">
                <span class="mmf-select-count"><lang>已选择</lang> <span id="mmf-select-count-num">0</span> <lang>个文件</lang></span>
            </div>
            <div class="mmf-select-bar-right">
                <button type="button" class="mmf-btn" id="mmf-btn-clear-select"><lang>取消全选</lang></button>
                <button type="button" class="mmf-btn" id="mmf-btn-invert-select"><lang>反选</lang></button>
                <button type="button" class="mmf-btn" id="mmf-btn-cancel"><lang>取消</lang></button>
                <button type="button" class="mmf-btn mmf-btn-primary" id="mmf-btn-confirm-select"><lang>确认选择</lang></button>
            </div>
        </div>
    </div>

    <!-- 右侧预览面板 -->
    <div class="mmf-preview" id="mmf-preview" data-mmf-preview>
        <div class="mmf-preview-title">
            <span><lang>文件详情</lang></span>
        </div>
        <div class="mmf-preview-content">
            <div class="mmf-preview-empty">
                <span class="mmf-preview-empty-icon">&#x1F5BC;&#xFE0F;</span>
                <span><lang>Select a file to preview</lang></span>
            </div>
            <div class="mmf-preview-image" style="display:none;">
                <img class="mmf-preview-img" alt="">
            </div>
            <div class="mmf-preview-info" style="display:none;">
                <div class="mmf-preview-info-scroll">
                    <div class="mmf-preview-name"></div>
                    <div class="mmf-locale-workbench" data-mmf-locale-workbench hidden>
                        <div class="mmf-locale-workbench-title"><lang>多语言翻译</lang></div>
                        <div class="mmf-locale-workbench-hint" data-mmf-locale-workbench-hint></div>
                        <div class="mmf-locale-tabs" data-mmf-locale-tabs role="tablist"></div>
                        <div class="mmf-locale-editor" data-mmf-locale-editor>
                            <label class="mmf-locale-field">
                                <span><lang>显示名称</lang></span>
                                <input type="text" data-mmf-locale-display-name maxlength="255">
                            </label>
                            <label class="mmf-locale-field">
                                <span><lang>默认 Alt</lang></span>
                                <input type="text" data-mmf-locale-default-alt maxlength="512">
                            </label>
                            <label class="mmf-locale-field">
                                <span><lang>资源描述</lang></span>
                                <textarea data-mmf-locale-description rows="3"></textarea>
                            </label>
                            <label class="mmf-locale-field">
                                <span><lang>默认说明文字</lang></span>
                                <textarea data-mmf-locale-caption rows="2"></textarea>
                            </label>
                            <div class="mmf-locale-editor-actions">
                                <button type="button" class="mmf-btn mmf-btn-primary" data-mmf-locale-save><lang>保存当前语言</lang></button>
                                <button type="button" class="mmf-btn" data-mmf-locale-translate><lang>一键补缺翻译</lang></button>
                            </div>
                            <div class="mmf-locale-status" data-mmf-locale-status></div>
                        </div>
                    </div>
                    <dl class="mmf-preview-meta" data-mmf-preview-meta></dl>
                </div>
                <div class="mmf-preview-actions">
                    <button type="button" class="mmf-btn mmf-preview-btn-details" title="@lang{查看详情}">
                        &#x2139;&#xFE0F; <lang>查看详情</lang>
                    </button>
                    <button type="button" class="mmf-btn mmf-btn-ai mmf-preview-btn-ai-edit" title="@lang{AI 修图}" style="display:none;">
                        &#x2728; <lang>AI 修图</lang>
                    </button>
                    <button type="button" class="mmf-btn mmf-btn-primary mmf-preview-btn-open" title="@lang{预览}">
                        &#x1F50D; <lang>Preview</lang>
                    </button>
                    <button type="button" class="mmf-btn mmf-preview-btn-download" title="@lang{Download}">
                        &#x1F4E5; <lang>Download</lang>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 右键菜单 -->
<div class="mmf-context-menu-root w-menu-root"
     data-mmf-context-menu-root
     data-w-component="menu"
     data-w-placement="bottom-start"
     data-w-anchor-mode="element">
    <button type="button"
            class="mmf-context-menu-anchor"
            data-w-menu-trigger
            tabindex="-1"
            aria-hidden="true"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="mmf-context-menu"></button>
    <div id="mmf-context-menu"
         class="mmf-context-menu w-menu"
         data-w-menu-panel
         data-w-viewport-padding="8"
         data-state="closed"
         role="menu" aria-hidden="true" hidden></div>
</div>

<!-- 拖入/粘贴时才出现的覆盖目标选择 -->
<div class="mmf-overwrite-pick-overlay" id="mmf-overwrite-pick-overlay" hidden aria-hidden="true">
    <div class="mmf-overwrite-pick-dialog" role="dialog" aria-modal="true" aria-labelledby="mmf-overwrite-pick-title">
        <div class="mmf-overwrite-pick-title" id="mmf-overwrite-pick-title"><lang>指定覆盖目标（可选）</lang></div>
        <p class="mmf-overwrite-pick-hint"><lang>可为每个入站文件搜索当前目录里要覆盖的已有文件；选定后只替换物理内容，目标文件名与元数据全部保留。不选则按新建上传。</lang></p>
        <div class="mmf-overwrite-pick-rows" id="mmf-overwrite-pick-rows" data-mmf-overwrite-pick-rows></div>
        <div class="mmf-overwrite-pick-error" id="mmf-overwrite-pick-error" role="alert" hidden></div>
        <div class="mmf-overwrite-pick-actions">
            <button type="button" class="mmf-btn" id="mmf-overwrite-pick-cancel"><lang>取消上传</lang></button>
            <button type="button" class="mmf-btn mmf-btn-primary" id="mmf-overwrite-pick-confirm"><lang>继续</lang></button>
        </div>
    </div>
</div>

<!-- 对话框 -->
<div class="mmf-dialog-overlay" aria-hidden="true">
    <div class="mmf-dialog" role="dialog" aria-modal="true" aria-labelledby="mmf-dialog-title">
        <div class="mmf-dialog-title" id="mmf-dialog-title"></div>
        <div class="mmf-dialog-message" hidden></div>
        <input type="text" class="mmf-dialog-input" autocomplete="off">
        <div class="mmf-dialog-actions">
            <button type="button" class="mmf-btn mmf-dialog-cancel"><lang>Cancel</lang></button>
            <button type="button" class="mmf-btn mmf-dialog-secondary" hidden></button>
            <button type="button" class="mmf-btn mmf-btn-primary mmf-dialog-ok"><lang>OK</lang></button>
        </div>
    </div>
</div>

<!-- 文件元数据详情 -->
<div class="mmf-details-overlay" aria-hidden="true">
    <section class="mmf-details-dialog" role="dialog" aria-modal="true" aria-labelledby="mmf-details-title">
        <header class="mmf-details-header">
            <div>
                <div class="mmf-details-eyebrow"><lang>文件元数据</lang></div>
                <h2 class="mmf-details-title" id="mmf-details-title"></h2>
            </div>
            <button type="button" class="mmf-details-close" aria-label="@lang{关闭}">&times;</button>
        </header>
        <div class="mmf-details-body">
            <div class="mmf-details-visual" hidden>
                <img class="mmf-details-image" alt="">
            </div>
            <dl class="mmf-details-list" data-mmf-details-list></dl>
        </div>
        <footer class="mmf-details-actions">
            <button type="button" class="mmf-btn mmf-details-edit" style="display:none;"><lang>编辑资源翻译信息</lang></button>
            <button type="button" class="mmf-btn mmf-btn-primary mmf-details-done"><lang>关闭</lang></button>
        </footer>
    </section>
</div>

<!-- AI 作图弹窗 -->
<div class="mmf-ai-draw-overlay" id="mmf-ai-draw-overlay">
    <div class="mmf-ai-draw-modal" id="mmf-ai-draw-modal">
