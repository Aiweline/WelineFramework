<script>(function(){var d=document.documentElement,p='{{$theme_preference|default:"system"}}';if(['system','light','dark'].indexOf(p)<0)p='system';var q=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)');var applyFallback=function(){var m=p==='dark'||(p==='system'&&q&&q.matches)?'dark':'light';d.setAttribute('data-w-area','backend');d.setAttribute('data-theme-preference',p);d.setAttribute('data-theme',m);d.style.colorScheme=m;};applyFallback();document.addEventListener('DOMContentLoaded',function(){var runtime=window.__WelineBackendThemeRuntime;if(runtime&&typeof runtime.apply==='function'){runtime.apply(p);return;}if(p==='system'&&q){if(q.addEventListener)q.addEventListener('change',applyFallback);else if(q.addListener)q.addListener(applyFallback);}}, {once:true});})();</script>
</notempty>
