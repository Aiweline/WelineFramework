$mmfJsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES;
$mmfJson = static function (mixed $value) use ($mmfJsonFlags): string {
    $encoded = json_encode((string)($value ?? ''), $mmfJsonFlags);
    return is_string($encoded) ? $encoded : '""';
};
$mmfBool = static fn (mixed $value): bool => in_array(
    strtolower(trim((string)$value)),
    ['1', 'true'],
    true,
);
$mmfSize = filter_var($this->getData('size'), FILTER_VALIDATE_INT, [
    'options' => ['min_range' => 1],
]);
$mmfSize = $mmfSize === false ? 512 * 1024 * 1024 : $mmfSize;
?>
