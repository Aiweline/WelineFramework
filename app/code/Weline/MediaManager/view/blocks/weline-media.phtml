<?php
$previewWidth = filter_var($this->getData('width'), FILTER_VALIDATE_INT, ['options' => ['min_range' => 24, 'max_range' => 4096]]);
$previewHeight = filter_var($this->getData('height'), FILTER_VALIDATE_INT, ['options' => ['min_range' => 24, 'max_range' => 4096]]);
$previewWidth = $previewWidth === false ? 50 : $previewWidth;
$previewHeight = $previewHeight === false ? 50 : $previewHeight;
$multiple = !empty($this->getData('multi')) && $this->getData('multi') !== '0';
$showPreview = !empty($this->getData('preview'));
$refMode = trim((string)($this->getData('ref_mode') ?? ($multiple ? 'multi' : 'single')));
$strongRef = filter_var($this->getData('strong_ref') ?? '0', FILTER_VALIDATE_BOOL);
$identityAttrs = [
    'data-w-identity' => (string)($this->getData('identity') ?? $this->getData('identity_path') ?? ''),
    'data-w-identity-root' => (string)($this->getData('identity_root') ?? ''),
    'data-w-identity-code' => (string)($this->getData('identity_code') ?? ''),
    'data-w-identity-scope' => (string)($this->getData('identity_scope') ?? ''),
    'data-w-identity-kind' => (string)($this->getData('identity_kind') ?? ''),
    'data-w-identity-field' => (string)($this->getData('identity_field') ?? ''),
    'data-w-identity-component' => (string)($this->getData('identity_component') ?? ''),
    'data-w-identity-locale' => (string)($this->getData('identity_locale') ?? ''),
    'data-w-identity-instance' => (string)($this->getData('identity_instance') ?? ''),
    'data-w-ref-mode' => $refMode !== '' ? $refMode : 'single',
    'data-w-owner-type' => (string)($this->getData('owner_type') ?? ''),
    'data-w-owner-id' => (string)($this->getData('owner_id') ?? ''),
    'data-w-owner-version' => (string)($this->getData('owner_version') ?? '1'),
    'data-w-strong-ref' => $strongRef ? '1' : '0',
];
$identityAttrHtml = '';
foreach ($identityAttrs as $attr => $val) {
    if ($val === '') {
        continue;
    }
    $identityAttrHtml .= ' ' . $attr . '="' . htmlspecialchars($val, ENT_QUOTES, 'UTF-8') . '"';
}
$valueMode = trim((string)($this->getData('value_mode') ?? ''));
$aspectRatioDisplay = trim((string)($this->getData('aspect_ratio_display') ?? ''));
$aspectRatioHint = trim((string)($this->getData('aspect_ratio_hint') ?? ''));
$recommendSizeDisplay = trim((string)($this->getData('recommend_size_display') ?? ''));
$aspectRatioRaw = trim((string)($this->getData('aspect_ratio') ?? ''));
$aspectRatioTolerance = trim((string)($this->getData('aspect_ratio_tolerance') ?? ''));
$aspectRatioAttr = $aspectRatioDisplay !== ''
    ? ' data-aspect-ratio="' . htmlspecialchars($aspectRatioDisplay, ENT_QUOTES, 'UTF-8') . '"'
    : '';
$aspectToleranceAttr = $aspectRatioTolerance !== ''
    ? ' data-w-aspect-ratio-tolerance="' . htmlspecialchars($aspectRatioTolerance, ENT_QUOTES, 'UTF-8') . '"'
    : '';
$aspectRawAttr = $aspectRatioRaw !== ''
    ? ' data-w-aspect-ratio="' . htmlspecialchars($aspectRatioRaw, ENT_QUOTES, 'UTF-8') . '"'
    : '';
?>
<div class="w-file-picker" data-w-component="file-picker" data-w-target-id="{{target}}"
     data-w-multiple="<?= $multiple ? 'true' : 'false' ?>" data-w-set-attr="{{params.setAttr}}"
     data-w-value-mode="<?= htmlspecialchars($valueMode, ENT_QUOTES, 'UTF-8') ?>"
     data-w-invalid-message="<?= htmlspecialchars((string)__('媒体选择器初始化失败，请刷新页面后重试。'), ENT_QUOTES, 'UTF-8') ?>"
     data-w-empty-message="<?= htmlspecialchars((string)__('暂无缩略图'), ENT_QUOTES, 'UTF-8') ?>"
     data-w-identity-missing="<?= htmlspecialchars((string)__('强引用选图缺少媒体身份：请由页面 Ambient 或标签显式设置 identity。'), ENT_QUOTES, 'UTF-8') ?>"
     data-w-bind-url="<?= htmlspecialchars((string)($this->getData('bind_url') ?? ''), ENT_QUOTES, 'UTF-8') ?>"
     <?= $aspectRatioAttr ?><?= $aspectRawAttr ?><?= $aspectToleranceAttr ?><?= $identityAttrHtml ?>>
    <div id="{{target}}-preview" class="w-file-preview" data-w-file-preview<?= $showPreview ? '' : ' hidden' ?>
         style="--w-file-preview-width: <?= (int)$previewWidth ?>px; --w-file-preview-height: <?= (int)$previewHeight ?>px;">
        <foreach name="value_items" key="k">
            <div class="w-file-preview__item<if condition="v.kind == 'audio'"> w-file-preview__item--audio<else/><if condition="v.kind == 'file'"> w-file-preview__item--file</if></if>"
                 data-w-file-item
                 data-path="{{v.path}}"
                 data-kind="{{v.kind}}"
                 data-file-image-node="{{v.file_image_json}}"
                 draggable="true">
                <div class="w-file-preview__media">
                    <button type="button" class="w-file-preview__thumbnail" data-w-file-open
                            aria-label="<?= htmlspecialchars((string)__('预览'), ENT_QUOTES, 'UTF-8') ?> {{v.name}}">
                        <if condition="v.is_image">
                            <img data-src="{{v.path}}" src="{{v.url}}" alt="{{v.name}}"
                                 title="{{v.name}}" draggable="false">
                            <else/>
                            <span class="w-file-preview__glyph" data-kind="{{v.kind}}" title="{{v.name}}" aria-hidden="true">
                                <if condition="v.kind == 'audio'">♪<else/>📄</if>
                            </span>
                        </if>
                    </button>
                </div>
                <if condition="v.kind == 'audio' || v.kind == 'file'">
                    <div class="w-file-preview__meta">
                        <span class="w-file-preview__name" title="{{v.name}}">{{v.name}}</span>
                        <span class="w-file-preview__hint"><if condition="v.kind == 'audio'"><?= htmlspecialchars((string)__('点击更换曲目'), ENT_QUOTES, 'UTF-8') ?><else/><?= htmlspecialchars((string)__('点击更换文件'), ENT_QUOTES, 'UTF-8') ?></if></span>
                    </div>
                    <else/>
                    <span class="w-file-preview__name" title="{{v.name}}">{{v.name}}</span>
                </if>
                <span class="w-file-preview__actions">
                    <button type="button" class="w-button" data-w-file-move="previous" data-tone="quiet" data-size="sm"
                            aria-label="<?= htmlspecialchars((string)__('向前移动'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="arrow-left" size="sm"></w:icon></button>
                    <button type="button" class="w-button" data-w-file-move="next" data-tone="quiet" data-size="sm"
                            aria-label="<?= htmlspecialchars((string)__('向后移动'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="arrow-right" size="sm"></w:icon></button>
                    <button type="button" class="w-button" data-w-file-remove data-tone="danger" data-size="sm"
                            aria-label="<?= htmlspecialchars((string)__('移除'), ENT_QUOTES, 'UTF-8') ?> {{v.name}}"><w:icon name="close" size="sm"></w:icon></button>
                </span>
            </div>
        </foreach>
    </div>

    <?php
    // Template::__init sets reserved `title` to the current module name; prefer picker_title.
    $pickerTitle = trim((string)($this->getData('picker_title') ?? ''));
    if ($pickerTitle === '') {
        $pickerTitle = trim((string)($this->getData('file_title') ?? ''));
    }
    if ($pickerTitle === '') {
        $pickerTitle = (string)__('从图库选择');
    }
    ?>
    <div class="w-stack" data-gap="xs">
        <button type="button" class="w-button" data-w-file-picker-open data-tone="primary" data-size="sm">
            <w:icon name="folder" size="sm"></w:icon><span><?= htmlspecialchars($pickerTitle, ENT_QUOTES, 'UTF-8') ?></span>
        </button>
        <if condition="ext !== '*'"><span class="w-text" data-size="sm" data-tone="muted">@lang{允许的文件类型：}({{ext}})</span></if>
        <span class="w-text" data-size="sm" data-tone="muted">@lang{允许的文件大小：}{{size_alias}}</span>
        <?php if ($aspectRatioHint !== ''): ?>
            <span class="w-text" data-size="sm" data-tone="muted"><?= htmlspecialchars($aspectRatioHint, ENT_QUOTES, 'UTF-8') ?></span>
        <?php endif; ?>
        <?php if ($recommendSizeDisplay !== ''): ?>
            <span class="w-text" data-size="sm" data-tone="muted"><?= htmlspecialchars($recommendSizeDisplay, ENT_QUOTES, 'UTF-8') ?></span>
        <?php endif; ?>
    </div>

    <dialog id="{{target}}-file-picker-dialog" class="w-dialog w-file-picker__dialog" data-w-component="dialog"
            data-w-file-picker-dialog data-state="closed" aria-labelledby="{{target}}-file-picker-title">
        <div class="w-dialog__surface">
            <header class="w-dialog__header">
                <div>
                    <h2 class="w-dialog__title" id="{{target}}-file-picker-title"><?= htmlspecialchars($pickerTitle, ENT_QUOTES, 'UTF-8') ?></h2>
                    <p class="w-text" data-size="sm" data-tone="muted">
                        <if condition="ext !== '*'">@lang{允许的文件类型：} {{ext}} · </if>@lang{允许的文件大小：} {{size_alias}}<?php
                        if ($aspectRatioHint !== '') {
                            echo ' · ' . htmlspecialchars($aspectRatioHint, ENT_QUOTES, 'UTF-8');
                        }
                        if ($recommendSizeDisplay !== '') {
                            echo ' · ' . htmlspecialchars($recommendSizeDisplay, ENT_QUOTES, 'UTF-8');
                        }
                        ?>
                    </p>
                </div>
                <button type="button" class="w-button" data-w-action="dialog.close" data-w-close data-tone="quiet" data-size="sm"
                        aria-label="<?= htmlspecialchars((string)__('关闭'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="close" size="sm"></w:icon></button>
            </header>
            <div class="w-dialog__body w-file-picker__body">
                <iframe id="{{target}}-file-manager-iframe" class="w-file-picker__frame" data-w-file-picker-frame
                        src="about:blank" data-src="{{connector}}" title="<?= htmlspecialchars($pickerTitle, ENT_QUOTES, 'UTF-8') ?>"></iframe>
            </div>
        </div>
    </dialog>

    <dialog id="{{target}}-file-preview-dialog" class="w-dialog w-file-preview__dialog" data-w-component="dialog"
            data-w-file-preview-dialog data-state="closed" aria-labelledby="{{target}}-file-preview-title">
        <div class="w-dialog__surface">
            <header class="w-dialog__header">
                <h2 class="w-dialog__title" id="{{target}}-file-preview-title"><lang>预览</lang></h2>
                <button type="button" class="w-button" data-w-action="dialog.close" data-w-close data-tone="quiet" data-size="sm"
                        aria-label="<?= htmlspecialchars((string)__('关闭'), ENT_QUOTES, 'UTF-8') ?>"><w:icon name="close" size="sm"></w:icon></button>
            </header>
            <div class="w-dialog__body w-file-preview__dialog-body">
                <img data-w-file-preview-image alt="">
            </div>
        </div>
    </dialog>
</div>
